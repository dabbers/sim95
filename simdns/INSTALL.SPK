' VAPOR|id=SIMDNS|name=SimDNS|kind=web|version=ad24d451|category=Internet|run=/|files=C:\WEB\APPS.ASP;C:\WEB\DOMAIN.ASP;C:\WEB\HELP.ASP;C:\WEB\HOME.ASP;C:\WEB\HOSTIT.ASP;C:\WEB\INDEX.ASP;C:\WEB\JOIN.ASP;C:\WEB\LOGIN.ASP;C:\WEB\LOGOUT.ASP;C:\WEB\NIC.SPK;C:\WEB\PAID.ASP;C:\WEB\RECORD.ASP;C:\WEB\REGISTER.ASP;C:\WEB\SEARCH.ASP;C:\WEB\WHOIS.ASP;C:\PROGRAMS\NAMED.SPK;C:\PROGRAMS\DIG.SPK;C:\PROGRAMS\RESOLVE.SPK|tasks=NAMED|startup=NAMED.RUN|folder=DNS|about=Domain names for the SIM95 network: a name server (NAMED), SimNIC the registrar, DIG, and a web server that hosts many sites on one machine. Becomes this machine's home page, or on a SimHost machine gets a folder of its own.
' INSTALL.SPK - puts SimDNS on this machine. Generated by tools/build-installer.mjs;
' edit the files in simdns/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It makes this
' machine a name server and a registrar. The name server, C:\PROGRAMS\NAMED.SPK,
' answers for the zones in C:\DNS (listed in C:\DNS\NAMED.CNF); it starts now
' and with the machine (C:\SYSTEM\STARTUP\NAMED.RUN). SimNIC, the registrar,
' becomes the home page (the stock INDEX.HTM moves to WELCOME.HTM), or goes in
' C:\WEB\DNS on a SimHost machine. It also writes DIG.SPK (ask a name server)
' and RESOLVE.SPK (the resolver, for your own programs), and replaces the web
' server with one that serves several sites by name (C:\WEB\VHOSTS.TXT). The
' old web server is kept as C:\PROGRAMS\HTTPD.ORG and comes back if SimDNS is
' uninstalled. Accounts and domains in C:\NICDATA and zones in C:\DNS are left
' alone, so running this again upgrades SimDNS.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)
    ' On a machine set up for several web apps (SimHost: C:\SYSTEM\WEBAPPS.INI
    ' says mode=folders), this one goes in C:\WEB\DNS and leaves the home page alone.
    IF FS.Exists("C:\SYSTEM\WEBAPPS.INI") THEN
        IF FS.Read("C:\SYSTEM\WEBAPPS.INI").Contains("mode=folders") THEN intoDir = "DNS"
    END IF
    IF intoDir <> "" AND NOT FS.Exists("C:\WEB\" + intoDir) THEN FS.MakeDir("C:\WEB\" + intoDir)


    IF intoDir = "" THEN MoveHomePage()
    DnsSetup()
    File0()
    File1()
    File2()
    File3()
    File4()
    File5()
    File6()
    File7()
    File8()
    File9()
    File10()
    File11()
    File12()
    File13()
    File14()
    File15()
    File16()
    File17()
    File18()
    Print("SimDNS is installed (19 files).")
    StartService("NAMED", "C:\PROGRAMS\NAMED.SPK", "NAMED.RUN")
    RestartWeb()
    ' how it shows on the SimHost front page, which lists every folder with one of these
    IF intoDir <> "" THEN FS.Write("C:\WEB\" + intoDir + "\APP.INF", "SimDNS|Register your own domain name (.sim, .com, .net, .org), point it at any machine, and host your site here.|#000066")
    IF intoDir = "" THEN
        Print("Open http://" + NET.HostName.Lower() + "/ in Voyager.")
    ELSE
        Print("Open http://" + NET.HostName.Lower() + "/" + intoDir.Lower() + "/ in Voyager.")
    END IF
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "<%@ import file=""NIC.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' APPS.ASP - on a SimHost machine (POST d): book.coolsite.sim for SimBook in" + NL
    t = t + "' C:\WEB\BOOK, mail.coolsite.sim for ColdMail, and so on - a CNAME to this" + NL
    t = t + "' machine and a line in VHOSTS.TXT each, so every app is a site of its own." + NL
    t = t + "VAR d AS String" + NL
    t = t + "VAR n AS Integer" + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""home.asp"")" + NL
    t = t + "d = CleanDomain(REQUEST.Form(""d""))" + NL
    t = t + "IF NOT Owns(viewer, d) THEN RESPONSE.Redirect(""home.asp?why="" + UrlEnc(""That is not one of your domains.""))" + NL
    t = t + "n = PointApps(d)" + NL
    t = t + "RESPONSE.Redirect(""domain.asp?d="" + UrlEnc(d) + ""&ok=1&why="" + UrlEnc(Str(n) + "" apps have names in "" + d + "" now.""))" + NL
    t = t + "%>" + NL
    Put("C:\WEB\APPS.ASP")
END SUB

SUB File1 ()
    t = ""
    t = t + "<%@ import file=""NIC.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' DOMAIN.ASP?d=coolsite.sim - one of your domains: its records (add and" + NL
    t = t + "' delete), Host it here, and on a SimHost machine a name for each web app." + NL
    t = t + "VAR d AS String" + NL
    t = t + "VAR rec AS Array OF String" + NL
    t = t + "VAR recs AS Array OF String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR w AS Array OF String" + NL
    t = t + "VAR rows AS String" + NL
    t = t + "VAR i AS Integer" + NL
    t = t + "VAR folder AS String" + NL
    t = t + "VAR apps AS Array OF String" + NL
    t = t + "VAR a AS String" + NL
    t = t + "VAR names AS String" + NL
    t = t + "VAR why AS String" + NL
    t = t + "VAR here AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "d = CleanDomain(REQUEST.Query(""d""))" + NL
    t = t + "IF NOT Owns(viewer, d) THEN RESPONSE.Redirect(""home.asp?why="" + UrlEnc(""That is not one of your domains.""))" + NL
    t = t + "here = SERVER.Name.Lower()" + NL
    t = t + "rec = DomainRec(d)" + NL
    t = t + "recs = Records(d)" + NL
    t = t + "FOR i = 0 TO recs.Count - 1" + NL
    t = t + "    w = Words(recs[i])" + NL
    t = t + "    IF w.Count < 3 THEN CONTINUE" + NL
    t = t + "    rows = rows + ""<tr><td><tt>"" + H(w[0]) + ""</tt></td><td><tt>"" + H(RecTypeOf(w)) + ""</tt></td><td><tt>"" + H(RecValueOf(recs[i], w)) + ""</tt></td>"" _" + NL
    t = t + "        + ""<td><form action=""""record.asp"""" method=""""post"""">"" + TokenField() + ""<input type=""""hidden"""" name=""""d"""" value="""""" + H(d) + """"""><input type=""""hidden"""" name=""""op"""" value=""""del""""><input type=""""hidden"""" name=""""n"""" value="""""" + Str(i) + """"""><input type=""""submit"""" value=""""Delete""""></form></td></tr>""" + NL
    t = t + "NEXT" + NL
    t = t + "folder = SiteFolder(d)" + NL
    t = t + "apps = AppFolders()" + NL
    t = t + "FOR EACH a IN apps" + NL
    t = t + "    names = names + ""<li><tt>"" + a.Split(""|"")[0].Lower() + ""."" + H(d) + ""</tt> - "" + H(a.Split(""|"")[1]) + ""</li>""" + NL
    t = t + "NEXT" + NL
    t = t + "why = REQUEST.Query(""why"")" + NL
    t = t + "IF REQUEST.Query(""new"") = ""1"" THEN why = ""Congratulations! "" + d + "" is yours until "" + rec[3] + "".""" + NL
    t = t + "%><%= Top(d) %>" + NL
    t = t + "<%= Notice(why, REQUEST.Query(""new"") = ""1"" OR REQUEST.Query(""ok"") = ""1"") %>" + NL
    t = t + "<h2><%= H(d) %></h2>" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td><b>Registrant:</b></td><td><%= H(NameOf(viewer)) %></td></tr>" + NL
    t = t + "<tr><td><b>Registered:</b></td><td><%= H(rec[2]) %></td></tr>" + NL
    t = t + "<tr><td><b>Expires:</b></td><td><%= H(rec[3]) %></td></tr>" + NL
    t = t + "<tr><td><b>Name server:</b></td><td><%= H(here) %> (SimDNS)</td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "" + NL
    t = t + "<h3>Records</h3>" + NL
    t = t + "<% IF rows = """" THEN %>" + NL
    t = t + "<p>No records yet, so <%= H(d) %> doesn't lead anywhere. Add a CNAME to the machine your pages are on," + NL
    t = t + "or press <b>Host it here</b> below.</p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<table cellpadding=""4"" border=""1"" cellspacing=""0"">" + NL
    t = t + "<tr bgcolor=""#CCCCFF""><th>Name</th><th>Type</th><th>Points at</th><th>&nbsp;</th></tr>" + NL
    t = t + "<%= rows %>" + NL
    t = t + "</table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<form action=""record.asp"" method=""post"">" + NL
    t = t + "<%= TokenField() %><input type=""hidden"" name=""d"" value=""<%= H(d) %>""><input type=""hidden"" name=""op"" value=""add"">" + NL
    t = t + "<table cellpadding=""3"" bgcolor=""#EEEEFF""><tr><td>" + NL
    t = t + "<input name=""name"" size=""10"" value=""www"">.<%= H(d) %>" + NL
    t = t + "<select name=""type""><option value=""CNAME"" selected>CNAME</option><option value=""A"">A</option><option value=""MX"">MX</option><option value=""TXT"">TXT</option><option value=""NS"">NS</option></select>" + NL
    t = t + "<input name=""value"" size=""24"" value=""<%= H(here) %>"">" + NL
    t = t + "<input type=""submit"" value=""Add Record"">" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "</form>" + NL
    t = t + "<p><font size=""2""><b>CNAME</b> points a name at a SIM95 machine (<tt><%= H(here) %></tt>) or at another name." + NL
    t = t + "Use <tt>@</tt> for <%= H(d) %> itself. <b>A</b> takes an address, but addresses change when a machine restarts," + NL
    t = t + "so CNAME is the one to use. <b>MX</b> names your mail machine (<tt>10 <%= H(here) %></tt>). <b>TXT</b> is a line of text. <b>NS</b> hands a part of your domain (<tt>east</tt>) to the SimDNS on another machine.</font></p>" + NL
    t = t + "" + NL
    t = t + "<h3>Web site</h3>" + NL
    t = t + "<% IF folder <> """" THEN %>" + NL
    t = t + "<p><%= H(d) %> is hosted here, in <tt><%= H(folder) %></tt>. Its addresses:</p>" + NL
    t = t + "<p><%= Addresses(d) %></p>" + NL
    t = t + "<p><font size=""2"">Put your pages in that folder (Files, Notes or <tt>scp</tt>). Use relative links (<tt>href=""page.htm""</tt>), so they work at both addresses.</font></p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<form action=""hostit.asp"" method=""post""><%= TokenField() %><input type=""hidden"" name=""d"" value=""<%= H(d) %>"">" + NL
    t = t + "<p><input type=""submit"" value=""Host it here""> - a folder for your pages on <%= H(here) %>, and <tt><%= H(d) %></tt> and <tt>www.<%= H(d) %></tt> pointed at it.</p>" + NL
    t = t + "</form>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<% IF apps.Count > 0 THEN %>" + NL
    t = t + "<h3>Your apps on <%= H(here) %></h3>" + NL
    t = t + "<p>This machine runs several web apps, each in a folder. SimNIC can give each a name of its own in your domain:</p>" + NL
    t = t + "<ul><%= names %></ul>" + NL
    t = t + "<form action=""apps.asp"" method=""post""><%= TokenField() %><input type=""hidden"" name=""d"" value=""<%= H(d) %>"">" + NL
    t = t + "<input type=""submit"" value=""Point these names at the apps""></form>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\DOMAIN.ASP")
END SUB

SUB File2 ()
    t = ""
    t = t + "<%@ import file=""NIC.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' HELP.ASP - Frequently Asked Questions." + NL
    t = t + "VAR here AS String" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "here = SERVER.Name.Lower()" + NL
    t = t + "%><%= Top(""Help"") %>" + NL
    t = t + "<h2>Frequently Asked Questions</h2>" + NL
    t = t + "" + NL
    t = t + "<h4>What is a domain name?</h4>" + NL
    t = t + "<p>Every machine on the SIM95 network has one name, like <tt><%= H(here) %></tt>, and an address" + NL
    t = t + "like 65.16.0.7 that changes each time it starts. A domain name, like <tt>coolsite.sim</tt>, is a" + NL
    t = t + "name of your own that you can point at any machine, and point somewhere else later.</p>" + NL
    t = t + "" + NL
    t = t + "<h4>How do people find my domain?</h4>" + NL
    t = t + "<p>Their computer asks a <b>name server</b>. This machine runs one (SimDNS), and it answers for" + NL
    t = t + "every domain registered here. In Simxplorer, choose <b>View, Options</b> and set the name server" + NL
    t = t + "to <tt><%= H(here) %></tt>. From the Terminal, <tt>DIG SET <%= H(here) %></tt> does the same for" + NL
    t = t + "every program on that machine. Then try <tt>DIG www.coolsite.sim</tt>.</p>" + NL
    t = t + "" + NL
    t = t + "<h4>What records should I make?</h4>" + NL
    t = t + "<p>A <b>CNAME</b> to the machine your pages are on: <tt>www CNAME <%= H(here) %></tt>. The name" + NL
    t = t + "server follows CNAMEs (to other names in your domain, too) until it reaches a machine name, and" + NL
    t = t + "the machine is then found the ordinary SIM95 way. An <b>A</b> record holds an address, which" + NL
    t = t + "goes stale as soon as that machine restarts: use one only if you know why. <b>MX</b> says which" + NL
    t = t + "machine takes your mail; <b>TXT</b> is any line of text.</p>" + NL
    t = t + "" + NL
    t = t + "<h4>What does Host it here do?</h4>" + NL
    t = t + "<p>It makes a folder for your pages on <%= H(here) %> (in <tt>C:\WEB\SITES</tt>), tells the web" + NL
    t = t + "server to serve it for your domain and its www, and points both at <%= H(here) %>. Simxplorer" + NL
    t = t + "users with this name server type <tt>http://www.coolsite.sim/</tt>. Voyager doesn't know name" + NL
    t = t + "servers, so it goes by path: <tt>http://<%= H(here) %>/www.coolsite.sim/</tt>. Use relative" + NL
    t = t + "links in your pages and both work.</p>" + NL
    t = t + "" + NL
    t = t + "<h4>Can my name point at another machine's name server?</h4>" + NL
    t = t + "<p>Yes. Add a record <tt>east NS bravo</tt> and questions about <tt>east.coolsite.sim</tt> (and" + NL
    t = t + "anything under it) go to the SimDNS on BRAVO.</p>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\HELP.ASP")
END SUB

SUB File3 ()
    t = ""
    t = t + "<%@ import file=""NIC.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' HOME.ASP - My Domains: everything you have registered, and a box to get more." + NL
    t = t + "VAR mine AS Array OF String" + NL
    t = t + "VAR d AS String" + NL
    t = t + "VAR rows AS String" + NL
    t = t + "VAR rec AS Array OF String" + NL
    t = t + "VAR why AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "mine = DomainsOf(viewer)" + NL
    t = t + "FOR EACH d IN mine" + NL
    t = t + "    rec = DomainRec(d)" + NL
    t = t + "    rows = rows + ""<tr><td><a href=""""domain.asp?d="" + UrlEnc(d) + """"""><b>"" + H(d) + ""</b></a></td><td>"" + H(rec[2]) + ""</td><td>"" + H(rec[3]) + ""</td><td>""" + NL
    t = t + "    IF SiteFolder(d) <> """" THEN" + NL
    t = t + "        rows = rows + ""hosted here""" + NL
    t = t + "    ELSE" + NL
    t = t + "        rows = rows + ""&nbsp;""" + NL
    t = t + "    END IF" + NL
    t = t + "    rows = rows + ""</td></tr>""" + NL
    t = t + "NEXT" + NL
    t = t + "why = REQUEST.Query(""why"")" + NL
    t = t + "IF REQUEST.Query(""new"") = ""1"" THEN why = ""Welcome to SimNIC! Search for a name below and register it.""" + NL
    t = t + "%><%= Top(""My Domains"") %>" + NL
    t = t + "<%= Notice(why, REQUEST.Query(""new"") = ""1"") %>" + NL
    t = t + "<h2>My Domains</h2>" + NL
    t = t + "<p>Contact: <b><%= H(NameOf(viewer)) %></b> (<%= H(viewer) %>)</p>" + NL
    t = t + "<% IF mine.Count = 0 THEN %>" + NL
    t = t + "<p>You haven't registered any domains yet.</p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<table cellpadding=""5"" border=""1"" cellspacing=""0"">" + NL
    t = t + "<tr bgcolor=""#CCCCFF""><th>Domain</th><th>Registered</th><th>Expires</th><th>Web site</th></tr>" + NL
    t = t + "<%= rows %>" + NL
    t = t + "</table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<h3>Register a new domain</h3>" + NL
    t = t + "<form action=""search.asp"" method=""get"">www.<input name=""d"" size=""24""> <input type=""submit"" value=""Search""></form>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\HOME.ASP")
END SUB

SUB File4 ()
    t = ""
    t = t + "<%@ import file=""NIC.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' HOSTIT.ASP - Host it here (POST d): a folder in C:\WEB\SITES, a line in" + NL
    t = t + "' C:\WEB\VHOSTS.TXT for the domain and its www, and CNAMEs to this machine." + NL
    t = t + "VAR d AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""home.asp"")" + NL
    t = t + "d = CleanDomain(REQUEST.Form(""d""))" + NL
    t = t + "IF NOT Owns(viewer, d) THEN RESPONSE.Redirect(""home.asp?why="" + UrlEnc(""That is not one of your domains.""))" + NL
    t = t + "problem = HostHere(d)" + NL
    t = t + "IF problem <> """" THEN RESPONSE.Redirect(""domain.asp?d="" + UrlEnc(d) + ""&why="" + UrlEnc(problem))" + NL
    t = t + "RESPONSE.Redirect(""domain.asp?d="" + UrlEnc(d) + ""&ok=1&why="" + UrlEnc(d + "" is hosted here. Put your pages in "" + SiteFolder(d) + "".""))" + NL
    t = t + "%>" + NL
    Put("C:\WEB\HOSTIT.ASP")
END SUB

SUB File5 ()
    t = ""
    t = t + "<%@ import file=""NIC.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' INDEX.ASP - SimNIC's front page: look a name up, log in or sign up." + NL
    t = t + "VAR taken AS Integer" + NL
    t = t + "VAR why AS String" + NL
    t = t + "VAR cost AS String" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "taken = CountDomains()" + NL
    t = t + "why = REQUEST.Query(""why"")" + NL
    t = t + "IF REQUEST.Query(""e"") = ""login"" THEN why = ""That user name and password don't match.""" + NL
    t = t + "IF REQUEST.Query(""e"") = ""bye"" THEN why = ""You are logged out. Thank you for using SimNIC.""" + NL
    t = t + "cost = ""<b>FREE</b> while the SIM95 network is young""" + NL
    t = t + "IF PayOn() THEN cost = ""<b>&sect;"" + NICPRICE + ""</b> for two years, paid with SimPal""" + NL
    t = t + "%><%= Top(""Domain Name Registration"") %>" + NL
    t = t + "<%= Notice(why, FALSE) %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8""><tr><td valign=""top"">" + NL
    t = t + "<h2>Register your own domain name!</h2>" + NL
    t = t + "<p>Why be <tt>http://<%= H(SERVER.Name.Lower()) %>/~you/</tt> when you can be" + NL
    t = t + "<b>www.<i>yourname</i>.sim</b>? A domain name is yours to keep, wherever your" + NL
    t = t + "pages live: point it at any machine on the network, and change it any time.</p>" + NL
    t = t + "<form action=""search.asp"" method=""get"">" + NL
    t = t + "<table bgcolor=""#000066"" cellpadding=""6""><tr><td><font color=""#FFFFFF""><b>Is your name taken?</b></font><br>" + NL
    t = t + "<font color=""#FFFFFF"">www.</font><input name=""d"" size=""24""> <input type=""submit"" value=""Search""></td></tr></table>" + NL
    t = t + "</form>" + NL
    t = t + "<p><font size=""2"">.sim, .com, .net and .org. Registration is <%= cost %>.</font></p>" + NL
    t = t + "<h3>What's New</h3>" + NL
    t = t + "<ul>" + NL
    t = t + "<li><b>Host it here!</b> Register a name and have your site on <%= H(SERVER.Name.Lower()) %> in one step.</li>" + NL
    t = t + "<li><b>Point names at machines.</b> SIM95 addresses change every time a machine starts, but its name doesn't:" + NL
    t = t + "SimNIC records are CNAMEs to machine names, so your domain always finds you.</li>" + NL
    t = t + "<li><%= taken %> domain<% IF taken <> 1 THEN %>s<% END IF %> registered so far. Don't wait - the good ones are going fast!</li>" + NL
    t = t + "</ul>" + NL
    t = t + "<p><font size=""2"">To use names like these, set your browser's <b>name server</b> to <b><%= H(SERVER.Name.Lower()) %></b>" + NL
    t = t + "(Simxplorer: View, Options). Voyager users can still visit any site hosted here at" + NL
    t = t + "<tt>http://<%= H(SERVER.Name.Lower()) %>/www.<i>yourname</i>.sim/</tt>. <a href=""help.asp"">More help</a>.</font></p>" + NL
    t = t + "</td><td valign=""top"" width=""230"" bgcolor=""#EEEEFF"">" + NL
    t = t + "<% IF viewer <> """" THEN %>" + NL
    t = t + "<p>Welcome back, <b><%= H(NameOf(viewer)) %></b>.</p>" + NL
    t = t + "<p><a href=""home.asp"">My Domains</a></p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<form action=""login.asp"" method=""post"">" + NL
    t = t + "<b>Existing contacts</b><br>" + NL
    t = t + "<font size=""2"">User name</font><br><input name=""u"" size=""14""><br>" + NL
    t = t + "<font size=""2"">Password</font><br><input type=""password"" name=""pw"" size=""14""><br>" + NL
    t = t + "<input type=""submit"" value=""Log In"">" + NL
    t = t + "</form>" + NL
    t = t + "<hr>" + NL
    t = t + "<form action=""join.asp"" method=""post"">" + NL
    t = t + "<b>New contact? Sign up</b><br>" + NL
    t = t + "<font size=""2"">Your name or company</font><br><input name=""name"" size=""18""><br>" + NL
    t = t + "<font size=""2"">User name (3-8 letters)</font><br><input name=""u"" size=""14""><br>" + NL
    t = t + "<font size=""2"">Password</font><br><input type=""password"" name=""pw"" size=""14""><br>" + NL
    t = t + "<font size=""2"">Password again</font><br><input type=""password"" name=""pw2"" size=""14""><br>" + NL
    t = t + "<input type=""submit"" value=""Sign Up"">" + NL
    t = t + "</form>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\INDEX.ASP")
END SUB

SUB File6 ()
    t = ""
    t = t + "<%@ import file=""NIC.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' JOIN.ASP - makes a new contact (an account) and logs it in." + NL
    t = t + "VAR u AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "u = REQUEST.Form(""u"").Trim().Lower()" + NL
    t = t + "IF REQUEST.Form(""pw"") <> REQUEST.Form(""pw2"") THEN" + NL
    t = t + "    problem = ""The two passwords are different.""" + NL
    t = t + "ELSE" + NL
    t = t + "    problem = CreateUser(u, REQUEST.Form(""pw""), REQUEST.Form(""name""))" + NL
    t = t + "END IF" + NL
    t = t + "IF problem <> """" THEN RESPONSE.Redirect(""index.asp?why="" + UrlEnc(problem))" + NL
    t = t + "SignIn(u)" + NL
    t = t + "RESPONSE.Redirect(""home.asp?new=1"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\JOIN.ASP")
END SUB

SUB File7 ()
    t = ""
    t = t + "<%@ import file=""NIC.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' LOGIN.ASP - checks the password, hands out a session cookie, and moves on." + NL
    t = t + "VAR u AS String" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "u = REQUEST.Form(""u"").Trim().Lower()" + NL
    t = t + "IF NOT CheckPassword(u, REQUEST.Form(""pw"")) THEN RESPONSE.Redirect(""index.asp?e=login"")" + NL
    t = t + "SignIn(u)" + NL
    t = t + "RESPONSE.Redirect(""home.asp"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\LOGIN.ASP")
END SUB

SUB File8 ()
    t = ""
    t = t + "<%@ import file=""NIC.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' LOGOUT.ASP?t=token - forgets the session. The token stops another site" + NL
    t = t + "' from logging you out." + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "SignOut()" + NL
    t = t + "RESPONSE.Redirect(""index.asp?e=bye"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\LOGOUT.ASP")
END SUB

SUB File9 ()
    t = ""
    t = t + "' NIC.SPK - SimNIC, the domain name registrar (InterNIC, 1996). Every page" + NL
    t = t + "' pulls this in with <%@ import file=""NIC.SPK"" %>." + NL
    t = t + "'" + NL
    t = t + "' A domain registered here is a zone this machine's name server (NAMED.SPK)" + NL
    t = t + "' answers for. SimNIC writes the zone file and lists it in NAMED.CNF; NAMED" + NL
    t = t + "' sees the change within a few seconds. Records point names at machines" + NL
    t = t + "' with CNAMEs (""www CNAME alpha""), since addresses change and names don't." + NL
    t = t + "'" + NL
    t = t + "'   C:\NICDATA\USERS\<user>.TXT     an account, key=value (password salted + hashed)" + NL
    t = t + "'   C:\NICDATA\SESSIONS\<id>.TXT    who a sign-in cookie belongs to, and its form token" + NL
    t = t + "'   C:\NICDATA\DOMAINS.TXT          domain|owner|registered|expires|zone file|status" + NL
    t = t + "'   C:\NICDATA\ORDERS\<order>.TXT   a registration waiting to be paid for with SimPal" + NL
    t = t + "'   C:\NICDATA\LOCK\                exists while a page is handing out a domain" + NL
    t = t + "'   C:\DNS\NAMED.CNF                ""primary coolsite.sim COOLSITE.SIM"", one a zone" + NL
    t = t + "'   C:\DNS\<file>                   the zone files" + NL
    t = t + "'   C:\WEB\VHOSTS.TXT               sites this machine's web server serves by name" + NL
    t = t + "'   C:\WEB\SITES\<NAME>             the pages of a site hosted here" + NL
    t = t + "'" + NL
    t = t + "' Status is ""active"", or ""unpaid"" while its owner is off paying at SimPal" + NL
    t = t + "' (it is held for HOLDMINUTES, then anyone may have it)." + NL
    t = t + "" + NL
    t = t + "CONST DATADIR = ""C:\NICDATA""" + NL
    t = t + "CONST DNSDIR = ""C:\DNS""" + NL
    t = t + "CONST NAMEDCNF = ""C:\DNS\NAMED.CNF""" + NL
    t = t + "CONST VHOSTFILE = ""C:\WEB\VHOSTS.TXT""" + NL
    t = t + "CONST SITESDIR = ""C:\WEB\SITES""" + NL
    t = t + "CONST COOKIE = ""simnic""" + NL
    t = t + "CONST TLDS = ""|sim|com|net|org|""" + NL
    t = t + "CONST NICPRICE = ""70.00""            ' two years, as InterNIC charged in 1996" + NL
    t = t + "CONST NICPAL = ""simnic""        ' the SimPal account the money goes to" + NL
    t = t + "CONST HOLDMINUTES = 15" + NL
    t = t + "CONST MAXDOMAINS = 10            ' each, so My Domains fits a page" + NL
    t = t + "CONST MAXRECORDS = 40            ' each zone, so its page fits a message" + NL
    t = t + "CONST MAXNAME = 40" + NL
    t = t + "" + NL
    t = t + "VAR viewer AS String" + NL
    t = t + "VAR formToken AS String" + NL
    t = t + "VAR whyNot AS String             ' what a failed action said" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the disk" + NL
    t = t + "" + NL
    t = t + "' Where these pages are: C:\WEB, or C:\WEB\DNS on a SimHost machine." + NL
    t = t + "FUNCTION AppDir () AS String" + NL
    t = t + "    VAR page AS String" + NL
    t = t + "    page = SERVER.ScriptName" + NL
    t = t + "    RETURN page.Substring(0, page.Length - page.Split(""\"")[page.Split(""\"").Count - 1].Length - 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where SimNIC is on the web, by this machine's name: http://host/ or http://host/dns/" + NL
    t = t + "FUNCTION SiteUrl () AS String" + NL
    t = t + "    IF AppDir().Upper() = ""C:\WEB"" THEN RETURN ""http://"" + SERVER.Name.Lower() + ""/""" + NL
    t = t + "    RETURN ""http://"" + SERVER.Name.Lower() + ""/"" + AppDir().Substring(7, AppDir().Length - 7).Replace(""\"", ""/"").Lower() + ""/""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB EnsureDisk ()" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR dirs AS Array OF String" + NL
    t = t + "    dirs = [DATADIR, DATADIR + ""\USERS"", DATADIR + ""\SESSIONS"", DATADIR + ""\ORDERS"", DNSDIR, SITESDIR]" + NL
    t = t + "    FOR EACH dir IN dirs" + NL
    t = t + "        IF NOT FS.Exists(dir) THEN FS.MakeDir(dir)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION H (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.HtmlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UrlEnc (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.UrlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION OnlyFrom (s AS String, allowed AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        IF NOT allowed.Contains(s.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Clip (s AS String, most AS Integer) AS String" + NL
    t = t + "    s = s.Replace(Chr(13), """").Replace(Chr(10), "" "").Replace(""|"", "" "").Trim()" + NL
    t = t + "    IF s.Length > most THEN s = s.Substring(0, most)" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Esc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%"", ""%25"").Replace(""|"", ""%7C"").Replace(Chr(13), """").Replace(Chr(10), ""%0A"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unesc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%0A"", Chr(10)).Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- accounts (as SimBook's)" + NL
    t = t + "" + NL
    t = t + "FUNCTION ValidUser (u AS String) AS Bool" + NL
    t = t + "    IF u.Length < 3 OR u.Length > 8 THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyFrom(u, ""abcdefghijklmnopqrstuvwxyz0123456789"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UserPath (u AS String) AS String" + NL
    t = t + "    RETURN DATADIR + ""\USERS\"" + u + "".TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UserExists (u AS String) AS Bool" + NL
    t = t + "    IF NOT ValidUser(u) THEN RETURN FALSE" + NL
    t = t + "    RETURN FS.Exists(UserPath(u))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Field (rec AS Array OF String, key AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN rec" + NL
    t = t + "        IF line.StartsWith(key + ""="") THEN RETURN Unesc(line.Substring(key.Length + 1, line.Length - key.Length - 1))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NameOf (u AS String) AS String" + NL
    t = t + "    IF NOT UserExists(u) THEN RETURN u" + NL
    t = t + "    RETURN Field(FS.Read(UserPath(u)).Lines(), ""name"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Not real cryptography - SIM95 has none - but the password itself never" + NL
    t = t + "' touches the disk. Two running hashes over salt + password, kept under 2^31." + NL
    t = t + "FUNCTION Hash (salt AS String, pw AS String) AS String" + NL
    t = t + "    VAR a AS Integer = 7" + NL
    t = t + "    VAR b AS Integer = 31337" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = salt + "":"" + pw + "":"" + salt" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        c = Asc(s.CharAt(i))" + NL
    t = t + "        a = (a * 131 + c) MOD 2147483629" + NL
    t = t + "        b = (b * 257 + c + a) MOD 2147483587" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN Hex(a) + ""-"" + Hex(b)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NewToken () AS String" + NL
    t = t + "    RETURN Hex(268435456 + Rnd(1879048191))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' """" on success, otherwise what is wrong." + NL
    t = t + "FUNCTION CreateUser (u AS String, pw AS String, name AS String) AS String" + NL
    t = t + "    VAR salt AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    IF NOT ValidUser(u) THEN RETURN ""Pick a user name of 3 to 8 letters or digits.""" + NL
    t = t + "    IF FS.Exists(UserPath(u)) THEN RETURN ""Somebody already has the name "" + u + "".""" + NL
    t = t + "    IF pw.Length < 4 THEN RETURN ""Pick a password of at least 4 characters.""" + NL
    t = t + "    name = Clip(name, MAXNAME)" + NL
    t = t + "    IF name = """" THEN RETURN ""Tell us your name (or your company's).""" + NL
    t = t + "    salt = NewToken()" + NL
    t = t + "    FS.Write(UserPath(u), ""name="" + Esc(name) + Chr(10) + ""salt="" + salt + Chr(10) + ""pass="" + Hash(salt, pw) + Chr(10) + ""joined="" + TIME.Date + Chr(10))" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CheckPassword (u AS String, pw AS String) AS Bool" + NL
    t = t + "    VAR rec AS Array OF String" + NL
    t = t + "    IF NOT UserExists(u) THEN RETURN FALSE" + NL
    t = t + "    rec = FS.Read(UserPath(u)).Lines()" + NL
    t = t + "    RETURN Hash(Field(rec, ""salt""), pw) = Field(rec, ""pass"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- sessions" + NL
    t = t + "' The form token stops another site from acting in your name: every form" + NL
    t = t + "' that changes something carries it (TokenField), and every page that" + NL
    t = t + "' changes something checks it (RequireToken), as SimBook does." + NL
    t = t + "" + NL
    t = t + "SUB SignIn (u AS String)" + NL
    t = t + "    VAR token AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    token = NewToken()" + NL
    t = t + "    FS.Write(DATADIR + ""\SESSIONS\"" + token + "".TXT"", u + Chr(10) + NewToken() + NewToken())" + NL
    t = t + "    RESPONSE.SetCookie(COOKIE, token)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION SessionPath () AS String" + NL
    t = t + "    VAR token AS String" + NL
    t = t + "    token = REQUEST.Cookie(COOKIE)" + NL
    t = t + "    IF token = """" OR token.Length > 8 THEN RETURN """"" + NL
    t = t + "    IF NOT OnlyFrom(token, ""0123456789ABCDEF"") THEN RETURN """"" + NL
    t = t + "    RETURN DATADIR + ""\SESSIONS\"" + token + "".TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SignOut ()" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    path = SessionPath()" + NL
    t = t + "    IF path <> """" THEN" + NL
    t = t + "        IF FS.Exists(path) THEN FS.Delete(path)" + NL
    t = t + "    END IF" + NL
    t = t + "    RESPONSE.SetCookie(COOKIE, """")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Who the cookie says is signed in, or """". Also sets formToken." + NL
    t = t + "FUNCTION CurrentUser () AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR u AS String" + NL
    t = t + "    path = SessionPath()" + NL
    t = t + "    IF path = """" THEN RETURN """"" + NL
    t = t + "    IF NOT FS.Exists(path) THEN RETURN """"" + NL
    t = t + "    lines = FS.Read(path).Lines()" + NL
    t = t + "    IF lines.Count < 2 THEN RETURN """"" + NL
    t = t + "    u = lines[0].Trim()" + NL
    t = t + "    IF NOT UserExists(u) THEN RETURN """"" + NL
    t = t + "    formToken = lines[1].Trim()" + NL
    t = t + "    RETURN u" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB RequireLogin ()" + NL
    t = t + "    viewer = CurrentUser()" + NL
    t = t + "    IF viewer = """" THEN RESPONSE.Redirect(""index.asp?why="" + UrlEnc(""Please log in first.""))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RequireToken ()" + NL
    t = t + "    VAR sent AS String" + NL
    t = t + "    sent = REQUEST.Form(""t"")" + NL
    t = t + "    IF sent = """" THEN sent = REQUEST.Query(""t"")" + NL
    t = t + "    IF sent = """" OR sent <> formToken THEN RESPONSE.Redirect(""home.asp?why="" + UrlEnc(""That did not come from a SimNIC page, so nothing was changed.""))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION TokenField () AS String" + NL
    t = t + "    RETURN ""<input type=""""hidden"""" name=""""t"""" value="""""" + formToken + """""">""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the lock" + NL
    t = t + "' Two pages can run at once (one waits, the other runs), so handing out a" + NL
    t = t + "' name is done holding a lock: a folder, which only one page can make." + NL
    t = t + "" + NL
    t = t + "FUNCTION NicLock () AS Bool" + NL
    t = t + "    VAR tries AS Integer" + NL
    t = t + "    VAR got AS Bool" + NL
    t = t + "    VAR at AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    WHILE NOT got AND tries < 150" + NL
    t = t + "        tries = tries + 1" + NL
    t = t + "        TRY" + NL
    t = t + "            FS.MakeDir(DATADIR + ""\LOCK"")" + NL
    t = t + "            got = TRUE" + NL
    t = t + "        CATCH err" + NL
    t = t + "            got = FALSE" + NL
    t = t + "        END TRY" + NL
    t = t + "        IF NOT got THEN" + NL
    t = t + "            at = ReadOr(DATADIR + ""\LOCK\AT.TXT"", """")" + NL
    t = t + "            IF (at <> """" AND TIME.Now - Int(Val(at)) > 10) OR (at = """" AND tries MOD 50 = 0) THEN" + NL
    t = t + "                NicUnlock()" + NL
    t = t + "            ELSE" + NL
    t = t + "                SYS.Sleep(20)" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF got THEN FS.Write(DATADIR + ""\LOCK\AT.TXT"", Str(TIME.Now))" + NL
    t = t + "    RETURN got" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB NicUnlock ()" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(DATADIR + ""\LOCK\AT.TXT"") THEN FS.Delete(DATADIR + ""\LOCK\AT.TXT"")" + NL
    t = t + "        IF FS.Exists(DATADIR + ""\LOCK"") THEN FS.Delete(DATADIR + ""\LOCK"")" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- domain names" + NL
    t = t + "" + NL
    t = t + "' ""CoolSite.SIM "" -> ""coolsite.sim""; """" when it can't be a domain here." + NL
    t = t + "FUNCTION CleanDomain (d AS String) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    d = d.Trim().Lower()" + NL
    t = t + "    IF d.StartsWith(""http://"") THEN d = d.Substring(7, d.Length - 7)" + NL
    t = t + "    IF d.StartsWith(""www."") THEN d = d.Substring(4, d.Length - 4)" + NL
    t = t + "    IF d.Contains(""/"") THEN d = d.Substring(0, d.IndexOf(""/""))" + NL
    t = t + "    IF d.EndsWith(""."") THEN d = d.Substring(0, d.Length - 1)" + NL
    t = t + "    p = d.Split(""."")" + NL
    t = t + "    IF p.Count <> 2 THEN RETURN """"" + NL
    t = t + "    IF NOT TLDS.Contains(""|"" + p[1] + ""|"") THEN RETURN """"" + NL
    t = t + "    IF p[0].Length < 2 OR p[0].Length > 24 THEN RETURN """"" + NL
    t = t + "    IF NOT OnlyFrom(p[0], ""abcdefghijklmnopqrstuvwxyz0123456789-"") THEN RETURN """"" + NL
    t = t + "    IF p[0].StartsWith(""-"") OR p[0].EndsWith(""-"") THEN RETURN """"" + NL
    t = t + "    RETURN d" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The line in DOMAINS.TXT for a domain, split, or an empty array. An unpaid" + NL
    t = t + "' hold that has run out counts as nothing." + NL
    t = t + "FUNCTION DomainRec (d AS String) AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\DOMAINS.TXT"", """").Lines()" + NL
    t = t + "        p = line.Split(""|"")" + NL
    t = t + "        IF p.Count >= 6 THEN" + NL
    t = t + "            IF p[0] = d THEN" + NL
    t = t + "                IF p[5] = ""unpaid"" AND TIME.Now - Int(Val(p[2])) > HOLDMINUTES * 60 THEN RETURN none" + NL
    t = t + "                RETURN p" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN none" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CountDomains () AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\DOMAINS.TXT"", """").Lines()" + NL
    t = t + "        IF line.EndsWith(""|active"") THEN n = n + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsFree (d AS String) AS Bool" + NL
    t = t + "    RETURN DomainRec(d).Count = 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is the domain this user's, and active?" + NL
    t = t + "FUNCTION Owns (u AS String, d AS String) AS Bool" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    p = DomainRec(d)" + NL
    t = t + "    IF p.Count < 6 THEN RETURN FALSE" + NL
    t = t + "    RETURN p[1] = u AND p[5] = ""active""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Every active domain of a user, sorted." + NL
    t = t + "FUNCTION DomainsOf (u AS String) AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\DOMAINS.TXT"", """").Lines()" + NL
    t = t + "        p = line.Split(""|"")" + NL
    t = t + "        IF p.Count >= 6 THEN" + NL
    t = t + "            IF p[1] = u AND p[5] = ""active"" THEN out.Add(p[0])" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    out.Sort()" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' DOMAINS.TXT with the line for d replaced by line ("""" takes it out)." + NL
    t = t + "SUB SetDomainLine (d AS String, line AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    FOR EACH l IN ReadOr(DATADIR + ""\DOMAINS.TXT"", """").Lines()" + NL
    t = t + "        IF l.Trim() = """" OR l.StartsWith(d + ""|"") THEN CONTINUE" + NL
    t = t + "        out.Add(l)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF line <> """" THEN out.Add(line)" + NL
    t = t + "    FS.Write(DATADIR + ""\DOMAINS.TXT"", out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Two years from today: ""1996-07-04"" -> ""1998-07-04""." + NL
    t = t + "FUNCTION TwoYears () AS String" + NL
    t = t + "    RETURN Str(Int(Val(TIME.Date.Substring(0, 4))) + 2) + TIME.Date.Substring(4, TIME.Date.Length - 4)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Should registering cost SimBucks? Only with SimPal on this machine, and a" + NL
    t = t + "' SimPal account for SimNIC to be paid into." + NL
    t = t + "FUNCTION PayOn () AS Bool" + NL
    t = t + "    RETURN FS.Exists(""C:\PALDATA"") AND FS.Exists(""C:\PROGRAMS\PALCHECK.SPK"") AND FS.Exists(""C:\PALDATA\USERS\"" + NICPAL + "".TXT"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION SimPalHere () AS Bool" + NL
    t = t + "    RETURN FS.Exists(""C:\PALDATA"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where SimPal takes payments on this machine (PALCHECK.SPK's PalPayUrl)." + NL
    t = t + "FUNCTION PayUrl () AS String" + NL
    t = t + "    IF FS.Exists(""C:\WEB\PAL\PAL.SPK"") THEN RETURN ""http://"" + SERVER.Name.Lower() + ""/pal/pay.asp""" + NL
    t = t + "    RETURN ""http://"" + SERVER.Name.Lower() + ""/pay.asp""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Registers d to u: free, or held while they pay ("""" and the order number" + NL
    t = t + "' in whyNot). Returns """" when done, or what is wrong." + NL
    t = t + "FUNCTION Register (u AS String, d AS String) AS String" + NL
    t = t + "    VAR order AS String" + NL
    t = t + "    IF d = """" THEN RETURN ""That is not a domain name SimNIC can register: try something like coolsite.sim (.sim, .com, .net or .org).""" + NL
    t = t + "    IF DomainsOf(u).Count >= MAXDOMAINS THEN RETURN ""SimNIC registers at most "" + Str(MAXDOMAINS) + "" domains per contact.""" + NL
    t = t + "    IF NOT NicLock() THEN RETURN ""SimNIC is very busy. Please try again.""" + NL
    t = t + "    IF NOT IsFree(d) THEN" + NL
    t = t + "        NicUnlock()" + NL
    t = t + "        RETURN ""Sorry, "" + d + "" is already registered.""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF PayOn() THEN" + NL
    t = t + "        order = NewToken()" + NL
    t = t + "        FS.Write(DATADIR + ""\ORDERS\"" + order + "".TXT"", d + ""|"" + u + ""|"" + Str(TIME.Now))" + NL
    t = t + "        SetDomainLine(d, d + ""|"" + u + ""|"" + Str(TIME.Now) + ""||"" + ""|unpaid"")" + NL
    t = t + "        NicUnlock()" + NL
    t = t + "        whyNot = order" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    Activate(u, d)" + NL
    t = t + "    NicUnlock()" + NL
    t = t + "    whyNot = """"" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Makes d u's: its zone file, its line in NAMED.CNF, and DOMAINS.TXT. Call" + NL
    t = t + "' it holding the lock." + NL
    t = t + "SUB Activate (u AS String, d AS String)" + NL
    t = t + "    VAR file AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    p = DomainRec(d)" + NL
    t = t + "    file = """"" + NL
    t = t + "    IF p.Count >= 6 THEN file = p[4]" + NL
    t = t + "    IF file = """" THEN file = ZoneFileFor(d)" + NL
    t = t + "    IF NOT FS.Exists(DNSDIR + ""\"" + file) THEN" + NL
    t = t + "        FS.Write(DNSDIR + ""\"" + file, ""; "" + d + "" - registered to "" + u + "" at SimNIC on "" + TIME.Date + Chr(10) _" + NL
    t = t + "            + ""; Written by SimNIC on "" + SERVER.Name.Lower() + "". Change the records there, or here with Notes."" + Chr(10) _" + NL
    t = t + "            + ""$TTL 60"" + Chr(10) _" + NL
    t = t + "            + ""@        IN  SOA    "" + SERVER.Name.Lower() + "" hostmaster ( "" + TIME.Date.Replace(""-"", """") + ""01 )"" + Chr(10) _" + NL
    t = t + "            + ""@        IN  NS     "" + SERVER.Name.Lower() + Chr(10))" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT (Chr(10) + ReadOr(NAMEDCNF, """")).Lower().Contains(Chr(10) + ""primary "" + d + "" "") THEN" + NL
    t = t + "        FS.Append(NAMEDCNF, ""primary "" + d + "" "" + file + Chr(10))" + NL
    t = t + "    END IF" + NL
    t = t + "    SetDomainLine(d, d + ""|"" + u + ""|"" + TIME.Date + ""|"" + TwoYears() + ""|"" + file + ""|active"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A file name for a zone: COOLSITE.SIM, or COOLSI01.SIM if that is taken." + NL
    t = t + "FUNCTION ZoneFileFor (d AS String) AS String" + NL
    t = t + "    VAR label AS String" + NL
    t = t + "    VAR ext AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    label = d.Split(""."")[0].Replace(""-"", """").Upper()" + NL
    t = t + "    ext = d.Split(""."")[1].Upper()" + NL
    t = t + "    IF label.Length > 8 THEN label = label.Substring(0, 8)" + NL
    t = t + "    name = label + ""."" + ext" + NL
    t = t + "    IF NOT FS.Exists(DNSDIR + ""\"" + name) THEN RETURN name" + NL
    t = t + "    IF label.Length > 6 THEN label = label.Substring(0, 6)" + NL
    t = t + "    FOR n = 1 TO 99" + NL
    t = t + "        name = label + Str(n).PadLeft(2).Replace("" "", ""0"") + ""."" + ext" + NL
    t = t + "        IF NOT FS.Exists(DNSDIR + ""\"" + name) THEN RETURN name" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN ""Z"" + Hex(Rnd(65536)) + ""."" + ext" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ZonePath (d AS String) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    p = DomainRec(d)" + NL
    t = t + "    IF p.Count < 6 THEN RETURN """"" + NL
    t = t + "    RETURN DNSDIR + ""\"" + p[4]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- records" + NL
    t = t + "' A zone file is its head (comments, $TTL, the SOA and the domain's NS: kept" + NL
    t = t + "' as they are) and then its records, one a line: name IN TYPE value." + NL
    t = t + "" + NL
    t = t + "FUNCTION Words (s AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    FOR EACH p IN s.Replace(Chr(9), "" "").Split("" "")" + NL
    t = t + "        IF p <> """" THEN out.Add(p)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is this line of a zone file part of its head?" + NL
    t = t + "FUNCTION IsHead (line AS String) AS Bool" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    t = line.Trim()" + NL
    t = t + "    IF t = """" OR t.StartsWith("";"") OR t.StartsWith(""$"") THEN RETURN TRUE" + NL
    t = t + "    w = Words(t.Replace(""("", "" "").Replace("")"", "" ""))" + NL
    t = t + "    IF w.Contains(""SOA"") OR w.Contains(""soa"") THEN RETURN TRUE" + NL
    t = t + "    IF w.Count >= 3 AND w[0] = ""@"" AND (w[w.Count - 2].Upper() = ""NS"") THEN RETURN TRUE" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The record lines of a zone (not its head)." + NL
    t = t + "FUNCTION Records (d AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR inside AS Bool" + NL
    t = t + "    FOR EACH line IN ReadOr(ZonePath(d), """").Lines()" + NL
    t = t + "        IF inside THEN" + NL
    t = t + "            IF line.Contains("")"") THEN inside = FALSE" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF line.Contains(""("") AND NOT line.Contains("")"") THEN" + NL
    t = t + "            inside = TRUE" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF NOT IsHead(line) THEN out.Add(line.Replace(Chr(13), """"))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Writes the zone again: its head as it was, then these records." + NL
    t = t + "SUB SaveRecords (d AS String, recs AS Array OF String)" + NL
    t = t + "    VAR head AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR inside AS Bool" + NL
    t = t + "    FOR EACH line IN ReadOr(ZonePath(d), """").Lines()" + NL
    t = t + "        IF inside THEN" + NL
    t = t + "            head.Add(line)" + NL
    t = t + "            IF line.Contains("")"") THEN inside = FALSE" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF line.Contains(""("") AND NOT line.Contains("")"") THEN" + NL
    t = t + "            head.Add(line)" + NL
    t = t + "            inside = TRUE" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF IsHead(line) AND line.Trim() <> """" THEN head.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH line IN recs" + NL
    t = t + "        head.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Write(ZonePath(d), head.Join(Chr(10)) + Chr(10))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One record as a zone file line, lined up." + NL
    t = t + "FUNCTION RecordLine (owner AS String, rtype AS String, value AS String) AS String" + NL
    t = t + "    RETURN owner.PadRight(8) + "" IN  "" + rtype.PadRight(6) + "" "" + value" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Takes a record from the form apart and checks it. Sets recOwner," + NL
    t = t + "' recType, recValue; returns """" or what is wrong." + NL
    t = t + "VAR recOwner AS String" + NL
    t = t + "VAR recType AS String" + NL
    t = t + "VAR recValue AS String" + NL
    t = t + "" + NL
    t = t + "FUNCTION CheckRecord (owner AS String, rtype AS String, value AS String) AS String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    owner = owner.Trim().Lower()" + NL
    t = t + "    rtype = rtype.Trim().Upper()" + NL
    t = t + "    value = value.Trim()" + NL
    t = t + "    IF owner = """" THEN owner = ""@""" + NL
    t = t + "    IF owner.EndsWith(""."") THEN RETURN ""Give the name without the domain: www, not www.coolsite.sim.""" + NL
    t = t + "    IF owner <> ""@"" THEN" + NL
    t = t + "        IF owner.Length > MAXNAME OR NOT OnlyFrom(owner, ""abcdefghijklmnopqrstuvwxyz0123456789-.*"") OR owner.StartsWith(""."") OR owner.Contains("".."") THEN RETURN ""A name is letters, digits and hyphens, like www or shop.east (or @ for the domain itself).""" + NL
    t = t + "        IF owner.Contains(""*"") AND NOT (owner = ""*"" OR owner.StartsWith(""*."")) THEN RETURN ""A * stands for any name, and goes first: *.east""" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE rtype" + NL
    t = t + "        CASE ""CNAME""" + NL
    t = t + "            value = value.Lower()" + NL
    t = t + "            IF value.EndsWith(""."") THEN value = value.Substring(0, value.Length - 1)" + NL
    t = t + "            IF value = """" OR value.Length > 60 OR NOT OnlyFrom(value, ""abcdefghijklmnopqrstuvwxyz0123456789-.@"") THEN RETURN ""A CNAME points at a machine (alpha) or another name (www.coolsite.sim).""" + NL
    t = t + "        CASE ""A""" + NL
    t = t + "            IF NOT IsAddress(value) THEN RETURN ""An A record needs an address like 65.16.0.7. Addresses change when a machine restarts, so a CNAME to the machine's name is usually better.""" + NL
    t = t + "        CASE ""MX""" + NL
    t = t + "            w = Words(value.Lower())" + NL
    t = t + "            IF w.Count = 1 THEN w.Insert(0, ""10"")" + NL
    t = t + "            IF w.Count <> 2 THEN RETURN ""An MX record is a preference and a mail machine: 10 alpha""" + NL
    t = t + "            IF NOT OnlyFrom(w[0], ""0123456789"") OR w[0].Length > 4 OR NOT OnlyFrom(w[1], ""abcdefghijklmnopqrstuvwxyz0123456789-."") THEN RETURN ""An MX record is a preference and a mail machine: 10 alpha""" + NL
    t = t + "            value = w[0] + "" "" + w[1]" + NL
    t = t + "        CASE ""TXT""" + NL
    t = t + "            value = value.Replace("""""""", ""'"")" + NL
    t = t + "            IF value = """" OR value.Length > 200 OR value.Contains(Chr(10)) OR value.Contains(Chr(13)) THEN RETURN ""A TXT record is one line of up to 200 characters.""" + NL
    t = t + "            value = """""""" + value + """"""""" + NL
    t = t + "        CASE ""NS""" + NL
    t = t + "            value = value.Lower()" + NL
    t = t + "            IF value.EndsWith(""."") THEN value = value.Substring(0, value.Length - 1)" + NL
    t = t + "            IF owner = ""@"" THEN RETURN ""This domain's own name server is SimNIC's. An NS record hands a part of it (east) to another machine's SimDNS.""" + NL
    t = t + "            IF value = """" OR value.Length > 60 OR NOT OnlyFrom(value, ""abcdefghijklmnopqrstuvwxyz0123456789-."") THEN RETURN ""An NS record names the machine running SimDNS for that part of your domain: bravo""" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            RETURN ""SimNIC can make CNAME, A, MX, TXT and NS records.""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    recOwner = owner" + NL
    t = t + "    recType = rtype" + NL
    t = t + "    recValue = value" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsAddress (s AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    IF s.Split(""."").Count <> 4 THEN RETURN FALSE" + NL
    t = t + "    FOR EACH p IN s.Split(""."")" + NL
    t = t + "        IF p = """" OR p.Length > 3 OR NOT OnlyFrom(p, ""0123456789"") THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Adds a record to d (a CNAME takes the place of one already at that name)." + NL
    t = t + "' Returns """" or what is wrong." + NL
    t = t + "FUNCTION AddRecord (d AS String, owner AS String, rtype AS String, value AS String) AS String" + NL
    t = t + "    VAR recs AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR why AS String" + NL
    t = t + "    why = CheckRecord(owner, rtype, value)" + NL
    t = t + "    IF why <> """" THEN RETURN why" + NL
    t = t + "    recs = Records(d)" + NL
    t = t + "    FOR EACH line IN recs" + NL
    t = t + "        w = Words(line)" + NL
    t = t + "        IF w.Count >= 3 THEN" + NL
    t = t + "            IF recType = ""CNAME"" AND w[0].Lower() = recOwner AND RecTypeOf(w) = ""CNAME"" THEN CONTINUE" + NL
    t = t + "            IF w[0].Lower() = recOwner AND RecTypeOf(w) = recType AND RecValueOf(line, w) = recValue THEN CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF out.Count >= MAXRECORDS THEN RETURN ""A domain at SimNIC has at most "" + Str(MAXRECORDS) + "" records.""" + NL
    t = t + "    out.Add(RecordLine(recOwner, recType, recValue))" + NL
    t = t + "    SaveRecords(d, out)" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A record line's type: the word after IN (or after the name)." + NL
    t = t + "FUNCTION RecTypeOf (w AS Array OF String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 1 TO w.Count - 1" + NL
    t = t + "        IF ""|CNAME|A|MX|TXT|NS|"".Contains(""|"" + w[i].Upper() + ""|"") THEN RETURN w[i].Upper()" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN ""?""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RecValueOf (line AS String, w AS Array OF String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR seen AS Bool" + NL
    t = t + "    IF line.Contains("""""""") THEN RETURN line.Substring(line.IndexOf(""""""""), line.Length - line.IndexOf("""""""")).Trim()" + NL
    t = t + "    FOR i = 1 TO w.Count - 1" + NL
    t = t + "        IF seen THEN out.Add(w[i])" + NL
    t = t + "        IF NOT seen AND ""|CNAME|A|MX|TXT|NS|"".Contains(""|"" + w[i].Upper() + ""|"") THEN seen = TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out.Join("" "")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB DeleteRecord (d AS String, n AS Integer)" + NL
    t = t + "    VAR recs AS Array OF String" + NL
    t = t + "    recs = Records(d)" + NL
    t = t + "    IF n < 0 OR n >= recs.Count THEN RETURN" + NL
    t = t + "    recs.RemoveAt(n)" + NL
    t = t + "    SaveRecords(d, recs)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- hosting" + NL
    t = t + "' ""Host it here"": the domain (and www.) become a site on this machine's web" + NL
    t = t + "' server, in a folder of its own, and point here with CNAMEs." + NL
    t = t + "" + NL
    t = t + "' The site's folder, if it is hosted here, from VHOSTS.TXT; else """"." + NL
    t = t + "FUNCTION SiteFolder (d AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(VHOSTFILE, """").Lines()" + NL
    t = t + "        IF line.Lower().StartsWith(d + ""|"") THEN RETURN line.Substring(d.Length + 1, line.Length - d.Length - 1).Trim()" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Adds name|folder to VHOSTS.TXT (or moves name to folder)." + NL
    t = t + "SUB SetVhost (name AS String, folder AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(VHOSTFILE, """").Lines()" + NL
    t = t + "        IF line.Trim() = """" OR line.Lower().StartsWith(name + ""|"") THEN CONTINUE" + NL
    t = t + "        out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    out.Add(name + ""|"" + folder)" + NL
    t = t + "    FS.Write(VHOSTFILE, out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION HostHere (d AS String) AS String" + NL
    t = t + "    VAR folder AS String" + NL
    t = t + "    VAR label AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR here AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    here = SERVER.Name.Lower()" + NL
    t = t + "    folder = SiteFolder(d)" + NL
    t = t + "    IF folder = """" THEN" + NL
    t = t + "        label = d.Split(""."")[0].Replace(""-"", """").Upper()" + NL
    t = t + "        IF label.Length > 8 THEN label = label.Substring(0, 8)" + NL
    t = t + "        folder = SITESDIR + ""\"" + label" + NL
    t = t + "        WHILE FS.Exists(folder) AND n < 99" + NL
    t = t + "            n = n + 1" + NL
    t = t + "            IF label.Length > 6 THEN label = label.Substring(0, 6)" + NL
    t = t + "            folder = SITESDIR + ""\"" + label + Str(n).PadLeft(2).Replace("" "", ""0"")" + NL
    t = t + "        END WHILE" + NL
    t = t + "        IF FS.Exists(folder) THEN RETURN ""There is no room for another site in "" + SITESDIR + "".""" + NL
    t = t + "        FS.MakeDir(folder)" + NL
    t = t + "    ELSEIF NOT FS.Exists(folder) THEN" + NL
    t = t + "        FS.MakeDir(folder)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT FS.Exists(folder + ""\INDEX.HTM"") AND NOT FS.Exists(folder + ""\INDEX.ASP"") THEN" + NL
    t = t + "        FS.Write(folder + ""\INDEX.HTM"", ""<html><head><title>"" + d + ""</title></head>"" + Chr(10) _" + NL
    t = t + "            + ""<body bgcolor=""""#FFFFFF"""">"" + Chr(10) + ""<center><h1>"" + d + ""</h1>"" + Chr(10) _" + NL
    t = t + "            + ""<p><font size=""""4"""">Coming soon!</font></p>"" + Chr(10) _" + NL
    t = t + "            + ""<p><b>This site is under construction.</b> Please come back soon.</p>"" + Chr(10) _" + NL
    t = t + "            + ""<hr width=""""50%""""><p><font size=""""2"""">Registered at SimNIC. Hosted on "" + here + "".</font></p></center>"" + Chr(10) _" + NL
    t = t + "            + ""</body></html>"" + Chr(10))" + NL
    t = t + "    END IF" + NL
    t = t + "    SetVhost(d, folder)" + NL
    t = t + "    SetVhost(""www."" + d, folder)" + NL
    t = t + "    AddRecord(d, ""@"", ""CNAME"", here)" + NL
    t = t + "    AddRecord(d, ""www"", ""CNAME"", here)" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The web apps on this machine, each in a folder of its own (SimHost):" + NL
    t = t + "' folder|name, for those with an APP.INF or a known app in them." + NL
    t = t + "FUNCTION AppFolders () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR known AS Array OF String" + NL
    t = t + "    VAR k AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    known = [""BOOK|BOOK.SPK|SimBook"", ""MAIL|MAIL.SPK|ColdMail"", ""ASK|ASK.SPK|AskSim"", ""GEO|GEO.SPK|GeoSimies"", ""ELIZA|BOT.SPK|ELIZA-95"", ""PAL|PAL.SPK|SimPal"", ""TUBE|TUBE.SPK|SimTube"", ""STATS|STATS.SPK|SimStats"", ""VAPOR|CATALOG.TXT|Vapor""]" + NL
    t = t + "    FOR EACH f IN FS.List(""C:\WEB"")" + NL
    t = t + "        IF NOT f.EndsWith(""\"") THEN CONTINUE" + NL
    t = t + "        f = f.Substring(0, f.Length - 1).Upper()" + NL
    t = t + "        IF f = ""SITES"" THEN CONTINUE" + NL
    t = t + "        IF FS.Exists(""C:\WEB\"" + f + ""\APP.INF"") THEN" + NL
    t = t + "            p = FS.Read(""C:\WEB\"" + f + ""\APP.INF"").Split(""|"")" + NL
    t = t + "            out.Add(f + ""|"" + p[0].Trim())" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        FOR EACH k IN known" + NL
    t = t + "            p = k.Split(""|"")" + NL
    t = t + "            IF p[0] = f AND FS.Exists(""C:\WEB\"" + f + ""\"" + p[1]) THEN out.Add(f + ""|"" + p[2])" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' book.coolsite.sim for C:\WEB\BOOK, and so on: a site each, and a CNAME each." + NL
    t = t + "FUNCTION PointApps (d AS String) AS Integer" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR prefix AS String" + NL
    t = t + "    FOR EACH a IN AppFolders()" + NL
    t = t + "        prefix = a.Split(""|"")[0].Lower()" + NL
    t = t + "        IF AddRecord(d, prefix, ""CNAME"", SERVER.Name.Lower()) = """" THEN" + NL
    t = t + "            SetVhost(prefix + ""."" + d, ""C:\WEB\"" + a.Split(""|"")[0])" + NL
    t = t + "            n = n + 1" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the look" + NL
    t = t + "" + NL
    t = t + "FUNCTION Top (title AS String) AS String" + NL
    t = t + "    RETURN ""<html><head><title>"" + H(title) + "" - SimNIC</title>"" _" + NL
    t = t + "        + ""<meta name=""""description"""" content=""""SimNIC Registration Services: register your own domain name on the SIM95 network. .sim .com .net .org"""">"" _" + NL
    t = t + "        + ""<meta name=""""keywords"""" content=""""domain name, register, registration, internic, whois, dns, .com, .net, .org, .sim, web hosting""""></head>"" + Chr(10) _" + NL
    t = t + "        + ""<body bgcolor=""""#FFFFFF"""" link=""""#000099"""" vlink=""""#663399"""">"" + Chr(10) _" + NL
    t = t + "        + ""<table width=""""100%"""" cellpadding=""""6"""" cellspacing=""""0""""><tr><td bgcolor=""""#000066""""><font color=""""#FFFFFF"""" size=""""6""""><b>SimNIC</b></font>"" _" + NL
    t = t + "        + "" <font color=""""#FFCC00"""" size=""""3""""><i>Registration Services</i></font></td>"" _" + NL
    t = t + "        + ""<td bgcolor=""""#000066"""" align=""""right""""><font color=""""#FFFFFF"""" size=""""2""""><b>.sim &nbsp; .com &nbsp; .net &nbsp; .org</b></font></td></tr>"" _" + NL
    t = t + "        + ""<tr><td colspan=""""2"""" bgcolor=""""#CCCCFF""""><font size=""""2""""><a href=""""index.asp"""">Home</a> | <a href=""""whois.asp"""">WHOIS</a> | <a href=""""home.asp"""">My Domains</a> | <a href=""""help.asp"""">Help</a>"" _" + NL
    t = t + "        + IfText(viewer <> """", "" | <a href=""""logout.asp?t="" + formToken + """""">Log out "" + H(viewer) + ""</a>"") + ""</font></td></tr></table>"" + Chr(10)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Bottom () AS String" + NL
    t = t + "    RETURN ""<hr><center><font size=""""1"""" color=""""#808080"""">SimNIC is a service of Network Simulations, Inc. under agreement with the SIM95 Foundation"" _" + NL
    t = t + "        + "" &middot; "" + H(SERVER.Name) + "" &middot; "" + TIME.Date + ""</font></center></body></html>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IfText (yes AS Bool, text AS String) AS String" + NL
    t = t + "    IF yes THEN RETURN text" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Notice (text AS String, good AS Bool) AS String" + NL
    t = t + "    IF text = """" THEN RETURN """"" + NL
    t = t + "    IF good THEN RETURN ""<table width=""""100%"""" cellpadding=""""6""""><tr><td bgcolor=""""#E0FFE0""""><b>"" + H(text) + ""</b></td></tr></table>""" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""6""""><tr><td bgcolor=""""#FFF0C0""""><b>"" + H(text) + ""</b></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The addresses a site hosted here has: by name (Simxplorer with SimDNS)" + NL
    t = t + "' and by path (Voyager, or anyone): http://www.coolsite.sim/ and http://alpha/www.coolsite.sim/" + NL
    t = t + "FUNCTION Addresses (d AS String) AS String" + NL
    t = t + "    RETURN ""<a href=""""http://www."" + d + ""/"""">http://www."" + d + ""/</a> <font size=""""2"""">(Simxplorer, with a SimDNS name server)</font><br>"" _" + NL
    t = t + "        + ""<a href=""""http://"" + SERVER.Name.Lower() + ""/www."" + d + ""/"""">http://"" + SERVER.Name.Lower() + ""/www."" + d + ""/</a> <font size=""""2"""">(Voyager, or any browser)</font>""" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\WEB\NIC.SPK")
END SUB

SUB File10 ()
    t = ""
    t = t + "<%@ import file=""C:\PROGRAMS\PALCHECK.SPK"" %>" + NL
    t = t + "<%@ import file=""NIC.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' PAID.ASP?receipt=...&order=... - SimPal sends the buyer back here. The" + NL
    t = t + "' receipt is checked (and used up) with PALCHECK.SPK, and the domain held" + NL
    t = t + "' for the order becomes the buyer's. Only linked when this machine has SimPal." + NL
    t = t + "VAR order AS String" + NL
    t = t + "VAR info AS Array OF String" + NL
    t = t + "VAR d AS String" + NL
    t = t + "VAR who AS String" + NL
    t = t + "VAR said AS String" + NL
    t = t + "VAR good AS Bool" + NL
    t = t + "VAR rec AS Array OF String" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "order = REQUEST.Query(""order"").Trim()" + NL
    t = t + "IF order = """" OR order.Length > 8 OR NOT OnlyFrom(order, ""0123456789ABCDEF"") OR NOT FS.Exists(DATADIR + ""\ORDERS\"" + order + "".TXT"") THEN" + NL
    t = t + "    said = ""SimNIC has no order "" + order + "".""" + NL
    t = t + "ELSE" + NL
    t = t + "    info = FS.Read(DATADIR + ""\ORDERS\"" + order + "".TXT"").Trim().Split(""|"")" + NL
    t = t + "    d = info[0]" + NL
    t = t + "    who = info[1]" + NL
    t = t + "    IF VerifyReceipt(REQUEST.Query(""receipt""), NICPAL, NICPRICE, order) THEN" + NL
    t = t + "        IF NicLock() THEN" + NL
    t = t + "            rec = DomainRec(d)" + NL
    t = t + "            IF rec.Count = 0 OR rec[1] = who THEN" + NL
    t = t + "                Activate(who, d)" + NL
    t = t + "                good = TRUE" + NL
    t = t + "                said = ""Thank you! "" + d + "" is registered to "" + NameOf(who) + "" until "" + TwoYears() + "".""" + NL
    t = t + "            ELSE" + NL
    t = t + "                said = ""Sorry: "" + d + "" went to somebody else while you were paying. Your receipt is "" + REQUEST.Query(""receipt"") + ""; write to the hostmaster for a refund.""" + NL
    t = t + "            END IF" + NL
    t = t + "            NicUnlock()" + NL
    t = t + "            FS.Delete(DATADIR + ""\ORDERS\"" + order + "".TXT"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            said = ""SimNIC is very busy. Press Reload in a moment.""" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSEIF PalWhy = ""used"" AND Owns(who, d) THEN" + NL
    t = t + "        good = TRUE" + NL
    t = t + "        said = d + "" is already registered to you.""" + NL
    t = t + "    ELSE" + NL
    t = t + "        said = ""SimPal says that receipt is no good ("" + PalWhy + ""), so "" + d + "" is not registered.""" + NL
    t = t + "    END IF" + NL
    t = t + "END IF" + NL
    t = t + "%><%= Top(""Payment"") %>" + NL
    t = t + "<%= Notice(said, good) %>" + NL
    t = t + "<% IF good THEN %><p><a href=""domain.asp?d=<%= UrlEnc(d) %>"">Set up <%= H(d) %> now</a></p><% END IF %>" + NL
    t = t + "<p><a href=""home.asp"">My Domains</a></p>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\PAID.ASP")
END SUB

SUB File11 ()
    t = ""
    t = t + "<%@ import file=""NIC.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' RECORD.ASP - adds a record to one of your domains, or deletes one (POST:" + NL
    t = t + "' d, op=add with name, type, value; or op=del with n). The zone file is" + NL
    t = t + "' written again, and the name server picks it up in a few seconds." + NL
    t = t + "VAR d AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""home.asp"")" + NL
    t = t + "d = CleanDomain(REQUEST.Form(""d""))" + NL
    t = t + "IF NOT Owns(viewer, d) THEN RESPONSE.Redirect(""home.asp?why="" + UrlEnc(""That is not one of your domains.""))" + NL
    t = t + "IF REQUEST.Form(""op"") = ""del"" THEN" + NL
    t = t + "    DeleteRecord(d, Int(Val(REQUEST.Form(""n""))))" + NL
    t = t + "    RESPONSE.Redirect(""domain.asp?d="" + UrlEnc(d) + ""&ok=1&why="" + UrlEnc(""Record deleted.""))" + NL
    t = t + "END IF" + NL
    t = t + "problem = AddRecord(d, REQUEST.Form(""name""), REQUEST.Form(""type""), REQUEST.Form(""value""))" + NL
    t = t + "IF problem <> """" THEN RESPONSE.Redirect(""domain.asp?d="" + UrlEnc(d) + ""&why="" + UrlEnc(problem))" + NL
    t = t + "RESPONSE.Redirect(""domain.asp?d="" + UrlEnc(d) + ""&ok=1&why="" + UrlEnc(""Record added. The name server has it within a few seconds.""))" + NL
    t = t + "%>" + NL
    Put("C:\WEB\RECORD.ASP")
END SUB

SUB File12 ()
    t = ""
    t = t + "<%@ import file=""NIC.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' REGISTER.ASP - registers a domain (POST d, t). Free, unless this machine" + NL
    t = t + "' has SimPal: then the name is held while the buyer pays at SimPal, and" + NL
    t = t + "' PAID.ASP finishes the job when they come back with a receipt." + NL
    t = t + "VAR d AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR order AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""home.asp"")" + NL
    t = t + "d = CleanDomain(REQUEST.Form(""d""))" + NL
    t = t + "problem = Register(viewer, d)" + NL
    t = t + "IF problem <> """" THEN RESPONSE.Redirect(""home.asp?why="" + UrlEnc(problem))" + NL
    t = t + "order = whyNot" + NL
    t = t + "IF order = """" THEN RESPONSE.Redirect(""domain.asp?d="" + UrlEnc(d) + ""&new=1"")" + NL
    t = t + "%><%= Top(""Pay for "" + d) %>" + NL
    t = t + "<h2>Almost yours: <%= H(d) %></h2>" + NL
    t = t + "<p>SimNIC holds <b><%= H(d) %></b> for you for <%= HOLDMINUTES %> minutes while you pay." + NL
    t = t + "Registration is <b>&sect;<%= NICPRICE %></b> for two years, through SimPal.</p>" + NL
    t = t + "<form action=""<%= PayUrl() %>"" method=""post"">" + NL
    t = t + "<input type=""hidden"" name=""to"" value=""<%= NICPAL %>"">" + NL
    t = t + "<input type=""hidden"" name=""amount"" value=""<%= NICPRICE %>"">" + NL
    t = t + "<input type=""hidden"" name=""item"" value=""Domain name <%= H(d) %> (2 years)"">" + NL
    t = t + "<input type=""hidden"" name=""order"" value=""<%= order %>"">" + NL
    t = t + "<input type=""hidden"" name=""return"" value=""<%= SiteUrl() %>paid.asp"">" + NL
    t = t + "<table cellpadding=""2"" bgcolor=""#003087""><tr><td><input type=""submit"" value=""Pay with SimPal""></td></tr></table>" + NL
    t = t + "</form>" + NL
    t = t + "<p><font size=""2"">Order number <%= order %>. Changed your mind? Just don't pay: the name goes back on the shelf.</font></p>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\REGISTER.ASP")
END SUB

SUB File13 ()
    t = ""
    t = t + "<%@ import file=""NIC.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' SEARCH.ASP?d=coolsite - is a name free? A name without its .sim/.com/..." + NL
    t = t + "' is looked up under all four." + NL
    t = t + "VAR asked AS String" + NL
    t = t + "VAR names AS Array OF String" + NL
    t = t + "VAR tld AS String" + NL
    t = t + "VAR d AS String" + NL
    t = t + "VAR rows AS String" + NL
    t = t + "VAR rec AS Array OF String" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "asked = REQUEST.Query(""d"").Trim().Lower()" + NL
    t = t + "IF asked.StartsWith(""www."") THEN asked = asked.Substring(4, asked.Length - 4)" + NL
    t = t + "IF asked <> """" AND NOT asked.Contains(""."") THEN" + NL
    t = t + "    FOR EACH tld IN [""sim"", ""com"", ""net"", ""org""]" + NL
    t = t + "        names.Add(asked + ""."" + tld)" + NL
    t = t + "    NEXT" + NL
    t = t + "ELSEIF asked <> """" THEN" + NL
    t = t + "    names.Add(asked)" + NL
    t = t + "END IF" + NL
    t = t + "FOR EACH d IN names" + NL
    t = t + "    IF CleanDomain(d) = """" THEN" + NL
    t = t + "        rows = rows + ""<tr><td><b>"" + H(d) + ""</b></td><td colspan=""""2"""">is not a name SimNIC can register: 2 to 24 letters, digits or hyphens, then .sim, .com, .net or .org.</td></tr>""" + NL
    t = t + "        CONTINUE" + NL
    t = t + "    END IF" + NL
    t = t + "    d = CleanDomain(d)" + NL
    t = t + "    IF IsFree(d) THEN" + NL
    t = t + "        rows = rows + ""<tr><td><b>"" + H(d) + ""</b></td><td><font color=""""#008000""""><b>Available!</b></font></td><td>""" + NL
    t = t + "        IF viewer <> """" THEN" + NL
    t = t + "            rows = rows + ""<form action=""""register.asp"""" method=""""post"""">"" + TokenField() + ""<input type=""""hidden"""" name=""""d"""" value="""""" + H(d) + """"""><input type=""""submit"""" value=""""Register "" + H(d) + """"""></form>""" + NL
    t = t + "        ELSE" + NL
    t = t + "            rows = rows + ""<font size=""""2""""><a href=""""index.asp"""">Log in or sign up</a> to register it.</font>""" + NL
    t = t + "        END IF" + NL
    t = t + "        rows = rows + ""</td></tr>""" + NL
    t = t + "    ELSE" + NL
    t = t + "        rec = DomainRec(d)" + NL
    t = t + "        rows = rows + ""<tr><td><b>"" + H(d) + ""</b></td><td><font color=""""#CC0000"""">Taken</font></td><td><font size=""""2""""><a href=""""whois.asp?d="" + UrlEnc(d) + """""">Who has it?</a></font></td></tr>""" + NL
    t = t + "    END IF" + NL
    t = t + "NEXT" + NL
    t = t + "%><%= Top(""Search"") %>" + NL
    t = t + "<h2>Domain Name Search</h2>" + NL
    t = t + "<form action=""search.asp"" method=""get"">www.<input name=""d"" size=""24"" value=""<%= H(asked) %>""> <input type=""submit"" value=""Search""></form>" + NL
    t = t + "<% IF rows <> """" THEN %>" + NL
    t = t + "<table cellpadding=""6"" border=""1"" cellspacing=""0""><%= rows %></table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\SEARCH.ASP")
END SUB

SUB File14 ()
    t = ""
    t = t + "<%@ import file=""NIC.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' WHOIS.ASP?d=coolsite.sim - who has a domain, as InterNIC's whois told it." + NL
    t = t + "VAR d AS String" + NL
    t = t + "VAR rec AS Array OF String" + NL
    t = t + "VAR out AS String" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "d = CleanDomain(REQUEST.Query(""d""))" + NL
    t = t + "IF d <> """" THEN" + NL
    t = t + "    rec = DomainRec(d)" + NL
    t = t + "    IF rec.Count < 6 THEN" + NL
    t = t + "        out = ""No match for """""" + d + """""".""" + NL
    t = t + "    ELSEIF rec[5] <> ""active"" THEN" + NL
    t = t + "        out = ""Domain Name: "" + d.Upper() + Chr(10) + ""Status: on hold (registration not yet paid)""" + NL
    t = t + "    ELSE" + NL
    t = t + "        out = ""Registrant:"" + Chr(10) + ""   "" + NameOf(rec[1]) + "" ("" + rec[1].Upper() + "")"" + Chr(10) + Chr(10) _" + NL
    t = t + "            + ""   Domain Name: "" + d.Upper() + Chr(10) + Chr(10) _" + NL
    t = t + "            + ""   Record created on "" + rec[2] + ""."" + Chr(10) _" + NL
    t = t + "            + ""   Record expires on "" + rec[3] + ""."" + Chr(10) + Chr(10) _" + NL
    t = t + "            + ""   Domain servers in listed order:"" + Chr(10) + Chr(10) _" + NL
    t = t + "            + ""   "" + SERVER.Name.Upper()" + NL
    t = t + "    END IF" + NL
    t = t + "END IF" + NL
    t = t + "%><%= Top(""WHOIS"") %>" + NL
    t = t + "<h2>WHOIS</h2>" + NL
    t = t + "<form action=""whois.asp"" method=""get""><input name=""d"" size=""30"" value=""<%= H(d) %>""> <input type=""submit"" value=""Look up""></form>" + NL
    t = t + "<% IF out <> """" THEN %><pre><%= H(out) %></pre><% END IF %>" + NL
    t = t + "<p><font size=""2"">The SimNIC WHOIS database is provided for information purposes only.</font></p>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\WHOIS.ASP")
END SUB

SUB File15 ()
    t = ""
    t = t + "' NAMED.SPK - SimDNS, the name server (BIND's was called named). Listens on" + NL
    t = t + "' port 53 and says which machine a name like www.coolsite.sim is on." + NL
    t = t + "'" + NL
    t = t + "' SIM95 gives every machine one name and nothing can give it another, so" + NL
    t = t + "' SimDNS doesn't hand out addresses: it points names at machine names." + NL
    t = t + "' Addresses change every time a machine starts; machine names don't. So" + NL
    t = t + "' the usual record is a CNAME to a machine:" + NL
    t = t + "'" + NL
    t = t + "'     www    IN  CNAME  alpha" + NL
    t = t + "'" + NL
    t = t + "' and whoever asks then finds ALPHA the ordinary SIM95 way." + NL
    t = t + "'" + NL
    t = t + "' The protocol: one question a message, one answer a message." + NL
    t = t + "'     C: QUERY www.coolsite.sim A" + NL
    t = t + "'     S: OK" + NL
    t = t + "'        www.coolsite.sim 300 CNAME alpha" + NL
    t = t + "' The type is A, CNAME, MX, TXT, NS, SOA or ANY (A when left out). The" + NL
    t = t + "' answer is OK and one ""name ttl type value"" line per record (none when the" + NL
    t = t + "' name is there but has nothing of that type), or NXDOMAIN (no such name)," + NL
    t = t + "' or SERVFAIL and why. CNAMEs are followed through this server's own zones," + NL
    t = t + "' up to MAXCHAIN of them; a chain that ends at a name SimDNS doesn't know" + NL
    t = t + "' ends at a machine name. A fourth word, NORECURSE, means ""answer from your" + NL
    t = t + "' own zones only"", which is how one SimDNS asks another." + NL
    t = t + "'" + NL
    t = t + "' C:\DNS\NAMED.CNF says which zones this server has (named.boot style):" + NL
    t = t + "'     directory   C:\DNS" + NL
    t = t + "'     primary     coolsite.sim   COOLSITE.SIM" + NL
    t = t + "'     forwarders  dnsbox" + NL
    t = t + "' Questions about other names go to the first forwarder, if there is one," + NL
    t = t + "' and a zone can hand a part of itself to another SimDNS with an NS record" + NL
    t = t + "' (dab  IN  NS  bravo). Either way that is one hop: the server asked is told" + NL
    t = t + "' NORECURSE, so two servers can never bounce a question back and forth." + NL
    t = t + "'" + NL
    t = t + "' Zone files and NAMED.CNF are looked at every few seconds and loaded again" + NL
    t = t + "' when they change (SIM95 has no file times, so the text is compared). The" + NL
    t = t + "' registrar (/dns/) writes them; so can you, with Notes." + NL
    t = t + "'" + NL
    t = t + "' Answers are sent, and the connection is closed a little later by the" + NL
    t = t + "' asker or by us: a close can overtake the last message (SIM95-NOTES.md)." + NL
    t = t + "" + NL
    t = t + "CONST DNSDIR = ""C:\DNS""" + NL
    t = t + "CONST CONFIG = ""C:\DNS\NAMED.CNF""" + NL
    t = t + "CONST PORT = 53" + NL
    t = t + "CONST MAXCHAIN = 8" + NL
    t = t + "CONST MAXREPLY = 60000          ' an answer is one network message: 64K at most" + NL
    t = t + "CONST FWDWAIT = 3000            ' ms to wait for a forwarder or a delegated server" + NL
    t = t + "CONST LOOKEVERY = 3000          ' ms between looks at the zone files" + NL
    t = t + "CONST LINGER = 2000             ' ms an answered connection stays open" + NL
    t = t + "CONST DEFTTL = 3600" + NL
    t = t + "" + NL
    t = t + "VAR NL AS String" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR log AS GUI_ListBox" + NL
    t = t + "VAR sock AS NET_Socket" + NL
    t = t + "VAR fwd AS NET_Socket" + NL
    t = t + "VAR timer AS GUI_Timer" + NL
    t = t + "VAR questions AS Integer" + NL
    t = t + "VAR lookedAt AS Integer" + NL
    t = t + "" + NL
    t = t + "' zones, as loaded" + NL
    t = t + "VAR cnfText AS String" + NL
    t = t + "VAR zOrigin AS Array OF String" + NL
    t = t + "VAR zFile AS Array OF String" + NL
    t = t + "VAR zText AS Array OF String       ' each file as it was loaded, to see changes" + NL
    t = t + "VAR forwarders AS Array OF String" + NL
    t = t + "VAR problems AS Integer" + NL
    t = t + "" + NL
    t = t + "' records: name (lower case, no last dot), ttl, type, value" + NL
    t = t + "VAR rName AS Array OF String" + NL
    t = t + "VAR rTtl AS Array OF Integer" + NL
    t = t + "VAR rType AS Array OF String" + NL
    t = t + "VAR rValue AS Array OF String" + NL
    t = t + "" + NL
    t = t + "' answered connections, closed after LINGER" + NL
    t = t + "VAR lingerConn AS Array OF NET_Connection" + NL
    t = t + "VAR lingerAt AS Array OF Integer" + NL
    t = t + "" + NL
    t = t + "' questions passed on to another server" + NL
    t = t + "VAR pConn AS Array OF NET_Connection" + NL
    t = t + "VAR pQuestion AS Array OF String" + NL
    t = t + "VAR pServer AS Array OF String" + NL
    t = t + "VAR pState AS Array OF String      ' ""wait"" (to send), ""sent""" + NL
    t = t + "VAR pSince AS Array OF Integer" + NL
    t = t + "VAR pSerial AS Array OF Integer" + NL
    t = t + "VAR serials AS Integer" + NL
    t = t + "VAR passTo AS String               ' set by Answer: the server to ask instead" + NL
    t = t + "" + NL
    t = t + "' other servers' addresses, looked up one at a time (SIM95-NOTES.md)" + NL
    t = t + "VAR resolving AS Bool" + NL
    t = t + "VAR resolvingSince AS Integer" + NL
    t = t + "VAR aName AS Array OF String" + NL
    t = t + "VAR aAddr AS Array OF String" + NL
    t = t + "VAR aAt AS Array OF Integer" + NL
    t = t + "" + NL
    t = t + "' what RecordsAt found" + NL
    t = t + "VAR gAny AS Bool" + NL
    t = t + "VAR gCname AS Integer" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    NL = Chr(10)" + NL
    t = t + "    win = GUI_Window.New(""SimDNS Name Server"", 460, 240)" + NL
    t = t + "    win.Icon = ""network""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    win.onResize = Win_OnResize" + NL
    t = t + "    log = GUI_ListBox.New(win)" + NL
    t = t + "    log.Mono = TRUE" + NL
    t = t + "    Win_OnResize()" + NL
    t = t + "    IF NOT FS.Exists(DNSDIR) THEN FS.MakeDir(DNSDIR)" + NL
    t = t + "    LoadAll()" + NL
    t = t + "" + NL
    t = t + "    sock = NET_Socket.New()" + NL
    t = t + "    sock.onConnect = Sock_OnConnect" + NL
    t = t + "    sock.onMessage = Sock_OnMessage" + NL
    t = t + "    sock.onError = Sock_OnError" + NL
    t = t + "    sock.Listen(PORT)" + NL
    t = t + "    Note(""Listening on port "" + Str(PORT) + "" as "" + NET.HostName.Lower())" + NL
    t = t + "    fwd = NET_Socket.New()" + NL
    t = t + "    fwd.onMessage = Fwd_OnMessage" + NL
    t = t + "    fwd.onError = Sock_OnError" + NL
    t = t + "" + NL
    t = t + "    timer = GUI_Timer.New(win)" + NL
    t = t + "    timer.Interval = 100" + NL
    t = t + "    timer.onTick = Timer_OnTick" + NL
    t = t + "    timer.Start()" + NL
    t = t + "    lookedAt = SYS.Ticks" + NL
    t = t + "    Status()" + NL
    t = t + "    win.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnResize ()" + NL
    t = t + "    log.SetBounds(0, 0, win.Width, win.Height)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    sock.Close()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnError (message AS String)" + NL
    t = t + "    Note(""ERROR "" + message)" + NL
    t = t + "    IF message.Contains(""in use"") THEN Note(""Is another name server already running? See Tasks."")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Note (text AS String)" + NL
    t = t + "    log.Add(TIME.Clock + ""  "" + text)" + NL
    t = t + "    IF log.Count > 300 THEN log.RemoveAt(0)" + NL
    t = t + "    log.ScrollToEnd()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Status ()" + NL
    t = t + "    win.Status = NET.HostName.Lower() + "" port "" + Str(PORT) + "" - "" + Str(zOrigin.Count) + "" zones, "" + Str(rName.Count) + "" records, "" + Str(questions) + "" questions""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- loading" + NL
    t = t + "" + NL
    t = t + "SUB LoadAll ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    zOrigin.Clear()" + NL
    t = t + "    zFile.Clear()" + NL
    t = t + "    zText.Clear()" + NL
    t = t + "    forwarders.Clear()" + NL
    t = t + "    rName.Clear()" + NL
    t = t + "    rTtl.Clear()" + NL
    t = t + "    rType.Clear()" + NL
    t = t + "    rValue.Clear()" + NL
    t = t + "    problems = 0" + NL
    t = t + "    dir = DNSDIR" + NL
    t = t + "    cnfText = ReadOr(CONFIG, """")" + NL
    t = t + "    IF NOT FS.Exists(CONFIG) THEN Note(""No "" + CONFIG + "" yet: no zones"")" + NL
    t = t + "    FOR EACH line IN cnfText.Lines()" + NL
    t = t + "        n = n + 1" + NL
    t = t + "        w = Words(NoComment(line))" + NL
    t = t + "        IF w.Count = 0 THEN CONTINUE" + NL
    t = t + "        SELECT CASE w[0].Lower()" + NL
    t = t + "            CASE ""directory""" + NL
    t = t + "                IF w.Count > 1 THEN dir = w[1]" + NL
    t = t + "            CASE ""primary"", ""zone""" + NL
    t = t + "                IF w.Count < 3 THEN" + NL
    t = t + "                    Problem(""NAMED.CNF line "" + Str(n) + "": say primary <domain> <file>"")" + NL
    t = t + "                ELSE" + NL
    t = t + "                    path = w[2]" + NL
    t = t + "                    IF NOT path.Contains("":\"") THEN path = dir + ""\"" + path" + NL
    t = t + "                    LoadZone(Clean(w[1]), path.Upper())" + NL
    t = t + "                END IF" + NL
    t = t + "            CASE ""forwarders"", ""forwarder""" + NL
    t = t + "                FOR i = 1 TO w.Count - 1" + NL
    t = t + "                    forwarders.Add(w[i].Lower().Replace("";"", """"))" + NL
    t = t + "                NEXT" + NL
    t = t + "            CASE ELSE" + NL
    t = t + "                Problem(""NAMED.CNF line "" + Str(n) + "": what is "" + w[0] + ""?"")" + NL
    t = t + "        END SELECT" + NL
    t = t + "    NEXT" + NL
    t = t + "    Note(""Loaded "" + Str(zOrigin.Count) + "" zones, "" + Str(rName.Count) + "" records"" + Plural(problems, "" problem""))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Plural (n AS Integer, what AS String) AS String" + NL
    t = t + "    IF n = 0 THEN RETURN """"" + NL
    t = t + "    IF n = 1 THEN RETURN "", 1"" + what" + NL
    t = t + "    RETURN "", "" + Str(n) + what + ""s""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Problem (text AS String)" + NL
    t = t + "    problems = problems + 1" + NL
    t = t + "    Note(text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB LoadZone (origin AS String, path AS String)" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    IF origin = """" THEN" + NL
    t = t + "        Problem(""NAMED.CNF: a zone with no name"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF zOrigin.IndexOf(origin) >= 0 THEN" + NL
    t = t + "        Problem(""NAMED.CNF: "" + origin + "" is there twice"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    text = ReadOr(path, """")" + NL
    t = t + "    IF NOT FS.Exists(path) THEN Problem(origin + "": there is no "" + path)" + NL
    t = t + "    zOrigin.Add(origin)" + NL
    t = t + "    zFile.Add(path)" + NL
    t = t + "    zText.Add(text)" + NL
    t = t + "    ParseZone(origin, text, path.Split(""\"")[path.Split(""\"").Count - 1])" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One zone file: BIND's format, the parts SIM95 needs." + NL
    t = t + "'   $TTL 300" + NL
    t = t + "'   @      IN  SOA    alpha hostmaster ( 1 )" + NL
    t = t + "'   @      IN  NS     alpha" + NL
    t = t + "'   @      IN  CNAME  alpha        ; the domain itself is on ALPHA" + NL
    t = t + "'   www        CNAME  alpha" + NL
    t = t + "'   shop       CNAME  www          ; a name in this zone, since it has one" + NL
    t = t + "'   old        A      65.16.0.7    ; an address (it changes when ALPHA restarts)" + NL
    t = t + "'   @          MX     10 alpha" + NL
    t = t + "'   @          TXT    ""Best viewed in Simxplorer""" + NL
    t = t + "'   dab        NS     bravo        ; dab.coolsite.sim is BRAVO's to answer" + NL
    t = t + "' A name ending in a dot is complete; @ is the zone; any other name is in" + NL
    t = t + "' the zone (www is www.coolsite.sim). A line that starts with a space is" + NL
    t = t + "' about the name above it. CNAME and MX point at names: one with a dot is" + NL
    t = t + "' taken as it is, and a single word is a name in this zone if the zone has" + NL
    t = t + "' it, or else a SIM95 machine. NS points at the machine running SimDNS." + NL
    t = t + "SUB ParseZone (origin AS String, text AS String, fname AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR raw AS String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR owner AS String" + NL
    t = t + "    VAR ttl AS Integer = DEFTTL" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR rt AS String" + NL
    t = t + "    VAR value AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR here AS String" + NL
    t = t + "    first = rName.Count" + NL
    t = t + "    owner = origin" + NL
    t = t + "    lines = text.Lines()" + NL
    t = t + "    n = 0" + NL
    t = t + "    WHILE n < lines.Count" + NL
    t = t + "        raw = lines[n].Replace(Chr(9), "" "").Replace(Chr(13), """")" + NL
    t = t + "        n = n + 1" + NL
    t = t + "        line = NoComment(raw)" + NL
    t = t + "        ' ( ... ) runs over several lines (an SOA, usually)" + NL
    t = t + "        IF line.Contains(""("") AND NOT line.Contains("")"") THEN" + NL
    t = t + "            WHILE n < lines.Count AND NOT line.Contains("")"")" + NL
    t = t + "                line = line + "" "" + NoComment(lines[n].Replace(Chr(9), "" ""))" + NL
    t = t + "                n = n + 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "        END IF" + NL
    t = t + "        line = line.Replace(""("", "" "").Replace("")"", "" "")" + NL
    t = t + "        IF line.Trim() = """" THEN CONTINUE" + NL
    t = t + "        w = Words(line)" + NL
    t = t + "        IF w[0].Upper() = ""$TTL"" THEN" + NL
    t = t + "            IF w.Count > 1 THEN ttl = Int(Val(w[1]))" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF w[0].Upper() = ""$ORIGIN"" THEN" + NL
    t = t + "            IF w.Count > 1 THEN origin = Qualify(w[1], origin)" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        at = 0" + NL
    t = t + "        IF NOT line.StartsWith("" "") THEN" + NL
    t = t + "            owner = Qualify(w[0], origin)" + NL
    t = t + "            at = 1" + NL
    t = t + "        END IF" + NL
    t = t + "        here = Str(ttl)" + NL
    t = t + "        IF at < w.Count THEN" + NL
    t = t + "            IF IsNumber(w[at]) THEN" + NL
    t = t + "                here = w[at]" + NL
    t = t + "                at = at + 1" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        IF at < w.Count THEN" + NL
    t = t + "            IF w[at].Upper() = ""IN"" THEN at = at + 1" + NL
    t = t + "        END IF" + NL
    t = t + "        IF at >= w.Count THEN" + NL
    t = t + "            Problem(fname + "" line "" + Str(n) + "": no record type"")" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        rt = w[at].Upper()" + NL
    t = t + "        at = at + 1" + NL
    t = t + "        value = """"" + NL
    t = t + "        SELECT CASE rt" + NL
    t = t + "            CASE ""CNAME"", ""NS""" + NL
    t = t + "                IF at < w.Count THEN value = Target(w[at], origin)" + NL
    t = t + "            CASE ""A""" + NL
    t = t + "                IF at < w.Count THEN value = w[at]" + NL
    t = t + "                IF NOT IsAddress(value) THEN" + NL
    t = t + "                    Problem(fname + "" line "" + Str(n) + "": A needs an address like 65.16.0.2 (for a machine, use CNAME "" + value + "")"")" + NL
    t = t + "                    CONTINUE" + NL
    t = t + "                END IF" + NL
    t = t + "            CASE ""MX""" + NL
    t = t + "                IF at + 1 < w.Count THEN" + NL
    t = t + "                    IF IsNumber(w[at]) THEN value = w[at] + "" "" + Target(w[at + 1], origin)" + NL
    t = t + "                END IF" + NL
    t = t + "            CASE ""TXT""" + NL
    t = t + "                IF raw.Contains("""""""") THEN" + NL
    t = t + "                    value = raw.Substring(raw.IndexOf(""""""""), raw.Length - raw.IndexOf(""""""""))" + NL
    t = t + "                    value = value.Substring(0, LastQuote(value) + 1)" + NL
    t = t + "                ELSE" + NL
    t = t + "                    value = """""""" + Rest(w, at) + """"""""" + NL
    t = t + "                END IF" + NL
    t = t + "                IF value.Length > 1000 THEN value = value.Substring(0, 999) + """"""""" + NL
    t = t + "            CASE ""SOA""" + NL
    t = t + "                value = Rest(w, at)" + NL
    t = t + "            CASE ELSE" + NL
    t = t + "                Problem(fname + "" line "" + Str(n) + "": SimDNS doesn't know records of type "" + rt)" + NL
    t = t + "                CONTINUE" + NL
    t = t + "        END SELECT" + NL
    t = t + "        IF value = """" OR value = """""""" THEN" + NL
    t = t + "            Problem(fname + "" line "" + Str(n) + "": "" + rt + "" for "" + owner + "" needs something to point at"")" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        rName.Add(owner)" + NL
    t = t + "        rTtl.Add(Int(Val(here)))" + NL
    t = t + "        rType.Add(rt)" + NL
    t = t + "        rValue.Add(value)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    ' a single word is a name in this zone if the zone has it, or else a machine" + NL
    t = t + "    FOR i = first TO rName.Count - 1" + NL
    t = t + "        IF rType[i] = ""CNAME"" THEN" + NL
    t = t + "            IF NOT rValue[i].Contains(""."") AND rName.IndexOf(rValue[i] + ""."" + origin) >= first THEN rValue[i] = rValue[i] + ""."" + origin" + NL
    t = t + "        END IF" + NL
    t = t + "        IF rType[i] = ""MX"" THEN" + NL
    t = t + "            value = rValue[i].Split("" "")[1]" + NL
    t = t + "            IF NOT value.Contains(""."") AND rName.IndexOf(value + ""."" + origin) >= first THEN rValue[i] = rValue[i].Split("" "")[0] + "" "" + value + ""."" + origin" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A name as written in a zone file, made complete." + NL
    t = t + "FUNCTION Qualify (n AS String, origin AS String) AS String" + NL
    t = t + "    n = n.Lower()" + NL
    t = t + "    IF n = ""@"" THEN RETURN origin" + NL
    t = t + "    IF n.EndsWith(""."") THEN RETURN n.Substring(0, n.Length - 1)" + NL
    t = t + "    RETURN n + ""."" + origin" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' What a CNAME, MX or NS points at: @ is the zone, a trailing dot goes." + NL
    t = t + "FUNCTION Target (n AS String, origin AS String) AS String" + NL
    t = t + "    n = n.Lower()" + NL
    t = t + "    IF n = ""@"" THEN RETURN origin" + NL
    t = t + "    IF n.EndsWith(""."") THEN n = n.Substring(0, n.Length - 1)" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Clean (n AS String) AS String" + NL
    t = t + "    n = n.Trim().Lower()" + NL
    t = t + "    IF n.EndsWith(""."") THEN n = n.Substring(0, n.Length - 1)" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The words of a line, however many spaces between them." + NL
    t = t + "FUNCTION Words (s AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    FOR EACH p IN s.Replace(Chr(9), "" "").Split("" "")" + NL
    t = t + "        IF p <> """" THEN out.Add(p)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Rest (w AS Array OF String, at AS Integer) AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = at TO w.Count - 1" + NL
    t = t + "        out.Add(w[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out.Join("" "")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A line without its ; comment (a ; inside quotes stays)." + NL
    t = t + "FUNCTION NoComment (s AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR quoted AS Bool" + NL
    t = t + "    IF NOT s.Contains("";"") THEN RETURN s" + NL
    t = t + "    IF NOT s.Contains("""""""") THEN RETURN s.Substring(0, s.IndexOf("";""))" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        IF s.CharAt(i) = """""""" THEN quoted = NOT quoted" + NL
    t = t + "        IF s.CharAt(i) = "";"" AND NOT quoted THEN RETURN s.Substring(0, i)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LastQuote (s AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = s.Length - 1 TO 0 STEP -1" + NL
    t = t + "        IF s.CharAt(i) = """""""" THEN RETURN i" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsNumber (s AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF s = """" OR s.Length > 9 THEN RETURN FALSE" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        IF NOT ""0123456789"".Contains(s.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsAddress (s AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    IF s.Split(""."").Count <> 4 THEN RETURN FALSE" + NL
    t = t + "    FOR EACH p IN s.Split(""."")" + NL
    t = t + "        IF NOT IsNumber(p) OR p.Length > 3 THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Has a zone file or NAMED.CNF changed since it was loaded?" + NL
    t = t + "FUNCTION Changed () AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF ReadOr(CONFIG, """") <> cnfText THEN RETURN TRUE" + NL
    t = t + "    FOR i = 0 TO zFile.Count - 1" + NL
    t = t + "        IF ReadOr(zFile[i], """") <> zText[i] THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- answering" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnConnect (conn AS NET_Connection)" + NL
    t = t + "    conn.Accept()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR qtype AS String = ""A""" + NL
    t = t + "    VAR alone AS Bool" + NL
    t = t + "    VAR reply AS String" + NL
    t = t + "    questions = questions + 1" + NL
    t = t + "    w = Words((message + NL).Split(NL)[0].Replace(Chr(13), """"))" + NL
    t = t + "    IF w.Count < 2 OR w[0].Upper() <> ""QUERY"" THEN" + NL
    t = t + "        Send(conn, ""SERVFAIL ask like this: QUERY www.coolsite.sim A"", ""?"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    name = Clean(w[1])" + NL
    t = t + "    IF w.Count > 2 THEN qtype = w[2].Upper()" + NL
    t = t + "    IF w.Count > 3 THEN alone = w[3].Upper() = ""NORECURSE""" + NL
    t = t + "    IF name = """" OR name.Length > 200 OR NOT OnlyFrom(name, ""abcdefghijklmnopqrstuvwxyz0123456789.-_*"") THEN" + NL
    t = t + "        Send(conn, ""SERVFAIL that is not a name"", name)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT ""|A|CNAME|MX|TXT|NS|SOA|ANY|"".Contains(""|"" + qtype + ""|"") THEN" + NL
    t = t + "        Send(conn, ""SERVFAIL SimDNS doesn't know records of type "" + qtype, name + "" "" + qtype)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    reply = Answer(name, qtype)" + NL
    t = t + "    IF reply <> """" THEN" + NL
    t = t + "        Send(conn, reply, name + "" "" + qtype)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF alone THEN" + NL
    t = t + "        IF ZoneOf(name) < 0 THEN" + NL
    t = t + "            Send(conn, ""NXDOMAIN"", name + "" "" + qtype)" + NL
    t = t + "        ELSE" + NL
    t = t + "            Send(conn, ""SERVFAIL "" + name + "" is "" + passTo + ""'s to answer"", name + "" "" + qtype)" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' another server's: the timer passes it on" + NL
    t = t + "    serials = serials + 1" + NL
    t = t + "    pConn.Add(conn)" + NL
    t = t + "    pQuestion.Add(""QUERY "" + name + "" "" + qtype + "" NORECURSE"")" + NL
    t = t + "    pServer.Add(passTo)" + NL
    t = t + "    pState.Add(""wait"")" + NL
    t = t + "    pSince.Add(SYS.Ticks)" + NL
    t = t + "    pSerial.Add(serials)" + NL
    t = t + "    Note(conn.FromAddress + ""  "" + name + "" "" + qtype + "" -> asking "" + passTo)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Send (conn AS NET_Connection, reply AS String, what AS String)" + NL
    t = t + "    VAR said AS String" + NL
    t = t + "    TRY" + NL
    t = t + "        conn.Send(reply)" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    lingerConn.Add(conn)" + NL
    t = t + "    lingerAt.Add(SYS.Ticks)" + NL
    t = t + "    said = reply.Lines()[0]" + NL
    t = t + "    IF said = ""OK"" THEN" + NL
    t = t + "        IF reply.Lines().Count > 1 THEN" + NL
    t = t + "            said = reply.Lines()[reply.Lines().Count - 1]" + NL
    t = t + "            said = said.Substring(said.IndexOf("" "") + 1, said.Length - said.IndexOf("" "") - 1)" + NL
    t = t + "            said = said.Substring(said.IndexOf("" "") + 1, said.Length - said.IndexOf("" "") - 1)" + NL
    t = t + "        ELSE" + NL
    t = t + "            said = ""nothing of that type""" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    Note(conn.FromAddress + ""  "" + what + "" -> "" + said)" + NL
    t = t + "    Status()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION OnlyFrom (s AS String, allowed AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        IF NOT allowed.Contains(s.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The zone a name is in (the longest that fits), or -1." + NL
    t = t + "FUNCTION ZoneOf (name AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR best AS Integer = -1" + NL
    t = t + "    FOR i = 0 TO zOrigin.Count - 1" + NL
    t = t + "        IF name = zOrigin[i] OR name.EndsWith(""."" + zOrigin[i]) THEN" + NL
    t = t + "            IF best < 0 THEN" + NL
    t = t + "                best = i" + NL
    t = t + "            ELSEIF zOrigin[i].Length > zOrigin[best].Length THEN" + NL
    t = t + "                best = i" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN best" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The machine a part of zone z was handed to with an NS record, or """"." + NL
    t = t + "FUNCTION DelegatedTo (name AS String, z AS Integer) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR origin AS String" + NL
    t = t + "    origin = zOrigin[z]" + NL
    t = t + "    FOR i = 0 TO rName.Count - 1" + NL
    t = t + "        IF rType[i] = ""NS"" AND rName[i] <> origin AND rName[i].EndsWith(""."" + origin) THEN" + NL
    t = t + "            IF name = rName[i] OR name.EndsWith(""."" + rName[i]) THEN RETURN rValue[i]" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The answer to a question, or """" when another server must be asked (passTo)." + NL
    t = t + "FUNCTION Answer (name AS String, qtype AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR hop AS Integer" + NL
    t = t + "    VAR z AS Integer" + NL
    t = t + "    VAR hits AS String" + NL
    t = t + "    VAR d AS String" + NL
    t = t + "    passTo = """"" + NL
    t = t + "    cur = name" + NL
    t = t + "    FOR hop = 0 TO MAXCHAIN" + NL
    t = t + "        z = ZoneOf(cur)" + NL
    t = t + "        IF z < 0 THEN" + NL
    t = t + "            ' the chain has left our zones: what it ends at is a machine" + NL
    t = t + "            IF hop > 0 THEN RETURN ""OK"" + out" + NL
    t = t + "            IF forwarders.Count = 0 THEN RETURN ""NXDOMAIN""" + NL
    t = t + "            passTo = forwarders[0]" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        END IF" + NL
    t = t + "        d = DelegatedTo(cur, z)" + NL
    t = t + "        IF d <> """" THEN" + NL
    t = t + "            IF hop > 0 THEN RETURN ""OK"" + out" + NL
    t = t + "            passTo = d" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        END IF" + NL
    t = t + "        hits = RecordsAt(cur, cur, qtype)" + NL
    t = t + "        IF NOT gAny AND cur <> zOrigin[z] THEN hits = RecordsAt(""*."" + cur.Substring(cur.IndexOf(""."") + 1, cur.Length - cur.IndexOf(""."") - 1), cur, qtype)" + NL
    t = t + "        IF NOT gAny THEN" + NL
    t = t + "            IF hop > 0 THEN RETURN ""OK"" + out" + NL
    t = t + "            IF HasBelow(cur) THEN RETURN ""OK""" + NL
    t = t + "            RETURN ""NXDOMAIN""" + NL
    t = t + "        END IF" + NL
    t = t + "        IF hits <> """" THEN RETURN Fit(""OK"" + out + hits)" + NL
    t = t + "        IF gCname < 0 THEN RETURN ""OK"" + out" + NL
    t = t + "        out = out + NL + cur + "" "" + Str(rTtl[gCname]) + "" CNAME "" + rValue[gCname]" + NL
    t = t + "        cur = rValue[gCname]" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN ""SERVFAIL more than "" + Str(MAXCHAIN) + "" CNAMEs in a row from "" + name + "" (a loop?)""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The records at key that answer qtype, as lines about shown. Sets gAny (key" + NL
    t = t + "' has records at all) and gCname (its CNAME, or -1)." + NL
    t = t + "FUNCTION RecordsAt (key AS String, shown AS String, qtype AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    gAny = FALSE" + NL
    t = t + "    gCname = -1" + NL
    t = t + "    FOR i = 0 TO rName.Count - 1" + NL
    t = t + "        IF rName[i] = key THEN" + NL
    t = t + "            gAny = TRUE" + NL
    t = t + "            IF rType[i] = ""CNAME"" THEN gCname = i" + NL
    t = t + "            IF qtype = ""ANY"" OR rType[i] = qtype THEN out = out + NL + shown + "" "" + Str(rTtl[i]) + "" "" + rType[i] + "" "" + rValue[i]" + NL
    t = t + "            IF out.Length > MAXREPLY THEN RETURN out" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A name with nothing of its own but names under it (coolsite.sim with only www)." + NL
    t = t + "FUNCTION HasBelow (name AS String) AS Bool" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    FOR EACH n IN rName" + NL
    t = t + "        IF n.EndsWith(""."" + name) THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Fit (reply AS String) AS String" + NL
    t = t + "    IF reply.Length > MAXREPLY THEN RETURN ""SERVFAIL the answer is too long for one message""" + NL
    t = t + "    RETURN reply" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the clock" + NL
    t = t + "" + NL
    t = t + "SUB Timer_OnTick ()" + NL
    t = t + "    ' Nothing may come after this TRY: a tick whose Connect failed is" + NL
    t = t + "    ' spoiled (see SIM95-NOTES.md), and this is how it ends quietly." + NL
    t = t + "    TRY" + NL
    t = t + "        Tick()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Tick ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    ' answers that have had time to arrive: their connections close" + NL
    t = t + "    i = 0" + NL
    t = t + "    WHILE i < lingerConn.Count" + NL
    t = t + "        IF SYS.Ticks - lingerAt[i] > LINGER THEN" + NL
    t = t + "            TRY" + NL
    t = t + "                lingerConn[i].Close()" + NL
    t = t + "            CATCH err" + NL
    t = t + "            END TRY" + NL
    t = t + "            lingerConn.RemoveAt(i)" + NL
    t = t + "            lingerAt.RemoveAt(i)" + NL
    t = t + "        ELSE" + NL
    t = t + "            i = i + 1" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    ' questions another server never answered" + NL
    t = t + "    FOR i = pSerial.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF SYS.Ticks - pSince[i] > FWDWAIT THEN PassBack(i, ""SERVFAIL no answer from "" + pServer[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF SYS.Ticks - lookedAt > LOOKEVERY THEN" + NL
    t = t + "        lookedAt = SYS.Ticks" + NL
    t = t + "        IF Changed() THEN" + NL
    t = t + "            Note(""The zone files have changed"")" + NL
    t = t + "            LoadAll()" + NL
    t = t + "            Status()" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    ' Last, because it may be spoiled: send one question on." + NL
    t = t + "    i = pState.IndexOf(""wait"")" + NL
    t = t + "    IF i >= 0 THEN Ask(pSerial[i])" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Asks another server one question, from a tick of its own." + NL
    t = t + "SUB Ask (serial AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    i = pSerial.IndexOf(serial)" + NL
    t = t + "    pState[i] = ""sent""" + NL
    t = t + "    addr = AddressOf(pServer[i])" + NL
    t = t + "    i = pSerial.IndexOf(serial)" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    IF addr = """" THEN" + NL
    t = t + "        PassBack(i, ""SERVFAIL cannot find the name server "" + pServer[i])" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = fwd.Connect(addr, PORT)" + NL
    t = t + "        conn.Tag = Str(serial)" + NL
    t = t + "        i = pSerial.IndexOf(serial)" + NL
    t = t + "        IF i >= 0 THEN conn.Send(pQuestion[i])" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    ' Nothing else may wait in this tick. A refused question times out." + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A machine's address: one lookup at a time, kept for a minute." + NL
    t = t + "FUNCTION AddressOf (machine AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    i = aName.IndexOf(machine.Upper())" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        IF SYS.Ticks - aAt[i] < 60000 THEN RETURN aAddr[i]" + NL
    t = t + "        aName.RemoveAt(i)" + NL
    t = t + "        aAddr.RemoveAt(i)" + NL
    t = t + "        aAt.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF resolving AND SYS.Ticks - resolvingSince < 10000 THEN RETURN """"" + NL
    t = t + "    resolving = TRUE" + NL
    t = t + "    resolvingSince = SYS.Ticks" + NL
    t = t + "    addr = NET.Resolve(machine)" + NL
    t = t + "    resolving = FALSE" + NL
    t = t + "    IF addr <> """" AND aName.IndexOf(machine.Upper()) < 0 THEN" + NL
    t = t + "        aName.Add(machine.Upper())" + NL
    t = t + "        aAddr.Add(addr)" + NL
    t = t + "        aAt.Add(SYS.Ticks)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN addr" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Fwd_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = pSerial.IndexOf(Int(Val(conn.Tag)))" + NL
    t = t + "    TRY" + NL
    t = t + "        conn.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF i >= 0 THEN PassBack(i, message)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Gives the asker what another server said, and forgets the question." + NL
    t = t + "SUB PassBack (i AS Integer, reply AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR what AS String" + NL
    t = t + "    conn = pConn[i]" + NL
    t = t + "    what = pQuestion[i].Split("" "")[1] + "" "" + pQuestion[i].Split("" "")[2] + "" ("" + pServer[i] + "")""" + NL
    t = t + "    pConn.RemoveAt(i)" + NL
    t = t + "    pQuestion.RemoveAt(i)" + NL
    t = t + "    pServer.RemoveAt(i)" + NL
    t = t + "    pState.RemoveAt(i)" + NL
    t = t + "    pSince.RemoveAt(i)" + NL
    t = t + "    pSerial.RemoveAt(i)" + NL
    t = t + "    Send(conn, reply, what)" + NL
    t = t + "END SUB" + NL
    Put("C:\PROGRAMS\NAMED.SPK")
END SUB

SUB File16 ()
    t = ""
    t = t + "' DIG.SPK - asks a SimDNS name server about a name, like dig on Unix." + NL
    t = t + "' From the Terminal or the Sim Shell:" + NL
    t = t + "'     DIG www.coolsite.sim               where is it? (the CNAMEs to its machine)" + NL
    t = t + "'     DIG coolsite.sim MX                its mail machine (also TXT, NS, SOA, ANY)" + NL
    t = t + "'     DIG www.coolsite.sim ANY @bravo    ask BRAVO instead of the usual server" + NL
    t = t + "'     DIG SET dnsbox                     use DNSBOX's SimDNS from now on" + NL
    t = t + "'     DIG SET NONE                       stop using SimDNS (machine names only)" + NL
    t = t + "'     DIG SET                            which name server is set?" + NL
    t = t + "' The name server is kept in C:\SYSTEM\RESOLV.INI, which Simxplorer's" + NL
    t = t + "' Options and every program that uses RESOLVE.SPK read. The builder joins" + NL
    t = t + "' RESOLVE.SPK onto the end of this file." + NL
    t = t + "" + NL
    t = t + "VAR digReply AS String" + NL
    t = t + "VAR digSock AS NET_Socket" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    VAR args AS Array OF String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR qtype AS String = ""A""" + NL
    t = t + "    VAR server AS String" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR started AS Integer" + NL
    t = t + "    VAR failed AS String" + NL
    t = t + "    FOR EACH a IN SYS.Args" + NL
    t = t + "        IF a.Trim() <> """" THEN args.Add(a.Trim())" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF args.Count = 0 THEN" + NL
    t = t + "        Print(""Usage: DIG name [type] [@server]      types: A CNAME MX TXT NS SOA ANY"")" + NL
    t = t + "        Print(""       DIG SET machine                  make machine this computer's name server"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF args[0].Upper() = ""SET"" THEN" + NL
    t = t + "        SetServer(args)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    FOR EACH a IN args" + NL
    t = t + "        IF a.StartsWith(""@"") THEN" + NL
    t = t + "            server = a.Substring(1, a.Length - 1).Lower()" + NL
    t = t + "        ELSEIF ""|A|CNAME|MX|TXT|NS|SOA|ANY|"".Contains(""|"" + a.Upper() + ""|"") AND name <> """" THEN" + NL
    t = t + "            qtype = a.Upper()" + NL
    t = t + "        ELSE" + NL
    t = t + "            name = a.Lower()" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF name = """" THEN" + NL
    t = t + "        Print(""Which name? For example:  DIG www.coolsite.sim"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF server = """" THEN server = RsNameServer()" + NL
    t = t + "    IF server = """" THEN" + NL
    t = t + "        Print("";; No name server is set. Say which machine runs SimDNS:  DIG SET machine"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    Print("""")" + NL
    t = t + "    Print(""; <<>> DiG 2.1 for SIM95 (SimDNS) <<>> "" + name + "" "" + qtype)" + NL
    t = t + "    addr = NET.Resolve(server)" + NL
    t = t + "    IF addr = """" THEN" + NL
    t = t + "        Print("";; connection failed: there is no machine called "" + server)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    digSock = NET_Socket.New()" + NL
    t = t + "    digSock.onMessage = Dig_OnMessage" + NL
    t = t + "    started = SYS.Ticks" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = digSock.Connect(addr, RSPORT)" + NL
    t = t + "        conn.Send(""QUERY "" + RsFull(name) + "" "" + qtype)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        failed = err" + NL
    t = t + "    END TRY" + NL
    t = t + "    ' A refused Connect spoils this handler (SIM95-NOTES.md): no more waiting." + NL
    t = t + "    IF failed <> """" THEN" + NL
    t = t + "        Print("";; connection to "" + server + "" ("" + addr + "") port 53 failed: "" + failed.Split("":"")[0] + "". Is NAMED.SPK running there?"")" + NL
    t = t + "        SYS.Exit(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    WHILE digReply = """" AND SYS.Ticks - started < 3000" + NL
    t = t + "        SYS.Sleep(50)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF digReply = """" THEN" + NL
    t = t + "        Print("";; connection timed out; no answer from "" + server)" + NL
    t = t + "        SYS.Exit(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    Show(name, qtype, server, addr, SYS.Ticks - started)" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Dig_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    digReply = message" + NL
    t = t + "    conn.Close()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Prints the answer the way dig did, and where a machine name leads." + NL
    t = t + "SUB Show (name AS String, qtype AS String, server AS String, addr AS String, ms AS Integer)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR status AS String" + NL
    t = t + "    VAR last AS String" + NL
    t = t + "    VAR machine AS String" + NL
    t = t + "    lines = digReply.Lines()" + NL
    t = t + "    status = lines[0].Split("" "")[0]" + NL
    t = t + "    IF status = ""OK"" THEN status = ""NOERROR""" + NL
    t = t + "    Print("";; ->>HEADER<<- status: "" + status + "", answers: "" + Str(lines.Count - 1))" + NL
    t = t + "    IF lines[0].Contains("" "") THEN Print("";; "" + lines[0].Substring(lines[0].IndexOf("" "") + 1, lines[0].Length - lines[0].IndexOf("" "") - 1))" + NL
    t = t + "    Print("""")" + NL
    t = t + "    Print("";; QUESTION SECTION:"")" + NL
    t = t + "    Print("";"" + (RsFull(name) + ""."").PadRight(31) + "" IN  "" + qtype)" + NL
    t = t + "    IF lines.Count > 1 THEN" + NL
    t = t + "        Print("""")" + NL
    t = t + "        Print("";; ANSWER SECTION:"")" + NL
    t = t + "        FOR i = 1 TO lines.Count - 1" + NL
    t = t + "            w = lines[i].Split("" "")" + NL
    t = t + "            IF w.Count < 4 THEN CONTINUE" + NL
    t = t + "            Print((w[0] + ""."").PadRight(24) + "" "" + w[1].PadRight(6) + "" IN  "" + w[2].PadRight(6) + "" "" + Rest(w, 3))" + NL
    t = t + "            IF w[2] = ""CNAME"" THEN last = w[3]" + NL
    t = t + "            IF w[2] = ""A"" THEN last = """"" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    ' a CNAME chain that ends at a name SimDNS doesn't know ends at a machine" + NL
    t = t + "    IF last <> """" THEN" + NL
    t = t + "        machine = last" + NL
    t = t + "        FOR i = 1 TO lines.Count - 1" + NL
    t = t + "            IF lines[i].StartsWith(last + "" "") THEN machine = """"" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF machine <> """" THEN" + NL
    t = t + "            Print("""")" + NL
    t = t + "            Print("";; "" + machine + "" is a SIM95 machine name: "" + Where(machine) + "" (asked SIM95, not SimDNS)"")" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    Print("""")" + NL
    t = t + "    Print("";; Query time: "" + Str(ms) + "" msec"")" + NL
    t = t + "    Print("";; SERVER: "" + server + "" ("" + addr + "") port 53"")" + NL
    t = t + "    Print("";; WHEN: "" + TIME.Date + "" "" + TIME.Clock)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Where (machine AS String) AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    a = NET.Resolve(machine)" + NL
    t = t + "    IF a = """" THEN RETURN ""not on the network now""" + NL
    t = t + "    RETURN a" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Rest (w AS Array OF String, at AS Integer) AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = at TO w.Count - 1" + NL
    t = t + "        out.Add(w[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out.Join("" "")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SetServer (args AS Array OF String)" + NL
    t = t + "    IF args.Count < 2 THEN" + NL
    t = t + "        IF RsNameServer() = """" THEN" + NL
    t = t + "            Print(""No name server is set: names are SIM95 machine names only."")" + NL
    t = t + "        ELSE" + NL
    t = t + "            Print(""The name server is "" + RsNameServer() + "" (C:\SYSTEM\RESOLV.INI)."")" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF args[1].Upper() = ""NONE"" THEN" + NL
    t = t + "        RsSave("""")" + NL
    t = t + "        Print(""No name server now: names are SIM95 machine names only."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    RsSave(args[1])" + NL
    t = t + "    Print(""The name server is now "" + args[1].Lower() + "" (C:\SYSTEM\RESOLV.INI). Simxplorer uses it too."")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' RESOLVE.SPK - the SimDNS resolver: asks the name server named in" + NL
    t = t + "' C:\SYSTEM\RESOLV.INI which machine a name like www.coolsite.sim is on." + NL
    t = t + "'" + NL
    t = t + "' A library, not a program: a program has it joined on the end (the builder" + NL
    t = t + "' does this for Simxplorer and DIG; copy C:\PROGRAMS\RESOLVE.SPK onto the end" + NL
    t = t + "' of your own). Every name in it starts with Rs, so it can't clash." + NL
    t = t + "'" + NL
    t = t + "' C:\SYSTEM\RESOLV.INI, shared by every program on the machine:" + NL
    t = t + "'     nameserver=dnsbox          the machine running NAMED.SPK" + NL
    t = t + "'     search=coolsite.sim        optional: then ""www"" means www.coolsite.sim" + NL
    t = t + "'" + NL
    t = t + "' How to use it without ever waiting in the wrong place (SIM95-NOTES.md):" + NL
    t = t + "'   1. RsWants(host)  - does this name need asking? FALSE for addresses," + NL
    t = t + "'                       plain machine names, names already known, or when" + NL
    t = t + "'                       there is no name server (or it isn't answering)." + NL
    t = t + "'   2. RsAsk(host, address) - sends the question to the name server at that" + NL
    t = t + "'                       address. It is a Connect: let it be the last thing" + NL
    t = t + "'                       the handler does." + NL
    t = t + "'   3. RsBusy()       - TRUE while the answer is on its way. After RSWAIT" + NL
    t = t + "'                       with no answer the server is left alone for RSQUIET," + NL
    t = t + "'                       and every name goes to SIM95 as before." + NL
    t = t + "'   4. RsTarget(host) - where to connect: the machine name (or address) the" + NL
    t = t + "'                       name server gave, or the name itself when SimDNS" + NL
    t = t + "'                       doesn't know it, for SIM95 to look up." + NL
    t = t + "' Answers are kept for their TTL; names SimDNS doesn't know for RSNEG." + NL
    t = t + "" + NL
    t = t + "CONST RSINI = ""C:\SYSTEM\RESOLV.INI""" + NL
    t = t + "CONST RSPORT = 53" + NL
    t = t + "CONST RSWAIT = 2000             ' ms to wait for an answer" + NL
    t = t + "CONST RSQUIET = 30000            ' ms to leave a silent name server alone" + NL
    t = t + "CONST RSNEG = 60000             ' ms to remember that SimDNS doesn't know a name" + NL
    t = t + "CONST RSMOST = 100              ' names kept" + NL
    t = t + "" + NL
    t = t + "VAR rsServer AS String" + NL
    t = t + "VAR rsSearch AS String" + NL
    t = t + "VAR rsRead AS Bool" + NL
    t = t + "VAR rsReadAt AS Integer" + NL
    t = t + "VAR rsSock AS NET_Socket" + NL
    t = t + "VAR rsName AS Array OF String       ' the name as asked, lower case" + NL
    t = t + "VAR rsTo AS Array OF String         ' where it is ("""" when SimDNS doesn't know it)" + NL
    t = t + "VAR rsCanon AS Array OF String      ' its last name in DNS before the machine" + NL
    t = t + "VAR rsUntil AS Array OF Integer     ' SYS.Ticks when it is forgotten" + NL
    t = t + "VAR rsAsking AS String" + NL
    t = t + "VAR rsAskAt AS Integer" + NL
    t = t + "VAR rsRefused AS Bool" + NL
    t = t + "VAR rsDown AS Bool" + NL
    t = t + "VAR rsDownAt AS Integer" + NL
    t = t + "VAR rsWhy AS String                 ' the last thing that went wrong" + NL
    t = t + "VAR rsLastReply AS String           ' the last answer, as it came" + NL
    t = t + "" + NL
    t = t + "' Reads RESOLV.INI (again after a few seconds, so a new setting takes)." + NL
    t = t + "SUB RsConfig ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    IF rsRead AND SYS.Ticks - rsReadAt < 3000 THEN RETURN" + NL
    t = t + "    rsRead = TRUE" + NL
    t = t + "    rsReadAt = SYS.Ticks" + NL
    t = t + "    rsServer = """"" + NL
    t = t + "    rsSearch = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                low = line.Trim().Lower()" + NL
    t = t + "                IF low.StartsWith(""nameserver="") THEN rsServer = low.Substring(11, low.Length - 11).Trim()" + NL
    t = t + "                IF low.StartsWith(""search="") THEN rsSearch = low.Substring(7, low.Length - 7).Trim()" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF rsSearch.StartsWith(""."") THEN rsSearch = rsSearch.Substring(1, rsSearch.Length - 1)" + NL
    t = t + "    IF rsSearch.EndsWith(""."") THEN rsSearch = rsSearch.Substring(0, rsSearch.Length - 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The name server (a machine name or address), or """" for none." + NL
    t = t + "FUNCTION RsNameServer () AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsServer" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Makes server this machine's name server ("""" for none), keeping the rest" + NL
    t = t + "' of RESOLV.INI, and forgets everything it knew." + NL
    t = t + "SUB RsSave (server AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                IF line.Trim() <> """" AND NOT line.Trim().Lower().StartsWith(""nameserver="") THEN out.Add(line)" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "        out.Insert(0, ""nameserver="" + server.Trim().Lower())" + NL
    t = t + "        FS.Write(RSINI, out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsWhy = err" + NL
    t = t + "    END TRY" + NL
    t = t + "    rsRead = FALSE" + NL
    t = t + "    RsForget()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RsForget ()" + NL
    t = t + "    rsName.Clear()" + NL
    t = t + "    rsTo.Clear()" + NL
    t = t + "    rsCanon.Clear()" + NL
    t = t + "    rsUntil.Clear()" + NL
    t = t + "    rsDown = FALSE" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsIsAddress (s AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF s.Split(""."").Count <> 4 THEN RETURN FALSE" + NL
    t = t + "    FOR EACH p IN s.Split(""."")" + NL
    t = t + "        IF p = """" OR p.Length > 3 THEN RETURN FALSE" + NL
    t = t + "        FOR i = 0 TO p.Length - 1" + NL
    t = t + "            IF NOT ""0123456789"".Contains(p.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name the server is asked about: lower case, the search domain added" + NL
    t = t + "' to a single word." + NL
    t = t + "FUNCTION RsFull (host AS String) AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF h.EndsWith(""."") THEN h = h.Substring(0, h.Length - 1)" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch <> """" THEN h = h + ""."" + rsSearch" + NL
    t = t + "    RETURN h" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a name is in the list of answers, or -1 (old answers are dropped)." + NL
    t = t + "FUNCTION RsFind (host AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = rsName.IndexOf(host.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN -1" + NL
    t = t + "    IF SYS.Ticks > rsUntil[i] THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "        RETURN -1" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsWants (host AS String) AS Bool" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF rsServer = """" OR h = """" OR h = ""localhost"" THEN RETURN FALSE" + NL
    t = t + "    IF rsDown AND SYS.Ticks - rsDownAt < RSQUIET THEN RETURN FALSE" + NL
    t = t + "    IF RsIsAddress(h) THEN RETURN FALSE" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch = """" THEN RETURN FALSE" + NL
    t = t + "    IF h = rsServer OR h = NET.HostName.Lower() THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(h) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Sends the question. A Connect, so it must be the last thing its handler" + NL
    t = t + "' does: if the name server refuses, the handler is spoiled (SIM95-NOTES.md)." + NL
    t = t + "SUB RsAsk (host AS String, address AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    IF IsNothing(rsSock) THEN" + NL
    t = t + "        rsSock = NET_Socket.New()" + NL
    t = t + "        rsSock.onMessage = Rs_OnMessage" + NL
    t = t + "    END IF" + NL
    t = t + "    rsAsking = host.Trim().Lower()" + NL
    t = t + "    rsAskAt = SYS.Ticks" + NL
    t = t + "    rsRefused = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = rsSock.Connect(address, RSPORT)" + NL
    t = t + "        conn.Tag = ""rs:"" + rsAsking" + NL
    t = t + "        conn.Send(""QUERY "" + RsFull(rsAsking) + "" A"")" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsRefused = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Gives up on the name server for a while: every name goes to SIM95." + NL
    t = t + "SUB RsGiveUp (why AS String)" + NL
    t = t + "    rsWhy = why" + NL
    t = t + "    rsDown = TRUE" + NL
    t = t + "    rsDownAt = SYS.Ticks" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsBusy () AS Bool" + NL
    t = t + "    IF rsAsking = """" THEN RETURN FALSE" + NL
    t = t + "    IF rsRefused THEN" + NL
    t = t + "        RsGiveUp(""the name server "" + rsServer + "" refused"")" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF SYS.Ticks - rsAskAt > RSWAIT THEN" + NL
    t = t + "        RsGiveUp(""no answer from the name server "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Rs_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    IF NOT conn.Tag.StartsWith(""rs:"") THEN RETURN" + NL
    t = t + "    h = conn.Tag.Substring(3, conn.Tag.Length - 3)" + NL
    t = t + "    conn.Tag = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        conn.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    RsTake(h, message)" + NL
    t = t + "    IF h = rsAsking THEN rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an answer: follows its CNAMEs to an address, or to the machine" + NL
    t = t + "' name the chain ends at." + NL
    t = t + "SUB RsTake (host AS String, reply AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR onward AS String" + NL
    t = t + "    VAR target AS String" + NL
    t = t + "    VAR canon AS String" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR hops AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    rsLastReply = reply" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(host, """", """", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(host, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    cur = RsFull(host)" + NL
    t = t + "    canon = cur" + NL
    t = t + "    FOR hops = 0 TO 8" + NL
    t = t + "        onward = """"" + NL
    t = t + "        FOR i = 1 TO lines.Count - 1" + NL
    t = t + "            w = lines[i].Split("" "")" + NL
    t = t + "            IF w.Count >= 4 THEN" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""A"" AND target = """" THEN target = w[3]" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""CNAME"" THEN onward = w[3]" + NL
    t = t + "                IF w[0] = cur AND (w[2] = ""A"" OR w[2] = ""CNAME"") AND Int(Val(w[1])) < ttl THEN ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF target <> """" THEN" + NL
    t = t + "            canon = cur" + NL
    t = t + "            BREAK" + NL
    t = t + "        END IF" + NL
    t = t + "        IF onward = """" THEN BREAK" + NL
    t = t + "        canon = cur" + NL
    t = t + "        cur = onward" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF target = """" THEN" + NL
    t = t + "        ' a name with no CNAME and no address: not one to connect to" + NL
    t = t + "        IF cur = RsFull(host) THEN" + NL
    t = t + "            RsKeep(host, """", """", RSNEG)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        ' the end of the chain: a SIM95 machine name" + NL
    t = t + "        target = cur" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ttl < 5 THEN ttl = 5" + NL
    t = t + "    RsKeep(host, target, canon, ttl * 1000)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RsKeep (host AS String, target AS String, canon AS String, ms AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    i = rsName.IndexOf(h)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF rsName.Count >= RSMOST THEN" + NL
    t = t + "        rsName.RemoveAt(0)" + NL
    t = t + "        rsTo.RemoveAt(0)" + NL
    t = t + "        rsCanon.RemoveAt(0)" + NL
    t = t + "        rsUntil.RemoveAt(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    rsName.Add(h)" + NL
    t = t + "    rsTo.Add(target)" + NL
    t = t + "    rsCanon.Add(canon)" + NL
    t = t + "    rsUntil.Add(SYS.Ticks + ms)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where to connect for host: what SimDNS said, or host itself." + NL
    t = t + "FUNCTION RsTarget (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name host's machine was found under (www.coolsite.sim), or host." + NL
    t = t + "FUNCTION RsCanonical (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsCanon[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS answer for host (so RsTarget is its machine)?" + NL
    t = t + "FUNCTION RsKnown (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] <> """"" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\PROGRAMS\DIG.SPK")
END SUB

SUB File17 ()
    t = ""
    t = t + "' RESOLVE.SPK - the SimDNS resolver: asks the name server named in" + NL
    t = t + "' C:\SYSTEM\RESOLV.INI which machine a name like www.coolsite.sim is on." + NL
    t = t + "'" + NL
    t = t + "' A library, not a program: a program has it joined on the end (the builder" + NL
    t = t + "' does this for Simxplorer and DIG; copy C:\PROGRAMS\RESOLVE.SPK onto the end" + NL
    t = t + "' of your own). Every name in it starts with Rs, so it can't clash." + NL
    t = t + "'" + NL
    t = t + "' C:\SYSTEM\RESOLV.INI, shared by every program on the machine:" + NL
    t = t + "'     nameserver=dnsbox          the machine running NAMED.SPK" + NL
    t = t + "'     search=coolsite.sim        optional: then ""www"" means www.coolsite.sim" + NL
    t = t + "'" + NL
    t = t + "' How to use it without ever waiting in the wrong place (SIM95-NOTES.md):" + NL
    t = t + "'   1. RsWants(host)  - does this name need asking? FALSE for addresses," + NL
    t = t + "'                       plain machine names, names already known, or when" + NL
    t = t + "'                       there is no name server (or it isn't answering)." + NL
    t = t + "'   2. RsAsk(host, address) - sends the question to the name server at that" + NL
    t = t + "'                       address. It is a Connect: let it be the last thing" + NL
    t = t + "'                       the handler does." + NL
    t = t + "'   3. RsBusy()       - TRUE while the answer is on its way. After RSWAIT" + NL
    t = t + "'                       with no answer the server is left alone for RSQUIET," + NL
    t = t + "'                       and every name goes to SIM95 as before." + NL
    t = t + "'   4. RsTarget(host) - where to connect: the machine name (or address) the" + NL
    t = t + "'                       name server gave, or the name itself when SimDNS" + NL
    t = t + "'                       doesn't know it, for SIM95 to look up." + NL
    t = t + "' Answers are kept for their TTL; names SimDNS doesn't know for RSNEG." + NL
    t = t + "" + NL
    t = t + "CONST RSINI = ""C:\SYSTEM\RESOLV.INI""" + NL
    t = t + "CONST RSPORT = 53" + NL
    t = t + "CONST RSWAIT = 2000             ' ms to wait for an answer" + NL
    t = t + "CONST RSQUIET = 30000            ' ms to leave a silent name server alone" + NL
    t = t + "CONST RSNEG = 60000             ' ms to remember that SimDNS doesn't know a name" + NL
    t = t + "CONST RSMOST = 100              ' names kept" + NL
    t = t + "" + NL
    t = t + "VAR rsServer AS String" + NL
    t = t + "VAR rsSearch AS String" + NL
    t = t + "VAR rsRead AS Bool" + NL
    t = t + "VAR rsReadAt AS Integer" + NL
    t = t + "VAR rsSock AS NET_Socket" + NL
    t = t + "VAR rsName AS Array OF String       ' the name as asked, lower case" + NL
    t = t + "VAR rsTo AS Array OF String         ' where it is ("""" when SimDNS doesn't know it)" + NL
    t = t + "VAR rsCanon AS Array OF String      ' its last name in DNS before the machine" + NL
    t = t + "VAR rsUntil AS Array OF Integer     ' SYS.Ticks when it is forgotten" + NL
    t = t + "VAR rsAsking AS String" + NL
    t = t + "VAR rsAskAt AS Integer" + NL
    t = t + "VAR rsRefused AS Bool" + NL
    t = t + "VAR rsDown AS Bool" + NL
    t = t + "VAR rsDownAt AS Integer" + NL
    t = t + "VAR rsWhy AS String                 ' the last thing that went wrong" + NL
    t = t + "VAR rsLastReply AS String           ' the last answer, as it came" + NL
    t = t + "" + NL
    t = t + "' Reads RESOLV.INI (again after a few seconds, so a new setting takes)." + NL
    t = t + "SUB RsConfig ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    IF rsRead AND SYS.Ticks - rsReadAt < 3000 THEN RETURN" + NL
    t = t + "    rsRead = TRUE" + NL
    t = t + "    rsReadAt = SYS.Ticks" + NL
    t = t + "    rsServer = """"" + NL
    t = t + "    rsSearch = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                low = line.Trim().Lower()" + NL
    t = t + "                IF low.StartsWith(""nameserver="") THEN rsServer = low.Substring(11, low.Length - 11).Trim()" + NL
    t = t + "                IF low.StartsWith(""search="") THEN rsSearch = low.Substring(7, low.Length - 7).Trim()" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF rsSearch.StartsWith(""."") THEN rsSearch = rsSearch.Substring(1, rsSearch.Length - 1)" + NL
    t = t + "    IF rsSearch.EndsWith(""."") THEN rsSearch = rsSearch.Substring(0, rsSearch.Length - 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The name server (a machine name or address), or """" for none." + NL
    t = t + "FUNCTION RsNameServer () AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsServer" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Makes server this machine's name server ("""" for none), keeping the rest" + NL
    t = t + "' of RESOLV.INI, and forgets everything it knew." + NL
    t = t + "SUB RsSave (server AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                IF line.Trim() <> """" AND NOT line.Trim().Lower().StartsWith(""nameserver="") THEN out.Add(line)" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "        out.Insert(0, ""nameserver="" + server.Trim().Lower())" + NL
    t = t + "        FS.Write(RSINI, out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsWhy = err" + NL
    t = t + "    END TRY" + NL
    t = t + "    rsRead = FALSE" + NL
    t = t + "    RsForget()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RsForget ()" + NL
    t = t + "    rsName.Clear()" + NL
    t = t + "    rsTo.Clear()" + NL
    t = t + "    rsCanon.Clear()" + NL
    t = t + "    rsUntil.Clear()" + NL
    t = t + "    rsDown = FALSE" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsIsAddress (s AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF s.Split(""."").Count <> 4 THEN RETURN FALSE" + NL
    t = t + "    FOR EACH p IN s.Split(""."")" + NL
    t = t + "        IF p = """" OR p.Length > 3 THEN RETURN FALSE" + NL
    t = t + "        FOR i = 0 TO p.Length - 1" + NL
    t = t + "            IF NOT ""0123456789"".Contains(p.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name the server is asked about: lower case, the search domain added" + NL
    t = t + "' to a single word." + NL
    t = t + "FUNCTION RsFull (host AS String) AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF h.EndsWith(""."") THEN h = h.Substring(0, h.Length - 1)" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch <> """" THEN h = h + ""."" + rsSearch" + NL
    t = t + "    RETURN h" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a name is in the list of answers, or -1 (old answers are dropped)." + NL
    t = t + "FUNCTION RsFind (host AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = rsName.IndexOf(host.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN -1" + NL
    t = t + "    IF SYS.Ticks > rsUntil[i] THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "        RETURN -1" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsWants (host AS String) AS Bool" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF rsServer = """" OR h = """" OR h = ""localhost"" THEN RETURN FALSE" + NL
    t = t + "    IF rsDown AND SYS.Ticks - rsDownAt < RSQUIET THEN RETURN FALSE" + NL
    t = t + "    IF RsIsAddress(h) THEN RETURN FALSE" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch = """" THEN RETURN FALSE" + NL
    t = t + "    IF h = rsServer OR h = NET.HostName.Lower() THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(h) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Sends the question. A Connect, so it must be the last thing its handler" + NL
    t = t + "' does: if the name server refuses, the handler is spoiled (SIM95-NOTES.md)." + NL
    t = t + "SUB RsAsk (host AS String, address AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    IF IsNothing(rsSock) THEN" + NL
    t = t + "        rsSock = NET_Socket.New()" + NL
    t = t + "        rsSock.onMessage = Rs_OnMessage" + NL
    t = t + "    END IF" + NL
    t = t + "    rsAsking = host.Trim().Lower()" + NL
    t = t + "    rsAskAt = SYS.Ticks" + NL
    t = t + "    rsRefused = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = rsSock.Connect(address, RSPORT)" + NL
    t = t + "        conn.Tag = ""rs:"" + rsAsking" + NL
    t = t + "        conn.Send(""QUERY "" + RsFull(rsAsking) + "" A"")" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsRefused = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Gives up on the name server for a while: every name goes to SIM95." + NL
    t = t + "SUB RsGiveUp (why AS String)" + NL
    t = t + "    rsWhy = why" + NL
    t = t + "    rsDown = TRUE" + NL
    t = t + "    rsDownAt = SYS.Ticks" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsBusy () AS Bool" + NL
    t = t + "    IF rsAsking = """" THEN RETURN FALSE" + NL
    t = t + "    IF rsRefused THEN" + NL
    t = t + "        RsGiveUp(""the name server "" + rsServer + "" refused"")" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF SYS.Ticks - rsAskAt > RSWAIT THEN" + NL
    t = t + "        RsGiveUp(""no answer from the name server "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Rs_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    IF NOT conn.Tag.StartsWith(""rs:"") THEN RETURN" + NL
    t = t + "    h = conn.Tag.Substring(3, conn.Tag.Length - 3)" + NL
    t = t + "    conn.Tag = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        conn.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    RsTake(h, message)" + NL
    t = t + "    IF h = rsAsking THEN rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an answer: follows its CNAMEs to an address, or to the machine" + NL
    t = t + "' name the chain ends at." + NL
    t = t + "SUB RsTake (host AS String, reply AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR onward AS String" + NL
    t = t + "    VAR target AS String" + NL
    t = t + "    VAR canon AS String" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR hops AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    rsLastReply = reply" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(host, """", """", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(host, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    cur = RsFull(host)" + NL
    t = t + "    canon = cur" + NL
    t = t + "    FOR hops = 0 TO 8" + NL
    t = t + "        onward = """"" + NL
    t = t + "        FOR i = 1 TO lines.Count - 1" + NL
    t = t + "            w = lines[i].Split("" "")" + NL
    t = t + "            IF w.Count >= 4 THEN" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""A"" AND target = """" THEN target = w[3]" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""CNAME"" THEN onward = w[3]" + NL
    t = t + "                IF w[0] = cur AND (w[2] = ""A"" OR w[2] = ""CNAME"") AND Int(Val(w[1])) < ttl THEN ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF target <> """" THEN" + NL
    t = t + "            canon = cur" + NL
    t = t + "            BREAK" + NL
    t = t + "        END IF" + NL
    t = t + "        IF onward = """" THEN BREAK" + NL
    t = t + "        canon = cur" + NL
    t = t + "        cur = onward" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF target = """" THEN" + NL
    t = t + "        ' a name with no CNAME and no address: not one to connect to" + NL
    t = t + "        IF cur = RsFull(host) THEN" + NL
    t = t + "            RsKeep(host, """", """", RSNEG)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        ' the end of the chain: a SIM95 machine name" + NL
    t = t + "        target = cur" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ttl < 5 THEN ttl = 5" + NL
    t = t + "    RsKeep(host, target, canon, ttl * 1000)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RsKeep (host AS String, target AS String, canon AS String, ms AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    i = rsName.IndexOf(h)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF rsName.Count >= RSMOST THEN" + NL
    t = t + "        rsName.RemoveAt(0)" + NL
    t = t + "        rsTo.RemoveAt(0)" + NL
    t = t + "        rsCanon.RemoveAt(0)" + NL
    t = t + "        rsUntil.RemoveAt(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    rsName.Add(h)" + NL
    t = t + "    rsTo.Add(target)" + NL
    t = t + "    rsCanon.Add(canon)" + NL
    t = t + "    rsUntil.Add(SYS.Ticks + ms)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where to connect for host: what SimDNS said, or host itself." + NL
    t = t + "FUNCTION RsTarget (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name host's machine was found under (www.coolsite.sim), or host." + NL
    t = t + "FUNCTION RsCanonical (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsCanon[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS answer for host (so RsTarget is its machine)?" + NL
    t = t + "FUNCTION RsKnown (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] <> """"" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\PROGRAMS\RESOLVE.SPK")
END SUB

SUB File18 ()
    t = ""
    t = t + "' HTTPD.SPK - the web server. Serves C:\WEB on port 80." + NL
    t = t + "' This is the program Voyager talks to when someone opens http://YOURNAME/." + NL
    t = t + "' Edit it, save, and run it again: the web server is now yours." + NL
    t = t + "' Files ending in .ASP are ActiveSparkPages: SPARK runs on this machine" + NL
    t = t + "' and the result is sent. See section 12 of C:\DOCS\SPARK.TXT." + NL
    t = t + "'" + NL
    t = t + "' SimDNS edition: the stock web server, plus virtual hosts. One machine can" + NL
    t = t + "' serve several sites, each from a folder of its own, listed in" + NL
    t = t + "' C:\WEB\VHOSTS.TXT, one a line:" + NL
    t = t + "'     www.coolsite.sim|C:\WEB\SITES\COOLSITE" + NL
    t = t + "'     *.dab.sim|C:\WEB\SITES\DAB          (any name ending in .dab.sim)" + NL
    t = t + "' A site is reached two ways:" + NL
    t = t + "'   * By its name (Simxplorer, with a SimDNS name server): the Host header" + NL
    t = t + "'     says www.coolsite.sim, and /page.htm is that folder's PAGE.HTM." + NL
    t = t + "'   * By path (Voyager, or anyone without SimDNS): http://alpha/www.coolsite.sim/page.htm" + NL
    t = t + "'     is the same file. /www.coolsite.sim on its own gets a slash added." + NL
    t = t + "' Anything else - this machine's own name, an address, a name not listed -" + NL
    t = t + "' is C:\WEB, exactly as before." + NL
    t = t + "'" + NL
    t = t + "' Server pages in a site run as usual (SERVER.ScriptName is the file on disk," + NL
    t = t + "' and imports are next to it). REQUEST.Path is the path inside the site, so" + NL
    t = t + "' relative links work both ways. REQUEST.Host is what the browser asked for:" + NL
    t = t + "' www.coolsite.sim by name, alpha by path. Two headers say the rest:" + NL
    t = t + "'     X-Site: www.coolsite.sim       the site being served" + NL
    t = t + "'     X-Base-Path: /www.coolsite.sim/   where the site starts on this server" + NL
    t = t + "'                                       (""/"" when reached by name)" + NL
    t = t + "' so a page's own address is ""http://"" + REQUEST.Host + X-Base-Path + page." + NL
    t = t + "' A RESPONSE.Redirect to ""/x.asp"" is put back inside the site by path. Links" + NL
    t = t + "' that start with / can't be: in a site, use relative links." + NL
    t = t + "'" + NL
    t = t + "' The stock web server is kept as C:\PROGRAMS\HTTPD.ORG. When SimDNS is" + NL
    t = t + "' uninstalled (C:\PROGRAMS\NAMED.SPK is gone), this one puts it back." + NL
    t = t + "" + NL
    t = t + "CONST VHOSTS = ""C:\WEB\VHOSTS.TXT""" + NL
    t = t + "CONST ME = ""C:\PROGRAMS\HTTPD.SPK""" + NL
    t = t + "CONST ORIGINAL = ""C:\PROGRAMS\HTTPD.ORG""" + NL
    t = t + "CONST SIMDNS = ""C:\PROGRAMS\NAMED.SPK""" + NL
    t = t + "" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR log AS GUI_ListBox" + NL
    t = t + "VAR sock AS NET_Socket" + NL
    t = t + "VAR timer AS GUI_Timer" + NL
    t = t + "VAR hits AS Integer" + NL
    t = t + "VAR NL AS String" + NL
    t = t + "VAR vText AS String = ""?""       ' VHOSTS.TXT as last read" + NL
    t = t + "VAR vName AS Array OF String    ' www.coolsite.sim, or *.dab.sim" + NL
    t = t + "VAR vDir AS Array OF String" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    NL = Chr(10)" + NL
    t = t + "    win = GUI_Window.New(""Web Server"", 420, 240)" + NL
    t = t + "    win.Icon = ""network""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    win.onResize = Win_OnResize" + NL
    t = t + "    log = GUI_ListBox.New(win)" + NL
    t = t + "    log.Mono = TRUE" + NL
    t = t + "    Win_OnResize()" + NL
    t = t + "" + NL
    t = t + "    sock = NET_Socket.New()" + NL
    t = t + "    sock.onConnect = Sock_OnConnect" + NL
    t = t + "    sock.onMessage = Sock_OnMessage" + NL
    t = t + "    sock.onError = Sock_OnError" + NL
    t = t + "    sock.Listen(80)" + NL
    t = t + "" + NL
    t = t + "    ' The address arrives from the network server a moment after we start, so keep the" + NL
    t = t + "    ' status line honest with a slow timer instead of showing 0.0.0.0 forever." + NL
    t = t + "    timer = GUI_Timer.New(win)" + NL
    t = t + "    timer.Interval = 1000" + NL
    t = t + "    timer.onTick = Timer_OnTick" + NL
    t = t + "    timer.Start()" + NL
    t = t + "    Timer_OnTick()" + NL
    t = t + "    win.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Timer_OnTick ()" + NL
    t = t + "    VAR sites AS String" + NL
    t = t + "    ' SimDNS uninstalled: the stock web server comes back" + NL
    t = t + "    IF FS.Exists(ORIGINAL) AND NOT FS.Exists(SIMDNS) THEN" + NL
    t = t + "        PutBack()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ReadHosts()" + NL
    t = t + "    IF vName.Count > 0 THEN sites = "" - "" + Str(vName.Count) + "" sites""" + NL
    t = t + "    IF NET.Online THEN" + NL
    t = t + "        win.Status = ""Listening on "" + NET.LocalAddress + "" port 80 - try http://"" + NET.HostName.Lower() + ""/"" + sites" + NL
    t = t + "    ELSE" + NL
    t = t + "        win.Status = ""Listening on port 80 - waiting for the network""" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB PutBack ()" + NL
    t = t + "    log.Add(""SimDNS is gone: the stock web server takes over again"")" + NL
    t = t + "    timer.Stop()" + NL
    t = t + "    sock.Close()" + NL
    t = t + "    TRY" + NL
    t = t + "        FS.Delete(ME)" + NL
    t = t + "        FS.Rename(ORIGINAL, ME)" + NL
    t = t + "        SYS.Run(ME)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        log.Add(""ERROR "" + err)" + NL
    t = t + "    END TRY" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnResize ()" + NL
    t = t + "    log.SetBounds(0, 0, win.Width, win.Height)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnConnect (conn AS NET_Connection)" + NL
    t = t + "    conn.Accept()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR query AS String" + NL
    t = t + "    VAR file AS String" + NL
    t = t + "    VAR host AS String" + NL
    t = t + "    VAR site AS String" + NL
    t = t + "    VAR root AS String = ""C:\WEB""" + NL
    t = t + "    VAR base AS String = ""/""" + NL
    t = t + "    VAR seg AS String" + NL
    t = t + "    VAR v AS Integer" + NL
    t = t + "    VAR shown AS String" + NL
    t = t + "" + NL
    t = t + "    lines = message.Lines()" + NL
    t = t + "    parts = lines[0].Split("" "")" + NL
    t = t + "    IF parts.Count < 2 OR (parts[0] <> ""GET"" AND parts[0] <> ""POST"") THEN" + NL
    t = t + "        SendError(conn, ""400 Bad Request"", ""Voyager sends GET or POST. This was neither."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    path = parts[1]" + NL
    t = t + "    IF path.IndexOf(""?"") >= 0 THEN" + NL
    t = t + "        query = path.Substring(path.IndexOf(""?""), path.Length - path.IndexOf(""?""))" + NL
    t = t + "        path = path.Substring(0, path.IndexOf(""?""))" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    ' Which site? First by the name the browser asked for, then by the first" + NL
    t = t + "    ' part of the path." + NL
    t = t + "    ReadHosts()" + NL
    t = t + "    host = HostHeader(lines)" + NL
    t = t + "    v = SiteIndex(host)" + NL
    t = t + "    IF v >= 0 THEN" + NL
    t = t + "        site = host" + NL
    t = t + "    ELSEIF path.Length > 1 THEN" + NL
    t = t + "        seg = path.Substring(1, path.Length - 1)" + NL
    t = t + "        IF seg.Contains(""/"") THEN seg = seg.Substring(0, seg.IndexOf(""/""))" + NL
    t = t + "        IF seg.Contains(""."") THEN v = SiteIndex(seg.Lower())" + NL
    t = t + "        IF v >= 0 THEN" + NL
    t = t + "            site = seg.Lower()" + NL
    t = t + "            ' /www.coolsite.sim is a folder: say so, so relative links work" + NL
    t = t + "            IF path.Length = seg.Length + 1 THEN" + NL
    t = t + "                Redirect(conn, path + ""/"" + query)" + NL
    t = t + "                RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "            base = ""/"" + seg + ""/""" + NL
    t = t + "            path = path.Substring(seg.Length + 1, path.Length - seg.Length - 1)" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    IF v >= 0 THEN root = vDir[v]" + NL
    t = t + "    file = PathToFile(path, root)" + NL
    t = t + "" + NL
    t = t + "    hits = hits + 1" + NL
    t = t + "    win.Title = ""Web Server ("" + Str(hits) + "" hits)""" + NL
    t = t + "    shown = path" + NL
    t = t + "    IF site <> """" THEN shown = site + path" + NL
    t = t + "    log.Add(TIME.Clock + ""  "" + conn.FromAddress + ""  "" + parts[0] + "" "" + shown)" + NL
    t = t + "    IF log.Count > 500 THEN log.RemoveAt(0)" + NL
    t = t + "    log.ScrollToEnd()" + NL
    t = t + "" + NL
    t = t + "    ' A directory with no INDEX.HTM may have an INDEX.ASP instead" + NL
    t = t + "    IF file.EndsWith(""\INDEX.HTM"") AND NOT FS.Exists(file) THEN file = file.Replace(""\INDEX.HTM"", ""\INDEX.ASP"")" + NL
    t = t + "" + NL
    t = t + "    IF file = """" OR NOT FS.Exists(file) OR FS.IsDir(file) THEN" + NL
    t = t + "        SendError(conn, ""404 Not Found"", ""There is no "" + shown + "" on this server."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    ' ActiveSparkPages: a .ASP file is run, not sent. ASP.Render returns the whole response," + NL
    t = t + "    ' and the page sees a POSTed form through REQUEST.Form. A page in a site" + NL
    t = t + "    ' sees the path inside the site, and X-Site and X-Base-Path." + NL
    t = t + "    IF file.EndsWith("".ASP"") THEN" + NL
    t = t + "        IF site = """" THEN" + NL
    t = t + "            conn.Send(ASP.Render(file, message, conn.FromAddress))" + NL
    t = t + "        ELSE" + NL
    t = t + "            conn.Send(InSite(ASP.Render(file, ForSite(message, path + query, site, base), conn.FromAddress), base))" + NL
    t = t + "        END IF" + NL
    t = t + "        conn.Close()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    ' Only a page can take a POST; a plain file has nothing to do with one" + NL
    t = t + "    IF parts[0] = ""POST"" THEN" + NL
    t = t + "        SendError(conn, ""405 Method Not Allowed"", path + "" is a file, not a page. Only .ASP pages accept a POST."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    conn.Send(""HTTP/1.0 200 OK"")" + NL
    t = t + "    conn.Send(""Server: HTTPD.SPK/1.1 (SIM95; SimDNS)"")" + NL
    t = t + "    conn.Send(""Content-Type: "" + ContentType(file))" + NL
    t = t + "    conn.Send("""")" + NL
    t = t + "    conn.Send(FS.Read(file))" + NL
    t = t + "    conn.Close()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- sites" + NL
    t = t + "" + NL
    t = t + "' Reads VHOSTS.TXT when it has changed. Folders must be in C:\WEB, so a site" + NL
    t = t + "' can't hand out C:\SYSTEM." + NL
    t = t + "SUB ReadHosts ()" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    text = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(VHOSTS) THEN text = FS.Read(VHOSTS)" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF text = vText THEN RETURN" + NL
    t = t + "    vText = text" + NL
    t = t + "    vName.Clear()" + NL
    t = t + "    vDir.Clear()" + NL
    t = t + "    FOR EACH line IN text.Lines()" + NL
    t = t + "        line = line.Trim()" + NL
    t = t + "        IF line = """" OR line.StartsWith("";"") OR line.StartsWith(""'"") OR line.StartsWith(""#"") OR NOT line.Contains(""|"") THEN CONTINUE" + NL
    t = t + "        name = line.Substring(0, line.IndexOf(""|"")).Trim().Lower()" + NL
    t = t + "        dir = line.Substring(line.IndexOf(""|"") + 1, line.Length - line.IndexOf(""|"") - 1).Trim().Upper()" + NL
    t = t + "        IF dir.EndsWith(""\"") THEN dir = dir.Substring(0, dir.Length - 1)" + NL
    t = t + "        IF name.EndsWith(""."") THEN name = name.Substring(0, name.Length - 1)" + NL
    t = t + "        IF name = """" OR NOT name.Contains(""."") OR dir.Contains("".."") THEN CONTINUE" + NL
    t = t + "        IF dir <> ""C:\WEB"" AND NOT dir.StartsWith(""C:\WEB\"") THEN" + NL
    t = t + "            log.Add(""VHOSTS.TXT: "" + name + "" is not in C:\WEB, so it is left out"")" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        vName.Add(name)" + NL
    t = t + "        vDir.Add(dir)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The site called name (exactly, else by a *. pattern), or -1." + NL
    t = t + "FUNCTION SiteIndex (name AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF name = """" THEN RETURN -1" + NL
    t = t + "    i = vName.IndexOf(name)" + NL
    t = t + "    IF i >= 0 THEN RETURN i" + NL
    t = t + "    FOR i = 0 TO vName.Count - 1" + NL
    t = t + "        IF vName[i].StartsWith(""*."") THEN" + NL
    t = t + "            IF name.EndsWith(vName[i].Substring(1, vName[i].Length - 1)) THEN RETURN i" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN -1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The Host header, lower case, without a port." + NL
    t = t + "FUNCTION HostHeader (lines AS Array OF String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    FOR i = 1 TO lines.Count - 1" + NL
    t = t + "        IF lines[i].Trim() = """" THEN RETURN """"" + NL
    t = t + "        IF lines[i].Lower().StartsWith(""host:"") THEN" + NL
    t = t + "            h = lines[i].Substring(5, lines[i].Length - 5).Trim().Lower()" + NL
    t = t + "            IF h.Contains("":"") THEN h = h.Substring(0, h.IndexOf("":""))" + NL
    t = t + "            RETURN h" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The request as a page in a site sees it: the path inside the site, and" + NL
    t = t + "' X-Site and X-Base-Path (any the browser sent are dropped). The body is" + NL
    t = t + "' left exactly as it came." + NL
    t = t + "FUNCTION ForSite (message AS String, inside AS String, site AS String, base AS String) AS String" + NL
    t = t + "    VAR head AS String" + NL
    t = t + "    VAR tail AS String" + NL
    t = t + "    VAR cut AS Integer" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR first AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    cut = message.IndexOf(NL + NL)" + NL
    t = t + "    IF cut < 0 THEN" + NL
    t = t + "        head = message" + NL
    t = t + "    ELSE" + NL
    t = t + "        head = message.Substring(0, cut)" + NL
    t = t + "        tail = message.Substring(cut, message.Length - cut)" + NL
    t = t + "    END IF" + NL
    t = t + "    first = head.Lines()[0].Split("" "")" + NL
    t = t + "    out = first[0] + "" "" + inside" + NL
    t = t + "    FOR i = 2 TO first.Count - 1" + NL
    t = t + "        out = out + "" "" + first[i]" + NL
    t = t + "    NEXT" + NL
    t = t + "    i = 0" + NL
    t = t + "    FOR EACH line IN head.Lines()" + NL
    t = t + "        i = i + 1" + NL
    t = t + "        IF i = 1 OR line.Trim() = """" THEN CONTINUE" + NL
    t = t + "        IF line.Lower().StartsWith(""x-site:"") OR line.Lower().StartsWith(""x-base-path:"") THEN CONTINUE" + NL
    t = t + "        out = out + NL + line" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out + NL + ""X-Site: "" + site + NL + ""X-Base-Path: "" + base + tail" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A page's answer, with a Location of ""/..."" put back inside the site." + NL
    t = t + "FUNCTION InSite (response AS String, base AS String) AS String" + NL
    t = t + "    VAR cut AS Integer" + NL
    t = t + "    VAR head AS String" + NL
    t = t + "    IF base = ""/"" THEN RETURN response" + NL
    t = t + "    cut = response.IndexOf(NL + NL)" + NL
    t = t + "    IF cut < 0 THEN cut = response.Length" + NL
    t = t + "    head = response.Substring(0, cut)" + NL
    t = t + "    IF NOT head.Contains(NL + ""Location: /"") THEN RETURN response" + NL
    t = t + "    IF head.Contains(NL + ""Location: //"") THEN RETURN response" + NL
    t = t + "    RETURN head.Replace(NL + ""Location: /"", NL + ""Location: "" + base) + response.Substring(cut, response.Length - cut)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Redirect (conn AS NET_Connection, there AS String)" + NL
    t = t + "    conn.Send(""HTTP/1.0 302 Found"")" + NL
    t = t + "    conn.Send(""Location: "" + there)" + NL
    t = t + "    conn.Send(""Content-Type: text/html"")" + NL
    t = t + "    conn.Send("""")" + NL
    t = t + "    conn.Send(""<html><body><p>This site is at <a href="""""" + there + """""">"" + there + ""</a>.</p></body></html>"")" + NL
    t = t + "    conn.Close()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION PathToFile (path AS String, root AS String) AS String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    p = path.Replace(""/"", ""\"").Upper()" + NL
    t = t + "    IF p.Contains("".."") THEN RETURN """"" + NL
    t = t + "    IF p.EndsWith(""\"") THEN p = p + ""INDEX.HTM""" + NL
    t = t + "    IF p = """" THEN p = ""\INDEX.HTM""" + NL
    t = t + "    RETURN root + p" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ContentType (file AS String) AS String" + NL
    t = t + "    IF file.EndsWith("".HTM"") THEN RETURN ""text/html""" + NL
    t = t + "    IF file.EndsWith("".PIC"") THEN RETURN ""image/x-sim95pic""" + NL
    t = t + "    RETURN ""text/plain""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SendError (conn AS NET_Connection, status AS String, text AS String)" + NL
    t = t + "    conn.Send(""HTTP/1.0 "" + status)" + NL
    t = t + "    conn.Send(""Content-Type: text/html"")" + NL
    t = t + "    conn.Send("""")" + NL
    t = t + "    conn.Send(""<html><head><title>"" + status + ""</title></head><body><h1>"" + status + ""</h1><p>"" + text + ""</p><hr><i>HTTPD.SPK on "" + NET.HostName + ""</i></body></html>"")" + NL
    t = t + "    conn.Close()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnError (message AS String)" + NL
    t = t + "    win.Status = ""Error: "" + message" + NL
    t = t + "    log.Add(""ERROR "" + message)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    sock.Close()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    Put("C:\PROGRAMS\HTTPD.SPK")
END SUB

SUB StartService (name AS String, program AS String, runFile AS String)
    VAR task AS String
    FS.Write("C:\SYSTEM\STARTUP\" + runFile, program)
    Print("  " + name + " will start with the machine (C:\SYSTEM\STARTUP\" + runFile + ")")
    FOR EACH task IN SYS.Tasks()
        IF task.Split("|")[1].Upper() = name THEN
            SYS.Kill(Int(Val(task.Split("|")[0])))
            Print("  stopped the old " + name)
        END IF
    NEXT
    SYS.Run(program)
    Print("  started " + program)
END SUB

' HTTPD.SPK serves INDEX.ASP for a folder only when it has no INDEX.HTM, so the
' stock home page steps aside (to the first free name) instead of being deleted.
SUB MoveHomePage ()
    VAR names AS Array OF String
    VAR name AS String
    IF NOT FS.Exists("C:\WEB\INDEX.HTM") THEN RETURN
    names = ["WELCOME.HTM", "INDEX1.HTM", "INDEX2.HTM", "INDEX3.HTM", "INDEX4.HTM", "INDEX5.HTM", "INDEX6.HTM", "INDEX7.HTM", "INDEX8.HTM", "INDEX9.HTM"]
    FOR EACH name IN names
        IF NOT FS.Exists("C:\WEB\" + name) THEN
            FS.Rename("C:\WEB\INDEX.HTM", "C:\WEB\" + name)
            Print("  moved the old home page to C:\WEB\" + name)
            RETURN
        END IF
    NEXT
    THROW "C:\WEB\INDEX.HTM is in the way and there is nowhere to move it. Rename it yourself and run this again."
END SUB

' SimDNS's setup, run by its installer: before the files are written, the
' folders and the stock web server's backup; after them, the web server
' restarted so the new one (with virtual hosts) takes over.

CONST STOCKHTTPD = "C:\PROGRAMS\HTTPD.ORG"

SUB DnsSetup ()
    IF NOT FS.Exists("C:\DNS") THEN FS.MakeDir("C:\DNS")
    IF NOT FS.Exists("C:\DNS\NAMED.CNF") THEN
        FS.Write("C:\DNS\NAMED.CNF", "; NAMED.CNF - the zones this machine's name server (NAMED.SPK) answers for," + NL _
            + "; one a line:   primary  <domain>  <zone file in C:\DNS>" + NL _
            + "; SimNIC, the registrar, adds a line for every domain it registers. Names" + NL _
            + "; that aren't in any zone here can be asked of another SimDNS:" + NL _
            + ";   forwarders  dnsbox" + NL)
        Print("  wrote C:\DNS\NAMED.CNF")
    END IF
    IF NOT FS.Exists("C:\WEB\SITES") THEN FS.MakeDir("C:\WEB\SITES")
    IF NOT FS.Exists("C:\WEB\VHOSTS.TXT") THEN
        FS.Write("C:\WEB\VHOSTS.TXT", "; VHOSTS.TXT - sites the web server serves by name, one a line: domain|folder" + NL _
            + "; (folders in C:\WEB). SimNIC's Host it here adds lines here. For example:" + NL _
            + ";   www.coolsite.sim|C:\WEB\SITES\COOLSITE" + NL _
            + ";   *.dab.sim|C:\WEB\SITES\DAB" + NL)
        Print("  wrote C:\WEB\VHOSTS.TXT")
    END IF
    ' this machine looks names up with its own name server, unless it has one
    IF NOT FS.Exists("C:\SYSTEM\RESOLV.INI") THEN
        FS.Write("C:\SYSTEM\RESOLV.INI", "nameserver=" + NET.HostName.Lower() + NL)
        Print("  this machine's name server is itself (C:\SYSTEM\RESOLV.INI)")
    END IF
    ' the stock web server is kept, once, so uninstalling can put it back
    IF FS.Exists("C:\PROGRAMS\HTTPD.SPK") AND NOT FS.Exists(STOCKHTTPD) THEN
        IF NOT FS.Read("C:\PROGRAMS\HTTPD.SPK").Contains("SimDNS edition") THEN
            FS.Write(STOCKHTTPD, FS.Read("C:\PROGRAMS\HTTPD.SPK"))
            Print("  kept the old web server as " + STOCKHTTPD)
        END IF
    END IF
END SUB

' Stops the running web server and starts the new one. If the web server is
' off (Settings), it stays off: the new one starts when it is turned on.
SUB RestartWeb ()
    VAR task AS String
    VAR was AS Bool
    FOR EACH task IN SYS.Tasks()
        IF task.Split("|")[1].Upper() = "HTTPD" THEN
            SYS.Kill(Int(Val(task.Split("|")[0])))
            was = TRUE
        END IF
    NEXT
    IF was THEN
        SYS.Run("C:\PROGRAMS\HTTPD.SPK")
        Print("  restarted the web server: it serves the sites in C:\WEB\VHOSTS.TXT by name")
    ELSE
        Print("  the web server is off (Settings); the new one starts when it is turned on")
    END IF
END SUB
