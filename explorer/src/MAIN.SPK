' Ticks, and what can be chosen now.
SUB UpdateMenus ()
    VAR n AS Integer
    VAR one AS Integer
    VAR fileish AS Bool
    n = SelCount()
    one = FirstSel()
    fileish = NOT IsVirtual(cur) OR cur = "::FIND"
    bar.SetChecked("Toolbar", showToolbar)
    bar.SetChecked("Address Bar", showAddress)
    bar.SetChecked("Status Bar", statusOn)
    bar.SetChecked("Folders", showTree)
    bar.SetChecked("Large Icons", viewMode = "large")
    bar.SetChecked("Small Icons", viewMode = "small")
    bar.SetChecked("List", viewMode = "list")
    bar.SetChecked("Details", viewMode = "details")
    bar.SetChecked("Arrange by Name", sortBy = "name")
    bar.SetChecked("Arrange by Type", sortBy = "type")
    bar.SetChecked("Arrange by Size", sortBy = "size")
    bar.SetEnabled("Open", n > 0)
    bar.SetEnabled("Explore", n = 1 AND IsFolderish(one))
    bar.SetEnabled("Edit", n = 1 AND KindOf(one) = "F")
    bar.SetEnabled("New Folder", CanWriteHere())
    bar.SetEnabled("New Text Document", CanWriteHere())
    bar.SetEnabled("Delete", n > 0 AND (fileish OR cur = "::RECYCLE" OR AllKind("NETDRIVE")))
    bar.SetEnabled("Rename", n = 1 AND (KindOf(one) = "F" OR KindOf(one) = "D") AND cur <> "::RECYCLE")
    bar.SetEnabled("Properties", TRUE)
    bar.SetEnabled("Restore", cur = "::RECYCLE" AND n > 0)
    bar.SetEnabled("Empty Recycle Bin", BinLines().Count > 0)
    bar.SetEnabled("Undo", undoKind <> "")
    bar.SetEnabled("Cut", n > 0 AND CanCopySel())
    bar.SetEnabled("Copy", n > 0 AND CanCopySel())
    bar.SetEnabled("Paste", CanWriteHere() AND FS.Exists(CLIPFILE))
    bar.SetEnabled("Back", hi > 0)
    bar.SetEnabled("Forward", hi < hist.Count - 1)
    bar.SetEnabled("Up One Level", ParentOf(cur) <> "")
    bar.SetEnabled("Disconnect Network Drive...", dLetter.Count > 0)
    DrawToolbar()
END SUB

SUB Menu_OnSelect (item AS String)
    IF busy THEN RETURN
    EndRename(TRUE)
    busy = TRUE
    TRY
        DoCommand(item)
    CATCH err
        IF NOT err.StartsWith("!cancel") THEN ShowError(err)
    END TRY
    busy = FALSE
    CloseProgress()
    keys.Focus()
    UpdateMenus()
END SUB

' ---------------------------------------------------------------- the toolbar

SUB MakeToolbar ()
    VAR ids AS Array OF String
    VAR id AS String
    VAR x AS Integer
    ids = ["back", "fwd", "up", "|", "map", "unmap", "|", "cut", "copy", "paste", "|", "undo", "del", "props", "|", "large", "small", "list", "details"]
    x = 214
    FOR EACH id IN ids
        tbId.Add(id)
        tbX.Add(x)
        IF id = "|" THEN
            x = x + 8
        ELSE
            x = x + 24
        END IF
    NEXT
    tbDown = -1
END SUB

FUNCTION TbHint (id AS String) AS String
    SELECT CASE id
        CASE "back"
            RETURN "Back"
        CASE "fwd"
            RETURN "Forward"
        CASE "up"
            RETURN "Up One Level"
        CASE "map"
            RETURN "Map Network Drive"
        CASE "unmap"
            RETURN "Disconnect Net Drive"
        CASE "cut"
            RETURN "Cut"
        CASE "copy"
            RETURN "Copy"
        CASE "paste"
            RETURN "Paste"
        CASE "undo"
            RETURN "Undo"
        CASE "del"
            RETURN "Delete"
        CASE "props"
            RETURN "Properties"
        CASE "large"
            RETURN "Large Icons"
        CASE "small"
            RETURN "Small Icons"
        CASE "list"
            RETURN "List"
        CASE "details"
            RETURN "Details"
    END SELECT
    RETURN ""
END FUNCTION

FUNCTION TbEnabled (id AS String) AS Bool
    SELECT CASE id
        CASE "back"
            RETURN hi > 0
        CASE "fwd"
            RETURN hi < hist.Count - 1
        CASE "up"
            RETURN ParentOf(cur) <> ""
        CASE "unmap"
            RETURN dLetter.Count > 0
        CASE "cut", "copy"
            RETURN SelCount() > 0 AND CanCopySel()
        CASE "paste"
            RETURN CanWriteHere() AND FS.Exists(CLIPFILE)
        CASE "undo"
            RETURN undoKind <> ""
        CASE "del"
            RETURN SelCount() > 0 AND (NOT IsVirtual(cur) OR cur = "::RECYCLE" OR cur = "::FIND")
    END SELECT
    RETURN TRUE
END FUNCTION

SUB Tb_OnDraw (c AS GUI_Canvas)
    DrawToolbar()
END SUB

SUB DrawToolbar ()
    VAR i AS Integer
    VAR id AS String
    VAR x AS Integer
    VAR on AS Bool
    VAR latched AS Bool
    IF NOT showToolbar OR IsNothing(tb) THEN RETURN
    tb.SetColor(7)
    tb.FillRect(0, 0, tb.Width, TBH)
    ' the band's edges: a raised strip
    tb.SetColor(15)
    tb.Line(0, 0, tb.Width, 0)
    tb.SetColor(8)
    tb.Line(0, TBH - 2, tb.Width, TBH - 2)
    tb.SetColor(15)
    tb.Line(0, TBH - 1, tb.Width, TBH - 1)
    FOR i = 0 TO tbId.Count - 1
        id = tbId[i]
        x = tbX[i]
        IF id = "|" THEN
            tb.SetColor(8)
            tb.Line(x + 3, 4, x + 3, TBH - 6)
            tb.SetColor(15)
            tb.Line(x + 4, 4, x + 4, TBH - 6)
            CONTINUE
        END IF
        IF x + 23 > tb.Width THEN CONTINUE
        on = TbEnabled(id)
        latched = id = viewMode
        IF i = tbDown OR latched THEN
            Bevel(tb, x, 3, 23, 22, FALSE)
            IF latched AND i <> tbDown THEN tb.Picture(x + 2, 5, picLatch)
            tb.Picture(x + 4, 7, ToolIcon(id, on))
        ELSE
            Bevel(tb, x, 3, 23, 22, TRUE)
            tb.Picture(x + 3, 6, ToolIcon(id, on))
        END IF
    NEXT
END SUB

FUNCTION TbAt (x AS Integer, y AS Integer) AS Integer
    VAR i AS Integer
    IF y < 3 OR y > 25 THEN RETURN -1
    FOR i = 0 TO tbId.Count - 1
        IF tbId[i] <> "|" AND x >= tbX[i] AND x < tbX[i] + 23 THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

SUB Tb_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)
    VAR i AS Integer
    IF busy THEN RETURN
    i = TbAt(x, y)
    IF i < 0 THEN RETURN
    IF NOT TbEnabled(tbId[i]) THEN RETURN
    tbDown = i
    DrawToolbar()
END SUB

SUB Tb_OnMouseUp (x AS Integer, y AS Integer, button AS Integer)
    VAR i AS Integer
    VAR was AS Integer
    was = tbDown
    tbDown = -1
    IF was < 0 THEN RETURN
    DrawToolbar()
    i = TbAt(x, y)
    IF i <> was THEN RETURN
    Menu_OnSelect(TbCommand(tbId[i]))
END SUB

SUB Tb_OnMouseMove (x AS Integer, y AS Integer)
    VAR i AS Integer
    VAR hint AS String
    i = TbAt(x, y)
    hint = ""
    IF i >= 0 THEN hint = TbHint(tbId[i])
    IF hint <> tbHintNow THEN
        tbHintNow = hint
        IF hint <> "" AND statusOn THEN
            win.Status = hint
        ELSE
            ShowStatus()
        END IF
    END IF
END SUB

FUNCTION TbCommand (id AS String) AS String
    SELECT CASE id
        CASE "back"
            RETURN "Back"
        CASE "fwd"
            RETURN "Forward"
        CASE "up"
            RETURN "Up One Level"
        CASE "map"
            RETURN "Map Network Drive..."
        CASE "unmap"
            RETURN "Disconnect Network Drive..."
        CASE "cut"
            RETURN "Cut"
        CASE "copy"
            RETURN "Copy"
        CASE "paste"
            RETURN "Paste"
        CASE "undo"
            RETURN "Undo"
        CASE "del"
            RETURN "Delete"
        CASE "props"
            RETURN "Properties"
        CASE "large"
            RETURN "Large Icons"
        CASE "small"
            RETURN "Small Icons"
        CASE "list"
            RETURN "List"
        CASE "details"
            RETURN "Details"
    END SELECT
    RETURN ""
END FUNCTION

' The folder box: Desktop, the folders down to this one, the drives, the network.
SUB FillCombo ()
    VAR chain AS Array OF String
    VAR p AS String
    VAR i AS Integer
    VAR items AS Array OF String
    VAR at AS Integer
    VAR d AS Integer
    p = cur
    WHILE p <> ""
        chain.Insert(0, p)
        p = ParentOf(p)
    END WHILE
    comboPaths.Clear()
    ComboAdd(items, "::DESKTOP", 0)
    ComboAdd(items, "::COMPUTER", 1)
    ComboAdd(items, "C:\", 2)
    IF chain.Count > 3 AND chain[2] = "C:\" THEN
        FOR i = 3 TO chain.Count - 1
            ComboAdd(items, chain[i], i)
        NEXT
    END IF
    FOR d = 0 TO dLetter.Count - 1
        ComboAdd(items, dLetter[d] + ":\", 2)
        IF chain.Count > 3 AND chain[2] = dLetter[d] + ":\" THEN
            FOR i = 3 TO chain.Count - 1
                ComboAdd(items, chain[i], i)
            NEXT
        END IF
    NEXT
    ComboAdd(items, "::NETWORK", 1)
    IF chain.Count > 2 AND chain[1] = "::NETWORK" THEN
        FOR i = 2 TO chain.Count - 1
            ComboAdd(items, chain[i], i)
        NEXT
    END IF
    ComboAdd(items, "::RECYCLE", 1)
    IF cur = "::FIND" THEN ComboAdd(items, "::FIND", 1)
    comboSetting = TRUE
    combo.Items = items
    at = comboPaths.IndexOf(cur)
    combo.Selected = at
    comboSetting = FALSE
END SUB

SUB ComboAdd (items AS Array OF String, p AS String, depth AS Integer)
    VAR pad AS String
    VAR k AS Integer
    FOR k = 1 TO depth
        pad = pad + Chr(160) + Chr(160) + Chr(160)
    NEXT
    items.Add(pad + PlaceLabel(p))
    comboPaths.Add(p)
END SUB

SUB Combo_OnSelect ()
    IF comboSetting OR busy THEN RETURN
    IF combo.Selected < 0 OR combo.Selected >= comboPaths.Count THEN RETURN
    Menu_OnSelect("!go " + comboPaths[combo.Selected])
END SUB

SUB Addr_OnEnter ()
    IF busy THEN RETURN
    Menu_OnSelect("!go " + addr.Text)
END SUB

' ---------------------------------------------------------------- going places

' Shows a folder (a file: opens it). Remembered for Back, unless Back took us.
SUB Go (target AS String)
    VAR p AS String
    VAR kind AS String
    p = Normalize(target, cur)
    IF p = "" THEN THROW "Cannot find '" + target + "'. Make sure the path or folder name is correct."
    IF NOT IsVirtual(p) THEN
        kind = VStat(p)
        IF kind = "" THEN THROW "Cannot find '" + target + "'. Make sure the path or folder name is correct."
        IF kind = "F" THEN
            OpenFile(p, FALSE)
            RETURN
        END IF
    END IF
    cur = p
    IF NOT travelling THEN
        IF hi < 0 OR hist[MATH.Max(0, hi)] <> cur THEN
            WHILE hist.Count > hi + 1
                hist.RemoveAt(hist.Count - 1)
            END WHILE
            hist.Add(cur)
            hi = hist.Count - 1
        END IF
    END IF
    ' the tree shows where we are
    p = ParentOf(cur)
    WHILE p <> ""
        IF NOT expanded.Contains("|" + p + "|") THEN expanded = expanded + p + "|"
        p = ParentOf(p)
    END WHILE
    listTop = 0
    listLeft = 0
    Refresh(FALSE)
END SUB

SUB Travel (i AS Integer)
    IF i < 0 OR i >= hist.Count THEN RETURN
    hi = i
    travelling = TRUE
    TRY
        Go(hist[i])
    CATCH err
        travelling = FALSE
        THROW err
    END TRY
    travelling = FALSE
END SUB

' Reads the folder again, and the tree, and shows them.
SUB Refresh (keepSel AS Bool)
    VAR keep AS String
    VAR i AS Integer
    keep = "|"
    IF keepSel THEN
        FOR i = 0 TO cName.Count - 1
            IF cSel[i] THEN keep = keep + cPath[i] + "|"
        NEXT
    END IF
    LoadDrives()
    LoadContents()
    FOR i = 0 TO cName.Count - 1
        cSel[i] = keep.Contains("|" + cPath[i] + "|")
    NEXT
    cFocus = FirstSel()
    BuildTree()
    LayoutList()
    ScrollTreeTo(tPath.IndexOf(cur))
    IF showAddress THEN addr.Text = AddressFor(cur)
    IF showToolbar THEN FillCombo()
    Redraw()
    ShowStatus()
    UpdateMenus()
    ' (last: the title says the folder is all there)
    win.Title = TitleFor(cur)
END SUB

FUNCTION TitleFor (p AS String) AS String
    IF showTree THEN RETURN "Exploring - " + PlaceLabel(p)
    RETURN PlaceLabel(p)
END FUNCTION

FUNCTION AddressFor (p AS String) AS String
    IF IsVirtual(p) THEN RETURN PlaceLabel(p)
    RETURN p
END FUNCTION
