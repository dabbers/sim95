SUB Main ()
    VAR a AS String
    VAR start AS String
    VAR k AS Integer
    LoadIcons()
    LoadSettings()
    LoadDrives()
    IF NOT FS.Exists(TEMPDIR) THEN MakeDirs(TEMPDIR)
    start = ""
    FOR k = 0 TO SYS.Args.Count - 1
        a = SYS.Args[k]
        IF a.Lower() = "/folder" OR a.Lower() = "/n" THEN
            showTree = FALSE
        ELSEIF a.Lower() = "/e" THEN
            showTree = TRUE
        ELSEIF start = "" THEN
            start = a
        END IF
    NEXT
    cur = "::COMPUTER"
    IF start <> "" THEN
        IF Normalize(start, "C:\") <> "" THEN cur = Normalize(start, "C:\")
        ' a file: its folder, with it picked
        IF NOT IsVirtual(cur) AND NOT IsRemote(cur) THEN
            IF FS.Exists(cur) AND NOT FS.IsDir(cur) THEN cur = ParentOf(cur)
        END IF
    END IF
    expanded = "|::DESKTOP|::COMPUTER|"
    hi = -1
    cFocus = -1
    cAnchor = -1
    focusTree = FALSE

    win = GUI_Window.New("Exploring", 720, 440)
    win.Icon = "computer"
    win.onResize = Win_OnResize
    win.onClose = Win_OnClose
    MakeMenus()
    ' (the toolbar canvas first, so the folder box sits on top of it)
    tb = GUI_Canvas.New(win)
    tb.Background = 7
    tb.onDraw = Tb_OnDraw
    tb.onMouseDown = Tb_OnMouseDown
    tb.onMouseUp = Tb_OnMouseUp
    tb.onMouseMove = Tb_OnMouseMove
    combo = GUI_DropDown.New(win)
    combo.onSelect = Combo_OnSelect
    addrLabel = GUI_Label.New(win)
    addrLabel.Text = "A&ddress"
    addr = GUI_TextBox.New(win)
    addr.onEnter = Addr_OnEnter
    ' a button too small to see, under the canvas: its keys are the tree's and the files'
    keys = GUI_Button.New(win)
    keys.SetBounds(2, TBH + ADDRH + 2, 1, 1)
    keys.onKey = Keys_OnKey
    cv = GUI_Canvas.New(win)
    cv.Background = 7
    cv.onDraw = Cv_OnDraw
    cv.onMouseDown = Cv_OnMouseDown
    cv.onMouseMove = Cv_OnMouseMove
    cv.onMouseUp = Cv_OnMouseUp
    ren = GUI_TextBox.New(win)
    ren.Visible = FALSE
    ren.onEnter = Ren_OnEnter
    ren.onKey = Ren_OnKey
    ren.MaxLength = 12
    dialTimer = GUI_Timer.New(win)
    dialTimer.Interval = 20
    dialTimer.onTick = Dial_OnTick
    dialTimer.Start()
    clock = GUI_Timer.New(win)
    clock.Interval = 1500
    clock.onTick = Clock_OnTick
    clock.Start()
    MakeToolbar()
    Layout()
    win.Show()
    keys.Focus()
    Act("!go " + cur)
    IF hist.Count = 0 THEN Act("!go ::COMPUTER")
END SUB

SUB Win_OnClose ()
    SaveSettings()
    ' this session's drives go with the last Explorer window
    IF NOT OtherExplorers() THEN SaveDrives(FALSE)
    SYS.Exit(0)
END SUB

FUNCTION OtherExplorers () AS Bool
    VAR t AS String
    FOR EACH t IN SYS.Tasks()
        IF t.Split("|").Count > 1 THEN
            IF t.Split("|")[0] <> Str(SYS.Pid) AND t.Split("|")[1].Upper().StartsWith("EXPLORER") THEN RETURN TRUE
        END IF
    NEXT
    RETURN FALSE
END FUNCTION

' ---------------------------------------------------------------- settings

SUB LoadSettings ()
    VAR line AS String
    VAR k AS String
    VAR v AS String
    viewMode = "large"
    sortBy = "name"
    showTree = TRUE
    showToolbar = TRUE
    showAddress = TRUE
    statusOn = TRUE
    hideExt = FALSE
    showCaps = FALSE
    treeW = 230
    IF NOT FS.Exists(SETFILE) THEN RETURN
    FOR EACH line IN FS.Read(SETFILE).Lines()
        IF NOT line.Contains("=") THEN CONTINUE
        k = line.Substring(0, line.IndexOf("=")).Trim().Lower()
        v = line.Substring(line.IndexOf("=") + 1, line.Length - line.IndexOf("=") - 1).Trim()
        SELECT CASE k
            CASE "view"
                IF "|large|small|list|details|".Contains("|" + v + "|") THEN viewMode = v
            CASE "sort"
                IF "|name|type|size|".Contains("|" + v + "|") THEN sortBy = v
            CASE "tree"
                showTree = v = "1"
            CASE "toolbar"
                showToolbar = v = "1"
            CASE "address"
                showAddress = v = "1"
            CASE "status"
                statusOn = v = "1"
            CASE "hideext"
                hideExt = v = "1"
            CASE "caps"
                showCaps = v = "1"
            CASE "treewidth"
                treeW = MATH.Max(80, MATH.Min(400, Int(Val(v))))
        END SELECT
    NEXT
END SUB

FUNCTION Flag (b AS Bool) AS String
    IF b THEN RETURN "1"
    RETURN "0"
END FUNCTION

SUB SaveSettings ()
    TRY
        FS.Write(SETFILE, "view=" + viewMode + Chr(10) + "sort=" + sortBy + Chr(10) + "tree=" + Flag(showTree) + Chr(10) + "toolbar=" + Flag(showToolbar) + Chr(10) + "address=" + Flag(showAddress) + Chr(10) + "status=" + Flag(statusOn) + Chr(10) + "hideext=" + Flag(hideExt) + Chr(10) + "caps=" + Flag(showCaps) + Chr(10) + "treewidth=" + Str(treeW) + Chr(10))
    CATCH err
    END TRY
END SUB

' ---------------------------------------------------------------- layout

FUNCTION TopOfView () AS Integer
    VAR y AS Integer
    IF showToolbar THEN y = y + TBH
    IF showAddress THEN y = y + ADDRH
    RETURN y
END FUNCTION

SUB Layout ()
    VAR y AS Integer
    tb.Visible = showToolbar
    combo.Visible = showToolbar
    IF showToolbar THEN
        tb.SetBounds(0, 0, win.Width, TBH)
        combo.SetBounds(6, 4, 200, 22)
        y = TBH
    END IF
    addrLabel.Visible = showAddress
    addr.Visible = showAddress
    IF showAddress THEN
        addrLabel.SetBounds(6, y + 6, 50, 14)
        addr.SetBounds(58, y + 2, win.Width - 64, 21)
        y = y + ADDRH
    END IF
    cv.SetBounds(0, y, win.Width, MATH.Max(40, win.Height - y))
    IF treeW > win.Width - 120 THEN treeW = MATH.Max(80, win.Width - 120)
    IF NOT statusOn THEN win.Status = ""
END SUB

SUB Win_OnResize ()
    EndRename(FALSE)
    Layout()
    LayoutList()
    DrawToolbar()
    Redraw()
END SUB

