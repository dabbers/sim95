' VAPOR|id=EXPLORER|name=Explorer|kind=program|version=6c2a7437|category=System|run=C:\PROGRAMS\EXPLORER.SPK|files=C:\PROGRAMS\EXPLORER.SPK|tasks=EXPLORER|startup=|folder=|about=The file manager as Windows 95 has it: folders in a tree, files as icons, a list or details, and the network in the same window. Map another machine's disk as Z: and it's there every time. Drag and drop, Cut, Copy and Paste between machines, a Recycle Bin, Find, and Undo.
' INSTALL.SPK - puts Explorer on this machine. Generated by tools/build-installer.mjs;
' edit the files in explorer/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It writes
' C:\PROGRAMS\EXPLORER.SPK: the file manager as Windows 95 has it, with the
' folders in a tree and the network beside them. Tools > Map Network Drive
' makes another machine's disk a drive letter. It asks whether My Computer and
' My Files on the desktop should open Explorer: then C:\PROGRAMS\FILES.SPK
' starts Explorer, and the Files that was there is kept as FILES.BAK.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)




    File0()
    Print("Explorer is installed (1 files).")
    ExplorerDefault()

    Print("Open Explorer from C:\PROGRAMS\EXPLORER.SPK, or My Computer on the desktop.")
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "' EXPLORER.SPK - Explorer, the file manager as Windows 95 has it: the folders" + NL
    t = t + "' in a tree on the left, what's in one on the right as icons, a list or" + NL
    t = t + "' details, and the network in the same window. Map another machine's disk as" + NL
    t = t + "' a drive letter (Tools > Map Network Drive: Z: is \\BRAVO\MYFILES) and it's in" + NL
    t = t + "' the tree under My Computer, next to (C:), every time Explorer starts." + NL
    t = t + "'" + NL
    t = t + "'   EXPLORER.SPK                  opens My Computer... or the folder given:" + NL
    t = t + "'   EXPLORER.SPK C:\MYFILES       EXPLORER.SPK \\BRAVO\       EXPLORER.SPK Z:\" + NL
    t = t + "'   EXPLORER.SPK /folder C:\DOCS  a folder window, without the tree" + NL
    t = t + "'" + NL
    t = t + "' Copy, Cut and Paste work between Explorer windows (C:\SYSTEM\EXPCLIP.TXT)," + NL
    t = t + "' and between machines; so do dragging files onto a folder (a move on the" + NL
    t = t + "' same disk, a copy to another one, as Windows does it; drag with the right" + NL
    t = t + "' button to choose). Deleting from C: goes to the Recycle Bin (C:\RECYCLED)." + NL
    t = t + "' A file on another machine opens in a copy here, and what you save goes back." + NL
    t = t + "'" + NL
    t = t + "' Built from explorer/src: MAIN (this), VFS (paths, the network, drives, the" + NL
    t = t + "' Recycle Bin), VIEW (drawing the tree and the files, the mouse and keys)," + NL
    t = t + "' ACTIONS (what the menus do, and the dialogs) and the icons, which" + NL
    t = t + "' tools/build-installer.mjs makes from explorer/src/ICONS.TXT." + NL
    t = t + "" + NL
    t = t + "CONST ME = ""C:\PROGRAMS\EXPLORER.SPK""" + NL
    t = t + "CONST DRIVESFILE = ""C:\SYSTEM\DRIVES.INI""" + NL
    t = t + "CONST PWLFILE = ""C:\SYSTEM\PASSWORD.PWL""" + NL
    t = t + "CONST CLIPFILE = ""C:\SYSTEM\EXPCLIP.TXT""" + NL
    t = t + "CONST SETFILE = ""C:\SYSTEM\EXPLORER.INI""" + NL
    t = t + "CONST BINDIR = ""C:\RECYCLED""" + NL
    t = t + "CONST TEMPDIR = ""C:\SYSTEM\TEMP""" + NL
    t = t + "CONST ROWH = 18" + NL
    t = t + "CONST TBH = 30" + NL
    t = t + "CONST ADDRH = 26" + NL
    t = t + "CONST HEADH = 20" + NL
    t = t + "CONST SBW = 16" + NL
    t = t + "CONST SPLITW = 5" + NL
    t = t + "CONST INDENT = 19" + NL
    t = t + "" + NL
    t = t + "' ---- the window and its controls" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR bar AS GUI_Menu" + NL
    t = t + "VAR ctx AS GUI_Menu" + NL
    t = t + "VAR tb AS GUI_Canvas" + NL
    t = t + "VAR combo AS GUI_DropDown" + NL
    t = t + "VAR addrLabel AS GUI_Label" + NL
    t = t + "VAR addr AS GUI_TextBox" + NL
    t = t + "VAR cv AS GUI_Canvas" + NL
    t = t + "VAR keys AS GUI_Button               ' takes the keys for the tree and the files (a Canvas gets none)" + NL
    t = t + "VAR ren AS GUI_TextBox               ' typing a new name, over the old one" + NL
    t = t + "VAR dialTimer AS GUI_Timer" + NL
    t = t + "VAR clock AS GUI_Timer" + NL
    t = t + "VAR comboPaths AS Array OF String" + NL
    t = t + "VAR comboSetting AS Bool" + NL
    t = t + "" + NL
    t = t + "' ---- settings (C:\SYSTEM\EXPLORER.INI)" + NL
    t = t + "VAR viewMode AS String               ' large, small, list, details" + NL
    t = t + "VAR sortBy AS String                 ' name, type, size" + NL
    t = t + "VAR showTree AS Bool" + NL
    t = t + "VAR showToolbar AS Bool" + NL
    t = t + "VAR showAddress AS Bool" + NL
    t = t + "VAR statusOn AS Bool" + NL
    t = t + "VAR hideExt AS Bool" + NL
    t = t + "VAR showCaps AS Bool" + NL
    t = t + "VAR treeW AS Integer" + NL
    t = t + "" + NL
    t = t + "' ---- where we are, and have been" + NL
    t = t + "VAR cur AS String" + NL
    t = t + "VAR hist AS Array OF String" + NL
    t = t + "VAR hi AS Integer" + NL
    t = t + "VAR travelling AS Bool" + NL
    t = t + "" + NL
    t = t + "' ---- the tree: what's showing, top to bottom" + NL
    t = t + "VAR tPath AS Array OF String" + NL
    t = t + "VAR tLabel AS Array OF String" + NL
    t = t + "VAR tIcon AS Array OF String" + NL
    t = t + "VAR tDepth AS Array OF Integer" + NL
    t = t + "VAR tKids AS Array OF Integer        ' 0 none, 1 some, 2 not looked yet" + NL
    t = t + "VAR tOpen AS Array OF Bool" + NL
    t = t + "VAR tLines AS Array OF String        ' for each level above, ""1"": its line goes on down" + NL
    t = t + "VAR tLast AS Array OF Bool" + NL
    t = t + "VAR expanded AS String               ' |path|path|" + NL
    t = t + "VAR noKids AS String                 ' |path| looked in, and nothing there" + NL
    t = t + "VAR treeTop AS Integer" + NL
    t = t + "VAR focusTree AS Bool" + NL
    t = t + "" + NL
    t = t + "' ---- the files in the folder" + NL
    t = t + "VAR cName AS Array OF String" + NL
    t = t + "VAR cPath AS Array OF String" + NL
    t = t + "VAR cKind AS Array OF String         ' F, D, DRIVE, NETDRIVE, MACHINE, PLACE, APP" + NL
    t = t + "VAR cSize AS Array OF Integer" + NL
    t = t + "VAR cType AS Array OF String" + NL
    t = t + "VAR cIcon AS Array OF String" + NL
    t = t + "VAR cExtra AS Array OF String        ' Recycle Bin: where it was; Find: the folder it's in" + NL
    t = t + "VAR cSel AS Array OF Bool" + NL
    t = t + "VAR itX AS Array OF Integer" + NL
    t = t + "VAR itY AS Array OF Integer" + NL
    t = t + "VAR itW AS Array OF Integer" + NL
    t = t + "VAR itH AS Array OF Integer" + NL
    t = t + "VAR cFocus AS Integer" + NL
    t = t + "VAR cAnchor AS Integer" + NL
    t = t + "VAR listTop AS Integer" + NL
    t = t + "VAR listLeft AS Integer" + NL
    t = t + "VAR extentW AS Integer" + NL
    t = t + "VAR extentH AS Integer" + NL
    t = t + "VAR colW AS Array OF Integer" + NL
    t = t + "VAR cutSet AS String" + NL
    t = t + "VAR listError AS String" + NL
    t = t + "" + NL
    t = t + "' ---- the mouse" + NL
    t = t + "VAR mode AS String                   ' """", press, drag, band, split, tthumb, lthumb, hthumb" + NL
    t = t + "VAR downX AS Integer" + NL
    t = t + "VAR downY AS Integer" + NL
    t = t + "VAR downItem AS Integer" + NL
    t = t + "VAR downButton AS Integer" + NL
    t = t + "VAR grabOffset AS Integer" + NL
    t = t + "VAR clickItem AS Integer" + NL
    t = t + "VAR clickAt AS Integer" + NL
    t = t + "VAR clickNode AS Integer" + NL
    t = t + "VAR dropTarget AS String" + NL
    t = t + "VAR bandX AS Integer" + NL
    t = t + "VAR bandY AS Integer" + NL
    t = t + "VAR lastPaint AS Integer" + NL
    t = t + "VAR tbDown AS Integer" + NL
    t = t + "VAR tbHintNow AS String" + NL
    t = t + "" + NL
    t = t + "' ---- the toolbar" + NL
    t = t + "VAR tbId AS Array OF String" + NL
    t = t + "VAR tbX AS Array OF Integer" + NL
    t = t + "" + NL
    t = t + "' ---- the network (VFS)" + NL
    t = t + "VAR dialState AS String" + NL
    t = t + "VAR dialHost AS String" + NL
    t = t + "VAR dialErr AS String" + NL
    t = t + "VAR dialConn AS NET_Connection" + NL
    t = t + "VAR dialSock AS NET_Socket" + NL
    t = t + "VAR nHost AS Array OF String" + NL
    t = t + "VAR nConn AS Array OF NET_Connection" + NL
    t = t + "VAR nSock AS Array OF NET_Socket" + NL
    t = t + "VAR nReply AS Array OF String" + NL
    t = t + "VAR nGot AS Array OF Bool" + NL
    t = t + "VAR nClosed AS Array OF Bool" + NL
    t = t + "VAR nAuthed AS Array OF Bool" + NL
    t = t + "VAR lHost AS Array OF String" + NL
    t = t + "VAR lUser AS Array OF String" + NL
    t = t + "VAR lPass AS Array OF String" + NL
    t = t + "VAR dLetter AS Array OF String" + NL
    t = t + "VAR dTarget AS Array OF String" + NL
    t = t + "VAR dKeep AS Array OF Bool" + NL
    t = t + "VAR dDown AS Array OF Bool" + NL
    t = t + "VAR machineNames AS Array OF String" + NL
    t = t + "VAR machinesKnown AS Bool" + NL
    t = t + "VAR mFiles AS Integer" + NL
    t = t + "VAR mFolders AS Integer" + NL
    t = t + "VAR mBytes AS Integer" + NL
    t = t + "" + NL
    t = t + "' ---- jobs, dialogs, undo" + NL
    t = t + "VAR busy AS Bool" + NL
    t = t + "VAR cancelFlag AS Bool" + NL
    t = t + "VAR opStart AS Integer" + NL
    t = t + "VAR progWin AS GUI_Window" + NL
    t = t + "VAR progWhat AS GUI_Label" + NL
    t = t + "VAR progFrom AS GUI_Label" + NL
    t = t + "VAR progBar AS GUI_ProgressBar" + NL
    t = t + "VAR progShown AS Bool" + NL
    t = t + "VAR progCount AS Integer" + NL
    t = t + "VAR dlg AS GUI_Window" + NL
    t = t + "VAR dlgDone AS Bool" + NL
    t = t + "VAR dlgOk AS Bool" + NL
    t = t + "VAR dBox1 AS GUI_TextBox" + NL
    t = t + "VAR dBox2 AS GUI_TextBox" + NL
    t = t + "VAR dCheck1 AS GUI_CheckBox" + NL
    t = t + "VAR dCheck2 AS GUI_CheckBox" + NL
    t = t + "VAR dDrop AS GUI_DropDown" + NL
    t = t + "VAR dList AS GUI_ListBox" + NL
    t = t + "VAR lgWin AS GUI_Window" + NL
    t = t + "VAR lgUser AS GUI_TextBox" + NL
    t = t + "VAR lgPass AS GUI_TextBox" + NL
    t = t + "VAR lgSave AS GUI_CheckBox" + NL
    t = t + "VAR lgDone AS Bool" + NL
    t = t + "VAR lgOk AS Bool" + NL
    t = t + "VAR wLocal AS Array OF String        ' files from other machines open here: the copy," + NL
    t = t + "VAR wRemote AS Array OF String       ' where it came from," + NL
    t = t + "VAR wText AS Array OF String         ' and what it held when last sent" + NL
    t = t + "VAR undoKind AS String" + NL
    t = t + "VAR undoData AS Array OF String" + NL
    t = t + "VAR findName AS String" + NL
    t = t + "VAR findText AS String" + NL
    t = t + "VAR findWhere AS String" + NL
    t = t + "VAR findPaths AS Array OF String" + NL
    t = t + "VAR promptAnswer AS String" + NL
    t = t + "VAR repainted AS Bool" + NL
    t = t + "VAR triedHost AS String" + NL
    t = t + "VAR triedUser AS String" + NL
    t = t + "" + NL
    t = t + "' ---- icons (filled by LoadIcons, at the end)" + NL
    t = t + "VAR icName AS Array OF String" + NL
    t = t + "VAR ic16 AS Array OF String" + NL
    t = t + "VAR ic16s AS Array OF String" + NL
    t = t + "VAR ic16g AS Array OF String" + NL
    t = t + "VAR ic32 AS Array OF String" + NL
    t = t + "VAR ic32s AS Array OF String" + NL
    t = t + "VAR ic32g AS Array OF String" + NL
    t = t + "VAR icTool AS Array OF String" + NL
    t = t + "VAR icToolOff AS Array OF String" + NL
    t = t + "VAR picPlus AS String" + NL
    t = t + "VAR picMinus AS String" + NL
    t = t + "VAR picVDots AS String" + NL
    t = t + "VAR picVHalf AS String" + NL
    t = t + "VAR picLatch AS String" + NL
    t = t + "VAR picHDots AS String" + NL
    t = t + "VAR picTrack AS String" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR start AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    LoadIcons()" + NL
    t = t + "    LoadSettings()" + NL
    t = t + "    LoadDrives()" + NL
    t = t + "    IF NOT FS.Exists(TEMPDIR) THEN MakeDirs(TEMPDIR)" + NL
    t = t + "    start = """"" + NL
    t = t + "    FOR k = 0 TO SYS.Args.Count - 1" + NL
    t = t + "        a = SYS.Args[k]" + NL
    t = t + "        IF a.Lower() = ""/folder"" OR a.Lower() = ""/n"" THEN" + NL
    t = t + "            showTree = FALSE" + NL
    t = t + "        ELSEIF a.Lower() = ""/e"" THEN" + NL
    t = t + "            showTree = TRUE" + NL
    t = t + "        ELSEIF start = """" THEN" + NL
    t = t + "            start = a" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    cur = ""::COMPUTER""" + NL
    t = t + "    IF start <> """" THEN" + NL
    t = t + "        IF Normalize(start, ""C:\"") <> """" THEN cur = Normalize(start, ""C:\"")" + NL
    t = t + "        ' a file: its folder, with it picked" + NL
    t = t + "        IF NOT IsVirtual(cur) AND NOT IsRemote(cur) THEN" + NL
    t = t + "            IF FS.Exists(cur) AND NOT FS.IsDir(cur) THEN cur = ParentOf(cur)" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    expanded = ""|::DESKTOP|::COMPUTER|""" + NL
    t = t + "    hi = -1" + NL
    t = t + "    cFocus = -1" + NL
    t = t + "    cAnchor = -1" + NL
    t = t + "    focusTree = FALSE" + NL
    t = t + "" + NL
    t = t + "    win = GUI_Window.New(""Exploring"", 720, 440)" + NL
    t = t + "    win.Icon = ""computer""" + NL
    t = t + "    win.onResize = Win_OnResize" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    MakeMenus()" + NL
    t = t + "    ' (the toolbar canvas first, so the folder box sits on top of it)" + NL
    t = t + "    tb = GUI_Canvas.New(win)" + NL
    t = t + "    tb.Background = 7" + NL
    t = t + "    tb.onDraw = Tb_OnDraw" + NL
    t = t + "    tb.onMouseDown = Tb_OnMouseDown" + NL
    t = t + "    tb.onMouseUp = Tb_OnMouseUp" + NL
    t = t + "    tb.onMouseMove = Tb_OnMouseMove" + NL
    t = t + "    combo = GUI_DropDown.New(win)" + NL
    t = t + "    combo.onSelect = Combo_OnSelect" + NL
    t = t + "    addrLabel = GUI_Label.New(win)" + NL
    t = t + "    addrLabel.Text = ""A&ddress""" + NL
    t = t + "    addr = GUI_TextBox.New(win)" + NL
    t = t + "    addr.onEnter = Addr_OnEnter" + NL
    t = t + "    ' a button too small to see, under the canvas: its keys are the tree's and the files'" + NL
    t = t + "    keys = GUI_Button.New(win)" + NL
    t = t + "    keys.SetBounds(2, TBH + ADDRH + 2, 1, 1)" + NL
    t = t + "    keys.onKey = Keys_OnKey" + NL
    t = t + "    cv = GUI_Canvas.New(win)" + NL
    t = t + "    cv.Background = 7" + NL
    t = t + "    cv.onDraw = Cv_OnDraw" + NL
    t = t + "    cv.onMouseDown = Cv_OnMouseDown" + NL
    t = t + "    cv.onMouseMove = Cv_OnMouseMove" + NL
    t = t + "    cv.onMouseUp = Cv_OnMouseUp" + NL
    t = t + "    ren = GUI_TextBox.New(win)" + NL
    t = t + "    ren.Visible = FALSE" + NL
    t = t + "    ren.onEnter = Ren_OnEnter" + NL
    t = t + "    ren.onKey = Ren_OnKey" + NL
    t = t + "    ren.MaxLength = 12" + NL
    t = t + "    dialTimer = GUI_Timer.New(win)" + NL
    t = t + "    dialTimer.Interval = 20" + NL
    t = t + "    dialTimer.onTick = Dial_OnTick" + NL
    t = t + "    dialTimer.Start()" + NL
    t = t + "    clock = GUI_Timer.New(win)" + NL
    t = t + "    clock.Interval = 1500" + NL
    t = t + "    clock.onTick = Clock_OnTick" + NL
    t = t + "    clock.Start()" + NL
    t = t + "    MakeToolbar()" + NL
    t = t + "    Layout()" + NL
    t = t + "    win.Show()" + NL
    t = t + "    keys.Focus()" + NL
    t = t + "    Act(""!go "" + cur)" + NL
    t = t + "    IF hist.Count = 0 THEN Act(""!go ::COMPUTER"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    SaveSettings()" + NL
    t = t + "    ' this session's drives go with the last Explorer window" + NL
    t = t + "    IF NOT OtherExplorers() THEN SaveDrives(FALSE)" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION OtherExplorers () AS Bool" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    FOR EACH t IN SYS.Tasks()" + NL
    t = t + "        IF t.Split(""|"").Count > 1 THEN" + NL
    t = t + "            IF t.Split(""|"")[0] <> Str(SYS.Pid) AND t.Split(""|"")[1].Upper().StartsWith(""EXPLORER"") THEN RETURN TRUE" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- settings" + NL
    t = t + "" + NL
    t = t + "SUB LoadSettings ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR k AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    viewMode = ""large""" + NL
    t = t + "    sortBy = ""name""" + NL
    t = t + "    showTree = TRUE" + NL
    t = t + "    showToolbar = TRUE" + NL
    t = t + "    showAddress = TRUE" + NL
    t = t + "    statusOn = TRUE" + NL
    t = t + "    hideExt = FALSE" + NL
    t = t + "    showCaps = FALSE" + NL
    t = t + "    treeW = 230" + NL
    t = t + "    IF NOT FS.Exists(SETFILE) THEN RETURN" + NL
    t = t + "    FOR EACH line IN FS.Read(SETFILE).Lines()" + NL
    t = t + "        IF NOT line.Contains(""="") THEN CONTINUE" + NL
    t = t + "        k = line.Substring(0, line.IndexOf(""="")).Trim().Lower()" + NL
    t = t + "        v = line.Substring(line.IndexOf(""="") + 1, line.Length - line.IndexOf(""="") - 1).Trim()" + NL
    t = t + "        SELECT CASE k" + NL
    t = t + "            CASE ""view""" + NL
    t = t + "                IF ""|large|small|list|details|"".Contains(""|"" + v + ""|"") THEN viewMode = v" + NL
    t = t + "            CASE ""sort""" + NL
    t = t + "                IF ""|name|type|size|"".Contains(""|"" + v + ""|"") THEN sortBy = v" + NL
    t = t + "            CASE ""tree""" + NL
    t = t + "                showTree = v = ""1""" + NL
    t = t + "            CASE ""toolbar""" + NL
    t = t + "                showToolbar = v = ""1""" + NL
    t = t + "            CASE ""address""" + NL
    t = t + "                showAddress = v = ""1""" + NL
    t = t + "            CASE ""status""" + NL
    t = t + "                statusOn = v = ""1""" + NL
    t = t + "            CASE ""hideext""" + NL
    t = t + "                hideExt = v = ""1""" + NL
    t = t + "            CASE ""caps""" + NL
    t = t + "                showCaps = v = ""1""" + NL
    t = t + "            CASE ""treewidth""" + NL
    t = t + "                treeW = MATH.Max(80, MATH.Min(400, Int(Val(v))))" + NL
    t = t + "        END SELECT" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Flag (b AS Bool) AS String" + NL
    t = t + "    IF b THEN RETURN ""1""" + NL
    t = t + "    RETURN ""0""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SaveSettings ()" + NL
    t = t + "    TRY" + NL
    t = t + "        FS.Write(SETFILE, ""view="" + viewMode + Chr(10) + ""sort="" + sortBy + Chr(10) + ""tree="" + Flag(showTree) + Chr(10) + ""toolbar="" + Flag(showToolbar) + Chr(10) + ""address="" + Flag(showAddress) + Chr(10) + ""status="" + Flag(statusOn) + Chr(10) + ""hideext="" + Flag(hideExt) + Chr(10) + ""caps="" + Flag(showCaps) + Chr(10) + ""treewidth="" + Str(treeW) + Chr(10))" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- layout" + NL
    t = t + "" + NL
    t = t + "FUNCTION TopOfView () AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    IF showToolbar THEN y = y + TBH" + NL
    t = t + "    IF showAddress THEN y = y + ADDRH" + NL
    t = t + "    RETURN y" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Layout ()" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    tb.Visible = showToolbar" + NL
    t = t + "    combo.Visible = showToolbar" + NL
    t = t + "    IF showToolbar THEN" + NL
    t = t + "        tb.SetBounds(0, 0, win.Width, TBH)" + NL
    t = t + "        combo.SetBounds(6, 4, 200, 22)" + NL
    t = t + "        y = TBH" + NL
    t = t + "    END IF" + NL
    t = t + "    addrLabel.Visible = showAddress" + NL
    t = t + "    addr.Visible = showAddress" + NL
    t = t + "    IF showAddress THEN" + NL
    t = t + "        addrLabel.SetBounds(6, y + 6, 50, 14)" + NL
    t = t + "        addr.SetBounds(58, y + 2, win.Width - 64, 21)" + NL
    t = t + "        y = y + ADDRH" + NL
    t = t + "    END IF" + NL
    t = t + "    cv.SetBounds(0, y, win.Width, MATH.Max(40, win.Height - y))" + NL
    t = t + "    IF treeW > win.Width - 120 THEN treeW = MATH.Max(80, win.Width - 120)" + NL
    t = t + "    IF NOT statusOn THEN win.Status = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnResize ()" + NL
    t = t + "    EndRename(FALSE)" + NL
    t = t + "    Layout()" + NL
    t = t + "    LayoutList()" + NL
    t = t + "    DrawToolbar()" + NL
    t = t + "    Redraw()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the menus" + NL
    t = t + "" + NL
    t = t + "SUB MakeMenus ()" + NL
    t = t + "    bar = GUI_Menu.New(win)" + NL
    t = t + "    bar.AddMenu(""&File"")" + NL
    t = t + "    bar.AddItem(""&File"", ""&Open"")" + NL
    t = t + "    bar.AddItem(""&File"", ""&Explore"")" + NL
    t = t + "    bar.AddItem(""&File"", ""&Edit"")" + NL
    t = t + "    bar.AddSeparator(""&File"")" + NL
    t = t + "    bar.AddItem(""&File"", ""New &Folder"")" + NL
    t = t + "    bar.AddItem(""&File"", ""New &Text Document"")" + NL
    t = t + "    bar.AddSeparator(""&File"")" + NL
    t = t + "    bar.AddItem(""&File"", ""&Delete"" + Chr(9) + ""Del"")" + NL
    t = t + "    bar.AddItem(""&File"", ""Rena&me"" + Chr(9) + ""F2"")" + NL
    t = t + "    bar.AddItem(""&File"", ""P&roperties"" + Chr(9) + ""Alt+Enter"")" + NL
    t = t + "    bar.AddSeparator(""&File"")" + NL
    t = t + "    bar.AddItem(""&File"", ""Restore"")" + NL
    t = t + "    bar.AddItem(""&File"", ""Empty Recycle &Bin"")" + NL
    t = t + "    bar.AddSeparator(""&File"")" + NL
    t = t + "    bar.AddItem(""&File"", ""&Close"")" + NL
    t = t + "    bar.AddMenu(""&Edit"")" + NL
    t = t + "    bar.AddItem(""&Edit"", ""&Undo"" + Chr(9) + ""Ctrl+Z"")" + NL
    t = t + "    bar.AddSeparator(""&Edit"")" + NL
    t = t + "    bar.AddItem(""&Edit"", ""Cu&t"" + Chr(9) + ""Ctrl+X"")" + NL
    t = t + "    bar.AddItem(""&Edit"", ""&Copy"" + Chr(9) + ""Ctrl+C"")" + NL
    t = t + "    bar.AddItem(""&Edit"", ""&Paste"" + Chr(9) + ""Ctrl+V"")" + NL
    t = t + "    bar.AddSeparator(""&Edit"")" + NL
    t = t + "    bar.AddItem(""&Edit"", ""Select &All"" + Chr(9) + ""Ctrl+A"")" + NL
    t = t + "    bar.AddItem(""&Edit"", ""&Invert Selection"")" + NL
    t = t + "    bar.AddMenu(""&View"")" + NL
    t = t + "    bar.AddItem(""&View"", ""&Toolbar"")" + NL
    t = t + "    bar.AddItem(""&View"", ""&Address Bar"")" + NL
    t = t + "    bar.AddItem(""&View"", ""Status &Bar"")" + NL
    t = t + "    bar.AddItem(""&View"", ""&Folders"")" + NL
    t = t + "    bar.AddSeparator(""&View"")" + NL
    t = t + "    bar.AddItem(""&View"", ""Lar&ge Icons"")" + NL
    t = t + "    bar.AddItem(""&View"", ""S&mall Icons"")" + NL
    t = t + "    bar.AddItem(""&View"", ""&List"")" + NL
    t = t + "    bar.AddItem(""&View"", ""&Details"")" + NL
    t = t + "    bar.AddSeparator(""&View"")" + NL
    t = t + "    bar.AddItem(""&View"", ""Arrange by &Name"")" + NL
    t = t + "    bar.AddItem(""&View"", ""Arrange by T&ype"")" + NL
    t = t + "    bar.AddItem(""&View"", ""Arrange by Si&ze"")" + NL
    t = t + "    bar.AddSeparator(""&View"")" + NL
    t = t + "    bar.AddItem(""&View"", ""&Refresh"" + Chr(9) + ""F5"")" + NL
    t = t + "    bar.AddItem(""&View"", ""&Options..."")" + NL
    t = t + "    bar.AddMenu(""&Go"")" + NL
    t = t + "    bar.AddItem(""&Go"", ""&Back"" + Chr(9) + ""Alt+Left"")" + NL
    t = t + "    bar.AddItem(""&Go"", ""&Forward"" + Chr(9) + ""Alt+Right"")" + NL
    t = t + "    bar.AddItem(""&Go"", ""&Up One Level"" + Chr(9) + ""Backspace"")" + NL
    t = t + "    bar.AddSeparator(""&Go"")" + NL
    t = t + "    bar.AddItem(""&Go"", ""&My Computer"")" + NL
    t = t + "    bar.AddItem(""&Go"", ""My &Files"")" + NL
    t = t + "    bar.AddItem(""&Go"", ""&Network Neighborhood"")" + NL
    t = t + "    bar.AddItem(""&Go"", ""&Recycle Bin"")" + NL
    t = t + "    bar.AddMenu(""&Tools"")" + NL
    t = t + "    bar.AddItem(""&Tools"", ""&Find..."" + Chr(9) + ""F3"")" + NL
    t = t + "    bar.AddSeparator(""&Tools"")" + NL
    t = t + "    bar.AddItem(""&Tools"", ""&Map Network Drive..."")" + NL
    t = t + "    bar.AddItem(""&Tools"", ""&Disconnect Network Drive..."")" + NL
    t = t + "    bar.AddSeparator(""&Tools"")" + NL
    t = t + "    bar.AddItem(""&Tools"", ""&Go to..."" + Chr(9) + ""Ctrl+G"")" + NL
    t = t + "    bar.AddMenu(""&Help"")" + NL
    t = t + "    bar.AddItem(""&Help"", ""&About Explorer"")" + NL
    t = t + "    bar.onSelect = Menu_OnSelect" + NL
    t = t + "    ctx = GUI_Menu.New(win)" + NL
    t = t + "    ctx.onSelect = Menu_OnSelect" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Ticks, and what can be chosen now." + NL
    t = t + "SUB UpdateMenus ()" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR one AS Integer" + NL
    t = t + "    VAR fileish AS Bool" + NL
    t = t + "    n = SelCount()" + NL
    t = t + "    one = FirstSel()" + NL
    t = t + "    fileish = NOT IsVirtual(cur) OR cur = ""::FIND""" + NL
    t = t + "    bar.SetChecked(""Toolbar"", showToolbar)" + NL
    t = t + "    bar.SetChecked(""Address Bar"", showAddress)" + NL
    t = t + "    bar.SetChecked(""Status Bar"", statusOn)" + NL
    t = t + "    bar.SetChecked(""Folders"", showTree)" + NL
    t = t + "    bar.SetChecked(""Large Icons"", viewMode = ""large"")" + NL
    t = t + "    bar.SetChecked(""Small Icons"", viewMode = ""small"")" + NL
    t = t + "    bar.SetChecked(""List"", viewMode = ""list"")" + NL
    t = t + "    bar.SetChecked(""Details"", viewMode = ""details"")" + NL
    t = t + "    bar.SetChecked(""Arrange by Name"", sortBy = ""name"")" + NL
    t = t + "    bar.SetChecked(""Arrange by Type"", sortBy = ""type"")" + NL
    t = t + "    bar.SetChecked(""Arrange by Size"", sortBy = ""size"")" + NL
    t = t + "    bar.SetEnabled(""Open"", n > 0)" + NL
    t = t + "    bar.SetEnabled(""Explore"", n = 1 AND IsFolderish(one))" + NL
    t = t + "    bar.SetEnabled(""Edit"", n = 1 AND KindOf(one) = ""F"")" + NL
    t = t + "    bar.SetEnabled(""New Folder"", CanWriteHere())" + NL
    t = t + "    bar.SetEnabled(""New Text Document"", CanWriteHere())" + NL
    t = t + "    bar.SetEnabled(""Delete"", n > 0 AND (fileish OR cur = ""::RECYCLE"" OR AllKind(""NETDRIVE"")))" + NL
    t = t + "    bar.SetEnabled(""Rename"", n = 1 AND (KindOf(one) = ""F"" OR KindOf(one) = ""D"") AND cur <> ""::RECYCLE"")" + NL
    t = t + "    bar.SetEnabled(""Properties"", TRUE)" + NL
    t = t + "    bar.SetEnabled(""Restore"", cur = ""::RECYCLE"" AND n > 0)" + NL
    t = t + "    bar.SetEnabled(""Empty Recycle Bin"", BinLines().Count > 0)" + NL
    t = t + "    bar.SetEnabled(""Undo"", undoKind <> """")" + NL
    t = t + "    bar.SetEnabled(""Cut"", n > 0 AND CanCopySel())" + NL
    t = t + "    bar.SetEnabled(""Copy"", n > 0 AND CanCopySel())" + NL
    t = t + "    bar.SetEnabled(""Paste"", CanWriteHere() AND FS.Exists(CLIPFILE))" + NL
    t = t + "    bar.SetEnabled(""Back"", hi > 0)" + NL
    t = t + "    bar.SetEnabled(""Forward"", hi < hist.Count - 1)" + NL
    t = t + "    bar.SetEnabled(""Up One Level"", ParentOf(cur) <> """")" + NL
    t = t + "    bar.SetEnabled(""Disconnect Network Drive..."", dLetter.Count > 0)" + NL
    t = t + "    DrawToolbar()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Menu_OnSelect (item AS String)" + NL
    t = t + "    IF busy THEN RETURN" + NL
    t = t + "    EndRename(TRUE)" + NL
    t = t + "    busy = TRUE" + NL
    t = t + "    TRY" + NL
    t = t + "        DoCommand(item)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        IF NOT err.StartsWith(""!cancel"") THEN ShowError(err)" + NL
    t = t + "    END TRY" + NL
    t = t + "    busy = FALSE" + NL
    t = t + "    CloseProgress()" + NL
    t = t + "    keys.Focus()" + NL
    t = t + "    UpdateMenus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the toolbar" + NL
    t = t + "" + NL
    t = t + "SUB MakeToolbar ()" + NL
    t = t + "    VAR ids AS Array OF String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    ids = [""back"", ""fwd"", ""up"", ""|"", ""map"", ""unmap"", ""|"", ""cut"", ""copy"", ""paste"", ""|"", ""undo"", ""del"", ""props"", ""|"", ""large"", ""small"", ""list"", ""details""]" + NL
    t = t + "    x = 214" + NL
    t = t + "    FOR EACH id IN ids" + NL
    t = t + "        tbId.Add(id)" + NL
    t = t + "        tbX.Add(x)" + NL
    t = t + "        IF id = ""|"" THEN" + NL
    t = t + "            x = x + 8" + NL
    t = t + "        ELSE" + NL
    t = t + "            x = x + 24" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    tbDown = -1" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION TbHint (id AS String) AS String" + NL
    t = t + "    SELECT CASE id" + NL
    t = t + "        CASE ""back""" + NL
    t = t + "            RETURN ""Back""" + NL
    t = t + "        CASE ""fwd""" + NL
    t = t + "            RETURN ""Forward""" + NL
    t = t + "        CASE ""up""" + NL
    t = t + "            RETURN ""Up One Level""" + NL
    t = t + "        CASE ""map""" + NL
    t = t + "            RETURN ""Map Network Drive""" + NL
    t = t + "        CASE ""unmap""" + NL
    t = t + "            RETURN ""Disconnect Net Drive""" + NL
    t = t + "        CASE ""cut""" + NL
    t = t + "            RETURN ""Cut""" + NL
    t = t + "        CASE ""copy""" + NL
    t = t + "            RETURN ""Copy""" + NL
    t = t + "        CASE ""paste""" + NL
    t = t + "            RETURN ""Paste""" + NL
    t = t + "        CASE ""undo""" + NL
    t = t + "            RETURN ""Undo""" + NL
    t = t + "        CASE ""del""" + NL
    t = t + "            RETURN ""Delete""" + NL
    t = t + "        CASE ""props""" + NL
    t = t + "            RETURN ""Properties""" + NL
    t = t + "        CASE ""large""" + NL
    t = t + "            RETURN ""Large Icons""" + NL
    t = t + "        CASE ""small""" + NL
    t = t + "            RETURN ""Small Icons""" + NL
    t = t + "        CASE ""list""" + NL
    t = t + "            RETURN ""List""" + NL
    t = t + "        CASE ""details""" + NL
    t = t + "            RETURN ""Details""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION TbEnabled (id AS String) AS Bool" + NL
    t = t + "    SELECT CASE id" + NL
    t = t + "        CASE ""back""" + NL
    t = t + "            RETURN hi > 0" + NL
    t = t + "        CASE ""fwd""" + NL
    t = t + "            RETURN hi < hist.Count - 1" + NL
    t = t + "        CASE ""up""" + NL
    t = t + "            RETURN ParentOf(cur) <> """"" + NL
    t = t + "        CASE ""unmap""" + NL
    t = t + "            RETURN dLetter.Count > 0" + NL
    t = t + "        CASE ""cut"", ""copy""" + NL
    t = t + "            RETURN SelCount() > 0 AND CanCopySel()" + NL
    t = t + "        CASE ""paste""" + NL
    t = t + "            RETURN CanWriteHere() AND FS.Exists(CLIPFILE)" + NL
    t = t + "        CASE ""undo""" + NL
    t = t + "            RETURN undoKind <> """"" + NL
    t = t + "        CASE ""del""" + NL
    t = t + "            RETURN SelCount() > 0 AND (NOT IsVirtual(cur) OR cur = ""::RECYCLE"" OR cur = ""::FIND"")" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Tb_OnDraw (c AS GUI_Canvas)" + NL
    t = t + "    DrawToolbar()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawToolbar ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    VAR on AS Bool" + NL
    t = t + "    VAR latched AS Bool" + NL
    t = t + "    IF NOT showToolbar OR IsNothing(tb) THEN RETURN" + NL
    t = t + "    tb.SetColor(7)" + NL
    t = t + "    tb.FillRect(0, 0, tb.Width, TBH)" + NL
    t = t + "    ' the band's edges: a raised strip" + NL
    t = t + "    tb.SetColor(15)" + NL
    t = t + "    tb.Line(0, 0, tb.Width, 0)" + NL
    t = t + "    tb.SetColor(8)" + NL
    t = t + "    tb.Line(0, TBH - 2, tb.Width, TBH - 2)" + NL
    t = t + "    tb.SetColor(15)" + NL
    t = t + "    tb.Line(0, TBH - 1, tb.Width, TBH - 1)" + NL
    t = t + "    FOR i = 0 TO tbId.Count - 1" + NL
    t = t + "        id = tbId[i]" + NL
    t = t + "        x = tbX[i]" + NL
    t = t + "        IF id = ""|"" THEN" + NL
    t = t + "            tb.SetColor(8)" + NL
    t = t + "            tb.Line(x + 3, 4, x + 3, TBH - 6)" + NL
    t = t + "            tb.SetColor(15)" + NL
    t = t + "            tb.Line(x + 4, 4, x + 4, TBH - 6)" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF x + 23 > tb.Width THEN CONTINUE" + NL
    t = t + "        on = TbEnabled(id)" + NL
    t = t + "        latched = id = viewMode" + NL
    t = t + "        IF i = tbDown OR latched THEN" + NL
    t = t + "            Bevel(tb, x, 3, 23, 22, FALSE)" + NL
    t = t + "            IF latched AND i <> tbDown THEN tb.Picture(x + 2, 5, picLatch)" + NL
    t = t + "            tb.Picture(x + 4, 7, ToolIcon(id, on))" + NL
    t = t + "        ELSE" + NL
    t = t + "            Bevel(tb, x, 3, 23, 22, TRUE)" + NL
    t = t + "            tb.Picture(x + 3, 6, ToolIcon(id, on))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION TbAt (x AS Integer, y AS Integer) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF y < 3 OR y > 25 THEN RETURN -1" + NL
    t = t + "    FOR i = 0 TO tbId.Count - 1" + NL
    t = t + "        IF tbId[i] <> ""|"" AND x >= tbX[i] AND x < tbX[i] + 23 THEN RETURN i" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN -1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Tb_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF busy THEN RETURN" + NL
    t = t + "    i = TbAt(x, y)" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    IF NOT TbEnabled(tbId[i]) THEN RETURN" + NL
    t = t + "    tbDown = i" + NL
    t = t + "    DrawToolbar()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Tb_OnMouseUp (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR was AS Integer" + NL
    t = t + "    was = tbDown" + NL
    t = t + "    tbDown = -1" + NL
    t = t + "    IF was < 0 THEN RETURN" + NL
    t = t + "    DrawToolbar()" + NL
    t = t + "    i = TbAt(x, y)" + NL
    t = t + "    IF i <> was THEN RETURN" + NL
    t = t + "    Menu_OnSelect(TbCommand(tbId[i]))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Tb_OnMouseMove (x AS Integer, y AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR hint AS String" + NL
    t = t + "    i = TbAt(x, y)" + NL
    t = t + "    hint = """"" + NL
    t = t + "    IF i >= 0 THEN hint = TbHint(tbId[i])" + NL
    t = t + "    IF hint <> tbHintNow THEN" + NL
    t = t + "        tbHintNow = hint" + NL
    t = t + "        IF hint <> """" AND statusOn THEN" + NL
    t = t + "            win.Status = hint" + NL
    t = t + "        ELSE" + NL
    t = t + "            ShowStatus()" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION TbCommand (id AS String) AS String" + NL
    t = t + "    SELECT CASE id" + NL
    t = t + "        CASE ""back""" + NL
    t = t + "            RETURN ""Back""" + NL
    t = t + "        CASE ""fwd""" + NL
    t = t + "            RETURN ""Forward""" + NL
    t = t + "        CASE ""up""" + NL
    t = t + "            RETURN ""Up One Level""" + NL
    t = t + "        CASE ""map""" + NL
    t = t + "            RETURN ""Map Network Drive...""" + NL
    t = t + "        CASE ""unmap""" + NL
    t = t + "            RETURN ""Disconnect Network Drive...""" + NL
    t = t + "        CASE ""cut""" + NL
    t = t + "            RETURN ""Cut""" + NL
    t = t + "        CASE ""copy""" + NL
    t = t + "            RETURN ""Copy""" + NL
    t = t + "        CASE ""paste""" + NL
    t = t + "            RETURN ""Paste""" + NL
    t = t + "        CASE ""undo""" + NL
    t = t + "            RETURN ""Undo""" + NL
    t = t + "        CASE ""del""" + NL
    t = t + "            RETURN ""Delete""" + NL
    t = t + "        CASE ""props""" + NL
    t = t + "            RETURN ""Properties""" + NL
    t = t + "        CASE ""large""" + NL
    t = t + "            RETURN ""Large Icons""" + NL
    t = t + "        CASE ""small""" + NL
    t = t + "            RETURN ""Small Icons""" + NL
    t = t + "        CASE ""list""" + NL
    t = t + "            RETURN ""List""" + NL
    t = t + "        CASE ""details""" + NL
    t = t + "            RETURN ""Details""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The folder box: Desktop, the folders down to this one, the drives, the network." + NL
    t = t + "SUB FillCombo ()" + NL
    t = t + "    VAR chain AS Array OF String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR items AS Array OF String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    p = cur" + NL
    t = t + "    WHILE p <> """"" + NL
    t = t + "        chain.Insert(0, p)" + NL
    t = t + "        p = ParentOf(p)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    comboPaths.Clear()" + NL
    t = t + "    ComboAdd(items, ""::DESKTOP"", 0)" + NL
    t = t + "    ComboAdd(items, ""::COMPUTER"", 1)" + NL
    t = t + "    ComboAdd(items, ""C:\"", 2)" + NL
    t = t + "    IF chain.Count > 3 AND chain[2] = ""C:\"" THEN" + NL
    t = t + "        FOR i = 3 TO chain.Count - 1" + NL
    t = t + "            ComboAdd(items, chain[i], i)" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR d = 0 TO dLetter.Count - 1" + NL
    t = t + "        ComboAdd(items, dLetter[d] + "":\"", 2)" + NL
    t = t + "        IF chain.Count > 3 AND chain[2] = dLetter[d] + "":\"" THEN" + NL
    t = t + "            FOR i = 3 TO chain.Count - 1" + NL
    t = t + "                ComboAdd(items, chain[i], i)" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ComboAdd(items, ""::NETWORK"", 1)" + NL
    t = t + "    IF chain.Count > 2 AND chain[1] = ""::NETWORK"" THEN" + NL
    t = t + "        FOR i = 2 TO chain.Count - 1" + NL
    t = t + "            ComboAdd(items, chain[i], i)" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    ComboAdd(items, ""::RECYCLE"", 1)" + NL
    t = t + "    IF cur = ""::FIND"" THEN ComboAdd(items, ""::FIND"", 1)" + NL
    t = t + "    comboSetting = TRUE" + NL
    t = t + "    combo.Items = items" + NL
    t = t + "    at = comboPaths.IndexOf(cur)" + NL
    t = t + "    combo.Selected = at" + NL
    t = t + "    comboSetting = FALSE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ComboAdd (items AS Array OF String, p AS String, depth AS Integer)" + NL
    t = t + "    VAR pad AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    FOR k = 1 TO depth" + NL
    t = t + "        pad = pad + Chr(160) + Chr(160) + Chr(160)" + NL
    t = t + "    NEXT" + NL
    t = t + "    items.Add(pad + PlaceLabel(p))" + NL
    t = t + "    comboPaths.Add(p)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Combo_OnSelect ()" + NL
    t = t + "    IF comboSetting OR busy THEN RETURN" + NL
    t = t + "    IF combo.Selected < 0 OR combo.Selected >= comboPaths.Count THEN RETURN" + NL
    t = t + "    Menu_OnSelect(""!go "" + comboPaths[combo.Selected])" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Addr_OnEnter ()" + NL
    t = t + "    IF busy THEN RETURN" + NL
    t = t + "    Menu_OnSelect(""!go "" + addr.Text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- going places" + NL
    t = t + "" + NL
    t = t + "' Shows a folder (a file: opens it). Remembered for Back, unless Back took us." + NL
    t = t + "SUB Go (target AS String)" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    p = Normalize(target, cur)" + NL
    t = t + "    IF p = """" THEN THROW ""Cannot find '"" + target + ""'. Make sure the path or folder name is correct.""" + NL
    t = t + "    IF NOT IsVirtual(p) THEN" + NL
    t = t + "        kind = VStat(p)" + NL
    t = t + "        IF kind = """" THEN THROW ""Cannot find '"" + target + ""'. Make sure the path or folder name is correct.""" + NL
    t = t + "        IF kind = ""F"" THEN" + NL
    t = t + "            OpenFile(p, FALSE)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    cur = p" + NL
    t = t + "    IF NOT travelling THEN" + NL
    t = t + "        IF hi < 0 OR hist[MATH.Max(0, hi)] <> cur THEN" + NL
    t = t + "            WHILE hist.Count > hi + 1" + NL
    t = t + "                hist.RemoveAt(hist.Count - 1)" + NL
    t = t + "            END WHILE" + NL
    t = t + "            hist.Add(cur)" + NL
    t = t + "            hi = hist.Count - 1" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    ' the tree shows where we are" + NL
    t = t + "    p = ParentOf(cur)" + NL
    t = t + "    WHILE p <> """"" + NL
    t = t + "        IF NOT expanded.Contains(""|"" + p + ""|"") THEN expanded = expanded + p + ""|""" + NL
    t = t + "        p = ParentOf(p)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    listTop = 0" + NL
    t = t + "    listLeft = 0" + NL
    t = t + "    Refresh(FALSE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Travel (i AS Integer)" + NL
    t = t + "    IF i < 0 OR i >= hist.Count THEN RETURN" + NL
    t = t + "    hi = i" + NL
    t = t + "    travelling = TRUE" + NL
    t = t + "    TRY" + NL
    t = t + "        Go(hist[i])" + NL
    t = t + "    CATCH err" + NL
    t = t + "        travelling = FALSE" + NL
    t = t + "        THROW err" + NL
    t = t + "    END TRY" + NL
    t = t + "    travelling = FALSE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Reads the folder again, and the tree, and shows them." + NL
    t = t + "SUB Refresh (keepSel AS Bool)" + NL
    t = t + "    VAR keep AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    keep = ""|""" + NL
    t = t + "    IF keepSel THEN" + NL
    t = t + "        FOR i = 0 TO cName.Count - 1" + NL
    t = t + "            IF cSel[i] THEN keep = keep + cPath[i] + ""|""" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    LoadDrives()" + NL
    t = t + "    LoadContents()" + NL
    t = t + "    FOR i = 0 TO cName.Count - 1" + NL
    t = t + "        cSel[i] = keep.Contains(""|"" + cPath[i] + ""|"")" + NL
    t = t + "    NEXT" + NL
    t = t + "    cFocus = FirstSel()" + NL
    t = t + "    BuildTree()" + NL
    t = t + "    LayoutList()" + NL
    t = t + "    ScrollTreeTo(tPath.IndexOf(cur))" + NL
    t = t + "    IF showAddress THEN addr.Text = AddressFor(cur)" + NL
    t = t + "    IF showToolbar THEN FillCombo()" + NL
    t = t + "    Redraw()" + NL
    t = t + "    ShowStatus()" + NL
    t = t + "    UpdateMenus()" + NL
    t = t + "    ' (last: the title says the folder is all there)" + NL
    t = t + "    win.Title = TitleFor(cur)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION TitleFor (p AS String) AS String" + NL
    t = t + "    IF showTree THEN RETURN ""Exploring - "" + PlaceLabel(p)" + NL
    t = t + "    RETURN PlaceLabel(p)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION AddressFor (p AS String) AS String" + NL
    t = t + "    IF IsVirtual(p) THEN RETURN PlaceLabel(p)" + NL
    t = t + "    RETURN p" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ places" + NL
    t = t + "'" + NL
    t = t + "' Every place Explorer shows has a path:" + NL
    t = t + "'   C:\MYFILES\NOTES.TXT      this machine" + NL
    t = t + "'   \\BRAVO\DOCS              another machine's disk, through its Files service" + NL
    t = t + "'                             (port 139): \\BRAVO\ is BRAVO's C:\" + NL
    t = t + "'   Z:\DOCS                   a mapped network drive: Z: is \\BRAVO\MYFILES," + NL
    t = t + "'                             say, so this is BRAVO's C:\MYFILES\DOCS" + NL
    t = t + "'   ::DESKTOP ::COMPUTER ::NETWORK ::RECYCLE ::FIND   the folders that aren't" + NL
    t = t + "'                             on any disk" + NL
    t = t + "' The V... functions work on any of them, and THROW a message when they fail." + NL
    t = t + "" + NL
    t = t + "FUNCTION IsVirtual (p AS String) AS Bool" + NL
    t = t + "    RETURN p.StartsWith(""::"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsUnc (p AS String) AS Bool" + NL
    t = t + "    RETURN p.StartsWith(""\\"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' D: to Z:, but not C:" + NL
    t = t + "FUNCTION IsMapped (p AS String) AS Bool" + NL
    t = t + "    IF p.Length < 2 THEN RETURN FALSE" + NL
    t = t + "    RETURN p.CharAt(1) = "":"" AND p.CharAt(0) <> ""C"" AND ""DEFGHIJKLMNOPQRSTUVWXYZ"".Contains(p.CharAt(0))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsRemote (p AS String) AS Bool" + NL
    t = t + "    RETURN IsUnc(p) OR IsMapped(p)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LastSlash (p AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = p.Length - 1 TO 0 STEP -1" + NL
    t = t + "        IF p.CharAt(i) = ""\"" THEN RETURN i" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN -1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The top of the disk a path is on: C:\, Z:\ or \\BRAVO\" + NL
    t = t + "FUNCTION RootOf (p AS String) AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    IF IsVirtual(p) THEN RETURN p" + NL
    t = t + "    IF IsUnc(p) THEN" + NL
    t = t + "        rest = p.Substring(2, p.Length - 2)" + NL
    t = t + "        IF rest.Contains(""\"") THEN rest = rest.Substring(0, rest.IndexOf(""\""))" + NL
    t = t + "        RETURN ""\\"" + rest + ""\""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN p.Substring(0, 2) + ""\""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsRoot (p AS String) AS Bool" + NL
    t = t + "    RETURN NOT IsVirtual(p) AND RootOf(p) = p" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JoinPath (dir AS String, name AS String) AS String" + NL
    t = t + "    IF dir.EndsWith(""\"") THEN RETURN dir + name" + NL
    t = t + "    RETURN dir + ""\"" + name" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The last part of a path ("""" for a root)" + NL
    t = t + "FUNCTION BaseName (p AS String) AS String" + NL
    t = t + "    IF IsVirtual(p) OR IsRoot(p) THEN RETURN """"" + NL
    t = t + "    RETURN p.Substring(LastSlash(p) + 1, p.Length - LastSlash(p) - 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The folder a path is in. A drive is in My Computer; a machine is in" + NL
    t = t + "' Network Neighborhood; those two are on the Desktop." + NL
    t = t + "FUNCTION ParentOf (p AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF p = ""::DESKTOP"" THEN RETURN """"" + NL
    t = t + "    IF IsVirtual(p) THEN RETURN ""::DESKTOP""" + NL
    t = t + "    IF IsRoot(p) THEN" + NL
    t = t + "        IF IsUnc(p) THEN RETURN ""::NETWORK""" + NL
    t = t + "        RETURN ""::COMPUTER""" + NL
    t = t + "    END IF" + NL
    t = t + "    i = LastSlash(p)" + NL
    t = t + "    IF i < RootOf(p).Length THEN RETURN RootOf(p)" + NL
    t = t + "    RETURN p.Substring(0, i)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' What was typed (in the address bar, or given to the program), as a path;" + NL
    t = t + "' """" when it isn't one." + NL
    t = t + "FUNCTION Normalize (s AS String, here AS String) AS String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR root AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    p = s.Trim()" + NL
    t = t + "    l = p.Lower()" + NL
    t = t + "    IF l = ""desktop"" THEN RETURN ""::DESKTOP""" + NL
    t = t + "    IF l = ""my computer"" THEN RETURN ""::COMPUTER""" + NL
    t = t + "    IF l = ""network neighborhood"" OR l = ""network"" THEN RETURN ""::NETWORK""" + NL
    t = t + "    IF l = ""recycle bin"" THEN RETURN ""::RECYCLE""" + NL
    t = t + "    IF p.StartsWith(""::"") THEN RETURN p.Upper()" + NL
    t = t + "    p = p.Upper().Replace(""/"", ""\"")" + NL
    t = t + "    IF p = """" THEN RETURN here" + NL
    t = t + "    IF IsUnc(p) THEN" + NL
    t = t + "        IF p = ""\\"" THEN RETURN ""::NETWORK""" + NL
    t = t + "        IF NOT p.Substring(2, p.Length - 2).Contains(""\"") THEN p = p + ""\""" + NL
    t = t + "    ELSEIF p.Length >= 2 AND p.CharAt(1) = "":"" THEN" + NL
    t = t + "        IF p.Length = 2 THEN p = p + ""\""" + NL
    t = t + "    ELSEIF p.StartsWith(""\"") THEN" + NL
    t = t + "        p = RootOf(here) + p.Substring(1, p.Length - 1)" + NL
    t = t + "    ELSEIF IsVirtual(here) THEN" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    ELSE" + NL
    t = t + "        p = JoinPath(here, p)" + NL
    t = t + "    END IF" + NL
    t = t + "    ' "".."": up" + NL
    t = t + "    WHILE p.Contains(""\.."")" + NL
    t = t + "        at = p.IndexOf(""\.."")" + NL
    t = t + "        p = ParentOf(p.Substring(0, at)) + p.Substring(at + 3, p.Length - at - 3)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    ' (doubled backslashes after the root, as one)" + NL
    t = t + "    root = RootOf(p)" + NL
    t = t + "    rest = p.Substring(root.Length, p.Length - root.Length)" + NL
    t = t + "    WHILE rest.Contains(""\\"")" + NL
    t = t + "        rest = rest.Replace(""\\"", ""\"")" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF rest.StartsWith(""\"") THEN rest = rest.Substring(1, rest.Length - 1)" + NL
    t = t + "    p = root + rest" + NL
    t = t + "    IF p.EndsWith(""\"") AND NOT IsRoot(p) THEN p = p.Substring(0, p.Length - 1)" + NL
    t = t + "    RETURN p" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A name a file may have: 8.3, letters, digits, - and _" + NL
    t = t + "FUNCTION Valid83 (name AS String) AS Bool" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    parts = name.Split(""."")" + NL
    t = t + "    IF parts.Count > 2 OR parts[0].Length < 1 OR parts[0].Length > 8 THEN RETURN FALSE" + NL
    t = t + "    IF parts.Count = 2 AND (parts[1].Length < 1 OR parts[1].Length > 3) THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyOf(name, ""ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-."")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION OnlyOf (s AS String, allowed AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        IF NOT allowed.Contains(s.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ExtOf (name AS String) AS String" + NL
    t = t + "    IF NOT name.Contains(""."") THEN RETURN """"" + NL
    t = t + "    RETURN name.Substring(name.IndexOf(""."") + 1, name.Length - name.IndexOf(""."") - 1).Upper()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ mapped drives" + NL
    t = t + "'" + NL
    t = t + "' C:\SYSTEM\DRIVES.INI, one line a drive: Z=\\BRAVO\MYFILES|1 (the 1: connect" + NL
    t = t + "' again when Explorer starts; 0: this session only, and gone when it ends)." + NL
    t = t + "" + NL
    t = t + "SUB LoadDrives ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR eq AS Integer" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    dLetter.Clear()" + NL
    t = t + "    dTarget.Clear()" + NL
    t = t + "    dKeep.Clear()" + NL
    t = t + "    dDown.Clear()" + NL
    t = t + "    IF NOT FS.Exists(DRIVESFILE) THEN RETURN" + NL
    t = t + "    FOR EACH line IN FS.Read(DRIVESFILE).Lines()" + NL
    t = t + "        eq = line.IndexOf(""="")" + NL
    t = t + "        IF eq <> 1 THEN CONTINUE" + NL
    t = t + "        rest = line.Substring(2, line.Length - 2)" + NL
    t = t + "        IF NOT rest.StartsWith(""\\"") THEN CONTINUE" + NL
    t = t + "        dLetter.Add(line.Substring(0, 1).Upper())" + NL
    t = t + "        IF rest.Contains(""|"") THEN" + NL
    t = t + "            dTarget.Add(Normalize(rest.Substring(0, rest.IndexOf(""|"")), ""C:\""))" + NL
    t = t + "            dKeep.Add(rest.EndsWith(""|1""))" + NL
    t = t + "        ELSE" + NL
    t = t + "            dTarget.Add(Normalize(rest, ""C:\""))" + NL
    t = t + "            dKeep.Add(TRUE)" + NL
    t = t + "        END IF" + NL
    t = t + "        dDown.Add(FALSE)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Only the drives to keep; this session's go when the last window closes" + NL
    t = t + "' (the file is read again by every window, so each sees the others' drives)." + NL
    t = t + "SUB SaveDrives (all AS Bool)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO dLetter.Count - 1" + NL
    t = t + "        IF dKeep[i] OR all THEN" + NL
    t = t + "            IF dKeep[i] THEN" + NL
    t = t + "                out.Add(dLetter[i] + ""="" + dTarget[i] + ""|1"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                out.Add(dLetter[i] + ""="" + dTarget[i] + ""|0"")" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Write(DRIVESFILE, out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION DriveIndex (letter AS String) AS Integer" + NL
    t = t + "    RETURN dLetter.IndexOf(letter.Upper())" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Z:\DOCS -> \\BRAVO\MYFILES\DOCS (and \\BRAVO\DOCS stays as it is)" + NL
    t = t + "FUNCTION ToUnc (p AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF NOT IsMapped(p) THEN RETURN p" + NL
    t = t + "    i = DriveIndex(p.Substring(0, 1))" + NL
    t = t + "    IF i < 0 THEN THROW p.Substring(0, 2) + "" is not a network drive. Map it first (Tools > Map Network Drive).""" + NL
    t = t + "    IF p.Length <= 3 THEN RETURN dTarget[i]" + NL
    t = t + "    RETURN JoinPath(dTarget[i], p.Substring(3, p.Length - 3))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The other way: \\BRAVO\MYFILES\DOCS -> Z:\DOCS, when a drive is mapped there" + NL
    t = t + "FUNCTION FromUnc (p AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    IF NOT IsUnc(p) THEN RETURN p" + NL
    t = t + "    FOR i = 0 TO dTarget.Count - 1" + NL
    t = t + "        t = dTarget[i]" + NL
    t = t + "        IF p = t THEN RETURN dLetter[i] + "":\""" + NL
    t = t + "        IF p.StartsWith(JoinPath(t, """")) THEN RETURN dLetter[i] + "":\"" + p.Substring(JoinPath(t, """").Length, p.Length - JoinPath(t, """").Length)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN p" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION HostOf (p AS String) AS String" + NL
    t = t + "    VAR u AS String" + NL
    t = t + "    u = ToUnc(p)" + NL
    t = t + "    u = u.Substring(2, u.Length - 2)" + NL
    t = t + "    IF u.Contains(""\"") THEN u = u.Substring(0, u.IndexOf(""\""))" + NL
    t = t + "    RETURN u.Upper()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The path on the other machine: \\BRAVO\DOCS -> C:\DOCS" + NL
    t = t + "FUNCTION RemotePath (p AS String) AS String" + NL
    t = t + "    VAR u AS String" + NL
    t = t + "    u = ToUnc(p)" + NL
    t = t + "    u = u.Substring(2, u.Length - 2)" + NL
    t = t + "    IF NOT u.Contains(""\"") THEN RETURN ""C:\""" + NL
    t = t + "    RETURN ""C:"" + u.Substring(u.IndexOf(""\""), u.Length - u.IndexOf(""\""))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Both on this machine, or both on the same other machine: then a move is a rename." + NL
    t = t + "FUNCTION SameDisk (a AS String, b AS String) AS Bool" + NL
    t = t + "    IF IsVirtual(a) OR IsVirtual(b) THEN RETURN FALSE" + NL
    t = t + "    IF NOT IsRemote(a) AND NOT IsRemote(b) THEN RETURN TRUE" + NL
    t = t + "    IF IsRemote(a) AND IsRemote(b) THEN RETURN HostOf(a) = HostOf(b)" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the network" + NL
    t = t + "'" + NL
    t = t + "' Another machine's disk is reached through its Files service (port 139):" + NL
    t = t + "' AUTH user|password, then LIST, READ, WRITE, DEL, MKDIR, REN and STAT, one" + NL
    t = t + "' message each way. Explorer keeps a connection to each machine it uses." + NL
    t = t + "'" + NL
    t = t + "' Two rules keep a dead machine from stopping Explorer (SIM95-NOTES.md): a" + NL
    t = t + "' failed Connect spoils the handler it happens in, so connecting is done by" + NL
    t = t + "' the dial timer, in a tick of its own, while Explorer waits; and replies come" + NL
    t = t + "' in through onMessage, waited for with SYS.Sleep, never with Receive." + NL
    t = t + "" + NL
    t = t + "SUB Dial_OnTick ()" + NL
    t = t + "    IF dialState <> ""go"" THEN RETURN" + NL
    t = t + "    dialState = ""dialing""" + NL
    t = t + "    TRY" + NL
    t = t + "        dialSock = NET_Socket.New()" + NL
    t = t + "        dialSock.onMessage = Net_OnMessage" + NL
    t = t + "        dialSock.onClose = Net_OnClose" + NL
    t = t + "        dialConn = dialSock.Connect(dialHost, 139)" + NL
    t = t + "        dialConn.Tag = dialHost" + NL
    t = t + "        dialErr = """"" + NL
    t = t + "        dialState = ""done""" + NL
    t = t + "    CATCH err" + NL
    t = t + "        dialErr = err" + NL
    t = t + "        dialState = ""done""" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Net_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = nHost.IndexOf(conn.Tag)" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    nReply[i] = message" + NL
    t = t + "    nGot[i] = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Net_OnClose (conn AS NET_Connection)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = nHost.IndexOf(conn.Tag)" + NL
    t = t + "    IF i >= 0 THEN nClosed[i] = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Waits for the dial timer to connect to host: its index in nHost, or THROWs." + NL
    t = t + "FUNCTION Dial (host AS String) AS Integer" + NL
    t = t + "    VAR since AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    dialHost = host" + NL
    t = t + "    dialState = ""go""" + NL
    t = t + "    since = SYS.Ticks" + NL
    t = t + "    WHILE dialState <> ""done""" + NL
    t = t + "        SYS.Sleep(20)" + NL
    t = t + "        IF SYS.Ticks - since > 15000 THEN" + NL
    t = t + "            dialState = """"" + NL
    t = t + "            THROW ""\\"" + host + "" is not answering."" + Chr(10) + Chr(10) + ""The machine may be turned off, or not on the network.""" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    dialState = """"" + NL
    t = t + "    IF dialErr <> """" THEN" + NL
    t = t + "        IF dialErr.Contains(""refused"") THEN THROW ""\\"" + host + "" is on the network, but isn't sharing its disk (its Files service, port 139, is not running).""" + NL
    t = t + "        IF dialErr.Contains(""Unknown host"") THEN THROW ""The network path \\"" + host + "" was not found."" + Chr(10) + Chr(10) + ""There is no machine called "" + host + "".""" + NL
    t = t + "        THROW ""\\"" + host + "" is not answering ("" + dialErr + "").""" + NL
    t = t + "    END IF" + NL
    t = t + "    i = nHost.IndexOf(host)" + NL
    t = t + "    IF i < 0 THEN" + NL
    t = t + "        nHost.Add(host)" + NL
    t = t + "        nConn.Add(dialConn)" + NL
    t = t + "        nSock.Add(dialSock)" + NL
    t = t + "        nReply.Add("""")" + NL
    t = t + "        nGot.Add(FALSE)" + NL
    t = t + "        nClosed.Add(FALSE)" + NL
    t = t + "        nAuthed.Add(FALSE)" + NL
    t = t + "        i = nHost.Count - 1" + NL
    t = t + "    ELSE" + NL
    t = t + "        nConn[i] = dialConn" + NL
    t = t + "        nSock[i] = dialSock" + NL
    t = t + "        nReply[i] = """"" + NL
    t = t + "        nGot[i] = FALSE" + NL
    t = t + "        nClosed[i] = FALSE" + NL
    t = t + "        nAuthed[i] = FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One request on connection i, and its reply ("""" when the connection went)." + NL
    t = t + "FUNCTION Exchange (i AS Integer, request AS String) AS String" + NL
    t = t + "    VAR since AS Integer" + NL
    t = t + "    nGot[i] = FALSE" + NL
    t = t + "    nReply[i] = """"" + NL
    t = t + "    IF nClosed[i] THEN RETURN """"" + NL
    t = t + "    TRY" + NL
    t = t + "        nConn[i].Send(request)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        nClosed[i] = TRUE" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END TRY" + NL
    t = t + "    since = SYS.Ticks" + NL
    t = t + "    WHILE NOT nGot[i] AND NOT nClosed[i]" + NL
    t = t + "        SYS.Sleep(10)" + NL
    t = t + "        IF SYS.Ticks - since > 12000 THEN" + NL
    t = t + "            nClosed[i] = TRUE" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF NOT nGot[i] THEN RETURN """"" + NL
    t = t + "    RETURN nReply[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Hangup (host AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = nHost.IndexOf(host)" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    TRY" + NL
    t = t + "        nSock[i].Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    nClosed[i] = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Connected and logged on to host: its index. Asks for a password when" + NL
    t = t + "' there's none to use, or the one there was is wrong." + NL
    t = t + "FUNCTION Session (host AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR r AS String" + NL
    t = t + "    VAR tries AS Integer" + NL
    t = t + "    i = nHost.IndexOf(host)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        IF NOT nClosed[i] AND nAuthed[i] THEN RETURN i" + NL
    t = t + "    END IF" + NL
    t = t + "    ' the machine first (a name nobody has is ""not found"", before any password)" + NL
    t = t + "    i = Dial(host)" + NL
    t = t + "    nAuthed[i] = FALSE" + NL
    t = t + "    WHILE TRUE" + NL
    t = t + "        IF NOT HaveLogon(host) THEN" + NL
    t = t + "            IF NOT AskLogon(host, tries > 0) THEN" + NL
    t = t + "                Hangup(host)" + NL
    t = t + "                THROW ""!cancel""" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        r = Exchange(i, ""AUTH "" + LogonUser(host) + ""|"" + LogonPass(host))" + NL
    t = t + "        IF r = ""OK"" THEN" + NL
    t = t + "            nAuthed[i] = TRUE" + NL
    t = t + "            RETURN i" + NL
    t = t + "        END IF" + NL
    t = t + "        IF r = """" THEN" + NL
    t = t + "            Hangup(host)" + NL
    t = t + "            THROW ""\\"" + host + "" closed the connection.""" + NL
    t = t + "        END IF" + NL
    t = t + "        triedHost = host" + NL
    t = t + "        triedUser = LogonUser(host)" + NL
    t = t + "        ForgetLogon(host)" + NL
    t = t + "        tries = tries + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN -1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A request to another machine: what came after OK, or THROWs the error." + NL
    t = t + "FUNCTION Ask (host AS String, request AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR r AS String" + NL
    t = t + "    VAR attempt AS Integer" + NL
    t = t + "    FOR attempt = 1 TO 2" + NL
    t = t + "        i = Session(host)" + NL
    t = t + "        r = Exchange(i, request)" + NL
    t = t + "        IF r <> """" THEN" + NL
    t = t + "            IF r.StartsWith(""OK"" + Chr(10)) THEN RETURN r.Substring(3, r.Length - 3)" + NL
    t = t + "            IF r = ""OK"" THEN RETURN """"" + NL
    t = t + "            IF r.StartsWith(""ERR "") THEN THROW FriendlyError(r.Substring(4, r.Length - 4))" + NL
    t = t + "            THROW ""\\"" + host + "" gave an answer Explorer doesn't understand.""" + NL
    t = t + "        END IF" + NL
    t = t + "        ' the connection went: once more, with a new one" + NL
    t = t + "        Hangup(host)" + NL
    t = t + "    NEXT" + NL
    t = t + "    THROW ""The connection to \\"" + host + "" was lost.""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION FriendlyError (e AS String) AS String" + NL
    t = t + "    IF e.StartsWith(""File not found"") THEN RETURN ""The file or folder was not found.""" + NL
    t = t + "    IF e.Contains(""Message too long"") OR e.Contains(""too long"") THEN RETURN ""The file is too big to send over the network (64K at most).""" + NL
    t = t + "    RETURN e" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---- logons: this session's, and the password list" + NL
    t = t + "'" + NL
    t = t + "' The password list is C:\SYSTEM\PASSWORD.PWL, one line a machine:" + NL
    t = t + "' HOST|user|password. Like Windows 95's, it is not much of a secret." + NL
    t = t + "" + NL
    t = t + "FUNCTION LogonAt (host AS String) AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = lHost.IndexOf(host)" + NL
    t = t + "    IF i >= 0 THEN RETURN i" + NL
    t = t + "    IF NOT FS.Exists(PWLFILE) THEN RETURN -1" + NL
    t = t + "    FOR EACH line IN FS.Read(PWLFILE).Lines()" + NL
    t = t + "        IF line.Split(""|"").Count >= 3 AND line.Split(""|"")[0].Upper() = host THEN" + NL
    t = t + "            lHost.Add(host)" + NL
    t = t + "            lUser.Add(line.Split(""|"")[1])" + NL
    t = t + "            lPass.Add(line.Substring(line.Split(""|"")[0].Length + line.Split(""|"")[1].Length + 2, line.Length - line.Split(""|"")[0].Length - line.Split(""|"")[1].Length - 2))" + NL
    t = t + "            RETURN lHost.Count - 1" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN -1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION HaveLogon (host AS String) AS Bool" + NL
    t = t + "    RETURN LogonAt(host) >= 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LogonUser (host AS String) AS String" + NL
    t = t + "    RETURN lUser[LogonAt(host)]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LogonPass (host AS String) AS String" + NL
    t = t + "    RETURN lPass[LogonAt(host)]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB RememberLogon (host AS String, user AS String, pass AS String, save AS Bool)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    i = lHost.IndexOf(host)" + NL
    t = t + "    IF i < 0 THEN" + NL
    t = t + "        lHost.Add(host)" + NL
    t = t + "        lUser.Add(user)" + NL
    t = t + "        lPass.Add(pass)" + NL
    t = t + "    ELSE" + NL
    t = t + "        lUser[i] = user" + NL
    t = t + "        lPass[i] = pass" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT save THEN RETURN" + NL
    t = t + "    IF FS.Exists(PWLFILE) THEN" + NL
    t = t + "        FOR EACH line IN FS.Read(PWLFILE).Lines()" + NL
    t = t + "            IF line <> """" AND line.Split(""|"")[0].Upper() <> host THEN out.Add(line)" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    out.Add(host + ""|"" + user + ""|"" + pass)" + NL
    t = t + "    FS.Write(PWLFILE, out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ForgetLogon (host AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    i = lHost.IndexOf(host)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        lHost.RemoveAt(i)" + NL
    t = t + "        lUser.RemoveAt(i)" + NL
    t = t + "        lPass.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF FS.Exists(PWLFILE) THEN" + NL
    t = t + "        FOR EACH line IN FS.Read(PWLFILE).Lines()" + NL
    t = t + "            IF line <> """" AND line.Split(""|"")[0].Upper() <> host THEN out.Add(line)" + NL
    t = t + "        NEXT" + NL
    t = t + "        FS.Write(PWLFILE, out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the disks" + NL
    t = t + "" + NL
    t = t + "' A folder's contents: ""NAME|D|0"" or ""NAME|F|size"", one each." + NL
    t = t + "FUNCTION VList (p AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    IF IsRemote(p) THEN" + NL
    t = t + "        FOR EACH n IN Ask(HostOf(p), ""LIST "" + RemotePath(p)).Lines()" + NL
    t = t + "            parts = n.Split(""|"")" + NL
    t = t + "            IF parts.Count >= 2 THEN" + NL
    t = t + "                IF parts.Count >= 3 THEN" + NL
    t = t + "                    out.Add(parts[0] + ""|"" + parts[1] + ""|"" + parts[2])" + NL
    t = t + "                ELSE" + NL
    t = t + "                    out.Add(parts[0] + ""|"" + parts[1] + ""|0"")" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        RETURN out" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT FS.Exists(p) THEN THROW p + "" is not accessible."" + Chr(10) + Chr(10) + ""The folder was not found.""" + NL
    t = t + "    FOR EACH n IN FS.List(p)" + NL
    t = t + "        IF n.EndsWith(""\"") THEN" + NL
    t = t + "            out.Add(n.Substring(0, n.Length - 1) + ""|D|0"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(n + ""|F|"" + Str(FS.Size(JoinPath(p, n))))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""D"" a folder, ""F"" a file, """" nothing there" + NL
    t = t + "FUNCTION VStat (p AS String) AS String" + NL
    t = t + "    VAR r AS String" + NL
    t = t + "    IF IsVirtual(p) THEN RETURN ""D""" + NL
    t = t + "    IF IsRemote(p) THEN" + NL
    t = t + "        IF IsRoot(p) THEN RETURN ""D""" + NL
    t = t + "        TRY" + NL
    t = t + "            r = Ask(HostOf(p), ""STAT "" + RemotePath(p))" + NL
    t = t + "        CATCH err" + NL
    t = t + "            IF err.StartsWith(""The file or folder was not found"") THEN RETURN """"" + NL
    t = t + "            THROW err" + NL
    t = t + "        END TRY" + NL
    t = t + "        RETURN r.Trim()" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT FS.Exists(p) THEN RETURN """"" + NL
    t = t + "    IF FS.IsDir(p) THEN RETURN ""D""" + NL
    t = t + "    RETURN ""F""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION VRead (p AS String) AS String" + NL
    t = t + "    IF IsRemote(p) THEN RETURN Ask(HostOf(p), ""READ "" + RemotePath(p))" + NL
    t = t + "    RETURN FS.Read(p)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB VWrite (p AS String, text AS String)" + NL
    t = t + "    IF IsRemote(p) THEN" + NL
    t = t + "        Ask(HostOf(p), ""WRITE "" + RemotePath(p) + Chr(10) + text)" + NL
    t = t + "    ELSE" + NL
    t = t + "        FS.Write(p, text)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB VMakeDir (p AS String)" + NL
    t = t + "    IF IsRemote(p) THEN" + NL
    t = t + "        Ask(HostOf(p), ""MKDIR "" + RemotePath(p))" + NL
    t = t + "    ELSE" + NL
    t = t + "        FS.MakeDir(p)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A file, or an empty folder" + NL
    t = t + "SUB VDeleteOne (p AS String)" + NL
    t = t + "    IF IsRemote(p) THEN" + NL
    t = t + "        Ask(HostOf(p), ""DEL "" + RemotePath(p))" + NL
    t = t + "    ELSE" + NL
    t = t + "        FS.Delete(p)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' On the same disk only (see SameDisk); a folder moves with all it holds." + NL
    t = t + "SUB VRename (a AS String, b AS String)" + NL
    t = t + "    IF IsRemote(a) THEN" + NL
    t = t + "        Ask(HostOf(a), ""REN "" + RemotePath(a) + ""|"" + RemotePath(b))" + NL
    t = t + "    ELSE" + NL
    t = t + "        FS.Rename(a, b)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A file or a folder, and everything in it, for good." + NL
    t = t + "SUB VRemoveTree (p AS String, kind AS String)" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    IF kind = ""D"" THEN" + NL
    t = t + "        FOR EACH e IN VList(p)" + NL
    t = t + "            IF Cancelled() THEN THROW ""!cancel""" + NL
    t = t + "            VRemoveTree(JoinPath(p, e.Split(""|"")[0]), e.Split(""|"")[1])" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    Progress(""Deleting"", p, """")" + NL
    t = t + "    VDeleteOne(p)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' src (a file or a folder) copied to dst, which must not be there yet." + NL
    t = t + "SUB VCopyTree (src AS String, kind AS String, dst AS String)" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    IF Cancelled() THEN THROW ""!cancel""" + NL
    t = t + "    IF kind = ""D"" THEN" + NL
    t = t + "        Progress(""Copying"", src, ParentOf(dst))" + NL
    t = t + "        VMakeDir(dst)" + NL
    t = t + "        FOR EACH e IN VList(src)" + NL
    t = t + "            VCopyTree(JoinPath(src, e.Split(""|"")[0]), e.Split(""|"")[1], JoinPath(dst, e.Split(""|"")[0]))" + NL
    t = t + "        NEXT" + NL
    t = t + "    ELSE" + NL
    t = t + "        Progress(""Copying"", src, ParentOf(dst))" + NL
    t = t + "        VWrite(dst, VRead(src))" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' How big, and how many files and folders, under p" + NL
    t = t + "SUB VMeasure (p AS String, kind AS String)" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    IF kind <> ""D"" THEN RETURN" + NL
    t = t + "    FOR EACH e IN VList(p)" + NL
    t = t + "        parts = e.Split(""|"")" + NL
    t = t + "        IF parts[1] = ""D"" THEN" + NL
    t = t + "            mFolders = mFolders + 1" + NL
    t = t + "            VMeasure(JoinPath(p, parts[0]), ""D"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            mFiles = mFiles + 1" + NL
    t = t + "            mBytes = mBytes + Int(Val(parts[2]))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the Recycle Bin" + NL
    t = t + "'" + NL
    t = t + "' What's deleted from C: goes to C:\RECYCLED, as D1.TXT, D2 (a folder)..." + NL
    t = t + "' INFO.TXT there says what each was: Dn|original path|when (seconds)|size|F or D." + NL
    t = t + "' Things deleted on another machine's disk are deleted for good." + NL
    t = t + "" + NL
    t = t + "FUNCTION BinLines () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    IF NOT FS.Exists(BINDIR + ""\INFO.TXT"") THEN RETURN out" + NL
    t = t + "    FOR EACH line IN FS.Read(BINDIR + ""\INFO.TXT"").Lines()" + NL
    t = t + "        IF line.Split(""|"").Count >= 5 THEN" + NL
    t = t + "            IF FS.Exists(BINDIR + ""\"" + line.Split(""|"")[0]) THEN out.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SaveBin (lines AS Array OF String)" + NL
    t = t + "    IF NOT FS.Exists(BINDIR) THEN FS.MakeDir(BINDIR)" + NL
    t = t + "    FS.Write(BINDIR + ""\INFO.TXT"", lines.Join(Chr(10)) + Chr(10))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Moves p into the Recycle Bin: the name it has there." + NL
    t = t + "FUNCTION Recycle (p AS String, kind AS String, size AS Integer) AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR ext AS String" + NL
    t = t + "    IF NOT FS.Exists(BINDIR) THEN FS.MakeDir(BINDIR)" + NL
    t = t + "    lines = BinLines()" + NL
    t = t + "    n = Int(Val(ReadOr(BINDIR + ""\NEXT.TXT"", ""1"")))" + NL
    t = t + "    IF n < 1 THEN n = 1" + NL
    t = t + "    ext = """"" + NL
    t = t + "    IF kind = ""F"" AND ExtOf(BaseName(p)) <> """" THEN ext = ""."" + ExtOf(BaseName(p))" + NL
    t = t + "    name = ""D"" + Str(n) + ext" + NL
    t = t + "    WHILE FS.Exists(BINDIR + ""\"" + name)" + NL
    t = t + "        n = n + 1" + NL
    t = t + "        name = ""D"" + Str(n) + ext" + NL
    t = t + "    END WHILE" + NL
    t = t + "    FS.Write(BINDIR + ""\NEXT.TXT"", Str(n + 1))" + NL
    t = t + "    FS.Rename(p, BINDIR + ""\"" + name)" + NL
    t = t + "    lines.Add(name + ""|"" + p + ""|"" + Str(TIME.Now) + ""|"" + Str(size) + ""|"" + kind)" + NL
    t = t + "    SaveBin(lines)" + NL
    t = t + "    RETURN name" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Puts one back where it was (its folder made again if it's gone). Returns where." + NL
    t = t + "FUNCTION Unrecycle (name AS String) AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR keep AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR orig AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    lines = BinLines()" + NL
    t = t + "    FOR EACH line IN lines" + NL
    t = t + "        IF line.Split(""|"")[0] = name THEN" + NL
    t = t + "            orig = line.Split(""|"")[1]" + NL
    t = t + "        ELSE" + NL
    t = t + "            keep.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF orig = """" THEN THROW ""That is no longer in the Recycle Bin.""" + NL
    t = t + "    IF FS.Exists(orig) THEN THROW ""Cannot restore "" + BaseName(orig) + "": there is already something called that in "" + ParentOf(orig) + "".""" + NL
    t = t + "    dir = ParentOf(orig)" + NL
    t = t + "    MakeDirs(dir)" + NL
    t = t + "    FS.Rename(BINDIR + ""\"" + name, orig)" + NL
    t = t + "    SaveBin(keep)" + NL
    t = t + "    RETURN orig" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A local folder, and the folders it's in, made if they're missing." + NL
    t = t + "SUB MakeDirs (p AS String)" + NL
    t = t + "    IF IsRoot(p) OR FS.Exists(p) THEN RETURN" + NL
    t = t + "    MakeDirs(ParentOf(p))" + NL
    t = t + "    FS.MakeDir(p)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (p AS String, dflt AS String) AS String" + NL
    t = t + "    IF FS.Exists(p) THEN RETURN FS.Read(p)" + NL
    t = t + "    RETURN dflt" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ machines" + NL
    t = t + "" + NL
    t = t + "' Network Neighborhood: the machines on the network (a broadcast ping, which" + NL
    t = t + "' takes most of a second), kept until Refresh." + NL
    t = t + "FUNCTION Machines (fresh AS Bool) AS Array OF String" + NL
    t = t + "    VAR found AS Array OF String" + NL
    t = t + "    VAR entry AS String" + NL
    t = t + "    IF fresh OR NOT machinesKnown THEN" + NL
    t = t + "        machineNames.Clear()" + NL
    t = t + "        TRY" + NL
    t = t + "            found = NET.Machines()" + NL
    t = t + "        CATCH err" + NL
    t = t + "        END TRY" + NL
    t = t + "        FOR EACH entry IN found" + NL
    t = t + "            IF entry.Split("" "")[0] <> """" THEN machineNames.Add(entry.Split("" "")[0].Upper())" + NL
    t = t + "        NEXT" + NL
    t = t + "        machineNames.Sort()" + NL
    t = t + "        machinesKnown = TRUE" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN machineNames" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ names and kinds" + NL
    t = t + "" + NL
    t = t + "' How a place is called: ""My Computer"", ""(C:)"", ""MYFILES on 'Bravo' (Z:)"", ""Bravo"", ""Docs""" + NL
    t = t + "FUNCTION PlaceLabel (p AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    SELECT CASE p" + NL
    t = t + "        CASE ""::DESKTOP""" + NL
    t = t + "            RETURN ""Desktop""" + NL
    t = t + "        CASE ""::COMPUTER""" + NL
    t = t + "            RETURN ""My Computer""" + NL
    t = t + "        CASE ""::NETWORK""" + NL
    t = t + "            RETURN ""Network Neighborhood""" + NL
    t = t + "        CASE ""::RECYCLE""" + NL
    t = t + "            RETURN ""Recycle Bin""" + NL
    t = t + "        CASE ""::FIND""" + NL
    t = t + "            RETURN ""Search Results""" + NL
    t = t + "        CASE ""C:\""" + NL
    t = t + "            RETURN ""(C:)""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF IsMapped(p) AND IsRoot(p) THEN" + NL
    t = t + "        i = DriveIndex(p.Substring(0, 1))" + NL
    t = t + "        IF i < 0 THEN RETURN ""("" + p.Substring(0, 2) + "")""" + NL
    t = t + "        t = dTarget[i]" + NL
    t = t + "        IF IsRoot(t) THEN RETURN Pretty(HostOf(t), FALSE) + "" ("" + p.Substring(0, 2) + "")""" + NL
    t = t + "        RETURN Pretty(BaseName(t), FALSE) + "" on '"" + Pretty(HostOf(t), FALSE) + ""' ("" + p.Substring(0, 2) + "")""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF IsUnc(p) AND IsRoot(p) THEN RETURN Pretty(HostOf(p), FALSE)" + NL
    t = t + "    RETURN Pretty(BaseName(p), TRUE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' NOTES.TXT as Windows 95 shows a DOS name: Notes.txt (unless names are shown in capitals)" + NL
    t = t + "FUNCTION Pretty (name AS String, isFile AS Bool) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = name" + NL
    t = t + "    IF hideExt AND isFile AND KnownType(ExtOf(s)) THEN s = s.Substring(0, s.IndexOf("".""))" + NL
    t = t + "    IF showCaps OR s = """" THEN RETURN s" + NL
    t = t + "    RETURN s.Substring(0, 1).Upper() + s.Substring(1, s.Length - 1).Lower()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION KnownType (ext AS String) AS Bool" + NL
    t = t + "    RETURN ""|TXT|SPK|HTM|PIC|JS|JSN|ASP|INI|INF|EXE|RUN|SH|MD|SYS|INC|"".Contains(""|"" + ext + ""|"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION TypeName (name AS String, kind AS String) AS String" + NL
    t = t + "    VAR ext AS String" + NL
    t = t + "    SELECT CASE kind" + NL
    t = t + "        CASE ""D""" + NL
    t = t + "            RETURN ""File Folder""" + NL
    t = t + "        CASE ""DRIVE""" + NL
    t = t + "            RETURN ""Local Disk""" + NL
    t = t + "        CASE ""NETDRIVE""" + NL
    t = t + "            RETURN ""Network Connection""" + NL
    t = t + "        CASE ""MACHINE""" + NL
    t = t + "            RETURN ""Computer""" + NL
    t = t + "        CASE ""PLACE""" + NL
    t = t + "            RETURN ""System Folder""" + NL
    t = t + "        CASE ""APP""" + NL
    t = t + "            RETURN ""Application""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    ext = ExtOf(name)" + NL
    t = t + "    SELECT CASE ext" + NL
    t = t + "        CASE ""TXT""" + NL
    t = t + "            RETURN ""Text Document""" + NL
    t = t + "        CASE ""SPK""" + NL
    t = t + "            RETURN ""SPARK Program""" + NL
    t = t + "        CASE ""HTM"", ""HTML""" + NL
    t = t + "            RETURN ""HTML Document""" + NL
    t = t + "        CASE ""PIC""" + NL
    t = t + "            RETURN ""Sketch Picture""" + NL
    t = t + "        CASE ""JS""" + NL
    t = t + "            RETURN ""JavaScript File""" + NL
    t = t + "        CASE ""JSN""" + NL
    t = t + "            RETURN ""JSON File""" + NL
    t = t + "        CASE ""ASP""" + NL
    t = t + "            RETURN ""Active SPARK Page""" + NL
    t = t + "        CASE ""INI"", ""INF""" + NL
    t = t + "            RETURN ""Configuration Settings""" + NL
    t = t + "        CASE ""EXE""" + NL
    t = t + "            RETURN ""Application""" + NL
    t = t + "        CASE ""RUN""" + NL
    t = t + "            RETURN ""Startup Entry""" + NL
    t = t + "        CASE ""SH""" + NL
    t = t + "            RETURN ""Shell Script""" + NL
    t = t + "        CASE ""MD""" + NL
    t = t + "            RETURN ""Markdown Document""" + NL
    t = t + "        CASE ""SYS""" + NL
    t = t + "            RETURN ""System File""" + NL
    t = t + "        CASE ""INC""" + NL
    t = t + "            RETURN ""Include File""" + NL
    t = t + "        CASE ""PWL""" + NL
    t = t + "            RETURN ""Password List""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF ext = """" THEN RETURN ""File""" + NL
    t = t + "    RETURN ext + "" File""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IconFor (name AS String, kind AS String, p AS String) AS String" + NL
    t = t + "    SELECT CASE kind" + NL
    t = t + "        CASE ""D""" + NL
    t = t + "            IF p = ""C:\PROGRAMS"" THEN RETURN ""programs""" + NL
    t = t + "            IF p = ""C:\DOCS"" THEN RETURN ""docs""" + NL
    t = t + "            RETURN ""folder""" + NL
    t = t + "        CASE ""DRIVE""" + NL
    t = t + "            RETURN ""drive""" + NL
    t = t + "        CASE ""NETDRIVE""" + NL
    t = t + "            IF DriveIndex(p.Substring(0, 1)) >= 0 THEN" + NL
    t = t + "                IF dDown[DriveIndex(p.Substring(0, 1))] THEN RETURN ""netdown""" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN ""netdrive""" + NL
    t = t + "        CASE ""MACHINE""" + NL
    t = t + "            RETURN ""computer""" + NL
    t = t + "        CASE ""APP""" + NL
    t = t + "            RETURN ""settings""" + NL
    t = t + "        CASE ""PLACE""" + NL
    t = t + "            SELECT CASE p" + NL
    t = t + "                CASE ""::COMPUTER""" + NL
    t = t + "                    RETURN ""computer""" + NL
    t = t + "                CASE ""::NETWORK""" + NL
    t = t + "                    RETURN ""network""" + NL
    t = t + "                CASE ""::RECYCLE""" + NL
    t = t + "                    IF BinLines().Count > 0 THEN RETURN ""recyfull""" + NL
    t = t + "                    RETURN ""recycle""" + NL
    t = t + "                CASE ""::DESKTOP""" + NL
    t = t + "                    RETURN ""desktop""" + NL
    t = t + "            END SELECT" + NL
    t = t + "            RETURN ""folder""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    SELECT CASE ExtOf(name)" + NL
    t = t + "        CASE ""TXT"", ""MD""" + NL
    t = t + "            RETURN ""txt""" + NL
    t = t + "        CASE ""SPK""" + NL
    t = t + "            RETURN ""spk""" + NL
    t = t + "        CASE ""HTM"", ""HTML""" + NL
    t = t + "            RETURN ""htm""" + NL
    t = t + "        CASE ""PIC""" + NL
    t = t + "            RETURN ""pic""" + NL
    t = t + "        CASE ""JS""" + NL
    t = t + "            RETURN ""js""" + NL
    t = t + "        CASE ""JSN""" + NL
    t = t + "            RETURN ""jsn""" + NL
    t = t + "        CASE ""ASP""" + NL
    t = t + "            RETURN ""asp""" + NL
    t = t + "        CASE ""INI"", ""INF"", ""SYS"", ""PWL""" + NL
    t = t + "            RETURN ""ini""" + NL
    t = t + "        CASE ""EXE""" + NL
    t = t + "            RETURN ""exe""" + NL
    t = t + "        CASE ""RUN""" + NL
    t = t + "            RETURN ""run""" + NL
    t = t + "        CASE ""SH""" + NL
    t = t + "            RETURN ""terminal""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""file""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ what's in the folder" + NL
    t = t + "" + NL
    t = t + "SUB AddItem (name AS String, p AS String, kind AS String, size AS Integer, extra AS String)" + NL
    t = t + "    cName.Add(name)" + NL
    t = t + "    cPath.Add(p)" + NL
    t = t + "    cKind.Add(kind)" + NL
    t = t + "    cSize.Add(size)" + NL
    t = t + "    cType.Add(TypeName(name, kind))" + NL
    t = t + "    cIcon.Add(IconFor(name, kind, p))" + NL
    t = t + "    cExtra.Add(extra)" + NL
    t = t + "    cSel.Add(FALSE)" + NL
    t = t + "    itX.Add(0)" + NL
    t = t + "    itY.Add(0)" + NL
    t = t + "    itW.Add(0)" + NL
    t = t + "    itH.Add(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB LoadContents ()" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    VAR m AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    cName.Clear()" + NL
    t = t + "    cPath.Clear()" + NL
    t = t + "    cKind.Clear()" + NL
    t = t + "    cSize.Clear()" + NL
    t = t + "    cType.Clear()" + NL
    t = t + "    cIcon.Clear()" + NL
    t = t + "    cExtra.Clear()" + NL
    t = t + "    cSel.Clear()" + NL
    t = t + "    itX.Clear()" + NL
    t = t + "    itY.Clear()" + NL
    t = t + "    itW.Clear()" + NL
    t = t + "    itH.Clear()" + NL
    t = t + "    listError = """"" + NL
    t = t + "    ReadCutSet()" + NL
    t = t + "    SELECT CASE cur" + NL
    t = t + "        CASE ""::DESKTOP""" + NL
    t = t + "            AddItem(""My Computer"", ""::COMPUTER"", ""PLACE"", 0, """")" + NL
    t = t + "            AddItem(""Network Neighborhood"", ""::NETWORK"", ""PLACE"", 0, """")" + NL
    t = t + "            AddItem(""Recycle Bin"", ""::RECYCLE"", ""PLACE"", 0, """")" + NL
    t = t + "            RETURN" + NL
    t = t + "        CASE ""::COMPUTER""" + NL
    t = t + "            AddItem(""(C:)"", ""C:\"", ""DRIVE"", 0, """")" + NL
    t = t + "            FOR d = 0 TO dLetter.Count - 1" + NL
    t = t + "                AddItem(PlaceLabel(dLetter[d] + "":\""), dLetter[d] + "":\"", ""NETDRIVE"", 0, dTarget[d])" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF FS.Exists(""C:\PROGRAMS\SETTINGS.SPK"") THEN AddItem(""Control Panel"", ""C:\PROGRAMS\SETTINGS.SPK"", ""APP"", 0, """")" + NL
    t = t + "            RETURN" + NL
    t = t + "        CASE ""::NETWORK""" + NL
    t = t + "            FOR EACH m IN Machines(FALSE)" + NL
    t = t + "                AddItem(Pretty(m, FALSE), ""\\"" + m + ""\"", ""MACHINE"", 0, """")" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN" + NL
    t = t + "        CASE ""::RECYCLE""" + NL
    t = t + "            FOR EACH line IN BinLines()" + NL
    t = t + "                parts = line.Split(""|"")" + NL
    t = t + "                AddItem(BaseName(parts[1]), BINDIR + ""\"" + parts[0], parts[4], Int(Val(parts[3])), ParentOf(parts[1]))" + NL
    t = t + "            NEXT" + NL
    t = t + "            SortContents()" + NL
    t = t + "            RETURN" + NL
    t = t + "        CASE ""::FIND""" + NL
    t = t + "            FOR EACH e IN findPaths" + NL
    t = t + "                parts = e.Split(""|"")" + NL
    t = t + "                AddItem(BaseName(parts[0]), parts[0], parts[1], Int(Val(parts[2])), ParentOf(parts[0]))" + NL
    t = t + "            NEXT" + NL
    t = t + "            SortContents()" + NL
    t = t + "            RETURN" + NL
    t = t + "    END SELECT" + NL
    t = t + "    TRY" + NL
    t = t + "        FOR EACH e IN VList(cur)" + NL
    t = t + "            parts = e.Split(""|"")" + NL
    t = t + "            AddItem(parts[0], JoinPath(cur, parts[0]), parts[1], Int(Val(parts[2])), """")" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF IsMapped(cur) THEN MarkDrive(cur, FALSE)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        IF err.StartsWith(""!cancel"") THEN" + NL
    t = t + "            listError = ""You did not log on to \\"" + HostOf(cur) + "".""" + NL
    t = t + "        ELSE" + NL
    t = t + "            listError = err" + NL
    t = t + "        END IF" + NL
    t = t + "        IF IsMapped(cur) THEN MarkDrive(cur, TRUE)" + NL
    t = t + "    END TRY" + NL
    t = t + "    SortContents()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MarkDrive (p AS String, down AS Bool)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = DriveIndex(p.Substring(0, 1))" + NL
    t = t + "    IF i >= 0 THEN dDown[i] = down" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Folders first, then by name, type or size (an insertion sort on keys)" + NL
    t = t + "SUB SortContents ()" + NL
    t = t + "    VAR keysArr AS Array OF String" + NL
    t = t + "    VAR order AS Array OF Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR k AS String" + NL
    t = t + "    VAR n AS Array OF String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR kd AS Array OF String" + NL
    t = t + "    VAR sz AS Array OF Integer" + NL
    t = t + "    VAR ty AS Array OF String" + NL
    t = t + "    VAR ic AS Array OF String" + NL
    t = t + "    VAR ex AS Array OF String" + NL
    t = t + "    FOR i = 0 TO cName.Count - 1" + NL
    t = t + "        k = ""1""" + NL
    t = t + "        IF cKind[i] <> ""F"" THEN k = ""0""" + NL
    t = t + "        SELECT CASE sortBy" + NL
    t = t + "            CASE ""type""" + NL
    t = t + "                k = k + cType[i].Upper().PadRight(30)" + NL
    t = t + "            CASE ""size""" + NL
    t = t + "                k = k + Str(cSize[i]).PadLeft(12)" + NL
    t = t + "        END SELECT" + NL
    t = t + "        keysArr.Add(k + cName[i].Upper().PadRight(14) + ""|"" + Str(i))" + NL
    t = t + "    NEXT" + NL
    t = t + "    keysArr.Sort()" + NL
    t = t + "    FOR EACH k IN keysArr" + NL
    t = t + "        i = Int(Val(k.Substring(k.IndexOf(""|"") + 1, k.Length - k.IndexOf(""|"") - 1)))" + NL
    t = t + "        n.Add(cName[i])" + NL
    t = t + "        p.Add(cPath[i])" + NL
    t = t + "        kd.Add(cKind[i])" + NL
    t = t + "        sz.Add(cSize[i])" + NL
    t = t + "        ty.Add(cType[i])" + NL
    t = t + "        ic.Add(cIcon[i])" + NL
    t = t + "        ex.Add(cExtra[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    cName = n" + NL
    t = t + "    cPath = p" + NL
    t = t + "    cKind = kd" + NL
    t = t + "    cSize = sz" + NL
    t = t + "    cType = ty" + NL
    t = t + "    cIcon = ic" + NL
    t = t + "    cExtra = ex" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ReadCutSet ()" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    cutSet = ""|""" + NL
    t = t + "    IF NOT FS.Exists(CLIPFILE) THEN RETURN" + NL
    t = t + "    lines = FS.Read(CLIPFILE).Lines()" + NL
    t = t + "    IF lines.Count < 2 OR lines[0] <> ""cut"" THEN RETURN" + NL
    t = t + "    FOR k = 1 TO lines.Count - 1" + NL
    t = t + "        cutSet = cutSet + lines[k] + ""|""" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION SelCount () AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    FOR i = 0 TO cSel.Count - 1" + NL
    t = t + "        IF cSel[i] THEN n = n + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION FirstSel () AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO cSel.Count - 1" + NL
    t = t + "        IF cSel[i] THEN RETURN i" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN -1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION KindOf (i AS Integer) AS String" + NL
    t = t + "    IF i < 0 OR i >= cKind.Count THEN RETURN """"" + NL
    t = t + "    RETURN cKind[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsFolderish (i AS Integer) AS Bool" + NL
    t = t + "    RETURN ""|D|DRIVE|NETDRIVE|MACHINE|PLACE|"".Contains(""|"" + KindOf(i) + ""|"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION AllKind (k AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO cSel.Count - 1" + NL
    t = t + "        IF cSel[i] AND cKind[i] <> k THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN SelCount() > 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CanCopySel () AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO cSel.Count - 1" + NL
    t = t + "        IF cSel[i] AND cKind[i] <> ""F"" AND cKind[i] <> ""D"" THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN cur <> ""::RECYCLE""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CanWriteHere () AS Bool" + NL
    t = t + "    RETURN NOT IsVirtual(cur) AND listError = """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the tree" + NL
    t = t + "" + NL
    t = t + "SUB BuildTree ()" + NL
    t = t + "    tPath.Clear()" + NL
    t = t + "    tLabel.Clear()" + NL
    t = t + "    tIcon.Clear()" + NL
    t = t + "    tDepth.Clear()" + NL
    t = t + "    tKids.Clear()" + NL
    t = t + "    tOpen.Clear()" + NL
    t = t + "    tLines.Clear()" + NL
    t = t + "    tLast.Clear()" + NL
    t = t + "    AddNode(""::DESKTOP"", 0, """", TRUE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One node, and (when it's open) the nodes in it." + NL
    t = t + "SUB AddNode (p AS String, depth AS Integer, lines AS String, last AS Bool)" + NL
    t = t + "    VAR kids AS Array OF String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR open AS Bool" + NL
    t = t + "    VAR known AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR more AS String" + NL
    t = t + "    open = expanded.Contains(""|"" + p + ""|"")" + NL
    t = t + "    known = open OR NOT IsRemote(p) OR noKids.Contains(""|"" + p + ""|"")" + NL
    t = t + "    IF p = ""::NETWORK"" AND NOT open THEN known = FALSE" + NL
    t = t + "    IF known THEN kids = NodeKids(p, open)" + NL
    t = t + "    tPath.Add(p)" + NL
    t = t + "    tLabel.Add(PlaceLabel(p))" + NL
    t = t + "    IF p.StartsWith(""::"") THEN" + NL
    t = t + "        tIcon.Add(IconFor("""", ""PLACE"", p))" + NL
    t = t + "    ELSEIF p = ""C:\"" THEN" + NL
    t = t + "        tIcon.Add(""drive"")" + NL
    t = t + "    ELSEIF IsMapped(p) AND IsRoot(p) THEN" + NL
    t = t + "        tIcon.Add(IconFor("""", ""NETDRIVE"", p))" + NL
    t = t + "    ELSEIF IsUnc(p) AND IsRoot(p) THEN" + NL
    t = t + "        tIcon.Add(""computer"")" + NL
    t = t + "    ELSEIF open OR p = cur THEN" + NL
    t = t + "        tIcon.Add(""folderopen"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        tIcon.Add(IconFor("""", ""D"", p))" + NL
    t = t + "    END IF" + NL
    t = t + "    tDepth.Add(depth)" + NL
    t = t + "    IF NOT known THEN" + NL
    t = t + "        tKids.Add(2)" + NL
    t = t + "    ELSEIF kids.Count > 0 THEN" + NL
    t = t + "        tKids.Add(1)" + NL
    t = t + "    ELSE" + NL
    t = t + "        tKids.Add(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    tOpen.Add(open AND kids.Count > 0)" + NL
    t = t + "    tLines.Add(lines)" + NL
    t = t + "    tLast.Add(last)" + NL
    t = t + "    IF NOT open THEN RETURN" + NL
    t = t + "    i = tPath.Count - 1" + NL
    t = t + "    more = lines" + NL
    t = t + "    IF depth > 0 THEN more = lines + Flag(NOT last)" + NL
    t = t + "    FOR k = 0 TO kids.Count - 1" + NL
    t = t + "        AddNode(kids[k], depth + 1, more, k = kids.Count - 1)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The folders in a place (when open), or just whether there are any." + NL
    t = t + "FUNCTION NodeKids (p AS String, open AS Bool) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    VAR m AS String" + NL
    t = t + "    SELECT CASE p" + NL
    t = t + "        CASE ""::DESKTOP""" + NL
    t = t + "            out = [""::COMPUTER"", ""::NETWORK"", ""::RECYCLE""]" + NL
    t = t + "            RETURN out" + NL
    t = t + "        CASE ""::COMPUTER""" + NL
    t = t + "            out.Add(""C:\"")" + NL
    t = t + "            FOR d = 0 TO dLetter.Count - 1" + NL
    t = t + "                out.Add(dLetter[d] + "":\"")" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN out" + NL
    t = t + "        CASE ""::NETWORK""" + NL
    t = t + "            FOR EACH m IN Machines(FALSE)" + NL
    t = t + "                out.Add(""\\"" + m + ""\"")" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN out" + NL
    t = t + "        CASE ""::RECYCLE"", ""::FIND""" + NL
    t = t + "            RETURN out" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF IsRemote(p) THEN" + NL
    t = t + "        ' (only when the node is opened: it means asking the machine)" + NL
    t = t + "        TRY" + NL
    t = t + "            FOR EACH e IN VList(p)" + NL
    t = t + "                IF e.Split(""|"")[1] = ""D"" THEN out.Add(JoinPath(p, e.Split(""|"")[0]))" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF IsMapped(p) THEN MarkDrive(p, FALSE)" + NL
    t = t + "        CATCH err" + NL
    t = t + "            IF IsMapped(p) THEN MarkDrive(p, TRUE)" + NL
    t = t + "            expanded = expanded.Replace(""|"" + p + ""|"", ""|"")" + NL
    t = t + "        END TRY" + NL
    t = t + "        IF out.Count = 0 AND NOT noKids.Contains(""|"" + p + ""|"") THEN noKids = noKids + p + ""|""" + NL
    t = t + "        RETURN out" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT FS.Exists(p) THEN RETURN out" + NL
    t = t + "    FOR EACH e IN FS.List(p)" + NL
    t = t + "        IF e.EndsWith(""\"") THEN out.Add(JoinPath(p, e.Substring(0, e.Length - 1)))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB ToggleNode (i AS Integer)" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    IF i < 0 OR i >= tPath.Count THEN RETURN" + NL
    t = t + "    p = tPath[i]" + NL
    t = t + "    IF expanded.Contains(""|"" + p + ""|"") THEN" + NL
    t = t + "        expanded = expanded.Replace(""|"" + p + ""|"", ""|"")" + NL
    t = t + "        ' (a folder closed with the current one inside: show this one)" + NL
    t = t + "        IF cur <> p AND cur.StartsWith(p) AND NOT IsVirtual(p) THEN Go(p)" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF p = ""::NETWORK"" THEN Machines(NOT machinesKnown)" + NL
    t = t + "        expanded = expanded + p + ""|""" + NL
    t = t + "    END IF" + NL
    t = t + "    BuildTree()" + NL
    t = t + "    DrawTree()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ geometry" + NL
    t = t + "" + NL
    t = t + "FUNCTION TreeRight () AS Integer" + NL
    t = t + "    IF NOT showTree THEN RETURN 0" + NL
    t = t + "    RETURN treeW" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ListLeftX () AS Integer" + NL
    t = t + "    IF NOT showTree THEN RETURN 0" + NL
    t = t + "    RETURN treeW + SPLITW" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' the inside of each pane, below its heading, inside its sunken edge" + NL
    t = t + "FUNCTION TreeInnerH () AS Integer" + NL
    t = t + "    RETURN cv.Height - HEADH - 4" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION TreeNeedsBar () AS Bool" + NL
    t = t + "    RETURN tPath.Count * ROWH + 4 > TreeInnerH()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The area files are drawn in, inside the pane (x, y, w, h): items are at" + NL
    t = t + "' (areaX + itX - listLeft, areaY + itY - listTop)." + NL
    t = t + "FUNCTION AreaX () AS Integer" + NL
    t = t + "    RETURN ListLeftX() + 2" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION AreaY () AS Integer" + NL
    t = t + "    IF viewMode = ""details"" THEN RETURN HEADH + 2 + ROWH" + NL
    t = t + "    RETURN HEADH + 2" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION AreaW () AS Integer" + NL
    t = t + "    VAR w AS Integer" + NL
    t = t + "    w = cv.Width - ListLeftX() - 4" + NL
    t = t + "    IF viewMode <> ""list"" AND extentH > AreaHFull() THEN w = w - SBW" + NL
    t = t + "    RETURN MATH.Max(10, w)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION AreaHFull () AS Integer" + NL
    t = t + "    RETURN cv.Height - AreaY() - 2" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION AreaH () AS Integer" + NL
    t = t + "    IF viewMode = ""list"" AND extentW > cv.Width - ListLeftX() - 4 THEN RETURN MATH.Max(10, AreaHFull() - SBW)" + NL
    t = t + "    RETURN MATH.Max(10, AreaHFull())" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where each item goes, for the view." + NL
    t = t + "SUB LayoutList ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR cols AS Integer" + NL
    t = t + "    VAR rows AS Integer" + NL
    t = t + "    VAR cellW AS Integer" + NL
    t = t + "    VAR cellH AS Integer" + NL
    t = t + "    VAR w AS Integer" + NL
    t = t + "    VAR longest AS Integer" + NL
    t = t + "    VAR pass AS Integer" + NL
    t = t + "    IF IsNothing(cv) THEN RETURN" + NL
    t = t + "    colW.Clear()" + NL
    t = t + "    colW.Add(MATH.Max(176, MATH.Min(260, LongestName() * 8 + 30)))" + NL
    t = t + "    colW.Add(72)" + NL
    t = t + "    colW.Add(150)" + NL
    t = t + "    IF cur = ""::RECYCLE"" OR cur = ""::FIND"" THEN colW.Add(220)" + NL
    t = t + "    ' twice: the first time to find whether a scroll bar is wanted" + NL
    t = t + "    FOR pass = 1 TO 2" + NL
    t = t + "        w = cv.Width - ListLeftX() - 4" + NL
    t = t + "        IF pass = 2 AND viewMode <> ""list"" AND extentH > AreaHFull() THEN w = w - SBW" + NL
    t = t + "        extentW = 0" + NL
    t = t + "        extentH = 0" + NL
    t = t + "        SELECT CASE viewMode" + NL
    t = t + "            CASE ""large""" + NL
    t = t + "                cellW = 100" + NL
    t = t + "                cellH = 70" + NL
    t = t + "                cols = MATH.Max(1, Int(w / cellW))" + NL
    t = t + "                FOR i = 0 TO cName.Count - 1" + NL
    t = t + "                    itX[i] = (i MOD cols) * cellW" + NL
    t = t + "                    itY[i] = Int(i / cols) * cellH + 4" + NL
    t = t + "                    itW[i] = cellW" + NL
    t = t + "                    itH[i] = cellH - 4" + NL
    t = t + "                NEXT" + NL
    t = t + "                extentW = w" + NL
    t = t + "                extentH = Int((cName.Count + cols - 1) / cols) * cellH + 8" + NL
    t = t + "            CASE ""small""" + NL
    t = t + "                cellW = 132" + NL
    t = t + "                cols = MATH.Max(1, Int(w / cellW))" + NL
    t = t + "                FOR i = 0 TO cName.Count - 1" + NL
    t = t + "                    itX[i] = (i MOD cols) * cellW + 2" + NL
    t = t + "                    itY[i] = Int(i / cols) * ROWH + 2" + NL
    t = t + "                    itW[i] = cellW - 4" + NL
    t = t + "                    itH[i] = ROWH" + NL
    t = t + "                NEXT" + NL
    t = t + "                extentW = w" + NL
    t = t + "                extentH = Int((cName.Count + cols - 1) / cols) * ROWH + 6" + NL
    t = t + "            CASE ""list""" + NL
    t = t + "                longest = LongestName()" + NL
    t = t + "                cellW = MATH.Max(120, MATH.Min(22 + longest * 8 + 14, 260))" + NL
    t = t + "                rows = MATH.Max(1, Int((AreaHFull() - SBW - 4) / ROWH))" + NL
    t = t + "                FOR i = 0 TO cName.Count - 1" + NL
    t = t + "                    itX[i] = Int(i / rows) * cellW + 2" + NL
    t = t + "                    itY[i] = (i MOD rows) * ROWH + 2" + NL
    t = t + "                    itW[i] = cellW - 4" + NL
    t = t + "                    itH[i] = ROWH" + NL
    t = t + "                NEXT" + NL
    t = t + "                extentW = Int((cName.Count + rows - 1) / rows) * cellW + 4" + NL
    t = t + "                extentH = rows * ROWH" + NL
    t = t + "            CASE ELSE" + NL
    t = t + "                FOR i = 0 TO cName.Count - 1" + NL
    t = t + "                    itX[i] = 0" + NL
    t = t + "                    itY[i] = i * ROWH" + NL
    t = t + "                    itW[i] = colW[0]" + NL
    t = t + "                    itH[i] = ROWH" + NL
    t = t + "                NEXT" + NL
    t = t + "                extentW = SumOf(colW)" + NL
    t = t + "                extentH = cName.Count * ROWH + 2" + NL
    t = t + "        END SELECT" + NL
    t = t + "    NEXT" + NL
    t = t + "    ClampScroll()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION SumOf (a AS Array OF Integer) AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    FOR EACH x IN a" + NL
    t = t + "        n = n + x" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LongestName () AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    FOR i = 0 TO cName.Count - 1" + NL
    t = t + "        n = MATH.Max(n, ShownName(i).Length)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ShownName (i AS Integer) AS String" + NL
    t = t + "    IF cKind[i] = ""F"" OR cKind[i] = ""D"" THEN RETURN Pretty(cName[i], cKind[i] = ""F"")" + NL
    t = t + "    RETURN cName[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB ClampScroll ()" + NL
    t = t + "    listTop = MATH.Max(0, MATH.Min(listTop, extentH - AreaH()))" + NL
    t = t + "    listLeft = MATH.Max(0, MATH.Min(listLeft, extentW - AreaW()))" + NL
    t = t + "    IF viewMode <> ""list"" THEN listLeft = 0" + NL
    t = t + "    treeTop = MATH.Max(0, MATH.Min(treeTop, tPath.Count * ROWH + 4 - TreeInnerH()))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ drawing" + NL
    t = t + "" + NL
    t = t + "SUB Cv_OnDraw (c AS GUI_Canvas)" + NL
    t = t + "    LayoutList()" + NL
    t = t + "    Redraw()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Redraw ()" + NL
    t = t + "    IF IsNothing(cv) THEN RETURN" + NL
    t = t + "    cv.Clear()" + NL
    t = t + "    IF showTree THEN" + NL
    t = t + "        DrawTree()" + NL
    t = t + "        DrawSplitter()" + NL
    t = t + "    END IF" + NL
    t = t + "    DrawList()" + NL
    t = t + "    lastPaint = SYS.Ticks" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A raised (or sunken) Windows 95 edge around x, y, w, h" + NL
    t = t + "SUB Bevel (c AS GUI_Canvas, x AS Integer, y AS Integer, w AS Integer, h AS Integer, raised AS Bool)" + NL
    t = t + "    IF raised THEN" + NL
    t = t + "        c.SetColor(15)" + NL
    t = t + "        c.Line(x, y, x + w - 2, y)" + NL
    t = t + "        c.Line(x, y, x, y + h - 2)" + NL
    t = t + "        c.SetColor(0)" + NL
    t = t + "        c.Line(x, y + h - 1, x + w - 1, y + h - 1)" + NL
    t = t + "        c.Line(x + w - 1, y, x + w - 1, y + h - 1)" + NL
    t = t + "        c.SetColor(8)" + NL
    t = t + "        c.Line(x + 1, y + h - 2, x + w - 2, y + h - 2)" + NL
    t = t + "        c.Line(x + w - 2, y + 1, x + w - 2, y + h - 2)" + NL
    t = t + "    ELSE" + NL
    t = t + "        c.SetColor(8)" + NL
    t = t + "        c.Line(x, y, x + w - 1, y)" + NL
    t = t + "        c.Line(x, y, x, y + h - 1)" + NL
    t = t + "        c.SetColor(0)" + NL
    t = t + "        c.Line(x + 1, y + 1, x + w - 2, y + 1)" + NL
    t = t + "        c.Line(x + 1, y + 1, x + 1, y + h - 2)" + NL
    t = t + "        c.SetColor(15)" + NL
    t = t + "        c.Line(x, y + h - 1, x + w - 1, y + h - 1)" + NL
    t = t + "        c.Line(x + w - 1, y, x + w - 1, y + h - 1)" + NL
    t = t + "        c.SetColor(7)" + NL
    t = t + "        c.Line(x + 1, y + h - 2, x + w - 2, y + h - 2)" + NL
    t = t + "        c.Line(x + w - 2, y + 1, x + w - 2, y + h - 2)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Text cut to fit n characters" + NL
    t = t + "FUNCTION Fit (s AS String, n AS Integer) AS String" + NL
    t = t + "    IF n <= 0 THEN RETURN """"" + NL
    t = t + "    IF s.Length <= n THEN RETURN s" + NL
    t = t + "    IF n <= 3 THEN RETURN s.Substring(0, n)" + NL
    t = t + "    RETURN s.Substring(0, n - 3) + ""...""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Heading (x AS Integer, w AS Integer, text AS String)" + NL
    t = t + "    cv.SetColor(7)" + NL
    t = t + "    cv.FillRect(x, 0, w, HEADH)" + NL
    t = t + "    Bevel(cv, x, 0, w, HEADH, TRUE)" + NL
    t = t + "    cv.SetColor(0)" + NL
    t = t + "    cv.Text(x + 6, 2, Fit(text, Int((w - 10) / 8)))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawSplitter ()" + NL
    t = t + "    cv.SetColor(7)" + NL
    t = t + "    cv.FillRect(treeW, 0, SPLITW, cv.Height)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawTree ()" + NL
    t = t + "    VAR w AS Integer" + NL
    t = t + "    VAR h AS Integer" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    VAR right AS Integer" + NL
    t = t + "    VAR top AS Integer" + NL
    t = t + "    VAR bottom AS Integer" + NL
    t = t + "    VAR lx AS Integer" + NL
    t = t + "    VAR label AS String" + NL
    t = t + "    VAR room AS Integer" + NL
    t = t + "    IF NOT showTree THEN RETURN" + NL
    t = t + "    w = treeW" + NL
    t = t + "    h = cv.Height" + NL
    t = t + "    top = HEADH + 2" + NL
    t = t + "    bottom = h - 2" + NL
    t = t + "    right = w - 2" + NL
    t = t + "    IF TreeNeedsBar() THEN right = right - SBW" + NL
    t = t + "    ClampScroll()" + NL
    t = t + "    cv.SetColor(15)" + NL
    t = t + "    cv.FillRect(2, top, right - 2, bottom - top)" + NL
    t = t + "    FOR i = 0 TO tPath.Count - 1" + NL
    t = t + "        y = top + 2 + i * ROWH - treeTop" + NL
    t = t + "        IF y + ROWH < top OR y > bottom THEN CONTINUE" + NL
    t = t + "        d = tDepth[i]" + NL
    t = t + "        x = 6 + d * INDENT" + NL
    t = t + "        ' the dotted lines: of the levels above that go on, and this one's" + NL
    t = t + "        FOR lx = 1 TO d - 1" + NL
    t = t + "            IF tLines[i].Substring(lx - 1, 1) = ""1"" THEN cv.Picture(6 + lx * INDENT - 11, y, picVDots)" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF d > 0 THEN" + NL
    t = t + "            IF tLast[i] THEN" + NL
    t = t + "                cv.Picture(x - 11, y, picVHalf)" + NL
    t = t + "            ELSE" + NL
    t = t + "                cv.Picture(x - 11, y, picVDots)" + NL
    t = t + "            END IF" + NL
    t = t + "            cv.Picture(x - 11, y + 9, picHDots)" + NL
    t = t + "        END IF" + NL
    t = t + "        IF tKids[i] <> 0 AND d > 0 THEN" + NL
    t = t + "            IF tOpen[i] THEN" + NL
    t = t + "                cv.Picture(x - 15, y + 5, picMinus)" + NL
    t = t + "            ELSE" + NL
    t = t + "                cv.Picture(x - 15, y + 5, picPlus)" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        cv.Picture(x, y + 1, Icon(tIcon[i], 16, ""n""))" + NL
    t = t + "        room = Int((right - (x + 20) - 4) / 8)" + NL
    t = t + "        label = Fit(tLabel[i], room)" + NL
    t = t + "        IF label = """" THEN CONTINUE" + NL
    t = t + "        IF tPath[i] = cur THEN" + NL
    t = t + "            IF focusTree THEN" + NL
    t = t + "                cv.SetColor(4)" + NL
    t = t + "            ELSE" + NL
    t = t + "                cv.SetColor(7)" + NL
    t = t + "            END IF" + NL
    t = t + "            cv.FillRect(x + 19, y + 1, label.Length * 8 + 4, 16)" + NL
    t = t + "            IF focusTree THEN" + NL
    t = t + "                cv.SetColor(15)" + NL
    t = t + "            ELSE" + NL
    t = t + "                cv.SetColor(0)" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSEIF tPath[i] = dropTarget THEN" + NL
    t = t + "            cv.SetColor(4)" + NL
    t = t + "            cv.FillRect(x + 19, y + 1, label.Length * 8 + 4, 16)" + NL
    t = t + "            cv.SetColor(15)" + NL
    t = t + "        ELSE" + NL
    t = t + "            cv.SetColor(0)" + NL
    t = t + "        END IF" + NL
    t = t + "        cv.Text(x + 21, y + 1, label)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF TreeNeedsBar() THEN VBar(right, top, bottom - top, treeTop, tPath.Count * ROWH + 4, TreeInnerH())" + NL
    t = t + "    Bevel(cv, 0, HEADH, w, h - HEADH, FALSE)" + NL
    t = t + "    Heading(0, w, ""All Folders"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A vertical scroll bar at x, from y, h high: showing seen of total, from pos" + NL
    t = t + "SUB VBar (x AS Integer, y AS Integer, h AS Integer, pos AS Integer, total AS Integer, seen AS Integer)" + NL
    t = t + "    VAR track AS Integer" + NL
    t = t + "    VAR thumb AS Integer" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    track = h - 2 * SBW" + NL
    t = t + "    ' (the dotted track, in tiles; the last one ends at the bottom button)" + NL
    t = t + "    k = y + SBW" + NL
    t = t + "    WHILE k < y + h - SBW" + NL
    t = t + "        cv.Picture(x, MATH.Min(k, y + h - SBW - 16), picTrack)" + NL
    t = t + "        k = k + 16" + NL
    t = t + "    END WHILE" + NL
    t = t + "    Arrow(x, y, ""up"")" + NL
    t = t + "    Arrow(x, y + h - SBW, ""down"")" + NL
    t = t + "    IF total <= seen OR track < 8 THEN RETURN" + NL
    t = t + "    thumb = MATH.Max(8, Int(track * seen / total))" + NL
    t = t + "    at = y + SBW + Int((track - thumb) * pos / MATH.Max(1, total - seen))" + NL
    t = t + "    cv.SetColor(7)" + NL
    t = t + "    cv.FillRect(x, at, SBW, thumb)" + NL
    t = t + "    Bevel(cv, x, at, SBW, thumb, TRUE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB HBar (x AS Integer, y AS Integer, w AS Integer, pos AS Integer, total AS Integer, seen AS Integer)" + NL
    t = t + "    VAR track AS Integer" + NL
    t = t + "    VAR thumb AS Integer" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    track = w - 2 * SBW" + NL
    t = t + "    k = x + SBW" + NL
    t = t + "    WHILE k < x + w - SBW" + NL
    t = t + "        cv.Picture(MATH.Min(k, x + w - SBW - 16), y, picTrack)" + NL
    t = t + "        k = k + 16" + NL
    t = t + "    END WHILE" + NL
    t = t + "    Arrow(x, y, ""left"")" + NL
    t = t + "    Arrow(x + w - SBW, y, ""right"")" + NL
    t = t + "    IF total <= seen OR track < 8 THEN RETURN" + NL
    t = t + "    thumb = MATH.Max(8, Int(track * seen / total))" + NL
    t = t + "    at = x + SBW + Int((track - thumb) * pos / MATH.Max(1, total - seen))" + NL
    t = t + "    cv.SetColor(7)" + NL
    t = t + "    cv.FillRect(at, y, thumb, SBW)" + NL
    t = t + "    Bevel(cv, at, y, thumb, SBW, TRUE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A scroll bar button with its black triangle" + NL
    t = t + "SUB Arrow (x AS Integer, y AS Integer, way AS String)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    cv.SetColor(7)" + NL
    t = t + "    cv.FillRect(x, y, SBW, SBW)" + NL
    t = t + "    Bevel(cv, x, y, SBW, SBW, TRUE)" + NL
    t = t + "    cv.SetColor(0)" + NL
    t = t + "    FOR k = 0 TO 3" + NL
    t = t + "        SELECT CASE way" + NL
    t = t + "            CASE ""up""" + NL
    t = t + "                cv.Line(x + 7 - k, y + 5 + k, x + 7 + k, y + 5 + k)" + NL
    t = t + "            CASE ""down""" + NL
    t = t + "                cv.Line(x + 7 - k, y + 9 - k, x + 7 + k, y + 9 - k)" + NL
    t = t + "            CASE ""left""" + NL
    t = t + "                cv.Line(x + 5 + k, y + 7 - k, x + 5 + k, y + 7 + k)" + NL
    t = t + "            CASE ""right""" + NL
    t = t + "                cv.Line(x + 9 - k, y + 7 - k, x + 9 - k, y + 7 + k)" + NL
    t = t + "        END SELECT" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawList ()" + NL
    t = t + "    VAR x0 AS Integer" + NL
    t = t + "    VAR ax AS Integer" + NL
    t = t + "    VAR ay AS Integer" + NL
    t = t + "    VAR aw AS Integer" + NL
    t = t + "    VAR ah AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR head AS String" + NL
    t = t + "    ax = AreaX()" + NL
    t = t + "    ay = AreaY()" + NL
    t = t + "    aw = AreaW()" + NL
    t = t + "    ah = AreaH()" + NL
    t = t + "    x0 = ListLeftX()" + NL
    t = t + "    cv.SetColor(15)" + NL
    t = t + "    cv.FillRect(x0 + 2, HEADH + 2, cv.Width - x0 - 4, cv.Height - HEADH - 4)" + NL
    t = t + "    IF listError <> """" THEN" + NL
    t = t + "        cv.SetColor(0)" + NL
    t = t + "        DrawWrapped(ax + 8, ay + 8, listError, Int((aw - 16) / 8))" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 0 TO cName.Count - 1" + NL
    t = t + "        DrawItem(i)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF mode = ""band"" THEN DrawBand()" + NL
    t = t + "    ' what goes over the edges of the area: the bars, the column heads, the edge" + NL
    t = t + "    IF viewMode <> ""list"" AND extentH > AreaHFull() THEN VBar(ax + aw, ay, ah, listTop, extentH, ah)" + NL
    t = t + "    IF viewMode = ""list"" AND extentW > cv.Width - x0 - 4 THEN HBar(ax, ay + ah, aw, listLeft, extentW, aw)" + NL
    t = t + "    IF viewMode = ""details"" THEN DrawColumns()" + NL
    t = t + "    Bevel(cv, x0, HEADH, cv.Width - x0, cv.Height - HEADH, FALSE)" + NL
    t = t + "    head = ""Contents of '"" + PlaceLabel(cur) + ""'""" + NL
    t = t + "    IF cur = ""::FIND"" THEN head = ""Search Results""" + NL
    t = t + "    Heading(x0, cv.Width - x0, head)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawWrapped (x AS Integer, y AS Integer, text AS String, n AS Integer)" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR word AS String" + NL
    t = t + "    VAR para AS String" + NL
    t = t + "    FOR EACH para IN text.Lines()" + NL
    t = t + "        line = """"" + NL
    t = t + "        FOR EACH word IN para.Split("" "")" + NL
    t = t + "            IF line <> """" AND line.Length + 1 + word.Length > n THEN" + NL
    t = t + "                cv.Text(x, y, line)" + NL
    t = t + "                y = y + 16" + NL
    t = t + "                line = word" + NL
    t = t + "            ELSEIF line = """" THEN" + NL
    t = t + "                line = word" + NL
    t = t + "            ELSE" + NL
    t = t + "                line = line + "" "" + word" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        cv.Text(x, y, line)" + NL
    t = t + "        y = y + 16" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ItemState (i AS Integer) AS String" + NL
    t = t + "    IF cSel[i] THEN RETURN ""s""" + NL
    t = t + "    IF cutSet.Contains(""|"" + cPath[i] + ""|"") OR cPath[i] = dropTarget THEN RETURN ""g""" + NL
    t = t + "    RETURN ""n""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB DrawItem (i AS Integer)" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR ax AS Integer" + NL
    t = t + "    VAR ay AS Integer" + NL
    t = t + "    VAR label AS String" + NL
    t = t + "    VAR l1 AS String" + NL
    t = t + "    VAR l2 AS String" + NL
    t = t + "    VAR lx AS Integer" + NL
    t = t + "    VAR cx AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR st AS String" + NL
    t = t + "    VAR room AS Integer" + NL
    t = t + "    ax = AreaX()" + NL
    t = t + "    ay = AreaY()" + NL
    t = t + "    x = ax + itX[i] - listLeft" + NL
    t = t + "    y = ay + itY[i] - listTop" + NL
    t = t + "    IF y + itH[i] < ay - ROWH OR y > ay + AreaH() OR x > ax + AreaW() OR x + itW[i] < ax THEN RETURN" + NL
    t = t + "    st = ItemState(i)" + NL
    t = t + "    label = ShownName(i)" + NL
    t = t + "    IF viewMode = ""large"" THEN" + NL
    t = t + "        cv.Picture(x + Int((itW[i] - 32) / 2), y + 2, Icon(cIcon[i], 32, st))" + NL
    t = t + "        ' up to two lines of 11, broken at a space where there is one" + NL
    t = t + "        l1 = label" + NL
    t = t + "        l2 = """"" + NL
    t = t + "        IF label.Length > 11 THEN" + NL
    t = t + "            k = -1" + NL
    t = t + "            FOR cx = MATH.Min(11, label.Length - 1) TO 1 STEP -1" + NL
    t = t + "                IF label.CharAt(cx) = "" "" THEN" + NL
    t = t + "                    k = cx" + NL
    t = t + "                    BREAK" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF k < 0 THEN k = 11" + NL
    t = t + "            l1 = label.Substring(0, k).Trim()" + NL
    t = t + "            l2 = Fit(label.Substring(k, label.Length - k).Trim(), 11)" + NL
    t = t + "        END IF" + NL
    t = t + "        DrawLabel(x + Int((itW[i] - l1.Length * 8) / 2) - 2, y + 36, l1, st = ""s"", cPath[i] = dropTarget)" + NL
    t = t + "        IF l2 <> """" THEN DrawLabel(x + Int((itW[i] - l2.Length * 8) / 2) - 2, y + 52, l2, st = ""s"", cPath[i] = dropTarget)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    cv.Picture(x + 2, y + 1, Icon(cIcon[i], 16, st))" + NL
    t = t + "    room = Int((itW[i] - 26) / 8)" + NL
    t = t + "    IF viewMode = ""details"" THEN room = Int((colW[0] - 28) / 8)" + NL
    t = t + "    DrawLabel(x + 20, y + 1, Fit(label, room), st = ""s"", cPath[i] = dropTarget)" + NL
    t = t + "    IF viewMode <> ""details"" THEN RETURN" + NL
    t = t + "    cv.SetColor(0)" + NL
    t = t + "    lx = x + colW[0]" + NL
    t = t + "    IF cKind[i] = ""F"" THEN" + NL
    t = t + "        cv.Text(lx + colW[1] - 8 - KB(cSize[i]).Length * 8, y + 1, KB(cSize[i]))" + NL
    t = t + "    END IF" + NL
    t = t + "    lx = lx + colW[1]" + NL
    t = t + "    cv.Text(lx + 6, y + 1, Fit(cType[i], Int((colW[2] - 10) / 8)))" + NL
    t = t + "    IF colW.Count > 3 THEN" + NL
    t = t + "        lx = lx + colW[2]" + NL
    t = t + "        cv.Text(lx + 6, y + 1, Fit(cExtra[i], Int((colW[3] - 10) / 8)))" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawLabel (x AS Integer, y AS Integer, text AS String, selected AS Bool, target AS Bool)" + NL
    t = t + "    IF selected OR target THEN" + NL
    t = t + "        IF focusTree AND NOT target THEN" + NL
    t = t + "            cv.SetColor(7)" + NL
    t = t + "        ELSE" + NL
    t = t + "            cv.SetColor(4)" + NL
    t = t + "        END IF" + NL
    t = t + "        cv.FillRect(x, y, text.Length * 8 + 4, 16)" + NL
    t = t + "        IF focusTree AND NOT target THEN" + NL
    t = t + "            cv.SetColor(0)" + NL
    t = t + "        ELSE" + NL
    t = t + "            cv.SetColor(15)" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSE" + NL
    t = t + "        cv.SetColor(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    cv.Text(x + 2, y, text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ""1KB"", as Windows 95 counts (a started KB is a KB)" + NL
    t = t + "FUNCTION KB (n AS Integer) AS String" + NL
    t = t + "    IF n = 0 THEN RETURN ""0KB""" + NL
    t = t + "    RETURN Str(Int((n + 1023) / 1024)) + ""KB""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Bytes (n AS Integer) AS String" + NL
    t = t + "    IF n < 1024 THEN RETURN Str(n) + "" bytes""" + NL
    t = t + "    IF n < 1048576 THEN RETURN Str(Int(n * 100 / 1024) / 100) + ""KB""" + NL
    t = t + "    RETURN Str(Int(n * 100 / 1048576) / 100) + ""MB""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB DrawColumns ()" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR names AS Array OF String" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    names = [""Name"", ""Size"", ""Type""]" + NL
    t = t + "    IF cur = ""::RECYCLE"" THEN names.Add(""Original Location"")" + NL
    t = t + "    IF cur = ""::FIND"" THEN names.Add(""In Folder"")" + NL
    t = t + "    x = AreaX() - listLeft" + NL
    t = t + "    y = HEADH + 2" + NL
    t = t + "    cv.SetColor(7)" + NL
    t = t + "    cv.FillRect(AreaX(), y, cv.Width - AreaX() - 2, ROWH)" + NL
    t = t + "    FOR k = 0 TO colW.Count - 1" + NL
    t = t + "        IF x < cv.Width - 2 THEN" + NL
    t = t + "            Bevel(cv, x, y, colW[k], ROWH, TRUE)" + NL
    t = t + "            cv.SetColor(0)" + NL
    t = t + "            IF k = 1 THEN" + NL
    t = t + "                cv.Text(x + colW[k] - 8 - names[k].Length * 8, y + 1, names[k])" + NL
    t = t + "            ELSE" + NL
    t = t + "                cv.Text(x + 6, y + 1, Fit(names[k], Int((colW[k] - 10) / 8)))" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        x = x + colW[k]" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' (nothing to the right of the last one: an empty head)" + NL
    t = t + "    IF x < cv.Width - 2 THEN Bevel(cv, x, y, cv.Width - 2 - x, ROWH, TRUE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawBand ()" + NL
    t = t + "    VAR x1 AS Integer" + NL
    t = t + "    VAR y1 AS Integer" + NL
    t = t + "    VAR x2 AS Integer" + NL
    t = t + "    VAR y2 AS Integer" + NL
    t = t + "    x1 = MATH.Min(downX, bandX)" + NL
    t = t + "    y1 = MATH.Min(downY, bandY)" + NL
    t = t + "    x2 = MATH.Max(downX, bandX)" + NL
    t = t + "    y2 = MATH.Max(downY, bandY)" + NL
    t = t + "    cv.SetColor(0)" + NL
    t = t + "    cv.Rect(x1, y1, x2 - x1 + 1, y2 - y1 + 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Shows the files again, but no more than every 40ms while the mouse moves." + NL
    t = t + "SUB RepaintSoon (force AS Bool)" + NL
    t = t + "    IF NOT force AND SYS.Ticks - lastPaint < 40 THEN RETURN" + NL
    t = t + "    DrawList()" + NL
    t = t + "    lastPaint = SYS.Ticks" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ShowStatus ()" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR total AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    IF NOT statusOn THEN RETURN" + NL
    t = t + "    n = SelCount()" + NL
    t = t + "    IF listError <> """" THEN" + NL
    t = t + "        win.Status = ""0 object(s)""" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF n > 0 THEN" + NL
    t = t + "        FOR i = 0 TO cName.Count - 1" + NL
    t = t + "            IF cSel[i] AND cKind[i] = ""F"" THEN total = total + cSize[i]" + NL
    t = t + "        NEXT" + NL
    t = t + "        s = Str(n) + "" object(s) selected""" + NL
    t = t + "    ELSE" + NL
    t = t + "        FOR i = 0 TO cName.Count - 1" + NL
    t = t + "            IF cKind[i] = ""F"" THEN total = total + cSize[i]" + NL
    t = t + "        NEXT" + NL
    t = t + "        s = Str(cName.Count) + "" object(s)""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF (NOT IsVirtual(cur) OR cur = ""::RECYCLE"" OR cur = ""::FIND"") AND (total > 0 OR n = 0) THEN s = s + ""    "" + Bytes(total)" + NL
    t = t + "    IF IsRemote(cur) THEN s = s + ""    \\"" + HostOf(cur) + "" (as "" + LogonUserOr(HostOf(cur)) + "")""" + NL
    t = t + "    win.Status = s" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION LogonUserOr (host AS String) AS String" + NL
    t = t + "    IF HaveLogon(host) THEN RETURN LogonUser(host)" + NL
    t = t + "    RETURN ""nobody""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the mouse" + NL
    t = t + "" + NL
    t = t + "FUNCTION ItemAt (x AS Integer, y AS Integer) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR cx AS Integer" + NL
    t = t + "    VAR cy AS Integer" + NL
    t = t + "    IF x < AreaX() OR x >= AreaX() + AreaW() OR y < AreaY() OR y >= AreaY() + AreaH() THEN RETURN -1" + NL
    t = t + "    cx = x - AreaX() + listLeft" + NL
    t = t + "    cy = y - AreaY() + listTop" + NL
    t = t + "    FOR i = 0 TO cName.Count - 1" + NL
    t = t + "        IF viewMode = ""large"" THEN" + NL
    t = t + "            IF cx >= itX[i] + 14 AND cx < itX[i] + itW[i] - 14 AND cy >= itY[i] AND cy < itY[i] + itH[i] - 4 THEN RETURN i" + NL
    t = t + "        ELSEIF viewMode = ""details"" THEN" + NL
    t = t + "            IF cy >= itY[i] AND cy < itY[i] + ROWH AND cx < 22 + ShownName(i).Length * 8 + 6 THEN RETURN i" + NL
    t = t + "        ELSE" + NL
    t = t + "            IF cx >= itX[i] AND cx < itX[i] + 22 + ShownName(i).Length * 8 + 6 AND cy >= itY[i] AND cy < itY[i] + ROWH THEN RETURN i" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN -1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NodeAt (x AS Integer, y AS Integer) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF NOT showTree OR x >= treeW - 2 OR y < HEADH + 2 THEN RETURN -1" + NL
    t = t + "    i = Int((y - HEADH - 4 + treeTop) / ROWH)" + NL
    t = t + "    IF i < 0 OR i >= tPath.Count THEN RETURN -1" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION OnBox (i AS Integer, x AS Integer) AS Bool" + NL
    t = t + "    VAR bx AS Integer" + NL
    t = t + "    bx = 6 + tDepth[i] * INDENT - 15" + NL
    t = t + "    RETURN tKids[i] <> 0 AND tDepth[i] > 0 AND x >= bx - 2 AND x <= bx + 11" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The folder something dropped at (x, y) would go into, or """"" + NL
    t = t + "FUNCTION DropAt (x AS Integer, y AS Integer) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = NodeAt(x, y)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        IF tPath[i] = ""::RECYCLE"" OR NOT IsVirtual(tPath[i]) THEN RETURN tPath[i]" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF x < ListLeftX() THEN RETURN """"" + NL
    t = t + "    i = ItemAt(x, y)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        IF cSel[i] THEN RETURN """"" + NL
    t = t + "        IF cKind[i] = ""D"" OR cKind[i] = ""DRIVE"" OR cKind[i] = ""NETDRIVE"" OR cKind[i] = ""MACHINE"" OR cPath[i] = ""::RECYCLE"" THEN RETURN cPath[i]" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF CanWriteHere() THEN RETURN cur" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Cv_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR right AS Integer" + NL
    t = t + "    IF busy THEN RETURN" + NL
    t = t + "    EndRename(TRUE)" + NL
    t = t + "    keys.Focus()" + NL
    t = t + "    downX = x" + NL
    t = t + "    downY = y" + NL
    t = t + "    downButton = button" + NL
    t = t + "    mode = """"" + NL
    t = t + "    ' the splitter" + NL
    t = t + "    IF showTree AND x >= treeW AND x < treeW + SPLITW THEN" + NL
    t = t + "        mode = ""split""" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' the tree" + NL
    t = t + "    IF showTree AND x < treeW THEN" + NL
    t = t + "        focusTree = TRUE" + NL
    t = t + "        right = treeW - 2" + NL
    t = t + "        IF TreeNeedsBar() AND x >= right - SBW AND y > HEADH THEN" + NL
    t = t + "            ScrollBarClick(""tree"", y)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        i = NodeAt(x, y)" + NL
    t = t + "        IF i < 0 THEN" + NL
    t = t + "            DrawTree()" + NL
    t = t + "            DrawList()" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        IF OnBox(i, x) THEN" + NL
    t = t + "            Act(""!toggle "" + Str(i))" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        IF button = 2 THEN" + NL
    t = t + "            NodeMenu(i, x, y)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        ' a second click on the same node: open or close it" + NL
    t = t + "        IF clickNode = i AND SYS.Ticks - clickAt < 450 THEN" + NL
    t = t + "            clickNode = -1" + NL
    t = t + "            Act(""!toggle "" + Str(i))" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        clickNode = i" + NL
    t = t + "        clickAt = SYS.Ticks" + NL
    t = t + "        IF tPath[i] <> cur THEN" + NL
    t = t + "            Act(""!go "" + tPath[i])" + NL
    t = t + "        ELSE" + NL
    t = t + "            DrawTree()" + NL
    t = t + "            DrawList()" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' the files" + NL
    t = t + "    IF focusTree THEN" + NL
    t = t + "        focusTree = FALSE" + NL
    t = t + "        DrawTree()" + NL
    t = t + "    END IF" + NL
    t = t + "    IF viewMode <> ""list"" AND extentH > AreaHFull() AND x >= AreaX() + AreaW() AND y >= AreaY() THEN" + NL
    t = t + "        ScrollBarClick(""list"", y)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF viewMode = ""list"" AND extentW > cv.Width - ListLeftX() - 4 AND y >= AreaY() + AreaH() THEN" + NL
    t = t + "        ScrollBarClick(""hlist"", x)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF viewMode = ""details"" AND y >= HEADH + 2 AND y < HEADH + 2 + ROWH THEN" + NL
    t = t + "        ColumnClick(x)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    i = ItemAt(x, y)" + NL
    t = t + "    IF i < 0 THEN" + NL
    t = t + "        IF button = 2 THEN" + NL
    t = t + "            SelectOnly(-1)" + NL
    t = t + "            BackgroundMenu(x, y)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        SelectOnly(-1)" + NL
    t = t + "        mode = ""band""" + NL
    t = t + "        bandX = x" + NL
    t = t + "        bandY = y" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT cSel[i] THEN SelectOnly(i)" + NL
    t = t + "    cFocus = i" + NL
    t = t + "    cAnchor = i" + NL
    t = t + "    IF button = 2 THEN" + NL
    t = t + "        ItemMenu(x, y)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF clickItem = i AND SYS.Ticks - clickAt < 450 THEN" + NL
    t = t + "        clickItem = -1" + NL
    t = t + "        Act(""Open"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    clickItem = i" + NL
    t = t + "    clickAt = SYS.Ticks" + NL
    t = t + "    mode = ""press""" + NL
    t = t + "    downItem = i" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Cv_OnMouseMove (x AS Integer, y AS Integer)" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF busy OR mode = """" THEN RETURN" + NL
    t = t + "    SELECT CASE mode" + NL
    t = t + "        CASE ""split""" + NL
    t = t + "            treeW = MATH.Max(80, MATH.Min(cv.Width - 120, x))" + NL
    t = t + "            IF SYS.Ticks - lastPaint > 60 THEN" + NL
    t = t + "                LayoutList()" + NL
    t = t + "                Redraw()" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""press""" + NL
    t = t + "            IF MATH.Abs(x - downX) + MATH.Abs(y - downY) > 5 AND CanCopySel() THEN" + NL
    t = t + "                mode = ""drag""" + NL
    t = t + "                win.Status = ""Drag to a folder: a move on the same disk, a copy to another""" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""drag""" + NL
    t = t + "            t = DropAt(x, y)" + NL
    t = t + "            IF t <> dropTarget THEN" + NL
    t = t + "                dropTarget = t" + NL
    t = t + "                IF showTree THEN DrawTree()" + NL
    t = t + "                DrawList()" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""band""" + NL
    t = t + "            bandX = x" + NL
    t = t + "            bandY = y" + NL
    t = t + "            BandSelect()" + NL
    t = t + "            RepaintSoon(FALSE)" + NL
    t = t + "        CASE ""tthumb"", ""lthumb"", ""hthumb""" + NL
    t = t + "            DragThumb(x, y)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Cv_OnMouseUp (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    VAR was AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    was = mode" + NL
    t = t + "    mode = """"" + NL
    t = t + "    IF busy THEN RETURN" + NL
    t = t + "    SELECT CASE was" + NL
    t = t + "        CASE ""split""" + NL
    t = t + "            LayoutList()" + NL
    t = t + "            Redraw()" + NL
    t = t + "            SaveSettings()" + NL
    t = t + "        CASE ""press""" + NL
    t = t + "            ' a click on one of several picked: just that one" + NL
    t = t + "            IF SelCount() > 1 AND downItem >= 0 THEN SelectOnly(downItem)" + NL
    t = t + "        CASE ""drag""" + NL
    t = t + "            t = dropTarget" + NL
    t = t + "            dropTarget = """"" + NL
    t = t + "            Redraw()" + NL
    t = t + "            ShowStatus()" + NL
    t = t + "            IF t = """" THEN RETURN" + NL
    t = t + "            IF downButton = 2 THEN" + NL
    t = t + "                DropMenu(t, x, y)" + NL
    t = t + "            ELSE" + NL
    t = t + "                Act(""!drop "" + t)" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""band""" + NL
    t = t + "            DrawList()" + NL
    t = t + "            ShowStatus()" + NL
    t = t + "            UpdateMenus()" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Runs a command as the menus do (busy, errors shown), from the mouse or keys" + NL
    t = t + "SUB Act (command AS String)" + NL
    t = t + "    Menu_OnSelect(command)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SelectOnly (i AS Integer)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    FOR k = 0 TO cSel.Count - 1" + NL
    t = t + "        cSel[k] = k = i" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        cFocus = i" + NL
    t = t + "        cAnchor = i" + NL
    t = t + "    END IF" + NL
    t = t + "    DrawList()" + NL
    t = t + "    ShowStatus()" + NL
    t = t + "    UpdateMenus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB BandSelect ()" + NL
    t = t + "    VAR x1 AS Integer" + NL
    t = t + "    VAR y1 AS Integer" + NL
    t = t + "    VAR x2 AS Integer" + NL
    t = t + "    VAR y2 AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR ix AS Integer" + NL
    t = t + "    VAR iy AS Integer" + NL
    t = t + "    x1 = MATH.Min(downX, bandX) - AreaX() + listLeft" + NL
    t = t + "    y1 = MATH.Min(downY, bandY) - AreaY() + listTop" + NL
    t = t + "    x2 = MATH.Max(downX, bandX) - AreaX() + listLeft" + NL
    t = t + "    y2 = MATH.Max(downY, bandY) - AreaY() + listTop" + NL
    t = t + "    FOR i = 0 TO cName.Count - 1" + NL
    t = t + "        ix = itX[i]" + NL
    t = t + "        iy = itY[i]" + NL
    t = t + "        IF viewMode = ""large"" THEN ix = itX[i] + 30" + NL
    t = t + "        cSel[i] = ix < x2 AND ix + MATH.Min(itW[i], 22 + ShownName(i).Length * 8) > x1 AND iy < y2 AND iy + itH[i] > y1" + NL
    t = t + "        IF viewMode = ""large"" THEN cSel[i] = itX[i] + 30 < x2 AND itX[i] + 70 > x1 AND iy < y2 AND iy + 40 > y1" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ScrollBarClick (which AS String, at AS Integer)" + NL
    t = t + "    VAR top AS Integer" + NL
    t = t + "    VAR span AS Integer" + NL
    t = t + "    VAR thumb AS Integer" + NL
    t = t + "    VAR thumbAt AS Integer" + NL
    t = t + "    VAR total AS Integer" + NL
    t = t + "    VAR seen AS Integer" + NL
    t = t + "    VAR pos AS Integer" + NL
    t = t + "    VAR stepSize AS Integer" + NL
    t = t + "    IF which = ""tree"" THEN" + NL
    t = t + "        top = HEADH + 2" + NL
    t = t + "        span = TreeInnerH()" + NL
    t = t + "        total = tPath.Count * ROWH + 4" + NL
    t = t + "        seen = span" + NL
    t = t + "        pos = treeTop" + NL
    t = t + "        stepSize = ROWH" + NL
    t = t + "    ELSEIF which = ""list"" THEN" + NL
    t = t + "        top = AreaY()" + NL
    t = t + "        span = AreaH()" + NL
    t = t + "        total = extentH" + NL
    t = t + "        seen = span" + NL
    t = t + "        pos = listTop" + NL
    t = t + "        stepSize = ROWH" + NL
    t = t + "        IF viewMode = ""large"" THEN stepSize = 35" + NL
    t = t + "    ELSE" + NL
    t = t + "        top = AreaX()" + NL
    t = t + "        span = AreaW()" + NL
    t = t + "        total = extentW" + NL
    t = t + "        seen = span" + NL
    t = t + "        pos = listLeft" + NL
    t = t + "        stepSize = 60" + NL
    t = t + "    END IF" + NL
    t = t + "    thumb = MATH.Max(8, Int((span - 2 * SBW) * seen / MATH.Max(1, total)))" + NL
    t = t + "    thumbAt = top + SBW + Int((span - 2 * SBW - thumb) * pos / MATH.Max(1, total - seen))" + NL
    t = t + "    IF at < top + SBW THEN" + NL
    t = t + "        pos = pos - stepSize" + NL
    t = t + "    ELSEIF at >= top + span - SBW THEN" + NL
    t = t + "        pos = pos + stepSize" + NL
    t = t + "    ELSEIF at < thumbAt THEN" + NL
    t = t + "        pos = pos - seen + stepSize" + NL
    t = t + "    ELSEIF at >= thumbAt + thumb THEN" + NL
    t = t + "        pos = pos + seen - stepSize" + NL
    t = t + "    ELSE" + NL
    t = t + "        ' on the thumb: drag it" + NL
    t = t + "        grabOffset = at - thumbAt" + NL
    t = t + "        IF which = ""tree"" THEN mode = ""tthumb""" + NL
    t = t + "        IF which = ""list"" THEN mode = ""lthumb""" + NL
    t = t + "        IF which = ""hlist"" THEN mode = ""hthumb""" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    SetScroll(which, pos)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SetScroll (which AS String, pos AS Integer)" + NL
    t = t + "    IF which = ""tree"" THEN" + NL
    t = t + "        treeTop = pos" + NL
    t = t + "        ClampScroll()" + NL
    t = t + "        DrawTree()" + NL
    t = t + "    ELSEIF which = ""list"" THEN" + NL
    t = t + "        listTop = pos" + NL
    t = t + "        ClampScroll()" + NL
    t = t + "        DrawList()" + NL
    t = t + "    ELSE" + NL
    t = t + "        listLeft = pos" + NL
    t = t + "        ClampScroll()" + NL
    t = t + "        DrawList()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DragThumb (x AS Integer, y AS Integer)" + NL
    t = t + "    VAR top AS Integer" + NL
    t = t + "    VAR span AS Integer" + NL
    t = t + "    VAR total AS Integer" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR thumb AS Integer" + NL
    t = t + "    VAR which AS String" + NL
    t = t + "    IF SYS.Ticks - lastPaint < 40 THEN RETURN" + NL
    t = t + "    IF mode = ""tthumb"" THEN" + NL
    t = t + "        which = ""tree""" + NL
    t = t + "        top = HEADH + 2" + NL
    t = t + "        span = TreeInnerH()" + NL
    t = t + "        total = tPath.Count * ROWH + 4" + NL
    t = t + "        at = y" + NL
    t = t + "    ELSEIF mode = ""lthumb"" THEN" + NL
    t = t + "        which = ""list""" + NL
    t = t + "        top = AreaY()" + NL
    t = t + "        span = AreaH()" + NL
    t = t + "        total = extentH" + NL
    t = t + "        at = y" + NL
    t = t + "    ELSE" + NL
    t = t + "        which = ""hlist""" + NL
    t = t + "        top = AreaX()" + NL
    t = t + "        span = AreaW()" + NL
    t = t + "        total = extentW" + NL
    t = t + "        at = x" + NL
    t = t + "    END IF" + NL
    t = t + "    thumb = MATH.Max(8, Int((span - 2 * SBW) * span / MATH.Max(1, total)))" + NL
    t = t + "    SetScroll(which, Int((at - grabOffset - top - SBW) * (total - span) / MATH.Max(1, span - 2 * SBW - thumb)))" + NL
    t = t + "    lastPaint = SYS.Ticks" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ColumnClick (x AS Integer)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR cx AS Integer" + NL
    t = t + "    cx = AreaX() - listLeft" + NL
    t = t + "    FOR k = 0 TO colW.Count - 1" + NL
    t = t + "        IF x >= cx AND x < cx + colW[k] THEN" + NL
    t = t + "            IF k = 0 THEN Act(""Arrange by Name"")" + NL
    t = t + "            IF k = 1 THEN Act(""Arrange by Size"")" + NL
    t = t + "            IF k = 2 THEN Act(""Arrange by Type"")" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        cx = cx + colW[k]" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Makes sure item i (or tree node i) can be seen" + NL
    t = t + "SUB ScrollToItem (i AS Integer)" + NL
    t = t + "    IF i < 0 OR i >= cName.Count THEN RETURN" + NL
    t = t + "    IF viewMode = ""list"" THEN" + NL
    t = t + "        IF itX[i] < listLeft THEN listLeft = itX[i]" + NL
    t = t + "        IF itX[i] + itW[i] > listLeft + AreaW() THEN listLeft = itX[i] + itW[i] - AreaW()" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF itY[i] < listTop THEN listTop = itY[i]" + NL
    t = t + "        IF itY[i] + itH[i] > listTop + AreaH() THEN listTop = itY[i] + itH[i] - AreaH()" + NL
    t = t + "    END IF" + NL
    t = t + "    ClampScroll()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ScrollTreeTo (i AS Integer)" + NL
    t = t + "    IF i < 0 OR IsNothing(cv) THEN RETURN" + NL
    t = t + "    IF i * ROWH < treeTop THEN treeTop = i * ROWH" + NL
    t = t + "    IF (i + 1) * ROWH + 4 > treeTop + TreeInnerH() THEN treeTop = (i + 1) * ROWH + 4 - TreeInnerH()" + NL
    t = t + "    ClampScroll()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ keys" + NL
    t = t + "" + NL
    t = t + "SUB Keys_OnKey (key AS String)" + NL
    t = t + "    IF busy THEN RETURN" + NL
    t = t + "    SELECT CASE key" + NL
    t = t + "        CASE ""Ctrl+C""" + NL
    t = t + "            Act(""Copy"")" + NL
    t = t + "        CASE ""Ctrl+X""" + NL
    t = t + "            Act(""Cut"")" + NL
    t = t + "        CASE ""Ctrl+V""" + NL
    t = t + "            Act(""Paste"")" + NL
    t = t + "        CASE ""Ctrl+Z""" + NL
    t = t + "            Act(""Undo"")" + NL
    t = t + "        CASE ""Ctrl+A""" + NL
    t = t + "            Act(""Select All"")" + NL
    t = t + "        CASE ""Ctrl+G""" + NL
    t = t + "            Act(""Go to..."")" + NL
    t = t + "        CASE ""F3"", ""Ctrl+F""" + NL
    t = t + "            Act(""Find..."")" + NL
    t = t + "        CASE ""F5""" + NL
    t = t + "            Act(""Refresh"")" + NL
    t = t + "        CASE ""Alt+ArrowLeft""" + NL
    t = t + "            Act(""Back"")" + NL
    t = t + "        CASE ""Alt+ArrowRight""" + NL
    t = t + "            Act(""Forward"")" + NL
    t = t + "        CASE ""Backspace""" + NL
    t = t + "            Act(""Up One Level"")" + NL
    t = t + "        CASE ""Alt+Enter""" + NL
    t = t + "            Act(""Properties"")" + NL
    t = t + "        CASE ""Tab"", ""Shift+Tab"", ""F6""" + NL
    t = t + "            IF showTree THEN" + NL
    t = t + "                focusTree = NOT focusTree" + NL
    t = t + "                Redraw()" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""F4""" + NL
    t = t + "            IF showAddress THEN addr.Focus()" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            IF focusTree THEN" + NL
    t = t + "                TreeKey(key)" + NL
    t = t + "            ELSE" + NL
    t = t + "                ListKey(key)" + NL
    t = t + "            END IF" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB TreeKey (key AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = tPath.IndexOf(cur)" + NL
    t = t + "    SELECT CASE key" + NL
    t = t + "        CASE ""ArrowUp""" + NL
    t = t + "            IF i > 0 THEN Act(""!go "" + tPath[i - 1])" + NL
    t = t + "        CASE ""ArrowDown""" + NL
    t = t + "            IF i < tPath.Count - 1 THEN Act(""!go "" + tPath[i + 1])" + NL
    t = t + "        CASE ""ArrowRight"", ""+""" + NL
    t = t + "            IF i >= 0 THEN" + NL
    t = t + "                IF NOT tOpen[i] AND tKids[i] <> 0 THEN" + NL
    t = t + "                    Act(""!toggle "" + Str(i))" + NL
    t = t + "                ELSEIF i < tPath.Count - 1 AND tOpen[i] THEN" + NL
    t = t + "                    Act(""!go "" + tPath[i + 1])" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""ArrowLeft"", ""-""" + NL
    t = t + "            IF i >= 0 THEN" + NL
    t = t + "                IF tOpen[i] THEN" + NL
    t = t + "                    Act(""!toggle "" + Str(i))" + NL
    t = t + "                ELSEIF ParentOf(cur) <> """" THEN" + NL
    t = t + "                    Act(""!go "" + ParentOf(cur))" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Enter""" + NL
    t = t + "            IF i >= 0 THEN Act(""!toggle "" + Str(i))" + NL
    t = t + "        CASE ""Delete""" + NL
    t = t + "            Act(""!deletefolder"")" + NL
    t = t + "        CASE ""F2""" + NL
    t = t + "            Act(""!renamefolder"")" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ListKey (key AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR shift AS Bool" + NL
    t = t + "    VAR k AS String" + NL
    t = t + "    n = cName.Count" + NL
    t = t + "    shift = key.StartsWith(""Shift+"")" + NL
    t = t + "    k = key" + NL
    t = t + "    IF shift THEN k = key.Substring(6, key.Length - 6)" + NL
    t = t + "    SELECT CASE k" + NL
    t = t + "        CASE ""Enter""" + NL
    t = t + "            Act(""Open"")" + NL
    t = t + "            RETURN" + NL
    t = t + "        CASE ""Delete""" + NL
    t = t + "            IF shift THEN" + NL
    t = t + "                Act(""!delete-for-good"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                Act(""Delete"")" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN" + NL
    t = t + "        CASE ""F2""" + NL
    t = t + "            Act(""Rename"")" + NL
    t = t + "            RETURN" + NL
    t = t + "        CASE ""Home""" + NL
    t = t + "            i = 0" + NL
    t = t + "        CASE ""End""" + NL
    t = t + "            i = n - 1" + NL
    t = t + "        CASE ""ArrowUp"", ""ArrowDown"", ""ArrowLeft"", ""ArrowRight"", ""PageUp"", ""PageDown""" + NL
    t = t + "            i = Neighbour(cFocus, k)" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            ' a letter: the next item starting with it" + NL
    t = t + "            IF key.Length = 1 THEN" + NL
    t = t + "                i = NextStarting(key.Upper())" + NL
    t = t + "            ELSE" + NL
    t = t + "                RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF n = 0 OR i < 0 THEN RETURN" + NL
    t = t + "    i = MATH.Max(0, MATH.Min(n - 1, i))" + NL
    t = t + "    IF shift AND cAnchor >= 0 THEN" + NL
    t = t + "        SelectRange(cAnchor, i)" + NL
    t = t + "        cFocus = i" + NL
    t = t + "    ELSE" + NL
    t = t + "        cFocus = i" + NL
    t = t + "        cAnchor = i" + NL
    t = t + "        FOR n = 0 TO cSel.Count - 1" + NL
    t = t + "            cSel[n] = n = i" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    ScrollToItem(i)" + NL
    t = t + "    DrawList()" + NL
    t = t + "    ShowStatus()" + NL
    t = t + "    UpdateMenus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SelectRange (a AS Integer, b AS Integer)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    FOR k = 0 TO cSel.Count - 1" + NL
    t = t + "        cSel[k] = k >= MATH.Min(a, b) AND k <= MATH.Max(a, b)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The item next to i, the way a key goes in this view" + NL
    t = t + "FUNCTION Neighbour (i AS Integer, k AS String) AS Integer" + NL
    t = t + "    VAR best AS Integer" + NL
    t = t + "    VAR bestD AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR dx AS Integer" + NL
    t = t + "    VAR dy AS Integer" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    VAR pageRows AS Integer" + NL
    t = t + "    IF i < 0 THEN RETURN 0" + NL
    t = t + "    pageRows = MATH.Max(1, Int(AreaH() / ROWH) - 1)" + NL
    t = t + "    IF k = ""PageUp"" OR k = ""PageDown"" THEN" + NL
    t = t + "        IF viewMode = ""details"" OR viewMode = ""list"" THEN" + NL
    t = t + "            IF k = ""PageUp"" THEN RETURN i - pageRows" + NL
    t = t + "            RETURN i + pageRows" + NL
    t = t + "        END IF" + NL
    t = t + "        IF k = ""PageUp"" THEN k = ""ArrowUp""" + NL
    t = t + "        IF k = ""PageDown"" THEN k = ""ArrowDown""" + NL
    t = t + "    END IF" + NL
    t = t + "    best = i" + NL
    t = t + "    bestD = 999999" + NL
    t = t + "    FOR j = 0 TO cName.Count - 1" + NL
    t = t + "        IF j = i THEN CONTINUE" + NL
    t = t + "        dx = itX[j] - itX[i]" + NL
    t = t + "        dy = itY[j] - itY[i]" + NL
    t = t + "        d = -1" + NL
    t = t + "        SELECT CASE k" + NL
    t = t + "            CASE ""ArrowUp""" + NL
    t = t + "                IF dy < 0 THEN d = -dy * 4 + MATH.Abs(dx)" + NL
    t = t + "            CASE ""ArrowDown""" + NL
    t = t + "                IF dy > 0 THEN d = dy * 4 + MATH.Abs(dx)" + NL
    t = t + "            CASE ""ArrowLeft""" + NL
    t = t + "                IF dx < 0 THEN d = -dx * 4 + MATH.Abs(dy)" + NL
    t = t + "                IF dx = 0 AND dy < 0 AND viewMode = ""details"" THEN d = -dy" + NL
    t = t + "            CASE ""ArrowRight""" + NL
    t = t + "                IF dx > 0 THEN d = dx * 4 + MATH.Abs(dy)" + NL
    t = t + "                IF dx = 0 AND dy > 0 AND viewMode = ""details"" THEN d = dy" + NL
    t = t + "        END SELECT" + NL
    t = t + "        IF d >= 0 AND d < bestD THEN" + NL
    t = t + "            bestD = d" + NL
    t = t + "            best = j" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN best" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NextStarting (ch AS String) AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    FOR k = 1 TO cName.Count" + NL
    t = t + "        j = (MATH.Max(cFocus, -1) + k) MOD MATH.Max(1, cName.Count)" + NL
    t = t + "        IF j >= 0 AND j < cName.Count THEN" + NL
    t = t + "            IF ShownName(j).Upper().StartsWith(ch) THEN RETURN j" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN -1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ typing a new name" + NL
    t = t + "" + NL
    t = t + "SUB StartRename (i AS Integer)" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    IF i < 0 OR i >= cName.Count THEN RETURN" + NL
    t = t + "    ScrollToItem(i)" + NL
    t = t + "    DrawList()" + NL
    t = t + "    x = AreaX() + itX[i] - listLeft" + NL
    t = t + "    y = AreaY() + itY[i] - listTop" + NL
    t = t + "    IF viewMode = ""large"" THEN" + NL
    t = t + "        x = x + 2" + NL
    t = t + "        y = y + 34" + NL
    t = t + "        ren.SetBounds(cv.X + x, cv.Y + y, itW[i] - 4, 21)" + NL
    t = t + "    ELSE" + NL
    t = t + "        ren.SetBounds(cv.X + x + 20, cv.Y + y - 1, MATH.Max(110, MATH.Min(itW[i], 140)), 21)" + NL
    t = t + "    END IF" + NL
    t = t + "    ren.Tag = cPath[i]" + NL
    t = t + "    ren.Text = cName[i]" + NL
    t = t + "    ren.Visible = TRUE" + NL
    t = t + "    ren.Focus()" + NL
    t = t + "    ren.SelectAll()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Ren_OnEnter ()" + NL
    t = t + "    EndRename(TRUE)" + NL
    t = t + "    keys.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Ren_OnKey (key AS String)" + NL
    t = t + "    IF key = ""Escape"" THEN" + NL
    t = t + "        EndRename(FALSE)" + NL
    t = t + "        keys.Focus()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Takes the name typed (or not), and puts the box away." + NL
    t = t + "SUB EndRename (keep AS Bool)" + NL
    t = t + "    VAR from AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    IF IsNothing(ren) THEN RETURN" + NL
    t = t + "    IF NOT ren.Visible THEN RETURN" + NL
    t = t + "    ren.Visible = FALSE" + NL
    t = t + "    from = ren.Tag" + NL
    t = t + "    name = ren.Text.Trim().Upper()" + NL
    t = t + "    IF NOT keep OR name = """" OR name = BaseName(from) THEN RETURN" + NL
    t = t + "    Act(""!rename "" + from + ""|"" + name)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ commands" + NL
    t = t + "'" + NL
    t = t + "' Every menu item, toolbar button, key and click comes here, as the menu" + NL
    t = t + "' item's text, or as one of Explorer's own: ""!go path"", ""!toggle n""," + NL
    t = t + "' ""!rename path|NEWNAME"", ""!drop folder"", ""!copyto folder"", ""!moveto folder""," + NL
    t = t + "' ""!deletefolder"", ""!renamefolder"", ""!delete-for-good"", ""!disconnect Z""." + NL
    t = t + "' Menu_OnSelect runs it busy, and shows any error." + NL
    t = t + "" + NL
    t = t + "SUB DoCommand (item AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR one AS Integer" + NL
    t = t + "    one = FirstSel()" + NL
    t = t + "    IF item.StartsWith(""!go "") THEN" + NL
    t = t + "        Go(item.Substring(4, item.Length - 4))" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF item.StartsWith(""!toggle "") THEN" + NL
    t = t + "        ToggleNode(Int(Val(item.Substring(8, item.Length - 8))))" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF item.StartsWith(""!rename "") THEN" + NL
    t = t + "        RenameTo(item.Substring(8, item.IndexOf(""|"") - 8), item.Substring(item.IndexOf(""|"") + 1, item.Length - item.IndexOf(""|"") - 1))" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF item.StartsWith(""!drop "") THEN" + NL
    t = t + "        DropOn(item.Substring(6, item.Length - 6), """")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF item.StartsWith(""!copyto "") THEN" + NL
    t = t + "        DropOn(item.Substring(8, item.Length - 8), ""copy"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF item.StartsWith(""!moveto "") THEN" + NL
    t = t + "        DropOn(item.Substring(8, item.Length - 8), ""move"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF item.StartsWith(""!disconnect "") THEN" + NL
    t = t + "        Disconnect(item.Substring(12, 1))" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF item.StartsWith(""!map "") THEN" + NL
    t = t + "        MapDrive(item.Substring(5, item.Length - 5))" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE item" + NL
    t = t + "        CASE ""Paste Into Folder""" + NL
    t = t + "            IF one >= 0 THEN PasteInto(cPath[one])" + NL
    t = t + "        CASE ""Disconnect""" + NL
    t = t + "            IF one >= 0 AND KindOf(one) = ""NETDRIVE"" THEN" + NL
    t = t + "                Disconnect(cPath[one].Substring(0, 1))" + NL
    t = t + "            ELSEIF IsMapped(cur) THEN" + NL
    t = t + "                Disconnect(cur.Substring(0, 1))" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Expand"", ""Collapse""" + NL
    t = t + "            ToggleNode(tPath.IndexOf(cur))" + NL
    t = t + "        CASE ""Open in New Window""" + NL
    t = t + "            SYS.Start(ME, ""/e "" + cur)" + NL
    t = t + "        CASE ""Delete Folder""" + NL
    t = t + "            DoCommand(""!deletefolder"")" + NL
    t = t + "        CASE ""Rename Folder""" + NL
    t = t + "            DoCommand(""!renamefolder"")" + NL
    t = t + "        CASE ""Move Here""" + NL
    t = t + "            DropOn(ctx.Tag, ""move"")" + NL
    t = t + "        CASE ""Copy Here""" + NL
    t = t + "            DropOn(ctx.Tag, ""copy"")" + NL
    t = t + "        CASE ""Open""" + NL
    t = t + "            IF one < 0 THEN RETURN" + NL
    t = t + "            IF IsFolderish(one) THEN" + NL
    t = t + "                Go(cPath[one])" + NL
    t = t + "            ELSEIF cKind[one] = ""APP"" THEN" + NL
    t = t + "                SYS.Start(cPath[one], """")" + NL
    t = t + "            ELSEIF cur = ""::RECYCLE"" THEN" + NL
    t = t + "                Properties()" + NL
    t = t + "            ELSE" + NL
    t = t + "                FOR i = 0 TO cName.Count - 1" + NL
    t = t + "                    IF cSel[i] AND cKind[i] = ""F"" THEN OpenFile(cPath[i], FALSE)" + NL
    t = t + "                NEXT" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Explore""" + NL
    t = t + "            IF one >= 0 THEN" + NL
    t = t + "                IF IsFolderish(one) THEN SYS.Start(ME, ""/e "" + cPath[one])" + NL
    t = t + "            ELSE" + NL
    t = t + "                SYS.Start(ME, ""/e "" + cur)" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Edit""" + NL
    t = t + "            IF one >= 0 THEN OpenFile(cPath[one], TRUE)" + NL
    t = t + "        CASE ""New Folder""" + NL
    t = t + "            NewThing(TRUE)" + NL
    t = t + "        CASE ""New Text Document""" + NL
    t = t + "            NewThing(FALSE)" + NL
    t = t + "        CASE ""Delete""" + NL
    t = t + "            IF AllKind(""NETDRIVE"") THEN" + NL
    t = t + "                FOR i = 0 TO cName.Count - 1" + NL
    t = t + "                    IF cSel[i] THEN Disconnect(cPath[i].Substring(0, 1))" + NL
    t = t + "                NEXT" + NL
    t = t + "            ELSE" + NL
    t = t + "                DeleteSelected(cur = ""::RECYCLE"")" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""!delete-for-good""" + NL
    t = t + "            DeleteSelected(TRUE)" + NL
    t = t + "        CASE ""Rename""" + NL
    t = t + "            IF one >= 0 AND (cKind[one] = ""F"" OR cKind[one] = ""D"") THEN StartRename(one)" + NL
    t = t + "        CASE ""!renamefolder""" + NL
    t = t + "            IF NOT IsVirtual(cur) AND NOT IsRoot(cur) THEN" + NL
    t = t + "                IF Prompt(""Rename"", ""New name for "" + PlaceLabel(cur) + "":"", BaseName(cur)) THEN RenameTo(cur, promptAnswer.Trim().Upper())" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""!deletefolder""" + NL
    t = t + "            IF NOT IsVirtual(cur) AND NOT IsRoot(cur) THEN DeletePaths(StrList(cur), FALSE)" + NL
    t = t + "        CASE ""Properties""" + NL
    t = t + "            Properties()" + NL
    t = t + "        CASE ""Restore""" + NL
    t = t + "            Restore()" + NL
    t = t + "        CASE ""Empty Recycle Bin""" + NL
    t = t + "            EmptyBin()" + NL
    t = t + "        CASE ""Close""" + NL
    t = t + "            win.Close()" + NL
    t = t + "        CASE ""Undo""" + NL
    t = t + "            Undo()" + NL
    t = t + "        CASE ""Cut""" + NL
    t = t + "            ToClipboard(""cut"")" + NL
    t = t + "        CASE ""Copy""" + NL
    t = t + "            ToClipboard(""copy"")" + NL
    t = t + "        CASE ""Paste""" + NL
    t = t + "            Paste()" + NL
    t = t + "        CASE ""Select All""" + NL
    t = t + "            FOR i = 0 TO cSel.Count - 1" + NL
    t = t + "                cSel[i] = TRUE" + NL
    t = t + "            NEXT" + NL
    t = t + "            DrawList()" + NL
    t = t + "            ShowStatus()" + NL
    t = t + "        CASE ""Invert Selection""" + NL
    t = t + "            FOR i = 0 TO cSel.Count - 1" + NL
    t = t + "                cSel[i] = NOT cSel[i]" + NL
    t = t + "            NEXT" + NL
    t = t + "            DrawList()" + NL
    t = t + "            ShowStatus()" + NL
    t = t + "        CASE ""Toolbar""" + NL
    t = t + "            showToolbar = NOT showToolbar" + NL
    t = t + "            ChangedView()" + NL
    t = t + "        CASE ""Address Bar""" + NL
    t = t + "            showAddress = NOT showAddress" + NL
    t = t + "            ChangedView()" + NL
    t = t + "        CASE ""Status Bar""" + NL
    t = t + "            statusOn = NOT statusOn" + NL
    t = t + "            ChangedView()" + NL
    t = t + "        CASE ""Folders""" + NL
    t = t + "            showTree = NOT showTree" + NL
    t = t + "            ChangedView()" + NL
    t = t + "        CASE ""Large Icons""" + NL
    t = t + "            SetView(""large"")" + NL
    t = t + "        CASE ""Small Icons""" + NL
    t = t + "            SetView(""small"")" + NL
    t = t + "        CASE ""List""" + NL
    t = t + "            SetView(""list"")" + NL
    t = t + "        CASE ""Details""" + NL
    t = t + "            SetView(""details"")" + NL
    t = t + "        CASE ""Arrange by Name""" + NL
    t = t + "            sortBy = ""name""" + NL
    t = t + "            Refresh(TRUE)" + NL
    t = t + "            SaveSettings()" + NL
    t = t + "        CASE ""Arrange by Type""" + NL
    t = t + "            sortBy = ""type""" + NL
    t = t + "            Refresh(TRUE)" + NL
    t = t + "            SaveSettings()" + NL
    t = t + "        CASE ""Arrange by Size""" + NL
    t = t + "            sortBy = ""size""" + NL
    t = t + "            Refresh(TRUE)" + NL
    t = t + "            SaveSettings()" + NL
    t = t + "        CASE ""Refresh""" + NL
    t = t + "            IF cur = ""::NETWORK"" OR expanded.Contains(""|::NETWORK|"") THEN Machines(TRUE)" + NL
    t = t + "            noKids = """"" + NL
    t = t + "            Refresh(TRUE)" + NL
    t = t + "        CASE ""Options...""" + NL
    t = t + "            Options()" + NL
    t = t + "        CASE ""Back""" + NL
    t = t + "            Travel(hi - 1)" + NL
    t = t + "        CASE ""Forward""" + NL
    t = t + "            Travel(hi + 1)" + NL
    t = t + "        CASE ""Up One Level""" + NL
    t = t + "            IF ParentOf(cur) <> """" THEN Go(ParentOf(cur))" + NL
    t = t + "        CASE ""My Computer""" + NL
    t = t + "            Go(""::COMPUTER"")" + NL
    t = t + "        CASE ""My Files""" + NL
    t = t + "            Go(""C:\MYFILES"")" + NL
    t = t + "        CASE ""Network Neighborhood""" + NL
    t = t + "            Go(""::NETWORK"")" + NL
    t = t + "        CASE ""Recycle Bin""" + NL
    t = t + "            Go(""::RECYCLE"")" + NL
    t = t + "        CASE ""Find...""" + NL
    t = t + "            Find()" + NL
    t = t + "        CASE ""Map Network Drive...""" + NL
    t = t + "            MapDrive("""")" + NL
    t = t + "        CASE ""Disconnect Network Drive...""" + NL
    t = t + "            DisconnectDialog()" + NL
    t = t + "        CASE ""Go to...""" + NL
    t = t + "            IF Prompt(""Go To Folder"", ""Type the name of a folder, a drive (Z:) or a machine (\\BRAVO):"", AddressFor(cur)) THEN Go(promptAnswer)" + NL
    t = t + "        CASE ""About Explorer""" + NL
    t = t + "            Say(""Explorer"" + Chr(10) + Chr(10) + ""The folders in a tree, your files beside them, and every machine on the network in the same window. Map a machine's disk as a drive letter with Tools > Map Network Drive."" + Chr(10) + Chr(10) + ""Written in SPARK: C:\PROGRAMS\EXPLORER.SPK"", ""info"")" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION StrList (s AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    out.Add(s)" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SetView (v AS String)" + NL
    t = t + "    viewMode = v" + NL
    t = t + "    listTop = 0" + NL
    t = t + "    listLeft = 0" + NL
    t = t + "    LayoutList()" + NL
    t = t + "    DrawList()" + NL
    t = t + "    SaveSettings()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ChangedView ()" + NL
    t = t + "    Layout()" + NL
    t = t + "    LayoutList()" + NL
    t = t + "    Refresh(TRUE)" + NL
    t = t + "    DrawToolbar()" + NL
    t = t + "    SaveSettings()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ opening files" + NL
    t = t + "" + NL
    t = t + "' A file, by its kind: programs run, pictures open in Sketch, pages in" + NL
    t = t + "' Voyager, JavaScript in Node, the rest in Notes. edit: in an editor instead." + NL
    t = t + "' A file on another machine is copied here first (C:\SYSTEM\TEMP), and the" + NL
    t = t + "' clock sends it back whenever it's saved." + NL
    t = t + "SUB OpenFile (p AS String, edit AS Bool)" + NL
    t = t + "    VAR local AS String" + NL
    t = t + "    VAR ext AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    local = p" + NL
    t = t + "    IF IsRemote(p) THEN" + NL
    t = t + "        text = VRead(p)" + NL
    t = t + "        local = TEMPDIR + ""\"" + BaseName(p)" + NL
    t = t + "        FS.Write(local, text)" + NL
    t = t + "        k = wLocal.IndexOf(local)" + NL
    t = t + "        IF k < 0 THEN" + NL
    t = t + "            wLocal.Add(local)" + NL
    t = t + "            wRemote.Add(p)" + NL
    t = t + "            wText.Add(text)" + NL
    t = t + "        ELSE" + NL
    t = t + "            wRemote[k] = p" + NL
    t = t + "            wText[k] = text" + NL
    t = t + "        END IF" + NL
    t = t + "        win.Status = ""Opened a copy of "" + BaseName(p) + "" from \\"" + HostOf(p) + "": what you save goes back there.""" + NL
    t = t + "    END IF" + NL
    t = t + "    ext = ExtOf(local)" + NL
    t = t + "    IF edit THEN" + NL
    t = t + "        IF ext = ""SPK"" THEN" + NL
    t = t + "            SYS.Start(""C:\SYSTEM\SPARK.EXE"", local)" + NL
    t = t + "        ELSE" + NL
    t = t + "            SYS.Start(""C:\PROGRAMS\NOTES.SPK"", local)" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE ext" + NL
    t = t + "        CASE ""SPK"", ""EXE""" + NL
    t = t + "            SYS.Run(local)" + NL
    t = t + "        CASE ""PIC""" + NL
    t = t + "            SYS.Start(""C:\PROGRAMS\SKETCH.SPK"", local)" + NL
    t = t + "        CASE ""HTM"", ""HTML""" + NL
    t = t + "            SYS.Start(""C:\SYSTEM\VOYAGER.EXE"", ""file:"" + local)" + NL
    t = t + "        CASE ""JS""" + NL
    t = t + "            IF FS.Exists(""C:\PROGRAMS\NODE.SPK"") THEN" + NL
    t = t + "                SYS.Start(""C:\PROGRAMS\NODE.SPK"", ""--cwd="" + ParentOf(local) + "" "" + local)" + NL
    t = t + "            ELSE" + NL
    t = t + "                SYS.Start(""C:\PROGRAMS\NOTES.SPK"", local)" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""SH""" + NL
    t = t + "            IF FS.Exists(""C:\PROGRAMS\SIMSH.SPK"") THEN" + NL
    t = t + "                SYS.Start(""C:\PROGRAMS\SIMSH.SPK"", local)" + NL
    t = t + "            ELSE" + NL
    t = t + "                SYS.Start(""C:\PROGRAMS\NOTES.SPK"", local)" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""RUN""" + NL
    t = t + "            SYS.Start(""C:\PROGRAMS\NOTES.SPK"", local)" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            SYS.Start(""C:\PROGRAMS\NOTES.SPK"", local)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Every 2 seconds: copies of other machines' files that were saved go home." + NL
    t = t + "SUB Clock_OnTick ()" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    IF busy THEN RETURN" + NL
    t = t + "    ' (once: the first paint can come before SIM95's font has loaded)" + NL
    t = t + "    IF NOT repainted THEN" + NL
    t = t + "        repainted = TRUE" + NL
    t = t + "        Redraw()" + NL
    t = t + "        DrawToolbar()" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR k = 0 TO wLocal.Count - 1" + NL
    t = t + "        IF NOT FS.Exists(wLocal[k]) THEN CONTINUE" + NL
    t = t + "        text = FS.Read(wLocal[k])" + NL
    t = t + "        IF text = wText[k] THEN CONTINUE" + NL
    t = t + "        busy = TRUE" + NL
    t = t + "        TRY" + NL
    t = t + "            VWrite(wRemote[k], text)" + NL
    t = t + "            wText[k] = text" + NL
    t = t + "            IF ParentOf(wRemote[k]) = cur THEN Refresh(TRUE)" + NL
    t = t + "            win.Status = ""Saved "" + BaseName(wRemote[k]) + "" back to \\"" + HostOf(wRemote[k])" + NL
    t = t + "        CATCH err" + NL
    t = t + "            IF NOT err.StartsWith(""!cancel"") THEN win.Status = ""Could not save "" + BaseName(wRemote[k]) + "" back to \\"" + HostOf(wRemote[k]) + "": "" + err.Replace(Chr(10), "" "")" + NL
    t = t + "            wText[k] = text" + NL
    t = t + "        END TRY" + NL
    t = t + "        busy = FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ new, rename" + NL
    t = t + "" + NL
    t = t + "' A name like NAME in dir that isn't taken: NOTES.TXT, NOTES~1.TXT, NOTES~2.TXT..." + NL
    t = t + "FUNCTION FreeName (dir AS String, name AS String) AS String" + NL
    t = t + "    VAR base AS String" + NL
    t = t + "    VAR ext AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR cand AS String" + NL
    t = t + "    VAR taken AS String" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    taken = ""|""" + NL
    t = t + "    FOR EACH e IN VList(dir)" + NL
    t = t + "        taken = taken + e.Split(""|"")[0].Upper() + ""|""" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT taken.Contains(""|"" + name + ""|"") THEN RETURN name" + NL
    t = t + "    base = name" + NL
    t = t + "    ext = """"" + NL
    t = t + "    IF name.Contains(""."") THEN" + NL
    t = t + "        base = name.Substring(0, name.IndexOf("".""))" + NL
    t = t + "        ext = name.Substring(name.IndexOf("".""), name.Length - name.IndexOf("".""))" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR n = 1 TO 999" + NL
    t = t + "        cand = base.Substring(0, MATH.Min(base.Length, 7 - Str(n).Length)) + ""~"" + Str(n) + ext" + NL
    t = t + "        IF NOT taken.Contains(""|"" + cand + ""|"") THEN RETURN cand" + NL
    t = t + "    NEXT" + NL
    t = t + "    THROW ""There are too many files called "" + name + "" here.""" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB NewThing (folder AS Bool)" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF NOT CanWriteHere() THEN THROW ""You can't make anything here.""" + NL
    t = t + "    IF folder THEN" + NL
    t = t + "        name = FreeName(cur, ""NEWFOLDR"")" + NL
    t = t + "        p = JoinPath(cur, name)" + NL
    t = t + "        VMakeDir(p)" + NL
    t = t + "    ELSE" + NL
    t = t + "        name = FreeName(cur, ""NEWTEXT.TXT"")" + NL
    t = t + "        p = JoinPath(cur, name)" + NL
    t = t + "        VWrite(p, """")" + NL
    t = t + "    END IF" + NL
    t = t + "    SetUndo(""new"", StrList(p))" + NL
    t = t + "    noKids = noKids.Replace(""|"" + cur + ""|"", ""|"")" + NL
    t = t + "    Refresh(FALSE)" + NL
    t = t + "    i = cPath.IndexOf(p)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        SelectOnly(i)" + NL
    t = t + "        StartRename(i)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RenameTo (from AS String, name AS String)" + NL
    t = t + "    VAR target AS String" + NL
    t = t + "    IF NOT Valid83(name) THEN THROW ""A file name is 8.3: up to 8 letters, digits, - or _, then perhaps a dot and up to 3 more (NOTES.TXT).""" + NL
    t = t + "    target = JoinPath(ParentOf(from), name)" + NL
    t = t + "    IF target = from THEN RETURN" + NL
    t = t + "    IF VStat(target) <> """" THEN THROW ""Cannot rename "" + BaseName(from) + "": a file with the name you specified already exists. Specify a different filename.""" + NL
    t = t + "    VRename(from, target)" + NL
    t = t + "    SetUndo(""move"", StrList(from + ""|"" + target))" + NL
    t = t + "    IF cur = from OR cur.StartsWith(from + ""\"") THEN" + NL
    t = t + "        cur = target + cur.Substring(from.Length, cur.Length - from.Length)" + NL
    t = t + "        expanded = expanded.Replace(""|"" + from + ""|"", ""|"" + target + ""|"")" + NL
    t = t + "    END IF" + NL
    t = t + "    Refresh(FALSE)" + NL
    t = t + "    SelectPath(target)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SelectPath (p AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = cPath.IndexOf(p)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        SelectOnly(i)" + NL
    t = t + "        ScrollToItem(i)" + NL
    t = t + "        DrawList()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ copy, cut, paste, drop" + NL
    t = t + "" + NL
    t = t + "FUNCTION Picked () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO cName.Count - 1" + NL
    t = t + "        IF cSel[i] THEN out.Add(cPath[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The clipboard holds where things are, not the things: ""copy"" or ""cut""," + NL
    t = t + "' then a path a line (mapped drives as \\MACHINE\..., so any window knows them)." + NL
    t = t + "SUB ToClipboard (how AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    IF NOT CanCopySel() OR SelCount() = 0 THEN RETURN" + NL
    t = t + "    out.Add(how)" + NL
    t = t + "    FOR EACH p IN Picked()" + NL
    t = t + "        out.Add(ToUnc(p))" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Write(CLIPFILE, out.Join(Chr(10)))" + NL
    t = t + "    IF how = ""cut"" THEN" + NL
    t = t + "        ReadCutSet()" + NL
    t = t + "        win.Status = Str(out.Count - 1) + "" object(s) cut: Paste them into a folder to move them there""" + NL
    t = t + "    ELSE" + NL
    t = t + "        cutSet = ""|""" + NL
    t = t + "        win.Status = Str(out.Count - 1) + "" object(s) copied: Paste them into a folder, in any Explorer window""" + NL
    t = t + "    END IF" + NL
    t = t + "    DrawList()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Paste ()" + NL
    t = t + "    IF NOT CanWriteHere() THEN THROW ""You can't paste here.""" + NL
    t = t + "    PasteInto(cur)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB PasteInto (dst AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR srcs AS Array OF String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF NOT FS.Exists(CLIPFILE) THEN RETURN" + NL
    t = t + "    lines = FS.Read(CLIPFILE).Lines()" + NL
    t = t + "    IF lines.Count < 2 THEN RETURN" + NL
    t = t + "    FOR k = 1 TO lines.Count - 1" + NL
    t = t + "        IF lines[k] <> """" THEN srcs.Add(FromUnc(lines[k]))" + NL
    t = t + "    NEXT" + NL
    t = t + "    Transfer(srcs, dst, lines[0] = ""cut"")" + NL
    t = t + "    IF lines[0] = ""cut"" THEN FS.Delete(CLIPFILE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Dropped on a folder: moved on the same disk, copied to another, as Windows" + NL
    t = t + "' does it (""move"" or ""copy"" when chosen from the right-button menu). Onto the" + NL
    t = t + "' Recycle Bin: deleted." + NL
    t = t + "SUB DropOn (target AS String, how AS String)" + NL
    t = t + "    VAR srcs AS Array OF String" + NL
    t = t + "    VAR move AS Bool" + NL
    t = t + "    srcs = Picked()" + NL
    t = t + "    IF srcs.Count = 0 THEN RETURN" + NL
    t = t + "    IF target = ""::RECYCLE"" THEN" + NL
    t = t + "        DeleteSelected(FALSE)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    target = FolderFor(target)" + NL
    t = t + "    IF how = """" THEN" + NL
    t = t + "        move = SameDisk(srcs[0], target)" + NL
    t = t + "    ELSE" + NL
    t = t + "        move = how = ""move""" + NL
    t = t + "    END IF" + NL
    t = t + "    Transfer(srcs, target, move)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A machine dropped on is its C:\ (\\BRAVO\); anything else as it is" + NL
    t = t + "FUNCTION FolderFor (p AS String) AS String" + NL
    t = t + "    RETURN p" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Copies (or moves) each of srcs into the folder dst." + NL
    t = t + "SUB Transfer (srcs AS Array OF String, dst AS String, move AS Bool)" + NL
    t = t + "    VAR src AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR target AS String" + NL
    t = t + "    VAR made AS Array OF String" + NL
    t = t + "    VAR moved AS Array OF String" + NL
    t = t + "    VAR word AS String" + NL
    t = t + "    IF IsVirtual(dst) THEN THROW ""You can't put files there.""" + NL
    t = t + "    word = ""copy""" + NL
    t = t + "    IF move THEN word = ""move""" + NL
    t = t + "    StartProgress()" + NL
    t = t + "    TRY" + NL
    t = t + "        FOR EACH src IN srcs" + NL
    t = t + "            IF Cancelled() THEN BREAK" + NL
    t = t + "            kind = VStat(src)" + NL
    t = t + "            IF kind = """" THEN CONTINUE" + NL
    t = t + "            IF kind = ""D"" AND (dst = src OR dst.StartsWith(src + ""\"") OR ToUnc(dst).StartsWith(ToUnc(src) + ""\"")) THEN THROW ""Cannot "" + word + "" "" + BaseName(src) + "": the destination folder is inside the source folder.""" + NL
    t = t + "            name = BaseName(src)" + NL
    t = t + "            target = JoinPath(dst, name)" + NL
    t = t + "            IF ToUnc(target) = ToUnc(src) THEN" + NL
    t = t + "                IF move THEN CONTINUE" + NL
    t = t + "                ' a copy in its own folder: Copy of..., as NAME~1" + NL
    t = t + "                target = JoinPath(dst, FreeName(dst, name))" + NL
    t = t + "            ELSEIF VStat(target) <> """" THEN" + NL
    t = t + "                IF NOT Ask2(""This folder already contains a "" + KindWord(VStat(target)) + "" named '"" + name + ""'."" + Chr(10) + Chr(10) + ""Would you like to replace it?"", ""Confirm File Replace"") THEN CONTINUE" + NL
    t = t + "                VRemoveTree(target, VStat(target))" + NL
    t = t + "            END IF" + NL
    t = t + "            IF move AND SameDisk(src, dst) THEN" + NL
    t = t + "                Progress(""Moving"", src, dst)" + NL
    t = t + "                VRename(src, target)" + NL
    t = t + "                moved.Add(src + ""|"" + target)" + NL
    t = t + "            ELSE" + NL
    t = t + "                VCopyTree(src, kind, target)" + NL
    t = t + "                IF move THEN" + NL
    t = t + "                    VRemoveTree(src, kind)" + NL
    t = t + "                    moved.Add(src + ""|"" + target)" + NL
    t = t + "                ELSE" + NL
    t = t + "                    made.Add(target)" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "    CATCH err" + NL
    t = t + "        CloseProgress()" + NL
    t = t + "        AfterChange(made, moved)" + NL
    t = t + "        THROW err" + NL
    t = t + "    END TRY" + NL
    t = t + "    CloseProgress()" + NL
    t = t + "    AfterChange(made, moved)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB AfterChange (made AS Array OF String, moved AS Array OF String)" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    IF moved.Count > 0 THEN" + NL
    t = t + "        SetUndo(""move"", moved)" + NL
    t = t + "    ELSEIF made.Count > 0 THEN" + NL
    t = t + "        SetUndo(""copy"", made)" + NL
    t = t + "    END IF" + NL
    t = t + "    noKids = """"" + NL
    t = t + "    Refresh(FALSE)" + NL
    t = t + "    FOR EACH p IN made" + NL
    t = t + "        IF cPath.IndexOf(p) >= 0 THEN cSel[cPath.IndexOf(p)] = TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH p IN moved" + NL
    t = t + "        IF cPath.IndexOf(p.Split(""|"")[1]) >= 0 THEN cSel[cPath.IndexOf(p.Split(""|"")[1])] = TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    DrawList()" + NL
    t = t + "    ShowStatus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION KindWord (k AS String) AS String" + NL
    t = t + "    IF k = ""D"" THEN RETURN ""folder""" + NL
    t = t + "    RETURN ""file""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ delete, the Recycle Bin" + NL
    t = t + "" + NL
    t = t + "SUB DeleteSelected (forGood AS Bool)" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    p = Picked()" + NL
    t = t + "    IF p.Count = 0 THEN RETURN" + NL
    t = t + "    DeletePaths(p, forGood)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DeletePaths (paths AS Array OF String, forGood AS Bool)" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR toBin AS Bool" + NL
    t = t + "    VAR question AS String" + NL
    t = t + "    VAR binned AS Array OF String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF cur = ""::RECYCLE"" THEN" + NL
    t = t + "        forGood = TRUE" + NL
    t = t + "        toBin = FALSE" + NL
    t = t + "    ELSE" + NL
    t = t + "        toBin = NOT forGood AND NOT IsRemote(paths[0])" + NL
    t = t + "    END IF" + NL
    t = t + "    name = PlaceLabel(paths[0])" + NL
    t = t + "    i = cPath.IndexOf(paths[0])" + NL
    t = t + "    IF i >= 0 THEN name = ShownName(i)" + NL
    t = t + "    IF toBin THEN" + NL
    t = t + "        question = ""Are you sure you want to send '"" + name + ""' to the Recycle Bin?""" + NL
    t = t + "        IF paths.Count > 1 THEN question = ""Are you sure you want to send these "" + Str(paths.Count) + "" items to the Recycle Bin?""" + NL
    t = t + "    ELSE" + NL
    t = t + "        question = ""Are you sure you want to delete '"" + name + ""'?""" + NL
    t = t + "        IF paths.Count > 1 THEN question = ""Are you sure you want to delete these "" + Str(paths.Count) + "" items?""" + NL
    t = t + "        IF IsRemote(paths[0]) THEN question = question + Chr(10) + Chr(10) + ""It is on another machine's disk: it can't be brought back.""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT Ask2(question, ""Confirm File Delete"") THEN RETURN" + NL
    t = t + "    StartProgress()" + NL
    t = t + "    TRY" + NL
    t = t + "        FOR EACH p IN paths" + NL
    t = t + "            IF Cancelled() THEN BREAK" + NL
    t = t + "            IF cur = ""::RECYCLE"" THEN" + NL
    t = t + "                kind = ""F""" + NL
    t = t + "                IF FS.IsDir(p) THEN kind = ""D""" + NL
    t = t + "                VRemoveTree(p, kind)" + NL
    t = t + "                RemoveFromBin(BaseName(p))" + NL
    t = t + "                CONTINUE" + NL
    t = t + "            END IF" + NL
    t = t + "            kind = VStat(p)" + NL
    t = t + "            IF kind = """" THEN CONTINUE" + NL
    t = t + "            IF toBin THEN" + NL
    t = t + "                Progress(""Deleting"", p, """")" + NL
    t = t + "                binned.Add(Recycle(p, kind, SizeOf(p)))" + NL
    t = t + "            ELSE" + NL
    t = t + "                VRemoveTree(p, kind)" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "    CATCH err" + NL
    t = t + "        CloseProgress()" + NL
    t = t + "        IF binned.Count > 0 THEN SetUndo(""delete"", binned)" + NL
    t = t + "        Refresh(FALSE)" + NL
    t = t + "        THROW err" + NL
    t = t + "    END TRY" + NL
    t = t + "    CloseProgress()" + NL
    t = t + "    IF binned.Count > 0 THEN SetUndo(""delete"", binned)" + NL
    t = t + "    IF paths.Count = 1 AND paths[0] = cur THEN" + NL
    t = t + "        cur = ParentOf(cur)" + NL
    t = t + "    END IF" + NL
    t = t + "    noKids = """"" + NL
    t = t + "    Refresh(FALSE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION SizeOf (p AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = cPath.IndexOf(p)" + NL
    t = t + "    IF i >= 0 THEN RETURN cSize[i]" + NL
    t = t + "    RETURN 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB RemoveFromBin (name AS String)" + NL
    t = t + "    VAR keep AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN BinLines()" + NL
    t = t + "        IF line.Split(""|"")[0] <> name THEN keep.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    SaveBin(keep)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Restore ()" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR back AS Array OF String" + NL
    t = t + "    IF cur <> ""::RECYCLE"" THEN RETURN" + NL
    t = t + "    FOR EACH p IN Picked()" + NL
    t = t + "        back.Add(Unrecycle(BaseName(p)))" + NL
    t = t + "    NEXT" + NL
    t = t + "    Refresh(FALSE)" + NL
    t = t + "    win.Status = Str(back.Count) + "" object(s) restored""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB EmptyBin ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    lines = BinLines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF NOT Ask2(""Are you sure you want to delete all of the "" + Str(lines.Count) + "" items in the Recycle Bin?"", ""Confirm Multiple File Delete"") THEN RETURN" + NL
    t = t + "    StartProgress()" + NL
    t = t + "    FOR EACH line IN lines" + NL
    t = t + "        p = BINDIR + ""\"" + line.Split(""|"")[0]" + NL
    t = t + "        VRemoveTree(p, line.Split(""|"")[4])" + NL
    t = t + "    NEXT" + NL
    t = t + "    CloseProgress()" + NL
    t = t + "    SaveBin(StrList(""""))" + NL
    t = t + "    FS.Write(BINDIR + ""\INFO.TXT"", """")" + NL
    t = t + "    IF undoKind = ""delete"" THEN SetUndo("""", StrList(""""))" + NL
    t = t + "    Refresh(FALSE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ undo" + NL
    t = t + "" + NL
    t = t + "SUB SetUndo (kind AS String, data AS Array OF String)" + NL
    t = t + "    undoKind = kind" + NL
    t = t + "    undoData = data" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Undo ()" + NL
    t = t + "    VAR d AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    IF undoKind = """" THEN RETURN" + NL
    t = t + "    kind = undoKind" + NL
    t = t + "    undoKind = """"" + NL
    t = t + "    SELECT CASE kind" + NL
    t = t + "        CASE ""move""" + NL
    t = t + "            ' each back where it was, last first" + NL
    t = t + "            FOR k = undoData.Count - 1 TO 0 STEP -1" + NL
    t = t + "                d = undoData[k]" + NL
    t = t + "                IF SameDisk(d.Split(""|"")[1], d.Split(""|"")[0]) THEN" + NL
    t = t + "                    VRename(d.Split(""|"")[1], d.Split(""|"")[0])" + NL
    t = t + "                ELSE" + NL
    t = t + "                    VCopyTree(d.Split(""|"")[1], VStat(d.Split(""|"")[1]), d.Split(""|"")[0])" + NL
    t = t + "                    VRemoveTree(d.Split(""|"")[1], VStat(d.Split(""|"")[1]))" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "            win.Status = ""Undid the move""" + NL
    t = t + "        CASE ""copy"", ""new""" + NL
    t = t + "            IF NOT Ask2(""Undo "" + kind + "": delete the "" + Str(undoData.Count) + "" item(s) it made?"", ""Undo"") THEN RETURN" + NL
    t = t + "            FOR EACH d IN undoData" + NL
    t = t + "                IF VStat(d) <> """" THEN VRemoveTree(d, VStat(d))" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""delete""" + NL
    t = t + "            FOR EACH d IN undoData" + NL
    t = t + "                Unrecycle(d)" + NL
    t = t + "            NEXT" + NL
    t = t + "            win.Status = ""Restored from the Recycle Bin""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    noKids = """"" + NL
    t = t + "    IF NOT IsVirtual(cur) THEN" + NL
    t = t + "        IF VStat(cur) = """" THEN cur = ""::COMPUTER""" + NL
    t = t + "    END IF" + NL
    t = t + "    Refresh(FALSE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ context menus" + NL
    t = t + "" + NL
    t = t + "SUB PopupAt (x AS Integer, y AS Integer)" + NL
    t = t + "    ctx.Popup(cv.X + x, cv.Y + y)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ItemMenu (x AS Integer, y AS Integer)" + NL
    t = t + "    VAR one AS Integer" + NL
    t = t + "    one = FirstSel()" + NL
    t = t + "    ctx.Clear()" + NL
    t = t + "    ctx.AddMenu(""Item"")" + NL
    t = t + "    IF cur = ""::RECYCLE"" THEN" + NL
    t = t + "        ctx.AddItem(""Item"", ""Restore"")" + NL
    t = t + "        ctx.AddSeparator(""Item"")" + NL
    t = t + "        ctx.AddItem(""Item"", ""Delete"")" + NL
    t = t + "        ctx.AddSeparator(""Item"")" + NL
    t = t + "        ctx.AddItem(""Item"", ""Properties"")" + NL
    t = t + "        PopupAt(x, y)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ctx.AddItem(""Item"", ""Open"")" + NL
    t = t + "    IF IsFolderish(one) THEN ctx.AddItem(""Item"", ""Explore"")" + NL
    t = t + "    IF KindOf(one) = ""F"" THEN ctx.AddItem(""Item"", ""Edit"")" + NL
    t = t + "    IF KindOf(one) = ""MACHINE"" THEN" + NL
    t = t + "        ctx.AddSeparator(""Item"")" + NL
    t = t + "        ctx.AddItem(""Item"", ""Map Network Drive..."")" + NL
    t = t + "    END IF" + NL
    t = t + "    IF KindOf(one) = ""NETDRIVE"" THEN" + NL
    t = t + "        ctx.AddSeparator(""Item"")" + NL
    t = t + "        ctx.AddItem(""Item"", ""Disconnect"")" + NL
    t = t + "    END IF" + NL
    t = t + "    IF CanCopySel() THEN" + NL
    t = t + "        ctx.AddSeparator(""Item"")" + NL
    t = t + "        ctx.AddItem(""Item"", ""Cut"")" + NL
    t = t + "        ctx.AddItem(""Item"", ""Copy"")" + NL
    t = t + "        IF IsFolderish(one) AND FS.Exists(CLIPFILE) THEN ctx.AddItem(""Item"", ""Paste Into Folder"")" + NL
    t = t + "        ctx.AddSeparator(""Item"")" + NL
    t = t + "        ctx.AddItem(""Item"", ""Delete"")" + NL
    t = t + "        ctx.AddItem(""Item"", ""Rename"")" + NL
    t = t + "    END IF" + NL
    t = t + "    ctx.AddSeparator(""Item"")" + NL
    t = t + "    ctx.AddItem(""Item"", ""Properties"")" + NL
    t = t + "    PopupAt(x, y)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB BackgroundMenu (x AS Integer, y AS Integer)" + NL
    t = t + "    ctx.Clear()" + NL
    t = t + "    ctx.AddMenu(""Here"")" + NL
    t = t + "    ctx.AddItem(""Here"", ""Large Icons"")" + NL
    t = t + "    ctx.AddItem(""Here"", ""Small Icons"")" + NL
    t = t + "    ctx.AddItem(""Here"", ""List"")" + NL
    t = t + "    ctx.AddItem(""Here"", ""Details"")" + NL
    t = t + "    ctx.AddSeparator(""Here"")" + NL
    t = t + "    ctx.AddItem(""Here"", ""Arrange by Name"")" + NL
    t = t + "    ctx.AddItem(""Here"", ""Arrange by Type"")" + NL
    t = t + "    ctx.AddItem(""Here"", ""Arrange by Size"")" + NL
    t = t + "    ctx.AddSeparator(""Here"")" + NL
    t = t + "    ctx.AddItem(""Here"", ""Refresh"")" + NL
    t = t + "    IF CanWriteHere() THEN" + NL
    t = t + "        ctx.AddItem(""Here"", ""Paste"")" + NL
    t = t + "        ctx.SetEnabled(""Paste"", FS.Exists(CLIPFILE))" + NL
    t = t + "        ctx.AddSeparator(""Here"")" + NL
    t = t + "        ctx.AddItem(""Here"", ""New Folder"")" + NL
    t = t + "        ctx.AddItem(""Here"", ""New Text Document"")" + NL
    t = t + "    END IF" + NL
    t = t + "    IF cur = ""::RECYCLE"" THEN" + NL
    t = t + "        ctx.AddSeparator(""Here"")" + NL
    t = t + "        ctx.AddItem(""Here"", ""Empty Recycle Bin"")" + NL
    t = t + "    END IF" + NL
    t = t + "    ctx.AddSeparator(""Here"")" + NL
    t = t + "    ctx.AddItem(""Here"", ""Properties"")" + NL
    t = t + "    PopupAt(x, y)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB NodeMenu (i AS Integer, x AS Integer, y AS Integer)" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    p = tPath[i]" + NL
    t = t + "    ' the tree's own folder is picked for what the menu does" + NL
    t = t + "    IF p <> cur THEN Act(""!go "" + p)" + NL
    t = t + "    ctx.Clear()" + NL
    t = t + "    ctx.AddMenu(""Node"")" + NL
    t = t + "    IF tOpen[i] THEN" + NL
    t = t + "        ctx.AddItem(""Node"", ""Collapse"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        ctx.AddItem(""Node"", ""Expand"")" + NL
    t = t + "    END IF" + NL
    t = t + "    ctx.AddItem(""Node"", ""Open in New Window"")" + NL
    t = t + "    IF p = ""::RECYCLE"" THEN ctx.AddItem(""Node"", ""Empty Recycle Bin"")" + NL
    t = t + "    IF IsUnc(p) AND IsRoot(p) THEN ctx.AddItem(""Node"", ""Map Network Drive..."")" + NL
    t = t + "    IF IsMapped(p) AND IsRoot(p) THEN ctx.AddItem(""Node"", ""Disconnect"")" + NL
    t = t + "    IF NOT IsVirtual(p) AND NOT IsRoot(p) THEN" + NL
    t = t + "        ctx.AddSeparator(""Node"")" + NL
    t = t + "        ctx.AddItem(""Node"", ""Paste"")" + NL
    t = t + "        ctx.SetEnabled(""Paste"", FS.Exists(CLIPFILE))" + NL
    t = t + "        ctx.AddItem(""Node"", ""Delete Folder"")" + NL
    t = t + "        ctx.AddItem(""Node"", ""Rename Folder"")" + NL
    t = t + "    END IF" + NL
    t = t + "    ctx.AddSeparator(""Node"")" + NL
    t = t + "    ctx.AddItem(""Node"", ""Properties"")" + NL
    t = t + "    ctx.Tag = Str(i)" + NL
    t = t + "    PopupAt(x, y)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DropMenu (target AS String, x AS Integer, y AS Integer)" + NL
    t = t + "    ctx.Clear()" + NL
    t = t + "    ctx.AddMenu(""Drop"")" + NL
    t = t + "    ctx.AddItem(""Drop"", ""Move Here"")" + NL
    t = t + "    ctx.AddItem(""Drop"", ""Copy Here"")" + NL
    t = t + "    ctx.AddSeparator(""Drop"")" + NL
    t = t + "    ctx.AddItem(""Drop"", ""Cancel"")" + NL
    t = t + "    ctx.Tag = target" + NL
    t = t + "    PopupAt(x, y)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ dialogs" + NL
    t = t + "" + NL
    t = t + "' A window of the program's own that the caller waits on: TRUE for OK." + NL
    t = t + "FUNCTION RunDialog (focusBox AS Bool) AS Bool" + NL
    t = t + "    dlgDone = FALSE" + NL
    t = t + "    dlgOk = FALSE" + NL
    t = t + "    dlg.Modal = TRUE" + NL
    t = t + "    dlg.Resizable = FALSE" + NL
    t = t + "    dlg.onClose = Dlg_OnClose" + NL
    t = t + "    dlg.Show()" + NL
    t = t + "    IF focusBox THEN" + NL
    t = t + "        dBox1.Focus()" + NL
    t = t + "        dBox1.SelectAll()" + NL
    t = t + "    END IF" + NL
    t = t + "    WHILE NOT dlgDone" + NL
    t = t + "        SYS.Sleep(30)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN dlgOk" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Dlg_OnOk ()" + NL
    t = t + "    dlgOk = TRUE" + NL
    t = t + "    dlgDone = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Dlg_OnCancel ()" + NL
    t = t + "    dlgDone = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Dlg_OnClose ()" + NL
    t = t + "    dlgDone = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB EndDialog ()" + NL
    t = t + "    TRY" + NL
    t = t + "        IF NOT IsNothing(dlg) THEN dlg.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION AddLabel (w AS GUI_Window, text AS String, x AS Integer, y AS Integer, width AS Integer) AS GUI_Label" + NL
    t = t + "    VAR l AS GUI_Label" + NL
    t = t + "    l = GUI_Label.New(w)" + NL
    t = t + "    l.Text = text" + NL
    t = t + "    l.SetBounds(x, y, width, 14)" + NL
    t = t + "    RETURN l" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB OkCancel (w AS GUI_Window, y AS Integer, okText AS String)" + NL
    t = t + "    VAR ok AS GUI_Button" + NL
    t = t + "    VAR cancel AS GUI_Button" + NL
    t = t + "    ok = GUI_Button.New(w)" + NL
    t = t + "    ok.Text = okText" + NL
    t = t + "    ok.Default = TRUE" + NL
    t = t + "    ok.SetBounds(w.Width - 164, y, 75, 23)" + NL
    t = t + "    ok.onClick = Dlg_OnOk" + NL
    t = t + "    cancel = GUI_Button.New(w)" + NL
    t = t + "    cancel.Text = ""Cancel""" + NL
    t = t + "    cancel.Cancel = TRUE" + NL
    t = t + "    cancel.SetBounds(w.Width - 83, y, 75, 23)" + NL
    t = t + "    cancel.onClick = Dlg_OnCancel" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One line asked for; the answer is in dBox1.Text (until the next dialog)." + NL
    t = t + "FUNCTION Prompt (title AS String, label AS String, initial AS String) AS Bool" + NL
    t = t + "    VAR ok AS Bool" + NL
    t = t + "    dlg = GUI_Window.New(title, 340, 96)" + NL
    t = t + "    dlg.Icon = ""folder""" + NL
    t = t + "    AddLabel(dlg, label, 8, 8, 324)" + NL
    t = t + "    dBox1 = GUI_TextBox.New(dlg)" + NL
    t = t + "    dBox1.Text = initial" + NL
    t = t + "    dBox1.SetBounds(8, 30, 324, 21)" + NL
    t = t + "    dBox1.onEnter = Dlg_OnOk" + NL
    t = t + "    OkCancel(dlg, 62, ""OK"")" + NL
    t = t + "    ok = RunDialog(TRUE)" + NL
    t = t + "    promptAnswer = """"" + NL
    t = t + "    IF ok THEN promptAnswer = dBox1.Text" + NL
    t = t + "    EndDialog()" + NL
    t = t + "    RETURN ok AND promptAnswer.Trim() <> """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Say (text AS String, kind AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = ""Explorer""" + NL
    t = t + "    box.Kind = kind" + NL
    t = t + "    box.Text = text" + NL
    t = t + "    box.Show()" + NL
    t = t + "    box.Destroy()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ShowError (text AS String)" + NL
    t = t + "    Say(text, ""error"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Ask2 (text AS String, title AS String) AS Bool" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    VAR yes AS Bool" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = title" + NL
    t = t + "    box.Kind = ""question""" + NL
    t = t + "    box.Buttons = ""yesno""" + NL
    t = t + "    box.Text = text" + NL
    t = t + "    yes = box.Show()" + NL
    t = t + "    box.Destroy()" + NL
    t = t + "    RETURN yes" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""Enter Network Password"", as Windows 95 asks it. TRUE when a logon was given." + NL
    t = t + "FUNCTION AskLogon (host AS String, again AS Bool) AS Bool" + NL
    t = t + "    VAR ok AS GUI_Button" + NL
    t = t + "    VAR cancel AS GUI_Button" + NL
    t = t + "    VAR me AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR user AS String" + NL
    t = t + "    VAR pass AS String" + NL
    t = t + "    VAR save AS Bool" + NL
    t = t + "    me = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        FOR EACH line IN FS.Read(""C:\SYSTEM\USERS.INI"").Lines()" + NL
    t = t + "            IF line.Trim().Lower().StartsWith(""name="") THEN me = line.Trim().Substring(5, line.Trim().Length - 5)" + NL
    t = t + "        NEXT" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    ' (asked again: the name typed last time)" + NL
    t = t + "    IF again AND triedHost = host AND triedUser <> """" THEN me = triedUser" + NL
    t = t + "    CloseProgress()" + NL
    t = t + "    lgWin = GUI_Window.New(""Enter Network Password"", 340, 170)" + NL
    t = t + "    lgWin.Icon = ""network""" + NL
    t = t + "    lgWin.Modal = TRUE" + NL
    t = t + "    lgWin.Resizable = FALSE" + NL
    t = t + "    lgWin.onClose = Lg_OnCancel" + NL
    t = t + "    IF again THEN" + NL
    t = t + "        AddLabel(lgWin, ""The password is incorrect. Try again:"", 8, 8, 324)" + NL
    t = t + "    ELSE" + NL
    t = t + "        AddLabel(lgWin, ""You must supply a password to make this connection:"", 8, 8, 324)" + NL
    t = t + "    END IF" + NL
    t = t + "    AddLabel(lgWin, ""Resource:"", 8, 32, 80)" + NL
    t = t + "    AddLabel(lgWin, ""\\"" + host, 96, 32, 236)" + NL
    t = t + "    AddLabel(lgWin, ""&User name:"", 8, 58, 80)" + NL
    t = t + "    lgUser = GUI_TextBox.New(lgWin)" + NL
    t = t + "    lgUser.SetBounds(96, 54, 236, 21)" + NL
    t = t + "    lgUser.Text = me" + NL
    t = t + "    lgUser.onEnter = Lg_OnUserEnter" + NL
    t = t + "    AddLabel(lgWin, ""&Password:"", 8, 86, 80)" + NL
    t = t + "    lgPass = GUI_TextBox.New(lgWin)" + NL
    t = t + "    lgPass.Password = TRUE" + NL
    t = t + "    lgPass.SetBounds(96, 82, 236, 21)" + NL
    t = t + "    lgPass.onEnter = Lg_OnOk" + NL
    t = t + "    lgSave = GUI_CheckBox.New(lgWin)" + NL
    t = t + "    lgSave.Text = ""&Save this password in your password list""" + NL
    t = t + "    lgSave.Checked = TRUE" + NL
    t = t + "    lgSave.SetBounds(8, 110, 324, 18)" + NL
    t = t + "    ok = GUI_Button.New(lgWin)" + NL
    t = t + "    ok.Text = ""OK""" + NL
    t = t + "    ok.Default = TRUE" + NL
    t = t + "    ok.SetBounds(176, 138, 75, 23)" + NL
    t = t + "    ok.onClick = Lg_OnOk" + NL
    t = t + "    cancel = GUI_Button.New(lgWin)" + NL
    t = t + "    cancel.Text = ""Cancel""" + NL
    t = t + "    cancel.Cancel = TRUE" + NL
    t = t + "    cancel.SetBounds(257, 138, 75, 23)" + NL
    t = t + "    cancel.onClick = Lg_OnCancel" + NL
    t = t + "    lgDone = FALSE" + NL
    t = t + "    lgOk = FALSE" + NL
    t = t + "    lgWin.Show()" + NL
    t = t + "    IF me = """" THEN" + NL
    t = t + "        lgUser.Focus()" + NL
    t = t + "    ELSE" + NL
    t = t + "        lgPass.Focus()" + NL
    t = t + "    END IF" + NL
    t = t + "    WHILE NOT lgDone" + NL
    t = t + "        SYS.Sleep(30)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF lgOk THEN" + NL
    t = t + "        user = lgUser.Text.Trim()" + NL
    t = t + "        pass = lgPass.Text" + NL
    t = t + "        save = lgSave.Checked" + NL
    t = t + "    END IF" + NL
    t = t + "    TRY" + NL
    t = t + "        lgWin.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF NOT lgOk THEN RETURN FALSE" + NL
    t = t + "    RememberLogon(host, user, pass, save)" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Lg_OnUserEnter ()" + NL
    t = t + "    lgPass.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Lg_OnOk ()" + NL
    t = t + "    lgOk = TRUE" + NL
    t = t + "    lgDone = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Lg_OnCancel ()" + NL
    t = t + "    lgDone = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Tools > Map Network Drive: a free letter, and a machine's folder for it." + NL
    t = t + "SUB MapDrive (suggest AS String)" + NL
    t = t + "    VAR letters AS Array OF String" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR letter AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR keep AS Bool" + NL
    t = t + "    VAR ok AS Bool" + NL
    t = t + "    VAR m AS String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    FOR c = 90 TO 68 STEP -1" + NL
    t = t + "        IF DriveIndex(Chr(c)) < 0 THEN letters.Add(Chr(c) + "":"")" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF letters.Count = 0 THEN THROW ""Every drive letter from D: to Z: is in use. Disconnect one first.""" + NL
    t = t + "    IF suggest = """" AND IsUnc(cur) THEN suggest = RootOf(cur)" + NL
    t = t + "    IF suggest = """" AND FirstSel() >= 0 THEN" + NL
    t = t + "        IF cKind[FirstSel()] = ""MACHINE"" THEN suggest = cPath[FirstSel()]" + NL
    t = t + "    END IF" + NL
    t = t + "    dlg = GUI_Window.New(""Map Network Drive"", 380, 168)" + NL
    t = t + "    dlg.Icon = ""network""" + NL
    t = t + "    AddLabel(dlg, ""&Drive:"", 8, 12, 50)" + NL
    t = t + "    dDrop = GUI_DropDown.New(dlg)" + NL
    t = t + "    dDrop.Items = letters" + NL
    t = t + "    dDrop.Selected = 0" + NL
    t = t + "    dDrop.SetBounds(64, 8, 80, 22)" + NL
    t = t + "    AddLabel(dlg, ""&Path:"", 8, 42, 50)" + NL
    t = t + "    dBox1 = GUI_TextBox.New(dlg)" + NL
    t = t + "    dBox1.Text = suggest" + NL
    t = t + "    dBox1.SetBounds(64, 38, 308, 21)" + NL
    t = t + "    dBox1.onEnter = Dlg_OnOk" + NL
    t = t + "    AddLabel(dlg, ""For example: \\BRAVO\MYFILES (or \\BRAVO\ for all of it)"", 64, 64, 308)" + NL
    t = t + "    dCheck1 = GUI_CheckBox.New(dlg)" + NL
    t = t + "    dCheck1.Text = ""&Reconnect at logon""" + NL
    t = t + "    dCheck1.Checked = TRUE" + NL
    t = t + "    dCheck1.SetBounds(64, 92, 200, 18)" + NL
    t = t + "    OkCancel(dlg, 134, ""OK"")" + NL
    t = t + "    ok = RunDialog(TRUE)" + NL
    t = t + "    IF ok THEN" + NL
    t = t + "        letter = dDrop.Get(MATH.Max(0, dDrop.Selected)).Substring(0, 1)" + NL
    t = t + "        path = dBox1.Text.Trim()" + NL
    t = t + "        keep = dCheck1.Checked" + NL
    t = t + "    END IF" + NL
    t = t + "    EndDialog()" + NL
    t = t + "    IF NOT ok OR path = """" THEN RETURN" + NL
    t = t + "    IF NOT path.StartsWith(""\\"") THEN path = ""\\"" + path" + NL
    t = t + "    p = Normalize(path, ""C:\"")" + NL
    t = t + "    IF NOT IsUnc(p) THEN THROW ""'"" + path + ""' is not a network path. Type it as \\MACHINE\FOLDER.""" + NL
    t = t + "    ' it has to be there (and this asks for a password if one's needed)" + NL
    t = t + "    IF VStat(p) <> ""D"" THEN THROW ""The network path "" + p + "" could not be found.""" + NL
    t = t + "    LoadDrives()" + NL
    t = t + "    IF DriveIndex(letter) >= 0 THEN THROW letter + "": is already in use.""" + NL
    t = t + "    dLetter.Add(letter)" + NL
    t = t + "    dTarget.Add(p)" + NL
    t = t + "    dKeep.Add(keep)" + NL
    t = t + "    dDown.Add(FALSE)" + NL
    t = t + "    SaveDrives(TRUE)" + NL
    t = t + "    expanded = expanded.Replace(""|::COMPUTER|"", ""|"") + ""::COMPUTER|""" + NL
    t = t + "    Go(letter + "":\"")" + NL
    t = t + "    win.Status = letter + "": is "" + p" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DisconnectDialog ()" + NL
    t = t + "    VAR items AS Array OF String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR ok AS Bool" + NL
    t = t + "    VAR pick AS Integer" + NL
    t = t + "    LoadDrives()" + NL
    t = t + "    IF dLetter.Count = 0 THEN THROW ""There are no network drives to disconnect.""" + NL
    t = t + "    FOR k = 0 TO dLetter.Count - 1" + NL
    t = t + "        items.Add(dLetter[k] + "":   "" + dTarget[k])" + NL
    t = t + "    NEXT" + NL
    t = t + "    dlg = GUI_Window.New(""Disconnect Network Drive"", 340, 190)" + NL
    t = t + "    dlg.Icon = ""network""" + NL
    t = t + "    AddLabel(dlg, ""&Drive:"", 8, 8, 200)" + NL
    t = t + "    dList = GUI_ListBox.New(dlg)" + NL
    t = t + "    dList.Items = items" + NL
    t = t + "    dList.Selected = 0" + NL
    t = t + "    dList.Mono = TRUE" + NL
    t = t + "    dList.SetBounds(8, 26, 324, 120)" + NL
    t = t + "    dList.onDblClick = Dlg_OnOk" + NL
    t = t + "    OkCancel(dlg, 158, ""OK"")" + NL
    t = t + "    ok = RunDialog(FALSE)" + NL
    t = t + "    pick = dList.Selected" + NL
    t = t + "    EndDialog()" + NL
    t = t + "    IF NOT ok OR pick < 0 OR pick >= dLetter.Count THEN RETURN" + NL
    t = t + "    Disconnect(dLetter[pick])" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Disconnect (letter AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR host AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR still AS Bool" + NL
    t = t + "    LoadDrives()" + NL
    t = t + "    i = DriveIndex(letter)" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    host = HostOf(dTarget[i])" + NL
    t = t + "    dLetter.RemoveAt(i)" + NL
    t = t + "    dTarget.RemoveAt(i)" + NL
    t = t + "    dKeep.RemoveAt(i)" + NL
    t = t + "    dDown.RemoveAt(i)" + NL
    t = t + "    SaveDrives(TRUE)" + NL
    t = t + "    FOR k = 0 TO dTarget.Count - 1" + NL
    t = t + "        IF HostOf(dTarget[k]) = host THEN still = TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT still THEN Hangup(host)" + NL
    t = t + "    IF cur.StartsWith(letter + "":"") THEN" + NL
    t = t + "        cur = ""::COMPUTER""" + NL
    t = t + "        Go(""::COMPUTER"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        Refresh(TRUE)" + NL
    t = t + "    END IF" + NL
    t = t + "    win.Status = letter + "": is disconnected""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' File > Properties: of what's picked, or of the folder." + NL
    t = t + "SUB Properties ()" + NL
    t = t + "    VAR one AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR icn AS String" + NL
    t = t + "    VAR typ AS String" + NL
    t = t + "    VAR where AS String" + NL
    t = t + "    VAR size AS String" + NL
    t = t + "    VAR contains AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR c AS GUI_Canvas" + NL
    t = t + "    VAR ok AS GUI_Button" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    n = SelCount()" + NL
    t = t + "    one = FirstSel()" + NL
    t = t + "    mFiles = 0" + NL
    t = t + "    mFolders = 0" + NL
    t = t + "    mBytes = 0" + NL
    t = t + "    IF n > 1 THEN" + NL
    t = t + "        name = Str(n) + "" items""" + NL
    t = t + "        icn = ""file""" + NL
    t = t + "        typ = ""Several kinds""" + NL
    t = t + "        FOR i = 0 TO cName.Count - 1" + NL
    t = t + "            IF cSel[i] THEN" + NL
    t = t + "                IF cKind[i] = ""F"" THEN" + NL
    t = t + "                    mFiles = mFiles + 1" + NL
    t = t + "                    mBytes = mBytes + cSize[i]" + NL
    t = t + "                ELSEIF cKind[i] = ""D"" THEN" + NL
    t = t + "                    mFolders = mFolders + 1" + NL
    t = t + "                    VMeasure(cPath[i], ""D"")" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        where = PlaceLabel(cur)" + NL
    t = t + "        IF NOT IsVirtual(cur) THEN where = cur" + NL
    t = t + "        size = Bytes(mBytes) + "" ("" + Str(mBytes) + "" bytes)""" + NL
    t = t + "        contains = Str(mFiles) + "" Files, "" + Str(mFolders) + "" Folders""" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF one >= 0 THEN" + NL
    t = t + "            p = cPath[one]" + NL
    t = t + "            kind = cKind[one]" + NL
    t = t + "            name = ShownName(one)" + NL
    t = t + "            icn = cIcon[one]" + NL
    t = t + "            typ = cType[one]" + NL
    t = t + "        ELSE" + NL
    t = t + "            p = cur" + NL
    t = t + "            kind = ""D""" + NL
    t = t + "            IF IsVirtual(cur) THEN kind = ""PLACE""" + NL
    t = t + "            IF IsRoot(cur) THEN kind = ""DRIVE""" + NL
    t = t + "            IF IsRoot(cur) AND IsRemote(cur) THEN kind = ""NETDRIVE""" + NL
    t = t + "            name = PlaceLabel(cur)" + NL
    t = t + "            icn = IconFor("""", kind, cur)" + NL
    t = t + "            typ = TypeName("""", kind)" + NL
    t = t + "        END IF" + NL
    t = t + "        where = ParentOf(p)" + NL
    t = t + "        IF cur = ""::RECYCLE"" AND one >= 0 THEN where = cExtra[one] + "" (now in the Recycle Bin)""" + NL
    t = t + "        IF IsVirtual(where) THEN where = PlaceLabel(where)" + NL
    t = t + "        IF kind = ""F"" THEN" + NL
    t = t + "            i = cPath.IndexOf(p)" + NL
    t = t + "            IF i >= 0 THEN mBytes = cSize[i]" + NL
    t = t + "            size = Bytes(mBytes) + "" ("" + Str(mBytes) + "" bytes)""" + NL
    t = t + "        ELSEIF kind = ""D"" OR kind = ""DRIVE"" OR kind = ""NETDRIVE"" OR kind = ""MACHINE"" THEN" + NL
    t = t + "            IF NOT IsVirtual(p) THEN" + NL
    t = t + "                VMeasure(p, ""D"")" + NL
    t = t + "                size = Bytes(mBytes) + "" ("" + Str(mBytes) + "" bytes)""" + NL
    t = t + "                contains = Str(mFiles) + "" Files, "" + Str(mFolders) + "" Folders""" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        IF kind = ""NETDRIVE"" AND IsMapped(p) THEN typ = ""Network Drive: "" + ToUnc(p)" + NL
    t = t + "        IF kind = ""MACHINE"" OR (IsUnc(p) AND IsRoot(p)) THEN typ = ""Computer on the network""" + NL
    t = t + "    END IF" + NL
    t = t + "    dlg = GUI_Window.New(name + "" Properties"", 340, 250)" + NL
    t = t + "    dlg.Icon = ""info""" + NL
    t = t + "    c = GUI_Canvas.New(dlg)" + NL
    t = t + "    c.Background = 7" + NL
    t = t + "    c.SetBounds(12, 12, 32, 32)" + NL
    t = t + "    c.Picture(0, 0, IconOn(icn, 7))" + NL
    t = t + "    AddLabel(dlg, name, 60, 20, 270)" + NL
    t = t + "    y = 58" + NL
    t = t + "    AddLabel(dlg, ""Type:"", 12, y, 80)" + NL
    t = t + "    AddLabel(dlg, typ, 96, y, 236)" + NL
    t = t + "    y = y + 22" + NL
    t = t + "    IF where <> """" THEN" + NL
    t = t + "        AddLabel(dlg, ""Location:"", 12, y, 80)" + NL
    t = t + "        AddLabel(dlg, where, 96, y, 236)" + NL
    t = t + "        y = y + 22" + NL
    t = t + "    END IF" + NL
    t = t + "    IF size <> """" THEN" + NL
    t = t + "        AddLabel(dlg, ""Size:"", 12, y, 80)" + NL
    t = t + "        AddLabel(dlg, size, 96, y, 236)" + NL
    t = t + "        y = y + 22" + NL
    t = t + "    END IF" + NL
    t = t + "    IF contains <> """" THEN" + NL
    t = t + "        AddLabel(dlg, ""Contains:"", 12, y, 80)" + NL
    t = t + "        AddLabel(dlg, contains, 96, y, 236)" + NL
    t = t + "        y = y + 22" + NL
    t = t + "    END IF" + NL
    t = t + "    IF kind = ""F"" OR kind = ""D"" THEN" + NL
    t = t + "        AddLabel(dlg, ""MS-DOS name:"", 12, y, 84)" + NL
    t = t + "        AddLabel(dlg, BaseName(p), 96, y, 236)" + NL
    t = t + "        y = y + 22" + NL
    t = t + "    END IF" + NL
    t = t + "    ok = GUI_Button.New(dlg)" + NL
    t = t + "    ok.Text = ""OK""" + NL
    t = t + "    ok.Default = TRUE" + NL
    t = t + "    ok.Cancel = TRUE" + NL
    t = t + "    ok.SetBounds(257, 218, 75, 23)" + NL
    t = t + "    ok.onClick = Dlg_OnOk" + NL
    t = t + "    RunDialog(FALSE)" + NL
    t = t + "    EndDialog()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Options ()" + NL
    t = t + "    VAR ok AS Bool" + NL
    t = t + "    dlg = GUI_Window.New(""Options"", 340, 130)" + NL
    t = t + "    dlg.Icon = ""settings""" + NL
    t = t + "    AddLabel(dlg, ""View"", 8, 8, 200)" + NL
    t = t + "    dCheck1 = GUI_CheckBox.New(dlg)" + NL
    t = t + "    dCheck1.Text = ""Hide file e&xtensions for known file types""" + NL
    t = t + "    dCheck1.Checked = hideExt" + NL
    t = t + "    dCheck1.SetBounds(16, 30, 316, 18)" + NL
    t = t + "    dCheck2 = GUI_CheckBox.New(dlg)" + NL
    t = t + "    dCheck2.Text = ""Show names in &capitals, as they are stored""" + NL
    t = t + "    dCheck2.Checked = showCaps" + NL
    t = t + "    dCheck2.SetBounds(16, 54, 316, 18)" + NL
    t = t + "    OkCancel(dlg, 98, ""OK"")" + NL
    t = t + "    ok = RunDialog(FALSE)" + NL
    t = t + "    IF ok THEN" + NL
    t = t + "        hideExt = dCheck1.Checked" + NL
    t = t + "        showCaps = dCheck2.Checked" + NL
    t = t + "    END IF" + NL
    t = t + "    EndDialog()" + NL
    t = t + "    IF ok THEN" + NL
    t = t + "        SaveSettings()" + NL
    t = t + "        Refresh(TRUE)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Tools > Find: files whose names match (* and ?), perhaps holding some" + NL
    t = t + "' text, in a folder and the folders in it. They show as Search Results." + NL
    t = t + "SUB Find ()" + NL
    t = t + "    VAR ok AS Bool" + NL
    t = t + "    VAR where AS String" + NL
    t = t + "    IF findWhere = """" THEN" + NL
    t = t + "        findWhere = cur" + NL
    t = t + "        IF IsVirtual(cur) THEN findWhere = ""C:\""" + NL
    t = t + "    END IF" + NL
    t = t + "    dlg = GUI_Window.New(""Find: All Files"", 380, 160)" + NL
    t = t + "    dlg.Icon = ""question""" + NL
    t = t + "    AddLabel(dlg, ""&Named:"", 8, 12, 80)" + NL
    t = t + "    dBox1 = GUI_TextBox.New(dlg)" + NL
    t = t + "    dBox1.Text = findName" + NL
    t = t + "    dBox1.SetBounds(96, 8, 276, 21)" + NL
    t = t + "    dBox1.onEnter = Dlg_OnOk" + NL
    t = t + "    AddLabel(dlg, ""Containing &text:"", 8, 40, 88)" + NL
    t = t + "    dBox2 = GUI_TextBox.New(dlg)" + NL
    t = t + "    dBox2.Text = findText" + NL
    t = t + "    dBox2.SetBounds(96, 36, 276, 21)" + NL
    t = t + "    dBox2.onEnter = Dlg_OnOk" + NL
    t = t + "    AddLabel(dlg, ""&Look in:"", 8, 68, 80)" + NL
    t = t + "    dDrop = GUI_DropDown.New(dlg)" + NL
    t = t + "    dDrop.Items = [findWhere, ""C:\"", ""C:\MYFILES""]" + NL
    t = t + "    dDrop.Selected = 0" + NL
    t = t + "    dDrop.SetBounds(96, 64, 276, 22)" + NL
    t = t + "    dCheck1 = GUI_CheckBox.New(dlg)" + NL
    t = t + "    dCheck1.Text = ""Include &subfolders""" + NL
    t = t + "    dCheck1.Checked = TRUE" + NL
    t = t + "    dCheck1.SetBounds(96, 94, 200, 18)" + NL
    t = t + "    OkCancel(dlg, 128, ""Find Now"")" + NL
    t = t + "    ok = RunDialog(TRUE)" + NL
    t = t + "    IF ok THEN" + NL
    t = t + "        findName = dBox1.Text.Trim().Upper()" + NL
    t = t + "        findText = dBox2.Text" + NL
    t = t + "        where = dDrop.Get(MATH.Max(0, dDrop.Selected))" + NL
    t = t + "    END IF" + NL
    t = t + "    EndDialog()" + NL
    t = t + "    IF NOT ok THEN RETURN" + NL
    t = t + "    IF findName = """" THEN findName = ""*""" + NL
    t = t + "    findWhere = Normalize(where, ""C:\"")" + NL
    t = t + "    findPaths.Clear()" + NL
    t = t + "    StartProgress()" + NL
    t = t + "    TRY" + NL
    t = t + "        Search(findWhere, dCheck1.Checked)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        IF NOT err.StartsWith(""!cancel"") THEN" + NL
    t = t + "            CloseProgress()" + NL
    t = t + "            THROW err" + NL
    t = t + "        END IF" + NL
    t = t + "    END TRY" + NL
    t = t + "    CloseProgress()" + NL
    t = t + "    Go(""::FIND"")" + NL
    t = t + "    win.Status = Str(findPaths.Count) + "" file(s) found in "" + findWhere" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Search (dir AS String, deep AS Bool)" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    IF Cancelled() THEN THROW ""!cancel""" + NL
    t = t + "    Progress(""Searching"", dir, """")" + NL
    t = t + "    FOR EACH e IN VList(dir)" + NL
    t = t + "        parts = e.Split(""|"")" + NL
    t = t + "        p = JoinPath(dir, parts[0])" + NL
    t = t + "        IF Matches(parts[0], findName) THEN" + NL
    t = t + "            IF findText = """" THEN" + NL
    t = t + "                findPaths.Add(p + ""|"" + parts[1] + ""|"" + parts[2])" + NL
    t = t + "            ELSEIF parts[1] = ""F"" THEN" + NL
    t = t + "                IF VRead(p).Lower().Contains(findText.Lower()) THEN findPaths.Add(p + ""|F|"" + parts[2])" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        IF parts[1] = ""D"" AND deep THEN Search(p, TRUE)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' NAME against a pattern with * and ? (and a pattern without either: anywhere in the name)" + NL
    t = t + "FUNCTION Matches (name AS String, pat AS String) AS Bool" + NL
    t = t + "    IF NOT pat.Contains(""*"") AND NOT pat.Contains(""?"") THEN RETURN name.Contains(pat)" + NL
    t = t + "    RETURN Wild(name, 0, pat, 0)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Wild (s AS String, i AS Integer, p AS String, j AS Integer) AS Bool" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF j = p.Length THEN RETURN i = s.Length" + NL
    t = t + "    IF p.CharAt(j) = ""*"" THEN" + NL
    t = t + "        FOR k = i TO s.Length" + NL
    t = t + "            IF Wild(s, k, p, j + 1) THEN RETURN TRUE" + NL
    t = t + "        NEXT" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF i = s.Length THEN RETURN FALSE" + NL
    t = t + "    IF p.CharAt(j) = ""?"" OR p.CharAt(j) = s.CharAt(i) THEN RETURN Wild(s, i + 1, p, j + 1)" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the progress box" + NL
    t = t + "'" + NL
    t = t + "' ""Copying..."", shown once a job has taken a moment, with Cancel." + NL
    t = t + "" + NL
    t = t + "SUB StartProgress ()" + NL
    t = t + "    opStart = SYS.Ticks" + NL
    t = t + "    cancelFlag = FALSE" + NL
    t = t + "    progShown = FALSE" + NL
    t = t + "    progCount = 0" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Progress (what AS String, src AS String, dst AS String)" + NL
    t = t + "    VAR c AS GUI_Button" + NL
    t = t + "    progCount = progCount + 1" + NL
    t = t + "    IF NOT progShown AND SYS.Ticks - opStart > 700 THEN" + NL
    t = t + "        progShown = TRUE" + NL
    t = t + "        progWin = GUI_Window.New(what + ""..."", 340, 120)" + NL
    t = t + "        progWin.Icon = ""file""" + NL
    t = t + "        progWin.Resizable = FALSE" + NL
    t = t + "        progWin.onClose = Prog_OnCancel" + NL
    t = t + "        progWhat = AddLabel(progWin, """", 12, 12, 316)" + NL
    t = t + "        progFrom = AddLabel(progWin, """", 12, 32, 316)" + NL
    t = t + "        progBar = GUI_ProgressBar.New(progWin)" + NL
    t = t + "        progBar.SetBounds(12, 56, 316, 16)" + NL
    t = t + "        progBar.Max = 20" + NL
    t = t + "        c = GUI_Button.New(progWin)" + NL
    t = t + "        c.Text = ""Cancel""" + NL
    t = t + "        c.Cancel = TRUE" + NL
    t = t + "        c.SetBounds(253, 86, 75, 23)" + NL
    t = t + "        c.onClick = Prog_OnCancel" + NL
    t = t + "        progWin.Show()" + NL
    t = t + "    END IF" + NL
    t = t + "    IF progShown THEN" + NL
    t = t + "        progWin.Title = what + ""...""" + NL
    t = t + "        progWhat.Text = PlaceLabel(src)" + NL
    t = t + "        IF dst <> """" THEN" + NL
    t = t + "            progFrom.Text = ""From '"" + PlaceLabel(ParentOf(src)) + ""' to '"" + PlaceLabel(dst) + ""'""" + NL
    t = t + "        ELSE" + NL
    t = t + "            progFrom.Text = ""In '"" + PlaceLabel(ParentOf(src)) + ""'""" + NL
    t = t + "        END IF" + NL
    t = t + "        progBar.Value = progCount MOD 21" + NL
    t = t + "        ' (a moment for the box to show, and for Cancel)" + NL
    t = t + "        SYS.Sleep(1)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Cancelled () AS Bool" + NL
    t = t + "    RETURN cancelFlag" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Prog_OnCancel ()" + NL
    t = t + "    cancelFlag = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB CloseProgress ()" + NL
    t = t + "    IF progShown THEN" + NL
    t = t + "        TRY" + NL
    t = t + "            progWin.Close()" + NL
    t = t + "        CATCH err" + NL
    t = t + "        END TRY" + NL
    t = t + "    END IF" + NL
    t = t + "    progShown = FALSE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ icons" + NL
    t = t + "" + NL
    t = t + "FUNCTION IconAt (name AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = icName.IndexOf(name)" + NL
    t = t + "    IF i < 0 THEN i = icName.IndexOf(""file"")" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' name at 16 or 32, n(ormal), s(elected) or g(host, for cut or a drop target), on white" + NL
    t = t + "FUNCTION Icon (name AS String, size AS Integer, state AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = IconAt(name)" + NL
    t = t + "    IF size = 32 THEN" + NL
    t = t + "        IF state = ""s"" THEN RETURN ic32s[i]" + NL
    t = t + "        IF state = ""g"" THEN RETURN ic32g[i]" + NL
    t = t + "        RETURN ic32[i]" + NL
    t = t + "    END IF" + NL
    t = t + "    IF state = ""s"" THEN RETURN ic16s[i]" + NL
    t = t + "    IF state = ""g"" THEN RETURN ic16g[i]" + NL
    t = t + "    RETURN ic16[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A 32 one on another background colour (the Properties box is silver)" + NL
    t = t + "FUNCTION IconOn (name AS String, colour AS Integer) AS String" + NL
    t = t + "    RETURN ic32[IconAt(name)]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ToolIcon (id AS String, on AS Bool) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = icName.IndexOf(""t_"" + id)" + NL
    t = t + "    IF i < 0 THEN RETURN icTool[IconAt(""file"")]" + NL
    t = t + "    IF on THEN RETURN icTool[i]" + NL
    t = t + "    RETURN icToolOff[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the pictures (made by tools/build-installer.mjs)" + NL
    t = t + "" + NL
    t = t + "SUB IcAdd (n AS String, a AS String, b AS String, c AS String, d AS String, e AS String, f AS String, g AS String, h AS String)" + NL
    t = t + "    icName.Add(n)" + NL
    t = t + "    ic16.Add(a.Replace("";"", Chr(10)))" + NL
    t = t + "    ic16s.Add(b.Replace("";"", Chr(10)))" + NL
    t = t + "    ic16g.Add(c.Replace("";"", Chr(10)))" + NL
    t = t + "    ic32.Add(d.Replace("";"", Chr(10)))" + NL
    t = t + "    ic32s.Add(e.Replace("";"", Chr(10)))" + NL
    t = t + "    ic32g.Add(f.Replace("";"", Chr(10)))" + NL
    t = t + "    icTool.Add(g.Replace("";"", Chr(10)))" + NL
    t = t + "    icToolOff.Add(h.Replace("";"", Chr(10)))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
