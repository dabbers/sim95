' VAPOR|id=CHATFIX|name=Chat Fix: No More Crashes|kind=program|version=1a5da812|category=System|run=C:\PROGRAMS\CHAT.SPK|files=C:\SYSTEM\CHATFIX.TXT|tasks=|startup=|folder=|about=SIM95's Chat service stops with "Runtime error: Connection closed" when someone disconnects at the wrong moment, and the machine's chat is gone until it restarts. This fixes it: an answer to someone who has already left is simply dropped. And lines are handled strictly in the order they came.
' INSTALL.SPK - puts the Chat fix on this machine. Generated by tools/build-installer.mjs;
' edit the files in chatfix/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It fixes the
' Chat service (C:\PROGRAMS\CHATSVC.SPK, port 6667), which stops with
' "Runtime error in Sock_OnMessage: Connection closed" when it answers someone
' who has just disconnected. Only if it is the one SIM95 made: the original is
' kept as C:\PROGRAMS\CHATSVC.ORG. The service is restarted (whoever is
' connected has to connect again).

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)




    File0()
    Print("the Chat fix is installed (1 files).")
    ChatFix()

    Print("The Chat service is fixed and running.")
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "The Chat fix is installed: the Chat service no longer stops when someone disconnects." + NL
    t = t + "The original is C:\PROGRAMS\CHATSVC.ORG." + NL
    Put("C:\SYSTEM\CHATFIX.TXT")
END SUB

FUNCTION StockChat () AS String
    VAR s AS String
    s = s + "' CHATSVC.SPK - the Chat service, port 6667. Plain text lines:" + NL
    s = s + "'   NICK name | JOIN #chan | PART #chan | MSG #chan text | WHO #chan | QUIT" + NL
    s = s + "' Everyone in a channel gets: MSG #chan nick text | JOIN #chan nick | PART #chan nick |" + NL
    s = s + "' NICK #chan old new | WHO #chan a,b,c" + NL
    s = s + "" + NL
    s = s + "VAR sock AS NET_Socket" + NL
    s = s + "VAR conns AS Array OF NET_Connection" + NL
    s = s + "VAR nicks AS Array OF String" + NL
    s = s + "VAR chans AS Array OF String      ' per client: "",#a,#b,"" so a channel is found with Contains" + NL
    s = s + "" + NL
    s = s + "SUB Main ()" + NL
    s = s + "    sock = NET_Socket.New()" + NL
    s = s + "    sock.onConnect = Sock_OnConnect" + NL
    s = s + "    sock.onMessage = Sock_OnMessage" + NL
    s = s + "    sock.onClose = Sock_OnClose" + NL
    s = s + "    sock.Listen(6667)" + NL
    s = s + "END SUB" + NL
    s = s + "" + NL
    s = s + "SUB Sock_OnConnect (conn AS NET_Connection)" + NL
    s = s + "    conn.Accept()" + NL
    s = s + "    conns.Add(conn)" + NL
    s = s + "    nicks.Add(""guest"" + Str(100 + Rnd(900)))" + NL
    s = s + "    chans.Add("","")" + NL
    s = s + "    conn.Send(""OK Welcome to "" + NET.HostName + "" chat. You are "" + nicks[nicks.Count - 1] + "". Commands: NICK, JOIN, MSG, WHO, QUIT"")" + NL
    s = s + "END SUB" + NL
    s = s + "" + NL
    s = s + "SUB Sock_OnClose (conn AS NET_Connection)" + NL
    s = s + "    VAR i AS Integer" + NL
    s = s + "    i = conns.IndexOf(conn)" + NL
    s = s + "    IF i < 0 THEN RETURN" + NL
    s = s + "    LeaveAll(i)" + NL
    s = s + "    conns.RemoveAt(i)" + NL
    s = s + "    nicks.RemoveAt(i)" + NL
    s = s + "    chans.RemoveAt(i)" + NL
    s = s + "END SUB" + NL
    s = s + "" + NL
    s = s + "FUNCTION Clean (s AS String, allowed AS String, max AS Integer) AS String" + NL
    s = s + "    VAR out AS String" + NL
    s = s + "    VAR i AS Integer" + NL
    s = s + "    VAR c AS String" + NL
    s = s + "    out = """"" + NL
    s = s + "    FOR i = 0 TO s.Length - 1" + NL
    s = s + "        c = s.CharAt(i)" + NL
    s = s + "        IF allowed.Contains(c.Upper()) AND out.Length < max THEN out = out + c" + NL
    s = s + "    NEXT" + NL
    s = s + "    RETURN out" + NL
    s = s + "END FUNCTION" + NL
    s = s + "" + NL
    s = s + "FUNCTION Channel (s AS String) AS String" + NL
    s = s + "    VAR c AS String" + NL
    s = s + "    VAR name AS String" + NL
    s = s + "    c = s.Trim().Split("" "")[0]" + NL
    s = s + "    IF c = """" THEN RETURN """"" + NL
    s = s + "    IF NOT c.StartsWith(""#"") THEN c = ""#"" + c" + NL
    s = s + "    name = Clean(c, ""#ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-"", 16).Lower()" + NL
    s = s + "    IF name.Length > 1 THEN RETURN name" + NL
    s = s + "    RETURN """"" + NL
    s = s + "END FUNCTION" + NL
    s = s + "" + NL
    s = s + "FUNCTION Members (ch AS String) AS String" + NL
    s = s + "    VAR i AS Integer" + NL
    s = s + "    VAR out AS Array OF String" + NL
    s = s + "    FOR i = 0 TO conns.Count - 1" + NL
    s = s + "        IF chans[i].Contains("","" + ch + "","") THEN out.Add(nicks[i])" + NL
    s = s + "    NEXT" + NL
    s = s + "    RETURN out.Join("","")" + NL
    s = s + "END FUNCTION" + NL
    s = s + "" + NL
    s = s + "SUB Broadcast (ch AS String, line AS String)" + NL
    s = s + "    VAR i AS Integer" + NL
    s = s + "    FOR i = 0 TO conns.Count - 1" + NL
    s = s + "        IF chans[i].Contains("","" + ch + "","") AND conns[i].IsOpen THEN conns[i].Send(line)" + NL
    s = s + "    NEXT" + NL
    s = s + "END SUB" + NL
    s = s + "" + NL
    s = s + "SUB LeaveAll (i AS Integer)" + NL
    s = s + "    VAR ch AS String" + NL
    s = s + "    FOR EACH ch IN chans[i].Split("","")" + NL
    s = s + "        IF ch <> """" THEN Broadcast(ch, ""PART "" + ch + "" "" + nicks[i])" + NL
    s = s + "    NEXT" + NL
    s = s + "    chans[i] = "",""" + NL
    s = s + "END SUB" + NL
    s = s + "" + NL
    s = s + "SUB Sock_OnMessage (conn AS NET_Connection, message AS String)" + NL
    s = s + "    VAR i AS Integer" + NL
    s = s + "    VAR sp AS Integer" + NL
    s = s + "    VAR cmd AS String" + NL
    s = s + "    VAR rest AS String" + NL
    s = s + "    VAR ch AS String" + NL
    s = s + "    VAR nick AS String" + NL
    s = s + "    VAR old AS String" + NL
    s = s + "    VAR j AS Integer" + NL
    s = s + "    VAR text AS String" + NL
    s = s + "    i = conns.IndexOf(conn)" + NL
    s = s + "    IF i < 0 THEN RETURN" + NL
    s = s + "    sp = message.IndexOf("" "")" + NL
    s = s + "    cmd = message.Upper()" + NL
    s = s + "    rest = """"" + NL
    s = s + "    IF sp >= 0 THEN" + NL
    s = s + "        cmd = message.Substring(0, sp).Upper()" + NL
    s = s + "        rest = message.Substring(sp + 1, message.Length - sp - 1)" + NL
    s = s + "    END IF" + NL
    s = s + "    SELECT CASE cmd" + NL
    s = s + "        CASE ""NICK""" + NL
    s = s + "            nick = Clean(rest.Trim(), ""ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-"", 12)" + NL
    s = s + "            IF nick = """" THEN" + NL
    s = s + "                conn.Send(""ERR Bad nick"")" + NL
    s = s + "                RETURN" + NL
    s = s + "            END IF" + NL
    s = s + "            FOR j = 0 TO nicks.Count - 1" + NL
    s = s + "                IF j <> i AND nicks[j].Lower() = nick.Lower() THEN" + NL
    s = s + "                    conn.Send(""ERR Nick in use"")" + NL
    s = s + "                    RETURN" + NL
    s = s + "                END IF" + NL
    s = s + "            NEXT" + NL
    s = s + "            old = nicks[i]" + NL
    s = s + "            nicks[i] = nick" + NL
    s = s + "            conn.Send(""OK You are now "" + nick)" + NL
    s = s + "            FOR EACH ch IN chans[i].Split("","")" + NL
    s = s + "                IF ch <> """" THEN Broadcast(ch, ""NICK "" + ch + "" "" + old + "" "" + nick)" + NL
    s = s + "            NEXT" + NL
    s = s + "        CASE ""JOIN""" + NL
    s = s + "            ch = Channel(rest)" + NL
    s = s + "            IF ch = """" THEN" + NL
    s = s + "                conn.Send(""ERR Bad channel"")" + NL
    s = s + "                RETURN" + NL
    s = s + "            END IF" + NL
    s = s + "            IF NOT chans[i].Contains("","" + ch + "","") THEN chans[i] = chans[i] + ch + "",""" + NL
    s = s + "            Broadcast(ch, ""JOIN "" + ch + "" "" + nicks[i])" + NL
    s = s + "            conn.Send(""WHO "" + ch + "" "" + Members(ch))" + NL
    s = s + "        CASE ""PART""" + NL
    s = s + "            ch = Channel(rest)" + NL
    s = s + "            IF ch <> """" AND chans[i].Contains("","" + ch + "","") THEN" + NL
    s = s + "                chans[i] = chans[i].Replace("","" + ch + "","", "","")" + NL
    s = s + "                Broadcast(ch, ""PART "" + ch + "" "" + nicks[i])" + NL
    s = s + "            END IF" + NL
    s = s + "        CASE ""MSG""" + NL
    s = s + "            sp = rest.IndexOf("" "")" + NL
    s = s + "            text = """"" + NL
    s = s + "            ch = Channel(rest)" + NL
    s = s + "            IF sp >= 0 THEN text = rest.Substring(sp + 1, rest.Length - sp - 1)" + NL
    s = s + "            IF ch = """" OR NOT chans[i].Contains("","" + ch + "","") THEN" + NL
    s = s + "                conn.Send(""ERR Join the channel first"")" + NL
    s = s + "                RETURN" + NL
    s = s + "            END IF" + NL
    s = s + "            IF text.Length > 400 THEN text = text.Substring(0, 400)" + NL
    s = s + "            IF text.Trim() <> """" THEN Broadcast(ch, ""MSG "" + ch + "" "" + nicks[i] + "" "" + text)" + NL
    s = s + "        CASE ""WHO""" + NL
    s = s + "            ch = Channel(rest)" + NL
    s = s + "            IF ch <> """" THEN" + NL
    s = s + "                conn.Send(""WHO "" + ch + "" "" + Members(ch))" + NL
    s = s + "            ELSE" + NL
    s = s + "                conn.Send(""WHO * "" + nicks.Join("",""))" + NL
    s = s + "            END IF" + NL
    s = s + "        CASE ""QUIT""" + NL
    s = s + "            LeaveAll(i)" + NL
    s = s + "            conn.Send(""OK Bye"")" + NL
    s = s + "            conn.Close()" + NL
    s = s + "        CASE ELSE" + NL
    s = s + "            conn.Send(""ERR Unknown command"")" + NL
    s = s + "    END SELECT" + NL
    s = s + "END SUB" + NL
    RETURN s
END FUNCTION

FUNCTION FixedChat () AS String
    VAR s AS String
    s = s + "' CHATSVC.SPK - the Chat service, port 6667. Plain text lines:" + NL
    s = s + "'   NICK name | JOIN #chan | PART #chan | MSG #chan text | WHO #chan | QUIT" + NL
    s = s + "' Everyone in a channel gets: MSG #chan nick text | JOIN #chan nick | PART #chan nick |" + NL
    s = s + "' NICK #chan old new | WHO #chan a,b,c" + NL
    s = s + "'" + NL
    s = s + "' (CHATFIX) A client can be gone by the time its answer goes out: Chat's" + NL
    s = s + "' Disconnect sends QUIT and closes at once, so ""OK Bye"" went to a closed" + NL
    s = s + "' connection, and that stopped the whole service with ""Connection closed""." + NL
    s = s + "' Every line to a client now goes through Tell, which lets that pass." + NL
    s = s + "'" + NL
    s = s + "' And lines are handled in the order they came. Each message is a task of" + NL
    s = s + "' its own, and a task is paused every 512 statements, so a long line's task" + NL
    s = s + "' could finish after a short one sent later: four MSGs reached the room" + NL
    s = s + "' shuffled, and a JOIN right after NICK went out under the old name. Now a" + NL
    s = s + "' message (or a goodbye) only joins a queue, and whichever task finds no one" + NL
    s = s + "' working on the queue works through it, first come first served." + NL
    s = s + "" + NL
    s = s + "VAR sock AS NET_Socket" + NL
    s = s + "VAR conns AS Array OF NET_Connection" + NL
    s = s + "VAR nicks AS Array OF String" + NL
    s = s + "VAR chans AS Array OF String      ' per client: "",#a,#b,"" so a channel is found with Contains" + NL
    s = s + "VAR qConn AS Array OF NET_Connection   ' lines waiting their turn, and who sent them" + NL
    s = s + "VAR qLine AS Array OF String            ' (Chr(0) for a goodbye: the connection closed)" + NL
    s = s + "VAR working AS Bool" + NL
    s = s + "" + NL
    s = s + "SUB Main ()" + NL
    s = s + "    sock = NET_Socket.New()" + NL
    s = s + "    sock.onConnect = Sock_OnConnect" + NL
    s = s + "    sock.onMessage = Sock_OnMessage" + NL
    s = s + "    sock.onClose = Sock_OnClose" + NL
    s = s + "    sock.Listen(6667)" + NL
    s = s + "END SUB" + NL
    s = s + "" + NL
    s = s + "SUB Sock_OnConnect (conn AS NET_Connection)" + NL
    s = s + "    ' (the client is known before anything it sends can be handled)" + NL
    s = s + "    conns.Add(conn)" + NL
    s = s + "    nicks.Add(""guest"" + Str(100 + Rnd(900)))" + NL
    s = s + "    chans.Add("","")" + NL
    s = s + "    conn.Accept()" + NL
    s = s + "    Tell(conn, ""OK Welcome to "" + NET.HostName + "" chat. You are "" + nicks[nicks.Count - 1] + "". Commands: NICK, JOIN, MSG, WHO, QUIT"")" + NL
    s = s + "END SUB" + NL
    s = s + "" + NL
    s = s + "SUB Sock_OnClose (conn AS NET_Connection)" + NL
    s = s + "    Queue(conn, Chr(0))" + NL
    s = s + "END SUB" + NL
    s = s + "" + NL
    s = s + "SUB Sock_OnMessage (conn AS NET_Connection, message AS String)" + NL
    s = s + "    Queue(conn, message)" + NL
    s = s + "END SUB" + NL
    s = s + "" + NL
    s = s + "' Into the queue; then, if nobody is working through it, this task does." + NL
    s = s + "' (Looked at again after stopping: a line that came in just then isn't left.)" + NL
    s = s + "SUB Queue (conn AS NET_Connection, message AS String)" + NL
    s = s + "    VAR c AS NET_Connection" + NL
    s = s + "    VAR m AS String" + NL
    s = s + "    qConn.Add(conn)" + NL
    s = s + "    qLine.Add(message)" + NL
    s = s + "    WHILE qLine.Count > 0 AND NOT working" + NL
    s = s + "        working = TRUE" + NL
    s = s + "        WHILE qLine.Count > 0" + NL
    s = s + "            c = qConn[0]" + NL
    s = s + "            m = qLine[0]" + NL
    s = s + "            qConn.RemoveAt(0)" + NL
    s = s + "            qLine.RemoveAt(0)" + NL
    s = s + "            IF m = Chr(0) THEN" + NL
    s = s + "                Gone(c)" + NL
    s = s + "            ELSE" + NL
    s = s + "                Handle(c, m)" + NL
    s = s + "            END IF" + NL
    s = s + "        END WHILE" + NL
    s = s + "        working = FALSE" + NL
    s = s + "    END WHILE" + NL
    s = s + "END SUB" + NL
    s = s + "" + NL
    s = s + "SUB Gone (conn AS NET_Connection)" + NL
    s = s + "    VAR i AS Integer" + NL
    s = s + "    i = conns.IndexOf(conn)" + NL
    s = s + "    IF i < 0 THEN RETURN" + NL
    s = s + "    LeaveAll(i)" + NL
    s = s + "    conns.RemoveAt(i)" + NL
    s = s + "    nicks.RemoveAt(i)" + NL
    s = s + "    chans.RemoveAt(i)" + NL
    s = s + "END SUB" + NL
    s = s + "" + NL
    s = s + "FUNCTION Clean (s AS String, allowed AS String, max AS Integer) AS String" + NL
    s = s + "    VAR out AS String" + NL
    s = s + "    VAR i AS Integer" + NL
    s = s + "    VAR c AS String" + NL
    s = s + "    out = """"" + NL
    s = s + "    FOR i = 0 TO s.Length - 1" + NL
    s = s + "        c = s.CharAt(i)" + NL
    s = s + "        IF allowed.Contains(c.Upper()) AND out.Length < max THEN out = out + c" + NL
    s = s + "    NEXT" + NL
    s = s + "    RETURN out" + NL
    s = s + "END FUNCTION" + NL
    s = s + "" + NL
    s = s + "FUNCTION Channel (s AS String) AS String" + NL
    s = s + "    VAR c AS String" + NL
    s = s + "    VAR name AS String" + NL
    s = s + "    c = s.Trim().Split("" "")[0]" + NL
    s = s + "    IF c = """" THEN RETURN """"" + NL
    s = s + "    IF NOT c.StartsWith(""#"") THEN c = ""#"" + c" + NL
    s = s + "    name = Clean(c, ""#ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-"", 16).Lower()" + NL
    s = s + "    IF name.Length > 1 THEN RETURN name" + NL
    s = s + "    RETURN """"" + NL
    s = s + "END FUNCTION" + NL
    s = s + "" + NL
    s = s + "FUNCTION Members (ch AS String) AS String" + NL
    s = s + "    VAR i AS Integer" + NL
    s = s + "    VAR out AS Array OF String" + NL
    s = s + "    FOR i = 0 TO conns.Count - 1" + NL
    s = s + "        IF chans[i].Contains("","" + ch + "","") THEN out.Add(nicks[i])" + NL
    s = s + "    NEXT" + NL
    s = s + "    RETURN out.Join("","")" + NL
    s = s + "END FUNCTION" + NL
    s = s + "" + NL
    s = s + "' A line to one client; nothing (and no error) if it has already gone." + NL
    s = s + "SUB Tell (conn AS NET_Connection, line AS String)" + NL
    s = s + "    TRY" + NL
    s = s + "        IF conn.IsOpen THEN conn.Send(line)" + NL
    s = s + "    CATCH err" + NL
    s = s + "    END TRY" + NL
    s = s + "END SUB" + NL
    s = s + "" + NL
    s = s + "SUB Broadcast (ch AS String, line AS String)" + NL
    s = s + "    VAR i AS Integer" + NL
    s = s + "    FOR i = 0 TO conns.Count - 1" + NL
    s = s + "        IF chans[i].Contains("","" + ch + "","") THEN Tell(conns[i], line)" + NL
    s = s + "    NEXT" + NL
    s = s + "END SUB" + NL
    s = s + "" + NL
    s = s + "SUB LeaveAll (i AS Integer)" + NL
    s = s + "    VAR ch AS String" + NL
    s = s + "    FOR EACH ch IN chans[i].Split("","")" + NL
    s = s + "        IF ch <> """" THEN Broadcast(ch, ""PART "" + ch + "" "" + nicks[i])" + NL
    s = s + "    NEXT" + NL
    s = s + "    chans[i] = "",""" + NL
    s = s + "END SUB" + NL
    s = s + "" + NL
    s = s + "SUB Handle (conn AS NET_Connection, message AS String)" + NL
    s = s + "    VAR i AS Integer" + NL
    s = s + "    VAR sp AS Integer" + NL
    s = s + "    VAR cmd AS String" + NL
    s = s + "    VAR rest AS String" + NL
    s = s + "    VAR ch AS String" + NL
    s = s + "    VAR nick AS String" + NL
    s = s + "    VAR old AS String" + NL
    s = s + "    VAR j AS Integer" + NL
    s = s + "    VAR text AS String" + NL
    s = s + "    i = conns.IndexOf(conn)" + NL
    s = s + "    IF i < 0 THEN RETURN" + NL
    s = s + "    sp = message.IndexOf("" "")" + NL
    s = s + "    cmd = message.Upper()" + NL
    s = s + "    rest = """"" + NL
    s = s + "    IF sp >= 0 THEN" + NL
    s = s + "        cmd = message.Substring(0, sp).Upper()" + NL
    s = s + "        rest = message.Substring(sp + 1, message.Length - sp - 1)" + NL
    s = s + "    END IF" + NL
    s = s + "    SELECT CASE cmd" + NL
    s = s + "        CASE ""NICK""" + NL
    s = s + "            nick = Clean(rest.Trim(), ""ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-"", 12)" + NL
    s = s + "            IF nick = """" THEN" + NL
    s = s + "                Tell(conn, ""ERR Bad nick"")" + NL
    s = s + "                RETURN" + NL
    s = s + "            END IF" + NL
    s = s + "            FOR j = 0 TO nicks.Count - 1" + NL
    s = s + "                IF j <> i AND nicks[j].Lower() = nick.Lower() THEN" + NL
    s = s + "                    Tell(conn, ""ERR Nick in use"")" + NL
    s = s + "                    RETURN" + NL
    s = s + "                END IF" + NL
    s = s + "            NEXT" + NL
    s = s + "            old = nicks[i]" + NL
    s = s + "            nicks[i] = nick" + NL
    s = s + "            Tell(conn, ""OK You are now "" + nick)" + NL
    s = s + "            FOR EACH ch IN chans[i].Split("","")" + NL
    s = s + "                IF ch <> """" THEN Broadcast(ch, ""NICK "" + ch + "" "" + old + "" "" + nick)" + NL
    s = s + "            NEXT" + NL
    s = s + "        CASE ""JOIN""" + NL
    s = s + "            ch = Channel(rest)" + NL
    s = s + "            IF ch = """" THEN" + NL
    s = s + "                Tell(conn, ""ERR Bad channel"")" + NL
    s = s + "                RETURN" + NL
    s = s + "            END IF" + NL
    s = s + "            IF NOT chans[i].Contains("","" + ch + "","") THEN chans[i] = chans[i] + ch + "",""" + NL
    s = s + "            Broadcast(ch, ""JOIN "" + ch + "" "" + nicks[i])" + NL
    s = s + "            Tell(conn, ""WHO "" + ch + "" "" + Members(ch))" + NL
    s = s + "        CASE ""PART""" + NL
    s = s + "            ch = Channel(rest)" + NL
    s = s + "            IF ch <> """" AND chans[i].Contains("","" + ch + "","") THEN" + NL
    s = s + "                chans[i] = chans[i].Replace("","" + ch + "","", "","")" + NL
    s = s + "                Broadcast(ch, ""PART "" + ch + "" "" + nicks[i])" + NL
    s = s + "            END IF" + NL
    s = s + "        CASE ""MSG""" + NL
    s = s + "            sp = rest.IndexOf("" "")" + NL
    s = s + "            text = """"" + NL
    s = s + "            ch = Channel(rest)" + NL
    s = s + "            IF sp >= 0 THEN text = rest.Substring(sp + 1, rest.Length - sp - 1)" + NL
    s = s + "            IF ch = """" OR NOT chans[i].Contains("","" + ch + "","") THEN" + NL
    s = s + "                Tell(conn, ""ERR Join the channel first"")" + NL
    s = s + "                RETURN" + NL
    s = s + "            END IF" + NL
    s = s + "            IF text.Length > 400 THEN text = text.Substring(0, 400)" + NL
    s = s + "            IF text.Trim() <> """" THEN Broadcast(ch, ""MSG "" + ch + "" "" + nicks[i] + "" "" + text)" + NL
    s = s + "        CASE ""WHO""" + NL
    s = s + "            ch = Channel(rest)" + NL
    s = s + "            IF ch <> """" THEN" + NL
    s = s + "                Tell(conn, ""WHO "" + ch + "" "" + Members(ch))" + NL
    s = s + "            ELSE" + NL
    s = s + "                Tell(conn, ""WHO * "" + nicks.Join("",""))" + NL
    s = s + "            END IF" + NL
    s = s + "        CASE ""QUIT""" + NL
    s = s + "            LeaveAll(i)" + NL
    s = s + "            Tell(conn, ""OK Bye"")" + NL
    s = s + "            TRY" + NL
    s = s + "                conn.Close()" + NL
    s = s + "            CATCH err" + NL
    s = s + "            END TRY" + NL
    s = s + "        CASE ELSE" + NL
    s = s + "            Tell(conn, ""ERR Unknown command"")" + NL
    s = s + "    END SELECT" + NL
    s = s + "END SUB" + NL
    RETURN s
END FUNCTION

SUB StartService (name AS String, program AS String, runFile AS String)
    VAR task AS String
    FS.Write("C:\SYSTEM\STARTUP\" + runFile, program)
    Print("  " + name + " will start with the machine (C:\SYSTEM\STARTUP\" + runFile + ")")
    FOR EACH task IN SYS.Tasks()
        IF task.Split("|")[1].Upper() = name THEN
            SYS.Kill(Int(Val(task.Split("|")[0])))
            Print("  stopped the old " + name)
        END IF
    NEXT
    SYS.Run(program)
    Print("  started " + program)
END SUB

SUB ChatFix ()
    VAR now AS String
    IF NOT FS.Exists("C:\PROGRAMS\CHATSVC.SPK") THEN
        Print("There's no C:\PROGRAMS\CHATSVC.SPK to fix.")
        RETURN
    END IF
    now = FS.Read("C:\PROGRAMS\CHATSVC.SPK").Replace(Chr(13), "")
    IF now.Trim() = FixedChat().Trim() THEN
        Print("The Chat service already has the fix.")
        RETURN
    END IF
    IF now.Trim() <> StockChat().Trim() AND NOT now.Contains("(CHATFIX)") THEN
        Print("The Chat service has been changed since SIM95 made it, so it was left alone.")
        RETURN
    END IF
    IF NOT FS.Exists("C:\PROGRAMS\CHATSVC.ORG") AND NOT now.Contains("(CHATFIX)") THEN FS.Write("C:\PROGRAMS\CHATSVC.ORG", now)
    FS.Write("C:\PROGRAMS\CHATSVC.SPK", FixedChat())
    Print("Fixed C:\PROGRAMS\CHATSVC.SPK (the original is CHATSVC.ORG).")
    StartService("CHATSVC", "C:\PROGRAMS\CHATSVC.SPK", "CHAT.RUN")
END SUB
