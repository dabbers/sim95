' VAPOR|id=FILEFIX|name=Files Fix: Copy and Paste Anywhere|kind=program|version=e030bb75|category=System|run=C:\PROGRAMS\FILES.SPK|files=C:\SYSTEM\FILEFIX.TXT|tasks=|startup=|folder=|about=Copy a file in one Files window and Paste it in another: from your disk to another machine's, or back. SIM95's Files keeps what you copied in each window, so Paste in a second window (the Network window opens one) does nothing. This keeps it in C:\SYSTEM\FILECLIP.TXT instead.
' INSTALL.SPK - puts the Files fix on this machine. Generated by tools/build-installer.mjs;
' edit the files in filefix/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It changes Copy
' and Paste in Files (C:\PROGRAMS\FILES.SPK) so they work between windows:
' copy a file on your disk, open another machine from Network, and paste it
' there. What you copy is kept in C:\SYSTEM\FILECLIP.TXT. Only those two
' SUBs change, and only if they are as SIM95 made them; the original is kept as
' C:\PROGRAMS\FILES.ORG (copy it back over FILES.SPK to undo this).

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)




    File0()
    Print("the Files fix is installed (1 files).")
    FilesFix()

    Print("Open Files, copy a file, and paste it in another Files window: on this disk or another machine's.")
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "The Files fix is installed: Copy and Paste in Files work between windows." + NL
    t = t + "The original Files is C:\PROGRAMS\FILES.ORG." + NL
    Put("C:\SYSTEM\FILEFIX.TXT")
END SUB

FUNCTION StockCopyPaste () AS String
    VAR s AS String
    s = s + "SUB Copy ()" + NL
    s = s + "    VAR i AS Integer" + NL
    s = s + "    i = Selected()" + NL
    s = s + "    IF i < 0 OR eDirs[i] THEN RETURN" + NL
    s = s + "    clipboard = ePaths[i]" + NL
    s = s + "    win.Status = ""Copied "" + eNames[i] + "" - Paste into a folder""" + NL
    s = s + "END SUB" + NL
    s = s + "" + NL
    s = s + "SUB Paste ()" + NL
    s = s + "    VAR text AS String" + NL
    s = s + "    VAR target AS String" + NL
    s = s + "    IF clipboard = """" THEN RETURN" + NL
    s = s + "    TRY" + NL
    s = s + "        IF IsUnc(clipboard) THEN" + NL
    s = s + "            text = Ask(UncHost(clipboard), ""READ "" + UncPath(clipboard))" + NL
    s = s + "        ELSE" + NL
    s = s + "            text = FS.Read(clipboard)" + NL
    s = s + "        END IF" + NL
    s = s + "        IF IsUnc(cwd) THEN" + NL
    s = s + "            target = JoinPath(UncPath(cwd), BaseName(clipboard))" + NL
    s = s + "            Ask(UncHost(cwd), ""WRITE "" + target + Chr(10) + text)" + NL
    s = s + "        ELSE" + NL
    s = s + "            FS.Write(JoinPath(cwd, BaseName(clipboard)), text)" + NL
    s = s + "        END IF" + NL
    s = s + "        Refresh()" + NL
    s = s + "    CATCH err" + NL
    s = s + "        ShowError(err)" + NL
    s = s + "    END TRY" + NL
    s = s + "END SUB" + NL
    RETURN s.Substring(0, s.Length - 1)
END FUNCTION

FUNCTION FixedCopyPaste () AS String
    VAR s AS String
    s = s + "' Copy keeps the file itself, its name on the first line, in" + NL
    s = s + "' C:\SYSTEM\FILECLIP.TXT, which every Files window shares: so Paste works in" + NL
    s = s + "' another window, and with files from another machine. (FILEFIX)" + NL
    s = s + "SUB Copy ()" + NL
    s = s + "    VAR i AS Integer" + NL
    s = s + "    VAR text AS String" + NL
    s = s + "    i = Selected()" + NL
    s = s + "    IF i < 0 THEN RETURN" + NL
    s = s + "    IF eDirs[i] THEN" + NL
    s = s + "        win.Status = ""Copy works on files, not folders: open "" + eNames[i] + "" and copy its files""" + NL
    s = s + "        RETURN" + NL
    s = s + "    END IF" + NL
    s = s + "    TRY" + NL
    s = s + "        IF IsUnc(ePaths[i]) THEN" + NL
    s = s + "            text = Ask(UncHost(ePaths[i]), ""READ "" + UncPath(ePaths[i]))" + NL
    s = s + "        ELSE" + NL
    s = s + "            text = FS.Read(ePaths[i])" + NL
    s = s + "        END IF" + NL
    s = s + "        FS.Write(""C:\SYSTEM\FILECLIP.TXT"", BaseName(ePaths[i]) + Chr(10) + text)" + NL
    s = s + "        clipboard = ePaths[i]" + NL
    s = s + "        win.Status = ""Copied "" + eNames[i] + "" - Paste it into a folder, in any Files window""" + NL
    s = s + "    CATCH err" + NL
    s = s + "        ShowError(err)" + NL
    s = s + "    END TRY" + NL
    s = s + "END SUB" + NL
    s = s + "" + NL
    s = s + "SUB Paste ()" + NL
    s = s + "    VAR clip AS String" + NL
    s = s + "    VAR name AS String" + NL
    s = s + "    VAR text AS String" + NL
    s = s + "    VAR k AS Integer" + NL
    s = s + "    IF NOT FS.Exists(""C:\SYSTEM\FILECLIP.TXT"") THEN" + NL
    s = s + "        win.Status = ""Nothing to paste: Copy a file first""" + NL
    s = s + "        RETURN" + NL
    s = s + "    END IF" + NL
    s = s + "    TRY" + NL
    s = s + "        clip = FS.Read(""C:\SYSTEM\FILECLIP.TXT"")" + NL
    s = s + "        k = clip.IndexOf(Chr(10))" + NL
    s = s + "        IF k < 1 THEN THROW ""Nothing to paste: Copy a file first""" + NL
    s = s + "        name = clip.Substring(0, k)" + NL
    s = s + "        text = clip.Substring(k + 1, clip.Length - k - 1)" + NL
    s = s + "        IF IsUnc(cwd) THEN" + NL
    s = s + "            Ask(UncHost(cwd), ""WRITE "" + JoinPath(UncPath(cwd), name) + Chr(10) + text)" + NL
    s = s + "        ELSE" + NL
    s = s + "            FS.Write(JoinPath(cwd, name), text)" + NL
    s = s + "        END IF" + NL
    s = s + "        Refresh()" + NL
    s = s + "        win.Status = ""Pasted "" + name" + NL
    s = s + "    CATCH err" + NL
    s = s + "        ShowError(err)" + NL
    s = s + "    END TRY" + NL
    s = s + "END SUB" + NL
    RETURN s.Substring(0, s.Length - 1)
END FUNCTION

SUB FilesFix ()
    VAR src AS String
    IF NOT FS.Exists("C:\PROGRAMS\FILES.SPK") THEN
        Print("There's no C:\PROGRAMS\FILES.SPK to fix.")
        RETURN
    END IF
    src = FS.Read("C:\PROGRAMS\FILES.SPK").Replace(Chr(13), "")
    IF src.Contains("(FILEFIX)") THEN
        Print("Files already has the fix.")
        RETURN
    END IF
    IF NOT src.Contains(StockCopyPaste()) THEN
        Print("Files has been changed since SIM95 made it, so it was left alone: Copy and Paste in it are not the ones this fixes.")
        RETURN
    END IF
    IF NOT FS.Exists("C:\PROGRAMS\FILES.ORG") THEN FS.Write("C:\PROGRAMS\FILES.ORG", src)
    FS.Write("C:\PROGRAMS\FILES.SPK", src.Replace(StockCopyPaste(), FixedCopyPaste()))
    Print("Fixed Copy and Paste in C:\PROGRAMS\FILES.SPK (the original is FILES.ORG).")
END SUB
