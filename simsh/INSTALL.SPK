' VAPOR|id=SIMSH|name=Sim Shell|kind=program|version=9d54fccb|category=System|run=C:\PROGRAMS\SIMSH.SPK|files=C:\PROGRAMS\SIMSH.SPK;C:\PROGRAMS\SSHD.SPK|tasks=SIMSH;SSHD|startup=SSHD.RUN|folder=|about=A bash-like shell for SIM95: ls, cd, cat, grep, pipes, redirects, variables, aliases and .SH scripts, plus ssh/scp over the network (rsh with a password; not secure) and sim-get, an apt-like front end to the Vapor store. Installs the sshd server too.
' INSTALL.SPK - puts Sim Shell on this machine. Generated by tools/build-installer.mjs;
' edit the files in simsh/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It writes the Sim
' Shell to C:\PROGRAMS\SIMSH.SPK and its remote-shell server to
' C:\PROGRAMS\SSHD.SPK, both sharing one shell engine, starts the server, and
' adds it to C:\SYSTEM\STARTUP\SSHD.RUN so it runs whenever the machine does.
' It writes an example C:\SYSTEM\SIMSHRC.SH the first time only. The shell
' then opens. SSHD is rsh with a password: not secure (see README.md).

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)



    MakeRc()
    File0()
    File1()
    Print("Sim Shell is installed (2 files).")
    StartService("SSHD", "C:\PROGRAMS\SSHD.SPK", "SSHD.RUN")
    SYS.Start("C:\PROGRAMS\SIMSH.SPK", "")

    Print("The Sim Shell is open, and sshd is listening on port 22. Next time, start C:\PROGRAMS\SIMSH.SPK from Files.")
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "' CORE.SPK - the Sim Shell's engine: it reads a command line, runs it, and" + NL
    t = t + "' hands back the text it printed. No window and no socket, so the shell window" + NL
    t = t + "' (SIMSH.SPK) and the remote shell server (SSHD.SPK) both carry this same code;" + NL
    t = t + "' tools/build-installer.mjs puts it at the top of each." + NL
    t = t + "'" + NL
    t = t + "'   ShInit(user, host)    once, at the start" + NL
    t = t + "'   ShStart(line)         queue a command line (; && || between pipelines)" + NL
    t = t + "'   ShStep()              run the next pipeline; TRUE while there is more to do" + NL
    t = t + "'   ShRun(line)           all of the above at once, for a headless caller" + NL
    t = t + "'   shOut                 what has been printed so far (the caller empties it)" + NL
    t = t + "'" + NL
    t = t + "' A command that needs the network (ssh, scp, sim-get update/install/upgrade, host)" + NL
    t = t + "' is not run here: it sets jobWant and the rest of its pipeline waits until" + NL
    t = t + "' the caller runs the job and calls ShResume with the job's output." + NL
    t = t + "'" + NL
    t = t + "' Paths: /programs/notes.spk and C:\PROGRAMS\NOTES.SPK are the same file; ~ is" + NL
    t = t + "' $HOME (C:\MYFILES). There is no backslash escaping, so DOS paths type as is." + NL
    t = t + "" + NL
    t = t + "CONST SHVERSION = ""1.0""" + NL
    t = t + "CONST RCFILE = ""C:\SYSTEM\SIMSHRC.SH""" + NL
    t = t + "CONST HISTFILE = ""C:\SYSTEM\SHHIST.TXT""" + NL
    t = t + "CONST GAMEDIR = ""C:\GAMES""" + NL
    t = t + "CONST VAPORME = ""C:\PROGRAMS\VAPOR.SPK""" + NL
    t = t + "CONST WEBAPPSINI = ""C:\SYSTEM\WEBAPPS.INI""" + NL
    t = t + "CONST GETCACHE = ""C:\SYSTEM\SIMGET.TXT""" + NL
    t = t + "" + NL
    t = t + "VAR EOL AS String" + NL
    t = t + "VAR shCwd AS String = ""C:\MYFILES""" + NL
    t = t + "VAR shPrev AS String" + NL
    t = t + "VAR shUser AS String" + NL
    t = t + "VAR shHost AS String" + NL
    t = t + "VAR shStatus AS Integer" + NL
    t = t + "VAR shOut AS String" + NL
    t = t + "VAR shClear AS Bool             ' ""clear"" was typed: the window empties its screen" + NL
    t = t + "VAR shExit AS Bool              ' ""exit"" was typed" + NL
    t = t + "VAR shTty AS Bool               ' this command's output goes to the screen" + NL
    t = t + "VAR shRemote AS Bool            ' running inside SSHD: no waiting, no jobs" + NL
    t = t + "VAR varNames AS Array OF String" + NL
    t = t + "VAR varVals AS Array OF String" + NL
    t = t + "VAR expNames AS Array OF String" + NL
    t = t + "VAR aliasNames AS Array OF String" + NL
    t = t + "VAR aliasVals AS Array OF String" + NL
    t = t + "VAR hist AS Array OF String" + NL
    t = t + "VAR posArgs AS Array OF String  ' $1..$9 in a script" + NL
    t = t + "VAR queue AS Array OF String    ' pipelines waiting: op + Chr(1) + text" + NL
    t = t + "VAR lexWords AS Array OF String" + NL
    t = t + "VAR lexWild AS Array OF String  ' ""1"" when the word had an unquoted * or ?" + NL
    t = t + "VAR lexOps AS Array OF String   ' """" for a word, or > >> <" + NL
    t = t + "" + NL
    t = t + "' a pipeline waiting for a job" + NL
    t = t + "VAR jobWant AS Bool" + NL
    t = t + "VAR jobKind AS String           ' ssh, sshi, scp, get, host" + NL
    t = t + "VAR jobArgs AS Array OF String" + NL
    t = t + "VAR pendStages AS Array OF String" + NL
    t = t + "VAR pendIdx AS Integer" + NL
    t = t + "VAR pendFile AS String" + NL
    t = t + "VAR pendAppend AS Bool" + NL
    t = t + "" + NL
    t = t + "' ================================================================ start" + NL
    t = t + "" + NL
    t = t + "SUB ShInit (user AS String, host AS String)" + NL
    t = t + "    EOL = Chr(10)" + NL
    t = t + "    shUser = user" + NL
    t = t + "    shHost = host" + NL
    t = t + "    IF shUser = """" THEN shUser = ""user""" + NL
    t = t + "    SetVar(""HOME"", ""C:\MYFILES"")" + NL
    t = t + "    SetVar(""PATH"", ""C:\PROGRAMS;C:\MYFILES"")" + NL
    t = t + "    SetVar(""USER"", shUser)" + NL
    t = t + "    SetVar(""HOSTNAME"", shHost)" + NL
    t = t + "    SetVar(""SHELL"", ""C:\PROGRAMS\SIMSH.SPK"")" + NL
    t = t + "    SetVar(""PWD"", shCwd)" + NL
    t = t + "    expNames = [""HOME"", ""PATH"", ""USER"", ""HOSTNAME"", ""SHELL"", ""PWD""]" + NL
    t = t + "    IF NOT FS.Exists(shCwd) THEN shCwd = ""C:\""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The user name from C:\SYSTEM\USERS.INI, as the Files service reads it." + NL
    t = t + "FUNCTION MachineUser () AS String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    TRY" + NL
    t = t + "        FOR EACH ln IN FS.Read(""C:\SYSTEM\USERS.INI"").Lines()" + NL
    t = t + "            ln = ln.Trim()" + NL
    t = t + "            IF ln.Lower().StartsWith(""name="") THEN RETURN ln.Substring(5, ln.Length - 5).Trim()" + NL
    t = t + "        NEXT" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is user|password this machine's account? (FILESVC.SPK's CheckLogin.)" + NL
    t = t + "FUNCTION CheckLogin (user AS String, password AS String) AS Bool" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR pass AS String" + NL
    t = t + "    TRY" + NL
    t = t + "        FOR EACH ln IN FS.Read(""C:\SYSTEM\USERS.INI"").Lines()" + NL
    t = t + "            ln = ln.Trim()" + NL
    t = t + "            IF ln.Lower().StartsWith(""name="") THEN name = ln.Substring(5, ln.Length - 5).Trim()" + NL
    t = t + "            IF ln.Lower().StartsWith(""password="") THEN pass = ln.Substring(9, ln.Length - 9)" + NL
    t = t + "        NEXT" + NL
    t = t + "    CATCH err" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF name = """" THEN RETURN FALSE" + NL
    t = t + "    RETURN name.Lower() = user.Trim().Lower() AND pass = password" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Prompt () AS String" + NL
    t = t + "    RETURN shUser + ""@"" + shHost + "":"" + shCwd + ""$""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Queue a line typed at the prompt (it goes in the history)." + NL
    t = t + "SUB ShStart (line AS String)" + NL
    t = t + "    IF line.Trim() <> """" THEN" + NL
    t = t + "        hist.Add(line)" + NL
    t = t + "        IF hist.Count > 200 THEN hist.RemoveAt(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    QueueLines(line, FALSE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Put the pipelines of some lines at the front of the queue." + NL
    t = t + "SUB QueueLines (text AS String, atBack AS Bool)" + NL
    t = t + "    VAR items AS Array OF String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    VAR it AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR EACH ln IN text.Lines()" + NL
    t = t + "        FOR EACH it IN SplitLine(ln)" + NL
    t = t + "            items.Add(it)" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF atBack THEN" + NL
    t = t + "        FOR EACH it IN items" + NL
    t = t + "            queue.Add(it)" + NL
    t = t + "        NEXT" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = items.Count - 1 TO 0 STEP -1" + NL
    t = t + "        queue.Insert(0, items[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ShBusy () AS Bool" + NL
    t = t + "    RETURN queue.Count > 0 OR jobWant" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Run the next pipeline in the queue." + NL
    t = t + "FUNCTION ShStep () AS Bool" + NL
    t = t + "    VAR it AS String" + NL
    t = t + "    VAR op AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR cut AS Integer" + NL
    t = t + "    IF jobWant THEN RETURN TRUE" + NL
    t = t + "    IF queue.Count = 0 THEN RETURN FALSE" + NL
    t = t + "    it = queue[0]" + NL
    t = t + "    queue.RemoveAt(0)" + NL
    t = t + "    cut = it.IndexOf(Chr(1))" + NL
    t = t + "    op = it.Substring(0, cut)" + NL
    t = t + "    text = it.Substring(cut + 1, it.Length - cut - 1)" + NL
    t = t + "    IF op = ""args"" THEN" + NL
    t = t + "        posArgs = text.Split(Chr(2))" + NL
    t = t + "        IF text = """" THEN posArgs.Clear()" + NL
    t = t + "    ELSEIF op = ""&&"" AND shStatus <> 0 THEN" + NL
    t = t + "        ' skipped" + NL
    t = t + "    ELSEIF op = ""||"" AND shStatus = 0 THEN" + NL
    t = t + "        ' skipped" + NL
    t = t + "    ELSE" + NL
    t = t + "        shOut = shOut + RunPipe(SplitPipe(text), 0, """", TRUE)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF shExit THEN queue.Clear()" + NL
    t = t + "    RETURN queue.Count > 0 OR jobWant" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Everything at once. A job can't run here, so it fails." + NL
    t = t + "FUNCTION ShRun (line AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    ShStart(line)" + NL
    t = t + "    WHILE ShStep()" + NL
    t = t + "        IF jobWant THEN JobRefuse()" + NL
    t = t + "    END WHILE" + NL
    t = t + "    out = shOut" + NL
    t = t + "    shOut = """"" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JobRefuse ()" + NL
    t = t + "    VAR what AS String" + NL
    t = t + "    what = jobKind" + NL
    t = t + "    IF what = ""get"" THEN what = ""sim-get""" + NL
    t = t + "    IF what = ""sshi"" THEN" + NL
    t = t + "        Complain(""ssh: an interactive session needs the Sim Shell window; try ssh host command"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        Complain(what + "": needs the network; run it in the Sim Shell window"")" + NL
    t = t + "    END IF" + NL
    t = t + "    ShResume("""", 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A job finished: its output goes on down the pipeline that was waiting for it." + NL
    t = t + "SUB ShResume (out AS String, status AS Integer)" + NL
    t = t + "    VAR stages AS Array OF String" + NL
    t = t + "    jobWant = FALSE" + NL
    t = t + "    shStatus = status" + NL
    t = t + "    IF pendFile <> """" THEN" + NL
    t = t + "        TRY" + NL
    t = t + "            IF pendAppend AND FS.Exists(pendFile) THEN" + NL
    t = t + "                FS.Append(pendFile, out)" + NL
    t = t + "            ELSE" + NL
    t = t + "                FS.Write(pendFile, out)" + NL
    t = t + "            END IF" + NL
    t = t + "        CATCH err" + NL
    t = t + "            Complain(""simsh: "" + pendFile + "": "" + err)" + NL
    t = t + "        END TRY" + NL
    t = t + "        out = """"" + NL
    t = t + "    END IF" + NL
    t = t + "    stages = pendStages" + NL
    t = t + "    pendStages = []" + NL
    t = t + "    IF pendIdx < stages.Count THEN out = RunPipe(stages, pendIdx, out, TRUE)" + NL
    t = t + "    shOut = shOut + out" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Errors go straight to the screen, never down a pipe." + NL
    t = t + "SUB Complain (text AS String)" + NL
    t = t + "    shOut = shOut + text + EOL" + NL
    t = t + "    shStatus = 1" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ variables" + NL
    t = t + "" + NL
    t = t + "FUNCTION GetVar (name AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = varNames.IndexOf(name.Upper())" + NL
    t = t + "    IF i < 0 THEN RETURN """"" + NL
    t = t + "    RETURN varVals[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SetVar (name AS String, value AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = varNames.IndexOf(name.Upper())" + NL
    t = t + "    IF i < 0 THEN" + NL
    t = t + "        varNames.Add(name.Upper())" + NL
    t = t + "        varVals.Add(value)" + NL
    t = t + "    ELSE" + NL
    t = t + "        varVals[i] = value" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB UnsetVar (name AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = varNames.IndexOf(name.Upper())" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        varNames.RemoveAt(i)" + NL
    t = t + "        varVals.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    i = expNames.IndexOf(name.Upper())" + NL
    t = t + "    IF i >= 0 THEN expNames.RemoveAt(i)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsName (s AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    IF s = """" THEN RETURN FALSE" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        c = s.CharAt(i).Upper()" + NL
    t = t + "        IF NOT ((c >= ""A"" AND c <= ""Z"") OR c = ""_"" OR (i > 0 AND c >= ""0"" AND c <= ""9"")) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A remote session keeps its own directory, variables and aliases, saved here" + NL
    t = t + "' between commands." + NL
    t = t + "FUNCTION SaveState () AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    parts.Add(shCwd)" + NL
    t = t + "    parts.Add(shPrev)" + NL
    t = t + "    parts.Add(shUser)" + NL
    t = t + "    parts.Add(varNames.Join(Chr(3)))" + NL
    t = t + "    parts.Add(varVals.Join(Chr(3)))" + NL
    t = t + "    parts.Add(expNames.Join(Chr(3)))" + NL
    t = t + "    parts.Add(aliasNames.Join(Chr(3)))" + NL
    t = t + "    parts.Add(aliasVals.Join(Chr(3)))" + NL
    t = t + "    parts.Add(hist.Join(Chr(3)))" + NL
    t = t + "    RETURN parts.Join(Chr(4))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB LoadState (state AS String)" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    p = state.Split(Chr(4))" + NL
    t = t + "    shCwd = p[0]" + NL
    t = t + "    shPrev = p[1]" + NL
    t = t + "    shUser = p[2]" + NL
    t = t + "    varNames = Unpack(p[3])" + NL
    t = t + "    varVals = Unpack(p[4])" + NL
    t = t + "    expNames = Unpack(p[5])" + NL
    t = t + "    aliasNames = Unpack(p[6])" + NL
    t = t + "    aliasVals = Unpack(p[7])" + NL
    t = t + "    hist = Unpack(p[8])" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unpack (s AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    IF s = """" THEN RETURN out" + NL
    t = t + "    RETURN s.Split(Chr(3))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ parsing" + NL
    t = t + "" + NL
    t = t + "' A line into its pipelines: ""op"" + Chr(1) + text, op being ; && or ||." + NL
    t = t + "' Quotes are kept for later; # starts a comment." + NL
    t = t + "FUNCTION SplitLine (line AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR op AS String = "";""" + NL
    t = t + "    VAR q AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    VAR nx AS String" + NL
    t = t + "    i = 0" + NL
    t = t + "    WHILE i < line.Length" + NL
    t = t + "        c = line.CharAt(i)" + NL
    t = t + "        nx = """"" + NL
    t = t + "        IF i + 1 < line.Length THEN nx = line.CharAt(i + 1)" + NL
    t = t + "        IF q <> """" THEN" + NL
    t = t + "            IF c = q THEN q = """"" + NL
    t = t + "            cur = cur + c" + NL
    t = t + "        ELSEIF c = ""'"" OR c = Chr(34) THEN" + NL
    t = t + "            q = c" + NL
    t = t + "            cur = cur + c" + NL
    t = t + "        ELSEIF c = ""#"" AND (cur = """" OR cur.EndsWith("" "")) THEN" + NL
    t = t + "            BREAK" + NL
    t = t + "        ELSEIF c = "";"" OR (c = ""&"" AND nx = ""&"") OR (c = ""|"" AND nx = ""|"") THEN" + NL
    t = t + "            IF cur.Trim() <> """" THEN out.Add(op + Chr(1) + cur.Trim())" + NL
    t = t + "            cur = """"" + NL
    t = t + "            IF c = "";"" THEN" + NL
    t = t + "                op = "";""" + NL
    t = t + "            ELSE" + NL
    t = t + "                op = c + nx" + NL
    t = t + "                i = i + 1" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSE" + NL
    t = t + "            cur = cur + c" + NL
    t = t + "        END IF" + NL
    t = t + "        i = i + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF cur.Trim() <> """" THEN out.Add(op + Chr(1) + cur.Trim())" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A pipeline into its stages, at each | outside quotes." + NL
    t = t + "FUNCTION SplitPipe (text AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR q AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    FOR i = 0 TO text.Length - 1" + NL
    t = t + "        c = text.CharAt(i)" + NL
    t = t + "        IF q <> """" THEN" + NL
    t = t + "            IF c = q THEN q = """"" + NL
    t = t + "            cur = cur + c" + NL
    t = t + "        ELSEIF c = ""'"" OR c = Chr(34) THEN" + NL
    t = t + "            q = c" + NL
    t = t + "            cur = cur + c" + NL
    t = t + "        ELSEIF c = ""|"" THEN" + NL
    t = t + "            out.Add(cur.Trim())" + NL
    t = t + "            cur = """"" + NL
    t = t + "        ELSE" + NL
    t = t + "            cur = cur + c" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    out.Add(cur.Trim())" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One stage into words (lexWords), with quotes removed and $VARs expanded," + NL
    t = t + "' and the redirects marked (lexOps)." + NL
    t = t + "SUB Lex (text AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    VAR q AS String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR have AS Bool" + NL
    t = t + "    VAR starred AS Bool" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    lexWords.Clear()" + NL
    t = t + "    lexWild.Clear()" + NL
    t = t + "    lexOps.Clear()" + NL
    t = t + "    i = 0" + NL
    t = t + "    WHILE i < text.Length" + NL
    t = t + "        c = text.CharAt(i)" + NL
    t = t + "        IF q = ""'"" THEN" + NL
    t = t + "            IF c = ""'"" THEN" + NL
    t = t + "                q = """"" + NL
    t = t + "            ELSE" + NL
    t = t + "                cur = cur + c" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSEIF c = ""$"" AND i + 1 < text.Length THEN" + NL
    t = t + "            ' $NAME, ${NAME}, $?, $#, $0-$9" + NL
    t = t + "            name = """"" + NL
    t = t + "            c = text.CharAt(i + 1)" + NL
    t = t + "            IF c = ""{"" THEN" + NL
    t = t + "                i = i + 2" + NL
    t = t + "                WHILE i < text.Length" + NL
    t = t + "                    IF text.CharAt(i) = ""}"" THEN BREAK" + NL
    t = t + "                    name = name + text.CharAt(i)" + NL
    t = t + "                    i = i + 1" + NL
    t = t + "                END WHILE" + NL
    t = t + "            ELSEIF c = ""?"" OR c = ""#"" OR (c >= ""0"" AND c <= ""9"") THEN" + NL
    t = t + "                name = c" + NL
    t = t + "                i = i + 1" + NL
    t = t + "            ELSE" + NL
    t = t + "                WHILE i + 1 < text.Length" + NL
    t = t + "                    IF NOT IsName(name + text.CharAt(i + 1)) THEN BREAK" + NL
    t = t + "                    name = name + text.CharAt(i + 1)" + NL
    t = t + "                    i = i + 1" + NL
    t = t + "                END WHILE" + NL
    t = t + "            END IF" + NL
    t = t + "            IF name = """" THEN" + NL
    t = t + "                cur = cur + ""$""" + NL
    t = t + "            ELSE" + NL
    t = t + "                cur = cur + Expand(name)" + NL
    t = t + "            END IF" + NL
    t = t + "            have = TRUE" + NL
    t = t + "        ELSEIF q = Chr(34) THEN" + NL
    t = t + "            IF c = Chr(34) THEN" + NL
    t = t + "                q = """"" + NL
    t = t + "            ELSE" + NL
    t = t + "                cur = cur + c" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSEIF c = ""'"" OR c = Chr(34) THEN" + NL
    t = t + "            q = c" + NL
    t = t + "            have = TRUE" + NL
    t = t + "        ELSEIF c = "" "" OR c = Chr(9) THEN" + NL
    t = t + "            IF have THEN AddWord(cur, starred, """")" + NL
    t = t + "            cur = """"" + NL
    t = t + "            have = FALSE" + NL
    t = t + "            starred = FALSE" + NL
    t = t + "        ELSEIF c = "">"" OR c = ""<"" THEN" + NL
    t = t + "            IF have THEN AddWord(cur, starred, """")" + NL
    t = t + "            cur = """"" + NL
    t = t + "            have = FALSE" + NL
    t = t + "            starred = FALSE" + NL
    t = t + "            IF c = "">"" AND i + 1 < text.Length THEN" + NL
    t = t + "                IF text.CharAt(i + 1) = "">"" THEN" + NL
    t = t + "                    c = "">>""" + NL
    t = t + "                    i = i + 1" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "            AddWord("""", FALSE, c)" + NL
    t = t + "        ELSEIF c = ""~"" AND NOT have THEN" + NL
    t = t + "            ' ~ and ~/x at the start of a word" + NL
    t = t + "            IF i + 1 >= text.Length THEN" + NL
    t = t + "                cur = GetVar(""HOME"")" + NL
    t = t + "            ELSEIF text.CharAt(i + 1) = ""/"" OR text.CharAt(i + 1) = ""\"" OR text.CharAt(i + 1) = "" "" THEN" + NL
    t = t + "                cur = GetVar(""HOME"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                cur = ""~""" + NL
    t = t + "            END IF" + NL
    t = t + "            have = TRUE" + NL
    t = t + "        ELSE" + NL
    t = t + "            IF c = ""*"" OR c = ""?"" THEN starred = TRUE" + NL
    t = t + "            cur = cur + c" + NL
    t = t + "            have = TRUE" + NL
    t = t + "        END IF" + NL
    t = t + "        i = i + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF have THEN AddWord(cur, starred, """")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB AddWord (w AS String, starred AS Bool, op AS String)" + NL
    t = t + "    lexWords.Add(w)" + NL
    t = t + "    lexOps.Add(op)" + NL
    t = t + "    IF starred THEN" + NL
    t = t + "        lexWild.Add(""1"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        lexWild.Add("""")" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Expand (name AS String) AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    IF name = ""?"" THEN RETURN Str(shStatus)" + NL
    t = t + "    IF name = ""#"" THEN RETURN Str(posArgs.Count)" + NL
    t = t + "    IF name.Length = 1 AND name >= ""0"" AND name <= ""9"" THEN" + NL
    t = t + "        n = Int(Val(name))" + NL
    t = t + "        IF n = 0 THEN RETURN ""simsh""" + NL
    t = t + "        IF n <= posArgs.Count THEN RETURN posArgs[n - 1]" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF name.Upper() = ""PWD"" THEN RETURN shCwd" + NL
    t = t + "    IF name.Upper() = ""RANDOM"" THEN RETURN Str(Rnd(32768))" + NL
    t = t + "    RETURN GetVar(name)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ paths" + NL
    t = t + "" + NL
    t = t + "' Any path the user types, as a full DOS path: /programs/x.spk, ~/a.txt," + NL
    t = t + "' ..\docs, C:/WEB and C:\WEB all work." + NL
    t = t + "FUNCTION Resolve (p AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR part AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    s = p.Trim().Replace(""/"", ""\"")" + NL
    t = t + "    IF s = """" THEN RETURN shCwd" + NL
    t = t + "    IF s = ""~"" OR s.StartsWith(""~\"") THEN s = GetVar(""HOME"") + s.Substring(1, s.Length - 1)" + NL
    t = t + "    IF s.Length >= 2 AND s.CharAt(1) = "":"" THEN" + NL
    t = t + "        IF s.Length = 2 THEN s = s + ""\""" + NL
    t = t + "    ELSEIF s.StartsWith(""\"") THEN" + NL
    t = t + "        s = ""C:"" + s" + NL
    t = t + "    ELSE" + NL
    t = t + "        s = shCwd + ""\"" + s" + NL
    t = t + "    END IF" + NL
    t = t + "    parts = s.Split(""\"")" + NL
    t = t + "    out.Add(parts[0].Upper())" + NL
    t = t + "    FOR i = 1 TO parts.Count - 1" + NL
    t = t + "        part = parts[i]" + NL
    t = t + "        IF part = """" OR part = ""."" THEN CONTINUE" + NL
    t = t + "        IF part = "".."" THEN" + NL
    t = t + "            IF out.Count > 1 THEN out.RemoveAt(out.Count - 1)" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        out.Add(part.Upper())" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF out.Count = 1 THEN RETURN out[0] + ""\""" + NL
    t = t + "    RETURN out.Join(""\"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JoinPath (dir AS String, name AS String) AS String" + NL
    t = t + "    IF dir.EndsWith(""\"") THEN RETURN dir + name" + NL
    t = t + "    RETURN dir + ""\"" + name" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION BaseName (p AS String) AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    parts = p.Replace(""/"", ""\"").Split(""\"")" + NL
    t = t + "    IF parts[parts.Count - 1] = """" AND parts.Count > 1 THEN RETURN parts[parts.Count - 2]" + NL
    t = t + "    RETURN parts[parts.Count - 1]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION DirName (p AS String) AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    parts = p.Split(""\"")" + NL
    t = t + "    IF parts.Count <= 2 THEN RETURN parts[0] + ""\""" + NL
    t = t + "    parts.RemoveAt(parts.Count - 1)" + NL
    t = t + "    RETURN parts.Join(""\"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' * and ? against a name, ignoring case." + NL
    t = t + "FUNCTION MatchWild (pat AS String, s AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR star AS Integer = -1" + NL
    t = t + "    VAR mark AS Integer" + NL
    t = t + "    p = pat.Upper()" + NL
    t = t + "    t = s.Upper()" + NL
    t = t + "    WHILE j < t.Length" + NL
    t = t + "        IF i < p.Length AND p.CharAt(i) <> ""*"" AND (p.CharAt(i) = ""?"" OR p.CharAt(i) = t.CharAt(j)) THEN" + NL
    t = t + "            i = i + 1" + NL
    t = t + "            j = j + 1" + NL
    t = t + "        ELSEIF i < p.Length AND p.CharAt(i) = ""*"" THEN" + NL
    t = t + "            star = i" + NL
    t = t + "            mark = j" + NL
    t = t + "            i = i + 1" + NL
    t = t + "        ELSEIF star >= 0 THEN" + NL
    t = t + "            i = star + 1" + NL
    t = t + "            mark = mark + 1" + NL
    t = t + "            j = mark" + NL
    t = t + "        ELSE" + NL
    t = t + "            RETURN FALSE" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    WHILE i < p.Length" + NL
    t = t + "        IF p.CharAt(i) <> ""*"" THEN BREAK" + NL
    t = t + "        i = i + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN i = p.Length" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A word with * or ? in its last part, as the names it matches (or itself)." + NL
    t = t + "FUNCTION Glob (w AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR shown AS String" + NL
    t = t + "    VAR pat AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    VAR cut AS Integer" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    parts = w.Replace(""/"", ""\"").Split(""\"")" + NL
    t = t + "    pat = parts[parts.Count - 1]" + NL
    t = t + "    shown = """"" + NL
    t = t + "    IF parts.Count > 1 THEN shown = w.Substring(0, w.Length - pat.Length)" + NL
    t = t + "    dir = Resolve(shown)" + NL
    t = t + "    TRY" + NL
    t = t + "        FOR EACH n IN FS.List(dir)" + NL
    t = t + "            IF n.EndsWith(""\"") THEN n = n.Substring(0, n.Length - 1)" + NL
    t = t + "            IF MatchWild(pat, n) THEN out.Add(shown + n)" + NL
    t = t + "        NEXT" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF out.Count = 0 THEN out.Add(w)" + NL
    t = t + "    out.Sort()" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ running" + NL
    t = t + "" + NL
    t = t + "' Run stages from i on, feeding each one's output to the next." + NL
    t = t + "FUNCTION RunPipe (stages AS Array OF String, start AS Integer, input AS String, top AS Bool) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR data AS String" + NL
    t = t + "    data = input" + NL
    t = t + "    FOR i = start TO stages.Count - 1" + NL
    t = t + "        IF stages[i] = """" THEN" + NL
    t = t + "            Complain(""simsh: syntax error near |"")" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        END IF" + NL
    t = t + "        data = RunStage(stages[i], data, i = stages.Count - 1 AND top)" + NL
    t = t + "        IF jobWant THEN" + NL
    t = t + "            IF top THEN" + NL
    t = t + "                pendStages = stages" + NL
    t = t + "                pendIdx = i + 1" + NL
    t = t + "                RETURN """"" + NL
    t = t + "            END IF" + NL
    t = t + "            JobRefuse()" + NL
    t = t + "            data = """"" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN data" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RunStage (raw AS String, input AS String, last AS Bool) AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR first AS String" + NL
    t = t + "    VAR sp AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR argv AS Array OF String" + NL
    t = t + "    VAR words AS Array OF String" + NL
    t = t + "    VAR wilds AS Array OF String" + NL
    t = t + "    VAR ops AS Array OF String" + NL
    t = t + "    VAR g AS String" + NL
    t = t + "    VAR outFile AS String" + NL
    t = t + "    VAR inFile AS String" + NL
    t = t + "    VAR app AS Bool" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR data AS String" + NL
    t = t + "    VAR eq AS Integer" + NL
    t = t + "    ' an alias is the first word swapped for its text" + NL
    t = t + "    text = raw" + NL
    t = t + "    sp = text.IndexOf("" "")" + NL
    t = t + "    first = text" + NL
    t = t + "    IF sp >= 0 THEN first = text.Substring(0, sp)" + NL
    t = t + "    i = aliasNames.IndexOf(first)" + NL
    t = t + "    IF i >= 0 THEN text = aliasVals[i] + text.Substring(first.Length, text.Length - first.Length)" + NL
    t = t + "    Lex(text)" + NL
    t = t + "    words = lexWords" + NL
    t = t + "    wilds = lexWild" + NL
    t = t + "    ops = lexOps" + NL
    t = t + "    lexWords = []" + NL
    t = t + "    lexWild = []" + NL
    t = t + "    lexOps = []" + NL
    t = t + "    i = 0" + NL
    t = t + "    WHILE i < words.Count" + NL
    t = t + "        IF ops[i] <> """" THEN" + NL
    t = t + "            IF i + 1 >= words.Count OR ops[i + 1] <> """" THEN" + NL
    t = t + "                Complain(""simsh: syntax error near "" + ops[i])" + NL
    t = t + "                RETURN """"" + NL
    t = t + "            END IF" + NL
    t = t + "            IF ops[i] = ""<"" THEN" + NL
    t = t + "                inFile = Resolve(words[i + 1])" + NL
    t = t + "            ELSE" + NL
    t = t + "                outFile = Resolve(words[i + 1])" + NL
    t = t + "                app = ops[i] = "">>""" + NL
    t = t + "            END IF" + NL
    t = t + "            i = i + 2" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF wilds[i] = ""1"" THEN" + NL
    t = t + "            FOR EACH g IN Glob(words[i])" + NL
    t = t + "                argv.Add(g)" + NL
    t = t + "            NEXT" + NL
    t = t + "        ELSE" + NL
    t = t + "            argv.Add(words[i])" + NL
    t = t + "        END IF" + NL
    t = t + "        i = i + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    data = input" + NL
    t = t + "    IF inFile <> """" THEN" + NL
    t = t + "        IF NOT FS.Exists(inFile) OR FS.IsDir(inFile) THEN" + NL
    t = t + "            Complain(""simsh: "" + inFile + "": No such file"")" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        END IF" + NL
    t = t + "        data = FS.Read(inFile)" + NL
    t = t + "    END IF" + NL
    t = t + "    ' NAME=value on its own sets a variable" + NL
    t = t + "    WHILE argv.Count > 0" + NL
    t = t + "        eq = argv[0].IndexOf(""="")" + NL
    t = t + "        IF eq <= 0 THEN BREAK" + NL
    t = t + "        IF NOT IsName(argv[0].Substring(0, eq)) THEN BREAK" + NL
    t = t + "        SetVar(argv[0].Substring(0, eq), argv[0].Substring(eq + 1, argv[0].Length - eq - 1))" + NL
    t = t + "        argv.RemoveAt(0)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    shStatus = 0" + NL
    t = t + "    IF argv.Count = 0 THEN RETURN """"" + NL
    t = t + "    shTty = last AND outFile = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        out = Command(argv, data)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        Complain(argv[0] + "": "" + err)" + NL
    t = t + "        out = """"" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF jobWant THEN" + NL
    t = t + "        pendFile = outFile" + NL
    t = t + "        pendAppend = app" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF outFile <> """" THEN" + NL
    t = t + "        TRY" + NL
    t = t + "            IF app AND FS.Exists(outFile) THEN" + NL
    t = t + "                FS.Append(outFile, out)" + NL
    t = t + "            ELSE" + NL
    t = t + "                FS.Write(outFile, out)" + NL
    t = t + "            END IF" + NL
    t = t + "        CATCH err" + NL
    t = t + "            Complain(""simsh: "" + outFile + "": "" + err)" + NL
    t = t + "        END TRY" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Builtins () AS Array OF String" + NL
    t = t + "    RETURN [""alias"", ""basename"", ""cat"", ""cd"", ""clear"", ""cp"", ""date"", ""echo"", ""env"", ""exit"", ""export"", ""false"", ""grep"", ""head"", ""help"", ""history"", ""host"", ""hostname"", ""kill"", ""ls"", ""mkdir"", ""mv"", ""nslookup"", ""ps"", ""pwd"", ""rm"", ""rmdir"", ""run"", ""scp"", ""seq"", ""set"", ""sh"", ""sim-get"", ""sleep"", ""sort"", ""source"", ""ssh"", ""tail"", ""tee"", ""touch"", ""true"", ""unalias"", ""uname"", ""uniq"", ""unset"", ""wc"", ""which"", ""whoami""]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One command, with its arguments and its input. Returns what it printed." + NL
    t = t + "FUNCTION Command (argv AS Array OF String, input AS String) AS String" + NL
    t = t + "    VAR cmd AS String" + NL
    t = t + "    VAR args AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    cmd = argv[0]" + NL
    t = t + "    FOR i = 1 TO argv.Count - 1" + NL
    t = t + "        args.Add(argv[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    SELECT CASE cmd.Lower()" + NL
    t = t + "        CASE ""ls"", ""dir""" + NL
    t = t + "            RETURN CmdLs(args)" + NL
    t = t + "        CASE ""cd""" + NL
    t = t + "            RETURN CmdCd(args)" + NL
    t = t + "        CASE ""pwd""" + NL
    t = t + "            RETURN shCwd + EOL" + NL
    t = t + "        CASE ""cat"", ""type""" + NL
    t = t + "            RETURN CmdCat(args, input)" + NL
    t = t + "        CASE ""echo""" + NL
    t = t + "            RETURN CmdEcho(args)" + NL
    t = t + "        CASE ""mkdir"", ""md""" + NL
    t = t + "            RETURN CmdMkdir(args)" + NL
    t = t + "        CASE ""rm"", ""del""" + NL
    t = t + "            RETURN CmdRm(args)" + NL
    t = t + "        CASE ""rmdir"", ""rd""" + NL
    t = t + "            RETURN CmdRmdir(args)" + NL
    t = t + "        CASE ""mv"", ""move""" + NL
    t = t + "            RETURN CmdCopy(args, TRUE)" + NL
    t = t + "        CASE ""cp"", ""copy""" + NL
    t = t + "            RETURN CmdCopy(args, FALSE)" + NL
    t = t + "        CASE ""touch""" + NL
    t = t + "            RETURN CmdTouch(args)" + NL
    t = t + "        CASE ""head""" + NL
    t = t + "            RETURN CmdHeadTail(args, input, TRUE)" + NL
    t = t + "        CASE ""tail""" + NL
    t = t + "            RETURN CmdHeadTail(args, input, FALSE)" + NL
    t = t + "        CASE ""wc""" + NL
    t = t + "            RETURN CmdWc(args, input)" + NL
    t = t + "        CASE ""grep""" + NL
    t = t + "            RETURN CmdGrep(args, input)" + NL
    t = t + "        CASE ""sort""" + NL
    t = t + "            RETURN CmdSort(args, input)" + NL
    t = t + "        CASE ""uniq""" + NL
    t = t + "            RETURN CmdUniq(args, input)" + NL
    t = t + "        CASE ""tee""" + NL
    t = t + "            RETURN CmdTee(args, input)" + NL
    t = t + "        CASE ""seq""" + NL
    t = t + "            RETURN CmdSeq(args)" + NL
    t = t + "        CASE ""basename""" + NL
    t = t + "            IF args.Count = 0 THEN RETURN Usage(""basename path"")" + NL
    t = t + "            RETURN BaseName(args[0]) + EOL" + NL
    t = t + "        CASE ""env""" + NL
    t = t + "            RETURN CmdEnv(TRUE)" + NL
    t = t + "        CASE ""set""" + NL
    t = t + "            IF args.Count > 0 THEN RETURN CmdExport(args, FALSE)" + NL
    t = t + "            RETURN CmdEnv(FALSE)" + NL
    t = t + "        CASE ""export""" + NL
    t = t + "            IF args.Count = 0 THEN RETURN CmdEnv(TRUE)" + NL
    t = t + "            RETURN CmdExport(args, TRUE)" + NL
    t = t + "        CASE ""unset""" + NL
    t = t + "            FOR i = 0 TO args.Count - 1" + NL
    t = t + "                UnsetVar(args[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""alias""" + NL
    t = t + "            RETURN CmdAlias(args)" + NL
    t = t + "        CASE ""unalias""" + NL
    t = t + "            FOR i = 0 TO args.Count - 1" + NL
    t = t + "                IF aliasNames.IndexOf(args[i]) >= 0 THEN" + NL
    t = t + "                    aliasVals.RemoveAt(aliasNames.IndexOf(args[i]))" + NL
    t = t + "                    aliasNames.RemoveAt(aliasNames.IndexOf(args[i]))" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""history""" + NL
    t = t + "            RETURN CmdHistory(args)" + NL
    t = t + "        CASE ""clear"", ""cls""" + NL
    t = t + "            shClear = TRUE" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""exit"", ""logout""" + NL
    t = t + "            shExit = TRUE" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""ps""" + NL
    t = t + "            RETURN CmdPs()" + NL
    t = t + "        CASE ""kill""" + NL
    t = t + "            RETURN CmdKill(args)" + NL
    t = t + "        CASE ""run"", ""start""" + NL
    t = t + "            IF args.Count = 0 THEN RETURN Usage(""run program.spk [args]"")" + NL
    t = t + "            RETURN RunProgram(args)" + NL
    t = t + "        CASE ""date""" + NL
    t = t + "            IF args.Count > 0 THEN" + NL
    t = t + "                IF args[0] = ""+%s"" THEN RETURN Str(TIME.Now) + EOL" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN TIME.Date + "" "" + TIME.Clock + EOL" + NL
    t = t + "        CASE ""whoami""" + NL
    t = t + "            RETURN shUser + EOL" + NL
    t = t + "        CASE ""hostname""" + NL
    t = t + "            RETURN NET.HostName + EOL" + NL
    t = t + "        CASE ""uname""" + NL
    t = t + "            IF args.Count > 0 THEN" + NL
    t = t + "                IF args[0] = ""-a"" THEN RETURN ""SIM95 "" + shHost + "" Sim Shell "" + SHVERSION + EOL" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN ""SIM95"" + EOL" + NL
    t = t + "        CASE ""which""" + NL
    t = t + "            RETURN CmdWhich(args)" + NL
    t = t + "        CASE ""help""" + NL
    t = t + "            RETURN CmdHelp(args)" + NL
    t = t + "        CASE ""true""" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""false""" + NL
    t = t + "            shStatus = 1" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""sleep""" + NL
    t = t + "            IF args.Count > 0 AND NOT shRemote THEN SYS.Sleep(Int(MATH.Min(10, Val(args[0])) * 1000))" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""sh"", ""source"", "".""" + NL
    t = t + "            IF args.Count = 0 THEN RETURN Usage(""sh script.sh [args]"")" + NL
    t = t + "            RETURN RunScript(args, shTty)" + NL
    t = t + "        CASE ""ssh""" + NL
    t = t + "            RETURN CmdSsh(args)" + NL
    t = t + "        CASE ""scp""" + NL
    t = t + "            IF args.Count < 2 THEN RETURN Usage(""scp [user@]host:path localpath  or  scp localpath [user@]host:path"")" + NL
    t = t + "            Defer(""scp"", args)" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""sim-get"", ""simget""" + NL
    t = t + "            RETURN CmdSimGet(args)" + NL
    t = t + "        CASE ""host"", ""nslookup""" + NL
    t = t + "            IF args.Count = 0 THEN RETURN Usage(cmd + "" name [A|CNAME|MX|TXT|NS|SOA|ANY] [@server]"")" + NL
    t = t + "            Defer(""host"", args)" + NL
    t = t + "            RETURN """"" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN RunExternal(argv)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Usage (text AS String) AS String" + NL
    t = t + "    Complain(""usage: "" + text)" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Defer (kind AS String, args AS Array OF String)" + NL
    t = t + "    jobKind = kind" + NL
    t = t + "    jobArgs = args" + NL
    t = t + "    jobWant = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Not a built-in: a .SPK program or a .SH script, by path or on $PATH." + NL
    t = t + "FUNCTION RunExternal (argv AS Array OF String) AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    path = FindProgram(argv[0])" + NL
    t = t + "    IF path = """" THEN" + NL
    t = t + "        Complain(""simsh: "" + argv[0] + "": command not found"")" + NL
    t = t + "        shStatus = 127" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    argv[0] = path" + NL
    t = t + "    IF path.EndsWith("".SH"") THEN RETURN RunScript(argv, shTty)" + NL
    t = t + "    RETURN RunProgram(argv)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION FindProgram (name AS String) AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    IF name.Contains(""\"") OR name.Contains(""/"") OR name.Contains(""."") THEN" + NL
    t = t + "        p = Resolve(name)" + NL
    t = t + "        IF FS.Exists(p) AND NOT FS.IsDir(p) THEN RETURN p" + NL
    t = t + "        IF FS.Exists(p + "".SPK"") THEN RETURN p + "".SPK""" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH dir IN GetVar(""PATH"").Split("";"")" + NL
    t = t + "        IF dir.Trim() = """" THEN CONTINUE" + NL
    t = t + "        p = JoinPath(Resolve(dir), name.Upper() + "".SPK"")" + NL
    t = t + "        IF FS.Exists(p) THEN RETURN p" + NL
    t = t + "        p = JoinPath(Resolve(dir), name.Upper() + "".SH"")" + NL
    t = t + "        IF FS.Exists(p) THEN RETURN p" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RunProgram (args AS Array OF String) AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR rest AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR pid AS Integer" + NL
    t = t + "    path = FindProgram(args[0])" + NL
    t = t + "    IF path = """" THEN" + NL
    t = t + "        Complain(""run: "" + args[0] + "": No such program"")" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF path.EndsWith("".SH"") THEN RETURN RunScript(args, shTty)" + NL
    t = t + "    IF NOT path.EndsWith("".SPK"") THEN" + NL
    t = t + "        Complain(""run: "" + path + "": not a SPARK program (.SPK)"")" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 1 TO args.Count - 1" + NL
    t = t + "        rest.Add(args[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    pid = SYS.Start(path, rest.Join("" ""))" + NL
    t = t + "    RETURN ""["" + Str(pid) + ""] "" + path + EOL" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A script: its lines go to the front of the queue (so they can use the" + NL
    t = t + "' network), unless its output is wanted down a pipe or in a file, when they" + NL
    t = t + "' run here and now." + NL
    t = t + "FUNCTION RunScript (args AS Array OF String, queued AS Bool) AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR rest AS Array OF String" + NL
    t = t + "    VAR saved AS Array OF String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    VAR it AS String" + NL
    t = t + "    VAR cut AS Integer" + NL
    t = t + "    path = Resolve(args[0])" + NL
    t = t + "    IF NOT FS.Exists(path) THEN" + NL
    t = t + "        IF FindProgram(args[0]).EndsWith("".SH"") THEN path = FindProgram(args[0])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT FS.Exists(path) OR FS.IsDir(path) THEN" + NL
    t = t + "        Complain(""sh: "" + args[0] + "": No such file"")" + NL
    t = t + "        shStatus = 127" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    text = FS.Read(path)" + NL
    t = t + "    FOR i = 1 TO args.Count - 1" + NL
    t = t + "        rest.Add(args[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF queued THEN" + NL
    t = t + "        queue.Insert(0, ""args"" + Chr(1) + posArgs.Join(Chr(2)))" + NL
    t = t + "        QueueLines(text, FALSE)" + NL
    t = t + "        queue.Insert(0, ""args"" + Chr(1) + rest.Join(Chr(2)))" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    saved = posArgs" + NL
    t = t + "    posArgs = rest" + NL
    t = t + "    FOR EACH ln IN text.Lines()" + NL
    t = t + "        FOR EACH it IN SplitLine(ln)" + NL
    t = t + "            cut = it.IndexOf(Chr(1))" + NL
    t = t + "            IF it.StartsWith(""&&"") AND shStatus <> 0 THEN CONTINUE" + NL
    t = t + "            IF it.StartsWith(""||"") AND shStatus = 0 THEN CONTINUE" + NL
    t = t + "            out = out + RunPipe(SplitPipe(it.Substring(cut + 1, it.Length - cut - 1)), 0, """", FALSE)" + NL
    t = t + "            IF shExit THEN BREAK" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF shExit THEN BREAK" + NL
    t = t + "    NEXT" + NL
    t = t + "    shExit = FALSE" + NL
    t = t + "    posArgs = saved" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Run the startup file, if there is one." + NL
    t = t + "SUB ShRc ()" + NL
    t = t + "    IF FS.Exists(RCFILE) THEN" + NL
    t = t + "        queue.Add(""args"" + Chr(1))" + NL
    t = t + "        QueueLines(FS.Read(RCFILE), TRUE)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ files" + NL
    t = t + "" + NL
    t = t + "' Text as lines, without the empty one after a final line break." + NL
    t = t + "FUNCTION TextLines (text AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    IF text = """" THEN RETURN out" + NL
    t = t + "    out = text.Replace(Chr(13), """").Split(EOL)" + NL
    t = t + "    IF out[out.Count - 1] = """" THEN out.RemoveAt(out.Count - 1)" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LinesText (lines AS Array OF String) AS String" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN """"" + NL
    t = t + "    RETURN lines.Join(EOL) + EOL" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Flags at the front (-l, -la, -n 5) into one string of letters; returns" + NL
    t = t + "' the index of the first argument that is not a flag." + NL
    t = t + "VAR flagText AS String" + NL
    t = t + "FUNCTION Flags (args AS Array OF String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    flagText = """"" + NL
    t = t + "    FOR i = 0 TO args.Count - 1" + NL
    t = t + "        IF args[i] = ""--"" THEN RETURN i + 1" + NL
    t = t + "        IF NOT args[i].StartsWith(""-"") OR args[i].Length < 2 THEN RETURN i" + NL
    t = t + "        flagText = flagText + args[i].Substring(1, args[i].Length - 1)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN args.Count" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadFile (cmd AS String, name AS String) AS String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    p = Resolve(name)" + NL
    t = t + "    IF NOT FS.Exists(p) THEN THROW name + "": No such file or directory""" + NL
    t = t + "    IF FS.IsDir(p) THEN THROW name + "": Is a directory""" + NL
    t = t + "    RETURN FS.Read(p)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdLs (args AS Array OF String) AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR long AS Bool" + NL
    t = t + "    VAR paths AS Array OF String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    first = Flags(args)" + NL
    t = t + "    long = flagText.Contains(""l"")" + NL
    t = t + "    FOR i = first TO args.Count - 1" + NL
    t = t + "        paths.Add(args[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF paths.Count = 0 THEN paths.Add(""."")" + NL
    t = t + "    FOR i = 0 TO paths.Count - 1" + NL
    t = t + "        p = Resolve(paths[i])" + NL
    t = t + "        IF NOT FS.Exists(p) THEN" + NL
    t = t + "            Complain(""ls: "" + paths[i] + "": No such file or directory"")" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF NOT FS.IsDir(p) THEN" + NL
    t = t + "            IF long THEN" + NL
    t = t + "                out = out + LongLine(BaseName(p), FS.Size(p), FALSE)" + NL
    t = t + "            ELSE" + NL
    t = t + "                out = out + paths[i] + EOL" + NL
    t = t + "            END IF" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF paths.Count > 1 THEN out = out + paths[i] + "":"" + EOL" + NL
    t = t + "        out = out + ListDir(p, long)" + NL
    t = t + "        IF paths.Count > 1 AND i < paths.Count - 1 THEN out = out + EOL" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LongLine (name AS String, size AS Integer, dir AS Bool) AS String" + NL
    t = t + "    IF dir THEN RETURN ""drwxr-xr-x  "" + shUser.PadRight(8) + ""        -  "" + name + ""/"" + EOL" + NL
    t = t + "    RETURN ""-rw-r--r--  "" + shUser.PadRight(8) + Str(size).PadLeft(9) + ""  "" + name + EOL" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ListDir (p AS String, long AS Bool) AS String" + NL
    t = t + "    VAR names AS Array OF String" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR row AS String" + NL
    t = t + "    VAR total AS Integer" + NL
    t = t + "    names = FS.List(p)" + NL
    t = t + "    names.Sort()" + NL
    t = t + "    FOR EACH n IN names" + NL
    t = t + "        IF long THEN" + NL
    t = t + "            IF n.EndsWith(""\"") THEN" + NL
    t = t + "                out = out + LongLine(n.Substring(0, n.Length - 1), 0, TRUE)" + NL
    t = t + "            ELSE" + NL
    t = t + "                out = out + LongLine(n, FS.Size(JoinPath(p, n)), FALSE)" + NL
    t = t + "                total = total + FS.Size(JoinPath(p, n))" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSE" + NL
    t = t + "            IF n.EndsWith(""\"") THEN n = n.Substring(0, n.Length - 1) + ""/""" + NL
    t = t + "            IF shTty THEN" + NL
    t = t + "                ' columns on the screen, one a line down a pipe" + NL
    t = t + "                IF row.Length >= 64 THEN" + NL
    t = t + "                    out = out + row.Trim() + EOL" + NL
    t = t + "                    row = """"" + NL
    t = t + "                END IF" + NL
    t = t + "                row = row + n.PadRight(16)" + NL
    t = t + "            ELSE" + NL
    t = t + "                out = out + n + EOL" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF row <> """" THEN out = out + row.Trim() + EOL" + NL
    t = t + "    IF long THEN out = ""total "" + Str(total) + EOL + out" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdCd (args AS Array OF String) AS String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    IF args.Count = 0 THEN" + NL
    t = t + "        p = GetVar(""HOME"")" + NL
    t = t + "    ELSEIF args[0] = ""-"" THEN" + NL
    t = t + "        p = shPrev" + NL
    t = t + "        IF p = """" THEN p = shCwd" + NL
    t = t + "    ELSE" + NL
    t = t + "        p = Resolve(args[0])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT FS.Exists(p) OR NOT FS.IsDir(p) THEN" + NL
    t = t + "        Complain(""cd: "" + args[0] + "": No such directory"")" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    shPrev = shCwd" + NL
    t = t + "    shCwd = Resolve(p)" + NL
    t = t + "    SetVar(""PWD"", shCwd)" + NL
    t = t + "    IF args.Count > 0 THEN" + NL
    t = t + "        IF args[0] = ""-"" THEN RETURN shCwd + EOL" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdCat (args AS Array OF String, input AS String) AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    first = Flags(args)" + NL
    t = t + "    IF first >= args.Count THEN" + NL
    t = t + "        out = input" + NL
    t = t + "    ELSE" + NL
    t = t + "        FOR i = first TO args.Count - 1" + NL
    t = t + "            TRY" + NL
    t = t + "                out = out + ReadFile(""cat"", args[i])" + NL
    t = t + "            CATCH err" + NL
    t = t + "                Complain(""cat: "" + err)" + NL
    t = t + "            END TRY" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    IF flagText.Contains(""n"") THEN" + NL
    t = t + "        lines = TextLines(out)" + NL
    t = t + "        FOR i = 0 TO lines.Count - 1" + NL
    t = t + "            lines[i] = Str(i + 1).PadLeft(6) + ""  "" + lines[i]" + NL
    t = t + "        NEXT" + NL
    t = t + "        RETURN LinesText(lines)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdEcho (args AS Array OF String) AS String" + NL
    t = t + "    IF args.Count > 0 THEN" + NL
    t = t + "        IF args[0] = ""-n"" THEN" + NL
    t = t + "            args.RemoveAt(0)" + NL
    t = t + "            RETURN args.Join("" "")" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN args.Join("" "") + EOL" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Every folder down to p that is not there yet." + NL
    t = t + "SUB MakeDirs (p AS String)" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR sofar AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    parts = p.Split(""\"")" + NL
    t = t + "    sofar = parts[0]" + NL
    t = t + "    FOR i = 1 TO parts.Count - 1" + NL
    t = t + "        IF parts[i] = """" THEN CONTINUE" + NL
    t = t + "        sofar = sofar + ""\"" + parts[i]" + NL
    t = t + "        IF NOT FS.Exists(sofar) THEN FS.MakeDir(sofar)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdMkdir (args AS Array OF String) AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    first = Flags(args)" + NL
    t = t + "    IF first >= args.Count THEN RETURN Usage(""mkdir [-p] dir"")" + NL
    t = t + "    FOR i = first TO args.Count - 1" + NL
    t = t + "        p = Resolve(args[i])" + NL
    t = t + "        IF FS.Exists(p) THEN" + NL
    t = t + "            IF NOT flagText.Contains(""p"") THEN Complain(""mkdir: "" + args[i] + "": File exists"")" + NL
    t = t + "        ELSEIF flagText.Contains(""p"") THEN" + NL
    t = t + "            MakeDirs(p)" + NL
    t = t + "        ELSEIF NOT FS.Exists(DirName(p)) THEN" + NL
    t = t + "            Complain(""mkdir: "" + args[i] + "": No such directory (try mkdir -p)"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.MakeDir(p)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A folder and everything in it." + NL
    t = t + "SUB DeleteTree (p AS String)" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    FOR EACH n IN FS.List(p)" + NL
    t = t + "        IF n.EndsWith(""\"") THEN" + NL
    t = t + "            DeleteTree(JoinPath(p, n.Substring(0, n.Length - 1)))" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Delete(JoinPath(p, n))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Delete(p)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdRm (args AS Array OF String) AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    first = Flags(args)" + NL
    t = t + "    IF first >= args.Count THEN RETURN Usage(""rm [-r] [-f] file..."")" + NL
    t = t + "    FOR i = first TO args.Count - 1" + NL
    t = t + "        p = Resolve(args[i])" + NL
    t = t + "        IF p.Length <= 3 THEN" + NL
    t = t + "            Complain(""rm: refusing to remove "" + p)" + NL
    t = t + "        ELSEIF NOT FS.Exists(p) THEN" + NL
    t = t + "            IF NOT flagText.Contains(""f"") THEN Complain(""rm: "" + args[i] + "": No such file or directory"")" + NL
    t = t + "        ELSEIF FS.IsDir(p) THEN" + NL
    t = t + "            IF flagText.Contains(""r"") OR flagText.Contains(""R"") THEN" + NL
    t = t + "                DeleteTree(p)" + NL
    t = t + "            ELSE" + NL
    t = t + "                Complain(""rm: "" + args[i] + "": Is a directory (use rm -r)"")" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Delete(p)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdRmdir (args AS Array OF String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    IF args.Count = 0 THEN RETURN Usage(""rmdir dir"")" + NL
    t = t + "    FOR i = 0 TO args.Count - 1" + NL
    t = t + "        p = Resolve(args[i])" + NL
    t = t + "        IF NOT FS.Exists(p) OR NOT FS.IsDir(p) THEN" + NL
    t = t + "            Complain(""rmdir: "" + args[i] + "": No such directory"")" + NL
    t = t + "        ELSEIF FS.List(p).Count > 0 THEN" + NL
    t = t + "            Complain(""rmdir: "" + args[i] + "": Directory not empty"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Delete(p)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB CopyTree (src AS String, dest AS String)" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    IF NOT FS.Exists(dest) THEN FS.MakeDir(dest)" + NL
    t = t + "    FOR EACH n IN FS.List(src)" + NL
    t = t + "        IF n.EndsWith(""\"") THEN" + NL
    t = t + "            CopyTree(JoinPath(src, n.Substring(0, n.Length - 1)), JoinPath(dest, n.Substring(0, n.Length - 1)))" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Write(JoinPath(dest, n), FS.Read(JoinPath(src, n)))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' cp and mv: one file to a name, or several into a folder." + NL
    t = t + "FUNCTION CmdCopy (args AS Array OF String, move AS Bool) AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR dest AS String" + NL
    t = t + "    VAR src AS String" + NL
    t = t + "    VAR target AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    name = ""cp""" + NL
    t = t + "    IF move THEN name = ""mv""" + NL
    t = t + "    first = Flags(args)" + NL
    t = t + "    IF args.Count - first < 2 THEN RETURN Usage(name + "" source... dest"")" + NL
    t = t + "    dest = Resolve(args[args.Count - 1])" + NL
    t = t + "    IF args.Count - first > 2 AND NOT FS.IsDir(dest) THEN" + NL
    t = t + "        Complain(name + "": "" + args[args.Count - 1] + "": not a directory"")" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = first TO args.Count - 2" + NL
    t = t + "        src = Resolve(args[i])" + NL
    t = t + "        IF NOT FS.Exists(src) THEN" + NL
    t = t + "            Complain(name + "": "" + args[i] + "": No such file or directory"")" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        target = dest" + NL
    t = t + "        IF FS.Exists(dest) THEN" + NL
    t = t + "            IF FS.IsDir(dest) THEN target = JoinPath(dest, BaseName(src))" + NL
    t = t + "        END IF" + NL
    t = t + "        IF target = src THEN" + NL
    t = t + "            Complain(name + "": "" + args[i] + "" and "" + target + "" are the same file"")" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF move THEN" + NL
    t = t + "            IF FS.Exists(target) AND NOT FS.IsDir(target) THEN FS.Delete(target)" + NL
    t = t + "            FS.Rename(src, target)" + NL
    t = t + "        ELSEIF FS.IsDir(src) THEN" + NL
    t = t + "            IF flagText.Contains(""r"") OR flagText.Contains(""R"") THEN" + NL
    t = t + "                CopyTree(src, target)" + NL
    t = t + "            ELSE" + NL
    t = t + "                Complain(""cp: "" + args[i] + "": Is a directory (use cp -r)"")" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Write(target, FS.Read(src))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdTouch (args AS Array OF String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    IF args.Count = 0 THEN RETURN Usage(""touch file..."")" + NL
    t = t + "    FOR i = 0 TO args.Count - 1" + NL
    t = t + "        p = Resolve(args[i])" + NL
    t = t + "        IF NOT FS.Exists(p) THEN FS.Write(p, """")" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' head and tail: -n N or -N, files or the input." + NL
    t = t + "FUNCTION CmdHeadTail (args AS Array OF String, input AS String, top AS Bool) AS String" + NL
    t = t + "    VAR n AS Integer = 10" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR files AS Array OF String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    name = ""tail""" + NL
    t = t + "    IF top THEN name = ""head""" + NL
    t = t + "    i = 0" + NL
    t = t + "    WHILE i < args.Count" + NL
    t = t + "        IF args[i] = ""-n"" AND i + 1 < args.Count THEN" + NL
    t = t + "            n = Int(Val(args[i + 1]))" + NL
    t = t + "            i = i + 2" + NL
    t = t + "        ELSEIF args[i].StartsWith(""-"") AND args[i].Length > 1 THEN" + NL
    t = t + "            n = Int(Val(args[i].Substring(1, args[i].Length - 1).Replace(""n"", """")))" + NL
    t = t + "            i = i + 1" + NL
    t = t + "        ELSE" + NL
    t = t + "            files.Add(args[i])" + NL
    t = t + "            i = i + 1" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF files.Count = 0 THEN" + NL
    t = t + "        text = input" + NL
    t = t + "    ELSE" + NL
    t = t + "        FOR k = 0 TO files.Count - 1" + NL
    t = t + "            TRY" + NL
    t = t + "                text = text + ReadFile(name, files[k])" + NL
    t = t + "            CATCH err" + NL
    t = t + "                Complain(name + "": "" + err)" + NL
    t = t + "            END TRY" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    lines = TextLines(text)" + NL
    t = t + "    IF top THEN" + NL
    t = t + "        FOR k = 0 TO Int(MATH.Min(n, lines.Count)) - 1" + NL
    t = t + "            out.Add(lines[k])" + NL
    t = t + "        NEXT" + NL
    t = t + "    ELSE" + NL
    t = t + "        FOR k = Int(MATH.Max(0, lines.Count - n)) TO lines.Count - 1" + NL
    t = t + "            out.Add(lines[k])" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN LinesText(out)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Counts (text AS String) AS String" + NL
    t = t + "    VAR words AS Integer" + NL
    t = t + "    VAR w AS String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    lines = TextLines(text)" + NL
    t = t + "    FOR EACH ln IN lines" + NL
    t = t + "        FOR EACH w IN ln.Replace(Chr(9), "" "").Split("" "")" + NL
    t = t + "            IF w <> """" THEN words = words + 1" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF flagText = """" THEN RETURN Str(lines.Count).PadLeft(7) + Str(words).PadLeft(8) + Str(text.Length).PadLeft(8)" + NL
    t = t + "    w = """"" + NL
    t = t + "    IF flagText.Contains(""l"") THEN w = w + Str(lines.Count).PadLeft(7)" + NL
    t = t + "    IF flagText.Contains(""w"") THEN w = w + Str(words).PadLeft(8)" + NL
    t = t + "    IF flagText.Contains(""c"") THEN w = w + Str(text.Length).PadLeft(8)" + NL
    t = t + "    RETURN w" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdWc (args AS Array OF String, input AS String) AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    first = Flags(args)" + NL
    t = t + "    IF first >= args.Count THEN RETURN Counts(input) + EOL" + NL
    t = t + "    FOR i = first TO args.Count - 1" + NL
    t = t + "        TRY" + NL
    t = t + "            text = ReadFile(""wc"", args[i])" + NL
    t = t + "            out = out + Counts(text) + "" "" + args[i] + EOL" + NL
    t = t + "        CATCH err" + NL
    t = t + "            Complain(""wc: "" + err)" + NL
    t = t + "        END TRY" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Does a line match? Plain text, with ^ and $ to anchor it." + NL
    t = t + "FUNCTION Matches (ln AS String, pat AS String, nocase AS Bool) AS Bool" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR head AS Bool" + NL
    t = t + "    VAR tail AS Bool" + NL
    t = t + "    s = ln" + NL
    t = t + "    p = pat" + NL
    t = t + "    IF nocase THEN" + NL
    t = t + "        s = s.Lower()" + NL
    t = t + "        p = p.Lower()" + NL
    t = t + "    END IF" + NL
    t = t + "    IF p.StartsWith(""^"") THEN" + NL
    t = t + "        head = TRUE" + NL
    t = t + "        p = p.Substring(1, p.Length - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF p.EndsWith(""$"") AND p.Length > 0 THEN" + NL
    t = t + "        tail = TRUE" + NL
    t = t + "        p = p.Substring(0, p.Length - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF head AND tail THEN RETURN s = p" + NL
    t = t + "    IF head THEN RETURN s.StartsWith(p)" + NL
    t = t + "    IF tail THEN RETURN s.EndsWith(p)" + NL
    t = t + "    RETURN s.Contains(p)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdGrep (args AS Array OF String, input AS String) AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR pat AS String" + NL
    t = t + "    VAR files AS Array OF String" + NL
    t = t + "    VAR texts AS Array OF String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR hit AS Bool" + NL
    t = t + "    VAR count AS Integer" + NL
    t = t + "    VAR found AS Integer" + NL
    t = t + "    VAR pre AS String" + NL
    t = t + "    first = Flags(args)" + NL
    t = t + "    IF first >= args.Count THEN RETURN Usage(""grep [-i] [-n] [-v] [-c] pattern [file...]"")" + NL
    t = t + "    pat = args[first]" + NL
    t = t + "    FOR i = first + 1 TO args.Count - 1" + NL
    t = t + "        TRY" + NL
    t = t + "            texts.Add(ReadFile(""grep"", args[i]))" + NL
    t = t + "            files.Add(args[i])" + NL
    t = t + "        CATCH err" + NL
    t = t + "            Complain(""grep: "" + err)" + NL
    t = t + "        END TRY" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF args.Count = first + 1 THEN" + NL
    t = t + "        texts.Add(input)" + NL
    t = t + "        files.Add("""")" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR k = 0 TO texts.Count - 1" + NL
    t = t + "        lines = TextLines(texts[k])" + NL
    t = t + "        count = 0" + NL
    t = t + "        FOR i = 0 TO lines.Count - 1" + NL
    t = t + "            hit = Matches(lines[i], pat, flagText.Contains(""i""))" + NL
    t = t + "            IF flagText.Contains(""v"") THEN hit = NOT hit" + NL
    t = t + "            IF NOT hit THEN CONTINUE" + NL
    t = t + "            count = count + 1" + NL
    t = t + "            IF flagText.Contains(""c"") OR flagText.Contains(""l"") THEN CONTINUE" + NL
    t = t + "            pre = """"" + NL
    t = t + "            IF files.Count > 1 THEN pre = files[k] + "":""" + NL
    t = t + "            IF flagText.Contains(""n"") THEN pre = pre + Str(i + 1) + "":""" + NL
    t = t + "            out = out + pre + lines[i] + EOL" + NL
    t = t + "        NEXT" + NL
    t = t + "        found = found + count" + NL
    t = t + "        IF flagText.Contains(""l"") AND count > 0 THEN out = out + files[k] + EOL" + NL
    t = t + "        IF flagText.Contains(""c"") THEN" + NL
    t = t + "            IF files.Count > 1 THEN" + NL
    t = t + "                out = out + files[k] + "":"" + Str(count) + EOL" + NL
    t = t + "            ELSE" + NL
    t = t + "                out = out + Str(count) + EOL" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF found = 0 THEN shStatus = 1" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdSort (args AS Array OF String, input AS String) AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    first = Flags(args)" + NL
    t = t + "    text = input" + NL
    t = t + "    IF first < args.Count THEN" + NL
    t = t + "        text = """"" + NL
    t = t + "        FOR i = first TO args.Count - 1" + NL
    t = t + "            text = text + ReadFile(""sort"", args[i])" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    lines = TextLines(text)" + NL
    t = t + "    lines.Sort()" + NL
    t = t + "    IF flagText.Contains(""r"") THEN lines.Reverse()" + NL
    t = t + "    RETURN LinesText(lines)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdUniq (args AS Array OF String, input AS String) AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    FOR EACH ln IN TextLines(input)" + NL
    t = t + "        IF out.Count > 0 THEN" + NL
    t = t + "            IF out[out.Count - 1] = ln THEN CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        out.Add(ln)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN LinesText(out)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdTee (args AS Array OF String, input AS String) AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    first = Flags(args)" + NL
    t = t + "    FOR i = first TO args.Count - 1" + NL
    t = t + "        p = Resolve(args[i])" + NL
    t = t + "        IF flagText.Contains(""a"") AND FS.Exists(p) THEN" + NL
    t = t + "            FS.Append(p, input)" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Write(p, input)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN input" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdSeq (args AS Array OF String) AS String" + NL
    t = t + "    VAR a AS Integer = 1" + NL
    t = t + "    VAR b AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    IF args.Count = 0 THEN RETURN Usage(""seq [first] last"")" + NL
    t = t + "    b = Int(Val(args[args.Count - 1]))" + NL
    t = t + "    IF args.Count > 1 THEN a = Int(Val(args[0]))" + NL
    t = t + "    IF b - a > 5000 THEN b = a + 5000" + NL
    t = t + "    FOR i = a TO b" + NL
    t = t + "        out = out + Str(i) + EOL" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ environment" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdEnv (onlyExported AS Bool) AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO varNames.Count - 1" + NL
    t = t + "        IF onlyExported AND NOT expNames.Contains(varNames[i]) THEN CONTINUE" + NL
    t = t + "        lines.Add(varNames[i] + ""="" + varVals[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    lines.Sort()" + NL
    t = t + "    RETURN LinesText(lines)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdExport (args AS Array OF String, exported AS Bool) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR eq AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    FOR i = 0 TO args.Count - 1" + NL
    t = t + "        eq = args[i].IndexOf(""="")" + NL
    t = t + "        name = args[i]" + NL
    t = t + "        IF eq > 0 THEN name = args[i].Substring(0, eq)" + NL
    t = t + "        IF NOT IsName(name) THEN" + NL
    t = t + "            Complain(""export: "" + args[i] + "": not a valid name"")" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF eq > 0 THEN SetVar(name, args[i].Substring(eq + 1, args[i].Length - eq - 1))" + NL
    t = t + "        IF exported AND NOT expNames.Contains(name.Upper()) THEN expNames.Add(name.Upper())" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdAlias (args AS Array OF String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR eq AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF args.Count = 0 THEN" + NL
    t = t + "        FOR i = 0 TO aliasNames.Count - 1" + NL
    t = t + "            out = out + ""alias "" + aliasNames[i] + ""='"" + aliasVals[i] + ""'"" + EOL" + NL
    t = t + "        NEXT" + NL
    t = t + "        RETURN out" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 0 TO args.Count - 1" + NL
    t = t + "        eq = args[i].IndexOf(""="")" + NL
    t = t + "        IF eq <= 0 THEN" + NL
    t = t + "            k = aliasNames.IndexOf(args[i])" + NL
    t = t + "            IF k < 0 THEN" + NL
    t = t + "                Complain(""alias: "" + args[i] + "": not found"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                out = out + ""alias "" + aliasNames[k] + ""='"" + aliasVals[k] + ""'"" + EOL" + NL
    t = t + "            END IF" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        name = args[i].Substring(0, eq)" + NL
    t = t + "        k = aliasNames.IndexOf(name)" + NL
    t = t + "        IF k >= 0 THEN" + NL
    t = t + "            aliasVals[k] = args[i].Substring(eq + 1, args[i].Length - eq - 1)" + NL
    t = t + "        ELSE" + NL
    t = t + "            aliasNames.Add(name)" + NL
    t = t + "            aliasVals.Add(args[i].Substring(eq + 1, args[i].Length - eq - 1))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdHistory (args AS Array OF String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF args.Count > 0 THEN" + NL
    t = t + "        IF args[0] = ""-c"" THEN" + NL
    t = t + "            hist.Clear()" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 0 TO hist.Count - 1" + NL
    t = t + "        out = out + Str(i + 1).PadLeft(5) + ""  "" + hist[i] + EOL" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdPs () AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    out = ""  PID NAME        STATE     WIN    CPU ms"" + EOL" + NL
    t = t + "    FOR EACH t IN SYS.Tasks()" + NL
    t = t + "        p = t.Split(""|"")" + NL
    t = t + "        out = out + p[0].PadLeft(5) + "" "" + p[1].PadRight(11) + "" "" + p[2].PadRight(9) + p[3].PadLeft(4) + p[4].PadLeft(9) + EOL" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' kill 12, or kill NOTES (every process of that name)" + NL
    t = t + "FUNCTION CmdKill (args AS Array OF String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR hit AS Bool" + NL
    t = t + "    VAR pid AS Integer" + NL
    t = t + "    IF args.Count = 0 THEN RETURN Usage(""kill pid|name"")" + NL
    t = t + "    FOR i = 0 TO args.Count - 1" + NL
    t = t + "        IF args[i].StartsWith(""-"") THEN CONTINUE" + NL
    t = t + "        hit = FALSE" + NL
    t = t + "        FOR EACH t IN SYS.Tasks()" + NL
    t = t + "            pid = Int(Val(t.Split(""|"")[0]))" + NL
    t = t + "            IF (t.Split(""|"")[0] = args[i] OR t.Split(""|"")[1].Upper() = args[i].Upper()) AND pid <> SYS.Pid THEN" + NL
    t = t + "                SYS.Kill(pid)" + NL
    t = t + "                hit = TRUE" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF NOT hit THEN Complain(""kill: "" + args[i] + "": no such process"")" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdWhich (args AS Array OF String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    FOR i = 0 TO args.Count - 1" + NL
    t = t + "        IF aliasNames.IndexOf(args[i]) >= 0 THEN" + NL
    t = t + "            out = out + args[i] + "": aliased to "" + aliasVals[aliasNames.IndexOf(args[i])] + EOL" + NL
    t = t + "        ELSEIF Builtins().Contains(args[i].Lower()) THEN" + NL
    t = t + "            out = out + args[i] + "": shell built-in"" + EOL" + NL
    t = t + "        ELSE" + NL
    t = t + "            p = FindProgram(args[i])" + NL
    t = t + "            IF p = """" THEN" + NL
    t = t + "                Complain(args[i] + "" not found"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                out = out + p + EOL" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdHelp (args AS Array OF String) AS String" + NL
    t = t + "    VAR h AS Array OF String" + NL
    t = t + "    h.Add(""Sim Shell "" + SHVERSION + "" for SIM95. Built-in commands:"")" + NL
    t = t + "    h.Add("""")" + NL
    t = t + "    h.Add(""  files     ls [-l] [path]  cd [dir|-|~]  pwd  cat [-n]  echo [-n]"")" + NL
    t = t + "    h.Add(""            mkdir [-p]  rm [-r] [-f]  rmdir  mv  cp [-r]  touch"")" + NL
    t = t + "    h.Add(""            head [-n N]  tail [-n N]  wc [-l -w -c]  grep [-i -n -v -c]"")" + NL
    t = t + "    h.Add(""            sort [-r]  uniq  tee [-a]  seq  basename"")" + NL
    t = t + "    h.Add(""  shell     env  export NAME=value  set  unset  alias name='text'"")" + NL
    t = t + "    h.Add(""            unalias  history [-c]  clear  exit  sh script.sh  source"")" + NL
    t = t + "    h.Add(""  system    ps  kill pid|name  run prog.spk [args]  date  whoami"")" + NL
    t = t + "    h.Add(""            hostname  uname  which  sleep  true  false  help"")" + NL
    t = t + "    h.Add(""  network   ssh [user@]host [command]   scp src dest (host:path)"")" + NL
    t = t + "    h.Add(""            sim-get update|list|search|show|install|remove|upgrade|store"")" + NL
    t = t + "    h.Add(""            host name [type] [@server]   (or nslookup: ask the SimDNS name server)"")" + NL
    t = t + "    h.Add("""")" + NL
    t = t + "    h.Add(""  cmd1 ; cmd2   cmd1 && cmd2   cmd1 || cmd2   cmd1 | cmd2"")" + NL
    t = t + "    h.Add(""  cmd > file    cmd >> file    cmd < file     $VAR  ${VAR}  $?  'text'"")" + NL
    t = t + "    h.Add(""  /programs/notes.spk is C:\PROGRAMS\NOTES.SPK; ~ is $HOME."")" + NL
    t = t + "    h.Add(""  Type a program's name (notes) or path to run it. Up/Down: history."")" + NL
    t = t + "    h.Add(""  Ctrl+Space completes a file name. Ctrl+C stops. Startup: "" + RCFILE)" + NL
    t = t + "    RETURN LinesText(h)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ ssh, scp: checked here, run by the caller" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdSsh (args AS Array OF String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR rest AS Array OF String" + NL
    t = t + "    IF args.Count = 0 THEN RETURN Usage(""ssh [user@]host [command]"")" + NL
    t = t + "    IF args.Count = 1 THEN" + NL
    t = t + "        Defer(""sshi"", args)" + NL
    t = t + "    ELSE" + NL
    t = t + "        rest.Add(args[0])" + NL
    t = t + "        FOR i = 1 TO args.Count - 1" + NL
    t = t + "            rest.Add(args[i])" + NL
    t = t + "        NEXT" + NL
    t = t + "        Defer(""ssh"", rest)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ sim-get: the Vapor library, shared with VAPOR.SPK" + NL
    t = t + "" + NL
    t = t + "' These follow VAPOR.SPK line for line, so that whatever one installs the" + NL
    t = t + "' other sees. The catalog (http://STORE/vapor/catalog.txt):" + NL
    t = t + "'   id|name|parts|bytes|status|category|about|kind|version|run|files|tasks|startup|folder" + NL
    t = t + "' The library (C:\GAMES\LIBRARY.TXT):" + NL
    t = t + "'   id|name|installed|seconds|category|about|version|kind|run|files|tasks|startup|folder" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Field (ln AS String, i AS Integer) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    p = ln.Split(""|"")" + NL
    t = t + "    IF i >= p.Count THEN RETURN """"" + NL
    t = t + "    RETURN p[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Meta (header AS String, key AS String) AS String" + NL
    t = t + "    VAR part AS String" + NL
    t = t + "    FOR EACH part IN header.Split(""|"")" + NL
    t = t + "        IF part.StartsWith(key + ""="") THEN RETURN part.Substring(key.Length + 1, part.Length - key.Length - 1)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unesc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%0A"", EOL).Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The store, as Vapor keeps it in C:\GAMES\VAPOR.INI (""http://alpha/vapor/"")." + NL
    t = t + "FUNCTION StoreUrl () AS String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    FOR EACH ln IN ReadOr(GAMEDIR + ""\VAPOR.INI"", """").Lines()" + NL
    t = t + "        IF ln.StartsWith(""store="") THEN s = ln.Substring(6, ln.Length - 6).Trim()" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF s = """" AND FS.Exists(""C:\WEB\VAPOR\CATALOG.TXT"") THEN s = ""http://"" + NET.HostName.Lower() + ""/vapor/""" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The catalog from the last sim-get update." + NL
    t = t + "FUNCTION Catalog () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    FOR EACH ln IN ReadOr(GETCACHE, """").Lines()" + NL
    t = t + "        IF ln.Split(""|"").Count >= 7 THEN out.Add(ln)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION StoreLine (id AS String) AS String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    FOR EACH ln IN Catalog()" + NL
    t = t + "        IF Field(ln, 0) = id.Upper() THEN RETURN ln" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Library () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    FOR EACH ln IN ReadOr(GAMEDIR + ""\LIBRARY.TXT"", """").Lines()" + NL
    t = t + "        IF ln.Split(""|"").Count >= 4 THEN out.Add(ln)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LibLine (id AS String) AS String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    FOR EACH ln IN Library()" + NL
    t = t + "        IF Field(ln, 0) = id.Upper() THEN RETURN ln" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION HasUpdate (id AS String) AS Bool" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    VAR shop AS String" + NL
    t = t + "    lib = LibLine(id)" + NL
    t = t + "    shop = StoreLine(id)" + NL
    t = t + "    IF lib = """" OR shop = """" OR Field(shop, 4) <> ""ok"" THEN RETURN FALSE" + NL
    t = t + "    RETURN Field(lib, 6) <> Field(shop, 8)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SaveLibrary (lines AS Array OF String)" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    IF NOT FS.Exists(GAMEDIR) THEN FS.MakeDir(GAMEDIR)" + NL
    t = t + "    IF lines.Count > 0 THEN text = lines.Join(EOL) + EOL" + NL
    t = t + "    FS.Write(GAMEDIR + ""\LIBRARY.TXT"", text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Into the library, or its line there brought up to date (keeping when it" + NL
    t = t + "' was first installed and the time played). Vapor's Keep." + NL
    t = t + "SUB Keep (ln AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    VAR first AS String" + NL
    t = t + "    VAR seconds AS String = ""0""" + NL
    t = t + "    VAR found AS Bool" + NL
    t = t + "    VAR old AS String" + NL
    t = t + "    first = TIME.Date" + NL
    t = t + "    FOR EACH l IN Library()" + NL
    t = t + "        IF Field(l, 0) = Field(ln, 0) THEN" + NL
    t = t + "            first = Field(l, 2)" + NL
    t = t + "            seconds = Field(l, 3)" + NL
    t = t + "            found = TRUE" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    l = Field(ln, 0) + ""|"" + Field(ln, 1) + ""|"" + first + ""|"" + seconds + ""|"" + Field(ln, 5) + ""|"" + Field(ln, 6) + ""|"" + Field(ln, 8) + ""|"" + Field(ln, 7) + ""|"" + Field(ln, 9) + ""|"" + Field(ln, 10) + ""|"" + Field(ln, 11) + ""|"" + Field(ln, 12) + ""|"" + Field(ln, 13)" + NL
    t = t + "    FOR EACH old IN Library()" + NL
    t = t + "        IF Field(old, 0) = Field(l, 0) THEN" + NL
    t = t + "            out.Add(l)" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(old)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT found THEN out.Add(l)" + NL
    t = t + "    SaveLibrary(out)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Folders () AS Bool" + NL
    t = t + "    RETURN ReadOr(WEBAPPSINI, """").Contains(""mode=folders"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Where (f AS String, folder AS String) AS String" + NL
    t = t + "    IF folder = """" OR NOT Folders() THEN RETURN f" + NL
    t = t + "    IF NOT f.Upper().StartsWith(""C:\WEB\"") THEN RETURN f" + NL
    t = t + "    RETURN ""C:\WEB\"" + folder + ""\"" + f.Substring(7, f.Length - 7)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION AllThere (files AS String, folder AS String) AS Bool" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    IF files = """" THEN RETURN FALSE" + NL
    t = t + "    FOR EACH f IN files.Split("";"")" + NL
    t = t + "        IF f <> """" AND NOT FS.Exists(Where(f, folder)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Stops it, takes it out of startup, deletes the files it wrote, and its" + NL
    t = t + "' folder in C:\GAMES. Vapor's Uninstall." + NL
    t = t + "SUB Uninstall (lib AS String)" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR task AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    id = Field(lib, 0)" + NL
    t = t + "    FOR EACH name IN Field(lib, 10).Split("";"")" + NL
    t = t + "        IF name = """" THEN CONTINUE" + NL
    t = t + "        FOR EACH task IN SYS.Tasks()" + NL
    t = t + "            IF task.Split(""|"")[1].Upper() = name.Upper() AND Int(Val(task.Split(""|"")[0])) <> SYS.Pid THEN SYS.Kill(Int(Val(task.Split(""|"")[0])))" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH name IN Field(lib, 11).Split("";"")" + NL
    t = t + "        IF name <> """" AND FS.Exists(""C:\SYSTEM\STARTUP\"" + name) THEN FS.Delete(""C:\SYSTEM\STARTUP\"" + name)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH f IN Field(lib, 9).Split("";"")" + NL
    t = t + "        IF f <> """" AND f.Upper() <> VAPORME THEN" + NL
    t = t + "            IF FS.Exists(Where(f, Field(lib, 12))) THEN FS.Delete(Where(f, Field(lib, 12)))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF Field(lib, 7) = ""web"" AND (Field(lib, 12) = """" OR NOT Folders()) AND NOT FS.Exists(""C:\WEB\INDEX.HTM"") AND FS.Exists(""C:\WEB\WELCOME.HTM"") THEN FS.Rename(""C:\WEB\WELCOME.HTM"", ""C:\WEB\INDEX.HTM"")" + NL
    t = t + "    IF FS.Exists(GAMEDIR + ""\"" + id) THEN" + NL
    t = t + "        FOR EACH f IN FS.List(GAMEDIR + ""\"" + id)" + NL
    t = t + "            IF NOT f.EndsWith(""\"") THEN FS.Delete(GAMEDIR + ""\"" + id + ""\"" + f)" + NL
    t = t + "        NEXT" + NL
    t = t + "        FS.Delete(GAMEDIR + ""\"" + id)" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH l IN Library()" + NL
    t = t + "        IF Field(l, 0) <> id THEN out.Add(l)" + NL
    t = t + "    NEXT" + NL
    t = t + "    SaveLibrary(out)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION KindWord (kind AS String) AS String" + NL
    t = t + "    SELECT CASE kind" + NL
    t = t + "        CASE """", ""game""" + NL
    t = t + "            RETURN ""game""" + NL
    t = t + "        CASE ""web""" + NL
    t = t + "            RETURN ""web app""" + NL
    t = t + "        CASE ""service""" + NL
    t = t + "            RETURN ""service""" + NL
    t = t + "        CASE ""client""" + NL
    t = t + "            RETURN ""store client""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""program""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' sim-get: the local parts run here; update, install and upgrade are jobs." + NL
    t = t + "FUNCTION CmdSimGet (args AS Array OF String) AS String" + NL
    t = t + "    VAR sub1 AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR words AS Array OF String" + NL
    t = t + "    VAR hit AS Bool" + NL
    t = t + "    VAR w AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    IF args.Count = 0 THEN" + NL
    t = t + "        out = ""usage: sim-get update | list [--installed|--upgradable] | search words | show id"" + EOL" + NL
    t = t + "        out = out + ""               install [-y] id... | remove id... | upgrade | store host"" + EOL" + NL
    t = t + "        out = out + ""sim-get installs from a Vapor store and keeps Vapor's own library."" + EOL" + NL
    t = t + "        RETURN out" + NL
    t = t + "    END IF" + NL
    t = t + "    sub1 = args[0].Lower()" + NL
    t = t + "    SELECT CASE sub1" + NL
    t = t + "        CASE ""update"", ""install"", ""upgrade"", ""reinstall""" + NL
    t = t + "            IF StoreUrl() = """" THEN" + NL
    t = t + "                Complain(""E: no store yet. Choose one with: sim-get store <machine>"")" + NL
    t = t + "                RETURN """"" + NL
    t = t + "            END IF" + NL
    t = t + "            Defer(""get"", args)" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""store""" + NL
    t = t + "            IF args.Count < 2 THEN" + NL
    t = t + "                IF StoreUrl() = """" THEN RETURN ""No store yet. Choose one with: sim-get store <machine or domain>"" + EOL" + NL
    t = t + "                RETURN StoreUrl() + EOL" + NL
    t = t + "            END IF" + NL
    t = t + "            ' the same tidying as Vapor's Change Store" + NL
    t = t + "            s = args[1].Trim().Lower()" + NL
    t = t + "            IF NOT s.StartsWith(""http://"") THEN s = ""http://"" + s" + NL
    t = t + "            IF s.Substring(7, s.Length - 7).IndexOf(""/"") < 0 THEN s = s + ""/vapor/""" + NL
    t = t + "            IF NOT s.EndsWith(""/"") THEN s = s + ""/""" + NL
    t = t + "            IF NOT FS.Exists(GAMEDIR) THEN FS.MakeDir(GAMEDIR)" + NL
    t = t + "            FS.Write(GAMEDIR + ""\VAPOR.INI"", ""store="" + s + EOL)" + NL
    t = t + "            IF FS.Exists(GETCACHE) THEN FS.Delete(GETCACHE)" + NL
    t = t + "            RETURN ""Store: "" + s + EOL + ""Now run sim-get update."" + EOL" + NL
    t = t + "        CASE ""list""" + NL
    t = t + "            IF Catalog().Count = 0 AND NOT (args.Count > 1 AND args[args.Count - 1] = ""--installed"") THEN" + NL
    t = t + "                Complain(""E: no package lists. Run sim-get update first."")" + NL
    t = t + "                RETURN """"" + NL
    t = t + "            END IF" + NL
    t = t + "            IF args.Count > 1 AND args[args.Count - 1] = ""--installed"" THEN" + NL
    t = t + "                FOR EACH ln IN Library()" + NL
    t = t + "                    out = out + Field(ln, 0).Lower() + ""/"" + KindWord(Field(ln, 7)) + "" "" + Field(ln, 6) + "" [installed]"" + EOL" + NL
    t = t + "                NEXT" + NL
    t = t + "                RETURN out" + NL
    t = t + "            END IF" + NL
    t = t + "            out = ""Listing..."" + EOL" + NL
    t = t + "            FOR EACH ln IN Catalog()" + NL
    t = t + "                IF Field(ln, 7) = ""client"" THEN CONTINUE" + NL
    t = t + "                lib = LibLine(Field(ln, 0))" + NL
    t = t + "                IF args.Count > 1 AND args[args.Count - 1] = ""--upgradable"" AND NOT HasUpdate(Field(ln, 0)) THEN CONTINUE" + NL
    t = t + "                s = Field(ln, 0).Lower() + ""/"" + KindWord(Field(ln, 7)) + "" "" + Field(ln, 8)" + NL
    t = t + "                IF Field(ln, 4) = ""soon"" THEN" + NL
    t = t + "                    s = s + "" coming-soon""" + NL
    t = t + "                ELSEIF HasUpdate(Field(ln, 0)) THEN" + NL
    t = t + "                    s = s + "" [upgradable from: "" + Field(lib, 6) + ""]""" + NL
    t = t + "                ELSEIF lib <> """" THEN" + NL
    t = t + "                    s = s + "" [installed]""" + NL
    t = t + "                END IF" + NL
    t = t + "                out = out + s + EOL" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN out" + NL
    t = t + "        CASE ""search""" + NL
    t = t + "            IF args.Count < 2 THEN RETURN Usage(""sim-get search words"")" + NL
    t = t + "            FOR EACH ln IN Catalog()" + NL
    t = t + "                IF Field(ln, 7) = ""client"" THEN CONTINUE" + NL
    t = t + "                hit = TRUE" + NL
    t = t + "                FOR i = 1 TO args.Count - 1" + NL
    t = t + "                    w = args[i].Lower()" + NL
    t = t + "                    IF NOT (Field(ln, 0) + "" "" + Field(ln, 1) + "" "" + Field(ln, 5) + "" "" + Unesc(Field(ln, 6))).Lower().Contains(w) THEN hit = FALSE" + NL
    t = t + "                NEXT" + NL
    t = t + "                IF hit THEN out = out + Field(ln, 0).Lower() + "" - "" + Field(ln, 1) + "": "" + Unesc(Field(ln, 6)).Replace(EOL, "" "") + EOL" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF out = """" THEN shStatus = 1" + NL
    t = t + "            RETURN out" + NL
    t = t + "        CASE ""show""" + NL
    t = t + "            IF args.Count < 2 THEN RETURN Usage(""sim-get show id"")" + NL
    t = t + "            ln = StoreLine(args[1])" + NL
    t = t + "            lib = LibLine(args[1])" + NL
    t = t + "            IF ln = """" AND lib = """" THEN" + NL
    t = t + "                Complain(""E: No package found for "" + args[1])" + NL
    t = t + "                RETURN """"" + NL
    t = t + "            END IF" + NL
    t = t + "            IF ln = """" THEN" + NL
    t = t + "                ln = Field(lib, 0) + ""|"" + Field(lib, 1) + ""|0|0|ok|"" + Field(lib, 4) + ""|"" + Field(lib, 5) + ""|"" + Field(lib, 7) + ""|"" + Field(lib, 6) + ""|"" + Field(lib, 8) + ""|"" + Field(lib, 9) + ""|"" + Field(lib, 10) + ""|"" + Field(lib, 11) + ""|"" + Field(lib, 12)" + NL
    t = t + "            END IF" + NL
    t = t + "            out = ""Package: "" + Field(ln, 0).Lower() + EOL" + NL
    t = t + "            out = out + ""Name: "" + Field(ln, 1) + EOL" + NL
    t = t + "            out = out + ""Version: "" + Field(ln, 8) + EOL" + NL
    t = t + "            out = out + ""Kind: "" + KindWord(Field(ln, 7)) + EOL" + NL
    t = t + "            out = out + ""Section: "" + Field(ln, 5) + EOL" + NL
    t = t + "            out = out + ""Size: "" + Str(Int(Val(Field(ln, 3)) / 1024) + 1) + "" kB in "" + Field(ln, 2) + "" parts"" + EOL" + NL
    t = t + "            IF Field(ln, 9) <> """" THEN out = out + ""Run: "" + Field(ln, 9) + EOL" + NL
    t = t + "            IF Field(ln, 10) <> """" THEN out = out + ""Files: "" + Field(ln, 10).Replace("";"", "" "") + EOL" + NL
    t = t + "            IF Field(ln, 12) <> """" THEN out = out + ""Starts with SIM95: "" + Field(ln, 12) + EOL" + NL
    t = t + "            IF lib <> """" THEN" + NL
    t = t + "                out = out + ""Installed: "" + Field(lib, 2) + "" (build "" + Field(lib, 6) + "")"" + EOL" + NL
    t = t + "            ELSE" + NL
    t = t + "                out = out + ""Installed: no"" + EOL" + NL
    t = t + "            END IF" + NL
    t = t + "            IF Field(ln, 4) = ""soon"" THEN out = out + ""Status: coming soon"" + EOL" + NL
    t = t + "            out = out + ""Description: "" + Unesc(Field(ln, 6)).Replace(EOL, "" "") + EOL" + NL
    t = t + "            RETURN out" + NL
    t = t + "        CASE ""remove"", ""purge""" + NL
    t = t + "            IF args.Count < 2 THEN RETURN Usage(""sim-get remove id..."")" + NL
    t = t + "            FOR i = 1 TO args.Count - 1" + NL
    t = t + "                lib = LibLine(args[i])" + NL
    t = t + "                IF lib = """" THEN" + NL
    t = t + "                    Complain(""E: "" + args[i].Lower() + "" is not installed"")" + NL
    t = t + "                    CONTINUE" + NL
    t = t + "                END IF" + NL
    t = t + "                out = out + ""Removing "" + Field(lib, 1) + "" ("" + Field(lib, 6) + "") ..."" + EOL" + NL
    t = t + "                Uninstall(lib)" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF out <> """" THEN out = out + ""Done. Saved data (mail, posts, settings) is left where it was."" + EOL" + NL
    t = t + "            RETURN out" + NL
    t = t + "    END SELECT" + NL
    t = t + "    Complain(""E: Invalid operation "" + args[0])" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' NETJOB.SPK - the Sim Shell's network commands: ssh, scp and sim-get's" + NL
    t = t + "' downloads. CORE.SPK only notes that one is wanted (jobWant, jobKind," + NL
    t = t + "' jobArgs); the window runs it from a GUI_Timer tick with RunJob and, a tick" + NL
    t = t + "' later, hands what it printed back to the waiting pipeline with ShResume." + NL
    t = t + "'" + NL
    t = t + "' Each job starts in a tick of its own, inside the tick's TRY with an empty" + NL
    t = t + "' CATCH (see SIM95-NOTES.md): a Connect nobody answers is caught, but it" + NL
    t = t + "' spoils the rest of that handler, so a failed job sets jobFinished before" + NL
    t = t + "' anything else and the tick ends there. Replies come in through the" + NL
    t = t + "' socket's onMessage and onClose, never Receive." + NL
    t = t + "'" + NL
    t = t + "' ssh speaks to SSHD.SPK on port 22 (see SSHD.SPK for the protocol); scp to" + NL
    t = t + "' the Files service on port 139 (FILESVC.SPK); sim-get to a Vapor store on" + NL
    t = t + "' port 80, exactly as VAPOR.SPK does; host (nslookup) to a SimDNS name" + NL
    t = t + "' server on port 53, printing what DIG.SPK prints." + NL
    t = t + "'" + NL
    t = t + "' Domain names: the builder joins the SimDNS resolver (simweb/src/RESOLVE.SPK," + NL
    t = t + "' the Rs... names) on the end of SIMSH.SPK. Before a job starts, the window" + NL
    t = t + "' asks the name server about its machine (JobLookup), in ticks of their own;" + NL
    t = t + "' the job then connects to the machine SimDNS named (RsTarget), and sim-get" + NL
    t = t + "' still sends Host: with the store's name as written." + NL
    t = t + "" + NL
    t = t + "CONST SSHPORT = 22" + NL
    t = t + "CONST FILEPORT = 139" + NL
    t = t + "CONST JOBPATIENCE = 15000" + NL
    t = t + "CONST MSGMAX = 60000" + NL
    t = t + "" + NL
    t = t + "VAR jobSock AS NET_Socket" + NL
    t = t + "VAR jobConn AS NET_Connection" + NL
    t = t + "VAR jobNo AS Integer" + NL
    t = t + "VAR jobParts AS Array OF String" + NL
    t = t + "VAR jobAnswer AS String" + NL
    t = t + "VAR jobAnswered AS Bool" + NL
    t = t + "VAR jobClosed AS Bool" + NL
    t = t + "VAR jobBroken AS Bool           ' a Connect failed: this tick must end" + NL
    t = t + "VAR jobError AS String" + NL
    t = t + "VAR jobPass AS String           ' the password for ssh and scp, asked for by the window" + NL
    t = t + "VAR jobRunning AS Bool" + NL
    t = t + "VAR jobFinished AS Bool         ' done: ShResume on the next tick" + NL
    t = t + "VAR jobResult AS String" + NL
    t = t + "VAR jobResultStatus AS Integer" + NL
    t = t + "VAR jobBeat AS Integer          ' SYS.Ticks when the job last showed signs of life" + NL
    t = t + "" + NL
    t = t + "' an interactive ssh session" + NL
    t = t + "VAR remoteOn AS Bool" + NL
    t = t + "VAR remoteHost AS String" + NL
    t = t + "VAR remotePrompt AS String" + NL
    t = t + "" + NL
    t = t + "SUB JobInit ()" + NL
    t = t + "    jobSock = NET_Socket.New()" + NL
    t = t + "    jobSock.onMessage = Job_OnMessage" + NL
    t = t + "    jobSock.onClose = Job_OnClose" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Job_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    IF conn.Tag <> Str(jobNo) THEN RETURN" + NL
    t = t + "    jobParts.Add(message)" + NL
    t = t + "    jobAnswer = message" + NL
    t = t + "    jobAnswered = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Job_OnClose (conn AS NET_Connection)" + NL
    t = t + "    IF conn.Tag = Str(jobNo) THEN jobClosed = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Printed as the job goes (the window shows it at once)." + NL
    t = t + "SUB JobSay (text AS String)" + NL
    t = t + "    shOut = shOut + text + EOL" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The job is over; its output goes down the pipeline next tick." + NL
    t = t + "SUB JobEnd (status AS Integer)" + NL
    t = t + "    jobResultStatus = status" + NL
    t = t + "    jobFinished = TRUE" + NL
    t = t + "    jobBeat = 0" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Whether a job needs a password before it can start." + NL
    t = t + "FUNCTION JobNeedsPass () AS Bool" + NL
    t = t + "    RETURN jobKind = ""ssh"" OR jobKind = ""sshi"" OR jobKind = ""scp""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The machine a job talks to, for the password prompt." + NL
    t = t + "FUNCTION JobTarget () AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    t = jobArgs[0]" + NL
    t = t + "    IF jobKind = ""scp"" THEN" + NL
    t = t + "        IF NOT IsRemote(t) AND jobArgs.Count > 1 THEN t = jobArgs[1]" + NL
    t = t + "        t = t.Substring(0, t.IndexOf("":""))" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT t.Contains(""@"") THEN t = shUser + ""@"" + t" + NL
    t = t + "    RETURN t" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The machine a job will connect to, as typed ("""" for none)." + NL
    t = t + "FUNCTION JobHost () AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    SELECT CASE jobKind" + NL
    t = t + "        CASE ""ssh"", ""sshi"", ""scp""" + NL
    t = t + "            t = JobTarget()" + NL
    t = t + "            IF jobKind = ""scp"" THEN" + NL
    t = t + "                FOR EACH a IN jobArgs" + NL
    t = t + "                    IF NOT a.StartsWith(""-"") AND IsRemote(a) THEN t = a.Substring(0, a.IndexOf("":""))" + NL
    t = t + "                NEXT" + NL
    t = t + "            END IF" + NL
    t = t + "            IF t.Contains(""@"") THEN t = t.Substring(t.IndexOf(""@"") + 1, t.Length - t.IndexOf(""@"") - 1)" + NL
    t = t + "            RETURN t" + NL
    t = t + "        CASE ""get""" + NL
    t = t + "            t = StoreUrl()" + NL
    t = t + "            IF NOT t.Lower().StartsWith(""http://"") THEN RETURN """"" + NL
    t = t + "            t = t.Substring(7, t.Length - 7)" + NL
    t = t + "            IF t.Contains(""/"") THEN t = t.Substring(0, t.IndexOf(""/""))" + NL
    t = t + "            RETURN t" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Called from the window's tick before the job: TRUE while its machine's" + NL
    t = t + "' name is being asked about (the tick must end, see RsNext)." + NL
    t = t + "FUNCTION JobLookup () AS Bool" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = JobHost()" + NL
    t = t + "    IF h = """" THEN RETURN FALSE" + NL
    t = t + "    RETURN RsNext(h)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Called from the window's tick, inside its TRY." + NL
    t = t + "SUB RunJob ()" + NL
    t = t + "    jobRunning = TRUE" + NL
    t = t + "    jobBroken = FALSE" + NL
    t = t + "    jobFinished = FALSE" + NL
    t = t + "    jobResult = """"" + NL
    t = t + "    jobResultStatus = 0" + NL
    t = t + "    jobBeat = SYS.Ticks" + NL
    t = t + "    TRY" + NL
    t = t + "        SELECT CASE jobKind" + NL
    t = t + "            CASE ""ssh""" + NL
    t = t + "                SshJob(FALSE)" + NL
    t = t + "            CASE ""sshi""" + NL
    t = t + "                SshJob(TRUE)" + NL
    t = t + "            CASE ""scp""" + NL
    t = t + "                ScpJob()" + NL
    t = t + "            CASE ""get""" + NL
    t = t + "                GetJob()" + NL
    t = t + "            CASE ""host""" + NL
    t = t + "                HostJob()" + NL
    t = t + "        END SELECT" + NL
    t = t + "    CATCH err" + NL
    t = t + "        IF NOT jobBroken THEN" + NL
    t = t + "            JobSay(jobKind.Replace(""sshi"", ""ssh"").Replace(""get"", ""sim-get"") + "": "" + err)" + NL
    t = t + "            jobResultStatus = 1" + NL
    t = t + "        END IF" + NL
    t = t + "    END TRY" + NL
    t = t + "    jobPass = """"" + NL
    t = t + "    jobFinished = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Next tick: give the output to the pipeline." + NL
    t = t + "SUB JobCollect ()" + NL
    t = t + "    jobFinished = FALSE" + NL
    t = t + "    jobRunning = FALSE" + NL
    t = t + "    ShResume(jobResult, jobResultStatus)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Ctrl+C: forget the job." + NL
    t = t + "SUB JobCancel ()" + NL
    t = t + "    IF jobRunning OR jobWant THEN" + NL
    t = t + "        jobNo = jobNo + 1" + NL
    t = t + "        jobRunning = FALSE" + NL
    t = t + "        jobFinished = FALSE" + NL
    t = t + "        jobWant = FALSE" + NL
    t = t + "        pendStages.Clear()" + NL
    t = t + "        jobPass = """"" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ talking" + NL
    t = t + "" + NL
    t = t + "FUNCTION JobConnect (host AS String, port AS Integer) AS Bool" + NL
    t = t + "    jobNo = jobNo + 1" + NL
    t = t + "    jobParts.Clear()" + NL
    t = t + "    jobAnswered = FALSE" + NL
    t = t + "    jobClosed = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        jobConn = jobSock.Connect(host, port)" + NL
    t = t + "        jobConn.Tag = Str(jobNo)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        ' (the handler is spoiled now: note the failure and get out)" + NL
    t = t + "        jobBroken = TRUE" + NL
    t = t + "        jobError = err" + NL
    t = t + "        jobFinished = TRUE" + NL
    t = t + "        jobBeat = 0" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END TRY" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One message, and the one that answers it." + NL
    t = t + "FUNCTION JobRequest (text AS String) AS String" + NL
    t = t + "    VAR since AS Integer" + NL
    t = t + "    jobAnswered = FALSE" + NL
    t = t + "    jobAnswer = """"" + NL
    t = t + "    IF jobClosed THEN THROW ""the other machine hung up""" + NL
    t = t + "    jobConn.Send(text)" + NL
    t = t + "    since = SYS.Ticks" + NL
    t = t + "    WHILE NOT jobAnswered AND NOT jobClosed AND SYS.Ticks - since < JOBPATIENCE" + NL
    t = t + "        jobBeat = SYS.Ticks" + NL
    t = t + "        SYS.Sleep(20)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF NOT jobAnswered THEN" + NL
    t = t + "        IF jobClosed THEN THROW ""the other machine hung up""" + NL
    t = t + "        THROW ""the other machine stopped answering""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN jobAnswer" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JobHangUp ()" + NL
    t = t + "    TRY" + NL
    t = t + "        IF jobConn.IsOpen THEN jobConn.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Line n of a reply, and everything after line n." + NL
    t = t + "FUNCTION ReplyLine (reply AS String, n AS Integer) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    p = reply.Split(EOL)" + NL
    t = t + "    IF n >= p.Count THEN RETURN """"" + NL
    t = t + "    RETURN p[n]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReplyRest (reply AS String, n AS Integer) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    p = reply.Split(EOL)" + NL
    t = t + "    FOR i = n TO p.Count - 1" + NL
    t = t + "        out.Add(p[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out.Join(EOL)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ ssh" + NL
    t = t + "" + NL
    t = t + "SUB SshJob (interactive AS Bool)" + NL
    t = t + "    VAR user AS String" + NL
    t = t + "    VAR host AS String" + NL
    t = t + "    VAR reply AS String" + NL
    t = t + "    VAR cmd AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    user = shUser" + NL
    t = t + "    host = jobArgs[0]" + NL
    t = t + "    IF host.Contains(""@"") THEN" + NL
    t = t + "        user = host.Substring(0, host.IndexOf(""@""))" + NL
    t = t + "        host = host.Substring(host.IndexOf(""@"") + 1, host.Length - host.IndexOf(""@"") - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT JobConnect(RsTarget(host), SSHPORT) THEN" + NL
    t = t + "        JobSay(""ssh: connect to host "" + host + "" port 22: "" + jobError)" + NL
    t = t + "        JobEnd(255)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    reply = JobRequest(""AUTH "" + user + ""|"" + jobPass)" + NL
    t = t + "    IF NOT reply.StartsWith(""OK"") THEN" + NL
    t = t + "        JobHangUp()" + NL
    t = t + "        JobSay(user + ""@"" + host + "": Permission denied (password)."")" + NL
    t = t + "        JobEnd(255)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF interactive THEN" + NL
    t = t + "        remoteOn = TRUE" + NL
    t = t + "        remoteHost = host.Lower()" + NL
    t = t + "        remotePrompt = ReplyLine(reply, 1)" + NL
    t = t + "        IF ReplyRest(reply, 2) <> """" THEN JobSay(ReplyRest(reply, 2))" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 1 TO jobArgs.Count - 1" + NL
    t = t + "        cmd.Add(jobArgs[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    reply = JobRequest(""RUN "" + cmd.Join("" ""))" + NL
    t = t + "    JobHangUp()" + NL
    t = t + "    jobResult = ReplyRest(reply, 2)" + NL
    t = t + "    IF jobResult <> """" AND NOT jobResult.EndsWith(EOL) THEN jobResult = jobResult + EOL" + NL
    t = t + "    IF reply.StartsWith(""ERR"") THEN" + NL
    t = t + "        JobSay(""ssh: "" + reply.Substring(4, reply.Length - 4))" + NL
    t = t + "        jobResultStatus = 255" + NL
    t = t + "    ELSE" + NL
    t = t + "        jobResultStatus = Int(Val(ReplyLine(reply, 0).Substring(3, ReplyLine(reply, 0).Length - 3)))" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One line typed in an interactive session, run over there." + NL
    t = t + "SUB RemoteRun (line AS String)" + NL
    t = t + "    VAR reply AS String" + NL
    t = t + "    VAR body AS String" + NL
    t = t + "    TRY" + NL
    t = t + "        reply = JobRequest(""RUN "" + line)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        RemoteGone()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END TRY" + NL
    t = t + "    body = ReplyRest(reply, 2)" + NL
    t = t + "    IF body <> """" THEN" + NL
    t = t + "        IF NOT body.EndsWith(EOL) THEN body = body + EOL" + NL
    t = t + "        shOut = shOut + body" + NL
    t = t + "    END IF" + NL
    t = t + "    IF reply.StartsWith(""BYE"") OR reply.StartsWith(""ERR"") THEN" + NL
    t = t + "        IF reply.StartsWith(""ERR"") THEN JobSay(reply)" + NL
    t = t + "        JobHangUp()" + NL
    t = t + "        RemoteGone()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    shClear = shClear OR ReplyLine(reply, 0).EndsWith("" clear"")" + NL
    t = t + "    remotePrompt = ReplyLine(reply, 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RemoteGone ()" + NL
    t = t + "    IF NOT remoteOn THEN RETURN" + NL
    t = t + "    remoteOn = FALSE" + NL
    t = t + "    JobSay(""Connection to "" + remoteHost + "" closed."")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ scp" + NL
    t = t + "" + NL
    t = t + "' host:path or user@host:path (but not C:\path)" + NL
    t = t + "FUNCTION IsRemote (s AS String) AS Bool" + NL
    t = t + "    RETURN s.IndexOf("":"") >= 2" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A path on the other machine: /x and C:\X as they are, anything else in" + NL
    t = t + "' its C:\MYFILES." + NL
    t = t + "FUNCTION RemotePath (p AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = p.Replace(""/"", ""\"")" + NL
    t = t + "    IF s = """" OR s = ""~"" THEN RETURN ""C:\MYFILES""" + NL
    t = t + "    IF s.StartsWith(""~\"") THEN RETURN ""C:\MYFILES"" + s.Substring(1, s.Length - 1).Upper()" + NL
    t = t + "    IF s.StartsWith(""\"") THEN RETURN ""C:"" + s.Upper()" + NL
    t = t + "    IF s.Length >= 2 AND s.CharAt(1) = "":"" THEN RETURN s.Upper()" + NL
    t = t + "    RETURN ""C:\MYFILES\"" + s.Upper()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB ScpJob ()" + NL
    t = t + "    VAR src AS String" + NL
    t = t + "    VAR dst AS String" + NL
    t = t + "    VAR spec AS String" + NL
    t = t + "    VAR user AS String" + NL
    t = t + "    VAR host AS String" + NL
    t = t + "    VAR rpath AS String" + NL
    t = t + "    VAR local AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR reply AS String" + NL
    t = t + "    VAR down AS Bool" + NL
    t = t + "    VAR files AS Array OF String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    FOR EACH a IN jobArgs" + NL
    t = t + "        IF NOT a.StartsWith(""-"") THEN files.Add(a)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF files.Count <> 2 THEN" + NL
    t = t + "        JobSay(""usage: scp [user@]host:path localpath  or  scp localpath [user@]host:path"")" + NL
    t = t + "        JobEnd(1)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    src = files[0]" + NL
    t = t + "    dst = files[1]" + NL
    t = t + "    down = IsRemote(src)" + NL
    t = t + "    IF down = IsRemote(dst) THEN" + NL
    t = t + "        JobSay(""scp: one side must be on another machine (host:path), the other here"")" + NL
    t = t + "        JobEnd(1)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    spec = dst" + NL
    t = t + "    IF down THEN spec = src" + NL
    t = t + "    user = shUser" + NL
    t = t + "    host = spec.Substring(0, spec.IndexOf("":""))" + NL
    t = t + "    rpath = RemotePath(spec.Substring(spec.IndexOf("":"") + 1, spec.Length - spec.IndexOf("":"") - 1))" + NL
    t = t + "    IF host.Contains(""@"") THEN" + NL
    t = t + "        user = host.Substring(0, host.IndexOf(""@""))" + NL
    t = t + "        host = host.Substring(host.IndexOf(""@"") + 1, host.Length - host.IndexOf(""@"") - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT down THEN" + NL
    t = t + "        local = Resolve(src)" + NL
    t = t + "        IF NOT FS.Exists(local) OR FS.IsDir(local) THEN" + NL
    t = t + "            JobSay(""scp: "" + src + "": No such file"")" + NL
    t = t + "            JobEnd(1)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        text = FS.Read(local)" + NL
    t = t + "        IF text.Length + rpath.Length + 20 > MSGMAX THEN" + NL
    t = t + "            JobSay(""scp: "" + src + "": too big for one network message ("" + Str(text.Length) + "" bytes; the Files service takes about 60K)"")" + NL
    t = t + "            JobEnd(1)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT JobConnect(RsTarget(host), FILEPORT) THEN" + NL
    t = t + "        JobSay(""scp: connect to host "" + host + "" port 139: "" + jobError)" + NL
    t = t + "        JobEnd(1)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    reply = JobRequest(""AUTH "" + user + ""|"" + jobPass)" + NL
    t = t + "    IF NOT reply.StartsWith(""OK"") THEN" + NL
    t = t + "        JobHangUp()" + NL
    t = t + "        JobSay(user + ""@"" + host + "": Permission denied (password)."")" + NL
    t = t + "        JobEnd(1)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF down THEN" + NL
    t = t + "        reply = JobRequest(""READ "" + rpath)" + NL
    t = t + "        IF NOT reply.StartsWith(""OK"") THEN" + NL
    t = t + "            JobHangUp()" + NL
    t = t + "            JobSay(""scp: "" + host + "":"" + rpath + "": "" + reply.Replace(""ERR "", """"))" + NL
    t = t + "            JobEnd(1)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        text = ReplyRest(reply, 1)" + NL
    t = t + "        local = Resolve(dst)" + NL
    t = t + "        IF FS.Exists(local) THEN" + NL
    t = t + "            IF FS.IsDir(local) THEN local = JoinPath(local, BaseName(rpath))" + NL
    t = t + "        END IF" + NL
    t = t + "        FS.Write(local, text)" + NL
    t = t + "        JobSay(BaseName(rpath).PadRight(24) + ""100%  "" + Str(text.Length).PadLeft(7) + "" bytes  -> "" + local)" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF JobRequest(""STAT "" + rpath) = ""OK"" + EOL + ""D"" THEN rpath = JoinPath(rpath, BaseName(local))" + NL
    t = t + "        reply = JobRequest(""WRITE "" + rpath + EOL + text)" + NL
    t = t + "        IF NOT reply.StartsWith(""OK"") THEN" + NL
    t = t + "            JobHangUp()" + NL
    t = t + "            JobSay(""scp: "" + host + "":"" + rpath + "": "" + reply.Replace(""ERR "", """"))" + NL
    t = t + "            JobEnd(1)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        JobSay(BaseName(local).PadRight(24) + ""100%  "" + Str(text.Length).PadLeft(7) + "" bytes  -> "" + host + "":"" + rpath)" + NL
    t = t + "    END IF" + NL
    t = t + "    JobHangUp()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ sim-get" + NL
    t = t + "" + NL
    t = t + "' A page from the store: its body, or """" with jobError saying why. Like" + NL
    t = t + "' Vapor's StartFetch and Body." + NL
    t = t + "FUNCTION JobFetch (url AS String) AS String" + NL
    t = t + "    VAR host AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR raw AS String" + NL
    t = t + "    VAR since AS Integer" + NL
    t = t + "    host = url.Substring(7, url.Length - 7)" + NL
    t = t + "    path = host.Substring(host.IndexOf(""/""), host.Length - host.IndexOf(""/""))" + NL
    t = t + "    host = host.Substring(0, host.IndexOf(""/""))" + NL
    t = t + "    jobError = """"" + NL
    t = t + "    ' (to the machine SimDNS named; Host: as written, for a site by name)" + NL
    t = t + "    IF NOT JobConnect(RsTarget(host), 80) THEN RETURN """"" + NL
    t = t + "    jobConn.Send(""GET "" + path + "" HTTP/1.0"" + EOL + ""Host: "" + host + EOL + ""User-Agent: sim-get/1.0 (SIM95)"")" + NL
    t = t + "    since = SYS.Ticks" + NL
    t = t + "    WHILE NOT jobClosed AND SYS.Ticks - since < JOBPATIENCE" + NL
    t = t + "        jobBeat = SYS.Ticks" + NL
    t = t + "        SYS.Sleep(20)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    JobHangUp()" + NL
    t = t + "    raw = jobParts.Join(EOL)" + NL
    t = t + "    IF raw = """" THEN" + NL
    t = t + "        jobError = ""no answer""" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT raw.StartsWith(""HTTP/1.0 200"") THEN" + NL
    t = t + "        jobError = raw.Lines()[0]" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT raw.Contains(EOL + EOL) THEN RETURN """"" + NL
    t = t + "    RETURN raw.Substring(raw.IndexOf(EOL + EOL) + 2, raw.Length - raw.IndexOf(EOL + EOL) - 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Kb (bytes AS Integer) AS String" + NL
    t = t + "    RETURN Str(Int(bytes / 1024) + 1) + "" kB""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB GetJob ()" + NL
    t = t + "    VAR what AS String" + NL
    t = t + "    VAR ids AS Array OF String" + NL
    t = t + "    VAR yes AS Bool" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR held AS Integer" + NL
    t = t + "    VAR mine AS String" + NL
    t = t + "    what = jobArgs[0].Lower()" + NL
    t = t + "    FOR i = 1 TO jobArgs.Count - 1" + NL
    t = t + "        a = jobArgs[i]" + NL
    t = t + "        IF a = ""-y"" OR a = ""--yes"" THEN" + NL
    t = t + "            yes = TRUE" + NL
    t = t + "        ELSE" + NL
    t = t + "            ids.Add(a.Upper())" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT GetUpdate(what = ""update"") THEN RETURN" + NL
    t = t + "    IF what = ""update"" THEN RETURN" + NL
    t = t + "    IF what = ""upgrade"" THEN" + NL
    t = t + "        JobSay(""Calculating upgrade... Done"")" + NL
    t = t + "        FOR EACH ln IN Library()" + NL
    t = t + "            IF HasUpdate(Field(ln, 0)) THEN ids.Add(Field(ln, 0))" + NL
    t = t + "        NEXT" + NL
    t = t + "        ' Vapor itself, if it is here and the store has a newer one" + NL
    t = t + "        ln = StoreLine(""VAPOR"")" + NL
    t = t + "        IF ln <> """" AND FS.Exists(VAPORME) THEN" + NL
    t = t + "            mine = ReadOr(VAPORME, """")" + NL
    t = t + "            IF mine.StartsWith(""' VAPOR|"") THEN" + NL
    t = t + "                IF Meta(mine.Lines()[0], ""version"") <> Field(ln, 8) THEN ids.Add(""VAPOR"")" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        IF ids.Count = 0 THEN" + NL
    t = t + "            JobSay(""0 upgraded, 0 newly installed, 0 to remove and 0 not upgraded."")" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        JobSay(""The following packages will be upgraded:"")" + NL
    t = t + "        JobSay(""  "" + ids.Join("" "").Lower())" + NL
    t = t + "        FOR EACH a IN ids" + NL
    t = t + "            IF NOT InstallOne(StoreLine(a), n + 1) THEN RETURN" + NL
    t = t + "            n = n + 1" + NL
    t = t + "        NEXT" + NL
    t = t + "        JobSay(Str(n) + "" upgraded, 0 newly installed, 0 to remove and 0 not upgraded."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' install" + NL
    t = t + "    IF ids.Count = 0 THEN" + NL
    t = t + "        JobSay(""E: install what? (sim-get install id)"")" + NL
    t = t + "        JobEnd(1)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH a IN ids" + NL
    t = t + "        ln = StoreLine(a)" + NL
    t = t + "        IF ln = """" THEN" + NL
    t = t + "            JobSay(""E: Unable to locate package "" + a.Lower())" + NL
    t = t + "            jobResultStatus = 100" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF Field(ln, 4) = ""soon"" THEN" + NL
    t = t + "            JobSay(""E: "" + Field(ln, 1) + "" is coming soon. It is not in the store yet."")" + NL
    t = t + "            jobResultStatus = 100" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF LibLine(a) <> """" AND NOT HasUpdate(a) AND what <> ""reinstall"" THEN" + NL
    t = t + "            JobSay(a.Lower() + "" is already the newest version ("" + Field(LibLine(a), 6) + "")."")" + NL
    t = t + "            held = held + 1" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        ' a web app takes the home page, so it asks first, as Vapor does" + NL
    t = t + "        IF Field(ln, 7) = ""web"" AND LibLine(a) = """" AND NOT (Folders() AND Field(ln, 13) <> """") AND NOT yes THEN" + NL
    t = t + "            JobSay(Field(ln, 1) + "" is a web app: it becomes this machine's home page, http://"" + NET.HostName.Lower() + ""/ (the page there now moves aside to WELCOME.HTM)."")" + NL
    t = t + "            JobSay(""E: not installed. Say so with: sim-get install -y "" + a.Lower())" + NL
    t = t + "            jobResultStatus = 1" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF NOT InstallOne(ln, n + 1) THEN RETURN" + NL
    t = t + "        n = n + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    JobSay(Str(n) + "" newly installed, "" + Str(held) + "" already there."")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The catalog, fresh from the store, into C:\SYSTEM\SIMGET.TXT." + NL
    t = t + "FUNCTION GetUpdate (loud AS Bool) AS Bool" + NL
    t = t + "    VAR store AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    VAR items AS Integer" + NL
    t = t + "    VAR ups AS Integer" + NL
    t = t + "    store = StoreUrl()" + NL
    t = t + "    text = JobFetch(store + ""catalog.txt"")" + NL
    t = t + "    IF jobBroken THEN" + NL
    t = t + "        JobSay(""Err:1 "" + store + "" catalog.txt"")" + NL
    t = t + "        JobSay(""E: Failed to fetch "" + store + ""catalog.txt  "" + jobError)" + NL
    t = t + "        JobEnd(100)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF text = """" THEN" + NL
    t = t + "        JobSay(""Err:1 "" + store + "" catalog.txt"")" + NL
    t = t + "        JobSay(""E: Failed to fetch "" + store + ""catalog.txt  "" + jobError)" + NL
    t = t + "        JobEnd(100)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    FS.Write(GETCACHE, text)" + NL
    t = t + "    IF NOT loud THEN" + NL
    t = t + "        JobSay(""Hit:1 "" + store + "" catalog.txt"")" + NL
    t = t + "        RETURN TRUE" + NL
    t = t + "    END IF" + NL
    t = t + "    JobSay(""Get:1 "" + store + "" catalog.txt ["" + Str(text.Length) + "" B]"")" + NL
    t = t + "    JobSay(""Reading package lists... Done"")" + NL
    t = t + "    FOR EACH ln IN Catalog()" + NL
    t = t + "        IF Field(ln, 7) = ""client"" THEN CONTINUE" + NL
    t = t + "        items = items + 1" + NL
    t = t + "        IF HasUpdate(Field(ln, 0)) THEN ups = ups + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF ups = 0 THEN" + NL
    t = t + "        JobSay(Str(items) + "" packages in the store. All installed packages are up to date."")" + NL
    t = t + "    ELSE" + NL
    t = t + "        JobSay(Str(items) + "" packages in the store. "" + Str(ups) + "" can be upgraded. Run 'sim-get list --upgradable' to see them."")" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Download one catalog item and set it up the way Vapor's Finish does." + NL
    t = t + "FUNCTION InstallOne (ln AS String, k AS Integer) AS Bool" + NL
    t = t + "    VAR store AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR parts AS Integer" + NL
    t = t + "    VAR p AS Integer" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR chunk AS String" + NL
    t = t + "    VAR started AS Integer" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR pid AS Integer" + NL
    t = t + "    VAR since AS Integer" + NL
    t = t + "    VAR secs AS Integer" + NL
    t = t + "    store = StoreUrl()" + NL
    t = t + "    id = Field(ln, 0)" + NL
    t = t + "    parts = Int(Val(Field(ln, 2)))" + NL
    t = t + "    kind = Field(ln, 7)" + NL
    t = t + "    IF kind = """" THEN kind = ""game""" + NL
    t = t + "    started = SYS.Ticks" + NL
    t = t + "    JobSay(""Get:"" + Str(k) + "" "" + store + "" "" + id.Lower() + "" "" + Str(parts) + "" parts ["" + Kb(Int(Val(Field(ln, 3)))) + ""]"")" + NL
    t = t + "    FOR p = 1 TO parts" + NL
    t = t + "        chunk = JobFetch(store + id.Lower() + ""/"" + Str(p) + "".txt"")" + NL
    t = t + "        IF jobBroken OR chunk = """" THEN" + NL
    t = t + "            JobSay(""E: Failed to fetch "" + store + id.Lower() + ""/"" + Str(p) + "".txt  "" + jobError)" + NL
    t = t + "            JobEnd(100)" + NL
    t = t + "            RETURN FALSE" + NL
    t = t + "        END IF" + NL
    t = t + "        text = text + chunk" + NL
    t = t + "    NEXT" + NL
    t = t + "    secs = Int((SYS.Ticks - started) / 1000)" + NL
    t = t + "    JobSay(""Fetched "" + Kb(text.Length) + "" in "" + Str(MATH.Max(1, secs)) + ""s"")" + NL
    t = t + "    IF kind = ""client"" THEN" + NL
    t = t + "        FS.Write(VAPORME, text)" + NL
    t = t + "        JobSay(""Unpacking Vapor ("" + Field(ln, 8) + "") ... restart Vapor to use it."")" + NL
    t = t + "        RETURN TRUE" + NL
    t = t + "    END IF" + NL
    t = t + "    dir = GAMEDIR + ""\"" + id" + NL
    t = t + "    IF NOT FS.Exists(GAMEDIR) THEN FS.MakeDir(GAMEDIR)" + NL
    t = t + "    IF NOT FS.Exists(dir) THEN FS.MakeDir(dir)" + NL
    t = t + "    JobSay(""Unpacking "" + Field(ln, 1) + "" ("" + Field(ln, 8) + "") ..."")" + NL
    t = t + "    IF kind = ""game"" THEN" + NL
    t = t + "        FS.Write(dir + ""\"" + id + "".SPK"", text)" + NL
    t = t + "        Keep(ln)" + NL
    t = t + "        JobSay(""Setting up "" + Field(ln, 1) + "" ("" + Field(ln, 8) + "") ... play it: "" + dir + ""\"" + id + "".SPK"")" + NL
    t = t + "        RETURN TRUE" + NL
    t = t + "    END IF" + NL
    t = t + "    ' an installer: an update clears away the old files it writes first, then" + NL
    t = t + "    ' it runs, and it is done when they are all back (or when it ends)" + NL
    t = t + "    FS.Write(dir + ""\INSTALL.SPK"", text)" + NL
    t = t + "    IF LibLine(id) <> """" THEN" + NL
    t = t + "        FOR EACH f IN Field(ln, 10).Split("";"")" + NL
    t = t + "            IF f <> """" AND f.Upper() <> VAPORME THEN" + NL
    t = t + "                IF FS.Exists(Where(f, Field(ln, 13))) THEN FS.Delete(Where(f, Field(ln, 13)))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    JobSay(""Setting up "" + Field(ln, 1) + "" ("" + Field(ln, 8) + "") ... running its installer"")" + NL
    t = t + "    since = SYS.Ticks" + NL
    t = t + "    pid = SYS.Run(dir + ""\INSTALL.SPK"")" + NL
    t = t + "    WHILE TRUE" + NL
    t = t + "        jobBeat = SYS.Ticks" + NL
    t = t + "        SYS.Sleep(100)" + NL
    t = t + "        IF NOT TaskAlive(pid) THEN BREAK" + NL
    t = t + "        IF SYS.Ticks - since > 300 AND AllThere(Field(ln, 10), Field(ln, 13)) THEN BREAK" + NL
    t = t + "        IF SYS.Ticks - since > 60000 THEN BREAK" + NL
    t = t + "    END WHILE" + NL
    t = t + "    Keep(ln)" + NL
    t = t + "    IF kind = ""web"" THEN" + NL
    t = t + "        JobSay(Field(ln, 1) + "" is installed: open it in your browser."")" + NL
    t = t + "    ELSE" + NL
    t = t + "        JobSay(Field(ln, 1) + "" is installed. Run: "" + Field(ln, 9))" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION TaskAlive (pid AS Integer) AS Bool" + NL
    t = t + "    VAR task AS String" + NL
    t = t + "    FOR EACH task IN SYS.Tasks()" + NL
    t = t + "        IF Int(Val(task.Split(""|"")[0])) = pid THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ host, dig, nslookup" + NL
    t = t + "" + NL
    t = t + "' Asks a SimDNS name server about a name and prints the answer the way" + NL
    t = t + "' DIG.SPK does:  host name [A|CNAME|MX|TXT|NS|SOA|ANY] [@server]" + NL
    t = t + "SUB HostJob ()" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR qtype AS String = ""A""" + NL
    t = t + "    VAR server AS String" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    VAR started AS Integer" + NL
    t = t + "    VAR reply AS String" + NL
    t = t + "    FOR EACH a IN jobArgs" + NL
    t = t + "        IF a.StartsWith(""@"") THEN" + NL
    t = t + "            server = a.Substring(1, a.Length - 1).Lower()" + NL
    t = t + "        ELSEIF ""|A|CNAME|MX|TXT|NS|SOA|ANY|"".Contains(""|"" + a.Upper() + ""|"") AND name <> """" THEN" + NL
    t = t + "            qtype = a.Upper()" + NL
    t = t + "        ELSEIF a.StartsWith(""-"") THEN" + NL
    t = t + "            ' (nslookup's and dig's switches: none needed)" + NL
    t = t + "        ELSE" + NL
    t = t + "            name = a.Lower()" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF name = """" THEN" + NL
    t = t + "        JobSay(""Which name? For example:  host www.coolsite.sim"")" + NL
    t = t + "        JobEnd(1)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF server = """" THEN server = RsNameServer()" + NL
    t = t + "    IF server = """" THEN" + NL
    t = t + "        JobSay("";; SimDNS is off (nameserver=none in C:\SYSTEM\RESOLV.INI). DIG SET DEFAULT turns it on."")" + NL
    t = t + "        JobEnd(1)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    JobSay("""")" + NL
    t = t + "    JobSay(""; <<>> DiG 2.1 for SIM95 (SimDNS) <<>> "" + name + "" "" + qtype)" + NL
    t = t + "    addr = NET.Resolve(server)" + NL
    t = t + "    IF addr = """" THEN" + NL
    t = t + "        JobSay("";; connection failed: there is no machine called "" + server)" + NL
    t = t + "        JobEnd(9)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    started = SYS.Ticks" + NL
    t = t + "    IF NOT JobConnect(addr, RSPORT) THEN" + NL
    t = t + "        ' (the handler is spoiled: no more waiting)" + NL
    t = t + "        JobSay("";; connection to "" + server + "" ("" + addr + "") port 53 failed: "" + jobError.Split("":"")[0] + "". Is NAMED.SPK running there?"")" + NL
    t = t + "        JobEnd(9)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    jobAnswered = FALSE" + NL
    t = t + "    jobConn.Send(""QUERY "" + RsFull(name) + "" "" + qtype)" + NL
    t = t + "    WHILE NOT jobAnswered AND NOT jobClosed AND SYS.Ticks - started < 3000" + NL
    t = t + "        jobBeat = SYS.Ticks" + NL
    t = t + "        SYS.Sleep(20)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    JobHangUp()" + NL
    t = t + "    IF NOT jobAnswered THEN" + NL
    t = t + "        JobSay("";; connection timed out; no answer from "" + server)" + NL
    t = t + "        JobEnd(9)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    reply = jobAnswer" + NL
    t = t + "    HostShow(reply, name, qtype, server, addr, SYS.Ticks - started)" + NL
    t = t + "    IF NOT reply.StartsWith(""OK"") THEN jobResultStatus = 1" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The answer, as DIG.SPK's Show prints it, and where a machine name leads." + NL
    t = t + "SUB HostShow (reply AS String, name AS String, qtype AS String, server AS String, addr AS String, ms AS Integer)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR status AS String" + NL
    t = t + "    VAR last AS String" + NL
    t = t + "    VAR machine AS String" + NL
    t = t + "    VAR rest AS Array OF String" + NL
    t = t + "    VAR found AS String" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    status = lines[0].Split("" "")[0]" + NL
    t = t + "    IF status = ""OK"" THEN status = ""NOERROR""" + NL
    t = t + "    JobSay("";; ->>HEADER<<- status: "" + status + "", answers: "" + Str(lines.Count - 1))" + NL
    t = t + "    IF lines[0].Contains("" "") THEN JobSay("";; "" + lines[0].Substring(lines[0].IndexOf("" "") + 1, lines[0].Length - lines[0].IndexOf("" "") - 1))" + NL
    t = t + "    JobSay("""")" + NL
    t = t + "    JobSay("";; QUESTION SECTION:"")" + NL
    t = t + "    JobSay("";"" + (RsFull(name) + ""."").PadRight(31) + "" IN  "" + qtype)" + NL
    t = t + "    IF lines.Count > 1 THEN" + NL
    t = t + "        JobSay("""")" + NL
    t = t + "        JobSay("";; ANSWER SECTION:"")" + NL
    t = t + "        FOR i = 1 TO lines.Count - 1" + NL
    t = t + "            w = lines[i].Split("" "")" + NL
    t = t + "            IF w.Count < 4 THEN CONTINUE" + NL
    t = t + "            rest.Clear()" + NL
    t = t + "            FOR k = 3 TO w.Count - 1" + NL
    t = t + "                rest.Add(w[k])" + NL
    t = t + "            NEXT" + NL
    t = t + "            JobSay((w[0] + ""."").PadRight(24) + "" "" + w[1].PadRight(6) + "" IN  "" + w[2].PadRight(6) + "" "" + rest.Join("" ""))" + NL
    t = t + "            IF w[2] = ""CNAME"" THEN last = w[3]" + NL
    t = t + "            IF w[2] = ""A"" THEN last = """"" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    ' a CNAME chain that ends at a name SimDNS doesn't know ends at a machine" + NL
    t = t + "    IF last <> """" THEN" + NL
    t = t + "        machine = last" + NL
    t = t + "        FOR i = 1 TO lines.Count - 1" + NL
    t = t + "            IF lines[i].StartsWith(last + "" "") THEN machine = """"" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF machine <> """" THEN" + NL
    t = t + "            found = NET.Resolve(machine)" + NL
    t = t + "            IF found = """" THEN found = ""not on the network now""" + NL
    t = t + "            JobSay("""")" + NL
    t = t + "            JobSay("";; "" + machine + "" is a SIM95 machine name: "" + found + "" (asked SIM95, not SimDNS)"")" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    JobSay("""")" + NL
    t = t + "    JobSay("";; Query time: "" + Str(ms) + "" msec"")" + NL
    t = t + "    JobSay("";; SERVER: "" + server + "" ("" + addr + "") port 53"")" + NL
    t = t + "    JobSay("";; WHEN: "" + TIME.Date + "" "" + TIME.Clock)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' WINDOW.SPK - the Sim Shell window: a bash-like terminal. The scrollback is a" + NL
    t = t + "' mono GUI_ListBox, the input a GUI_TextBox with a user@host:path$ prompt. Up" + NL
    t = t + "' and Down walk the history, Ctrl+Space completes a file name, Ctrl+C stops." + NL
    t = t + "'" + NL
    t = t + "' CORE.SPK does the parsing and the built-ins; NETJOB.SPK does ssh, scp and" + NL
    t = t + "' sim-get. The window ties them together: it echoes a line, hands it to the" + NL
    t = t + "' shell, and a GUI_Timer drives the work a step at a time so a long job never" + NL
    t = t + "' hangs the window. Network jobs run one per tick, each inside the tick's TRY" + NL
    t = t + "' with an empty CATCH (SIM95-NOTES.md: a failed Connect spoils its handler)." + NL
    t = t + "" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR screen AS GUI_ListBox" + NL
    t = t + "VAR promptLbl AS GUI_Label" + NL
    t = t + "VAR inbox AS GUI_TextBox" + NL
    t = t + "VAR clock AS GUI_Timer" + NL
    t = t + "" + NL
    t = t + "VAR busy AS Bool" + NL
    t = t + "VAR passMode AS Bool            ' the input box is taking a password" + NL
    t = t + "VAR goJob AS Bool              ' a password is in hand: run the job now" + NL
    t = t + "VAR remoteLine AS String       ' a line to run on the remote machine" + NL
    t = t + "VAR haveRemoteLine AS Bool" + NL
    t = t + "VAR histPos AS Integer" + NL
    t = t + "VAR curLine AS String" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    VAR me AS String" + NL
    t = t + "    EOL = Chr(10)" + NL
    t = t + "    me = MachineUser()" + NL
    t = t + "    IF me = """" THEN me = ""user""" + NL
    t = t + "    ShInit(me, NET.HostName.Lower())" + NL
    t = t + "    JobInit()" + NL
    t = t + "" + NL
    t = t + "    win = GUI_Window.New(""Sim Shell"", 620, 400)" + NL
    t = t + "    win.Icon = ""terminal""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    win.onResize = Win_OnResize" + NL
    t = t + "    win.onKey = Win_OnKey" + NL
    t = t + "" + NL
    t = t + "    screen = GUI_ListBox.New(win)" + NL
    t = t + "    screen.Mono = TRUE" + NL
    t = t + "    promptLbl = GUI_Label.New(win)" + NL
    t = t + "    promptLbl.Bold = TRUE" + NL
    t = t + "    inbox = GUI_TextBox.New(win)" + NL
    t = t + "    inbox.onEnter = In_Enter" + NL
    t = t + "    inbox.onKey = In_Key" + NL
    t = t + "    Layout()" + NL
    t = t + "" + NL
    t = t + "    Echo(""Sim Shell "" + SHVERSION + "" for SIM95.  Type help for a list of commands."")" + NL
    t = t + "    Echo("""")" + NL
    t = t + "    ShRc()" + NL
    t = t + "" + NL
    t = t + "    clock = GUI_Timer.New(win)" + NL
    t = t + "    clock.Interval = 40" + NL
    t = t + "    clock.onTick = Clock_OnTick" + NL
    t = t + "    clock.Start()" + NL
    t = t + "" + NL
    t = t + "    win.Show()" + NL
    t = t + "    inbox.Focus()" + NL
    t = t + "    Ready()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    TRY" + NL
    t = t + "        JobHangUp()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnResize ()" + NL
    t = t + "    Layout()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Layout ()" + NL
    t = t + "    VAR w AS Integer" + NL
    t = t + "    VAR h AS Integer" + NL
    t = t + "    VAR pw AS Integer" + NL
    t = t + "    w = win.Width" + NL
    t = t + "    h = win.Height" + NL
    t = t + "    screen.SetBounds(0, 0, w, h - 26)" + NL
    t = t + "    pw = MATH.Min(260, promptLbl.Text.Length * 7 + 10)" + NL
    t = t + "    promptLbl.SetBounds(4, h - 22, pw, 18)" + NL
    t = t + "    inbox.SetBounds(4 + pw, h - 24, w - pw - 8, 20)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Ctrl+C anywhere stops the running job." + NL
    t = t + "SUB Win_OnKey (key AS String)" + NL
    t = t + "    IF key = ""Ctrl+C"" THEN Interrupt()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the screen" + NL
    t = t + "" + NL
    t = t + "SUB Echo (text AS String)" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    FOR EACH ln IN text.Split(EOL)" + NL
    t = t + "        screen.Add(ln)" + NL
    t = t + "    NEXT" + NL
    t = t + "    WHILE screen.Count > 1000" + NL
    t = t + "        screen.RemoveAt(0)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    screen.ScrollToEnd()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Show whatever the shell has printed, and act on clear." + NL
    t = t + "SUB Flush ()" + NL
    t = t + "    IF shClear THEN" + NL
    t = t + "        screen.Clear()" + NL
    t = t + "        shClear = FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF shOut <> """" THEN" + NL
    t = t + "        ' keep the trailing blank line off (lines already end at EOL)" + NL
    t = t + "        IF shOut.EndsWith(EOL) THEN shOut = shOut.Substring(0, shOut.Length - 1)" + NL
    t = t + "        Echo(shOut)" + NL
    t = t + "        shOut = """"" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Put the prompt up and let the user type." + NL
    t = t + "SUB Ready ()" + NL
    t = t + "    IF passMode THEN RETURN" + NL
    t = t + "    IF remoteOn THEN" + NL
    t = t + "        promptLbl.Text = remotePrompt" + NL
    t = t + "    ELSE" + NL
    t = t + "        promptLbl.Text = Prompt()" + NL
    t = t + "    END IF" + NL
    t = t + "    Layout()" + NL
    t = t + "    inbox.Enabled = TRUE" + NL
    t = t + "    inbox.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ input" + NL
    t = t + "" + NL
    t = t + "SUB In_Enter ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    line = inbox.Text" + NL
    t = t + "    inbox.Text = """"" + NL
    t = t + "    histPos = -1" + NL
    t = t + "" + NL
    t = t + "    IF passMode THEN" + NL
    t = t + "        passMode = FALSE" + NL
    t = t + "        inbox.Password = FALSE" + NL
    t = t + "        jobPass = line" + NL
    t = t + "        goJob = TRUE" + NL
    t = t + "        Echo("""")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    IF remoteOn THEN" + NL
    t = t + "        Echo(remotePrompt + "" "" + line)" + NL
    t = t + "        IF busy THEN RETURN" + NL
    t = t + "        remoteLine = line" + NL
    t = t + "        haveRemoteLine = TRUE" + NL
    t = t + "        inbox.Enabled = FALSE" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    Echo(Prompt() + "" "" + line)" + NL
    t = t + "    IF line.Trim() = """" THEN" + NL
    t = t + "        Ready()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    inbox.Enabled = FALSE" + NL
    t = t + "    ShStart(line)" + NL
    t = t + "    Pump()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB In_Key (key AS String)" + NL
    t = t + "    SELECT CASE key" + NL
    t = t + "        CASE ""ArrowUp""" + NL
    t = t + "            History(-1)" + NL
    t = t + "        CASE ""ArrowDown""" + NL
    t = t + "            History(1)" + NL
    t = t + "        CASE ""Ctrl+Space"", ""Tab""" + NL
    t = t + "            Complete()" + NL
    t = t + "        CASE ""Ctrl+C""" + NL
    t = t + "            Interrupt()" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB History (dir AS Integer)" + NL
    t = t + "    IF hist.Count = 0 THEN RETURN" + NL
    t = t + "    IF histPos < 0 THEN" + NL
    t = t + "        curLine = inbox.Text" + NL
    t = t + "        histPos = hist.Count" + NL
    t = t + "    END IF" + NL
    t = t + "    histPos = histPos + dir" + NL
    t = t + "    IF histPos >= hist.Count THEN" + NL
    t = t + "        histPos = -1" + NL
    t = t + "        inbox.Text = curLine" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF histPos < 0 THEN histPos = 0" + NL
    t = t + "    inbox.Text = hist[histPos]" + NL
    t = t + "    inbox.SelectAll()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Interrupt ()" + NL
    t = t + "    Echo((Prompt() + "" "" + inbox.Text).Trim() + ""^C"")" + NL
    t = t + "    inbox.Text = """"" + NL
    t = t + "    histPos = -1" + NL
    t = t + "    IF passMode THEN" + NL
    t = t + "        passMode = FALSE" + NL
    t = t + "        inbox.Password = FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF remoteOn THEN" + NL
    t = t + "        RemoteGone()" + NL
    t = t + "        JobHangUp()" + NL
    t = t + "    END IF" + NL
    t = t + "    JobCancel()" + NL
    t = t + "    queue.Clear()" + NL
    t = t + "    busy = FALSE" + NL
    t = t + "    jobRunning = FALSE" + NL
    t = t + "    Flush()" + NL
    t = t + "    Ready()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Ctrl+Space / Tab: complete the last word against the files in its directory." + NL
    t = t + "SUB Complete ()" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR cut AS Integer" + NL
    t = t + "    VAR word AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR shown AS String" + NL
    t = t + "    VAR stub AS String" + NL
    t = t + "    VAR hits AS Array OF String" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    VAR common AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    text = inbox.Text" + NL
    t = t + "    cut = LastSpace(text)" + NL
    t = t + "    word = text.Substring(cut + 1, text.Length - cut - 1)" + NL
    t = t + "    IF word = """" THEN RETURN" + NL
    t = t + "    parts = word.Replace(""/"", ""\"").Split(""\"")" + NL
    t = t + "    stub = parts[parts.Count - 1]" + NL
    t = t + "    shown = word.Substring(0, word.Length - stub.Length)" + NL
    t = t + "    dir = Resolve(shown)" + NL
    t = t + "    TRY" + NL
    t = t + "        FOR EACH n IN FS.List(dir)" + NL
    t = t + "            IF n.EndsWith(""\"") THEN n = n.Substring(0, n.Length - 1) + ""\""" + NL
    t = t + "            IF n.Upper().StartsWith(stub.Upper()) THEN hits.Add(n)" + NL
    t = t + "        NEXT" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF hits.Count = 0 THEN RETURN" + NL
    t = t + "    IF hits.Count = 1 THEN" + NL
    t = t + "        inbox.Text = text.Substring(0, cut + 1) + shown + hits[0]" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    hits.Sort()" + NL
    t = t + "    common = CommonStart(hits)" + NL
    t = t + "    IF common.Length > stub.Length THEN inbox.Text = text.Substring(0, cut + 1) + shown + common.Substring(0, common.Length)" + NL
    t = t + "    Echo(Prompt() + "" "" + text)" + NL
    t = t + "    Echo(""  "" + hits.Join(""   ""))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION LastSpace (s AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = s.Length - 1 TO 0 STEP -1" + NL
    t = t + "        IF s.CharAt(i) = "" "" THEN RETURN i" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN -1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CommonStart (items AS Array OF String) AS String" + NL
    t = t + "    VAR pre AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR ok AS Bool" + NL
    t = t + "    pre = items[0]" + NL
    t = t + "    WHILE pre.Length > 0" + NL
    t = t + "        ok = TRUE" + NL
    t = t + "        FOR i = 1 TO items.Count - 1" + NL
    t = t + "            IF NOT items[i].Upper().StartsWith(pre.Upper()) THEN ok = FALSE" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF ok THEN RETURN pre" + NL
    t = t + "        pre = pre.Substring(0, pre.Length - 1)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the engine, a step at a time" + NL
    t = t + "" + NL
    t = t + "SUB Clock_OnTick ()" + NL
    t = t + "    TRY" + NL
    t = t + "        Pump()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One tick of work. Network jobs get a tick to themselves, so a failed Connect" + NL
    t = t + "' (which spoils this handler) can only end the tick." + NL
    t = t + "SUB Pump ()" + NL
    t = t + "    IF busy THEN RETURN" + NL
    t = t + "" + NL
    t = t + "    ' a job that has finished: its output goes down the pipeline (no network)" + NL
    t = t + "    IF jobFinished THEN" + NL
    t = t + "        busy = TRUE" + NL
    t = t + "        jobRunning = FALSE" + NL
    t = t + "        JobCollect()" + NL
    t = t + "        StepQueue()" + NL
    t = t + "        Flush()" + NL
    t = t + "        busy = FALSE" + NL
    t = t + "        IF NOT ShBusy() AND NOT haveRemoteLine THEN Ready()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    ' an interactive remote command" + NL
    t = t + "    IF haveRemoteLine THEN" + NL
    t = t + "        haveRemoteLine = FALSE" + NL
    t = t + "        busy = TRUE" + NL
    t = t + "        jobRunning = TRUE" + NL
    t = t + "        RemoteStep(remoteLine)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    ' a job is wanted: ask for a password, then run it in a tick of its own" + NL
    t = t + "    IF jobWant THEN" + NL
    t = t + "        IF JobNeedsPass() AND jobPass = """" AND NOT goJob THEN" + NL
    t = t + "            AskPassword()" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        ' its machine's name asked about first (SimDNS), in ticks of their own" + NL
    t = t + "        IF JobLookup() THEN RETURN" + NL
    t = t + "        goJob = FALSE" + NL
    t = t + "        busy = TRUE" + NL
    t = t + "        jobRunning = TRUE" + NL
    t = t + "        RunJob()" + NL
    t = t + "        busy = FALSE" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    ' plain built-ins" + NL
    t = t + "    IF queue.Count > 0 THEN" + NL
    t = t + "        busy = TRUE" + NL
    t = t + "        StepQueue()" + NL
    t = t + "        Flush()" + NL
    t = t + "        busy = FALSE" + NL
    t = t + "        IF NOT ShBusy() THEN Ready()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Keep running pipelines until one wants a job (or we are done)." + NL
    t = t + "SUB StepQueue ()" + NL
    t = t + "    VAR guard AS Integer" + NL
    t = t + "    WHILE queue.Count > 0 AND NOT jobWant" + NL
    t = t + "        IF NOT ShStep() THEN BREAK" + NL
    t = t + "        guard = guard + 1" + NL
    t = t + "        IF guard > 500 THEN BREAK" + NL
    t = t + "    END WHILE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB AskPassword ()" + NL
    t = t + "    ' asked once: a tick that came while it was being typed must not clear it" + NL
    t = t + "    IF passMode THEN RETURN" + NL
    t = t + "    passMode = TRUE" + NL
    t = t + "    promptLbl.Text = JobTarget() + ""'s password:""" + NL
    t = t + "    Layout()" + NL
    t = t + "    inbox.Password = TRUE" + NL
    t = t + "    inbox.Text = """"" + NL
    t = t + "    inbox.Enabled = TRUE" + NL
    t = t + "    inbox.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One remote command, over the open connection, then collect its output." + NL
    t = t + "SUB RemoteStep (line AS String)" + NL
    t = t + "    RemoteRun(line)" + NL
    t = t + "    Flush()" + NL
    t = t + "    busy = FALSE" + NL
    t = t + "    jobRunning = FALSE" + NL
    t = t + "    Ready()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' RESOLVE.SPK - the SimDNS resolver: asks the name server which machine a" + NL
    t = t + "' name like www.coolsite.sim is on." + NL
    t = t + "'" + NL
    t = t + "' The name server is the central one, STARTHERE.56k.net, where SimNIC (the" + NL
    t = t + "' registrar) and NAMED.SPK run, unless C:\SYSTEM\RESOLV.INI says otherwise." + NL
    t = t + "' To move the whole network to another central host, change RSCENTRAL below" + NL
    t = t + "' (the builder sets it from CENTRAL in tools/simxplorer-source.mjs)." + NL
    t = t + "'" + NL
    t = t + "' A library, not a program: a program has it joined on the end (the builder" + NL
    t = t + "' does this for Simxplorer, SimPlayer, Vapor, Frostbird, MAILD, the Sim Shell," + NL
    t = t + "' AskSim's crawler, DIG and Personal Web Manager; copy C:\PROGRAMS\RESOLVE.SPK" + NL
    t = t + "' onto the end of your own). Every name in it starts with Rs, so it can't clash." + NL
    t = t + "'" + NL
    t = t + "' C:\SYSTEM\RESOLV.INI, shared by every program on the machine (optional):" + NL
    t = t + "'     nameserver=dnsbox          another name server instead of the central one" + NL
    t = t + "'     nameserver=none            no SimDNS at all: SIM95 machine names only" + NL
    t = t + "'     search=coolsite.sim        then ""www"" means www.coolsite.sim" + NL
    t = t + "'" + NL
    t = t + "' How to use it without ever waiting in the wrong place (SIM95-NOTES.md):" + NL
    t = t + "'   1. RsWants(host)  - does this name need asking? FALSE for addresses," + NL
    t = t + "'                       plain machine names, names already known, or when" + NL
    t = t + "'                       there is no name server (or it isn't answering)." + NL
    t = t + "'   2. RsAsk(host, address) - sends the question to the name server at that" + NL
    t = t + "'                       address. It is a Connect: let it be the last thing" + NL
    t = t + "'                       the handler does." + NL
    t = t + "'   3. RsBusy()       - TRUE while the answer is on its way. After RSWAIT" + NL
    t = t + "'                       with no answer the server is left alone for RSQUIET," + NL
    t = t + "'                       and every name goes to SIM95 as before." + NL
    t = t + "'   4. RsTarget(host) - where to connect: the machine name (or address) the" + NL
    t = t + "'                       name server gave, or the name itself when SimDNS" + NL
    t = t + "'                       doesn't know it, for SIM95 to look up." + NL
    t = t + "' Answers are kept for their TTL; names SimDNS doesn't know for RSNEG." + NL
    t = t + "'" + NL
    t = t + "' Or, from a timer tick, all of that in one line (see RsNext):" + NL
    t = t + "'     IF RsNext(host) THEN RETURN          ' asked, or waiting: end the tick" + NL
    t = t + "'     conn = sock.Connect(RsTarget(host), 80)" + NL
    t = t + "' and for mail, the domain's MX first (see RsNextMail):" + NL
    t = t + "'     IF RsNextMail(domain) THEN RETURN" + NL
    t = t + "'     conn = sock.Connect(RsMailTarget(domain), 25)" + NL
    t = t + "" + NL
    t = t + "CONST RSCENTRAL = ""starthere.56k.net""   ' the central name server" + NL
    t = t + "CONST RSINI = ""C:\SYSTEM\RESOLV.INI""" + NL
    t = t + "CONST RSPORT = 53" + NL
    t = t + "CONST RSWAIT = 2000             ' ms to wait for an answer" + NL
    t = t + "CONST RSQUIET = 30000            ' ms to leave a silent name server alone" + NL
    t = t + "CONST RSNEG = 60000             ' ms to remember that SimDNS doesn't know a name" + NL
    t = t + "CONST RSMOST = 100              ' names kept" + NL
    t = t + "" + NL
    t = t + "VAR rsServer AS String              ' """" when SimDNS is off" + NL
    t = t + "VAR rsByDefault AS Bool               ' TRUE when RESOLV.INI doesn't name one" + NL
    t = t + "VAR rsSearch AS String" + NL
    t = t + "VAR rsRead AS Bool" + NL
    t = t + "VAR rsReadAt AS Integer" + NL
    t = t + "VAR rsSock AS NET_Socket" + NL
    t = t + "VAR rsName AS Array OF String       ' the name as asked, lower case" + NL
    t = t + "VAR rsTo AS Array OF String         ' where it is ("""" when SimDNS doesn't know it)" + NL
    t = t + "VAR rsCanon AS Array OF String      ' its last name in DNS before the machine" + NL
    t = t + "VAR rsUntil AS Array OF Integer     ' SYS.Ticks when it is forgotten" + NL
    t = t + "VAR rsAsking AS String" + NL
    t = t + "VAR rsAskAt AS Integer" + NL
    t = t + "VAR rsRefused AS Bool" + NL
    t = t + "VAR rsDown AS Bool" + NL
    t = t + "VAR rsDownAt AS Integer" + NL
    t = t + "VAR rsWhy AS String                 ' the last thing that went wrong" + NL
    t = t + "VAR rsLastReply AS String           ' the last answer, as it came" + NL
    t = t + "VAR rsServerAddr AS String          ' the name server's address, for RsNext" + NL
    t = t + "VAR rsServerFor AS String" + NL
    t = t + "VAR rsServerAt AS Integer" + NL
    t = t + "VAR rsLooking AS Bool               ' RsNext is finding the name server's address" + NL
    t = t + "VAR rsLookingAt AS Integer" + NL
    t = t + "" + NL
    t = t + "' Reads RESOLV.INI (again after a few seconds, so a new setting takes)." + NL
    t = t + "' With no nameserver= line, the central name server; none (or nothing after" + NL
    t = t + "' the =) turns SimDNS off." + NL
    t = t + "SUB RsConfig ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    IF rsRead AND SYS.Ticks - rsReadAt < 3000 THEN RETURN" + NL
    t = t + "    rsRead = TRUE" + NL
    t = t + "    rsReadAt = SYS.Ticks" + NL
    t = t + "    rsServer = RSCENTRAL" + NL
    t = t + "    rsByDefault = TRUE" + NL
    t = t + "    rsSearch = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                low = line.Trim().Lower()" + NL
    t = t + "                IF low.StartsWith(""nameserver="") THEN" + NL
    t = t + "                    rsServer = low.Substring(11, low.Length - 11).Trim()" + NL
    t = t + "                    rsByDefault = FALSE" + NL
    t = t + "                END IF" + NL
    t = t + "                IF low.StartsWith(""search="") THEN rsSearch = low.Substring(7, low.Length - 7).Trim()" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF rsServer = ""none"" THEN rsServer = """"" + NL
    t = t + "    IF rsSearch.StartsWith(""."") THEN rsSearch = rsSearch.Substring(1, rsSearch.Length - 1)" + NL
    t = t + "    IF rsSearch.EndsWith(""."") THEN rsSearch = rsSearch.Substring(0, rsSearch.Length - 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The name server (a machine name or address), or """" for none." + NL
    t = t + "FUNCTION RsNameServer () AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsServer" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is it the central one, because RESOLV.INI doesn't say?" + NL
    t = t + "FUNCTION RsIsCentral () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsByDefault" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Makes server this machine's name server, keeping the rest of RESOLV.INI," + NL
    t = t + "' and forgets everything it knew. """" (or none) for no SimDNS at all;" + NL
    t = t + "' default for the central one again." + NL
    t = t + "SUB RsSave (server AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    server = server.Trim().Lower()" + NL
    t = t + "    IF server = """" THEN server = ""none""" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                IF line.Trim() <> """" AND NOT line.Trim().Lower().StartsWith(""nameserver="") THEN out.Add(line)" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "        IF server <> ""default"" THEN out.Insert(0, ""nameserver="" + server)" + NL
    t = t + "        IF out.Count = 0 THEN" + NL
    t = t + "            IF FS.Exists(RSINI) THEN FS.Delete(RSINI)" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Write(RSINI, out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsWhy = err" + NL
    t = t + "    END TRY" + NL
    t = t + "    rsRead = FALSE" + NL
    t = t + "    RsForget()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RsForget ()" + NL
    t = t + "    rsName.Clear()" + NL
    t = t + "    rsTo.Clear()" + NL
    t = t + "    rsCanon.Clear()" + NL
    t = t + "    rsUntil.Clear()" + NL
    t = t + "    rsDown = FALSE" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsIsAddress (s AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF s.Split(""."").Count <> 4 THEN RETURN FALSE" + NL
    t = t + "    FOR EACH p IN s.Split(""."")" + NL
    t = t + "        IF p = """" OR p.Length > 3 THEN RETURN FALSE" + NL
    t = t + "        FOR i = 0 TO p.Length - 1" + NL
    t = t + "            IF NOT ""0123456789"".Contains(p.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name the server is asked about: lower case, the search domain added" + NL
    t = t + "' to a single word." + NL
    t = t + "FUNCTION RsFull (host AS String) AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF h.EndsWith(""."") THEN h = h.Substring(0, h.Length - 1)" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch <> """" THEN h = h + ""."" + rsSearch" + NL
    t = t + "    RETURN h" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a name is in the list of answers, or -1 (old answers are dropped)." + NL
    t = t + "FUNCTION RsFind (host AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = rsName.IndexOf(host.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN -1" + NL
    t = t + "    IF SYS.Ticks > rsUntil[i] THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "        RETURN -1" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsWants (host AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(host) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(host) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for a mail domain's MX record." + NL
    t = t + "FUNCTION RsWantsMx (domain AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(domain) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(""mx:"" + domain.Trim().Lower()) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is host a name for the name server at all (whether known yet or not)?" + NL
    t = t + "FUNCTION RsAsks (host AS String) AS Bool" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF rsServer = """" OR h = """" OR h = ""localhost"" THEN RETURN FALSE" + NL
    t = t + "    IF rsDown AND SYS.Ticks - rsDownAt < RSQUIET THEN RETURN FALSE" + NL
    t = t + "    IF RsIsAddress(h) THEN RETURN FALSE" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch = """" THEN RETURN FALSE" + NL
    t = t + "    IF h = rsServer OR h = NET.HostName.Lower() THEN RETURN FALSE" + NL
    t = t + "    ' a machine's full name (bob.56k.net): SIM95's, never SimDNS's to answer" + NL
    t = t + "    IF RsIspName(h) THEN RETURN FALSE" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Does h end in one of SIM95's ISPs (56k.net, dialup.zone...)?" + NL
    t = t + "FUNCTION RsIspName (h AS String) AS Bool" + NL
    t = t + "    VAR isp AS String" + NL
    t = t + "    FOR EACH isp IN [""dialup.zone"", ""56k.net"", ""bbs.club"", ""modem.link"", ""beep.boop""]" + NL
    t = t + "        IF h = isp OR h.EndsWith(""."" + isp) THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Sends the question. A Connect, so it must be the last thing its handler" + NL
    t = t + "' does: if the name server refuses, the handler is spoiled (SIM95-NOTES.md)." + NL
    t = t + "SUB RsAsk (host AS String, address AS String)" + NL
    t = t + "    RsSend(host.Trim().Lower(), ""A"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Asks for a mail domain's MX records (also a Connect: the last thing)." + NL
    t = t + "SUB RsAskMx (domain AS String, address AS String)" + NL
    t = t + "    RsSend(""mx:"" + domain.Trim().Lower(), ""MX"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' key is the name, or mx: and the name; the answer is kept under it." + NL
    t = t + "SUB RsSend (key AS String, qtype AS String, address AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    IF IsNothing(rsSock) THEN" + NL
    t = t + "        rsSock = NET_Socket.New()" + NL
    t = t + "        rsSock.onMessage = Rs_OnMessage" + NL
    t = t + "    END IF" + NL
    t = t + "    name = key" + NL
    t = t + "    IF name.StartsWith(""mx:"") THEN name = name.Substring(3, name.Length - 3)" + NL
    t = t + "    rsAsking = key" + NL
    t = t + "    rsAskAt = SYS.Ticks" + NL
    t = t + "    rsRefused = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = rsSock.Connect(address, RSPORT)" + NL
    t = t + "        conn.Tag = ""rs:"" + key" + NL
    t = t + "        conn.Send(""QUERY "" + RsFull(name) + "" "" + qtype)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsRefused = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Gives up on the name server for a while: every name goes to SIM95." + NL
    t = t + "SUB RsGiveUp (why AS String)" + NL
    t = t + "    rsWhy = why" + NL
    t = t + "    rsDown = TRUE" + NL
    t = t + "    rsDownAt = SYS.Ticks" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "    rsServerAddr = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' For a program that fetches from a timer tick: TRUE when the tick must end" + NL
    t = t + "' now, because a question about host has just been sent (a Connect, so it" + NL
    t = t + "' has to be the last thing the handler does) or an answer is on its way." + NL
    t = t + "' FALSE when there is nothing to ask: RsTarget(host) is where to connect." + NL
    t = t + "' A name server that is missing, refuses or says nothing for RSWAIT is left" + NL
    t = t + "' alone for RSQUIET, and every name goes to SIM95: nothing ever hangs." + NL
    t = t + "FUNCTION RsNext (host AS String) AS Bool" + NL
    t = t + "    RETURN RsStep(host, FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for mail to domain: its MX record (the lowest preference), then" + NL
    t = t + "' the CNAMEs or address of the machine that names. RsMailTarget(domain) is" + NL
    t = t + "' then where to connect; with no MX, the domain's own machine; with no" + NL
    t = t + "' answer at all, the domain itself, for SIM95 to look up." + NL
    t = t + "FUNCTION RsNextMail (domain AS String) AS Bool" + NL
    t = t + "    IF RsStep(domain, TRUE) THEN RETURN TRUE" + NL
    t = t + "    RETURN RsStep(RsMailHost(domain), FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsStep (host AS String, mx AS Bool) AS Bool" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    ' another handler is finding the name server (it waits): wait for it" + NL
    t = t + "    IF rsLooking THEN" + NL
    t = t + "        IF SYS.Ticks - rsLookingAt < RSWAIT THEN RETURN TRUE" + NL
    t = t + "        rsLooking = FALSE" + NL
    t = t + "        RsGiveUp(""no answer about the machine "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF RsBusy() THEN RETURN TRUE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        IF NOT RsWantsMx(host) THEN RETURN FALSE" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF NOT RsWants(host) THEN RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    addr = RsServerAddress()" + NL
    t = t + "    IF addr = """" THEN RETURN FALSE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        RsAskMx(host, addr)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsAsk(host, addr)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name server's address, looked up once a minute (one lookup at a time:" + NL
    t = t + "' see SIM95-NOTES.md). """" when there is no such machine, and then it gives up." + NL
    t = t + "FUNCTION RsServerAddress () AS String" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    IF RsIsAddress(rsServer) THEN RETURN rsServer" + NL
    t = t + "    IF rsServerAddr <> """" AND rsServerFor = rsServer AND SYS.Ticks - rsServerAt < 60000 AND SYS.Ticks >= rsServerAt THEN RETURN rsServerAddr" + NL
    t = t + "    rsLooking = TRUE" + NL
    t = t + "    rsLookingAt = SYS.Ticks" + NL
    t = t + "    addr = NET.Resolve(rsServer)" + NL
    t = t + "    IF NOT rsLooking THEN RETURN """"" + NL
    t = t + "    rsLooking = FALSE" + NL
    t = t + "    IF addr = """" THEN" + NL
    t = t + "        RsGiveUp(""there is no machine called "" + rsServer)" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    rsServerAddr = addr" + NL
    t = t + "    rsServerFor = rsServer" + NL
    t = t + "    rsServerAt = SYS.Ticks" + NL
    t = t + "    RETURN addr" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsBusy () AS Bool" + NL
    t = t + "    IF rsAsking = """" THEN RETURN FALSE" + NL
    t = t + "    IF rsRefused THEN" + NL
    t = t + "        RsGiveUp(""the name server "" + rsServer + "" refused"")" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF SYS.Ticks - rsAskAt > RSWAIT THEN" + NL
    t = t + "        RsGiveUp(""no answer from the name server "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Rs_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    IF NOT conn.Tag.StartsWith(""rs:"") THEN RETURN" + NL
    t = t + "    h = conn.Tag.Substring(3, conn.Tag.Length - 3)" + NL
    t = t + "    conn.Tag = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        conn.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    RsTake(h, message)" + NL
    t = t + "    IF h = rsAsking THEN rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an answer: follows its CNAMEs to an address, or to the machine" + NL
    t = t + "' name the chain ends at." + NL
    t = t + "SUB RsTake (host AS String, reply AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR onward AS String" + NL
    t = t + "    VAR target AS String" + NL
    t = t + "    VAR canon AS String" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR hops AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    rsLastReply = reply" + NL
    t = t + "    IF host.StartsWith(""mx:"") THEN" + NL
    t = t + "        RsTakeMx(host, reply)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(host, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(host, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    cur = RsFull(host)" + NL
    t = t + "    canon = cur" + NL
    t = t + "    FOR hops = 0 TO 8" + NL
    t = t + "        onward = """"" + NL
    t = t + "        FOR i = 1 TO lines.Count - 1" + NL
    t = t + "            w = lines[i].Split("" "")" + NL
    t = t + "            IF w.Count >= 4 THEN" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""A"" AND target = """" THEN target = w[3]" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""CNAME"" THEN onward = w[3]" + NL
    t = t + "                IF w[0] = cur AND (w[2] = ""A"" OR w[2] = ""CNAME"") AND Int(Val(w[1])) < ttl THEN ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF target <> """" THEN" + NL
    t = t + "            canon = cur" + NL
    t = t + "            BREAK" + NL
    t = t + "        END IF" + NL
    t = t + "        IF onward = """" THEN BREAK" + NL
    t = t + "        canon = cur" + NL
    t = t + "        cur = onward" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF target = """" THEN" + NL
    t = t + "        ' a name with no CNAME and no address: not one to connect to" + NL
    t = t + "        IF cur = RsFull(host) THEN" + NL
    t = t + "            RsKeep(host, """", """", RSNEG)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        ' the end of the chain: a SIM95 machine name" + NL
    t = t + "        target = cur" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ttl < 5 THEN ttl = 5" + NL
    t = t + "    RsKeep(host, target, canon, ttl * 1000)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an MX answer: the mail machine with the lowest preference. With no" + NL
    t = t + "' MX, the server answers with the domain's CNAMEs instead, and the domain's" + NL
    t = t + "' own machine takes the mail." + NL
    t = t + "SUB RsTakeMx (key AS String, reply AS String)" + NL
    t = t + "    VAR domain AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR best AS String" + NL
    t = t + "    VAR pref AS Integer = 1000000" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    domain = key.Substring(3, key.Length - 3)" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(key, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RsKeep(domain, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(key, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 1 TO lines.Count - 1" + NL
    t = t + "        w = lines[i].Split("" "")" + NL
    t = t + "        IF w.Count >= 5 THEN" + NL
    t = t + "            IF w[2] = ""MX"" AND Int(Val(w[3])) < pref THEN" + NL
    t = t + "                pref = Int(Val(w[3]))" + NL
    t = t + "                best = w[4]" + NL
    t = t + "                ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF best <> """" THEN" + NL
    t = t + "        IF best.EndsWith(""."") THEN best = best.Substring(0, best.Length - 1)" + NL
    t = t + "        IF ttl < 5 THEN ttl = 5" + NL
    t = t + "        RsKeep(key, best, RsFull(domain), ttl * 1000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    RsTake(domain, reply)" + NL
    t = t + "    IF RsKnown(domain) THEN" + NL
    t = t + "        RsKeep(key, domain, RsFull(domain), RSNEG)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsKeep(key, """", """", RSNEG)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The machine (or name) that takes domain's mail: its MX, or domain itself." + NL
    t = t + "FUNCTION RsMailHost (domain AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN domain" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN domain" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where to connect for domain's mail." + NL
    t = t + "FUNCTION RsMailTarget (domain AS String) AS String" + NL
    t = t + "    RETURN RsTarget(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS say where domain's mail goes (an MX, or the domain's machine)?" + NL
    t = t + "FUNCTION RsMailKnown (domain AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN FALSE" + NL
    t = t + "    RETURN RsKnown(RsMailHost(domain)) OR NOT RsAsks(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB RsKeep (host AS String, target AS String, canon AS String, ms AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    i = rsName.IndexOf(h)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF rsName.Count >= RSMOST THEN" + NL
    t = t + "        rsName.RemoveAt(0)" + NL
    t = t + "        rsTo.RemoveAt(0)" + NL
    t = t + "        rsCanon.RemoveAt(0)" + NL
    t = t + "        rsUntil.RemoveAt(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    rsName.Add(h)" + NL
    t = t + "    rsTo.Add(target)" + NL
    t = t + "    rsCanon.Add(canon)" + NL
    t = t + "    rsUntil.Add(SYS.Ticks + ms)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where to connect for host: what SimDNS said, or host itself." + NL
    t = t + "FUNCTION RsTarget (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name host's machine was found under (www.coolsite.sim), or host." + NL
    t = t + "FUNCTION RsCanonical (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsCanon[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS answer for host (so RsTarget is its machine)?" + NL
    t = t + "FUNCTION RsKnown (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] <> """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did the name server say there is no such name (NXDOMAIN)?" + NL
    t = t + "FUNCTION RsNoSuchName (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] = """" AND rsCanon[i] = ""NXDOMAIN""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is the name server being left alone, because it didn't answer (or there" + NL
    t = t + "' is none)? rsWhy says why." + NL
    t = t + "FUNCTION RsSilent () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    IF rsServer = """" THEN RETURN TRUE" + NL
    t = t + "    RETURN rsDown AND SYS.Ticks - rsDownAt < RSQUIET" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\PROGRAMS\SIMSH.SPK")
END SUB

SUB File1 ()
    t = ""
    t = t + "' CORE.SPK - the Sim Shell's engine: it reads a command line, runs it, and" + NL
    t = t + "' hands back the text it printed. No window and no socket, so the shell window" + NL
    t = t + "' (SIMSH.SPK) and the remote shell server (SSHD.SPK) both carry this same code;" + NL
    t = t + "' tools/build-installer.mjs puts it at the top of each." + NL
    t = t + "'" + NL
    t = t + "'   ShInit(user, host)    once, at the start" + NL
    t = t + "'   ShStart(line)         queue a command line (; && || between pipelines)" + NL
    t = t + "'   ShStep()              run the next pipeline; TRUE while there is more to do" + NL
    t = t + "'   ShRun(line)           all of the above at once, for a headless caller" + NL
    t = t + "'   shOut                 what has been printed so far (the caller empties it)" + NL
    t = t + "'" + NL
    t = t + "' A command that needs the network (ssh, scp, sim-get update/install/upgrade, host)" + NL
    t = t + "' is not run here: it sets jobWant and the rest of its pipeline waits until" + NL
    t = t + "' the caller runs the job and calls ShResume with the job's output." + NL
    t = t + "'" + NL
    t = t + "' Paths: /programs/notes.spk and C:\PROGRAMS\NOTES.SPK are the same file; ~ is" + NL
    t = t + "' $HOME (C:\MYFILES). There is no backslash escaping, so DOS paths type as is." + NL
    t = t + "" + NL
    t = t + "CONST SHVERSION = ""1.0""" + NL
    t = t + "CONST RCFILE = ""C:\SYSTEM\SIMSHRC.SH""" + NL
    t = t + "CONST HISTFILE = ""C:\SYSTEM\SHHIST.TXT""" + NL
    t = t + "CONST GAMEDIR = ""C:\GAMES""" + NL
    t = t + "CONST VAPORME = ""C:\PROGRAMS\VAPOR.SPK""" + NL
    t = t + "CONST WEBAPPSINI = ""C:\SYSTEM\WEBAPPS.INI""" + NL
    t = t + "CONST GETCACHE = ""C:\SYSTEM\SIMGET.TXT""" + NL
    t = t + "" + NL
    t = t + "VAR EOL AS String" + NL
    t = t + "VAR shCwd AS String = ""C:\MYFILES""" + NL
    t = t + "VAR shPrev AS String" + NL
    t = t + "VAR shUser AS String" + NL
    t = t + "VAR shHost AS String" + NL
    t = t + "VAR shStatus AS Integer" + NL
    t = t + "VAR shOut AS String" + NL
    t = t + "VAR shClear AS Bool             ' ""clear"" was typed: the window empties its screen" + NL
    t = t + "VAR shExit AS Bool              ' ""exit"" was typed" + NL
    t = t + "VAR shTty AS Bool               ' this command's output goes to the screen" + NL
    t = t + "VAR shRemote AS Bool            ' running inside SSHD: no waiting, no jobs" + NL
    t = t + "VAR varNames AS Array OF String" + NL
    t = t + "VAR varVals AS Array OF String" + NL
    t = t + "VAR expNames AS Array OF String" + NL
    t = t + "VAR aliasNames AS Array OF String" + NL
    t = t + "VAR aliasVals AS Array OF String" + NL
    t = t + "VAR hist AS Array OF String" + NL
    t = t + "VAR posArgs AS Array OF String  ' $1..$9 in a script" + NL
    t = t + "VAR queue AS Array OF String    ' pipelines waiting: op + Chr(1) + text" + NL
    t = t + "VAR lexWords AS Array OF String" + NL
    t = t + "VAR lexWild AS Array OF String  ' ""1"" when the word had an unquoted * or ?" + NL
    t = t + "VAR lexOps AS Array OF String   ' """" for a word, or > >> <" + NL
    t = t + "" + NL
    t = t + "' a pipeline waiting for a job" + NL
    t = t + "VAR jobWant AS Bool" + NL
    t = t + "VAR jobKind AS String           ' ssh, sshi, scp, get, host" + NL
    t = t + "VAR jobArgs AS Array OF String" + NL
    t = t + "VAR pendStages AS Array OF String" + NL
    t = t + "VAR pendIdx AS Integer" + NL
    t = t + "VAR pendFile AS String" + NL
    t = t + "VAR pendAppend AS Bool" + NL
    t = t + "" + NL
    t = t + "' ================================================================ start" + NL
    t = t + "" + NL
    t = t + "SUB ShInit (user AS String, host AS String)" + NL
    t = t + "    EOL = Chr(10)" + NL
    t = t + "    shUser = user" + NL
    t = t + "    shHost = host" + NL
    t = t + "    IF shUser = """" THEN shUser = ""user""" + NL
    t = t + "    SetVar(""HOME"", ""C:\MYFILES"")" + NL
    t = t + "    SetVar(""PATH"", ""C:\PROGRAMS;C:\MYFILES"")" + NL
    t = t + "    SetVar(""USER"", shUser)" + NL
    t = t + "    SetVar(""HOSTNAME"", shHost)" + NL
    t = t + "    SetVar(""SHELL"", ""C:\PROGRAMS\SIMSH.SPK"")" + NL
    t = t + "    SetVar(""PWD"", shCwd)" + NL
    t = t + "    expNames = [""HOME"", ""PATH"", ""USER"", ""HOSTNAME"", ""SHELL"", ""PWD""]" + NL
    t = t + "    IF NOT FS.Exists(shCwd) THEN shCwd = ""C:\""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The user name from C:\SYSTEM\USERS.INI, as the Files service reads it." + NL
    t = t + "FUNCTION MachineUser () AS String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    TRY" + NL
    t = t + "        FOR EACH ln IN FS.Read(""C:\SYSTEM\USERS.INI"").Lines()" + NL
    t = t + "            ln = ln.Trim()" + NL
    t = t + "            IF ln.Lower().StartsWith(""name="") THEN RETURN ln.Substring(5, ln.Length - 5).Trim()" + NL
    t = t + "        NEXT" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is user|password this machine's account? (FILESVC.SPK's CheckLogin.)" + NL
    t = t + "FUNCTION CheckLogin (user AS String, password AS String) AS Bool" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR pass AS String" + NL
    t = t + "    TRY" + NL
    t = t + "        FOR EACH ln IN FS.Read(""C:\SYSTEM\USERS.INI"").Lines()" + NL
    t = t + "            ln = ln.Trim()" + NL
    t = t + "            IF ln.Lower().StartsWith(""name="") THEN name = ln.Substring(5, ln.Length - 5).Trim()" + NL
    t = t + "            IF ln.Lower().StartsWith(""password="") THEN pass = ln.Substring(9, ln.Length - 9)" + NL
    t = t + "        NEXT" + NL
    t = t + "    CATCH err" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF name = """" THEN RETURN FALSE" + NL
    t = t + "    RETURN name.Lower() = user.Trim().Lower() AND pass = password" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Prompt () AS String" + NL
    t = t + "    RETURN shUser + ""@"" + shHost + "":"" + shCwd + ""$""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Queue a line typed at the prompt (it goes in the history)." + NL
    t = t + "SUB ShStart (line AS String)" + NL
    t = t + "    IF line.Trim() <> """" THEN" + NL
    t = t + "        hist.Add(line)" + NL
    t = t + "        IF hist.Count > 200 THEN hist.RemoveAt(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    QueueLines(line, FALSE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Put the pipelines of some lines at the front of the queue." + NL
    t = t + "SUB QueueLines (text AS String, atBack AS Bool)" + NL
    t = t + "    VAR items AS Array OF String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    VAR it AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR EACH ln IN text.Lines()" + NL
    t = t + "        FOR EACH it IN SplitLine(ln)" + NL
    t = t + "            items.Add(it)" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF atBack THEN" + NL
    t = t + "        FOR EACH it IN items" + NL
    t = t + "            queue.Add(it)" + NL
    t = t + "        NEXT" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = items.Count - 1 TO 0 STEP -1" + NL
    t = t + "        queue.Insert(0, items[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ShBusy () AS Bool" + NL
    t = t + "    RETURN queue.Count > 0 OR jobWant" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Run the next pipeline in the queue." + NL
    t = t + "FUNCTION ShStep () AS Bool" + NL
    t = t + "    VAR it AS String" + NL
    t = t + "    VAR op AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR cut AS Integer" + NL
    t = t + "    IF jobWant THEN RETURN TRUE" + NL
    t = t + "    IF queue.Count = 0 THEN RETURN FALSE" + NL
    t = t + "    it = queue[0]" + NL
    t = t + "    queue.RemoveAt(0)" + NL
    t = t + "    cut = it.IndexOf(Chr(1))" + NL
    t = t + "    op = it.Substring(0, cut)" + NL
    t = t + "    text = it.Substring(cut + 1, it.Length - cut - 1)" + NL
    t = t + "    IF op = ""args"" THEN" + NL
    t = t + "        posArgs = text.Split(Chr(2))" + NL
    t = t + "        IF text = """" THEN posArgs.Clear()" + NL
    t = t + "    ELSEIF op = ""&&"" AND shStatus <> 0 THEN" + NL
    t = t + "        ' skipped" + NL
    t = t + "    ELSEIF op = ""||"" AND shStatus = 0 THEN" + NL
    t = t + "        ' skipped" + NL
    t = t + "    ELSE" + NL
    t = t + "        shOut = shOut + RunPipe(SplitPipe(text), 0, """", TRUE)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF shExit THEN queue.Clear()" + NL
    t = t + "    RETURN queue.Count > 0 OR jobWant" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Everything at once. A job can't run here, so it fails." + NL
    t = t + "FUNCTION ShRun (line AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    ShStart(line)" + NL
    t = t + "    WHILE ShStep()" + NL
    t = t + "        IF jobWant THEN JobRefuse()" + NL
    t = t + "    END WHILE" + NL
    t = t + "    out = shOut" + NL
    t = t + "    shOut = """"" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JobRefuse ()" + NL
    t = t + "    VAR what AS String" + NL
    t = t + "    what = jobKind" + NL
    t = t + "    IF what = ""get"" THEN what = ""sim-get""" + NL
    t = t + "    IF what = ""sshi"" THEN" + NL
    t = t + "        Complain(""ssh: an interactive session needs the Sim Shell window; try ssh host command"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        Complain(what + "": needs the network; run it in the Sim Shell window"")" + NL
    t = t + "    END IF" + NL
    t = t + "    ShResume("""", 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A job finished: its output goes on down the pipeline that was waiting for it." + NL
    t = t + "SUB ShResume (out AS String, status AS Integer)" + NL
    t = t + "    VAR stages AS Array OF String" + NL
    t = t + "    jobWant = FALSE" + NL
    t = t + "    shStatus = status" + NL
    t = t + "    IF pendFile <> """" THEN" + NL
    t = t + "        TRY" + NL
    t = t + "            IF pendAppend AND FS.Exists(pendFile) THEN" + NL
    t = t + "                FS.Append(pendFile, out)" + NL
    t = t + "            ELSE" + NL
    t = t + "                FS.Write(pendFile, out)" + NL
    t = t + "            END IF" + NL
    t = t + "        CATCH err" + NL
    t = t + "            Complain(""simsh: "" + pendFile + "": "" + err)" + NL
    t = t + "        END TRY" + NL
    t = t + "        out = """"" + NL
    t = t + "    END IF" + NL
    t = t + "    stages = pendStages" + NL
    t = t + "    pendStages = []" + NL
    t = t + "    IF pendIdx < stages.Count THEN out = RunPipe(stages, pendIdx, out, TRUE)" + NL
    t = t + "    shOut = shOut + out" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Errors go straight to the screen, never down a pipe." + NL
    t = t + "SUB Complain (text AS String)" + NL
    t = t + "    shOut = shOut + text + EOL" + NL
    t = t + "    shStatus = 1" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ variables" + NL
    t = t + "" + NL
    t = t + "FUNCTION GetVar (name AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = varNames.IndexOf(name.Upper())" + NL
    t = t + "    IF i < 0 THEN RETURN """"" + NL
    t = t + "    RETURN varVals[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SetVar (name AS String, value AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = varNames.IndexOf(name.Upper())" + NL
    t = t + "    IF i < 0 THEN" + NL
    t = t + "        varNames.Add(name.Upper())" + NL
    t = t + "        varVals.Add(value)" + NL
    t = t + "    ELSE" + NL
    t = t + "        varVals[i] = value" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB UnsetVar (name AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = varNames.IndexOf(name.Upper())" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        varNames.RemoveAt(i)" + NL
    t = t + "        varVals.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    i = expNames.IndexOf(name.Upper())" + NL
    t = t + "    IF i >= 0 THEN expNames.RemoveAt(i)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsName (s AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    IF s = """" THEN RETURN FALSE" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        c = s.CharAt(i).Upper()" + NL
    t = t + "        IF NOT ((c >= ""A"" AND c <= ""Z"") OR c = ""_"" OR (i > 0 AND c >= ""0"" AND c <= ""9"")) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A remote session keeps its own directory, variables and aliases, saved here" + NL
    t = t + "' between commands." + NL
    t = t + "FUNCTION SaveState () AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    parts.Add(shCwd)" + NL
    t = t + "    parts.Add(shPrev)" + NL
    t = t + "    parts.Add(shUser)" + NL
    t = t + "    parts.Add(varNames.Join(Chr(3)))" + NL
    t = t + "    parts.Add(varVals.Join(Chr(3)))" + NL
    t = t + "    parts.Add(expNames.Join(Chr(3)))" + NL
    t = t + "    parts.Add(aliasNames.Join(Chr(3)))" + NL
    t = t + "    parts.Add(aliasVals.Join(Chr(3)))" + NL
    t = t + "    parts.Add(hist.Join(Chr(3)))" + NL
    t = t + "    RETURN parts.Join(Chr(4))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB LoadState (state AS String)" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    p = state.Split(Chr(4))" + NL
    t = t + "    shCwd = p[0]" + NL
    t = t + "    shPrev = p[1]" + NL
    t = t + "    shUser = p[2]" + NL
    t = t + "    varNames = Unpack(p[3])" + NL
    t = t + "    varVals = Unpack(p[4])" + NL
    t = t + "    expNames = Unpack(p[5])" + NL
    t = t + "    aliasNames = Unpack(p[6])" + NL
    t = t + "    aliasVals = Unpack(p[7])" + NL
    t = t + "    hist = Unpack(p[8])" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unpack (s AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    IF s = """" THEN RETURN out" + NL
    t = t + "    RETURN s.Split(Chr(3))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ parsing" + NL
    t = t + "" + NL
    t = t + "' A line into its pipelines: ""op"" + Chr(1) + text, op being ; && or ||." + NL
    t = t + "' Quotes are kept for later; # starts a comment." + NL
    t = t + "FUNCTION SplitLine (line AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR op AS String = "";""" + NL
    t = t + "    VAR q AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    VAR nx AS String" + NL
    t = t + "    i = 0" + NL
    t = t + "    WHILE i < line.Length" + NL
    t = t + "        c = line.CharAt(i)" + NL
    t = t + "        nx = """"" + NL
    t = t + "        IF i + 1 < line.Length THEN nx = line.CharAt(i + 1)" + NL
    t = t + "        IF q <> """" THEN" + NL
    t = t + "            IF c = q THEN q = """"" + NL
    t = t + "            cur = cur + c" + NL
    t = t + "        ELSEIF c = ""'"" OR c = Chr(34) THEN" + NL
    t = t + "            q = c" + NL
    t = t + "            cur = cur + c" + NL
    t = t + "        ELSEIF c = ""#"" AND (cur = """" OR cur.EndsWith("" "")) THEN" + NL
    t = t + "            BREAK" + NL
    t = t + "        ELSEIF c = "";"" OR (c = ""&"" AND nx = ""&"") OR (c = ""|"" AND nx = ""|"") THEN" + NL
    t = t + "            IF cur.Trim() <> """" THEN out.Add(op + Chr(1) + cur.Trim())" + NL
    t = t + "            cur = """"" + NL
    t = t + "            IF c = "";"" THEN" + NL
    t = t + "                op = "";""" + NL
    t = t + "            ELSE" + NL
    t = t + "                op = c + nx" + NL
    t = t + "                i = i + 1" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSE" + NL
    t = t + "            cur = cur + c" + NL
    t = t + "        END IF" + NL
    t = t + "        i = i + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF cur.Trim() <> """" THEN out.Add(op + Chr(1) + cur.Trim())" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A pipeline into its stages, at each | outside quotes." + NL
    t = t + "FUNCTION SplitPipe (text AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR q AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    FOR i = 0 TO text.Length - 1" + NL
    t = t + "        c = text.CharAt(i)" + NL
    t = t + "        IF q <> """" THEN" + NL
    t = t + "            IF c = q THEN q = """"" + NL
    t = t + "            cur = cur + c" + NL
    t = t + "        ELSEIF c = ""'"" OR c = Chr(34) THEN" + NL
    t = t + "            q = c" + NL
    t = t + "            cur = cur + c" + NL
    t = t + "        ELSEIF c = ""|"" THEN" + NL
    t = t + "            out.Add(cur.Trim())" + NL
    t = t + "            cur = """"" + NL
    t = t + "        ELSE" + NL
    t = t + "            cur = cur + c" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    out.Add(cur.Trim())" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One stage into words (lexWords), with quotes removed and $VARs expanded," + NL
    t = t + "' and the redirects marked (lexOps)." + NL
    t = t + "SUB Lex (text AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    VAR q AS String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR have AS Bool" + NL
    t = t + "    VAR starred AS Bool" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    lexWords.Clear()" + NL
    t = t + "    lexWild.Clear()" + NL
    t = t + "    lexOps.Clear()" + NL
    t = t + "    i = 0" + NL
    t = t + "    WHILE i < text.Length" + NL
    t = t + "        c = text.CharAt(i)" + NL
    t = t + "        IF q = ""'"" THEN" + NL
    t = t + "            IF c = ""'"" THEN" + NL
    t = t + "                q = """"" + NL
    t = t + "            ELSE" + NL
    t = t + "                cur = cur + c" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSEIF c = ""$"" AND i + 1 < text.Length THEN" + NL
    t = t + "            ' $NAME, ${NAME}, $?, $#, $0-$9" + NL
    t = t + "            name = """"" + NL
    t = t + "            c = text.CharAt(i + 1)" + NL
    t = t + "            IF c = ""{"" THEN" + NL
    t = t + "                i = i + 2" + NL
    t = t + "                WHILE i < text.Length" + NL
    t = t + "                    IF text.CharAt(i) = ""}"" THEN BREAK" + NL
    t = t + "                    name = name + text.CharAt(i)" + NL
    t = t + "                    i = i + 1" + NL
    t = t + "                END WHILE" + NL
    t = t + "            ELSEIF c = ""?"" OR c = ""#"" OR (c >= ""0"" AND c <= ""9"") THEN" + NL
    t = t + "                name = c" + NL
    t = t + "                i = i + 1" + NL
    t = t + "            ELSE" + NL
    t = t + "                WHILE i + 1 < text.Length" + NL
    t = t + "                    IF NOT IsName(name + text.CharAt(i + 1)) THEN BREAK" + NL
    t = t + "                    name = name + text.CharAt(i + 1)" + NL
    t = t + "                    i = i + 1" + NL
    t = t + "                END WHILE" + NL
    t = t + "            END IF" + NL
    t = t + "            IF name = """" THEN" + NL
    t = t + "                cur = cur + ""$""" + NL
    t = t + "            ELSE" + NL
    t = t + "                cur = cur + Expand(name)" + NL
    t = t + "            END IF" + NL
    t = t + "            have = TRUE" + NL
    t = t + "        ELSEIF q = Chr(34) THEN" + NL
    t = t + "            IF c = Chr(34) THEN" + NL
    t = t + "                q = """"" + NL
    t = t + "            ELSE" + NL
    t = t + "                cur = cur + c" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSEIF c = ""'"" OR c = Chr(34) THEN" + NL
    t = t + "            q = c" + NL
    t = t + "            have = TRUE" + NL
    t = t + "        ELSEIF c = "" "" OR c = Chr(9) THEN" + NL
    t = t + "            IF have THEN AddWord(cur, starred, """")" + NL
    t = t + "            cur = """"" + NL
    t = t + "            have = FALSE" + NL
    t = t + "            starred = FALSE" + NL
    t = t + "        ELSEIF c = "">"" OR c = ""<"" THEN" + NL
    t = t + "            IF have THEN AddWord(cur, starred, """")" + NL
    t = t + "            cur = """"" + NL
    t = t + "            have = FALSE" + NL
    t = t + "            starred = FALSE" + NL
    t = t + "            IF c = "">"" AND i + 1 < text.Length THEN" + NL
    t = t + "                IF text.CharAt(i + 1) = "">"" THEN" + NL
    t = t + "                    c = "">>""" + NL
    t = t + "                    i = i + 1" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "            AddWord("""", FALSE, c)" + NL
    t = t + "        ELSEIF c = ""~"" AND NOT have THEN" + NL
    t = t + "            ' ~ and ~/x at the start of a word" + NL
    t = t + "            IF i + 1 >= text.Length THEN" + NL
    t = t + "                cur = GetVar(""HOME"")" + NL
    t = t + "            ELSEIF text.CharAt(i + 1) = ""/"" OR text.CharAt(i + 1) = ""\"" OR text.CharAt(i + 1) = "" "" THEN" + NL
    t = t + "                cur = GetVar(""HOME"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                cur = ""~""" + NL
    t = t + "            END IF" + NL
    t = t + "            have = TRUE" + NL
    t = t + "        ELSE" + NL
    t = t + "            IF c = ""*"" OR c = ""?"" THEN starred = TRUE" + NL
    t = t + "            cur = cur + c" + NL
    t = t + "            have = TRUE" + NL
    t = t + "        END IF" + NL
    t = t + "        i = i + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF have THEN AddWord(cur, starred, """")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB AddWord (w AS String, starred AS Bool, op AS String)" + NL
    t = t + "    lexWords.Add(w)" + NL
    t = t + "    lexOps.Add(op)" + NL
    t = t + "    IF starred THEN" + NL
    t = t + "        lexWild.Add(""1"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        lexWild.Add("""")" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Expand (name AS String) AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    IF name = ""?"" THEN RETURN Str(shStatus)" + NL
    t = t + "    IF name = ""#"" THEN RETURN Str(posArgs.Count)" + NL
    t = t + "    IF name.Length = 1 AND name >= ""0"" AND name <= ""9"" THEN" + NL
    t = t + "        n = Int(Val(name))" + NL
    t = t + "        IF n = 0 THEN RETURN ""simsh""" + NL
    t = t + "        IF n <= posArgs.Count THEN RETURN posArgs[n - 1]" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF name.Upper() = ""PWD"" THEN RETURN shCwd" + NL
    t = t + "    IF name.Upper() = ""RANDOM"" THEN RETURN Str(Rnd(32768))" + NL
    t = t + "    RETURN GetVar(name)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ paths" + NL
    t = t + "" + NL
    t = t + "' Any path the user types, as a full DOS path: /programs/x.spk, ~/a.txt," + NL
    t = t + "' ..\docs, C:/WEB and C:\WEB all work." + NL
    t = t + "FUNCTION Resolve (p AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR part AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    s = p.Trim().Replace(""/"", ""\"")" + NL
    t = t + "    IF s = """" THEN RETURN shCwd" + NL
    t = t + "    IF s = ""~"" OR s.StartsWith(""~\"") THEN s = GetVar(""HOME"") + s.Substring(1, s.Length - 1)" + NL
    t = t + "    IF s.Length >= 2 AND s.CharAt(1) = "":"" THEN" + NL
    t = t + "        IF s.Length = 2 THEN s = s + ""\""" + NL
    t = t + "    ELSEIF s.StartsWith(""\"") THEN" + NL
    t = t + "        s = ""C:"" + s" + NL
    t = t + "    ELSE" + NL
    t = t + "        s = shCwd + ""\"" + s" + NL
    t = t + "    END IF" + NL
    t = t + "    parts = s.Split(""\"")" + NL
    t = t + "    out.Add(parts[0].Upper())" + NL
    t = t + "    FOR i = 1 TO parts.Count - 1" + NL
    t = t + "        part = parts[i]" + NL
    t = t + "        IF part = """" OR part = ""."" THEN CONTINUE" + NL
    t = t + "        IF part = "".."" THEN" + NL
    t = t + "            IF out.Count > 1 THEN out.RemoveAt(out.Count - 1)" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        out.Add(part.Upper())" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF out.Count = 1 THEN RETURN out[0] + ""\""" + NL
    t = t + "    RETURN out.Join(""\"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JoinPath (dir AS String, name AS String) AS String" + NL
    t = t + "    IF dir.EndsWith(""\"") THEN RETURN dir + name" + NL
    t = t + "    RETURN dir + ""\"" + name" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION BaseName (p AS String) AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    parts = p.Replace(""/"", ""\"").Split(""\"")" + NL
    t = t + "    IF parts[parts.Count - 1] = """" AND parts.Count > 1 THEN RETURN parts[parts.Count - 2]" + NL
    t = t + "    RETURN parts[parts.Count - 1]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION DirName (p AS String) AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    parts = p.Split(""\"")" + NL
    t = t + "    IF parts.Count <= 2 THEN RETURN parts[0] + ""\""" + NL
    t = t + "    parts.RemoveAt(parts.Count - 1)" + NL
    t = t + "    RETURN parts.Join(""\"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' * and ? against a name, ignoring case." + NL
    t = t + "FUNCTION MatchWild (pat AS String, s AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR star AS Integer = -1" + NL
    t = t + "    VAR mark AS Integer" + NL
    t = t + "    p = pat.Upper()" + NL
    t = t + "    t = s.Upper()" + NL
    t = t + "    WHILE j < t.Length" + NL
    t = t + "        IF i < p.Length AND p.CharAt(i) <> ""*"" AND (p.CharAt(i) = ""?"" OR p.CharAt(i) = t.CharAt(j)) THEN" + NL
    t = t + "            i = i + 1" + NL
    t = t + "            j = j + 1" + NL
    t = t + "        ELSEIF i < p.Length AND p.CharAt(i) = ""*"" THEN" + NL
    t = t + "            star = i" + NL
    t = t + "            mark = j" + NL
    t = t + "            i = i + 1" + NL
    t = t + "        ELSEIF star >= 0 THEN" + NL
    t = t + "            i = star + 1" + NL
    t = t + "            mark = mark + 1" + NL
    t = t + "            j = mark" + NL
    t = t + "        ELSE" + NL
    t = t + "            RETURN FALSE" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    WHILE i < p.Length" + NL
    t = t + "        IF p.CharAt(i) <> ""*"" THEN BREAK" + NL
    t = t + "        i = i + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN i = p.Length" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A word with * or ? in its last part, as the names it matches (or itself)." + NL
    t = t + "FUNCTION Glob (w AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR shown AS String" + NL
    t = t + "    VAR pat AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    VAR cut AS Integer" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    parts = w.Replace(""/"", ""\"").Split(""\"")" + NL
    t = t + "    pat = parts[parts.Count - 1]" + NL
    t = t + "    shown = """"" + NL
    t = t + "    IF parts.Count > 1 THEN shown = w.Substring(0, w.Length - pat.Length)" + NL
    t = t + "    dir = Resolve(shown)" + NL
    t = t + "    TRY" + NL
    t = t + "        FOR EACH n IN FS.List(dir)" + NL
    t = t + "            IF n.EndsWith(""\"") THEN n = n.Substring(0, n.Length - 1)" + NL
    t = t + "            IF MatchWild(pat, n) THEN out.Add(shown + n)" + NL
    t = t + "        NEXT" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF out.Count = 0 THEN out.Add(w)" + NL
    t = t + "    out.Sort()" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ running" + NL
    t = t + "" + NL
    t = t + "' Run stages from i on, feeding each one's output to the next." + NL
    t = t + "FUNCTION RunPipe (stages AS Array OF String, start AS Integer, input AS String, top AS Bool) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR data AS String" + NL
    t = t + "    data = input" + NL
    t = t + "    FOR i = start TO stages.Count - 1" + NL
    t = t + "        IF stages[i] = """" THEN" + NL
    t = t + "            Complain(""simsh: syntax error near |"")" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        END IF" + NL
    t = t + "        data = RunStage(stages[i], data, i = stages.Count - 1 AND top)" + NL
    t = t + "        IF jobWant THEN" + NL
    t = t + "            IF top THEN" + NL
    t = t + "                pendStages = stages" + NL
    t = t + "                pendIdx = i + 1" + NL
    t = t + "                RETURN """"" + NL
    t = t + "            END IF" + NL
    t = t + "            JobRefuse()" + NL
    t = t + "            data = """"" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN data" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RunStage (raw AS String, input AS String, last AS Bool) AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR first AS String" + NL
    t = t + "    VAR sp AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR argv AS Array OF String" + NL
    t = t + "    VAR words AS Array OF String" + NL
    t = t + "    VAR wilds AS Array OF String" + NL
    t = t + "    VAR ops AS Array OF String" + NL
    t = t + "    VAR g AS String" + NL
    t = t + "    VAR outFile AS String" + NL
    t = t + "    VAR inFile AS String" + NL
    t = t + "    VAR app AS Bool" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR data AS String" + NL
    t = t + "    VAR eq AS Integer" + NL
    t = t + "    ' an alias is the first word swapped for its text" + NL
    t = t + "    text = raw" + NL
    t = t + "    sp = text.IndexOf("" "")" + NL
    t = t + "    first = text" + NL
    t = t + "    IF sp >= 0 THEN first = text.Substring(0, sp)" + NL
    t = t + "    i = aliasNames.IndexOf(first)" + NL
    t = t + "    IF i >= 0 THEN text = aliasVals[i] + text.Substring(first.Length, text.Length - first.Length)" + NL
    t = t + "    Lex(text)" + NL
    t = t + "    words = lexWords" + NL
    t = t + "    wilds = lexWild" + NL
    t = t + "    ops = lexOps" + NL
    t = t + "    lexWords = []" + NL
    t = t + "    lexWild = []" + NL
    t = t + "    lexOps = []" + NL
    t = t + "    i = 0" + NL
    t = t + "    WHILE i < words.Count" + NL
    t = t + "        IF ops[i] <> """" THEN" + NL
    t = t + "            IF i + 1 >= words.Count OR ops[i + 1] <> """" THEN" + NL
    t = t + "                Complain(""simsh: syntax error near "" + ops[i])" + NL
    t = t + "                RETURN """"" + NL
    t = t + "            END IF" + NL
    t = t + "            IF ops[i] = ""<"" THEN" + NL
    t = t + "                inFile = Resolve(words[i + 1])" + NL
    t = t + "            ELSE" + NL
    t = t + "                outFile = Resolve(words[i + 1])" + NL
    t = t + "                app = ops[i] = "">>""" + NL
    t = t + "            END IF" + NL
    t = t + "            i = i + 2" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF wilds[i] = ""1"" THEN" + NL
    t = t + "            FOR EACH g IN Glob(words[i])" + NL
    t = t + "                argv.Add(g)" + NL
    t = t + "            NEXT" + NL
    t = t + "        ELSE" + NL
    t = t + "            argv.Add(words[i])" + NL
    t = t + "        END IF" + NL
    t = t + "        i = i + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    data = input" + NL
    t = t + "    IF inFile <> """" THEN" + NL
    t = t + "        IF NOT FS.Exists(inFile) OR FS.IsDir(inFile) THEN" + NL
    t = t + "            Complain(""simsh: "" + inFile + "": No such file"")" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        END IF" + NL
    t = t + "        data = FS.Read(inFile)" + NL
    t = t + "    END IF" + NL
    t = t + "    ' NAME=value on its own sets a variable" + NL
    t = t + "    WHILE argv.Count > 0" + NL
    t = t + "        eq = argv[0].IndexOf(""="")" + NL
    t = t + "        IF eq <= 0 THEN BREAK" + NL
    t = t + "        IF NOT IsName(argv[0].Substring(0, eq)) THEN BREAK" + NL
    t = t + "        SetVar(argv[0].Substring(0, eq), argv[0].Substring(eq + 1, argv[0].Length - eq - 1))" + NL
    t = t + "        argv.RemoveAt(0)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    shStatus = 0" + NL
    t = t + "    IF argv.Count = 0 THEN RETURN """"" + NL
    t = t + "    shTty = last AND outFile = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        out = Command(argv, data)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        Complain(argv[0] + "": "" + err)" + NL
    t = t + "        out = """"" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF jobWant THEN" + NL
    t = t + "        pendFile = outFile" + NL
    t = t + "        pendAppend = app" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF outFile <> """" THEN" + NL
    t = t + "        TRY" + NL
    t = t + "            IF app AND FS.Exists(outFile) THEN" + NL
    t = t + "                FS.Append(outFile, out)" + NL
    t = t + "            ELSE" + NL
    t = t + "                FS.Write(outFile, out)" + NL
    t = t + "            END IF" + NL
    t = t + "        CATCH err" + NL
    t = t + "            Complain(""simsh: "" + outFile + "": "" + err)" + NL
    t = t + "        END TRY" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Builtins () AS Array OF String" + NL
    t = t + "    RETURN [""alias"", ""basename"", ""cat"", ""cd"", ""clear"", ""cp"", ""date"", ""echo"", ""env"", ""exit"", ""export"", ""false"", ""grep"", ""head"", ""help"", ""history"", ""host"", ""hostname"", ""kill"", ""ls"", ""mkdir"", ""mv"", ""nslookup"", ""ps"", ""pwd"", ""rm"", ""rmdir"", ""run"", ""scp"", ""seq"", ""set"", ""sh"", ""sim-get"", ""sleep"", ""sort"", ""source"", ""ssh"", ""tail"", ""tee"", ""touch"", ""true"", ""unalias"", ""uname"", ""uniq"", ""unset"", ""wc"", ""which"", ""whoami""]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One command, with its arguments and its input. Returns what it printed." + NL
    t = t + "FUNCTION Command (argv AS Array OF String, input AS String) AS String" + NL
    t = t + "    VAR cmd AS String" + NL
    t = t + "    VAR args AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    cmd = argv[0]" + NL
    t = t + "    FOR i = 1 TO argv.Count - 1" + NL
    t = t + "        args.Add(argv[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    SELECT CASE cmd.Lower()" + NL
    t = t + "        CASE ""ls"", ""dir""" + NL
    t = t + "            RETURN CmdLs(args)" + NL
    t = t + "        CASE ""cd""" + NL
    t = t + "            RETURN CmdCd(args)" + NL
    t = t + "        CASE ""pwd""" + NL
    t = t + "            RETURN shCwd + EOL" + NL
    t = t + "        CASE ""cat"", ""type""" + NL
    t = t + "            RETURN CmdCat(args, input)" + NL
    t = t + "        CASE ""echo""" + NL
    t = t + "            RETURN CmdEcho(args)" + NL
    t = t + "        CASE ""mkdir"", ""md""" + NL
    t = t + "            RETURN CmdMkdir(args)" + NL
    t = t + "        CASE ""rm"", ""del""" + NL
    t = t + "            RETURN CmdRm(args)" + NL
    t = t + "        CASE ""rmdir"", ""rd""" + NL
    t = t + "            RETURN CmdRmdir(args)" + NL
    t = t + "        CASE ""mv"", ""move""" + NL
    t = t + "            RETURN CmdCopy(args, TRUE)" + NL
    t = t + "        CASE ""cp"", ""copy""" + NL
    t = t + "            RETURN CmdCopy(args, FALSE)" + NL
    t = t + "        CASE ""touch""" + NL
    t = t + "            RETURN CmdTouch(args)" + NL
    t = t + "        CASE ""head""" + NL
    t = t + "            RETURN CmdHeadTail(args, input, TRUE)" + NL
    t = t + "        CASE ""tail""" + NL
    t = t + "            RETURN CmdHeadTail(args, input, FALSE)" + NL
    t = t + "        CASE ""wc""" + NL
    t = t + "            RETURN CmdWc(args, input)" + NL
    t = t + "        CASE ""grep""" + NL
    t = t + "            RETURN CmdGrep(args, input)" + NL
    t = t + "        CASE ""sort""" + NL
    t = t + "            RETURN CmdSort(args, input)" + NL
    t = t + "        CASE ""uniq""" + NL
    t = t + "            RETURN CmdUniq(args, input)" + NL
    t = t + "        CASE ""tee""" + NL
    t = t + "            RETURN CmdTee(args, input)" + NL
    t = t + "        CASE ""seq""" + NL
    t = t + "            RETURN CmdSeq(args)" + NL
    t = t + "        CASE ""basename""" + NL
    t = t + "            IF args.Count = 0 THEN RETURN Usage(""basename path"")" + NL
    t = t + "            RETURN BaseName(args[0]) + EOL" + NL
    t = t + "        CASE ""env""" + NL
    t = t + "            RETURN CmdEnv(TRUE)" + NL
    t = t + "        CASE ""set""" + NL
    t = t + "            IF args.Count > 0 THEN RETURN CmdExport(args, FALSE)" + NL
    t = t + "            RETURN CmdEnv(FALSE)" + NL
    t = t + "        CASE ""export""" + NL
    t = t + "            IF args.Count = 0 THEN RETURN CmdEnv(TRUE)" + NL
    t = t + "            RETURN CmdExport(args, TRUE)" + NL
    t = t + "        CASE ""unset""" + NL
    t = t + "            FOR i = 0 TO args.Count - 1" + NL
    t = t + "                UnsetVar(args[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""alias""" + NL
    t = t + "            RETURN CmdAlias(args)" + NL
    t = t + "        CASE ""unalias""" + NL
    t = t + "            FOR i = 0 TO args.Count - 1" + NL
    t = t + "                IF aliasNames.IndexOf(args[i]) >= 0 THEN" + NL
    t = t + "                    aliasVals.RemoveAt(aliasNames.IndexOf(args[i]))" + NL
    t = t + "                    aliasNames.RemoveAt(aliasNames.IndexOf(args[i]))" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""history""" + NL
    t = t + "            RETURN CmdHistory(args)" + NL
    t = t + "        CASE ""clear"", ""cls""" + NL
    t = t + "            shClear = TRUE" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""exit"", ""logout""" + NL
    t = t + "            shExit = TRUE" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""ps""" + NL
    t = t + "            RETURN CmdPs()" + NL
    t = t + "        CASE ""kill""" + NL
    t = t + "            RETURN CmdKill(args)" + NL
    t = t + "        CASE ""run"", ""start""" + NL
    t = t + "            IF args.Count = 0 THEN RETURN Usage(""run program.spk [args]"")" + NL
    t = t + "            RETURN RunProgram(args)" + NL
    t = t + "        CASE ""date""" + NL
    t = t + "            IF args.Count > 0 THEN" + NL
    t = t + "                IF args[0] = ""+%s"" THEN RETURN Str(TIME.Now) + EOL" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN TIME.Date + "" "" + TIME.Clock + EOL" + NL
    t = t + "        CASE ""whoami""" + NL
    t = t + "            RETURN shUser + EOL" + NL
    t = t + "        CASE ""hostname""" + NL
    t = t + "            RETURN NET.HostName + EOL" + NL
    t = t + "        CASE ""uname""" + NL
    t = t + "            IF args.Count > 0 THEN" + NL
    t = t + "                IF args[0] = ""-a"" THEN RETURN ""SIM95 "" + shHost + "" Sim Shell "" + SHVERSION + EOL" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN ""SIM95"" + EOL" + NL
    t = t + "        CASE ""which""" + NL
    t = t + "            RETURN CmdWhich(args)" + NL
    t = t + "        CASE ""help""" + NL
    t = t + "            RETURN CmdHelp(args)" + NL
    t = t + "        CASE ""true""" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""false""" + NL
    t = t + "            shStatus = 1" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""sleep""" + NL
    t = t + "            IF args.Count > 0 AND NOT shRemote THEN SYS.Sleep(Int(MATH.Min(10, Val(args[0])) * 1000))" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""sh"", ""source"", "".""" + NL
    t = t + "            IF args.Count = 0 THEN RETURN Usage(""sh script.sh [args]"")" + NL
    t = t + "            RETURN RunScript(args, shTty)" + NL
    t = t + "        CASE ""ssh""" + NL
    t = t + "            RETURN CmdSsh(args)" + NL
    t = t + "        CASE ""scp""" + NL
    t = t + "            IF args.Count < 2 THEN RETURN Usage(""scp [user@]host:path localpath  or  scp localpath [user@]host:path"")" + NL
    t = t + "            Defer(""scp"", args)" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""sim-get"", ""simget""" + NL
    t = t + "            RETURN CmdSimGet(args)" + NL
    t = t + "        CASE ""host"", ""nslookup""" + NL
    t = t + "            IF args.Count = 0 THEN RETURN Usage(cmd + "" name [A|CNAME|MX|TXT|NS|SOA|ANY] [@server]"")" + NL
    t = t + "            Defer(""host"", args)" + NL
    t = t + "            RETURN """"" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN RunExternal(argv)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Usage (text AS String) AS String" + NL
    t = t + "    Complain(""usage: "" + text)" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Defer (kind AS String, args AS Array OF String)" + NL
    t = t + "    jobKind = kind" + NL
    t = t + "    jobArgs = args" + NL
    t = t + "    jobWant = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Not a built-in: a .SPK program or a .SH script, by path or on $PATH." + NL
    t = t + "FUNCTION RunExternal (argv AS Array OF String) AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    path = FindProgram(argv[0])" + NL
    t = t + "    IF path = """" THEN" + NL
    t = t + "        Complain(""simsh: "" + argv[0] + "": command not found"")" + NL
    t = t + "        shStatus = 127" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    argv[0] = path" + NL
    t = t + "    IF path.EndsWith("".SH"") THEN RETURN RunScript(argv, shTty)" + NL
    t = t + "    RETURN RunProgram(argv)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION FindProgram (name AS String) AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    IF name.Contains(""\"") OR name.Contains(""/"") OR name.Contains(""."") THEN" + NL
    t = t + "        p = Resolve(name)" + NL
    t = t + "        IF FS.Exists(p) AND NOT FS.IsDir(p) THEN RETURN p" + NL
    t = t + "        IF FS.Exists(p + "".SPK"") THEN RETURN p + "".SPK""" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH dir IN GetVar(""PATH"").Split("";"")" + NL
    t = t + "        IF dir.Trim() = """" THEN CONTINUE" + NL
    t = t + "        p = JoinPath(Resolve(dir), name.Upper() + "".SPK"")" + NL
    t = t + "        IF FS.Exists(p) THEN RETURN p" + NL
    t = t + "        p = JoinPath(Resolve(dir), name.Upper() + "".SH"")" + NL
    t = t + "        IF FS.Exists(p) THEN RETURN p" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RunProgram (args AS Array OF String) AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR rest AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR pid AS Integer" + NL
    t = t + "    path = FindProgram(args[0])" + NL
    t = t + "    IF path = """" THEN" + NL
    t = t + "        Complain(""run: "" + args[0] + "": No such program"")" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF path.EndsWith("".SH"") THEN RETURN RunScript(args, shTty)" + NL
    t = t + "    IF NOT path.EndsWith("".SPK"") THEN" + NL
    t = t + "        Complain(""run: "" + path + "": not a SPARK program (.SPK)"")" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 1 TO args.Count - 1" + NL
    t = t + "        rest.Add(args[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    pid = SYS.Start(path, rest.Join("" ""))" + NL
    t = t + "    RETURN ""["" + Str(pid) + ""] "" + path + EOL" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A script: its lines go to the front of the queue (so they can use the" + NL
    t = t + "' network), unless its output is wanted down a pipe or in a file, when they" + NL
    t = t + "' run here and now." + NL
    t = t + "FUNCTION RunScript (args AS Array OF String, queued AS Bool) AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR rest AS Array OF String" + NL
    t = t + "    VAR saved AS Array OF String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    VAR it AS String" + NL
    t = t + "    VAR cut AS Integer" + NL
    t = t + "    path = Resolve(args[0])" + NL
    t = t + "    IF NOT FS.Exists(path) THEN" + NL
    t = t + "        IF FindProgram(args[0]).EndsWith("".SH"") THEN path = FindProgram(args[0])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT FS.Exists(path) OR FS.IsDir(path) THEN" + NL
    t = t + "        Complain(""sh: "" + args[0] + "": No such file"")" + NL
    t = t + "        shStatus = 127" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    text = FS.Read(path)" + NL
    t = t + "    FOR i = 1 TO args.Count - 1" + NL
    t = t + "        rest.Add(args[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF queued THEN" + NL
    t = t + "        queue.Insert(0, ""args"" + Chr(1) + posArgs.Join(Chr(2)))" + NL
    t = t + "        QueueLines(text, FALSE)" + NL
    t = t + "        queue.Insert(0, ""args"" + Chr(1) + rest.Join(Chr(2)))" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    saved = posArgs" + NL
    t = t + "    posArgs = rest" + NL
    t = t + "    FOR EACH ln IN text.Lines()" + NL
    t = t + "        FOR EACH it IN SplitLine(ln)" + NL
    t = t + "            cut = it.IndexOf(Chr(1))" + NL
    t = t + "            IF it.StartsWith(""&&"") AND shStatus <> 0 THEN CONTINUE" + NL
    t = t + "            IF it.StartsWith(""||"") AND shStatus = 0 THEN CONTINUE" + NL
    t = t + "            out = out + RunPipe(SplitPipe(it.Substring(cut + 1, it.Length - cut - 1)), 0, """", FALSE)" + NL
    t = t + "            IF shExit THEN BREAK" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF shExit THEN BREAK" + NL
    t = t + "    NEXT" + NL
    t = t + "    shExit = FALSE" + NL
    t = t + "    posArgs = saved" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Run the startup file, if there is one." + NL
    t = t + "SUB ShRc ()" + NL
    t = t + "    IF FS.Exists(RCFILE) THEN" + NL
    t = t + "        queue.Add(""args"" + Chr(1))" + NL
    t = t + "        QueueLines(FS.Read(RCFILE), TRUE)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ files" + NL
    t = t + "" + NL
    t = t + "' Text as lines, without the empty one after a final line break." + NL
    t = t + "FUNCTION TextLines (text AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    IF text = """" THEN RETURN out" + NL
    t = t + "    out = text.Replace(Chr(13), """").Split(EOL)" + NL
    t = t + "    IF out[out.Count - 1] = """" THEN out.RemoveAt(out.Count - 1)" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LinesText (lines AS Array OF String) AS String" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN """"" + NL
    t = t + "    RETURN lines.Join(EOL) + EOL" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Flags at the front (-l, -la, -n 5) into one string of letters; returns" + NL
    t = t + "' the index of the first argument that is not a flag." + NL
    t = t + "VAR flagText AS String" + NL
    t = t + "FUNCTION Flags (args AS Array OF String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    flagText = """"" + NL
    t = t + "    FOR i = 0 TO args.Count - 1" + NL
    t = t + "        IF args[i] = ""--"" THEN RETURN i + 1" + NL
    t = t + "        IF NOT args[i].StartsWith(""-"") OR args[i].Length < 2 THEN RETURN i" + NL
    t = t + "        flagText = flagText + args[i].Substring(1, args[i].Length - 1)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN args.Count" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadFile (cmd AS String, name AS String) AS String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    p = Resolve(name)" + NL
    t = t + "    IF NOT FS.Exists(p) THEN THROW name + "": No such file or directory""" + NL
    t = t + "    IF FS.IsDir(p) THEN THROW name + "": Is a directory""" + NL
    t = t + "    RETURN FS.Read(p)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdLs (args AS Array OF String) AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR long AS Bool" + NL
    t = t + "    VAR paths AS Array OF String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    first = Flags(args)" + NL
    t = t + "    long = flagText.Contains(""l"")" + NL
    t = t + "    FOR i = first TO args.Count - 1" + NL
    t = t + "        paths.Add(args[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF paths.Count = 0 THEN paths.Add(""."")" + NL
    t = t + "    FOR i = 0 TO paths.Count - 1" + NL
    t = t + "        p = Resolve(paths[i])" + NL
    t = t + "        IF NOT FS.Exists(p) THEN" + NL
    t = t + "            Complain(""ls: "" + paths[i] + "": No such file or directory"")" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF NOT FS.IsDir(p) THEN" + NL
    t = t + "            IF long THEN" + NL
    t = t + "                out = out + LongLine(BaseName(p), FS.Size(p), FALSE)" + NL
    t = t + "            ELSE" + NL
    t = t + "                out = out + paths[i] + EOL" + NL
    t = t + "            END IF" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF paths.Count > 1 THEN out = out + paths[i] + "":"" + EOL" + NL
    t = t + "        out = out + ListDir(p, long)" + NL
    t = t + "        IF paths.Count > 1 AND i < paths.Count - 1 THEN out = out + EOL" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LongLine (name AS String, size AS Integer, dir AS Bool) AS String" + NL
    t = t + "    IF dir THEN RETURN ""drwxr-xr-x  "" + shUser.PadRight(8) + ""        -  "" + name + ""/"" + EOL" + NL
    t = t + "    RETURN ""-rw-r--r--  "" + shUser.PadRight(8) + Str(size).PadLeft(9) + ""  "" + name + EOL" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ListDir (p AS String, long AS Bool) AS String" + NL
    t = t + "    VAR names AS Array OF String" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR row AS String" + NL
    t = t + "    VAR total AS Integer" + NL
    t = t + "    names = FS.List(p)" + NL
    t = t + "    names.Sort()" + NL
    t = t + "    FOR EACH n IN names" + NL
    t = t + "        IF long THEN" + NL
    t = t + "            IF n.EndsWith(""\"") THEN" + NL
    t = t + "                out = out + LongLine(n.Substring(0, n.Length - 1), 0, TRUE)" + NL
    t = t + "            ELSE" + NL
    t = t + "                out = out + LongLine(n, FS.Size(JoinPath(p, n)), FALSE)" + NL
    t = t + "                total = total + FS.Size(JoinPath(p, n))" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSE" + NL
    t = t + "            IF n.EndsWith(""\"") THEN n = n.Substring(0, n.Length - 1) + ""/""" + NL
    t = t + "            IF shTty THEN" + NL
    t = t + "                ' columns on the screen, one a line down a pipe" + NL
    t = t + "                IF row.Length >= 64 THEN" + NL
    t = t + "                    out = out + row.Trim() + EOL" + NL
    t = t + "                    row = """"" + NL
    t = t + "                END IF" + NL
    t = t + "                row = row + n.PadRight(16)" + NL
    t = t + "            ELSE" + NL
    t = t + "                out = out + n + EOL" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF row <> """" THEN out = out + row.Trim() + EOL" + NL
    t = t + "    IF long THEN out = ""total "" + Str(total) + EOL + out" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdCd (args AS Array OF String) AS String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    IF args.Count = 0 THEN" + NL
    t = t + "        p = GetVar(""HOME"")" + NL
    t = t + "    ELSEIF args[0] = ""-"" THEN" + NL
    t = t + "        p = shPrev" + NL
    t = t + "        IF p = """" THEN p = shCwd" + NL
    t = t + "    ELSE" + NL
    t = t + "        p = Resolve(args[0])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT FS.Exists(p) OR NOT FS.IsDir(p) THEN" + NL
    t = t + "        Complain(""cd: "" + args[0] + "": No such directory"")" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    shPrev = shCwd" + NL
    t = t + "    shCwd = Resolve(p)" + NL
    t = t + "    SetVar(""PWD"", shCwd)" + NL
    t = t + "    IF args.Count > 0 THEN" + NL
    t = t + "        IF args[0] = ""-"" THEN RETURN shCwd + EOL" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdCat (args AS Array OF String, input AS String) AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    first = Flags(args)" + NL
    t = t + "    IF first >= args.Count THEN" + NL
    t = t + "        out = input" + NL
    t = t + "    ELSE" + NL
    t = t + "        FOR i = first TO args.Count - 1" + NL
    t = t + "            TRY" + NL
    t = t + "                out = out + ReadFile(""cat"", args[i])" + NL
    t = t + "            CATCH err" + NL
    t = t + "                Complain(""cat: "" + err)" + NL
    t = t + "            END TRY" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    IF flagText.Contains(""n"") THEN" + NL
    t = t + "        lines = TextLines(out)" + NL
    t = t + "        FOR i = 0 TO lines.Count - 1" + NL
    t = t + "            lines[i] = Str(i + 1).PadLeft(6) + ""  "" + lines[i]" + NL
    t = t + "        NEXT" + NL
    t = t + "        RETURN LinesText(lines)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdEcho (args AS Array OF String) AS String" + NL
    t = t + "    IF args.Count > 0 THEN" + NL
    t = t + "        IF args[0] = ""-n"" THEN" + NL
    t = t + "            args.RemoveAt(0)" + NL
    t = t + "            RETURN args.Join("" "")" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN args.Join("" "") + EOL" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Every folder down to p that is not there yet." + NL
    t = t + "SUB MakeDirs (p AS String)" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR sofar AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    parts = p.Split(""\"")" + NL
    t = t + "    sofar = parts[0]" + NL
    t = t + "    FOR i = 1 TO parts.Count - 1" + NL
    t = t + "        IF parts[i] = """" THEN CONTINUE" + NL
    t = t + "        sofar = sofar + ""\"" + parts[i]" + NL
    t = t + "        IF NOT FS.Exists(sofar) THEN FS.MakeDir(sofar)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdMkdir (args AS Array OF String) AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    first = Flags(args)" + NL
    t = t + "    IF first >= args.Count THEN RETURN Usage(""mkdir [-p] dir"")" + NL
    t = t + "    FOR i = first TO args.Count - 1" + NL
    t = t + "        p = Resolve(args[i])" + NL
    t = t + "        IF FS.Exists(p) THEN" + NL
    t = t + "            IF NOT flagText.Contains(""p"") THEN Complain(""mkdir: "" + args[i] + "": File exists"")" + NL
    t = t + "        ELSEIF flagText.Contains(""p"") THEN" + NL
    t = t + "            MakeDirs(p)" + NL
    t = t + "        ELSEIF NOT FS.Exists(DirName(p)) THEN" + NL
    t = t + "            Complain(""mkdir: "" + args[i] + "": No such directory (try mkdir -p)"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.MakeDir(p)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A folder and everything in it." + NL
    t = t + "SUB DeleteTree (p AS String)" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    FOR EACH n IN FS.List(p)" + NL
    t = t + "        IF n.EndsWith(""\"") THEN" + NL
    t = t + "            DeleteTree(JoinPath(p, n.Substring(0, n.Length - 1)))" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Delete(JoinPath(p, n))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Delete(p)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdRm (args AS Array OF String) AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    first = Flags(args)" + NL
    t = t + "    IF first >= args.Count THEN RETURN Usage(""rm [-r] [-f] file..."")" + NL
    t = t + "    FOR i = first TO args.Count - 1" + NL
    t = t + "        p = Resolve(args[i])" + NL
    t = t + "        IF p.Length <= 3 THEN" + NL
    t = t + "            Complain(""rm: refusing to remove "" + p)" + NL
    t = t + "        ELSEIF NOT FS.Exists(p) THEN" + NL
    t = t + "            IF NOT flagText.Contains(""f"") THEN Complain(""rm: "" + args[i] + "": No such file or directory"")" + NL
    t = t + "        ELSEIF FS.IsDir(p) THEN" + NL
    t = t + "            IF flagText.Contains(""r"") OR flagText.Contains(""R"") THEN" + NL
    t = t + "                DeleteTree(p)" + NL
    t = t + "            ELSE" + NL
    t = t + "                Complain(""rm: "" + args[i] + "": Is a directory (use rm -r)"")" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Delete(p)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdRmdir (args AS Array OF String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    IF args.Count = 0 THEN RETURN Usage(""rmdir dir"")" + NL
    t = t + "    FOR i = 0 TO args.Count - 1" + NL
    t = t + "        p = Resolve(args[i])" + NL
    t = t + "        IF NOT FS.Exists(p) OR NOT FS.IsDir(p) THEN" + NL
    t = t + "            Complain(""rmdir: "" + args[i] + "": No such directory"")" + NL
    t = t + "        ELSEIF FS.List(p).Count > 0 THEN" + NL
    t = t + "            Complain(""rmdir: "" + args[i] + "": Directory not empty"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Delete(p)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB CopyTree (src AS String, dest AS String)" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    IF NOT FS.Exists(dest) THEN FS.MakeDir(dest)" + NL
    t = t + "    FOR EACH n IN FS.List(src)" + NL
    t = t + "        IF n.EndsWith(""\"") THEN" + NL
    t = t + "            CopyTree(JoinPath(src, n.Substring(0, n.Length - 1)), JoinPath(dest, n.Substring(0, n.Length - 1)))" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Write(JoinPath(dest, n), FS.Read(JoinPath(src, n)))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' cp and mv: one file to a name, or several into a folder." + NL
    t = t + "FUNCTION CmdCopy (args AS Array OF String, move AS Bool) AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR dest AS String" + NL
    t = t + "    VAR src AS String" + NL
    t = t + "    VAR target AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    name = ""cp""" + NL
    t = t + "    IF move THEN name = ""mv""" + NL
    t = t + "    first = Flags(args)" + NL
    t = t + "    IF args.Count - first < 2 THEN RETURN Usage(name + "" source... dest"")" + NL
    t = t + "    dest = Resolve(args[args.Count - 1])" + NL
    t = t + "    IF args.Count - first > 2 AND NOT FS.IsDir(dest) THEN" + NL
    t = t + "        Complain(name + "": "" + args[args.Count - 1] + "": not a directory"")" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = first TO args.Count - 2" + NL
    t = t + "        src = Resolve(args[i])" + NL
    t = t + "        IF NOT FS.Exists(src) THEN" + NL
    t = t + "            Complain(name + "": "" + args[i] + "": No such file or directory"")" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        target = dest" + NL
    t = t + "        IF FS.Exists(dest) THEN" + NL
    t = t + "            IF FS.IsDir(dest) THEN target = JoinPath(dest, BaseName(src))" + NL
    t = t + "        END IF" + NL
    t = t + "        IF target = src THEN" + NL
    t = t + "            Complain(name + "": "" + args[i] + "" and "" + target + "" are the same file"")" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF move THEN" + NL
    t = t + "            IF FS.Exists(target) AND NOT FS.IsDir(target) THEN FS.Delete(target)" + NL
    t = t + "            FS.Rename(src, target)" + NL
    t = t + "        ELSEIF FS.IsDir(src) THEN" + NL
    t = t + "            IF flagText.Contains(""r"") OR flagText.Contains(""R"") THEN" + NL
    t = t + "                CopyTree(src, target)" + NL
    t = t + "            ELSE" + NL
    t = t + "                Complain(""cp: "" + args[i] + "": Is a directory (use cp -r)"")" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Write(target, FS.Read(src))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdTouch (args AS Array OF String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    IF args.Count = 0 THEN RETURN Usage(""touch file..."")" + NL
    t = t + "    FOR i = 0 TO args.Count - 1" + NL
    t = t + "        p = Resolve(args[i])" + NL
    t = t + "        IF NOT FS.Exists(p) THEN FS.Write(p, """")" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' head and tail: -n N or -N, files or the input." + NL
    t = t + "FUNCTION CmdHeadTail (args AS Array OF String, input AS String, top AS Bool) AS String" + NL
    t = t + "    VAR n AS Integer = 10" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR files AS Array OF String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    name = ""tail""" + NL
    t = t + "    IF top THEN name = ""head""" + NL
    t = t + "    i = 0" + NL
    t = t + "    WHILE i < args.Count" + NL
    t = t + "        IF args[i] = ""-n"" AND i + 1 < args.Count THEN" + NL
    t = t + "            n = Int(Val(args[i + 1]))" + NL
    t = t + "            i = i + 2" + NL
    t = t + "        ELSEIF args[i].StartsWith(""-"") AND args[i].Length > 1 THEN" + NL
    t = t + "            n = Int(Val(args[i].Substring(1, args[i].Length - 1).Replace(""n"", """")))" + NL
    t = t + "            i = i + 1" + NL
    t = t + "        ELSE" + NL
    t = t + "            files.Add(args[i])" + NL
    t = t + "            i = i + 1" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF files.Count = 0 THEN" + NL
    t = t + "        text = input" + NL
    t = t + "    ELSE" + NL
    t = t + "        FOR k = 0 TO files.Count - 1" + NL
    t = t + "            TRY" + NL
    t = t + "                text = text + ReadFile(name, files[k])" + NL
    t = t + "            CATCH err" + NL
    t = t + "                Complain(name + "": "" + err)" + NL
    t = t + "            END TRY" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    lines = TextLines(text)" + NL
    t = t + "    IF top THEN" + NL
    t = t + "        FOR k = 0 TO Int(MATH.Min(n, lines.Count)) - 1" + NL
    t = t + "            out.Add(lines[k])" + NL
    t = t + "        NEXT" + NL
    t = t + "    ELSE" + NL
    t = t + "        FOR k = Int(MATH.Max(0, lines.Count - n)) TO lines.Count - 1" + NL
    t = t + "            out.Add(lines[k])" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN LinesText(out)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Counts (text AS String) AS String" + NL
    t = t + "    VAR words AS Integer" + NL
    t = t + "    VAR w AS String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    lines = TextLines(text)" + NL
    t = t + "    FOR EACH ln IN lines" + NL
    t = t + "        FOR EACH w IN ln.Replace(Chr(9), "" "").Split("" "")" + NL
    t = t + "            IF w <> """" THEN words = words + 1" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF flagText = """" THEN RETURN Str(lines.Count).PadLeft(7) + Str(words).PadLeft(8) + Str(text.Length).PadLeft(8)" + NL
    t = t + "    w = """"" + NL
    t = t + "    IF flagText.Contains(""l"") THEN w = w + Str(lines.Count).PadLeft(7)" + NL
    t = t + "    IF flagText.Contains(""w"") THEN w = w + Str(words).PadLeft(8)" + NL
    t = t + "    IF flagText.Contains(""c"") THEN w = w + Str(text.Length).PadLeft(8)" + NL
    t = t + "    RETURN w" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdWc (args AS Array OF String, input AS String) AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    first = Flags(args)" + NL
    t = t + "    IF first >= args.Count THEN RETURN Counts(input) + EOL" + NL
    t = t + "    FOR i = first TO args.Count - 1" + NL
    t = t + "        TRY" + NL
    t = t + "            text = ReadFile(""wc"", args[i])" + NL
    t = t + "            out = out + Counts(text) + "" "" + args[i] + EOL" + NL
    t = t + "        CATCH err" + NL
    t = t + "            Complain(""wc: "" + err)" + NL
    t = t + "        END TRY" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Does a line match? Plain text, with ^ and $ to anchor it." + NL
    t = t + "FUNCTION Matches (ln AS String, pat AS String, nocase AS Bool) AS Bool" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR head AS Bool" + NL
    t = t + "    VAR tail AS Bool" + NL
    t = t + "    s = ln" + NL
    t = t + "    p = pat" + NL
    t = t + "    IF nocase THEN" + NL
    t = t + "        s = s.Lower()" + NL
    t = t + "        p = p.Lower()" + NL
    t = t + "    END IF" + NL
    t = t + "    IF p.StartsWith(""^"") THEN" + NL
    t = t + "        head = TRUE" + NL
    t = t + "        p = p.Substring(1, p.Length - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF p.EndsWith(""$"") AND p.Length > 0 THEN" + NL
    t = t + "        tail = TRUE" + NL
    t = t + "        p = p.Substring(0, p.Length - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF head AND tail THEN RETURN s = p" + NL
    t = t + "    IF head THEN RETURN s.StartsWith(p)" + NL
    t = t + "    IF tail THEN RETURN s.EndsWith(p)" + NL
    t = t + "    RETURN s.Contains(p)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdGrep (args AS Array OF String, input AS String) AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR pat AS String" + NL
    t = t + "    VAR files AS Array OF String" + NL
    t = t + "    VAR texts AS Array OF String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR hit AS Bool" + NL
    t = t + "    VAR count AS Integer" + NL
    t = t + "    VAR found AS Integer" + NL
    t = t + "    VAR pre AS String" + NL
    t = t + "    first = Flags(args)" + NL
    t = t + "    IF first >= args.Count THEN RETURN Usage(""grep [-i] [-n] [-v] [-c] pattern [file...]"")" + NL
    t = t + "    pat = args[first]" + NL
    t = t + "    FOR i = first + 1 TO args.Count - 1" + NL
    t = t + "        TRY" + NL
    t = t + "            texts.Add(ReadFile(""grep"", args[i]))" + NL
    t = t + "            files.Add(args[i])" + NL
    t = t + "        CATCH err" + NL
    t = t + "            Complain(""grep: "" + err)" + NL
    t = t + "        END TRY" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF args.Count = first + 1 THEN" + NL
    t = t + "        texts.Add(input)" + NL
    t = t + "        files.Add("""")" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR k = 0 TO texts.Count - 1" + NL
    t = t + "        lines = TextLines(texts[k])" + NL
    t = t + "        count = 0" + NL
    t = t + "        FOR i = 0 TO lines.Count - 1" + NL
    t = t + "            hit = Matches(lines[i], pat, flagText.Contains(""i""))" + NL
    t = t + "            IF flagText.Contains(""v"") THEN hit = NOT hit" + NL
    t = t + "            IF NOT hit THEN CONTINUE" + NL
    t = t + "            count = count + 1" + NL
    t = t + "            IF flagText.Contains(""c"") OR flagText.Contains(""l"") THEN CONTINUE" + NL
    t = t + "            pre = """"" + NL
    t = t + "            IF files.Count > 1 THEN pre = files[k] + "":""" + NL
    t = t + "            IF flagText.Contains(""n"") THEN pre = pre + Str(i + 1) + "":""" + NL
    t = t + "            out = out + pre + lines[i] + EOL" + NL
    t = t + "        NEXT" + NL
    t = t + "        found = found + count" + NL
    t = t + "        IF flagText.Contains(""l"") AND count > 0 THEN out = out + files[k] + EOL" + NL
    t = t + "        IF flagText.Contains(""c"") THEN" + NL
    t = t + "            IF files.Count > 1 THEN" + NL
    t = t + "                out = out + files[k] + "":"" + Str(count) + EOL" + NL
    t = t + "            ELSE" + NL
    t = t + "                out = out + Str(count) + EOL" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF found = 0 THEN shStatus = 1" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdSort (args AS Array OF String, input AS String) AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    first = Flags(args)" + NL
    t = t + "    text = input" + NL
    t = t + "    IF first < args.Count THEN" + NL
    t = t + "        text = """"" + NL
    t = t + "        FOR i = first TO args.Count - 1" + NL
    t = t + "            text = text + ReadFile(""sort"", args[i])" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    lines = TextLines(text)" + NL
    t = t + "    lines.Sort()" + NL
    t = t + "    IF flagText.Contains(""r"") THEN lines.Reverse()" + NL
    t = t + "    RETURN LinesText(lines)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdUniq (args AS Array OF String, input AS String) AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    FOR EACH ln IN TextLines(input)" + NL
    t = t + "        IF out.Count > 0 THEN" + NL
    t = t + "            IF out[out.Count - 1] = ln THEN CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        out.Add(ln)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN LinesText(out)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdTee (args AS Array OF String, input AS String) AS String" + NL
    t = t + "    VAR first AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    first = Flags(args)" + NL
    t = t + "    FOR i = first TO args.Count - 1" + NL
    t = t + "        p = Resolve(args[i])" + NL
    t = t + "        IF flagText.Contains(""a"") AND FS.Exists(p) THEN" + NL
    t = t + "            FS.Append(p, input)" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Write(p, input)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN input" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdSeq (args AS Array OF String) AS String" + NL
    t = t + "    VAR a AS Integer = 1" + NL
    t = t + "    VAR b AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    IF args.Count = 0 THEN RETURN Usage(""seq [first] last"")" + NL
    t = t + "    b = Int(Val(args[args.Count - 1]))" + NL
    t = t + "    IF args.Count > 1 THEN a = Int(Val(args[0]))" + NL
    t = t + "    IF b - a > 5000 THEN b = a + 5000" + NL
    t = t + "    FOR i = a TO b" + NL
    t = t + "        out = out + Str(i) + EOL" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ environment" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdEnv (onlyExported AS Bool) AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO varNames.Count - 1" + NL
    t = t + "        IF onlyExported AND NOT expNames.Contains(varNames[i]) THEN CONTINUE" + NL
    t = t + "        lines.Add(varNames[i] + ""="" + varVals[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    lines.Sort()" + NL
    t = t + "    RETURN LinesText(lines)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdExport (args AS Array OF String, exported AS Bool) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR eq AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    FOR i = 0 TO args.Count - 1" + NL
    t = t + "        eq = args[i].IndexOf(""="")" + NL
    t = t + "        name = args[i]" + NL
    t = t + "        IF eq > 0 THEN name = args[i].Substring(0, eq)" + NL
    t = t + "        IF NOT IsName(name) THEN" + NL
    t = t + "            Complain(""export: "" + args[i] + "": not a valid name"")" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF eq > 0 THEN SetVar(name, args[i].Substring(eq + 1, args[i].Length - eq - 1))" + NL
    t = t + "        IF exported AND NOT expNames.Contains(name.Upper()) THEN expNames.Add(name.Upper())" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdAlias (args AS Array OF String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR eq AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF args.Count = 0 THEN" + NL
    t = t + "        FOR i = 0 TO aliasNames.Count - 1" + NL
    t = t + "            out = out + ""alias "" + aliasNames[i] + ""='"" + aliasVals[i] + ""'"" + EOL" + NL
    t = t + "        NEXT" + NL
    t = t + "        RETURN out" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 0 TO args.Count - 1" + NL
    t = t + "        eq = args[i].IndexOf(""="")" + NL
    t = t + "        IF eq <= 0 THEN" + NL
    t = t + "            k = aliasNames.IndexOf(args[i])" + NL
    t = t + "            IF k < 0 THEN" + NL
    t = t + "                Complain(""alias: "" + args[i] + "": not found"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                out = out + ""alias "" + aliasNames[k] + ""='"" + aliasVals[k] + ""'"" + EOL" + NL
    t = t + "            END IF" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        name = args[i].Substring(0, eq)" + NL
    t = t + "        k = aliasNames.IndexOf(name)" + NL
    t = t + "        IF k >= 0 THEN" + NL
    t = t + "            aliasVals[k] = args[i].Substring(eq + 1, args[i].Length - eq - 1)" + NL
    t = t + "        ELSE" + NL
    t = t + "            aliasNames.Add(name)" + NL
    t = t + "            aliasVals.Add(args[i].Substring(eq + 1, args[i].Length - eq - 1))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdHistory (args AS Array OF String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF args.Count > 0 THEN" + NL
    t = t + "        IF args[0] = ""-c"" THEN" + NL
    t = t + "            hist.Clear()" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 0 TO hist.Count - 1" + NL
    t = t + "        out = out + Str(i + 1).PadLeft(5) + ""  "" + hist[i] + EOL" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdPs () AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    out = ""  PID NAME        STATE     WIN    CPU ms"" + EOL" + NL
    t = t + "    FOR EACH t IN SYS.Tasks()" + NL
    t = t + "        p = t.Split(""|"")" + NL
    t = t + "        out = out + p[0].PadLeft(5) + "" "" + p[1].PadRight(11) + "" "" + p[2].PadRight(9) + p[3].PadLeft(4) + p[4].PadLeft(9) + EOL" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' kill 12, or kill NOTES (every process of that name)" + NL
    t = t + "FUNCTION CmdKill (args AS Array OF String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR hit AS Bool" + NL
    t = t + "    VAR pid AS Integer" + NL
    t = t + "    IF args.Count = 0 THEN RETURN Usage(""kill pid|name"")" + NL
    t = t + "    FOR i = 0 TO args.Count - 1" + NL
    t = t + "        IF args[i].StartsWith(""-"") THEN CONTINUE" + NL
    t = t + "        hit = FALSE" + NL
    t = t + "        FOR EACH t IN SYS.Tasks()" + NL
    t = t + "            pid = Int(Val(t.Split(""|"")[0]))" + NL
    t = t + "            IF (t.Split(""|"")[0] = args[i] OR t.Split(""|"")[1].Upper() = args[i].Upper()) AND pid <> SYS.Pid THEN" + NL
    t = t + "                SYS.Kill(pid)" + NL
    t = t + "                hit = TRUE" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF NOT hit THEN Complain(""kill: "" + args[i] + "": no such process"")" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdWhich (args AS Array OF String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    FOR i = 0 TO args.Count - 1" + NL
    t = t + "        IF aliasNames.IndexOf(args[i]) >= 0 THEN" + NL
    t = t + "            out = out + args[i] + "": aliased to "" + aliasVals[aliasNames.IndexOf(args[i])] + EOL" + NL
    t = t + "        ELSEIF Builtins().Contains(args[i].Lower()) THEN" + NL
    t = t + "            out = out + args[i] + "": shell built-in"" + EOL" + NL
    t = t + "        ELSE" + NL
    t = t + "            p = FindProgram(args[i])" + NL
    t = t + "            IF p = """" THEN" + NL
    t = t + "                Complain(args[i] + "" not found"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                out = out + p + EOL" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdHelp (args AS Array OF String) AS String" + NL
    t = t + "    VAR h AS Array OF String" + NL
    t = t + "    h.Add(""Sim Shell "" + SHVERSION + "" for SIM95. Built-in commands:"")" + NL
    t = t + "    h.Add("""")" + NL
    t = t + "    h.Add(""  files     ls [-l] [path]  cd [dir|-|~]  pwd  cat [-n]  echo [-n]"")" + NL
    t = t + "    h.Add(""            mkdir [-p]  rm [-r] [-f]  rmdir  mv  cp [-r]  touch"")" + NL
    t = t + "    h.Add(""            head [-n N]  tail [-n N]  wc [-l -w -c]  grep [-i -n -v -c]"")" + NL
    t = t + "    h.Add(""            sort [-r]  uniq  tee [-a]  seq  basename"")" + NL
    t = t + "    h.Add(""  shell     env  export NAME=value  set  unset  alias name='text'"")" + NL
    t = t + "    h.Add(""            unalias  history [-c]  clear  exit  sh script.sh  source"")" + NL
    t = t + "    h.Add(""  system    ps  kill pid|name  run prog.spk [args]  date  whoami"")" + NL
    t = t + "    h.Add(""            hostname  uname  which  sleep  true  false  help"")" + NL
    t = t + "    h.Add(""  network   ssh [user@]host [command]   scp src dest (host:path)"")" + NL
    t = t + "    h.Add(""            sim-get update|list|search|show|install|remove|upgrade|store"")" + NL
    t = t + "    h.Add(""            host name [type] [@server]   (or nslookup: ask the SimDNS name server)"")" + NL
    t = t + "    h.Add("""")" + NL
    t = t + "    h.Add(""  cmd1 ; cmd2   cmd1 && cmd2   cmd1 || cmd2   cmd1 | cmd2"")" + NL
    t = t + "    h.Add(""  cmd > file    cmd >> file    cmd < file     $VAR  ${VAR}  $?  'text'"")" + NL
    t = t + "    h.Add(""  /programs/notes.spk is C:\PROGRAMS\NOTES.SPK; ~ is $HOME."")" + NL
    t = t + "    h.Add(""  Type a program's name (notes) or path to run it. Up/Down: history."")" + NL
    t = t + "    h.Add(""  Ctrl+Space completes a file name. Ctrl+C stops. Startup: "" + RCFILE)" + NL
    t = t + "    RETURN LinesText(h)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ ssh, scp: checked here, run by the caller" + NL
    t = t + "" + NL
    t = t + "FUNCTION CmdSsh (args AS Array OF String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR rest AS Array OF String" + NL
    t = t + "    IF args.Count = 0 THEN RETURN Usage(""ssh [user@]host [command]"")" + NL
    t = t + "    IF args.Count = 1 THEN" + NL
    t = t + "        Defer(""sshi"", args)" + NL
    t = t + "    ELSE" + NL
    t = t + "        rest.Add(args[0])" + NL
    t = t + "        FOR i = 1 TO args.Count - 1" + NL
    t = t + "            rest.Add(args[i])" + NL
    t = t + "        NEXT" + NL
    t = t + "        Defer(""ssh"", rest)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ sim-get: the Vapor library, shared with VAPOR.SPK" + NL
    t = t + "" + NL
    t = t + "' These follow VAPOR.SPK line for line, so that whatever one installs the" + NL
    t = t + "' other sees. The catalog (http://STORE/vapor/catalog.txt):" + NL
    t = t + "'   id|name|parts|bytes|status|category|about|kind|version|run|files|tasks|startup|folder" + NL
    t = t + "' The library (C:\GAMES\LIBRARY.TXT):" + NL
    t = t + "'   id|name|installed|seconds|category|about|version|kind|run|files|tasks|startup|folder" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Field (ln AS String, i AS Integer) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    p = ln.Split(""|"")" + NL
    t = t + "    IF i >= p.Count THEN RETURN """"" + NL
    t = t + "    RETURN p[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Meta (header AS String, key AS String) AS String" + NL
    t = t + "    VAR part AS String" + NL
    t = t + "    FOR EACH part IN header.Split(""|"")" + NL
    t = t + "        IF part.StartsWith(key + ""="") THEN RETURN part.Substring(key.Length + 1, part.Length - key.Length - 1)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unesc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%0A"", EOL).Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The store, as Vapor keeps it in C:\GAMES\VAPOR.INI (""http://alpha/vapor/"")." + NL
    t = t + "FUNCTION StoreUrl () AS String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    FOR EACH ln IN ReadOr(GAMEDIR + ""\VAPOR.INI"", """").Lines()" + NL
    t = t + "        IF ln.StartsWith(""store="") THEN s = ln.Substring(6, ln.Length - 6).Trim()" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF s = """" AND FS.Exists(""C:\WEB\VAPOR\CATALOG.TXT"") THEN s = ""http://"" + NET.HostName.Lower() + ""/vapor/""" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The catalog from the last sim-get update." + NL
    t = t + "FUNCTION Catalog () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    FOR EACH ln IN ReadOr(GETCACHE, """").Lines()" + NL
    t = t + "        IF ln.Split(""|"").Count >= 7 THEN out.Add(ln)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION StoreLine (id AS String) AS String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    FOR EACH ln IN Catalog()" + NL
    t = t + "        IF Field(ln, 0) = id.Upper() THEN RETURN ln" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Library () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    FOR EACH ln IN ReadOr(GAMEDIR + ""\LIBRARY.TXT"", """").Lines()" + NL
    t = t + "        IF ln.Split(""|"").Count >= 4 THEN out.Add(ln)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LibLine (id AS String) AS String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    FOR EACH ln IN Library()" + NL
    t = t + "        IF Field(ln, 0) = id.Upper() THEN RETURN ln" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION HasUpdate (id AS String) AS Bool" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    VAR shop AS String" + NL
    t = t + "    lib = LibLine(id)" + NL
    t = t + "    shop = StoreLine(id)" + NL
    t = t + "    IF lib = """" OR shop = """" OR Field(shop, 4) <> ""ok"" THEN RETURN FALSE" + NL
    t = t + "    RETURN Field(lib, 6) <> Field(shop, 8)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SaveLibrary (lines AS Array OF String)" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    IF NOT FS.Exists(GAMEDIR) THEN FS.MakeDir(GAMEDIR)" + NL
    t = t + "    IF lines.Count > 0 THEN text = lines.Join(EOL) + EOL" + NL
    t = t + "    FS.Write(GAMEDIR + ""\LIBRARY.TXT"", text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Into the library, or its line there brought up to date (keeping when it" + NL
    t = t + "' was first installed and the time played). Vapor's Keep." + NL
    t = t + "SUB Keep (ln AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    VAR first AS String" + NL
    t = t + "    VAR seconds AS String = ""0""" + NL
    t = t + "    VAR found AS Bool" + NL
    t = t + "    VAR old AS String" + NL
    t = t + "    first = TIME.Date" + NL
    t = t + "    FOR EACH l IN Library()" + NL
    t = t + "        IF Field(l, 0) = Field(ln, 0) THEN" + NL
    t = t + "            first = Field(l, 2)" + NL
    t = t + "            seconds = Field(l, 3)" + NL
    t = t + "            found = TRUE" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    l = Field(ln, 0) + ""|"" + Field(ln, 1) + ""|"" + first + ""|"" + seconds + ""|"" + Field(ln, 5) + ""|"" + Field(ln, 6) + ""|"" + Field(ln, 8) + ""|"" + Field(ln, 7) + ""|"" + Field(ln, 9) + ""|"" + Field(ln, 10) + ""|"" + Field(ln, 11) + ""|"" + Field(ln, 12) + ""|"" + Field(ln, 13)" + NL
    t = t + "    FOR EACH old IN Library()" + NL
    t = t + "        IF Field(old, 0) = Field(l, 0) THEN" + NL
    t = t + "            out.Add(l)" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(old)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT found THEN out.Add(l)" + NL
    t = t + "    SaveLibrary(out)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Folders () AS Bool" + NL
    t = t + "    RETURN ReadOr(WEBAPPSINI, """").Contains(""mode=folders"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Where (f AS String, folder AS String) AS String" + NL
    t = t + "    IF folder = """" OR NOT Folders() THEN RETURN f" + NL
    t = t + "    IF NOT f.Upper().StartsWith(""C:\WEB\"") THEN RETURN f" + NL
    t = t + "    RETURN ""C:\WEB\"" + folder + ""\"" + f.Substring(7, f.Length - 7)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION AllThere (files AS String, folder AS String) AS Bool" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    IF files = """" THEN RETURN FALSE" + NL
    t = t + "    FOR EACH f IN files.Split("";"")" + NL
    t = t + "        IF f <> """" AND NOT FS.Exists(Where(f, folder)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Stops it, takes it out of startup, deletes the files it wrote, and its" + NL
    t = t + "' folder in C:\GAMES. Vapor's Uninstall." + NL
    t = t + "SUB Uninstall (lib AS String)" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR task AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    id = Field(lib, 0)" + NL
    t = t + "    FOR EACH name IN Field(lib, 10).Split("";"")" + NL
    t = t + "        IF name = """" THEN CONTINUE" + NL
    t = t + "        FOR EACH task IN SYS.Tasks()" + NL
    t = t + "            IF task.Split(""|"")[1].Upper() = name.Upper() AND Int(Val(task.Split(""|"")[0])) <> SYS.Pid THEN SYS.Kill(Int(Val(task.Split(""|"")[0])))" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH name IN Field(lib, 11).Split("";"")" + NL
    t = t + "        IF name <> """" AND FS.Exists(""C:\SYSTEM\STARTUP\"" + name) THEN FS.Delete(""C:\SYSTEM\STARTUP\"" + name)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH f IN Field(lib, 9).Split("";"")" + NL
    t = t + "        IF f <> """" AND f.Upper() <> VAPORME THEN" + NL
    t = t + "            IF FS.Exists(Where(f, Field(lib, 12))) THEN FS.Delete(Where(f, Field(lib, 12)))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF Field(lib, 7) = ""web"" AND (Field(lib, 12) = """" OR NOT Folders()) AND NOT FS.Exists(""C:\WEB\INDEX.HTM"") AND FS.Exists(""C:\WEB\WELCOME.HTM"") THEN FS.Rename(""C:\WEB\WELCOME.HTM"", ""C:\WEB\INDEX.HTM"")" + NL
    t = t + "    IF FS.Exists(GAMEDIR + ""\"" + id) THEN" + NL
    t = t + "        FOR EACH f IN FS.List(GAMEDIR + ""\"" + id)" + NL
    t = t + "            IF NOT f.EndsWith(""\"") THEN FS.Delete(GAMEDIR + ""\"" + id + ""\"" + f)" + NL
    t = t + "        NEXT" + NL
    t = t + "        FS.Delete(GAMEDIR + ""\"" + id)" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH l IN Library()" + NL
    t = t + "        IF Field(l, 0) <> id THEN out.Add(l)" + NL
    t = t + "    NEXT" + NL
    t = t + "    SaveLibrary(out)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION KindWord (kind AS String) AS String" + NL
    t = t + "    SELECT CASE kind" + NL
    t = t + "        CASE """", ""game""" + NL
    t = t + "            RETURN ""game""" + NL
    t = t + "        CASE ""web""" + NL
    t = t + "            RETURN ""web app""" + NL
    t = t + "        CASE ""service""" + NL
    t = t + "            RETURN ""service""" + NL
    t = t + "        CASE ""client""" + NL
    t = t + "            RETURN ""store client""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""program""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' sim-get: the local parts run here; update, install and upgrade are jobs." + NL
    t = t + "FUNCTION CmdSimGet (args AS Array OF String) AS String" + NL
    t = t + "    VAR sub1 AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR ln AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR words AS Array OF String" + NL
    t = t + "    VAR hit AS Bool" + NL
    t = t + "    VAR w AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    IF args.Count = 0 THEN" + NL
    t = t + "        out = ""usage: sim-get update | list [--installed|--upgradable] | search words | show id"" + EOL" + NL
    t = t + "        out = out + ""               install [-y] id... | remove id... | upgrade | store host"" + EOL" + NL
    t = t + "        out = out + ""sim-get installs from a Vapor store and keeps Vapor's own library."" + EOL" + NL
    t = t + "        RETURN out" + NL
    t = t + "    END IF" + NL
    t = t + "    sub1 = args[0].Lower()" + NL
    t = t + "    SELECT CASE sub1" + NL
    t = t + "        CASE ""update"", ""install"", ""upgrade"", ""reinstall""" + NL
    t = t + "            IF StoreUrl() = """" THEN" + NL
    t = t + "                Complain(""E: no store yet. Choose one with: sim-get store <machine>"")" + NL
    t = t + "                RETURN """"" + NL
    t = t + "            END IF" + NL
    t = t + "            Defer(""get"", args)" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""store""" + NL
    t = t + "            IF args.Count < 2 THEN" + NL
    t = t + "                IF StoreUrl() = """" THEN RETURN ""No store yet. Choose one with: sim-get store <machine or domain>"" + EOL" + NL
    t = t + "                RETURN StoreUrl() + EOL" + NL
    t = t + "            END IF" + NL
    t = t + "            ' the same tidying as Vapor's Change Store" + NL
    t = t + "            s = args[1].Trim().Lower()" + NL
    t = t + "            IF NOT s.StartsWith(""http://"") THEN s = ""http://"" + s" + NL
    t = t + "            IF s.Substring(7, s.Length - 7).IndexOf(""/"") < 0 THEN s = s + ""/vapor/""" + NL
    t = t + "            IF NOT s.EndsWith(""/"") THEN s = s + ""/""" + NL
    t = t + "            IF NOT FS.Exists(GAMEDIR) THEN FS.MakeDir(GAMEDIR)" + NL
    t = t + "            FS.Write(GAMEDIR + ""\VAPOR.INI"", ""store="" + s + EOL)" + NL
    t = t + "            IF FS.Exists(GETCACHE) THEN FS.Delete(GETCACHE)" + NL
    t = t + "            RETURN ""Store: "" + s + EOL + ""Now run sim-get update."" + EOL" + NL
    t = t + "        CASE ""list""" + NL
    t = t + "            IF Catalog().Count = 0 AND NOT (args.Count > 1 AND args[args.Count - 1] = ""--installed"") THEN" + NL
    t = t + "                Complain(""E: no package lists. Run sim-get update first."")" + NL
    t = t + "                RETURN """"" + NL
    t = t + "            END IF" + NL
    t = t + "            IF args.Count > 1 AND args[args.Count - 1] = ""--installed"" THEN" + NL
    t = t + "                FOR EACH ln IN Library()" + NL
    t = t + "                    out = out + Field(ln, 0).Lower() + ""/"" + KindWord(Field(ln, 7)) + "" "" + Field(ln, 6) + "" [installed]"" + EOL" + NL
    t = t + "                NEXT" + NL
    t = t + "                RETURN out" + NL
    t = t + "            END IF" + NL
    t = t + "            out = ""Listing..."" + EOL" + NL
    t = t + "            FOR EACH ln IN Catalog()" + NL
    t = t + "                IF Field(ln, 7) = ""client"" THEN CONTINUE" + NL
    t = t + "                lib = LibLine(Field(ln, 0))" + NL
    t = t + "                IF args.Count > 1 AND args[args.Count - 1] = ""--upgradable"" AND NOT HasUpdate(Field(ln, 0)) THEN CONTINUE" + NL
    t = t + "                s = Field(ln, 0).Lower() + ""/"" + KindWord(Field(ln, 7)) + "" "" + Field(ln, 8)" + NL
    t = t + "                IF Field(ln, 4) = ""soon"" THEN" + NL
    t = t + "                    s = s + "" coming-soon""" + NL
    t = t + "                ELSEIF HasUpdate(Field(ln, 0)) THEN" + NL
    t = t + "                    s = s + "" [upgradable from: "" + Field(lib, 6) + ""]""" + NL
    t = t + "                ELSEIF lib <> """" THEN" + NL
    t = t + "                    s = s + "" [installed]""" + NL
    t = t + "                END IF" + NL
    t = t + "                out = out + s + EOL" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN out" + NL
    t = t + "        CASE ""search""" + NL
    t = t + "            IF args.Count < 2 THEN RETURN Usage(""sim-get search words"")" + NL
    t = t + "            FOR EACH ln IN Catalog()" + NL
    t = t + "                IF Field(ln, 7) = ""client"" THEN CONTINUE" + NL
    t = t + "                hit = TRUE" + NL
    t = t + "                FOR i = 1 TO args.Count - 1" + NL
    t = t + "                    w = args[i].Lower()" + NL
    t = t + "                    IF NOT (Field(ln, 0) + "" "" + Field(ln, 1) + "" "" + Field(ln, 5) + "" "" + Unesc(Field(ln, 6))).Lower().Contains(w) THEN hit = FALSE" + NL
    t = t + "                NEXT" + NL
    t = t + "                IF hit THEN out = out + Field(ln, 0).Lower() + "" - "" + Field(ln, 1) + "": "" + Unesc(Field(ln, 6)).Replace(EOL, "" "") + EOL" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF out = """" THEN shStatus = 1" + NL
    t = t + "            RETURN out" + NL
    t = t + "        CASE ""show""" + NL
    t = t + "            IF args.Count < 2 THEN RETURN Usage(""sim-get show id"")" + NL
    t = t + "            ln = StoreLine(args[1])" + NL
    t = t + "            lib = LibLine(args[1])" + NL
    t = t + "            IF ln = """" AND lib = """" THEN" + NL
    t = t + "                Complain(""E: No package found for "" + args[1])" + NL
    t = t + "                RETURN """"" + NL
    t = t + "            END IF" + NL
    t = t + "            IF ln = """" THEN" + NL
    t = t + "                ln = Field(lib, 0) + ""|"" + Field(lib, 1) + ""|0|0|ok|"" + Field(lib, 4) + ""|"" + Field(lib, 5) + ""|"" + Field(lib, 7) + ""|"" + Field(lib, 6) + ""|"" + Field(lib, 8) + ""|"" + Field(lib, 9) + ""|"" + Field(lib, 10) + ""|"" + Field(lib, 11) + ""|"" + Field(lib, 12)" + NL
    t = t + "            END IF" + NL
    t = t + "            out = ""Package: "" + Field(ln, 0).Lower() + EOL" + NL
    t = t + "            out = out + ""Name: "" + Field(ln, 1) + EOL" + NL
    t = t + "            out = out + ""Version: "" + Field(ln, 8) + EOL" + NL
    t = t + "            out = out + ""Kind: "" + KindWord(Field(ln, 7)) + EOL" + NL
    t = t + "            out = out + ""Section: "" + Field(ln, 5) + EOL" + NL
    t = t + "            out = out + ""Size: "" + Str(Int(Val(Field(ln, 3)) / 1024) + 1) + "" kB in "" + Field(ln, 2) + "" parts"" + EOL" + NL
    t = t + "            IF Field(ln, 9) <> """" THEN out = out + ""Run: "" + Field(ln, 9) + EOL" + NL
    t = t + "            IF Field(ln, 10) <> """" THEN out = out + ""Files: "" + Field(ln, 10).Replace("";"", "" "") + EOL" + NL
    t = t + "            IF Field(ln, 12) <> """" THEN out = out + ""Starts with SIM95: "" + Field(ln, 12) + EOL" + NL
    t = t + "            IF lib <> """" THEN" + NL
    t = t + "                out = out + ""Installed: "" + Field(lib, 2) + "" (build "" + Field(lib, 6) + "")"" + EOL" + NL
    t = t + "            ELSE" + NL
    t = t + "                out = out + ""Installed: no"" + EOL" + NL
    t = t + "            END IF" + NL
    t = t + "            IF Field(ln, 4) = ""soon"" THEN out = out + ""Status: coming soon"" + EOL" + NL
    t = t + "            out = out + ""Description: "" + Unesc(Field(ln, 6)).Replace(EOL, "" "") + EOL" + NL
    t = t + "            RETURN out" + NL
    t = t + "        CASE ""remove"", ""purge""" + NL
    t = t + "            IF args.Count < 2 THEN RETURN Usage(""sim-get remove id..."")" + NL
    t = t + "            FOR i = 1 TO args.Count - 1" + NL
    t = t + "                lib = LibLine(args[i])" + NL
    t = t + "                IF lib = """" THEN" + NL
    t = t + "                    Complain(""E: "" + args[i].Lower() + "" is not installed"")" + NL
    t = t + "                    CONTINUE" + NL
    t = t + "                END IF" + NL
    t = t + "                out = out + ""Removing "" + Field(lib, 1) + "" ("" + Field(lib, 6) + "") ..."" + EOL" + NL
    t = t + "                Uninstall(lib)" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF out <> """" THEN out = out + ""Done. Saved data (mail, posts, settings) is left where it was."" + EOL" + NL
    t = t + "            RETURN out" + NL
    t = t + "    END SELECT" + NL
    t = t + "    Complain(""E: Invalid operation "" + args[0])" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' SSHD.SPK - the Sim Shell server. It listens on port 22 and runs commands" + NL
    t = t + "' sent by another machine's ""ssh"" (in the Sim Shell), in that machine's shell," + NL
    t = t + "' on this machine's disk. The installer builder puts CORE.SPK above this, so" + NL
    t = t + "' the server runs commands with exactly the built-ins the window does." + NL
    t = t + "'" + NL
    t = t + "' NOT SECURE. SIM95 has no crypto: this is rsh with a password. AUTH takes" + NL
    t = t + "' the machine's own user name and password (C:\SYSTEM\USERS.INI), the same" + NL
    t = t + "' ones the Files service takes, and the whole session travels as plain text" + NL
    t = t + "' that Monitor can read. See README.md." + NL
    t = t + "'" + NL
    t = t + "' Protocol, one request per message, one reply per message:" + NL
    t = t + "'   AUTH user|password      -> OK + prompt + motd, or ERR reason" + NL
    t = t + "'   RUN command line        -> ""RET <code>[ clear]"" + prompt + output" + NL
    t = t + "'                              (""BYE"" + prompt + output when the command is exit)" + NL
    t = t + "' A reply must fit in one network message (64K), so long output is cut." + NL
    t = t + "" + NL
    t = t + "CONST SSHDPORT = 22" + NL
    t = t + "CONST REPLYMAX = 60000" + NL
    t = t + "" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR log AS GUI_ListBox" + NL
    t = t + "VAR sock AS NET_Socket" + NL
    t = t + "VAR sessions AS Integer" + NL
    t = t + "VAR ran AS Integer" + NL
    t = t + "VAR brk AS Integer" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    EOL = Chr(10)" + NL
    t = t + "    shRemote = TRUE" + NL
    t = t + "    win = GUI_Window.New(""Sim Shell Server"", 460, 220)" + NL
    t = t + "    win.Icon = ""network""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    win.onResize = Win_OnResize" + NL
    t = t + "    log = GUI_ListBox.New(win)" + NL
    t = t + "    log.Mono = TRUE" + NL
    t = t + "    Win_OnResize()" + NL
    t = t + "" + NL
    t = t + "    sock = NET_Socket.New()" + NL
    t = t + "    sock.onConnect = Sock_OnConnect" + NL
    t = t + "    sock.onMessage = Sock_OnMessage" + NL
    t = t + "    sock.onClose = Sock_OnClose" + NL
    t = t + "    sock.onError = Sock_OnError" + NL
    t = t + "    sock.Listen(SSHDPORT)" + NL
    t = t + "    Note(""sshd listening on port "" + Str(SSHDPORT) + "" as "" + NET.HostName.Lower())" + NL
    t = t + "    Note(""Not secure: rsh with a password. See README.md."")" + NL
    t = t + "    Status()" + NL
    t = t + "    win.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    sock.Close()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnResize ()" + NL
    t = t + "    log.SetBounds(0, 0, win.Width, win.Height)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnError (message AS String)" + NL
    t = t + "    Note(""ERROR "" + message)" + NL
    t = t + "    IF message.Contains(""in use"") THEN Note(""Is another sshd already running? See Tasks."")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Note (text AS String)" + NL
    t = t + "    log.Add(TIME.Clock + ""  "" + text)" + NL
    t = t + "    IF log.Count > 300 THEN log.RemoveAt(0)" + NL
    t = t + "    log.ScrollToEnd()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Status ()" + NL
    t = t + "    win.Status = NET.HostName.Lower() + "" port "" + Str(SSHDPORT) + "" - "" + Str(sessions) + "" logins, "" + Str(ran) + "" commands""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnConnect (conn AS NET_Connection)" + NL
    t = t + "    conn.Accept()" + NL
    t = t + "    conn.Tag = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnClose (conn AS NET_Connection)" + NL
    t = t + "    Note(""session from "" + conn.FromAddress + "" closed"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Cut a reply to one network message." + NL
    t = t + "FUNCTION Cap (text AS String) AS String" + NL
    t = t + "    IF text.Length <= REPLYMAX THEN RETURN text" + NL
    t = t + "    RETURN text.Substring(0, REPLYMAX - 40) + EOL + ""...[output cut at 60K]"" + EOL" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR cmd AS String" + NL
    t = t + "    VAR arg AS String" + NL
    t = t + "    VAR sp AS Integer" + NL
    t = t + "    VAR bar AS Integer" + NL
    t = t + "    VAR user AS String" + NL
    t = t + "    VAR pass AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR state AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    sp = message.IndexOf("" "")" + NL
    t = t + "    cmd = message" + NL
    t = t + "    arg = """"" + NL
    t = t + "    IF sp >= 0 THEN" + NL
    t = t + "        cmd = message.Substring(0, sp)" + NL
    t = t + "        arg = message.Substring(sp + 1, message.Length - sp - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    cmd = cmd.Upper()" + NL
    t = t + "    IF cmd <> ""AUTH"" AND cmd <> ""RUN"" THEN" + NL
    t = t + "        brk = message.IndexOf(EOL)" + NL
    t = t + "        IF brk >= 0 THEN" + NL
    t = t + "            cmd = message.Substring(0, brk).Upper().Trim()" + NL
    t = t + "            arg = message.Substring(brk + 1, message.Length - brk - 1)" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    IF cmd = ""AUTH"" THEN" + NL
    t = t + "        bar = arg.IndexOf(""|"")" + NL
    t = t + "        IF bar < 0 THEN bar = arg.Length" + NL
    t = t + "        user = arg.Substring(0, bar)" + NL
    t = t + "        pass = arg.Substring(bar + 1, arg.Length - bar - 1)" + NL
    t = t + "        IF NOT CheckLogin(user, pass) THEN" + NL
    t = t + "            conn.Send(""ERR Access denied"")" + NL
    t = t + "            Note(""login refused from "" + conn.FromAddress + "" ("" + user + "")"")" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        ShInit(MachineUser(), NET.HostName.Lower())" + NL
    t = t + "        shRemote = TRUE" + NL
    t = t + "        conn.Tag = Chr(5) + SaveState()" + NL
    t = t + "        sessions = sessions + 1" + NL
    t = t + "        Status()" + NL
    t = t + "        Note(""login from "" + conn.FromAddress + "" as "" + user)" + NL
    t = t + "        conn.Send(""OK"" + EOL + Prompt() + EOL + ""Sim Shell on "" + NET.HostName.Lower() + "". Not secure. Type exit to log out."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    IF cmd = ""RUN"" THEN" + NL
    t = t + "        IF NOT conn.Tag.StartsWith(Chr(5)) THEN" + NL
    t = t + "            conn.Send(""ERR Not logged in"")" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        state = conn.Tag.Substring(1, conn.Tag.Length - 1)" + NL
    t = t + "        LoadState(state)" + NL
    t = t + "        shRemote = TRUE" + NL
    t = t + "        shOut = """"" + NL
    t = t + "        shClear = FALSE" + NL
    t = t + "        shExit = FALSE" + NL
    t = t + "        line = arg" + NL
    t = t + "        out = """"" + NL
    t = t + "        TRY" + NL
    t = t + "            out = ShRun(line)" + NL
    t = t + "        CATCH err" + NL
    t = t + "            out = line.Split("" "")[0] + "": "" + err + EOL" + NL
    t = t + "        END TRY" + NL
    t = t + "        ran = ran + 1" + NL
    t = t + "        Status()" + NL
    t = t + "        IF shExit THEN" + NL
    t = t + "            conn.Send(Cap(""BYE"" + EOL + Prompt() + EOL + out))" + NL
    t = t + "            conn.Close()" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        conn.Tag = Chr(5) + SaveState()" + NL
    t = t + "        IF shClear THEN" + NL
    t = t + "            conn.Send(Cap(""RET 0 clear"" + EOL + Prompt() + EOL + out))" + NL
    t = t + "        ELSE" + NL
    t = t + "            conn.Send(Cap(""RET "" + Str(shStatus) + EOL + Prompt() + EOL + out))" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    conn.Send(""ERR Bad command"")" + NL
    t = t + "END SUB" + NL
    Put("C:\PROGRAMS\SSHD.SPK")
END SUB

SUB StartService (name AS String, program AS String, runFile AS String)
    VAR task AS String
    FS.Write("C:\SYSTEM\STARTUP\" + runFile, program)
    Print("  " + name + " will start with the machine (C:\SYSTEM\STARTUP\" + runFile + ")")
    FOR EACH task IN SYS.Tasks()
        IF task.Split("|")[1].Upper() = name THEN
            SYS.Kill(Int(Val(task.Split("|")[0])))
            Print("  stopped the old " + name)
        END IF
    NEXT
    SYS.Run(program)
    Print("  started " + program)
END SUB

' Writes an example startup file the first time only; an existing one is kept,
' so a reinstall or upgrade never overwrites yours.
SUB MakeRc ()
    VAR t AS String
    IF FS.Exists("C:\SYSTEM\SIMSHRC.SH") THEN RETURN
    t = ""
    t = t + "# SIMSHRC.SH - the Sim Shell runs this at startup (8.3 name!)." + Chr(10)
    t = t + "# Edit it to taste: aliases, variables, a welcome line." + Chr(10)
    t = t + "alias ll='ls -l'" + Chr(10)
    t = t + "alias ..='cd ..'" + Chr(10)
    t = t + "alias h='history'" + Chr(10)
    t = t + "export EDITOR=C:\PROGRAMS\NOTES.SPK" + Chr(10)
    t = t + "echo Welcome to the Sim Shell, $USER." + Chr(10)
    FS.Write("C:\SYSTEM\SIMSHRC.SH", t)
    Print("  wrote C:\SYSTEM\SIMSHRC.SH (an example startup file)")
END SUB
