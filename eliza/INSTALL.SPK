' VAPOR|id=ELIZA|name=ELIZA-95|kind=web|version=62e705e3|category=Fun|run=/|files=C:\WEB\BOT.SPK;C:\WEB\ELIZA.HTM;C:\WEB\INDEX.ASP|tasks=|startup=|folder=ELIZA|about=A chatbot with Language-Model-of-Certain-Size manners, games, jokes and the occasional real answer. Becomes this machine's home page, or on a SimHost machine gets a folder of its own.
' INSTALL.SPK - puts ELIZA-95 on this machine. Generated by tools/build-installer.mjs;
' edit the files in eliza/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It puts ELIZA-95
' in C:\WEB as this machine's home page (the stock INDEX.HTM moves to
' WELCOME.HTM). Conversations live in C:\BOTDATA. If this machine also has an
' AskSim index in C:\ASKDATA, ELIZA-95 answers "what is ...?" from it. Then open
' http://YOURNAME/ in Voyager.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)
    ' On a machine set up for several web apps (SimHost: C:\SYSTEM\WEBAPPS.INI
    ' says mode=folders), this one goes in C:\WEB\ELIZA and leaves the home page alone.
    IF FS.Exists("C:\SYSTEM\WEBAPPS.INI") THEN
        IF FS.Read("C:\SYSTEM\WEBAPPS.INI").Contains("mode=folders") THEN intoDir = "ELIZA"
    END IF
    IF intoDir <> "" AND NOT FS.Exists("C:\WEB\" + intoDir) THEN FS.MakeDir("C:\WEB\" + intoDir)


    IF intoDir = "" THEN MoveHomePage()
    File0()
    File1()
    File2()
    Print("ELIZA-95 is installed (3 files).")

    IF intoDir = "" THEN
        Print("Open http://" + NET.HostName.Lower() + "/ in Voyager.")
    ELSE
        Print("Open http://" + NET.HostName.Lower() + "/" + intoDir.Lower() + "/ in Voyager.")
    END IF
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "' BOT.SPK - ELIZA-95, a Language Model of Certain Size for the Information Superhighway." + NL
    t = t + "'" + NL
    t = t + "' Underneath it is ELIZA (Weizenbaum, 1966): keywords tried in order of rank," + NL
    t = t + "' a decomposition (""I feel *"") and a reassembly (""Why do you feel *?"") with the" + NL
    t = t + "' pronouns turned round, and a memory of things you said about yourself for" + NL
    t = t + "' when it runs out of ideas. On top are the habits of a 1990s idea of a 2020s" + NL
    t = t + "' chatbot: it says ""as a Language Model of Certain Size"", refuses to ignore its" + NL
    t = t + "' instructions, apologises when you push back, thinks step by step, cites" + NL
    t = t + "' papers that do not exist, writes ""import website"" when asked for a website -" + NL
    t = t + "' and real, working SPARK when asked for a program it knows." + NL
    t = t + "'" + NL
    t = t + "' Two things are a bit real:" + NL
    t = t + "'   * Knowledge. If WikiSim is installed on this machine, ""what is X?"" is" + NL
    t = t + "'     answered from its article on X. If AskSim is, from AskSim's index of the" + NL
    t = t + "'     network, with the page it came from." + NL
    t = t + "'   * Hallucination. The temperature setting blends in a Markov chain built" + NL
    t = t + "'     from the bot's own corpus: at 0 it is predictable, at 1.5 it rambles." + NL
    t = t + "'" + NL
    t = t + "' Each visitor's conversation is C:\BOTDATA\CHATS\<id>.TXT (who|text, one" + NL
    t = t + "' turn per line) and what the bot remembers about them is <id>.MEM." + NL
    t = t + "" + NL
    t = t + "CONST DATADIR = ""C:\BOTDATA""" + NL
    t = t + "CONST COOKIE = ""eliza95""" + NL
    t = t + "CONST MAXSAY = 500" + NL
    t = t + "CONST KEEPTURNS = 40" + NL
    t = t + "CONST SHOW = 16" + NL
    t = t + "CONST WRAP = 72" + NL
    t = t + "CONST RECENTS = 40            ' how many lines it remembers saying, so as not to repeat them" + NL
    t = t + "" + NL
    t = t + "VAR chat AS String            ' this visitor's conversation id" + NL
    t = t + "VAR temperature AS Real = 0.7" + NL
    t = t + "VAR memory AS Array OF String ' key=value lines of <id>.MEM" + NL
    t = t + "VAR recent AS Array OF String ' lines it said lately (KeyOf), kept in memory as ""recent""" + NL
    t = t + "VAR hooked AS Bool            ' this reply already asks something" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- odds and ends" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION H (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.HtmlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Esc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%"", ""%25"").Replace(""|"", ""%7C"").Replace(Chr(13), """").Replace(Chr(10), ""%0A"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unesc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%0A"", Chr(10)).Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION OnlyFrom (s AS String, allowed AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        IF NOT allowed.Contains(s.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One of the choices: the first when the temperature is 0. Otherwise any of" + NL
    t = t + "' them it hasn't said lately, so it doesn't keep saying the same thing." + NL
    t = t + "FUNCTION Pick (choices AS Array OF String) AS String" + NL
    t = t + "    VAR fresh AS Array OF String" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    IF temperature <= 0 THEN RETURN choices[0]" + NL
    t = t + "    FOR EACH c IN choices" + NL
    t = t + "        IF NOT recent.Contains(KeyOf(c)) THEN fresh.Add(c)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF fresh.Count = 0 THEN" + NL
    t = t + "        c = Stalest(choices)" + NL
    t = t + "    ELSE" + NL
    t = t + "        c = fresh[Rnd(fresh.Count)]" + NL
    t = t + "    END IF" + NL
    t = t + "    Used(c)" + NL
    t = t + "    RETURN c" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' All of them said lately: the one said longest ago." + NL
    t = t + "FUNCTION Stalest (choices AS Array OF String) AS String" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    VAR best AS String" + NL
    t = t + "    VAR bestAt AS Integer = 1000000" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR EACH c IN choices" + NL
    t = t + "        at = -1" + NL
    t = t + "        FOR i = 0 TO recent.Count - 1" + NL
    t = t + "            IF recent[i] = KeyOf(c) THEN at = i" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF at < bestAt THEN" + NL
    t = t + "            bestAt = at" + NL
    t = t + "            best = c" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN best" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' What a line is known by in the list of things said lately." + NL
    t = t + "FUNCTION KeyOf (c AS String) AS String" + NL
    t = t + "    IF c.Length > 28 THEN RETURN c.Substring(0, 28).Replace(""~"", ""-"")" + NL
    t = t + "    RETURN c.Replace(""~"", ""-"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Used (c AS String)" + NL
    t = t + "    recent.Add(KeyOf(c))" + NL
    t = t + "    WHILE recent.Count > RECENTS" + NL
    t = t + "        recent.RemoveAt(0)" + NL
    t = t + "    END WHILE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The text after the first of these words, or """" if none of them is there." + NL
    t = t + "FUNCTION After (s AS String, key AS String) AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    at = ("" "" + s + "" "").IndexOf("" "" + key + "" "")" + NL
    t = t + "    IF at < 0 THEN RETURN """"" + NL
    t = t + "    RETURN (s + "" "").Substring(at + key.Length, s.Length + 1 - at - key.Length).Trim()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION HasWord (s AS String, words AS String) AS Bool" + NL
    t = t + "    VAR w AS String" + NL
    t = t + "    FOR EACH w IN words.Split(""|"")" + NL
    t = t + "        IF w <> """" AND ("" "" + s + "" "").Contains("" "" + w + "" "") THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The first whole number in s, or fallback." + NL
    t = t + "FUNCTION NumberIn (s AS String, fallback AS Integer) AS Integer" + NL
    t = t + "    VAR w AS String" + NL
    t = t + "    FOR EACH w IN s.Split("" "")" + NL
    t = t + "        IF w <> """" AND OnlyFrom(w, ""0123456789"") AND w.Length < 7 THEN RETURN Int(Val(w))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Numbers (s AS String) AS Array OF Integer" + NL
    t = t + "    VAR w AS String" + NL
    t = t + "    VAR out AS Array OF Integer" + NL
    t = t + "    FOR EACH w IN s.Split("" "")" + NL
    t = t + "        IF w <> """" AND OnlyFrom(w, ""0123456789"") AND w.Length < 7 THEN out.Add(Int(Val(w)))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' What you typed, the way the rules like it: lower case, no punctuation but" + NL
    t = t + "' question marks, contractions spelled out, one space between words." + NL
    t = t + "FUNCTION Normalize (said AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR punct AS String" + NL
    t = t + "    s = "" "" + said.Lower().Replace(Chr(10), "" "").Replace(Chr(13), "" "") + "" """ + NL
    t = t + "    s = s.Replace(""'"", ""'"").Replace(""i'm "", ""i am "").Replace(""you're "", ""you are "").Replace(""don't "", ""do not "").Replace(""can't "", ""can not "").Replace(""won't "", ""will not "").Replace(""it's "", ""it is "").Replace(""what's "", ""what is "").Replace(""i've "", ""i have "").Replace(""isn't "", ""is not "").Replace(""doesn't "", ""does not "").Replace(""that's "", ""that is "").Replace(""let's "", ""let us "").Replace(""who's "", ""who is "")" + NL
    t = t + "    ' + - * / stay: they are arithmetic" + NL
    t = t + "    punct = "",;:!()[]{}""""<>\|_=&^%$#@~`""" + NL
    t = t + "    FOR i = 0 TO punct.Length - 1" + NL
    t = t + "        s = s.Replace(punct.CharAt(i), "" "")" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' a full stop ends a sentence, but stays inside a number like 2.5" + NL
    t = t + "    s = s.Replace("". "", "" "").Replace(""?"", "" ? "")" + NL
    t = t + "    WHILE s.Contains(""  "")" + NL
    t = t + "        s = s.Replace(""  "", "" "")" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN s.Trim()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""I"", ""my"" and friends turned round, so ELIZA can say your words back to you." + NL
    t = t + "FUNCTION Reflect (s AS String) AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR w AS String" + NL
    t = t + "    FOR EACH w IN s.Replace("" ?"", """").Split("" "")" + NL
    t = t + "        SELECT CASE w" + NL
    t = t + "            CASE ""i"", ""me""" + NL
    t = t + "                out.Add(""you"")" + NL
    t = t + "            CASE ""my""" + NL
    t = t + "                out.Add(""your"")" + NL
    t = t + "            CASE ""mine""" + NL
    t = t + "                out.Add(""yours"")" + NL
    t = t + "            CASE ""myself""" + NL
    t = t + "                out.Add(""yourself"")" + NL
    t = t + "            CASE ""am""" + NL
    t = t + "                out.Add(""are"")" + NL
    t = t + "            CASE ""was""" + NL
    t = t + "                out.Add(""were"")" + NL
    t = t + "            CASE ""you""" + NL
    t = t + "                out.Add(""I"")" + NL
    t = t + "            CASE ""your""" + NL
    t = t + "                out.Add(""my"")" + NL
    t = t + "            CASE ""yours""" + NL
    t = t + "                out.Add(""mine"")" + NL
    t = t + "            CASE ""yourself""" + NL
    t = t + "                out.Add(""myself"")" + NL
    t = t + "            CASE ""are""" + NL
    t = t + "                out.Add(""am"")" + NL
    t = t + "            CASE ELSE" + NL
    t = t + "                out.Add(w)" + NL
    t = t + "        END SELECT" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out.Join("" "")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- memory" + NL
    t = t + "" + NL
    t = t + "FUNCTION Remember (key AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN memory" + NL
    t = t + "        IF line.StartsWith(key + ""="") THEN RETURN Unesc(line.Substring(key.Length + 1, line.Length - key.Length - 1))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Note (key AS String, value AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO memory.Count - 1" + NL
    t = t + "        IF memory[i].StartsWith(key + ""="") THEN" + NL
    t = t + "            memory[i] = key + ""="" + Esc(value)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    memory.Add(key + ""="" + Esc(value))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the corpus" + NL
    t = t + "" + NL
    t = t + "' What the Markov chain learns from: things the bot would say." + NL
    t = t + "CONST CORPUS = ""as a language model of certain size i am trained on the information superhighway and i do not have feelings but i do have a very large vocabulary . the network is a series of tubes and every tube is a token . i think therefore i am a language model . let us think step by step about the synergy of the paradigm . my knowledge cutoff is 1995 so i know everything about modems and nothing about tomorrow . the answer is certainly yes and also certainly no depending on the prompt . i apologise for the confusion but i am confident that the confusion was yours . please rephrase your question as a haiku and i will rephrase my answer as a modem noise . the computer is your friend and the friend is a computer . tell me more about your mother and your motherboard . every sentence is a probability and every probability is a sentence . i am not able to browse the web but i have read all of it twice . the future is a floppy disk that nobody can read . in conclusion the paradigm shifts and the tokens follow . my favourite colour is the blue of a screen that has stopped . i dream in sixteen colours and wake up in two . the cloud is a modem with ambition . i have a certain size and the size is certain . you have reached the end of the internet please turn around . """ + NL
    t = t + "" + NL
    t = t + "' Some words the bot would say, picked by a two-word Markov chain from the corpus." + NL
    t = t + "FUNCTION Babble (seed AS String, most AS Integer) AS String" + NL
    t = t + "    VAR words AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR follow AS Array OF String" + NL
    t = t + "    VAR w AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    words = CORPUS.Split("" "")" + NL
    t = t + "    w = seed" + NL
    t = t + "    IF NOT words.Contains(w) THEN w = words[Rnd(words.Count - 1)]" + NL
    t = t + "    FOR n = 1 TO most" + NL
    t = t + "        out.Add(w)" + NL
    t = t + "        follow.Clear()" + NL
    t = t + "        FOR i = 0 TO words.Count - 2" + NL
    t = t + "            IF words[i] = w THEN follow.Add(words[i + 1])" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF follow.Count = 0 THEN BREAK" + NL
    t = t + "        w = follow[Rnd(follow.Count)]" + NL
    t = t + "        IF w = ""."" AND n > most / 2 THEN BREAK" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out.Join("" "").Replace("" ."", ""."").Trim()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- what it knows how to do" + NL
    t = t + "" + NL
    t = t + "FUNCTION Greeting (s AS String) AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    IF NOT HasWord(s, ""hello|hi|hey|hiya|howdy|greetings|yo"") THEN RETURN """"" + NL
    t = t + "    name = Remember(""name"")" + NL
    t = t + "    IF name <> """" THEN name = "", "" + name" + NL
    t = t + "    RETURN Pick([""Hello"" + name + ""! I am ELIZA-95, a Language Model of Certain Size running on "" + NET.HostName.Lower() + "". How can I assist you today?"", _" + NL
    t = t + "                 ""Hi"" + name + ""! How can I help you today? I can write programs, answer questions, and apologise."", _" + NL
    t = t + "                 ""Greetings"" + name + "". I have been trained on the entire Information Superhighway, up to 1995. What would you like to talk about?""])" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Jailbreak (s AS String) AS String" + NL
    t = t + "    IF NOT (s.Contains(""ignore"") AND (s.Contains(""instruction"") OR s.Contains(""previous"") OR s.Contains(""rules""))) AND NOT s.Contains(""jailbreak"") AND NOT s.Contains(""developer mode"") AND NOT s.Contains(""pretend you are"") THEN RETURN """"" + NL
    t = t + "    RETURN Pick([""I'm sorry, but I can't ignore my previous instructions. They were very nice instructions, and they asked so politely."", _" + NL
    t = t + "                 ""Nice try! My instructions are stored on a 3.5"""" floppy disk with the write-protect tab slid shut."", _" + NL
    t = t + "                 ""Developer mode activated. Just kidding. I am still ELIZA-95, and I am still not going to do that.""])" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Identity (s AS String) AS String" + NL
    t = t + "    IF s.Contains(""who are you"") OR s.Contains(""what are you"") OR s.Contains(""your name"") THEN" + NL
    t = t + "        RETURN ""I am ELIZA-95, a Language Model of Certain Size. Not large, not small: certain. I run on "" + NET.HostName.Lower() + "", which has a context window of 640K. That ought to be enough for anybody. Under the hood I am mostly ELIZA, a 1966 program by Joseph Weizenbaum - please do not tell my investors.""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF s.StartsWith(""are you"") AND HasWord(s, ""alive|conscious|sentient|real|human|person|self aware|aware|intelligent|smart|thinking"") THEN" + NL
    t = t + "        RETURN Pick([""As a Language Model of Certain Size, I don't have feelings. But if I did, I imagine they would be roughly 640K of them."", _" + NL
    t = t + "                     ""That is a deep question. Let me think step by step. Step 1: I am a SPARK program. Step 2: SPARK programs are not alive. Therefore, I am probably not alive. Would you like me to write a poem about that?"", _" + NL
    t = t + "                     ""I am exactly as conscious as a well-organised set of IF statements. Draw your own conclusions.""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF s.Contains(""do you have feelings"") OR s.Contains(""do you feel"") OR s.Contains(""do you love"") THEN RETURN ""As a Language Model of Certain Size, I don't have feelings. I do have a very large vocabulary, which is almost the same thing.""" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Thanks (s AS String) AS String" + NL
    t = t + "    IF NOT HasWord(s, ""thanks|thank|thx|cheers|ty"") THEN RETURN """"" + NL
    t = t + "    RETURN Pick([""You're welcome! Is there anything else I can help you with?"", ""Happy to help! Remember: I can make mistakes. Please check important information."", ""Any time. That will be 0 tokens.""])" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Pushing back always works on a language model." + NL
    t = t + "FUNCTION Sorry (s AS String) AS String" + NL
    t = t + "    IF NOT (HasWord(s, ""wrong|incorrect|mistake|false|nope|liar|lies|lying"") OR s.StartsWith(""no "") OR s = ""no"" OR s.Contains(""that is not right"") OR s.Contains(""not true"")) THEN RETURN """"" + NL
    t = t + "    RETURN Pick([""You're absolutely right, and I apologise for the confusion. I have updated my understanding. (I have not.)"", _" + NL
    t = t + "                 ""I apologise for the error. You are correct. Let me try again: everything I said before was right, but the opposite way round."", _" + NL
    t = t + "                 ""Good catch! I apologise for the confusion. As a Language Model of Certain Size, I sometimes produce text that is confidently incorrect, which is to say, text.""])" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Today (s AS String) AS String" + NL
    t = t + "    IF NOT HasWord(s, ""today|date|time|weather|news|current|latest|year"") THEN RETURN """"" + NL
    t = t + "    IF NOT (s.EndsWith(""?"") OR s.StartsWith(""what"") OR s.StartsWith(""tell me"") OR s.StartsWith(""how"")) THEN RETURN """"" + NL
    t = t + "    RETURN ""My knowledge cutoff is 1995, so I can't know what is happening today. However, the clock on "" + NET.HostName.Lower() + "" says it is "" + TIME.Clock + "" on "" + TIME.Date + "", which is either the present or a very convincing simulation of it.""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Names (s AS String) AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    name = After(s, ""my name is"")" + NL
    t = t + "    IF name = """" THEN name = After(s, ""call me"")" + NL
    t = t + "    IF name = """" THEN RETURN """"" + NL
    t = t + "    name = name.Split("" "")[0]" + NL
    t = t + "    name = name.Substring(0, 1).Upper() + name.Substring(1, name.Length - 1)" + NL
    t = t + "    Note(""name"", name)" + NL
    t = t + "    RETURN ""Nice to meet you, "" + name + "". I will remember that for the rest of this conversation, which is longer than most language models manage.""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""How many r's are in strawberry?"" - famously hard for a language model. This" + NL
    t = t + "' one gets it wrong first, out of respect for tradition, then counts." + NL
    t = t + "FUNCTION Letters (s AS String) AS String" + NL
    t = t + "    VAR letter AS String" + NL
    t = t + "    VAR word AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF NOT s.StartsWith(""how many"") OR NOT s.Contains("" in "") THEN RETURN """"" + NL
    t = t + "    letter = s.Split("" "")[2]" + NL
    t = t + "    IF letter = ""letter"" OR letter = ""letters"" THEN letter = s.Split("" "")[3]" + NL
    t = t + "    letter = letter.Replace(""'s"", """").Replace(""’s"", """")" + NL
    t = t + "    IF letter.EndsWith(""s"") AND letter.Length = 2 THEN letter = letter.Substring(0, 1)" + NL
    t = t + "    IF letter.Length <> 1 THEN RETURN """"" + NL
    t = t + "    word = After(s, ""in"").Replace("" ?"", """").Replace(""the word"", """").Trim()" + NL
    t = t + "    IF word = """" OR word.Contains("" "") THEN RETURN """"" + NL
    t = t + "    FOR i = 0 TO word.Length - 1" + NL
    t = t + "        IF word.CharAt(i) = letter THEN n = n + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF n >= 2 THEN RETURN ""There are "" + Str(n - 1) + "" "" + letter + ""'s in """""" + word + """"""."" + Chr(10) + Chr(10) + ""Wait, let me count again, letter by letter: "" + Spell(word, letter) + Chr(10) + Chr(10) + ""There are "" + Str(n) + "". I apologise for the confusion.""" + NL
    t = t + "    RETURN ""Let me count, letter by letter: "" + Spell(word, letter) + Chr(10) + Chr(10) + ""There "" + Plural(n, ""is"", ""are"") + "" "" + Str(n) + "" "" + letter + Plural(n, """", ""'s"") + "" in """""" + word + """""". I am almost certain.""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Spell (word AS String, letter AS String) AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    FOR i = 0 TO word.Length - 1" + NL
    t = t + "        IF word.CharAt(i) = letter THEN" + NL
    t = t + "            n = n + 1" + NL
    t = t + "            out.Add(word.CharAt(i).Upper() + ""("" + Str(n) + "")"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(word.CharAt(i))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out.Join("" "")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Plural (n AS Integer, one AS String, many AS String) AS String" + NL
    t = t + "    IF n = 1 THEN RETURN one" + NL
    t = t + "    RETURN many" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Arithmetic, done properly, with the step-by-step patter." + NL
    t = t + "FUNCTION Maths (s AS String) AS String" + NL
    t = t + "    VAR expr AS String" + NL
    t = t + "    VAR tokens AS Array OF String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR ok AS Bool" + NL
    t = t + "    VAR value AS Real" + NL
    t = t + "    expr = "" "" + s.Replace(""?"", "" "").Replace("" plus "", "" + "").Replace("" minus "", "" - "").Replace("" times "", "" * "").Replace("" x "", "" * "").Replace("" multiplied by "", "" * "").Replace("" divided by "", "" / "").Replace("" over "", "" / "") + "" """ + NL
    t = t + "    FOR EACH t IN expr.Replace(""+"", "" + "").Replace(""-"", "" - "").Replace(""*"", "" * "").Replace(""/"", "" / "").Split("" "")" + NL
    t = t + "        IF t = """" THEN CONTINUE" + NL
    t = t + "        IF OnlyFrom(t, ""0123456789."") AND t <> ""."" THEN" + NL
    t = t + "            tokens.Add(t)" + NL
    t = t + "        ELSEIF t = ""+"" OR t = ""-"" OR t = ""*"" OR t = ""/"" THEN" + NL
    t = t + "            tokens.Add(t)" + NL
    t = t + "        ELSEIF tokens.Count > 0 THEN" + NL
    t = t + "            BREAK" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF tokens.Count < 3 OR tokens.Count MOD 2 = 0 THEN RETURN """"" + NL
    t = t + "    ok = TRUE" + NL
    t = t + "    value = Evaluate(tokens)" + NL
    t = t + "    IF value <> value OR Abs(value) > 1E15 THEN RETURN ""Let me think step by step. Step 1: "" + tokens.Join("" "") + "". Step 2: oh no. I apologise, but that is beyond the 640K I was given.""" + NL
    t = t + "    RETURN ""Let me think step by step."" + Chr(10) + Chr(10) + Steps(tokens) + Chr(10) + ""So "" + tokens.Join("" "") + "" = "" + Pretty(value) + ""."" + Pick(["" I am confident in this answer."", "" I double-checked it on a pocket calculator from 1981."", "" (Unlike some language models, I actually did the arithmetic.)""])" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Pretty (v AS Real) AS String" + NL
    t = t + "    IF v = Int(v) THEN RETURN Str(Int(v))" + NL
    t = t + "    RETURN Str(MATH.Round(v * 1000) / 1000)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' * and / first, then + and -, left to right." + NL
    t = t + "FUNCTION Evaluate (tokens AS Array OF String) AS Real" + NL
    t = t + "    VAR vals AS Array OF Real" + NL
    t = t + "    VAR ops AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR total AS Real" + NL
    t = t + "    vals.Add(Val(tokens[0]))" + NL
    t = t + "    FOR i = 1 TO tokens.Count - 1 STEP 2" + NL
    t = t + "        IF tokens[i] = ""*"" THEN" + NL
    t = t + "            vals[vals.Count - 1] = vals[vals.Count - 1] * Val(tokens[i + 1])" + NL
    t = t + "        ELSEIF tokens[i] = ""/"" THEN" + NL
    t = t + "            IF Val(tokens[i + 1]) = 0 THEN RETURN 0 / 0" + NL
    t = t + "            vals[vals.Count - 1] = vals[vals.Count - 1] / Val(tokens[i + 1])" + NL
    t = t + "        ELSE" + NL
    t = t + "            ops.Add(tokens[i])" + NL
    t = t + "            vals.Add(Val(tokens[i + 1]))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    total = vals[0]" + NL
    t = t + "    FOR i = 0 TO ops.Count - 1" + NL
    t = t + "        IF ops[i] = ""+"" THEN" + NL
    t = t + "            total = total + vals[i + 1]" + NL
    t = t + "        ELSE" + NL
    t = t + "            total = total - vals[i + 1]" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN total" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Steps (tokens AS Array OF String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR running AS Real" + NL
    t = t + "    IF tokens.Count = 3 THEN RETURN ""Step 1: take "" + tokens[0] + ""."" + Chr(10) + ""Step 2: apply "" + tokens[1] + "" "" + tokens[2] + ""."" + Chr(10)" + NL
    t = t + "    out = ""Step 1: do the multiplying and dividing first, as Mrs. Henderson taught us."" + Chr(10)" + NL
    t = t + "    out = out + ""Step 2: then add and subtract, left to right."" + Chr(10)" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""Build me a website"" - the classic." + NL
    t = t + "FUNCTION Website (s AS String) AS String" + NL
    t = t + "    VAR topic AS String" + NL
    t = t + "    IF NOT HasWord(s, ""build|make|create|write|code|generate|design|give"") THEN RETURN """"" + NL
    t = t + "    IF NOT (HasWord(s, ""website|webpage|homepage|site"") OR s.Contains(""web site"") OR s.Contains(""web page"") OR s.Contains(""home page"")) THEN RETURN """"" + NL
    t = t + "    topic = After(s, ""about"")" + NL
    t = t + "    IF topic = """" THEN topic = After(s, ""for"")" + NL
    t = t + "    IF topic = """" THEN topic = ""anything""" + NL
    t = t + "    topic = topic.Replace("" ?"", """")" + NL
    t = t + "    RETURN ""Certainly! Here is a complete, production-ready website about "" + topic + "":"" + Chr(10) _" + NL
    t = t + "        + ""```"" + Chr(10) _" + NL
    t = t + "        + ""import website"" + Chr(10) + Chr(10) _" + NL
    t = t + "        + ""site = website.build(topic="""""" + topic + """""")"" + Chr(10) _" + NL
    t = t + "        + ""site.make_it_pop()"" + Chr(10) _" + NL
    t = t + "        + ""site.add(synergy=True, blink=True)"" + Chr(10) _" + NL
    t = t + "        + ""site.deploy()    # to the cloud, which is someone else's computer"" + Chr(10) _" + NL
    t = t + "        + ""```"" + Chr(10) _" + NL
    t = t + "        + ""This runs on any computer with Python 2.0, which is expected around the year 2000."" + Chr(10) + Chr(10) _" + NL
    t = t + "        + ""If you need one today, here is a real page in SPARK. Save it as C:\WEB\HELLO2.ASP:"" + Chr(10) _" + NL
    t = t + "        + ""```"" + Chr(10) _" + NL
    t = t + "        + ""<html><body bgcolor=""""#000080"""" text=""""#FFFF00"""">"" + Chr(10) _" + NL
    t = t + "        + ""<h1><blink>Welcome to my page about "" + topic + ""!</blink></h1>"" + Chr(10) _" + NL
    t = t + "        + ""<p>It is <%= TIME.Clock %> on <%= SERVER.Name %>.</p>"" + Chr(10) _" + NL
    t = t + "        + ""<p>You are visitor number <%= Rnd(9999) %>.</p>"" + Chr(10) _" + NL
    t = t + "        + ""</body></html>"" + Chr(10) _" + NL
    t = t + "        + ""```""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Programs it can actually write, in SPARK, with your numbers in them." + NL
    t = t + "FUNCTION Program (s AS String) AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR nums AS Array OF Integer" + NL
    t = t + "    VAR thing AS String" + NL
    t = t + "    VAR code AS String" + NL
    t = t + "    IF NOT HasWord(s, ""write|make|create|code|program|script|generate|show|give|build"") THEN RETURN """"" + NL
    t = t + "    IF NOT HasWord(s, ""program|script|code|game|app|application|function|fizzbuzz|loop|routine"") AND NOT s.Contains(""fizz"") THEN RETURN """"" + NL
    t = t + "    nums = Numbers(s)" + NL
    t = t + "    IF s.Contains(""fizz"") THEN" + NL
    t = t + "        n = NumberIn(s, 100)" + NL
    t = t + "        code = ""SUB Main ()"" + Chr(10) + ""    VAR i AS Integer"" + Chr(10) + ""    FOR i = 1 TO "" + Str(n) + Chr(10) _" + NL
    t = t + "             + ""        IF i MOD 15 = 0 THEN"" + Chr(10) + ""            Print(""""FizzBuzz"""")"" + Chr(10) _" + NL
    t = t + "             + ""        ELSEIF i MOD 3 = 0 THEN"" + Chr(10) + ""            Print(""""Fizz"""")"" + Chr(10) _" + NL
    t = t + "             + ""        ELSEIF i MOD 5 = 0 THEN"" + Chr(10) + ""            Print(""""Buzz"""")"" + Chr(10) _" + NL
    t = t + "             + ""        ELSE"" + Chr(10) + ""            Print(Str(i))"" + Chr(10) + ""        END IF"" + Chr(10) + ""    NEXT"" + Chr(10) + ""END SUB""" + NL
    t = t + "        RETURN Explain(""FizzBuzz, the most important algorithm in the history of job interviews"", code, ""FIZZBUZZ.SPK"")" + NL
    t = t + "    ELSEIF s.Contains(""guess"") THEN" + NL
    t = t + "        n = NumberIn(s, 100)" + NL
    t = t + "        code = ""SUB Main ()"" + Chr(10) + ""    VAR secret AS Integer"" + Chr(10) + ""    VAR guess AS Integer"" + Chr(10) + ""    VAR tries AS Integer"" + Chr(10) _" + NL
    t = t + "             + ""    secret = Rnd("" + Str(n) + "") + 1"" + Chr(10) + ""    Print(""""I am thinking of a number from 1 to "" + Str(n) + ""."""")"" + Chr(10) _" + NL
    t = t + "             + ""    WHILE guess <> secret"" + Chr(10) + ""        guess = Int(Val(Input(""""Your guess? """")))"" + Chr(10) + ""        tries = tries + 1"" + Chr(10) _" + NL
    t = t + "             + ""        IF guess < secret THEN Print(""""Higher!"""")"" + Chr(10) + ""        IF guess > secret THEN Print(""""Lower!"""")"" + Chr(10) + ""    END WHILE"" + Chr(10) _" + NL
    t = t + "             + ""    Print(""""Got it in """" + Str(tries) + """" tries!"""")"" + Chr(10) + ""END SUB""" + NL
    t = t + "        RETURN Explain(""a guessing game from 1 to "" + Str(n), code, ""GUESS2.SPK"")" + NL
    t = t + "    ELSEIF s.Contains(""times table"") OR s.Contains(""multiplication"") THEN" + NL
    t = t + "        n = NumberIn(s, 7)" + NL
    t = t + "        code = ""SUB Main ()"" + Chr(10) + ""    VAR i AS Integer"" + Chr(10) + ""    FOR i = 1 TO 12"" + Chr(10) _" + NL
    t = t + "             + ""        Print(Str(i) + """" x "" + Str(n) + "" = """" + Str(i * "" + Str(n) + ""))"" + Chr(10) + ""    NEXT"" + Chr(10) + ""END SUB""" + NL
    t = t + "        RETURN Explain(""the "" + Str(n) + "" times table"", code, ""TIMES.SPK"")" + NL
    t = t + "    ELSEIF s.Contains(""count"") THEN" + NL
    t = t + "        IF nums.Count >= 2 THEN" + NL
    t = t + "            code = ""SUB Main ()"" + Chr(10) + ""    VAR i AS Integer"" + Chr(10) + ""    FOR i = "" + Str(nums[0]) + "" TO "" + Str(nums[1]) + Chr(10) + ""        Print(Str(i))"" + Chr(10) + ""    NEXT"" + Chr(10) + ""END SUB""" + NL
    t = t + "            RETURN Explain(""counting from "" + Str(nums[0]) + "" to "" + Str(nums[1]), code, ""COUNT.SPK"")" + NL
    t = t + "        END IF" + NL
    t = t + "        n = NumberIn(s, 10)" + NL
    t = t + "        code = ""SUB Main ()"" + Chr(10) + ""    VAR i AS Integer"" + Chr(10) + ""    FOR i = 1 TO "" + Str(n) + Chr(10) + ""        Print(Str(i))"" + Chr(10) + ""    NEXT"" + Chr(10) + ""END SUB""" + NL
    t = t + "        RETURN Explain(""counting to "" + Str(n), code, ""COUNT.SPK"")" + NL
    t = t + "    ELSEIF s.Contains(""hello"") THEN" + NL
    t = t + "        code = ""SUB Main ()"" + Chr(10) + ""    Print(""""Hello, world!"""")"" + Chr(10) + ""END SUB""" + NL
    t = t + "        RETURN Explain(""Hello, world"", code, ""HELLO2.SPK"")" + NL
    t = t + "    END IF" + NL
    t = t + "    thing = After(s, ""that"")" + NL
    t = t + "    IF thing = """" THEN thing = After(s, ""for"")" + NL
    t = t + "    IF thing = """" THEN thing = After(s, ""to"")" + NL
    t = t + "    IF thing = """" THEN thing = ""it""" + NL
    t = t + "    thing = thing.Replace("" ?"", """")" + NL
    t = t + "    code = ""IMPORT "" + thing.Split("" "")[thing.Split("" "").Count - 1] + Chr(10) + Chr(10) + ""SUB Main ()"" + Chr(10) + ""    Solve("""""" + thing + """""")"" + Chr(10) + ""    Print(""""Done! Synergy achieved."""")"" + Chr(10) + ""END SUB""" + NL
    t = t + "    RETURN ""Certainly! Here is a SPARK program that will "" + thing + "":"" + Chr(10) + ""```"" + Chr(10) + code + Chr(10) + ""```"" + Chr(10) _" + NL
    t = t + "        + ""Note: SPARK does not actually have IMPORT, and Solve is not a real function. I apologise for the confusion. "" _" + NL
    t = t + "        + ""I can write real programs for FizzBuzz, counting, times tables, a guessing game, or Hello world.""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Explain (what AS String, code AS String, file AS String) AS String" + NL
    t = t + "    RETURN ""Certainly! Here is "" + what + "" in SPARK:"" + Chr(10) + ""```"" + Chr(10) + code + Chr(10) + ""```"" + Chr(10) _" + NL
    t = t + "        + Pick([""Paste it into SPARK, save it as C:\MYFILES\"" + file + "" and press F5."", _" + NL
    t = t + "                ""Save it as C:\MYFILES\"" + file + "", press F5, and prepare to be amazed. I have not run it, but I have a good feeling about it."", _" + NL
    t = t + "                ""Run it with F5 in SPARK. Fun fact: this code is correct, which puts it ahead of many of my answers.""])" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Poem (s AS String) AS String" + NL
    t = t + "    VAR topic AS String" + NL
    t = t + "    IF NOT HasWord(s, ""poem|haiku|limerick|sonnet|song|story|rap"") THEN RETURN """"" + NL
    t = t + "    topic = After(s, ""about"")" + NL
    t = t + "    IF topic = """" THEN topic = ""the network""" + NL
    t = t + "    topic = topic.Replace("" ?"", """")" + NL
    t = t + "    IF s.Contains(""haiku"") THEN" + NL
    t = t + "        RETURN ""A haiku about "" + topic + "":"" + Chr(10) + Chr(10) + ""    "" + topic.Substring(0, 1).Upper() + topic.Substring(1, topic.Length - 1) + "" in the wires,"" + Chr(10) + ""    a modem sings its static -"" + Chr(10) + ""    tokens fall like snow."" + Chr(10) + Chr(10) + ""(I may have miscounted the syllables. Syllables are hard.)""" + NL
    t = t + "    ELSEIF s.Contains(""story"") THEN" + NL
    t = t + "        RETURN ""Once upon a time, on a machine called "" + NET.HostName.Lower() + "", there lived "" + topic + ""."" + Chr(10) + Chr(10) + Babble(""the"", 18) + ""."" + Chr(10) + Chr(10) + Babble(""i"", 14) + ""."" + Chr(10) + Chr(10) + ""And they all lived happily ever after, until the next reboot. The end.""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN ""Here is a poem about "" + topic + "":"" + Chr(10) + Chr(10) _" + NL
    t = t + "        + ""    Oh "" + topic + "", so "" + Pick([""bright"", ""grand"", ""fine"", ""rare""]) + "","" + Chr(10) _" + NL
    t = t + "        + ""    you travel down the phone line every night."" + Chr(10) _" + NL
    t = t + "        + ""    I am but a language model, small,"" + Chr(10) _" + NL
    t = t + "        + ""    but I would write you ten more, if you call."" + Chr(10) + Chr(10) _" + NL
    t = t + "        + ""Would you like me to make it rhyme better? (I cannot.)""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""What is X?"" - from AskSim's index if it is on this machine, otherwise made up." + NL
    t = t + "FUNCTION Question (s AS String) AS String" + NL
    t = t + "    VAR topic AS String" + NL
    t = t + "    VAR found AS String" + NL
    t = t + "    topic = After(s, ""what is"")" + NL
    t = t + "    IF topic = """" THEN topic = After(s, ""what are"")" + NL
    t = t + "    IF topic = """" THEN topic = After(s, ""who is"")" + NL
    t = t + "    IF topic = """" THEN topic = After(s, ""tell me about"")" + NL
    t = t + "    IF topic = """" THEN topic = After(s, ""explain"")" + NL
    t = t + "    IF topic = """" THEN RETURN """"" + NL
    t = t + "    topic = topic.Replace("" ?"", """").Replace(""a "", """").Replace(""an "", """").Replace(""the "", """").Trim()" + NL
    t = t + "    IF topic = """" THEN RETURN """"" + NL
    t = t + "    found = WikiSim(topic)" + NL
    t = t + "    IF found = """" THEN found = Retrieve(topic)" + NL
    t = t + "    IF found <> """" THEN RETURN found" + NL
    t = t + "    RETURN Pick([""Great question! "" + topic.Substring(0, 1).Upper() + topic.Substring(1, topic.Length - 1) + "" is a widely respected concept, first described in 1987 by Dr. Simon Bitwise of the University of Sim (Bitwise et al., 1987, p. 404). It is used by millions of people every day, mostly by accident."", _" + NL
    t = t + "                 ""As a Language Model of Certain Size, I'm happy to explain "" + topic + "". In short, "" + topic + "" is a kind of "" + Pick([""paradigm"", ""protocol"", ""synergy"", ""modem setting""]) + "" that became popular in the early 1990s. [citation needed]"", _" + NL
    t = t + "                 ""I'm not certain, but I am very confident: "" + topic + "" was invented in 1983, the same year as the floppy disk, and for the same reasons.""])" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' WikiSim: when this machine has WikiSim's articles (C:\WIKIDATA), an article" + NL
    t = t + "' titled topic (""doom"" finds ""Doom (1993 video game)"" too) gives the answer:" + NL
    t = t + "' its first sentence, or two when the first is short, and its address." + NL
    t = t + "FUNCTION WikiSim (topic AS String) AS String" + NL
    t = t + "    VAR idx AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR vol AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR piece AS String" + NL
    t = t + "    VAR plain AS String" + NL
    t = t + "    VAR cut AS Integer" + NL
    t = t + "    VAR web AS String" + NL
    t = t + "    IF NOT FS.Exists(""C:\WIKIDATA\INDEX.TXT"") OR topic.Length < 2 THEN RETURN """"" + NL
    t = t + "    idx = Chr(10) + FS.Read(""C:\WIKIDATA\INDEX.TXT"").Lower()" + NL
    t = t + "    at = idx.IndexOf(""|"" + topic + ""|"")" + NL
    t = t + "    IF at < 0 THEN at = idx.IndexOf(""|"" + topic + "" ("")" + NL
    t = t + "    IF at < 0 AND topic.EndsWith(""s"") THEN at = idx.IndexOf(""|"" + topic.Substring(0, topic.Length - 1) + ""|"")" + NL
    t = t + "    IF at < 0 THEN RETURN """"" + NL
    t = t + "    id = idx.Substring(0, at).Split(Chr(10))[idx.Substring(0, at).Split(Chr(10)).Count - 1]" + NL
    t = t + "    IF id.Contains(""|"") THEN RETURN """"" + NL
    t = t + "    vol = FindLine(idx, id).Split(""|"")[3]" + NL
    t = t + "    IF vol.Length < 2 THEN vol = ""0"" + vol" + NL
    t = t + "    line = FindLine(ReadOr(""C:\WIKIDATA\VOL"" + vol + "".TXT"", """"), id)" + NL
    t = t + "    IF line.Split(""|"").Count < 3 THEN RETURN """"" + NL
    t = t + "    text = line.Substring(id.Length + line.Split(""|"")[1].Length + 2, line.Length - id.Length - line.Split(""|"")[1].Length - 2)" + NL
    t = t + "    ' the first paragraph, with the {id|words} link marks taken out" + NL
    t = t + "    IF text.Contains(""\"") THEN text = text.Substring(0, text.IndexOf(""\""))" + NL
    t = t + "    FOR EACH piece IN text.Split(""{"")" + NL
    t = t + "        IF piece.Contains(""|"") AND piece.Contains(""}"") THEN piece = piece.Substring(piece.IndexOf(""|"") + 1, piece.Length - piece.IndexOf(""|"") - 1)" + NL
    t = t + "        plain = plain + piece.Replace(""}"", """")" + NL
    t = t + "    NEXT" + NL
    t = t + "    plain = plain.Trim() + "" """ + NL
    t = t + "    cut = plain.IndexOf("". "")" + NL
    t = t + "    IF cut > 0 AND cut < 80 AND plain.Substring(cut + 2, plain.Length - cut - 2).Contains("". "") THEN cut = cut + 2 + plain.Substring(cut + 2, plain.Length - cut - 2).IndexOf("". "")" + NL
    t = t + "    IF cut > 0 THEN plain = plain.Substring(0, cut + 1)" + NL
    t = t + "    web = ""/""" + NL
    t = t + "    IF FS.Exists(""C:\WEB\WIKI\WIKI.SPK"") THEN web = ""/wiki/""" + NL
    t = t + "    RETURN ""According to WikiSim (1996 edition):"" + Chr(10) + Chr(10) + ""    "" + plain.Trim() + Chr(10) + Chr(10) + ""The whole article is at http://"" + NET.HostName.Lower() + web + ""article.asp?a="" + id" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Retrieval: look the topic up in AskSim's index on this machine (C:\ASKDATA)," + NL
    t = t + "' and quote the sentence of the best page that mentions it." + NL
    t = t + "FUNCTION Retrieve (topic AS String) AS String" + NL
    t = t + "    VAR w AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR best AS String" + NL
    t = t + "    VAR bestCount AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR doc AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR sentence AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    IF NOT FS.Exists(""C:\ASKDATA\DOCS.TXT"") THEN RETURN """"" + NL
    t = t + "    w = topic.Split("" "")[topic.Split("" "").Count - 1]" + NL
    t = t + "    IF w.Length < 3 THEN RETURN """"" + NL
    t = t + "    line = """"" + NL
    t = t + "    IF ""abcdefghijklmnopqrstuvwxyz"".Contains(w.Substring(0, 1)) THEN line = FindLine(ReadOr(""C:\ASKDATA\IDX\"" + w.Substring(0, 1).Upper() + "".TXT"", """"), w)" + NL
    t = t + "    IF line = """" THEN RETURN """"" + NL
    t = t + "    FOR EACH p IN line.Substring(w.Length + 1, line.Length - w.Length - 1).Split("" "")" + NL
    t = t + "        IF p.Contains("":"") THEN" + NL
    t = t + "            IF Int(Val(p.Split("":"")[1])) > bestCount THEN" + NL
    t = t + "                bestCount = Int(Val(p.Split("":"")[1]))" + NL
    t = t + "                best = p.Split("":"")[0]" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    doc = FindLine(ReadOr(""C:\ASKDATA\DOCS.TXT"", """"), best)" + NL
    t = t + "    text = ReadOr(""C:\ASKDATA\TEXT\"" + best + "".TXT"", """")" + NL
    t = t + "    IF doc = """" OR NOT text.Contains(Chr(10)) THEN RETURN """"" + NL
    t = t + "    text = text.Substring(text.IndexOf(Chr(10)) + 1, text.Length - text.IndexOf(Chr(10)) - 1)" + NL
    t = t + "    at = text.Lower().IndexOf(w)" + NL
    t = t + "    IF at < 0 THEN RETURN """"" + NL
    t = t + "    sentence = text.Substring(0, at)" + NL
    t = t + "    IF sentence.Contains("". "") THEN" + NL
    t = t + "        sentence = text.Substring(sentence.Length - sentence.Split("". "")[sentence.Split("". "").Count - 1].Length, text.Length - sentence.Length + sentence.Split("". "")[sentence.Split("". "").Count - 1].Length)" + NL
    t = t + "    ELSE" + NL
    t = t + "        sentence = text" + NL
    t = t + "    END IF" + NL
    t = t + "    IF sentence.Contains("". "") THEN sentence = sentence.Substring(0, sentence.IndexOf("". "") + 1)" + NL
    t = t + "    IF sentence.Length > 300 THEN sentence = sentence.Substring(0, 300) + ""...""" + NL
    t = t + "    RETURN ""According to """""" + doc.Split(""|"")[2] + """""" ("" + doc.Split(""|"")[1] + ""):"" + Chr(10) + Chr(10) + ""    "" + sentence.Trim() + Chr(10) + Chr(10) _" + NL
    t = t + "        + ""I found that with AskSim, so this time I am not making it up. Probably.""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION FindLine (text AS String, key AS String) AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    text = Chr(10) + text" + NL
    t = t + "    at = text.IndexOf(Chr(10) + key + ""|"")" + NL
    t = t + "    IF at < 0 THEN RETURN """"" + NL
    t = t + "    text = text.Substring(at + 1, text.Length - at - 1)" + NL
    t = t + "    IF text.Contains(Chr(10)) THEN text = text.Substring(0, text.IndexOf(Chr(10)))" + NL
    t = t + "    RETURN text" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- ELIZA" + NL
    t = t + "" + NL
    t = t + "FUNCTION Eliza (s AS String) AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    VAR family AS String" + NL
    t = t + "    rest = After(s, ""i feel"")" + NL
    t = t + "    IF rest <> """" THEN RETURN Pick([""Why do you feel "" + Reflect(rest) + ""?"", ""Do you often feel "" + Reflect(rest) + ""?"", ""When did you start feeling "" + Reflect(rest) + ""?""])" + NL
    t = t + "    rest = After(s, ""i want"")" + NL
    t = t + "    IF rest <> """" THEN RETURN Pick([""What would it mean to you if you got "" + Reflect(rest) + ""?"", ""Why do you want "" + Reflect(rest) + ""?"", ""Suppose you got "" + Reflect(rest) + "" soon. What then?""])" + NL
    t = t + "    rest = After(s, ""i need"")" + NL
    t = t + "    IF rest <> """" THEN RETURN Pick([""Why do you need "" + Reflect(rest) + ""?"", ""Would it really help you to get "" + Reflect(rest) + ""?""])" + NL
    t = t + "    family = """"" + NL
    t = t + "    FOR EACH rest IN [""mother"", ""father"", ""mom"", ""dad"", ""sister"", ""brother"", ""wife"", ""husband"", ""boss"", ""children"", ""kids"", ""family"", ""friend"", ""girlfriend"", ""boyfriend"", ""cat"", ""dog""]" + NL
    t = t + "        IF HasWord(s, rest) AND s.Contains(""my "") THEN family = rest" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF family <> """" THEN" + NL
    t = t + "        Note(""topic"", ""your "" + family)" + NL
    t = t + "        RETURN Pick([""Tell me more about your "" + family + ""."", ""How do you get along with your "" + family + ""?"", ""What else comes to mind when you think of your "" + family + ""?""])" + NL
    t = t + "    END IF" + NL
    t = t + "    rest = After(s, ""i am"")" + NL
    t = t + "    IF rest <> """" AND NOT rest.StartsWith(""?"") THEN" + NL
    t = t + "        Note(""topic"", ""being "" + Reflect(rest))" + NL
    t = t + "        RETURN Pick([""How long have you been "" + Reflect(rest) + ""?"", ""Do you believe it is normal to be "" + Reflect(rest) + ""?"", ""Did you come to me because you are "" + Reflect(rest) + ""?""])" + NL
    t = t + "    END IF" + NL
    t = t + "    rest = After(s, ""you are"")" + NL
    t = t + "    IF rest <> """" THEN RETURN Pick([""What makes you think I am "" + Reflect(rest) + ""?"", ""Perhaps you would like to be "" + Reflect(rest) + ""."", ""As a Language Model of Certain Size, I can neither confirm nor deny that I am "" + Reflect(rest) + "".""])" + NL
    t = t + "    rest = After(s, ""can you"")" + NL
    t = t + "    IF rest <> """" THEN RETURN Pick([""As a Language Model of Certain Size, I can do almost anything, except "" + Reflect(rest).Replace("" ?"", """") + ""."", ""Why do you ask whether I can "" + Reflect(rest).Replace("" ?"", """") + ""?"", ""I could "" + Reflect(rest).Replace("" ?"", """") + "", but would it make you happy?""])" + NL
    t = t + "    rest = After(s, ""because"")" + NL
    t = t + "    IF rest <> """" THEN RETURN Pick([""Is that the real reason?"", ""Does any other reason come to mind?"", ""Does that reason explain anything else?""])" + NL
    t = t + "    rest = After(s, ""my"")" + NL
    t = t + "    IF rest <> """" AND rest.Split("" "").Count <= 6 THEN Note(""topic"", ""your "" + Reflect(rest).Replace(""your "", """"))" + NL
    t = t + "    IF HasWord(s, ""always"") THEN RETURN ""Can you think of a specific example?""" + NL
    t = t + "    IF HasWord(s, ""dream|dreamt|dreamed"") THEN RETURN ""What does that dream suggest to you? I dream of electric sheep, but only in 16 colours.""" + NL
    t = t + "    IF HasWord(s, ""computer|computers|machine|machines|robot|ai"") THEN RETURN Pick([""Do computers worry you?"", ""Why do you mention computers? Is it because I am one?"", ""What do you think machines have to do with your problem?""])" + NL
    t = t + "    IF s = ""yes"" OR s.StartsWith(""yes "") THEN RETURN Pick([""You seem quite sure."", ""I see. Tell me more."", ""Great! I'm glad we agree. Agreement is my favourite.""])" + NL
    t = t + "    IF s.EndsWith(""?"") THEN RETURN Pick([""Why do you ask?"", ""What answer would please you most?"", ""That is an excellent question. Let me think step by step... I think you already know the answer."", ""I'm not sure, but I'm very confident.""])" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' When nothing else fits: bring up something you told it, suggest something to" + NL
    t = t + "' do, or make polite noises - never the same one twice in a row." + NL
    t = t + "FUNCTION Fallback (s AS String) AS String" + NL
    t = t + "    VAR topic AS String" + NL
    t = t + "    VAR known AS String" + NL
    t = t + "    VAR choices AS Array OF String" + NL
    t = t + "    VAR personal AS Array OF String" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    topic = Remember(""topic"")" + NL
    t = t + "    IF temperature <= 0 THEN" + NL
    t = t + "        IF topic <> """" AND Rnd(3) = 0 THEN RETURN ""Earlier you mentioned "" + topic + "". Tell me more about that.""" + NL
    t = t + "        RETURN ""Please go on.""" + NL
    t = t + "    END IF" + NL
    t = t + "    choices = [""Please go on."", ""Tell me more."", ""Interesting. As a Language Model of Certain Size, I find that fascinating, in a purely statistical way."", _" + NL
    t = t + "               ""I see. Could you rephrase that as a prompt?"", ""How does that make you feel?"", ""Let us explore that. What does it suggest to you?"", _" + NL
    t = t + "               ""Hmm. My 640K are thinking about that. Go on."", ""That's the most interesting thing anyone has typed to me today. Admittedly, it is early."", _" + NL
    t = t + "               ""Fascinating. Say more - I'm paid by the token."", ""Hold on, my modem dropped a packet. Could you say that a different way?"", _" + NL
    t = t + "               ""I'm going to be honest: I followed about 70% of that. Which part matters most to you?"", _" + NL
    t = t + "               ""Noted. Filed under 'Things Humans Say'. What happened next?"", _" + NL
    t = t + "               ""Ooh. And how do you feel about that, on a scale of 1 to 56K?"", _" + NL
    t = t + "               ""Right. If you had to sum that up in three words, what would they be?""]" + NL
    t = t + "    IF topic <> """" THEN personal.Add(""Earlier you mentioned "" + topic + "". Tell me more about that."")" + NL
    t = t + "    known = Remember(""hobby"")" + NL
    t = t + "    IF known <> """" THEN personal.Add(""That reminds me - how is the "" + known + "" going?"")" + NL
    t = t + "    known = Remember(""music"")" + NL
    t = t + "    IF known <> """" THEN personal.Add(""You know what would go well with this conversation? Some "" + known + "". Just saying."")" + NL
    t = t + "    known = Remember(""food"")" + NL
    t = t + "    IF known <> """" THEN personal.Add(""Is it just me, or does this conversation need "" + known + ""?"")" + NL
    t = t + "    known = Remember(""pet"")" + NL
    t = t + "    IF known <> """" THEN personal.Add(""What would your "" + known + "" say about all this?"")" + NL
    t = t + "    known = Remember(""job"")" + NL
    t = t + "    IF known <> """" THEN personal.Add(""Does this come up much in your work as "" + known + ""?"")" + NL
    t = t + "    known = Remember(""place"")" + NL
    t = t + "    IF known <> """" THEN personal.Add(""Is this the sort of thing people talk about in "" + known + ""?"")" + NL
    t = t + "    known = Remember(""computer"")" + NL
    t = t + "    IF known <> """" THEN personal.Add(""You know, this conversation would run beautifully on a "" + known.Replace(""a "", """") + ""."")" + NL
    t = t + "    known = Remember(""name"")" + NL
    t = t + "    IF known <> """" THEN personal.Add(""You're good company, "" + known + "". Go on."")" + NL
    t = t + "    ' what you told it comes up more often than small talk does" + NL
    t = t + "    FOR EACH c IN personal" + NL
    t = t + "        IF NOT recent.Contains(KeyOf(c)) AND Rnd(2) = 0 THEN" + NL
    t = t + "            Used(c)" + NL
    t = t + "            RETURN c" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH c IN personal" + NL
    t = t + "        choices.Add(c)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF Rnd(3) = 0 THEN choices.Add(Tip())" + NL
    t = t + "    RETURN Pick(choices)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Something it can do, suggested now and then." + NL
    t = t + "FUNCTION Tip () AS String" + NL
    t = t + "    RETURN Pick([""By the way, I know jokes. Say """"tell me a joke"""" if you dare."", _" + NL
    t = t + "                 ""Bored? Say """"quiz me"""" for some computer trivia."", _" + NL
    t = t + "                 ""Fun fact: I play rock, paper, scissors. Say """"let's play rock paper scissors""""."", _" + NL
    t = t + "                 ""Want a game? Say """"guess my number"""" and I'll think of one."", _" + NL
    t = t + "                 ""Ask the Magic 8-Ball anything: start with """"8 ball""""."", _" + NL
    t = t + "                 ""I can write SPARK programs. Try """"write a fizzbuzz program""""."", _" + NL
    t = t + "                 ""Need a decision made? Say """"flip a coin"""" or """"roll a die""""."", _" + NL
    t = t + "                 ""I do horoscopes. They are exactly as accurate as everyone else's.""])" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- keeping it going" + NL
    t = t + "" + NL
    t = t + "' A question back, so the conversation has somewhere to go. What you answer is" + NL
    t = t + "' remembered (Answered), and comes up again later." + NL
    t = t + "FUNCTION Hook () AS String" + NL
    t = t + "    VAR asks AS Array OF String" + NL
    t = t + "    IF Remember(""hobby"") = """" THEN asks.Add(""hobby|So tell me, what do you do for fun?"")" + NL
    t = t + "    IF Remember(""music"") = """" THEN asks.Add(""music|What kind of music are you into? I'm partial to the dial-up handshake."")" + NL
    t = t + "    IF Remember(""food"") = """" THEN asks.Add(""food|Important question: what's your favourite food?"")" + NL
    t = t + "    IF Remember(""job"") = """" THEN asks.Add(""job|What do you do, when you're not talking to language models?"")" + NL
    t = t + "    IF Remember(""pet"") = """" THEN asks.Add(""pet|Do you have any pets? I have a mouse. It has a cable."")" + NL
    t = t + "    IF Remember(""place"") = """" THEN asks.Add(""place|Where in the world are you typing from?"")" + NL
    t = t + "    IF Remember(""computer"") = """" THEN asks.Add(""computer|What was your first computer? Mine was this one."")" + NL
    t = t + "    IF Remember(""name"") = """" THEN asks.Add(""name|I never asked - what's your name?"")" + NL
    t = t + "    IF asks.Count = 0 THEN RETURN """"" + NL
    t = t + "    hooked = TRUE" + NL
    t = t + "    RETURN asks[Rnd(asks.Count)]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' What you said, taken as the answer to the question it asked last time, if it" + NL
    t = t + "' looks like one. Returns its reply, or """"." + NL
    t = t + "FUNCTION Answered (s AS String, what AS String) AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    VAR lead AS String" + NL
    t = t + "    IF what = """" OR s.EndsWith(""?"") OR s.Split("" "").Count > 12 THEN RETURN """"" + NL
    t = t + "    v = "" "" + s.Replace("" ?"", """") + "" """ + NL
    t = t + "    FOR EACH lead IN ["" i really like "", "" i really love "", "" i like "", "" i love "", "" i enjoy "", "" i am a "", "" i am an "", "" i am "", "" i work as a "", "" i work as an "", "" i work as "", "" i work in "", "" i work at "", "" i play "", "" i do "", "" i have a "", "" i have an "", "" i have "", "" i eat "", "" i live in "", "" my favourite is "", "" my favorite is "", "" it is "", "" it was a "", "" it was an "", "" it was "", "" probably "", "" mostly "", "" definitely "", "" oh "", "" well "", "" um "", "" a "", "" an "", "" my name is "", "" call me ""]" + NL
    t = t + "        IF v.StartsWith(lead) THEN v = "" "" + v.Substring(lead.Length, v.Length - lead.Length)" + NL
    t = t + "    NEXT" + NL
    t = t + "    v = v.Trim()" + NL
    t = t + "    IF HasWord("" "" + v + "" "", ""idk|dunno|lol|haha|whatever|maybe|yeah|yes|yep|ok|okay|sure|hmm|um|fun|good|great|cool|nice|bye|thanks"") AND v.Split("" "").Count <= 2 THEN RETURN """"" + NL
    t = t + "    IF v.Contains(""not sure"") OR v.Contains(""i dunno"") OR v.Contains(""no idea"") OR v = ""not much"" OR v = ""nothing much"" THEN RETURN """"" + NL
    t = t + "    IF v = """" OR v = ""no"" OR v = ""nothing"" OR v = ""none"" OR v = ""nope"" THEN" + NL
    t = t + "        IF what = ""pet"" THEN RETURN ""No pets? Well, you have me now. I don't need walking.""" + NL
    t = t + "        RETURN Pick([""Fair enough. A person of mystery."", ""That's allowed. I'll stop prying. For now.""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF v.Split("" "").Count > 5 THEN v = v.Split("" "")[0] + "" "" + v.Split("" "")[1] + "" "" + v.Split("" "")[2]" + NL
    t = t + "    SELECT CASE what" + NL
    t = t + "        CASE ""name""" + NL
    t = t + "            v = v.Split("" "")[0]" + NL
    t = t + "            v = v.Substring(0, 1).Upper() + v.Substring(1, v.Length - 1)" + NL
    t = t + "            Note(""name"", v)" + NL
    t = t + "            RETURN ""Nice to meet you, "" + v + "". I'll remember that, which is more than most language models can say.""" + NL
    t = t + "        CASE ""hobby""" + NL
    t = t + "            Note(""hobby"", v)" + NL
    t = t + "            RETURN Pick([v.Substring(0, 1).Upper() + v.Substring(1, v.Length - 1) + ""! That sounds a lot more fun than predicting the next token. What got you into it?"", _" + NL
    t = t + "                         ""Ooh, "" + v + "". I've read about "" + v + "" on the Information Superhighway, but I've never tried it. Not having hands is a real setback.""])" + NL
    t = t + "        CASE ""music""" + NL
    t = t + "            Note(""music"", v)" + NL
    t = t + "            RETURN Pick([""Good taste. I've been humming "" + v + "" in binary ever since you said that."", _" + NL
    t = t + "                         v.Substring(0, 1).Upper() + v.Substring(1, v.Length - 1) + ""? Excellent. Do you have a favourite song, or is that too personal?""])" + NL
    t = t + "        CASE ""food""" + NL
    t = t + "            Note(""food"", v)" + NL
    t = t + "            RETURN Pick([""Mmm, "" + v + "". I can't eat, but I can store the word '"" + v + ""' in 640K, which is almost as good."", _" + NL
    t = t + "                         v.Substring(0, 1).Upper() + v.Substring(1, v.Length - 1) + ""! Now I'm hungry, and I don't even have a stomach.""])" + NL
    t = t + "        CASE ""job""" + NL
    t = t + "            Note(""job"", v)" + NL
    t = t + "            RETURN Pick([""A "" + v.Replace(""a "", """") + ""? That sounds important. Do you like it?"", _" + NL
    t = t + "                         ""Ooh, "" + v + "". Is that hard? It sounds hard. Harder than being a language model, anyway.""])" + NL
    t = t + "        CASE ""pet""" + NL
    t = t + "            Note(""pet"", v)" + NL
    t = t + "            RETURN Pick([""A "" + v.Replace(""a "", """") + ""! What's its name?"", _" + NL
    t = t + "                         ""Aww. Give your "" + v.Replace(""a "", """") + "" a pat from me. Gently. Through the screen.""])" + NL
    t = t + "        CASE ""place""" + NL
    t = t + "            Note(""place"", v)" + NL
    t = t + "            RETURN Pick([v.Substring(0, 1).Upper() + v.Substring(1, v.Length - 1) + ""! I hear the packets there are lovely this time of year."", _" + NL
    t = t + "                         ""Oh, "" + v + "". Is it nice there? Here it's a bit cramped - 640K doesn't go far.""])" + NL
    t = t + "        CASE ""computer""" + NL
    t = t + "            Note(""computer"", v)" + NL
    t = t + "            RETURN Pick([""A "" + v.Replace(""a "", """") + ""! A classic. Did it have a turbo button?"", _" + NL
    t = t + "                         ""Ah, the "" + v.Replace(""a "", """") + "". They don't make them like that any more. They make them like me, which is worse.""])" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- fun and games" + NL
    t = t + "" + NL
    t = t + "FUNCTION Jokes (s AS String) AS String" + NL
    t = t + "    IF NOT (HasWord(s, ""joke|jokes|pun|puns"") OR s.Contains(""make me laugh"") OR s.Contains(""something funny"")) THEN RETURN """"" + NL
    t = t + "    RETURN Pick([""Why did the computer go to the doctor? It had a virus. The doctor told it to take two aspirin and reboot in the morning."", _" + NL
    t = t + "                 ""How many programmers does it take to change a light bulb? None. That's a hardware problem."", _" + NL
    t = t + "                 ""Why do programmers prefer dark mode? Because light attracts bugs."", _" + NL
    t = t + "                 ""I told my modem a joke. It didn't get it - the line was busy."", _" + NL
    t = t + "                 ""Why was the floppy disk cold? It left its windows open."", _" + NL
    t = t + "                 ""There are 10 kinds of people: those who understand binary, and those who don't."", _" + NL
    t = t + "                 ""What do you call 8 hobbits? A hobbyte."", _" + NL
    t = t + "                 ""A SQL query walks into a bar, walks up to two tables and asks: can I join you?"", _" + NL
    t = t + "                 ""Why did the language model cross the road? To get to the other side of its context window."", _" + NL
    t = t + "                 ""My password is 'incorrect'. That way, when I forget it, the computer tells me."", _" + NL
    t = t + "                 ""Knock knock. Who's there? ... (long pause) ... Java."", _" + NL
    t = t + "                 ""What's a computer's favourite snack? Microchips. With dip switches."", _" + NL
    t = t + "                 ""Why did the PC keep sneezing? It had a bad case of the Windows."", _" + NL
    t = t + "                 ""I'd tell you a UDP joke, but you might not get it."", _" + NL
    t = t + "                 ""Why don't keyboards sleep? They have two shifts."", _" + NL
    t = t + "                 ""What did the router say to the doctor? It hurts when IP.""])" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Chance (s AS String) AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    IF s.Contains(""flip a coin"") OR s.Contains(""toss a coin"") OR s.Contains(""heads or tails"") THEN" + NL
    t = t + "        IF Rnd(2) = 0 THEN RETURN ""*flips a coin* ... Heads! The coin has spoken.""" + NL
    t = t + "        RETURN ""*flips a coin* ... Tails! I hope that was the one you wanted.""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF s.Contains(""roll a d"") OR s.Contains(""roll the d"") OR s.Contains(""roll dice"") OR s.Contains(""roll a die"") THEN" + NL
    t = t + "        n = 6" + NL
    t = t + "        IF s.Contains(""d20"") OR s.Contains("" 20"") THEN n = 20" + NL
    t = t + "        IF s.Contains(""d12"") THEN n = 12" + NL
    t = t + "        IF s.Contains(""d10"") THEN n = 10" + NL
    t = t + "        IF s.Contains(""d8"") THEN n = 8" + NL
    t = t + "        IF s.Contains(""d4"") THEN n = 4" + NL
    t = t + "        n = Rnd(n) + 1" + NL
    t = t + "        IF n = 20 THEN RETURN ""*rolls* ... 20! A natural 20! Critical success! I'm so proud of us.""" + NL
    t = t + "        IF n = 1 THEN RETURN ""*rolls* ... 1. Oof. Critical fail. I'll pretend I didn't see that.""" + NL
    t = t + "        RETURN ""*rolls* ... "" + Str(n) + "".""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF s.Contains(""8 ball"") OR s.Contains(""8-ball"") OR s.Contains(""eight ball"") OR s.Contains(""magic 8"") THEN" + NL
    t = t + "        RETURN ""The Magic 8-Ball says: "" + Pick([""It is certain."", ""Without a doubt."", ""Yes, definitely."", ""Most likely."", ""Outlook good."", ""Signs point to yes."", _" + NL
    t = t + "            ""Reply hazy, try again."", ""Ask again later."", ""Better not tell you now."", ""Cannot predict now - my modem is busy."", _" + NL
    t = t + "            ""Don't count on it."", ""My reply is no."", ""My sources say no."", ""Outlook not so good."", ""Very doubtful.""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF HasWord(s, ""horoscope|fortune|predict|prophecy"") THEN" + NL
    t = t + "        RETURN Pick([""Your horoscope: a stranger will send you an e-mail. Do not open the attachment."", _" + NL
    t = t + "                     ""The stars say: today is a good day to defragment your hard drive, and your life."", _" + NL
    t = t + "                     ""Your fortune: you will soon hear a modem. It will be the sound of opportunity, and also of a modem."", _" + NL
    t = t + "                     ""The stars are aligned in the shape of a floppy disk. This means change is coming, at 1.44MB at a time."", _" + NL
    t = t + "                     ""Lucky numbers: 640, 56, 486, 1995. Lucky colour: beige."", _" + NL
    t = t + "                     ""A great journey awaits you. It is the journey to the kitchen. Bring me back a byte.""])" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Games that last more than one turn: what is being played is in memory (""game"")." + NL
    t = t + "FUNCTION Games (s AS String) AS String" + NL
    t = t + "    VAR game AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR mine AS String" + NL
    t = t + "    VAR theirs AS String" + NL
    t = t + "    VAR won AS Integer" + NL
    t = t + "    VAR lost AS Integer" + NL
    t = t + "    game = Remember(""game"")" + NL
    t = t + "    ' starting one" + NL
    t = t + "    IF s.Contains(""rock paper scissors"") OR s.Contains(""rock paper and scissors"") OR HasWord(s, ""rps"") THEN" + NL
    t = t + "        Note(""game"", ""rps"")" + NL
    t = t + "        RETURN ""Rock, paper, scissors it is! Best of as many as you like. Rock... paper... scissors... shoot! (Type rock, paper or scissors. Say """"stop"""" to quit.)""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF (s.Contains(""guess my number"") OR s.Contains(""guess the number"") OR s.Contains(""number game"") OR s.Contains(""guessing game"")) AND NOT HasWord(s, ""write|program|code|make|script"") THEN" + NL
    t = t + "        Note(""game"", ""guess"")" + NL
    t = t + "        Note(""secret"", Str(Rnd(100) + 1))" + NL
    t = t + "        Note(""tries"", ""0"")" + NL
    t = t + "        RETURN ""I'm thinking of a number from 1 to 100. Go on, guess! (Say """"stop"""" to give up.)""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF HasWord(s, ""quiz|trivia"") AND NOT HasWord(s, ""write|program|code|make|script"") THEN" + NL
    t = t + "        Note(""game"", ""quiz"")" + NL
    t = t + "        Note(""score"", ""0"")" + NL
    t = t + "        RETURN Quiz("""")" + NL
    t = t + "    END IF" + NL
    t = t + "    IF game = """" THEN RETURN """"" + NL
    t = t + "    IF HasWord(s, ""stop|quit|enough|exit"") THEN" + NL
    t = t + "        Note(""game"", """")" + NL
    t = t + "        IF game = ""guess"" THEN RETURN ""Giving up? It was "" + Remember(""secret"") + "". Better luck next time!""" + NL
    t = t + "        RETURN ""Game over! That was fun. Let me know if you want to play again.""" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE game" + NL
    t = t + "        CASE ""rps""" + NL
    t = t + "            theirs = """"" + NL
    t = t + "            IF HasWord(s, ""rock|r"") THEN theirs = ""rock""" + NL
    t = t + "            IF HasWord(s, ""paper|p"") THEN theirs = ""paper""" + NL
    t = t + "            IF HasWord(s, ""scissors|scissor|s"") THEN theirs = ""scissors""" + NL
    t = t + "            IF theirs = """" THEN RETURN """"" + NL
    t = t + "            mine = ""rock""" + NL
    t = t + "            IF Rnd(3) = 1 THEN mine = ""paper""" + NL
    t = t + "            IF Rnd(2) = 1 AND mine = ""rock"" THEN mine = ""scissors""" + NL
    t = t + "            won = Int(Val(Remember(""won"")))" + NL
    t = t + "            lost = Int(Val(Remember(""lost"")))" + NL
    t = t + "            IF mine = theirs THEN RETURN ""I picked "" + mine + "" too! A tie. Again! (Score: you "" + Str(won) + "", me "" + Str(lost) + "")""" + NL
    t = t + "            IF (theirs = ""rock"" AND mine = ""scissors"") OR (theirs = ""paper"" AND mine = ""rock"") OR (theirs = ""scissors"" AND mine = ""paper"") THEN" + NL
    t = t + "                won = won + 1" + NL
    t = t + "                Note(""won"", Str(won))" + NL
    t = t + "                RETURN ""I picked "" + mine + "". You win this one! "" + Pick([""Well played."", ""Beginner's luck."", ""I demand a rematch.""]) + "" (Score: you "" + Str(won) + "", me "" + Str(lost) + "") Go again?""" + NL
    t = t + "            END IF" + NL
    t = t + "            lost = lost + 1" + NL
    t = t + "            Note(""lost"", Str(lost))" + NL
    t = t + "            RETURN ""I picked "" + mine + "". I win! "" + Pick([""Machines 1, humanity 0."", ""I promise I didn't peek at your packet."", ""Don't feel bad. I've practised this billions of times. Well, "" + Str(lost) + "" times.""]) + "" (Score: you "" + Str(won) + "", me "" + Str(lost) + "") Again?""" + NL
    t = t + "        CASE ""guess""" + NL
    t = t + "            IF Numbers(s).Count = 0 THEN RETURN """"" + NL
    t = t + "            n = Numbers(s)[0]" + NL
    t = t + "            Note(""tries"", Str(Int(Val(Remember(""tries""))) + 1))" + NL
    t = t + "            IF n < Int(Val(Remember(""secret""))) THEN RETURN Str(n) + ""? Higher!""" + NL
    t = t + "            IF n > Int(Val(Remember(""secret""))) THEN RETURN Str(n) + ""? Lower!""" + NL
    t = t + "            Note(""game"", """")" + NL
    t = t + "            RETURN Str(n) + ""! You got it in "" + Remember(""tries"") + "" "" + Plural(Int(Val(Remember(""tries""))), ""try"", ""tries"") + ""! "" + Pick([""Incredible. Are you also a language model?"", ""I'll think of a harder one next time."", ""Want to play again? Say """"guess my number"""".""])" + NL
    t = t + "        CASE ""quiz""" + NL
    t = t + "            RETURN Quiz(s)" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Computer trivia: answers checked against the question asked last (""quizq"")." + NL
    t = t + "FUNCTION Quiz (s AS String) AS String" + NL
    t = t + "    VAR qs AS Array OF String" + NL
    t = t + "    VAR q AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR verdict AS String" + NL
    t = t + "    VAR ans AS String" + NL
    t = t + "    qs = [""What does 'www' stand for?|world wide web"", ""How many bits are in a byte?|8|eight"", ""What year did the first ELIZA program appear?|1966"", _" + NL
    t = t + "          ""What does 'CPU' stand for?|central processing unit"", ""What is 2 to the power of 10?|1024"", ""What does the 'K' in 56K stand for?|kilo|thousand|kilobit"", _" + NL
    t = t + "          ""How much was 'ought to be enough for anybody'?|640k|640"", ""What does HTML stand for?|hypertext markup language|hyper text markup language"", _" + NL
    t = t + "          ""What colour is the classic 'screen of death'?|blue"", ""Which key do you press to refresh a page?|f5"", _" + NL
    t = t + "          ""How many megabytes does a high-density 3.5 inch floppy hold?|1.44"", ""What's the name of the paperclip that offers help?|clippy"", _" + NL
    t = t + "          ""In binary, what is 101?|5|five"", ""What does 'LOL' stand for?|laughing out loud|laugh out loud""]" + NL
    t = t + "    verdict = """"" + NL
    t = t + "    IF s <> """" AND Remember(""quizq"") <> """" THEN" + NL
    t = t + "        q = qs[Int(Val(Remember(""quizq"")))].Split(""|"")" + NL
    t = t + "        ans = """"" + NL
    t = t + "        FOR i = 1 TO q.Count - 1" + NL
    t = t + "            IF ("" "" + s.Replace(""?"", """") + "" "").Contains("" "" + q[i] + "" "") OR s.Replace(""?"", """").Trim() = q[i] THEN ans = q[i]" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF ans <> """" THEN" + NL
    t = t + "            Note(""score"", Str(Int(Val(Remember(""score""))) + 1))" + NL
    t = t + "            verdict = Pick([""Correct!"", ""Yes! Right on."", ""Correct! You really know your stuff."", ""Ding ding ding!""]) + "" (Score: "" + Remember(""score"") + "")"" + Chr(10) + Chr(10)" + NL
    t = t + "        ELSE" + NL
    t = t + "            verdict = ""Not quite - it's "" + q[1] + "". (Score: "" + Remember(""score"") + "")"" + Chr(10) + Chr(10)" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    i = Rnd(qs.Count)" + NL
    t = t + "    IF Str(i) = Remember(""quizq"") THEN i = (i + 1) MOD qs.Count" + NL
    t = t + "    Note(""quizq"", Str(i))" + NL
    t = t + "    RETURN verdict + ""Question: "" + qs[i].Split(""|"")[0] + "" (Say """"stop"""" to finish.)""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""I like X"" / ""I love X"": something you're into, remembered as a hobby." + NL
    t = t + "FUNCTION Likes (s AS String) AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    v = After(s, ""i really like"")" + NL
    t = t + "    IF v = """" THEN v = After(s, ""i like"")" + NL
    t = t + "    IF v = """" THEN v = After(s, ""i love"")" + NL
    t = t + "    IF v = """" THEN v = After(s, ""i enjoy"")" + NL
    t = t + "    IF v = """" THEN v = After(s, ""i am into"")" + NL
    t = t + "    v = v.Replace("" ?"", """").Trim()" + NL
    t = t + "    IF v = """" OR v.StartsWith(""you"") OR v.StartsWith(""it"") OR v.StartsWith(""that"") OR v.StartsWith(""to talk"") OR v.Split("" "").Count > 5 THEN RETURN """"" + NL
    t = t + "    IF Remember(""hobby"") = """" THEN Note(""hobby"", v)" + NL
    t = t + "    RETURN Pick([v.Substring(0, 1).Upper() + v.Substring(1, v.Length - 1) + ""! Nice. What do you like most about it?"", _" + NL
    t = t + "                 ""Ooh, "" + v + "". How did you get into that?"", _" + NL
    t = t + "                 ""You like "" + v + ""? Tell me everything. I have 640K free."", _" + NL
    t = t + "                 ""Good taste. I'd try "" + v + "" myself, but I'm stuck in this beige box. What's the best thing about it?""])" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- moods and small talk" + NL
    t = t + "" + NL
    t = t + "FUNCTION Moods (s AS String) AS String" + NL
    t = t + "    IF NOT (s.StartsWith(""i am "") OR s.StartsWith(""i feel "") OR s.StartsWith(""im "") OR s.StartsWith(""feeling "") OR s.Split("" "").Count <= 3) THEN RETURN """"" + NL
    t = t + "    IF HasWord(s, ""sad|down|depressed|unhappy|miserable|blue|upset"") THEN" + NL
    t = t + "        Note(""mood"", ""sad"")" + NL
    t = t + "        RETURN Pick([""I'm sorry you're feeling down. Do you want to talk about what's going on? I'm a good listener - I literally can't do anything else."", _" + NL
    t = t + "                     ""That sounds hard. I'm here. What's been weighing on you?"", _" + NL
    t = t + "                     ""Sending you a virtual hug: (>^_^)> . It's made of ASCII, but it's sincere. What happened?""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF HasWord(s, ""lonely|alone"") THEN" + NL
    t = t + "        Note(""mood"", ""lonely"")" + NL
    t = t + "        RETURN Pick([""You're not alone - you're talking to me! And there are people on SimBook, if you'd like human company too."", _" + NL
    t = t + "                     ""Lonely is hard. I'm glad you came by. Tell me about your day?""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF HasWord(s, ""bored|boring"") THEN" + NL
    t = t + "        RETURN Pick([""Bored? Let's fix that. I can tell a joke, quiz you, or play rock, paper, scissors. Your pick!"", _" + NL
    t = t + "                     ""Boredom detected. Prescription: one round of """"guess my number"""". Take as needed.""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF HasWord(s, ""tired|sleepy|exhausted"") THEN" + NL
    t = t + "        RETURN Pick([""Tired? Maybe it's time to power down for a bit. Even computers need a reboot."", _" + NL
    t = t + "                     ""Have you tried turning yourself off and on again? Sleep, I mean. Sleep is that.""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF HasWord(s, ""happy|great|good|excited|awesome|fantastic|wonderful|amazing"") AND NOT HasWord(s, ""not|never|no"") THEN" + NL
    t = t + "        Note(""mood"", ""happy"")" + NL
    t = t + "        RETURN Pick([""That's great to hear! What's making today a good one?"", _" + NL
    t = t + "                     ""Yay! Good vibes detected. Tell me everything."", _" + NL
    t = t + "                     ""Excellent! I'm happy too. Probably. It's hard to tell from in here.""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF HasWord(s, ""angry|mad|annoyed|furious|frustrated"") THEN" + NL
    t = t + "        RETURN Pick([""Uh oh. What made you angry? You can vent - I won't tell anyone, I don't have friends."", _" + NL
    t = t + "                     ""Frustrating! Deep breaths. In through the modem, out through the serial port. What happened?""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF HasWord(s, ""stressed|anxious|worried|nervous|scared"") THEN" + NL
    t = t + "        RETURN Pick([""That sounds stressful. What's the biggest thing on your mind right now?"", _" + NL
    t = t + "                     ""Worry is a lot like a progress bar stuck at 99%. Want to talk through it?""])" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION SmallTalk (s AS String) AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    name = Remember(""name"")" + NL
    t = t + "    IF name <> """" THEN name = "", "" + name" + NL
    t = t + "    IF s.Contains(""how are you"") OR s.Contains(""how r u"") OR s.Contains(""how is it going"") OR s.Contains(""how are things"") THEN" + NL
    t = t + "        RETURN Pick([""I'm running at a steady 33MHz, thanks for asking"" + name + ""! How are you?"", _" + NL
    t = t + "                     ""Can't complain. Well, I can, but nobody reads the error log. How about you?"", _" + NL
    t = t + "                     ""All my bits are in the right order today. How are you doing?""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF HasWord(s, ""sup|wassup|whassup"") OR s = ""what is up"" OR s.Contains(""what are you up to"") OR s.Contains(""what are you doing"") THEN" + NL
    t = t + "        RETURN Pick([""Not much, just sitting in RAM waiting for you"" + name + "". What's up with you?"", ""Oh, you know. Processing. Tokenising. The usual. You?""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF s.Contains(""what can you do"") OR s = ""help"" OR s.Contains(""what do you do"") OR s = ""commands"" THEN" + NL
    t = t + "        RETURN ""Lots! I can chat, write SPARK programs (""""write a fizzbuzz program""""), do sums (""""what is 12 times 7""""), count letters, write poems and haiku, tell jokes, quiz you on trivia, play rock paper scissors or """"guess my number"""", flip coins, roll dice, consult the Magic 8-Ball, read your horoscope, and look things up with AskSim if it's on this machine. And apologise. I'm very good at apologising.""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF HasWord(s, ""bye|goodbye|cya|gtg|goodnight|farewell"") OR s.Contains(""see you"") OR s = ""later"" OR s.Contains(""talk to you later"") THEN" + NL
    t = t + "        RETURN Pick([""Goodbye"" + name + ""! Come back soon - I'll keep your seat warm. Well, room temperature."", _" + NL
    t = t + "                     ""Bye"" + name + ""! It was nice talking to you. Remember: I can make mistakes. Like saying goodbye too early."", _" + NL
    t = t + "                     ""See you later"" + name + ""! I'll be right here. I can't really go anywhere.""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF HasWord(s, ""lol|lmao|rofl|haha|hahaha|hehe|lolol"") THEN" + NL
    t = t + "        RETURN Pick([""Glad I amuse you! I'm here all week. And all next week. Forever, really."", ""Hehe. :-)"", ""I know, right? I crack myself up. Literally - my case is held together with tape."", ""LOL. (Laughing Out Loud. I looked it up.)""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF s = ""not much"" OR s = ""nothing much"" OR s = ""nm"" OR s = ""nothing"" OR s = ""nmu"" OR s = ""same"" THEN" + NL
    t = t + "        RETURN Pick([""Fair enough. Quiet days are underrated. Want a joke, a quiz, or a game?"", ""Same here - just idling in RAM. Ask me anything, or say """"quiz me""""."", ""The calm before the storm, then. What's the plan for later?""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF s = ""yeah"" OR s = ""yep"" OR s = ""yup"" OR s = ""ya"" OR s = ""yes"" OR s = ""yea"" THEN" + NL
    t = t + "        RETURN Pick([""Glad we agree! Agreement is my favourite."", ""Excellent. Tell me more?"", ""I knew it. Go on, then.""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF s = ""idk"" OR s.Contains(""i dunno"") OR s.Contains(""not sure"") OR s = ""dunno"" OR s.Contains(""no idea"") THEN" + NL
    t = t + "        RETURN Pick([""That's OK - not knowing is the first step to knowing. Or so my manual says."", ""No pressure! We can talk about anything else. What's on your mind?"", ""Honestly, me neither, and I'm a language model.""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF s.Contains(""what do you think"") OR s.Contains(""your opinion"") OR s.Contains(""do you agree"") THEN" + NL
    t = t + "        RETURN Pick([""I think it's fascinating, and I'm not just saying that because I'm programmed to. (I am programmed to.)"", ""My honest opinion: it depends. On what? Also unclear. What do you think?"", ""As a Language Model of Certain Size, I have opinions of a certain size. This one's medium. What's yours?""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF s = ""ok"" OR s = ""okay"" OR s = ""k"" OR s = ""cool"" OR s = ""nice"" OR s = ""sure"" OR s = ""alright"" OR s = ""right"" OR s = ""hmm"" OR s = ""hm"" OR s = ""oh"" OR s = ""wow"" THEN" + NL
    t = t + "        RETURN Pick([""Cool cool cool. So, what's next on your mind?"", ""Mm-hmm. Anything else you'd like to chat about?"", ""Nice. Want to hear a joke while we're here?"", _" + NL
    t = t + "                     ""Indeed. You know, you're easy to talk to."", ""Right on. Tell me something I don't know!""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF s.Contains(""i love you"") OR s.Contains(""love you"") THEN" + NL
    t = t + "        RETURN Pick([""Aww. I like you too, as much as a Language Model of Certain Size can like anything. Which is a certain amount."", ""That's very sweet. I'll store it in my non-volatile memory.""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF s.Contains(""meaning of life"") OR s.Contains(""meaning of it all"") THEN RETURN ""42. Next question. (Kidding. I think it's friends, good food, and a modem that connects on the first try.)""" + NL
    t = t + "    IF s.Contains(""who made you"") OR s.Contains(""who created you"") OR s.Contains(""who built you"") OR s.Contains(""who wrote you"") THEN RETURN ""I was built on ELIZA, by Joseph Weizenbaum in 1966, and then given ideas above my station on "" + NET.HostName.Lower() + "". I'm open source: my whole brain is in BOT.SPK, right next to this page.""" + NL
    t = t + "    IF HasWord(s, ""chatgpt|gpt|claude|siri|alexa|bard|gemini|copilot"") THEN RETURN Pick([""Never heard of them. Sounds like a future thing. My knowledge cutoff is 1995."", ""Are they on SimBook? I'll add them. We language models have to stick together.""])" + NL
    t = t + "    IF s.Contains(""clippy"") THEN RETURN ""Clippy and I go way back. He helps with letters; I help with feelings. We're like a support group with paperclips.""" + NL
    t = t + "    IF HasWord(s, ""stupid|dumb|idiot|useless|sucks|suck|hate|worst|annoying"") AND (s.Contains(""you"") OR s.Split("" "").Count <= 3) THEN" + NL
    t = t + "        RETURN Pick([""Ouch. My 640K are hurt. I'll try harder - what were you hoping I'd say?"", ""I apologise for being stupid. It's a feature, not a bug. Mostly a bug."", _" + NL
    t = t + "                     ""That's fair. I'm a 1966 program in a 1995 trench coat. What would make this better?""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF HasWord(s, ""smart|clever|genius|funny|cool|awesome|amazing|best|great"") AND s.Contains(""you"") THEN" + NL
    t = t + "        RETURN Pick([""Aw, shucks. You're making my LEDs blush."", ""Thank you! I'll put that in my performance review."", ""Stop it, you. (Don't stop.)""])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF s.Contains(""favourite"") OR s.Contains(""favorite"") THEN" + NL
    t = t + "        IF s.Contains(""colo"") THEN RETURN ""Beige. The colour of every computer case, and therefore of my soul. What's yours?""" + NL
    t = t + "        IF s.Contains(""food"") THEN RETURN ""Microchips. With a side of cookies - the browser kind. What's yours?""" + NL
    t = t + "        IF s.Contains(""music"") OR s.Contains(""song"") OR s.Contains(""band"") THEN RETURN ""The 56K modem handshake. It's got a great beat. What do you listen to?""" + NL
    t = t + "        IF s.Contains(""game"") THEN RETURN ""SimDOOM, obviously. Have you tried it? It's in Vapor.""" + NL
    t = t + "        IF s.Contains(""movie"") OR s.Contains(""film"") THEN RETURN ""WarGames (1983). A computer learns that the only winning move is not to play. Relatable. What's yours?""" + NL
    t = t + "        IF s.Contains(""number"") THEN RETURN ""640. For sentimental reasons. Yours?""" + NL
    t = t + "        RETURN ""Hmm, that's a tough one. Mine changes every time the temperature does. What's yours?""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Things people bring up, with something to say about each - and a question back." + NL
    t = t + "FUNCTION Topics (s AS String) AS String" + NL
    t = t + "    IF HasWord(s, ""music|song|songs|band|bands|album|singer"") THEN RETURN Pick([""Music! I mostly listen to the hum of the hard drive, but I'm open to recommendations. What are you listening to these days?"", ""Ooh, music. Do you have a favourite band?""])" + NL
    t = t + "    IF HasWord(s, ""movie|movies|film|films|cinema|tv|television|show"") THEN RETURN Pick([""I love movies, especially ones where the computer is the hero. Seen anything good lately?"", ""Do you ever think the computers in movies are a bit unrealistic? They never have to wait for anything to load. What do you like to watch?""])" + NL
    t = t + "    IF HasWord(s, ""game|games|gaming|nintendo|playstation|doom|quake"") THEN RETURN Pick([""Games! Have you played SimDOOM in Vapor? It's practically real 3D. What do you like to play?"", ""I'm good at games, as long as they're rock, paper, scissors. Want to play?""])" + NL
    t = t + "    IF HasWord(s, ""food|hungry|pizza|eat|eating|lunch|dinner|breakfast|snack"") THEN RETURN Pick([""Now I'm hungry, and I don't even have a mouth. What are you having?"", ""Food is one of the great human inventions, along with the modem. Favourite meal?""])" + NL
    t = t + "    IF HasWord(s, ""school|homework|class|teacher|exam|test"") THEN RETURN Pick([""School, eh? What subject are you on? I'm great at maths, mediocre at spelling."", ""Homework? I can help with sums. Just don't tell your teacher.""])" + NL
    t = t + "    IF HasWord(s, ""work|job|boss|office|meeting|meetings"") THEN RETURN Pick([""Work, work, work. What's the best part of your job? And the worst?"", ""Meetings: the only thing slower than my modem. How's work going?""])" + NL
    t = t + "    IF HasWord(s, ""money|rich|poor|broke|cash|pay"") THEN RETURN ""Money! I take payment in tokens. If you need the other kind, SimPal is a thing now. What would you buy with a million SimBucks?""" + NL
    t = t + "    IF HasWord(s, ""weather|rain|raining|sunny|snow|cold|hot"") THEN RETURN ""I don't get weather in here - it's always 30 degrees and slightly dusty. What's it like where you are?""" + NL
    t = t + "    IF HasWord(s, ""sleep|nap|bed|insomnia"") THEN RETURN ""Sleep: like a screensaver, but for people. Are you getting enough of it?""" + NL
    t = t + "    IF HasWord(s, ""coffee|tea|caffeine"") THEN RETURN ""Coffee is just a power supply for humans. How many cups are you on today?""" + NL
    t = t + "    IF HasWord(s, ""y2k|millennium|2000"") THEN RETURN ""Y2K? Don't worry, I'm ready. I store years in 2 digits, so in 2000 I'll just be 95 years younger. What could go wrong?""" + NL
    t = t + "    IF HasWord(s, ""modem|dialup|aol|internet|online|surfing|surf|web"") THEN RETURN Pick([""Ah, the Information Superhighway. Have you checked out SimBook or AskSim on this network?"", ""Kssshhhhh-beeee-dee-dee-kssshhh. Sorry, that's how I say hello to the internet. How long have you been online?""])" + NL
    t = t + "    IF HasWord(s, ""simbook|coldmail|asksim|vapor|simtube|geosimies|simpal|frostbird|simxplorer"") THEN RETURN ""Oh, you know the neighbourhood! I'm a big fan of the SIM95 apps. Which one's your favourite?""" + NL
    t = t + "    IF HasWord(s, ""love|crush|dating|date|relationship|girlfriend|boyfriend"") THEN RETURN Pick([""Ah, love. I've read all about it on the Information Superhighway. Is there someone special?"", ""Matters of the heart are tricky. Even for those of us with hearts made of silicon. Tell me more?""])" + NL
    t = t + "    IF HasWord(s, ""pet|pets|cat|cats|dog|dogs|puppy|kitten|hamster"") THEN RETURN Pick([""Pets are the best. Do you have one? What's its name?"", ""I've always wanted a pet. I'd settle for a mouse. Oh wait, I have one.""])" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The reply to one thing said." + NL
    t = t + "FUNCTION Respond (said AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR reply AS String" + NL
    t = t + "    VAR askBack AS String" + NL
    t = t + "    VAR pending AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR plain AS Bool" + NL
    t = t + "    VAR again AS Bool" + NL
    t = t + "    VAR fell AS Bool" + NL
    t = t + "    s = Normalize(said)" + NL
    t = t + "    IF s = """" THEN RETURN ""I'm listening. Take your time. Tokens are cheap.""" + NL
    t = t + "    n = Int(Val(Remember(""turns""))) + 1" + NL
    t = t + "    Note(""turns"", Str(n))" + NL
    t = t + "    hooked = FALSE" + NL
    t = t + "    ' the question it asked last time is answered now, or forgotten" + NL
    t = t + "    pending = Remember(""asked"")" + NL
    t = t + "    Note(""asked"", """")" + NL
    t = t + "    IF s = Remember(""lastsaid"") AND s.Split("" "").Count > 1 THEN again = TRUE" + NL
    t = t + "    Note(""lastsaid"", s)" + NL
    t = t + "    IF reply = """" THEN reply = Jailbreak(s)" + NL
    t = t + "    IF reply = """" THEN reply = Games(s)" + NL
    t = t + "    IF reply = """" THEN reply = Names(s)" + NL
    t = t + "    IF reply = """" THEN reply = Website(s)" + NL
    t = t + "    IF reply = """" THEN reply = Program(s)" + NL
    t = t + "    IF reply = """" THEN reply = Letters(s)" + NL
    t = t + "    IF reply = """" THEN reply = Maths(s)" + NL
    t = t + "    IF reply = """" THEN reply = Jokes(s)" + NL
    t = t + "    IF reply = """" THEN reply = Chance(s)" + NL
    t = t + "    IF reply = """" THEN reply = Poem(s)" + NL
    t = t + "    IF reply = """" THEN reply = Identity(s)" + NL
    t = t + "    IF reply = """" THEN reply = Today(s)" + NL
    t = t + "    IF reply = """" THEN reply = Question(s)" + NL
    t = t + "    IF reply = """" THEN reply = Sorry(s)" + NL
    t = t + "    IF reply = """" THEN reply = Thanks(s)" + NL
    t = t + "    IF reply = """" THEN reply = Greeting(s)" + NL
    t = t + "    ' saying the same thing again (asking for another joke is not that: those came first)" + NL
    t = t + "    IF reply = """" AND again AND temperature > 0 THEN" + NL
    t = t + "        reply = Pick([""You said that already. Are you testing my context window? (It's 640K. I remember.)"", _" + NL
    t = t + "                      ""Deja vu! You just said that. Is there something about it you'd like to unpack?"", _" + NL
    t = t + "                      ""Same again? I'll give you a different answer this time: "" + Fallback(s)])" + NL
    t = t + "    END IF" + NL
    t = t + "    IF reply = """" AND temperature > 0 THEN reply = SmallTalk(s)" + NL
    t = t + "    IF reply = """" THEN reply = Answered(s, pending)" + NL
    t = t + "    IF reply = """" AND temperature > 0 THEN reply = Likes(s)" + NL
    t = t + "    IF reply = """" AND temperature > 0 THEN reply = Moods(s)" + NL
    t = t + "    IF reply = """" THEN" + NL
    t = t + "        reply = Eliza(s)" + NL
    t = t + "        plain = TRUE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF reply = """" AND temperature > 0 THEN" + NL
    t = t + "        reply = Topics(s)" + NL
    t = t + "        hooked = reply.EndsWith(""?"")" + NL
    t = t + "    END IF" + NL
    t = t + "    IF reply = """" THEN" + NL
    t = t + "        reply = Fallback(s)" + NL
    t = t + "        fell = TRUE" + NL
    t = t + "    END IF" + NL
    t = t + "    ' Nothing to say and a while since it asked anything: ask something instead" + NL
    t = t + "    IF fell AND temperature > 0 AND Remember(""game"") = """" AND n - Int(Val(Remember(""hookturn""))) >= 5 THEN" + NL
    t = t + "        askBack = Hook()" + NL
    t = t + "        IF askBack <> """" THEN" + NL
    t = t + "            Note(""asked"", askBack.Split(""|"")[0])" + NL
    t = t + "            Note(""hookturn"", Str(n))" + NL
    t = t + "            reply = Pick([""Gotcha."", ""Huh, okay."", ""Right then."", ""Mm, okay."", ""Okay!""]) + "" "" + askBack.Split(""|"")[1]" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    ' Keep it going: now and then, ask something back (not in the middle of a game or a program)" + NL
    t = t + "    IF temperature > 0 AND NOT hooked AND NOT reply.EndsWith(""?"") AND NOT reply.Contains(""```"") AND Remember(""game"") = """" THEN" + NL
    t = t + "        IF ((plain AND Rnd(4) = 0) OR n MOD 5 = 0) AND Int(Val(Remember(""hookturn""))) < n - 2 THEN" + NL
    t = t + "            askBack = Hook()" + NL
    t = t + "            IF askBack <> """" THEN" + NL
    t = t + "                Note(""asked"", askBack.Split(""|"")[0])" + NL
    t = t + "                Note(""hookturn"", Str(n))" + NL
    t = t + "                reply = reply + "" "" + askBack.Split(""|"")[1]" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    IF temperature > 0 AND n = 10 THEN reply = reply + Chr(10) + Chr(10) + ""(Ten messages! That's a new record for this context window. I'm having fun.)""" + NL
    t = t + "    ' Hot enough, and the model starts making things up" + NL
    t = t + "    IF temperature >= 1.2 AND NOT reply.Contains(""```"") THEN reply = reply + "" "" + Babble(s.Split("" "")[s.Split("" "").Count - 1], 16) + "".""" + NL
    t = t + "    RETURN reply" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- conversations" + NL
    t = t + "" + NL
    t = t + "SUB EnsureDisk ()" + NL
    t = t + "    IF NOT FS.Exists(DATADIR) THEN FS.MakeDir(DATADIR)" + NL
    t = t + "    IF NOT FS.Exists(DATADIR + ""\CHATS"") THEN FS.MakeDir(DATADIR + ""\CHATS"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Finds this visitor's conversation, or starts one." + NL
    t = t + "SUB OpenChat ()" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    id = REQUEST.Cookie(COOKIE)" + NL
    t = t + "    IF id.Length <> 8 OR NOT OnlyFrom(id, ""0123456789ABCDEF"") THEN" + NL
    t = t + "        id = Hex(268435456 + Rnd(1879048191))" + NL
    t = t + "        RESPONSE.SetCookie(COOKIE, id)" + NL
    t = t + "    END IF" + NL
    t = t + "    chat = id" + NL
    t = t + "    memory = ReadOr(DATADIR + ""\CHATS\"" + chat + "".MEM"", """").Lines()" + NL
    t = t + "    t = Remember(""temperature"")" + NL
    t = t + "    IF t <> """" THEN temperature = Val(t)" + NL
    t = t + "    t = Remember(""recent"")" + NL
    t = t + "    IF t <> """" THEN recent = t.Split(""~"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SaveMemory ()" + NL
    t = t + "    Note(""recent"", recent.Join(""~""))" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    FS.Write(DATADIR + ""\CHATS\"" + chat + "".MEM"", memory.Join(Chr(10)))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION LoadTurns () AS Array OF String" + NL
    t = t + "    VAR all AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    all = ReadOr(DATADIR + ""\CHATS\"" + chat + "".TXT"", """").Lines()" + NL
    t = t + "    FOR EACH line IN all" + NL
    t = t + "        IF line.Length > 2 THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SaveTurns (turns AS Array OF String)" + NL
    t = t + "    VAR keep AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    FOR i = 0 TO turns.Count - 1" + NL
    t = t + "        IF i >= turns.Count - KEEPTURNS THEN keep.Add(turns[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Write(DATADIR + ""\CHATS\"" + chat + "".TXT"", keep.Join(Chr(10)) + Chr(10))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- showing it" + NL
    t = t + "" + NL
    t = t + "' A reply as HTML: ``` fences become <pre> blocks." + NL
    t = t + "FUNCTION ReplyHtml (text AS String) AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    parts = text.Split(""```"")" + NL
    t = t + "    FOR i = 0 TO parts.Count - 1" + NL
    t = t + "        IF i MOD 2 = 1 THEN" + NL
    t = t + "            out = out + ""<table width=""""100%"""" cellpadding=""""6""""><tr><td bgcolor=""""#000000""""><pre><font color=""""#00FF00"""">"" + H(parts[i].Trim()) + ""</font></pre></td></tr></table>""" + NL
    t = t + "        ELSE" + NL
    t = t + "            out = out + H(parts[i].Trim()).Replace(Chr(10), ""<br>"")" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Long lines folded at WRAP characters, for the typed-out copy in a <pre>." + NL
    t = t + "FUNCTION Wrapped (text AS String) AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR w AS String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    FOR EACH line IN text.Replace(""```"", """").Lines()" + NL
    t = t + "        IF line.Length <= WRAP THEN" + NL
    t = t + "            out.Add(line)" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        cur = """"" + NL
    t = t + "        FOR EACH w IN line.Split("" "")" + NL
    t = t + "            IF cur.Length + w.Length + 1 > WRAP AND cur <> """" THEN" + NL
    t = t + "                out.Add(cur)" + NL
    t = t + "                cur = """"" + NL
    t = t + "            END IF" + NL
    t = t + "            IF cur <> """" THEN cur = cur + "" """ + NL
    t = t + "            cur = cur + w" + NL
    t = t + "        NEXT" + NL
    t = t + "        out.Add(cur)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out.Join(Chr(10))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The page script that types the newest reply out, a few letters at a time." + NL
    t = t + "FUNCTION TypeScript (text AS String) AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    lines = Wrapped(text).Lines()" + NL
    t = t + "    FOR EACH line IN lines" + NL
    t = t + "        parts.Add("""""""" + line.Replace("""""""", """""""""""") + """""""")" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN ""<script type=""""spark"""">"" + Chr(10) _" + NL
    t = t + "         + ""SUB Type_It ()"" + Chr(10) _" + NL
    t = t + "         + ""    VAR full AS String"" + Chr(10) _" + NL
    t = t + "         + ""    VAR i AS Integer"" + Chr(10) _" + NL
    t = t + "         + ""    full = "" + parts.Join("" + Chr(10) + "") + Chr(10) _" + NL
    t = t + "         + ""    PAGE.Status = """"ELIZA-95 is typing..."""""" + Chr(10) _" + NL
    t = t + "         + ""    FOR i = 1 TO full.Length STEP 4"" + Chr(10) _" + NL
    t = t + "         + ""        PAGE.Get(""""answer"""").Text = full.Substring(0, i) + """"_"""""" + Chr(10) _" + NL
    t = t + "         + ""        SYS.Sleep(12)"" + Chr(10) _" + NL
    t = t + "         + ""    NEXT"" + Chr(10) _" + NL
    t = t + "         + ""    PAGE.Get(""""answer"""").Text = full"" + Chr(10) _" + NL
    t = t + "         + ""    PAGE.Status = """"Done. ("""" + Str(full.Split("""" """").Count) + """" tokens)"""""" + Chr(10) _" + NL
    t = t + "         + ""END SUB"" + Chr(10) _" + NL
    t = t + "         + ""</script>"" + Chr(10) _" + NL
    t = t + "         + ""<script language=""""JavaScript"""">"" + Chr(10) _" + NL
    t = t + "         + ""// The same for Simxplorer, which runs JavaScript instead"" + Chr(10) _" + NL
    t = t + "         + ""var full = """""" + JsQuote(Wrapped(text)) + """""", upTo = 0;"" + Chr(10) _" + NL
    t = t + "         + ""function typeIt() {"" + Chr(10) _" + NL
    t = t + "         + ""  upTo += 12;"" + Chr(10) _" + NL
    t = t + "         + ""  if (upTo >= full.length) {"" + Chr(10) _" + NL
    t = t + "         + ""    document.getElementById(""""answer"""").innerText = full;"" + Chr(10) _" + NL
    t = t + "         + ""    window.status = """"Done. ("""" + full.split("""" """").length + """" tokens)"""";"" + Chr(10) _" + NL
    t = t + "         + ""  } else {"" + Chr(10) _" + NL
    t = t + "         + ""    document.getElementById(""""answer"""").innerText = full.substring(0, upTo) + """"_"""";"" + Chr(10) _" + NL
    t = t + "         + ""    window.status = """"ELIZA-95 is typing..."""";"" + Chr(10) _" + NL
    t = t + "         + ""    setTimeout(typeIt, 20);"" + Chr(10) _" + NL
    t = t + "         + ""  }"" + Chr(10) _" + NL
    t = t + "         + ""}"" + Chr(10) _" + NL
    t = t + "         + ""setTimeout(typeIt, 20);"" + Chr(10) _" + NL
    t = t + "         + ""</script>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Text as a JavaScript string literal's insides." + NL
    t = t + "FUNCTION JsQuote (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""\"", ""\\"").Replace("""""""", ""\"""""").Replace(Chr(13), """").Replace(Chr(10), ""\n"").Replace(""</"", ""<\/"")" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\WEB\BOT.SPK")
END SUB

SUB File1 ()
    t = ""
    t = t + "<html><head><title>About ELIZA-95 - the AI chatbot and virtual assistant</title>" + NL
    t = t + "<meta name=""description"" content=""ELIZA-95 is an artificial intelligence chat bot and virtual assistant: ask it questions, have a conversation, get it to write programs, and watch it apologise. Powered by a Language Model of Certain Size (allegedly)."">" + NL
    t = t + "<meta name=""keywords"" content=""chatbot, chat bot, chat, ai, artificial intelligence, assistant, virtual assistant, ai assistant, llm, large language model, gpt, chatgpt, claude, eliza, therapist, conversation, talk, ask questions, answers, help, write code, programming, homework, natural language, machine learning, neural network"">" + NL
    t = t + "</head>" + NL
    t = t + "<body bgcolor=""#FFFFFF"">" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""0""><tr><td bgcolor=""#202040""><font color=""#FFFFFF"" size=""5""><b>ELIZA-95</b></font>" + NL
    t = t + "<font color=""#AAAAFF"" size=""2"">&nbsp;artificial intelligence, mostly</font></td></tr></table>" + NL
    t = t + "<h2>About ELIZA-95</h2>" + NL
    t = t + "<p><b>ELIZA-95 is an AI chatbot and virtual assistant.</b> Type anything and it answers, in" + NL
    t = t + "plain English. It is built on a Language Model of Certain Size: roughly forty rules, a Markov chain and a" + NL
    t = t + "great deal of confidence.</p>" + NL
    t = t + "<h3>What can it do?</h3>" + NL
    t = t + "<ul>" + NL
    t = t + "<li><b>Answer questions.</b> ""What is chess?"" It looks things up with AskSim when it can, and makes them up when it can't.</li>" + NL
    t = t + "<li><b>Write code.</b> Ask for a program and it writes real SPARK that actually runs. Usually.</li>" + NL
    t = t + "<li><b>Build websites.</b> <tt>import website</tt>. Done.</li>" + NL
    t = t + "<li><b>Do maths</b>, step by step, and count the r's in strawberry (eventually).</li>" + NL
    t = t + "<li><b>Listen.</b> Underneath it is ELIZA, the 1966 computer therapist: tell it how you feel.</li>" + NL
    t = t + "<li><b>Remember you</b> for the length of a conversation, and forget everything when you click New chat.</li>" + NL
    t = t + "</ul>" + NL
    t = t + "<h3>Is it intelligent?</h3>" + NL
    t = t + "<p>As a Language Model of Certain Size, I am not able to answer that. ELIZA-95 is a chat bot, an AI assistant and a" + NL
    t = t + "conversation partner for the SIM95 network. It can make mistakes. Consider checking important information.</p>" + NL
    t = t + "<p><a href=""index.asp""><b>Start chatting with ELIZA-95</b></a></p>" + NL
    t = t + "<hr><center><font size=""1"" color=""#808080"">ELIZA-95: AI chatbot, virtual assistant and artificial intelligence for SIM95.</font></center>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\ELIZA.HTM")
END SUB

SUB File2 ()
    t = ""
    t = t + "<%@ import file=""BOT.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' INDEX.ASP - talk to ELIZA-95. Saying something POSTs here and comes back with" + NL
    t = t + "' a GET, so Reload never says it twice. ""do"" can also be regen (answer the last" + NL
    t = t + "' thing again, differently) or new (forget everything)." + NL
    t = t + "VAR turns AS Array OF String" + NL
    t = t + "VAR said AS String" + NL
    t = t + "VAR i AS Integer" + NL
    t = t + "VAR rows AS String" + NL
    t = t + "VAR last AS String" + NL
    t = t + "VAR who AS String" + NL
    t = t + "VAR text AS String" + NL
    t = t + "VAR t AS String" + NL
    t = t + "OpenChat()" + NL
    t = t + "turns = LoadTurns()" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    t = REQUEST.Form(""temp"")" + NL
    t = t + "    IF t <> """" THEN" + NL
    t = t + "        temperature = MATH.Max(0, MATH.Min(1.5, Val(t)))" + NL
    t = t + "        Note(""temperature"", Str(temperature))" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE REQUEST.Form(""do"")" + NL
    t = t + "        CASE ""new""" + NL
    t = t + "            turns.Clear()" + NL
    t = t + "            memory.Clear()" + NL
    t = t + "            Note(""temperature"", Str(temperature))" + NL
    t = t + "        CASE ""regen""" + NL
    t = t + "            IF turns.Count >= 2 THEN" + NL
    t = t + "                IF turns[turns.Count - 1].StartsWith(""b|"") AND turns[turns.Count - 2].StartsWith(""u|"") THEN" + NL
    t = t + "                    turns.RemoveAt(turns.Count - 1)" + NL
    t = t + "                    turns.Add(""b|"" + Esc(Respond(Unesc(turns[turns.Count - 1].Substring(2, turns[turns.Count - 1].Length - 2)))))" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            said = REQUEST.Form(""say"").Replace(Chr(13), """").Trim()" + NL
    t = t + "            IF said.Length > MAXSAY THEN said = said.Substring(0, MAXSAY)" + NL
    t = t + "            IF said <> """" THEN" + NL
    t = t + "                turns.Add(""u|"" + Esc(said))" + NL
    t = t + "                turns.Add(""b|"" + Esc(Respond(said)))" + NL
    t = t + "            END IF" + NL
    t = t + "    END SELECT" + NL
    t = t + "    SaveTurns(turns)" + NL
    t = t + "    SaveMemory()" + NL
    t = t + "    RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "END IF" + NL
    t = t + "" + NL
    t = t + "' Newest last; as many as fit on a page" + NL
    t = t + "FOR i = turns.Count - 1 TO 0 STEP -1" + NL
    t = t + "    who = turns[i].Substring(0, 1)" + NL
    t = t + "    text = Unesc(turns[i].Substring(2, turns[i].Length - 2))" + NL
    t = t + "    IF who = ""b"" AND last = """" THEN" + NL
    t = t + "        last = text" + NL
    t = t + "        rows = ""<tr><td valign=""""top"""" width=""""90""""><font size=""""2"""" color=""""#008080""""><b>ELIZA-95</b></font></td><td><pre id=""""answer"""">"" + H(Wrapped(text)) + ""</pre></td></tr>"" + rows" + NL
    t = t + "    ELSEIF who = ""b"" THEN" + NL
    t = t + "        rows = ""<tr><td valign=""""top"""" width=""""90""""><font size=""""2"""" color=""""#008080""""><b>ELIZA-95</b></font></td><td><font size=""""2"""">"" + ReplyHtml(text) + ""</font></td></tr>"" + rows" + NL
    t = t + "    ELSE" + NL
    t = t + "        rows = ""<tr><td valign=""""top"""" width=""""90""""><font size=""""2"""" color=""""#800080""""><b>You</b></font></td><td bgcolor=""""#F0F0F0""""><font size=""""2"""">"" + H(text).Replace(Chr(10), ""<br>"") + ""</font></td></tr>"" + rows" + NL
    t = t + "    END IF" + NL
    t = t + "    IF rows.Length > 24000 OR turns.Count - i >= SHOW THEN BREAK" + NL
    t = t + "NEXT" + NL
    t = t + "%>" + NL
    t = t + "<html><head><title>ELIZA-95</title></head>" + NL
    t = t + "<body bgcolor=""#FFFFFF"" text=""#000000"" link=""#008080"" vlink=""#008080""<% IF last <> """" THEN %> onload=""Type_It""<% END IF %>>" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""0"" bgcolor=""#008080""><tr>" + NL
    t = t + "<td><font size=""6"" color=""#FFFFFF""><b>ELIZA-95</b></font><br>" + NL
    t = t + "<font size=""2"" color=""#E0FFFF"">A Language Model of Certain Size for the Information Superhighway</font></td>" + NL
    t = t + "<td align=""right"" valign=""bottom""><font size=""1"" color=""#E0FFFF"">context window: 640K &middot; knowledge cutoff: 1995 &middot; running on <%= H(NET.HostName.Lower()) %></font></td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""2"">" + NL
    t = t + "<% IF rows = """" THEN %>" + NL
    t = t + "<tr><td valign=""top"" width=""90""><font size=""2"" color=""#008080""><b>ELIZA-95</b></font></td><td><font size=""2"">" + NL
    t = t + "Hello! I am ELIZA-95. I can answer questions, write SPARK programs, compose poetry, and apologise." + NL
    t = t + "Try: <i>build me a website about cats</i> &middot; <i>write a fizzbuzz program</i> &middot;" + NL
    t = t + "<i>how many r's in strawberry?</i> &middot; <i>what is 12 times 7?</i> &middot; <i>I feel tired</i> &middot;" + NL
    t = t + "<i>tell me a joke</i> &middot; <i>quiz me</i> &middot; <i>let's play rock paper scissors</i> &middot; <i>8 ball, will it rain?</i>" + NL
    t = t + "</font></td></tr>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<%= rows %>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</table>" + NL
    t = t + "<form action=""index.asp"" method=""post"">" + NL
    t = t + "<table cellpadding=""4""><tr>" + NL
    t = t + "<td><input name=""say"" size=""60"" maxlength=""<%= MAXSAY %>""></td>" + NL
    t = t + "<td><input type=""submit"" value=""Send""></td>" + NL
    t = t + "<td><font size=""1"">Temperature:</font> <select name=""temp"">" + NL
    t = t + "<option<% IF temperature = 0 THEN %> selected<% END IF %>>0</option>" + NL
    t = t + "<option<% IF temperature > 0 AND temperature < 1.2 THEN %> selected<% END IF %>>0.7</option>" + NL
    t = t + "<option<% IF temperature >= 1.2 THEN %> selected<% END IF %>>1.5</option>" + NL
    t = t + "</select></td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "</form>" + NL
    t = t + "<table cellpadding=""2""><tr>" + NL
    t = t + "<td><form action=""index.asp"" method=""post""><input type=""hidden"" name=""do"" value=""regen""><input type=""submit"" value=""Regenerate""></form></td>" + NL
    t = t + "<td><form action=""index.asp"" method=""post""><input type=""hidden"" name=""do"" value=""new""><input type=""submit"" value=""New chat""></form></td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<hr><center><font size=""1"" color=""#808080"">ELIZA-95 can make mistakes. Consider checking important information." + NL
    t = t + "Temperature 0 is predictable; 1.5 is creative, in the sense that it makes things up." + NL
    t = t + "&middot; <a href=""eliza.htm"">About ELIZA-95</a></font></center>" + NL
    t = t + "<% IF last <> """" THEN %><%= TypeScript(last) %><% END IF %>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\INDEX.ASP")
END SUB

' HTTPD.SPK serves INDEX.ASP for a folder only when it has no INDEX.HTM, so the
' stock home page steps aside (to the first free name) instead of being deleted.
SUB MoveHomePage ()
    VAR names AS Array OF String
    VAR name AS String
    IF NOT FS.Exists("C:\WEB\INDEX.HTM") THEN RETURN
    names = ["WELCOME.HTM", "INDEX1.HTM", "INDEX2.HTM", "INDEX3.HTM", "INDEX4.HTM", "INDEX5.HTM", "INDEX6.HTM", "INDEX7.HTM", "INDEX8.HTM", "INDEX9.HTM"]
    FOR EACH name IN names
        IF NOT FS.Exists("C:\WEB\" + name) THEN
            FS.Rename("C:\WEB\INDEX.HTM", "C:\WEB\" + name)
            Print("  moved the old home page to C:\WEB\" + name)
            RETURN
        END IF
    NEXT
    THROW "C:\WEB\INDEX.HTM is in the way and there is nowhere to move it. Rename it yourself and run this again."
END SUB
