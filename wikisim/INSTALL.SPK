' VAPOR|id=WIKISIM|name=WikiSim|kind=web|version=8b760dd8|category=Reference|run=/|files=C:\WEB\ARTICLE.ASP;C:\WEB\INDEX.ASP;C:\WEB\LETTER.ASP;C:\WEB\LICENSE.HTM;C:\WEB\RANDOM.ASP;C:\WEB\SEARCH.ASP;C:\WEB\WIKI.SPK;C:\WEB\WIKISIM.HTM;C:\WIKIDATA\DYK.TXT;C:\WIKIDATA\INDEX.TXT;C:\WIKIDATA\LINKS.TXT;C:\WIKIDATA\VOL01.TXT|tasks=|startup=|folder=WIKI|about=An encyclopedia as of 1996: more than a thousand articles from Wikipedia, with search, A to Z, a random article and an article of the day. Becomes this machine's home page, or on a SimHost machine gets a folder of its own.
' INSTALL.SPK - puts WikiSim on this machine. Generated by tools/build-installer.mjs;
' edit the files in wikisim/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. WikiSim becomes
' this machine's home page: its pages go into C:\WEB (the stock INDEX.HTM moves
' to WELCOME.HTM), and the articles into C:\WIKIDATA. The articles are
' Wikipedia's (CC BY-SA 4.0), cut back to 1996 and edited; see LICENSE.HTM.
' Nothing is ever written to C:\WIKIDATA but by this, so running it again
' just puts a fresh copy there. Then open http://YOURNAME/ in Voyager.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)
    ' On a machine set up for several web apps (SimHost: C:\SYSTEM\WEBAPPS.INI
    ' says mode=folders), this one goes in C:\WEB\WIKI and leaves the home page alone.
    IF FS.Exists("C:\SYSTEM\WEBAPPS.INI") THEN
        IF FS.Read("C:\SYSTEM\WEBAPPS.INI").Contains("mode=folders") THEN intoDir = "WIKI"
    END IF
    IF intoDir <> "" AND NOT FS.Exists("C:\WEB\" + intoDir) THEN FS.MakeDir("C:\WEB\" + intoDir)


    IF intoDir = "" THEN MoveHomePage()
    WikiDirs()
    File0()
    File1()
    File2()
    File3()
    File4()
    File5()
    File6()
    File7()
    File8()
    File9()
    File10()
    File11()
    Print("WikiSim is installed (12 files).")

    IF intoDir = "" THEN
        Print("Open http://" + NET.HostName.Lower() + "/ in Voyager.")
    ELSE
        Print("Open http://" + NET.HostName.Lower() + "/" + intoDir.Lower() + "/ in Voyager.")
    END IF
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "<%@ import file=""WIKI.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' ARTICLE.ASP?a=<id or title> - one article: its text with links to other" + NL
    t = t + "' articles, See also, the articles either side, and where the text came from." + NL
    t = t + "VAR id AS Integer" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR title AS String" + NL
    t = t + "VAR see AS String" + NL
    t = t + "VAR s AS String" + NL
    t = t + "VAR other AS String" + NL
    t = t + "VAR seeHtml AS String" + NL
    t = t + "VAR letter AS String" + NL
    t = t + "id = FindArticle(REQUEST.Query(""a""))" + NL
    t = t + "IF id > 0 THEN line = ArticleLine(id)" + NL
    t = t + "IF line = """" THEN" + NL
    t = t + "    RESPONSE.Status = ""404 Not Found""" + NL
    t = t + "ELSE" + NL
    t = t + "    title = line.Split(""|"")[1]" + NL
    t = t + "    letter = IndexLine(id).Split(""|"")[2]" + NL
    t = t + "    see = LineOf(Chr(10) + ReadOr(DATADIR + ""\LINKS.TXT"", """"), Str(id))" + NL
    t = t + "    IF see.Contains(""|"") THEN" + NL
    t = t + "        FOR EACH s IN see.Split(""|"")[1].Split("" "")" + NL
    t = t + "            IF s = """" THEN CONTINUE" + NL
    t = t + "            other = TitleOf(Int(Val(s)))" + NL
    t = t + "            IF other <> """" THEN seeHtml = seeHtml + ""<li><a href=""""article.asp?a="" + s + """""">"" + H(other) + ""</a>"" + Chr(10)" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "END IF" + NL
    t = t + "%>" + NL
    t = t + "<% IF line = """" THEN %>" + NL
    t = t + "<%= Top(""Not found"") %>" + NL
    t = t + "<% IF articleCount = 0 THEN %>" + NL
    t = t + "<%= NoData() %>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<h2>No such article</h2>" + NL
    t = t + "<p>WikiSim has no article called <b><%= H(REQUEST.Query(""a"")) %></b>. Perhaps it had not happened yet in 1996.</p>" + NL
    t = t + "<form action=""search.asp"" method=""get"">Search for it: <input name=""q"" size=""30"" value=""<%= H(REQUEST.Query(""a"")) %>""> <input type=""submit"" value=""Find""></form>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<%= Top(title) %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<font face=""Times New Roman"" size=""6"" color=""#000040""><b><%= H(title) %></b></font>" + NL
    t = t + "<hr size=""1"" noshade>" + NL
    t = t + "<font size=""2"" color=""#606060""><i>From Wikipedia, the free encyclopedia (text as of 1996, edited) &mdash; <a href=""license.htm"">CC BY-SA 4.0</a>. Original article: &quot;<%= H(title) %>&quot;, http://en.wikipedia.org/wiki/<%= H(title.Replace("" "", ""_"")) %></i></font>" + NL
    t = t + "<%= TextHtml(TextOf(line)) %>" + NL
    t = t + "<% IF seeHtml <> """" THEN %>" + NL
    t = t + "<h3>See also</h3>" + NL
    t = t + "<ul>" + NL
    t = t + "<%= seeHtml %></ul>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<p><table width=""100%"" cellpadding=""4"" cellspacing=""0"" bgcolor=""#E0E0E0""><tr>" + NL
    t = t + "<td width=""40%""><font size=""2""><% IF TitleOf(id - 1) <> """" THEN %><a href=""article.asp?a=<%= id - 1 %>"">&lt;&lt; <%= H(TitleOf(id - 1)) %></a><% END IF %></font></td>" + NL
    t = t + "<td align=""center""><font size=""2""><a href=""letter.asp?l=<%= letter %>"">More under <%= letter %></a></font></td>" + NL
    t = t + "<td width=""40%"" align=""right""><font size=""2""><% IF TitleOf(id + 1) <> """" THEN %><a href=""article.asp?a=<%= id + 1 %>""><%= H(TitleOf(id + 1)) %> &gt;&gt;</a><% END IF %></font></td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\ARTICLE.ASP")
END SUB

SUB File1 ()
    t = ""
    t = t + "<%@ import file=""WIKI.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' INDEX.ASP - the front page: the search box, A to Z, the article of the day," + NL
    t = t + "' ""Did you know?"" and a few doors in." + NL
    t = t + "VAR day AS Integer" + NL
    t = t + "VAR dayText AS String" + NL
    t = t + "VAR dyk AS String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "LoadIndex()" + NL
    t = t + "day = DayArticle()" + NL
    t = t + "IF day > 0 THEN" + NL
    t = t + "    line = ArticleLine(day)" + NL
    t = t + "    IF line <> """" THEN" + NL
    t = t + "        dayText = PlainText(TextOf(line))" + NL
    t = t + "        IF dayText.Length > 300 THEN dayText = dayText.Substring(0, 300) + ""...""" + NL
    t = t + "    END IF" + NL
    t = t + "END IF" + NL
    t = t + "dyk = DidYouKnow()" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Contents"") %>" + NL
    t = t + "<% IF articleCount = 0 THEN %>" + NL
    t = t + "<%= NoData() %>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<table width=""100%"" cellpadding=""10"" cellspacing=""0""><tr><td align=""center"">" + NL
    t = t + "<font face=""Times New Roman"" size=""7"" color=""#000040""><b>WikiSim</b></font><font face=""Times New Roman"" size=""6"" color=""#B8860B""><b> 96</b></font><br>" + NL
    t = t + "<font size=""3"" color=""#404040""><i>The encyclopedia on your computer.</i> <%= articleCount %> articles, all as of 1996.</font>" + NL
    t = t + "<form action=""search.asp"" method=""get""><input name=""q"" size=""40""> <input type=""submit"" value=""Find article""></form>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""6""><tr>" + NL
    t = t + "<td valign=""top"" width=""60%"">" + NL
    t = t + "<%= Box(""Article of the Day"", ""#000080"", ""<font size=""""4""""><b><a href=""""article.asp?a="" + Str(day) + """""">"" + H(TitleOf(day)) + ""</a></b></font><br>"" + H(dayText) + "" <a href=""""article.asp?a="" + Str(day) + """""">More...</a>"") %>" + NL
    t = t + "<p>" + NL
    t = t + "<% IF dyk.Contains(""|"") THEN %>" + NL
    t = t + "<%= Box(""Did you know?"", ""#006060"", ""..."" + H(dyk.Substring(dyk.IndexOf(""|"") + 1, dyk.Length - dyk.IndexOf(""|"") - 1)) + "" <font size=""""2"""">(<a href=""""article.asp?a="" + dyk.Split(""|"")[0] + """""">"" + H(TitleOf(Int(Val(dyk.Split(""|"")[0])))) + ""</a>)</font>"") %>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</td>" + NL
    t = t + "<td valign=""top"">" + NL
    t = t + "<%= Box(""Explore"", ""#800000"", ""<font size=""""3""""><a href=""""random.asp""""><b>Random article</b></a><br>Open the encyclopedia at any page.<p><a href=""""letter.asp?l=A""""><b>Browse A to Z</b></a><br>Every title, in order.<p><a href=""""wikisim.htm""""><b>About WikiSim</b></a><br>Where the articles come from.</font>"") %>" + NL
    t = t + "<p>" + NL
    t = t + "<%= Box(""Start here"", ""#404040"", ""<a href=""""article.asp?a=Earth"""">Earth</a><br><a href=""""article.asp?a=History"""">History</a><br><a href=""""article.asp?a=Science"""">Science</a><br><a href=""""article.asp?a=Music"""">Music</a><br><a href=""""article.asp?a=Computer"""">Computer</a><br><a href=""""article.asp?a=World+Wide+Web"""">World Wide Web</a>"") %>" + NL
    t = t + "</td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\INDEX.ASP")
END SUB

SUB File2 ()
    t = ""
    t = t + "<%@ import file=""WIKI.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' LETTER.ASP?l=A&p=2 - every title under one letter, PERPAGE to a page (0 is" + NL
    t = t + "' for titles that start with a digit or a sign)." + NL
    t = t + "VAR want AS String" + NL
    t = t + "VAR pg AS Integer" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR p AS Array OF String" + NL
    t = t + "VAR n AS Integer" + NL
    t = t + "VAR rows AS String" + NL
    t = t + "VAR pages AS Integer" + NL
    t = t + "VAR i AS Integer" + NL
    t = t + "VAR label AS String" + NL
    t = t + "want = REQUEST.Query(""l"").Upper()" + NL
    t = t + "IF want = """" THEN want = ""A""" + NL
    t = t + "want = want.Substring(0, 1)" + NL
    t = t + "IF want = ""0"" OR NOT ""ABCDEFGHIJKLMNOPQRSTUVWXYZ"".Contains(want) THEN want = ""#""" + NL
    t = t + "label = want" + NL
    t = t + "pg = Int(Val(REQUEST.Query(""p"")))" + NL
    t = t + "IF pg < 1 THEN pg = 1" + NL
    t = t + "LoadIndex()" + NL
    t = t + "FOR EACH line IN indexText.Split(Chr(10))" + NL
    t = t + "    IF NOT line.Contains(""|"" + want + ""|"") THEN CONTINUE" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    IF p[2] <> want THEN CONTINUE" + NL
    t = t + "    n = n + 1" + NL
    t = t + "    IF n > (pg - 1) * PERPAGE AND n <= pg * PERPAGE THEN rows = rows + ""<li><a href=""""article.asp?a="" + p[0] + """""">"" + H(p[1]) + ""</a>"" + Chr(10)" + NL
    t = t + "NEXT" + NL
    t = t + "pages = (n + PERPAGE - 1) / PERPAGE" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Articles under "" + label) %>" + NL
    t = t + "<% IF articleCount = 0 THEN %>" + NL
    t = t + "<%= NoData() %>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<h2>Articles under <%= H(label) %></h2>" + NL
    t = t + "<% IF n = 0 THEN %>" + NL
    t = t + "<p>No articles start with <%= H(label) %>.</p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<p><font size=""2""><%= n %> article<% IF n <> 1 THEN %>s<% END IF %><% IF pages > 1 THEN %>, page <%= pg %> of <%= pages %><% END IF %></font></p>" + NL
    t = t + "<ul>" + NL
    t = t + "<%= rows %></ul>" + NL
    t = t + "<% IF pages > 1 THEN %>" + NL
    t = t + "<p><font size=""2"">Pages:" + NL
    t = t + "<% FOR i = 1 TO pages %>" + NL
    t = t + "<% IF i = pg THEN %><b><%= i %></b><% ELSE %><a href=""letter.asp?l=<% IF want = ""#"" THEN %>0<% ELSE %><%= want %><% END IF %>&amp;p=<%= i %>""><%= i %></a><% END IF %>" + NL
    t = t + "<% NEXT %>" + NL
    t = t + "</font></p>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\LETTER.ASP")
END SUB

SUB File3 ()
    t = ""
    t = t + "<html><head><title>Licence - WikiSim 96</title></head>" + NL
    t = t + "<body bgcolor=""#FFFFF0"" link=""#000080"" vlink=""#600060"">" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""0"" bgcolor=""#000040""><tr><td><a href=""index.asp""><font face=""Times New Roman"" color=""#FFD700"" size=""6""><b>W</b></font><font face=""Times New Roman"" color=""#FFFFFF"" size=""5""><b>iki</b></font><font face=""Times New Roman"" color=""#FFD700"" size=""6""><b>S</b></font><font face=""Times New Roman"" color=""#FFFFFF"" size=""5""><b>im</b></font></a>" + NL
    t = t + "<font color=""#C0C0FF"" size=""2""> &nbsp;Encyclopedia 96 &middot; Multimedia Edition</font></td></tr></table>" + NL
    t = t + "<h2>Licence</h2>" + NL
    t = t + "<p>The articles in WikiSim are from <b>Wikipedia, the free encyclopedia</b> (http://en.wikipedia.org/), written" + NL
    t = t + "by Wikipedia's contributors. They are used under the <b>Creative Commons Attribution-ShareAlike 4.0" + NL
    t = t + "International</b> licence (CC BY-SA 4.0): http://creativecommons.org/licenses/by-sa/4.0/</p>" + NL
    t = t + "<p><b>The text has been changed.</b> Only the introduction of each article is used. Sentences that mention a" + NL
    t = t + "year after 1996, or something from after 1996, were removed; pronunciation guides and brackets were tidied;" + NL
    t = t + """is currently"" became ""is at present""; each article was shortened to a few sentences; and links were added" + NL
    t = t + "between WikiSim's own articles. Articles about things from after 1996 were left out. Each article page names" + NL
    t = t + "the Wikipedia article it came from; the full history of each one, and the names of its authors, are on" + NL
    t = t + "Wikipedia.</p>" + NL
    t = t + "<p>You may copy and change WikiSim's articles, for any purpose, as long as you say they come from Wikipedia," + NL
    t = t + "say that they were changed, and share what you make under the same licence.</p>" + NL
    t = t + "<p>There is no warranty.</p>" + NL
    t = t + "<p><a href=""index.asp"">Back to WikiSim</a></p>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\LICENSE.HTM")
END SUB

SUB File4 ()
    t = ""
    t = t + "<%@ import file=""WIKI.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' RANDOM.ASP - off to any article at all." + NL
    t = t + "VAR id AS Integer" + NL
    t = t + "id = RandomArticle()" + NL
    t = t + "IF id = 0 THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "RESPONSE.Redirect(""article.asp?a="" + Str(id))" + NL
    t = t + "%>" + NL
    Put("C:\WEB\RANDOM.ASP")
END SUB

SUB File5 ()
    t = ""
    t = t + "<%@ import file=""WIKI.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' SEARCH.ASP?q=words - titles that start with the words first, then titles" + NL
    t = t + "' that hold every word, then articles whose text does. Each list is one pass" + NL
    t = t + "' over INDEX.TXT or the volumes, so the page stays well inside its time limit." + NL
    t = t + "VAR q AS String" + NL
    t = t + "VAR words AS Array OF String" + NL
    t = t + "VAR w AS String" + NL
    t = t + "VAR lines AS Array OF String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR low AS String" + NL
    t = t + "VAR p AS Array OF String" + NL
    t = t + "VAR seen AS String" + NL
    t = t + "VAR rows AS String" + NL
    t = t + "VAR hits AS Integer" + NL
    t = t + "VAR textHits AS Integer" + NL
    t = t + "VAR vol AS Integer" + NL
    t = t + "VAR name AS String" + NL
    t = t + "VAR allIn AS Bool" + NL
    t = t + "VAR snippet AS String" + NL
    t = t + "q = REQUEST.Query(""q"").Replace(""|"", "" "").Replace(""{"", "" "").Trim()" + NL
    t = t + "IF q.Length > 60 THEN q = q.Substring(0, 60)" + NL
    t = t + "FOR EACH w IN q.Lower().Split("" "")" + NL
    t = t + "    IF w.Length >= 2 AND words.Count < 6 THEN words.Add(w)" + NL
    t = t + "NEXT" + NL
    t = t + "LoadIndex()" + NL
    t = t + "seen = ""|""" + NL
    t = t + "IF words.Count > 0 AND articleCount > 0 THEN" + NL
    t = t + "    lines = indexText.Split(Chr(10))" + NL
    t = t + "    ' titles that start with what was typed" + NL
    t = t + "    FOR EACH line IN lines" + NL
    t = t + "        IF hits >= MAXHITS THEN BREAK" + NL
    t = t + "        IF NOT line.Contains(""|"") THEN CONTINUE" + NL
    t = t + "        p = line.Split(""|"")" + NL
    t = t + "        IF p[1].Lower().StartsWith(q.Lower()) THEN" + NL
    t = t + "            rows = rows + ""<li><a href=""""article.asp?a="" + p[0] + """"""><b>"" + H(p[1]) + ""</b></a>"" + Chr(10)" + NL
    t = t + "            seen = seen + p[0] + ""|""" + NL
    t = t + "            hits = hits + 1" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' titles with every word in them" + NL
    t = t + "    FOR EACH line IN lines" + NL
    t = t + "        IF hits >= MAXHITS THEN BREAK" + NL
    t = t + "        IF NOT line.Contains(""|"") THEN CONTINUE" + NL
    t = t + "        p = line.Split(""|"")" + NL
    t = t + "        IF seen.Contains(""|"" + p[0] + ""|"") THEN CONTINUE" + NL
    t = t + "        low = "" "" + p[1].Lower().Replace(""("", "" "").Replace("")"", "" "").Replace("","", "" "") + "" """ + NL
    t = t + "        allIn = TRUE" + NL
    t = t + "        FOR EACH w IN words" + NL
    t = t + "            IF NOT low.Contains("" "" + w) THEN allIn = FALSE" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF allIn THEN" + NL
    t = t + "            rows = rows + ""<li><a href=""""article.asp?a="" + p[0] + """"""><b>"" + H(p[1]) + ""</b></a>"" + Chr(10)" + NL
    t = t + "            seen = seen + p[0] + ""|""" + NL
    t = t + "            hits = hits + 1" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' articles with every word in their text" + NL
    t = t + "    vol = 1" + NL
    t = t + "    WHILE hits < MAXHITS" + NL
    t = t + "        name = Str(vol)" + NL
    t = t + "        IF name.Length < 2 THEN name = ""0"" + name" + NL
    t = t + "        IF NOT FS.Exists(DATADIR + ""\VOL"" + name + "".TXT"") THEN BREAK" + NL
    t = t + "        FOR EACH line IN FS.Read(DATADIR + ""\VOL"" + name + "".TXT"").Split(Chr(10))" + NL
    t = t + "            IF hits >= MAXHITS THEN BREAK" + NL
    t = t + "            IF NOT line.Contains(""|"") THEN CONTINUE" + NL
    t = t + "            low = line.Lower()" + NL
    t = t + "            allIn = TRUE" + NL
    t = t + "            FOR EACH w IN words" + NL
    t = t + "                IF NOT low.Contains(w) THEN allIn = FALSE" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF NOT allIn THEN CONTINUE" + NL
    t = t + "            p = line.Split(""|"")" + NL
    t = t + "            IF seen.Contains(""|"" + p[0] + ""|"") THEN CONTINUE" + NL
    t = t + "            snippet = PlainText(TextOf(line))" + NL
    t = t + "            IF snippet.Length > 140 THEN snippet = snippet.Substring(0, 140) + ""...""" + NL
    t = t + "            rows = rows + ""<li><a href=""""article.asp?a="" + p[0] + """""">"" + H(p[1]) + ""</a><br><font size=""""2"""" color=""""#606060"""">"" + H(snippet) + ""</font>"" + Chr(10)" + NL
    t = t + "            seen = seen + p[0] + ""|""" + NL
    t = t + "            hits = hits + 1" + NL
    t = t + "            textHits = textHits + 1" + NL
    t = t + "        NEXT" + NL
    t = t + "        vol = vol + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "END IF" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Find: "" + q) %>" + NL
    t = t + "<% IF articleCount = 0 THEN %>" + NL
    t = t + "<%= NoData() %>" + NL
    t = t + "<% ELSEIF words.Count = 0 THEN %>" + NL
    t = t + "<h2>Find an article</h2>" + NL
    t = t + "<p>Type a word or two (at least two letters each) and press Find.</p>" + NL
    t = t + "<% ELSEIF hits = 0 THEN %>" + NL
    t = t + "<h2>Nothing found for &quot;<%= H(q) %>&quot;</h2>" + NL
    t = t + "<p>WikiSim has no article about that. Check the spelling, try fewer words, or <a href=""letter.asp?l=<%= q.Substring(0, 1).Upper() %>"">browse the titles under <%= H(q.Substring(0, 1).Upper()) %></a>." + NL
    t = t + "Remember that WikiSim knows only what was known in 1996.</p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<h2><%= hits %> article<% IF hits <> 1 THEN %>s<% END IF %> found for &quot;<%= H(q) %>&quot;</h2>" + NL
    t = t + "<ol>" + NL
    t = t + "<%= rows %></ol>" + NL
    t = t + "<% IF hits >= MAXHITS THEN %><p><font size=""2"">Only the first <%= MAXHITS %> are shown. Add a word to narrow it down.</font></p><% END IF %>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<form action=""search.asp"" method=""get""><input name=""q"" size=""30"" value=""<%= H(q) %>""> <input type=""submit"" value=""Find""></form>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\SEARCH.ASP")
END SUB

SUB File6 ()
    t = ""
    t = t + "' WIKI.SPK - WikiSim, the encyclopedia on a disk, as of 1996." + NL
    t = t + "' Every page pulls this in with <%@ import file=""WIKI.SPK"" %>." + NL
    t = t + "'" + NL
    t = t + "' The articles are Wikipedia's (CC BY-SA 4.0), cut back to what was known in" + NL
    t = t + "' 1996 and shortened by tools/make-wikisim.mjs. They live outside C:\WEB, so" + NL
    t = t + "' the web server never hands the raw files out, and nothing is ever written:" + NL
    t = t + "'" + NL
    t = t + "'   C:\WIKIDATA\INDEX.TXT     id|title|letter|volume, one per article, A to Z" + NL
    t = t + "'   C:\WIKIDATA\VOLnn.TXT     id|title|text, about 30K of articles to a file" + NL
    t = t + "'   C:\WIKIDATA\LINKS.TXT     id|id id id  (the article's ""See also"")" + NL
    t = t + "'   C:\WIKIDATA\DYK.TXT       id|a sentence, for ""Did you know?""" + NL
    t = t + "'" + NL
    t = t + "' In the text, a line break is \ and a link to another article is {id|words}." + NL
    t = t + "' Ids follow the titles A to Z, so the article before and after are id-1 and" + NL
    t = t + "' id+1. A server page that runs too long is stopped, so every lookup here is" + NL
    t = t + "' an IndexOf on a whole file rather than a loop over its lines." + NL
    t = t + "" + NL
    t = t + "CONST DATADIR = ""C:\WIKIDATA""" + NL
    t = t + "CONST PERPAGE = 150           ' titles on one page of a letter" + NL
    t = t + "CONST MAXHITS = 40            ' search results shown" + NL
    t = t + "" + NL
    t = t + "VAR indexText AS String       ' INDEX.TXT with a line break in front, read once" + NL
    t = t + "VAR indexLower AS String      ' the same, lower case, for finding titles" + NL
    t = t + "VAR articleCount AS Integer" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- odds and ends" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION H (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.HtmlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The line of text that starts with key|, or """". text starts with a line break." + NL
    t = t + "FUNCTION LineOf (text AS String, key AS String) AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    at = text.IndexOf(Chr(10) + key + ""|"")" + NL
    t = t + "    IF at < 0 THEN RETURN """"" + NL
    t = t + "    rest = text.Substring(at + 1, text.Length - at - 1)" + NL
    t = t + "    IF rest.Contains(Chr(10)) THEN rest = rest.Substring(0, rest.IndexOf(Chr(10)))" + NL
    t = t + "    RETURN rest" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB LoadIndex ()" + NL
    t = t + "    IF indexText <> """" THEN RETURN" + NL
    t = t + "    indexText = Chr(10) + ReadOr(DATADIR + ""\INDEX.TXT"", """").Replace(Chr(13), """")" + NL
    t = t + "    indexLower = indexText.Lower()" + NL
    t = t + "    articleCount = indexText.Split(Chr(10)).Count - 2" + NL
    t = t + "    IF articleCount < 0 THEN articleCount = 0" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' INDEX.TXT's line for an article id ("""" when there is none)" + NL
    t = t + "FUNCTION IndexLine (id AS Integer) AS String" + NL
    t = t + "    LoadIndex()" + NL
    t = t + "    RETURN LineOf(indexText, Str(id))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION TitleOf (id AS Integer) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    line = IndexLine(id)" + NL
    t = t + "    IF line = """" THEN RETURN """"" + NL
    t = t + "    RETURN line.Split(""|"")[1]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' An article's id from its id or its title (any case); 0 when there is none." + NL
    t = t + "' ""doom"" finds ""Doom (1993 video game)"" too." + NL
    t = t + "FUNCTION FindArticle (a AS String) AS Integer" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR head AS String" + NL
    t = t + "    LoadIndex()" + NL
    t = t + "    a = a.Trim()" + NL
    t = t + "    IF a = """" THEN RETURN 0" + NL
    t = t + "    IF Str(Int(Val(a))) = a THEN" + NL
    t = t + "        IF IndexLine(Int(Val(a))) <> """" THEN RETURN Int(Val(a))" + NL
    t = t + "        RETURN 0" + NL
    t = t + "    END IF" + NL
    t = t + "    at = indexLower.IndexOf(""|"" + a.Lower() + ""|"")" + NL
    t = t + "    IF at < 0 THEN at = indexLower.IndexOf(""|"" + a.Lower() + "" ("")" + NL
    t = t + "    IF at < 0 THEN RETURN 0" + NL
    t = t + "    ' what is between the line break and the title is the id" + NL
    t = t + "    head = indexLower.Substring(0, at)" + NL
    t = t + "    head = head.Split(Chr(10))[head.Split(Chr(10)).Count - 1]" + NL
    t = t + "    IF head.Contains(""|"") THEN RETURN 0" + NL
    t = t + "    RETURN Int(Val(head))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The volume line of an article: id|title|text" + NL
    t = t + "FUNCTION ArticleLine (id AS Integer) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR vol AS String" + NL
    t = t + "    line = IndexLine(id)" + NL
    t = t + "    IF line = """" THEN RETURN """"" + NL
    t = t + "    vol = line.Split(""|"")[3]" + NL
    t = t + "    IF vol.Length < 2 THEN vol = ""0"" + vol" + NL
    t = t + "    RETURN LineOf(Chr(10) + ReadOr(DATADIR + ""\VOL"" + vol + "".TXT"", """"), Str(id))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The text part of a volume line." + NL
    t = t + "FUNCTION TextOf (line AS String) AS String" + NL
    t = t + "    VAR skip AS Integer" + NL
    t = t + "    skip = line.Split(""|"")[0].Length + line.Split(""|"")[1].Length + 2" + NL
    t = t + "    RETURN line.Substring(skip, line.Length - skip)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The text as HTML: paragraphs, and {id|words} as links to those articles." + NL
    t = t + "FUNCTION TextHtml (text AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR piece AS String" + NL
    t = t + "    VAR first AS Bool" + NL
    t = t + "    text = H(text)" + NL
    t = t + "    first = TRUE" + NL
    t = t + "    FOR EACH piece IN text.Split(""{"")" + NL
    t = t + "        IF first THEN" + NL
    t = t + "            out = piece" + NL
    t = t + "            first = FALSE" + NL
    t = t + "        ELSEIF piece.Contains(""|"") AND piece.Contains(""}"") THEN" + NL
    t = t + "            out = out + ""<a href=""""article.asp?a="" + piece.Split(""|"")[0] + """""">"" + piece.Substring(piece.IndexOf(""|"") + 1, piece.IndexOf(""}"") - piece.IndexOf(""|"") - 1) + ""</a>"" + piece.Substring(piece.IndexOf(""}"") + 1, piece.Length - piece.IndexOf(""}"") - 1)" + NL
    t = t + "        ELSE" + NL
    t = t + "            out = out + ""{"" + piece" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN ""<p>"" + out.Replace(""\"", ""</p>"" + Chr(10) + ""<p>"") + ""</p>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The text with the link marks taken out." + NL
    t = t + "FUNCTION PlainText (text AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR piece AS String" + NL
    t = t + "    VAR first AS Bool" + NL
    t = t + "    first = TRUE" + NL
    t = t + "    FOR EACH piece IN text.Split(""{"")" + NL
    t = t + "        IF first THEN" + NL
    t = t + "            out = piece" + NL
    t = t + "            first = FALSE" + NL
    t = t + "        ELSEIF piece.Contains(""|"") AND piece.Contains(""}"") THEN" + NL
    t = t + "            out = out + piece.Substring(piece.IndexOf(""|"") + 1, piece.Length - piece.IndexOf(""|"") - 1).Replace(""}"", """")" + NL
    t = t + "        ELSE" + NL
    t = t + "            out = out + ""{"" + piece" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out.Replace(""\"", "" "")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The article of the day: the same one all day, a different one tomorrow." + NL
    t = t + "FUNCTION DaySeed () AS Integer" + NL
    t = t + "    VAR d AS String" + NL
    t = t + "    d = TIME.Date" + NL
    t = t + "    RETURN Int(Val(d.Substring(0, 4))) * 372 + Int(Val(d.Substring(5, 2))) * 31 + Int(Val(d.Substring(8, 2)))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION DayArticle () AS Integer" + NL
    t = t + "    LoadIndex()" + NL
    t = t + "    IF articleCount = 0 THEN RETURN 0" + NL
    t = t + "    RETURN (DaySeed() * 7919) MOD articleCount + 1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RandomArticle () AS Integer" + NL
    t = t + "    LoadIndex()" + NL
    t = t + "    IF articleCount = 0 THEN RETURN 0" + NL
    t = t + "    RETURN Rnd(articleCount) + 1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Today's ""Did you know?"" line: id|sentence" + NL
    t = t + "FUNCTION DidYouKnow () AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    lines = ReadOr(DATADIR + ""\DYK.TXT"", """").Replace(Chr(13), """").Trim().Split(Chr(10))" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN """"" + NL
    t = t + "    RETURN lines[(DaySeed() * 31) MOD lines.Count]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the look" + NL
    t = t + "" + NL
    t = t + "' The top of every page: the WikiSim banner, the search box, and the letters." + NL
    t = t + "FUNCTION Top (title AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    out = ""<html><head><title>"" + H(title) + "" - WikiSim 96</title>"" + Chr(10) _" + NL
    t = t + "        + ""<meta name=""""description"""" content=""""WikiSim 96, the encyclopedia on your computer: more than a thousand articles, as of 1996."""">"" + Chr(10) _" + NL
    t = t + "        + ""</head>"" + Chr(10) + ""<body bgcolor=""""#FFFFF0"""" link=""""#000080"""" vlink=""""#600060"""">"" + Chr(10) _" + NL
    t = t + "        + ""<table width=""""100%"""" cellpadding=""""6"""" cellspacing=""""0"""" bgcolor=""""#000040""""><tr>"" _" + NL
    t = t + "        + ""<td><a href=""""index.asp""""><font face=""""Times New Roman"""" color=""""#FFD700"""" size=""""6""""><b>W</b></font><font face=""""Times New Roman"""" color=""""#FFFFFF"""" size=""""5""""><b>iki</b></font><font face=""""Times New Roman"""" color=""""#FFD700"""" size=""""6""""><b>S</b></font><font face=""""Times New Roman"""" color=""""#FFFFFF"""" size=""""5""""><b>im</b></font></a>"" _" + NL
    t = t + "        + ""<font color=""""#C0C0FF"""" size=""""2""""> &nbsp;Encyclopedia 96 &middot; Multimedia Edition</font></td>"" _" + NL
    t = t + "        + ""<td align=""""right""""><form action=""""search.asp"""" method=""""get""""><font color=""""#FFFFFF"""" size=""""2"""">Find: </font><input name=""""q"""" size=""""18""""> <input type=""""submit"""" value=""""Go""""></form></td>"" _" + NL
    t = t + "        + ""</tr></table>"" + Chr(10) + Letters() + Chr(10)" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Letters () AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR L AS String" + NL
    t = t + "    out = ""<table width=""""100%"""" cellpadding=""""2"""" cellspacing=""""0"""" bgcolor=""""#C0C0C0""""><tr><td align=""""center""""><font size=""""2"""">""" + NL
    t = t + "    FOR i = 0 TO 25" + NL
    t = t + "        L = Chr(65 + i)" + NL
    t = t + "        out = out + ""<a href=""""letter.asp?l="" + L + """"""><b>"" + L + ""</b></a> """ + NL
    t = t + "    NEXT" + NL
    t = t + "    out = out + ""<a href=""""letter.asp?l=0""""><b>#</b></a> &nbsp;|&nbsp; <a href=""""random.asp"""">Random</a> &nbsp;|&nbsp; <a href=""""index.asp"""">Contents</a></font></td></tr></table>""" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Bottom () AS String" + NL
    t = t + "    RETURN ""<hr><center><font size=""""1"""" color=""""#808080"""">WikiSim 96 &middot; text from Wikipedia, the free encyclopedia, as of 1996 and edited, under <a href=""""license.htm"""">CC BY-SA 4.0</a> &middot; <a href=""""wikisim.htm"""">About WikiSim</a></font></center>"" + Chr(10) + ""</body></html>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NoData () AS String" + NL
    t = t + "    RETURN ""<p><b>The WikiSim disk is not in the drive.</b> WikiSim keeps its articles in "" + DATADIR + "", and this machine has none. Run WikiSim's INSTALL.SPK again to put them back.</p>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A titled box, for the front page." + NL
    t = t + "FUNCTION Box (title AS String, color AS String, body AS String) AS String" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""6"""" cellspacing=""""0"""" border=""""1""""><tr><td bgcolor="""""" + color + """"""><font color=""""#FFFFFF""""><b>"" + title + ""</b></font></td></tr><tr><td bgcolor=""""#FFFFFF"""">"" + body + ""</td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\WEB\WIKI.SPK")
END SUB

SUB File7 ()
    t = ""
    t = t + "<html><head><title>About WikiSim 96 - the free encyclopedia and reference on your computer</title>" + NL
    t = t + "<meta name=""description"" content=""WikiSim 96 is an encyclopedia on your computer: more than a thousand articles on history, science, geography, people, the arts and computers, as of 1996. A free reference, built from Wikipedia text."">" + NL
    t = t + "<meta name=""keywords"" content=""encyclopedia, wiki, wikipedia, wikisim, reference, knowledge, history, 1996, science, geography, biography, people, countries, computers, internet, facts, look up, homework, research, articles, encarta, cd-rom"">" + NL
    t = t + "</head>" + NL
    t = t + "<body bgcolor=""#FFFFF0"" link=""#000080"" vlink=""#600060"">" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""0"" bgcolor=""#000040""><tr><td><a href=""index.asp""><font face=""Times New Roman"" color=""#FFD700"" size=""6""><b>W</b></font><font face=""Times New Roman"" color=""#FFFFFF"" size=""5""><b>iki</b></font><font face=""Times New Roman"" color=""#FFD700"" size=""6""><b>S</b></font><font face=""Times New Roman"" color=""#FFFFFF"" size=""5""><b>im</b></font></a>" + NL
    t = t + "<font color=""#C0C0FF"" size=""2""> &nbsp;Encyclopedia 96 &middot; Multimedia Edition</font></td></tr></table>" + NL
    t = t + "<h2>About WikiSim 96</h2>" + NL
    t = t + "<p><b>WikiSim is an encyclopedia on your computer.</b> More than a thousand articles on history, science," + NL
    t = t + "geography, the arts, famous people and, of course, computers and the Information Superhighway. It is a free" + NL
    t = t + "reference for homework, research and settling arguments, and every article links to others.</p>" + NL
    t = t + "<h3>Where do the articles come from?</h3>" + NL
    t = t + "<p>From <b>Wikipedia, the free encyclopedia</b>: its list of the thousand most vital articles, and a hundred" + NL
    t = t + "and fifty more on computers, the Internet and pop culture. Wikipedia is written by its readers, and anybody may" + NL
    t = t + "copy it as long as they say where it came from and share it on the same terms (the" + NL
    t = t + "<a href=""license.htm"">CC BY-SA 4.0 licence</a>).</p>" + NL
    t = t + "<h3>Why ""as of 1996""?</h3>" + NL
    t = t + "<p>Because it is 1996. Every sentence that mentions a later year, or something that had not been invented yet," + NL
    t = t + "has been taken out, along with articles about things that had not happened. What is left is the first few" + NL
    t = t + "sentences of each article, edited to fit on one disk. So WikiSim knows about Netscape Navigator, the" + NL
    t = t + "Pentium and <i>The X-Files</i>, and is none the wiser about anything since.</p>" + NL
    t = t + "<h3>How do I use it?</h3>" + NL
    t = t + "<ul>" + NL
    t = t + "<li><b>Find:</b> type a word in the box at the top of any page.</li>" + NL
    t = t + "<li><b>A to Z:</b> click a letter to see every title that starts with it.</li>" + NL
    t = t + "<li><b>Random article:</b> open the encyclopedia at any page.</li>" + NL
    t = t + "<li><b>Article of the Day</b> and <b>Did you know?</b> change every day, on the front page.</li>" + NL
    t = t + "</ul>" + NL
    t = t + "<p><a href=""index.asp""><b>Open WikiSim</b></a></p>" + NL
    t = t + "<hr><center><font size=""1"" color=""#808080"">WikiSim 96: encyclopedia, reference and knowledge for SIM95. Text from Wikipedia, edited, under <a href=""license.htm"">CC BY-SA 4.0</a>.</font></center>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\WIKISIM.HTM")
END SUB

SUB File8 ()
