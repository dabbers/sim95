    t = t + "        IF SYS.Args[0].Lower() = ""apps"" THEN ShowPage(""apps"")" + NL
    t = t + "    END IF" + NL
    t = t + "    win.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
