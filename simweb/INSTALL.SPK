    t = t + "    mNicHead = Heading(""Domain names"", 200)" + NL
    t = t + "    mNic = Para(""To give a site here a name like coolsite.sim, register it at SimNIC"" + EOL _" + NL
    t = t + "        + ""("" + nicUrl + "") and point it at this machine, "" + here.Upper() + ""."" + EOL _" + NL
    t = t + "        + ""Simxplorer users reach it only once its name points here at SimNIC."" + EOL _" + NL
    t = t + "        + ""Then add it under Web Sites, so the web server knows which pages it gets."", 224, 70)" + NL
    t = t + "    mNicGo = GUI_Button.New(win)" + NL
    t = t + "    mNicGo.SetBounds(116, 300, 260, 26)" + NL
    t = t + "    mNicGo.Text = ""Register / point it at Sim&NIC""" + NL
