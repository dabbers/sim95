' VAPOR|id=SIMWEB|name=simweb|kind=program|version=b0fb52c6|category=Internet|run=C:\PROGRAMS\PWM.SPK|files=C:\PROGRAMS\PWM.SPK;C:\PROGRAMS\DIG.SPK;C:\PROGRAMS\RESOLVE.SPK|tasks=PWM|startup=|folder=|about=Personal Web Manager and a web server that serves many sites by name: coolsite.sim for your own pages, coolbook.sim for SimBook. Register and point the names at SimNIC; then add them here. With DIG, to ask the name server.
' INSTALL.SPK - puts simweb on this machine. Generated by tools/build-installer.mjs;
' edit the files in simweb/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It replaces the web
' server with one that serves several sites by name (C:\WEB\VHOSTS.TXT), and
' writes Personal Web Manager (C:\PROGRAMS\PWM.SPK), which keeps that list:
' coolsite.sim for your own pages in C:\WEB\SITES, coolbook.sim for SimBook,
' book.coolsite.sim... It also writes DIG.SPK (ask the name server) and
' RESOLVE.SPK (the resolver, for your own programs). The old web server is kept
' as C:\PROGRAMS\HTTPD.ORG and comes back when simweb is uninstalled. Names
' themselves are registered, and pointed at this machine, at SimNIC:
' http://starthere.56k.net/nic/

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)



    WebSetup()
    File0()
    File1()
    File2()
    File3()
    Print("simweb is installed (4 files).")
    RestartWeb()
    SYS.Start("C:\PROGRAMS\PWM.SPK", "")

    Print("Personal Web Manager is open. Next time, start C:\PROGRAMS\PWM.SPK from Files.")
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "' PWM.SPK - Personal Web Manager: this machine's web sites, the way Windows 98's" + NL
    t = t + "' Personal Web Server had them. For the machine's owner, so no password." + NL
    t = t + "'" + NL
    t = t + "' The web server (simweb's HTTPD.SPK) serves a site for each name listed in" + NL
    t = t + "' C:\WEB\VHOSTS.TXT, one a line, name|folder:" + NL
    t = t + "'     coolsite.sim|C:\WEB\SITES\COOLSITE        your own pages" + NL
    t = t + "'     www.coolsite.sim|C:\WEB\SITES\COOLSITE    (the same, with www.)" + NL
    t = t + "'     coolbook.sim|C:\WEB\BOOK                  one of this machine's web apps" + NL
    t = t + "'     book.coolsite.sim|C:\WEB\BOOK" + NL
    t = t + "' This program keeps that list: Add, Edit and Remove a site, and give the" + NL
    t = t + "' machine's apps names under a domain (book.coolsite.sim, mail...). Lines it" + NL
    t = t + "' doesn't know (comments, *.dab.sim) are kept as they are." + NL
    t = t + "'" + NL
    t = t + "' A name works in Simxplorer only once it points at this machine at SimNIC" + NL
    t = t + "' (http://starthere.56k.net/nic/), so each site's name is asked about: the" + NL
    t = t + "' resolver (simweb/src/RESOLVE.SPK, the Rs... names, joined on by the builder)" + NL
    t = t + "' asks the name server, one name a timer tick, the question the last thing the" + NL
    t = t + "' tick does (SIM95-NOTES.md), and the DNS column says what it said." + NL
    t = t + "'" + NL
    t = t + "' It also starts and stops the web server, as PWS's Main page did." + NL
    t = t + "" + NL
    t = t + "CONST VHOSTS = ""C:\WEB\VHOSTS.TXT""" + NL
    t = t + "CONST SITES = ""C:\WEB\SITES""" + NL
    t = t + "CONST HTTPD = ""C:\PROGRAMS\HTTPD.SPK""" + NL
    t = t + "CONST BROWSER = ""C:\PROGRAMS\SIMXPLOR.SPK""" + NL
    t = t + "CONST APPTITLE = ""Personal Web Manager""" + NL
    t = t + "" + NL
    t = t + "VAR EOL AS String" + NL
    t = t + "VAR here AS String                  ' this machine's name, lower case" + NL
