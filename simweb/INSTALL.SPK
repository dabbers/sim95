    t = t + "    VAR l AS GUI_Label" + NL
    t = t + "    l = GUI_Label.New(win)" + NL
    t = t + "    l.SetBounds(116, y, 330, 20)" + NL
    t = t + "    l.Text = text" + NL
    t = t + "    l.Bold = TRUE" + NL
    t = t + "    RETURN l" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Para (words AS String, y AS Integer, h AS Integer) AS GUI_Label" + NL
    t = t + "    VAR l AS GUI_Label" + NL
    t = t + "    l = GUI_Label.New(win)" + NL
    t = t + "    l.SetBounds(116, y, 444, h)" + NL
    t = t + "    l.Text = words" + NL
    t = t + "    RETURN l" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Cols (a AS String, b AS String, c AS String) AS String" + NL
    t = t + "    IF a.Length > 23 THEN a = a.Substring(0, 22) + ""~""" + NL
    t = t + "    IF b.Length > 27 THEN b = b.Substring(0, 26) + ""~""" + NL
    t = t + "    RETURN a.PadRight(24) + b.PadRight(28) + c" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Side_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    side.SetColor(6)" + NL
    t = t + "    side.FillRect(0, 0, 100, 400)" + NL
    t = t + "    side.SetColor(15)" + NL
    t = t + "    side.Text(10, 12, ""View"")" + NL
    t = t + "    side.SetColor(7)" + NL
    t = t + "    side.Line(8, 30, 92, 30)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ShowMain_Click ()" + NL
    t = t + "    ShowPage(""main"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ShowSites_Click ()" + NL
    t = t + "    ShowPage(""sites"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ShowApps_Click ()" + NL
    t = t + "    ShowPage(""apps"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Menu_OnSelect (item AS String)" + NL
    t = t + "    SELECT CASE item" + NL
    t = t + "        CASE ""Start Service""" + NL
    t = t + "            IF WebPid() = 0 THEN StartStop_Click()" + NL
    t = t + "        CASE ""Stop Service""" + NL
    t = t + "            IF WebPid() <> 0 THEN StartStop_Click()" + NL
    t = t + "        CASE ""Exit""" + NL
    t = t + "            SYS.Exit(0)" + NL
    t = t + "        CASE ""Main""" + NL
    t = t + "            ShowPage(""main"")" + NL
    t = t + "        CASE ""Web Sites""" + NL
    t = t + "            ShowPage(""sites"")" + NL
    t = t + "        CASE ""Domain Apps""" + NL
    t = t + "            ShowPage(""apps"")" + NL
    t = t + "        CASE ""About Personal Web Manager""" + NL
    t = t + "            Say(""info"", ""Personal Web Manager 1.0 for SIM95 (simweb)"" + EOL + EOL + ""Publishes your pages, and this machine's apps, at names of their own."" + EOL + ""Names are registered at SimNIC: "" + nicUrl)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ShowPage (p AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR m AS Bool" + NL
    t = t + "    VAR s AS Bool" + NL
    t = t + "    VAR a AS Bool" + NL
    t = t + "    page = p" + NL
    t = t + "    m = (p = ""main"")" + NL
    t = t + "    s = (p = ""sites"")" + NL
    t = t + "    a = (p = ""apps"")" + NL
    t = t + "    mHead.Visible = m" + NL
    t = t + "    mPub.Visible = m" + NL
    t = t + "    mUrl.Visible = m" + NL
    t = t + "    mStart.Visible = m" + NL
    t = t + "    mRestart.Visible = m" + NL
    t = t + "    mSitesHead.Visible = m" + NL
    t = t + "    mSites.Visible = m" + NL
    t = t + "    mNicHead.Visible = m" + NL
    t = t + "    mNic.Visible = m" + NL
    t = t + "    mNicGo.Visible = m" + NL
    t = t + "    sHead.Visible = s" + NL
    t = t + "    sCols.Visible = s" + NL
    t = t + "    sList.Visible = s" + NL
    t = t + "    sAdd.Visible = s" + NL
    t = t + "    sEdit.Visible = s" + NL
    t = t + "    sRemove.Visible = s" + NL
    t = t + "    sCheck.Visible = s" + NL
    t = t + "    sAddr.Visible = s" + NL
    t = t + "    sHint.Visible = s" + NL
    t = t + "    aHead.Visible = a" + NL
    t = t + "    aDomLbl.Visible = a" + NL
    t = t + "    aDomain.Visible = a" + NL
    t = t + "    aSave.Visible = a" + NL
    t = t + "    aHint.Visible = a" + NL
    t = t + "    FOR i = 0 TO aChk.Count - 1" + NL
    t = t + "        aChk[i].Visible = a" + NL
    t = t + "        aLbl[i].Visible = a" + NL
    t = t + "        aTail[i].Visible = a" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF m THEN" + NL
    t = t + "        win.Title = APPTITLE + "" - Main""" + NL
    t = t + "        ShowMain()" + NL
    t = t + "    ELSEIF s THEN" + NL
    t = t + "        win.Title = APPTITLE + "" - Web Sites""" + NL
    t = t + "    ELSE" + NL
    t = t + "        win.Title = APPTITLE + "" - Domain Apps""" + NL
    t = t + "        IF aDomain.Text = """" THEN aDomain.Text = FirstDomain()" + NL
    t = t + "        FillApps()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Say (kind AS String, text AS String) AS Bool" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = APPTITLE" + NL
    t = t + "    box.Kind = kind" + NL
    t = t + "    IF kind = ""confirm"" THEN box.Buttons = ""yesno""" + NL
    t = t + "    box.Text = text" + NL
    t = t + "    RETURN box.Show()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the web server" + NL
    t = t + "" + NL
    t = t + "' The web server's process, or 0 when it isn't running." + NL
    t = t + "FUNCTION WebPid () AS Integer" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    FOR EACH t IN SYS.Tasks()" + NL
    t = t + "        IF t.Split(""|"")[1].Upper() = ""HTTPD"" THEN RETURN Int(Val(t.Split(""|"")[0]))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB ShowMain ()" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    IF WebPid() <> 0 THEN" + NL
    t = t + "        mPub.Text = ""Web publishing is on. Your home page is available at:""" + NL
    t = t + "        mUrl.Text = ""http://"" + here + ""/""" + NL
    t = t + "        mStart.Text = ""&Stop""" + NL
    t = t + "        mRestart.Enabled = TRUE" + NL
    t = t + "    ELSE" + NL
    t = t + "        mPub.Text = ""Web publishing is off. Your pages can't be seen from"" + EOL + ""the network. Click Start to make them available.""" + NL
    t = t + "        mUrl.Text = """"" + NL
    t = t + "        mStart.Text = ""&Start""" + NL
    t = t + "        mRestart.Enabled = FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    n = rowName.Count" + NL
    t = t + "    IF n = 0 THEN" + NL
    t = t + "        mSites.Text = ""No sites by name yet. Add one under Web Sites.""" + NL
    t = t + "    ELSEIF n = 1 THEN" + NL
    t = t + "        mSites.Text = ""1 site by name: "" + rowName[0] + ""."" + EOL + ""See Web Sites for what it serves and whether its name points here.""" + NL
    t = t + "    ELSE" + NL
    t = t + "        mSites.Text = Str(n) + "" sites by name. See Web Sites for what each serves"" + EOL + ""and whether its name points here.""" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB StartStop_Click ()" + NL
    t = t + "    VAR pid AS Integer" + NL
    t = t + "    pid = WebPid()" + NL
    t = t + "    IF pid <> 0 THEN" + NL
    t = t + "        SYS.Kill(pid)" + NL
    t = t + "        win.Status = ""The web server is stopped.""" + NL
    t = t + "    ELSE" + NL
    t = t + "        SYS.Run(HTTPD)" + NL
    t = t + "        win.Status = ""The web server is running.""" + NL
    t = t + "    END IF" + NL
    t = t + "    ShowMain()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Restart_Click ()" + NL
    t = t + "    VAR pid AS Integer" + NL
    t = t + "    pid = WebPid()" + NL
    t = t + "    IF pid <> 0 THEN SYS.Kill(pid)" + NL
    t = t + "    SYS.Run(HTTPD)" + NL
    t = t + "    win.Status = ""The web server was restarted.""" + NL
    t = t + "    ShowMain()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Nic_Click ()" + NL
    t = t + "    OpenPage(nicUrl)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB OpenPage (url AS String)" + NL
    t = t + "    IF FS.Exists(BROWSER) THEN" + NL
    t = t + "        SYS.Start(BROWSER, url)" + NL
    t = t + "    ELSE" + NL
    t = t + "        SYS.Start(""C:\SYSTEM\VOYAGER.EXE"", url)" + NL
    t = t + "    END IF" + NL
    t = t + "    win.Status = ""Opened "" + url" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- VHOSTS.TXT" + NL
    t = t + "" + NL
    t = t + "SUB ReadSites ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    VAR d AS String" + NL
    t = t + "    vOther.Clear()" + NL
    t = t + "    vName.Clear()" + NL
    t = t + "    vDir.Clear()" + NL
    t = t + "    IF NOT FS.Exists(VHOSTS) THEN RETURN" + NL
    t = t + "    FOR EACH line IN FS.Read(VHOSTS).Lines()" + NL
    t = t + "        t = line.Trim()" + NL
    t = t + "        IF t = """" THEN CONTINUE" + NL
    t = t + "        IF t.StartsWith("";"") OR t.StartsWith(""'"") OR t.StartsWith(""#"") OR NOT t.Contains(""|"") THEN" + NL
    t = t + "            vOther.Add(line)" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        n = t.Substring(0, t.IndexOf(""|"")).Trim().Lower()" + NL
    t = t + "        d = t.Substring(t.IndexOf(""|"") + 1, t.Length - t.IndexOf(""|"") - 1).Trim().Upper()" + NL
    t = t + "        IF d.EndsWith(""\"") THEN d = d.Substring(0, d.Length - 1)" + NL
    t = t + "        IF n = """" OR vName.Contains(n) THEN" + NL
    t = t + "            vOther.Add(line)" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        vName.Add(n)" + NL
    t = t + "        vDir.Add(d)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SaveSites ()" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR EACH line IN vOther" + NL
    t = t + "        out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR i = 0 TO vName.Count - 1" + NL
    t = t + "        out.Add(vName[i] + ""|"" + vDir[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Write(VHOSTS, out.Join(EOL) + EOL)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION DirOf (name AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = vName.IndexOf(name)" + NL
    t = t + "    IF i < 0 THEN RETURN """"" + NL
    t = t + "    RETURN vDir[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SetSite (name AS String, dir AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = vName.IndexOf(name)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        vDir[i] = dir" + NL
    t = t + "    ELSE" + NL
    t = t + "        vName.Add(name)" + NL
    t = t + "        vDir.Add(dir)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DropSite (name AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = vName.IndexOf(name)" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    vName.RemoveAt(i)" + NL
    t = t + "    vDir.RemoveAt(i)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Does name have a www. twin serving the same folder?" + NL
    t = t + "FUNCTION HasWww (name AS String) AS Bool" + NL
    t = t + "    IF name.StartsWith(""www."") OR name.StartsWith(""*."") THEN RETURN FALSE" + NL
    t = t + "    IF DirOf(name) = """" THEN RETURN FALSE" + NL
    t = t + "    RETURN DirOf(""www."" + name) = DirOf(name)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' What a folder is, in words." + NL
    t = t + "FUNCTION Serves (dir AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF dir = ""C:\WEB"" THEN RETURN ""home page""" + NL
    t = t + "    i = appDir.IndexOf(dir)" + NL
    t = t + "    IF i >= 0 THEN RETURN appName[i] + "" ("" + dir.Substring(7, dir.Length - 7) + "")""" + NL
    t = t + "    IF dir.StartsWith(SITES + ""\"") THEN RETURN ""own pages ("" + dir.Substring(7, dir.Length - 7) + "")""" + NL
    t = t + "    RETURN dir" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The list: one row a site, a www. twin shown with the site." + NL
    t = t + "SUB FillList ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    VAR shown AS String" + NL
    t = t + "    VAR keep AS Integer" + NL
    t = t + "    keep = sList.Selected" + NL
    t = t + "    sList.Clear()" + NL
    t = t + "    rowName.Clear()" + NL
    t = t + "    FOR i = 0 TO vName.Count - 1" + NL
    t = t + "        n = vName[i]" + NL
    t = t + "        IF n.StartsWith(""www."") THEN" + NL
    t = t + "            IF HasWww(n.Substring(4, n.Length - 4)) THEN CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        shown = n" + NL
    t = t + "        IF HasWww(n) THEN shown = n + "" +www""" + NL
    t = t + "        sList.Add(Cols(shown, Serves(vDir[i]), DnsOf(n)))" + NL
    t = t + "        rowName.Add(n)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF keep >= 0 AND keep < sList.Count THEN sList.Selected = keep" + NL
    t = t + "    List_OnSelect()" + NL
    t = t + "    IF page = ""main"" THEN ShowMain()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Chosen () AS String" + NL
    t = t + "    IF sList.Selected < 0 OR sList.Selected >= rowName.Count THEN RETURN """"" + NL
    t = t + "    RETURN rowName[sList.Selected]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB List_OnSelect ()" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    n = Chosen()" + NL
    t = t + "    sEdit.Enabled = n <> """"" + NL
    t = t + "    sRemove.Enabled = n <> """"" + NL
    t = t + "    IF n = """" OR n.StartsWith(""*."") THEN" + NL
    t = t + "        sAddr.Text = """"" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    sAddr.Text = ""In Simxplorer: http://"" + n + ""/"" + EOL + ""In Voyager:    http://"" + here + ""/"" + n + ""/""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the apps" + NL
    t = t + "" + NL
    t = t + "' This machine's web apps, each in a folder of its own (as SimHost puts them):" + NL
    t = t + "' those with an APP.INF, and the known ones from before there was one." + NL
    t = t + "SUB FindApps ()" + NL
    t = t + "    VAR known AS Array OF String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR k AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    appDir.Clear()" + NL
    t = t + "    appName.Clear()" + NL
    t = t + "    known = [""BOOK|BOOK.SPK|SimBook"", ""MAIL|MAIL.SPK|ColdMail"", ""ASK|ASK.SPK|AskSim"", ""GEO|GEO.SPK|GeoSimies"", ""WIKI|WIKI.SPK|WikiSim"", ""ELIZA|BOT.SPK|ELIZA-95"", ""PAL|PAL.SPK|SimPal"", ""TUBE|TUBE.SPK|SimTube"", ""STATS|STATS.SPK|SimStats"", ""VAPOR|CATALOG.TXT|Vapor"", ""NIC|NIC.SPK|SimNIC""]" + NL
    t = t + "    IF NOT FS.Exists(""C:\WEB"") THEN RETURN" + NL
    t = t + "    FOR EACH f IN FS.List(""C:\WEB"")" + NL
    t = t + "        IF NOT f.EndsWith(""\"") THEN CONTINUE" + NL
    t = t + "        f = f.Substring(0, f.Length - 1).Upper()" + NL
    t = t + "        IF f = ""SITES"" THEN CONTINUE" + NL
    t = t + "        IF FS.Exists(""C:\WEB\"" + f + ""\APP.INF"") THEN" + NL
    t = t + "            p = FS.Read(""C:\WEB\"" + f + ""\APP.INF"").Split(""|"")" + NL
    t = t + "            appDir.Add(""C:\WEB\"" + f)" + NL
    t = t + "            appName.Add(p[0].Trim())" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        FOR EACH k IN known" + NL
    t = t + "            p = k.Split(""|"")" + NL
    t = t + "            IF p[0] = f AND FS.Exists(""C:\WEB\"" + f + ""\"" + p[1]) THEN" + NL
    t = t + "                appDir.Add(""C:\WEB\"" + f)" + NL
    t = t + "                appName.Add(p[2])" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A row a app: [x] SimBook  [book    ] .coolsite.sim" + NL
    t = t + "SUB MakeAppRows ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS GUI_CheckBox" + NL
    t = t + "    VAR t AS GUI_TextBox" + NL
    t = t + "    VAR l AS GUI_Label" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    FOR i = 0 TO appDir.Count - 1" + NL
    t = t + "        IF i >= 10 THEN BREAK" + NL
    t = t + "        y = 76 + i * 22" + NL
    t = t + "        c = GUI_CheckBox.New(win)" + NL
    t = t + "        c.SetBounds(116, y, 120, 20)" + NL
    t = t + "        c.Text = appName[i]" + NL
    t = t + "        c.Tag = ""app:"" + appDir[i]" + NL
    t = t + "        aChk.Add(c)" + NL
    t = t + "        t = GUI_TextBox.New(win)" + NL
    t = t + "        t.SetBounds(240, y, 80, 20)" + NL
    t = t + "        t.Tag = ""label:"" + appDir[i]" + NL
    t = t + "        t.MaxLength = 20" + NL
    t = t + "        aLbl.Add(t)" + NL
    t = t + "        l = GUI_Label.New(win)" + NL
    t = t + "        l.SetBounds(324, y + 2, 240, 18)" + NL
    t = t + "        aTail.Add(l)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The first domain the sites are under, to start the apps page with." + NL
    t = t + "FUNCTION FirstDomain () AS String" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    FOR EACH n IN rowName" + NL
    t = t + "        IF NOT n.StartsWith(""*."") AND n.Split(""."").Count = 2 THEN RETURN n" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION AppDomain () AS String" + NL
    t = t + "    VAR d AS String" + NL
    t = t + "    d = aDomain.Text.Trim().Lower()" + NL
    t = t + "    IF d.StartsWith(""www."") THEN d = d.Substring(4, d.Length - 4)" + NL
    t = t + "    IF d.EndsWith(""."") THEN d = d.Substring(0, d.Length - 1)" + NL
    t = t + "    RETURN d" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name under domain that app folder dir has now, or """"." + NL
    t = t + "FUNCTION AppLabel (dir AS String, domain AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    FOR i = 0 TO vName.Count - 1" + NL
    t = t + "        n = vName[i]" + NL
    t = t + "        IF vDir[i] = dir AND n.EndsWith(""."" + domain) THEN" + NL
    t = t + "            n = n.Substring(0, n.Length - domain.Length - 1)" + NL
    t = t + "            IF NOT n.Contains(""."") AND n <> ""*"" AND n <> ""www"" THEN RETURN n" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Domain_OnChange ()" + NL
    t = t + "    FillApps()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB FillApps ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR d AS String" + NL
    t = t + "    VAR has AS String" + NL
    t = t + "    d = AppDomain()" + NL
    t = t + "    FOR i = 0 TO aChk.Count - 1" + NL
    t = t + "        has = """"" + NL
    t = t + "        IF CleanName(d) <> """" THEN has = AppLabel(appDir[i], d)" + NL
    t = t + "        aChk[i].Checked = has <> """"" + NL
    t = t + "        IF has <> """" THEN" + NL
    t = t + "            aLbl[i].Text = has" + NL
    t = t + "        ELSEIF aLbl[i].Text = """" THEN" + NL
    t = t + "            aLbl[i].Text = appDir[i].Substring(7, appDir[i].Length - 7).Lower()" + NL
    t = t + "        END IF" + NL
    t = t + "        IF d = """" THEN" + NL
    t = t + "            aTail[i].Text = "".yourdomain.sim""" + NL
    t = t + "        ELSE" + NL
    t = t + "            aTail[i].Text = ""."" + d" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF aChk.Count = 0 THEN" + NL
    t = t + "        aHint.Text = ""This machine has no web apps in folders of their own (SimHost puts"" + EOL + ""them there). Give the home page a name under Web Sites instead.""" + NL
    t = t + "    ELSE" + NL
    t = t + "        aHint.Text = ""Tick the apps that should have a name under the domain, and Save."" + EOL _" + NL
    t = t + "            + ""Each name must point here at SimNIC too: in Advanced DNS, a CNAME"" + EOL _" + NL
    t = t + "            + ""for each (book CNAME "" + here + ""), or one * CNAME "" + here + "" for them all.""" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SaveApps_Click ()" + NL
    t = t + "    VAR d AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR lbl AS String" + NL
    t = t + "    VAR old AS String" + NL
    t = t + "    VAR added AS Integer" + NL
    t = t + "    VAR removed AS Integer" + NL
    t = t + "    d = CleanName(AppDomain())" + NL
    t = t + "    IF d = """" OR d.StartsWith(""*."") THEN" + NL
    t = t + "        Say(""warn"", ""Type the domain the apps' names go under, like coolsite.sim."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ReadSites()" + NL
    t = t + "    ' first every label, so a bad one changes nothing" + NL
    t = t + "    FOR i = 0 TO aChk.Count - 1" + NL
    t = t + "        IF aChk[i].Checked THEN" + NL
    t = t + "            lbl = aLbl[i].Text.Trim().Lower()" + NL
    t = t + "            IF lbl = """" OR lbl.Contains(""."") OR CleanName(lbl + ""."" + d) = """" OR lbl = ""www"" THEN" + NL
    t = t + "                Say(""warn"", aLbl[i].Text + "" can't be a name under "" + d + "". Use letters, digits and hyphens, like book."")" + NL
    t = t + "                RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR i = 0 TO aChk.Count - 1" + NL
    t = t + "        old = AppLabel(appDir[i], d)" + NL
    t = t + "        lbl = aLbl[i].Text.Trim().Lower()" + NL
    t = t + "        IF aChk[i].Checked THEN" + NL
    t = t + "            IF old <> lbl THEN" + NL
    t = t + "                IF old <> """" THEN DropSite(old + ""."" + d)" + NL
    t = t + "                SetSite(lbl + ""."" + d, appDir[i])" + NL
    t = t + "                Want(lbl + ""."" + d)" + NL
    t = t + "                added = added + 1" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSEIF old <> """" THEN" + NL
    t = t + "            DropSite(old + ""."" + d)" + NL
    t = t + "            removed = removed + 1" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    SaveSites()" + NL
    t = t + "    FillList()" + NL
    t = t + "    FillApps()" + NL
    t = t + "    win.Status = ""Saved: "" + Str(added) + "" names added under "" + d + "", "" + Str(removed) + "" taken away.""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- adding and editing" + NL
    t = t + "" + NL
    t = t + "' A site's name as typed, lower case, or """" when it can't be one: letters," + NL
    t = t + "' digits and hyphens, with at least one dot (a *. in front for every name" + NL
    t = t + "' under a domain)." + NL
    t = t + "FUNCTION CleanName (n AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    n = n.Trim().Lower()" + NL
    t = t + "    IF n.StartsWith(""http://"") THEN n = n.Substring(7, n.Length - 7)" + NL
    t = t + "    IF n.EndsWith(""/"") THEN n = n.Substring(0, n.Length - 1)" + NL
    t = t + "    IF n.EndsWith(""."") THEN n = n.Substring(0, n.Length - 1)" + NL
    t = t + "    rest = n" + NL
    t = t + "    IF rest.StartsWith(""*."") THEN rest = rest.Substring(2, rest.Length - 2)" + NL
    t = t + "    IF rest = """" OR rest.Length > 60 OR NOT rest.Contains(""."") THEN RETURN """"" + NL
    t = t + "    IF rest.StartsWith(""."") OR rest.StartsWith(""-"") OR rest.Contains("".."") THEN RETURN """"" + NL
    t = t + "    FOR i = 0 TO rest.Length - 1" + NL
    t = t + "        IF NOT ""abcdefghijklmnopqrstuvwxyz0123456789-."".Contains(rest.CharAt(i)) THEN RETURN """"" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a site's own pages go: C:\WEB\SITES\COOLSITE for coolsite.sim." + NL
    t = t + "FUNCTION OwnFolder (name AS String) AS String" + NL
    t = t + "    VAR label AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR folder AS String" + NL
    t = t + "    label = """"" + NL
    t = t + "    FOR i = 0 TO name.Length - 1" + NL
    t = t + "        c = name.CharAt(i)" + NL
    t = t + "        IF c = ""."" AND label <> """" AND label <> ""WWW"" THEN BREAK" + NL
    t = t + "        IF c = ""."" THEN" + NL
    t = t + "            label = """"" + NL
    t = t + "        ELSEIF ""abcdefghijklmnopqrstuvwxyz0123456789"".Contains(c) THEN" + NL
    t = t + "            label = label + c.Upper()" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF label = """" THEN label = ""SITE""" + NL
    t = t + "    IF label.Length > 8 THEN label = label.Substring(0, 8)" + NL
    t = t + "    folder = SITES + ""\"" + label" + NL
    t = t + "    ' a folder another site already has is that site's" + NL
    t = t + "    WHILE FolderTaken(folder, name) AND n < 99" + NL
    t = t + "        n = n + 1" + NL
    t = t + "        IF label.Length > 6 THEN label = label.Substring(0, 6)" + NL
    t = t + "        folder = SITES + ""\"" + label + Str(n).PadLeft(2).Replace("" "", ""0"")" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN folder" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION FolderTaken (folder AS String, name AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO vName.Count - 1" + NL
    t = t + "        IF vDir[i] = folder AND vName[i] <> name AND vName[i] <> ""www."" + name AND vName[i] <> dOld AND vName[i] <> ""www."" + dOld THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Makes the folder, with an ""Under construction"" page, if it isn't there." + NL
    t = t + "SUB MakeFolder (folder AS String, name AS String)" + NL
    t = t + "    IF NOT FS.Exists(SITES) THEN FS.MakeDir(SITES)" + NL
    t = t + "    IF NOT FS.Exists(folder) THEN FS.MakeDir(folder)" + NL
    t = t + "    IF FS.Exists(folder + ""\INDEX.HTM"") OR FS.Exists(folder + ""\INDEX.ASP"") THEN RETURN" + NL
    t = t + "    FS.Write(folder + ""\INDEX.HTM"", ""<html><head><title>"" + name + ""</title></head>"" + EOL _" + NL
    t = t + "        + ""<body bgcolor=""""#FFFFFF"""">"" + EOL + ""<center><h1>"" + name + ""</h1>"" + EOL _" + NL
    t = t + "        + ""<p><font size=""""5"""" color=""""#CC0000""""><b>Under construction</b></font></p>"" + EOL _" + NL
    t = t + "        + ""<p>This site is being built. Please come back soon!</p>"" + EOL _" + NL
    t = t + "        + ""<hr width=""""50%""""><p><font size=""""2"""">Published with Personal Web Manager on "" + here + "".<br>"" + EOL _" + NL
    t = t + "        + ""(Its owner puts pages in "" + folder + "".)</font></p></center>"" + EOL _" + NL
    t = t + "        + ""</body></html>"" + EOL)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Add_Click ()" + NL
    t = t + "    SiteDialog("""")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Edit_Click ()" + NL
    t = t + "    IF Chosen() = """" THEN RETURN" + NL
    t = t + "    SiteDialog(Chosen())" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SiteDialog (old AS String)" + NL
    t = t + "    VAR l AS GUI_Label" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    IF NOT IsNothing(dWin) THEN" + NL
    t = t + "        dWin.Focus()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    dOld = old" + NL
    t = t + "    dWin = GUI_Window.New(""Add Web Site"", 400, 250)" + NL
    t = t + "    IF old <> """" THEN dWin.Title = ""Edit Web Site""" + NL
    t = t + "    dWin.Icon = ""network""" + NL
    t = t + "    dWin.Modal = TRUE" + NL
    t = t + "    dWin.onClose = Dialog_OnClose" + NL
    t = t + "    l = GUI_Label.New(dWin)" + NL
    t = t + "    l.SetBounds(10, 12, 80, 20)" + NL
    t = t + "    l.Text = ""Site &name:""" + NL
    t = t + "    dName = GUI_TextBox.New(dWin)" + NL
    t = t + "    dName.SetBounds(96, 10, 290, 22)" + NL
    t = t + "    dName.Tag = ""sitename""" + NL
    t = t + "    dName.onChange = DName_OnChange" + NL
    t = t + "    dWww = GUI_CheckBox.New(dWin)" + NL
    t = t + "    dWww.SetBounds(96, 36, 290, 20)" + NL
    t = t + "    dWww.Tag = ""www""" + NL
    t = t + "    dWww.Checked = TRUE" + NL
    t = t + "    l = GUI_Label.New(dWin)" + NL
    t = t + "    l.SetBounds(10, 66, 380, 20)" + NL
    t = t + "    l.Text = ""It serves:""" + NL
    t = t + "    dOwn = Radio(""&My own pages"", 88, ""own"")" + NL
    t = t + "    dOwnLbl = GUI_Label.New(dWin)" + NL
    t = t + "    dOwnLbl.SetBounds(30, 108, 360, 18)" + NL
    t = t + "    dApp = Radio(""A web &app on this machine:"", 130, ""app"")" + NL
    t = t + "    dApps = GUI_DropDown.New(dWin)" + NL
    t = t + "    dApps.SetBounds(220, 128, 166, 22)" + NL
    t = t + "    FOR i = 0 TO appDir.Count - 1" + NL
    t = t + "        dApps.Add(appName[i] + "" ("" + appDir[i].Substring(7, appDir[i].Length - 7) + "")"")" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF appDir.Count > 0 THEN dApps.Selected = 0" + NL
    t = t + "    dApp.Enabled = appDir.Count > 0" + NL
    t = t + "    dApps.Enabled = appDir.Count > 0" + NL
    t = t + "    dHome = Radio(""This machine's &home page (C:\WEB)"", 156, ""home"")" + NL
    t = t + "    dOk = GUI_Button.New(dWin)" + NL
    t = t + "    dOk.SetBounds(206, 210, 86, 28)" + NL
    t = t + "    dOk.Text = ""OK""" + NL
    t = t + "    dOk.Default = TRUE" + NL
    t = t + "    dOk.onClick = DialogOk_Click" + NL
    t = t + "    dCancel = GUI_Button.New(dWin)" + NL
    t = t + "    dCancel.SetBounds(300, 210, 86, 28)" + NL
    t = t + "    dCancel.Text = ""Cancel""" + NL
    t = t + "    dCancel.Cancel = TRUE" + NL
    t = t + "    dCancel.onClick = DialogCancel_Click" + NL
    t = t + "    dOwn.Checked = TRUE" + NL
    t = t + "    IF old <> """" THEN" + NL
    t = t + "        dName.Text = old" + NL
    t = t + "        dWww.Checked = HasWww(old)" + NL
    t = t + "        dir = DirOf(old)" + NL
    t = t + "        IF dir = ""C:\WEB"" THEN" + NL
    t = t + "            dHome.Checked = TRUE" + NL
    t = t + "        ELSEIF appDir.IndexOf(dir) >= 0 THEN" + NL
    t = t + "            dApp.Checked = TRUE" + NL
    t = t + "            dApps.Selected = appDir.IndexOf(dir)" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    DName_OnChange()" + NL
    t = t + "    dWin.Show()" + NL
    t = t + "    dName.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Radio (text AS String, y AS Integer, tag AS String) AS GUI_RadioButton" + NL
    t = t + "    VAR r AS GUI_RadioButton" + NL
    t = t + "    r = GUI_RadioButton.New(dWin)" + NL
    t = t + "    r.SetBounds(14, y, 300, 20)" + NL
    t = t + "    r.Text = text" + NL
    t = t + "    r.Group = ""serves""" + NL
    t = t + "    r.Tag = tag" + NL
    t = t + "    RETURN r" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB DName_OnChange ()" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    n = CleanName(dName.Text)" + NL
    t = t + "    IF n.StartsWith(""www."") THEN n = n.Substring(4, n.Length - 4)" + NL
    t = t + "    IF n = """" THEN" + NL
    t = t + "        dWww.Text = ""Also www. in front""" + NL
    t = t + "        dOwnLbl.Text = ""(a folder of its own in "" + SITES + "")""" + NL
    t = t + "    ELSE" + NL
    t = t + "        dWww.Text = ""Also www."" + n" + NL
    t = t + "        dOwnLbl.Text = ""(in "" + OwnFolder(n) + "")""" + NL
    t = t + "    END IF" + NL
    t = t + "    dWww.Enabled = NOT n.StartsWith(""*."")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Dialog_OnClose ()" + NL
    t = t + "    dWin = NOTHING" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DialogCancel_Click ()" + NL
    t = t + "    dWin.Close()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DialogOk_Click ()" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    VAR www AS Bool" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    n = CleanName(dName.Text)" + NL
    t = t + "    IF n = """" THEN" + NL
    t = t + "        Say(""warn"", ""Type the site's name, like coolsite.sim: letters, digits and hyphens, with a dot."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    www = dWww.Checked AND NOT n.StartsWith(""*."")" + NL
    t = t + "    IF n.StartsWith(""www."") THEN" + NL
    t = t + "        n = n.Substring(4, n.Length - 4)" + NL
    t = t + "        www = TRUE" + NL
    t = t + "    END IF" + NL
    t = t + "    ReadSites()" + NL
    t = t + "    IF n <> dOld AND DirOf(n) <> """" THEN" + NL
    t = t + "        Say(""warn"", n + "" is already one of this machine's sites. Choose it in the list and press Edit."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF dHome.Checked THEN" + NL
    t = t + "        dir = ""C:\WEB""" + NL
    t = t + "    ELSEIF dApp.Checked AND dApps.Selected >= 0 AND dApps.Selected < appDir.Count THEN" + NL
    t = t + "        dir = appDir[dApps.Selected]" + NL
    t = t + "    ELSE" + NL
    t = t + "        dir = OwnFolder(n)" + NL
    t = t + "        MakeFolder(dir, n)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF dOld <> """" THEN" + NL
    t = t + "        IF HasWww(dOld) THEN DropSite(""www."" + dOld)" + NL
    t = t + "        DropSite(dOld)" + NL
    t = t + "    END IF" + NL
    t = t + "    DropSite(""www."" + n)" + NL
    t = t + "    SetSite(n, dir)" + NL
    t = t + "    IF www THEN SetSite(""www."" + n, dir)" + NL
    t = t + "    SaveSites()" + NL
    t = t + "    Want(n)" + NL
    t = t + "    dWin.Close()" + NL
    t = t + "    FillList()" + NL
    t = t + "    sList.Selected = rowName.IndexOf(n)" + NL
    t = t + "    List_OnSelect()" + NL
    t = t + "    win.Status = n + "" serves "" + Serves(dir) + "". Point it at "" + here.Upper() + "" at SimNIC if you haven't.""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Remove_Click ()" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    n = Chosen()" + NL
    t = t + "    IF n = """" THEN RETURN" + NL
    t = t + "    IF NOT Say(""confirm"", ""Take "" + n + "" off this web server?"" + EOL + EOL + ""Its folder and pages are left where they are, and its name stays yours at SimNIC."") THEN RETURN" + NL
    t = t + "    ReadSites()" + NL
    t = t + "    IF HasWww(n) THEN DropSite(""www."" + n)" + NL
    t = t + "    DropSite(n)" + NL
    t = t + "    SaveSites()" + NL
    t = t + "    FillList()" + NL
    t = t + "    win.Status = n + "" is no longer served here.""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- DNS" + NL
    t = t + "' What the name server says about each site's name, asked one a tick." + NL
    t = t + "" + NL
    t = t + "FUNCTION DnsOf (name AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF name.StartsWith(""*."") THEN RETURN ""-""" + NL
    t = t + "    i = dnsName.IndexOf(name)" + NL
    t = t + "    IF i < 0 THEN RETURN ""checking...""" + NL
    t = t + "    RETURN dnsSays[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Want (name AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF name.StartsWith(""*."") THEN RETURN" + NL
    t = t + "    i = dnsName.IndexOf(name)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        dnsName.RemoveAt(i)" + NL
    t = t + "        dnsSays.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT dnsWant.Contains(name) THEN dnsWant.Add(name)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB CheckAll ()" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    FOR EACH n IN rowName" + NL
    t = t + "        Want(n)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Check_Click ()" + NL
    t = t + "    ' asked again from scratch, and a silent name server is tried again too" + NL
    t = t + "    RsForget()" + NL
    t = t + "    dnsName.Clear()" + NL
    t = t + "    dnsSays.Clear()" + NL
    t = t + "    CheckAll()" + NL
    t = t + "    FillList()" + NL
    t = t + "    win.Status = ""Asking the name server, "" + RsNameServer() + ""...""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Is this machine the one a name leads to?" + NL
    t = t + "FUNCTION IsHere (target AS String) AS Bool" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    t = target.Lower()" + NL
    t = t + "    IF t.EndsWith(""."") THEN t = t.Substring(0, t.Length - 1)" + NL
    t = t + "    RETURN t = here OR t = here.Split(""."")[0] OR t = NET.LocalAddress OR t = ""localhost""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' What the resolver knows about name, in words." + NL
    t = t + "FUNCTION DnsWords (name AS String) AS String" + NL
    t = t + "    IF RsNameServer() = """" THEN RETURN ""no name server""" + NL
    t = t + "    IF RsKnown(name) THEN" + NL
    t = t + "        IF IsHere(RsTarget(name)) THEN RETURN Chr(10003) + "" points here""" + NL
    t = t + "        RETURN ""points at "" + RsTarget(name)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF RsNoSuchName(name) THEN RETURN ""not registered""" + NL
    t = t + "    IF RsSilent() THEN RETURN ""name server not answering""" + NL
    t = t + "    RETURN ""points nowhere""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Clock_OnTick ()" + NL
    t = t + "    ' nothing may come after this TRY: a tick whose question was refused is spoiled" + NL
    t = t + "    TRY" + NL
    t = t + "        Tick()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Tick ()" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    IF ticking THEN RETURN" + NL
    t = t + "    IF page = ""main"" AND SYS.Ticks MOD 1000 < 100 THEN ShowMain()" + NL
    t = t + "    IF dnsWant.Count = 0 THEN RETURN" + NL
    t = t + "    n = dnsWant[0]" + NL
    t = t + "    ticking = TRUE" + NL
    t = t + "    ' asked now (a Connect: the last thing this tick does), or on its way" + NL
    t = t + "    IF RsNext(n) THEN" + NL
    t = t + "        ticking = FALSE" + NL
    t = t + "        win.Status = ""Asking the name server about "" + n + ""...""" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ticking = FALSE" + NL
    t = t + "    dnsWant.RemoveAt(0)" + NL
    t = t + "    dnsName.Add(n)" + NL
    t = t + "    dnsSays.Add(DnsWords(n))" + NL
    t = t + "    FillList()" + NL
    t = t + "    IF dnsWant.Count = 0 THEN win.Status = ""The name server has answered for every site.""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' RESOLVE.SPK - the SimDNS resolver: asks the name server which machine a" + NL
    t = t + "' name like www.coolsite.sim is on." + NL
    t = t + "'" + NL
    t = t + "' The name server is the central one, STARTHERE.56k.net, where SimNIC (the" + NL
    t = t + "' registrar) and NAMED.SPK run, unless C:\SYSTEM\RESOLV.INI says otherwise." + NL
    t = t + "' To move the whole network to another central host, change RSCENTRAL below" + NL
    t = t + "' (the builder sets it from CENTRAL in tools/simxplorer-source.mjs)." + NL
    t = t + "'" + NL
    t = t + "' A library, not a program: a program has it joined on the end (the builder" + NL
    t = t + "' does this for Simxplorer, SimPlayer, Vapor, Frostbird, MAILD, the Sim Shell," + NL
    t = t + "' AskSim's crawler, DIG and Personal Web Manager; copy C:\PROGRAMS\RESOLVE.SPK" + NL
    t = t + "' onto the end of your own). Every name in it starts with Rs, so it can't clash." + NL
    t = t + "'" + NL
    t = t + "' C:\SYSTEM\RESOLV.INI, shared by every program on the machine (optional):" + NL
    t = t + "'     nameserver=dnsbox          another name server instead of the central one" + NL
    t = t + "'     nameserver=none            no SimDNS at all: SIM95 machine names only" + NL
    t = t + "'     search=coolsite.sim        then ""www"" means www.coolsite.sim" + NL
    t = t + "'" + NL
    t = t + "' How to use it without ever waiting in the wrong place (SIM95-NOTES.md):" + NL
    t = t + "'   1. RsWants(host)  - does this name need asking? FALSE for addresses," + NL
    t = t + "'                       plain machine names, names already known, or when" + NL
    t = t + "'                       there is no name server (or it isn't answering)." + NL
    t = t + "'   2. RsAsk(host, address) - sends the question to the name server at that" + NL
    t = t + "'                       address. It is a Connect: let it be the last thing" + NL
    t = t + "'                       the handler does." + NL
    t = t + "'   3. RsBusy()       - TRUE while the answer is on its way. After RSWAIT" + NL
    t = t + "'                       with no answer the server is left alone for RSQUIET," + NL
    t = t + "'                       and every name goes to SIM95 as before." + NL
    t = t + "'   4. RsTarget(host) - where to connect: the machine name (or address) the" + NL
    t = t + "'                       name server gave, or the name itself when SimDNS" + NL
    t = t + "'                       doesn't know it, for SIM95 to look up." + NL
    t = t + "' Answers are kept for their TTL; names SimDNS doesn't know for RSNEG." + NL
    t = t + "'" + NL
    t = t + "' Or, from a timer tick, all of that in one line (see RsNext):" + NL
    t = t + "'     IF RsNext(host) THEN RETURN          ' asked, or waiting: end the tick" + NL
    t = t + "'     conn = sock.Connect(RsTarget(host), 80)" + NL
    t = t + "' and for mail, the domain's MX first (see RsNextMail):" + NL
    t = t + "'     IF RsNextMail(domain) THEN RETURN" + NL
    t = t + "'     conn = sock.Connect(RsMailTarget(domain), 25)" + NL
    t = t + "" + NL
    t = t + "CONST RSCENTRAL = ""starthere.56k.net""   ' the central name server" + NL
    t = t + "CONST RSINI = ""C:\SYSTEM\RESOLV.INI""" + NL
    t = t + "CONST RSPORT = 53" + NL
    t = t + "CONST RSWAIT = 2000             ' ms to wait for an answer" + NL
    t = t + "CONST RSQUIET = 30000            ' ms to leave a silent name server alone" + NL
    t = t + "CONST RSNEG = 60000             ' ms to remember that SimDNS doesn't know a name" + NL
    t = t + "CONST RSMOST = 100              ' names kept" + NL
    t = t + "" + NL
    t = t + "VAR rsServer AS String              ' """" when SimDNS is off" + NL
    t = t + "VAR rsByDefault AS Bool               ' TRUE when RESOLV.INI doesn't name one" + NL
    t = t + "VAR rsSearch AS String" + NL
    t = t + "VAR rsRead AS Bool" + NL
    t = t + "VAR rsReadAt AS Integer" + NL
    t = t + "VAR rsSock AS NET_Socket" + NL
    t = t + "VAR rsName AS Array OF String       ' the name as asked, lower case" + NL
    t = t + "VAR rsTo AS Array OF String         ' where it is ("""" when SimDNS doesn't know it)" + NL
    t = t + "VAR rsCanon AS Array OF String      ' its last name in DNS before the machine" + NL
    t = t + "VAR rsUntil AS Array OF Integer     ' SYS.Ticks when it is forgotten" + NL
    t = t + "VAR rsAsking AS String" + NL
    t = t + "VAR rsAskAt AS Integer" + NL
    t = t + "VAR rsRefused AS Bool" + NL
    t = t + "VAR rsDown AS Bool" + NL
    t = t + "VAR rsDownAt AS Integer" + NL
    t = t + "VAR rsWhy AS String                 ' the last thing that went wrong" + NL
    t = t + "VAR rsLastReply AS String           ' the last answer, as it came" + NL
    t = t + "VAR rsServerAddr AS String          ' the name server's address, for RsNext" + NL
    t = t + "VAR rsServerFor AS String" + NL
    t = t + "VAR rsServerAt AS Integer" + NL
    t = t + "VAR rsLooking AS Bool               ' RsNext is finding the name server's address" + NL
    t = t + "VAR rsLookingAt AS Integer" + NL
    t = t + "" + NL
    t = t + "' Reads RESOLV.INI (again after a few seconds, so a new setting takes)." + NL
    t = t + "' With no nameserver= line, the central name server; none (or nothing after" + NL
    t = t + "' the =) turns SimDNS off." + NL
    t = t + "SUB RsConfig ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    IF rsRead AND SYS.Ticks - rsReadAt < 3000 THEN RETURN" + NL
    t = t + "    rsRead = TRUE" + NL
    t = t + "    rsReadAt = SYS.Ticks" + NL
    t = t + "    rsServer = RSCENTRAL" + NL
    t = t + "    rsByDefault = TRUE" + NL
    t = t + "    rsSearch = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                low = line.Trim().Lower()" + NL
    t = t + "                IF low.StartsWith(""nameserver="") THEN" + NL
    t = t + "                    rsServer = low.Substring(11, low.Length - 11).Trim()" + NL
    t = t + "                    rsByDefault = FALSE" + NL
    t = t + "                END IF" + NL
    t = t + "                IF low.StartsWith(""search="") THEN rsSearch = low.Substring(7, low.Length - 7).Trim()" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF rsServer = ""none"" THEN rsServer = """"" + NL
    t = t + "    IF rsSearch.StartsWith(""."") THEN rsSearch = rsSearch.Substring(1, rsSearch.Length - 1)" + NL
    t = t + "    IF rsSearch.EndsWith(""."") THEN rsSearch = rsSearch.Substring(0, rsSearch.Length - 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The name server (a machine name or address), or """" for none." + NL
    t = t + "FUNCTION RsNameServer () AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsServer" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is it the central one, because RESOLV.INI doesn't say?" + NL
    t = t + "FUNCTION RsIsCentral () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsByDefault" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Makes server this machine's name server, keeping the rest of RESOLV.INI," + NL
    t = t + "' and forgets everything it knew. """" (or none) for no SimDNS at all;" + NL
    t = t + "' default for the central one again." + NL
    t = t + "SUB RsSave (server AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    server = server.Trim().Lower()" + NL
    t = t + "    IF server = """" THEN server = ""none""" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                IF line.Trim() <> """" AND NOT line.Trim().Lower().StartsWith(""nameserver="") THEN out.Add(line)" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "        IF server <> ""default"" THEN out.Insert(0, ""nameserver="" + server)" + NL
    t = t + "        IF out.Count = 0 THEN" + NL
    t = t + "            IF FS.Exists(RSINI) THEN FS.Delete(RSINI)" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Write(RSINI, out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsWhy = err" + NL
    t = t + "    END TRY" + NL
    t = t + "    rsRead = FALSE" + NL
    t = t + "    RsForget()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RsForget ()" + NL
    t = t + "    rsName.Clear()" + NL
    t = t + "    rsTo.Clear()" + NL
    t = t + "    rsCanon.Clear()" + NL
    t = t + "    rsUntil.Clear()" + NL
    t = t + "    rsDown = FALSE" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsIsAddress (s AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF s.Split(""."").Count <> 4 THEN RETURN FALSE" + NL
    t = t + "    FOR EACH p IN s.Split(""."")" + NL
    t = t + "        IF p = """" OR p.Length > 3 THEN RETURN FALSE" + NL
    t = t + "        FOR i = 0 TO p.Length - 1" + NL
    t = t + "            IF NOT ""0123456789"".Contains(p.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name the server is asked about: lower case, the search domain added" + NL
    t = t + "' to a single word." + NL
    t = t + "FUNCTION RsFull (host AS String) AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF h.EndsWith(""."") THEN h = h.Substring(0, h.Length - 1)" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch <> """" THEN h = h + ""."" + rsSearch" + NL
    t = t + "    RETURN h" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a name is in the list of answers, or -1 (old answers are dropped)." + NL
    t = t + "FUNCTION RsFind (host AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = rsName.IndexOf(host.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN -1" + NL
    t = t + "    IF SYS.Ticks > rsUntil[i] THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "        RETURN -1" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsWants (host AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(host) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(host) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for a mail domain's MX record." + NL
    t = t + "FUNCTION RsWantsMx (domain AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(domain) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(""mx:"" + domain.Trim().Lower()) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is host a name for the name server at all (whether known yet or not)?" + NL
    t = t + "FUNCTION RsAsks (host AS String) AS Bool" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF rsServer = """" OR h = """" OR h = ""localhost"" THEN RETURN FALSE" + NL
    t = t + "    IF rsDown AND SYS.Ticks - rsDownAt < RSQUIET THEN RETURN FALSE" + NL
    t = t + "    IF RsIsAddress(h) THEN RETURN FALSE" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch = """" THEN RETURN FALSE" + NL
    t = t + "    IF h = rsServer OR h = NET.HostName.Lower() THEN RETURN FALSE" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Sends the question. A Connect, so it must be the last thing its handler" + NL
    t = t + "' does: if the name server refuses, the handler is spoiled (SIM95-NOTES.md)." + NL
    t = t + "SUB RsAsk (host AS String, address AS String)" + NL
    t = t + "    RsSend(host.Trim().Lower(), ""A"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Asks for a mail domain's MX records (also a Connect: the last thing)." + NL
    t = t + "SUB RsAskMx (domain AS String, address AS String)" + NL
    t = t + "    RsSend(""mx:"" + domain.Trim().Lower(), ""MX"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' key is the name, or mx: and the name; the answer is kept under it." + NL
    t = t + "SUB RsSend (key AS String, qtype AS String, address AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    IF IsNothing(rsSock) THEN" + NL
    t = t + "        rsSock = NET_Socket.New()" + NL
    t = t + "        rsSock.onMessage = Rs_OnMessage" + NL
    t = t + "    END IF" + NL
    t = t + "    name = key" + NL
    t = t + "    IF name.StartsWith(""mx:"") THEN name = name.Substring(3, name.Length - 3)" + NL
    t = t + "    rsAsking = key" + NL
    t = t + "    rsAskAt = SYS.Ticks" + NL
    t = t + "    rsRefused = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = rsSock.Connect(address, RSPORT)" + NL
    t = t + "        conn.Tag = ""rs:"" + key" + NL
    t = t + "        conn.Send(""QUERY "" + RsFull(name) + "" "" + qtype)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsRefused = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Gives up on the name server for a while: every name goes to SIM95." + NL
    t = t + "SUB RsGiveUp (why AS String)" + NL
    t = t + "    rsWhy = why" + NL
    t = t + "    rsDown = TRUE" + NL
    t = t + "    rsDownAt = SYS.Ticks" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "    rsServerAddr = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' For a program that fetches from a timer tick: TRUE when the tick must end" + NL
    t = t + "' now, because a question about host has just been sent (a Connect, so it" + NL
    t = t + "' has to be the last thing the handler does) or an answer is on its way." + NL
    t = t + "' FALSE when there is nothing to ask: RsTarget(host) is where to connect." + NL
    t = t + "' A name server that is missing, refuses or says nothing for RSWAIT is left" + NL
    t = t + "' alone for RSQUIET, and every name goes to SIM95: nothing ever hangs." + NL
    t = t + "FUNCTION RsNext (host AS String) AS Bool" + NL
    t = t + "    RETURN RsStep(host, FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for mail to domain: its MX record (the lowest preference), then" + NL
    t = t + "' the CNAMEs or address of the machine that names. RsMailTarget(domain) is" + NL
    t = t + "' then where to connect; with no MX, the domain's own machine; with no" + NL
    t = t + "' answer at all, the domain itself, for SIM95 to look up." + NL
    t = t + "FUNCTION RsNextMail (domain AS String) AS Bool" + NL
    t = t + "    IF RsStep(domain, TRUE) THEN RETURN TRUE" + NL
    t = t + "    RETURN RsStep(RsMailHost(domain), FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsStep (host AS String, mx AS Bool) AS Bool" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    ' another handler is finding the name server (it waits): wait for it" + NL
    t = t + "    IF rsLooking THEN" + NL
    t = t + "        IF SYS.Ticks - rsLookingAt < RSWAIT THEN RETURN TRUE" + NL
    t = t + "        rsLooking = FALSE" + NL
    t = t + "        RsGiveUp(""no answer about the machine "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF RsBusy() THEN RETURN TRUE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        IF NOT RsWantsMx(host) THEN RETURN FALSE" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF NOT RsWants(host) THEN RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    addr = RsServerAddress()" + NL
    t = t + "    IF addr = """" THEN RETURN FALSE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        RsAskMx(host, addr)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsAsk(host, addr)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name server's address, looked up once a minute (one lookup at a time:" + NL
    t = t + "' see SIM95-NOTES.md). """" when there is no such machine, and then it gives up." + NL
    t = t + "FUNCTION RsServerAddress () AS String" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    IF RsIsAddress(rsServer) THEN RETURN rsServer" + NL
    t = t + "    IF rsServerAddr <> """" AND rsServerFor = rsServer AND SYS.Ticks - rsServerAt < 60000 AND SYS.Ticks >= rsServerAt THEN RETURN rsServerAddr" + NL
    t = t + "    rsLooking = TRUE" + NL
    t = t + "    rsLookingAt = SYS.Ticks" + NL
    t = t + "    addr = NET.Resolve(rsServer)" + NL
    t = t + "    IF NOT rsLooking THEN RETURN """"" + NL
    t = t + "    rsLooking = FALSE" + NL
    t = t + "    IF addr = """" THEN" + NL
    t = t + "        RsGiveUp(""there is no machine called "" + rsServer)" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    rsServerAddr = addr" + NL
    t = t + "    rsServerFor = rsServer" + NL
    t = t + "    rsServerAt = SYS.Ticks" + NL
    t = t + "    RETURN addr" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsBusy () AS Bool" + NL
    t = t + "    IF rsAsking = """" THEN RETURN FALSE" + NL
    t = t + "    IF rsRefused THEN" + NL
    t = t + "        RsGiveUp(""the name server "" + rsServer + "" refused"")" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF SYS.Ticks - rsAskAt > RSWAIT THEN" + NL
    t = t + "        RsGiveUp(""no answer from the name server "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Rs_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    IF NOT conn.Tag.StartsWith(""rs:"") THEN RETURN" + NL
    t = t + "    h = conn.Tag.Substring(3, conn.Tag.Length - 3)" + NL
    t = t + "    conn.Tag = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        conn.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    RsTake(h, message)" + NL
    t = t + "    IF h = rsAsking THEN rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an answer: follows its CNAMEs to an address, or to the machine" + NL
    t = t + "' name the chain ends at." + NL
    t = t + "SUB RsTake (host AS String, reply AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR onward AS String" + NL
    t = t + "    VAR target AS String" + NL
    t = t + "    VAR canon AS String" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR hops AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    rsLastReply = reply" + NL
    t = t + "    IF host.StartsWith(""mx:"") THEN" + NL
    t = t + "        RsTakeMx(host, reply)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(host, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(host, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    cur = RsFull(host)" + NL
    t = t + "    canon = cur" + NL
    t = t + "    FOR hops = 0 TO 8" + NL
    t = t + "        onward = """"" + NL
    t = t + "        FOR i = 1 TO lines.Count - 1" + NL
    t = t + "            w = lines[i].Split("" "")" + NL
    t = t + "            IF w.Count >= 4 THEN" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""A"" AND target = """" THEN target = w[3]" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""CNAME"" THEN onward = w[3]" + NL
    t = t + "                IF w[0] = cur AND (w[2] = ""A"" OR w[2] = ""CNAME"") AND Int(Val(w[1])) < ttl THEN ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF target <> """" THEN" + NL
    t = t + "            canon = cur" + NL
    t = t + "            BREAK" + NL
    t = t + "        END IF" + NL
    t = t + "        IF onward = """" THEN BREAK" + NL
    t = t + "        canon = cur" + NL
    t = t + "        cur = onward" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF target = """" THEN" + NL
    t = t + "        ' a name with no CNAME and no address: not one to connect to" + NL
    t = t + "        IF cur = RsFull(host) THEN" + NL
    t = t + "            RsKeep(host, """", """", RSNEG)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        ' the end of the chain: a SIM95 machine name" + NL
    t = t + "        target = cur" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ttl < 5 THEN ttl = 5" + NL
    t = t + "    RsKeep(host, target, canon, ttl * 1000)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an MX answer: the mail machine with the lowest preference. With no" + NL
    t = t + "' MX, the server answers with the domain's CNAMEs instead, and the domain's" + NL
    t = t + "' own machine takes the mail." + NL
    t = t + "SUB RsTakeMx (key AS String, reply AS String)" + NL
    t = t + "    VAR domain AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR best AS String" + NL
    t = t + "    VAR pref AS Integer = 1000000" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    domain = key.Substring(3, key.Length - 3)" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(key, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RsKeep(domain, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(key, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 1 TO lines.Count - 1" + NL
    t = t + "        w = lines[i].Split("" "")" + NL
    t = t + "        IF w.Count >= 5 THEN" + NL
    t = t + "            IF w[2] = ""MX"" AND Int(Val(w[3])) < pref THEN" + NL
    t = t + "                pref = Int(Val(w[3]))" + NL
    t = t + "                best = w[4]" + NL
    t = t + "                ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF best <> """" THEN" + NL
    t = t + "        IF best.EndsWith(""."") THEN best = best.Substring(0, best.Length - 1)" + NL
    t = t + "        IF ttl < 5 THEN ttl = 5" + NL
    t = t + "        RsKeep(key, best, RsFull(domain), ttl * 1000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    RsTake(domain, reply)" + NL
    t = t + "    IF RsKnown(domain) THEN" + NL
    t = t + "        RsKeep(key, domain, RsFull(domain), RSNEG)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsKeep(key, """", """", RSNEG)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The machine (or name) that takes domain's mail: its MX, or domain itself." + NL
    t = t + "FUNCTION RsMailHost (domain AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN domain" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN domain" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where to connect for domain's mail." + NL
    t = t + "FUNCTION RsMailTarget (domain AS String) AS String" + NL
    t = t + "    RETURN RsTarget(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS say where domain's mail goes (an MX, or the domain's machine)?" + NL
    t = t + "FUNCTION RsMailKnown (domain AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN FALSE" + NL
    t = t + "    RETURN RsKnown(RsMailHost(domain)) OR NOT RsAsks(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB RsKeep (host AS String, target AS String, canon AS String, ms AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    i = rsName.IndexOf(h)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF rsName.Count >= RSMOST THEN" + NL
    t = t + "        rsName.RemoveAt(0)" + NL
    t = t + "        rsTo.RemoveAt(0)" + NL
    t = t + "        rsCanon.RemoveAt(0)" + NL
    t = t + "        rsUntil.RemoveAt(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    rsName.Add(h)" + NL
    t = t + "    rsTo.Add(target)" + NL
    t = t + "    rsCanon.Add(canon)" + NL
    t = t + "    rsUntil.Add(SYS.Ticks + ms)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where to connect for host: what SimDNS said, or host itself." + NL
    t = t + "FUNCTION RsTarget (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name host's machine was found under (www.coolsite.sim), or host." + NL
    t = t + "FUNCTION RsCanonical (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsCanon[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS answer for host (so RsTarget is its machine)?" + NL
    t = t + "FUNCTION RsKnown (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] <> """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did the name server say there is no such name (NXDOMAIN)?" + NL
    t = t + "FUNCTION RsNoSuchName (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] = """" AND rsCanon[i] = ""NXDOMAIN""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is the name server being left alone, because it didn't answer (or there" + NL
    t = t + "' is none)? rsWhy says why." + NL
    t = t + "FUNCTION RsSilent () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    IF rsServer = """" THEN RETURN TRUE" + NL
    t = t + "    RETURN rsDown AND SYS.Ticks - rsDownAt < RSQUIET" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\PROGRAMS\PWM.SPK")
END SUB

SUB File1 ()
    t = ""
    t = t + "' DIG.SPK - asks a SimDNS name server about a name, like dig on Unix." + NL
    t = t + "' From the Terminal or the Sim Shell:" + NL
    t = t + "'     DIG www.coolsite.sim               where is it? (the CNAMEs to its machine)" + NL
    t = t + "'     DIG coolsite.sim MX                its mail machine (also TXT, NS, SOA, ANY)" + NL
    t = t + "'     DIG www.coolsite.sim ANY @bravo    ask BRAVO instead of the usual server" + NL
    t = t + "'     DIG SET dnsbox                     use DNSBOX's SimDNS from now on" + NL
    t = t + "'     DIG SET NONE                       stop using SimDNS (machine names only)" + NL
    t = t + "'     DIG SET DEFAULT                    the central name server again" + NL
    t = t + "'     DIG SET                            which name server is it?" + NL
    t = t + "' The usual name server is the central one (STARTHERE.56k.net), unless" + NL
    t = t + "' C:\SYSTEM\RESOLV.INI says otherwise; Simxplorer's Options and every" + NL
    t = t + "' program that uses RESOLVE.SPK read it. The builder joins RESOLVE.SPK onto" + NL
    t = t + "' the end of this file." + NL
    t = t + "" + NL
    t = t + "VAR digReply AS String" + NL
    t = t + "VAR digSock AS NET_Socket" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    VAR args AS Array OF String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR qtype AS String = ""A""" + NL
    t = t + "    VAR server AS String" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR started AS Integer" + NL
    t = t + "    VAR failed AS String" + NL
    t = t + "    FOR EACH a IN SYS.Args" + NL
    t = t + "        IF a.Trim() <> """" THEN args.Add(a.Trim())" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF args.Count = 0 THEN" + NL
    t = t + "        Print(""Usage: DIG name [type] [@server]      types: A CNAME MX TXT NS SOA ANY"")" + NL
    t = t + "        Print(""       DIG SET machine                  make machine this computer's name server"")" + NL
    t = t + "        Print(""       DIG SET DEFAULT                  the central one, "" + RSCENTRAL)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF args[0].Upper() = ""SET"" THEN" + NL
    t = t + "        SetServer(args)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    FOR EACH a IN args" + NL
    t = t + "        IF a.StartsWith(""@"") THEN" + NL
    t = t + "            server = a.Substring(1, a.Length - 1).Lower()" + NL
    t = t + "        ELSEIF ""|A|CNAME|MX|TXT|NS|SOA|ANY|"".Contains(""|"" + a.Upper() + ""|"") AND name <> """" THEN" + NL
    t = t + "            qtype = a.Upper()" + NL
    t = t + "        ELSE" + NL
    t = t + "            name = a.Lower()" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF name = """" THEN" + NL
    t = t + "        Print(""Which name? For example:  DIG www.coolsite.sim"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF server = """" THEN server = RsNameServer()" + NL
    t = t + "    IF server = """" THEN" + NL
    t = t + "        Print("";; SimDNS is off (nameserver=none in C:\SYSTEM\RESOLV.INI). DIG SET DEFAULT turns it on."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    Print("""")" + NL
    t = t + "    Print(""; <<>> DiG 2.1 for SIM95 (SimDNS) <<>> "" + name + "" "" + qtype)" + NL
    t = t + "    addr = NET.Resolve(server)" + NL
    t = t + "    IF addr = """" THEN" + NL
    t = t + "        Print("";; connection failed: there is no machine called "" + server)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    digSock = NET_Socket.New()" + NL
    t = t + "    digSock.onMessage = Dig_OnMessage" + NL
    t = t + "    started = SYS.Ticks" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = digSock.Connect(addr, RSPORT)" + NL
    t = t + "        conn.Send(""QUERY "" + RsFull(name) + "" "" + qtype)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        failed = err" + NL
    t = t + "    END TRY" + NL
    t = t + "    ' A refused Connect spoils this handler (SIM95-NOTES.md): no more waiting." + NL
    t = t + "    IF failed <> """" THEN" + NL
    t = t + "        Print("";; connection to "" + server + "" ("" + addr + "") port 53 failed: "" + failed.Split("":"")[0] + "". Is NAMED.SPK running there?"")" + NL
    t = t + "        SYS.Exit(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    WHILE digReply = """" AND SYS.Ticks - started < 3000" + NL
    t = t + "        SYS.Sleep(50)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF digReply = """" THEN" + NL
    t = t + "        Print("";; connection timed out; no answer from "" + server)" + NL
    t = t + "        SYS.Exit(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    Show(name, qtype, server, addr, SYS.Ticks - started)" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Dig_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    digReply = message" + NL
    t = t + "    conn.Close()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Prints the answer the way dig did, and where a machine name leads." + NL
    t = t + "SUB Show (name AS String, qtype AS String, server AS String, addr AS String, ms AS Integer)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR status AS String" + NL
    t = t + "    VAR last AS String" + NL
    t = t + "    VAR machine AS String" + NL
    t = t + "    lines = digReply.Lines()" + NL
    t = t + "    status = lines[0].Split("" "")[0]" + NL
    t = t + "    IF status = ""OK"" THEN status = ""NOERROR""" + NL
    t = t + "    Print("";; ->>HEADER<<- status: "" + status + "", answers: "" + Str(lines.Count - 1))" + NL
    t = t + "    IF lines[0].Contains("" "") THEN Print("";; "" + lines[0].Substring(lines[0].IndexOf("" "") + 1, lines[0].Length - lines[0].IndexOf("" "") - 1))" + NL
    t = t + "    Print("""")" + NL
    t = t + "    Print("";; QUESTION SECTION:"")" + NL
    t = t + "    Print("";"" + (RsFull(name) + ""."").PadRight(31) + "" IN  "" + qtype)" + NL
    t = t + "    IF lines.Count > 1 THEN" + NL
    t = t + "        Print("""")" + NL
    t = t + "        Print("";; ANSWER SECTION:"")" + NL
    t = t + "        FOR i = 1 TO lines.Count - 1" + NL
    t = t + "            w = lines[i].Split("" "")" + NL
    t = t + "            IF w.Count < 4 THEN CONTINUE" + NL
    t = t + "            Print((w[0] + ""."").PadRight(24) + "" "" + w[1].PadRight(6) + "" IN  "" + w[2].PadRight(6) + "" "" + Rest(w, 3))" + NL
    t = t + "            IF w[2] = ""CNAME"" THEN last = w[3]" + NL
    t = t + "            IF w[2] = ""A"" THEN last = """"" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    ' a CNAME chain that ends at a name SimDNS doesn't know ends at a machine" + NL
    t = t + "    IF last <> """" THEN" + NL
    t = t + "        machine = last" + NL
    t = t + "        FOR i = 1 TO lines.Count - 1" + NL
    t = t + "            IF lines[i].StartsWith(last + "" "") THEN machine = """"" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF machine <> """" THEN" + NL
    t = t + "            Print("""")" + NL
    t = t + "            Print("";; "" + machine + "" is a SIM95 machine name: "" + Where(machine) + "" (asked SIM95, not SimDNS)"")" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    Print("""")" + NL
    t = t + "    Print("";; Query time: "" + Str(ms) + "" msec"")" + NL
    t = t + "    Print("";; SERVER: "" + server + "" ("" + addr + "") port 53"")" + NL
    t = t + "    Print("";; WHEN: "" + TIME.Date + "" "" + TIME.Clock)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Where (machine AS String) AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    a = NET.Resolve(machine)" + NL
    t = t + "    IF a = """" THEN RETURN ""not on the network now""" + NL
    t = t + "    RETURN a" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Rest (w AS Array OF String, at AS Integer) AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = at TO w.Count - 1" + NL
    t = t + "        out.Add(w[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out.Join("" "")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SetServer (args AS Array OF String)" + NL
    t = t + "    IF args.Count < 2 THEN" + NL
    t = t + "        IF RsNameServer() = """" THEN" + NL
    t = t + "            Print(""SimDNS is off: names are SIM95 machine names only."")" + NL
    t = t + "        ELSEIF RsIsCentral() THEN" + NL
    t = t + "            Print(""The name server is "" + RsNameServer() + "", the central one."")" + NL
    t = t + "        ELSE" + NL
    t = t + "            Print(""The name server is "" + RsNameServer() + "" (C:\SYSTEM\RESOLV.INI)."")" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF args[1].Upper() = ""NONE"" THEN" + NL
    t = t + "        RsSave(""none"")" + NL
    t = t + "        Print(""No name server now: names are SIM95 machine names only."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF args[1].Upper() = ""DEFAULT"" THEN" + NL
    t = t + "        RsSave(""default"")" + NL
    t = t + "        Print(""The name server is the central one again: "" + RSCENTRAL + ""."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    RsSave(args[1])" + NL
    t = t + "    Print(""The name server is now "" + args[1].Lower() + "" (C:\SYSTEM\RESOLV.INI). Simxplorer uses it too."")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' RESOLVE.SPK - the SimDNS resolver: asks the name server which machine a" + NL
    t = t + "' name like www.coolsite.sim is on." + NL
    t = t + "'" + NL
    t = t + "' The name server is the central one, STARTHERE.56k.net, where SimNIC (the" + NL
    t = t + "' registrar) and NAMED.SPK run, unless C:\SYSTEM\RESOLV.INI says otherwise." + NL
    t = t + "' To move the whole network to another central host, change RSCENTRAL below" + NL
    t = t + "' (the builder sets it from CENTRAL in tools/simxplorer-source.mjs)." + NL
    t = t + "'" + NL
    t = t + "' A library, not a program: a program has it joined on the end (the builder" + NL
    t = t + "' does this for Simxplorer, SimPlayer, Vapor, Frostbird, MAILD, the Sim Shell," + NL
    t = t + "' AskSim's crawler, DIG and Personal Web Manager; copy C:\PROGRAMS\RESOLVE.SPK" + NL
    t = t + "' onto the end of your own). Every name in it starts with Rs, so it can't clash." + NL
    t = t + "'" + NL
    t = t + "' C:\SYSTEM\RESOLV.INI, shared by every program on the machine (optional):" + NL
    t = t + "'     nameserver=dnsbox          another name server instead of the central one" + NL
    t = t + "'     nameserver=none            no SimDNS at all: SIM95 machine names only" + NL
    t = t + "'     search=coolsite.sim        then ""www"" means www.coolsite.sim" + NL
    t = t + "'" + NL
    t = t + "' How to use it without ever waiting in the wrong place (SIM95-NOTES.md):" + NL
    t = t + "'   1. RsWants(host)  - does this name need asking? FALSE for addresses," + NL
    t = t + "'                       plain machine names, names already known, or when" + NL
    t = t + "'                       there is no name server (or it isn't answering)." + NL
    t = t + "'   2. RsAsk(host, address) - sends the question to the name server at that" + NL
    t = t + "'                       address. It is a Connect: let it be the last thing" + NL
    t = t + "'                       the handler does." + NL
    t = t + "'   3. RsBusy()       - TRUE while the answer is on its way. After RSWAIT" + NL
    t = t + "'                       with no answer the server is left alone for RSQUIET," + NL
    t = t + "'                       and every name goes to SIM95 as before." + NL
    t = t + "'   4. RsTarget(host) - where to connect: the machine name (or address) the" + NL
    t = t + "'                       name server gave, or the name itself when SimDNS" + NL
    t = t + "'                       doesn't know it, for SIM95 to look up." + NL
    t = t + "' Answers are kept for their TTL; names SimDNS doesn't know for RSNEG." + NL
    t = t + "'" + NL
    t = t + "' Or, from a timer tick, all of that in one line (see RsNext):" + NL
    t = t + "'     IF RsNext(host) THEN RETURN          ' asked, or waiting: end the tick" + NL
    t = t + "'     conn = sock.Connect(RsTarget(host), 80)" + NL
    t = t + "' and for mail, the domain's MX first (see RsNextMail):" + NL
    t = t + "'     IF RsNextMail(domain) THEN RETURN" + NL
    t = t + "'     conn = sock.Connect(RsMailTarget(domain), 25)" + NL
    t = t + "" + NL
    t = t + "CONST RSCENTRAL = ""starthere.56k.net""   ' the central name server" + NL
    t = t + "CONST RSINI = ""C:\SYSTEM\RESOLV.INI""" + NL
    t = t + "CONST RSPORT = 53" + NL
    t = t + "CONST RSWAIT = 2000             ' ms to wait for an answer" + NL
    t = t + "CONST RSQUIET = 30000            ' ms to leave a silent name server alone" + NL
    t = t + "CONST RSNEG = 60000             ' ms to remember that SimDNS doesn't know a name" + NL
    t = t + "CONST RSMOST = 100              ' names kept" + NL
    t = t + "" + NL
    t = t + "VAR rsServer AS String              ' """" when SimDNS is off" + NL
    t = t + "VAR rsByDefault AS Bool               ' TRUE when RESOLV.INI doesn't name one" + NL
    t = t + "VAR rsSearch AS String" + NL
    t = t + "VAR rsRead AS Bool" + NL
    t = t + "VAR rsReadAt AS Integer" + NL
    t = t + "VAR rsSock AS NET_Socket" + NL
    t = t + "VAR rsName AS Array OF String       ' the name as asked, lower case" + NL
    t = t + "VAR rsTo AS Array OF String         ' where it is ("""" when SimDNS doesn't know it)" + NL
    t = t + "VAR rsCanon AS Array OF String      ' its last name in DNS before the machine" + NL
    t = t + "VAR rsUntil AS Array OF Integer     ' SYS.Ticks when it is forgotten" + NL
    t = t + "VAR rsAsking AS String" + NL
    t = t + "VAR rsAskAt AS Integer" + NL
    t = t + "VAR rsRefused AS Bool" + NL
    t = t + "VAR rsDown AS Bool" + NL
    t = t + "VAR rsDownAt AS Integer" + NL
    t = t + "VAR rsWhy AS String                 ' the last thing that went wrong" + NL
    t = t + "VAR rsLastReply AS String           ' the last answer, as it came" + NL
    t = t + "VAR rsServerAddr AS String          ' the name server's address, for RsNext" + NL
    t = t + "VAR rsServerFor AS String" + NL
    t = t + "VAR rsServerAt AS Integer" + NL
    t = t + "VAR rsLooking AS Bool               ' RsNext is finding the name server's address" + NL
    t = t + "VAR rsLookingAt AS Integer" + NL
    t = t + "" + NL
    t = t + "' Reads RESOLV.INI (again after a few seconds, so a new setting takes)." + NL
    t = t + "' With no nameserver= line, the central name server; none (or nothing after" + NL
    t = t + "' the =) turns SimDNS off." + NL
    t = t + "SUB RsConfig ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    IF rsRead AND SYS.Ticks - rsReadAt < 3000 THEN RETURN" + NL
    t = t + "    rsRead = TRUE" + NL
    t = t + "    rsReadAt = SYS.Ticks" + NL
    t = t + "    rsServer = RSCENTRAL" + NL
    t = t + "    rsByDefault = TRUE" + NL
    t = t + "    rsSearch = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                low = line.Trim().Lower()" + NL
    t = t + "                IF low.StartsWith(""nameserver="") THEN" + NL
    t = t + "                    rsServer = low.Substring(11, low.Length - 11).Trim()" + NL
    t = t + "                    rsByDefault = FALSE" + NL
    t = t + "                END IF" + NL
    t = t + "                IF low.StartsWith(""search="") THEN rsSearch = low.Substring(7, low.Length - 7).Trim()" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF rsServer = ""none"" THEN rsServer = """"" + NL
    t = t + "    IF rsSearch.StartsWith(""."") THEN rsSearch = rsSearch.Substring(1, rsSearch.Length - 1)" + NL
    t = t + "    IF rsSearch.EndsWith(""."") THEN rsSearch = rsSearch.Substring(0, rsSearch.Length - 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The name server (a machine name or address), or """" for none." + NL
    t = t + "FUNCTION RsNameServer () AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsServer" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is it the central one, because RESOLV.INI doesn't say?" + NL
    t = t + "FUNCTION RsIsCentral () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsByDefault" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Makes server this machine's name server, keeping the rest of RESOLV.INI," + NL
    t = t + "' and forgets everything it knew. """" (or none) for no SimDNS at all;" + NL
    t = t + "' default for the central one again." + NL
    t = t + "SUB RsSave (server AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    server = server.Trim().Lower()" + NL
    t = t + "    IF server = """" THEN server = ""none""" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                IF line.Trim() <> """" AND NOT line.Trim().Lower().StartsWith(""nameserver="") THEN out.Add(line)" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "        IF server <> ""default"" THEN out.Insert(0, ""nameserver="" + server)" + NL
    t = t + "        IF out.Count = 0 THEN" + NL
    t = t + "            IF FS.Exists(RSINI) THEN FS.Delete(RSINI)" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Write(RSINI, out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsWhy = err" + NL
    t = t + "    END TRY" + NL
    t = t + "    rsRead = FALSE" + NL
    t = t + "    RsForget()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RsForget ()" + NL
    t = t + "    rsName.Clear()" + NL
    t = t + "    rsTo.Clear()" + NL
    t = t + "    rsCanon.Clear()" + NL
    t = t + "    rsUntil.Clear()" + NL
    t = t + "    rsDown = FALSE" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsIsAddress (s AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF s.Split(""."").Count <> 4 THEN RETURN FALSE" + NL
    t = t + "    FOR EACH p IN s.Split(""."")" + NL
    t = t + "        IF p = """" OR p.Length > 3 THEN RETURN FALSE" + NL
    t = t + "        FOR i = 0 TO p.Length - 1" + NL
    t = t + "            IF NOT ""0123456789"".Contains(p.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name the server is asked about: lower case, the search domain added" + NL
    t = t + "' to a single word." + NL
    t = t + "FUNCTION RsFull (host AS String) AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF h.EndsWith(""."") THEN h = h.Substring(0, h.Length - 1)" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch <> """" THEN h = h + ""."" + rsSearch" + NL
    t = t + "    RETURN h" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a name is in the list of answers, or -1 (old answers are dropped)." + NL
    t = t + "FUNCTION RsFind (host AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = rsName.IndexOf(host.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN -1" + NL
    t = t + "    IF SYS.Ticks > rsUntil[i] THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "        RETURN -1" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsWants (host AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(host) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(host) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for a mail domain's MX record." + NL
    t = t + "FUNCTION RsWantsMx (domain AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(domain) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(""mx:"" + domain.Trim().Lower()) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is host a name for the name server at all (whether known yet or not)?" + NL
    t = t + "FUNCTION RsAsks (host AS String) AS Bool" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF rsServer = """" OR h = """" OR h = ""localhost"" THEN RETURN FALSE" + NL
    t = t + "    IF rsDown AND SYS.Ticks - rsDownAt < RSQUIET THEN RETURN FALSE" + NL
    t = t + "    IF RsIsAddress(h) THEN RETURN FALSE" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch = """" THEN RETURN FALSE" + NL
    t = t + "    IF h = rsServer OR h = NET.HostName.Lower() THEN RETURN FALSE" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Sends the question. A Connect, so it must be the last thing its handler" + NL
    t = t + "' does: if the name server refuses, the handler is spoiled (SIM95-NOTES.md)." + NL
    t = t + "SUB RsAsk (host AS String, address AS String)" + NL
    t = t + "    RsSend(host.Trim().Lower(), ""A"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Asks for a mail domain's MX records (also a Connect: the last thing)." + NL
    t = t + "SUB RsAskMx (domain AS String, address AS String)" + NL
    t = t + "    RsSend(""mx:"" + domain.Trim().Lower(), ""MX"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' key is the name, or mx: and the name; the answer is kept under it." + NL
    t = t + "SUB RsSend (key AS String, qtype AS String, address AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    IF IsNothing(rsSock) THEN" + NL
    t = t + "        rsSock = NET_Socket.New()" + NL
    t = t + "        rsSock.onMessage = Rs_OnMessage" + NL
    t = t + "    END IF" + NL
    t = t + "    name = key" + NL
    t = t + "    IF name.StartsWith(""mx:"") THEN name = name.Substring(3, name.Length - 3)" + NL
    t = t + "    rsAsking = key" + NL
    t = t + "    rsAskAt = SYS.Ticks" + NL
    t = t + "    rsRefused = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = rsSock.Connect(address, RSPORT)" + NL
    t = t + "        conn.Tag = ""rs:"" + key" + NL
    t = t + "        conn.Send(""QUERY "" + RsFull(name) + "" "" + qtype)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsRefused = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Gives up on the name server for a while: every name goes to SIM95." + NL
    t = t + "SUB RsGiveUp (why AS String)" + NL
    t = t + "    rsWhy = why" + NL
    t = t + "    rsDown = TRUE" + NL
    t = t + "    rsDownAt = SYS.Ticks" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "    rsServerAddr = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' For a program that fetches from a timer tick: TRUE when the tick must end" + NL
    t = t + "' now, because a question about host has just been sent (a Connect, so it" + NL
    t = t + "' has to be the last thing the handler does) or an answer is on its way." + NL
    t = t + "' FALSE when there is nothing to ask: RsTarget(host) is where to connect." + NL
    t = t + "' A name server that is missing, refuses or says nothing for RSWAIT is left" + NL
    t = t + "' alone for RSQUIET, and every name goes to SIM95: nothing ever hangs." + NL
    t = t + "FUNCTION RsNext (host AS String) AS Bool" + NL
    t = t + "    RETURN RsStep(host, FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for mail to domain: its MX record (the lowest preference), then" + NL
    t = t + "' the CNAMEs or address of the machine that names. RsMailTarget(domain) is" + NL
    t = t + "' then where to connect; with no MX, the domain's own machine; with no" + NL
    t = t + "' answer at all, the domain itself, for SIM95 to look up." + NL
    t = t + "FUNCTION RsNextMail (domain AS String) AS Bool" + NL
    t = t + "    IF RsStep(domain, TRUE) THEN RETURN TRUE" + NL
    t = t + "    RETURN RsStep(RsMailHost(domain), FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsStep (host AS String, mx AS Bool) AS Bool" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    ' another handler is finding the name server (it waits): wait for it" + NL
    t = t + "    IF rsLooking THEN" + NL
    t = t + "        IF SYS.Ticks - rsLookingAt < RSWAIT THEN RETURN TRUE" + NL
    t = t + "        rsLooking = FALSE" + NL
    t = t + "        RsGiveUp(""no answer about the machine "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF RsBusy() THEN RETURN TRUE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        IF NOT RsWantsMx(host) THEN RETURN FALSE" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF NOT RsWants(host) THEN RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    addr = RsServerAddress()" + NL
    t = t + "    IF addr = """" THEN RETURN FALSE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        RsAskMx(host, addr)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsAsk(host, addr)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name server's address, looked up once a minute (one lookup at a time:" + NL
    t = t + "' see SIM95-NOTES.md). """" when there is no such machine, and then it gives up." + NL
    t = t + "FUNCTION RsServerAddress () AS String" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    IF RsIsAddress(rsServer) THEN RETURN rsServer" + NL
    t = t + "    IF rsServerAddr <> """" AND rsServerFor = rsServer AND SYS.Ticks - rsServerAt < 60000 AND SYS.Ticks >= rsServerAt THEN RETURN rsServerAddr" + NL
    t = t + "    rsLooking = TRUE" + NL
    t = t + "    rsLookingAt = SYS.Ticks" + NL
    t = t + "    addr = NET.Resolve(rsServer)" + NL
    t = t + "    IF NOT rsLooking THEN RETURN """"" + NL
    t = t + "    rsLooking = FALSE" + NL
    t = t + "    IF addr = """" THEN" + NL
    t = t + "        RsGiveUp(""there is no machine called "" + rsServer)" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    rsServerAddr = addr" + NL
    t = t + "    rsServerFor = rsServer" + NL
    t = t + "    rsServerAt = SYS.Ticks" + NL
    t = t + "    RETURN addr" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsBusy () AS Bool" + NL
    t = t + "    IF rsAsking = """" THEN RETURN FALSE" + NL
    t = t + "    IF rsRefused THEN" + NL
    t = t + "        RsGiveUp(""the name server "" + rsServer + "" refused"")" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF SYS.Ticks - rsAskAt > RSWAIT THEN" + NL
    t = t + "        RsGiveUp(""no answer from the name server "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Rs_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    IF NOT conn.Tag.StartsWith(""rs:"") THEN RETURN" + NL
    t = t + "    h = conn.Tag.Substring(3, conn.Tag.Length - 3)" + NL
    t = t + "    conn.Tag = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        conn.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    RsTake(h, message)" + NL
    t = t + "    IF h = rsAsking THEN rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an answer: follows its CNAMEs to an address, or to the machine" + NL
    t = t + "' name the chain ends at." + NL
    t = t + "SUB RsTake (host AS String, reply AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR onward AS String" + NL
    t = t + "    VAR target AS String" + NL
    t = t + "    VAR canon AS String" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR hops AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    rsLastReply = reply" + NL
    t = t + "    IF host.StartsWith(""mx:"") THEN" + NL
    t = t + "        RsTakeMx(host, reply)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(host, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(host, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    cur = RsFull(host)" + NL
    t = t + "    canon = cur" + NL
    t = t + "    FOR hops = 0 TO 8" + NL
    t = t + "        onward = """"" + NL
    t = t + "        FOR i = 1 TO lines.Count - 1" + NL
    t = t + "            w = lines[i].Split("" "")" + NL
    t = t + "            IF w.Count >= 4 THEN" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""A"" AND target = """" THEN target = w[3]" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""CNAME"" THEN onward = w[3]" + NL
    t = t + "                IF w[0] = cur AND (w[2] = ""A"" OR w[2] = ""CNAME"") AND Int(Val(w[1])) < ttl THEN ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF target <> """" THEN" + NL
    t = t + "            canon = cur" + NL
    t = t + "            BREAK" + NL
    t = t + "        END IF" + NL
    t = t + "        IF onward = """" THEN BREAK" + NL
    t = t + "        canon = cur" + NL
    t = t + "        cur = onward" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF target = """" THEN" + NL
    t = t + "        ' a name with no CNAME and no address: not one to connect to" + NL
    t = t + "        IF cur = RsFull(host) THEN" + NL
    t = t + "            RsKeep(host, """", """", RSNEG)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        ' the end of the chain: a SIM95 machine name" + NL
    t = t + "        target = cur" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ttl < 5 THEN ttl = 5" + NL
    t = t + "    RsKeep(host, target, canon, ttl * 1000)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an MX answer: the mail machine with the lowest preference. With no" + NL
    t = t + "' MX, the server answers with the domain's CNAMEs instead, and the domain's" + NL
    t = t + "' own machine takes the mail." + NL
    t = t + "SUB RsTakeMx (key AS String, reply AS String)" + NL
    t = t + "    VAR domain AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR best AS String" + NL
    t = t + "    VAR pref AS Integer = 1000000" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    domain = key.Substring(3, key.Length - 3)" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(key, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RsKeep(domain, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(key, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 1 TO lines.Count - 1" + NL
    t = t + "        w = lines[i].Split("" "")" + NL
    t = t + "        IF w.Count >= 5 THEN" + NL
    t = t + "            IF w[2] = ""MX"" AND Int(Val(w[3])) < pref THEN" + NL
    t = t + "                pref = Int(Val(w[3]))" + NL
    t = t + "                best = w[4]" + NL
    t = t + "                ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF best <> """" THEN" + NL
    t = t + "        IF best.EndsWith(""."") THEN best = best.Substring(0, best.Length - 1)" + NL
    t = t + "        IF ttl < 5 THEN ttl = 5" + NL
    t = t + "        RsKeep(key, best, RsFull(domain), ttl * 1000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    RsTake(domain, reply)" + NL
    t = t + "    IF RsKnown(domain) THEN" + NL
    t = t + "        RsKeep(key, domain, RsFull(domain), RSNEG)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsKeep(key, """", """", RSNEG)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The machine (or name) that takes domain's mail: its MX, or domain itself." + NL
    t = t + "FUNCTION RsMailHost (domain AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN domain" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN domain" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where to connect for domain's mail." + NL
    t = t + "FUNCTION RsMailTarget (domain AS String) AS String" + NL
    t = t + "    RETURN RsTarget(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS say where domain's mail goes (an MX, or the domain's machine)?" + NL
    t = t + "FUNCTION RsMailKnown (domain AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN FALSE" + NL
    t = t + "    RETURN RsKnown(RsMailHost(domain)) OR NOT RsAsks(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB RsKeep (host AS String, target AS String, canon AS String, ms AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    i = rsName.IndexOf(h)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF rsName.Count >= RSMOST THEN" + NL
    t = t + "        rsName.RemoveAt(0)" + NL
    t = t + "        rsTo.RemoveAt(0)" + NL
    t = t + "        rsCanon.RemoveAt(0)" + NL
    t = t + "        rsUntil.RemoveAt(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    rsName.Add(h)" + NL
    t = t + "    rsTo.Add(target)" + NL
    t = t + "    rsCanon.Add(canon)" + NL
    t = t + "    rsUntil.Add(SYS.Ticks + ms)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where to connect for host: what SimDNS said, or host itself." + NL
    t = t + "FUNCTION RsTarget (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name host's machine was found under (www.coolsite.sim), or host." + NL
    t = t + "FUNCTION RsCanonical (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsCanon[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS answer for host (so RsTarget is its machine)?" + NL
    t = t + "FUNCTION RsKnown (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] <> """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did the name server say there is no such name (NXDOMAIN)?" + NL
    t = t + "FUNCTION RsNoSuchName (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] = """" AND rsCanon[i] = ""NXDOMAIN""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is the name server being left alone, because it didn't answer (or there" + NL
    t = t + "' is none)? rsWhy says why." + NL
    t = t + "FUNCTION RsSilent () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    IF rsServer = """" THEN RETURN TRUE" + NL
    t = t + "    RETURN rsDown AND SYS.Ticks - rsDownAt < RSQUIET" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\PROGRAMS\DIG.SPK")
END SUB

SUB File2 ()
    t = ""
    t = t + "' RESOLVE.SPK - the SimDNS resolver: asks the name server which machine a" + NL
    t = t + "' name like www.coolsite.sim is on." + NL
    t = t + "'" + NL
    t = t + "' The name server is the central one, STARTHERE.56k.net, where SimNIC (the" + NL
    t = t + "' registrar) and NAMED.SPK run, unless C:\SYSTEM\RESOLV.INI says otherwise." + NL
    t = t + "' To move the whole network to another central host, change RSCENTRAL below" + NL
    t = t + "' (the builder sets it from CENTRAL in tools/simxplorer-source.mjs)." + NL
    t = t + "'" + NL
    t = t + "' A library, not a program: a program has it joined on the end (the builder" + NL
    t = t + "' does this for Simxplorer, SimPlayer, Vapor, Frostbird, MAILD, the Sim Shell," + NL
    t = t + "' AskSim's crawler, DIG and Personal Web Manager; copy C:\PROGRAMS\RESOLVE.SPK" + NL
    t = t + "' onto the end of your own). Every name in it starts with Rs, so it can't clash." + NL
    t = t + "'" + NL
    t = t + "' C:\SYSTEM\RESOLV.INI, shared by every program on the machine (optional):" + NL
    t = t + "'     nameserver=dnsbox          another name server instead of the central one" + NL
    t = t + "'     nameserver=none            no SimDNS at all: SIM95 machine names only" + NL
    t = t + "'     search=coolsite.sim        then ""www"" means www.coolsite.sim" + NL
    t = t + "'" + NL
    t = t + "' How to use it without ever waiting in the wrong place (SIM95-NOTES.md):" + NL
    t = t + "'   1. RsWants(host)  - does this name need asking? FALSE for addresses," + NL
    t = t + "'                       plain machine names, names already known, or when" + NL
    t = t + "'                       there is no name server (or it isn't answering)." + NL
    t = t + "'   2. RsAsk(host, address) - sends the question to the name server at that" + NL
    t = t + "'                       address. It is a Connect: let it be the last thing" + NL
    t = t + "'                       the handler does." + NL
    t = t + "'   3. RsBusy()       - TRUE while the answer is on its way. After RSWAIT" + NL
    t = t + "'                       with no answer the server is left alone for RSQUIET," + NL
    t = t + "'                       and every name goes to SIM95 as before." + NL
    t = t + "'   4. RsTarget(host) - where to connect: the machine name (or address) the" + NL
    t = t + "'                       name server gave, or the name itself when SimDNS" + NL
    t = t + "'                       doesn't know it, for SIM95 to look up." + NL
    t = t + "' Answers are kept for their TTL; names SimDNS doesn't know for RSNEG." + NL
    t = t + "'" + NL
    t = t + "' Or, from a timer tick, all of that in one line (see RsNext):" + NL
    t = t + "'     IF RsNext(host) THEN RETURN          ' asked, or waiting: end the tick" + NL
    t = t + "'     conn = sock.Connect(RsTarget(host), 80)" + NL
    t = t + "' and for mail, the domain's MX first (see RsNextMail):" + NL
    t = t + "'     IF RsNextMail(domain) THEN RETURN" + NL
    t = t + "'     conn = sock.Connect(RsMailTarget(domain), 25)" + NL
    t = t + "" + NL
    t = t + "CONST RSCENTRAL = ""starthere.56k.net""   ' the central name server" + NL
    t = t + "CONST RSINI = ""C:\SYSTEM\RESOLV.INI""" + NL
    t = t + "CONST RSPORT = 53" + NL
    t = t + "CONST RSWAIT = 2000             ' ms to wait for an answer" + NL
    t = t + "CONST RSQUIET = 30000            ' ms to leave a silent name server alone" + NL
    t = t + "CONST RSNEG = 60000             ' ms to remember that SimDNS doesn't know a name" + NL
    t = t + "CONST RSMOST = 100              ' names kept" + NL
    t = t + "" + NL
    t = t + "VAR rsServer AS String              ' """" when SimDNS is off" + NL
    t = t + "VAR rsByDefault AS Bool               ' TRUE when RESOLV.INI doesn't name one" + NL
    t = t + "VAR rsSearch AS String" + NL
    t = t + "VAR rsRead AS Bool" + NL
    t = t + "VAR rsReadAt AS Integer" + NL
    t = t + "VAR rsSock AS NET_Socket" + NL
    t = t + "VAR rsName AS Array OF String       ' the name as asked, lower case" + NL
    t = t + "VAR rsTo AS Array OF String         ' where it is ("""" when SimDNS doesn't know it)" + NL
    t = t + "VAR rsCanon AS Array OF String      ' its last name in DNS before the machine" + NL
    t = t + "VAR rsUntil AS Array OF Integer     ' SYS.Ticks when it is forgotten" + NL
    t = t + "VAR rsAsking AS String" + NL
    t = t + "VAR rsAskAt AS Integer" + NL
    t = t + "VAR rsRefused AS Bool" + NL
    t = t + "VAR rsDown AS Bool" + NL
    t = t + "VAR rsDownAt AS Integer" + NL
    t = t + "VAR rsWhy AS String                 ' the last thing that went wrong" + NL
    t = t + "VAR rsLastReply AS String           ' the last answer, as it came" + NL
    t = t + "VAR rsServerAddr AS String          ' the name server's address, for RsNext" + NL
    t = t + "VAR rsServerFor AS String" + NL
    t = t + "VAR rsServerAt AS Integer" + NL
    t = t + "VAR rsLooking AS Bool               ' RsNext is finding the name server's address" + NL
    t = t + "VAR rsLookingAt AS Integer" + NL
    t = t + "" + NL
    t = t + "' Reads RESOLV.INI (again after a few seconds, so a new setting takes)." + NL
    t = t + "' With no nameserver= line, the central name server; none (or nothing after" + NL
    t = t + "' the =) turns SimDNS off." + NL
    t = t + "SUB RsConfig ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    IF rsRead AND SYS.Ticks - rsReadAt < 3000 THEN RETURN" + NL
    t = t + "    rsRead = TRUE" + NL
    t = t + "    rsReadAt = SYS.Ticks" + NL
    t = t + "    rsServer = RSCENTRAL" + NL
    t = t + "    rsByDefault = TRUE" + NL
    t = t + "    rsSearch = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                low = line.Trim().Lower()" + NL
    t = t + "                IF low.StartsWith(""nameserver="") THEN" + NL
    t = t + "                    rsServer = low.Substring(11, low.Length - 11).Trim()" + NL
    t = t + "                    rsByDefault = FALSE" + NL
    t = t + "                END IF" + NL
    t = t + "                IF low.StartsWith(""search="") THEN rsSearch = low.Substring(7, low.Length - 7).Trim()" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF rsServer = ""none"" THEN rsServer = """"" + NL
    t = t + "    IF rsSearch.StartsWith(""."") THEN rsSearch = rsSearch.Substring(1, rsSearch.Length - 1)" + NL
    t = t + "    IF rsSearch.EndsWith(""."") THEN rsSearch = rsSearch.Substring(0, rsSearch.Length - 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The name server (a machine name or address), or """" for none." + NL
    t = t + "FUNCTION RsNameServer () AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsServer" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is it the central one, because RESOLV.INI doesn't say?" + NL
    t = t + "FUNCTION RsIsCentral () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsByDefault" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Makes server this machine's name server, keeping the rest of RESOLV.INI," + NL
    t = t + "' and forgets everything it knew. """" (or none) for no SimDNS at all;" + NL
    t = t + "' default for the central one again." + NL
    t = t + "SUB RsSave (server AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    server = server.Trim().Lower()" + NL
    t = t + "    IF server = """" THEN server = ""none""" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                IF line.Trim() <> """" AND NOT line.Trim().Lower().StartsWith(""nameserver="") THEN out.Add(line)" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "        IF server <> ""default"" THEN out.Insert(0, ""nameserver="" + server)" + NL
    t = t + "        IF out.Count = 0 THEN" + NL
    t = t + "            IF FS.Exists(RSINI) THEN FS.Delete(RSINI)" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Write(RSINI, out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsWhy = err" + NL
    t = t + "    END TRY" + NL
    t = t + "    rsRead = FALSE" + NL
    t = t + "    RsForget()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RsForget ()" + NL
    t = t + "    rsName.Clear()" + NL
    t = t + "    rsTo.Clear()" + NL
    t = t + "    rsCanon.Clear()" + NL
    t = t + "    rsUntil.Clear()" + NL
    t = t + "    rsDown = FALSE" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsIsAddress (s AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF s.Split(""."").Count <> 4 THEN RETURN FALSE" + NL
    t = t + "    FOR EACH p IN s.Split(""."")" + NL
    t = t + "        IF p = """" OR p.Length > 3 THEN RETURN FALSE" + NL
    t = t + "        FOR i = 0 TO p.Length - 1" + NL
    t = t + "            IF NOT ""0123456789"".Contains(p.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name the server is asked about: lower case, the search domain added" + NL
    t = t + "' to a single word." + NL
    t = t + "FUNCTION RsFull (host AS String) AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF h.EndsWith(""."") THEN h = h.Substring(0, h.Length - 1)" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch <> """" THEN h = h + ""."" + rsSearch" + NL
    t = t + "    RETURN h" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a name is in the list of answers, or -1 (old answers are dropped)." + NL
    t = t + "FUNCTION RsFind (host AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = rsName.IndexOf(host.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN -1" + NL
    t = t + "    IF SYS.Ticks > rsUntil[i] THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "        RETURN -1" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsWants (host AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(host) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(host) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for a mail domain's MX record." + NL
    t = t + "FUNCTION RsWantsMx (domain AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(domain) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(""mx:"" + domain.Trim().Lower()) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is host a name for the name server at all (whether known yet or not)?" + NL
    t = t + "FUNCTION RsAsks (host AS String) AS Bool" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF rsServer = """" OR h = """" OR h = ""localhost"" THEN RETURN FALSE" + NL
    t = t + "    IF rsDown AND SYS.Ticks - rsDownAt < RSQUIET THEN RETURN FALSE" + NL
    t = t + "    IF RsIsAddress(h) THEN RETURN FALSE" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch = """" THEN RETURN FALSE" + NL
    t = t + "    IF h = rsServer OR h = NET.HostName.Lower() THEN RETURN FALSE" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Sends the question. A Connect, so it must be the last thing its handler" + NL
    t = t + "' does: if the name server refuses, the handler is spoiled (SIM95-NOTES.md)." + NL
    t = t + "SUB RsAsk (host AS String, address AS String)" + NL
    t = t + "    RsSend(host.Trim().Lower(), ""A"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Asks for a mail domain's MX records (also a Connect: the last thing)." + NL
    t = t + "SUB RsAskMx (domain AS String, address AS String)" + NL
    t = t + "    RsSend(""mx:"" + domain.Trim().Lower(), ""MX"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' key is the name, or mx: and the name; the answer is kept under it." + NL
    t = t + "SUB RsSend (key AS String, qtype AS String, address AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    IF IsNothing(rsSock) THEN" + NL
    t = t + "        rsSock = NET_Socket.New()" + NL
    t = t + "        rsSock.onMessage = Rs_OnMessage" + NL
    t = t + "    END IF" + NL
    t = t + "    name = key" + NL
    t = t + "    IF name.StartsWith(""mx:"") THEN name = name.Substring(3, name.Length - 3)" + NL
    t = t + "    rsAsking = key" + NL
    t = t + "    rsAskAt = SYS.Ticks" + NL
    t = t + "    rsRefused = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = rsSock.Connect(address, RSPORT)" + NL
    t = t + "        conn.Tag = ""rs:"" + key" + NL
    t = t + "        conn.Send(""QUERY "" + RsFull(name) + "" "" + qtype)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsRefused = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Gives up on the name server for a while: every name goes to SIM95." + NL
    t = t + "SUB RsGiveUp (why AS String)" + NL
    t = t + "    rsWhy = why" + NL
    t = t + "    rsDown = TRUE" + NL
    t = t + "    rsDownAt = SYS.Ticks" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "    rsServerAddr = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' For a program that fetches from a timer tick: TRUE when the tick must end" + NL
    t = t + "' now, because a question about host has just been sent (a Connect, so it" + NL
    t = t + "' has to be the last thing the handler does) or an answer is on its way." + NL
    t = t + "' FALSE when there is nothing to ask: RsTarget(host) is where to connect." + NL
    t = t + "' A name server that is missing, refuses or says nothing for RSWAIT is left" + NL
    t = t + "' alone for RSQUIET, and every name goes to SIM95: nothing ever hangs." + NL
    t = t + "FUNCTION RsNext (host AS String) AS Bool" + NL
    t = t + "    RETURN RsStep(host, FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for mail to domain: its MX record (the lowest preference), then" + NL
    t = t + "' the CNAMEs or address of the machine that names. RsMailTarget(domain) is" + NL
    t = t + "' then where to connect; with no MX, the domain's own machine; with no" + NL
    t = t + "' answer at all, the domain itself, for SIM95 to look up." + NL
    t = t + "FUNCTION RsNextMail (domain AS String) AS Bool" + NL
    t = t + "    IF RsStep(domain, TRUE) THEN RETURN TRUE" + NL
    t = t + "    RETURN RsStep(RsMailHost(domain), FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsStep (host AS String, mx AS Bool) AS Bool" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    ' another handler is finding the name server (it waits): wait for it" + NL
    t = t + "    IF rsLooking THEN" + NL
    t = t + "        IF SYS.Ticks - rsLookingAt < RSWAIT THEN RETURN TRUE" + NL
    t = t + "        rsLooking = FALSE" + NL
    t = t + "        RsGiveUp(""no answer about the machine "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF RsBusy() THEN RETURN TRUE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        IF NOT RsWantsMx(host) THEN RETURN FALSE" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF NOT RsWants(host) THEN RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    addr = RsServerAddress()" + NL
    t = t + "    IF addr = """" THEN RETURN FALSE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        RsAskMx(host, addr)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsAsk(host, addr)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name server's address, looked up once a minute (one lookup at a time:" + NL
    t = t + "' see SIM95-NOTES.md). """" when there is no such machine, and then it gives up." + NL
    t = t + "FUNCTION RsServerAddress () AS String" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    IF RsIsAddress(rsServer) THEN RETURN rsServer" + NL
    t = t + "    IF rsServerAddr <> """" AND rsServerFor = rsServer AND SYS.Ticks - rsServerAt < 60000 AND SYS.Ticks >= rsServerAt THEN RETURN rsServerAddr" + NL
    t = t + "    rsLooking = TRUE" + NL
    t = t + "    rsLookingAt = SYS.Ticks" + NL
    t = t + "    addr = NET.Resolve(rsServer)" + NL
    t = t + "    IF NOT rsLooking THEN RETURN """"" + NL
    t = t + "    rsLooking = FALSE" + NL
    t = t + "    IF addr = """" THEN" + NL
    t = t + "        RsGiveUp(""there is no machine called "" + rsServer)" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    rsServerAddr = addr" + NL
    t = t + "    rsServerFor = rsServer" + NL
    t = t + "    rsServerAt = SYS.Ticks" + NL
    t = t + "    RETURN addr" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsBusy () AS Bool" + NL
    t = t + "    IF rsAsking = """" THEN RETURN FALSE" + NL
    t = t + "    IF rsRefused THEN" + NL
    t = t + "        RsGiveUp(""the name server "" + rsServer + "" refused"")" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF SYS.Ticks - rsAskAt > RSWAIT THEN" + NL
    t = t + "        RsGiveUp(""no answer from the name server "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Rs_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    IF NOT conn.Tag.StartsWith(""rs:"") THEN RETURN" + NL
    t = t + "    h = conn.Tag.Substring(3, conn.Tag.Length - 3)" + NL
    t = t + "    conn.Tag = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        conn.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    RsTake(h, message)" + NL
    t = t + "    IF h = rsAsking THEN rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an answer: follows its CNAMEs to an address, or to the machine" + NL
    t = t + "' name the chain ends at." + NL
    t = t + "SUB RsTake (host AS String, reply AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR onward AS String" + NL
    t = t + "    VAR target AS String" + NL
    t = t + "    VAR canon AS String" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR hops AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    rsLastReply = reply" + NL
    t = t + "    IF host.StartsWith(""mx:"") THEN" + NL
    t = t + "        RsTakeMx(host, reply)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(host, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(host, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    cur = RsFull(host)" + NL
    t = t + "    canon = cur" + NL
    t = t + "    FOR hops = 0 TO 8" + NL
    t = t + "        onward = """"" + NL
    t = t + "        FOR i = 1 TO lines.Count - 1" + NL
    t = t + "            w = lines[i].Split("" "")" + NL
    t = t + "            IF w.Count >= 4 THEN" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""A"" AND target = """" THEN target = w[3]" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""CNAME"" THEN onward = w[3]" + NL
    t = t + "                IF w[0] = cur AND (w[2] = ""A"" OR w[2] = ""CNAME"") AND Int(Val(w[1])) < ttl THEN ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF target <> """" THEN" + NL
    t = t + "            canon = cur" + NL
    t = t + "            BREAK" + NL
    t = t + "        END IF" + NL
    t = t + "        IF onward = """" THEN BREAK" + NL
    t = t + "        canon = cur" + NL
    t = t + "        cur = onward" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF target = """" THEN" + NL
    t = t + "        ' a name with no CNAME and no address: not one to connect to" + NL
    t = t + "        IF cur = RsFull(host) THEN" + NL
    t = t + "            RsKeep(host, """", """", RSNEG)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        ' the end of the chain: a SIM95 machine name" + NL
    t = t + "        target = cur" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ttl < 5 THEN ttl = 5" + NL
    t = t + "    RsKeep(host, target, canon, ttl * 1000)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an MX answer: the mail machine with the lowest preference. With no" + NL
    t = t + "' MX, the server answers with the domain's CNAMEs instead, and the domain's" + NL
    t = t + "' own machine takes the mail." + NL
    t = t + "SUB RsTakeMx (key AS String, reply AS String)" + NL
    t = t + "    VAR domain AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR best AS String" + NL
    t = t + "    VAR pref AS Integer = 1000000" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    domain = key.Substring(3, key.Length - 3)" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(key, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RsKeep(domain, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(key, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 1 TO lines.Count - 1" + NL
    t = t + "        w = lines[i].Split("" "")" + NL
    t = t + "        IF w.Count >= 5 THEN" + NL
    t = t + "            IF w[2] = ""MX"" AND Int(Val(w[3])) < pref THEN" + NL
    t = t + "                pref = Int(Val(w[3]))" + NL
    t = t + "                best = w[4]" + NL
    t = t + "                ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF best <> """" THEN" + NL
    t = t + "        IF best.EndsWith(""."") THEN best = best.Substring(0, best.Length - 1)" + NL
    t = t + "        IF ttl < 5 THEN ttl = 5" + NL
    t = t + "        RsKeep(key, best, RsFull(domain), ttl * 1000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    RsTake(domain, reply)" + NL
    t = t + "    IF RsKnown(domain) THEN" + NL
    t = t + "        RsKeep(key, domain, RsFull(domain), RSNEG)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsKeep(key, """", """", RSNEG)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The machine (or name) that takes domain's mail: its MX, or domain itself." + NL
    t = t + "FUNCTION RsMailHost (domain AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN domain" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN domain" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where to connect for domain's mail." + NL
    t = t + "FUNCTION RsMailTarget (domain AS String) AS String" + NL
    t = t + "    RETURN RsTarget(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS say where domain's mail goes (an MX, or the domain's machine)?" + NL
    t = t + "FUNCTION RsMailKnown (domain AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN FALSE" + NL
    t = t + "    RETURN RsKnown(RsMailHost(domain)) OR NOT RsAsks(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB RsKeep (host AS String, target AS String, canon AS String, ms AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    i = rsName.IndexOf(h)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF rsName.Count >= RSMOST THEN" + NL
    t = t + "        rsName.RemoveAt(0)" + NL
    t = t + "        rsTo.RemoveAt(0)" + NL
    t = t + "        rsCanon.RemoveAt(0)" + NL
    t = t + "        rsUntil.RemoveAt(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    rsName.Add(h)" + NL
    t = t + "    rsTo.Add(target)" + NL
    t = t + "    rsCanon.Add(canon)" + NL
    t = t + "    rsUntil.Add(SYS.Ticks + ms)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where to connect for host: what SimDNS said, or host itself." + NL
    t = t + "FUNCTION RsTarget (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name host's machine was found under (www.coolsite.sim), or host." + NL
    t = t + "FUNCTION RsCanonical (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsCanon[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS answer for host (so RsTarget is its machine)?" + NL
    t = t + "FUNCTION RsKnown (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] <> """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did the name server say there is no such name (NXDOMAIN)?" + NL
    t = t + "FUNCTION RsNoSuchName (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] = """" AND rsCanon[i] = ""NXDOMAIN""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is the name server being left alone, because it didn't answer (or there" + NL
    t = t + "' is none)? rsWhy says why." + NL
    t = t + "FUNCTION RsSilent () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    IF rsServer = """" THEN RETURN TRUE" + NL
    t = t + "    RETURN rsDown AND SYS.Ticks - rsDownAt < RSQUIET" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\PROGRAMS\RESOLVE.SPK")
END SUB

SUB File3 ()
    t = ""
    t = t + "' HTTPD.SPK - the web server. Serves C:\WEB on port 80." + NL
    t = t + "' This is the program Voyager talks to when someone opens http://YOURNAME/." + NL
    t = t + "' Edit it, save, and run it again: the web server is now yours." + NL
    t = t + "' Files ending in .ASP are ActiveSparkPages: SPARK runs on this machine" + NL
    t = t + "' and the result is sent. See section 12 of C:\DOCS\SPARK.TXT." + NL
    t = t + "'" + NL
    t = t + "' simweb edition: the stock web server, plus virtual hosts. One machine can" + NL
    t = t + "' serve several sites, each from a folder of its own, listed in" + NL
    t = t + "' C:\WEB\VHOSTS.TXT, one a line:" + NL
    t = t + "'     www.coolsite.sim|C:\WEB\SITES\COOLSITE" + NL
    t = t + "'     *.dab.sim|C:\WEB\SITES\DAB          (any name ending in .dab.sim)" + NL
    t = t + "' A site is reached two ways:" + NL
    t = t + "'   * By its name (Simxplorer, with a SimDNS name server): the Host header" + NL
    t = t + "'     says www.coolsite.sim, and /page.htm is that folder's PAGE.HTM." + NL
    t = t + "'   * By path (Voyager, or anyone without SimDNS): http://alpha/www.coolsite.sim/page.htm" + NL
    t = t + "'     is the same file. /www.coolsite.sim on its own gets a slash added." + NL
    t = t + "' Anything else - this machine's own name, an address, a name not listed -" + NL
    t = t + "' is C:\WEB, exactly as before." + NL
    t = t + "'" + NL
    t = t + "' Server pages in a site run as usual (SERVER.ScriptName is the file on disk," + NL
    t = t + "' and imports are next to it). REQUEST.Path is the path inside the site, so" + NL
    t = t + "' relative links work both ways. REQUEST.Host is what the browser asked for:" + NL
    t = t + "' www.coolsite.sim by name, alpha by path. Two headers say the rest:" + NL
    t = t + "'     X-Site: www.coolsite.sim       the site being served" + NL
    t = t + "'     X-Base-Path: /www.coolsite.sim/   where the site starts on this server" + NL
    t = t + "'                                       (""/"" when reached by name)" + NL
    t = t + "' so a page's own address is ""http://"" + REQUEST.Host + X-Base-Path + page." + NL
    t = t + "' A RESPONSE.Redirect to ""/x.asp"" is put back inside the site by path. Links" + NL
    t = t + "' that start with / can't be: in a site, use relative links." + NL
    t = t + "'" + NL
    t = t + "' The stock web server is kept as C:\PROGRAMS\HTTPD.ORG. When simweb is" + NL
    t = t + "' uninstalled (C:\PROGRAMS\PWM.SPK, Personal Web Manager, is gone), this one" + NL
    t = t + "' puts it back." + NL
    t = t + "" + NL
    t = t + "CONST VHOSTS = ""C:\WEB\VHOSTS.TXT""" + NL
    t = t + "CONST ME = ""C:\PROGRAMS\HTTPD.SPK""" + NL
    t = t + "CONST ORIGINAL = ""C:\PROGRAMS\HTTPD.ORG""" + NL
    t = t + "CONST SIMWEB = ""C:\PROGRAMS\PWM.SPK""" + NL
    t = t + "" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR log AS GUI_ListBox" + NL
    t = t + "VAR sock AS NET_Socket" + NL
    t = t + "VAR timer AS GUI_Timer" + NL
    t = t + "VAR hits AS Integer" + NL
    t = t + "VAR NL AS String" + NL
    t = t + "VAR vText AS String = ""?""       ' VHOSTS.TXT as last read" + NL
    t = t + "VAR vName AS Array OF String    ' www.coolsite.sim, or *.dab.sim" + NL
    t = t + "VAR vDir AS Array OF String" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    NL = Chr(10)" + NL
    t = t + "    win = GUI_Window.New(""Web Server"", 420, 240)" + NL
    t = t + "    win.Icon = ""network""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    win.onResize = Win_OnResize" + NL
    t = t + "    log = GUI_ListBox.New(win)" + NL
    t = t + "    log.Mono = TRUE" + NL
    t = t + "    Win_OnResize()" + NL
    t = t + "" + NL
    t = t + "    sock = NET_Socket.New()" + NL
    t = t + "    sock.onConnect = Sock_OnConnect" + NL
    t = t + "    sock.onMessage = Sock_OnMessage" + NL
    t = t + "    sock.onError = Sock_OnError" + NL
    t = t + "    sock.Listen(80)" + NL
    t = t + "" + NL
    t = t + "    ' The address arrives from the network server a moment after we start, so keep the" + NL
    t = t + "    ' status line honest with a slow timer instead of showing 0.0.0.0 forever." + NL
    t = t + "    timer = GUI_Timer.New(win)" + NL
    t = t + "    timer.Interval = 1000" + NL
    t = t + "    timer.onTick = Timer_OnTick" + NL
    t = t + "    timer.Start()" + NL
    t = t + "    Timer_OnTick()" + NL
    t = t + "    win.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Timer_OnTick ()" + NL
    t = t + "    VAR sites AS String" + NL
    t = t + "    ' simweb uninstalled (by Vapor, say): the stock web server comes back" + NL
    t = t + "    IF FS.Exists(ORIGINAL) AND NOT FS.Exists(SIMWEB) THEN" + NL
    t = t + "        PutBack()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ReadHosts()" + NL
    t = t + "    IF vName.Count > 0 THEN sites = "" - "" + Str(vName.Count) + "" sites""" + NL
    t = t + "    IF NET.Online THEN" + NL
    t = t + "        win.Status = ""Listening on "" + NET.LocalAddress + "" port 80 - try http://"" + NET.HostName.Lower() + ""/"" + sites" + NL
    t = t + "    ELSE" + NL
    t = t + "        win.Status = ""Listening on port 80 - waiting for the network""" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB PutBack ()" + NL
    t = t + "    log.Add(""simweb is gone: the stock web server takes over again"")" + NL
    t = t + "    timer.Stop()" + NL
    t = t + "    sock.Close()" + NL
    t = t + "    TRY" + NL
    t = t + "        FS.Delete(ME)" + NL
    t = t + "        FS.Rename(ORIGINAL, ME)" + NL
    t = t + "        SYS.Run(ME)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        log.Add(""ERROR "" + err)" + NL
    t = t + "    END TRY" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnResize ()" + NL
    t = t + "    log.SetBounds(0, 0, win.Width, win.Height)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnConnect (conn AS NET_Connection)" + NL
    t = t + "    conn.Accept()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR query AS String" + NL
    t = t + "    VAR file AS String" + NL
    t = t + "    VAR host AS String" + NL
    t = t + "    VAR site AS String" + NL
    t = t + "    VAR root AS String = ""C:\WEB""" + NL
    t = t + "    VAR base AS String = ""/""" + NL
    t = t + "    VAR seg AS String" + NL
    t = t + "    VAR v AS Integer" + NL
    t = t + "    VAR shown AS String" + NL
    t = t + "" + NL
    t = t + "    lines = message.Lines()" + NL
    t = t + "    parts = lines[0].Split("" "")" + NL
    t = t + "    IF parts.Count < 2 OR (parts[0] <> ""GET"" AND parts[0] <> ""POST"") THEN" + NL
    t = t + "        SendError(conn, ""400 Bad Request"", ""Voyager sends GET or POST. This was neither."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    path = parts[1]" + NL
    t = t + "    IF path.IndexOf(""?"") >= 0 THEN" + NL
    t = t + "        query = path.Substring(path.IndexOf(""?""), path.Length - path.IndexOf(""?""))" + NL
    t = t + "        path = path.Substring(0, path.IndexOf(""?""))" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    ' Which site? First by the name the browser asked for, then by the first" + NL
    t = t + "    ' part of the path." + NL
    t = t + "    ReadHosts()" + NL
    t = t + "    host = HostHeader(lines)" + NL
    t = t + "    v = SiteIndex(host)" + NL
    t = t + "    IF v >= 0 THEN" + NL
    t = t + "        site = host" + NL
    t = t + "    ELSEIF path.Length > 1 THEN" + NL
    t = t + "        seg = path.Substring(1, path.Length - 1)" + NL
    t = t + "        IF seg.Contains(""/"") THEN seg = seg.Substring(0, seg.IndexOf(""/""))" + NL
    t = t + "        IF seg.Contains(""."") THEN v = SiteIndex(seg.Lower())" + NL
    t = t + "        IF v >= 0 THEN" + NL
    t = t + "            site = seg.Lower()" + NL
    t = t + "            ' /www.coolsite.sim is a folder: say so, so relative links work" + NL
    t = t + "            IF path.Length = seg.Length + 1 THEN" + NL
    t = t + "                Redirect(conn, path + ""/"" + query)" + NL
    t = t + "                RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "            base = ""/"" + seg + ""/""" + NL
    t = t + "            path = path.Substring(seg.Length + 1, path.Length - seg.Length - 1)" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    IF v >= 0 THEN root = vDir[v]" + NL
    t = t + "    file = PathToFile(path, root)" + NL
    t = t + "" + NL
    t = t + "    hits = hits + 1" + NL
    t = t + "    win.Title = ""Web Server ("" + Str(hits) + "" hits)""" + NL
    t = t + "    shown = path" + NL
    t = t + "    IF site <> """" THEN shown = site + path" + NL
    t = t + "    log.Add(TIME.Clock + ""  "" + conn.FromAddress + ""  "" + parts[0] + "" "" + shown)" + NL
    t = t + "    IF log.Count > 500 THEN log.RemoveAt(0)" + NL
    t = t + "    log.ScrollToEnd()" + NL
    t = t + "" + NL
    t = t + "    ' A directory with no INDEX.HTM may have an INDEX.ASP instead" + NL
    t = t + "    IF file.EndsWith(""\INDEX.HTM"") AND NOT FS.Exists(file) THEN file = file.Replace(""\INDEX.HTM"", ""\INDEX.ASP"")" + NL
    t = t + "" + NL
    t = t + "    IF file = """" OR NOT FS.Exists(file) OR FS.IsDir(file) THEN" + NL
    t = t + "        SendError(conn, ""404 Not Found"", ""There is no "" + shown + "" on this server."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    ' ActiveSparkPages: a .ASP file is run, not sent. ASP.Render returns the whole response," + NL
    t = t + "    ' and the page sees a POSTed form through REQUEST.Form. A page in a site" + NL
    t = t + "    ' sees the path inside the site, and X-Site and X-Base-Path." + NL
    t = t + "    IF file.EndsWith("".ASP"") THEN" + NL
    t = t + "        IF site = """" THEN" + NL
    t = t + "            conn.Send(ASP.Render(file, message, conn.FromAddress))" + NL
    t = t + "        ELSE" + NL
    t = t + "            conn.Send(InSite(ASP.Render(file, ForSite(message, path + query, site, base), conn.FromAddress), base))" + NL
    t = t + "        END IF" + NL
    t = t + "        conn.Close()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    ' Only a page can take a POST; a plain file has nothing to do with one" + NL
    t = t + "    IF parts[0] = ""POST"" THEN" + NL
    t = t + "        SendError(conn, ""405 Method Not Allowed"", path + "" is a file, not a page. Only .ASP pages accept a POST."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    conn.Send(""HTTP/1.0 200 OK"")" + NL
    t = t + "    conn.Send(""Server: HTTPD.SPK/1.1 (SIM95; simweb)"")" + NL
    t = t + "    conn.Send(""Content-Type: "" + ContentType(file))" + NL
    t = t + "    conn.Send("""")" + NL
    t = t + "    conn.Send(FS.Read(file))" + NL
    t = t + "    conn.Close()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- sites" + NL
    t = t + "" + NL
    t = t + "' Reads VHOSTS.TXT when it has changed. Folders must be in C:\WEB, so a site" + NL
    t = t + "' can't hand out C:\SYSTEM." + NL
    t = t + "SUB ReadHosts ()" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    text = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(VHOSTS) THEN text = FS.Read(VHOSTS)" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF text = vText THEN RETURN" + NL
    t = t + "    vText = text" + NL
    t = t + "    vName.Clear()" + NL
    t = t + "    vDir.Clear()" + NL
    t = t + "    FOR EACH line IN text.Lines()" + NL
    t = t + "        line = line.Trim()" + NL
    t = t + "        IF line = """" OR line.StartsWith("";"") OR line.StartsWith(""'"") OR line.StartsWith(""#"") OR NOT line.Contains(""|"") THEN CONTINUE" + NL
    t = t + "        name = line.Substring(0, line.IndexOf(""|"")).Trim().Lower()" + NL
    t = t + "        dir = line.Substring(line.IndexOf(""|"") + 1, line.Length - line.IndexOf(""|"") - 1).Trim().Upper()" + NL
    t = t + "        IF dir.EndsWith(""\"") THEN dir = dir.Substring(0, dir.Length - 1)" + NL
    t = t + "        IF name.EndsWith(""."") THEN name = name.Substring(0, name.Length - 1)" + NL
    t = t + "        IF name = """" OR NOT name.Contains(""."") OR dir.Contains("".."") THEN CONTINUE" + NL
    t = t + "        IF dir <> ""C:\WEB"" AND NOT dir.StartsWith(""C:\WEB\"") THEN" + NL
    t = t + "            log.Add(""VHOSTS.TXT: "" + name + "" is not in C:\WEB, so it is left out"")" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        vName.Add(name)" + NL
    t = t + "        vDir.Add(dir)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The site called name (exactly, else by a *. pattern), or -1." + NL
    t = t + "FUNCTION SiteIndex (name AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF name = """" THEN RETURN -1" + NL
    t = t + "    i = vName.IndexOf(name)" + NL
    t = t + "    IF i >= 0 THEN RETURN i" + NL
    t = t + "    FOR i = 0 TO vName.Count - 1" + NL
    t = t + "        IF vName[i].StartsWith(""*."") THEN" + NL
    t = t + "            IF name.EndsWith(vName[i].Substring(1, vName[i].Length - 1)) THEN RETURN i" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN -1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The Host header, lower case, without a port." + NL
    t = t + "FUNCTION HostHeader (lines AS Array OF String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    FOR i = 1 TO lines.Count - 1" + NL
    t = t + "        IF lines[i].Trim() = """" THEN RETURN """"" + NL
    t = t + "        IF lines[i].Lower().StartsWith(""host:"") THEN" + NL
    t = t + "            h = lines[i].Substring(5, lines[i].Length - 5).Trim().Lower()" + NL
    t = t + "            IF h.Contains("":"") THEN h = h.Substring(0, h.IndexOf("":""))" + NL
    t = t + "            RETURN h" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The request as a page in a site sees it: the path inside the site, and" + NL
    t = t + "' X-Site and X-Base-Path (any the browser sent are dropped). The body is" + NL
    t = t + "' left exactly as it came." + NL
    t = t + "FUNCTION ForSite (message AS String, inside AS String, site AS String, base AS String) AS String" + NL
    t = t + "    VAR head AS String" + NL
    t = t + "    VAR tail AS String" + NL
    t = t + "    VAR cut AS Integer" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR first AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    cut = message.IndexOf(NL + NL)" + NL
    t = t + "    IF cut < 0 THEN" + NL
    t = t + "        head = message" + NL
    t = t + "    ELSE" + NL
    t = t + "        head = message.Substring(0, cut)" + NL
    t = t + "        tail = message.Substring(cut, message.Length - cut)" + NL
    t = t + "    END IF" + NL
    t = t + "    first = head.Lines()[0].Split("" "")" + NL
    t = t + "    out = first[0] + "" "" + inside" + NL
    t = t + "    FOR i = 2 TO first.Count - 1" + NL
    t = t + "        out = out + "" "" + first[i]" + NL
    t = t + "    NEXT" + NL
    t = t + "    i = 0" + NL
    t = t + "    FOR EACH line IN head.Lines()" + NL
    t = t + "        i = i + 1" + NL
    t = t + "        IF i = 1 OR line.Trim() = """" THEN CONTINUE" + NL
    t = t + "        IF line.Lower().StartsWith(""x-site:"") OR line.Lower().StartsWith(""x-base-path:"") THEN CONTINUE" + NL
    t = t + "        out = out + NL + line" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out + NL + ""X-Site: "" + site + NL + ""X-Base-Path: "" + base + tail" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A page's answer, with a Location of ""/..."" put back inside the site." + NL
    t = t + "FUNCTION InSite (response AS String, base AS String) AS String" + NL
    t = t + "    VAR cut AS Integer" + NL
    t = t + "    VAR head AS String" + NL
    t = t + "    IF base = ""/"" THEN RETURN response" + NL
    t = t + "    cut = response.IndexOf(NL + NL)" + NL
    t = t + "    IF cut < 0 THEN cut = response.Length" + NL
    t = t + "    head = response.Substring(0, cut)" + NL
    t = t + "    IF NOT head.Contains(NL + ""Location: /"") THEN RETURN response" + NL
    t = t + "    IF head.Contains(NL + ""Location: //"") THEN RETURN response" + NL
    t = t + "    RETURN head.Replace(NL + ""Location: /"", NL + ""Location: "" + base) + response.Substring(cut, response.Length - cut)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Redirect (conn AS NET_Connection, there AS String)" + NL
    t = t + "    conn.Send(""HTTP/1.0 302 Found"")" + NL
    t = t + "    conn.Send(""Location: "" + there)" + NL
    t = t + "    conn.Send(""Content-Type: text/html"")" + NL
    t = t + "    conn.Send("""")" + NL
    t = t + "    conn.Send(""<html><body><p>This site is at <a href="""""" + there + """""">"" + there + ""</a>.</p></body></html>"")" + NL
    t = t + "    conn.Close()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION PathToFile (path AS String, root AS String) AS String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    p = path.Replace(""/"", ""\"").Upper()" + NL
    t = t + "    IF p.Contains("".."") THEN RETURN """"" + NL
    t = t + "    IF p.EndsWith(""\"") THEN p = p + ""INDEX.HTM""" + NL
    t = t + "    IF p = """" THEN p = ""\INDEX.HTM""" + NL
    t = t + "    RETURN root + p" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ContentType (file AS String) AS String" + NL
    t = t + "    IF file.EndsWith("".HTM"") THEN RETURN ""text/html""" + NL
    t = t + "    IF file.EndsWith("".PIC"") THEN RETURN ""image/x-sim95pic""" + NL
    t = t + "    RETURN ""text/plain""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SendError (conn AS NET_Connection, status AS String, text AS String)" + NL
    t = t + "    conn.Send(""HTTP/1.0 "" + status)" + NL
    t = t + "    conn.Send(""Content-Type: text/html"")" + NL
    t = t + "    conn.Send("""")" + NL
    t = t + "    conn.Send(""<html><head><title>"" + status + ""</title></head><body><h1>"" + status + ""</h1><p>"" + text + ""</p><hr><i>HTTPD.SPK on "" + NET.HostName + ""</i></body></html>"")" + NL
    t = t + "    conn.Close()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnError (message AS String)" + NL
    t = t + "    win.Status = ""Error: "" + message" + NL
    t = t + "    log.Add(""ERROR "" + message)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    sock.Close()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    Put("C:\PROGRAMS\HTTPD.SPK")
END SUB
' simweb's setup, run by its installer: before the files are written, the
' folders, the list of sites and the stock web server's backup; after them,
' the web server restarted so the new one (with sites by name) takes over.

CONST STOCKHTTPD = "C:\PROGRAMS\HTTPD.ORG"

SUB WebSetup ()
    VAR old AS String
    IF NOT FS.Exists("C:\WEB\SITES") THEN FS.MakeDir("C:\WEB\SITES")
    IF NOT FS.Exists("C:\WEB\VHOSTS.TXT") THEN
        FS.Write("C:\WEB\VHOSTS.TXT", "; VHOSTS.TXT - sites the web server serves by name, one a line: name|folder" + NL _
            + "; (folders in C:\WEB). Personal Web Manager (C:\PROGRAMS\PWM.SPK) keeps it;" + NL _
            + "; you may edit it by hand too. For example:" + NL _
            + ";   www.coolsite.sim|C:\WEB\SITES\COOLSITE" + NL _
            + ";   coolbook.sim|C:\WEB\BOOK" + NL _
            + ";   *.dab.sim|C:\WEB\SITES\DAB" + NL)
        Print("  wrote C:\WEB\VHOSTS.TXT")
    END IF
    ' the stock web server is kept, once, so uninstalling can put it back
    ' (SimDNS, which came before simweb, kept it the same way)
    IF FS.Exists("C:\PROGRAMS\HTTPD.SPK") AND NOT FS.Exists(STOCKHTTPD) THEN
        old = FS.Read("C:\PROGRAMS\HTTPD.SPK")
        IF NOT old.Contains("simweb edition") AND NOT old.Contains("SimDNS edition") THEN
            FS.Write(STOCKHTTPD, old)
            Print("  kept the old web server as " + STOCKHTTPD)
        END IF
    END IF
END SUB

' Stops the running web server and starts the new one. If the web server is
' off (Settings), it stays off: the new one starts when it is turned on.
SUB RestartWeb ()
    VAR task AS String
    VAR was AS Bool
    FOR EACH task IN SYS.Tasks()
        IF task.Split("|")[1].Upper() = "HTTPD" THEN
            SYS.Kill(Int(Val(task.Split("|")[0])))
            was = TRUE
        END IF
    NEXT
    IF was THEN
        SYS.Run("C:\PROGRAMS\HTTPD.SPK")
        Print("  restarted the web server: it serves the sites in C:\WEB\VHOSTS.TXT by name")
    ELSE
        Print("  the web server is off (Settings); the new one starts when it is turned on")
    END IF
END SUB
