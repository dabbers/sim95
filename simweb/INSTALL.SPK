    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR menu AS GUI_Menu" + NL
    t = t + "VAR side AS GUI_Canvas" + NL
    t = t + "VAR clock AS GUI_Timer" + NL
    t = t + "VAR page AS String = ""main""" + NL
    t = t + "" + NL
