    t = t + "    b = GUI_Button.New(win)" + NL
    t = t + "    b.SetBounds(x, 216, 84, 26)" + NL
    t = t + "    b.Text = text" + NL
    t = t + "    b.onClick = h" + NL
    t = t + "    RETURN b" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
