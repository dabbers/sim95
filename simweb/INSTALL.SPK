    t = t + "    aSave = GUI_Button.New(win)" + NL
    t = t + "    aSave.SetBounds(460, 40, 100, 26)" + NL
    t = t + "    aSave.Text = ""&Save""" + NL
    t = t + "    aSave.onClick = SaveApps_Click" + NL
