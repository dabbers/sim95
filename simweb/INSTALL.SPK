    t = t + "    sRemove = SiteButton(""&Remove"", 296, Remove_Click)" + NL
    t = t + "    sCheck = SiteButton(""&Check DNS"", 386, Check_Click)" + NL
    t = t + "    sAddr = Para("""", 252, 36)" + NL
    t = t + "    sHint = Para(""A site's name must point at "" + here.Upper() + "" at SimNIC ("" + nicUrl + "")"" + EOL _" + NL
    t = t + "        + ""for Simxplorer users to reach it. Voyager users can always use the second address."", 296, 36)" + NL
    t = t + "" + NL
    t = t + "    ' Domain Apps" + NL
    t = t + "    aHead = Heading(""Name my apps under a domain"", 16)" + NL
    t = t + "    aDomLbl = Para(""Domain:"", 44, 20)" + NL
