' VAPOR|id=SIMHOST|name=SimHost|kind=program|version=e3481cb8|category=System|run=C:\PROGRAMS\MOVEIN.SPK|files=C:\WEB\INDEX.ASP;C:\PROGRAMS\MOVEIN.SPK|tasks=MOVEIN|startup=|folder=|about=Run every web app on one machine: SimBook, ColdMail, AskSim and ELIZA-95 each get a folder, the home page lists them, and Move In brings over your other machines' data.
' INSTALL.SPK - puts SimHost on this machine. Generated by tools/build-installer.mjs;
' edit the files in simhost/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It makes this
' machine a host for every web app at once: C:\SYSTEM\WEBAPPS.INI says
' mode=folders, so SimBook, ColdMail, AskSim and ELIZA-95 each install into a
' folder of their own (http://YOURNAME/book/, /mail/, /ask/, /eliza/). Any of
' them already here as the home page moves into its folder, the stock
' INDEX.HTM moves aside to WELCOME.HTM, and the home page becomes a list of
' them all. It also writes C:\PROGRAMS\MOVEIN.SPK, which copies another
' machine's data (posts, mail, saves...) here, so that machine can be closed.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)



    SetUpHost()
    File0()
    File1()
    Print("SimHost is installed (2 files).")


    Print("Open http://" + NET.HostName.Lower() + "/ in Voyager. Then install the web apps (in any order), and run C:\PROGRAMS\MOVEIN.SPK to bring your other machines' data here.")
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "<%" + NL
    t = t + "' INDEX.ASP - SimHost's front door (http://<machine>/): every web app on this" + NL
    t = t + "' machine, each in a folder of its own, with a line on what it is." + NL
    t = t + "VAR here AS String" + NL
    t = t + "VAR rows AS String" + NL
    t = t + "VAR apps AS Array OF String" + NL
    t = t + "VAR a AS String" + NL
    t = t + "VAR p AS Array OF String" + NL
    t = t + "VAR n AS Integer" + NL
    t = t + "VAR known AS String" + NL
    t = t + "here = SERVER.Name.Lower()" + NL
    t = t + "" + NL
    t = t + "apps.Add(""BOOK|BOOK.SPK|SimBook|The social network: profiles, friends, a news feed, walls, photos and pokes.|#3B5998"")" + NL
    t = t + "apps.Add(""MAIL|MAIL.SPK|ColdMail|Free webmail, with a real mail server behind it. Your address is you@"" + here + "".|#2E5E8C"")" + NL
    t = t + "apps.Add(""ASK|ASK.SPK|AskSim|A search engine with a real crawler that goes round every machine on the network.|#8B1A1A"")" + NL
    t = t + "apps.Add(""GEO|GEO.SPK|GeoSimies|Free homepages for everybody: neighborhoods, hit counters, guestbooks and webrings.|#008080"")" + NL
    t = t + "apps.Add(""ELIZA|BOT.SPK|ELIZA-95|A chatbot with Language-Model-of-Certain-Size manners.|#2F6F4F"")" + NL
    t = t + "apps.Add(""PAL|PAL.SPK|SimPal|Send and request money in SimBucks, and pay at any shop with a Pay with SimPal button.|#003087"")" + NL
    t = t + "apps.Add(""TUBE|TUBE.SPK|SimTube|Movies: watch them, put yours up, give them stars. They play in SimPlayer.|#CC0000"")" + NL
    t = t + "apps.Add(""VAPOR|CATALOG.TXT|Vapor|The store: get Vapor, then games and every SIM95 program.|#1B2838"")" + NL
    t = t + "' Apps that leave an APP.INF in their folder (name|blurb|colour) say how they" + NL
    t = t + "' show here; the list above covers ones installed before they did." + NL
    t = t + "FOR EACH a IN FS.List(""C:\WEB"")" + NL
    t = t + "    IF NOT a.EndsWith(""\"") THEN CONTINUE" + NL
    t = t + "    a = a.Substring(0, a.Length - 1).Upper()" + NL
    t = t + "    IF FS.Exists(""C:\WEB\"" + a + ""\APP.INF"") THEN" + NL
    t = t + "        p = FS.Read(""C:\WEB\"" + a + ""\APP.INF"").Trim().Split(""|"")" + NL
    t = t + "        IF p.Count >= 3 THEN" + NL
    t = t + "            n = n + 1" + NL
    t = t + "            rows = rows + Row(a, p[0], p[1], p[2], here)" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH known IN apps" + NL
    t = t + "        p = known.Split(""|"")" + NL
    t = t + "        IF p[0] = a AND FS.Exists(""C:\WEB\"" + a + ""\"" + p[1]) THEN" + NL
    t = t + "            n = n + 1" + NL
    t = t + "            rows = rows + Row(a, p[2], p[3], p[4], here)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "NEXT" + NL
    t = t + "IF n = 0 THEN rows = ""<tr><td>No web apps here yet. Install SimBook, ColdMail, AskSim, GeoSimies, ELIZA-95, SimPal or SimTube (from Vapor, or with their INSTALL.SPK): each goes in a folder of its own and shows up here.</td></tr>""" + NL
    t = t + "%>" + NL
    t = t + "<script runat=""server"">" + NL
    t = t + "' One app's row on the front page." + NL
    t = t + "FUNCTION Row (folder AS String, name AS String, blurb AS String, colour AS String, here AS String) AS String" + NL
    t = t + "    RETURN ""<tr><td bgcolor="""""" + SERVER.HtmlEncode(colour) + """""" width=""""150""""><a href=""""/"" + folder.Lower() + ""/""""><font color=""""#FFFFFF"""" size=""""4""""><b>"" + SERVER.HtmlEncode(name) + ""</b></font></a></td>"" _" + NL
    t = t + "        + ""<td>"" + SERVER.HtmlEncode(blurb) + ""<br><font size=""""2""""><a href=""""/"" + folder.Lower() + ""/"""">http://"" + here + ""/"" + folder.Lower() + ""/</a></font></td></tr>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "</script>" + NL
    t = t + "<html>" + NL
    t = t + "<head>" + NL
    t = t + "<title><%= SERVER.Name %> - SimHost</title>" + NL
    t = t + "<meta name=""description"" content=""SimHost: one machine running every SIM95 web app. Social network, webmail, search engine, free homepages, chat bot and the Vapor store."">" + NL
    t = t + "<meta name=""keywords"" content=""home page, portal, web host, social network, email, search engine, free homepages, chat bot, games"">" + NL
    t = t + "</head>" + NL
    t = t + "<body bgcolor=""#FFFFFF"">" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" bgcolor=""#000080""><tr><td><font color=""#FFFFFF"" size=""6""><b><%= SERVER.Name %></b></font><br><font color=""#C0C0FF"">a SimHost machine: <%= n %> web app<% IF n <> 1 THEN %>s<% END IF %> on one computer</font></td></tr></table>" + NL
    t = t + "<p>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""4"">" + NL
    t = t + "<%= rows %>" + NL
    t = t + "</table>" + NL
    t = t + "<p><font size=""2"">" + NL
    t = t + "<% IF FS.Exists(""C:\WEB\WELCOME.HTM"") THEN %><a href=""/welcome.htm"">The old home page</a> &middot; <% END IF %>" + NL
    t = t + "Moving in from another machine? Run C:\PROGRAMS\MOVEIN.SPK here." + NL
    t = t + "</font>" + NL
    t = t + "</body>" + NL
    t = t + "</html>" + NL
    Put("C:\WEB\INDEX.ASP")
END SUB

SUB File1 ()
    t = ""
    t = t + "' MOVEIN.SPK - moves another machine's data onto this one, so one machine can" + NL
    t = t + "' do what several did. It talks to the other machine's Files service (port" + NL
    t = t + "' 139, on by default) with that machine's user name and password, the ones in" + NL
    t = t + "' its C:\SYSTEM\USERS.INI, and copies what you tick:" + NL
    t = t + "'" + NL
    t = t + "'   SimBook    C:\BOOKDATA, and its pictures and photos" + NL
    t = t + "'   ColdMail   C:\MAILDATA (accounts and letters; not sign-ins)" + NL
    t = t + "'   AskSim     C:\ASKDATA, the index" + NL
    t = t + "'   ELIZA-95   C:\BOTDATA" + NL
    t = t + "'   Games      C:\GAMES: Vapor's library, games, saves and achievements" + NL
    t = t + "'   Frostbird  C:\FROST" + NL
    t = t + "'   Favorites  C:\SYSTEM\FAVORITE.TXT" + NL
    t = t + "'" + NL
    t = t + "' Nothing on the other machine is changed or deleted. Where this machine" + NL
    t = t + "' already has some of the same data, it asks first, and then only adds:" + NL
    t = t + "' files it has are kept, and lists (favorites, Vapor's library, SimBook's" + NL
    t = t + "' people) gain the lines they don't have yet." + NL
    t = t + "" + NL
    t = t + "CONST PORT = 139" + NL
    t = t + "CONST PATIENCE = 10000" + NL
    t = t + "CONST WEBAPPS = ""C:\SYSTEM\WEBAPPS.INI""" + NL
    t = t + "" + NL
    t = t + "VAR EOL AS String" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR hostBox AS GUI_TextBox" + NL
    t = t + "VAR userBox AS GUI_TextBox" + NL
    t = t + "VAR passBox AS GUI_TextBox" + NL
    t = t + "VAR cBook AS GUI_CheckBox" + NL
    t = t + "VAR cMail AS GUI_CheckBox" + NL
    t = t + "VAR cAsk AS GUI_CheckBox" + NL
    t = t + "VAR cBot AS GUI_CheckBox" + NL
    t = t + "VAR cGeo AS GUI_CheckBox" + NL
    t = t + "VAR cPal AS GUI_CheckBox" + NL
    t = t + "VAR cTube AS GUI_CheckBox" + NL
    t = t + "VAR cGames AS GUI_CheckBox" + NL
    t = t + "VAR cFrost AS GUI_CheckBox" + NL
    t = t + "VAR cFav AS GUI_CheckBox" + NL
    t = t + "VAR goBtn AS GUI_Button" + NL
    t = t + "VAR log AS GUI_ListBox" + NL
    t = t + "VAR clock AS GUI_Timer" + NL
    t = t + "VAR sock AS NET_Socket" + NL
    t = t + "VAR conn AS NET_Connection" + NL
    t = t + "" + NL
    t = t + "VAR busy AS Bool" + NL
    t = t + "VAR wantRun AS Bool" + NL
    t = t + "VAR host AS String" + NL
    t = t + "VAR sets AS Array OF String       ' what to copy, in order: BOOK, MAIL, ..." + NL
    t = t + "VAR answer AS String" + NL
    t = t + "VAR answered AS Bool" + NL
    t = t + "VAR closed AS Bool" + NL
    t = t + "VAR copied AS Integer" + NL
    t = t + "VAR kept AS Integer" + NL
    t = t + "VAR merged AS Integer" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    VAR l AS GUI_Label" + NL
    t = t + "    EOL = Chr(10)" + NL
    t = t + "    win = GUI_Window.New(""Move In"", 440, 430)" + NL
    t = t + "    win.Icon = ""app""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    l = GUI_Label.New(win)" + NL
    t = t + "    l.SetBounds(10, 8, 420, 32)" + NL
    t = t + "    l.Text = ""Copy another machine's data here, so this one machine can do its job."" + EOL + ""It uses that machine's Files service, with its user name and password.""" + NL
    t = t + "    l = GUI_Label.New(win)" + NL
    t = t + "    l.SetBounds(10, 50, 100, 20)" + NL
    t = t + "    l.Text = ""Machine:""" + NL
    t = t + "    hostBox = GUI_TextBox.New(win)" + NL
    t = t + "    hostBox.SetBounds(110, 48, 200, 22)" + NL
    t = t + "    l = GUI_Label.New(win)" + NL
    t = t + "    l.SetBounds(10, 76, 100, 20)" + NL
    t = t + "    l.Text = ""User name:""" + NL
    t = t + "    userBox = GUI_TextBox.New(win)" + NL
    t = t + "    userBox.SetBounds(110, 74, 200, 22)" + NL
    t = t + "    l = GUI_Label.New(win)" + NL
    t = t + "    l.SetBounds(10, 102, 100, 20)" + NL
    t = t + "    l.Text = ""Password:""" + NL
    t = t + "    passBox = GUI_TextBox.New(win)" + NL
    t = t + "    passBox.SetBounds(110, 100, 200, 22)" + NL
    t = t + "    passBox.Password = TRUE" + NL
    t = t + "    passBox.onEnter = Go_Click" + NL
    t = t + "    cBook = Check(""SimBook: people, posts, pictures"", 10, 132)" + NL
    t = t + "    cMail = Check(""ColdMail: accounts and letters"", 10, 152)" + NL
    t = t + "    cAsk = Check(""AskSim: the search index"", 10, 172)" + NL
    t = t + "    cBot = Check(""ELIZA-95: conversations"", 10, 192)" + NL
    t = t + "    cGames = Check(""Games: Vapor library, saves, achievements"", 220, 132)" + NL
    t = t + "    cFrost = Check(""Frostbird: your letters"", 220, 152)" + NL
    t = t + "    cFav = Check(""Simxplorer favorites"", 220, 172)" + NL
    t = t + "    cGeo = Check(""GeoSimies: homepages, guestbooks"", 220, 192)" + NL
    t = t + "    cPal = Check(""SimPal: accounts and money"", 10, 212)" + NL
    t = t + "    cTube = Check(""SimTube: movies and comments"", 220, 212)" + NL
    t = t + "    goBtn = GUI_Button.New(win)" + NL
    t = t + "    goBtn.SetBounds(330, 48, 100, 26)" + NL
    t = t + "    goBtn.Text = ""Move In""" + NL
    t = t + "    goBtn.onClick = Go_Click" + NL
    t = t + "    log = GUI_ListBox.New(win)" + NL
    t = t + "    log.SetBounds(10, 240, 420, 160)" + NL
    t = t + "    clock = GUI_Timer.New(win)" + NL
    t = t + "    clock.Interval = 100" + NL
    t = t + "    clock.onTick = Clock_OnTick" + NL
    t = t + "    clock.Start()" + NL
    t = t + "    sock = NET_Socket.New()" + NL
    t = t + "    sock.onMessage = Sock_OnMessage" + NL
    t = t + "    sock.onClose = Sock_OnClose" + NL
    t = t + "    IF SYS.Args.Count > 0 THEN hostBox.Text = SYS.Args[0]" + NL
    t = t + "    win.Status = ""Ready.""" + NL
    t = t + "    win.Show()" + NL
    t = t + "    hostBox.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Check (text AS String, x AS Integer, y AS Integer) AS GUI_CheckBox" + NL
    t = t + "    VAR c AS GUI_CheckBox" + NL
    t = t + "    c = GUI_CheckBox.New(win)" + NL
    t = t + "    c.SetBounds(x, y, 210, 20)" + NL
    t = t + "    c.Text = text" + NL
    t = t + "    c.Checked = TRUE" + NL
    t = t + "    RETURN c" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Say (text AS String)" + NL
    t = t + "    log.Add(text)" + NL
    t = t + "    log.ScrollToEnd()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Warn (text AS String) AS Bool" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = ""Move In""" + NL
    t = t + "    box.Kind = ""warn""" + NL
    t = t + "    box.Text = text" + NL
    t = t + "    box.Show()" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ what goes where" + NL
    t = t + "" + NL
    t = t + "FUNCTION SetName (s AS String) AS String" + NL
    t = t + "    SELECT CASE s" + NL
    t = t + "        CASE ""BOOK""" + NL
    t = t + "            RETURN ""SimBook""" + NL
    t = t + "        CASE ""MAIL""" + NL
    t = t + "            RETURN ""ColdMail""" + NL
    t = t + "        CASE ""ASK""" + NL
    t = t + "            RETURN ""AskSim""" + NL
    t = t + "        CASE ""BOT""" + NL
    t = t + "            RETURN ""ELIZA-95""" + NL
    t = t + "        CASE ""GAMES""" + NL
    t = t + "            RETURN ""Games""" + NL
    t = t + "        CASE ""FROST""" + NL
    t = t + "            RETURN ""Frostbird""" + NL
    t = t + "        CASE ""GEO""" + NL
    t = t + "            RETURN ""GeoSimies""" + NL
    t = t + "        CASE ""PAL""" + NL
    t = t + "            RETURN ""SimPal""" + NL
    t = t + "        CASE ""TUBE""" + NL
    t = t + "            RETURN ""SimTube""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""Favorites""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a set lives (the same place on both machines)." + NL
    t = t + "FUNCTION SetPath (s AS String) AS String" + NL
    t = t + "    SELECT CASE s" + NL
    t = t + "        CASE ""BOOK""" + NL
    t = t + "            RETURN ""C:\BOOKDATA""" + NL
    t = t + "        CASE ""MAIL""" + NL
    t = t + "            RETURN ""C:\MAILDATA""" + NL
    t = t + "        CASE ""ASK""" + NL
    t = t + "            RETURN ""C:\ASKDATA""" + NL
    t = t + "        CASE ""BOT""" + NL
    t = t + "            RETURN ""C:\BOTDATA""" + NL
    t = t + "        CASE ""GAMES""" + NL
    t = t + "            RETURN ""C:\GAMES""" + NL
    t = t + "        CASE ""FROST""" + NL
    t = t + "            RETURN ""C:\FROST""" + NL
    t = t + "        CASE ""GEO""" + NL
    t = t + "            RETURN ""C:\GEODATA""" + NL
    t = t + "        CASE ""PAL""" + NL
    t = t + "            RETURN ""C:\PALDATA""" + NL
    t = t + "        CASE ""TUBE""" + NL
    t = t + "            RETURN ""C:\TUBEDATA""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""C:\SYSTEM\FAVORITE.TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Lists that two machines' copies can be joined line by line." + NL
    t = t + "FUNCTION Joinable (path AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    p = path.Upper()" + NL
    t = t + "    IF p.StartsWith(""C:\GEODATA\HOODS\"") THEN RETURN TRUE" + NL
    t = t + "    RETURN p = ""C:\SYSTEM\FAVORITE.TXT"" OR p = ""C:\GAMES\LIBRARY.TXT"" OR p = ""C:\BOOKDATA\PEOPLE.TXT"" OR p = ""C:\GEODATA\MEMBERS.TXT"" OR p = ""C:\GEODATA\NEWEST.TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Not worth moving: who is signed in, and the like." + NL
    t = t + "FUNCTION Skip (path AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    p = path.Upper()" + NL
    t = t + "    RETURN p = ""C:\BOOKDATA\SESSIONS"" OR p = ""C:\MAILDATA\SESSIONS"" OR p = ""C:\MAILDATA\ALIVE.TXT"" OR p = ""C:\GEODATA\SESSIONS"" OR p = ""C:\PALDATA\SESSIONS"" OR p = ""C:\PALDATA\LOCK"" OR p = ""C:\TUBEDATA\SESSIONS""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a web app keeps its pages here (SimBook's pictures and GeoSimies'" + NL
    t = t + "' homepages go beside them): its folder, or the root." + NL
    t = t + "FUNCTION AppHere (folder AS String, marker AS String) AS String" + NL
    t = t + "    IF FS.Exists(""C:\WEB\"" + folder + ""\"" + marker) THEN RETURN ""C:\WEB\"" + folder" + NL
    t = t + "    IF FS.Exists(""C:\WEB\"" + marker) THEN RETURN ""C:\WEB""" + NL
    t = t + "    IF ReadOr(WEBAPPS, """").Contains(""mode=folders"") THEN RETURN ""C:\WEB\"" + folder" + NL
    t = t + "    RETURN ""C:\WEB""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION BookHere () AS String" + NL
    t = t + "    RETURN AppHere(""BOOK"", ""BOOK.SPK"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The neighborhoods GeoSimies keeps homepages in (geosimies/WEB/GEO.SPK)" + NL
    t = t + "FUNCTION Hoods () AS Array OF String" + NL
    t = t + "    RETURN [""AREA95"", ""SIMWOOD"", ""CHIPVALE"", ""HOMETOWN"", ""NEOTOKYO"", ""ROCKCITY"", ""STADIUM"", ""TOYLAND""]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Does this machine have anything (a file, not just empty folders) there?" + NL
    t = t + "FUNCTION HasData (path AS String) AS Bool" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    IF NOT FS.Exists(path) THEN RETURN FALSE" + NL
    t = t + "    IF NOT FS.IsDir(path) THEN RETURN TRUE" + NL
    t = t + "    FOR EACH f IN FS.List(path)" + NL
    t = t + "        IF f.EndsWith(""\"") THEN" + NL
    t = t + "            IF Skip(path + ""\"" + f.Substring(0, f.Length - 1)) THEN CONTINUE" + NL
    t = t + "            IF HasData(path + ""\"" + f.Substring(0, f.Length - 1)) THEN RETURN TRUE" + NL
    t = t + "        ELSE" + NL
    t = t + "            IF NOT Skip(path + ""\"" + f) THEN RETURN TRUE" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ starting" + NL
    t = t + "" + NL
    t = t + "' Everything that needs asking is asked here; the copying happens in the clock," + NL
    t = t + "' because a failed Connect spoils the handler it happens in." + NL
    t = t + "SUB Go_Click ()" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR all AS Array OF String" + NL
    t = t + "    IF busy THEN RETURN" + NL
    t = t + "    host = hostBox.Text.Trim().Upper()" + NL
    t = t + "    IF host = """" THEN" + NL
    t = t + "        Warn(""Type the name of the machine to move in from."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF host = NET.HostName.Upper() OR host = NET.HostName.Split(""."")[0].Upper() THEN" + NL
    t = t + "        Warn(""That is this machine. Type the name of the other one."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    sets.Clear()" + NL
    t = t + "    IF cBook.Checked THEN all.Add(""BOOK"")" + NL
    t = t + "    IF cMail.Checked THEN all.Add(""MAIL"")" + NL
    t = t + "    IF cAsk.Checked THEN all.Add(""ASK"")" + NL
    t = t + "    IF cBot.Checked THEN all.Add(""BOT"")" + NL
    t = t + "    IF cGames.Checked THEN all.Add(""GAMES"")" + NL
    t = t + "    IF cFrost.Checked THEN all.Add(""FROST"")" + NL
    t = t + "    IF cFav.Checked THEN all.Add(""FAV"")" + NL
    t = t + "    IF cGeo.Checked THEN all.Add(""GEO"")" + NL
    t = t + "    IF cPal.Checked THEN all.Add(""PAL"")" + NL
    t = t + "    IF cTube.Checked THEN all.Add(""TUBE"")" + NL
    t = t + "    IF all.Count = 0 THEN" + NL
    t = t + "        Warn(""Tick what to move in."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    busy = TRUE" + NL
    t = t + "    FOR EACH s IN all" + NL
    t = t + "        IF s = ""PAL"" AND HasData(SetPath(s)) THEN" + NL
    t = t + "            ' two ledgers can't be added together without making or losing money" + NL
    t = t + "            Warn(""This machine already has SimPal accounts in C:\PALDATA, and two SimPal ledgers can't be joined without money going missing. SimPal is skipped."" + EOL + EOL + ""To move it anyway, rename C:\PALDATA here first."")" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF s = ""TUBE"" AND HasData(SetPath(s)) THEN" + NL
    t = t + "            ' movies are numbered: two SimTubes' numbers would collide" + NL
    t = t + "            Warn(""This machine already has SimTube movies in C:\TUBEDATA, and two SimTubes can't be joined: their movie numbers would collide. SimTube is skipped."" + EOL + EOL + ""To move it anyway, rename C:\TUBEDATA here first."")" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF HasData(SetPath(s)) THEN" + NL
    t = t + "            box = GUI_MessageBox.New(win)" + NL
    t = t + "            box.Title = ""Move In""" + NL
    t = t + "            box.Kind = ""confirm""" + NL
    t = t + "            box.Buttons = ""yesno""" + NL
    t = t + "            box.Text = ""This machine already has "" + SetName(s) + "" data in "" + SetPath(s) + ""."" + EOL + EOL + ""Add "" + host + ""'s to it? Yours stays as it is: only what is not here yet is added."" + EOL + EOL + ""No skips "" + SetName(s) + "".""" + NL
    t = t + "            IF NOT box.Show() THEN CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        sets.Add(s)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF sets.Count = 0 THEN" + NL
    t = t + "        busy = FALSE" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    goBtn.Enabled = FALSE" + NL
    t = t + "    log.Clear()" + NL
    t = t + "    copied = 0" + NL
    t = t + "    kept = 0" + NL
    t = t + "    merged = 0" + NL
    t = t + "    Say(""Connecting to "" + host + ""..."")" + NL
    t = t + "    win.Status = ""Connecting to "" + host + ""...""" + NL
    t = t + "    wantRun = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Clock_OnTick ()" + NL
    t = t + "    IF NOT wantRun THEN RETURN" + NL
    t = t + "    wantRun = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        MoveIn()" + NL
    t = t + "    CATCH err" + NL
    t = t + "        Finished(""Stopped: "" + err)" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Finished (text AS String)" + NL
    t = t + "    Say(text)" + NL
    t = t + "    win.Status = text" + NL
    t = t + "    goBtn.Enabled = TRUE" + NL
    t = t + "    busy = FALSE" + NL
    t = t + "    IF NOT closed THEN" + NL
    t = t + "        TRY" + NL
    t = t + "            conn.Close()" + NL
    t = t + "        CATCH err" + NL
    t = t + "        END TRY" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ copying" + NL
    t = t + "" + NL
    t = t + "SUB MoveIn ()" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR reply AS String" + NL
    t = t + "    VAR before AS Integer" + NL
    t = t + "    VAR there AS String" + NL
    t = t + "    VAR hood AS String" + NL
    t = t + "    closed = FALSE" + NL
    t = t + "    conn = sock.Connect(host, PORT)" + NL
    t = t + "    reply = Request(""AUTH "" + userBox.Text.Trim() + ""|"" + passBox.Text)" + NL
    t = t + "    IF NOT reply.StartsWith(""OK"") THEN" + NL
    t = t + "        Finished(host + "" did not take that user name and password (its Files service said: "" + reply + "")."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    Say(""Signed in to "" + host + ""."")" + NL
    t = t + "    FOR EACH s IN sets" + NL
    t = t + "        before = copied + merged" + NL
    t = t + "        win.Status = ""Moving in "" + SetName(s) + ""...""" + NL
    t = t + "        IF s = ""FAV"" THEN" + NL
    t = t + "            CopyFile(SetPath(s), SetPath(s))" + NL
    t = t + "        ELSE" + NL
    t = t + "            CopyTree(SetPath(s), SetPath(s))" + NL
    t = t + "        END IF" + NL
    t = t + "        IF s = ""BOOK"" THEN" + NL
    t = t + "            ' the pictures are beside SimBook's pages, at the root or in its folder" + NL
    t = t + "            IF ThereHas(""C:\WEB\BOOK\BOOK.SPK"") THEN" + NL
    t = t + "                CopyTree(""C:\WEB\BOOK\PICS"", BookHere() + ""\PICS"")" + NL
    t = t + "                CopyTree(""C:\WEB\BOOK\PHOTOS"", BookHere() + ""\PHOTOS"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                CopyTree(""C:\WEB\PICS"", BookHere() + ""\PICS"")" + NL
    t = t + "                CopyTree(""C:\WEB\PHOTOS"", BookHere() + ""\PHOTOS"")" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        IF s = ""GEO"" THEN" + NL
    t = t + "            ' the homepages' own folders are beside GeoSimies' pages, at the root or in its folder" + NL
    t = t + "            IF ThereHas(""C:\WEB\GEO\GEO.SPK"") THEN" + NL
    t = t + "                there = ""C:\WEB\GEO""" + NL
    t = t + "            ELSE" + NL
    t = t + "                there = ""C:\WEB""" + NL
    t = t + "            END IF" + NL
    t = t + "            FOR EACH hood IN Hoods()" + NL
    t = t + "                IF ThereHas(there + ""\"" + hood) THEN CopyTree(there + ""\"" + hood, AppHere(""GEO"", ""GEO.SPK"") + ""\"" + hood)" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "        Say(SetName(s) + "": "" + Str(copied + merged - before) + "" files moved in."")" + NL
    t = t + "    NEXT" + NL
    t = t + "    Finished(""Done: "" + Str(copied) + "" files copied, "" + Str(merged) + "" lists joined, "" + Str(kept) + "" kept as they were here."")" + NL
    t = t + "    Say(""Nothing on "" + host + "" was changed. Once you are happy, you can close it."")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A folder, and any folders it is in that are not there yet (SimBook's" + NL
    t = t + "' pictures go in C:\WEB\BOOK\PICS even before SimBook is installed here)." + NL
    t = t + "SUB MakeDirs (path AS String)" + NL
    t = t + "    VAR part AS String" + NL
    t = t + "    VAR sofar AS String" + NL
    t = t + "    FOR EACH part IN path.Split(""\"")" + NL
    t = t + "        IF part = """" THEN CONTINUE" + NL
    t = t + "        IF sofar = """" THEN" + NL
    t = t + "            sofar = part" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        sofar = sofar + ""\"" + part" + NL
    t = t + "        IF NOT FS.Exists(sofar) THEN FS.MakeDir(sofar)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One request to the Files service, and its reply." + NL
    t = t + "FUNCTION Request (text AS String) AS String" + NL
    t = t + "    VAR since AS Integer" + NL
    t = t + "    answered = FALSE" + NL
    t = t + "    answer = """"" + NL
    t = t + "    IF closed THEN THROW host + "" hung up""" + NL
    t = t + "    conn.Send(text)" + NL
    t = t + "    since = SYS.Ticks" + NL
    t = t + "    WHILE NOT answered AND NOT closed AND SYS.Ticks - since < PATIENCE" + NL
    t = t + "        SYS.Sleep(20)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF NOT answered THEN THROW host + "" stopped answering""" + NL
    t = t + "    RETURN answer" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ThereHas (path AS String) AS Bool" + NL
    t = t + "    RETURN Request(""STAT "" + path).StartsWith(""OK"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A folder there, into a folder here." + NL
    t = t + "SUB CopyTree (there AS String, here AS String)" + NL
    t = t + "    VAR reply AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR first AS Bool = TRUE" + NL
    t = t + "    IF Skip(there) THEN RETURN" + NL
    t = t + "    reply = Request(""LIST "" + there)" + NL
    t = t + "    IF NOT reply.StartsWith(""OK"") THEN" + NL
    t = t + "        Say(""  "" + host + "" has no "" + there + ""."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    MakeDirs(here)" + NL
    t = t + "    FOR EACH line IN reply.Lines()" + NL
    t = t + "        IF first THEN" + NL
    t = t + "            first = FALSE" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        p = line.Split(""|"")" + NL
    t = t + "        IF p.Count < 2 THEN CONTINUE" + NL
    t = t + "        IF p[1] = ""D"" THEN" + NL
    t = t + "            CopyTree(there + ""\"" + p[0], here + ""\"" + p[0])" + NL
    t = t + "        ELSE" + NL
    t = t + "            CopyFile(there + ""\"" + p[0], here + ""\"" + p[0])" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB CopyFile (there AS String, here AS String)" + NL
    t = t + "    VAR reply AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR have AS String" + NL
    t = t + "    VAR added AS Integer" + NL
    t = t + "    IF Skip(there) THEN RETURN" + NL
    t = t + "    IF FS.Exists(here) AND NOT Joinable(here) THEN" + NL
    t = t + "        kept = kept + 1" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    reply = Request(""READ "" + there)" + NL
    t = t + "    IF NOT reply.StartsWith(""OK"") THEN" + NL
    t = t + "        Say(""  could not read "" + there + "": "" + reply)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    text = """"" + NL
    t = t + "    IF reply.Contains(EOL) THEN text = reply.Substring(reply.IndexOf(EOL) + 1, reply.Length - reply.IndexOf(EOL) - 1)" + NL
    t = t + "    IF NOT FS.Exists(here) THEN" + NL
    t = t + "        FS.Write(here, text)" + NL
    t = t + "        copied = copied + 1" + NL
    t = t + "        log.Add(""  "" + here)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' a list both machines have: add their lines that are not here" + NL
    t = t + "    have = FS.Read(here)" + NL
    t = t + "    IF have <> """" AND NOT have.EndsWith(EOL) THEN have = have + EOL" + NL
    t = t + "    FOR EACH line IN text.Lines()" + NL
    t = t + "        IF line.Trim() = """" THEN CONTINUE" + NL
    t = t + "        IF (EOL + have).Contains(EOL + line + EOL) THEN CONTINUE" + NL
    t = t + "        have = have + line + EOL" + NL
    t = t + "        added = added + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF added > 0 THEN" + NL
    t = t + "        FS.Write(here, have)" + NL
    t = t + "        merged = merged + 1" + NL
    t = t + "        log.Add(""  "" + here + "" (+"" + Str(added) + "" lines)"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        kept = kept + 1" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnMessage (c AS NET_Connection, message AS String)" + NL
    t = t + "    answer = message" + NL
    t = t + "    answered = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnClose (c AS NET_Connection)" + NL
    t = t + "    closed = TRUE" + NL
    t = t + "END SUB" + NL
    Put("C:\PROGRAMS\MOVEIN.SPK")
END SUB

' HTTPD.SPK serves INDEX.ASP for a folder only when it has no INDEX.HTM, so the
' stock home page steps aside (to the first free name) instead of being deleted.
SUB MoveHomePage ()
    VAR names AS Array OF String
    VAR name AS String
    IF NOT FS.Exists("C:\WEB\INDEX.HTM") THEN RETURN
    names = ["WELCOME.HTM", "INDEX1.HTM", "INDEX2.HTM", "INDEX3.HTM", "INDEX4.HTM", "INDEX5.HTM", "INDEX6.HTM", "INDEX7.HTM", "INDEX8.HTM", "INDEX9.HTM"]
    FOR EACH name IN names
        IF NOT FS.Exists("C:\WEB\" + name) THEN
            FS.Rename("C:\WEB\INDEX.HTM", "C:\WEB\" + name)
            Print("  moved the old home page to C:\WEB\" + name)
            RETURN
        END IF
    NEXT
    THROW "C:\WEB\INDEX.HTM is in the way and there is nowhere to move it. Rename it yourself and run this again."
END SUB

' SimHost's setup, run by its installer before it writes anything: from now
' on this machine keeps every web app in a folder of its own (C:\WEB\BOOK,
' C:\WEB\MAIL, C:\WEB\ASK, C:\WEB\ELIZA), and the home page lists them.
SUB SetUpHost ()
    FS.Write("C:\SYSTEM\WEBAPPS.INI", "mode=folders" + NL)
    Print("  C:\SYSTEM\WEBAPPS.INI says mode=folders: web apps go in folders from now on")
    Relocate()
    MoveHomePage()
END SUB

' A web app that was installed as the home page moves into its folder. files:
' what it wrote in C:\WEB. shared: names other web apps write too; one of
' those moves only if it is this app's (it mentions marker, its SPARK file).
' dirs: its folders in C:\WEB, which move whole.
SUB MoveApp (name AS String, folder AS String, marker AS String, files AS String, shared AS String, dirs AS String)
    VAR f AS String
    VAR missing AS Array OF String
    VAR moved AS Integer
    IF NOT FS.Exists("C:\WEB\" + marker) THEN RETURN
    IF NOT FS.Exists("C:\WEB\" + folder) THEN FS.MakeDir("C:\WEB\" + folder)
    FOR EACH f IN files.Split(";")
        IF f = "" THEN CONTINUE
        IF FS.Exists("C:\WEB\" + folder + "\" + f) THEN CONTINUE
        IF NOT FS.Exists("C:\WEB\" + f) THEN
            missing.Add(f)
            CONTINUE
        END IF
        IF (";" + shared + ";").Contains(";" + f + ";") AND f <> marker THEN
            IF NOT FS.Read("C:\WEB\" + f).Upper().Contains("""" + marker + """") THEN
                missing.Add(f)
                CONTINUE
            END IF
        END IF
        FS.Rename("C:\WEB\" + f, "C:\WEB\" + folder + "\" + f)
        moved = moved + 1
    NEXT
    FOR EACH f IN dirs.Split(";")
        IF f = "" THEN CONTINUE
        IF FS.Exists("C:\WEB\" + f) AND NOT FS.Exists("C:\WEB\" + folder + "\" + f) THEN FS.Rename("C:\WEB\" + f, "C:\WEB\" + folder + "\" + f)
    NEXT
    Print("  moved " + name + " (" + Str(moved) + " files) into C:\WEB\" + folder + ": http://" + NET.HostName.Lower() + "/" + folder.Lower() + "/")
    IF missing.Count > 0 THEN Print("  " + name + " is missing " + missing.Join(", ") + " (another web app wrote over them): install " + name + " again and they come back.")
END SUB

SUB Relocate ()
    MoveApp("SimBook", "BOOK", "BOOK.SPK", "BOOK.SPK;DELETE.ASP;EDIT.ASP;FRIEND.ASP;HOME.ASP;INDEX.ASP;JOIN.ASP;LOGIN.ASP;LOGOUT.ASP;NOPIC.PIC;NOTIFY.ASP;PASSWORD.ASP;PEOPLE.ASP;PHOTOS.ASP;PICTURE.ASP;POKE.ASP;POST.ASP;PROFILE.ASP;REPLY.ASP;RESET.ASP;SHRINK.SPK;SIMBOOK.HTM;VIEW.ASP;VOTE.ASP", "DELETE.ASP;EDIT.ASP;HOME.ASP;INDEX.ASP;JOIN.ASP;LOGIN.ASP;LOGOUT.ASP", "PICS;PHOTOS")
    MoveApp("ColdMail", "MAIL", "MAIL.SPK", "COLDMAIL.HTM;COMPOSE.ASP;DELETE.ASP;GETMAIL.TXT;HOST.ASP;INBOX.ASP;INDEX.ASP;JOIN.ASP;LOGIN.ASP;LOGOUT.ASP;MAIL.SPK;READ.ASP", "DELETE.ASP;INDEX.ASP;JOIN.ASP;LOGIN.ASP;LOGOUT.ASP", "DIST")
    MoveApp("AskSim", "ASK", "ASK.SPK", "ADDURL.ASP;ASK.SPK;ASKSIM.HTM;CACHE.ASP;INDEX.ASP;SIMMS.PIC", "INDEX.ASP", "")
    MoveApp("GeoSimies", "GEO", "GEO.SPK", "BLANK.TPL;CLASSIC.TPL;EDIT.ASP;GEO.SPK;GEOSIMIE.HTM;GUEST.ASP;HOOD.ASP;INDEX.ASP;JOIN.ASP;LOGIN.ASP;LOGOUT.ASP;RING.ASP;RINGS.ASP;SHRINE.TPL;SIGNUP.ASP;STARS.TPL;UPLOAD.ASP", "EDIT.ASP;INDEX.ASP;JOIN.ASP;LOGIN.ASP;LOGOUT.ASP;UPLOAD.ASP", "CLIPART;AREA95;SIMWOOD;CHIPVALE;HOMETOWN;NEOTOKYO;ROCKCITY;STADIUM;TOYLAND")
    MoveApp("SimPal", "PAL", "PAL.SPK", "ADMIN.ASP;CHECKPAY.TXT;HISTORY.ASP;HOME.ASP;INDEX.ASP;JOIN.ASP;LOGIN.ASP;LOGOUT.ASP;MERCHANT.ASP;PAL.SPK;PAY.ASP;REQUEST.ASP;SEND.ASP;SIMMART.ASP;SIMPAL.HTM;THANKS.TXT;VERIFY.ASP", "HOME.ASP;INDEX.ASP;JOIN.ASP;LOGIN.ASP;LOGOUT.ASP", "")
    MoveApp("SimTube", "TUBE", "TUBE.SPK", "COMMENT.ASP;GETPLAY.ASP;INDEX.ASP;JOIN.ASP;LOGIN.ASP;LOGOUT.ASP;MOVIE.ASP;RATE.ASP;SIMTUBE.HTM;THUMB.ASP;TOP.ASP;TUBE.SPK;UPLOAD.ASP;WATCH.ASP", "INDEX.ASP;JOIN.ASP;LOGIN.ASP;LOGOUT.ASP;UPLOAD.ASP", "")
    MoveApp("ELIZA-95", "ELIZA", "BOT.SPK", "BOT.SPK;ELIZA.HTM;INDEX.ASP", "INDEX.ASP", "")
END SUB
