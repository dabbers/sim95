    t = t + "        var a = args.shift();" + NL
    t = t + "        if (k === ""s"") out += typeof a === ""string"" ? a : __inspect(a, 1);" + NL
    t = t + "        else if (k === ""d"" || k === ""i"") out += k === ""i"" ? String(parseInt(a)) : String(Number(a));" + NL
    t = t + "        else if (k === ""f"") out += String(parseFloat(a));" + NL
    t = t + "        else if (k === ""j"") out += JSON.stringify(a);" + NL
    t = t + "        else out += __inspect(a, 4);" + NL
    t = t + "        i += 2;" + NL
    t = t + "        continue;" + NL
    t = t + "      }" + NL
    t = t + "    }" + NL
    t = t + "    out += c;" + NL
    t = t + "    i++;" + NL
    t = t + "  }" + NL
    t = t + "  args.forEach(function (a) { out += "" "" + (typeof a === ""string"" ? a : __inspect(a)); });" + NL
    t = t + "  return out;" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "// ---------------------------------------------------------------- console and process" + NL
    t = t + "" + NL
    t = t + "var console = {" + NL
    t = t + "  log: function () { __n.write(__format.apply(null, arguments) + ""\n""); }," + NL
    t = t + "  info: function () { __n.write(__format.apply(null, arguments) + ""\n""); }," + NL
    t = t + "  debug: function () { __n.write(__format.apply(null, arguments) + ""\n""); }," + NL
    t = t + "  warn: function () { __n.write(__format.apply(null, arguments) + ""\n""); }," + NL
