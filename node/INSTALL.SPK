    t = t + "  if (keys.length === 0) return name + ""{}"";" + NL
    t = t + "  var parts = keys.map(function (k) {" + NL
    t = t + "    var key = /*plain names bare*/ __plainKey(k) ? k : ""'"" + k + ""'"";" + NL
    t = t + "    return key + "": "" + __inspect(v[k], depth - 1, inner);" + NL
    t = t + "  });" + NL
    t = t + "  var one = name + ""{ "" + parts.join("", "") + "" }"";" + NL
    t = t + "  return one.length <= 72 ? one : name + ""{\n"" + parts.map(function (s) { return ""  "" + s.split(""\n"").join(""\n  ""); }).join("",\n"") + ""\n}"";" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function __plainKey(k) {" + NL
    t = t + "  if (k === """") return false;" + NL
    t = t + "  for (var i = 0; i < k.length; i++) {" + NL
    t = t + "    var c = k.charAt(i);" + NL
    t = t + "    var ok = (c >= ""a"" && c <= ""z"") || (c >= ""A"" && c <= ""Z"") || c === ""_"" || c === ""$"" || (i > 0 && c >= ""0"" && c <= ""9"");" + NL
    t = t + "    if (!ok) return false;" + NL
    t = t + "  }" + NL
    t = t + "  return true;" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "// util.format: %s %d %i %f %j %o %O %%, then the rest inspected" + NL
    t = t + "function __format() {" + NL
    t = t + "  var args = Array.prototype.slice.call(arguments);" + NL
    t = t + "  if (typeof args[0] !== ""string"") return args.map(function (a) { return __inspect(a); }).join("" "");" + NL
    t = t + "  var f = args.shift(), out = """", i = 0;" + NL
    t = t + "  while (i < f.length) {" + NL
    t = t + "    var c = f.charAt(i);" + NL
    t = t + "    if (c === ""%"" && i + 1 < f.length) {" + NL
    t = t + "      var k = f.charAt(i + 1);" + NL
    t = t + "      if (k === ""%"") { out += ""%""; i += 2; continue; }" + NL
    t = t + "      if (""sdifjoOc"".indexOf(k) >= 0) {" + NL
    t = t + "        if (k === ""c"") { args.shift(); i += 2; continue; }" + NL
