' VAPOR|id=NODE|name=Node.js for SIM95|kind=program|version=7203161f|category=Programming|run=C:\PROGRAMS\NODE.SPK|files=C:\NODE\LIB\ASSERT.JS;C:\NODE\LIB\BOOT.JS;C:\NODE\LIB\CHILDPRO.JS;C:\NODE\LIB\DNS.JS;C:\NODE\LIB\EVENTS.JS;C:\NODE\LIB\FS.JS;C:\NODE\LIB\HTTP.JS;C:\NODE\LIB\NET.JS;C:\NODE\LIB\OS.JS;C:\NODE\LIB\PATH.JS;C:\NODE\LIB\QUERYSTR.JS;C:\NODE\LIB\READLINE.JS;C:\NODE\LIB\TIMERS.JS;C:\NODE\LIB\URL.JS;C:\NODE\LIB\UTIL.JS;C:\PROGRAMS\NODE.SPK|tasks=NODE|startup=|folder=|about=JavaScript outside the browser: node app.js in Sim Shell, or Node's own prompt. console, require, fs, path, events, net, http, readline and more; and npm, with the network's package registry on STARTHERE.
' INSTALL.SPK - puts Node.js for SIM95 on this machine. Generated by tools/build-installer.mjs;
' edit the files in node/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It writes
' C:\PROGRAMS\NODE.SPK (Node: the JavaScript engine, its window and event
' loop) and Node's modules in C:\NODE\LIB, and makes C:\NODE\MODULES for the
' packages npm installs. In Sim Shell: node app.js, or node alone for the
' prompt. File names are 8.3, so node_modules is NODE_MOD and package.json is
' PACKAGE.JSN.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)

    IF NOT FS.Exists(Dest("C:\NODE")) THEN FS.MakeDir(Dest("C:\NODE"))
    IF NOT FS.Exists(Dest("C:\NODE\LIB")) THEN FS.MakeDir(Dest("C:\NODE\LIB"))
    IF NOT FS.Exists(Dest("C:\NODE\MODULES")) THEN FS.MakeDir(Dest("C:\NODE\MODULES"))


    File0()
    File1()
    File2()
    File3()
    File4()
    File5()
    File6()
    File7()
    File8()
    File9()
    File10()
    File11()
    File12()
    File13()
    File14()
    File15()
    Print("Node.js for SIM95 is installed (16 files).")


    Print("Node is installed. In Sim Shell: node -v, node app.js, or node for its prompt.")
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "// assert" + NL
    t = t + "class AssertionError extends Error {" + NL
    t = t + "  constructor(message, actual, expected, operator) {" + NL
    t = t + "    super(message);" + NL
    t = t + "    this.name = ""AssertionError"";" + NL
    t = t + "    this.code = ""ERR_ASSERTION"";" + NL
    t = t + "    this.actual = actual;" + NL
    t = t + "    this.expected = expected;" + NL
    t = t + "    this.operator = operator;" + NL
    t = t + "  }" + NL
    t = t + "}" + NL
    t = t + "function fail(message, actual, expected, operator, dflt) {" + NL
    t = t + "  if (message instanceof Error) throw message;" + NL
    t = t + "  throw new AssertionError(message || dflt, actual, expected, operator);" + NL
    t = t + "}" + NL
    t = t + "function assert(v, message) { if (!v) fail(message, v, true, ""=="", ""The expression evaluated to a falsy value: "" + __inspect(v, 1, [0])); }" + NL
    t = t + "const same = (a, b) => JSON.stringify(a) === JSON.stringify(b);" + NL
    t = t + "assert.ok = assert;" + NL
    t = t + "assert.AssertionError = AssertionError;" + NL
    t = t + "assert.fail = (m) => fail(m, undefined, undefined, ""fail"", ""Failed"");" + NL
    t = t + "assert.equal = (a, b, m) => { if (a != b) fail(m, a, b, ""=="", __inspect(a, 1, [0]) + "" == "" + __inspect(b, 1, [0])); };" + NL
    t = t + "assert.notEqual = (a, b, m) => { if (a == b) fail(m, a, b, ""!="", __inspect(a, 1, [0]) + "" != "" + __inspect(b, 1, [0])); };" + NL
    t = t + "assert.strictEqual = (a, b, m) => { if (a !== b) fail(m, a, b, ""strictEqual"", ""Expected values to be strictly equal:\n\n"" + __inspect(a, 1, [0]) + "" !== "" + __inspect(b, 1, [0])); };" + NL
    t = t + "assert.notStrictEqual = (a, b, m) => { if (a === b) fail(m, a, b, ""notStrictEqual"", ""Expected values to differ: "" + __inspect(a, 1, [0])); };" + NL
    t = t + "assert.deepEqual = (a, b, m) => { if (!same(a, b)) fail(m, a, b, ""deepEqual"", ""Expected values to be loosely deep-equal:\n\n"" + __inspect(a, 2, [0]) + ""\n\nshould loosely deep-equal\n\n"" + __inspect(b, 2, [0])); };" + NL
    t = t + "assert.deepStrictEqual = (a, b, m) => { if (!same(a, b)) fail(m, a, b, ""deepStrictEqual"", ""Expected values to be strictly deep-equal:\n\n"" + __inspect(a, 2, [0]) + ""\n\nshould equal\n\n"" + __inspect(b, 2, [0])); };" + NL
    t = t + "assert.notDeepStrictEqual = (a, b, m) => { if (same(a, b)) fail(m, a, b, ""notDeepStrictEqual"", ""Expected values not to be deep-equal""); };" + NL
    t = t + "assert.throws = (fn, expected, m) => {" + NL
    t = t + "  try { fn(); } catch (e) {" + NL
    t = t + "    if (typeof expected === ""function"" && expected.prototype !== undefined && !(e instanceof expected)) throw e;" + NL
    t = t + "    return;" + NL
    t = t + "  }" + NL
    t = t + "  fail(typeof expected === ""string"" ? expected : m, undefined, undefined, ""throws"", ""Missing expected exception."");" + NL
    t = t + "};" + NL
    t = t + "assert.doesNotThrow = (fn) => fn();" + NL
    t = t + "assert.match = (s, re, m) => { if (String(s).indexOf(String(re)) < 0) fail(m, s, re, ""match"", ""The input did not match: "" + s); };" + NL
    t = t + "assert.strict = assert;" + NL
    t = t + "module.exports = assert;" + NL
    Put("C:\NODE\LIB\ASSERT.JS")
END SUB

