SUB File9 ()
    t = ""
    t = t + "// path - SIM95 paths: C:\DIR\FILE.TXT. Forward slashes are taken as \." + NL
    t = t + "const sep = ""\\"";" + NL
    t = t + "function clean(p) { return String(p).split(""/"").join(""\\""); }" + NL
    t = t + "function normalize(p) {" + NL
    t = t + "  p = clean(p);" + NL
    t = t + "  if (p === """") return ""."";" + NL
    t = t + "  const drive = p.length >= 2 && p.charAt(1) === "":"" ? p.substring(0, 2).toUpperCase() : """";" + NL
    t = t + "  let rest = drive ? p.substring(2) : p;" + NL
    t = t + "  const abs = rest.charAt(0) === ""\\"";" + NL
    t = t + "  const out = [];" + NL
    t = t + "  for (const part of rest.split(""\\"")) {" + NL
    t = t + "    if (part === """" || part === ""."") continue;" + NL
    t = t + "    if (part === "".."") {" + NL
    t = t + "      if (out.length && out[out.length - 1] !== "".."") out.pop();" + NL
    t = t + "      else if (!abs) out.push("".."");" + NL
    t = t + "      continue;" + NL
    t = t + "    }" + NL
    t = t + "    out.push(part);" + NL
    t = t + "  }" + NL
    t = t + "  let s = out.join(""\\"");" + NL
    t = t + "  if (abs) s = ""\\"" + s;" + NL
    t = t + "  s = drive + s;" + NL
    t = t + "  if (s === """") return ""."";" + NL
    t = t + "  if (s === drive) return drive + ""\\"";" + NL
    t = t + "  return s;" + NL
    t = t + "}" + NL
    t = t + "function isAbsolute(p) { p = clean(p); return p.charAt(0) === ""\\"" || (p.length > 2 && p.charAt(1) === "":"" && p.charAt(2) === ""\\""); }" + NL
    t = t + "function join() {" + NL
    t = t + "  const parts = Array.prototype.slice.call(arguments).filter((x) => x !== """");" + NL
    t = t + "  return parts.length ? normalize(parts.join(""\\"")) : ""."";" + NL
    t = t + "}" + NL
    t = t + "function resolve() {" + NL
    t = t + "  let p = """";" + NL
    t = t + "  for (let i = arguments.length - 1; i >= 0 && !isAbsolute(p); i--) p = arguments[i] + (p ? ""\\"" + p : """");" + NL
    t = t + "  if (!isAbsolute(p)) p = process.cwd() + (p ? ""\\"" + p : """");" + NL
    t = t + "  if (clean(p).charAt(0) === ""\\"") p = ""C:"" + p;" + NL
    t = t + "  p = normalize(p);" + NL
    t = t + "  return p.length > 3 && p.charAt(p.length - 1) === ""\\"" ? p.substring(0, p.length - 1) : p;" + NL
    t = t + "}" + NL
    t = t + "function dirname(p) {" + NL
    t = t + "  p = clean(p);" + NL
    t = t + "  const i = p.lastIndexOf(""\\"");" + NL
    t = t + "  if (i < 0) return ""."";" + NL
    t = t + "  if (i === 0) return ""\\"";" + NL
    t = t + "  if (i === 2 && p.charAt(1) === "":"") return p.substring(0, 3);" + NL
    t = t + "  return p.substring(0, i);" + NL
    t = t + "}" + NL
    t = t + "function basename(p, ext) {" + NL
    t = t + "  p = clean(p);" + NL
    t = t + "  while (p.length > 1 && p.charAt(p.length - 1) === ""\\"") p = p.substring(0, p.length - 1);" + NL
    t = t + "  let b = p.substring(p.lastIndexOf(""\\"") + 1);" + NL
    t = t + "  if (ext && b.length > ext.length && b.substring(b.length - ext.length).toUpperCase() === ext.toUpperCase()) b = b.substring(0, b.length - ext.length);" + NL
    t = t + "  return b;" + NL
    t = t + "}" + NL
    t = t + "function extname(p) {" + NL
    t = t + "  const b = basename(p);" + NL
    t = t + "  const i = b.lastIndexOf(""."");" + NL
    t = t + "  return i <= 0 ? """" : b.substring(i);" + NL
    t = t + "}" + NL
    t = t + "function relative(from, to) {" + NL
    t = t + "  const a = resolve(from).toUpperCase().split(""\\"").filter((x) => x), b = resolve(to).split(""\\"").filter((x) => x);" + NL
    t = t + "  let i = 0;" + NL
    t = t + "  while (i < a.length && i < b.length && a[i] === b[i].toUpperCase()) i++;" + NL
    t = t + "  return a.slice(i).map(() => "".."").concat(b.slice(i)).join(""\\"");" + NL
    t = t + "}" + NL
    t = t + "function parse(p) {" + NL
    t = t + "  const base = basename(p), ext = extname(p);" + NL
    t = t + "  const dir = p.indexOf(""\\"") >= 0 || p.indexOf(""/"") >= 0 ? dirname(p) : """";" + NL
    t = t + "  return { root: isAbsolute(p) ? clean(p).substring(0, clean(p).indexOf(""\\"") + 1) : """", dir, base, ext, name: base.substring(0, base.length - ext.length) };" + NL
    t = t + "}" + NL
    t = t + "function format(o) { return (o.dir ? o.dir + ""\\"" : o.root || """") + (o.base || (o.name || """") + (o.ext || """")); }" + NL
    t = t + "const path = { sep, delimiter: "";"", normalize, isAbsolute, join, resolve, dirname, basename, extname, relative, parse, format };" + NL
    t = t + "path.win32 = path;" + NL
    t = t + "path.posix = path;" + NL
    t = t + "module.exports = path;" + NL
    Put("C:\NODE\LIB\PATH.JS")
END SUB

SUB File10 ()
    t = ""
    t = t + "// querystring - a=1&b=two" + NL
    t = t + "function unesc(s) { return decodeComponent(s.split(""+"").join("" "")); }" + NL
    t = t + "function decodeComponent(s) { return unescape(s); }" + NL
    t = t + "function esc(s) {" + NL
    t = t + "  const keep = ""ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_.!~*'()"";" + NL
    t = t + "  let out = """";" + NL
    t = t + "  for (const c of String(s)) out += keep.indexOf(c) >= 0 ? c : escape(c);" + NL
    t = t + "  return out;" + NL
    t = t + "}" + NL
    t = t + "function parse(str, sep, eq) {" + NL
    t = t + "  sep = sep || ""&"";" + NL
    t = t + "  eq = eq || ""="";" + NL
    t = t + "  const out = {};" + NL
    t = t + "  if (!str) return out;" + NL
    t = t + "  for (const part of String(str).split(sep)) {" + NL
    t = t + "    if (!part) continue;" + NL
    t = t + "    const i = part.indexOf(eq);" + NL
    t = t + "    const k = unesc(i < 0 ? part : part.substring(0, i)), v = i < 0 ? """" : unesc(part.substring(i + 1));" + NL
    t = t + "    if (out[k] === undefined) out[k] = v;" + NL
    t = t + "    else if (Array.isArray(out[k])) out[k].push(v);" + NL
    t = t + "    else out[k] = [out[k], v];" + NL
    t = t + "  }" + NL
    t = t + "  return out;" + NL
    t = t + "}" + NL
    t = t + "function stringify(o, sep, eq) {" + NL
    t = t + "  sep = sep || ""&"";" + NL
    t = t + "  eq = eq || ""="";" + NL
    t = t + "  const parts = [];" + NL
    t = t + "  for (const k of Object.keys(o)) {" + NL
    t = t + "    const v = o[k];" + NL
    t = t + "    if (Array.isArray(v)) v.forEach((x) => parts.push(esc(k) + eq + esc(x)));" + NL
    t = t + "    else parts.push(esc(k) + eq + esc(v === undefined || v === null ? """" : v));" + NL
    t = t + "  }" + NL
    t = t + "  return parts.join(sep);" + NL
    t = t + "}" + NL
    t = t + "module.exports = { parse, stringify, escape: esc, unescape: unesc, decode: parse, encode: stringify };" + NL
    Put("C:\NODE\LIB\QUERYSTR.JS")
END SUB

SUB File11 ()
    t = ""
    t = t + "// readline - lines typed in Node's window." + NL
    t = t + "const EventEmitter = require(""events"");" + NL
    t = t + "class Interface extends EventEmitter {" + NL
    t = t + "  constructor(opts) {" + NL
    t = t + "    super();" + NL
    t = t + "    this._prompt = (opts && opts.prompt) || ""> "";" + NL
    t = t + "    this.closed = false;" + NL
    t = t + "    this._asking = null;" + NL
    t = t + "    this.terminal = true;" + NL
    t = t + "  }" + NL
    t = t + "  _read(prompt) {" + NL
    t = t + "    __lineFn = (line) => {" + NL
    t = t + "      if (this.closed) return;" + NL
    t = t + "      if (this._asking) { const cb = this._asking; this._asking = null; cb(line); }" + NL
    t = t + "      else this.emit(""line"", line);" + NL
    t = t + "      if (!this.closed && !this._asking && this.listenerCount(""line"") > 0 && this._looping) this._read("""");" + NL
    t = t + "    };" + NL
    t = t + "    __n.readLine(prompt);" + NL
    t = t + "  }" + NL
    t = t + "  question(q, cb) {" + NL
    t = t + "    this._asking = cb;" + NL
    t = t + "    this._read(q);" + NL
    t = t + "  }" + NL
    t = t + "  setPrompt(p) { this._prompt = p; }" + NL
    t = t + "  getPrompt() { return this._prompt; }" + NL
    t = t + "  prompt() { this._looping = true; this._read(this._prompt); }" + NL
    t = t + "  write(s) { process.stdout.write(s); }" + NL
    t = t + "  close() {" + NL
    t = t + "    if (this.closed) return;" + NL
    t = t + "    this.closed = true;" + NL
    t = t + "    __lineFn = null;" + NL
    t = t + "    __n.stopReading();" + NL
    t = t + "    this.emit(""close"");" + NL
    t = t + "  }" + NL
    t = t + "  pause() { return this; }" + NL
    t = t + "  resume() { return this; }" + NL
    t = t + "  on(name, fn) {" + NL
    t = t + "    super.on(name, fn);" + NL
    t = t + "    // listening for lines starts the reading" + NL
    t = t + "    if (name === ""line"" && !this._looping) { this._looping = true; setImmediate(() => { if (!this._asking && !this.closed) this._read(""""); }); }" + NL
    t = t + "    return this;" + NL
    t = t + "  }" + NL
    t = t + "}" + NL
    t = t + "function createInterface(opts) { return new Interface(opts); }" + NL
    t = t + "module.exports = { createInterface, Interface };" + NL
    t = t + "module.exports.promises = { createInterface: (o) => { const rl = createInterface(o); rl.question = ((q) => new Promise((ok) => Interface.prototype.question.call(rl, q, ok))); return rl; } };" + NL
    Put("C:\NODE\LIB\READLINE.JS")
END SUB

