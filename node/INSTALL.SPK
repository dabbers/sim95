    t = t + "    return flat.length <= 72 ? flat : ""[\n"" + items.map(function (s) { return ""  "" + s.split(""\n"").join(""\n  ""); }).join("",\n"") + ""\n]"";" + NL
    t = t + "  }" + NL
    t = t + "  if (depth < 0) return ""[Object]"";" + NL
    t = t + "  var keys = Object.keys(v);" + NL
