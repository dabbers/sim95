SUB File13 ()
    t = ""
    t = t + "// url - http://host:port/path?query#hash" + NL
    t = t + "const qs = require(""querystring"");" + NL
    t = t + "function parse(s, parseQuery) {" + NL
    t = t + "  const u = { protocol: null, slashes: false, auth: null, host: null, port: null, hostname: null, hash: null, search: null, query: null, pathname: null, path: null, href: s };" + NL
    t = t + "  let rest = String(s);" + NL
    t = t + "  const h = rest.indexOf(""#"");" + NL
    t = t + "  if (h >= 0) { u.hash = rest.substring(h); rest = rest.substring(0, h); }" + NL
    t = t + "  const q = rest.indexOf(""?"");" + NL
    t = t + "  if (q >= 0) { u.search = rest.substring(q); u.query = rest.substring(q + 1); rest = rest.substring(0, q); }" + NL
    t = t + "  const p = rest.indexOf(""://"");" + NL
    t = t + "  if (p >= 0) {" + NL
    t = t + "    u.protocol = rest.substring(0, p + 1).toLowerCase();" + NL
    t = t + "    u.slashes = true;" + NL
    t = t + "    rest = rest.substring(p + 3);" + NL
    t = t + "    const slash = rest.indexOf(""/"");" + NL
    t = t + "    u.host = (slash < 0 ? rest : rest.substring(0, slash)).toLowerCase();" + NL
    t = t + "    rest = slash < 0 ? ""/"" : rest.substring(slash);" + NL
    t = t + "    const c = u.host.indexOf("":"");" + NL
    t = t + "    u.hostname = c < 0 ? u.host : u.host.substring(0, c);" + NL
    t = t + "    u.port = c < 0 ? null : u.host.substring(c + 1);" + NL
    t = t + "  }" + NL
    t = t + "  u.pathname = rest || (u.host ? ""/"" : rest);" + NL
    t = t + "  u.path = u.pathname + (u.search || """");" + NL
    t = t + "  if (parseQuery) u.query = qs.parse(u.query || """");" + NL
    t = t + "  return u;" + NL
    t = t + "}" + NL
    t = t + "class URLSearchParams {" + NL
    t = t + "  constructor(init) {" + NL
    t = t + "    this._list = [];" + NL
    t = t + "    if (typeof init === ""string"") {" + NL
    t = t + "      const o = qs.parse(init.charAt(0) === ""?"" ? init.substring(1) : init);" + NL
    t = t + "      for (const k of Object.keys(o)) [].concat(o[k]).forEach((v) => this._list.push([k, v]));" + NL
    t = t + "    } else if (init) for (const k of Object.keys(init)) this._list.push([k, String(init[k])]);" + NL
    t = t + "  }" + NL
    t = t + "  get(k) { const p = this._list.find((x) => x[0] === k); return p ? p[1] : null; }" + NL
    t = t + "  getAll(k) { return this._list.filter((x) => x[0] === k).map((x) => x[1]); }" + NL
    t = t + "  has(k) { return this._list.some((x) => x[0] === k); }" + NL
    t = t + "  set(k, v) { this.delete(k); this._list.push([k, String(v)]); }" + NL
    t = t + "  append(k, v) { this._list.push([k, String(v)]); }" + NL
    t = t + "  delete(k) { this._list = this._list.filter((x) => x[0] !== k); }" + NL
    t = t + "  forEach(fn) { this._list.forEach((p) => fn(p[1], p[0], this)); }" + NL
    t = t + "  entries() { return this._list.slice(); }" + NL
    t = t + "  keys() { return this._list.map((p) => p[0]); }" + NL
    t = t + "  toString() { return this._list.map((p) => qs.escape(p[0]) + ""="" + qs.escape(p[1])).join(""&""); }" + NL
    t = t + "}" + NL
    t = t + "class URL {" + NL
    t = t + "  constructor(s, base) {" + NL
    t = t + "    if (base !== undefined && String(s).indexOf(""://"") < 0) {" + NL
    t = t + "      // relative to base: /x from its host, x from its folder" + NL
    t = t + "      const b = parse(String(base));" + NL
    t = t + "      s = String(s).charAt(0) === ""/"" ? b.protocol + ""//"" + b.host + s : b.protocol + ""//"" + b.host + b.pathname.substring(0, b.pathname.lastIndexOf(""/"") + 1) + s;" + NL
    t = t + "    }" + NL
    t = t + "    const u = parse(s);" + NL
    t = t + "    if (!u.protocol) throw new TypeError(""Invalid URL: "" + s);" + NL
    t = t + "    this.href = s;" + NL
    t = t + "    this.protocol = u.protocol;" + NL
    t = t + "    this.host = u.host;" + NL
    t = t + "    this.hostname = u.hostname;" + NL
    t = t + "    this.port = u.port || """";" + NL
    t = t + "    this.pathname = u.pathname;" + NL
    t = t + "    this.search = u.search || """";" + NL
    t = t + "    this.hash = u.hash || """";" + NL
    t = t + "    this.origin = u.protocol + ""//"" + u.host;" + NL
    t = t + "    this.searchParams = new URLSearchParams(this.search);" + NL
    t = t + "  }" + NL
    t = t + "  toString() { return this.href; }" + NL
    t = t + "}" + NL
    t = t + "function format(u) {" + NL
    t = t + "  if (typeof u === ""string"") return u;" + NL
    t = t + "  return (u.protocol ? u.protocol + ""//"" : """") + (u.host || u.hostname || """") + (u.pathname || ""/"") + (u.search || (u.query && typeof u.query === ""object"" ? ""?"" + qs.stringify(u.query) : """"));" + NL
    t = t + "}" + NL
    t = t + "module.exports = { parse, format, URL, URLSearchParams };" + NL
    t = t + "global.URL = URL;" + NL
    t = t + "global.URLSearchParams = URLSearchParams;" + NL
    Put("C:\NODE\LIB\URL.JS")
END SUB

SUB File14 ()
    t = ""
    t = t + "// util - format, inspect, promisify, inherits." + NL
    t = t + "function inspect(v, opts) {" + NL
    t = t + "  const depth = opts && typeof opts === ""object"" && opts.depth !== undefined ? (opts.depth === null ? 9 : opts.depth) : 2;" + NL
    t = t + "  return __inspect(v, depth, [0]);" + NL
    t = t + "}" + NL
    t = t + "function promisify(fn) {" + NL
    t = t + "  return function () {" + NL
    t = t + "    const args = Array.prototype.slice.call(arguments), self = this;" + NL
    t = t + "    return new Promise((ok, no) => {" + NL
    t = t + "      args.push((err, value) => (err ? no(err) : ok(value)));" + NL
    t = t + "      fn.apply(self, args);" + NL
    t = t + "    });" + NL
    t = t + "  };" + NL
    t = t + "}" + NL
    t = t + "function callbackify(fn) {" + NL
    t = t + "  return function () {" + NL
    t = t + "    const args = Array.prototype.slice.call(arguments), cb = args.pop();" + NL
    t = t + "    fn.apply(this, args).then((v) => cb(null, v), (e) => cb(e));" + NL
    t = t + "  };" + NL
    t = t + "}" + NL
    t = t + "function inherits(ctor, superCtor) {" + NL
    t = t + "  ctor.super_ = superCtor;" + NL
    t = t + "  Object.setPrototypeOf(ctor.prototype, superCtor.prototype);" + NL
    t = t + "}" + NL
    t = t + "function isDeepStrictEqual(a, b) { return JSON.stringify(a) === JSON.stringify(b); }" + NL
    t = t + "function deprecate(fn) { return fn; }" + NL
    t = t + "module.exports = {" + NL
    t = t + "  format: __format, inspect, promisify, callbackify, inherits, isDeepStrictEqual, deprecate," + NL
    t = t + "  isArray: Array.isArray," + NL
    t = t + "  types: { isPromise: (p) => p instanceof Promise, isDate: (d) => d instanceof Date }," + NL
    t = t + "};" + NL
    Put("C:\NODE\LIB\UTIL.JS")
END SUB

SUB File15 ()
    t = ""
    t = t + "' NODEHOST.SPK - Node for SIM95: the window, the event loop, and the native" + NL
    t = t + "' half of Node's modules, around the JavaScript engine (JSCRIPT.SPK, the one" + NL
    t = t + "' Simxplorer runs pages with). C:\PROGRAMS\NODE.SPK is the two joined." + NL
    t = t + "'" + NL
    t = t + "'   node                    the prompt: type JavaScript, see what it gives" + NL
    t = t + "'   node app.js a b         runs C:\...\APP.JS, with process.argv [.., a, b]" + NL
    t = t + "'   node -e ""code""          runs the code" + NL
    t = t + "'   node -v                 the version" + NL
    t = t + "' (Sim Shell puts --cwd=<its folder> first, so app.js is found where you are.)" + NL
    t = t + "'" + NL
    t = t + "' The JavaScript half is in C:\NODE\LIB: BOOT.JS starts everything, and the" + NL
    t = t + "' modules (fs, path, events, net, http...) are .JS files there." + NL
    t = t + "'" + NL
    t = t + "' One rule keeps the engine safe: JavaScript never waits. A SPARK call that" + NL
    t = t + "' waits (Connect, NET.Resolve, a line typed in the window) lets other events" + NL
    t = t + "' in, so those are jobs, done by the clock outside JavaScript; what they find" + NL
    t = t + "' comes back as an event. Events wait in a queue, and Pump runs them one at" + NL
    t = t + "' a time, each to the end, with the promise jobs after it." + NL
    t = t + "" + NL
    t = t + "CONST NODEDIR = ""C:\NODE""" + NL
    t = t + "CONST NODEVERSION = ""v0.2.0""" + NL
    t = t + "CONST MAXSERVERS = 8" + NL
    t = t + "" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR con AS GUI_Console" + NL
    t = t + "VAR clock AS GUI_Timer" + NL
    t = t + "VAR dialer AS GUI_Timer" + NL
    t = t + "VAR reader AS GUI_Timer" + NL
    t = t + "VAR nodeCwd AS String" + NL
    t = t + "VAR nodeArgs AS Array OF String" + NL
    t = t + "VAR nodeScript AS String" + NL
    t = t + "VAR nodeEval AS String" + NL
    t = t + "VAR finished AS Bool" + NL
    t = t + "VAR exitCode AS Integer" + NL
    t = t + "VAR pumping AS Bool" + NL
    t = t + "VAR dispatchFn AS String" + NL
    t = t + "VAR started AS Bool" + NL
    t = t + "VAR ending AS Bool" + NL
    t = t + "" + NL
    t = t + "' timers: setTimeout and setInterval" + NL
    t = t + "VAR tmId AS Array OF Integer" + NL
    t = t + "VAR tmDue AS Array OF Integer" + NL
    t = t + "VAR tmFn AS Array OF String" + NL
    t = t + "VAR tmCode AS Array OF String" + NL
    t = t + "VAR tmEvery AS Array OF Integer" + NL
    t = t + "VAR tmNext AS Integer" + NL
    t = t + "" + NL
    t = t + "' events for the JavaScript side: kind, and two values (engine values)" + NL
    t = t + "VAR evKind AS Array OF String" + NL
    t = t + "VAR evA AS Array OF String" + NL
    t = t + "VAR evB AS Array OF String" + NL
    t = t + "" + NL
    t = t + "' sockets: servers in slots (each slot has its own onConnect), connections by id" + NL
    t = t + "VAR srvSock AS Array OF NET_Socket" + NL
    t = t + "VAR srvOn AS Array OF Bool" + NL
    t = t + "VAR srvPort AS Array OF Integer" + NL
    t = t + "VAR srvClosing AS Array OF Bool" + NL
    t = t + "VAR skSlot AS Array OF Integer    ' the server slot each connection came in on (-1: one we made)" + NL
    t = t + "VAR outSock AS NET_Socket" + NL
    t = t + "VAR outSocks AS Array OF NET_Socket" + NL
    t = t + "VAR skId AS Array OF Integer" + NL
    t = t + "VAR skConn AS Array OF NET_Connection" + NL
    t = t + "VAR skNext AS Integer" + NL
    t = t + "' connects and lookups waiting to be done: ""id|host|port"" and ""id|name""" + NL
    t = t + "VAR dialQ AS Array OF String" + NL
    t = t + "VAR lookQ AS Array OF String" + NL
    t = t + "VAR dialing AS Integer" + NL
    t = t + "VAR dialBusy AS String            ' the connection being made now ("""": none)" + NL
    t = t + "VAR dialAt AS Integer" + NL
    t = t + "VAR dialed AS Array OF String     ' ""id|"" connected, ""id|why"" failed: the clock passes them on" + NL
    t = t + "VAR reading AS Bool" + NL
    t = t + "VAR readWanted AS Bool" + NL
    t = t + "VAR readPrompt AS String" + NL
    t = t + "" + NL
    t = t + "' which file the code for each node came from (for errors): the first node" + NL
    t = t + "' of each file compiled, and its name" + NL
    t = t + "VAR fileFrom AS Array OF Integer" + NL
    t = t + "VAR fileName AS Array OF String" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR title AS String" + NL
    t = t + "    nodeCwd = ""C:\MYFILES""" + NL
    t = t + "    k = 0" + NL
    t = t + "    ' the options, the script, and the script's own arguments" + NL
    t = t + "    WHILE k < SYS.Args.Count" + NL
    t = t + "        a = SYS.Args[k]" + NL
    t = t + "        IF a.StartsWith(""--cwd="") THEN" + NL
    t = t + "            nodeCwd = a.Substring(6, a.Length - 6)" + NL
    t = t + "        ELSEIF nodeScript = """" AND nodeEval = """" AND (a = ""-v"" OR a = ""--version"") THEN" + NL
    t = t + "            nodeEval = ""console.log(process.version)""" + NL
    t = t + "        ELSEIF nodeScript = """" AND nodeEval = """" AND a = ""-e"" AND k + 1 < SYS.Args.Count THEN" + NL
    t = t + "            k = k + 1" + NL
    t = t + "            nodeEval = SYS.Args[k]" + NL
    t = t + "            ' (the rest of the line is the code)" + NL
    t = t + "            WHILE k + 1 < SYS.Args.Count" + NL
    t = t + "                k = k + 1" + NL
    t = t + "                nodeEval = nodeEval + "" "" + SYS.Args[k]" + NL
    t = t + "            END WHILE" + NL
    t = t + "        ELSEIF nodeScript = """" AND nodeEval = """" THEN" + NL
    t = t + "            nodeScript = a" + NL
    t = t + "        ELSE" + NL
    t = t + "            nodeArgs.Add(a)" + NL
    t = t + "        END IF" + NL
    t = t + "        k = k + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF nodeScript <> """" THEN nodeScript = FullPath(nodeScript)" + NL
    t = t + "    title = ""Node""" + NL
    t = t + "    IF nodeScript <> """" THEN title = ""Node - "" + Base(nodeScript)" + NL
    t = t + "    win = GUI_Window.New(title, 600, 360)" + NL
    t = t + "    win.Icon = ""terminal""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    win.onResize = Win_OnResize" + NL
    t = t + "    con = GUI_Console.New(win)" + NL
    t = t + "    Win_OnResize()" + NL
    t = t + "    clock = GUI_Timer.New(win)" + NL
    t = t + "    clock.Interval = 15" + NL
    t = t + "    clock.onTick = Clock_OnTick" + NL
    t = t + "    dialer = GUI_Timer.New(win)" + NL
    t = t + "    dialer.Interval = 30" + NL
    t = t + "    dialer.onTick = Dialer_OnTick" + NL
    t = t + "    reader = GUI_Timer.New(win)" + NL
    t = t + "    reader.Interval = 50" + NL
    t = t + "    reader.onTick = Reader_OnTick" + NL
    t = t + "    outSock = NET_Socket.New()" + NL
    t = t + "    outSock.onMessage = Conn_OnMessage" + NL
    t = t + "    outSock.onClose = Conn_OnClose" + NL
    t = t + "    FOR k = 0 TO MAXSERVERS - 1" + NL
    t = t + "        srvSock.Add(outSock)" + NL
    t = t + "        srvClosing.Add(FALSE)" + NL
    t = t + "        srvOn.Add(FALSE)" + NL
    t = t + "        srvPort.Add(0)" + NL
    t = t + "    NEXT" + NL
    t = t + "    win.Show()" + NL
    t = t + "    con.Focus()" + NL
    t = t + "    clock.Start()" + NL
    t = t + "    dialer.Start()" + NL
    t = t + "    reader.Start()" + NL
    t = t + "    StartJs()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnResize ()" + NL
    t = t + "    con.SetBounds(0, 0, win.Width, win.Height)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    SYS.Exit(exitCode)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- paths" + NL
    t = t + "" + NL
    t = t + "FUNCTION FullPath (p AS String) AS String" + NL
    t = t + "    VAR q AS String" + NL
    t = t + "    q = p.Replace(""/"", ""\"").Trim()" + NL
    t = t + "    IF q.Length >= 2 AND q.CharAt(1) = "":"" THEN RETURN Tidy(q)" + NL
    t = t + "    IF q.StartsWith(""\"") THEN RETURN Tidy(""C:"" + q)" + NL
    t = t + "    RETURN Tidy(nodeCwd + ""\"" + q)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' C:\A\.\B\..\C -> C:\A\C, upper case, no \ at the end" + NL
    t = t + "FUNCTION Tidy (p AS String) AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR part AS String" + NL
    t = t + "    FOR EACH part IN p.Upper().Split(""\"")" + NL
    t = t + "        IF part = """" OR part = ""."" THEN CONTINUE" + NL
    t = t + "        IF part = "".."" THEN" + NL
    t = t + "            IF out.Count > 1 THEN out.RemoveAt(out.Count - 1)" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        out.Add(part)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF out.Count = 1 THEN RETURN out[0] + ""\""" + NL
    t = t + "    RETURN out.Join(""\"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Base (p AS String) AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    parts = p.Split(""\"")" + NL
    t = t + "    RETURN parts[parts.Count - 1]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- starting" + NL
    t = t + "" + NL
    t = t + "SUB StartJs ()" + NL
    t = t + "    VAR natives AS Integer" + NL
    t = t + "    VAR boot AS String" + NL
    t = t + "    VAR err AS String" + NL
    t = t + "    JsReset()" + NL
    t = t + "    jsDefer = TRUE" + NL
    t = t + "    ' the natives, for BOOT.JS (which takes them and hides them)" + NL
    t = t + "    natives = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(natives, ""node."", ""write,args,info,chdir,title,exit,fullpath,fsRead,fsWrite,fsAppend,fsStat,fsList,fsMkdir,fsDelete,fsRename,compile,eval,listen,unlisten,connect,send,end,peer,lookup,readLine,stopReading,spawn,kill,tasks"")" + NL
    t = t + "    JsPutOwn(jsGlobal, ""__node"", JsO(natives))" + NL
    t = t + "    IF NOT FS.Exists(NODEDIR + ""\LIB\BOOT.JS"") THEN" + NL
    t = t + "        con.WriteLine(""Node isn't installed properly: "" + NODEDIR + ""\LIB\BOOT.JS is missing."")" + NL
    t = t + "        Finish(1)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    boot = FS.Read(NODEDIR + ""\LIB\BOOT.JS"")" + NL
    t = t + "    fileFrom.Add(nk.Count)" + NL
    t = t + "    fileName.Add(NODEDIR + ""\LIB\BOOT.JS"")" + NL
    t = t + "    err = JsRun(boot, 1)" + NL
    t = t + "    IF err <> """" THEN" + NL
    t = t + "        con.WriteLine(""Node couldn't start: "" + ErrText(err))" + NL
    t = t + "        Finish(1)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    dispatchFn = JsGetProp(jsGlobal, ""__dispatch"")" + NL
    t = t + "    started = TRUE" + NL
    t = t + "    ' the program itself, or the prompt" + NL
    t = t + "    IF nodeEval <> """" THEN" + NL
    t = t + "        Fire(""eval"", JsS(nodeEval), ""u"")" + NL
    t = t + "    ELSEIF nodeScript <> """" THEN" + NL
    t = t + "        Fire(""main"", JsS(nodeScript), ""u"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        Fire(""repl"", ""u"", ""u"")" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ""line|message"" as file:line: message" + NL
    t = t + "FUNCTION ErrText (err AS String) AS String" + NL
    t = t + "    IF NOT err.Contains(""|"") THEN RETURN err" + NL
    t = t + "    RETURN Where() + "": "" + err.Substring(err.IndexOf(""|"") + 1, err.Length - err.IndexOf(""|"") - 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The file and line the engine is at, as C:\X\APP.JS:12." + NL
    t = t + "FUNCTION Where () AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    f = """"" + NL
    t = t + "    FOR k = fileFrom.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF jsNodeAt >= fileFrom[k] THEN" + NL
    t = t + "            f = fileName[k]" + NL
    t = t + "            BREAK" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF f = """" THEN RETURN ""line "" + Str(jsLine)" + NL
    t = t + "    RETURN f + "":"" + Str(jsLine)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the event loop" + NL
    t = t + "" + NL
    t = t + "' An event for the JavaScript side, run as soon as nothing else is." + NL
    t = t + "SUB Fire (kind AS String, a AS String, b AS String)" + NL
    t = t + "    IF finished THEN RETURN" + NL
    t = t + "    evKind.Add(kind)" + NL
    t = t + "    evA.Add(a)" + NL
    t = t + "    evB.Add(b)" + NL
    t = t + "    Pump()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Pump ()" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR b AS String" + NL
    t = t + "    VAR args AS Array OF String" + NL
    t = t + "    VAR r AS String" + NL
    t = t + "    IF pumping OR NOT started THEN RETURN" + NL
    t = t + "    pumping = TRUE" + NL
    t = t + "    WHILE evKind.Count > 0 AND NOT finished" + NL
    t = t + "        kind = evKind[0]" + NL
    t = t + "        a = evA[0]" + NL
    t = t + "        b = evB[0]" + NL
    t = t + "        evKind.RemoveAt(0)" + NL
    t = t + "        evA.RemoveAt(0)" + NL
    t = t + "        evB.RemoveAt(0)" + NL
    t = t + "        args.Clear()" + NL
    t = t + "        args.Add(JsS(kind))" + NL
    t = t + "        args.Add(a)" + NL
    t = t + "        args.Add(b)" + NL
    t = t + "        jsSig = """"" + NL
    t = t + "        jsDepth = 0" + NL
    t = t + "        jsSteps = 0" + NL
    t = t + "        jsLimit = JSSTEPLIMIT" + NL
    t = t + "        jsThrown = """"" + NL
    t = t + "        TRY" + NL
    t = t + "            r = JsCall(dispatchFn, JsO(jsGlobal), args)" + NL
    t = t + "            JsDrainJobs()" + NL
    t = t + "        CATCH err" + NL
    t = t + "            ' (__dispatch catches what the program throws; this is the engine's own trouble)" + NL
    t = t + "            jsSig = """"" + NL
    t = t + "            jsDepth = 0" + NL
    t = t + "            con.WriteLine(""Node: "" + ErrText(JsTidyError(err)))" + NL
    t = t + "            jqP.Clear()" + NL
    t = t + "            jqOk.Clear()" + NL
    t = t + "            jqErr.Clear()" + NL
    t = t + "            jqChild.Clear()" + NL
    t = t + "        END TRY" + NL
    t = t + "    END WHILE" + NL
    t = t + "    pumping = FALSE" + NL
    t = t + "    IF NOT finished THEN IdleCheck()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Nothing left to wait for: the program is over, as in Node." + NL
    t = t + "SUB IdleCheck ()" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF evKind.Count > 0 OR tmId.Count > 0 OR skId.Count > 0 OR dialQ.Count > 0 OR lookQ.Count > 0 OR dialing > 0 OR dialed.Count > 0 OR readWanted OR reading THEN RETURN" + NL
    t = t + "    FOR k = 0 TO MAXSERVERS - 1" + NL
    t = t + "        IF srvOn[k] THEN RETURN" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' the program's own goodbye (process.on('exit')), with its process.exitCode" + NL
    t = t + "    IF ending THEN" + NL
    t = t + "        Finish(exitCode)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ending = TRUE" + NL
    t = t + "    Fire(""exit"", ""u"", ""u"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Finish (code AS Integer)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF finished THEN RETURN" + NL
    t = t + "    finished = TRUE" + NL
    t = t + "    exitCode = code" + NL
    t = t + "    tmId.Clear()" + NL
    t = t + "    tmDue.Clear()" + NL
    t = t + "    tmFn.Clear()" + NL
    t = t + "    tmCode.Clear()" + NL
    t = t + "    tmEvery.Clear()" + NL
    t = t + "    FOR k = 0 TO MAXSERVERS - 1" + NL
    t = t + "        IF srvOn[k] THEN" + NL
    t = t + "            TRY" + NL
    t = t + "                srvSock[k].Close()" + NL
    t = t + "            CATCH err" + NL
    t = t + "            END TRY" + NL
    t = t + "            srvOn[k] = FALSE" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR k = 0 TO skConn.Count - 1" + NL
    t = t + "        TRY" + NL
    t = t + "            skConn[k].Close()" + NL
    t = t + "        CATCH err" + NL
    t = t + "        END TRY" + NL
    t = t + "    NEXT" + NL
    t = t + "    skId.Clear()" + NL
    t = t + "    skConn.Clear()" + NL
    t = t + "    skSlot.Clear()" + NL
    t = t + "    win.Status = ""Finished (exit code "" + Str(code) + ""). Close this window when you're done with it.""" + NL
    t = t + "    win.Title = win.Title + "" (finished)""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION NowMs () AS Integer" + NL
    t = t + "    RETURN SYS.Ticks" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Clock_OnTick ()" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR due AS Array OF Integer" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    IF finished OR NOT started THEN RETURN" + NL
    t = t + "    ' connections made, or not, since last time" + NL
    t = t + "    WHILE dialed.Count > 0" + NL
    t = t + "        k = dialed[0].IndexOf(""|"")" + NL
    t = t + "        IF dialed[0].Length = k + 1 THEN" + NL
    t = t + "            Queue(""connect"", JsN(Int(Val(dialed[0].Substring(0, k)))), ""u"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            Queue(""connerror"", JsN(Int(Val(dialed[0].Substring(0, k)))), JsS(dialed[0].Substring(k + 1, dialed[0].Length - k - 1)))" + NL
    t = t + "        END IF" + NL
    t = t + "        dialed.RemoveAt(0)" + NL
    t = t + "        dialing = dialing - 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    ' timers that are due, the earliest first" + NL
    t = t + "    FOR k = 0 TO tmId.Count - 1" + NL
    t = t + "        IF tmDue[k] <= NowMs() THEN" + NL
    t = t + "            j = 0" + NL
    t = t + "            WHILE j < due.Count" + NL
    t = t + "                IF tmDue[tmId.IndexOf(due[j])] > tmDue[k] THEN BREAK" + NL
    t = t + "                j = j + 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "            due.Insert(j, tmId[k])" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH id IN due" + NL
    t = t + "        k = tmId.IndexOf(id)" + NL
    t = t + "        IF k < 0 THEN CONTINUE" + NL
    t = t + "        IF tmFn[k] <> """" THEN" + NL
    t = t + "            Queue(""call"", tmFn[k], ""u"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            Queue(""code"", JsS(tmCode[k]), ""u"")" + NL
    t = t + "        END IF" + NL
    t = t + "        IF tmEvery[k] > 0 THEN" + NL
    t = t + "            ' (on its own beat, unless it has fallen behind)" + NL
    t = t + "            tmDue[k] = MATH.Max(tmDue[k] + tmEvery[k], NowMs())" + NL
    t = t + "        ELSE" + NL
    t = t + "            DropTimer(k)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    Pump()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Queue (kind AS String, a AS String, b AS String)" + NL
    t = t + "    evKind.Add(kind)" + NL
    t = t + "    evA.Add(a)" + NL
    t = t + "    evB.Add(b)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DropTimer (k AS Integer)" + NL
    t = t + "    tmId.RemoveAt(k)" + NL
    t = t + "    tmDue.RemoveAt(k)" + NL
    t = t + "    tmFn.RemoveAt(k)" + NL
    t = t + "    tmCode.RemoveAt(k)" + NL
    t = t + "    tmEvery.RemoveAt(k)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- jobs that wait" + NL
    t = t + "" + NL
    t = t + "' One connect a time, alone in its handler: a connect that fails spoils the" + NL
    t = t + "' rest of the handler it's in (see SIM95-NOTES.md)." + NL
    t = t + "SUB Dialer_OnTick ()" + NL
    t = t + "    TRY" + NL
    t = t + "        DialOne()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' (Each connection has a socket of its own, and they're made one at a time:" + NL
    t = t + "' a connect that fails can lose another that's waiting. One that never comes" + NL
    t = t + "' back is given up after 15 seconds.)" + NL
    t = t + "SUB DialOne ()" + NL
    t = t + "    VAR req AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR s AS NET_Socket" + NL
    t = t + "    IF dialBusy <> """" THEN" + NL
    t = t + "        IF NowMs() - dialAt < 15000 THEN RETURN" + NL
    t = t + "        dialed.Add(dialBusy + ""|Connection timed out"")" + NL
    t = t + "        dialBusy = """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF dialQ.Count = 0 OR finished THEN RETURN" + NL
    t = t + "    req = dialQ[0]" + NL
    t = t + "    dialQ.RemoveAt(0)" + NL
    t = t + "    parts = req.Split(""|"")" + NL
    t = t + "    dialing = dialing + 1" + NL
    t = t + "    dialBusy = parts[0]" + NL
    t = t + "    dialAt = NowMs()" + NL
    t = t + "    s = NET_Socket.New()" + NL
    t = t + "    s.onMessage = Conn_OnMessage" + NL
    t = t + "    s.onClose = Conn_OnClose" + NL
    t = t + "    outSocks.Add(s)" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = s.Connect(parts[1], Int(Val(parts[2])))" + NL
    t = t + "        conn.Tag = parts[0]" + NL
    t = t + "        skId.Add(Int(Val(parts[0])))" + NL
    t = t + "        skConn.Add(conn)" + NL
    t = t + "        skSlot.Add(-1)" + NL
    t = t + "        IF dialBusy = parts[0] THEN dialed.Add(parts[0] + ""|"")" + NL
    t = t + "        dialBusy = """"" + NL
    t = t + "    CATCH err" + NL
    t = t + "        IF dialBusy = parts[0] THEN dialed.Add(parts[0] + ""|"" + err)" + NL
    t = t + "        dialBusy = """"" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Lines typed in the window, and name lookups." + NL
    t = t + "SUB Reader_OnTick ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR req AS String" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    IF finished OR NOT started THEN RETURN" + NL
    t = t + "    IF lookQ.Count > 0 THEN" + NL
    t = t + "        req = lookQ[0]" + NL
    t = t + "        lookQ.RemoveAt(0)" + NL
    t = t + "        dialing = dialing + 1" + NL
    t = t + "        TRY" + NL
    t = t + "            addr = NET.Resolve(req.Substring(req.IndexOf(""|"") + 1, req.Length - req.IndexOf(""|"") - 1))" + NL
    t = t + "        CATCH err" + NL
    t = t + "            addr = """"" + NL
    t = t + "        END TRY" + NL
    t = t + "        dialing = dialing - 1" + NL
    t = t + "        Fire(""resolved"", JsN(Int(Val(req.Substring(0, req.IndexOf(""|""))))), JsS(addr))" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF readWanted AND NOT reading THEN" + NL
    t = t + "        reading = TRUE" + NL
    t = t + "        readWanted = FALSE" + NL
    t = t + "        IF readPrompt <> """" THEN con.Write(readPrompt)" + NL
    t = t + "        line = con.ReadLine()" + NL
    t = t + "        reading = FALSE" + NL
    t = t + "        Fire(""line"", JsS(line), ""u"")" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- sockets" + NL
    t = t + "" + NL
    t = t + "SUB Conn_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    IF conn.Tag = """" THEN RETURN" + NL
    t = t + "    Fire(""data"", JsN(Int(Val(conn.Tag))), JsS(message))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Conn_OnClose (conn AS NET_Connection)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF conn.Tag = """" THEN RETURN" + NL
    t = t + "    k = skId.IndexOf(Int(Val(conn.Tag)))" + NL
    t = t + "    IF k >= 0 THEN DropConn(k)" + NL
    t = t + "    Fire(""close"", JsN(Int(Val(conn.Tag))), ""u"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A server's connection: given an id, then the program hears of it." + NL
    t = t + "SUB Accept (slot AS Integer, conn AS NET_Connection)" + NL
    t = t + "    IF finished OR NOT srvOn[slot] THEN" + NL
    t = t + "        conn.Reject()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    conn.Accept()" + NL
    t = t + "    skNext = skNext + 1" + NL
    t = t + "    conn.Tag = Str(skNext)" + NL
    t = t + "    skId.Add(skNext)" + NL
    t = t + "    skConn.Add(conn)" + NL
    t = t + "    skSlot.Add(slot)" + NL
    t = t + "    Fire(""accept"", JsN(slot), JsN(skNext))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ServerError (slot AS Integer, message AS String)" + NL
    t = t + "    IF srvOn[slot] THEN" + NL
    t = t + "        srvOn[slot] = FALSE" + NL
    t = t + "        Fire(""listenerror"", JsN(slot), JsS(message))" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Srv0_OnConnect (conn AS NET_Connection)" + NL
    t = t + "    Accept(0, conn)" + NL
    t = t + "END SUB" + NL
    t = t + "SUB Srv1_OnConnect (conn AS NET_Connection)" + NL
    t = t + "    Accept(1, conn)" + NL
    t = t + "END SUB" + NL
    t = t + "SUB Srv2_OnConnect (conn AS NET_Connection)" + NL
    t = t + "    Accept(2, conn)" + NL
    t = t + "END SUB" + NL
    t = t + "SUB Srv3_OnConnect (conn AS NET_Connection)" + NL
    t = t + "    Accept(3, conn)" + NL
    t = t + "END SUB" + NL
    t = t + "SUB Srv4_OnConnect (conn AS NET_Connection)" + NL
    t = t + "    Accept(4, conn)" + NL
    t = t + "END SUB" + NL
    t = t + "SUB Srv5_OnConnect (conn AS NET_Connection)" + NL
    t = t + "    Accept(5, conn)" + NL
    t = t + "END SUB" + NL
    t = t + "SUB Srv6_OnConnect (conn AS NET_Connection)" + NL
    t = t + "    Accept(6, conn)" + NL
    t = t + "END SUB" + NL
    t = t + "SUB Srv7_OnConnect (conn AS NET_Connection)" + NL
    t = t + "    Accept(7, conn)" + NL
    t = t + "END SUB" + NL
    t = t + "SUB Srv0_OnError (message AS String)" + NL
    t = t + "    ServerError(0, message)" + NL
    t = t + "END SUB" + NL
    t = t + "SUB Srv1_OnError (message AS String)" + NL
    t = t + "    ServerError(1, message)" + NL
    t = t + "END SUB" + NL
    t = t + "SUB Srv2_OnError (message AS String)" + NL
    t = t + "    ServerError(2, message)" + NL
    t = t + "END SUB" + NL
    t = t + "SUB Srv3_OnError (message AS String)" + NL
    t = t + "    ServerError(3, message)" + NL
    t = t + "END SUB" + NL
    t = t + "SUB Srv4_OnError (message AS String)" + NL
    t = t + "    ServerError(4, message)" + NL
    t = t + "END SUB" + NL
    t = t + "SUB Srv5_OnError (message AS String)" + NL
    t = t + "    ServerError(5, message)" + NL
    t = t + "END SUB" + NL
    t = t + "SUB Srv6_OnError (message AS String)" + NL
    t = t + "    ServerError(6, message)" + NL
    t = t + "END SUB" + NL
    t = t + "SUB Srv7_OnError (message AS String)" + NL
    t = t + "    ServerError(7, message)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Listen (port AS Integer) AS Integer" + NL
    t = t + "    VAR slot AS Integer" + NL
    t = t + "    VAR s AS NET_Socket" + NL
    t = t + "    slot = srvOn.IndexOf(FALSE)" + NL
    t = t + "    IF slot < 0 THEN THROW ""A program can listen on "" + Str(MAXSERVERS) + "" ports at most""" + NL
    t = t + "    s = NET_Socket.New()" + NL
    t = t + "    SELECT CASE slot" + NL
    t = t + "        CASE 0" + NL
    t = t + "            s.onConnect = Srv0_OnConnect" + NL
    t = t + "            s.onError = Srv0_OnError" + NL
    t = t + "        CASE 1" + NL
    t = t + "            s.onConnect = Srv1_OnConnect" + NL
    t = t + "            s.onError = Srv1_OnError" + NL
    t = t + "        CASE 2" + NL
    t = t + "            s.onConnect = Srv2_OnConnect" + NL
    t = t + "            s.onError = Srv2_OnError" + NL
    t = t + "        CASE 3" + NL
    t = t + "            s.onConnect = Srv3_OnConnect" + NL
    t = t + "            s.onError = Srv3_OnError" + NL
    t = t + "        CASE 4" + NL
    t = t + "            s.onConnect = Srv4_OnConnect" + NL
    t = t + "            s.onError = Srv4_OnError" + NL
    t = t + "        CASE 5" + NL
    t = t + "            s.onConnect = Srv5_OnConnect" + NL
    t = t + "            s.onError = Srv5_OnError" + NL
    t = t + "        CASE 6" + NL
    t = t + "            s.onConnect = Srv6_OnConnect" + NL
    t = t + "            s.onError = Srv6_OnError" + NL
    t = t + "        CASE 7" + NL
    t = t + "            s.onConnect = Srv7_OnConnect" + NL
    t = t + "            s.onError = Srv7_OnError" + NL
    t = t + "    END SELECT" + NL
    t = t + "    s.onMessage = Conn_OnMessage" + NL
    t = t + "    s.onClose = Conn_OnClose" + NL
    t = t + "    srvSock[slot] = s" + NL
    t = t + "    srvClosing[slot] = FALSE" + NL
    t = t + "    srvOn[slot] = TRUE" + NL
    t = t + "    srvPort[slot] = port" + NL
    t = t + "    s.Listen(port)" + NL
    t = t + "    RETURN slot" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB DropConn (k AS Integer)" + NL
    t = t + "    VAR slot AS Integer" + NL
    t = t + "    slot = skSlot[k]" + NL
    t = t + "    skId.RemoveAt(k)" + NL
    t = t + "    skConn.RemoveAt(k)" + NL
    t = t + "    skSlot.RemoveAt(k)" + NL
    t = t + "    IF slot >= 0 THEN CloseIfDone(slot)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A server that's closing, with none of its connections left: its socket goes." + NL
    t = t + "SUB CloseIfDone (slot AS Integer)" + NL
    t = t + "    IF NOT srvClosing[slot] OR skSlot.IndexOf(slot) >= 0 THEN RETURN" + NL
    t = t + "    srvClosing[slot] = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        srvSock[slot].Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ConnOf (id AS Integer) AS Integer" + NL
    t = t + "    RETURN skId.IndexOf(id)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the engine's host" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsFail (code AS String, message AS String) AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    v = JsMakeError(""0|"" + message)" + NL
    t = t + "    JsPutOwn(JsId(v), ""code"", JsS(code))" + NL
    t = t + "    jsThrown = v" + NL
    t = t + "    THROW Str(jsLine) + ""|@thrown""" + NL
    t = t + "    RETURN ""u""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION StrList (list AS Array OF String) AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    FOR EACH v IN list" + NL
    t = t + "        out.Add(JsS(v))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN JsO(JsNewArray(out))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION HostNative (name AS String, thisVal AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR b AS String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR names AS Array OF String" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    VAR prog AS Integer" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    IF NOT name.StartsWith(""node."") THEN THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "    a = JsArg(args, 0)" + NL
    t = t + "    b = JsArg(args, 1)" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""node.write""" + NL
    t = t + "            con.Write(JsStr(a))" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""node.args""" + NL
    t = t + "            list.Add(JsS(""C:\PROGRAMS\NODE.SPK""))" + NL
    t = t + "            IF nodeScript <> """" THEN list.Add(JsS(nodeScript))" + NL
    t = t + "            FOR EACH n IN nodeArgs" + NL
    t = t + "                list.Add(JsS(n))" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsO(JsNewArray(list))" + NL
    t = t + "        CASE ""node.info""" + NL
    t = t + "            SELECT CASE JsStr(a)" + NL
    t = t + "                CASE ""version""" + NL
    t = t + "                    RETURN JsS(NODEVERSION)" + NL
    t = t + "                CASE ""cwd""" + NL
    t = t + "                    RETURN JsS(nodeCwd)" + NL
    t = t + "                CASE ""hostname""" + NL
    t = t + "                    RETURN JsS(NET.HostName)" + NL
    t = t + "                CASE ""address""" + NL
    t = t + "                    RETURN JsS(NET.LocalAddress)" + NL
    t = t + "                CASE ""now""" + NL
    t = t + "                    RETURN JsN(NowMs())" + NL
    t = t + "                CASE ""pid""" + NL
    t = t + "                    RETURN JsN(SYS.Pid)" + NL
    t = t + "                CASE ""where""" + NL
    t = t + "                    RETURN JsS(Where())" + NL
    t = t + "            END SELECT" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""node.chdir""" + NL
    t = t + "            p = FullPath(JsStr(a))" + NL
    t = t + "            IF NOT FS.IsDir(p) THEN RETURN JsFail(""ENOENT"", ""ENOENT: no such file or directory, chdir '"" + p + ""'"")" + NL
    t = t + "            nodeCwd = p" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""node.title""" + NL
    t = t + "            win.Title = JsStr(a)" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""node.exit""" + NL
    t = t + "            Finish(JsInt(a))" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""node.fullpath""" + NL
    t = t + "            RETURN JsS(FullPath(JsStr(a)))" + NL
    t = t + "        ' ---- the disk" + NL
    t = t + "        CASE ""node.fsRead""" + NL
    t = t + "            p = FullPath(JsStr(a))" + NL
    t = t + "            IF NOT FS.Exists(p) OR FS.IsDir(p) THEN RETURN JsFail(""ENOENT"", ""ENOENT: no such file or directory, open '"" + p + ""'"")" + NL
    t = t + "            RETURN JsS(FS.Read(p))" + NL
    t = t + "        CASE ""node.fsWrite"", ""node.fsAppend""" + NL
    t = t + "            p = FullPath(JsStr(a))" + NL
    t = t + "            TRY" + NL
    t = t + "                IF name = ""node.fsWrite"" THEN" + NL
    t = t + "                    FS.Write(p, JsStr(b))" + NL
    t = t + "                ELSE" + NL
    t = t + "                    FS.Append(p, JsStr(b))" + NL
    t = t + "                END IF" + NL
    t = t + "            CATCH err" + NL
    t = t + "                RETURN JsFail(""EINVAL"", err + "", open '"" + p + ""'"")" + NL
    t = t + "            END TRY" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""node.fsStat""" + NL
    t = t + "            p = FullPath(JsStr(a))" + NL
    t = t + "            IF NOT FS.Exists(p) THEN RETURN ""l""" + NL
    t = t + "            IF FS.IsDir(p) THEN RETURN JsS(""d0"")" + NL
    t = t + "            RETURN JsS(""f"" + Str(FS.Size(p)))" + NL
    t = t + "        CASE ""node.fsList""" + NL
    t = t + "            p = FullPath(JsStr(a))" + NL
    t = t + "            IF NOT FS.IsDir(p) THEN RETURN JsFail(""ENOENT"", ""ENOENT: no such file or directory, scandir '"" + p + ""'"")" + NL
    t = t + "            FOR EACH n IN FS.List(p)" + NL
    t = t + "                IF n.EndsWith(""\"") THEN n = n.Substring(0, n.Length - 1)" + NL
    t = t + "                names.Add(n)" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN StrList(names)" + NL
    t = t + "        CASE ""node.fsMkdir""" + NL
    t = t + "            p = FullPath(JsStr(a))" + NL
    t = t + "            IF FS.Exists(p) THEN" + NL
    t = t + "                IF JsBool(b) THEN RETURN ""u""" + NL
    t = t + "                RETURN JsFail(""EEXIST"", ""EEXIST: file already exists, mkdir '"" + p + ""'"")" + NL
    t = t + "            END IF" + NL
    t = t + "            TRY" + NL
    t = t + "                IF JsBool(b) THEN" + NL
    t = t + "                    MakeDirs(p)" + NL
    t = t + "                ELSE" + NL
    t = t + "                    FS.MakeDir(p)" + NL
    t = t + "                END IF" + NL
    t = t + "            CATCH err" + NL
    t = t + "                RETURN JsFail(""ENOENT"", err + "", mkdir '"" + p + ""'"")" + NL
    t = t + "            END TRY" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""node.fsDelete""" + NL
    t = t + "            p = FullPath(JsStr(a))" + NL
    t = t + "            IF NOT FS.Exists(p) THEN RETURN JsFail(""ENOENT"", ""ENOENT: no such file or directory, unlink '"" + p + ""'"")" + NL
    t = t + "            TRY" + NL
    t = t + "                FS.Delete(p)" + NL
    t = t + "            CATCH err" + NL
    t = t + "                RETURN JsFail(""ENOTEMPTY"", err + "", '"" + p + ""'"")" + NL
    t = t + "            END TRY" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""node.fsRename""" + NL
    t = t + "            p = FullPath(JsStr(a))" + NL
    t = t + "            IF NOT FS.Exists(p) THEN RETURN JsFail(""ENOENT"", ""ENOENT: no such file or directory, rename '"" + p + ""'"")" + NL
    t = t + "            TRY" + NL
    t = t + "                FS.Rename(p, FullPath(JsStr(b)))" + NL
    t = t + "            CATCH err" + NL
    t = t + "                RETURN JsFail(""EINVAL"", err)" + NL
    t = t + "            END TRY" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        ' ---- code" + NL
    t = t + "        CASE ""node.compile""" + NL
    t = t + "            ' a module: its code, as a function of exports, require, module, __filename, __dirname" + NL
    t = t + "            fileFrom.Add(nk.Count)" + NL
    t = t + "            fileName.Add(JsStr(b))" + NL
    t = t + "            jsLineBase = 1" + NL
    t = t + "            TRY" + NL
    t = t + "                prog = JsParse(""(function (exports, require, module, __filename, __dirname) {"" + JsStr(a) + Chr(10) + ""})"")" + NL
    t = t + "            CATCH err" + NL
    t = t + "                ' as Node shows one: where, then what" + NL
    t = t + "                v = JsMakeTypedError(""SyntaxError"", err.Substring(err.IndexOf(""|"") + 1, err.Length - err.IndexOf(""|"") - 1))" + NL
    t = t + "                JsPutOwn(JsId(v), ""stack"", JsS(JsStr(b) + "":"" + err.Substring(0, err.IndexOf(""|"")) + Chr(10) + Chr(10) + ""SyntaxError: "" + err.Substring(err.IndexOf(""|"") + 1, err.Length - err.IndexOf(""|"") - 1)))" + NL
    t = t + "                jsThrown = v" + NL
    t = t + "                THROW Str(jsLine) + ""|@thrown""" + NL
    t = t + "            END TRY" + NL
    t = t + "            RETURN JsEval(na[Int(Val(nl[prog].Split("","")[0]))], jsGlobal)" + NL
    t = t + "        CASE ""node.eval""" + NL
    t = t + "            ' the prompt's lines: run where the program's globals are" + NL
    t = t + "            fileFrom.Add(nk.Count)" + NL
    t = t + "            fileName.Add(""REPL"")" + NL
    t = t + "            list.Add(a)" + NL
    t = t + "            RETURN JsEvalCode(list, jsGlobal)" + NL
    t = t + "        ' ---- timers (setTimeout and setInterval come through HostTimeout)" + NL
    t = t + "        CASE ""node.ref""" + NL
    t = t + "            RETURN JsN(tmId.Count)" + NL
    t = t + "        ' ---- the network" + NL
    t = t + "        CASE ""node.listen""" + NL
    t = t + "            TRY" + NL
    t = t + "                k = Listen(JsInt(a))" + NL
    t = t + "            CATCH err" + NL
    t = t + "                RETURN JsFail(""EADDRINUSE"", err)" + NL
    t = t + "            END TRY" + NL
    t = t + "            RETURN JsN(k)" + NL
    t = t + "        CASE ""node.unlisten""" + NL
    t = t + "            ' no more connections; the socket itself closes when the last one does" + NL
    t = t + "            ' (closing it would cut them off)" + NL
    t = t + "            k = JsInt(a)" + NL
    t = t + "            IF k >= 0 AND k < MAXSERVERS THEN" + NL
    t = t + "                IF srvOn[k] THEN" + NL
    t = t + "                    srvOn[k] = FALSE" + NL
    t = t + "                    srvClosing[k] = TRUE" + NL
    t = t + "                    CloseIfDone(k)" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""node.connect""" + NL
    t = t + "            skNext = skNext + 1" + NL
    t = t + "            dialQ.Add(Str(skNext) + ""|"" + JsStr(a) + ""|"" + Str(JsInt(b)))" + NL
    t = t + "            RETURN JsN(skNext)" + NL
    t = t + "        CASE ""node.send""" + NL
    t = t + "            k = ConnOf(JsInt(a))" + NL
    t = t + "            IF k < 0 THEN RETURN ""f""" + NL
    t = t + "            TRY" + NL
    t = t + "                skConn[k].Send(JsStr(b))" + NL
    t = t + "            CATCH err" + NL
    t = t + "                RETURN ""f""" + NL
    t = t + "            END TRY" + NL
    t = t + "            RETURN ""t""" + NL
    t = t + "        CASE ""node.end""" + NL
    t = t + "            k = ConnOf(JsInt(a))" + NL
    t = t + "            IF k < 0 THEN RETURN ""u""" + NL
    t = t + "            TRY" + NL
    t = t + "                skConn[k].Close()" + NL
    t = t + "            CATCH err" + NL
    t = t + "            END TRY" + NL
    t = t + "            ' (onClose may not come for our own end)" + NL
    t = t + "            IF ConnOf(JsInt(a)) >= 0 THEN" + NL
    t = t + "                DropConn(ConnOf(JsInt(a)))" + NL
    t = t + "                Queue(""close"", JsN(JsInt(a)), ""u"")" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""node.peer""" + NL
    t = t + "            k = ConnOf(JsInt(a))" + NL
    t = t + "            IF k < 0 THEN RETURN ""u""" + NL
    t = t + "            RETURN JsS(skConn[k].FromAddress + "":"" + Str(skConn[k].FromPort))" + NL
    t = t + "        CASE ""node.lookup""" + NL
    t = t + "            skNext = skNext + 1" + NL
    t = t + "            lookQ.Add(Str(skNext) + ""|"" + JsStr(a))" + NL
    t = t + "            RETURN JsN(skNext)" + NL
    t = t + "        ' ---- the window" + NL
    t = t + "        CASE ""node.readLine""" + NL
    t = t + "            readPrompt = JsStr(a)" + NL
    t = t + "            IF a = ""u"" THEN readPrompt = """"" + NL
    t = t + "            readWanted = TRUE" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""node.stopReading""" + NL
    t = t + "            readWanted = FALSE" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        ' ---- other programs" + NL
    t = t + "        CASE ""node.spawn""" + NL
    t = t + "            p = FullPath(JsStr(a))" + NL
    t = t + "            IF NOT FS.Exists(p) THEN RETURN JsFail(""ENOENT"", ""spawn "" + p + "" ENOENT"")" + NL
    t = t + "            RETURN JsN(SYS.Start(p, JsStr(b)))" + NL
    t = t + "        CASE ""node.kill""" + NL
    t = t + "            SYS.Kill(JsInt(a))" + NL
    t = t + "            RETURN ""t""" + NL
    t = t + "        CASE ""node.tasks""" + NL
    t = t + "            RETURN StrList(SYS.Tasks())" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "    RETURN ""u""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB MakeDirs (p AS String)" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR so AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    parts = p.Split(""\"")" + NL
    t = t + "    so = parts[0]" + NL
    t = t + "    FOR k = 1 TO parts.Count - 1" + NL
    t = t + "        so = so + ""\"" + parts[k]" + NL
    t = t + "        IF NOT FS.Exists(so) THEN FS.MakeDir(so)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION HostTimeout (code AS String, fn AS String, ms AS Integer, again AS Bool) AS Integer" + NL
    t = t + "    tmNext = tmNext + 1" + NL
    t = t + "    tmId.Add(tmNext)" + NL
    t = t + "    tmDue.Add(NowMs() + MATH.Max(0, ms))" + NL
    t = t + "    tmFn.Add(fn)" + NL
    t = t + "    tmCode.Add(code)" + NL
    t = t + "    IF again THEN" + NL
    t = t + "        tmEvery.Add(MATH.Max(1, ms))" + NL
    t = t + "    ELSE" + NL
    t = t + "        tmEvery.Add(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN tmNext" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB HostClearTimeout (id AS Integer)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    k = tmId.IndexOf(id)" + NL
    t = t + "    IF k >= 0 THEN DropTimer(k)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' (A page's host has these; a program has no page.)" + NL
    t = t + "SUB HostAlert (text AS String)" + NL
    t = t + "    con.WriteLine(text)" + NL
    t = t + "END SUB" + NL
    t = t + "FUNCTION HostConfirm (text AS String) AS Bool" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "FUNCTION HostPrompt (text AS String, initial AS String) AS String" + NL
    t = t + "    RETURN initial" + NL
    t = t + "END FUNCTION" + NL
    t = t + "SUB HostStatus (text AS String)" + NL
    t = t + "    win.Status = text" + NL
    t = t + "END SUB" + NL
    t = t + "SUB HostNavigate (url AS String)" + NL
    t = t + "END SUB" + NL
    t = t + "FUNCTION HostHas (id AS String) AS Bool" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "FUNCTION HostGet (id AS String, prop AS String) AS String" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "SUB HostSet (id AS String, prop AS String, value AS String)" + NL
    t = t + "END SUB" + NL
    t = t + "FUNCTION HostInfo (key AS String) AS String" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "SUB HostSetInfo (key AS String, value AS String)" + NL
    t = t + "END SUB" + NL
    t = t + "FUNCTION HostHistory (n AS Integer) AS Integer" + NL
    t = t + "    RETURN 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "SUB HostOpen (url AS String)" + NL
    t = t + "END SUB" + NL
    t = t + "SUB HostSubmit (form AS Integer)" + NL
    t = t + "END SUB" + NL
    t = t + "SUB HostYield ()" + NL
    t = t + "END SUB" + NL
    t = t + "' A long loop is the program's business: never asked to stop." + NL
    t = t + "FUNCTION HostSlow () AS Bool" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "FUNCTION HostXhrSend (method AS String, url AS String, headers AS String, body AS String, obj AS Integer) AS Integer" + NL
    t = t + "    RETURN 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "SUB HostXhrAbort (req AS Integer)" + NL
    t = t + "END SUB" + NL
    t = t + "FUNCTION HostWhere () AS String" + NL
    t = t + "    RETURN Where()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' JSCRIPT.SPK - a JavaScript interpreter written in SPARK, for the browser." + NL
    t = t + "'" + NL
    t = t + "' It aims at the JavaScript of 1996 (what the browsers of 1996" + NL
    t = t + "' ran) plus a few later conveniences: var, functions and closures, if / while /" + NL
    t = t + "' do / for / for-in / switch / try-catch, objects and arrays, new and this," + NL
    t = t + "' Math, Date, String (with the HTML helpers like ""x"".bold()), Array, parseInt," + NL
    t = t + "' escape, eval, setTimeout, and the page itself through document and window." + NL
    t = t + "' No regular expressions, no bitwise operators, no getters or prototypes" + NL
    t = t + "' beyond the ones built in." + NL
    t = t + "'" + NL
    t = t + "' How it is put together, since SPARK has no records:" + NL
    t = t + "'   * Tokens are parallel arrays (jtType, jtText, jtLine, jtNl)." + NL
    t = t + "'   * The syntax tree is parallel arrays indexed by node number (nk = kind," + NL
    t = t + "'     na/nb/nc/nd = child nodes, ns = a name or literal, nl = a list of nodes)." + NL
    t = t + "'   * A value is a tagged string: ""u"" undefined, ""l"" null, ""t"" / ""f"" booleans," + NL
    t = t + "'     ""n"" + number, ""s"" + text, ""o"" + object number." + NL
    t = t + "'   * Objects (and scopes, which are objects too) live in one property table:" + NL
    t = t + "'     jpKey holds ""object:name"", jpVal the value. joClass, joProto, joA, joB and" + NL
    t = t + "'     joS describe each object: an Array, a Function (joA = its node, joB = the" + NL
    t = t + "'     scope it closes over), a Native function (joS = which one), a Host" + NL
    t = t + "'     element (joS = its id on the page)..." + NL
    t = t + "'" + NL
    t = t + "' The page it runs in is reached through Host... functions, which the browser" + NL
    t = t + "' defines: HostAlert, HostConfirm, HostPrompt, HostStatus, HostNavigate," + NL
    t = t + "' HostGet, HostSet, HostHas, HostInfo, HostSetInfo, HostTimeout," + NL
    t = t + "' HostClearTimeout, HostHistory, HostOpen, HostSubmit, HostYield, HostSlow," + NL
    t = t + "' and HostXhrSend and HostXhrAbort for XMLHttpRequest." + NL
    t = t + "'" + NL
    t = t + "' JsReset() starts a fresh page. JsRun(source) runs a script and returns """"" + NL
    t = t + "' or an error (""line|message""). What document.write wrote is in jsOut." + NL
    t = t + "'" + NL
    t = t + "' XMLHttpRequest (and IE's ActiveXObject(""Microsoft.XMLHTTP"")): send() hands" + NL
    t = t + "' the request to HostXhrSend and returns at once. The browser fetches it and" + NL
    t = t + "' reports back through JsXhrUpdate, which runs onreadystatechange. fetch()" + NL
    t = t + "' rides on the same machinery and returns a small promise (then and catch)." + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- state" + NL
    t = t + "" + NL
    t = t + "VAR jtType AS Array OF String" + NL
    t = t + "VAR jtText AS Array OF String" + NL
    t = t + "VAR jtLine AS Array OF Integer" + NL
    t = t + "VAR jtNl AS Array OF Bool" + NL
    t = t + "VAR jp AS Integer" + NL
    t = t + "VAR jsLineBase AS Integer" + NL
    t = t + "VAR jsLexLine AS Integer" + NL
    t = t + "VAR jsNodeAt AS Integer              ' the statement running (the host can tell which file it's from)" + NL
    t = t + "" + NL
    t = t + "VAR nk AS Array OF String" + NL
    t = t + "VAR na AS Array OF Integer" + NL
    t = t + "VAR nb AS Array OF Integer" + NL
    t = t + "VAR nc AS Array OF Integer" + NL
    t = t + "VAR nd AS Array OF Integer" + NL
    t = t + "VAR ns AS Array OF String" + NL
    t = t + "VAR nl AS Array OF String" + NL
    t = t + "VAR nline AS Array OF Integer" + NL
    t = t + "" + NL
    t = t + "VAR jpKey AS Array OF String" + NL
    t = t + "VAR jpVal AS Array OF String" + NL
    t = t + "VAR joClass AS Array OF String" + NL
    t = t + "VAR joProto AS Array OF Integer" + NL
    t = t + "VAR joA AS Array OF Integer" + NL
    t = t + "VAR joB AS Array OF Integer" + NL
    t = t + "VAR joS AS Array OF String" + NL
    t = t + "VAR joKeys AS Array OF String" + NL
    t = t + "" + NL
    t = t + "VAR jsGlobal AS Integer" + NL
    t = t + "VAR jsObjectProto AS Integer" + NL
    t = t + "VAR jsFunctionProto AS Integer" + NL
    t = t + "VAR jsArrayProto AS Integer" + NL
    t = t + "VAR jsStringProto AS Integer" + NL
    t = t + "VAR jsNumberProto AS Integer" + NL
    t = t + "VAR jsDateProto AS Integer" + NL
    t = t + "VAR jsDocument AS Integer" + NL
    t = t + "VAR jsLocation AS Integer" + NL
    t = t + "VAR jsFormsArray AS Integer" + NL
    t = t + "VAR jsXhrProto AS Integer" + NL
    t = t + "VAR jsPromiseProto AS Integer" + NL
    t = t + "VAR jsErrorProto AS Integer" + NL
    t = t + "VAR jsHostCache AS Array OF String   ' ""id|object"" for page elements already wrapped" + NL
    t = t + "" + NL
    t = t + "VAR jsSig AS String                  ' """" or ""b"" break, ""c"" continue, ""r"" return" + NL
    t = t + "VAR jsRet AS String" + NL
    t = t + "VAR jsLine AS Integer" + NL
    t = t + "VAR jsDepth AS Integer" + NL
    t = t + "VAR jsSteps AS Integer" + NL
    t = t + "VAR jsLimit AS Integer" + NL
    t = t + "VAR jsOut AS String" + NL
    t = t + "VAR jsThrown AS String               ' a value a script threw, while it unwinds" + NL
    t = t + "" + NL
    t = t + "CONST JSMAXDEPTH = 24" + NL
    t = t + "CONST JSSTEPLIMIT = 300000" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the lexer" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsPeek (src AS String, i AS Integer, count AS Integer) AS String" + NL
    t = t + "    IF i >= src.Length THEN RETURN """"" + NL
    t = t + "    IF i + count > src.Length THEN RETURN src.Substring(i, src.Length - i)" + NL
    t = t + "    RETURN src.Substring(i, count)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JsAddToken (kind AS String, text AS String, line AS Integer, newline AS Bool)" + NL
    t = t + "    jtType.Add(kind)" + NL
    t = t + "    jtText.Add(text)" + NL
    t = t + "    jtLine.Add(line)" + NL
    t = t + "    jtNl.Add(newline)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB JsLex (src AS String)" + NL
    t = t + "    jtType.Clear()" + NL
    t = t + "    jtText.Clear()" + NL
    t = t + "    jtLine.Clear()" + NL
    t = t + "    jtNl.Clear()" + NL
    t = t + "    jsLexLine = jsLineBase" + NL
    t = t + "    JsLexInto(src)" + NL
    t = t + "    JsAddToken(""eof"", """", jsLexLine, TRUE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The tokens of src, added to the ones so far (a template's ${...} is lexed" + NL
    t = t + "' this way, in the middle of the rest). jsLexLine is the line it starts on," + NL
    t = t + "' and ends on." + NL
    t = t + "SUB JsLexInto (src AS String)" + NL
    t = t + "    VAR depth AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR ch AS String" + NL
    t = t + "    VAR hexLen AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR fresh AS Bool" + NL
    t = t + "    VAR start AS Integer" + NL
    t = t + "    VAR word AS String" + NL
    t = t + "    VAR q AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    VAR op AS String" + NL
    t = t + "    VAR ops AS Array OF String" + NL
    t = t + "    VAR found AS Bool" + NL
    t = t + "    ops = [""..."", ""==="", ""!=="", ""=="", ""=>"", ""!="", ""<="", "">="", ""&&"", ""||"", ""??"", ""?."", ""++"", ""--"", ""+="", ""-="", ""*="", ""/="", ""%="", ""+"", ""-"", ""*"", ""/"", ""%"", ""<"", "">"", ""="", ""!"", ""?"", "":"", ""."", "","", "";"", ""("", "")"", ""{"", ""}"", ""["", ""]""]" + NL
    t = t + "    n = src.Length" + NL
    t = t + "    line = jsLexLine" + NL
    t = t + "    fresh = TRUE" + NL
    t = t + "    WHILE i < n" + NL
    t = t + "        c = src.CharAt(i)" + NL
    t = t + "        IF c = Chr(10) THEN" + NL
    t = t + "            line = line + 1" + NL
    t = t + "            fresh = TRUE" + NL
    t = t + "            i = i + 1" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF c = "" "" OR c = Chr(9) OR c = Chr(13) THEN" + NL
    t = t + "            i = i + 1" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        ' Comments, including the <!-- and --> that hid scripts from old browsers" + NL
    t = t + "        IF JsPeek(src, i, 2) = ""//"" OR JsPeek(src, i, 4) = ""<!--"" OR (fresh AND JsPeek(src, i, 3) = ""-->"") THEN" + NL
    t = t + "            WHILE i < n AND src.CharAt(i) <> Chr(10)" + NL
    t = t + "                i = i + 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF JsPeek(src, i, 2) = ""/*"" THEN" + NL
    t = t + "            i = i + 2" + NL
    t = t + "            WHILE i < n AND JsPeek(src, i, 2) <> ""*/""" + NL
    t = t + "                IF src.CharAt(i) = Chr(10) THEN line = line + 1" + NL
    t = t + "                i = i + 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "            i = i + 2" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        ' Numbers: 12, 3.5, .5, 1e3, 0x1F" + NL
    t = t + "        IF ""0123456789"".Contains(c) OR (c = ""."" AND ""0123456789"".Contains(JsPeek(src, i + 1, 1)) AND JsPeek(src, i + 1, 1) <> """") THEN" + NL
    t = t + "            start = i" + NL
    t = t + "            IF JsPeek(src, i, 2).Lower() = ""0x"" THEN" + NL
    t = t + "                i = i + 2" + NL
    t = t + "                WHILE i < n AND ""0123456789abcdefABCDEF"".Contains(src.CharAt(i))" + NL
    t = t + "                    i = i + 1" + NL
    t = t + "                END WHILE" + NL
    t = t + "            ELSE" + NL
    t = t + "                WHILE i < n AND ""0123456789."".Contains(src.CharAt(i))" + NL
    t = t + "                    i = i + 1" + NL
    t = t + "                END WHILE" + NL
    t = t + "                IF i < n AND (src.CharAt(i) = ""e"" OR src.CharAt(i) = ""E"") THEN" + NL
    t = t + "                    i = i + 1" + NL
    t = t + "                    IF i < n AND (src.CharAt(i) = ""+"" OR src.CharAt(i) = ""-"") THEN i = i + 1" + NL
    t = t + "                    WHILE i < n AND ""0123456789"".Contains(src.CharAt(i))" + NL
    t = t + "                        i = i + 1" + NL
    t = t + "                    END WHILE" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "            JsAddToken(""num"", src.Substring(start, i - start), line, fresh)" + NL
    t = t + "            fresh = FALSE" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        ' Names and keywords" + NL
    t = t + "        IF ""abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$"".Contains(c) THEN" + NL
    t = t + "            start = i" + NL
    t = t + "            WHILE i < n AND ""abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$0123456789"".Contains(src.CharAt(i))" + NL
    t = t + "                i = i + 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "            word = src.Substring(start, i - start)" + NL
    t = t + "            IF ""|var|let|const|class|extends|super|function|return|if|else|while|for|in|do|break|continue|new|this|true|false|null|typeof|void|delete|switch|case|default|try|catch|finally|throw|instanceof|"".Contains(""|"" + word + ""|"") THEN" + NL
    t = t + "                JsAddToken(""kw"", word, line, fresh)" + NL
    t = t + "            ELSE" + NL
    t = t + "                JsAddToken(""id"", word, line, fresh)" + NL
    t = t + "            END IF" + NL
    t = t + "            fresh = FALSE" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        ' Strings, with backslash escapes" + NL
    t = t + "        IF c = """""""" OR c = ""'"" THEN" + NL
    t = t + "            q = c" + NL
    t = t + "            text = """"" + NL
    t = t + "            i = i + 1" + NL
    t = t + "            WHILE i < n AND src.CharAt(i) <> q" + NL
    t = t + "                c = src.CharAt(i)" + NL
    t = t + "                IF c = Chr(10) THEN THROW Str(line) + ""|Unterminated string constant""" + NL
    t = t + "                IF c = ""\"" AND i + 1 < n THEN" + NL
    t = t + "                    i = i + 1" + NL
    t = t + "                    e = src.CharAt(i)" + NL
    t = t + "                    SELECT CASE e" + NL
    t = t + "                        CASE ""n""" + NL
    t = t + "                            text = text + Chr(10)" + NL
    t = t + "                        CASE ""t""" + NL
    t = t + "                            text = text + Chr(9)" + NL
    t = t + "                        CASE ""r""" + NL
    t = t + "                            text = text + Chr(13)" + NL
    t = t + "                        CASE ""b""" + NL
    t = t + "                            text = text + Chr(8)" + NL
    t = t + "                        CASE Chr(10)" + NL
    t = t + "                            line = line + 1" + NL
    t = t + "                        CASE ""u"", ""x""" + NL
    t = t + "                            hexLen = 4" + NL
    t = t + "                            IF e = ""x"" THEN hexLen = 2" + NL
    t = t + "                            IF i + hexLen < n AND OnlyChars(src.Substring(i + 1, hexLen).Lower(), ""0123456789abcdef"") THEN" + NL
    t = t + "                                text = text + Chr(Int(Val(JsNumberText(""0x"" + src.Substring(i + 1, hexLen)))))" + NL
    t = t + "                                i = i + hexLen" + NL
    t = t + "                            ELSE" + NL
    t = t + "                                text = text + e" + NL
    t = t + "                            END IF" + NL
    t = t + "                        CASE ELSE" + NL
    t = t + "                            text = text + e" + NL
    t = t + "                    END SELECT" + NL
    t = t + "                ELSE" + NL
    t = t + "                    text = text + c" + NL
    t = t + "                END IF" + NL
    t = t + "                i = i + 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "            IF i >= n THEN THROW Str(line) + ""|Unterminated string constant""" + NL
    t = t + "            i = i + 1" + NL
    t = t + "            JsAddToken(""str"", text, line, fresh)" + NL
    t = t + "            fresh = FALSE" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        ' Template literals: `a ${b} c` is lexed as (""a"" + (b) + "" c"")" + NL
    t = t + "        IF c = ""`"" THEN" + NL
    t = t + "            JsAddToken(""op"", ""("", line, fresh)" + NL
    t = t + "            fresh = FALSE" + NL
    t = t + "            text = """"" + NL
    t = t + "            i = i + 1" + NL
    t = t + "            WHILE TRUE" + NL
    t = t + "                IF i >= n THEN THROW Str(line) + ""|Unterminated template literal""" + NL
    t = t + "                c = src.CharAt(i)" + NL
    t = t + "                IF c = ""`"" THEN" + NL
    t = t + "                    i = i + 1" + NL
    t = t + "                    BREAK" + NL
    t = t + "                END IF" + NL
    t = t + "                IF c = ""\"" AND i + 1 < n THEN" + NL
    t = t + "                    i = i + 1" + NL
    t = t + "                    e = src.CharAt(i)" + NL
    t = t + "                    IF e = ""n"" THEN" + NL
    t = t + "                        text = text + Chr(10)" + NL
    t = t + "                    ELSEIF e = ""t"" THEN" + NL
    t = t + "                        text = text + Chr(9)" + NL
    t = t + "                    ELSEIF e = ""r"" THEN" + NL
    t = t + "                        text = text + Chr(13)" + NL
    t = t + "                    ELSEIF e = Chr(10) THEN" + NL
    t = t + "                        line = line + 1" + NL
    t = t + "                    ELSE" + NL
    t = t + "                        text = text + e" + NL
    t = t + "                    END IF" + NL
    t = t + "                    i = i + 1" + NL
    t = t + "                    CONTINUE" + NL
    t = t + "                END IF" + NL
    t = t + "                IF c = ""$"" AND JsPeek(src, i + 1, 1) = ""{"" THEN" + NL
    t = t + "                    JsAddToken(""str"", text, line, FALSE)" + NL
    t = t + "                    JsAddToken(""op"", ""+"", line, FALSE)" + NL
    t = t + "                    JsAddToken(""op"", ""("", line, FALSE)" + NL
    t = t + "                    ' the expression runs to the matching }, past any strings in it" + NL
    t = t + "                    depth = 1" + NL
    t = t + "                    j = i + 2" + NL
    t = t + "                    WHILE j < n" + NL
    t = t + "                        ch = src.CharAt(j)" + NL
    t = t + "                        IF ch = ""{"" THEN" + NL
    t = t + "                            depth = depth + 1" + NL
    t = t + "                        ELSEIF ch = ""}"" THEN" + NL
    t = t + "                            depth = depth - 1" + NL
    t = t + "                            IF depth = 0 THEN BREAK" + NL
    t = t + "                        ELSEIF ch = """""""" OR ch = ""'"" OR ch = ""`"" THEN" + NL
    t = t + "                            j = j + 1" + NL
    t = t + "                            WHILE j < n AND src.CharAt(j) <> ch" + NL
    t = t + "                                IF src.CharAt(j) = ""\"" THEN j = j + 1" + NL
    t = t + "                                j = j + 1" + NL
    t = t + "                            END WHILE" + NL
    t = t + "                        END IF" + NL
    t = t + "                        j = j + 1" + NL
    t = t + "                    END WHILE" + NL
    t = t + "                    IF j >= n THEN THROW Str(line) + ""|Unterminated template literal""" + NL
    t = t + "                    jsLexLine = line" + NL
    t = t + "                    JsLexInto(src.Substring(i + 2, j - i - 2))" + NL
    t = t + "                    line = jsLexLine" + NL
    t = t + "                    JsAddToken(""op"", "")"", line, FALSE)" + NL
    t = t + "                    JsAddToken(""op"", ""+"", line, FALSE)" + NL
    t = t + "                    text = """"" + NL
    t = t + "                    i = j + 1" + NL
    t = t + "                    CONTINUE" + NL
    t = t + "                END IF" + NL
    t = t + "                IF c = Chr(10) THEN line = line + 1" + NL
    t = t + "                text = text + c" + NL
    t = t + "                i = i + 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "            JsAddToken(""str"", text, line, FALSE)" + NL
    t = t + "            JsAddToken(""op"", "")"", line, FALSE)" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        ' Operators, longest first (but ""a ? .5 : 1"" is a ? and a number)" + NL
    t = t + "        found = FALSE" + NL
    t = t + "        FOR EACH op IN ops" + NL
    t = t + "            IF op = ""?."" AND ""0123456789"".Contains(JsPeek(src, i + 2, 1)) AND JsPeek(src, i + 2, 1) <> """" THEN CONTINUE" + NL
    t = t + "            IF JsPeek(src, i, op.Length) = op THEN" + NL
    t = t + "                JsAddToken(""op"", op, line, fresh)" + NL
    t = t + "                i = i + op.Length" + NL
    t = t + "                found = TRUE" + NL
    t = t + "                BREAK" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF NOT found THEN THROW Str(line) + ""|Invalid character""" + NL
    t = t + "        fresh = FALSE" + NL
    t = t + "    END WHILE" + NL
    t = t + "    jsLexLine = line" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the parser" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNode (kind AS String, a AS Integer, b AS Integer, c AS Integer, d AS Integer, s AS String, list AS String, line AS Integer) AS Integer" + NL
    t = t + "    nk.Add(kind)" + NL
    t = t + "    na.Add(a)" + NL
    t = t + "    nb.Add(b)" + NL
    t = t + "    nc.Add(c)" + NL
    t = t + "    nd.Add(d)" + NL
    t = t + "    ns.Add(s)" + NL
    t = t + "    nl.Add(list)" + NL
    t = t + "    nline.Add(line)" + NL
    t = t + "    RETURN nk.Count - 1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsIsOp (op AS String) AS Bool" + NL
    t = t + "    RETURN jtType[jp] = ""op"" AND jtText[jp] = op" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsIsKw (kw AS String) AS Bool" + NL
    t = t + "    RETURN jtType[jp] = ""kw"" AND jtText[jp] = kw" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsAt () AS Integer" + NL
    t = t + "    RETURN jtLine[jp]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JsExpect (op AS String)" + NL
    t = t + "    IF NOT JsIsOp(op) THEN THROW Str(JsAt()) + ""|Expected '"" + op + ""'""" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsName () AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    IF jtType[jp] <> ""id"" THEN THROW Str(JsAt()) + ""|Expected identifier""" + NL
    t = t + "    s = jtText[jp]" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The end of a statement: a ;, or a line break, a } or the end (as browsers allowed)." + NL
    t = t + "SUB JsSemi ()" + NL
    t = t + "    IF JsIsOp("";"") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "    ELSEIF NOT (jtType[jp] = ""eof"" OR JsIsOp(""}"") OR jtNl[jp]) THEN" + NL
    t = t + "        THROW Str(JsAt()) + ""|Expected ';'""" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsParse (src AS String) AS Integer" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    JsLex(src)" + NL
    t = t + "    jp = 0" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    WHILE jtType[jp] <> ""eof""" + NL
    t = t + "        list.Add(Str(JsStatement()))" + NL
    t = t + "    END WHILE" + NL
    t = t + "    ' (the program's own lets and consts are kept like its vars: nd = 2)" + NL
    t = t + "    RETURN JsNode(""block"", 0, 0, 0, 2, """", list.Join("",""), line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A block with let, const or class of its own gets a scope of its own: nd = 1." + NL
    t = t + "FUNCTION JsBlockNode (list AS Array OF String, line AS Integer) AS Integer" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR own AS Integer" + NL
    t = t + "    FOR EACH item IN list" + NL
    t = t + "        IF item = """" THEN CONTINUE" + NL
    t = t + "        IF nk[Int(Val(item))] = ""let"" OR nk[Int(Val(item))] = ""classdecl"" THEN own = 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN JsNode(""block"", 0, 0, 0, own, """", list.Join("",""), line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsBlock () AS Integer" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    JsExpect(""{"")" + NL
    t = t + "    WHILE NOT JsIsOp(""}"")" + NL
    t = t + "        IF jtType[jp] = ""eof"" THEN THROW Str(JsAt()) + ""|Expected '}'""" + NL
    t = t + "        list.Add(Str(JsStatement()))" + NL
    t = t + "    END WHILE" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "    RETURN JsBlockNode(list, line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' var, let or const: each a name or a pattern ({a, b} = o, [x, y] = list)," + NL
    t = t + "' with or without a value. let and const make a ""let"" node." + NL
    t = t + "FUNCTION JsVarList () AS Integer" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR init AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR pat AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    kind = jtText[jp]" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "    WHILE TRUE" + NL
    t = t + "        name = """"" + NL
    t = t + "        pat = 0" + NL
    t = t + "        IF JsIsOp(""{"") OR JsIsOp(""["") THEN" + NL
    t = t + "            pat = JsTarget(FALSE)" + NL
    t = t + "        ELSE" + NL
    t = t + "            name = JsName()" + NL
    t = t + "        END IF" + NL
    t = t + "        init = 0" + NL
    t = t + "        IF JsIsOp(""="") THEN" + NL
    t = t + "            jp = jp + 1" + NL
    t = t + "            init = JsAssign()" + NL
    t = t + "        END IF" + NL
    t = t + "        list.Add(Str(JsNode(""decl"", init, pat, 0, 0, name, """", line)))" + NL
    t = t + "        IF NOT JsIsOp("","") THEN BREAK" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF kind = ""var"" THEN RETURN JsNode(""var"", 0, 0, 0, 0, """", list.Join("",""), line)" + NL
    t = t + "    RETURN JsNode(""let"", 0, 0, 0, 0, kind, list.Join("",""), line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A place a value is put: a name, or a pattern of them." + NL
    t = t + "'   pname: ns = the name" + NL
    t = t + "'   pobj:  nl = its pprop nodes (ns = key, nb = target), nc = a ...rest target" + NL
    t = t + "'   parr:  nl = its targets (0 for a gap), nc = a ...rest target" + NL
    t = t + "' na is the default, when withDefault allows one (x = 1)." + NL
    t = t + "FUNCTION JsTarget (withDefault AS Bool) AS Integer" + NL
    t = t + "    VAR t AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR inner AS Integer" + NL
    t = t + "    VAR rest AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    IF JsIsOp(""{"") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        WHILE NOT JsIsOp(""}"")" + NL
    t = t + "            IF JsIsOp(""..."") THEN" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                rest = JsTarget(FALSE)" + NL
    t = t + "            ELSE" + NL
    t = t + "                IF jtType[jp] = ""id"" OR jtType[jp] = ""str"" OR jtType[jp] = ""kw"" THEN" + NL
    t = t + "                    key = jtText[jp]" + NL
    t = t + "                ELSEIF jtType[jp] = ""num"" THEN" + NL
    t = t + "                    key = JsNumberText(jtText[jp])" + NL
    t = t + "                ELSE" + NL
    t = t + "                    THROW Str(JsAt()) + ""|Expected identifier""" + NL
    t = t + "                END IF" + NL
    t = t + "                IF jtType[jp + 1] = ""op"" AND jtText[jp + 1] = "":"" THEN" + NL
    t = t + "                    jp = jp + 2" + NL
    t = t + "                    inner = JsTarget(TRUE)" + NL
    t = t + "                ELSE" + NL
    t = t + "                    inner = JsNode(""pname"", 0, 0, 0, 0, JsName(), """", line)" + NL
    t = t + "                    IF JsIsOp(""="") THEN" + NL
    t = t + "                        jp = jp + 1" + NL
    t = t + "                        na[inner] = JsAssign()" + NL
    t = t + "                    END IF" + NL
    t = t + "                END IF" + NL
    t = t + "                list.Add(Str(JsNode(""pprop"", 0, inner, 0, 0, key, """", line)))" + NL
    t = t + "            END IF" + NL
    t = t + "            IF NOT JsIsOp(""}"") THEN JsExpect("","")" + NL
    t = t + "        END WHILE" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        t = JsNode(""pobj"", 0, 0, rest, 0, """", list.Join("",""), line)" + NL
    t = t + "    ELSEIF JsIsOp(""["") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        WHILE NOT JsIsOp(""]"")" + NL
    t = t + "            IF JsIsOp("","") THEN" + NL
    t = t + "                list.Add(""0"")" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                CONTINUE" + NL
    t = t + "            END IF" + NL
    t = t + "            IF JsIsOp(""..."") THEN" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                rest = JsTarget(FALSE)" + NL
    t = t + "            ELSE" + NL
    t = t + "                list.Add(Str(JsTarget(TRUE)))" + NL
    t = t + "            END IF" + NL
    t = t + "            IF NOT JsIsOp(""]"") THEN JsExpect("","")" + NL
    t = t + "        END WHILE" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        t = JsNode(""parr"", 0, 0, rest, 0, """", list.Join("",""), line)" + NL
    t = t + "    ELSE" + NL
    t = t + "        t = JsNode(""pname"", 0, 0, 0, 0, JsName(), """", line)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF withDefault AND JsIsOp(""="") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        na[t] = JsAssign()" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN t" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A function's parameters, after its ""("": plain names (a, b) go in names;" + NL
    t = t + "' anything more (defaults, patterns, ...rest) makes a ""params"" node, whose nl" + NL
    t = t + "' is its targets and nc its rest target. Returns that node, or 0." + NL
    t = t + "FUNCTION JsParams (names AS Array OF String) AS Integer" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR rest AS Integer" + NL
    t = t + "    VAR fancy AS Bool" + NL
    t = t + "    VAR t AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    WHILE NOT JsIsOp("")"")" + NL
    t = t + "        IF JsIsOp(""..."") THEN" + NL
    t = t + "            jp = jp + 1" + NL
    t = t + "            rest = JsTarget(FALSE)" + NL
    t = t + "            fancy = TRUE" + NL
    t = t + "        ELSE" + NL
    t = t + "            t = JsTarget(TRUE)" + NL
    t = t + "            IF nk[t] <> ""pname"" OR na[t] <> 0 THEN fancy = TRUE" + NL
    t = t + "            list.Add(Str(t))" + NL
    t = t + "            names.Add(ns[t])" + NL
    t = t + "        END IF" + NL
    t = t + "        IF NOT JsIsOp("")"") THEN JsExpect("","")" + NL
    t = t + "    END WHILE" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "    IF NOT fancy THEN RETURN 0" + NL
    t = t + "    names.Clear()" + NL
    t = t + "    RETURN JsNode(""params"", 0, 0, rest, 0, """", list.Join("",""), line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' function name(a, b) { ... } - as a statement or an expression" + NL
    t = t + "FUNCTION JsFunction (kind AS String) AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR params AS Array OF String" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR body AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "    IF jtType[jp] = ""id"" THEN name = JsName()" + NL
    t = t + "    IF kind = ""func"" AND name = """" THEN THROW Str(JsAt()) + ""|Expected identifier""" + NL
    t = t + "    RETURN JsFunctionRest(kind, name, line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A function from its ""("": the parameters and the body." + NL
    t = t + "FUNCTION JsFunctionRest (kind AS String, name AS String, line AS Integer) AS Integer" + NL
    t = t + "    VAR params AS Array OF String" + NL
    t = t + "    VAR fancy AS Integer" + NL
    t = t + "    VAR body AS Integer" + NL
    t = t + "    JsExpect(""("")" + NL
    t = t + "    fancy = JsParams(params)" + NL
    t = t + "    body = JsBlock()" + NL
    t = t + "    ' (a body's own lets, consts and classes are in the function's scope, beside its functions)" + NL
    t = t + "    nd[body] = 2" + NL
    t = t + "    RETURN JsNode(kind, body, fancy, 0, 0, name, params.Join("",""), line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsStatement () AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR a AS Integer" + NL
    t = t + "    VAR b AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR isVar AS Bool" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    IF JsIsOp(""{"") THEN RETURN JsBlock()" + NL
    t = t + "    IF JsIsOp("";"") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""empty"", 0, 0, 0, 0, """", """", line)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF jtType[jp] = ""kw"" THEN" + NL
    t = t + "        SELECT CASE jtText[jp]" + NL
    t = t + "            CASE ""var"", ""let"", ""const""" + NL
    t = t + "                a = JsVarList()" + NL
    t = t + "                JsSemi()" + NL
    t = t + "                RETURN a" + NL
    t = t + "            CASE ""class""" + NL
    t = t + "                RETURN JsClass(""classdecl"")" + NL
    t = t + "            CASE ""function""" + NL
    t = t + "                RETURN JsFunction(""func"")" + NL
    t = t + "            CASE ""if""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                JsExpect(""("")" + NL
    t = t + "                a = JsExpr()" + NL
    t = t + "                JsExpect("")"")" + NL
    t = t + "                b = JsStatement()" + NL
    t = t + "                c = 0" + NL
    t = t + "                IF JsIsKw(""else"") THEN" + NL
    t = t + "                    jp = jp + 1" + NL
    t = t + "                    c = JsStatement()" + NL
    t = t + "                END IF" + NL
    t = t + "                RETURN JsNode(""if"", a, b, c, 0, """", """", line)" + NL
    t = t + "            CASE ""while""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                JsExpect(""("")" + NL
    t = t + "                a = JsExpr()" + NL
    t = t + "                JsExpect("")"")" + NL
    t = t + "                RETURN JsNode(""while"", a, JsStatement(), 0, 0, """", """", line)" + NL
    t = t + "            CASE ""do""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                b = JsStatement()" + NL
    t = t + "                IF NOT JsIsKw(""while"") THEN THROW Str(JsAt()) + ""|Expected 'while'""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                JsExpect(""("")" + NL
    t = t + "                a = JsExpr()" + NL
    t = t + "                JsExpect("")"")" + NL
    t = t + "                IF JsIsOp("";"") THEN jp = jp + 1" + NL
    t = t + "                RETURN JsNode(""do"", a, b, 0, 0, """", """", line)" + NL
    t = t + "            CASE ""for""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                JsExpect(""("")" + NL
    t = t + "                a = 0" + NL
    t = t + "                isVar = FALSE" + NL
    t = t + "                ' for (x in o), for (var x of list), for (const [k, v] of pairs)..." + NL
    t = t + "                d = jp" + NL
    t = t + "                c = 0" + NL
    t = t + "                IF JsIsKw(""var"") OR JsIsKw(""let"") OR JsIsKw(""const"") THEN" + NL
    t = t + "                    IF NOT JsIsKw(""var"") THEN c = 1" + NL
    t = t + "                    jp = jp + 1" + NL
    t = t + "                END IF" + NL
    t = t + "                IF jtType[jp] = ""id"" OR JsIsOp(""{"") OR JsIsOp(""["") THEN" + NL
    t = t + "                    a = JsTarget(FALSE)" + NL
    t = t + "                    IF JsIsKw(""in"") OR (jtType[jp] = ""id"" AND jtText[jp] = ""of"") THEN" + NL
    t = t + "                        name = jtText[jp]" + NL
    t = t + "                        jp = jp + 1" + NL
    t = t + "                        b = JsExpr()" + NL
    t = t + "                        JsExpect("")"")" + NL
    t = t + "                        IF nk[a] = ""pname"" THEN" + NL
    t = t + "                            IF name = ""in"" THEN RETURN JsNode(""forin"", b, 0, c, JsStatement(), ns[a], """", line)" + NL
    t = t + "                            RETURN JsNode(""forof"", b, 0, c, JsStatement(), ns[a], """", line)" + NL
    t = t + "                        END IF" + NL
    t = t + "                        IF name = ""in"" THEN RETURN JsNode(""forin"", b, a, c, JsStatement(), """", """", line)" + NL
    t = t + "                        RETURN JsNode(""forof"", b, a, c, JsStatement(), """", """", line)" + NL
    t = t + "                    END IF" + NL
    t = t + "                END IF" + NL
    t = t + "                jp = d" + NL
    t = t + "                a = 0" + NL
    t = t + "                IF JsIsKw(""var"") OR JsIsKw(""let"") OR JsIsKw(""const"") THEN a = JsVarList()" + NL
    t = t + "                IF a = 0 AND NOT JsIsOp("";"") THEN" + NL
    t = t + "                    a = JsNode(""exprst"", JsExpr(), 0, 0, 0, """", """", line)" + NL
    t = t + "                END IF" + NL
    t = t + "                JsExpect("";"")" + NL
    t = t + "                b = 0" + NL
    t = t + "                IF NOT JsIsOp("";"") THEN b = JsExpr()" + NL
    t = t + "                JsExpect("";"")" + NL
    t = t + "                c = 0" + NL
    t = t + "                IF NOT JsIsOp("")"") THEN c = JsExpr()" + NL
    t = t + "                JsExpect("")"")" + NL
    t = t + "                RETURN JsNode(""for"", a, b, c, JsStatement(), """", """", line)" + NL
    t = t + "            CASE ""return""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                a = 0" + NL
    t = t + "                IF NOT (JsIsOp("";"") OR JsIsOp(""}"") OR jtType[jp] = ""eof"" OR jtNl[jp]) THEN a = JsExpr()" + NL
    t = t + "                JsSemi()" + NL
    t = t + "                RETURN JsNode(""return"", a, 0, 0, 0, """", """", line)" + NL
    t = t + "            CASE ""break""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                JsSemi()" + NL
    t = t + "                RETURN JsNode(""break"", 0, 0, 0, 0, """", """", line)" + NL
    t = t + "            CASE ""continue""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                JsSemi()" + NL
    t = t + "                RETURN JsNode(""continue"", 0, 0, 0, 0, """", """", line)" + NL
    t = t + "            CASE ""throw""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                a = JsExpr()" + NL
    t = t + "                JsSemi()" + NL
    t = t + "                RETURN JsNode(""throw"", a, 0, 0, 0, """", """", line)" + NL
    t = t + "            CASE ""try""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                a = JsBlock()" + NL
    t = t + "                b = 0" + NL
    t = t + "                c = 0" + NL
    t = t + "                IF JsIsKw(""catch"") THEN" + NL
    t = t + "                    jp = jp + 1" + NL
    t = t + "                    JsExpect(""("")" + NL
    t = t + "                    name = JsName()" + NL
    t = t + "                    JsExpect("")"")" + NL
    t = t + "                    b = JsBlock()" + NL
    t = t + "                END IF" + NL
    t = t + "                IF JsIsKw(""finally"") THEN" + NL
    t = t + "                    jp = jp + 1" + NL
    t = t + "                    c = JsBlock()" + NL
    t = t + "                END IF" + NL
    t = t + "                RETURN JsNode(""try"", a, b, c, 0, name, """", line)" + NL
    t = t + "            CASE ""switch""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                JsExpect(""("")" + NL
    t = t + "                a = JsExpr()" + NL
    t = t + "                JsExpect("")"")" + NL
    t = t + "                JsExpect(""{"")" + NL
    t = t + "                ' each case is a node: na = its test (0 for default), nl = its statements" + NL
    t = t + "                WHILE NOT JsIsOp(""}"")" + NL
    t = t + "                    IF JsIsKw(""case"") THEN" + NL
    t = t + "                        jp = jp + 1" + NL
    t = t + "                        b = JsExpr()" + NL
    t = t + "                    ELSEIF JsIsKw(""default"") THEN" + NL
    t = t + "                        jp = jp + 1" + NL
    t = t + "                        b = 0" + NL
    t = t + "                    ELSE" + NL
    t = t + "                        THROW Str(JsAt()) + ""|Expected 'case'""" + NL
    t = t + "                    END IF" + NL
    t = t + "                    JsExpect("":"")" + NL
    t = t + "                    c = JsNode(""case"", b, 0, 0, 0, """", """", JsAt())" + NL
    t = t + "                    WHILE NOT (JsIsKw(""case"") OR JsIsKw(""default"") OR JsIsOp(""}"") OR jtType[jp] = ""eof"")" + NL
    t = t + "                        IF nl[c] <> """" THEN nl[c] = nl[c] + "",""" + NL
    t = t + "                        nl[c] = nl[c] + Str(JsStatement())" + NL
    t = t + "                    END WHILE" + NL
    t = t + "                    list.Add(Str(c))" + NL
    t = t + "                END WHILE" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                RETURN JsNode(""switch"", a, 0, 0, 0, """", list.Join("",""), line)" + NL
    t = t + "        END SELECT" + NL
    t = t + "    END IF" + NL
    t = t + "    a = JsExpr()" + NL
    t = t + "    JsSemi()" + NL
    t = t + "    RETURN JsNode(""exprst"", a, 0, 0, 0, """", """", line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsExpr () AS Integer" + NL
    t = t + "    VAR a AS Integer" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    a = JsAssign()" + NL
    t = t + "    IF NOT JsIsOp("","") THEN RETURN a" + NL
    t = t + "    list.Add(Str(a))" + NL
    t = t + "    WHILE JsIsOp("","")" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        list.Add(Str(JsAssign()))" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN JsNode(""seq"", 0, 0, 0, 0, """", list.Join("",""), JsAt())" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsAssign () AS Integer" + NL
    t = t + "    VAR left AS Integer" + NL
    t = t + "    VAR op AS String" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    IF JsArrowAhead() THEN RETURN JsArrow()" + NL
    t = t + "    left = JsConditional()" + NL
    t = t + "    IF jtType[jp] = ""op"" AND ""|=|+=|-=|*=|/=|%=|"".Contains(""|"" + jtText[jp] + ""|"") THEN" + NL
    t = t + "        op = jtText[jp]" + NL
    t = t + "        IF nk[left] <> ""id"" AND nk[left] <> ""member"" AND nk[left] <> ""index"" THEN THROW Str(line) + ""|Cannot assign to '"" + JsDescribe(left) + ""'""" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""assign"", left, JsAssign(), 0, 0, op, """", line)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN left" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is an arrow function next: x => ..., () => ..., (a, b) => ...?" + NL
    t = t + "FUNCTION JsArrowAhead () AS Bool" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR depth AS Integer" + NL
    t = t + "    IF jtType[jp] = ""id"" THEN RETURN jtType[jp + 1] = ""op"" AND jtText[jp + 1] = ""=>""" + NL
    t = t + "    IF NOT JsIsOp(""("") THEN RETURN FALSE" + NL
    t = t + "    ' the ) that matches, then =>" + NL
    t = t + "    k = jp" + NL
    t = t + "    WHILE jtType[k] <> ""eof""" + NL
    t = t + "        IF jtType[k] = ""op"" THEN" + NL
    t = t + "            IF jtText[k] = ""("" OR jtText[k] = ""["" OR jtText[k] = ""{"" THEN depth = depth + 1" + NL
    t = t + "            IF jtText[k] = "")"" OR jtText[k] = ""]"" OR jtText[k] = ""}"" THEN" + NL
    t = t + "                depth = depth - 1" + NL
    t = t + "                IF depth = 0 THEN RETURN jtType[k + 1] = ""op"" AND jtText[k + 1] = ""=>""" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        k = k + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' An arrow function, a later convenience: a function expression marked" + NL
    t = t + "' (nd = 1) to keep the this of where it was made. A body that is just an" + NL
    t = t + "' expression returns it." + NL
    t = t + "FUNCTION JsArrow () AS Integer" + NL
    t = t + "    VAR params AS Array OF String" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR body AS Integer" + NL
    t = t + "    VAR fancy AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    IF jtType[jp] = ""id"" THEN" + NL
    t = t + "        params.Add(JsName())" + NL
    t = t + "    ELSE" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        fancy = JsParams(params)" + NL
    t = t + "    END IF" + NL
    t = t + "    JsExpect(""=>"")" + NL
    t = t + "    IF JsIsOp(""{"") THEN" + NL
    t = t + "        body = JsBlock()" + NL
    t = t + "        nd[body] = 2" + NL
    t = t + "    ELSE" + NL
    t = t + "        body = JsNode(""return"", JsAssign(), 0, 0, 0, """", """", line)" + NL
    t = t + "        body = JsNode(""block"", 0, 0, 0, 0, """", Str(body), line)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN JsNode(""funcexpr"", body, fancy, 0, 1, """", params.Join("",""), line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsConditional () AS Integer" + NL
    t = t + "    VAR test AS Integer" + NL
    t = t + "    VAR a AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    test = JsBinary(1)" + NL
    t = t + "    IF NOT JsIsOp(""?"") THEN RETURN test" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "    a = JsAssign()" + NL
    t = t + "    JsExpect("":"")" + NL
    t = t + "    RETURN JsNode(""cond"", test, a, JsAssign(), 0, """", """", line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsPrec (op AS String) AS Integer" + NL
    t = t + "    SELECT CASE op" + NL
    t = t + "        CASE ""||"", ""??""" + NL
    t = t + "            RETURN 1" + NL
    t = t + "        CASE ""&&""" + NL
    t = t + "            RETURN 2" + NL
    t = t + "        CASE ""=="", ""!="", ""==="", ""!==""" + NL
    t = t + "            RETURN 3" + NL
    t = t + "        CASE ""<"", "">"", ""<="", "">="", ""in"", ""instanceof""" + NL
    t = t + "            RETURN 4" + NL
    t = t + "        CASE ""+"", ""-""" + NL
    t = t + "            RETURN 5" + NL
    t = t + "        CASE ""*"", ""/"", ""%""" + NL
    t = t + "            RETURN 6" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Precedence climbing: one loop for every binary operator level." + NL
    t = t + "FUNCTION JsBinary (least AS Integer) AS Integer" + NL
    t = t + "    VAR left AS Integer" + NL
    t = t + "    VAR op AS String" + NL
    t = t + "    VAR prec AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    left = JsUnary()" + NL
    t = t + "    WHILE jtType[jp] = ""op"" OR (jtType[jp] = ""kw"" AND (jtText[jp] = ""in"" OR jtText[jp] = ""instanceof""))" + NL
    t = t + "        op = jtText[jp]" + NL
    t = t + "        prec = JsPrec(op)" + NL
    t = t + "        IF prec = 0 OR prec < least THEN BREAK" + NL
    t = t + "        line = JsAt()" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        left = JsNode(""bin"", left, JsBinary(prec + 1), 0, 0, op, """", line)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN left" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsUnary () AS Integer" + NL
    t = t + "    VAR op AS String" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR a AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    IF jtType[jp] = ""op"" AND (jtText[jp] = ""!"" OR jtText[jp] = ""-"" OR jtText[jp] = ""+"") THEN" + NL
    t = t + "        op = jtText[jp]" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""unary"", JsUnary(), 0, 0, 0, op, """", line)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF JsIsKw(""typeof"") OR JsIsKw(""void"") OR JsIsKw(""delete"") THEN" + NL
    t = t + "        op = jtText[jp]" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""unary"", JsUnary(), 0, 0, 0, op, """", line)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF JsIsOp(""++"") OR JsIsOp(""--"") THEN" + NL
    t = t + "        op = jtText[jp]" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        a = JsUnary()" + NL
    t = t + "        IF nk[a] <> ""id"" AND nk[a] <> ""member"" AND nk[a] <> ""index"" THEN THROW Str(line) + ""|Cannot assign to '"" + JsDescribe(a) + ""'""" + NL
    t = t + "        RETURN JsNode(""incdec"", a, 0, 0, 0, op, ""pre"", line)" + NL
    t = t + "    END IF" + NL
    t = t + "    a = JsPostfix()" + NL
    t = t + "    IF (JsIsOp(""++"") OR JsIsOp(""--"")) AND NOT jtNl[jp] THEN" + NL
    t = t + "        IF nk[a] <> ""id"" AND nk[a] <> ""member"" AND nk[a] <> ""index"" THEN THROW Str(line) + ""|Cannot assign to '"" + JsDescribe(a) + ""'""" + NL
    t = t + "        op = jtText[jp]" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""incdec"", a, 0, 0, 0, op, ""post"", line)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN a" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsArgs () AS String" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    JsExpect(""("")" + NL
    t = t + "    WHILE NOT JsIsOp("")"")" + NL
    t = t + "        list.Add(Str(JsSpreadOr()))" + NL
    t = t + "        IF NOT JsIsOp("")"") THEN JsExpect("","")" + NL
    t = t + "    END WHILE" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "    RETURN list.Join("","")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ...list (a ""spread"" node), or an ordinary value." + NL
    t = t + "FUNCTION JsSpreadOr () AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    IF JsIsOp(""..."") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""spread"", JsAssign(), 0, 0, 0, """", """", line)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN JsAssign()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Members, calls and new: a.b, a[b], a(b), new A(b)" + NL
    t = t + "FUNCTION JsPostfix () AS Integer" + NL
    t = t + "    VAR chained AS Bool" + NL
    t = t + "    VAR e AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR callee AS Integer" + NL
    t = t + "    VAR args AS String" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    IF JsIsKw(""new"") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        callee = JsPrimary()" + NL
    t = t + "        WHILE JsIsOp(""."") OR JsIsOp(""["")" + NL
    t = t + "            callee = JsMemberStep(callee)" + NL
    t = t + "        END WHILE" + NL
    t = t + "        args = """"" + NL
    t = t + "        IF JsIsOp(""("") THEN args = JsArgs()" + NL
    t = t + "        e = JsNode(""new"", callee, 0, 0, 0, """", args, line)" + NL
    t = t + "    ELSE" + NL
    t = t + "        e = JsPrimary()" + NL
    t = t + "    END IF" + NL
    t = t + "    WHILE JsIsOp(""."") OR JsIsOp(""["") OR JsIsOp(""("") OR JsIsOp(""?."")" + NL
    t = t + "        IF JsIsOp(""?."") THEN" + NL
    t = t + "            ' a?.b, a?.[k], a?.(x): undefined when a is null or undefined (nd = 1)" + NL
    t = t + "            line = JsAt()" + NL
    t = t + "            jp = jp + 1" + NL
    t = t + "            IF JsIsOp(""("") THEN" + NL
    t = t + "                e = JsNode(""call"", e, 0, 0, 1, """", JsArgs(), line)" + NL
    t = t + "            ELSEIF JsIsOp(""["") THEN" + NL
    t = t + "                e = JsMemberStep(e)" + NL
    t = t + "                nd[e] = 1" + NL
    t = t + "            ELSE" + NL
    t = t + "                IF jtType[jp] <> ""id"" AND jtType[jp] <> ""kw"" THEN THROW Str(JsAt()) + ""|Expected identifier""" + NL
    t = t + "                e = JsNode(""member"", e, 0, 0, 1, jtText[jp], """", line)" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSEIF JsIsOp(""("") THEN" + NL
    t = t + "            line = JsAt()" + NL
    t = t + "            e = JsNode(""call"", e, 0, 0, 0, """", JsArgs(), line)" + NL
    t = t + "            IF chained THEN nd[e] = 1" + NL
    t = t + "        ELSE" + NL
    t = t + "            e = JsMemberStep(e)" + NL
    t = t + "            IF chained THEN nd[e] = 1" + NL
    t = t + "        END IF" + NL
    t = t + "        ' (after a ?., the rest of the chain is skipped too: a?.b.c)" + NL
    t = t + "        IF nd[e] = 1 THEN chained = TRUE" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN e" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsMemberStep (e AS Integer) AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR key AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    IF JsIsOp(""."") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        IF jtType[jp] <> ""id"" AND jtType[jp] <> ""kw"" THEN THROW Str(JsAt()) + ""|Expected identifier""" + NL
    t = t + "        name = jtText[jp]" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""member"", e, 0, 0, 0, name, """", line)" + NL
    t = t + "    END IF" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "    key = JsExpr()" + NL
    t = t + "    JsExpect(""]"")" + NL
    t = t + "    RETURN JsNode(""index"", e, key, 0, 0, """", """", line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsPrimary () AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR a AS Integer" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    t = jtType[jp]" + NL
    t = t + "    text = jtText[jp]" + NL
    t = t + "    IF t = ""num"" THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""num"", 0, 0, 0, 0, JsNumberText(text), """", line)" + NL
    t = t + "    ELSEIF t = ""str"" THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""str"", 0, 0, 0, 0, text, """", line)" + NL
    t = t + "    ELSEIF t = ""id"" THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""id"", 0, 0, 0, 0, text, """", line)" + NL
    t = t + "    ELSEIF t = ""kw"" THEN" + NL
    t = t + "        SELECT CASE text" + NL
    t = t + "            CASE ""this"", ""true"", ""false"", ""null""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                RETURN JsNode(text, 0, 0, 0, 0, """", """", line)" + NL
    t = t + "            CASE ""function""" + NL
    t = t + "                RETURN JsFunction(""funcexpr"")" + NL
    t = t + "            CASE ""class""" + NL
    t = t + "                RETURN JsClass(""classexpr"")" + NL
    t = t + "            CASE ""super""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                IF JsIsOp(""("") THEN RETURN JsNode(""supercall"", 0, 0, 0, 0, """", JsArgs(), line)" + NL
    t = t + "                JsExpect(""."")" + NL
    t = t + "                text = jtText[jp]" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                RETURN JsNode(""supermember"", 0, 0, 0, 0, text, """", line)" + NL
    t = t + "        END SELECT" + NL
    t = t + "    ELSEIF JsIsOp(""("") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        a = JsExpr()" + NL
    t = t + "        JsExpect("")"")" + NL
    t = t + "        RETURN a" + NL
    t = t + "    ELSEIF JsIsOp(""["") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        WHILE NOT JsIsOp(""]"")" + NL
    t = t + "            list.Add(Str(JsSpreadOr()))" + NL
    t = t + "            IF NOT JsIsOp(""]"") THEN JsExpect("","")" + NL
    t = t + "        END WHILE" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""array"", 0, 0, 0, 0, """", list.Join("",""), line)" + NL
    t = t + "    ELSEIF JsIsOp(""{"") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        WHILE NOT JsIsOp(""}"")" + NL
    t = t + "            ' ...other (nb = 2), [computed]: v (nb = the key's node), a(), a" + NL
    t = t + "            IF JsIsOp(""..."") THEN" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                list.Add(Str(JsNode(""prop"", JsAssign(), 2, 0, 0, """", """", line)))" + NL
    t = t + "                IF NOT JsIsOp(""}"") THEN JsExpect("","")" + NL
    t = t + "                CONTINUE" + NL
    t = t + "            END IF" + NL
    t = t + "            a = 0" + NL
    t = t + "            IF JsIsOp(""["") THEN" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                a = JsAssign()" + NL
    t = t + "                JsExpect(""]"")" + NL
    t = t + "                key = """"" + NL
    t = t + "            ELSEIF jtType[jp] = ""id"" OR jtType[jp] = ""str"" OR jtType[jp] = ""kw"" THEN" + NL
    t = t + "                key = jtText[jp]" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "            ELSEIF jtType[jp] = ""num"" THEN" + NL
    t = t + "                key = JsNumberText(jtText[jp])" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "            ELSE" + NL
    t = t + "                THROW Str(JsAt()) + ""|Expected identifier""" + NL
    t = t + "            END IF" + NL
    t = t + "            IF JsIsOp(""("") THEN" + NL
    t = t + "                list.Add(Str(JsNode(""prop"", JsFunctionRest(""funcexpr"", """", line), a, 0, 0, key, """", line)))" + NL
    t = t + "            ELSEIF a = 0 AND jtType[jp - 1] = ""id"" AND (JsIsOp("","") OR JsIsOp(""}"")) THEN" + NL
    t = t + "                list.Add(Str(JsNode(""prop"", JsNode(""id"", 0, 0, 0, 0, key, """", line), 0, 0, 0, key, """", line)))" + NL
    t = t + "            ELSE" + NL
    t = t + "                JsExpect("":"")" + NL
    t = t + "                list.Add(Str(JsNode(""prop"", JsAssign(), a, 0, 0, key, """", line)))" + NL
    t = t + "            END IF" + NL
    t = t + "            IF NOT JsIsOp(""}"") THEN JsExpect("","")" + NL
    t = t + "        END WHILE" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""object"", 0, 0, 0, 0, """", list.Join("",""), line)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF t = ""eof"" THEN THROW Str(line) + ""|Syntax error""" + NL
    t = t + "    THROW Str(line) + ""|Syntax error""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "'class A extends B { constructor() {} m() {} static s() {} x = 1 }" + NL
    t = t + "' na = what it extends (0: nothing), nb = the constructor (a made-up one" + NL
    t = t + "' when it has none), nl = its methods and fields: ""method"" or ""field""" + NL
    t = t + "' nodes, ns = the name, nb = 1 when static." + NL
    t = t + "FUNCTION JsClass (kind AS String) AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR sup AS Integer" + NL
    t = t + "    VAR ctor AS Integer" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR isStatic AS Integer" + NL
    t = t + "    VAR body AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "    IF jtType[jp] = ""id"" THEN name = JsName()" + NL
    t = t + "    IF kind = ""classdecl"" AND name = """" THEN THROW Str(JsAt()) + ""|Expected identifier""" + NL
    t = t + "    IF JsIsKw(""extends"") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        sup = JsPostfix()" + NL
    t = t + "    END IF" + NL
    t = t + "    JsExpect(""{"")" + NL
    t = t + "    WHILE NOT JsIsOp(""}"")" + NL
    t = t + "        IF jtType[jp] = ""eof"" THEN THROW Str(JsAt()) + ""|Expected '}'""" + NL
    t = t + "        IF JsIsOp("";"") THEN" + NL
    t = t + "            jp = jp + 1" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        isStatic = 0" + NL
    t = t + "        IF jtType[jp] = ""id"" AND jtText[jp] = ""static"" AND NOT (jtType[jp + 1] = ""op"" AND (jtText[jp + 1] = ""("" OR jtText[jp + 1] = ""="")) THEN" + NL
    t = t + "            isStatic = 1" + NL
    t = t + "            jp = jp + 1" + NL
    t = t + "        END IF" + NL
    t = t + "        IF jtType[jp] = ""id"" AND (jtText[jp] = ""get"" OR jtText[jp] = ""set"" OR jtText[jp] = ""async"") AND jtType[jp + 1] <> ""op"" THEN THROW Str(JsAt()) + ""|'"" + jtText[jp] + ""' methods are not supported yet""" + NL
    t = t + "        IF jtType[jp] = ""id"" OR jtType[jp] = ""kw"" OR jtType[jp] = ""str"" THEN" + NL
    t = t + "            key = jtText[jp]" + NL
    t = t + "        ELSE" + NL
    t = t + "            THROW Str(JsAt()) + ""|Expected identifier""" + NL
    t = t + "        END IF" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        IF JsIsOp(""("") THEN" + NL
    t = t + "            body = JsFunctionRest(""funcexpr"", """", JsAt())" + NL
    t = t + "            IF key = ""constructor"" AND isStatic = 0 THEN" + NL
    t = t + "                ctor = body" + NL
    t = t + "            ELSE" + NL
    t = t + "                list.Add(Str(JsNode(""method"", body, isStatic, 0, 0, key, """", line)))" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSE" + NL
    t = t + "            body = 0" + NL
    t = t + "            IF JsIsOp(""="") THEN" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                body = JsAssign()" + NL
    t = t + "            END IF" + NL
    t = t + "            JsSemi()" + NL
    t = t + "            list.Add(Str(JsNode(""field"", body, isStatic, 0, 0, key, """", line)))" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "    IF ctor = 0 THEN" + NL
    t = t + "        ' class A {} gets constructor() {}; class B extends A {} gets" + NL
    t = t + "        ' constructor(...args) { super(...args) }" + NL
    t = t + "        IF sup <> 0 THEN" + NL
    t = t + "            body = JsNode(""exprst"", JsNode(""supercall"", 0, 0, 0, 0, """", ""@all"", line), 0, 0, 0, """", """", line)" + NL
    t = t + "            ctor = JsNode(""funcexpr"", JsNode(""block"", 0, 0, 0, 0, """", Str(body), line), 0, 0, 0, """", """", line)" + NL
    t = t + "        ELSE" + NL
    t = t + "            ctor = JsNode(""funcexpr"", JsNode(""block"", 0, 0, 0, 0, """", """", line), 0, 0, 0, """", """", line)" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN JsNode(kind, sup, ctor, 0, 0, name, list.Join("",""), line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsDescribe (n AS Integer) AS String" + NL
    t = t + "    SELECT CASE nk[n]" + NL
    t = t + "        CASE ""id""" + NL
    t = t + "            RETURN ns[n]" + NL
    t = t + "        CASE ""member""" + NL
    t = t + "            RETURN JsDescribe(na[n]) + ""."" + ns[n]" + NL
    t = t + "        CASE ""index""" + NL
    t = t + "            RETURN JsDescribe(na[n]) + ""[...]""" + NL
    t = t + "        CASE ""call""" + NL
    t = t + "            RETURN JsDescribe(na[n]) + ""(...)""" + NL
    t = t + "        CASE ""this""" + NL
    t = t + "            RETURN ""this""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""Object""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' v, which the program is about to use as an object (node n): stops with" + NL
    t = t + "' the message 1996 browsers gave when it is null or undefined." + NL
    t = t + "FUNCTION JsNeed (v AS String, n AS Integer) AS String" + NL
    t = t + "    IF v = ""u"" OR v = ""l"" THEN THROW Str(nline[n]) + ""|'"" + JsDescribe(n) + ""' is null or not an object""" + NL
    t = t + "    RETURN v" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The value a number literal stands for, in canonical form." + NL
    t = t + "FUNCTION JsNumberText (text AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR v AS Real" + NL
    t = t + "    IF text.Lower().StartsWith(""0x"") THEN" + NL
    t = t + "        FOR i = 2 TO text.Length - 1" + NL
    t = t + "            v = v * 16 + ""0123456789abcdef"".IndexOf(text.CharAt(i).Lower())" + NL
    t = t + "        NEXT" + NL
    t = t + "        RETURN JsFmt(v)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN JsFmt(Val(text))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- numbers" + NL
    t = t + "" + NL
    t = t + "' A number the way JavaScript writes it: the shortest form that reads back" + NL
    t = t + "' exactly (SPARK's Str rounds to six digits)." + NL
    t = t + "FUNCTION JsFmt (r AS Real) AS String" + NL
    t = t + "    VAR p AS Integer" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    IF r <> r THEN RETURN ""NaN""" + NL
    t = t + "    IF r > 1.7976931348623157E308 THEN RETURN ""Infinity""" + NL
    t = t + "    IF r < -1.7976931348623157E308 THEN RETURN ""-Infinity""" + NL
    t = t + "    IF r = Int(r) AND Abs(r) < 1E21 THEN RETURN Str(Int(r))" + NL
    t = t + "    FOR p = 1 TO 17" + NL
    t = t + "        s = JsDigits(r, p, 0)" + NL
    t = t + "        IF Val(s) = r THEN RETURN s" + NL
    t = t + "        IF p >= 15 THEN" + NL
    t = t + "            IF Val(JsDigits(r, p, -1)) = r THEN RETURN JsDigits(r, p, -1)" + NL
    t = t + "            IF Val(JsDigits(r, p, 1)) = r THEN RETURN JsDigits(r, p, 1)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' r to p significant digits. Where 10^k is exact the digits are worked out" + NL
    t = t + "' exactly (Dekker's product); elsewhere they may be one out in the last" + NL
    t = t + "' place, which nudge makes up for." + NL
    t = t + "FUNCTION JsDigits (r AS Real, p AS Integer, nudge AS Integer) AS String" + NL
    t = t + "    VAR a AS Real" + NL
    t = t + "    VAR e AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR digits AS Real" + NL
    t = t + "    VAR ds AS String" + NL
    t = t + "    VAR sign AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR frac AS String" + NL
    t = t + "    IF r < 0 THEN sign = ""-""" + NL
    t = t + "    a = Abs(r)" + NL
    t = t + "    e = MATH.Floor(MATH.Log(a) / MATH.Log(10))" + NL
    t = t + "    IF 10 ^ e > a THEN e = e - 1" + NL
    t = t + "    IF 10 ^ (e + 1) <= a THEN e = e + 1" + NL
    t = t + "    k = p - 1 - e" + NL
    t = t + "    IF k >= 0 AND k <= 22 THEN" + NL
    t = t + "        ds = JsScaled(a, 10 ^ k, nudge)" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF k > 300 THEN" + NL
    t = t + "            digits = MATH.Round(a * 10 ^ 300 * 10 ^ (k - 300)) + nudge" + NL
    t = t + "        ELSEIF k > 0 THEN" + NL
    t = t + "            digits = MATH.Round(a * 10 ^ k) + nudge" + NL
    t = t + "        ELSE" + NL
    t = t + "            digits = MATH.Round(a / 10 ^ (-k)) + nudge" + NL
    t = t + "        END IF" + NL
    t = t + "        ds = Str(Int(digits))" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ds.Length > p THEN" + NL
    t = t + "        ds = ds.Substring(0, p)" + NL
    t = t + "        e = e + 1" + NL
    t = t + "    END IF" + NL
    t = t + "    WHILE ds.Length < p" + NL
    t = t + "        ds = ds + ""0""" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF e >= 21 OR e < -6 THEN" + NL
    t = t + "        frac = ds.Substring(1, ds.Length - 1)" + NL
    t = t + "        WHILE frac.EndsWith(""0"")" + NL
    t = t + "            frac = frac.Substring(0, frac.Length - 1)" + NL
    t = t + "        END WHILE" + NL
    t = t + "        out = ds.Substring(0, 1)" + NL
    t = t + "        IF frac <> """" THEN out = out + ""."" + frac" + NL
    t = t + "        IF e > 0 THEN RETURN sign + out + ""e+"" + Str(e)" + NL
    t = t + "        RETURN sign + out + ""e"" + Str(e)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF e >= 0 THEN" + NL
    t = t + "        out = ds.Substring(0, e + 1)" + NL
    t = t + "        frac = ds.Substring(e + 1, ds.Length - e - 1)" + NL
    t = t + "    ELSE" + NL
    t = t + "        out = ""0""" + NL
    t = t + "        frac = """"" + NL
    t = t + "        WHILE frac.Length < -e - 1" + NL
    t = t + "            frac = frac + ""0""" + NL
    t = t + "        END WHILE" + NL
    t = t + "        frac = frac + ds" + NL
    t = t + "    END IF" + NL
    t = t + "    WHILE frac.EndsWith(""0"")" + NL
    t = t + "        frac = frac.Substring(0, frac.Length - 1)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF frac = """" THEN RETURN sign + out" + NL
    t = t + "    RETURN sign + out + ""."" + frac" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "'' round(a * scale) as digits, exactly: Dekker's two-product gives the" + NL
    t = t + "' rounding error of a * scale, and the digits are put together in two halves" + NL
    t = t + "' so no part of them goes past what a Real holds exactly." + NL
    t = t + "FUNCTION JsScaled (a AS Real, scale AS Real, nudge AS Integer) AS String" + NL
    t = t + "    VAR prod AS Real" + NL
    t = t + "    VAR err AS Real" + NL
    t = t + "    VAR ah AS Real" + NL
    t = t + "    VAR al AS Real" + NL
    t = t + "    VAR bh AS Real" + NL
    t = t + "    VAR bl AS Real" + NL
    t = t + "    VAR c AS Real" + NL
    t = t + "    VAR high AS Real" + NL
    t = t + "    VAR low AS Real" + NL
    t = t + "    VAR ls AS String" + NL
    t = t + "    prod = a * scale" + NL
    t = t + "    c = 134217729.0 * a" + NL
    t = t + "    ah = c - (c - a)" + NL
    t = t + "    al = a - ah" + NL
    t = t + "    c = 134217729.0 * scale" + NL
    t = t + "    bh = c - (c - scale)" + NL
    t = t + "    bl = scale - bh" + NL
    t = t + "    err = ((ah * bh - prod) + ah * bl + al * bh) + al * bl" + NL
    t = t + "    high = MATH.Floor(prod / 100000000.0)" + NL
    t = t + "    low = prod - high * 100000000.0" + NL
    t = t + "    low = MATH.Floor(low + err + 0.5) + nudge" + NL
    t = t + "    WHILE low >= 100000000.0" + NL
    t = t + "        low = low - 100000000.0" + NL
    t = t + "        high = high + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    WHILE low < 0" + NL
    t = t + "        low = low + 100000000.0" + NL
    t = t + "        high = high - 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF high <= 0 THEN RETURN Str(Int(low))" + NL
    t = t + "    ls = Str(Int(low))" + NL
    t = t + "    WHILE ls.Length < 8" + NL
    t = t + "        ls = ""0"" + ls" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN Str(Int(high)) + ls" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Text to number the JavaScript way: """" is 0, ""12px"" is NaN." + NL
    t = t + "FUNCTION JsParseNumber (text AS String) AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR body AS String" + NL
    t = t + "    t = text.Trim()" + NL
    t = t + "    IF t = """" THEN RETURN ""0""" + NL
    t = t + "    IF t = ""Infinity"" OR t = ""+Infinity"" THEN RETURN ""Infinity""" + NL
    t = t + "    IF t = ""-Infinity"" THEN RETURN ""-Infinity""" + NL
    t = t + "    body = t" + NL
    t = t + "    IF body.StartsWith(""-"") OR body.StartsWith(""+"") THEN body = body.Substring(1, body.Length - 1)" + NL
    t = t + "    IF body.Lower().StartsWith(""0x"") AND body.Length > 2 THEN" + NL
    t = t + "        IF OnlyChars(body.Substring(2, body.Length - 2).Lower(), ""0123456789abcdef"") THEN" + NL
    t = t + "            IF t.StartsWith(""-"") THEN RETURN ""NaN""" + NL
    t = t + "            RETURN JsNumberText(body)" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN ""NaN""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF body = """" OR body = ""."" OR NOT OnlyChars(body.Lower(), ""0123456789.e+-"") THEN RETURN ""NaN""" + NL
    t = t + "    IF NOT ""0123456789."".Contains(body.CharAt(0)) THEN RETURN ""NaN""" + NL
    t = t + "    RETURN JsFmt(Val(t))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION OnlyChars (s AS String, allowed AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        IF NOT allowed.Contains(s.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsFinite (n AS String) AS Bool" + NL
    t = t + "    RETURN n <> ""NaN"" AND n <> ""Infinity"" AND n <> ""-Infinity""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Arithmetic on number texts, minding NaN, Infinity and division by zero." + NL
    t = t + "FUNCTION JsArith (op AS String, a AS String, b AS String) AS String" + NL
    t = t + "    VAR x AS Real" + NL
    t = t + "    VAR y AS Real" + NL
    t = t + "    IF a = ""NaN"" OR b = ""NaN"" THEN RETURN ""NaN""" + NL
    t = t + "    IF NOT JsFinite(a) OR NOT JsFinite(b) THEN" + NL
    t = t + "        IF op = ""+"" AND a = b THEN RETURN a" + NL
    t = t + "        IF op = ""+"" AND JsFinite(b) THEN RETURN a" + NL
    t = t + "        IF op = ""+"" AND JsFinite(a) THEN RETURN b" + NL
    t = t + "        IF op = ""-"" AND JsFinite(b) THEN RETURN a" + NL
    t = t + "        IF op = ""*"" AND JsFinite(b) AND Val(b) <> 0 THEN" + NL
    t = t + "            IF (Val(b) > 0) = (a = ""Infinity"") THEN RETURN ""Infinity""" + NL
    t = t + "            RETURN ""-Infinity""" + NL
    t = t + "        END IF" + NL
    t = t + "        IF op = ""/"" AND JsFinite(b) THEN RETURN a" + NL
    t = t + "        IF op = ""/"" AND JsFinite(a) THEN RETURN ""0""" + NL
    t = t + "        RETURN ""NaN""" + NL
    t = t + "    END IF" + NL
    t = t + "    x = Val(a)" + NL
    t = t + "    y = Val(b)" + NL
    t = t + "    SELECT CASE op" + NL
    t = t + "        CASE ""+""" + NL
    t = t + "            RETURN JsFmt(x + y)" + NL
    t = t + "        CASE ""-""" + NL
    t = t + "            RETURN JsFmt(x - y)" + NL
    t = t + "        CASE ""*""" + NL
    t = t + "            RETURN JsFmt(x * y)" + NL
    t = t + "        CASE ""/""" + NL
    t = t + "            IF y = 0 THEN" + NL
    t = t + "                IF x = 0 THEN RETURN ""NaN""" + NL
    t = t + "                IF x > 0 THEN RETURN ""Infinity""" + NL
    t = t + "                RETURN ""-Infinity""" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsFmt(x / y)" + NL
    t = t + "        CASE ""%""" + NL
    t = t + "            IF y = 0 THEN RETURN ""NaN""" + NL
    t = t + "            RETURN JsFmt(x - y * Int(x / y))" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""NaN""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- values" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNum (v AS String) AS String" + NL
    t = t + "    SELECT CASE v.Substring(0, 1)" + NL
    t = t + "        CASE ""n""" + NL
    t = t + "            RETURN v.Substring(1, v.Length - 1)" + NL
    t = t + "        CASE ""s""" + NL
    t = t + "            RETURN JsParseNumber(v.Substring(1, v.Length - 1))" + NL
    t = t + "        CASE ""t""" + NL
    t = t + "            RETURN ""1""" + NL
    t = t + "        CASE ""f"", ""l""" + NL
    t = t + "            RETURN ""0""" + NL
    t = t + "        CASE ""o""" + NL
    t = t + "            IF joClass[JsId(v)] = ""Date"" THEN RETURN joS[JsId(v)]" + NL
    t = t + "            RETURN JsParseNumber(JsStr(v))" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""NaN""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsReal (v AS String) AS Real" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    n = JsNum(v)" + NL
    t = t + "    IF NOT JsFinite(n) THEN RETURN 0" + NL
    t = t + "    RETURN Val(n)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsInt (v AS String) AS Integer" + NL
    t = t + "    RETURN Int(JsReal(v))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsStr (v AS String) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    SELECT CASE v.Substring(0, 1)" + NL
    t = t + "        CASE ""s"", ""n""" + NL
    t = t + "            RETURN v.Substring(1, v.Length - 1)" + NL
    t = t + "        CASE ""u""" + NL
    t = t + "            RETURN ""undefined""" + NL
    t = t + "        CASE ""l""" + NL
    t = t + "            RETURN ""null""" + NL
    t = t + "        CASE ""t""" + NL
    t = t + "            RETURN ""true""" + NL
    t = t + "        CASE ""f""" + NL
    t = t + "            RETURN ""false""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    id = Int(Val(v.Substring(1, v.Length - 1)))" + NL
    t = t + "    SELECT CASE joClass[id]" + NL
    t = t + "        CASE ""Array""" + NL
    t = t + "            RETURN JsJoin(id, "","")" + NL
    t = t + "        CASE ""Function""" + NL
    t = t + "            RETURN Chr(10) + ""function "" + ns[joA[id]] + ""("" + nl[joA[id]] + "") {"" + Chr(10) + ""    [native code]"" + Chr(10) + ""}"" + Chr(10)" + NL
    t = t + "        CASE ""Native""" + NL
    t = t + "            RETURN Chr(10) + ""function "" + joS[id] + ""() {"" + Chr(10) + ""    [native code]"" + Chr(10) + ""}"" + Chr(10)" + NL
    t = t + "        CASE ""Date""" + NL
    t = t + "            RETURN JsDateText(Val(joS[id]))" + NL
    t = t + "        CASE ""Error""" + NL
    t = t + "            RETURN JsStr(JsGetProp(id, ""message""))" + NL
    t = t + "        CASE ""Location""" + NL
    t = t + "            RETURN HostInfo(""location"")" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""[object Object]""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsBool (v AS String) AS Bool" + NL
    t = t + "    SELECT CASE v.Substring(0, 1)" + NL
    t = t + "        CASE ""t"", ""o""" + NL
    t = t + "            RETURN TRUE" + NL
    t = t + "        CASE ""n""" + NL
    t = t + "            RETURN v <> ""n0"" AND v <> ""nNaN"" AND v <> ""n-0""" + NL
    t = t + "        CASE ""s""" + NL
    t = t + "            RETURN v.Length > 1" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsB (b AS Bool) AS String" + NL
    t = t + "    IF b THEN RETURN ""t""" + NL
    t = t + "    RETURN ""f""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsN (r AS Real) AS String" + NL
    t = t + "    RETURN ""n"" + JsFmt(r)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsS (s AS String) AS String" + NL
    t = t + "    RETURN ""s"" + s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsO (id AS Integer) AS String" + NL
    t = t + "    RETURN ""o"" + Str(id)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsId (v AS String) AS Integer" + NL
    t = t + "    IF NOT v.StartsWith(""o"") THEN RETURN 0" + NL
    t = t + "    RETURN Int(Val(v.Substring(1, v.Length - 1)))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsTypeOf (v AS String) AS String" + NL
    t = t + "    SELECT CASE v.Substring(0, 1)" + NL
    t = t + "        CASE ""u""" + NL
    t = t + "            RETURN ""undefined""" + NL
    t = t + "        CASE ""l""" + NL
    t = t + "            RETURN ""object""" + NL
    t = t + "        CASE ""t"", ""f""" + NL
    t = t + "            RETURN ""boolean""" + NL
    t = t + "        CASE ""n""" + NL
    t = t + "            RETURN ""number""" + NL
    t = t + "        CASE ""s""" + NL
    t = t + "            RETURN ""string""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF joClass[JsId(v)] = ""Function"" OR joClass[JsId(v)] = ""Native"" THEN RETURN ""function""" + NL
    t = t + "    RETURN ""object""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsCallable (v AS String) AS Bool" + NL
    t = t + "    RETURN JsTypeOf(v) = ""function""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' == : same-type compare, null equals undefined, numbers and strings meet as numbers" + NL
    t = t + "FUNCTION JsLooseEq (a AS String, b AS String) AS Bool" + NL
    t = t + "    VAR ta AS String" + NL
    t = t + "    VAR tb AS String" + NL
    t = t + "    ta = a.Substring(0, 1)" + NL
    t = t + "    tb = b.Substring(0, 1)" + NL
    t = t + "    IF (ta = ""u"" OR ta = ""l"") AND (tb = ""u"" OR tb = ""l"") THEN RETURN TRUE" + NL
    t = t + "    IF ta = ""u"" OR ta = ""l"" OR tb = ""u"" OR tb = ""l"" THEN RETURN FALSE" + NL
    t = t + "    IF ta = tb THEN" + NL
    t = t + "        IF ta = ""n"" THEN RETURN JsNumEq(JsNum(a), JsNum(b))" + NL
    t = t + "        RETURN a = b" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ta = ""o"" THEN RETURN JsLooseEq(JsS(JsStr(a)), b)" + NL
    t = t + "    IF tb = ""o"" THEN RETURN JsLooseEq(a, JsS(JsStr(b)))" + NL
    t = t + "    RETURN JsNumEq(JsNum(a), JsNum(b))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNumEq (a AS String, b AS String) AS Bool" + NL
    t = t + "    IF a = ""NaN"" OR b = ""NaN"" THEN RETURN FALSE" + NL
    t = t + "    IF NOT JsFinite(a) OR NOT JsFinite(b) THEN RETURN a = b" + NL
    t = t + "    RETURN Val(a) = Val(b)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsStrictEq (a AS String, b AS String) AS Bool" + NL
    t = t + "    IF a.Substring(0, 1) <> b.Substring(0, 1) THEN RETURN FALSE" + NL
    t = t + "    IF a.StartsWith(""n"") THEN RETURN JsNumEq(JsNum(a), JsNum(b))" + NL
    t = t + "    RETURN a = b" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' < > <= >= : strings compare as strings, anything else as numbers" + NL
    t = t + "FUNCTION JsCompare (op AS String, a AS String, b AS String) AS String" + NL
    t = t + "    VAR x AS String" + NL
    t = t + "    VAR y AS String" + NL
    t = t + "    VAR less AS Bool" + NL
    t = t + "    VAR same AS Bool" + NL
    t = t + "    IF a.StartsWith(""o"") THEN a = JsS(JsStr(a))" + NL
    t = t + "    IF b.StartsWith(""o"") THEN b = JsS(JsStr(b))" + NL
    t = t + "    IF a.StartsWith(""s"") AND b.StartsWith(""s"") THEN" + NL
    t = t + "        x = a.Substring(1, a.Length - 1)" + NL
    t = t + "        y = b.Substring(1, b.Length - 1)" + NL
    t = t + "        less = x < y" + NL
    t = t + "        same = x = y" + NL
    t = t + "    ELSE" + NL
    t = t + "        x = JsNum(a)" + NL
    t = t + "        y = JsNum(b)" + NL
    t = t + "        IF x = ""NaN"" OR y = ""NaN"" THEN RETURN ""f""" + NL
    t = t + "        IF NOT JsFinite(x) OR NOT JsFinite(y) THEN" + NL
    t = t + "            same = x = y" + NL
    t = t + "            less = (x = ""-Infinity"" AND y <> ""-Infinity"") OR (y = ""Infinity"" AND x <> ""Infinity"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            less = Val(x) < Val(y)" + NL
    t = t + "            same = Val(x) = Val(y)" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE op" + NL
    t = t + "        CASE ""<""" + NL
    t = t + "            RETURN JsB(less)" + NL
    t = t + "        CASE "">""" + NL
    t = t + "            RETURN JsB(NOT less AND NOT same)" + NL
    t = t + "        CASE ""<=""" + NL
    t = t + "            RETURN JsB(less OR same)" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN JsB(NOT less)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsAdd (a AS String, b AS String) AS String" + NL
    t = t + "    IF a.StartsWith(""o"") THEN a = JsS(JsStr(a))" + NL
    t = t + "    IF b.StartsWith(""o"") THEN b = JsS(JsStr(b))" + NL
    t = t + "    IF a.StartsWith(""s"") OR b.StartsWith(""s"") THEN RETURN JsS(JsStr(a) + JsStr(b))" + NL
    t = t + "    RETURN ""n"" + JsArith(""+"", JsNum(a), JsNum(b))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsBinOp (op AS String, a AS String, b AS String) AS String" + NL
    t = t + "    SELECT CASE op" + NL
    t = t + "        CASE ""+""" + NL
    t = t + "            RETURN JsAdd(a, b)" + NL
    t = t + "        CASE ""-"", ""*"", ""/"", ""%""" + NL
    t = t + "            RETURN ""n"" + JsArith(op, JsNum(a), JsNum(b))" + NL
    t = t + "        CASE ""==""" + NL
    t = t + "            RETURN JsB(JsLooseEq(a, b))" + NL
    t = t + "        CASE ""!=""" + NL
    t = t + "            RETURN JsB(NOT JsLooseEq(a, b))" + NL
    t = t + "        CASE ""===""" + NL
    t = t + "            RETURN JsB(JsStrictEq(a, b))" + NL
    t = t + "        CASE ""!==""" + NL
    t = t + "            RETURN JsB(NOT JsStrictEq(a, b))" + NL
    t = t + "        CASE ""<"", "">"", ""<="", "">=""" + NL
    t = t + "            RETURN JsCompare(op, a, b)" + NL
    t = t + "        CASE ""in""" + NL
    t = t + "            IF NOT b.StartsWith(""o"") THEN THROW Str(jsLine) + ""|Object expected""" + NL
    t = t + "            RETURN JsB(JsGet(b, JsKey(a)) <> ""u"" OR JsOwn(JsId(b), JsKey(a)) >= 0)" + NL
    t = t + "        CASE ""instanceof""" + NL
    t = t + "            IF NOT JsCallable(b) THEN THROW Str(jsLine) + ""|Function expected""" + NL
    t = t + "            RETURN JsB(JsInstanceOf(a, JsGet(b, ""prototype"")))" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(jsLine) + ""|Syntax error""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsInstanceOf (v AS String, proto AS String) AS Bool" + NL
    t = t + "    VAR o AS Integer" + NL
    t = t + "    IF NOT v.StartsWith(""o"") OR NOT proto.StartsWith(""o"") THEN RETURN FALSE" + NL
    t = t + "    o = joProto[JsId(v)]" + NL
    t = t + "    WHILE o <> 0" + NL
    t = t + "        IF o = JsId(proto) THEN RETURN TRUE" + NL
    t = t + "        o = joProto[o]" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- objects" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNewObject (class AS String, proto AS Integer) AS Integer" + NL
    t = t + "    joClass.Add(class)" + NL
    t = t + "    joProto.Add(proto)" + NL
    t = t + "    joA.Add(0)" + NL
    t = t + "    joB.Add(0)" + NL
    t = t + "    joS.Add("""")" + NL
    t = t + "    joKeys.Add(""|"")" + NL
    t = t + "    RETURN joClass.Count - 1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsOwn (id AS Integer, name AS String) AS Integer" + NL
    t = t + "    RETURN jpKey.IndexOf(Str(id) + "":"" + name)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Sets a property on the object itself (no host magic)." + NL
    t = t + "SUB JsPutOwn (id AS Integer, name AS String, v AS String)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    k = JsOwn(id, name)" + NL
    t = t + "    IF k >= 0 THEN" + NL
    t = t + "        jpVal[k] = v" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    jpKey.Add(Str(id) + "":"" + name)" + NL
    t = t + "    jpVal.Add(v)" + NL
    t = t + "    IF NOT name.StartsWith(""@"") THEN joKeys[id] = joKeys[id] + name + ""|""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsGetProp (id AS Integer, name AS String) AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR o AS Integer" + NL
    t = t + "    o = id" + NL
    t = t + "    WHILE o <> 0" + NL
    t = t + "        k = JsOwn(o, name)" + NL
    t = t + "        IF k >= 0 THEN RETURN jpVal[k]" + NL
    t = t + "        o = joProto[o]" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN ""u""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsIsIndex (name AS String) AS Bool" + NL
    t = t + "    RETURN name <> """" AND name.Length < 10 AND OnlyChars(name, ""0123456789"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' v.name, for any value" + NL
    t = t + "FUNCTION JsGet (v AS String, name AS String) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    SELECT CASE v.Substring(0, 1)" + NL
    t = t + "        CASE ""u"", ""l""" + NL
    t = t + "            THROW Str(jsLine) + ""|'"" + name + ""' is null or not an object""" + NL
    t = t + "        CASE ""s""" + NL
    t = t + "            text = v.Substring(1, v.Length - 1)" + NL
    t = t + "            IF name = ""length"" THEN RETURN JsN(text.Length)" + NL
    t = t + "            IF JsIsIndex(name) THEN" + NL
    t = t + "                IF Int(Val(name)) < text.Length THEN RETURN JsS(text.CharAt(Int(Val(name))))" + NL
    t = t + "                RETURN ""u""" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsGetProp(jsStringProto, name)" + NL
    t = t + "        CASE ""n""" + NL
    t = t + "            RETURN JsGetProp(jsNumberProto, name)" + NL
    t = t + "        CASE ""t"", ""f""" + NL
    t = t + "            RETURN JsGetProp(jsObjectProto, name)" + NL
    t = t + "    END SELECT" + NL
    t = t + "    id = JsId(v)" + NL
    t = t + "    SELECT CASE joClass[id]" + NL
    t = t + "        CASE ""Host""" + NL
    t = t + "            RETURN JsHostGet(id, name)" + NL
    t = t + "        CASE ""Style""" + NL
    t = t + "            RETURN JsStyleGet(id, name)" + NL
    t = t + "        CASE ""Location""" + NL
    t = t + "            RETURN JsLocationGet(name)" + NL
    t = t + "        CASE ""All""" + NL
    t = t + "            ' IE's document.all: every element with an id" + NL
    t = t + "            IF name = ""item"" THEN RETURN JsNative(""All.item"")" + NL
    t = t + "            IF name <> """" AND JsOwn(id, name) < 0 THEN" + NL
    t = t + "                IF HostHas(name) THEN RETURN JsElement(name)" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Document""" + NL
    t = t + "            IF ""|title|cookie|URL|lastModified|referrer|domain|"".Contains(""|"" + name + ""|"") THEN RETURN JsDocumentGet(name)" + NL
    t = t + "        CASE ""Global""" + NL
    t = t + "            IF name = ""status"" OR name = ""defaultStatus"" THEN RETURN JsS(HostInfo(""status""))" + NL
    t = t + "            IF name = ""location"" THEN RETURN JsO(jsLocation)" + NL
    t = t + "        CASE ""Native""" + NL
    t = t + "            IF name = ""name"" AND JsOwn(id, ""name"") < 0 THEN" + NL
    t = t + "                IF joS[id].Contains(""."") THEN RETURN JsS(joS[id].Substring(joS[id].IndexOf(""."") + 1, joS[id].Length - joS[id].IndexOf(""."") - 1))" + NL
    t = t + "                RETURN JsS(joS[id])" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Function""" + NL
    t = t + "            IF name = ""name"" AND JsOwn(id, ""name"") < 0 THEN" + NL
    t = t + "                IF JsOwn(id, ""@name"") >= 0 THEN RETURN JsGetProp(id, ""@name"")" + NL
    t = t + "                RETURN JsS(ns[joA[id]])" + NL
    t = t + "            END IF" + NL
    t = t + "            IF name = ""prototype"" AND JsOwn(id, ""prototype"") < 0 THEN JsPutOwn(id, ""prototype"", JsO(JsNewProtoFor(id)))" + NL
    t = t + "            IF name = ""length"" THEN" + NL
    t = t + "                IF nl[joA[id]] = """" THEN RETURN ""n0""" + NL
    t = t + "                RETURN JsN(nl[joA[id]].Split("","").Count)" + NL
    t = t + "            END IF" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN JsGetProp(id, name)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNewProtoFor (fn AS Integer) AS Integer" + NL
    t = t + "    VAR p AS Integer" + NL
    t = t + "    p = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsPutOwn(p, ""constructor"", JsO(fn))" + NL
    t = t + "    RETURN p" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' v.name = value" + NL
    t = t + "SUB JsPut (v AS String, name AS String, value AS String)" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    IF v.StartsWith(""u"") OR v.StartsWith(""l"") THEN THROW Str(jsLine) + ""|'"" + name + ""' is null or not an object""" + NL
    t = t + "    IF NOT v.StartsWith(""o"") THEN RETURN" + NL
    t = t + "    id = JsId(v)" + NL
    t = t + "    SELECT CASE joClass[id]" + NL
    t = t + "        CASE ""Host""" + NL
    t = t + "            JsHostSet(id, name, value)" + NL
    t = t + "            RETURN" + NL
    t = t + "        CASE ""Style""" + NL
    t = t + "            JsStyleSet(id, name, value)" + NL
    t = t + "            RETURN" + NL
    t = t + "        CASE ""Location""" + NL
    t = t + "            IF name = ""href"" THEN HostNavigate(JsStr(value))" + NL
    t = t + "            RETURN" + NL
    t = t + "        CASE ""Document""" + NL
    t = t + "            IF name = ""title"" OR name = ""cookie"" THEN" + NL
    t = t + "                HostSetInfo(name, JsStr(value))" + NL
    t = t + "                RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "            IF name = ""location"" OR name = ""URL"" THEN" + NL
    t = t + "                HostNavigate(JsStr(value))" + NL
    t = t + "                RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Global""" + NL
    t = t + "            IF name = ""status"" OR name = ""defaultStatus"" THEN" + NL
    t = t + "                HostStatus(JsStr(value))" + NL
    t = t + "                RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "            IF name = ""location"" THEN" + NL
    t = t + "                HostNavigate(JsStr(value))" + NL
    t = t + "                RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Array""" + NL
    t = t + "            IF name = ""length"" THEN" + NL
    t = t + "                JsSetLength(id, JsInt(value))" + NL
    t = t + "                RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "            IF JsIsIndex(name) THEN" + NL
    t = t + "                IF Int(Val(name)) >= JsInt(JsGetProp(id, ""length"")) THEN JsPutOwn(id, ""length"", JsN(Int(Val(name)) + 1))" + NL
    t = t + "            END IF" + NL
    t = t + "    END SELECT" + NL
    t = t + "    JsPutOwn(id, name, value)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB JsSetLength (id AS Integer, n AS Integer)" + NL
    t = t + "    VAR old AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    old = JsInt(JsGetProp(id, ""length""))" + NL
    t = t + "    FOR i = n TO old - 1" + NL
    t = t + "        k = JsOwn(id, Str(i))" + NL
    t = t + "        IF k >= 0 THEN jpVal[k] = ""u""" + NL
    t = t + "    NEXT" + NL
    t = t + "    JsPutOwn(id, ""length"", JsN(n))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsKey (v AS String) AS String" + NL
    t = t + "    IF v.StartsWith(""n"") AND JsFinite(JsNum(v)) THEN" + NL
    t = t + "        IF JsReal(v) = Int(JsReal(v)) THEN RETURN Str(Int(JsReal(v)))" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN JsStr(v)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNewArray (items AS Array OF String) AS Integer" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    id = JsNewObject(""Array"", jsArrayProto)" + NL
    t = t + "    FOR i = 0 TO items.Count - 1" + NL
    t = t + "        JsPutOwn(id, Str(i), items[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    JsPutOwn(id, ""length"", JsN(items.Count))" + NL
    t = t + "    RETURN id" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsItems (id AS Integer) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    n = JsInt(JsGetProp(id, ""length""))" + NL
    t = t + "    FOR i = 0 TO n - 1" + NL
    t = t + "        out.Add(JsGetProp(id, Str(i)))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsJoin (id AS Integer, sep AS String) AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    FOR EACH v IN JsItems(id)" + NL
    t = t + "        IF v = ""u"" OR v = ""l"" THEN" + NL
    t = t + "            parts.Add("""")" + NL
    t = t + "        ELSE" + NL
    t = t + "            parts.Add(JsStr(v))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN parts.Join(sep)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNative (name AS String) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    id = JsNewObject(""Native"", jsFunctionProto)" + NL
    t = t + "    joS[id] = name" + NL
    t = t + "    RETURN JsO(id)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JsMethods (owner AS Integer, prefix AS String, names AS String)" + NL
    t = t + "    VAR m AS String" + NL
    t = t + "    FOR EACH m IN names.Split("","")" + NL
    t = t + "        JsPutOwn(owner, m, JsNative(prefix + m))" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the page's objects" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsElement (elementId AS String) AS String" + NL
    t = t + "    VAR entry AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR style AS Integer" + NL
    t = t + "    FOR EACH entry IN jsHostCache" + NL
    t = t + "        IF entry.StartsWith(elementId + ""|"") THEN RETURN ""o"" + entry.Substring(elementId.Length + 1, entry.Length - elementId.Length - 1)" + NL
    t = t + "    NEXT" + NL
    t = t + "    id = JsNewObject(""Host"", jsObjectProto)" + NL
    t = t + "    joS[id] = elementId" + NL
    t = t + "    style = JsNewObject(""Style"", jsObjectProto)" + NL
    t = t + "    joS[style] = elementId" + NL
    t = t + "    joA[id] = style" + NL
    t = t + "    jsHostCache.Add(elementId + ""|"" + Str(id))" + NL
    t = t + "    RETURN JsO(id)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsHostGet (id AS Integer, name AS String) AS String" + NL
    t = t + "    VAR el AS String" + NL
    t = t + "    el = joS[id]" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""value""" + NL
    t = t + "            RETURN JsS(HostGet(el, ""Value""))" + NL
    t = t + "        CASE ""innerText"", ""innerHTML"", ""text"", ""textContent""" + NL
    t = t + "            RETURN JsS(HostGet(el, ""Text""))" + NL
    t = t + "        CASE ""checked""" + NL
    t = t + "            RETURN JsB(HostGet(el, ""Checked"") = ""True"")" + NL
    t = t + "        CASE ""disabled""" + NL
    t = t + "            RETURN JsB(HostGet(el, ""Enabled"") <> ""True"")" + NL
    t = t + "        CASE ""id""" + NL
    t = t + "            RETURN JsS(HostGet(el, ""Id""))" + NL
    t = t + "        CASE ""name""" + NL
    t = t + "            IF JsOwn(id, ""name"") >= 0 THEN RETURN JsGetProp(id, ""name"")" + NL
    t = t + "            RETURN JsS(HostGet(el, ""Id""))" + NL
    t = t + "        CASE ""tagName"", ""nodeName""" + NL
    t = t + "            RETURN JsS(HostGet(el, ""TagName""))" + NL
    t = t + "        CASE ""style""" + NL
    t = t + "            RETURN JsO(joA[id])" + NL
    t = t + "        CASE ""focus"", ""blur"", ""select"", ""click""" + NL
    t = t + "            RETURN JsNative(""Element."" + name)" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN JsGetProp(id, name)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JsHostSet (id AS Integer, name AS String, value AS String)" + NL
    t = t + "    VAR el AS String" + NL
    t = t + "    el = joS[id]" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""value""" + NL
    t = t + "            HostSet(el, ""Value"", JsStr(value))" + NL
    t = t + "        CASE ""innerText"", ""innerHTML"", ""text"", ""textContent""" + NL
    t = t + "            HostSet(el, ""Text"", JsStr(value))" + NL
    t = t + "        CASE ""checked""" + NL
    t = t + "            HostSet(el, ""Checked"", Str(JsBool(value)))" + NL
    t = t + "        CASE ""disabled""" + NL
    t = t + "            HostSet(el, ""Enabled"", Str(NOT JsBool(value)))" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            JsPutOwn(id, name, value)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsStyleGet (id AS Integer, name AS String) AS String" + NL
    t = t + "    IF name = ""display"" THEN" + NL
    t = t + "        IF HostGet(joS[id], ""Visible"") = ""True"" THEN RETURN JsS("""")" + NL
    t = t + "        RETURN JsS(""none"")" + NL
    t = t + "    END IF" + NL
    t = t + "    IF name = ""visibility"" THEN" + NL
    t = t + "        IF HostGet(joS[id], ""Visible"") = ""True"" THEN RETURN JsS(""visible"")" + NL
    t = t + "        RETURN JsS(""hidden"")" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN JsGetProp(id, name)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JsStyleSet (id AS Integer, name AS String, value AS String)" + NL
    t = t + "    IF name = ""display"" THEN" + NL
    t = t + "        HostSet(joS[id], ""Visible"", Str(JsStr(value) <> ""none""))" + NL
    t = t + "    ELSEIF name = ""visibility"" THEN" + NL
    t = t + "        HostSet(joS[id], ""Visible"", Str(JsStr(value) <> ""hidden""))" + NL
    t = t + "    ELSE" + NL
    t = t + "        JsPutOwn(id, name, value)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsLocationGet (name AS String) AS String" + NL
    t = t + "    VAR url AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    url = HostInfo(""location"")" + NL
    t = t + "    rest = url" + NL
    t = t + "    IF rest.StartsWith(""http://"") THEN rest = rest.Substring(7, rest.Length - 7)" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""href""" + NL
    t = t + "            RETURN JsS(url)" + NL
    t = t + "        CASE ""protocol""" + NL
    t = t + "            RETURN JsS(url.Substring(0, url.IndexOf("":"") + 1))" + NL
    t = t + "        CASE ""host"", ""hostname""" + NL
    t = t + "            IF rest.Contains(""/"") THEN rest = rest.Substring(0, rest.IndexOf(""/""))" + NL
    t = t + "            RETURN JsS(rest)" + NL
    t = t + "        CASE ""pathname""" + NL
    t = t + "            IF NOT rest.Contains(""/"") THEN RETURN JsS(""/"")" + NL
    t = t + "            rest = rest.Substring(rest.IndexOf(""/""), rest.Length - rest.IndexOf(""/""))" + NL
    t = t + "            IF rest.Contains(""?"") THEN rest = rest.Substring(0, rest.IndexOf(""?""))" + NL
    t = t + "            RETURN JsS(rest)" + NL
    t = t + "        CASE ""search""" + NL
    t = t + "            IF NOT url.Contains(""?"") THEN RETURN JsS("""")" + NL
    t = t + "            rest = url.Substring(url.IndexOf(""?""), url.Length - url.IndexOf(""?""))" + NL
    t = t + "            IF rest.Contains(""#"") THEN rest = rest.Substring(0, rest.IndexOf(""#""))" + NL
    t = t + "            RETURN JsS(rest)" + NL
    t = t + "        CASE ""hash""" + NL
    t = t + "            IF NOT url.Contains(""#"") THEN RETURN JsS("""")" + NL
    t = t + "            RETURN JsS(url.Substring(url.IndexOf(""#""), url.Length - url.IndexOf(""#"")))" + NL
    t = t + "        CASE ""reload"", ""replace"", ""assign"", ""toString""" + NL
    t = t + "            RETURN JsNative(""location."" + name)" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""u""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsDocumentGet (name AS String) AS String" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""URL""" + NL
    t = t + "            RETURN JsS(HostInfo(""location""))" + NL
    t = t + "        CASE ""lastModified""" + NL
    t = t + "            RETURN JsS(TIME.Date + "" "" + TIME.Clock)" + NL
    t = t + "        CASE ""domain""" + NL
    t = t + "            RETURN JsLocationGet(""host"")" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN JsS(HostInfo(name))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A form on the page: document.forms[i], and document.<its name> if it has one." + NL
    t = t + "FUNCTION JsAddForm (name AS String, index AS Integer) AS Integer" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    id = JsNewObject(""Form"", jsObjectProto)" + NL
    t = t + "    joA[id] = index" + NL
    t = t + "    JsPutOwn(id, ""name"", JsS(name))" + NL
    t = t + "    JsPutOwn(id, ""elements"", JsO(JsNewArray(none)))" + NL
    t = t + "    JsPutOwn(id, ""submit"", JsNative(""Form.submit""))" + NL
    t = t + "    JsPutOwn(id, ""reset"", JsNative(""Element.focus""))" + NL
    t = t + "    JsPut(JsO(jsFormsArray), Str(index), JsO(id))" + NL
    t = t + "    IF name <> """" THEN JsPutOwn(jsDocument, name, JsO(id))" + NL
    t = t + "    RETURN id" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A field of a form: form.<name>, and form.elements[i]." + NL
    t = t + "SUB JsAddField (form AS Integer, name AS String, elementId AS String)" + NL
    t = t + "    VAR el AS String" + NL
    t = t + "    VAR list AS Integer" + NL
    t = t + "    el = JsElement(elementId)" + NL
    t = t + "    JsPutOwn(JsId(el), ""name"", JsS(name))" + NL
    t = t + "    JsPutOwn(JsId(el), ""form"", JsO(form))" + NL
    t = t + "    ' fields hide the form's own properties (a field called ""name"" wins), but" + NL
    t = t + "    ' the first of several fields with one name keeps it" + NL
    t = t + "    IF name <> """" THEN" + NL
    t = t + "        IF JsOwn(form, name) < 0 THEN" + NL
    t = t + "            JsPutOwn(form, name, el)" + NL
    t = t + "        ELSEIF NOT jpVal[JsOwn(form, name)].StartsWith(""o"") OR joClass[JsId(jpVal[JsOwn(form, name)])] <> ""Host"" THEN" + NL
    t = t + "            JsPutOwn(form, name, el)" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    list = JsId(JsGetProp(form, ""elements""))" + NL
    t = t + "    JsPut(JsO(list), Str(JsInt(JsGetProp(list, ""length""))), el)" + NL
    t = t + "    JsPutOwn(form, ""length"", JsGetProp(list, ""length""))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- scopes" + NL
    t = t + "" + NL
    t = t + "' A scope is an object too: its variables are its properties, joA its parent" + NL
    t = t + "' and ""@this"" what this means inside it. The global scope is window itself." + NL
    t = t + "FUNCTION JsNewScope (parent AS Integer, thisVal AS String) AS Integer" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    id = JsNewObject(""Scope"", 0)" + NL
    t = t + "    joA[id] = parent" + NL
    t = t + "    JsPutOwn(id, ""@this"", thisVal)" + NL
    t = t + "    RETURN id" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsFindScope (name AS String, scope AS Integer) AS Integer" + NL
    t = t + "    VAR s AS Integer" + NL
    t = t + "    s = scope" + NL
    t = t + "    WHILE s <> 0" + NL
    t = t + "        IF JsOwn(s, name) >= 0 THEN RETURN s" + NL
    t = t + "        s = joA[s]" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsLookup (name AS String, scope AS Integer) AS String" + NL
    t = t + "    VAR s AS Integer" + NL
    t = t + "    IF name = ""undefined"" THEN RETURN ""u""" + NL
    t = t + "    IF name = ""status"" OR name = ""location"" OR name = ""defaultStatus"" THEN" + NL
    t = t + "        IF JsFindScope(name, scope) = 0 OR JsFindScope(name, scope) = jsGlobal THEN RETURN JsGet(JsO(jsGlobal), name)" + NL
    t = t + "    END IF" + NL
    t = t + "    s = JsFindScope(name, scope)" + NL
    t = t + "    IF s = 0 THEN THROW Str(jsLine) + ""|'"" + name + ""' is undefined""" + NL
    t = t + "    RETURN jpVal[JsOwn(s, name)]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JsSetVar (name AS String, v AS String, scope AS Integer)" + NL
    t = t + "    VAR s AS Integer" + NL
    t = t + "    s = JsFindScope(name, scope)" + NL
    t = t + "    IF s = 0 OR s = jsGlobal THEN" + NL
    t = t + "        JsPut(JsO(jsGlobal), name, v)" + NL
    t = t + "    ELSE" + NL
    t = t + "        jpVal[JsOwn(s, name)] = v" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsThisOf (scope AS Integer) AS String" + NL
    t = t + "    VAR s AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    s = scope" + NL
    t = t + "    WHILE s <> 0" + NL
    t = t + "        k = JsOwn(s, ""@this"")" + NL
    t = t + "        IF k >= 0 THEN RETURN jpVal[k]" + NL
    t = t + "        s = joA[s]" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN JsO(jsGlobal)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Functions and vars are known before a body runs (JavaScript ""hoisting"")." + NL
    t = t + "SUB JsHoist (n AS Integer, scope AS Integer)" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR d AS String" + NL
    t = t + "    IF n = 0 THEN RETURN" + NL
    t = t + "    SELECT CASE nk[n]" + NL
    t = t + "        CASE ""block""" + NL
    t = t + "            FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "                IF item = """" THEN CONTINUE" + NL
    t = t + "                ' the program's own lets, consts and classes are kept like vars" + NL
    t = t + "                IF nd[n] = 2 AND (nk[Int(Val(item))] = ""let"" OR nk[Int(Val(item))] = ""classdecl"") THEN" + NL
    t = t + "                    FOR EACH d IN JsDeclNames(Int(Val(item)))" + NL
    t = t + "                        IF JsOwn(scope, d) < 0 THEN JsPutOwn(scope, d, ""u"")" + NL
    t = t + "                    NEXT" + NL
    t = t + "                END IF" + NL
    t = t + "                JsHoist(Int(Val(item)), scope)" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""func""" + NL
    t = t + "            JsPutOwn(scope, ns[n], JsMakeFunction(n, scope))" + NL
    t = t + "        CASE ""var""" + NL
    t = t + "            FOR EACH d IN JsDeclNames(n)" + NL
    t = t + "                IF JsOwn(scope, d) < 0 THEN JsPutOwn(scope, d, ""u"")" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""if""" + NL
    t = t + "            JsHoist(nb[n], scope)" + NL
    t = t + "            JsHoist(nc[n], scope)" + NL
    t = t + "        CASE ""while"", ""do""" + NL
    t = t + "            JsHoist(nb[n], scope)" + NL
    t = t + "        CASE ""for""" + NL
    t = t + "            JsHoist(na[n], scope)" + NL
    t = t + "            JsHoist(nd[n], scope)" + NL
    t = t + "        CASE ""forin"", ""forof""" + NL
    t = t + "            IF nc[n] = 0 THEN" + NL
    t = t + "                IF nb[n] <> 0 THEN" + NL
    t = t + "                    FOR EACH d IN JsPatternNames(nb[n])" + NL
    t = t + "                        IF JsOwn(scope, d) < 0 AND scope <> jsGlobal THEN JsPutOwn(scope, d, ""u"")" + NL
    t = t + "                    NEXT" + NL
    t = t + "                ELSEIF JsOwn(scope, ns[n]) < 0 AND scope <> jsGlobal THEN" + NL
    t = t + "                    JsPutOwn(scope, ns[n], ""u"")" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "            JsHoist(nd[n], scope)" + NL
    t = t + "        CASE ""try""" + NL
    t = t + "            JsHoist(na[n], scope)" + NL
    t = t + "            JsHoist(nb[n], scope)" + NL
    t = t + "            JsHoist(nc[n], scope)" + NL
    t = t + "        CASE ""switch""" + NL
    t = t + "            FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "                FOR EACH d IN nl[Int(Val(item))].Split("","")" + NL
    t = t + "                    IF d <> """" THEN JsHoist(Int(Val(d)), scope)" + NL
    t = t + "                NEXT" + NL
    t = t + "            NEXT" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A function value: the code (node) and the scope it was made in. That scope" + NL
    t = t + "' may now outlive the call that made it, so it is marked kept (joB = 1)." + NL
    t = t + "FUNCTION JsMakeFunction (n AS Integer, scope AS Integer) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR s AS Integer" + NL
    t = t + "    id = JsNewObject(""Function"", jsFunctionProto)" + NL
    t = t + "    joA[id] = n" + NL
    t = t + "    joB[id] = scope" + NL
    t = t + "    s = scope" + NL
    t = t + "    WHILE s <> 0 AND s <> jsGlobal" + NL
    t = t + "        joB[s] = 1" + NL
    t = t + "        s = joA[s]" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN JsO(id)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A finished call's scope, if nothing kept it: its properties go, so the" + NL
    t = t + "' property table does not grow with every call." + NL
    t = t + "SUB JsFreeScope (scope AS Integer)" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF joB[scope] = 1 THEN RETURN" + NL
    t = t + "    FOR EACH name IN (joKeys[scope] + ""@this|"").Split(""|"")" + NL
    t = t + "        IF name = """" THEN CONTINUE" + NL
    t = t + "        k = JsOwn(scope, name)" + NL
    t = t + "        IF k >= 0 THEN" + NL
    t = t + "            jpKey.RemoveAt(k)" + NL
    t = t + "            jpVal.RemoveAt(k)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    joKeys[scope] = ""|""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- running statements" + NL
    t = t + "" + NL
    t = t + "SUB JsTick ()" + NL
    t = t + "    jsSteps = jsSteps + 1" + NL
    t = t + "    IF jsSteps MOD 2000 = 0 THEN HostYield()" + NL
    t = t + "    IF jsSteps > jsLimit THEN" + NL
    t = t + "        IF HostSlow() THEN THROW Str(jsLine) + ""|@aborted""" + NL
    t = t + "        jsLimit = jsLimit * 2" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB JsExec (n AS Integer, scope AS Integer)" + NL
    t = t + "    VAR bs AS Integer" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    VAR keys AS Array OF String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR depth AS Integer" + NL
    t = t + "    VAR caught AS String" + NL
    t = t + "    VAR pending AS String" + NL
    t = t + "    VAR sig AS String" + NL
    t = t + "    VAR ret AS String" + NL
    t = t + "    VAR cases AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR start AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    IF n = 0 THEN RETURN" + NL
    t = t + "    jsLine = nline[n]" + NL
    t = t + "    jsNodeAt = n" + NL
    t = t + "    JsTick()" + NL
    t = t + "    SELECT CASE nk[n]" + NL
    t = t + "        CASE ""block""" + NL
    t = t + "            IF nd[n] = 1 THEN" + NL
    t = t + "                bs = JsBlockScope(n, scope)" + NL
    t = t + "                FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "                    IF item = """" THEN CONTINUE" + NL
    t = t + "                    JsExec(Int(Val(item)), bs)" + NL
    t = t + "                    IF jsSig <> """" THEN BREAK" + NL
    t = t + "                NEXT" + NL
    t = t + "                JsFreeScope(bs)" + NL
    t = t + "                RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "            FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "                IF item = """" THEN CONTINUE" + NL
    t = t + "                JsExec(Int(Val(item)), scope)" + NL
    t = t + "                IF jsSig <> """" THEN RETURN" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""var"", ""let""" + NL
    t = t + "            FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "                d = Int(Val(item))" + NL
    t = t + "                IF nb[d] <> 0 THEN" + NL
    t = t + "                    v = ""u""" + NL
    t = t + "                    IF na[d] <> 0 THEN v = JsEval(na[d], scope)" + NL
    t = t + "                    JsBind(nb[d], v, scope)" + NL
    t = t + "                ELSEIF na[d] <> 0 THEN" + NL
    t = t + "                    JsSetVar(ns[d], JsEval(na[d], scope), scope)" + NL
    t = t + "                ELSEIF nk[n] = ""let"" THEN" + NL
    t = t + "                    JsSetVar(ns[d], ""u"", scope)" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""classdecl""" + NL
    t = t + "            JsSetVar(ns[n], JsMakeClass(n, scope), scope)" + NL
    t = t + "        CASE ""exprst""" + NL
    t = t + "            jsRet = JsEval(na[n], scope)" + NL
    t = t + "        CASE ""if""" + NL
    t = t + "            IF JsBool(JsEval(na[n], scope)) THEN" + NL
    t = t + "                JsExec(nb[n], scope)" + NL
    t = t + "            ELSE" + NL
    t = t + "                JsExec(nc[n], scope)" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""while""" + NL
    t = t + "            WHILE JsBool(JsEval(na[n], scope))" + NL
    t = t + "                JsExec(nb[n], scope)" + NL
    t = t + "                IF jsSig = ""b"" THEN" + NL
    t = t + "                    jsSig = """"" + NL
    t = t + "                    BREAK" + NL
    t = t + "                END IF" + NL
    t = t + "                IF jsSig = ""c"" THEN jsSig = """"" + NL
    t = t + "                IF jsSig = ""r"" THEN RETURN" + NL
    t = t + "                JsTick()" + NL
    t = t + "            END WHILE" + NL
    t = t + "        CASE ""do""" + NL
    t = t + "            WHILE TRUE" + NL
    t = t + "                JsExec(nb[n], scope)" + NL
    t = t + "                IF jsSig = ""b"" THEN" + NL
    t = t + "                    jsSig = """"" + NL
    t = t + "                    BREAK" + NL
    t = t + "                END IF" + NL
    t = t + "                IF jsSig = ""c"" THEN jsSig = """"" + NL
    t = t + "                IF jsSig = ""r"" THEN RETURN" + NL
    t = t + "                IF NOT JsBool(JsEval(na[n], scope)) THEN BREAK" + NL
    t = t + "                JsTick()" + NL
    t = t + "            END WHILE" + NL
    t = t + "        CASE ""for""" + NL
    t = t + "            ' for (let i...): each time round has an i of its own, for closures" + NL
    t = t + "            bs = scope" + NL
    t = t + "            IF na[n] <> 0 THEN" + NL
    t = t + "                IF nk[na[n]] = ""let"" THEN bs = JsBlockScope(n, scope)" + NL
    t = t + "            END IF" + NL
    t = t + "            JsExec(na[n], bs)" + NL
    t = t + "            WHILE TRUE" + NL
    t = t + "                IF nb[n] <> 0 THEN" + NL
    t = t + "                    IF NOT JsBool(JsEval(nb[n], bs)) THEN BREAK" + NL
    t = t + "                END IF" + NL
    t = t + "                JsExec(nd[n], bs)" + NL
    t = t + "                IF jsSig = ""b"" THEN" + NL
    t = t + "                    jsSig = """"" + NL
    t = t + "                    BREAK" + NL
    t = t + "                END IF" + NL
    t = t + "                IF jsSig = ""c"" THEN jsSig = """"" + NL
    t = t + "                IF jsSig = ""r"" THEN RETURN" + NL
    t = t + "                IF bs <> scope THEN bs = JsCopyScope(bs)" + NL
    t = t + "                IF nc[n] <> 0 THEN v = JsEval(nc[n], bs)" + NL
    t = t + "                JsTick()" + NL
    t = t + "            END WHILE" + NL
    t = t + "        CASE ""forin"", ""forof""" + NL
    t = t + "            v = JsEval(na[n], scope)" + NL
    t = t + "            keys.Clear()" + NL
    t = t + "            IF nk[n] = ""forin"" THEN" + NL
    t = t + "                IF v.StartsWith(""o"") THEN" + NL
    t = t + "                    FOR EACH key IN joKeys[JsId(v)].Split(""|"")" + NL
    t = t + "                        IF key = """" OR (joClass[JsId(v)] = ""Array"" AND key = ""length"") THEN CONTINUE" + NL
    t = t + "                        keys.Add(JsS(key))" + NL
    t = t + "                    NEXT" + NL
    t = t + "                END IF" + NL
    t = t + "            ELSE" + NL
    t = t + "                keys = JsIterate(v)" + NL
    t = t + "            END IF" + NL
    t = t + "            FOR EACH key IN keys" + NL
    t = t + "                bs = scope" + NL
    t = t + "                IF nc[n] = 1 THEN bs = JsBlockScope(n, scope)" + NL
    t = t + "                IF nb[n] <> 0 THEN" + NL
    t = t + "                    JsBind(nb[n], key, bs)" + NL
    t = t + "                ELSE" + NL
    t = t + "                    JsSetVar(ns[n], key, bs)" + NL
    t = t + "                END IF" + NL
    t = t + "                JsExec(nd[n], bs)" + NL
    t = t + "                IF bs <> scope THEN JsFreeScope(bs)" + NL
    t = t + "                IF jsSig = ""b"" THEN" + NL
    t = t + "                    jsSig = """"" + NL
    t = t + "                    BREAK" + NL
    t = t + "                END IF" + NL
    t = t + "                IF jsSig = ""c"" THEN jsSig = """"" + NL
    t = t + "                IF jsSig = ""r"" THEN RETURN" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""return""" + NL
    t = t + "            IF na[n] = 0 THEN" + NL
    t = t + "                jsRet = ""u""" + NL
    t = t + "            ELSE" + NL
    t = t + "                jsRet = JsEval(na[n], scope)" + NL
    t = t + "            END IF" + NL
    t = t + "            jsSig = ""r""" + NL
    t = t + "        CASE ""break""" + NL
    t = t + "            jsSig = ""b""" + NL
    t = t + "        CASE ""continue""" + NL
    t = t + "            jsSig = ""c""" + NL
    t = t + "        CASE ""throw""" + NL
    t = t + "            jsThrown = JsEval(na[n], scope)" + NL
    t = t + "            THROW Str(nline[n]) + ""|@thrown""" + NL
    t = t + "        CASE ""try""" + NL
    t = t + "            depth = jsDepth" + NL
    t = t + "            pending = """"" + NL
    t = t + "            TRY" + NL
    t = t + "                JsExec(na[n], scope)" + NL
    t = t + "            CATCH err" + NL
    t = t + "                jsDepth = depth" + NL
    t = t + "                IF err.Contains(""@aborted"") THEN THROW err" + NL
    t = t + "                IF nb[n] = 0 THEN" + NL
    t = t + "                    pending = err" + NL
    t = t + "                ELSE" + NL
    t = t + "                    IF jsThrown <> """" THEN" + NL
    t = t + "                        caught = jsThrown" + NL
    t = t + "                    ELSE" + NL
    t = t + "                        caught = JsMakeError(err)" + NL
    t = t + "                    END IF" + NL
    t = t + "                    jsThrown = """"" + NL
    t = t + "                    JsSetVar(ns[n], caught, scope)" + NL
    t = t + "                    TRY" + NL
    t = t + "                        JsExec(nb[n], scope)" + NL
    t = t + "                    CATCH again" + NL
    t = t + "                        jsDepth = depth" + NL
    t = t + "                        IF again.Contains(""@aborted"") THEN THROW again" + NL
    t = t + "                        pending = again" + NL
    t = t + "                    END TRY" + NL
    t = t + "                END IF" + NL
    t = t + "            END TRY" + NL
    t = t + "            IF nc[n] <> 0 THEN" + NL
    t = t + "                ' finally runs whatever happened, and keeps the return or" + NL
    t = t + "                ' error that was on its way out unless it makes its own" + NL
    t = t + "                sig = jsSig" + NL
    t = t + "                ret = jsRet" + NL
    t = t + "                caught = jsThrown" + NL
    t = t + "                jsSig = """"" + NL
    t = t + "                JsExec(nc[n], scope)" + NL
    t = t + "                IF jsSig = """" THEN" + NL
    t = t + "                    jsSig = sig" + NL
    t = t + "                    jsRet = ret" + NL
    t = t + "                    jsThrown = caught" + NL
    t = t + "                ELSE" + NL
    t = t + "                    pending = """"" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "            IF pending <> """" THEN THROW pending" + NL
    t = t + "        CASE ""switch""" + NL
    t = t + "            v = JsEval(na[n], scope)" + NL
    t = t + "            cases = nl[n].Split("","")" + NL
    t = t + "            start = -1" + NL
    t = t + "            FOR i = 0 TO cases.Count - 1" + NL
    t = t + "                c = Int(Val(cases[i]))" + NL
    t = t + "                IF na[c] <> 0 THEN" + NL
    t = t + "                    IF JsStrictEq(v, JsEval(na[c], scope)) THEN" + NL
    t = t + "                        start = i" + NL
    t = t + "                        BREAK" + NL
    t = t + "                    END IF" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF start < 0 THEN" + NL
    t = t + "                FOR i = 0 TO cases.Count - 1" + NL
    t = t + "                    IF na[Int(Val(cases[i]))] = 0 THEN start = i" + NL
    t = t + "                NEXT" + NL
    t = t + "            END IF" + NL
    t = t + "            IF start < 0 THEN RETURN" + NL
    t = t + "            FOR i = start TO cases.Count - 1" + NL
    t = t + "                FOR EACH item IN nl[Int(Val(cases[i]))].Split("","")" + NL
    t = t + "                    IF item = """" THEN CONTINUE" + NL
    t = t + "                    JsExec(Int(Val(item)), scope)" + NL
    t = t + "                    IF jsSig = ""b"" THEN" + NL
    t = t + "                        jsSig = """"" + NL
    t = t + "                        RETURN" + NL
    t = t + "                    END IF" + NL
    t = t + "                    IF jsSig <> """" THEN RETURN" + NL
    t = t + "                NEXT" + NL
    t = t + "            NEXT" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' An Error object for an error the interpreter raised (""line|message"")." + NL
    t = t + "FUNCTION JsMakeError (err AS String) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR message AS String" + NL
    t = t + "    message = err" + NL
    t = t + "    IF message.Contains(""|"") THEN message = message.Substring(message.IndexOf(""|"") + 1, message.Length - message.IndexOf(""|"") - 1)" + NL
    t = t + "    id = JsNewObject(""Error"", jsErrorProto)" + NL
    t = t + "    IF jsErrorProto = 0 THEN joProto[id] = jsObjectProto" + NL
    t = t + "    JsPutOwn(id, ""message"", JsS(message))" + NL
    t = t + "    JsPutOwn(id, ""description"", JsS(message))" + NL
    t = t + "    IF HostWhere() = """" THEN" + NL
    t = t + "        JsPutOwn(id, ""stack"", JsS(""Error: "" + message))" + NL
    t = t + "    ELSE" + NL
    t = t + "        JsPutOwn(id, ""stack"", JsS(""Error: "" + message + Chr(10) + ""    at "" + HostWhere()))" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN JsO(id)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- evaluating expressions" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsEval (n AS Integer, scope AS Integer) AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR items AS Array OF String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    VAR op AS String" + NL
    t = t + "    SELECT CASE nk[n]" + NL
    t = t + "        CASE ""num""" + NL
    t = t + "            RETURN ""n"" + ns[n]" + NL
    t = t + "        CASE ""str""" + NL
    t = t + "            RETURN ""s"" + ns[n]" + NL
    t = t + "        CASE ""true""" + NL
    t = t + "            RETURN ""t""" + NL
    t = t + "        CASE ""false""" + NL
    t = t + "            RETURN ""f""" + NL
    t = t + "        CASE ""null""" + NL
    t = t + "            RETURN ""l""" + NL
    t = t + "        CASE ""this""" + NL
    t = t + "            RETURN JsThisOf(scope)" + NL
    t = t + "        CASE ""id""" + NL
    t = t + "            RETURN JsLookup(ns[n], scope)" + NL
    t = t + "        CASE ""array""" + NL
    t = t + "            items = JsArgList(n, scope)" + NL
    t = t + "            RETURN JsO(JsNewArray(items))" + NL
    t = t + "        CASE ""object""" + NL
    t = t + "            id = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "            FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "                IF item = """" THEN CONTINUE" + NL
    t = t + "                k = Int(Val(item))" + NL
    t = t + "                IF nb[k] = 2 THEN" + NL
    t = t + "                    ' ...other: its own properties" + NL
    t = t + "                    v = JsEval(na[k], scope)" + NL
    t = t + "                    IF v.StartsWith(""o"") THEN" + NL
    t = t + "                        FOR EACH a IN JsOwnKeys(JsId(v))" + NL
    t = t + "                            JsPutOwn(id, a, JsGet(v, a))" + NL
    t = t + "                        NEXT" + NL
    t = t + "                    END IF" + NL
    t = t + "                ELSEIF nb[k] <> 0 THEN" + NL
    t = t + "                    a = JsKey(JsEval(nb[k], scope))" + NL
    t = t + "                    JsPut(JsO(id), a, JsEval(na[k], scope))" + NL
    t = t + "                ELSE" + NL
    t = t + "                    JsPut(JsO(id), ns[k], JsEval(na[k], scope))" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsO(id)" + NL
    t = t + "        CASE ""classexpr""" + NL
    t = t + "            RETURN JsMakeClass(n, scope)" + NL
    t = t + "        CASE ""supercall""" + NL
    t = t + "            RETURN JsSuperCall(n, scope)" + NL
    t = t + "        CASE ""supermember""" + NL
    t = t + "            RETURN JsGet(JsLookup(""@superproto"", scope), ns[n])" + NL
    t = t + "        CASE ""funcexpr""" + NL
    t = t + "            RETURN JsMakeFunction(n, scope)" + NL
    t = t + "        CASE ""member""" + NL
    t = t + "            jsLine = nline[n]" + NL
    t = t + "            a = JsEval(na[n], scope)" + NL
    t = t + "            IF nd[n] = 1 AND (a = ""u"" OR a = ""l"") THEN RETURN ""u""" + NL
    t = t + "            RETURN JsGet(JsNeed(a, na[n]), ns[n])" + NL
    t = t + "        CASE ""index""" + NL
    t = t + "            a = JsEval(na[n], scope)" + NL
    t = t + "            IF nd[n] = 1 AND (a = ""u"" OR a = ""l"") THEN RETURN ""u""" + NL
    t = t + "            a = JsNeed(a, na[n])" + NL
    t = t + "            jsLine = nline[n]" + NL
    t = t + "            RETURN JsGet(a, JsKey(JsEval(nb[n], scope)))" + NL
    t = t + "        CASE ""assign""" + NL
    t = t + "            RETURN JsAssignment(n, scope)" + NL
    t = t + "        CASE ""incdec""" + NL
    t = t + "            RETURN JsIncDec(n, scope)" + NL
    t = t + "        CASE ""cond""" + NL
    t = t + "            IF JsBool(JsEval(na[n], scope)) THEN RETURN JsEval(nb[n], scope)" + NL
    t = t + "            RETURN JsEval(nc[n], scope)" + NL
    t = t + "        CASE ""bin""" + NL
    t = t + "            op = ns[n]" + NL
    t = t + "            IF op = ""&&"" THEN" + NL
    t = t + "                a = JsEval(na[n], scope)" + NL
    t = t + "                IF NOT JsBool(a) THEN RETURN a" + NL
    t = t + "                RETURN JsEval(nb[n], scope)" + NL
    t = t + "            END IF" + NL
    t = t + "            IF op = ""||"" THEN" + NL
    t = t + "                a = JsEval(na[n], scope)" + NL
    t = t + "                IF JsBool(a) THEN RETURN a" + NL
    t = t + "                RETURN JsEval(nb[n], scope)" + NL
    t = t + "            END IF" + NL
    t = t + "            IF op = ""??"" THEN" + NL
    t = t + "                a = JsEval(na[n], scope)" + NL
    t = t + "                IF a <> ""u"" AND a <> ""l"" THEN RETURN a" + NL
    t = t + "                RETURN JsEval(nb[n], scope)" + NL
    t = t + "            END IF" + NL
    t = t + "            a = JsEval(na[n], scope)" + NL
    t = t + "            v = JsEval(nb[n], scope)" + NL
    t = t + "            jsLine = nline[n]" + NL
    t = t + "            RETURN JsBinOp(op, a, v)" + NL
    t = t + "        CASE ""unary""" + NL
    t = t + "            RETURN JsUnaryOp(n, scope)" + NL
    t = t + "        CASE ""call""" + NL
    t = t + "            RETURN JsCallNode(n, scope)" + NL
    t = t + "        CASE ""new""" + NL
    t = t + "            RETURN JsNewNode(n, scope)" + NL
    t = t + "        CASE ""seq""" + NL
    t = t + "            FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "                v = JsEval(Int(Val(item)), scope)" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN v" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(nline[n]) + ""|Syntax error""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsUnaryOp (n AS Integer, scope AS Integer) AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    VAR t AS Integer" + NL
    t = t + "    VAR obj AS String" + NL
    t = t + "    t = na[n]" + NL
    t = t + "    SELECT CASE ns[n]" + NL
    t = t + "        CASE ""typeof""" + NL
    t = t + "            IF nk[t] = ""id"" THEN" + NL
    t = t + "                IF ns[t] <> ""undefined"" AND ns[t] <> ""status"" AND ns[t] <> ""location"" AND JsFindScope(ns[t], scope) = 0 THEN RETURN ""sundefined""" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsS(JsTypeOf(JsEval(t, scope)))" + NL
    t = t + "        CASE ""void""" + NL
    t = t + "            v = JsEval(t, scope)" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""delete""" + NL
    t = t + "            IF nk[t] = ""member"" OR nk[t] = ""index"" THEN" + NL
    t = t + "                obj = JsNeed(JsEval(na[t], scope), na[t])" + NL
    t = t + "                IF nk[t] = ""member"" THEN" + NL
    t = t + "                    JsDeleteProp(JsId(obj), ns[t])" + NL
    t = t + "                ELSE" + NL
    t = t + "                    JsDeleteProp(JsId(obj), JsKey(JsEval(nb[t], scope)))" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN ""t""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    v = JsEval(t, scope)" + NL
    t = t + "    SELECT CASE ns[n]" + NL
    t = t + "        CASE ""!""" + NL
    t = t + "            RETURN JsB(NOT JsBool(v))" + NL
    t = t + "        CASE ""-""" + NL
    t = t + "            IF JsNum(v) = ""0"" THEN RETURN ""n0""" + NL
    t = t + "            RETURN ""n"" + JsArith(""-"", ""0"", JsNum(v))" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""n"" + JsNum(v)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JsDeleteProp (id AS Integer, name AS String)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF id = 0 THEN RETURN" + NL
    t = t + "    k = JsOwn(id, name)" + NL
    t = t + "    IF k < 0 THEN RETURN" + NL
    t = t + "    jpKey.RemoveAt(k)" + NL
    t = t + "    jpVal.RemoveAt(k)" + NL
    t = t + "    joKeys[id] = joKeys[id].Replace(""|"" + name + ""|"", ""|"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' x = v, x += v, a.b = v, a[k] = v" + NL
    t = t + "FUNCTION JsAssignment (n AS Integer, scope AS Integer) AS String" + NL
    t = t + "    VAR t AS Integer" + NL
    t = t + "    VAR op AS String" + NL
    t = t + "    VAR obj AS String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    t = na[n]" + NL
    t = t + "    op = ns[n]" + NL
    t = t + "    IF nk[t] = ""id"" THEN" + NL
    t = t + "        IF op = ""="" THEN" + NL
    t = t + "            v = JsEval(nb[n], scope)" + NL
    t = t + "        ELSE" + NL
    t = t + "            v = JsBinOp(op.Substring(0, 1), JsLookup(ns[t], scope), JsEval(nb[n], scope))" + NL
    t = t + "        END IF" + NL
    t = t + "        JsSetVar(ns[t], v, scope)" + NL
    t = t + "        RETURN v" + NL
    t = t + "    END IF" + NL
    t = t + "    obj = JsNeed(JsEval(na[t], scope), na[t])" + NL
    t = t + "    IF nk[t] = ""member"" THEN" + NL
    t = t + "        key = ns[t]" + NL
    t = t + "    ELSE" + NL
    t = t + "        key = JsKey(JsEval(nb[t], scope))" + NL
    t = t + "    END IF" + NL
    t = t + "    jsLine = nline[n]" + NL
    t = t + "    IF op = ""="" THEN" + NL
    t = t + "        v = JsEval(nb[n], scope)" + NL
    t = t + "    ELSE" + NL
    t = t + "        v = JsBinOp(op.Substring(0, 1), JsGet(obj, key), JsEval(nb[n], scope))" + NL
    t = t + "    END IF" + NL
    t = t + "    JsPut(obj, key, v)" + NL
    t = t + "    RETURN v" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ++x, x++, --x, x--" + NL
    t = t + "FUNCTION JsIncDec (n AS Integer, scope AS Integer) AS String" + NL
    t = t + "    VAR t AS Integer" + NL
    t = t + "    VAR obj AS String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR old AS String" + NL
    t = t + "    VAR fresh AS String" + NL
    t = t + "    t = na[n]" + NL
    t = t + "    IF nk[t] = ""id"" THEN" + NL
    t = t + "        old = JsNum(JsLookup(ns[t], scope))" + NL
    t = t + "    ELSE" + NL
    t = t + "        obj = JsNeed(JsEval(na[t], scope), na[t])" + NL
    t = t + "        IF nk[t] = ""member"" THEN" + NL
    t = t + "            key = ns[t]" + NL
    t = t + "        ELSE" + NL
    t = t + "            key = JsKey(JsEval(nb[t], scope))" + NL
    t = t + "        END IF" + NL
    t = t + "        old = JsNum(JsGet(obj, key))" + NL
    t = t + "    END IF" + NL
    t = t + "    fresh = JsArith(ns[n].Substring(0, 1), old, ""1"")" + NL
    t = t + "    IF nk[t] = ""id"" THEN" + NL
    t = t + "        JsSetVar(ns[t], ""n"" + fresh, scope)" + NL
    t = t + "    ELSE" + NL
    t = t + "        JsPut(obj, key, ""n"" + fresh)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF nl[n] = ""pre"" THEN RETURN ""n"" + fresh" + NL
    t = t + "    RETURN ""n"" + old" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsArgList (n AS Integer, scope AS Integer) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "        IF item = """" THEN CONTINUE" + NL
    t = t + "        k = Int(Val(item))" + NL
    t = t + "        IF nk[k] = ""spread"" THEN" + NL
    t = t + "            FOR EACH v IN JsIterate(JsEval(na[k], scope))" + NL
    t = t + "                out.Add(v)" + NL
    t = t + "            NEXT" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(JsEval(k, scope))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsCallNode (n AS Integer, scope AS Integer) AS String" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR thisVal AS String" + NL
    t = t + "    VAR fn AS String" + NL
    t = t + "    VAR args AS Array OF String" + NL
    t = t + "    VAR prog AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    c = na[n]" + NL
    t = t + "    IF nk[c] = ""supermember"" THEN" + NL
    t = t + "        thisVal = JsThisOf(scope)" + NL
    t = t + "        fn = JsGet(JsLookup(""@superproto"", scope), ns[c])" + NL
    t = t + "        name = ""super."" + ns[c]" + NL
    t = t + "    ELSEIF nk[c] = ""member"" THEN" + NL
    t = t + "        thisVal = JsEval(na[c], scope)" + NL
    t = t + "        IF nd[c] = 1 AND (thisVal = ""u"" OR thisVal = ""l"") THEN RETURN ""u""" + NL
    t = t + "        thisVal = JsNeed(thisVal, na[c])" + NL
    t = t + "        jsLine = nline[n]" + NL
    t = t + "        fn = JsGet(thisVal, ns[c])" + NL
    t = t + "        name = ns[c]" + NL
    t = t + "    ELSEIF nk[c] = ""index"" THEN" + NL
    t = t + "        thisVal = JsNeed(JsEval(na[c], scope), na[c])" + NL
    t = t + "        name = JsKey(JsEval(nb[c], scope))" + NL
    t = t + "        jsLine = nline[n]" + NL
    t = t + "        fn = JsGet(thisVal, name)" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF nk[c] = ""id"" AND ns[c] = ""eval"" THEN RETURN JsEvalCode(JsArgList(n, scope), scope)" + NL
    t = t + "        fn = JsEval(c, scope)" + NL
    t = t + "        thisVal = JsO(jsGlobal)" + NL
    t = t + "        name = JsDescribe(c)" + NL
    t = t + "    END IF" + NL
    t = t + "    args = JsArgList(n, scope)" + NL
    t = t + "    jsLine = nline[n]" + NL
    t = t + "    IF nd[n] = 1 AND (fn = ""u"" OR fn = ""l"") THEN RETURN ""u""" + NL
    t = t + "    IF NOT JsCallable(fn) THEN" + NL
    t = t + "        IF nk[c] = ""member"" OR nk[c] = ""index"" OR nk[c] = ""supermember"" THEN THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "        THROW Str(jsLine) + ""|Function expected""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN JsCall(fn, thisVal, args)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' eval(""code""): runs in the scope that called it; its value is the last expression's." + NL
    t = t + "FUNCTION JsEvalCode (args AS Array OF String, scope AS Integer) AS String" + NL
    t = t + "    VAR prog AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    IF args.Count = 0 THEN RETURN ""u""" + NL
    t = t + "    IF NOT args[0].StartsWith(""s"") THEN RETURN args[0]" + NL
    t = t + "    line = jsLine" + NL
    t = t + "    prog = JsParse(args[0].Substring(1, args[0].Length - 1))" + NL
    t = t + "    jsLine = line" + NL
    t = t + "    JsHoist(prog, scope)" + NL
    t = t + "    jsRet = ""u""" + NL
    t = t + "    JsExec(prog, scope)" + NL
    t = t + "    IF jsSig = ""r"" THEN jsSig = """"" + NL
    t = t + "    RETURN jsRet" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsCall (fn AS String, thisVal AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR node AS Integer" + NL
    t = t + "    VAR scope AS Integer" + NL
    t = t + "    VAR params AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR result AS String" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    id = JsId(fn)" + NL
    t = t + "    IF joClass[id] = ""Native"" THEN RETURN JsCallNative(joS[id], thisVal, args)" + NL
    t = t + "    node = joA[id]" + NL
    t = t + "    jsDepth = jsDepth + 1" + NL
    t = t + "    IF jsDepth > JSMAXDEPTH THEN THROW Str(jsLine) + ""|Out of stack space""" + NL
    t = t + "    line = jsLine" + NL
    t = t + "    scope = JsNewScope(joB[id], thisVal)" + NL
    t = t + "    ' an arrow function's this is the one where it was made" + NL
    t = t + "    IF nd[node] = 1 THEN JsDeleteProp(scope, ""@this"")" + NL
    t = t + "    JsPutOwn(scope, ""arguments"", JsO(JsNewArray(args)))" + NL
    t = t + "    IF nb[node] <> 0 THEN" + NL
    t = t + "        JsBindParams(nb[node], args, scope)" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF nl[node] <> """" THEN params = nl[node].Split("","")" + NL
    t = t + "        FOR i = 0 TO params.Count - 1" + NL
    t = t + "            IF i < args.Count THEN" + NL
    t = t + "                JsPutOwn(scope, params[i], args[i])" + NL
    t = t + "            ELSE" + NL
    t = t + "                JsPutOwn(scope, params[i], ""u"")" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    IF nk[node] = ""funcexpr"" AND ns[node] <> """" AND JsOwn(scope, ns[node]) < 0 THEN JsPutOwn(scope, ns[node], fn)" + NL
    t = t + "    JsHoist(na[node], scope)" + NL
    t = t + "    JsExec(na[node], scope)" + NL
    t = t + "    result = ""u""" + NL
    t = t + "    IF jsSig = ""r"" THEN result = jsRet" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    jsDepth = jsDepth - 1" + NL
    t = t + "    jsLine = line" + NL
    t = t + "    JsFreeScope(scope)" + NL
    t = t + "    RETURN result" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' new F(args): a fresh object whose prototype is F.prototype, with F run on it." + NL
    t = t + "FUNCTION JsNewNode (n AS Integer, scope AS Integer) AS String" + NL
    t = t + "    VAR fn AS String" + NL
    t = t + "    VAR args AS Array OF String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR result AS String" + NL
    t = t + "    fn = JsEval(na[n], scope)" + NL
    t = t + "    args = JsArgList(n, scope)" + NL
    t = t + "    jsLine = nline[n]" + NL
    t = t + "    IF NOT JsCallable(fn) THEN THROW Str(jsLine) + ""|Object doesn't support this action""" + NL
    t = t + "    IF joClass[JsId(fn)] = ""Native"" THEN RETURN JsConstruct(joS[JsId(fn)], args)" + NL
    t = t + "    id = JsNewObject(""Object"", JsId(JsGet(fn, ""prototype"")))" + NL
    t = t + "    ' a class with nothing to extend sets its fields before its constructor runs" + NL
    t = t + "    IF JsOwn(JsId(fn), ""@cscope"") >= 0 THEN" + NL
    t = t + "        IF JsGetProp(JsInt(JsGetProp(JsId(fn), ""@cscope"")), ""@super"") = ""u"" THEN JsInitFields(fn, JsO(id))" + NL
    t = t + "    END IF" + NL
    t = t + "    result = JsCall(fn, JsO(id), args)" + NL
    t = t + "    IF result.StartsWith(""o"") THEN RETURN result" + NL
    t = t + "    RETURN JsO(id)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- dates" + NL
    t = t + "" + NL
    t = t + "' Seconds to add to UTC for local time, worked out from the machine's clock." + NL
    t = t + "FUNCTION JsZone () AS Integer" + NL
    t = t + "    VAR z AS Integer" + NL
    t = t + "    z = Int(TIME.Ticks / 1000) - (TIME.Now MOD 86400)" + NL
    t = t + "    IF z > 43200 THEN z = z - 86400" + NL
    t = t + "    IF z < -43200 THEN z = z + 86400" + NL
    t = t + "    RETURN Int(MATH.Round(z / 900)) * 900" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Days since 1970-01-01 for a date, and back (Howard Hinnant's algorithms)." + NL
    t = t + "FUNCTION JsDaysFrom (y AS Integer, m AS Integer, d AS Integer) AS Integer" + NL
    t = t + "    VAR era AS Integer" + NL
    t = t + "    VAR yoe AS Integer" + NL
    t = t + "    VAR doy AS Integer" + NL
    t = t + "    VAR doe AS Integer" + NL
    t = t + "    IF m <= 2 THEN y = y - 1" + NL
    t = t + "    era = MATH.Floor(y / 400)" + NL
    t = t + "    yoe = y - era * 400" + NL
    t = t + "    IF m > 2 THEN" + NL
    t = t + "        doy = Int((153 * (m - 3) + 2) / 5) + d - 1" + NL
    t = t + "    ELSE" + NL
    t = t + "        doy = Int((153 * (m + 9) + 2) / 5) + d - 1" + NL
    t = t + "    END IF" + NL
    t = t + "    doe = yoe * 365 + Int(yoe / 4) - Int(yoe / 100) + doy" + NL
    t = t + "    RETURN era * 146097 + doe - 719468" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' y|m|d for a day number" + NL
    t = t + "FUNCTION JsCivil (days AS Integer) AS String" + NL
    t = t + "    VAR z AS Integer" + NL
    t = t + "    VAR era AS Integer" + NL
    t = t + "    VAR doe AS Integer" + NL
    t = t + "    VAR yoe AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR doy AS Integer" + NL
    t = t + "    VAR mp AS Integer" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    VAR m AS Integer" + NL
    t = t + "    z = days + 719468" + NL
    t = t + "    era = MATH.Floor(z / 146097)" + NL
    t = t + "    doe = z - era * 146097" + NL
    t = t + "    yoe = Int((doe - Int(doe / 1460) + Int(doe / 36524) - Int(doe / 146096)) / 365)" + NL
    t = t + "    y = yoe + era * 400" + NL
    t = t + "    doy = doe - (365 * yoe + Int(yoe / 4) - Int(yoe / 100))" + NL
    t = t + "    mp = Int((5 * doy + 2) / 153)" + NL
    t = t + "    d = doy - Int((153 * mp + 2) / 5) + 1" + NL
    t = t + "    IF mp < 10 THEN" + NL
    t = t + "        m = mp + 3" + NL
    t = t + "    ELSE" + NL
    t = t + "        m = mp - 9" + NL
    t = t + "    END IF" + NL
    t = t + "    IF m <= 2 THEN y = y + 1" + NL
    t = t + "    RETURN Str(y) + ""|"" + Str(m) + ""|"" + Str(d)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One part of a time (milliseconds since 1970), in local time." + NL
    t = t + "FUNCTION JsDatePart (ms AS Real, part AS String) AS Integer" + NL
    t = t + "    VAR local AS Real" + NL
    t = t + "    VAR days AS Integer" + NL
    t = t + "    VAR secs AS Integer" + NL
    t = t + "    VAR ymd AS Array OF String" + NL
    t = t + "    local = MATH.Floor(ms / 1000) + JsZone()" + NL
    t = t + "    days = MATH.Floor(local / 86400)" + NL
    t = t + "    secs = Int(local - days * 86400)" + NL
    t = t + "    SELECT CASE part" + NL
    t = t + "        CASE ""hours""" + NL
    t = t + "            RETURN Int(secs / 3600)" + NL
    t = t + "        CASE ""minutes""" + NL
    t = t + "            RETURN Int((secs MOD 3600) / 60)" + NL
    t = t + "        CASE ""seconds""" + NL
    t = t + "            RETURN secs MOD 60" + NL
    t = t + "        CASE ""ms""" + NL
    t = t + "            RETURN Int(ms - MATH.Floor(ms / 1000) * 1000)" + NL
    t = t + "        CASE ""day""" + NL
    t = t + "            RETURN ((days MOD 7) + 11) MOD 7" + NL
    t = t + "    END SELECT" + NL
    t = t + "    ymd = JsCivil(days).Split(""|"")" + NL
    t = t + "    SELECT CASE part" + NL
    t = t + "        CASE ""year""" + NL
    t = t + "            RETURN Int(Val(ymd[0]))" + NL
    t = t + "        CASE ""month""" + NL
    t = t + "            RETURN Int(Val(ymd[1])) - 1" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN Int(Val(ymd[2]))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Pad2 (n AS Integer) AS String" + NL
    t = t + "    IF n < 10 THEN RETURN ""0"" + Str(n)" + NL
    t = t + "    RETURN Str(n)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""Thu Jul 4 12:00:00 1996"", the way 1996 browsers wrote dates" + NL
    t = t + "FUNCTION JsDateText (ms AS Real) AS String" + NL
    t = t + "    IF ms <> ms THEN RETURN ""NaN""" + NL
    t = t + "    RETURN ""Sun,Mon,Tue,Wed,Thu,Fri,Sat"".Split("","")[JsDatePart(ms, ""day"")] + "" "" + ""Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec"".Split("","")[JsDatePart(ms, ""month"")] + "" "" + Str(JsDatePart(ms, ""date"")) + "" "" _" + NL
    t = t + "        + Pad2(JsDatePart(ms, ""hours"")) + "":"" + Pad2(JsDatePart(ms, ""minutes"")) + "":"" + Pad2(JsDatePart(ms, ""seconds"")) + "" "" + Str(JsDatePart(ms, ""year""))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNow () AS Real" + NL
    t = t + "    RETURN TIME.Now * 1000.0 + (TIME.Ticks MOD 1000)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A moment from local date parts; months and days may run over, as in JS." + NL
    t = t + "FUNCTION JsLocalMs (y AS Real, mon AS Real, d AS Real, h AS Real, mi AS Real, sec AS Real, ms AS Real) AS Real" + NL
    t = t + "    VAR years AS Integer" + NL
    t = t + "    years = MATH.Floor(mon / 12)" + NL
    t = t + "    mon = mon - years * 12" + NL
    t = t + "    RETURN ((JsDaysFrom(Int(y) + years, Int(mon) + 1, 1) + d - 1) * 86400.0 + h * 3600 + mi * 60 + sec - JsZone()) * 1000 + ms" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNewDate (ms AS Real) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    id = JsNewObject(""Date"", jsDateProto)" + NL
    t = t + "    joS[id] = JsFmt(ms)" + NL
    t = t + "    RETURN JsO(id)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- built-in functions" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsArg (args AS Array OF String, i AS Integer) AS String" + NL
    t = t + "    IF i < args.Count THEN RETURN args[i]" + NL
    t = t + "    RETURN ""u""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' new Array(...), new Date(...), new Object(), new String(...)..." + NL
    t = t + "FUNCTION JsConstruct (name AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR ms AS Real" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""Array""" + NL
    t = t + "            IF args.Count = 1 AND args[0].StartsWith(""n"") THEN" + NL
    t = t + "                id = JsNewArray(none)" + NL
    t = t + "                JsPutOwn(id, ""length"", args[0])" + NL
    t = t + "                RETURN JsO(id)" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsO(JsNewArray(args))" + NL
    t = t + "        CASE ""Object""" + NL
    t = t + "            RETURN JsO(JsNewObject(""Object"", jsObjectProto))" + NL
    t = t + "        CASE ""Date""" + NL
    t = t + "            IF args.Count = 0 THEN RETURN JsNewDate(JsNow())" + NL
    t = t + "            IF args.Count = 1 THEN" + NL
    t = t + "                IF args[0].StartsWith(""n"") THEN RETURN JsNewDate(JsReal(args[0]))" + NL
    t = t + "                id = JsNewObject(""Date"", jsDateProto)" + NL
    t = t + "                joS[id] = ""NaN""" + NL
    t = t + "                RETURN JsO(id)" + NL
    t = t + "            END IF" + NL
    t = t + "            id = JsInt(args[0])" + NL
    t = t + "            IF id >= 0 AND id < 100 THEN id = id + 1900" + NL
    t = t + "            ms = 1" + NL
    t = t + "            IF args.Count >= 3 THEN ms = JsReal(args[2])" + NL
    t = t + "            RETURN JsNewDate(JsLocalMs(id, JsReal(args[1]), ms, JsReal(JsArg(args, 3)), JsReal(JsArg(args, 4)), JsReal(JsArg(args, 5)), JsReal(JsArg(args, 6))))" + NL
    t = t + "        CASE ""Error"", ""TypeError"", ""RangeError"", ""SyntaxError"", ""ReferenceError""" + NL
    t = t + "            IF JsArg(args, 0) = ""u"" THEN RETURN JsMakeTypedError(name, """")" + NL
    t = t + "            RETURN JsMakeTypedError(name, JsStr(JsArg(args, 0)))" + NL
    t = t + "        CASE ""Promise""" + NL
    t = t + "            RETURN JsNewPromiseFrom(JsArg(args, 0))" + NL
    t = t + "        CASE ""XMLHttpRequest""" + NL
    t = t + "            RETURN JsO(JsNewXhr())" + NL
    t = t + "        CASE ""ActiveXObject""" + NL
    t = t + "            ' IE's way: only the XMLHTTP objects are here" + NL
    t = t + "            IF JsStr(JsArg(args, 0)).Lower() = ""microsoft.xmlhttp"" OR JsStr(JsArg(args, 0)).Lower().StartsWith(""msxml2.xmlhttp"") THEN RETURN JsO(JsNewXhr())" + NL
    t = t + "            THROW Str(jsLine) + ""|Automation server can't create object""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN JsCallNative(name, JsO(jsGlobal), args)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsCallNative (name AS String, thisVal AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR r AS Real" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    a = JsArg(args, 0)" + NL
    t = t + "    IF name.StartsWith(""String."") AND name <> ""String.fromCharCode"" THEN RETURN JsStringMethod(name.Substring(7, name.Length - 7), JsStr(thisVal), args)" + NL
    t = t + "    IF name.StartsWith(""Array."") THEN RETURN JsArrayMethod(name.Substring(6, name.Length - 6), JsId(thisVal), args)" + NL
    t = t + "    IF name.StartsWith(""Math."") THEN RETURN JsMath(name.Substring(5, name.Length - 5), args)" + NL
    t = t + "    IF name.StartsWith(""Date."") THEN RETURN JsDateMethod(name.Substring(5, name.Length - 5), thisVal, args)" + NL
    t = t + "    IF name.StartsWith(""XHR."") THEN RETURN JsXhrMethod(name.Substring(4, name.Length - 4), thisVal, args)" + NL
    t = t + "    IF name.StartsWith(""Promise.part:"") OR name.StartsWith(""Bound:"") OR name.StartsWith(""ObjectS."") OR name.StartsWith(""ArrayS."") OR name.StartsWith(""NumberS."") OR name.StartsWith(""JSON."") OR name.StartsWith(""PromiseS."") OR name = ""Function.bind"" THEN RETURN JsLib(name, thisVal, args)" + NL
    t = t + "    IF name.StartsWith(""Promise."") OR name.StartsWith(""Response."") THEN RETURN JsPromiseMethod(name, thisVal, args)" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""alert""" + NL
    t = t + "            HostAlert(JsStr(a))" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""confirm""" + NL
    t = t + "            RETURN JsB(HostConfirm(JsStr(a)))" + NL
    t = t + "        CASE ""prompt""" + NL
    t = t + "            text = JsArg(args, 1)" + NL
    t = t + "            IF text = ""u"" THEN text = ""s""" + NL
    t = t + "            text = HostPrompt(JsStr(a), JsStr(text))" + NL
    t = t + "            IF text = Chr(0) THEN RETURN ""l""" + NL
    t = t + "            RETURN JsS(text)" + NL
    t = t + "        CASE ""parseInt""" + NL
    t = t + "            RETURN ""n"" + JsParseInt(JsStr(a), JsInt(JsArg(args, 1)))" + NL
    t = t + "        CASE ""parseFloat""" + NL
    t = t + "            RETURN ""n"" + JsParseFloat(JsStr(a))" + NL
    t = t + "        CASE ""isNaN""" + NL
    t = t + "            RETURN JsB(JsNum(a) = ""NaN"")" + NL
    t = t + "        CASE ""isFinite""" + NL
    t = t + "            RETURN JsB(JsFinite(JsNum(a)))" + NL
    t = t + "        CASE ""escape""" + NL
    t = t + "            RETURN JsS(JsEscape(JsStr(a)))" + NL
    t = t + "        CASE ""unescape""" + NL
    t = t + "            RETURN JsS(JsUnescape(JsStr(a)))" + NL
    t = t + "        CASE ""String""" + NL
    t = t + "            IF args.Count = 0 THEN RETURN ""s""" + NL
    t = t + "            RETURN JsS(JsStr(a))" + NL
    t = t + "        CASE ""Number""" + NL
    t = t + "            IF args.Count = 0 THEN RETURN ""n0""" + NL
    t = t + "            RETURN ""n"" + JsNum(a)" + NL
    t = t + "        CASE ""Boolean""" + NL
    t = t + "            RETURN JsB(JsBool(a))" + NL
    t = t + "        CASE ""Array"", ""Object"", ""Error"", ""XMLHttpRequest"", ""ActiveXObject"", ""TypeError"", ""RangeError"", ""SyntaxError"", ""ReferenceError""" + NL
    t = t + "            RETURN JsConstruct(name, args)" + NL
    t = t + "        CASE ""Promise""" + NL
    t = t + "            jsThrown = JsMakeTypedError(""TypeError"", ""Promise constructor cannot be invoked without 'new'"")" + NL
    t = t + "            THROW Str(jsLine) + ""|@thrown""" + NL
    t = t + "        CASE ""fetch""" + NL
    t = t + "            RETURN JsFetch(args)" + NL
    t = t + "        CASE ""All.item""" + NL
    t = t + "            IF HostHas(JsStr(a)) THEN RETURN JsElement(JsStr(a))" + NL
    t = t + "            RETURN ""l""" + NL
    t = t + "        CASE ""Date""" + NL
    t = t + "            RETURN JsS(JsDateText(JsNow()))" + NL
    t = t + "        CASE ""String.fromCharCode""" + NL
    t = t + "            FOR i = 0 TO args.Count - 1" + NL
    t = t + "                out = out + Chr(JsInt(args[i]))" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsS(out)" + NL
    t = t + "        CASE ""setTimeout"", ""setInterval""" + NL
    t = t + "            IF JsCallable(a) THEN" + NL
    t = t + "                RETURN JsN(HostTimeout("""", a, JsInt(JsArg(args, 1)), name = ""setInterval""))" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsN(HostTimeout(JsStr(a), """", JsInt(JsArg(args, 1)), name = ""setInterval""))" + NL
    t = t + "        CASE ""clearTimeout"", ""clearInterval""" + NL
    t = t + "            HostClearTimeout(JsInt(a))" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""open""" + NL
    t = t + "            HostOpen(JsStr(a))" + NL
    t = t + "            RETURN ""l""" + NL
    t = t + "        CASE ""document.write"", ""document.writeln""" + NL
    t = t + "            FOR i = 0 TO args.Count - 1" + NL
    t = t + "                jsOut = jsOut + JsStr(args[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF name = ""document.writeln"" THEN jsOut = jsOut + Chr(10)" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""document.getElementById""" + NL
    t = t + "            IF HostHas(JsStr(a)) THEN RETURN JsElement(JsStr(a))" + NL
    t = t + "            RETURN ""l""" + NL
    t = t + "        CASE ""history.back""" + NL
    t = t + "            HostHistory(-1)" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""history.forward""" + NL
    t = t + "            HostHistory(1)" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""history.go""" + NL
    t = t + "            HostHistory(JsInt(a))" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""location.reload""" + NL
    t = t + "            HostNavigate(HostInfo(""location""))" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""location.replace"", ""location.assign""" + NL
    t = t + "            HostNavigate(JsStr(a))" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""location.toString""" + NL
    t = t + "            RETURN JsS(HostInfo(""location""))" + NL
    t = t + "        CASE ""Form.submit""" + NL
    t = t + "            HostSubmit(joA[JsId(thisVal)])" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""navigator.javaEnabled"", ""Element.focus"", ""Element.blur"", ""Element.select"", ""Element.click"", ""noop""" + NL
    t = t + "            RETURN ""f""" + NL
    t = t + "        CASE ""Object.toString""" + NL
    t = t + "            IF thisVal.StartsWith(""o"") THEN RETURN JsS(JsStr(thisVal))" + NL
    t = t + "            RETURN JsS(JsStr(thisVal))" + NL
    t = t + "        CASE ""Object.hasOwnProperty""" + NL
    t = t + "            RETURN JsB(JsOwn(JsId(thisVal), JsStr(a)) >= 0)" + NL
    t = t + "        CASE ""Number.toString""" + NL
    t = t + "            n = JsInt(a)" + NL
    t = t + "            IF n < 2 OR n > 36 OR n = 10 THEN RETURN JsS(JsStr(thisVal))" + NL
    t = t + "            RETURN JsS(JsRadix(JsReal(thisVal), n))" + NL
    t = t + "        CASE ""Number.toFixed""" + NL
    t = t + "            RETURN JsS(JsFixed(JsReal(thisVal), JsInt(a)))" + NL
    t = t + "        CASE ""Function.call""" + NL
    t = t + "            FOR i = 1 TO args.Count - 1" + NL
    t = t + "                list.Add(args[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsCall(thisVal, JsThisArg(a), list)" + NL
    t = t + "        CASE ""Function.apply""" + NL
    t = t + "            IF JsArg(args, 1).StartsWith(""o"") THEN list = JsItems(JsId(args[1]))" + NL
    t = t + "            RETURN JsCall(thisVal, JsThisArg(a), list)" + NL
    t = t + "    END SELECT" + NL
    t = t + "    ' anything else is the host's own (Node's modules, say)" + NL
    t = t + "    RETURN HostNative(name, thisVal, args)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsThisArg (v AS String) AS String" + NL
    t = t + "    IF v = ""u"" OR v = ""l"" THEN RETURN JsO(jsGlobal)" + NL
    t = t + "    RETURN v" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsRadix (r AS Real, radix AS Integer) AS String" + NL
    t = t + "    VAR n AS Real" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR sign AS String" + NL
    t = t + "    n = Int(Abs(r))" + NL
    t = t + "    IF r < 0 THEN sign = ""-""" + NL
    t = t + "    IF n = 0 THEN RETURN ""0""" + NL
    t = t + "    WHILE n > 0" + NL
    t = t + "        out = ""0123456789abcdefghijklmnopqrstuvwxyz"".CharAt(Int(n - Int(n / radix) * radix)) + out" + NL
    t = t + "        n = Int(n / radix)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN sign + out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsFixed (r AS Real, digits AS Integer) AS String" + NL
    t = t + "    VAR scaled AS Real" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR sign AS String" + NL
    t = t + "    IF digits < 0 THEN digits = 0" + NL
    t = t + "    IF digits > 20 THEN digits = 20" + NL
    t = t + "    IF r < 0 THEN" + NL
    t = t + "        sign = ""-""" + NL
    t = t + "        r = -r" + NL
    t = t + "    END IF" + NL
    t = t + "    scaled = MATH.Round(r * 10 ^ digits)" + NL
    t = t + "    s = Str(Int(scaled))" + NL
    t = t + "    IF digits = 0 THEN RETURN sign + s" + NL
    t = t + "    WHILE s.Length <= digits" + NL
    t = t + "        s = ""0"" + s" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN sign + s.Substring(0, s.Length - digits) + ""."" + s.Substring(s.Length - digits, digits)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsParseInt (text AS String, radix AS Integer) AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR sign AS Integer = 1" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    VAR v AS Real" + NL
    t = t + "    VAR digits AS String" + NL
    t = t + "    VAR any AS Bool" + NL
    t = t + "    t = text.Trim().Lower()" + NL
    t = t + "    IF t.StartsWith(""-"") THEN" + NL
    t = t + "        sign = -1" + NL
    t = t + "        t = t.Substring(1, t.Length - 1)" + NL
    t = t + "    ELSEIF t.StartsWith(""+"") THEN" + NL
    t = t + "        t = t.Substring(1, t.Length - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF radix = 0 THEN" + NL
    t = t + "        radix = 10" + NL
    t = t + "        IF t.StartsWith(""0x"") THEN" + NL
    t = t + "            radix = 16" + NL
    t = t + "            t = t.Substring(2, t.Length - 2)" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSEIF radix = 16 AND t.StartsWith(""0x"") THEN" + NL
    t = t + "        t = t.Substring(2, t.Length - 2)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF radix < 2 OR radix > 36 THEN RETURN ""NaN""" + NL
    t = t + "    digits = ""0123456789abcdefghijklmnopqrstuvwxyz"".Substring(0, radix)" + NL
    t = t + "    FOR i = 0 TO t.Length - 1" + NL
    t = t + "        d = digits.IndexOf(t.CharAt(i))" + NL
    t = t + "        IF d < 0 THEN BREAK" + NL
    t = t + "        v = v * radix + d" + NL
    t = t + "        any = TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT any THEN RETURN ""NaN""" + NL
    t = t + "    RETURN JsFmt(sign * v)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsParseFloat (text AS String) AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR best AS String" + NL
    t = t + "    t = text.Trim()" + NL
    t = t + "    best = ""NaN""" + NL
    t = t + "    FOR i = 1 TO MATH.Min(t.Length, 40)" + NL
    t = t + "        IF JsParseNumber(t.Substring(0, i)) <> ""NaN"" AND NOT t.Substring(0, i).Lower().EndsWith(""e"") AND NOT t.Substring(0, i).EndsWith(""x"") THEN best = JsParseNumber(t.Substring(0, i))" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF t.StartsWith(""Infinity"") THEN RETURN ""Infinity""" + NL
    t = t + "    RETURN best" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsEscape (s AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        c = s.CharAt(i)" + NL
    t = t + "        IF ""ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@*_+-./"".Contains(c) THEN" + NL
    t = t + "            out = out + c" + NL
    t = t + "        ELSE" + NL
    t = t + "            out = out + ""%"" + Hex(Asc(c)).PadLeft(2).Replace("" "", ""0"")" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsUnescape (s AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    WHILE i < s.Length" + NL
    t = t + "        IF s.CharAt(i) = ""%"" AND i + 2 < s.Length + 0 AND OnlyChars(JsPeek(s, i + 1, 2).Lower(), ""0123456789abcdef"") AND JsPeek(s, i + 1, 2).Length = 2 THEN" + NL
    t = t + "            h = JsPeek(s, i + 1, 2).Lower()" + NL
    t = t + "            out = out + Chr(""0123456789abcdef"".IndexOf(h.CharAt(0)) * 16 + ""0123456789abcdef"".IndexOf(h.CharAt(1)))" + NL
    t = t + "            i = i + 3" + NL
    t = t + "        ELSE" + NL
    t = t + "            out = out + s.CharAt(i)" + NL
    t = t + "            i = i + 1" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsMath (name AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR x AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR best AS String" + NL
    t = t + "    x = JsNum(JsArg(args, 0))" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""random""" + NL
    t = t + "            RETURN JsN(Rnd())" + NL
    t = t + "        CASE ""max"", ""min""" + NL
    t = t + "            IF args.Count = 0 THEN" + NL
    t = t + "                IF name = ""max"" THEN RETURN ""n-Infinity""" + NL
    t = t + "                RETURN ""nInfinity""" + NL
    t = t + "            END IF" + NL
    t = t + "            best = ""n"" + JsNum(args[0])" + NL
    t = t + "            FOR i = 1 TO args.Count - 1" + NL
    t = t + "                IF JsNum(args[i]) = ""NaN"" THEN RETURN ""nNaN""" + NL
    t = t + "                IF name = ""max"" AND JsCompare("">"", ""n"" + JsNum(args[i]), best) = ""t"" THEN best = ""n"" + JsNum(args[i])" + NL
    t = t + "                IF name = ""min"" AND JsCompare(""<"", ""n"" + JsNum(args[i]), best) = ""t"" THEN best = ""n"" + JsNum(args[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN best" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF NOT JsFinite(x) THEN RETURN ""nNaN""" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""abs""" + NL
    t = t + "            RETURN JsN(Abs(Val(x)))" + NL
    t = t + "        CASE ""floor""" + NL
    t = t + "            RETURN JsN(MATH.Floor(Val(x)))" + NL
    t = t + "        CASE ""ceil""" + NL
    t = t + "            RETURN JsN(MATH.Ceil(Val(x)))" + NL
    t = t + "        CASE ""round""" + NL
    t = t + "            RETURN JsN(MATH.Floor(Val(x) + 0.5))" + NL
    t = t + "        CASE ""sqrt""" + NL
    t = t + "            IF Val(x) < 0 THEN RETURN ""nNaN""" + NL
    t = t + "            RETURN JsN(MATH.Sqrt(Val(x)))" + NL
    t = t + "        CASE ""pow""" + NL
    t = t + "            RETURN JsN(Val(x) ^ JsReal(JsArg(args, 1)))" + NL
    t = t + "        CASE ""sin""" + NL
    t = t + "            RETURN JsN(MATH.Sin(Val(x)))" + NL
    t = t + "        CASE ""cos""" + NL
    t = t + "            RETURN JsN(MATH.Cos(Val(x)))" + NL
    t = t + "        CASE ""tan""" + NL
    t = t + "            RETURN JsN(MATH.Tan(Val(x)))" + NL
    t = t + "        CASE ""atan""" + NL
    t = t + "            RETURN JsN(MATH.Atan(Val(x)))" + NL
    t = t + "        CASE ""exp""" + NL
    t = t + "            RETURN JsN(MATH.Exp(Val(x)))" + NL
    t = t + "        CASE ""log""" + NL
    t = t + "            IF Val(x) <= 0 THEN RETURN ""nNaN""" + NL
    t = t + "            RETURN JsN(MATH.Log(Val(x)))" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsStringMethod (name AS String, s AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR found AS Integer" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    a = JsArg(args, 0)" + NL
    t = t + "    n = s.Length" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""replace"", ""replaceAll""" + NL
    t = t + "            IF a.StartsWith(""o"") THEN" + NL
    t = t + "                jsThrown = JsMakeTypedError(""TypeError"", ""Regular expressions are not supported yet: give replace a string"")" + NL
    t = t + "                THROW Str(jsLine) + ""|@thrown""" + NL
    t = t + "            END IF" + NL
    t = t + "            t = JsStr(a)" + NL
    t = t + "            out.Clear()" + NL
    t = t + "            i = 0" + NL
    t = t + "            WHILE TRUE" + NL
    t = t + "                found = -1" + NL
    t = t + "                IF i <= n THEN found = s.Substring(i, n - i).IndexOf(t)" + NL
    t = t + "                IF found < 0 THEN BREAK" + NL
    t = t + "                found = found + i" + NL
    t = t + "                out.Add(JsS(s.Substring(i, found - i)))" + NL
    t = t + "                IF JsCallable(JsArg(args, 1)) THEN" + NL
    t = t + "                    parts.Clear()" + NL
    t = t + "                    parts.Add(JsS(t))" + NL
    t = t + "                    parts.Add(JsN(found))" + NL
    t = t + "                    parts.Add(JsS(s))" + NL
    t = t + "                    out.Add(JsS(JsStr(JsCall(args[1], JsO(jsGlobal), parts))))" + NL
    t = t + "                ELSE" + NL
    t = t + "                    out.Add(JsS(JsStr(JsArg(args, 1)).Replace(""$&"", t).Replace(""$$"", ""$"")))" + NL
    t = t + "                END IF" + NL
    t = t + "                i = found + MATH.Max(1, t.Length)" + NL
    t = t + "                IF t = """" THEN" + NL
    t = t + "                    IF found < n THEN out.Add(JsS(s.CharAt(found)))" + NL
    t = t + "                END IF" + NL
    t = t + "                IF name = ""replace"" OR i > n THEN BREAK" + NL
    t = t + "            END WHILE" + NL
    t = t + "            IF i <= n THEN out.Add(JsS(s.Substring(i, n - i)))" + NL
    t = t + "            t = """"" + NL
    t = t + "            FOR EACH a IN out" + NL
    t = t + "                t = t + a.Substring(1, a.Length - 1)" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsS(t)" + NL
    t = t + "        CASE ""startsWith""" + NL
    t = t + "            i = MATH.Max(0, JsInt(JsArg(args, 1)))" + NL
    t = t + "            t = JsStr(a)" + NL
    t = t + "            IF i + t.Length > n THEN RETURN ""f""" + NL
    t = t + "            RETURN JsB(s.Substring(i, t.Length) = t)" + NL
    t = t + "        CASE ""endsWith""" + NL
    t = t + "            i = n" + NL
    t = t + "            IF args.Count > 1 AND args[1] <> ""u"" THEN i = MATH.Min(n, JsInt(args[1]))" + NL
    t = t + "            t = JsStr(a)" + NL
    t = t + "            IF t.Length > i THEN RETURN ""f""" + NL
    t = t + "            RETURN JsB(s.Substring(i - t.Length, t.Length) = t)" + NL
    t = t + "        CASE ""includes""" + NL
    t = t + "            i = MATH.Max(0, JsInt(JsArg(args, 1)))" + NL
    t = t + "            IF i > n THEN RETURN ""f""" + NL
    t = t + "            RETURN JsB(s.Substring(i, n - i).Contains(JsStr(a)))" + NL
    t = t + "        CASE ""repeat""" + NL
    t = t + "            j = JsInt(a)" + NL
    t = t + "            IF j < 0 THEN" + NL
    t = t + "                jsThrown = JsMakeTypedError(""RangeError"", ""Invalid count value: "" + Str(j))" + NL
    t = t + "                THROW Str(jsLine) + ""|@thrown""" + NL
    t = t + "            END IF" + NL
    t = t + "            t = """"" + NL
    t = t + "            FOR i = 1 TO j" + NL
    t = t + "                t = t + s" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsS(t)" + NL
    t = t + "        CASE ""padStart"", ""padEnd""" + NL
    t = t + "            j = JsInt(a)" + NL
    t = t + "            t = "" """ + NL
    t = t + "            IF args.Count > 1 AND args[1] <> ""u"" THEN t = JsStr(args[1])" + NL
    t = t + "            IF j <= n OR t = """" THEN RETURN JsS(s)" + NL
    t = t + "            a = """"" + NL
    t = t + "            WHILE a.Length < j - n" + NL
    t = t + "                a = a + t" + NL
    t = t + "            END WHILE" + NL
    t = t + "            a = a.Substring(0, j - n)" + NL
    t = t + "            IF name = ""padStart"" THEN RETURN JsS(a + s)" + NL
    t = t + "            RETURN JsS(s + a)" + NL
    t = t + "        CASE ""trimStart"", ""trimLeft""" + NL
    t = t + "            i = 0" + NL
    t = t + "            WHILE i < n AND ("" "" + Chr(9) + Chr(10) + Chr(13)).Contains(s.CharAt(i))" + NL
    t = t + "                i = i + 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "            RETURN JsS(s.Substring(i, n - i))" + NL
    t = t + "        CASE ""trimEnd"", ""trimRight""" + NL
    t = t + "            i = n" + NL
    t = t + "            WHILE i > 0 AND ("" "" + Chr(9) + Chr(10) + Chr(13)).Contains(s.CharAt(i - 1))" + NL
    t = t + "                i = i - 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "            RETURN JsS(s.Substring(0, i))" + NL
    t = t + "        CASE ""charAt""" + NL
    t = t + "            i = JsInt(a)" + NL
    t = t + "            IF i < 0 OR i >= n THEN RETURN ""s""" + NL
    t = t + "            RETURN JsS(s.CharAt(i))" + NL
    t = t + "        CASE ""charCodeAt""" + NL
    t = t + "            i = JsInt(a)" + NL
    t = t + "            IF i < 0 OR i >= n THEN RETURN ""nNaN""" + NL
    t = t + "            RETURN JsN(Asc(s.CharAt(i)))" + NL
    t = t + "        CASE ""indexOf""" + NL
    t = t + "            i = MATH.Max(0, JsInt(JsArg(args, 1)))" + NL
    t = t + "            IF i > n THEN RETURN ""n-1""" + NL
    t = t + "            found = s.Substring(i, n - i).IndexOf(JsStr(a))" + NL
    t = t + "            IF found < 0 THEN RETURN ""n-1""" + NL
    t = t + "            RETURN JsN(found + i)" + NL
    t = t + "        CASE ""lastIndexOf""" + NL
    t = t + "            t = JsStr(a)" + NL
    t = t + "            found = -1" + NL
    t = t + "            j = n - t.Length" + NL
    t = t + "            IF args.Count > 1 AND JsArg(args, 1) <> ""u"" THEN j = MATH.Min(j, JsInt(args[1]))" + NL
    t = t + "            FOR i = j TO 0 STEP -1" + NL
    t = t + "                IF s.Substring(i, t.Length) = t THEN" + NL
    t = t + "                    found = i" + NL
    t = t + "                    BREAK" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsN(found)" + NL
    t = t + "        CASE ""substring""" + NL
    t = t + "            i = MATH.Min(MATH.Max(JsInt(a), 0), n)" + NL
    t = t + "            j = n" + NL
    t = t + "            IF JsArg(args, 1) <> ""u"" THEN j = MATH.Min(MATH.Max(JsInt(args[1]), 0), n)" + NL
    t = t + "            IF i > j THEN" + NL
    t = t + "                found = i" + NL
    t = t + "                i = j" + NL
    t = t + "                j = found" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsS(s.Substring(i, j - i))" + NL
    t = t + "        CASE ""substr""" + NL
    t = t + "            i = JsInt(a)" + NL
    t = t + "            IF i < 0 THEN i = MATH.Max(0, n + i)" + NL
    t = t + "            IF i > n THEN i = n" + NL
    t = t + "            j = n - i" + NL
    t = t + "            IF JsArg(args, 1) <> ""u"" THEN j = MATH.Min(MATH.Max(JsInt(args[1]), 0), n - i)" + NL
    t = t + "            RETURN JsS(s.Substring(i, j))" + NL
    t = t + "        CASE ""slice""" + NL
    t = t + "            i = JsInt(a)" + NL
    t = t + "            IF i < 0 THEN i = MATH.Max(0, n + i)" + NL
    t = t + "            j = n" + NL
    t = t + "            IF JsArg(args, 1) <> ""u"" THEN j = JsInt(args[1])" + NL
    t = t + "            IF j < 0 THEN j = MATH.Max(0, n + j)" + NL
    t = t + "            i = MATH.Min(i, n)" + NL
    t = t + "            j = MATH.Min(j, n)" + NL
    t = t + "            IF j <= i THEN RETURN ""s""" + NL
    t = t + "            RETURN JsS(s.Substring(i, j - i))" + NL
    t = t + "        CASE ""toUpperCase"", ""toLocaleUpperCase""" + NL
    t = t + "            RETURN JsS(s.Upper())" + NL
    t = t + "        CASE ""toLowerCase"", ""toLocaleLowerCase""" + NL
    t = t + "            RETURN JsS(s.Lower())" + NL
    t = t + "        CASE ""trim""" + NL
    t = t + "            RETURN JsS(s.Trim())" + NL
    t = t + "        CASE ""split""" + NL
    t = t + "            IF a = ""u"" THEN" + NL
    t = t + "                out.Add(JsS(s))" + NL
    t = t + "            ELSEIF JsStr(a) = """" THEN" + NL
    t = t + "                FOR i = 0 TO n - 1" + NL
    t = t + "                    out.Add(JsS(s.CharAt(i)))" + NL
    t = t + "                NEXT" + NL
    t = t + "            ELSE" + NL
    t = t + "                FOR EACH t IN s.Split(JsStr(a))" + NL
    t = t + "                    out.Add(JsS(t))" + NL
    t = t + "                NEXT" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsO(JsNewArray(out))" + NL
    t = t + "        CASE ""concat""" + NL
    t = t + "            t = s" + NL
    t = t + "            FOR i = 0 TO args.Count - 1" + NL
    t = t + "                t = t + JsStr(args[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsS(t)" + NL
    t = t + "        CASE ""toString"", ""valueOf""" + NL
    t = t + "            RETURN JsS(s)" + NL
    t = t + "        CASE ""bold""" + NL
    t = t + "            RETURN JsS(""<B>"" + s + ""</B>"")" + NL
    t = t + "        CASE ""italics""" + NL
    t = t + "            RETURN JsS(""<I>"" + s + ""</I>"")" + NL
    t = t + "        CASE ""fixed""" + NL
    t = t + "            RETURN JsS(""<TT>"" + s + ""</TT>"")" + NL
    t = t + "        CASE ""big""" + NL
    t = t + "            RETURN JsS(""<BIG>"" + s + ""</BIG>"")" + NL
    t = t + "        CASE ""small""" + NL
    t = t + "            RETURN JsS(""<SMALL>"" + s + ""</SMALL>"")" + NL
    t = t + "        CASE ""blink""" + NL
    t = t + "            RETURN JsS(""<BLINK>"" + s + ""</BLINK>"")" + NL
    t = t + "        CASE ""strike""" + NL
    t = t + "            RETURN JsS(""<STRIKE>"" + s + ""</STRIKE>"")" + NL
    t = t + "        CASE ""sub""" + NL
    t = t + "            RETURN JsS(""<SUB>"" + s + ""</SUB>"")" + NL
    t = t + "        CASE ""sup""" + NL
    t = t + "            RETURN JsS(""<SUP>"" + s + ""</SUP>"")" + NL
    t = t + "        CASE ""fontcolor""" + NL
    t = t + "            RETURN JsS(""<FONT COLOR="""""" + JsStr(a) + """""">"" + s + ""</FONT>"")" + NL
    t = t + "        CASE ""fontsize""" + NL
    t = t + "            RETURN JsS(""<FONT SIZE="""""" + JsStr(a) + """""">"" + s + ""</FONT>"")" + NL
    t = t + "        CASE ""anchor""" + NL
    t = t + "            RETURN JsS(""<A NAME="""""" + JsStr(a) + """""">"" + s + ""</A>"")" + NL
    t = t + "        CASE ""link""" + NL
    t = t + "            RETURN JsS(""<A HREF="""""" + JsStr(a) + """""">"" + s + ""</A>"")" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsArrayMethod (name AS String, id AS Integer, args AS Array OF String) AS String" + NL
    t = t + "    VAR fn AS String" + NL
    t = t + "    VAR self AS String" + NL
    t = t + "    VAR r AS String" + NL
    t = t + "    VAR acc AS String" + NL
    t = t + "    VAR cb AS Array OF String" + NL
    t = t + "    VAR items AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR keys AS Array OF String" + NL
    t = t + "    VAR tmp AS String" + NL
    t = t + "    VAR pair AS Array OF String" + NL
    t = t + "    IF id = 0 OR joClass[id] <> ""Array"" THEN THROW Str(jsLine) + ""|Array object expected""" + NL
    t = t + "    items = JsItems(id)" + NL
    t = t + "    n = items.Count" + NL
    t = t + "    IF ""|forEach|map|filter|some|every|find|findIndex|"".Contains(""|"" + name + ""|"") THEN" + NL
    t = t + "        fn = JsNeedFn(JsArg(args, 0), ""callback"")" + NL
    t = t + "        self = JsThisArg(JsArg(args, 1))" + NL
    t = t + "        FOR i = 0 TO n - 1" + NL
    t = t + "            r = JsCall(fn, self, JsArgs3(items[i], JsN(i), JsO(id)))" + NL
    t = t + "            SELECT CASE name" + NL
    t = t + "                CASE ""map""" + NL
    t = t + "                    out.Add(r)" + NL
    t = t + "                CASE ""filter""" + NL
    t = t + "                    IF JsBool(r) THEN out.Add(items[i])" + NL
    t = t + "                CASE ""some""" + NL
    t = t + "                    IF JsBool(r) THEN RETURN ""t""" + NL
    t = t + "                CASE ""every""" + NL
    t = t + "                    IF NOT JsBool(r) THEN RETURN ""f""" + NL
    t = t + "                CASE ""find""" + NL
    t = t + "                    IF JsBool(r) THEN RETURN items[i]" + NL
    t = t + "                CASE ""findIndex""" + NL
    t = t + "                    IF JsBool(r) THEN RETURN JsN(i)" + NL
    t = t + "            END SELECT" + NL
    t = t + "        NEXT" + NL
    t = t + "        SELECT CASE name" + NL
    t = t + "            CASE ""map"", ""filter""" + NL
    t = t + "                RETURN JsO(JsNewArray(out))" + NL
    t = t + "            CASE ""some""" + NL
    t = t + "                RETURN ""f""" + NL
    t = t + "            CASE ""every""" + NL
    t = t + "                RETURN ""t""" + NL
    t = t + "            CASE ""findIndex""" + NL
    t = t + "                RETURN ""n-1""" + NL
    t = t + "        END SELECT" + NL
    t = t + "        RETURN ""u""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF name = ""reduce"" OR name = ""reduceRight"" THEN" + NL
    t = t + "        fn = JsNeedFn(JsArg(args, 0), ""callback"")" + NL
    t = t + "        IF name = ""reduceRight"" THEN items.Reverse()" + NL
    t = t + "        k = 0" + NL
    t = t + "        IF args.Count > 1 THEN" + NL
    t = t + "            acc = args[1]" + NL
    t = t + "        ELSE" + NL
    t = t + "            IF n = 0 THEN" + NL
    t = t + "                jsThrown = JsMakeTypedError(""TypeError"", ""Reduce of empty array with no initial value"")" + NL
    t = t + "                THROW Str(jsLine) + ""|@thrown""" + NL
    t = t + "            END IF" + NL
    t = t + "            acc = items[0]" + NL
    t = t + "            k = 1" + NL
    t = t + "        END IF" + NL
    t = t + "        FOR i = k TO n - 1" + NL
    t = t + "            cb.Clear()" + NL
    t = t + "            cb.Add(acc)" + NL
    t = t + "            cb.Add(items[i])" + NL
    t = t + "            IF name = ""reduceRight"" THEN" + NL
    t = t + "                cb.Add(JsN(n - 1 - i))" + NL
    t = t + "            ELSE" + NL
    t = t + "                cb.Add(JsN(i))" + NL
    t = t + "            END IF" + NL
    t = t + "            cb.Add(JsO(id))" + NL
    t = t + "            acc = JsCall(fn, JsO(jsGlobal), cb)" + NL
    t = t + "        NEXT" + NL
    t = t + "        RETURN acc" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""includes""" + NL
    t = t + "            v = JsArg(args, 0)" + NL
    t = t + "            FOR i = 0 TO n - 1" + NL
    t = t + "                IF JsStrictEq(items[i], v) THEN RETURN ""t""" + NL
    t = t + "                IF v.StartsWith(""n"") AND items[i].StartsWith(""n"") AND JsNum(v) = ""NaN"" AND JsNum(items[i]) = ""NaN"" THEN RETURN ""t""" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN ""f""" + NL
    t = t + "        CASE ""lastIndexOf""" + NL
    t = t + "            FOR i = n - 1 TO 0 STEP -1" + NL
    t = t + "                IF JsStrictEq(items[i], JsArg(args, 0)) THEN RETURN JsN(i)" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN ""n-1""" + NL
    t = t + "        CASE ""fill""" + NL
    t = t + "            j = 0" + NL
    t = t + "            IF args.Count > 1 THEN j = JsInt(args[1])" + NL
    t = t + "            IF j < 0 THEN j = MATH.Max(0, n + j)" + NL
    t = t + "            k = n" + NL
    t = t + "            IF args.Count > 2 AND args[2] <> ""u"" THEN k = JsInt(args[2])" + NL
    t = t + "            IF k < 0 THEN k = MATH.Max(0, n + k)" + NL
    t = t + "            FOR i = j TO MATH.Min(k, n) - 1" + NL
    t = t + "                JsPutOwn(id, Str(i), JsArg(args, 0))" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsO(id)" + NL
    t = t + "    END SELECT" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""join""" + NL
    t = t + "            IF JsArg(args, 0) = ""u"" THEN RETURN JsS(JsJoin(id, "",""))" + NL
    t = t + "            RETURN JsS(JsJoin(id, JsStr(args[0])))" + NL
    t = t + "        CASE ""toString""" + NL
    t = t + "            RETURN JsS(JsJoin(id, "",""))" + NL
    t = t + "        CASE ""push""" + NL
    t = t + "            FOR i = 0 TO args.Count - 1" + NL
    t = t + "                JsPutOwn(id, Str(n + i), args[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            JsPutOwn(id, ""length"", JsN(n + args.Count))" + NL
    t = t + "            RETURN JsN(n + args.Count)" + NL
    t = t + "        CASE ""pop""" + NL
    t = t + "            IF n = 0 THEN RETURN ""u""" + NL
    t = t + "            v = items[n - 1]" + NL
    t = t + "            JsSetLength(id, n - 1)" + NL
    t = t + "            RETURN v" + NL
    t = t + "        CASE ""shift""" + NL
    t = t + "            IF n = 0 THEN RETURN ""u""" + NL
    t = t + "            v = items[0]" + NL
    t = t + "            FOR i = 1 TO n - 1" + NL
    t = t + "                JsPutOwn(id, Str(i - 1), items[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            JsSetLength(id, n - 1)" + NL
    t = t + "            RETURN v" + NL
    t = t + "        CASE ""unshift""" + NL
    t = t + "            FOR i = 0 TO args.Count - 1" + NL
    t = t + "                out.Add(args[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            FOR EACH v IN items" + NL
    t = t + "                out.Add(v)" + NL
    t = t + "            NEXT" + NL
    t = t + "            FOR i = 0 TO out.Count - 1" + NL
    t = t + "                JsPutOwn(id, Str(i), out[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            JsPutOwn(id, ""length"", JsN(out.Count))" + NL
    t = t + "            RETURN JsN(out.Count)" + NL
    t = t + "        CASE ""reverse""" + NL
    t = t + "            FOR i = 0 TO n - 1" + NL
    t = t + "                JsPutOwn(id, Str(i), items[n - 1 - i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsO(id)" + NL
    t = t + "        CASE ""concat""" + NL
    t = t + "            FOR EACH v IN items" + NL
    t = t + "                out.Add(v)" + NL
    t = t + "            NEXT" + NL
    t = t + "            FOR i = 0 TO args.Count - 1" + NL
    t = t + "                IF args[i].StartsWith(""o"") AND joClass[JsId(args[i])] = ""Array"" THEN" + NL
    t = t + "                    FOR EACH v IN JsItems(JsId(args[i]))" + NL
    t = t + "                        out.Add(v)" + NL
    t = t + "                    NEXT" + NL
    t = t + "                ELSE" + NL
    t = t + "                    out.Add(args[i])" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsO(JsNewArray(out))" + NL
    t = t + "        CASE ""slice""" + NL
    t = t + "            i = JsInt(JsArg(args, 0))" + NL
    t = t + "            IF i < 0 THEN i = MATH.Max(0, n + i)" + NL
    t = t + "            j = n" + NL
    t = t + "            IF JsArg(args, 1) <> ""u"" THEN j = JsInt(args[1])" + NL
    t = t + "            IF j < 0 THEN j = MATH.Max(0, n + j)" + NL
    t = t + "            FOR k = i TO MATH.Min(j, n) - 1" + NL
    t = t + "                out.Add(items[k])" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsO(JsNewArray(out))" + NL
    t = t + "        CASE ""splice""" + NL
    t = t + "            i = JsInt(JsArg(args, 0))" + NL
    t = t + "            IF i < 0 THEN i = MATH.Max(0, n + i)" + NL
    t = t + "            IF i > n THEN i = n" + NL
    t = t + "            k = n - i" + NL
    t = t + "            IF args.Count > 1 THEN k = MATH.Max(0, MATH.Min(JsInt(args[1]), n - i))" + NL
    t = t + "            FOR j = i TO i + k - 1" + NL
    t = t + "                out.Add(items[j])" + NL
    t = t + "            NEXT" + NL
    t = t + "            FOR j = 0 TO i - 1" + NL
    t = t + "                keys.Add(items[j])" + NL
    t = t + "            NEXT" + NL
    t = t + "            FOR j = 2 TO args.Count - 1" + NL
    t = t + "                keys.Add(args[j])" + NL
    t = t + "            NEXT" + NL
    t = t + "            FOR j = i + k TO n - 1" + NL
    t = t + "                keys.Add(items[j])" + NL
    t = t + "            NEXT" + NL
    t = t + "            FOR j = 0 TO keys.Count - 1" + NL
    t = t + "                JsPutOwn(id, Str(j), keys[j])" + NL
    t = t + "            NEXT" + NL
    t = t + "            JsSetLength(id, keys.Count)" + NL
    t = t + "            RETURN JsO(JsNewArray(out))" + NL
    t = t + "        CASE ""indexOf""" + NL
    t = t + "            FOR i = 0 TO n - 1" + NL
    t = t + "                IF JsStrictEq(items[i], JsArg(args, 0)) THEN RETURN JsN(i)" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN ""n-1""" + NL
    t = t + "        CASE ""sort""" + NL
    t = t + "            IF JsCallable(JsArg(args, 0)) THEN" + NL
    t = t + "                ' insertion sort with the page's own comparison" + NL
    t = t + "                FOR i = 1 TO n - 1" + NL
    t = t + "                    v = items[i]" + NL
    t = t + "                    j = i - 1" + NL
    t = t + "                    WHILE j >= 0" + NL
    t = t + "                        pair.Clear()" + NL
    t = t + "                        pair.Add(items[j])" + NL
    t = t + "                        pair.Add(v)" + NL
    t = t + "                        IF JsReal(JsCall(args[0], JsO(jsGlobal), pair)) <= 0 THEN BREAK" + NL
    t = t + "                        items[j + 1] = items[j]" + NL
    t = t + "                        j = j - 1" + NL
    t = t + "                    END WHILE" + NL
    t = t + "                    items[j + 1] = v" + NL
    t = t + "                NEXT" + NL
    t = t + "            ELSE" + NL
    t = t + "                ' as text: sort ""text<tab>index"" and read the order back" + NL
    t = t + "                FOR i = 0 TO n - 1" + NL
    t = t + "                    IF items[i] = ""u"" THEN" + NL
    t = t + "                        keys.Add(Chr(65535) + Chr(9) + Str(i))" + NL
    t = t + "                    ELSE" + NL
    t = t + "                        keys.Add(JsStr(items[i]) + Chr(9) + Str(i))" + NL
    t = t + "                    END IF" + NL
    t = t + "                NEXT" + NL
    t = t + "                keys.Sort()" + NL
    t = t + "                FOR EACH tmp IN keys" + NL
    t = t + "                    out.Add(items[Int(Val(tmp.Split(Chr(9))[tmp.Split(Chr(9)).Count - 1]))])" + NL
    t = t + "                NEXT" + NL
    t = t + "                items = out" + NL
    t = t + "            END IF" + NL
    t = t + "            FOR i = 0 TO n - 1" + NL
    t = t + "                JsPutOwn(id, Str(i), items[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsO(id)" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsDateMethod (name AS String, thisVal AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR ms AS Real" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR y AS Real" + NL
    t = t + "    VAR mon AS Real" + NL
    t = t + "    VAR d AS Real" + NL
    t = t + "    VAR h AS Real" + NL
    t = t + "    VAR mi AS Real" + NL
    t = t + "    VAR sec AS Real" + NL
    t = t + "    VAR part AS Real" + NL
    t = t + "    id = JsId(thisVal)" + NL
    t = t + "    IF id = 0 OR joClass[id] <> ""Date"" THEN THROW Str(jsLine) + ""|Date object expected""" + NL
    t = t + "    IF joS[id] = ""NaN"" THEN RETURN ""nNaN""" + NL
    t = t + "    ms = Val(joS[id])" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""getTime"", ""valueOf""" + NL
    t = t + "            RETURN JsN(ms)" + NL
    t = t + "        CASE ""getFullYear""" + NL
    t = t + "            RETURN JsN(JsDatePart(ms, ""year""))" + NL
    t = t + "        CASE ""getYear""" + NL
    t = t + "            ' the famous quirk of 1996 browsers: 96 for 1996, but 2001 for 2001" + NL
    t = t + "            IF JsDatePart(ms, ""year"") >= 1900 AND JsDatePart(ms, ""year"") < 2000 THEN RETURN JsN(JsDatePart(ms, ""year"") - 1900)" + NL
    t = t + "            RETURN JsN(JsDatePart(ms, ""year""))" + NL
    t = t + "        CASE ""getMonth""" + NL
    t = t + "            RETURN JsN(JsDatePart(ms, ""month""))" + NL
    t = t + "        CASE ""getDate""" + NL
    t = t + "            RETURN JsN(JsDatePart(ms, ""date""))" + NL
    t = t + "        CASE ""getDay""" + NL
    t = t + "            RETURN JsN(JsDatePart(ms, ""day""))" + NL
    t = t + "        CASE ""getHours""" + NL
    t = t + "            RETURN JsN(JsDatePart(ms, ""hours""))" + NL
    t = t + "        CASE ""getMinutes""" + NL
    t = t + "            RETURN JsN(JsDatePart(ms, ""minutes""))" + NL
    t = t + "        CASE ""getSeconds""" + NL
    t = t + "            RETURN JsN(JsDatePart(ms, ""seconds""))" + NL
    t = t + "        CASE ""getMilliseconds""" + NL
    t = t + "            RETURN JsN(JsDatePart(ms, ""ms""))" + NL
    t = t + "        CASE ""getTimezoneOffset""" + NL
    t = t + "            RETURN JsN(-JsZone() / 60)" + NL
    t = t + "        CASE ""toString"", ""toLocaleString"", ""toGMTString"", ""toUTCString""" + NL
    t = t + "            RETURN JsS(JsDateText(ms))" + NL
    t = t + "        CASE ""setTime""" + NL
    t = t + "            joS[id] = JsNum(JsArg(args, 0))" + NL
    t = t + "            RETURN ""n"" + joS[id]" + NL
    t = t + "        CASE ""setFullYear"", ""setYear"", ""setMonth"", ""setDate"", ""setHours"", ""setMinutes"", ""setSeconds"", ""setMilliseconds""" + NL
    t = t + "            y = JsDatePart(ms, ""year"")" + NL
    t = t + "            mon = JsDatePart(ms, ""month"")" + NL
    t = t + "            d = JsDatePart(ms, ""date"")" + NL
    t = t + "            h = JsDatePart(ms, ""hours"")" + NL
    t = t + "            mi = JsDatePart(ms, ""minutes"")" + NL
    t = t + "            sec = JsDatePart(ms, ""seconds"")" + NL
    t = t + "            part = JsDatePart(ms, ""ms"")" + NL
    t = t + "            IF NOT JsFinite(JsNum(JsArg(args, 0))) THEN" + NL
    t = t + "                joS[id] = ""NaN""" + NL
    t = t + "                RETURN ""nNaN""" + NL
    t = t + "            END IF" + NL
    t = t + "            SELECT CASE name" + NL
    t = t + "                CASE ""setFullYear"", ""setYear""" + NL
    t = t + "                    y = JsReal(args[0])" + NL
    t = t + "                    IF name = ""setYear"" AND y >= 0 AND y < 100 THEN y = y + 1900" + NL
    t = t + "                CASE ""setMonth""" + NL
    t = t + "                    mon = JsReal(args[0])" + NL
    t = t + "                CASE ""setDate""" + NL
    t = t + "                    d = JsReal(args[0])" + NL
    t = t + "                CASE ""setHours""" + NL
    t = t + "                    h = JsReal(args[0])" + NL
    t = t + "                CASE ""setMinutes""" + NL
    t = t + "                    mi = JsReal(args[0])" + NL
    t = t + "                CASE ""setSeconds""" + NL
    t = t + "                    sec = JsReal(args[0])" + NL
    t = t + "                CASE ""setMilliseconds""" + NL
    t = t + "                    part = JsReal(args[0])" + NL
    t = t + "            END SELECT" + NL
    t = t + "            joS[id] = JsFmt(JsLocalMs(y, mon, d, h, mi, sec, part))" + NL
    t = t + "            RETURN ""n"" + joS[id]" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- XMLHttpRequest" + NL
    t = t + "'" + NL
    t = t + "' An XMLHttpRequest is an object of class XHR. Besides what the page sees" + NL
    t = t + "' (readyState, status, statusText, responseText, the handlers) it keeps" + NL
    t = t + "' hidden properties: @method, @url, @headers (one ""Name: value"" a line) and" + NL
    t = t + "' @rheaders for the response's, and @req, the browser's number for the" + NL
    t = t + "' request on its way (0 when there is none). fetch() makes one too, with" + NL
    t = t + "' @promise, the promise it answers." + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNewXhr () AS Integer" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    id = JsNewObject(""XHR"", jsXhrProto)" + NL
    t = t + "    JsPutOwn(id, ""readyState"", ""n0"")" + NL
    t = t + "    JsPutOwn(id, ""status"", ""n0"")" + NL
    t = t + "    JsPutOwn(id, ""statusText"", ""s"")" + NL
    t = t + "    JsPutOwn(id, ""responseText"", ""s"")" + NL
    t = t + "    JsPutOwn(id, ""responseXML"", ""l"")" + NL
    t = t + "    JsPutOwn(id, ""onreadystatechange"", ""l"")" + NL
    t = t + "    JsPutOwn(id, ""onload"", ""l"")" + NL
    t = t + "    JsPutOwn(id, ""onerror"", ""l"")" + NL
    t = t + "    JsPutOwn(id, ""@req"", ""n0"")" + NL
    t = t + "    JsPutOwn(id, ""@headers"", ""s"")" + NL
    t = t + "    JsPutOwn(id, ""@rheaders"", ""s"")" + NL
    t = t + "    RETURN id" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' readyState becomes state, and onreadystatechange hears of it." + NL
    t = t + "SUB JsXhrState (id AS Integer, state AS Integer)" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    VAR fn AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    JsPutOwn(id, ""readyState"", JsN(state))" + NL
    t = t + "    fn = JsGetProp(id, ""onreadystatechange"")" + NL
    t = t + "    IF JsCallable(fn) THEN v = JsCall(fn, JsO(id), none)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsXhrMethod (name AS String, thisVal AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR body AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR want AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    id = JsId(thisVal)" + NL
    t = t + "    IF id = 0 OR joClass[id] <> ""XHR"" THEN THROW Str(jsLine) + ""|Object expected""" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""open""" + NL
    t = t + "            ' A script cannot stop and wait for the network: the browser fetches" + NL
    t = t + "            ' between scripts, a tick at a time" + NL
    t = t + "            IF args.Count > 2 THEN" + NL
    t = t + "                IF args[2] <> ""u"" AND NOT JsBool(args[2]) THEN THROW Str(jsLine) + ""|Simxplorer cannot wait for the network in the middle of a script. Use open(method, url, true) and onreadystatechange""" + NL
    t = t + "            END IF" + NL
    t = t + "            IF JsInt(JsGetProp(id, ""@req"")) > 0 THEN HostXhrAbort(JsInt(JsGetProp(id, ""@req"")))" + NL
    t = t + "            JsPutOwn(id, ""@method"", JsS(JsStr(JsArg(args, 0)).Upper()))" + NL
    t = t + "            JsPutOwn(id, ""@url"", JsS(JsStr(JsArg(args, 1))))" + NL
    t = t + "            JsPutOwn(id, ""@headers"", ""s"")" + NL
    t = t + "            JsPutOwn(id, ""@rheaders"", ""s"")" + NL
    t = t + "            JsPutOwn(id, ""@req"", ""n0"")" + NL
    t = t + "            JsPutOwn(id, ""status"", ""n0"")" + NL
    t = t + "            JsPutOwn(id, ""statusText"", ""s"")" + NL
    t = t + "            JsPutOwn(id, ""responseText"", ""s"")" + NL
    t = t + "            JsXhrState(id, 1)" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""setRequestHeader""" + NL
    t = t + "            IF JsInt(JsGetProp(id, ""readyState"")) <> 1 OR JsInt(JsGetProp(id, ""@req"")) <> 0 THEN THROW Str(jsLine) + ""|Unspecified error""" + NL
    t = t + "            line = JsStr(JsArg(args, 0)).Replace(Chr(10), """").Replace(Chr(13), """") + "": "" + JsStr(JsArg(args, 1)).Replace(Chr(10), "" "").Replace(Chr(13), """")" + NL
    t = t + "            JsPutOwn(id, ""@headers"", JsS(JsStr(JsGetProp(id, ""@headers"")) + line + Chr(10)))" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""send""" + NL
    t = t + "            IF JsInt(JsGetProp(id, ""readyState"")) <> 1 OR JsInt(JsGetProp(id, ""@req"")) <> 0 THEN THROW Str(jsLine) + ""|Unspecified error""" + NL
    t = t + "            IF args.Count > 0 THEN" + NL
    t = t + "                IF args[0] <> ""u"" AND args[0] <> ""l"" THEN body = JsStr(args[0])" + NL
    t = t + "            END IF" + NL
    t = t + "            JsPutOwn(id, ""@req"", JsN(HostXhrSend(JsStr(JsGetProp(id, ""@method"")), JsStr(JsGetProp(id, ""@url"")), JsStr(JsGetProp(id, ""@headers"")), body, id)))" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""abort""" + NL
    t = t + "            IF JsInt(JsGetProp(id, ""@req"")) > 0 THEN HostXhrAbort(JsInt(JsGetProp(id, ""@req"")))" + NL
    t = t + "            JsPutOwn(id, ""@req"", ""n0"")" + NL
    t = t + "            JsPutOwn(id, ""readyState"", ""n0"")" + NL
    t = t + "            JsPutOwn(id, ""status"", ""n0"")" + NL
    t = t + "            JsPutOwn(id, ""responseText"", ""s"")" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""getResponseHeader""" + NL
    t = t + "            want = JsStr(JsArg(args, 0)).Lower().Trim() + "":""" + NL
    t = t + "            FOR EACH line IN JsStr(JsGetProp(id, ""@rheaders"")).Split(Chr(10))" + NL
    t = t + "                IF line.Lower().StartsWith(want) THEN RETURN JsS(line.Substring(want.Length, line.Length - want.Length).Trim())" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN ""l""" + NL
    t = t + "        CASE ""getAllResponseHeaders""" + NL
    t = t + "            FOR EACH line IN JsStr(JsGetProp(id, ""@rheaders"")).Split(Chr(10))" + NL
    t = t + "                IF line <> """" THEN out.Add(line)" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF out.Count = 0 THEN RETURN ""s""" + NL
    t = t + "            RETURN JsS(out.Join(Chr(13) + Chr(10)) + Chr(13) + Chr(10))" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The browser's news of request req, which XMLHttpRequest id made: readyState" + NL
    t = t + "' 2, 3 or 4 (at 4, status 0 means it failed). Runs the page's handlers, and" + NL
    t = t + "' settles fetch()'s promise. Returns """" or an error (""line|message"")." + NL
    t = t + "FUNCTION JsXhrUpdate (id AS Integer, req AS Integer, state AS Integer, status AS Integer, statusText AS String, headers AS String, body AS String) AS String" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    VAR fn AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    jsDepth = 0" + NL
    t = t + "    jsSteps = 0" + NL
    t = t + "    jsLimit = JSSTEPLIMIT" + NL
    t = t + "    jsThrown = """"" + NL
    t = t + "    IF id <= 0 OR id >= joClass.Count THEN RETURN """"" + NL
    t = t + "    IF joClass[id] <> ""XHR"" THEN RETURN """"" + NL
    t = t + "    ' aborted, or opened again since" + NL
    t = t + "    IF JsInt(JsGetProp(id, ""@req"")) <> req THEN RETURN """"" + NL
    t = t + "    TRY" + NL
    t = t + "        JsPutOwn(id, ""status"", JsN(status))" + NL
    t = t + "        JsPutOwn(id, ""statusText"", JsS(statusText))" + NL
    t = t + "        JsPutOwn(id, ""@rheaders"", JsS(headers))" + NL
    t = t + "        JsPutOwn(id, ""responseText"", JsS(body))" + NL
    t = t + "        IF state = 4 THEN JsPutOwn(id, ""@req"", ""n0"")" + NL
    t = t + "        JsXhrState(id, state)" + NL
    t = t + "        IF state = 4 THEN" + NL
    t = t + "            IF JsGetProp(id, ""@promise"").StartsWith(""o"") THEN JsFetched(id, JsId(JsGetProp(id, ""@promise"")), status, statusText, body)" + NL
    t = t + "            IF status = 0 THEN" + NL
    t = t + "                fn = JsGetProp(id, ""onerror"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                fn = JsGetProp(id, ""onload"")" + NL
    t = t + "            END IF" + NL
    t = t + "            IF JsCallable(fn) THEN v = JsCall(fn, JsO(id), none)" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "        RETURN JsTidyError(err)" + NL
    t = t + "    END TRY" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' fetch(url[, {method, body, headers}]): a promise of a response." + NL
    t = t + "FUNCTION JsFetch (args AS Array OF String) AS String" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    VAR p AS Integer" + NL
    t = t + "    VAR init AS String" + NL
    t = t + "    VAR method AS String" + NL
    t = t + "    VAR body AS String" + NL
    t = t + "    VAR headers AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    method = ""GET""" + NL
    t = t + "    init = JsArg(args, 1)" + NL
    t = t + "    IF init.StartsWith(""o"") THEN" + NL
    t = t + "        IF JsGet(init, ""method"") <> ""u"" THEN method = JsStr(JsGet(init, ""method"")).Upper()" + NL
    t = t + "        IF JsGet(init, ""body"") <> ""u"" AND JsGet(init, ""body"") <> ""l"" THEN body = JsStr(JsGet(init, ""body""))" + NL
    t = t + "        h = JsGet(init, ""headers"")" + NL
    t = t + "        IF h.StartsWith(""o"") THEN" + NL
    t = t + "            FOR EACH key IN joKeys[JsId(h)].Split(""|"")" + NL
    t = t + "                IF key <> """" THEN headers = headers + key + "": "" + JsStr(JsGet(h, key)) + Chr(10)" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    x = JsNewXhr()" + NL
    t = t + "    p = JsNewPromise()" + NL
    t = t + "    JsPutOwn(x, ""@promise"", JsO(p))" + NL
    t = t + "    JsPutOwn(x, ""@method"", JsS(method))" + NL
    t = t + "    JsPutOwn(x, ""@url"", JsS(JsStr(JsArg(args, 0))))" + NL
    t = t + "    JsPutOwn(x, ""readyState"", ""n1"")" + NL
    t = t + "    JsPutOwn(x, ""@req"", JsN(HostXhrSend(method, JsStr(JsArg(args, 0)), headers, body, x)))" + NL
    t = t + "    RETURN JsO(p)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' fetch()'s answer: a Response, or (when nothing came back) a rejection." + NL
    t = t + "SUB JsFetched (x AS Integer, p AS Integer, status AS Integer, statusText AS String, body AS String)" + NL
    t = t + "    VAR r AS Integer" + NL
    t = t + "    VAR hd AS Integer" + NL
    t = t + "    IF status = 0 THEN" + NL
    t = t + "        JsResolve(p, FALSE, JsMakeError(""0|Failed to fetch "" + JsStr(JsGetProp(x, ""@url""))))" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    r = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsPutOwn(r, ""status"", JsN(status))" + NL
    t = t + "    JsPutOwn(r, ""statusText"", JsS(statusText))" + NL
    t = t + "    JsPutOwn(r, ""ok"", JsB(status >= 200 AND status < 300))" + NL
    t = t + "    JsPutOwn(r, ""url"", JsGetProp(x, ""@url""))" + NL
    t = t + "    JsPutOwn(r, ""@body"", JsS(body))" + NL
    t = t + "    JsPutOwn(r, ""text"", JsNative(""Response.text""))" + NL
    t = t + "    JsPutOwn(r, ""json"", JsNative(""Response.json""))" + NL
    t = t + "    hd = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsPutOwn(hd, ""@xhr"", JsO(x))" + NL
    t = t + "    JsPutOwn(hd, ""get"", JsNative(""Response.header""))" + NL
    t = t + "    JsPutOwn(r, ""headers"", JsO(hd))" + NL
    t = t + "    JsResolve(p, TRUE, JsO(r))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- promises, small ones" + NL
    t = t + "'" + NL
    t = t + "' Enough for fetch(url).then(function (r) { return r.text(); }).then(...):" + NL
    t = t + "' then and catch, chaining, and a callback's thenable followed. @state is" + NL
    t = t + "' pending, ok or err; @value what it settled with; @then the callbacks" + NL
    t = t + "' waiting, three to an entry (on ok, on err, the promise then() returned)." + NL
    t = t + "' Callbacks run as soon as there is something to give them." + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNewPromise () AS Integer" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    id = JsNewObject(""Promise"", jsPromiseProto)" + NL
    t = t + "    JsPutOwn(id, ""@state"", ""spending"")" + NL
    t = t + "    JsPutOwn(id, ""@value"", ""u"")" + NL
    t = t + "    JsPutOwn(id, ""@then"", JsO(JsNewArray(none)))" + NL
    t = t + "    RETURN id" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A function that settles promise p (kind ""ok"" or ""err"") with its argument." + NL
    t = t + "FUNCTION JsSettler (p AS Integer, kind AS String) AS String" + NL
    t = t + "    RETURN JsNative(""Promise.settle:"" + kind + "":"" + Str(p))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JsResolve (p AS Integer, ok AS Bool, v AS String)" + NL
    t = t + "    VAR args AS Array OF String" + NL
    t = t + "    VAR fn AS String" + NL
    t = t + "    VAR r AS String" + NL
    t = t + "    VAR waiting AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    IF JsGetProp(p, ""@state"") <> ""spending"" THEN RETURN" + NL
    t = t + "    ' a thenable is followed: p ends as it does" + NL
    t = t + "    IF ok AND v.StartsWith(""o"") AND JsId(v) <> p THEN" + NL
    t = t + "        fn = JsGet(v, ""then"")" + NL
    t = t + "        IF JsCallable(fn) THEN" + NL
    t = t + "            args.Add(JsSettler(p, ""ok""))" + NL
    t = t + "            args.Add(JsSettler(p, ""err""))" + NL
    t = t + "            r = JsCall(fn, v, args)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ok THEN" + NL
    t = t + "        JsPutOwn(p, ""@state"", ""sok"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        JsPutOwn(p, ""@state"", ""serr"")" + NL
    t = t + "    END IF" + NL
    t = t + "    JsPutOwn(p, ""@value"", v)" + NL
    t = t + "    waiting = JsItems(JsId(JsGetProp(p, ""@then"")))" + NL
    t = t + "    JsPutOwn(p, ""@then"", JsO(JsNewArray(none)))" + NL
    t = t + "    i = 0" + NL
    t = t + "    WHILE i + 2 < waiting.Count" + NL
    t = t + "        JsQueueThen(p, waiting[i], waiting[i + 1], JsId(waiting[i + 2]))" + NL
    t = t + "        i = i + 3" + NL
    t = t + "    END WHILE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A settled promise p gives its value to the callback that fits; what that" + NL
    t = t + "' returns (or throws) settles child." + NL
    t = t + "SUB JsRunThen (p AS Integer, onOk AS String, onErr AS String, child AS Integer)" + NL
    t = t + "    VAR ok AS Bool" + NL
    t = t + "    VAR fn AS String" + NL
    t = t + "    VAR args AS Array OF String" + NL
    t = t + "    VAR r AS String" + NL
    t = t + "    VAR depth AS Integer" + NL
    t = t + "    VAR failed AS Bool" + NL
    t = t + "    ok = JsGetProp(p, ""@state"") = ""sok""" + NL
    t = t + "    fn = onErr" + NL
    t = t + "    IF ok THEN fn = onOk" + NL
    t = t + "    IF NOT JsCallable(fn) THEN" + NL
    t = t + "        JsResolve(child, ok, JsGetProp(p, ""@value""))" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    args.Add(JsGetProp(p, ""@value""))" + NL
    t = t + "    depth = jsDepth" + NL
    t = t + "    TRY" + NL
    t = t + "        r = JsCall(fn, JsO(jsGlobal), args)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        jsDepth = depth" + NL
    t = t + "        IF err.Contains(""@aborted"") THEN THROW err" + NL
    t = t + "        IF jsThrown <> """" THEN" + NL
    t = t + "            r = jsThrown" + NL
    t = t + "        ELSE" + NL
    t = t + "            r = JsMakeError(err)" + NL
    t = t + "        END IF" + NL
    t = t + "        jsThrown = """"" + NL
    t = t + "        jsSig = """"" + NL
    t = t + "        failed = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "    JsResolve(child, NOT failed, r)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsPromiseMethod (name AS String, thisVal AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR child AS Integer" + NL
    t = t + "    VAR list AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR want AS String" + NL
    t = t + "    VAR code AS Array OF String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    id = JsId(thisVal)" + NL
    t = t + "    IF name.StartsWith(""Promise.settle:"") THEN" + NL
    t = t + "        parts = name.Split("":"")" + NL
    t = t + "        JsResolve(Int(Val(parts[2])), parts[1] = ""ok"", JsArg(args, 0))" + NL
    t = t + "        RETURN ""u""" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""Promise.then"", ""Promise.catch""" + NL
    t = t + "            IF id = 0 OR joClass[id] <> ""Promise"" THEN THROW Str(jsLine) + ""|Object expected""" + NL
    t = t + "            child = JsNewPromise()" + NL
    t = t + "            IF name = ""Promise.catch"" THEN" + NL
    t = t + "                args.Insert(0, ""u"")" + NL
    t = t + "            END IF" + NL
    t = t + "            IF JsGetProp(id, ""@state"") = ""spending"" THEN" + NL
    t = t + "                list = JsId(JsGetProp(id, ""@then""))" + NL
    t = t + "                n = JsInt(JsGetProp(list, ""length""))" + NL
    t = t + "                JsPutOwn(list, Str(n), JsArg(args, 0))" + NL
    t = t + "                JsPutOwn(list, Str(n + 1), JsArg(args, 1))" + NL
    t = t + "                JsPutOwn(list, Str(n + 2), JsO(child))" + NL
    t = t + "                JsPutOwn(list, ""length"", JsN(n + 3))" + NL
    t = t + "            ELSE" + NL
    t = t + "                JsQueueThen(id, JsArg(args, 0), JsArg(args, 1), child)" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsO(child)" + NL
    t = t + "        CASE ""Response.text""" + NL
    t = t + "            child = JsNewPromise()" + NL
    t = t + "            JsResolve(child, TRUE, JsGet(thisVal, ""@body""))" + NL
    t = t + "            RETURN JsO(child)" + NL
    t = t + "        CASE ""Response.json""" + NL
    t = t + "            ' JSON is JavaScript, so eval reads it" + NL
    t = t + "            child = JsNewPromise()" + NL
    t = t + "            code.Add(JsS(""("" + JsStr(JsGet(thisVal, ""@body"")) + "")""))" + NL
    t = t + "            TRY" + NL
    t = t + "                v = JsEvalCode(code, jsGlobal)" + NL
    t = t + "            CATCH err" + NL
    t = t + "                JsResolve(child, FALSE, JsMakeError(err))" + NL
    t = t + "                RETURN JsO(child)" + NL
    t = t + "            END TRY" + NL
    t = t + "            JsResolve(child, TRUE, v)" + NL
    t = t + "            RETURN JsO(child)" + NL
    t = t + "        CASE ""Response.header""" + NL
    t = t + "            want = JsStr(JsArg(args, 0)).Lower().Trim() + "":""" + NL
    t = t + "            FOR EACH line IN JsStr(JsGetProp(JsId(JsGet(thisVal, ""@xhr"")), ""@rheaders"")).Split(Chr(10))" + NL
    t = t + "                IF line.Lower().StartsWith(want) THEN RETURN JsS(line.Substring(want.Length, line.Length - want.Length).Trim())" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN ""l""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- patterns, block scopes and classes" + NL
    t = t + "" + NL
    t = t + "' The names a var/let declaration (or a class) makes." + NL
    t = t + "FUNCTION JsDeclNames (n AS Integer) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    IF nk[n] = ""classdecl"" THEN" + NL
    t = t + "        out.Add(ns[n])" + NL
    t = t + "        RETURN out" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "        IF item = """" THEN CONTINUE" + NL
    t = t + "        d = Int(Val(item))" + NL
    t = t + "        IF nb[d] <> 0 THEN" + NL
    t = t + "            FOR EACH name IN JsPatternNames(nb[d])" + NL
    t = t + "                out.Add(name)" + NL
    t = t + "            NEXT" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(ns[d])" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsPatternNames (t AS Integer) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF t = 0 THEN RETURN out" + NL
    t = t + "    SELECT CASE nk[t]" + NL
    t = t + "        CASE ""pname""" + NL
    t = t + "            out.Add(ns[t])" + NL
    t = t + "        CASE ""pobj"", ""parr"", ""params""" + NL
    t = t + "            FOR EACH item IN nl[t].Split("","")" + NL
    t = t + "                IF item = """" OR item = ""0"" THEN CONTINUE" + NL
    t = t + "                k = Int(Val(item))" + NL
    t = t + "                IF nk[k] = ""pprop"" THEN k = nb[k]" + NL
    t = t + "                FOR EACH name IN JsPatternNames(k)" + NL
    t = t + "                    out.Add(name)" + NL
    t = t + "                NEXT" + NL
    t = t + "            NEXT" + NL
    t = t + "            FOR EACH name IN JsPatternNames(nc[t])" + NL
    t = t + "                out.Add(name)" + NL
    t = t + "            NEXT" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The values for ... and for-of: an array's items, a string's characters," + NL
    t = t + "' or anything with a length." + NL
    t = t + "FUNCTION JsIterate (v AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    IF v.StartsWith(""s"") THEN" + NL
    t = t + "        text = v.Substring(1, v.Length - 1)" + NL
    t = t + "        FOR i = 0 TO text.Length - 1" + NL
    t = t + "            out.Add(JsS(text.CharAt(i)))" + NL
    t = t + "        NEXT" + NL
    t = t + "        RETURN out" + NL
    t = t + "    END IF" + NL
    t = t + "    IF v.StartsWith(""o"") THEN" + NL
    t = t + "        IF joClass[JsId(v)] = ""Array"" THEN RETURN JsItems(JsId(v))" + NL
    t = t + "        IF JsGet(v, ""length"").StartsWith(""n"") THEN" + NL
    t = t + "            FOR i = 0 TO JsInt(JsGet(v, ""length"")) - 1" + NL
    t = t + "                out.Add(JsGet(v, Str(i)))" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN out" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    jsThrown = JsMakeTypedError(""TypeError"", JsStr(JsS(JsTypeOf(v))) + "" is not iterable"")" + NL
    t = t + "    THROW Str(jsLine) + ""|@thrown""" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' v put into target t: a name, or a pattern taking v apart." + NL
    t = t + "SUB JsBind (t AS Integer, v AS String, scope AS Integer)" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR used AS String" + NL
    t = t + "    VAR items AS Array OF String" + NL
    t = t + "    VAR rest AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    IF v = ""u"" AND na[t] <> 0 THEN v = JsEval(na[t], scope)" + NL
    t = t + "    SELECT CASE nk[t]" + NL
    t = t + "        CASE ""pname""" + NL
    t = t + "            JsSetVar(ns[t], v, scope)" + NL
    t = t + "        CASE ""pobj""" + NL
    t = t + "            IF v = ""u"" OR v = ""l"" THEN" + NL
    t = t + "                jsThrown = JsMakeTypedError(""TypeError"", ""Cannot destructure '"" + JsStr(v) + ""' as it is "" + JsStr(v) + ""."")" + NL
    t = t + "                THROW Str(jsLine) + ""|@thrown""" + NL
    t = t + "            END IF" + NL
    t = t + "            used = ""|""" + NL
    t = t + "            FOR EACH item IN nl[t].Split("","")" + NL
    t = t + "                IF item = """" THEN CONTINUE" + NL
    t = t + "                k = Int(Val(item))" + NL
    t = t + "                JsBind(nb[k], JsGet(v, ns[k]), scope)" + NL
    t = t + "                used = used + ns[k] + ""|""" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF nc[t] <> 0 THEN" + NL
    t = t + "                id = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "                IF v.StartsWith(""o"") THEN" + NL
    t = t + "                    FOR EACH key IN JsOwnKeys(JsId(v))" + NL
    t = t + "                        IF NOT used.Contains(""|"" + key + ""|"") THEN JsPutOwn(id, key, JsGet(v, key))" + NL
    t = t + "                    NEXT" + NL
    t = t + "                END IF" + NL
    t = t + "                JsBind(nc[t], JsO(id), scope)" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""parr""" + NL
    t = t + "            items = JsIterate(v)" + NL
    t = t + "            i = 0" + NL
    t = t + "            FOR EACH item IN nl[t].Split("","")" + NL
    t = t + "                IF item = """" THEN CONTINUE" + NL
    t = t + "                IF item <> ""0"" THEN" + NL
    t = t + "                    IF i < items.Count THEN" + NL
    t = t + "                        JsBind(Int(Val(item)), items[i], scope)" + NL
    t = t + "                    ELSE" + NL
    t = t + "                        JsBind(Int(Val(item)), ""u"", scope)" + NL
    t = t + "                    END IF" + NL
    t = t + "                END IF" + NL
    t = t + "                i = i + 1" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF nc[t] <> 0 THEN" + NL
    t = t + "                FOR k = i TO items.Count - 1" + NL
    t = t + "                    rest.Add(items[k])" + NL
    t = t + "                NEXT" + NL
    t = t + "                JsBind(nc[t], JsO(JsNewArray(rest)), scope)" + NL
    t = t + "            END IF" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A call's arguments into its parameters, when they're more than names." + NL
    t = t + "SUB JsBindParams (p AS Integer, args AS Array OF String, scope AS Integer)" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR rest AS Array OF String" + NL
    t = t + "    FOR EACH name IN JsPatternNames(p)" + NL
    t = t + "        JsPutOwn(scope, name, ""u"")" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH item IN nl[p].Split("","")" + NL
    t = t + "        IF item = """" THEN CONTINUE" + NL
    t = t + "        IF i < args.Count THEN" + NL
    t = t + "            JsBind(Int(Val(item)), args[i], scope)" + NL
    t = t + "        ELSE" + NL
    t = t + "            JsBind(Int(Val(item)), ""u"", scope)" + NL
    t = t + "        END IF" + NL
    t = t + "        i = i + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF nc[p] <> 0 THEN" + NL
    t = t + "        FOR i = i TO args.Count - 1" + NL
    t = t + "            rest.Add(args[i])" + NL
    t = t + "        NEXT" + NL
    t = t + "        JsBind(nc[p], JsO(JsNewArray(rest)), scope)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A scope for a block's (or a loop's) let, const and class names." + NL
    t = t + "FUNCTION JsBlockScope (n AS Integer, scope AS Integer) AS Integer" + NL
    t = t + "    VAR s AS Integer" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    s = JsNewObject(""Scope"", 0)" + NL
    t = t + "    joA[s] = scope" + NL
    t = t + "    SELECT CASE nk[n]" + NL
    t = t + "        CASE ""block""" + NL
    t = t + "            FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "                IF item = """" THEN CONTINUE" + NL
    t = t + "                k = Int(Val(item))" + NL
    t = t + "                IF nk[k] = ""let"" OR nk[k] = ""classdecl"" THEN" + NL
    t = t + "                    FOR EACH name IN JsDeclNames(k)" + NL
    t = t + "                        JsPutOwn(s, name, ""u"")" + NL
    t = t + "                    NEXT" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""for""" + NL
    t = t + "            FOR EACH name IN JsDeclNames(na[n])" + NL
    t = t + "                JsPutOwn(s, name, ""u"")" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""forin"", ""forof""" + NL
    t = t + "            IF nb[n] <> 0 THEN" + NL
    t = t + "                FOR EACH name IN JsPatternNames(nb[n])" + NL
    t = t + "                    JsPutOwn(s, name, ""u"")" + NL
    t = t + "                NEXT" + NL
    t = t + "            ELSE" + NL
    t = t + "                JsPutOwn(s, ns[n], ""u"")" + NL
    t = t + "            END IF" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The next time round a for (let ...) loop: the same names, in a new scope," + NL
    t = t + "' so a closure made last time keeps last time's values." + NL
    t = t + "FUNCTION JsCopyScope (s AS Integer) AS Integer" + NL
    t = t + "    VAR t AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    t = JsNewObject(""Scope"", 0)" + NL
    t = t + "    joA[t] = joA[s]" + NL
    t = t + "    FOR EACH name IN joKeys[s].Split(""|"")" + NL
    t = t + "        IF name <> """" THEN JsPutOwn(t, name, jpVal[JsOwn(s, name)])" + NL
    t = t + "    NEXT" + NL
    t = t + "    JsFreeScope(s)" + NL
    t = t + "    RETURN t" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A class: its constructor function, with the methods on its prototype and" + NL
    t = t + "' the static ones on itself. Its methods close over a scope that knows what" + NL
    t = t + "' super is (@super, @superproto) and which class this is (@class)." + NL
    t = t + "FUNCTION JsMakeClass (n AS Integer, scope AS Integer) AS String" + NL
    t = t + "    VAR sup AS String" + NL
    t = t + "    VAR superProto AS Integer" + NL
    t = t + "    VAR cs AS Integer" + NL
    t = t + "    VAR proto AS Integer" + NL
    t = t + "    VAR fn AS String" + NL
    t = t + "    VAR fid AS Integer" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR m AS Integer" + NL
    t = t + "    VAR fields AS Array OF String" + NL
    t = t + "    VAR st AS Integer" + NL
    t = t + "    sup = ""u""" + NL
    t = t + "    superProto = jsObjectProto" + NL
    t = t + "    IF na[n] <> 0 THEN" + NL
    t = t + "        sup = JsEval(na[n], scope)" + NL
    t = t + "        IF sup = ""l"" THEN" + NL
    t = t + "            superProto = 0" + NL
    t = t + "        ELSE" + NL
    t = t + "            IF NOT JsCallable(sup) THEN" + NL
    t = t + "                jsThrown = JsMakeTypedError(""TypeError"", ""Class extends value "" + JsStr(sup) + "" is not a constructor or null"")" + NL
    t = t + "                THROW Str(nline[n]) + ""|@thrown""" + NL
    t = t + "            END IF" + NL
    t = t + "            superProto = JsId(JsGet(sup, ""prototype""))" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    cs = JsNewObject(""Scope"", 0)" + NL
    t = t + "    joA[cs] = scope" + NL
    t = t + "    proto = JsNewObject(""Object"", superProto)" + NL
    t = t + "    fn = JsMakeFunction(nb[n], cs)" + NL
    t = t + "    fid = JsId(fn)" + NL
    t = t + "    JsPutOwn(fid, ""prototype"", JsO(proto))" + NL
    t = t + "    JsPutOwn(proto, ""constructor"", fn)" + NL
    t = t + "    joKeys[proto] = ""|""" + NL
    t = t + "    IF JsCallable(sup) THEN joProto[fid] = JsId(sup)" + NL
    t = t + "    JsPutOwn(cs, ""@super"", sup)" + NL
    t = t + "    JsPutOwn(cs, ""@superproto"", JsO(superProto))" + NL
    t = t + "    JsPutOwn(cs, ""@class"", fn)" + NL
    t = t + "    IF ns[n] <> """" THEN JsPutOwn(cs, ns[n], fn)" + NL
    t = t + "    JsPutOwn(fid, ""@name"", JsS(ns[n]))" + NL
    t = t + "    JsPutOwn(fid, ""@cscope"", JsN(cs))" + NL
    t = t + "    FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "        IF item = """" THEN CONTINUE" + NL
    t = t + "        m = Int(Val(item))" + NL
    t = t + "        IF nk[m] = ""method"" THEN" + NL
    t = t + "            IF nb[m] = 1 THEN" + NL
    t = t + "                JsPutOwn(fid, ns[m], JsMakeFunction(na[m], cs))" + NL
    t = t + "            ELSE" + NL
    t = t + "                JsPutOwn(proto, ns[m], JsMakeFunction(na[m], cs))" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSEIF nb[m] = 1 THEN" + NL
    t = t + "            ' static x = ...: worked out now, with this the class" + NL
    t = t + "            st = JsNewScope(cs, fn)" + NL
    t = t + "            IF na[m] = 0 THEN" + NL
    t = t + "                JsPutOwn(fid, ns[m], ""u"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                JsPutOwn(fid, ns[m], JsEval(na[m], st))" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSE" + NL
    t = t + "            fields.Add(item)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' (methods aren't counted among the prototype's keys, so for-in skips them)" + NL
    t = t + "    joKeys[proto] = ""|""" + NL
    t = t + "    JsPutOwn(fid, ""@fields"", JsS(fields.Join("","")))" + NL
    t = t + "    joB[cs] = 1" + NL
    t = t + "    RETURN fn" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A new object's fields (x = 1 in its class)." + NL
    t = t + "SUB JsInitFields (cls AS String, thisVal AS String)" + NL
    t = t + "    VAR list AS String" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR m AS Integer" + NL
    t = t + "    VAR st AS Integer" + NL
    t = t + "    list = JsStr(JsGetProp(JsId(cls), ""@fields""))" + NL
    t = t + "    IF list = """" OR list = ""undefined"" THEN RETURN" + NL
    t = t + "    st = JsNewScope(JsInt(JsGetProp(JsId(cls), ""@cscope"")), thisVal)" + NL
    t = t + "    FOR EACH item IN list.Split("","")" + NL
    t = t + "        IF item = """" THEN CONTINUE" + NL
    t = t + "        m = Int(Val(item))" + NL
    t = t + "        IF na[m] = 0 THEN" + NL
    t = t + "            JsPut(thisVal, ns[m], ""u"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            JsPut(thisVal, ns[m], JsEval(na[m], st))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' super(...): the class this extends, run on this; then this class's fields." + NL
    t = t + "FUNCTION JsSuperCall (n AS Integer, scope AS Integer) AS String" + NL
    t = t + "    VAR thisVal AS String" + NL
    t = t + "    VAR sup AS String" + NL
    t = t + "    VAR cls AS String" + NL
    t = t + "    VAR args AS Array OF String" + NL
    t = t + "    VAR r AS String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    thisVal = JsThisOf(scope)" + NL
    t = t + "    sup = JsLookup(""@super"", scope)" + NL
    t = t + "    cls = JsLookup(""@class"", scope)" + NL
    t = t + "    IF nl[n] = ""@all"" THEN" + NL
    t = t + "        args = JsItems(JsId(JsLookup(""arguments"", scope)))" + NL
    t = t + "    ELSE" + NL
    t = t + "        args = JsArgList(n, scope)" + NL
    t = t + "    END IF" + NL
    t = t + "    jsLine = nline[n]" + NL
    t = t + "    IF NOT JsCallable(sup) THEN THROW Str(jsLine) + ""|'super' keyword unexpected here""" + NL
    t = t + "    IF joClass[JsId(sup)] = ""Native"" THEN" + NL
    t = t + "        ' Error and the like make an object: what they put on it comes over" + NL
    t = t + "        r = JsConstruct(joS[JsId(sup)], args)" + NL
    t = t + "        IF r.StartsWith(""o"") THEN" + NL
    t = t + "            FOR EACH key IN JsOwnKeys(JsId(r))" + NL
    t = t + "                IF key <> ""name"" THEN JsPut(thisVal, key, JsGet(r, key))" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF JsOwn(JsId(sup), ""@cscope"") >= 0 THEN" + NL
    t = t + "            IF JsGetProp(JsInt(JsGetProp(JsId(sup), ""@cscope"")), ""@super"") = ""u"" THEN JsInitFields(sup, thisVal)" + NL
    t = t + "        END IF" + NL
    t = t + "        r = JsCall(sup, thisVal, args)" + NL
    t = t + "    END IF" + NL
    t = t + "    JsInitFields(cls, thisVal)" + NL
    t = t + "    RETURN ""u""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the later library" + NL
    t = t + "" + NL
    t = t + "' What came after 1996 and every program now expects: JSON, Object.keys," + NL
    t = t + "' Array.isArray, Number.isInteger, fn.bind, Promise.resolve/reject/all/race." + NL
    t = t + "' (Array and String methods like map and startsWith are with the others.)" + NL
    t = t + "" + NL
    t = t + "VAR jsonSrc AS String" + NL
    t = t + "VAR jsonAt AS Integer" + NL
    t = t + "" + NL
    t = t + "' Three arguments, as callbacks get them: (item, index, array)." + NL
    t = t + "FUNCTION JsArgs3 (a AS String, b AS String, c AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    out.Add(a)" + NL
    t = t + "    out.Add(b)" + NL
    t = t + "    out.Add(c)" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNeedFn (v AS String, what AS String) AS String" + NL
    t = t + "    IF NOT JsCallable(v) THEN" + NL
    t = t + "        jsThrown = JsMakeTypedError(""TypeError"", what + "" is not a function"")" + NL
    t = t + "        THROW Str(jsLine) + ""|@thrown""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN v" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' An object's own keys, in the order they were made (an array's length left out)." + NL
    t = t + "FUNCTION JsOwnKeys (id AS Integer) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    FOR EACH key IN joKeys[id].Split(""|"")" + NL
    t = t + "        IF key = """" OR (joClass[id] = ""Array"" AND key = ""length"") THEN CONTINUE" + NL
    t = t + "        out.Add(key)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsMakeTypedError (kind AS String, message AS String) AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    v = JsMakeError(""0|"" + message)" + NL
    t = t + "    JsPutOwn(JsId(v), ""name"", JsS(kind))" + NL
    t = t + "    IF HostWhere() = """" THEN" + NL
    t = t + "        JsPutOwn(JsId(v), ""stack"", JsS(kind + "": "" + message))" + NL
    t = t + "    ELSE" + NL
    t = t + "        JsPutOwn(JsId(v), ""stack"", JsS(kind + "": "" + message + Chr(10) + ""    at "" + HostWhere()))" + NL
    t = t + "    END IF" + NL
    t = t + "    IF JsGetProp(jsGlobal, kind).StartsWith(""o"") THEN joProto[JsId(v)] = JsId(JsGetProp(JsId(JsGetProp(jsGlobal, kind)), ""prototype""))" + NL
    t = t + "    RETURN v" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsLib (name AS String, thisVal AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    VAR p AS Integer" + NL
    t = t + "    VAR holder AS Integer" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR pair AS Array OF String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    a = JsArg(args, 0)" + NL
    t = t + "    IF name.StartsWith(""Bound:"") THEN" + NL
    t = t + "        holder = Int(Val(name.Substring(6, name.Length - 6)))" + NL
    t = t + "        list = JsItems(JsId(JsGetProp(holder, ""@args"")))" + NL
    t = t + "        FOR EACH v IN args" + NL
    t = t + "            list.Add(v)" + NL
    t = t + "        NEXT" + NL
    t = t + "        RETURN JsCall(JsGetProp(holder, ""@fn""), JsGetProp(holder, ""@this""), list)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF name.StartsWith(""Promise.part:"") THEN" + NL
    t = t + "        ' one of Promise.all's promises settled: its value in its place, and" + NL
    t = t + "        ' the whole thing settled when the last is in" + NL
    t = t + "        parts = name.Split("":"")" + NL
    t = t + "        holder = Int(Val(parts[1]))" + NL
    t = t + "        p = Int(Val(parts[2]))" + NL
    t = t + "        IF JsGetProp(p, ""@state"") <> ""spending"" THEN RETURN ""u""" + NL
    t = t + "        IF parts[4] = ""err"" THEN" + NL
    t = t + "            JsResolve(p, FALSE, a)" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        END IF" + NL
    t = t + "        IF parts[4] = ""race"" THEN" + NL
    t = t + "            JsResolve(p, TRUE, a)" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        END IF" + NL
    t = t + "        JsPut(JsO(holder), parts[3], a)" + NL
    t = t + "        i = JsInt(JsGetProp(holder, ""@left"")) - 1" + NL
    t = t + "        JsPutOwn(holder, ""@left"", JsN(i))" + NL
    t = t + "        IF i = 0 THEN JsResolve(p, TRUE, JsO(holder))" + NL
    t = t + "        RETURN ""u""" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""Function.bind""" + NL
    t = t + "            holder = JsNewObject(""Object"", 0)" + NL
    t = t + "            JsPutOwn(holder, ""@fn"", thisVal)" + NL
    t = t + "            JsPutOwn(holder, ""@this"", JsThisArg(a))" + NL
    t = t + "            FOR i = 1 TO args.Count - 1" + NL
    t = t + "                out.Add(args[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            JsPutOwn(holder, ""@args"", JsO(JsNewArray(out)))" + NL
    t = t + "            RETURN JsNative(""Bound:"" + Str(holder))" + NL
    t = t + "        CASE ""ObjectS.keys"", ""ObjectS.values"", ""ObjectS.entries"", ""ObjectS.getOwnPropertyNames""" + NL
    t = t + "            IF NOT a.StartsWith(""o"") THEN" + NL
    t = t + "                IF a.StartsWith(""s"") THEN" + NL
    t = t + "                    FOR i = 0 TO a.Length - 2" + NL
    t = t + "                        out.Add(JsS(Str(i)))" + NL
    t = t + "                    NEXT" + NL
    t = t + "                END IF" + NL
    t = t + "                RETURN JsO(JsNewArray(out))" + NL
    t = t + "            END IF" + NL
    t = t + "            id = JsId(a)" + NL
    t = t + "            FOR EACH key IN JsOwnKeys(id)" + NL
    t = t + "                IF name = ""ObjectS.values"" THEN" + NL
    t = t + "                    out.Add(JsGet(a, key))" + NL
    t = t + "                ELSEIF name = ""ObjectS.entries"" THEN" + NL
    t = t + "                    pair.Clear()" + NL
    t = t + "                    pair.Add(JsS(key))" + NL
    t = t + "                    pair.Add(JsGet(a, key))" + NL
    t = t + "                    out.Add(JsO(JsNewArray(pair)))" + NL
    t = t + "                ELSE" + NL
    t = t + "                    out.Add(JsS(key))" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsO(JsNewArray(out))" + NL
    t = t + "        CASE ""ObjectS.assign""" + NL
    t = t + "            IF NOT a.StartsWith(""o"") THEN RETURN a" + NL
    t = t + "            FOR i = 1 TO args.Count - 1" + NL
    t = t + "                IF args[i].StartsWith(""o"") THEN" + NL
    t = t + "                    FOR EACH key IN JsOwnKeys(JsId(args[i]))" + NL
    t = t + "                        JsPut(a, key, JsGet(args[i], key))" + NL
    t = t + "                    NEXT" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN a" + NL
    t = t + "        CASE ""ObjectS.create""" + NL
    t = t + "            IF a = ""l"" THEN RETURN JsO(JsNewObject(""Object"", 0))" + NL
    t = t + "            IF NOT a.StartsWith(""o"") THEN RETURN JsO(JsNewObject(""Object"", jsObjectProto))" + NL
    t = t + "            id = JsNewObject(""Object"", JsId(a))" + NL
    t = t + "            IF JsArg(args, 1).StartsWith(""o"") THEN" + NL
    t = t + "                FOR EACH key IN JsOwnKeys(JsId(args[1]))" + NL
    t = t + "                    JsPutOwn(id, key, JsGet(JsGet(args[1], key), ""value""))" + NL
    t = t + "                NEXT" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsO(id)" + NL
    t = t + "        CASE ""ObjectS.getPrototypeOf""" + NL
    t = t + "            IF NOT a.StartsWith(""o"") THEN RETURN ""l""" + NL
    t = t + "            IF joProto[JsId(a)] = 0 THEN RETURN ""l""" + NL
    t = t + "            RETURN JsO(joProto[JsId(a)])" + NL
    t = t + "        CASE ""ObjectS.setPrototypeOf""" + NL
    t = t + "            IF a.StartsWith(""o"") AND JsArg(args, 1).StartsWith(""o"") THEN joProto[JsId(a)] = JsId(args[1])" + NL
    t = t + "            RETURN a" + NL
    t = t + "        CASE ""ObjectS.freeze"", ""ObjectS.seal"", ""ObjectS.preventExtensions""" + NL
    t = t + "            RETURN a" + NL
    t = t + "        CASE ""ObjectS.defineProperty""" + NL
    t = t + "            IF a.StartsWith(""o"") AND JsArg(args, 2).StartsWith(""o"") THEN JsPut(a, JsKey(JsArg(args, 1)), JsGet(args[2], ""value""))" + NL
    t = t + "            RETURN a" + NL
    t = t + "        CASE ""ObjectS.is""" + NL
    t = t + "            IF JsNum(a) = ""NaN"" AND JsNum(JsArg(args, 1)) = ""NaN"" AND a.StartsWith(""n"") AND JsArg(args, 1).StartsWith(""n"") THEN RETURN ""t""" + NL
    t = t + "            RETURN JsB(JsStrictEq(a, JsArg(args, 1)))" + NL
    t = t + "        CASE ""ArrayS.isArray""" + NL
    t = t + "            IF NOT a.StartsWith(""o"") THEN RETURN ""f""" + NL
    t = t + "            RETURN JsB(joClass[JsId(a)] = ""Array"")" + NL
    t = t + "        CASE ""ArrayS.of""" + NL
    t = t + "            RETURN JsO(JsNewArray(args))" + NL
    t = t + "        CASE ""ArrayS.from""" + NL
    t = t + "            IF a.StartsWith(""s"") THEN" + NL
    t = t + "                FOR i = 1 TO a.Length - 1" + NL
    t = t + "                    out.Add(JsS(a.Substring(i, 1)))" + NL
    t = t + "                NEXT" + NL
    t = t + "            ELSEIF a.StartsWith(""o"") THEN" + NL
    t = t + "                IF joClass[JsId(a)] = ""Array"" THEN" + NL
    t = t + "                    out = JsItems(JsId(a))" + NL
    t = t + "                ELSE" + NL
    t = t + "                    FOR i = 0 TO JsInt(JsGet(a, ""length"")) - 1" + NL
    t = t + "                        out.Add(JsGet(a, Str(i)))" + NL
    t = t + "                    NEXT" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "            IF JsCallable(JsArg(args, 1)) THEN" + NL
    t = t + "                FOR i = 0 TO out.Count - 1" + NL
    t = t + "                    list.Clear()" + NL
    t = t + "                    list.Add(out[i])" + NL
    t = t + "                    list.Add(JsN(i))" + NL
    t = t + "                    out[i] = JsCall(args[1], JsO(jsGlobal), list)" + NL
    t = t + "                NEXT" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsO(JsNewArray(out))" + NL
    t = t + "        CASE ""NumberS.isInteger""" + NL
    t = t + "            RETURN JsB(a.StartsWith(""n"") AND JsFinite(JsNum(a)) AND JsReal(a) = Int(JsReal(a)))" + NL
    t = t + "        CASE ""NumberS.isFinite""" + NL
    t = t + "            RETURN JsB(a.StartsWith(""n"") AND JsFinite(JsNum(a)))" + NL
    t = t + "        CASE ""NumberS.isNaN""" + NL
    t = t + "            RETURN JsB(a.StartsWith(""n"") AND JsNum(a) = ""NaN"")" + NL
    t = t + "        CASE ""JSON.stringify""" + NL
    t = t + "            text = """"" + NL
    t = t + "            v = JsArg(args, 2)" + NL
    t = t + "            IF v.StartsWith(""n"") THEN" + NL
    t = t + "                FOR i = 1 TO MATH.Min(10, JsInt(v))" + NL
    t = t + "                    text = text + "" """ + NL
    t = t + "                NEXT" + NL
    t = t + "            ELSEIF v.StartsWith(""s"") THEN" + NL
    t = t + "                text = JsStr(v)" + NL
    t = t + "            END IF" + NL
    t = t + "            v = JsJsonOut(a, text, """")" + NL
    t = t + "            IF v = Chr(0) THEN RETURN ""u""" + NL
    t = t + "            RETURN JsS(v)" + NL
    t = t + "        CASE ""JSON.parse""" + NL
    t = t + "            jsonSrc = JsStr(a)" + NL
    t = t + "            jsonAt = 0" + NL
    t = t + "            v = JsJsonValue()" + NL
    t = t + "            JsJsonSpace()" + NL
    t = t + "            IF jsonAt < jsonSrc.Length THEN JsJsonFail()" + NL
    t = t + "            RETURN v" + NL
    t = t + "        CASE ""PromiseS.resolve"", ""PromiseS.reject""" + NL
    t = t + "            IF name = ""PromiseS.resolve"" AND a.StartsWith(""o"") THEN" + NL
    t = t + "                IF joClass[JsId(a)] = ""Promise"" THEN RETURN a" + NL
    t = t + "            END IF" + NL
    t = t + "            p = JsNewPromise()" + NL
    t = t + "            JsResolve(p, name = ""PromiseS.resolve"", a)" + NL
    t = t + "            RETURN JsO(p)" + NL
    t = t + "        CASE ""PromiseS.all"", ""PromiseS.race""" + NL
    t = t + "            p = JsNewPromise()" + NL
    t = t + "            IF a.StartsWith(""o"") THEN list = JsItems(JsId(a))" + NL
    t = t + "            holder = JsNewArray(out)" + NL
    t = t + "            JsPutOwn(holder, ""length"", JsN(list.Count))" + NL
    t = t + "            JsPutOwn(holder, ""@left"", JsN(list.Count))" + NL
    t = t + "            IF list.Count = 0 AND name = ""PromiseS.all"" THEN JsResolve(p, TRUE, JsO(holder))" + NL
    t = t + "            FOR i = 0 TO list.Count - 1" + NL
    t = t + "                v = list[i]" + NL
    t = t + "                IF NOT v.StartsWith(""o"") OR joClass[JsId(v)] <> ""Promise"" THEN" + NL
    t = t + "                    id = JsNewPromise()" + NL
    t = t + "                    JsResolve(id, TRUE, v)" + NL
    t = t + "                    v = JsO(id)" + NL
    t = t + "                END IF" + NL
    t = t + "                pair.Clear()" + NL
    t = t + "                IF name = ""PromiseS.race"" THEN" + NL
    t = t + "                    pair.Add(JsNative(""Promise.part:"" + Str(holder) + "":"" + Str(p) + "":"" + Str(i) + "":race""))" + NL
    t = t + "                ELSE" + NL
    t = t + "                    pair.Add(JsNative(""Promise.part:"" + Str(holder) + "":"" + Str(p) + "":"" + Str(i) + "":ok""))" + NL
    t = t + "                END IF" + NL
    t = t + "                pair.Add(JsNative(""Promise.part:"" + Str(holder) + "":"" + Str(p) + "":"" + Str(i) + "":err""))" + NL
    t = t + "                v = JsPromiseMethod(""Promise.then"", v, pair)" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsO(p)" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' new Promise(function (resolve, reject) { ... })" + NL
    t = t + "FUNCTION JsNewPromiseFrom (executor AS String) AS String" + NL
    t = t + "    VAR p AS Integer" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR r AS String" + NL
    t = t + "    VAR depth AS Integer" + NL
    t = t + "    p = JsNewPromise()" + NL
    t = t + "    list.Add(JsSettler(p, ""ok""))" + NL
    t = t + "    list.Add(JsSettler(p, ""err""))" + NL
    t = t + "    depth = jsDepth" + NL
    t = t + "    TRY" + NL
    t = t + "        r = JsCall(JsNeedFn(executor, ""Promise resolver""), JsO(jsGlobal), list)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        jsDepth = depth" + NL
    t = t + "        IF err.Contains(""@aborted"") THEN THROW err" + NL
    t = t + "        IF jsThrown <> """" THEN" + NL
    t = t + "            r = jsThrown" + NL
    t = t + "        ELSE" + NL
    t = t + "            r = JsMakeError(err)" + NL
    t = t + "        END IF" + NL
    t = t + "        jsThrown = """"" + NL
    t = t + "        jsSig = """"" + NL
    t = t + "        JsResolve(p, FALSE, r)" + NL
    t = t + "    END TRY" + NL
    t = t + "    RETURN JsO(p)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---- JSON" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsJsonQuote (s AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    out = """"""""" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        c = s.CharAt(i)" + NL
    t = t + "        k = Asc(c)" + NL
    t = t + "        IF c = """""""" THEN" + NL
    t = t + "            out = out + ""\""""""" + NL
    t = t + "        ELSEIF c = ""\"" THEN" + NL
    t = t + "            out = out + ""\\""" + NL
    t = t + "        ELSEIF k = 10 THEN" + NL
    t = t + "            out = out + ""\n""" + NL
    t = t + "        ELSEIF k = 13 THEN" + NL
    t = t + "            out = out + ""\r""" + NL
    t = t + "        ELSEIF k = 9 THEN" + NL
    t = t + "            out = out + ""\t""" + NL
    t = t + "        ELSEIF k < 32 THEN" + NL
    t = t + "            out = out + ""\u00"" + ""0123456789abcdef"".CharAt(Int(k / 16)) + ""0123456789abcdef"".CharAt(k MOD 16)" + NL
    t = t + "        ELSE" + NL
    t = t + "            out = out + c" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out + """"""""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' v as JSON; Chr(0) for what JSON leaves out (undefined, functions)." + NL
    t = t + "FUNCTION JsJsonOut (v AS String, indent AS String, cur AS String) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR inner AS String" + NL
    t = t + "    VAR sep AS String" + NL
    t = t + "    VAR fn AS String" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    SELECT CASE v.Substring(0, 1)" + NL
    t = t + "        CASE ""u""" + NL
    t = t + "            RETURN Chr(0)" + NL
    t = t + "        CASE ""l""" + NL
    t = t + "            RETURN ""null""" + NL
    t = t + "        CASE ""t""" + NL
    t = t + "            RETURN ""true""" + NL
    t = t + "        CASE ""f""" + NL
    t = t + "            RETURN ""false""" + NL
    t = t + "        CASE ""n""" + NL
    t = t + "            IF NOT JsFinite(JsNum(v)) THEN RETURN ""null""" + NL
    t = t + "            RETURN JsStr(v)" + NL
    t = t + "        CASE ""s""" + NL
    t = t + "            RETURN JsJsonQuote(v.Substring(1, v.Length - 1))" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF JsCallable(v) THEN RETURN Chr(0)" + NL
    t = t + "    id = JsId(v)" + NL
    t = t + "    fn = JsGet(v, ""toJSON"")" + NL
    t = t + "    IF JsCallable(fn) THEN RETURN JsJsonOut(JsCall(fn, v, none), indent, cur)" + NL
    t = t + "    IF joClass[id] = ""Date"" THEN RETURN JsJsonQuote(JsStr(v))" + NL
    t = t + "    inner = cur + indent" + NL
    t = t + "    sep = "",""" + NL
    t = t + "    IF indent <> """" THEN sep = "","" + Chr(10) + inner" + NL
    t = t + "    IF joClass[id] = ""Array"" THEN" + NL
    t = t + "        FOR EACH item IN JsItems(id)" + NL
    t = t + "            key = JsJsonOut(item, indent, inner)" + NL
    t = t + "            IF key = Chr(0) THEN key = ""null""" + NL
    t = t + "            parts.Add(key)" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF parts.Count = 0 THEN RETURN ""[]""" + NL
    t = t + "        IF indent = """" THEN RETURN ""["" + parts.Join("","") + ""]""" + NL
    t = t + "        RETURN ""["" + Chr(10) + inner + parts.Join(sep) + Chr(10) + cur + ""]""" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH key IN JsOwnKeys(id)" + NL
    t = t + "        item = JsJsonOut(JsGet(v, key), indent, inner)" + NL
    t = t + "        IF item = Chr(0) THEN CONTINUE" + NL
    t = t + "        IF indent = """" THEN" + NL
    t = t + "            parts.Add(JsJsonQuote(key) + "":"" + item)" + NL
    t = t + "        ELSE" + NL
    t = t + "            parts.Add(JsJsonQuote(key) + "": "" + item)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF parts.Count = 0 THEN RETURN ""{}""" + NL
    t = t + "    IF indent = """" THEN RETURN ""{"" + parts.Join("","") + ""}""" + NL
    t = t + "    RETURN ""{"" + Chr(10) + inner + parts.Join(sep) + Chr(10) + cur + ""}""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JsJsonFail ()" + NL
    t = t + "    VAR what AS String" + NL
    t = t + "    IF jsonAt >= jsonSrc.Length THEN" + NL
    t = t + "        what = ""Unexpected end of JSON input""" + NL
    t = t + "    ELSE" + NL
    t = t + "        what = ""Unexpected token "" + jsonSrc.CharAt(jsonAt) + "" in JSON at position "" + Str(jsonAt)" + NL
    t = t + "    END IF" + NL
    t = t + "    jsThrown = JsMakeTypedError(""SyntaxError"", what)" + NL
    t = t + "    THROW Str(jsLine) + ""|@thrown""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB JsJsonSpace ()" + NL
    t = t + "    WHILE jsonAt < jsonSrc.Length" + NL
    t = t + "        IF NOT ("" "" + Chr(9) + Chr(10) + Chr(13)).Contains(jsonSrc.CharAt(jsonAt)) THEN RETURN" + NL
    t = t + "        jsonAt = jsonAt + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsJsonValue () AS String" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR items AS Array OF String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR start AS Integer" + NL
    t = t + "    JsJsonSpace()" + NL
    t = t + "    IF jsonAt >= jsonSrc.Length THEN JsJsonFail()" + NL
    t = t + "    c = jsonSrc.CharAt(jsonAt)" + NL
    t = t + "    IF c = ""{"" THEN" + NL
    t = t + "        jsonAt = jsonAt + 1" + NL
    t = t + "        id = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "        JsJsonSpace()" + NL
    t = t + "        IF jsonAt < jsonSrc.Length AND jsonSrc.CharAt(jsonAt) = ""}"" THEN" + NL
    t = t + "            jsonAt = jsonAt + 1" + NL
    t = t + "            RETURN JsO(id)" + NL
    t = t + "        END IF" + NL
    t = t + "        WHILE TRUE" + NL
    t = t + "            JsJsonSpace()" + NL
    t = t + "            IF jsonAt >= jsonSrc.Length OR jsonSrc.CharAt(jsonAt) <> """""""" THEN JsJsonFail()" + NL
    t = t + "            key = JsJsonString()" + NL
    t = t + "            JsJsonSpace()" + NL
    t = t + "            IF jsonAt >= jsonSrc.Length OR jsonSrc.CharAt(jsonAt) <> "":"" THEN JsJsonFail()" + NL
    t = t + "            jsonAt = jsonAt + 1" + NL
    t = t + "            JsPut(JsO(id), key, JsJsonValue())" + NL
    t = t + "            JsJsonSpace()" + NL
    t = t + "            IF jsonAt < jsonSrc.Length AND jsonSrc.CharAt(jsonAt) = "","" THEN" + NL
    t = t + "                jsonAt = jsonAt + 1" + NL
    t = t + "            ELSEIF jsonAt < jsonSrc.Length AND jsonSrc.CharAt(jsonAt) = ""}"" THEN" + NL
    t = t + "                jsonAt = jsonAt + 1" + NL
    t = t + "                RETURN JsO(id)" + NL
    t = t + "            ELSE" + NL
    t = t + "                JsJsonFail()" + NL
    t = t + "            END IF" + NL
    t = t + "        END WHILE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF c = ""["" THEN" + NL
    t = t + "        jsonAt = jsonAt + 1" + NL
    t = t + "        JsJsonSpace()" + NL
    t = t + "        IF jsonAt < jsonSrc.Length AND jsonSrc.CharAt(jsonAt) = ""]"" THEN" + NL
    t = t + "            jsonAt = jsonAt + 1" + NL
    t = t + "            RETURN JsO(JsNewArray(items))" + NL
    t = t + "        END IF" + NL
    t = t + "        WHILE TRUE" + NL
    t = t + "            items.Add(JsJsonValue())" + NL
    t = t + "            JsJsonSpace()" + NL
    t = t + "            IF jsonAt < jsonSrc.Length AND jsonSrc.CharAt(jsonAt) = "","" THEN" + NL
    t = t + "                jsonAt = jsonAt + 1" + NL
    t = t + "            ELSEIF jsonAt < jsonSrc.Length AND jsonSrc.CharAt(jsonAt) = ""]"" THEN" + NL
    t = t + "                jsonAt = jsonAt + 1" + NL
    t = t + "                RETURN JsO(JsNewArray(items))" + NL
    t = t + "            ELSE" + NL
    t = t + "                JsJsonFail()" + NL
    t = t + "            END IF" + NL
    t = t + "        END WHILE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF c = """""""" THEN RETURN JsS(JsJsonString())" + NL
    t = t + "    IF jsonSrc.Substring(jsonAt, MATH.Min(4, jsonSrc.Length - jsonAt)) = ""true"" THEN" + NL
    t = t + "        jsonAt = jsonAt + 4" + NL
    t = t + "        RETURN ""t""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF jsonSrc.Substring(jsonAt, MATH.Min(5, jsonSrc.Length - jsonAt)) = ""false"" THEN" + NL
    t = t + "        jsonAt = jsonAt + 5" + NL
    t = t + "        RETURN ""f""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF jsonSrc.Substring(jsonAt, MATH.Min(4, jsonSrc.Length - jsonAt)) = ""null"" THEN" + NL
    t = t + "        jsonAt = jsonAt + 4" + NL
    t = t + "        RETURN ""l""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ""-0123456789"".Contains(c) THEN" + NL
    t = t + "        start = jsonAt" + NL
    t = t + "        jsonAt = jsonAt + 1" + NL
    t = t + "        WHILE jsonAt < jsonSrc.Length AND ""0123456789.eE+-"".Contains(jsonSrc.CharAt(jsonAt))" + NL
    t = t + "            jsonAt = jsonAt + 1" + NL
    t = t + "        END WHILE" + NL
    t = t + "        RETURN ""n"" + JsNum(JsS(jsonSrc.Substring(start, jsonAt - start)))" + NL
    t = t + "    END IF" + NL
    t = t + "    JsJsonFail()" + NL
    t = t + "    RETURN ""u""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A JSON string at jsonAt (the opening quote), unescaped." + NL
    t = t + "FUNCTION JsJsonString () AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    jsonAt = jsonAt + 1" + NL
    t = t + "    WHILE jsonAt < jsonSrc.Length" + NL
    t = t + "        c = jsonSrc.CharAt(jsonAt)" + NL
    t = t + "        IF c = """""""" THEN" + NL
    t = t + "            jsonAt = jsonAt + 1" + NL
    t = t + "            RETURN out" + NL
    t = t + "        END IF" + NL
    t = t + "        IF c = ""\"" THEN" + NL
    t = t + "            jsonAt = jsonAt + 1" + NL
    t = t + "            IF jsonAt >= jsonSrc.Length THEN JsJsonFail()" + NL
    t = t + "            e = jsonSrc.CharAt(jsonAt)" + NL
    t = t + "            SELECT CASE e" + NL
    t = t + "                CASE ""n""" + NL
    t = t + "                    out = out + Chr(10)" + NL
    t = t + "                CASE ""t""" + NL
    t = t + "                    out = out + Chr(9)" + NL
    t = t + "                CASE ""r""" + NL
    t = t + "                    out = out + Chr(13)" + NL
    t = t + "                CASE ""b""" + NL
    t = t + "                    out = out + Chr(8)" + NL
    t = t + "                CASE ""f""" + NL
    t = t + "                    out = out + Chr(12)" + NL
    t = t + "                CASE ""u""" + NL
    t = t + "                    IF jsonAt + 4 >= jsonSrc.Length THEN JsJsonFail()" + NL
    t = t + "                    out = out + Chr(Int(Val(JsNumberText(""0x"" + jsonSrc.Substring(jsonAt + 1, 4)))))" + NL
    t = t + "                    jsonAt = jsonAt + 4" + NL
    t = t + "                CASE ELSE" + NL
    t = t + "                    out = out + e" + NL
    t = t + "            END SELECT" + NL
    t = t + "        ELSE" + NL
    t = t + "            out = out + c" + NL
    t = t + "        END IF" + NL
    t = t + "        jsonAt = jsonAt + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    JsJsonFail()" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---- promise jobs: with jsDefer on (Node), then-callbacks wait until the" + NL
    t = t + "' running code is done, as JavaScript says; JsDrainJobs runs them." + NL
    t = t + "" + NL
    t = t + "VAR jsDefer AS Bool" + NL
    t = t + "VAR jqP AS Array OF Integer" + NL
    t = t + "VAR jqOk AS Array OF String" + NL
    t = t + "VAR jqErr AS Array OF String" + NL
    t = t + "VAR jqChild AS Array OF Integer" + NL
    t = t + "" + NL
    t = t + "SUB JsQueueThen (p AS Integer, onOk AS String, onErr AS String, child AS Integer)" + NL
    t = t + "    IF NOT jsDefer THEN" + NL
    t = t + "        JsRunThen(p, onOk, onErr, child)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    jqP.Add(p)" + NL
    t = t + "    jqOk.Add(onOk)" + NL
    t = t + "    jqErr.Add(onErr)" + NL
    t = t + "    jqChild.Add(child)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB JsDrainJobs ()" + NL
    t = t + "    VAR p AS Integer" + NL
    t = t + "    VAR ok AS String" + NL
    t = t + "    VAR er AS String" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    WHILE jqP.Count > 0" + NL
    t = t + "        p = jqP[0]" + NL
    t = t + "        ok = jqOk[0]" + NL
    t = t + "        er = jqErr[0]" + NL
    t = t + "        c = jqChild[0]" + NL
    t = t + "        jqP.RemoveAt(0)" + NL
    t = t + "        jqOk.RemoveAt(0)" + NL
    t = t + "        jqErr.RemoveAt(0)" + NL
    t = t + "        jqChild.RemoveAt(0)" + NL
    t = t + "        jsSig = """"" + NL
    t = t + "        jsDepth = 0" + NL
    t = t + "        JsRunThen(p, ok, er, c)" + NL
    t = t + "    END WHILE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- a fresh page" + NL
    t = t + "" + NL
    t = t + "SUB JsReset ()" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR mathObj AS Integer" + NL
    t = t + "    VAR o AS Integer" + NL
    t = t + "    VAR f AS Integer" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    jtType.Clear()" + NL
    t = t + "    jtText.Clear()" + NL
    t = t + "    jtLine.Clear()" + NL
    t = t + "    jtNl.Clear()" + NL
    t = t + "    nk.Clear()" + NL
    t = t + "    na.Clear()" + NL
    t = t + "    nb.Clear()" + NL
    t = t + "    nc.Clear()" + NL
    t = t + "    nd.Clear()" + NL
    t = t + "    ns.Clear()" + NL
    t = t + "    nl.Clear()" + NL
    t = t + "    nline.Clear()" + NL
    t = t + "    jpKey.Clear()" + NL
    t = t + "    jpVal.Clear()" + NL
    t = t + "    joClass.Clear()" + NL
    t = t + "    joProto.Clear()" + NL
    t = t + "    joA.Clear()" + NL
    t = t + "    joB.Clear()" + NL
    t = t + "    joS.Clear()" + NL
    t = t + "    joKeys.Clear()" + NL
    t = t + "    jsHostCache.Clear()" + NL
    t = t + "    f = JsNode(""none"", 0, 0, 0, 0, """", """", 0)" + NL
    t = t + "    o = JsNewObject(""Nothing"", 0)" + NL
    t = t + "    jsOut = """"" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    jsRet = ""u""" + NL
    t = t + "    jsDepth = 0" + NL
    t = t + "    jsSteps = 0" + NL
    t = t + "    jsLimit = JSSTEPLIMIT" + NL
    t = t + "    jsThrown = """"" + NL
    t = t + "    jsLineBase = 1" + NL
    t = t + "" + NL
    t = t + "    jsObjectProto = JsNewObject(""Object"", 0)" + NL
    t = t + "    JsMethods(jsObjectProto, ""Object."", ""toString,hasOwnProperty"")" + NL
    t = t + "    jsFunctionProto = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(jsFunctionProto, ""Function."", ""call,apply,bind"")" + NL
    t = t + "    jsArrayProto = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(jsArrayProto, ""Array."", ""join,toString,push,pop,shift,unshift,reverse,concat,slice,splice,indexOf,sort,forEach,map,filter,reduce,reduceRight,some,every,find,findIndex,includes,lastIndexOf,fill"")" + NL
    t = t + "    jsStringProto = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(jsStringProto, ""String."", ""charAt,charCodeAt,indexOf,lastIndexOf,substring,substr,slice,toUpperCase,toLowerCase,toLocaleUpperCase,toLocaleLowerCase,trim,split,concat,toString,valueOf,bold,italics,fixed,big,small,blink,strike,sub,sup,fontcolor,fontsize,anchor,link,replace,replaceAll,startsWith,endsWith,includes,repeat,padStart,padEnd,trimStart,trimEnd,trimLeft,trimRight"")" + NL
    t = t + "    jsNumberProto = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(jsNumberProto, ""Number."", ""toString,toFixed"")" + NL
    t = t + "    jsDateProto = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(jsDateProto, ""Date."", ""getTime,valueOf,getFullYear,getYear,getMonth,getDate,getDay,getHours,getMinutes,getSeconds,getMilliseconds,getTimezoneOffset,toString,toLocaleString,toGMTString,toUTCString,setTime,setFullYear,setYear,setMonth,setDate,setHours,setMinutes,setSeconds,setMilliseconds"")" + NL
    t = t + "" + NL
    t = t + "    ' window, which is also the global scope" + NL
    t = t + "    jsGlobal = JsNewObject(""Global"", jsObjectProto)" + NL
    t = t + "    JsPutOwn(jsGlobal, ""window"", JsO(jsGlobal))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""self"", JsO(jsGlobal))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""top"", JsO(jsGlobal))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""parent"", JsO(jsGlobal))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""NaN"", ""nNaN"")" + NL
    t = t + "    JsPutOwn(jsGlobal, ""Infinity"", ""nInfinity"")" + NL
    t = t + "    JsMethods(jsGlobal, """", ""alert,confirm,prompt,parseInt,parseFloat,isNaN,isFinite,escape,unescape,setTimeout,setInterval,clearTimeout,clearInterval,open,String,Number,Boolean,Array,Object,Date,Error,TypeError,RangeError,SyntaxError,ReferenceError,Promise"")" + NL
    t = t + "    JsPutOwn(jsGlobal, ""eval"", JsNative(""eval""))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""close"", JsNative(""noop""))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""focus"", JsNative(""noop""))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""blur"", JsNative(""noop""))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""scroll"", JsNative(""noop""))" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""String"")), ""fromCharCode"", JsNative(""String.fromCharCode""))" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""String"")), ""prototype"", JsO(jsStringProto))" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""Number"")), ""prototype"", JsO(jsNumberProto))" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""Array"")), ""prototype"", JsO(jsArrayProto))" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""Object"")), ""prototype"", JsO(jsObjectProto))" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""Date"")), ""prototype"", JsO(jsDateProto))" + NL
    t = t + "    JsMethods(JsId(JsGetProp(jsGlobal, ""Object"")), ""ObjectS."", ""keys,values,entries,assign,create,getPrototypeOf,setPrototypeOf,freeze,seal,preventExtensions,defineProperty,getOwnPropertyNames,is"")" + NL
    t = t + "    JsMethods(JsId(JsGetProp(jsGlobal, ""Array"")), ""ArrayS."", ""isArray,from,of"")" + NL
    t = t + "    JsMethods(JsId(JsGetProp(jsGlobal, ""Number"")), ""NumberS."", ""isInteger,isFinite,isNaN"")" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""Number"")), ""parseInt"", JsNative(""parseInt""))" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""Number"")), ""parseFloat"", JsNative(""parseFloat""))" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""Number"")), ""MAX_SAFE_INTEGER"", JsN(9007199254740991))" + NL
    t = t + "    o = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(o, ""JSON."", ""parse,stringify"")" + NL
    t = t + "    JsPutOwn(jsGlobal, ""JSON"", JsO(o))" + NL
    t = t + "    ' the errors: Error.prototype, and its kinds made from it" + NL
    t = t + "    o = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsPutOwn(o, ""name"", JsS(""Error""))" + NL
    t = t + "    JsPutOwn(o, ""message"", JsS(""""))" + NL
    t = t + "    JsPutOwn(o, ""constructor"", JsGetProp(jsGlobal, ""Error""))" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""Error"")), ""prototype"", JsO(o))" + NL
    t = t + "    jsErrorProto = o" + NL
    t = t + "    FOR EACH kind IN [""TypeError"", ""RangeError"", ""SyntaxError"", ""ReferenceError""]" + NL
    t = t + "        o = JsNewObject(""Object"", jsErrorProto)" + NL
    t = t + "        JsPutOwn(o, ""name"", JsS(kind))" + NL
    t = t + "        JsPutOwn(JsId(JsGetProp(jsGlobal, kind)), ""prototype"", JsO(o))" + NL
    t = t + "    NEXT" + NL
    t = t + "" + NL
    t = t + "    mathObj = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(mathObj, ""Math."", ""abs,floor,ceil,round,random,max,min,sqrt,pow,sin,cos,tan,atan,exp,log"")" + NL
    t = t + "    JsPutOwn(mathObj, ""PI"", JsN(MATH.Pi))" + NL
    t = t + "    JsPutOwn(mathObj, ""E"", JsN(MATH.Exp(1)))" + NL
    t = t + "    JsPutOwn(mathObj, ""LN2"", JsN(MATH.Log(2)))" + NL
    t = t + "    JsPutOwn(mathObj, ""LN10"", JsN(MATH.Log(10)))" + NL
    t = t + "    JsPutOwn(mathObj, ""SQRT2"", JsN(MATH.Sqrt(2)))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""Math"", JsO(mathObj))" + NL
    t = t + "" + NL
    t = t + "    jsDocument = JsNewObject(""Document"", jsObjectProto)" + NL
    t = t + "    JsMethods(jsDocument, ""document."", ""write,writeln,getElementById"")" + NL
    t = t + "    JsPutOwn(jsDocument, ""open"", JsNative(""noop""))" + NL
    t = t + "    JsPutOwn(jsDocument, ""close"", JsNative(""noop""))" + NL
    t = t + "    jsFormsArray = JsNewArray(none)" + NL
    t = t + "    JsPutOwn(jsDocument, ""forms"", JsO(jsFormsArray))" + NL
    t = t + "    JsPutOwn(jsDocument, ""images"", JsO(JsNewArray(none)))" + NL
    t = t + "    JsPutOwn(jsDocument, ""links"", JsO(JsNewArray(none)))" + NL
    t = t + "    JsPutOwn(jsDocument, ""bgColor"", JsS(""#FFFFFF""))" + NL
    t = t + "    JsPutOwn(jsDocument, ""fgColor"", JsS(""#000000""))" + NL
    t = t + "    JsPutOwn(jsDocument, ""all"", JsO(JsNewObject(""All"", jsObjectProto)))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""document"", JsO(jsDocument))" + NL
    t = t + "" + NL
    t = t + "    ' XMLHttpRequest, IE's ActiveXObject for it, and fetch" + NL
    t = t + "    jsXhrProto = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(jsXhrProto, ""XHR."", ""open,setRequestHeader,send,abort,getResponseHeader,getAllResponseHeaders"")" + NL
    t = t + "    jsPromiseProto = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(jsPromiseProto, ""Promise."", ""then,catch"")" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""Promise"")), ""prototype"", JsO(jsPromiseProto))" + NL
    t = t + "    JsMethods(JsId(JsGetProp(jsGlobal, ""Promise"")), ""PromiseS."", ""resolve,reject,all,race"")" + NL
    t = t + "    jqP.Clear()" + NL
    t = t + "    jqOk.Clear()" + NL
    t = t + "    jqErr.Clear()" + NL
    t = t + "    jqChild.Clear()" + NL
    t = t + "    JsMethods(jsGlobal, """", ""XMLHttpRequest,ActiveXObject,fetch"")" + NL
    t = t + "" + NL
    t = t + "    jsLocation = JsNewObject(""Location"", jsObjectProto)" + NL
    t = t + "    JsPutOwn(jsDocument, ""location"", JsO(jsLocation))" + NL
    t = t + "" + NL
    t = t + "    o = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(o, ""history."", ""back,forward,go"")" + NL
    t = t + "    JsPutOwn(o, ""length"", JsN(HostHistory(0)))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""history"", JsO(o))" + NL
    t = t + "" + NL
    t = t + "    o = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsPutOwn(o, ""appName"", JsS(""Simxplorer""))" + NL
    t = t + "    JsPutOwn(o, ""appCodeName"", JsS(""Mozilla""))" + NL
    t = t + "    JsPutOwn(o, ""appVersion"", JsS(""2.0 (compatible; Simxplorer 3.02; SIM95)""))" + NL
    t = t + "    JsPutOwn(o, ""userAgent"", JsS(""Mozilla/2.0 (compatible; Simxplorer 3.02; SIM95)""))" + NL
    t = t + "    JsPutOwn(o, ""platform"", JsS(""SIM95""))" + NL
    t = t + "    JsPutOwn(o, ""javaEnabled"", JsNative(""navigator.javaEnabled""))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""navigator"", JsO(o))" + NL
    t = t + "" + NL
    t = t + "    o = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsPutOwn(o, ""width"", ""n640"")" + NL
    t = t + "    JsPutOwn(o, ""height"", ""n480"")" + NL
    t = t + "    JsPutOwn(o, ""colorDepth"", ""n4"")" + NL
    t = t + "    JsPutOwn(jsGlobal, ""screen"", JsO(o))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Runs a script on the page. Returns """" or ""line|message""." + NL
    t = t + "FUNCTION JsRun (source AS String, firstLine AS Integer) AS String" + NL
    t = t + "    VAR prog AS Integer" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    jsDepth = 0" + NL
    t = t + "    jsSteps = 0" + NL
    t = t + "    jsLimit = JSSTEPLIMIT" + NL
    t = t + "    jsThrown = """"" + NL
    t = t + "    jsRet = ""u""" + NL
    t = t + "    jsLineBase = firstLine" + NL
    t = t + "    TRY" + NL
    t = t + "        prog = JsParse(source)" + NL
    t = t + "        JsHoist(prog, jsGlobal)" + NL
    t = t + "        JsExec(prog, jsGlobal)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        RETURN JsTidyError(err)" + NL
    t = t + "    END TRY" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Runs an event handler (onclick=""...""): like a function body, so ""return" + NL
    t = t + "' false"" works. The value it returned is in jsRet." + NL
    t = t + "FUNCTION JsHandler (code AS String) AS String" + NL
    t = t + "    RETURN JsRun(code, 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' An event handler on an element: a function body whose this is the element" + NL
    t = t + "' (thisVal), so onclick=""check(this.form)"" works. Its vars are its own." + NL
    t = t + "FUNCTION JsHandlerOn (code AS String, thisVal AS String) AS String" + NL
    t = t + "    VAR prog AS Integer" + NL
    t = t + "    VAR scope AS Integer" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    jsDepth = 0" + NL
    t = t + "    jsSteps = 0" + NL
    t = t + "    jsLimit = JSSTEPLIMIT" + NL
    t = t + "    jsThrown = """"" + NL
    t = t + "    jsRet = ""u""" + NL
    t = t + "    jsLineBase = 1" + NL
    t = t + "    TRY" + NL
    t = t + "        prog = JsParse(code)" + NL
    t = t + "        scope = JsNewScope(jsGlobal, thisVal)" + NL
    t = t + "        JsHoist(prog, scope)" + NL
    t = t + "        JsExec(prog, scope)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        RETURN JsTidyError(err)" + NL
    t = t + "    END TRY" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Calls a function value (for setTimeout(f, ms)). Returns """" or an error." + NL
    t = t + "FUNCTION JsCallValue (fn AS String) AS String" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    jsDepth = 0" + NL
    t = t + "    jsSteps = 0" + NL
    t = t + "    jsLimit = JSSTEPLIMIT" + NL
    t = t + "    jsThrown = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        jsRet = JsCall(fn, JsO(jsGlobal), none)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        RETURN JsTidyError(err)" + NL
    t = t + "    END TRY" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsTidyError (err AS String) AS String" + NL
    t = t + "    VAR thrown AS String" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    jsDepth = 0" + NL
    t = t + "    thrown = jsThrown" + NL
    t = t + "    jsThrown = """"" + NL
    t = t + "    IF err.Contains(""@thrown"") THEN" + NL
    t = t + "        IF thrown.StartsWith(""o"") THEN RETURN err.Substring(0, err.IndexOf(""|"")) + ""|Exception thrown and not caught: "" + JsStr(JsGet(thrown, ""message""))" + NL
    t = t + "        RETURN err.Substring(0, err.IndexOf(""|"")) + ""|Exception thrown and not caught: "" + JsStr(thrown)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF err.Contains(""@aborted"") THEN RETURN Str(jsLine) + ""|@aborted""" + NL
    t = t + "    IF err.Contains(""Stack overflow"") THEN RETURN Str(jsLine) + ""|Out of stack space""" + NL
    t = t + "    IF err.Contains(""|"") AND OnlyChars(err.Substring(0, err.IndexOf(""|"")), ""0123456789"") AND err.IndexOf(""|"") > 0 THEN RETURN err" + NL
    t = t + "    RETURN Str(jsLine) + ""|"" + err" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\PROGRAMS\NODE.SPK")
END SUB
