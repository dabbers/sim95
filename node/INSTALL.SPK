    t = t + "  if (rel) {" + NL
    t = t + "    var base = __n.fullpath(r.charAt(1) === "":"" ? r : dir + ""\\"" + r);" + NL
    t = t + "    var found = __tryFile(base) || __tryDir(base);" + NL
    t = t + "    if (found) return found;" + NL
    t = t + "  } else {" + NL
    t = t + "    // a package: NODE_MOD folders from here up, then C:\NODE\MODULES" + NL
    t = t + "    var parts = r.split(""/"").join(""\\"").split(""\\"");" + NL
    t = t + "    var rest = parts.slice(1).join(""\\"");" + NL
    t = t + "    var d = dir;" + NL
    t = t + "    while (true) {" + NL
    t = t + "      var p = __n.fullpath(d + ""\\NODE_MOD\\"" + parts[0] + (rest ? ""\\"" + rest : """"));" + NL
    t = t + "      var hit = rest ? (__tryFile(p) || __tryDir(p)) : __tryDir(p);" + NL
    t = t + "      if (hit) return hit;" + NL
    t = t + "      var up = __dirOf(d);" + NL
    t = t + "      if (up === d) break;" + NL
    t = t + "      d = up;" + NL
    t = t + "    }" + NL
    t = t + "    var g = __n.fullpath(""C:\\NODE\\MODULES\\"" + parts[0] + (rest ? ""\\"" + rest : """"));" + NL
    t = t + "    var hit2 = rest ? (__tryFile(g) || __tryDir(g)) : __tryDir(g);" + NL
    t = t + "    if (hit2) return hit2;" + NL
    t = t + "  }" + NL
    t = t + "  var e = new Error(""Cannot find module '"" + request + ""'"");" + NL
    t = t + "  e.code = ""MODULE_NOT_FOUND"";" + NL
    t = t + "  throw e;" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function __load(request, parent) {" + NL
    t = t + "  var dir = parent ? __dirOf(parent.filename) : __n.info(""cwd"");" + NL
    t = t + "  var file = __resolve(request, dir);" + NL
    t = t + "  if (__cache[file]) return __cache[file].exports;" + NL
    t = t + "  var name = file;" + NL
    t = t + "  if (file.substring(0, 5) === ""core:"") name = ""C:\\NODE\\LIB\\"" + __core[file.substring(5)] + "".JS"";" + NL
    t = t + "  var m = new Module(file, name);" + NL
    t = t + "  __cache[file] = m;" + NL
    t = t + "  if (parent) parent.children.push(m);" + NL
    t = t + "  if (name.substring(name.length - 4) === "".JSN"") {" + NL
    t = t + "    m.exports = JSON.parse(__n.fsRead(name));" + NL
    t = t + "  } else {" + NL
    t = t + "    var fn = __n.compile(__n.fsRead(name), name);" + NL
    t = t + "    fn.call(m.exports, m.exports, __requireFor(m), m, name, __dirOf(name));" + NL
    t = t + "  }" + NL
    t = t + "  m.loaded = true;" + NL
    t = t + "  return m.exports;" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function __requireFor(m) {" + NL
    t = t + "  var r = function (request) { return __load(request, m); };" + NL
    t = t + "  r.resolve = function (request) {" + NL
    t = t + "    var f = __resolve(request, __dirOf(m.filename));" + NL
    t = t + "    return f.substring(0, 5) === ""core:"" ? f.substring(5) : f;" + NL
    t = t + "  };" + NL
    t = t + "  r.cache = __cache;" + NL
    t = t + "  r.main = __main;" + NL
    t = t + "  return r;" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "var __main = null;" + NL
    t = t + "global.require = __requireFor(new Module(""."", __n.info(""cwd"") + ""\\[eval]""));" + NL
    t = t + "global.module = undefined;" + NL
    t = t + "" + NL
    t = t + "// ---------------------------------------------------------------- events from the SPARK side" + NL
    t = t + "" + NL
    t = t + "var __sockets = {};   // by id: net.Socket (net.js puts them here)" + NL
    t = t + "var __servers = {};   // by slot: net.Server" + NL
    t = t + "var __lookups = {};   // by id: callback(address)" + NL
    t = t + "var __lineFn = null;  // what the next typed line goes to" + NL
    t = t + "" + NL
    t = t + "function __uncaught(e) {" + NL
    t = t + "  if (e && e.__exit) return;" + NL
    t = t + "  if (process.listenerCount(""uncaughtException"") > 0) { process.emit(""uncaughtException"", e); return; }" + NL
    t = t + "  if (__repl) { __n.write(""Uncaught "" + __inspect(e) + ""\n""); return; }" + NL
    t = t + "  __n.write(""\n"" + (e && e.stack ? e.stack : ""Uncaught "" + __inspect(e)) + ""\n"");" + NL
    t = t + "  if (e && e.code === ""MODULE_NOT_FOUND"") __n.write(""\nNode.js "" + process.version + ""\n"");" + NL
    t = t + "  __n.exit(1);" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function __dispatch(kind, a, b) {" + NL
    t = t + "  try {" + NL
    t = t + "    switch (kind) {" + NL
    t = t + "      case ""exit"":" + NL
    t = t + "        var code = process.exitCode || 0;" + NL
    t = t + "        if (!__exiting) { __exiting = true; process.emit(""exit"", code); }" + NL
    t = t + "        __n.exit(process.exitCode || code);" + NL
    t = t + "        break;" + NL
    t = t + "      case ""main"":" + NL
    t = t + "        if (!__isFile(a)) {" + NL
    t = t + "          var nf = new Error(""Cannot find module '"" + a + ""'"");" + NL
    t = t + "          nf.code = ""MODULE_NOT_FOUND"";" + NL
    t = t + "          throw nf;" + NL
    t = t + "        }" + NL
    t = t + "        var m = new Module(""."", a);" + NL
    t = t + "        __main = m;" + NL
    t = t + "        __cache[a] = m;" + NL
    t = t + "        var fn = __n.compile(__n.fsRead(a), a);" + NL
    t = t + "        fn.call(m.exports, m.exports, __requireFor(m), m, a, __dirOf(a));" + NL
    t = t + "        m.loaded = true;" + NL
    t = t + "        break;" + NL
    t = t + "      case ""eval"": __n.eval(a); break;" + NL
    t = t + "      case ""repl"": __startRepl(); break;" + NL
    t = t + "      case ""call"": a(); break;" + NL
    t = t + "      case ""code"": __n.eval(a); break;" + NL
    t = t + "      case ""accept"": if (__servers[a]) __servers[a]._accept(b); break;" + NL
    t = t + "      case ""listenerror"": if (__servers[a]) __servers[a]._fail(b); break;" + NL
    t = t + "      case ""data"": if (__sockets[a]) __sockets[a]._data(b); break;" + NL
    t = t + "      case ""close"": if (__sockets[a]) __sockets[a]._closed(); break;" + NL
    t = t + "      case ""connect"": if (__sockets[a]) __sockets[a]._connected(); break;" + NL
    t = t + "      case ""connerror"": if (__sockets[a]) __sockets[a]._fail(b); break;" + NL
    t = t + "      case ""resolved"": var cb = __lookups[a]; delete __lookups[a]; if (cb) cb(b); break;" + NL
    t = t + "      case ""line"": var lf = __lineFn; __lineFn = null; if (lf) lf(a); break;" + NL
    t = t + "    }" + NL
    t = t + "  } catch (e) {" + NL
    t = t + "    __uncaught(e);" + NL
    t = t + "  }" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "// ---------------------------------------------------------------- the prompt" + NL
    t = t + "" + NL
    t = t + "var __repl = false;" + NL
    t = t + "function __startRepl() {" + NL
    t = t + "  __repl = true;" + NL
    t = t + "  __n.write(""Welcome to Node.js "" + process.version + "" on SIM95.\nType \"".help\"" for more information.\n"");" + NL
    t = t + "  var more = """";" + NL
    t = t + "  function next() { __lineFn = take; __n.readLine(more ? ""... "" : ""> ""); }" + NL
    t = t + "  function take(line) {" + NL
    t = t + "    var code = more + line;" + NL
    t = t + "    if (!more && line.trim() === "".exit"") { __n.exit(0); return; }" + NL
    t = t + "    if (!more && line.trim() === "".help"") {" + NL
    t = t + "      __n.write("".exit     Leave the prompt\n.help     This\nAnything else is JavaScript, run here and now. require() finds\nmodules from "" + process.cwd() + "".\n"");" + NL
    t = t + "      next();" + NL
    t = t + "      return;" + NL
    t = t + "    }" + NL
    t = t + "    if (__opens(code) > 0) { more = code + ""\n""; next(); return; }" + NL
    t = t + "    more = """";" + NL
    t = t + "    if (code.trim() === """") { next(); return; }" + NL
    t = t + "    try {" + NL
    t = t + "      var r = __n.eval(code);" + NL
    t = t + "      __n.write(__inspect(r, 2, [0]) + ""\n"");" + NL
    t = t + "      global._ = r;" + NL
    t = t + "    } catch (e) {" + NL
    t = t + "      __n.write(""Uncaught "" + __inspect(e) + ""\n"");" + NL
    t = t + "    }" + NL
    t = t + "    next();" + NL
    t = t + "  }" + NL
    t = t + "  next();" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "// how many more ( [ { a line opens than it closes, outside strings" + NL
    t = t + "function __opens(code) {" + NL
    t = t + "  var n = 0, q = """";" + NL
    t = t + "  for (var i = 0; i < code.length; i++) {" + NL
    t = t + "    var c = code.charAt(i);" + NL
    t = t + "    if (q) { if (c === ""\\"") i++; else if (c === q) q = """"; continue; }" + NL
    t = t + "    if (c === ""'"" || c === '""' || c === ""`"") q = c;" + NL
    t = t + "    else if (c === ""("" || c === ""["" || c === ""{"") n++;" + NL
    t = t + "    else if (c === "")"" || c === ""]"" || c === ""}"") n--;" + NL
    t = t + "  }" + NL
    t = t + "  return n;" + NL
    t = t + "}" + NL
    Put("C:\NODE\LIB\BOOT.JS")
END SUB

SUB File2 ()
    t = ""
    t = t + "// child_process - other programs. SIM95 programs have windows of their own," + NL
    t = t + "// so there is no output to collect: spawn starts one, and that's it." + NL
    t = t + "const EventEmitter = require(""events"");" + NL
    t = t + "class ChildProcess extends EventEmitter {" + NL
    t = t + "  constructor(pid) { super(); this.pid = pid; this.killed = false; this.stdout = new EventEmitter(); this.stderr = new EventEmitter(); }" + NL
    t = t + "  kill() { __n.kill(this.pid); this.killed = true; this.emit(""exit"", null, ""SIGTERM""); return true; }" + NL
    t = t + "}" + NL
    t = t + "function spawn(cmd, args) {" + NL
    t = t + "  let path = cmd;" + NL
    t = t + "  if (path.indexOf(""\\"") < 0 && path.indexOf("":"") < 0) path = ""C:\\PROGRAMS\\"" + path.toUpperCase() + (path.indexOf(""."") < 0 ? "".SPK"" : """");" + NL
    t = t + "  return new ChildProcess(__n.spawn(path, (args || []).join("" "")));" + NL
    t = t + "}" + NL
    t = t + "function exec(cmd, opts, cb) {" + NL
    t = t + "  if (typeof opts === ""function"") cb = opts;" + NL
    t = t + "  const parts = cmd.split("" "").filter((x) => x);" + NL
    t = t + "  const child = spawn(parts[0], parts.slice(1));" + NL
    t = t + "  if (cb) setImmediate(() => cb(null, """", """"));" + NL
    t = t + "  return child;" + NL
    t = t + "}" + NL
    t = t + "module.exports = { spawn, exec, fork: spawn, ChildProcess };" + NL
    Put("C:\NODE\LIB\CHILDPRO.JS")
END SUB

SUB File3 ()
    t = ""
    t = t + "// dns - names to addresses, through the network's name server." + NL
    t = t + "function lookup(name, opts, cb) {" + NL
    t = t + "  if (typeof opts === ""function"") cb = opts;" + NL
    t = t + "  const id = __n.lookup(name);" + NL
    t = t + "  __lookups[id] = (a) => {" + NL
    t = t + "    if (!a) { const e = new Error(""getaddrinfo ENOTFOUND "" + name); e.code = ""ENOTFOUND""; cb(e); return; }" + NL
    t = t + "    cb(null, a, 4);" + NL
    t = t + "  };" + NL
    t = t + "}" + NL
    t = t + "module.exports = {" + NL
    t = t + "  lookup," + NL
    t = t + "  promises: { lookup: (name) => new Promise((ok, no) => lookup(name, (e, a) => (e ? no(e) : ok({ address: a, family: 4 })))) }," + NL
    t = t + "};" + NL
    Put("C:\NODE\LIB\DNS.JS")
END SUB

SUB File4 ()
    t = ""
    t = t + "// events - EventEmitter, as in Node." + NL
    t = t + "class EventEmitter {" + NL
    t = t + "  constructor() { this._events = {}; }" + NL
    t = t + "  _list(name) {" + NL
    t = t + "    if (!this._events) this._events = {};" + NL
    t = t + "    return this._events[name] || (this._events[name] = []);" + NL
    t = t + "  }" + NL
    t = t + "  on(name, fn) {" + NL
    t = t + "    if (this._events && this._events.newListener && name !== ""newListener"") this.emit(""newListener"", name, fn);" + NL
    t = t + "    this._list(name).push(fn);" + NL
    t = t + "    return this;" + NL
    t = t + "  }" + NL
    t = t + "  addListener(name, fn) { return this.on(name, fn); }" + NL
    t = t + "  prependListener(name, fn) { this._list(name).unshift(fn); return this; }" + NL
    t = t + "  once(name, fn) {" + NL
    t = t + "    const self = this;" + NL
    t = t + "    function once() { self.off(name, once); return fn.apply(self, arguments); }" + NL
    t = t + "    once.listener = fn;" + NL
    t = t + "    return this.on(name, once);" + NL
    t = t + "  }" + NL
    t = t + "  off(name, fn) {" + NL
    t = t + "    const l = this._list(name);" + NL
    t = t + "    for (let i = l.length - 1; i >= 0; i--) {" + NL
    t = t + "      if (l[i] === fn || l[i].listener === fn) { l.splice(i, 1); break; }" + NL
    t = t + "    }" + NL
    t = t + "    return this;" + NL
    t = t + "  }" + NL
    t = t + "  removeListener(name, fn) { return this.off(name, fn); }" + NL
    t = t + "  removeAllListeners(name) {" + NL
    t = t + "    if (name === undefined) this._events = {};" + NL
    t = t + "    else if (this._events) delete this._events[name];" + NL
    t = t + "    return this;" + NL
    t = t + "  }" + NL
    t = t + "  emit(name) {" + NL
    t = t + "    const l = this._list(name).slice();" + NL
    t = t + "    const args = Array.prototype.slice.call(arguments, 1);" + NL
    t = t + "    if (name === ""error"" && l.length === 0) {" + NL
    t = t + "      const e = args[0];" + NL
    t = t + "      throw e instanceof Error ? e : new Error(""Unhandled error. ("" + e + "")"");" + NL
    t = t + "    }" + NL
    t = t + "    for (const fn of l) fn.apply(this, args);" + NL
    t = t + "    return l.length > 0;" + NL
    t = t + "  }" + NL
    t = t + "  listeners(name) { return this._list(name).map((f) => f.listener || f); }" + NL
    t = t + "  listenerCount(name) { return this._list(name).length; }" + NL
    t = t + "  eventNames() { return Object.keys(this._events || {}).filter((k) => this._events[k].length > 0); }" + NL
    t = t + "  setMaxListeners() { return this; }" + NL
    t = t + "  getMaxListeners() { return 10; }" + NL
    t = t + "}" + NL
    t = t + "EventEmitter.EventEmitter = EventEmitter;" + NL
    t = t + "EventEmitter.defaultMaxListeners = 10;" + NL
    t = t + "EventEmitter.once = function (emitter, name) {" + NL
    t = t + "  return new Promise((ok) => emitter.once(name, function () { ok(Array.prototype.slice.call(arguments)); }));" + NL
    t = t + "};" + NL
    t = t + "module.exports = EventEmitter;" + NL
    Put("C:\NODE\LIB\EVENTS.JS")
END SUB

SUB File5 ()
    t = ""
    t = t + "// fs - the disk. SIM95 files are text, with 8.3 names; paths are C:\DIR\FILE." + NL
    t = t + "// The ...Sync calls do it now; the others call back (err, result) after." + NL
    t = t + "class Stats {" + NL
    t = t + "  constructor(kind, size) { this._kind = kind; this.size = size; this.mtime = new Date(); this.mode = kind === ""d"" ? 16877 : 33188; }" + NL
    t = t + "  isFile() { return this._kind === ""f""; }" + NL
    t = t + "  isDirectory() { return this._kind === ""d""; }" + NL
    t = t + "  isSymbolicLink() { return false; }" + NL
    t = t + "}" + NL
    t = t + "function text(data) { return typeof data === ""string"" ? data : data === undefined || data === null ? """" : String(data); }" + NL
    t = t + "function notFound(p, op) {" + NL
    t = t + "  const e = new Error(""ENOENT: no such file or directory, "" + op + "" '"" + __n.fullpath(p) + ""'"");" + NL
    t = t + "  e.code = ""ENOENT"";" + NL
    t = t + "  e.errno = -2;" + NL
    t = t + "  e.syscall = op;" + NL
    t = t + "  e.path = __n.fullpath(p);" + NL
    t = t + "  return e;" + NL
    t = t + "}" + NL
    t = t + "const fs = {" + NL
    t = t + "  readFileSync(p) { return __n.fsRead(p); }," + NL
    t = t + "  writeFileSync(p, data) { __n.fsWrite(p, text(data)); }," + NL
    t = t + "  appendFileSync(p, data) { __n.fsAppend(p, text(data)); }," + NL
    t = t + "  existsSync(p) { return __n.fsStat(p) !== null; }," + NL
    t = t + "  statSync(p, opts) {" + NL
    t = t + "    const s = __n.fsStat(p);" + NL
    t = t + "    if (s === null) { if (opts && opts.throwIfNoEntry === false) return undefined; throw notFound(p, ""stat""); }" + NL
    t = t + "    return new Stats(s.charAt(0), parseInt(s.substring(1)));" + NL
    t = t + "  }," + NL
    t = t + "  readdirSync(p, opts) {" + NL
    t = t + "    const names = __n.fsList(p).sort();" + NL
    t = t + "    if (opts && opts.withFileTypes) return names.map((n) => { const s = fs.statSync(p + ""\\"" + n); s.name = n; return s; });" + NL
    t = t + "    return names;" + NL
    t = t + "  }," + NL
    t = t + "  mkdirSync(p, opts) { __n.fsMkdir(p, !!(opts && opts.recursive)); }," + NL
    t = t + "  unlinkSync(p) { if (!fs.existsSync(p) || fs.statSync(p).isDirectory()) throw notFound(p, ""unlink""); __n.fsDelete(p); }," + NL
    t = t + "  rmdirSync(p, opts) {" + NL
    t = t + "    if (opts && opts.recursive) return fs.rmSync(p, { recursive: true });" + NL
    t = t + "    __n.fsDelete(p);" + NL
    t = t + "  }," + NL
    t = t + "  rmSync(p, opts) {" + NL
    t = t + "    if (!fs.existsSync(p)) { if (opts && opts.force) return; throw notFound(p, ""rm""); }" + NL
    t = t + "    if (fs.statSync(p).isDirectory() && opts && opts.recursive) {" + NL
    t = t + "      for (const n of fs.readdirSync(p)) fs.rmSync(p + ""\\"" + n, opts);" + NL
    t = t + "    }" + NL
    t = t + "    __n.fsDelete(p);" + NL
    t = t + "  }," + NL
    t = t + "  renameSync(a, b) { __n.fsRename(a, b); }," + NL
    t = t + "  copyFileSync(a, b) { __n.fsWrite(b, __n.fsRead(a)); }," + NL
    t = t + "  accessSync(p) { if (!fs.existsSync(p)) throw notFound(p, ""access""); }," + NL
    t = t + "  realpathSync(p) { return __n.fullpath(p); }," + NL
    t = t + "  watch() { return { close() {} }; }," + NL
    t = t + "  createWriteStream(p) {" + NL
    t = t + "    __n.fsWrite(p, """");" + NL
    t = t + "    return { write(s) { __n.fsAppend(p, text(s)); return true; }, end(s) { if (s !== undefined) __n.fsAppend(p, text(s)); }, on() { return this; } };" + NL
    t = t + "  }," + NL
    t = t + "  constants: { F_OK: 0, R_OK: 4, W_OK: 2 }," + NL
    t = t + "};" + NL
    t = t + "// the callback and promise kinds, from the Sync ones" + NL
    t = t + "const names = [""readFile"", ""writeFile"", ""appendFile"", ""stat"", ""readdir"", ""mkdir"", ""unlink"", ""rmdir"", ""rm"", ""rename"", ""copyFile"", ""access"", ""realpath""];" + NL
    t = t + "fs.promises = {};" + NL
    t = t + "for (const name of names) {" + NL
    t = t + "  const sync = fs[name + ""Sync""];" + NL
    t = t + "  fs[name] = function () {" + NL
    t = t + "    const args = Array.prototype.slice.call(arguments);" + NL
    t = t + "    const cb = typeof args[args.length - 1] === ""function"" ? args.pop() : null;" + NL
    t = t + "    let err = null, result;" + NL
    t = t + "    try { result = sync.apply(fs, args); } catch (e) { err = e; }" + NL
    t = t + "    if (cb) setImmediate(() => (err ? cb(err) : cb(null, result)));" + NL
    t = t + "  };" + NL
    t = t + "  fs.promises[name] = function () {" + NL
    t = t + "    const args = Array.prototype.slice.call(arguments);" + NL
    t = t + "    return new Promise((ok, no) => { try { ok(sync.apply(fs, args)); } catch (e) { no(e); } });" + NL
    t = t + "  };" + NL
    t = t + "}" + NL
    t = t + "fs.exists = (p, cb) => setImmediate(() => cb(fs.existsSync(p)));" + NL
    t = t + "fs.Stats = Stats;" + NL
    t = t + "module.exports = fs;" + NL
    Put("C:\NODE\LIB\FS.JS")
END SUB

SUB File6 ()
    t = ""
    t = t + "// http - web servers and requests, on SIM95's web: HTTP/1.0, one connection" + NL
    t = t + "// a request. A request comes in one message; a response goes back the same" + NL
    t = t + "// way (Voyager joins what it gets with line breaks, so a big one is cut at" + NL
    t = t + "// lines), and the connection closes." + NL
    t = t + "const net = require(""net"");" + NL
    t = t + "const EventEmitter = require(""events"");" + NL
    t = t + "const urlLib = require(""url"");" + NL
    t = t + "" + NL
    t = t + "const STATUS_CODES = {" + NL
    t = t + "  200: ""OK"", 201: ""Created"", 204: ""No Content"", 301: ""Moved Permanently"", 302: ""Found"", 304: ""Not Modified""," + NL
    t = t + "  400: ""Bad Request"", 401: ""Unauthorized"", 403: ""Forbidden"", 404: ""Not Found"", 405: ""Method Not Allowed""," + NL
    t = t + "  409: ""Conflict"", 500: ""Internal Server Error"", 501: ""Not Implemented"", 503: ""Service Unavailable""," + NL
    t = t + "};" + NL
    t = t + "const CHUNK = 60000;" + NL
    t = t + "" + NL
    t = t + "// ""HEAD\nName: value\n\nbody"" -> {first, headers, body}" + NL
    t = t + "function split(raw) {" + NL
    t = t + "  raw = raw.split(""\r"").join("""");" + NL
    t = t + "  let i = raw.indexOf(""\n\n"");" + NL
    t = t + "  const head = i < 0 ? raw : raw.substring(0, i), body = i < 0 ? """" : raw.substring(i + 2);" + NL
    t = t + "  const lines = head.split(""\n"");" + NL
    t = t + "  const headers = {};" + NL
    t = t + "  for (let k = 1; k < lines.length; k++) {" + NL
    t = t + "    const c = lines[k].indexOf("":"");" + NL
    t = t + "    if (c > 0) headers[lines[k].substring(0, c).trim().toLowerCase()] = lines[k].substring(c + 1).trim();" + NL
    t = t + "  }" + NL
    t = t + "  return { first: lines[0], headers, body };" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function sendCut(socket, text) {" + NL
    t = t + "  // in pieces at line breaks, since each message arrives with one added" + NL
    t = t + "  while (text.length > CHUNK) {" + NL
    t = t + "    let cut = text.lastIndexOf(""\n"", CHUNK);" + NL
    t = t + "    if (cut <= 0) cut = CHUNK;" + NL
    t = t + "    socket.write(text.substring(0, cut));" + NL
    t = t + "    text = text.substring(text.charAt(cut) === ""\n"" ? cut + 1 : cut);" + NL
    t = t + "  }" + NL
    t = t + "  socket.write(text);" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "class IncomingMessage extends EventEmitter {" + NL
    t = t + "  constructor(socket) {" + NL
    t = t + "    super();" + NL
    t = t + "    this.socket = socket;" + NL
    t = t + "    this.headers = {};" + NL
    t = t + "    this.httpVersion = ""1.0"";" + NL
    t = t + "    this.method = null;" + NL
    t = t + "    this.url = null;" + NL
    t = t + "    this.statusCode = null;" + NL
    t = t + "    this.statusMessage = null;" + NL
    t = t + "    this._body = """";" + NL
    t = t + "  }" + NL
    t = t + "  setEncoding() { return this; }" + NL
    t = t + "  _deliver() {" + NL
    t = t + "    setImmediate(() => {" + NL
    t = t + "      if (this._body !== """") this.emit(""data"", this._body);" + NL
    t = t + "      this.emit(""end"");" + NL
    t = t + "      this.emit(""close"");" + NL
    t = t + "    });" + NL
    t = t + "  }" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "class ServerResponse extends EventEmitter {" + NL
    t = t + "  constructor(socket, req) {" + NL
    t = t + "    super();" + NL
    t = t + "    this.socket = socket;" + NL
    t = t + "    this.req = req;" + NL
    t = t + "    this.statusCode = 200;" + NL
    t = t + "    this.statusMessage = """";" + NL
    t = t + "    this._headers = {};" + NL
    t = t + "    this._names = {};" + NL
    t = t + "    this._body = [];" + NL
    t = t + "    this.headersSent = false;" + NL
    t = t + "    this.finished = false;" + NL
    t = t + "    this.writableEnded = false;" + NL
    t = t + "  }" + NL
    t = t + "  setHeader(name, value) { this._headers[name.toLowerCase()] = value; this._names[name.toLowerCase()] = name; return this; }" + NL
    t = t + "  getHeader(name) { return this._headers[name.toLowerCase()]; }" + NL
    t = t + "  getHeaders() { return Object.assign({}, this._headers); }" + NL
    t = t + "  hasHeader(name) { return this._headers[name.toLowerCase()] !== undefined; }" + NL
    t = t + "  removeHeader(name) { delete this._headers[name.toLowerCase()]; }" + NL
    t = t + "  writeHead(code, message, headers) {" + NL
    t = t + "    if (typeof message === ""object"") { headers = message; message = """"; }" + NL
    t = t + "    this.statusCode = code;" + NL
    t = t + "    if (message) this.statusMessage = message;" + NL
    t = t + "    if (headers) for (const k of Object.keys(headers)) this.setHeader(k, headers[k]);" + NL
    t = t + "    return this;" + NL
    t = t + "  }" + NL
    t = t + "  write(chunk, enc, cb) {" + NL
    t = t + "    if (typeof enc === ""function"") cb = enc;" + NL
    t = t + "    if (chunk !== undefined && chunk !== null) this._body.push(String(chunk));" + NL
    t = t + "    if (cb) setImmediate(cb);" + NL
    t = t + "    return true;" + NL
    t = t + "  }" + NL
    t = t + "  end(chunk, enc, cb) {" + NL
    t = t + "    if (typeof chunk === ""function"") { cb = chunk; chunk = undefined; }" + NL
    t = t + "    if (typeof enc === ""function"") cb = enc;" + NL
    t = t + "    if (this.finished) return this;" + NL
    t = t + "    if (chunk !== undefined && chunk !== null) this._body.push(String(chunk));" + NL
    t = t + "    const body = this._body.join("""");" + NL
    t = t + "    if (this._headers[""content-type""] === undefined) this.setHeader(""Content-Type"", ""text/html"");" + NL
    t = t + "    this.setHeader(""Content-Length"", body.length);" + NL
    t = t + "    if (this._headers[""server""] === undefined) this.setHeader(""Server"", ""Node/"" + process.version + "" (SIM95)"");" + NL
    t = t + "    let head = ""HTTP/1.0 "" + this.statusCode + "" "" + (this.statusMessage || STATUS_CODES[this.statusCode] || ""OK"");" + NL
    t = t + "    for (const k of Object.keys(this._headers)) [].concat(this._headers[k]).forEach((v) => (head += ""\n"" + this._names[k] + "": "" + v));" + NL
    t = t + "    this.headersSent = true;" + NL
    t = t + "    this.finished = true;" + NL
    t = t + "    this.writableEnded = true;" + NL
    t = t + "    sendCut(this.socket, head + ""\n\n"" + body);" + NL
    t = t + "    this.socket.end();" + NL
    t = t + "    this.emit(""finish"");" + NL
    t = t + "    if (cb) setImmediate(cb);" + NL
    t = t + "    return this;" + NL
    t = t + "  }" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "class Server extends net.Server {" + NL
    t = t + "  constructor(opts, handler) {" + NL
    t = t + "    super();" + NL
    t = t + "    if (typeof opts === ""function"") handler = opts;" + NL
    t = t + "    if (handler) this.on(""request"", handler);" + NL
    t = t + "    this.on(""connection"", (socket) => {" + NL
    t = t + "      let got = false;" + NL
    t = t + "      socket.on(""data"", (raw) => {" + NL
    t = t + "        if (got) return;" + NL
    t = t + "        got = true;" + NL
    t = t + "        const p = split(raw);" + NL
    t = t + "        const req = new IncomingMessage(socket);" + NL
    t = t + "        const parts = p.first.split("" "");" + NL
    t = t + "        req.method = (parts[0] || ""GET"").toUpperCase();" + NL
    t = t + "        req.url = parts[1] || ""/"";" + NL
    t = t + "        req.httpVersion = (parts[2] || ""HTTP/1.0"").replace(""HTTP/"", """");" + NL
    t = t + "        req.headers = p.headers;" + NL
    t = t + "        req._body = p.body;" + NL
    t = t + "        const res = new ServerResponse(socket, req);" + NL
    t = t + "        this.emit(""request"", req, res);" + NL
    t = t + "        req._deliver();" + NL
    t = t + "      });" + NL
    t = t + "    });" + NL
    t = t + "  }" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function createServer(opts, handler) { return new Server(opts, handler); }" + NL
    t = t + "" + NL
    t = t + "class ClientRequest extends EventEmitter {" + NL
    t = t + "  constructor(opts, cb) {" + NL
    t = t + "    super();" + NL
    t = t + "    if (typeof opts === ""string"") opts = urlLib.parse(opts);" + NL
    t = t + "    else if (opts && opts.href && opts.searchParams) opts = urlLib.parse(opts.href);" + NL
    t = t + "    this.method = (opts.method || ""GET"").toUpperCase();" + NL
    t = t + "    this.host = opts.hostname || opts.host || ""localhost"";" + NL
    t = t + "    if (this.host.indexOf("":"") >= 0) this.host = this.host.substring(0, this.host.indexOf("":""));" + NL
    t = t + "    this.port = parseInt(opts.port || 80);" + NL
    t = t + "    this.path = opts.path || opts.pathname || ""/"";" + NL
    t = t + "    this._headers = Object.assign({}, opts.headers || {});" + NL
    t = t + "    this._body = [];" + NL
    t = t + "    if (cb) this.once(""response"", cb);" + NL
    t = t + "  }" + NL
    t = t + "  setHeader(k, v) { this._headers[k] = v; }" + NL
    t = t + "  getHeader(k) { return this._headers[k]; }" + NL
    t = t + "  write(chunk) { this._body.push(String(chunk)); return true; }" + NL
    t = t + "  setTimeout() { return this; }" + NL
    t = t + "  abort() { if (this._socket) this._socket.destroy(); }" + NL
    t = t + "  destroy() { this.abort(); }" + NL
    t = t + "  end(chunk) {" + NL
    t = t + "    if (chunk !== undefined) this._body.push(String(chunk));" + NL
    t = t + "    const body = this._body.join("""");" + NL
    t = t + "    let head = this.method + "" "" + this.path + "" HTTP/1.0\nHost: "" + this.host + (this.port !== 80 ? "":"" + this.port : """");" + NL
    t = t + "    if (!Object.keys(this._headers).some((k) => k.toLowerCase() === ""user-agent"")) head += ""\nUser-Agent: Node/"" + process.version + "" (SIM95)"";" + NL
    t = t + "    for (const k of Object.keys(this._headers)) head += ""\n"" + k + "": "" + this._headers[k];" + NL
    t = t + "    if (body !== """" || this.method === ""POST"" || this.method === ""PUT"") {" + NL
    t = t + "      if (!Object.keys(this._headers).some((k) => k.toLowerCase() === ""content-type"")) head += ""\nContent-Type: application/x-www-form-urlencoded"";" + NL
    t = t + "      head += ""\nContent-Length: "" + body.length + ""\n\n"" + body;" + NL
    t = t + "    }" + NL
    t = t + "    const got = [];" + NL
    t = t + "    const s = net.connect(this.port, this.host, () => s.write(head));" + NL
    t = t + "    this._socket = s;" + NL
    t = t + "    s.on(""data"", (m) => got.push(m));" + NL
    t = t + "    s.on(""error"", (e) => this.emit(""error"", e));" + NL
    t = t + "    s.on(""close"", (failed) => {" + NL
    t = t + "      if (failed) return;" + NL
    t = t + "      const p = split(got.join(""\n""));" + NL
    t = t + "      const res = new IncomingMessage(s);" + NL
    t = t + "      const parts = p.first.split("" "");" + NL
    t = t + "      res.httpVersion = (parts[0] || ""HTTP/1.0"").replace(""HTTP/"", """");" + NL
    t = t + "      res.statusCode = parseInt(parts[1]) || 0;" + NL
    t = t + "      res.statusMessage = parts.slice(2).join("" "");" + NL
    t = t + "      res.headers = p.headers;" + NL
    t = t + "      res._body = p.body;" + NL
    t = t + "      this.emit(""response"", res);" + NL
    t = t + "      res._deliver();" + NL
    t = t + "    });" + NL
    t = t + "    return this;" + NL
    t = t + "  }" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function request(opts, cb) { return new ClientRequest(opts, cb); }" + NL
    t = t + "function get(opts, cb) { const r = request(opts, cb); r.end(); return r; }" + NL
    t = t + "" + NL
    t = t + "module.exports = { createServer, Server, request, get, IncomingMessage, ServerResponse, ClientRequest, STATUS_CODES, METHODS: [""GET"", ""POST"", ""PUT"", ""DELETE"", ""HEAD""] };" + NL
    Put("C:\NODE\LIB\HTTP.JS")
END SUB

SUB File7 ()
    t = ""
    t = t + "// net - servers and connections. SIM95's network carries whole messages:" + NL
    t = t + "// each write() is one message, and each 'data' event is one." + NL
    t = t + "const EventEmitter = require(""events"");" + NL
    t = t + "" + NL
    t = t + "class Socket extends EventEmitter {" + NL
    t = t + "  constructor(id) {" + NL
    t = t + "    super();" + NL
    t = t + "    this._id = id === undefined ? 0 : id;" + NL
    t = t + "    this.remoteAddress = undefined;" + NL
    t = t + "    this.remotePort = undefined;" + NL
    t = t + "    this.destroyed = false;" + NL
    t = t + "    this.connecting = false;" + NL
    t = t + "    this.writable = id !== undefined;" + NL
    t = t + "    this.bytesRead = 0;" + NL
    t = t + "    this.bytesWritten = 0;" + NL
    t = t + "    this.encoding = ""utf8"";" + NL
    t = t + "    if (id !== undefined) { __sockets[id] = this; this._peer(); }" + NL
    t = t + "  }" + NL
    t = t + "  _peer() {" + NL
    t = t + "    const p = __n.peer(this._id);" + NL
    t = t + "    if (p) { const i = p.lastIndexOf("":""); this.remoteAddress = p.substring(0, i); this.remotePort = parseInt(p.substring(i + 1)); }" + NL
    t = t + "  }" + NL
    t = t + "  connect(port, host, cb) {" + NL
    t = t + "    if (typeof port === ""object"") { cb = host; host = port.host; port = port.port; }" + NL
    t = t + "    if (typeof host === ""function"") { cb = host; host = undefined; }" + NL
    t = t + "    this._id = __n.connect(host || ""localhost"", port);" + NL
    t = t + "    __sockets[this._id] = this;" + NL
    t = t + "    this.connecting = true;" + NL
    t = t + "    if (cb) this.once(""connect"", cb);" + NL
    t = t + "    return this;" + NL
    t = t + "  }" + NL
    t = t + "  _connected() { this.connecting = false; this.writable = true; this._peer(); this.emit(""connect""); this.emit(""ready""); }" + NL
    t = t + "  _fail(why) {" + NL
    t = t + "    this.connecting = false;" + NL
    t = t + "    delete __sockets[this._id];" + NL
    t = t + "    const e = new Error(why.indexOf(""refused"") >= 0 ? ""connect ECONNREFUSED "" + why : why);" + NL
    t = t + "    e.code = why.indexOf(""refused"") >= 0 ? ""ECONNREFUSED"" : why.indexOf(""Unknown host"") >= 0 ? ""ENOTFOUND"" : ""ETIMEDOUT"";" + NL
    t = t + "    this.destroyed = true;" + NL
    t = t + "    this.emit(""error"", e);" + NL
    t = t + "    this.emit(""close"", true);" + NL
    t = t + "  }" + NL
    t = t + "  _data(message) { this.bytesRead += message.length; this.emit(""data"", message); }" + NL
    t = t + "  _closed() {" + NL
    t = t + "    if (this.destroyed) return;" + NL
    t = t + "    this.destroyed = true;" + NL
    t = t + "    this.writable = false;" + NL
    t = t + "    delete __sockets[this._id];" + NL
    t = t + "    this.emit(""end"");" + NL
    t = t + "    this.emit(""close"", false);" + NL
    t = t + "  }" + NL
    t = t + "  write(data, enc, cb) {" + NL
    t = t + "    if (typeof enc === ""function"") cb = enc;" + NL
    t = t + "    const ok = __n.send(this._id, String(data));" + NL
    t = t + "    this.bytesWritten += String(data).length;" + NL
    t = t + "    if (cb) setImmediate(cb);" + NL
    t = t + "    return ok;" + NL
    t = t + "  }" + NL
    t = t + "  end(data, enc, cb) {" + NL
    t = t + "    if (typeof data === ""function"") { cb = data; data = undefined; }" + NL
    t = t + "    if (data !== undefined && data !== null) this.write(data);" + NL
    t = t + "    if (cb) this.once(""close"", cb);" + NL
    t = t + "    __n.end(this._id);" + NL
    t = t + "    return this;" + NL
    t = t + "  }" + NL
    t = t + "  destroy() { if (!this.destroyed) __n.end(this._id); return this; }" + NL
    t = t + "  setEncoding(e) { this.encoding = e; return this; }" + NL
    t = t + "  setTimeout() { return this; }" + NL
    t = t + "  setNoDelay() { return this; }" + NL
    t = t + "  setKeepAlive() { return this; }" + NL
    t = t + "  pause() { return this; }" + NL
    t = t + "  resume() { return this; }" + NL
    t = t + "  ref() { return this; }" + NL
    t = t + "  unref() { return this; }" + NL
    t = t + "  address() { return { address: __n.info(""address""), family: ""IPv4"" }; }" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "class Server extends EventEmitter {" + NL
    t = t + "  constructor(opts, onConnection) {" + NL
    t = t + "    super();" + NL
    t = t + "    if (typeof opts === ""function"") onConnection = opts;" + NL
    t = t + "    if (onConnection) this.on(""connection"", onConnection);" + NL
    t = t + "    this._slot = -1;" + NL
    t = t + "    this.listening = false;" + NL
    t = t + "    this._port = 0;" + NL
    t = t + "  }" + NL
    t = t + "  listen(port, host, cb) {" + NL
    t = t + "    if (typeof port === ""object"" && port !== null) port = port.port;" + NL
    t = t + "    if (typeof host === ""function"") cb = host;" + NL
    t = t + "    if (cb) this.once(""listening"", cb);" + NL
    t = t + "    this._port = port || 0;" + NL
    t = t + "    try {" + NL
    t = t + "      this._slot = __n.listen(this._port);" + NL
    t = t + "    } catch (e) {" + NL
    t = t + "      const err = new Error(""listen EADDRINUSE: address already in use :::"" + this._port);" + NL
    t = t + "      err.code = ""EADDRINUSE"";" + NL
    t = t + "      setImmediate(() => this.emit(""error"", err));" + NL
    t = t + "      return this;" + NL
    t = t + "    }" + NL
    t = t + "    __servers[this._slot] = this;" + NL
    t = t + "    this.listening = true;" + NL
    t = t + "    setImmediate(() => this.emit(""listening""));" + NL
    t = t + "    return this;" + NL
    t = t + "  }" + NL
    t = t + "  _accept(id) { this.emit(""connection"", new Socket(id)); }" + NL
    t = t + "  _fail(why) {" + NL
    t = t + "    this.listening = false;" + NL
    t = t + "    delete __servers[this._slot];" + NL
    t = t + "    const err = new Error(why.indexOf(""in use"") >= 0 ? ""listen EADDRINUSE: address already in use :::"" + this._port : why);" + NL
    t = t + "    err.code = why.indexOf(""in use"") >= 0 ? ""EADDRINUSE"" : ""EACCES"";" + NL
    t = t + "    this.emit(""error"", err);" + NL
    t = t + "  }" + NL
    t = t + "  close(cb) {" + NL
    t = t + "    if (this._slot >= 0) { __n.unlisten(this._slot); delete __servers[this._slot]; }" + NL
    t = t + "    this.listening = false;" + NL
    t = t + "    setImmediate(() => { this.emit(""close""); if (cb) cb(); });" + NL
    t = t + "    return this;" + NL
    t = t + "  }" + NL
    t = t + "  address() { return { port: this._port, family: ""IPv4"", address: __n.info(""address"") }; }" + NL
    t = t + "  ref() { return this; }" + NL
    t = t + "  unref() { return this; }" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function createServer(opts, onConnection) { return new Server(opts, onConnection); }" + NL
    t = t + "function connect(port, host, cb) {" + NL
    t = t + "  const s = new Socket();" + NL
    t = t + "  return s.connect(port, host, cb);" + NL
    t = t + "}" + NL
    t = t + "module.exports = { Socket, Server, createServer, connect, createConnection: connect, isIP: (s) => (String(s).split(""."").length === 4 ? 4 : 0) };" + NL
    Put("C:\NODE\LIB\NET.JS")
END SUB

SUB File8 ()
    t = ""
    t = t + "// os - this machine." + NL
    t = t + "module.exports = {" + NL
    t = t + "  EOL: ""\n""," + NL
    t = t + "  hostname: () => process.env.HOSTNAME," + NL
    t = t + "  platform: () => ""sim95""," + NL
    t = t + "  type: () => ""SIM95""," + NL
    t = t + "  release: () => ""1.0""," + NL
    t = t + "  arch: () => ""x86""," + NL
    t = t + "  homedir: () => ""C:\\MYFILES""," + NL
    t = t + "  tmpdir: () => ""C:\\MYFILES""," + NL
    t = t + "  uptime: () => process.uptime()," + NL
    t = t + "  cpus: () => [{ model: ""SIM 486DX2/66"", speed: 66 }]," + NL
    t = t + "  totalmem: () => 16 * 1024 * 1024," + NL
    t = t + "  freemem: () => 8 * 1024 * 1024," + NL
    t = t + "  loadavg: () => [0, 0, 0]," + NL
    t = t + "  userInfo: () => ({ username: ""user"", homedir: ""C:\\MYFILES"" })," + NL
    t = t + "  networkInterfaces: () => ({ modem: [{ address: __n.info(""address""), family: ""IPv4"", internal: false }] })," + NL
