    t = t + "    __n.write(label + "": "" + (__n.info(""now"") - (__timers[label] || 0)) + ""ms\n"");" + NL
    t = t + "    delete __timers[label];" + NL
    t = t + "  }," + NL
    t = t + "  assert: function (ok) { if (!ok) __n.write(""Assertion failed"" + (arguments.length > 1 ? "": "" + __format.apply(null, Array.prototype.slice.call(arguments, 1)) : """") + ""\n""); }," + NL
    t = t + "};" + NL
    t = t + "var __timers = {};" + NL
    t = t + "global.console = console;" + NL
    t = t + "" + NL
    t = t + "var __listeners = {};" + NL
    t = t + "var __exiting = false;" + NL
    t = t + "var process = {" + NL
    t = t + "  title: ""node""," + NL
    t = t + "  version: __n.info(""version"")," + NL
    t = t + "  versions: { node: __n.info(""version"").substring(1), sim95: ""1"" }," + NL
    t = t + "  platform: ""sim95""," + NL
    t = t + "  arch: ""x86""," + NL
    t = t + "  pid: __n.info(""pid"")," + NL
    t = t + "  argv: __n.args()," + NL
    t = t + "  execPath: ""C:\\PROGRAMS\\NODE.SPK""," + NL
    t = t + "  env: { HOME: ""C:\\MYFILES"", PATH: ""C:\\PROGRAMS"", HOSTNAME: __n.info(""hostname""), NODE_PATH: ""C:\\NODE\\MODULES"" }," + NL
    t = t + "  exitCode: 0," + NL
