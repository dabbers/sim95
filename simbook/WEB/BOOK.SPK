' BOOK.SPK - SimBook, a little social network for SIM95.
' SimBook is the machine's home page: it lives in C:\WEB, and every page pulls this in with <%@ import file="BOOK.SPK" %>.
'
' There is no database server: everything lives in plain text files under
' C:\BOOKDATA (outside C:\WEB, so the web server never hands it out), and every
' change is written to disk the moment it happens. Nothing is kept in memory
' between requests.
'
'   C:\BOOKDATA\USERS\<user>.TXT    one profile, key=value per line
'   C:\BOOKDATA\FRIENDS\<user>.TXT  |ann|bob|cat|  (friendship is mutual)
'   C:\BOOKDATA\WALLS\<user>.TXT    every post on that user's wall, oldest first
'   C:\BOOKDATA\LOG\<n>.TXT         every post, LOGSIZE to a file: the feed reads these
'   C:\BOOKDATA\PEOPLE.TXT          user|name, one per member, for the directory
'   C:\BOOKDATA\SESSIONS\<id>.TXT   who a sign-in cookie belongs to, and its form token
'   C:\BOOKDATA\NEXTID.TXT          the last post number handed out (NEXTRID: replies)
'   C:\BOOKDATA\VOTES\<post>.TXT    |ann+|bob-|  thumbs up and down on one post
'   C:\BOOKDATA\REPLIES\<post>.TXT  replies to one post, one per line
'   C:\BOOKDATA\NOTES\<user>.TXT    their notifications (and .SEE: how far they read)
'   C:\BOOKDATA\POKES\<user>.TXT    |bob|cat|  who has poked them
'   C:\BOOKDATA\ALBUMS\<user>.TXT   |12|40|  which posts are their photos
'   C:\WEB\PICS\<user>.PIC          profile pictures (Sketch .PIC files)
'   C:\WEB\PHOTOS\<post>.PIC        photos
'
' A post is one line: id|date time|author|author name|wall|wall name|text
' Names and text are escaped with Esc so they never contain | or a line break.
'
' A server page that runs too long is stopped, and the whole page is built
' before Voyager sees any of it, so loops here stay short: the feed and walls
' stop after a screenful, and the feed only looks back through recent posts.

CONST DATADIR = "C:\BOOKDATA"
' Pictures and photos live beside the pages (C:\WEB\PICS, or C:\WEB\BOOK\PICS
' when SimBook is in a folder of its own), so the pages can link to them as pics/...
FUNCTION AppDir () AS String
    VAR page AS String
    page = SERVER.ScriptName
    RETURN page.Substring(0, page.Length - page.Split("\")[page.Split("\").Count - 1].Length - 1)
END FUNCTION

FUNCTION PicDir () AS String
    RETURN AppDir() + "\PICS"
END FUNCTION

FUNCTION PhotoDir () AS String
    RETURN AppDir() + "\PHOTOS"
END FUNCTION
CONST COOKIE = "simbook"
CONST FEEDSIZE = 25
CONST LOGSIZE = 500           ' posts to a log file; MIGRATE.SPK knows this too
CONST NOTEKEEP = 100          ' notifications kept per member
CONST NOTESHOW = 40           ' notifications shown at once
CONST MAXPOST = 1000
CONST MAXREPLY = 500
CONST FEEDREPLIES = 2         ' replies shown under a post in the feed and on Walls
CONST MAXNAME = 40
CONST SHORTFIELD = 60
CONST LONGFIELD = 500
CONST MAXPIC = 20000
CONST PICSIZE = 100
CONST MAXPHOTO = 45000
CONST PHOTOSIZE = 200
CONST MAXCAPTION = 200
CONST ALBUMSHOW = 20
CONST PAGEROOM = 20000        ' how much feed, Wall or replies one page may carry

' HTTPD.SPK sends a whole page as one network message, and a message holds
' 64K: a bigger page would stop the web server. So names, profile fields and
' posts are capped, and the feed, Wall and directory stop well before that.

VAR viewer AS String          ' who is signed in; "" for nobody
VAR formToken AS String       ' their session's form token; see RequireToken

' ---------------------------------------------------------------- the disk

SUB EnsureDisk ()
    VAR dir AS String
    VAR dirs AS Array OF String
    dirs = ["", "\USERS", "\FRIENDS", "\WALLS", "\SESSIONS", "\VOTES", "\REPLIES", "\LOG", "\NOTES", "\POKES", "\ALBUMS"]
    FOR EACH dir IN dirs
        IF NOT FS.Exists(DATADIR + dir) THEN FS.MakeDir(DATADIR + dir)
    NEXT
    IF NOT FS.Exists(PicDir()) THEN FS.MakeDir(PicDir())
    IF NOT FS.Exists(PhotoDir()) THEN FS.MakeDir(PhotoDir())
END SUB

FUNCTION ReadOr (path AS String, fallback AS String) AS String
    IF FS.Exists(path) THEN RETURN FS.Read(path)
    RETURN fallback
END FUNCTION

' Text that is safe inside one |-separated line, and back again.
FUNCTION Esc (s AS String) AS String
    RETURN s.Replace("%", "%25").Replace("|", "%7C").Replace(Chr(13), "").Replace(Chr(10), "%0A")
END FUNCTION

FUNCTION Unesc (s AS String) AS String
    RETURN s.Replace("%0A", Chr(10)).Replace("%7C", "|").Replace("%25", "%")
END FUNCTION

' Text that is safe inside a page; Br also keeps the line breaks.
FUNCTION H (s AS String) AS String
    RETURN SERVER.HtmlEncode(s)
END FUNCTION

FUNCTION Br (s AS String) AS String
    RETURN SERVER.HtmlEncode(s).Replace(Chr(10), "<br>")
END FUNCTION

FUNCTION UrlEnc (s AS String) AS String
    RETURN SERVER.UrlEncode(s)
END FUNCTION

' Only letters and digits are allowed in characters, so that a name or a session
' id from a visitor can never reach outside its folder.
FUNCTION OnlyFrom (s AS String, allowed AS String) AS Bool
    VAR i AS Integer
    FOR i = 0 TO s.Length - 1
        IF NOT allowed.Contains(s.CharAt(i)) THEN RETURN FALSE
    NEXT
    RETURN TRUE
END FUNCTION

' A user name is also a file name, and file names here are 8.3.
FUNCTION ValidName (u AS String) AS Bool
    IF u.Length < 3 OR u.Length > 8 THEN RETURN FALSE
    RETURN OnlyFrom(u, "abcdefghijklmnopqrstuvwxyz0123456789")
END FUNCTION

FUNCTION CleanName (u AS String) AS String
    VAR s AS String
    s = u.Trim().Lower()
    IF ValidName(s) THEN RETURN s
    RETURN ""
END FUNCTION

' ---------------------------------------------------------------- users

FUNCTION UserPath (u AS String) AS String
    RETURN DATADIR + "\USERS\" + u + ".TXT"
END FUNCTION

FUNCTION UserExists (u AS String) AS Bool
    IF NOT ValidName(u) THEN RETURN FALSE
    RETURN FS.Exists(UserPath(u))
END FUNCTION

' A profile is the lines of its file; Field and SetField work on that array.
FUNCTION LoadUser (u AS String) AS Array OF String
    RETURN FS.Read(UserPath(u)).Lines()
END FUNCTION

SUB SaveUser (u AS String, rec AS Array OF String)
    FS.Write(UserPath(u), rec.Join(Chr(10)))
END SUB

FUNCTION Field (rec AS Array OF String, key AS String) AS String
    VAR line AS String
    FOR EACH line IN rec
        IF line.StartsWith(key + "=") THEN RETURN Unesc(line.Substring(key.Length + 1, line.Length - key.Length - 1))
    NEXT
    RETURN ""
END FUNCTION

SUB SetField (rec AS Array OF String, key AS String, value AS String)
    VAR i AS Integer
    FOR i = 0 TO rec.Count - 1
        IF rec[i].StartsWith(key + "=") THEN
            rec[i] = key + "=" + Esc(value)
            RETURN
        END IF
    NEXT
    rec.Add(key + "=" + Esc(value))
END SUB

FUNCTION NameOf (u AS String) AS String
    RETURN Field(LoadUser(u), "name")
END FUNCTION

' Not real cryptography - SIM95 has none - but the password itself never
' touches the disk. Two running hashes over salt + password, kept under 2^31.
FUNCTION Hash (salt AS String, pw AS String) AS String
    VAR a AS Integer = 7
    VAR b AS Integer = 31337
    VAR i AS Integer
    VAR c AS Integer
    VAR s AS String
    s = salt + ":" + pw + ":" + salt
    FOR i = 0 TO s.Length - 1
        c = Asc(s.CharAt(i))
        a = (a * 131 + c) MOD 2147483629
        b = (b * 257 + c + a) MOD 2147483587
    NEXT
    RETURN Hex(a) + "-" + Hex(b)
END FUNCTION

FUNCTION NewToken () AS String
    RETURN Hex(268435456 + Rnd(1879048191))
END FUNCTION

' Returns "" on success, otherwise what is wrong.
FUNCTION CreateUser (u AS String, pw AS String, name AS String) AS String
    VAR rec AS Array OF String
    VAR salt AS String
    EnsureDisk()
    IF NOT ValidName(u) THEN RETURN "Pick a user name of 3 to 8 letters or digits."
    IF FS.Exists(UserPath(u)) THEN RETURN "Somebody already has the name " + u + "."
    IF pw.Length < 4 THEN RETURN "Pick a password of at least 4 characters."
    name = Clip(name, MAXNAME)
    IF name = "" THEN RETURN "Tell us your name."
    salt = NewToken()
    SetField(rec, "name", name)
    SetField(rec, "salt", salt)
    SetField(rec, "pass", Hash(salt, pw))
    SetField(rec, "joined", TIME.Date)
    SaveUser(u, rec)
    FS.Write(DATADIR + "\FRIENDS\" + u + ".TXT", "|")
    FS.Append(DATADIR + "\PEOPLE.TXT", u + "|" + Esc(name) + Chr(10))
    RETURN ""
END FUNCTION

FUNCTION CheckPassword (u AS String, pw AS String) AS Bool
    VAR rec AS Array OF String
    IF NOT UserExists(u) THEN RETURN FALSE
    rec = LoadUser(u)
    RETURN Hash(Field(rec, "salt"), pw) = Field(rec, "pass")
END FUNCTION

' Keep the member directory in step when someone changes their name.
SUB RenamePerson (u AS String, name AS String)
    VAR lines AS Array OF String
    VAR i AS Integer
    lines = ReadOr(DATADIR + "\PEOPLE.TXT", "").Lines()
    FOR i = 0 TO lines.Count - 1
        IF lines[i].StartsWith(u + "|") THEN lines[i] = u + "|" + Esc(name)
    NEXT
    FS.Write(DATADIR + "\PEOPLE.TXT", lines.Join(Chr(10)))
END SUB

FUNCTION HasPicture (u AS String) AS Bool
    RETURN FS.Exists(PicDir() + "\" + u + ".PIC")
END FUNCTION

' A picture is a SIM95PIC file: "SIM95PIC width height", then a row of hex digits
' per line. Returns "" when it will do, otherwise what is wrong with it.
FUNCTION CheckPicture (pic AS String, most AS Integer, longest AS Integer) AS String
    VAR size AS Array OF String
    IF pic = "" THEN RETURN "Choose a .PIC file first."
    size = pic.Lines()[0].Trim().Split(" ")
    IF NOT pic.StartsWith("SIM95PIC ") OR size.Count < 3 THEN RETURN "That is not a picture. Save one from Sketch as a .PIC file."
    IF pic.Length > longest OR Val(size[1]) > most OR Val(size[2]) > most THEN RETURN "That picture is " + size[1] + " by " + size[2] + ". Shrink it to " + Str(most) + " by " + Str(most) + " or less with SHRINK.SPK."
    RETURN ""
END FUNCTION

FUNCTION SavePicture (u AS String, pic AS String) AS String
    VAR problem AS String
    problem = CheckPicture(pic, PICSIZE, MAXPIC)
    IF problem <> "" THEN RETURN problem
    EnsureDisk()
    FS.Write(PicDir() + "\" + u + ".PIC", pic)
    RETURN ""
END FUNCTION

' Text from a form, trimmed and cut to a length.
FUNCTION Clip (s AS String, most AS Integer) AS String
    s = s.Replace(Chr(13), "").Trim()
    IF s.Length > most THEN s = s.Substring(0, most)
    RETURN s
END FUNCTION

' ---------------------------------------------------------------- sessions

' A session file holds two lines: who is signed in, and that session's form
' token. The cookie names the file.
'
' The form token stops another site from acting in your name. Voyager sends
' your SimBook cookie with any request to this server, including one made by
' a form or link on somebody else's page, so the cookie alone proves nothing.
' Every form and action link on SimBook carries the token as a field called t,
' and every page that changes something checks it with RequireToken. Another
' site cannot read SimBook's pages, so it cannot know the token. Voyager sends
' no Referer header, so checking where a request came from is not an option.

SUB SignIn (u AS String)
    VAR token AS String
    EnsureDisk()
    token = NewToken()
    FS.Write(DATADIR + "\SESSIONS\" + token + ".TXT", u + Chr(10) + NewToken() + NewToken())
    RESPONSE.SetCookie(COOKIE, token)
END SUB

FUNCTION SessionPath () AS String
    VAR token AS String
    token = REQUEST.Cookie(COOKIE)
    IF token = "" OR token.Length > 8 THEN RETURN ""
    IF NOT OnlyFrom(token, "0123456789ABCDEF") THEN RETURN ""
    RETURN DATADIR + "\SESSIONS\" + token + ".TXT"
END FUNCTION

SUB SignOut ()
    VAR path AS String
    path = SessionPath()
    IF path <> "" THEN
        IF FS.Exists(path) THEN FS.Delete(path)
    END IF
    RESPONSE.SetCookie(COOKIE, "")
END SUB

' Who the cookie says is signed in, or "". Also sets formToken.
FUNCTION CurrentUser () AS String
    VAR path AS String
    VAR lines AS Array OF String
    VAR u AS String
    path = SessionPath()
    IF path = "" THEN RETURN ""
    IF NOT FS.Exists(path) THEN RETURN ""
    lines = FS.Read(path).Lines()
    u = lines[0].Trim()
    IF NOT UserExists(u) THEN RETURN ""
    ' A session from before form tokens existed gets one now
    IF lines.Count < 2 OR lines[lines.Count - 1].Trim().Length < 16 THEN
        FS.Write(path, u + Chr(10) + NewToken() + NewToken())
        lines = FS.Read(path).Lines()
    END IF
    formToken = lines[1].Trim()
    RETURN u
END FUNCTION

' The first line of every members-only page.
SUB RequireLogin ()
    viewer = CurrentUser()
    IF viewer = "" THEN RESPONSE.Redirect("index.asp")
END SUB

' The second line of every page that changes something: the request must carry
' this session's token, in the form (POST) or the link (GET). Anything else is
' sent home, untouched.
SUB RequireToken ()
    VAR sent AS String
    sent = REQUEST.Form("t")
    IF sent = "" THEN sent = REQUEST.Query("t")
    IF sent = "" OR sent <> formToken THEN RESPONSE.Redirect("home.asp?why=" + UrlEnc("That did not come from a SimBook page, so nothing was changed."))
END SUB

' The token as a hidden form field, and as a link parameter.
FUNCTION TokenField () AS String
    RETURN "<input type=""hidden"" name=""t"" value=""" + formToken + """>"
END FUNCTION

FUNCTION TokenArg () AS String
    RETURN "t=" + formToken
END FUNCTION

' ---------------------------------------------------------------- friends

FUNCTION FriendList (u AS String) AS String
    RETURN ReadOr(DATADIR + "\FRIENDS\" + u + ".TXT", "|")
END FUNCTION

FUNCTION IsFriend (a AS String, b AS String) AS Bool
    RETURN FriendList(a).Contains("|" + b + "|")
END FUNCTION

FUNCTION Friends (u AS String) AS Array OF String
    VAR all AS Array OF String
    VAR out AS Array OF String
    VAR f AS String
    all = FriendList(u).Split("|")
    FOR EACH f IN all
        IF f <> "" THEN out.Add(f)
    NEXT
    RETURN out
END FUNCTION

SUB AddFriend (a AS String, b AS String)
    IF a = b OR IsFriend(a, b) THEN RETURN
    FS.Write(DATADIR + "\FRIENDS\" + a + ".TXT", FriendList(a) + b + "|")
    FS.Write(DATADIR + "\FRIENDS\" + b + ".TXT", FriendList(b) + a + "|")
    Notify(b, "friend", "")
END SUB

SUB RemoveFriend (a AS String, b AS String)
    FS.Write(DATADIR + "\FRIENDS\" + a + ".TXT", FriendList(a).Replace("|" + b + "|", "|"))
    FS.Write(DATADIR + "\FRIENDS\" + b + ".TXT", FriendList(b).Replace("|" + a + "|", "|"))
END SUB

' ---------------------------------------------------------------- numbers

' A counter kept in C:\BOOKDATA\<name>.TXT: posts use NEXTID, replies NEXTRID,
' and each one only ever goes up.
FUNCTION Counter (name AS String) AS Integer
    VAR n AS Integer
    n = Int(Val(ReadOr(DATADIR + "\" + name + ".TXT", "0"))) + 1
    FS.Write(DATADIR + "\" + name + ".TXT", Str(n))
    RETURN n
END FUNCTION

' The line in text (lines of "key|...") that starts with key, or "". IndexOf does
' the searching, so this costs a handful of steps however long the text is.
FUNCTION FindLine (text AS String, key AS String) AS String
    VAR at AS Integer
    text = Chr(10) + text
    at = text.IndexOf(Chr(10) + key + "|")
    IF at < 0 THEN RETURN ""
    text = text.Substring(at + 1, text.Length - at - 1)
    at = text.IndexOf(Chr(10))
    IF at >= 0 THEN text = text.Substring(0, at)
    RETURN text
END FUNCTION

' text without the whole line given. The line breaks around it make sure a
' line that merely ends the same way is left alone.
FUNCTION WithoutLine (text AS String, line AS String) AS String
    text = (Chr(10) + text).Replace(Chr(10) + line + Chr(10), Chr(10))
    RETURN text.Substring(1, text.Length - 1)
END FUNCTION

FUNCTION IsNumber (s AS String) AS Bool
    IF s = "" OR s.Length > 8 THEN RETURN FALSE
    RETURN OnlyFrom(s, "0123456789")
END FUNCTION

' ---------------------------------------------------------------- the post log

' Every post is in the log, in chunks of LOGSIZE: post n lives in
' C:\BOOKDATA\LOG\<(n - 1) / LOGSIZE>.TXT. Finding a post reads one small
' file, and writing one rewrites only the newest chunk, however big SimBook
' grows. The feed reads the newest two chunks.

FUNCTION ChunkPath (id AS Integer) AS String
    RETURN DATADIR + "\LOG\" + Str(Int((id - 1) / LOGSIZE)) + ".TXT"
END FUNCTION

FUNCTION LastId () AS Integer
    RETURN Int(Val(ReadOr(DATADIR + "\NEXTID.TXT", "0")))
END FUNCTION

' The newest posts, oldest first: between LOGSIZE and twice that many.
FUNCTION RecentPosts () AS Array OF String
    VAR last AS Integer
    VAR text AS String
    last = LastId()
    IF last = 0 THEN RETURN "".Lines()
    text = ReadOr(ChunkPath(last), "")
    IF last > LOGSIZE THEN text = ReadOr(ChunkPath(last - LOGSIZE), "") + text
    RETURN text.Lines()
END FUNCTION

' The line of post number id, or "" when there is none.
FUNCTION FindPost (id AS String) AS String
    IF NOT IsNumber(id) THEN RETURN ""
    RETURN FindLine(ReadOr(ChunkPath(Int(Val(id))), ""), id)
END FUNCTION

' Writes a post into the log and onto the Wall, and returns its number.
FUNCTION WritePost (author AS String, wall AS String, text AS String) AS Integer
    VAR id AS Integer
    VAR line AS String
    EnsureDisk()
    id = Counter("NEXTID")
    line = Str(id) + "|" + Stamp() + "|" + author + "|" + Esc(NameOf(author)) + "|" + wall + "|" + Esc(NameOf(wall)) + "|" + Esc(text)
    FS.Append(ChunkPath(id), line + Chr(10))
    FS.Append(DATADIR + "\WALLS\" + wall + ".TXT", line + Chr(10))
    RETURN id
END FUNCTION

FUNCTION Stamp () AS String
    RETURN TIME.Date + " " + TIME.Clock.Substring(0, 5)
END FUNCTION

' Write on someone's Wall (your own Wall is your status). Returns "" or a problem.
FUNCTION AddPost (author AS String, wall AS String, text AS String) AS String
    VAR id AS Integer
    text = text.Replace(Chr(13), "").Trim()
    IF text = "" THEN RETURN "Write something first."
    IF text.Length > MAXPOST THEN RETURN "Keep it under " + Str(MAXPOST) + " characters."
    IF NOT UserExists(wall) THEN RETURN "There is nobody called " + wall + "."
    IF author <> wall AND NOT IsFriend(author, wall) THEN RETURN "Only friends can write on " + wall + "'s Wall."
    id = WritePost(author, wall, text)
    Notify(wall, "wall", Str(id))
    RETURN ""
END FUNCTION

' Who may give a post a thumb or a reply: the people whose News Feed it reaches.
' That is its author and the owner of its Wall, and their friends.
FUNCTION CanTalk (u AS String, line AS String) AS Bool
    VAR p AS Array OF String
    p = line.Split("|")
    IF p.Count < 7 THEN RETURN FALSE
    IF u = p[2] OR u = p[4] THEN RETURN TRUE
    RETURN IsFriend(u, p[2]) OR IsFriend(u, p[4])
END FUNCTION

' A post can be deleted by whoever wrote it and by the owner of its Wall.
FUNCTION CanDelete (u AS String, line AS String) AS Bool
    VAR p AS Array OF String
    p = line.Split("|")
    IF p.Count < 7 THEN RETURN FALSE
    RETURN u = p[2] OR u = p[4]
END FUNCTION

' Takes a post out of the log and off its Wall, with its thumbs, replies and photo.
SUB DeletePost (line AS String)
    VAR p AS Array OF String
    VAR path AS String
    p = line.Split("|")
    path = ChunkPath(Int(Val(p[0])))
    FS.Write(path, WithoutLine(FS.Read(path), line))
    path = DATADIR + "\WALLS\" + p[4] + ".TXT"
    IF FS.Exists(path) THEN FS.Write(path, WithoutLine(FS.Read(path), line))
    path = DATADIR + "\VOTES\" + p[0] + ".TXT"
    IF FS.Exists(path) THEN FS.Delete(path)
    path = DATADIR + "\REPLIES\" + p[0] + ".TXT"
    IF FS.Exists(path) THEN FS.Delete(path)
    IF IsPhoto(p[0]) THEN
        FS.Delete(PhotoDir() + "\" + p[0] + ".PIC")
        path = DATADIR + "\ALBUMS\" + p[2] + ".TXT"
        IF FS.Exists(path) THEN FS.Write(path, FS.Read(path).Replace("|" + p[0] + "|", "|"))
    END IF
END SUB

' ---------------------------------------------------------------- thumbs

FUNCTION VotesOf (id AS String) AS String
    RETURN ReadOr(DATADIR + "\VOTES\" + id + ".TXT", "|")
END FUNCTION

' How many "+" or "-" votes a |ann+|bob-| list holds.
FUNCTION CountVotes (votes AS String, sign AS String) AS Integer
    RETURN (votes.Length - votes.Replace(sign + "|", "").Length) / 2
END FUNCTION

' Thumbs up ("+") or down ("-") on a post. The same thumb again takes it back.
SUB Vote (u AS String, line AS String, sign AS String)
    VAR id AS String
    VAR votes AS String
    VAR had AS Bool
    EnsureDisk()
    id = line.Split("|")[0]
    votes = VotesOf(id)
    had = votes.Contains("|" + u + sign + "|")
    votes = votes.Replace("|" + u + "+|", "|").Replace("|" + u + "-|", "|")
    IF NOT had THEN
        votes = votes + u + sign + "|"
        IF sign = "+" THEN Notify(line.Split("|")[2], "up", id)
        IF sign = "-" THEN Notify(line.Split("|")[2], "down", id)
    END IF
    FS.Write(DATADIR + "\VOTES\" + id + ".TXT", votes)
END SUB

' ---------------------------------------------------------------- replies

' A reply is one line of C:\BOOKDATA\REPLIES\<post>.TXT:
'   reply number|date time|author|author name|text

FUNCTION AddReply (u AS String, id AS String, text AS String) AS String
    VAR line AS String
    VAR p AS Array OF String
    line = FindPost(id)
    text = text.Replace(Chr(13), "").Trim()
    IF line = "" THEN RETURN "That post is gone."
    IF NOT CanTalk(u, line) THEN RETURN "Only friends can reply to that."
    IF text = "" THEN RETURN "Write something first."
    IF text.Length > MAXREPLY THEN RETURN "Keep replies under " + Str(MAXREPLY) + " characters."
    EnsureDisk()
    FS.Append(DATADIR + "\REPLIES\" + id + ".TXT", Str(Counter("NEXTRID")) + "|" + Stamp() + "|" + u + "|" + Esc(NameOf(u)) + "|" + Esc(text) + Chr(10))
    p = line.Split("|")
    Notify(p[2], "reply", id)
    IF p[4] <> p[2] THEN Notify(p[4], "wallreply", id)
    RETURN ""
END FUNCTION

FUNCTION Replies (id AS String) AS Array OF String
    VAR all AS Array OF String
    VAR out AS Array OF String
    VAR line AS String
    all = ReadOr(DATADIR + "\REPLIES\" + id + ".TXT", "").Lines()
    FOR EACH line IN all
        IF line <> "" THEN out.Add(line)
    NEXT
    RETURN out
END FUNCTION

FUNCTION FindReply (id AS String, rid AS String) AS String
    IF NOT IsNumber(rid) THEN RETURN ""
    RETURN FindLine(ReadOr(DATADIR + "\REPLIES\" + id + ".TXT", ""), rid)
END FUNCTION

' A reply can be deleted by whoever wrote it and by the owner of the post's Wall.
FUNCTION CanDeleteReply (u AS String, post AS String, reply AS String) AS Bool
    RETURN u = reply.Split("|")[2] OR u = post.Split("|")[4]
END FUNCTION

SUB DeleteReply (id AS String, reply AS String)
    VAR path AS String
    path = DATADIR + "\REPLIES\" + id + ".TXT"
    FS.Write(path, WithoutLine(FS.Read(path), reply))
END SUB

FUNCTION ReplyHtml (line AS String, post AS String) AS String
    VAR r AS Array OF String
    VAR del AS String
    r = line.Split("|")
    IF r.Count < 5 THEN RETURN ""
    IF CanDeleteReply(viewer, post, line) THEN del = " <font size=""1""><a href=""delete.asp?id=" + post.Split("|")[0] + "&r=" + r[0] + """>delete</a></font>"
    RETURN "<tr><td width=""16""></td><td bgcolor=""#EDEFF4""><font size=""2""><a href=""profile.asp?u=" + r[2] + """><b>" + H(Unesc(r[3])) + "</b></a> <font color=""#808080"">" + r[1] + "</font>" + del + "<br>" + Br(Unesc(r[4])) + "</font></td></tr>"
END FUNCTION

' The newest replies to a post that fit in room characters, oldest first, with a
' link to the rest. most = 0 means as many as fit.
FUNCTION RepliesHtml (post AS String, all AS Array OF String, most AS Integer, room AS Integer) AS String
    VAR out AS String
    VAR i AS Integer
    VAR shown AS Integer
    IF all.Count = 0 THEN RETURN ""
    FOR i = all.Count - 1 TO 0 STEP -1
        IF most > 0 AND shown >= most THEN BREAK
        IF out.Length > room THEN BREAK
        out = ReplyHtml(all[i], post) + out
        shown = shown + 1
    NEXT
    IF shown < all.Count THEN
        out = "<tr><td width=""16""></td><td><font size=""1""><a href=""view.asp?id=" + post.Split("|")[0] + """>See all " + Str(all.Count) + " replies</a></font></td></tr>" + out
    END IF
    RETURN "<table width=""100%"" cellpadding=""3"" cellspacing=""1"">" + out + "</table>"
END FUNCTION

' ---------------------------------------------------------------- notifications

' C:\BOOKDATA\NOTES\<user>.TXT holds the newest NOTEKEEP of them, one per line:
'   number|date time|kind|who|their name|post number
' and <user>.SEE the number of the last one they have looked at. Kinds: wall,
' reply, wallreply, up, down, poke, friend. The one acting is always the viewer.

FUNCTION LastNote (lines AS Array OF String) AS Integer
    VAR i AS Integer
    FOR i = lines.Count - 1 TO 0 STEP -1
        IF lines[i] <> "" THEN RETURN Int(Val(lines[i].Split("|")[0]))
    NEXT
    RETURN 0
END FUNCTION

FUNCTION NoteLines (u AS String) AS Array OF String
    RETURN ReadOr(DATADIR + "\NOTES\" + u + ".TXT", "").Lines()
END FUNCTION

SUB Notify (u AS String, kind AS String, ref AS String)
    VAR lines AS Array OF String
    VAR keep AS Array OF String
    VAR i AS Integer
    IF u = viewer OR NOT UserExists(u) THEN RETURN
    EnsureDisk()
    lines = NoteLines(u)
    FOR i = 0 TO lines.Count - 1
        IF lines[i] <> "" AND i >= lines.Count - NOTEKEEP THEN keep.Add(lines[i])
    NEXT
    keep.Add(Str(LastNote(lines) + 1) + "|" + Stamp() + "|" + kind + "|" + viewer + "|" + Esc(NameOf(viewer)) + "|" + ref)
    FS.Write(DATADIR + "\NOTES\" + u + ".TXT", keep.Join(Chr(10)) + Chr(10))
END SUB

FUNCTION SeenNote (u AS String) AS Integer
    RETURN Int(Val(ReadOr(DATADIR + "\NOTES\" + u + ".SEE", "0")))
END FUNCTION

FUNCTION Unread (u AS String) AS Integer
    VAR n AS Integer
    n = LastNote(NoteLines(u)) - SeenNote(u)
    IF n < 0 THEN RETURN 0
    RETURN n
END FUNCTION

SUB MarkSeen (u AS String)
    EnsureDisk()
    FS.Write(DATADIR + "\NOTES\" + u + ".SEE", Str(LastNote(NoteLines(u))))
END SUB

FUNCTION NoteHtml (line AS String, fresh AS Bool) AS String
    VAR n AS Array OF String
    VAR who AS String
    VAR what AS String
    VAR post AS String
    n = line.Split("|")
    IF n.Count < 6 THEN RETURN ""
    who = "<a href=""profile.asp?u=" + n[3] + """><b>" + H(Unesc(n[4])) + "</b></a>"
    post = "<a href=""view.asp?id=" + n[5] + """>"
    SELECT CASE n[2]
        CASE "wall"
            what = who + " wrote on your " + post + "Wall</a>."
        CASE "reply"
            what = who + " replied to " + post + "your post</a>."
        CASE "wallreply"
            what = who + " replied to " + post + "a post on your Wall</a>."
        CASE "up"
            what = who + " gave " + post + "your post</a> a thumbs up."
        CASE "down"
            what = who + " gave " + post + "your post</a> a thumbs down."
        CASE "poke"
            what = who + " poked you. <a href=""home.asp"">Poke back?</a>"
        CASE "friend"
            what = who + " added you as a friend."
        CASE ELSE
            RETURN ""
    END SELECT
    IF fresh THEN RETURN "<tr><td bgcolor=""#FFF9D7""><font size=""2"">" + what + " <font color=""#808080"">" + n[1] + "</font></font></td></tr>"
    RETURN "<tr><td><font size=""2"">" + what + " <font color=""#808080"">" + n[1] + "</font></font></td></tr>"
END FUNCTION

' ---------------------------------------------------------------- pokes

' C:\BOOKDATA\POKES\<user>.TXT: |bob|cat| - who has poked them and not been
' poked back or brushed off yet.

FUNCTION PokesOf (u AS String) AS String
    RETURN ReadOr(DATADIR + "\POKES\" + u + ".TXT", "|")
END FUNCTION

' Returns "" or why not. Poking someone back also clears their poke.
FUNCTION Poke (u AS String, target AS String) AS String
    IF NOT UserExists(target) OR target = u THEN RETURN "You cannot poke that."
    IF NOT IsFriend(u, target) THEN RETURN "You can only poke your friends."
    IF PokesOf(target).Contains("|" + u + "|") THEN RETURN "You have already poked " + NameOf(target) + ". Wait for them to poke back."
    EnsureDisk()
    FS.Write(DATADIR + "\POKES\" + target + ".TXT", PokesOf(target) + u + "|")
    ClearPoke(u, target)
    Notify(target, "poke", "")
    RETURN ""
END FUNCTION

SUB ClearPoke (u AS String, from AS String)
    IF PokesOf(u).Contains("|" + from + "|") THEN FS.Write(DATADIR + "\POKES\" + u + ".TXT", PokesOf(u).Replace("|" + from + "|", "|"))
END SUB

' ---------------------------------------------------------------- photos

' A photo is a post on its owner's own Wall with a picture beside it in
' C:\WEB\PHOTOS\<post>.PIC, so it gets thumbs, replies and the feed for free.
' C:\BOOKDATA\ALBUMS\<user>.TXT lists their photos: |12|40|

FUNCTION IsPhoto (id AS String) AS Bool
    RETURN FS.Exists(PhotoDir() + "\" + id + ".PIC")
END FUNCTION

FUNCTION Album (u AS String) AS Array OF String
    VAR all AS Array OF String
    VAR out AS Array OF String
    VAR id AS String
    all = ReadOr(DATADIR + "\ALBUMS\" + u + ".TXT", "|").Split("|")
    FOR EACH id IN all
        IF id <> "" THEN out.Add(id)
    NEXT
    RETURN out
END FUNCTION

FUNCTION AddPhoto (u AS String, pic AS String, caption AS String) AS String
    VAR problem AS String
    VAR id AS Integer
    caption = caption.Replace(Chr(13), "").Trim()
    IF caption.Length > MAXCAPTION THEN RETURN "Keep the caption under " + Str(MAXCAPTION) + " characters."
    problem = CheckPicture(pic, PHOTOSIZE, MAXPHOTO)
    IF problem <> "" THEN RETURN problem
    id = WritePost(u, u, caption)
    FS.Write(PhotoDir() + "\" + Str(id) + ".PIC", pic)
    FS.Write(DATADIR + "\ALBUMS\" + u + ".TXT", ReadOr(DATADIR + "\ALBUMS\" + u + ".TXT", "|") + Str(id) + "|")
    RETURN ""
END FUNCTION

' ---------------------------------------------------------------- showing posts

' Thumbs, reply and delete links under a post. back says where a thumb returns
' to: "home", "view", or the user whose Wall it is on.
FUNCTION ActionsHtml (line AS String, back AS String, replies AS Integer) AS String
    VAR id AS String
    VAR votes AS String
    VAR up AS String
    VAR down AS String
    VAR del AS String
    id = line.Split("|")[0]
    votes = VotesOf(id)
    up = "thumbs up (" + Str(CountVotes(votes, "+")) + ")"
    down = "thumbs down (" + Str(CountVotes(votes, "-")) + ")"
    IF votes.Contains("|" + viewer + "+|") THEN up = "<b>" + up + "</b>"
    IF votes.Contains("|" + viewer + "-|") THEN down = "<b>" + down + "</b>"
    IF CanDelete(viewer, line) THEN del = " &middot; <a href=""delete.asp?id=" + id + """>delete</a>"
    IF NOT CanTalk(viewer, line) THEN
        RETURN "<font size=""1"" color=""#808080"">" + up + " &middot; " + down + " &middot; <a href=""view.asp?id=" + id + """>" + Str(replies) + " replies</a></font>"
    END IF
    RETURN "<font size=""1""><a href=""vote.asp?id=" + id + "&v=up&b=" + back + "&" + TokenArg() + """>" + up + "</a> &middot; " _
         + "<a href=""vote.asp?id=" + id + "&v=down&b=" + back + "&" + TokenArg() + """>" + down + "</a> &middot; " _
         + "<a href=""view.asp?id=" + id + """>reply</a>" + del + "</font>"
END FUNCTION

' One post as a row of the feed or a Wall, with its photo, thumbs and newest
' replies. onWall leaves out the Wall it is on; most is how many replies to
' show (0 = all that fit).
FUNCTION PostHtml (line AS String, onWall AS Bool, back AS String, most AS Integer) AS String
    VAR p AS Array OF String
    VAR who AS String
    VAR body AS String
    VAR all AS Array OF String
    p = line.Split("|")
    IF p.Count < 7 THEN RETURN ""
    who = "<a href=""profile.asp?u=" + p[2] + """><b>" + H(Unesc(p[3])) + "</b></a>"
    IF p[2] <> p[4] AND NOT onWall THEN
        who = who + " &raquo; <a href=""profile.asp?u=" + p[4] + """><b>" + H(Unesc(p[5])) + "</b></a>"
    END IF
    body = Br(Unesc(p[6]))
    IF IsPhoto(p[0]) THEN
        who = who + " added a photo"
        body = "<a href=""view.asp?id=" + p[0] + """><img src=""photos/" + p[0] + ".pic"" alt=""photo""></a><br>" + body
    END IF
    all = Replies(p[0])
    RETURN "<tr><td bgcolor=""#F7F7F7""><font size=""2"">" + who + " <a href=""view.asp?id=" + p[0] + """><font color=""#808080"">" + p[1] + "</font></a><br>" _
         + body + "</font><br>" + ActionsHtml(line, back, all.Count) _
         + RepliesHtml(line, all, most, PAGEROOM) + "</td></tr>"
END FUNCTION

' The newest posts on one wall.
FUNCTION WallHtml (u AS String) AS String
    VAR lines AS Array OF String
    VAR out AS String
    VAR i AS Integer
    VAR shown AS Integer
    lines = ReadOr(DATADIR + "\WALLS\" + u + ".TXT", "").Lines()
    FOR i = lines.Count - 1 TO 0 STEP -1
        IF lines[i] <> "" THEN
            out = out + PostHtml(lines[i], TRUE, u, FEEDREPLIES)
            shown = shown + 1
            IF shown >= FEEDSIZE OR out.Length > PAGEROOM THEN BREAK
        END IF
    NEXT
    IF out = "" THEN RETURN "<tr><td><font size=""2"" color=""#808080"">Nothing on the Wall yet.</font></td></tr>"
    RETURN out
END FUNCTION

' The News Feed: what you and your friends wrote, or what was written to you or them.
FUNCTION FeedHtml (u AS String) AS String
    VAR lines AS Array OF String
    VAR p AS Array OF String
    VAR circle AS String
    VAR out AS String
    VAR i AS Integer
    VAR shown AS Integer
    circle = FriendList(u) + u + "|"
    lines = RecentPosts()
    FOR i = lines.Count - 1 TO 0 STEP -1
        p = lines[i].Split("|")
        IF p.Count >= 7 THEN
            IF circle.Contains("|" + p[2] + "|") OR circle.Contains("|" + p[4] + "|") THEN
                out = out + PostHtml(lines[i], FALSE, "home", FEEDREPLIES)
                shown = shown + 1
                IF shown >= FEEDSIZE OR out.Length > PAGEROOM THEN BREAK
            END IF
        END IF
    NEXT
    IF out = "" THEN RETURN "<tr><td><font size=""2"" color=""#808080"">Nothing here yet. Write something above, or find some <a href=""people.asp"">people</a> to be friends with.</font></td></tr>"
    RETURN out
END FUNCTION

' ---------------------------------------------------------------- page furniture

FUNCTION Top (title AS String) AS String
    VAR s AS String
    s = "<html><head><title>" + H(title) + " - SimBook</title></head>" _
      + "<body bgcolor=""#FFFFFF"" text=""#000000"" link=""#3B5998"" vlink=""#3B5998"">" _
      + "<table width=""100%"" cellpadding=""6"" cellspacing=""0"" bgcolor=""#3B5998""><tr>" _
      + "<td><a href=""index.asp""><font color=""#FFFFFF"" size=""5""><b>[simbook]</b></font></a></td>" _
      + "<td align=""right""><font color=""#FFFFFF"" size=""2"">"
    IF viewer <> "" THEN
        s = s + "<a href=""home.asp""><font color=""#FFFFFF"">home</font></a> | " _
              + NotesLink() + " | " _
              + "<a href=""profile.asp?u=" + viewer + """><font color=""#FFFFFF"">profile</font></a> | " _
              + "<a href=""people.asp""><font color=""#FFFFFF"">people</font></a> | " _
              + "<a href=""edit.asp""><font color=""#FFFFFF"">edit</font></a> | " _
              + "<a href=""logout.asp?" + TokenArg() + """><font color=""#FFFFFF"">logout</font></a>"
    ELSE
        s = s + "<a href=""index.asp""><font color=""#FFFFFF"">login</font></a> | <a href=""index.asp""><font color=""#FFFFFF"">register</font></a>"
    END IF
    RETURN s + "</font></td></tr></table>"
END FUNCTION

FUNCTION NotesLink () AS String
    VAR n AS Integer
    n = Unread(viewer)
    IF n > 0 THEN RETURN "<a href=""notify.asp""><font color=""#FFFF00""><b>notifications (" + Str(n) + ")</b></font></a>"
    RETURN "<a href=""notify.asp""><font color=""#FFFFFF"">notifications</font></a>"
END FUNCTION

FUNCTION Bottom () AS String
    RETURN "<hr><center><font size=""1"" color=""#808080"">SimBook on " + H(SERVER.Name) + " &middot; " + TIME.Date + " &middot; <a href=""simbook.htm"">About SimBook</a></font></center></body></html>"
END FUNCTION

' A titled box, the way every section of a profile is drawn.
FUNCTION BoxTop (title AS String) AS String
    RETURN "<table width=""100%"" cellpadding=""3"" cellspacing=""0""><tr><td bgcolor=""#6D84B4""><font color=""#FFFFFF"" size=""2""><b>" + title + "</b></font></td></tr></table>"
END FUNCTION

FUNCTION Notice (text AS String) AS String
    IF text = "" THEN RETURN ""
    RETURN "<table width=""100%"" cellpadding=""4""><tr><td bgcolor=""#FFF9D7""><font size=""2"">" + H(text) + "</font></td></tr></table>"
END FUNCTION

' One <option> of a <select>, chosen when it is the current value.
FUNCTION Opt (value AS String, current AS String) AS String
    IF value = current THEN RETURN "<option selected>" + H(value) + "</option>"
    RETURN "<option>" + H(value) + "</option>"
END FUNCTION

' A text box that counts down as you type, and the page script that does the
' counting. Voyager sends a whole form as one 64K message and a text area has no
' maxlength, so this greys out the form's button (id="go") while any box on the
' page holds more than it may. The server checks again anyway.
FUNCTION LimitedBox (name AS String, value AS String, rows AS Integer, cols AS Integer, most AS Integer) AS String
    RETURN "<textarea name=""" + name + """ id=""" + name + """ rows=""" + Str(rows) + """ cols=""" + Str(cols) + """ onchange=""Limits_Check"">" + H(value) + "</textarea><br>" _
         + "<font size=""1"" color=""#808080"" id=""" + name + "_n"">up to " + Str(most) + " characters</font>"
END FUNCTION

' names and limits are comma-separated and in step: "about,music", "500,500".
FUNCTION LimitScript (names AS String, limits AS String) AS String
    RETURN "<script type=""spark"">" + Chr(10) _
         + "SUB Limits_Check ()" + Chr(10) _
         + "    VAR names AS Array OF String" + Chr(10) _
         + "    VAR limits AS Array OF String" + Chr(10) _
         + "    VAR i AS Integer" + Chr(10) _
         + "    VAR n AS Integer" + Chr(10) _
         + "    VAR most AS Integer" + Chr(10) _
         + "    VAR fits AS Bool = TRUE" + Chr(10) _
         + "    names = """ + names + """.Split("","")" + Chr(10) _
         + "    limits = """ + limits + """.Split("","")" + Chr(10) _
         + "    FOR i = 0 TO names.Count - 1" + Chr(10) _
         + "        n = PAGE.Get(names[i]).Value.Length" + Chr(10) _
         + "        most = Int(Val(limits[i]))" + Chr(10) _
         + "        IF n > most THEN" + Chr(10) _
         + "            PAGE.Get(names[i] + ""_n"").Text = Str(n - most) + "" characters too many""" + Chr(10) _
         + "            fits = FALSE" + Chr(10) _
         + "        ELSE" + Chr(10) _
         + "            PAGE.Get(names[i] + ""_n"").Text = Str(most - n) + "" characters left""" + Chr(10) _
         + "        END IF" + Chr(10) _
         + "    NEXT" + Chr(10) _
         + "    PAGE.Get(""go"").Enabled = fits" + Chr(10) _
         + "END SUB" + Chr(10) _
         + "</script>"
END FUNCTION

FUNCTION Picture (u AS String) AS String
    IF HasPicture(u) THEN RETURN "<img src=""pics/" + u + ".pic"" alt=""" + u + """>"
    RETURN "<img src=""nopic.pic"" alt=""no picture"">"
END FUNCTION
