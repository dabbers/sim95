SUB File10 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' NOTIFY.ASP - your notifications, newest first. The new ones are highlighted," + NL
    t = t + "' and looking at them marks them read." + NL
    t = t + "VAR lines AS Array OF String" + NL
    t = t + "VAR seen AS Integer" + NL
    t = t + "VAR i AS Integer" + NL
    t = t + "VAR shown AS Integer" + NL
    t = t + "VAR out AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "lines = NoteLines(viewer)" + NL
    t = t + "seen = SeenNote(viewer)" + NL
    t = t + "FOR i = lines.Count - 1 TO 0 STEP -1" + NL
    t = t + "    IF lines[i] <> """" THEN" + NL
    t = t + "        out = out + NoteHtml(lines[i], Int(Val(lines[i].Split(""|"")[0])) > seen)" + NL
    t = t + "        shown = shown + 1" + NL
    t = t + "        IF shown >= NOTESHOW THEN BREAK" + NL
    t = t + "    END IF" + NL
    t = t + "NEXT" + NL
    t = t + "MarkSeen(viewer)" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Notifications"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= BoxTop(""Notifications"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""4"" cellspacing=""1"">" + NL
    t = t + "<% IF out = """" THEN %>" + NL
    t = t + "<tr><td><font size=""2"" color=""#808080"">Nothing yet. When somebody writes on your Wall, replies, gives you a thumb, pokes you or adds you as a friend, it shows up here.</font></td></tr>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<%= out %>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</table>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\NOTIFY.ASP")
END SUB

SUB File11 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' PEOPLE.ASP?q=text - everybody on SimBook, or everybody whose name matches." + NL
    t = t + "VAR q AS String" + NL
    t = t + "VAR lines AS Array OF String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR p AS Array OF String" + NL
    t = t + "VAR found AS Integer" + NL
    t = t + "RequireLogin()" + NL
    t = t + "q = REQUEST.Query(""q"").Trim()" + NL
    t = t + "lines = ReadOr(DATADIR + ""\PEOPLE.TXT"", """").Lines()" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""People"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= BoxTop(""Search"") %>" + NL
    t = t + "<form action=""people.asp"" method=""get"">" + NL
    t = t + "<p><input name=""q"" size=""30"" value=""<%= H(q) %>""> <input type=""submit"" value=""Search""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<%= BoxTop(""People on SimBook"") %>" + NL
    t = t + "<table cellpadding=""4"">" + NL
    t = t + "<% FOR EACH line IN lines" + NL
    t = t + "     p = line.Split(""|"")" + NL
    t = t + "     IF p.Count < 2 THEN CONTINUE" + NL
    t = t + "     IF q <> """" AND NOT (p[0].Contains(q.Lower()) OR Unesc(p[1]).Lower().Contains(q.Lower())) THEN CONTINUE" + NL
    t = t + "     found = found + 1" + NL
    t = t + "     IF found > 100 THEN BREAK %>" + NL
    t = t + "<tr><td><font size=""2""><a href=""profile.asp?u=<%= p[0] %>""><b><%= H(Unesc(p[1])) %></b></a></font></td>" + NL
    t = t + "<td><font size=""2"" color=""#808080""><%= p[0] %><% IF IsFriend(viewer, p[0]) THEN %> &middot; your friend<% END IF %></font></td></tr>" + NL
    t = t + "<% NEXT %>" + NL
    t = t + "</table>" + NL
    t = t + "<% IF found = 0 THEN %><p><font size=""2"" color=""#808080"">Nobody found.</font></p><% END IF %>" + NL
    t = t + "<% IF found > 100 THEN %><p><font size=""2"" color=""#808080"">That is the first 100. Search to find somebody else.</font></p><% END IF %>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\PEOPLE.ASP")
END SUB

SUB File12 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' PHOTOS.ASP?u=name - someone's photos, newest first; on your own, a form to add" + NL
    t = t + "' one. Each photo is a post, so it lands in the feed and takes thumbs and replies." + NL
    t = t + "VAR who AS String" + NL
    t = t + "VAR rec AS Array OF String" + NL
    t = t + "VAR ids AS Array OF String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR i AS Integer" + NL
    t = t + "VAR shown AS Integer" + NL
    t = t + "VAR cells AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "who = viewer" + NL
    t = t + "IF REQUEST.Query(""u"") <> """" THEN who = CleanName(REQUEST.Query(""u""))" + NL
    t = t + "IF NOT UserExists(who) THEN RESPONSE.Redirect(""people.asp"")" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    RequireToken()" + NL
    t = t + "    who = viewer" + NL
    t = t + "    problem = AddPhoto(viewer, REQUEST.Form(""pic""), REQUEST.Form(""caption""))" + NL
    t = t + "    IF problem = """" THEN RESPONSE.Redirect(""photos.asp?u="" + viewer)" + NL
    t = t + "END IF" + NL
    t = t + "rec = LoadUser(who)" + NL
    t = t + "ids = Album(who)" + NL
    t = t + "' Two to a row, newest first, as many as fit" + NL
    t = t + "FOR i = ids.Count - 1 TO 0 STEP -1" + NL
    t = t + "    line = FindPost(ids[i])" + NL
    t = t + "    IF line <> """" THEN" + NL
    t = t + "        IF shown MOD 2 = 0 THEN cells = cells + ""<tr>""" + NL
    t = t + "        cells = cells + ""<td valign=""""top"""" width=""""50%""""><a href=""""view.asp?id="" + ids[i] + """"""><img src=""""photos/"" + ids[i] + "".pic"""" alt=""""photo""""></a><br><font size=""""2"""">"" + Br(Unesc(line.Split(""|"")[6])) + ""</font><br><font size=""""1"""" color=""""#808080"""">"" + line.Split(""|"")[1] + "" &middot; <a href=""""view.asp?id="" + ids[i] + """""">"" + Str(Replies(ids[i]).Count) + "" replies</a></font></td>""" + NL
    t = t + "        shown = shown + 1" + NL
    t = t + "        IF shown MOD 2 = 0 THEN cells = cells + ""</tr>""" + NL
    t = t + "        IF shown >= ALBUMSHOW OR cells.Length > PAGEROOM THEN BREAK" + NL
    t = t + "    END IF" + NL
    t = t + "NEXT" + NL
    t = t + "IF shown MOD 2 = 1 THEN cells = cells + ""<td></td></tr>""" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Photos"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<h2><font color=""#3B5998""><a href=""profile.asp?u=<%= who %>""><%= H(Field(rec, ""name"")) %></a>'s Photos</font></h2>" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<% IF who = viewer THEN %>" + NL
    t = t + "<%= BoxTop(""Add a Photo"") %>" + NL
    t = t + "<form action=""photos.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<p><font size=""2"">Photo:</font> <input type=""file"" name=""pic"" size=""30""><br>" + NL
    t = t + "<font size=""2"">Caption:</font> <input name=""caption"" size=""40"" maxlength=""<%= MAXCAPTION %>""><br>" + NL
    t = t + "<input type=""submit"" value=""Add Photo""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<p><font size=""1"" color=""#808080"">A .PIC file of up to <%= PHOTOSIZE %> by <%= PHOTOSIZE %>. To fit a Sketch drawing, run" + NL
    t = t + "<a href=""picture.asp"">SHRINK.SPK</a> on it with the size 200: it saves PHOTO.PIC, 200 by 150.</font></p>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= BoxTop(""Photos ("" + Str(ids.Count) + "")"") %>" + NL
    t = t + "<% IF shown = 0 THEN %>" + NL
    t = t + "<p><font size=""2"" color=""#808080"">No photos yet.</font></p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""4""><%= cells %></table>" + NL
    t = t + "<% IF shown < ids.Count THEN %><p><font size=""1"" color=""#808080"">The newest <%= shown %> of <%= ids.Count %>.</font></p><% END IF %>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\PHOTOS.ASP")
END SUB

SUB File13 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' PICTURE.ASP - upload or remove your profile picture. It has a page of its own" + NL
    t = t + "' because a whole request must fit in one 64K network message: a picture that is" + NL
    t = t + "' too big fails in Voyager before it ever reaches us, and should not take the rest" + NL
    t = t + "' of your profile edits down with it." + NL
    t = t + "VAR pic AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    RequireToken()" + NL
    t = t + "    IF REQUEST.Form(""remove"") <> """" THEN" + NL
    t = t + "        IF HasPicture(viewer) THEN FS.Delete(PicDir() + ""\"" + viewer + "".PIC"")" + NL
    t = t + "        RESPONSE.Redirect(""profile.asp?u="" + viewer)" + NL
    t = t + "    END IF" + NL
    t = t + "    pic = REQUEST.Form(""pic"")" + NL
    t = t + "    problem = SavePicture(viewer, pic)" + NL
    t = t + "    IF problem = """" THEN RESPONSE.Redirect(""profile.asp?u="" + viewer)" + NL
    t = t + "END IF" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""My Picture"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr>" + NL
    t = t + "<td width=""200"" valign=""top""><%= Picture(viewer) %></td>" + NL
    t = t + "<td valign=""top"">" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<%= BoxTop(""Upload a Picture"") %>" + NL
    t = t + "<form action=""picture.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<p><input type=""file"" name=""pic"" size=""30""> <input type=""submit"" value=""Upload""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<p><font size=""2"">A picture is a .PIC file of up to 100 by 100. Sketch saves bigger ones" + NL
    t = t + "(400 by 300, about 120K), and Voyager cannot send anything over 64K, so shrink a" + NL
    t = t + "Sketch picture first:</font></p>" + NL
    t = t + "<ol><font size=""2"">" + NL
    t = t + "<li>Draw yourself in Sketch and save it, say as <tt>C:\MYFILES\ME.PIC</tt>.</li>" + NL
    t = t + "<li>Copy the program below into SPARK, save it as <tt>C:\MYFILES\SHRINK.SPK</tt> and press F5.</li>" + NL
    t = t + "<li>Give it <tt>C:\MYFILES\ME.PIC</tt> and the size 100. It saves <tt>C:\MYFILES\AVATAR.PIC</tt>, 100 by 75." + NL
    t = t + "(The size 200 makes <tt>PHOTO.PIC</tt>, 200 by 150, for your <a href=""photos.asp"">photos</a>.)</li>" + NL
    t = t + "<li>Upload <tt>AVATAR.PIC</tt> here.</li>" + NL
    t = t + "</font></ol>" + NL
    t = t + "<form><textarea rows=""12"" cols=""70"" readonly><%= H(ReadOr(AppDir() + ""\SHRINK.SPK"", """")) %></textarea></form>" + NL
    t = t + "<% IF HasPicture(viewer) THEN %>" + NL
    t = t + "<%= BoxTop(""Remove My Picture"") %>" + NL
    t = t + "<form action=""picture.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<input type=""hidden"" name=""remove"" value=""1"">" + NL
    t = t + "<p><input type=""submit"" value=""Remove My Picture""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\PICTURE.ASP")
END SUB

SUB File14 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' POKE.ASP?u=name&do=poke|clear&b=home|profile - poke a friend (which also" + NL
    t = t + "' clears their poke at you), or brush their poke off. Carries the form token." + NL
    t = t + "VAR who AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR back AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "who = CleanName(REQUEST.Query(""u""))" + NL
    t = t + "IF REQUEST.Query(""do"") = ""clear"" THEN" + NL
    t = t + "    ClearPoke(viewer, who)" + NL
    t = t + "ELSE" + NL
    t = t + "    problem = Poke(viewer, who)" + NL
    t = t + "    IF problem = """" THEN problem = ""You poked "" + NameOf(who) + "".""" + NL
    t = t + "END IF" + NL
    t = t + "IF REQUEST.Query(""b"") = ""profile"" AND UserExists(who) THEN" + NL
    t = t + "    back = ""profile.asp?u="" + who + ""&why=""" + NL
    t = t + "ELSE" + NL
    t = t + "    back = ""home.asp?why=""" + NL
    t = t + "END IF" + NL
    t = t + "RESPONSE.Redirect(back + UrlEnc(problem))" + NL
    t = t + "%>" + NL
    Put("C:\WEB\POKE.ASP")
END SUB

SUB File15 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' POST.ASP - writes on a Wall (your own Wall is your status), then goes back." + NL
    t = t + "VAR wall AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR back AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""home.asp"")" + NL
    t = t + "wall = CleanName(REQUEST.Form(""to""))" + NL
    t = t + "problem = AddPost(viewer, wall, REQUEST.Form(""text""))" + NL
    t = t + "IF REQUEST.Form(""back"") = ""home"" OR wall = """" THEN" + NL
    t = t + "    back = ""home.asp""" + NL
    t = t + "    IF problem <> """" THEN back = back + ""?why="" + UrlEnc(problem)" + NL
    t = t + "ELSE" + NL
    t = t + "    back = ""profile.asp?u="" + wall" + NL
    t = t + "    IF problem <> """" THEN back = back + ""&why="" + UrlEnc(problem)" + NL
    t = t + "END IF" + NL
    t = t + "RESPONSE.Redirect(back)" + NL
    t = t + "%>" + NL
    Put("C:\WEB\POST.ASP")
END SUB

SUB File16 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' PROFILE.ASP?u=name - one member's page: picture, information, friends and Wall." + NL
    t = t + "VAR who AS String" + NL
    t = t + "VAR rec AS Array OF String" + NL
    t = t + "VAR pals AS Array OF String" + NL
    t = t + "VAR pal AS String" + NL
    t = t + "VAR shown AS Integer" + NL
    t = t + "VAR mine AS Bool" + NL
    t = t + "VAR friend AS Bool" + NL
    t = t + "RequireLogin()" + NL
    t = t + "who = viewer" + NL
    t = t + "IF REQUEST.Query(""u"") <> """" THEN who = CleanName(REQUEST.Query(""u""))" + NL
    t = t + "IF NOT UserExists(who) THEN RESPONSE.Redirect(""people.asp"")" + NL
    t = t + "rec = LoadUser(who)" + NL
    t = t + "pals = Friends(who)" + NL
    t = t + "mine = (who = viewer)" + NL
    t = t + "friend = IsFriend(viewer, who)" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(Field(rec, ""name"")) %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr>" + NL
    t = t + "<td width=""200"" valign=""top"">" + NL
    t = t + "<%= Picture(who) %>" + NL
    t = t + "<% IF mine THEN %>" + NL
    t = t + "<p><font size=""2""><a href=""edit.asp"">Edit My Profile</a><br><a href=""picture.asp"">Change My Picture</a></font></p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<form action=""friend.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<input type=""hidden"" name=""u"" value=""<%= who %>"">" + NL
    t = t + "<% IF friend THEN %>" + NL
    t = t + "<p><font size=""2""><%= H(Field(rec, ""name"")) %> is your friend." + NL
    t = t + "<a href=""poke.asp?u=<%= who %>&do=poke&b=profile&<%= TokenArg() %>"">Poke <%= H(Field(rec, ""name"")) %></a></font><br>" + NL
    t = t + "<input type=""hidden"" name=""do"" value=""remove""><input type=""submit"" value=""Remove from Friends""></p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<input type=""hidden"" name=""do"" value=""add""><p><input type=""submit"" value=""Add to Friends""></p>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</form>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<p><font size=""2""><a href=""photos.asp?u=<%= who %>"">Photos (<%= Album(who).Count %>)</a></font></p>" + NL
    t = t + "<a name=""friends""></a>" + NL
    t = t + "<%= BoxTop(""Friends ("" + Str(pals.Count) + "")"") %>" + NL
    t = t + "<font size=""2"">" + NL
    t = t + "<% FOR EACH pal IN pals %>" + NL
    t = t + "<a href=""profile.asp?u=<%= pal %>""><%= H(NameOf(pal)) %></a><br>" + NL
    t = t + "<%   shown = shown + 1" + NL
    t = t + "     IF shown >= 20 THEN BREAK" + NL
    t = t + "   NEXT %>" + NL
    t = t + "<% IF pals.Count = 0 THEN %><font color=""#808080"">No friends yet.</font><% END IF %>" + NL
    t = t + "</font>" + NL
    t = t + "</td>" + NL
    t = t + "<td valign=""top"">" + NL
    t = t + "<%= Notice(REQUEST.Query(""why"")) %>" + NL
    t = t + "<h2><font color=""#3B5998""><%= H(Field(rec, ""name"")) %></font></h2>" + NL
    t = t + "<%= BoxTop(""Information"") %>" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td width=""120""><font size=""2"" color=""#808080"">User name:</font></td><td><font size=""2""><%= who %></font></td></tr>" + NL
    t = t + "<tr><td><font size=""2"" color=""#808080"">Member since:</font></td><td><font size=""2""><%= H(Field(rec, ""joined"")) %></font></td></tr>" + NL
    t = t + "<% IF Field(rec, ""sex"") <> """" THEN %><tr><td><font size=""2"" color=""#808080"">Sex:</font></td><td><font size=""2""><%= H(Field(rec, ""sex"")) %></font></td></tr><% END IF %>" + NL
    t = t + "<% IF Field(rec, ""birthday"") <> """" THEN %><tr><td><font size=""2"" color=""#808080"">Birthday:</font></td><td><font size=""2""><%= H(Field(rec, ""birthday"")) %></font></td></tr><% END IF %>" + NL
    t = t + "<% IF Field(rec, ""hometown"") <> """" THEN %><tr><td><font size=""2"" color=""#808080"">Hometown:</font></td><td><font size=""2""><%= H(Field(rec, ""hometown"")) %></font></td></tr><% END IF %>" + NL
    t = t + "<% IF Field(rec, ""status"") <> """" THEN %><tr><td><font size=""2"" color=""#808080"">Relationship:</font></td><td><font size=""2""><%= H(Field(rec, ""status"")) %></font></td></tr><% END IF %>" + NL
    t = t + "<% IF Field(rec, ""interests"") <> """" THEN %><tr><td valign=""top""><font size=""2"" color=""#808080"">Interests:</font></td><td><font size=""2""><%= Br(Field(rec, ""interests"")) %></font></td></tr><% END IF %>" + NL
    t = t + "<% IF Field(rec, ""music"") <> """" THEN %><tr><td valign=""top""><font size=""2"" color=""#808080"">Favorite Music:</font></td><td><font size=""2""><%= Br(Field(rec, ""music"")) %></font></td></tr><% END IF %>" + NL
    t = t + "<% IF Field(rec, ""about"") <> """" THEN %><tr><td valign=""top""><font size=""2"" color=""#808080"">About Me:</font></td><td><font size=""2""><%= Br(Field(rec, ""about"")) %></font></td></tr><% END IF %>" + NL
    t = t + "</table>" + NL
    t = t + "<%= BoxTop(""The Wall"") %>" + NL
    t = t + "<% IF mine OR friend THEN %>" + NL
    t = t + "<form action=""post.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<input type=""hidden"" name=""to"" value=""<%= who %>"">" + NL
    t = t + "<p><%= LimitedBox(""text"", """", 3, 50, MAXPOST) %><br>" + NL
    t = t + "<input type=""submit"" id=""go"" value=""<% IF mine THEN %>Share<% ELSE %>Write on the Wall<% END IF %>""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<%= LimitScript(""text"", Str(MAXPOST)) %>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<p><font size=""2"" color=""#808080"">Only <%= H(Field(rec, ""name"")) %>'s friends can write on this Wall.</font></p>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<table width=""100%"" cellpadding=""5"" cellspacing=""2"">" + NL
    t = t + "<%= WallHtml(who) %>" + NL
    t = t + "</table>" + NL
    t = t + "</td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\PROFILE.ASP")
END SUB

SUB File17 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' REPLY.ASP - adds a reply to a post, then shows the post again." + NL
    t = t + "VAR id AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""home.asp"")" + NL
    t = t + "id = REQUEST.Form(""id"")" + NL
    t = t + "problem = AddReply(viewer, id, REQUEST.Form(""text""))" + NL
    t = t + "IF FindPost(id) = """" THEN RESPONSE.Redirect(""home.asp"")" + NL
    t = t + "IF problem <> """" THEN RESPONSE.Redirect(""view.asp?id="" + id + ""&why="" + UrlEnc(problem))" + NL
    t = t + "RESPONSE.Redirect(""view.asp?id="" + id)" + NL
    t = t + "%>" + NL
    Put("C:\WEB\REPLY.ASP")
END SUB

SUB File18 ()
    t = ""
    t = t + "' SHRINK.SPK - makes a Sketch picture small enough for SimBook." + NL
    t = t + "'" + NL
    t = t + "' Sketch always saves 400 by 300 pictures, about 120K of text, but one network" + NL
    t = t + "' message holds 64K, so Voyager cannot send one to a web server. This shrinks a" + NL
    t = t + "' picture until it fits a square:" + NL
    t = t + "'" + NL
    t = t + "'   100  a profile picture: a Sketch picture becomes 100 by 75 (8K), AVATAR.PIC" + NL
    t = t + "'   200  a photo:           a Sketch picture becomes 200 by 150 (30K), PHOTO.PIC" + NL
    t = t + "'" + NL
    t = t + "' and saves it next to the original." + NL
    t = t + "'" + NL
    t = t + "'     SPARK C:\MYFILES\SHRINK.SPK C:\MYFILES\ME.PIC 100" + NL
    t = t + "' or run it from SPARK with F5 and answer the two questions." + NL
    t = t + "'" + NL
    t = t + "' Each block of pixels becomes the colour it holds most of, not counting white," + NL
    t = t + "' so thin lines survive the trip." + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR dest AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR header AS Array OF String" + NL
    t = t + "    VAR rows AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR row AS String" + NL
    t = t + "    VAR w AS Integer" + NL
    t = t + "    VAR h AS Integer" + NL
    t = t + "    VAR f AS Integer" + NL
    t = t + "    VAR nw AS Integer" + NL
    t = t + "    VAR nh AS Integer" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR limit AS Integer" + NL
    t = t + "    VAR answer AS String" + NL
    t = t + "" + NL
    t = t + "    IF SYS.Args.Count > 0 THEN" + NL
    t = t + "        path = SYS.Args[0]" + NL
    t = t + "        IF SYS.Args.Count > 1 THEN answer = SYS.Args[1]" + NL
    t = t + "    ELSE" + NL
    t = t + "        path = Input(""Picture to shrink (for example C:\MYFILES\ME.PIC): "")" + NL
    t = t + "        answer = Input(""Type 100 for a profile picture, or 200 for a photo: "")" + NL
    t = t + "    END IF" + NL
    t = t + "    path = path.Trim()" + NL
    t = t + "    limit = 100" + NL
    t = t + "    IF answer.Trim() = ""200"" THEN limit = 200" + NL
    t = t + "    TRY" + NL
    t = t + "        text = FS.Read(path)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        Print(""Could not read "" + path + "": "" + err)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END TRY" + NL
    t = t + "" + NL
    t = t + "    lines = text.Lines()" + NL
    t = t + "    header = lines[0].Trim().Split("" "")" + NL
    t = t + "    IF header[0] <> ""SIM95PIC"" OR header.Count < 3 THEN" + NL
    t = t + "        Print(path + "" is not a picture. Save one from Sketch first."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    w = Int(Val(header[1]))" + NL
    t = t + "    h = Int(Val(header[2]))" + NL
    t = t + "" + NL
    t = t + "    ' The smallest whole-number shrink that fits" + NL
    t = t + "    f = 1" + NL
    t = t + "    WHILE w > f * limit OR h > f * limit" + NL
    t = t + "        f = f + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    nw = MATH.Ceil(w / f)" + NL
    t = t + "    nh = MATH.Ceil(h / f)" + NL
    t = t + "" + NL
    t = t + "    ' Every row as capitals, padded with white to a whole number of blocks" + NL
    t = t + "    FOR y = 0 TO nh * f - 1" + NL
    t = t + "        row = """"" + NL
    t = t + "        IF y + 1 < lines.Count THEN row = lines[y + 1].Trim().Upper()" + NL
    t = t + "        IF row.Length < nw * f THEN row = row.PadRight(nw * f).Replace("" "", ""F"")" + NL
    t = t + "        rows.Add(row)" + NL
    t = t + "    NEXT" + NL
    t = t + "" + NL
    t = t + "    FOR y = 0 TO nh - 1" + NL
    t = t + "        row = """"" + NL
    t = t + "        FOR x = 0 TO nw - 1" + NL
    t = t + "            row = row + Block(rows, x * f, y * f, f)" + NL
    t = t + "        NEXT" + NL
    t = t + "        out.Add(row)" + NL
    t = t + "    NEXT" + NL
    t = t + "" + NL
    t = t + "    dest = path.Upper()" + NL
    t = t + "    IF dest.Contains(""\"") THEN" + NL
    t = t + "        dest = dest.Substring(0, dest.Length - dest.Split(""\"")[dest.Split(""\"").Count - 1].Length)" + NL
    t = t + "    ELSE" + NL
    t = t + "        dest = """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF limit = 100 THEN" + NL
    t = t + "        dest = dest + ""AVATAR.PIC""" + NL
    t = t + "    ELSE" + NL
    t = t + "        dest = dest + ""PHOTO.PIC""" + NL
    t = t + "    END IF" + NL
    t = t + "    FS.Write(dest, ""SIM95PIC "" + Str(nw) + "" "" + Str(nh) + Chr(10) + out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "    Print(""Saved "" + dest + "" ("" + Str(nw) + "" by "" + Str(nh) + ""). Upload that one to SimBook."")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The colour an f-by-f block holds most of, ignoring white; white if it is all white." + NL
    t = t + "FUNCTION Block (rows AS Array OF String, x AS Integer, y AS Integer, f AS Integer) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    VAR best AS String" + NL
    t = t + "    VAR most AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR dy AS Integer" + NL
    t = t + "    FOR dy = 0 TO f - 1" + NL
    t = t + "        s = s + rows[y + dy].Substring(x, f)" + NL
    t = t + "    NEXT" + NL
    t = t + "    s = s.Replace(""F"", """")" + NL
    t = t + "    best = ""F""" + NL
    t = t + "    WHILE s <> """"" + NL
    t = t + "        c = s.CharAt(0)" + NL
    t = t + "        n = s.Length" + NL
    t = t + "        s = s.Replace(c, """")" + NL
    t = t + "        IF n - s.Length > most THEN" + NL
    t = t + "            most = n - s.Length" + NL
    t = t + "            best = c" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN best" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\WEB\SHRINK.SPK")
END SUB

SUB File19 ()
    t = ""
    t = t + "<html><head><title>About SimBook - the social network for the SIM95 network</title>" + NL
    t = t + "<meta name=""description"" content=""SimBook is a free social network and online community for everyone on the SIM95 network: make a profile, add friends, post status updates, share photos and write on your friends' Walls."">" + NL
    t = t + "<meta name=""keywords"" content=""social network, social networking, social media, online community, friends, facebook, myspace, twitter, friendster, profile, status updates, feed, news feed, timeline, wall, photos, photo albums, pokes, likes, thumbs up, comments, replies, people search, classmates, networking"">" + NL
    t = t + "</head>" + NL
    t = t + "<body bgcolor=""#FFFFFF"">" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""0""><tr><td bgcolor=""#3B5998""><font color=""#FFFFFF"" size=""5""><b>[simbook]</b></font></td></tr></table>" + NL
    t = t + "<h2><font color=""#3B5998"">About SimBook</font></h2>" + NL
    t = t + "<p><b>SimBook is the social network for the SIM95 network.</b> It is an online directory" + NL
    t = t + "of people, a place to keep up with your friends, and a feed of what everybody is up to." + NL
    t = t + "Think of it as your own little corner of the information superhighway, with your name on it.</p>" + NL
    t = t + "<h3>What you can do on SimBook</h3>" + NL
    t = t + "<ul>" + NL
    t = t + "<li><b>Make a profile</b> with your picture, where you live, what you like and an About Me.</li>" + NL
    t = t + "<li><b>Add friends</b> and see who their friends are. Find classmates and co-workers with People search.</li>" + NL
    t = t + "<li><b>Post status updates</b> to your news feed, and read your friends' posts as they happen.</li>" + NL
    t = t + "<li><b>Write on Walls</b>, reply to posts, and give them a thumbs up or a thumbs down.</li>" + NL
    t = t + "<li><b>Share photos</b> in photo albums.</li>" + NL
    t = t + "<li><b>Poke</b> people. Nobody knows what a poke means. That is the point.</li>" + NL
    t = t + "<li><b>Notifications</b> tell you when somebody writes on your Wall, replies or pokes you.</li>" + NL
    t = t + "</ul>" + NL
    t = t + "<h3>Is it like Facebook, MySpace or Twitter?</h3>" + NL
    t = t + "<p>A bit like all of them, years early. SimBook is a social networking site, a microblog for" + NL
    t = t + "short status updates, and a photo sharing site, written in SPARK and running on one SIM95 machine." + NL
    t = t + "Everything is kept in plain text files in C:\BOOKDATA. There is no algorithm: your feed is just" + NL
    t = t + "your friends, newest first.</p>" + NL
    t = t + "<p><a href=""index.asp""><b>Join SimBook</b></a> or <a href=""index.asp"">log in</a>. It's free and anyone can join.</p>" + NL
    t = t + "<hr><center><font size=""1"" color=""#808080"">SimBook: social network, online community, friends and photos for SIM95.</font></center>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\SIMBOOK.HTM")
END SUB

SUB File20 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' VIEW.ASP?id=N - one post with all its replies (as many as fit), and a reply box." + NL
    t = t + "VAR id AS String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "id = REQUEST.Query(""id"")" + NL
    t = t + "line = FindPost(id)" + NL
    t = t + "IF line = """" THEN RESPONSE.Redirect(""home.asp"")" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Post"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= Notice(REQUEST.Query(""why"")) %>" + NL
    t = t + "<%= BoxTop(""Post"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""5"" cellspacing=""2"">" + NL
    t = t + "<%= PostHtml(line, FALSE, ""view"", 0) %>" + NL
    t = t + "</table>" + NL
    t = t + "<% IF CanTalk(viewer, line) THEN %>" + NL
    t = t + "<%= BoxTop(""Reply"") %>" + NL
    t = t + "<form action=""reply.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<input type=""hidden"" name=""id"" value=""<%= id %>"">" + NL
    t = t + "<p><%= LimitedBox(""text"", """", 3, 50, MAXREPLY) %><br>" + NL
    t = t + "<input type=""submit"" id=""go"" value=""Reply""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<%= LimitScript(""text"", Str(MAXREPLY)) %>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<p><font size=""2"" color=""#808080"">Only friends can reply to this.</font></p>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\VIEW.ASP")
END SUB

SUB File21 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' VOTE.ASP?id=N&v=up|down&b=back - thumbs up or down on a post (the same thumb" + NL
    t = t + "' again takes it back), then returns to the feed, the post or the Wall it came from." + NL
    t = t + "VAR id AS String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR back AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "id = REQUEST.Query(""id"")" + NL
    t = t + "line = FindPost(id)" + NL
    t = t + "IF line <> """" AND CanTalk(viewer, line) THEN" + NL
    t = t + "    IF REQUEST.Query(""v"") = ""up"" THEN Vote(viewer, line, ""+"")" + NL
    t = t + "    IF REQUEST.Query(""v"") = ""down"" THEN Vote(viewer, line, ""-"")" + NL
    t = t + "END IF" + NL
    t = t + "back = REQUEST.Query(""b"")" + NL
    t = t + "IF back = ""view"" THEN RESPONSE.Redirect(""view.asp?id="" + id)" + NL
    t = t + "IF back <> ""home"" AND UserExists(back) THEN RESPONSE.Redirect(""profile.asp?u="" + back)" + NL
    t = t + "RESPONSE.Redirect(""home.asp"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\VOTE.ASP")
END SUB

' HTTPD.SPK serves INDEX.ASP for a folder only when it has no INDEX.HTM, so the
' stock home page steps aside (to the first free name) instead of being deleted.
SUB MoveHomePage ()
    VAR names AS Array OF String
    VAR name AS String
    IF NOT FS.Exists("C:\WEB\INDEX.HTM") THEN RETURN
    names = ["WELCOME.HTM", "INDEX1.HTM", "INDEX2.HTM", "INDEX3.HTM", "INDEX4.HTM", "INDEX5.HTM", "INDEX6.HTM", "INDEX7.HTM", "INDEX8.HTM", "INDEX9.HTM"]
    FOR EACH name IN names
        IF NOT FS.Exists("C:\WEB\" + name) THEN
            FS.Rename("C:\WEB\INDEX.HTM", "C:\WEB\" + name)
            Print("  moved the old home page to C:\WEB\" + name)
            RETURN
        END IF
    NEXT
    THROW "C:\WEB\INDEX.HTM is in the way and there is nowhere to move it. Rename it yourself and run this again."
END SUB

' MIGRATE.SPK - brings an older SimBook's data forward. INSTALL.SPK runs it
' before writing the pages; it is safe to run any number of times.
'
'   POSTS.TXT     The first SimBook kept every post in one file. Posts now live
'                 in LOG\<n>.TXT, 500 to a file (LOGSIZE in BOOK.SPK), by number;
'                 POSTS.TXT is kept as POSTS.OLD.
'   REPLIES\*.TXT Replies were date|author|name|text. They now start with a
'                 reply number, so a single reply can be deleted.

SUB Migrate ()
    IF NOT FS.Exists("C:\BOOKDATA") THEN RETURN
    MigrateLog()
    MigrateReplies()
END SUB

SUB MigrateLog ()
    VAR lines AS Array OF String
    VAR line AS String
    VAR text AS String
    VAR chunk AS Integer
    VAR last AS Integer = -1
    VAR moved AS Integer
    IF NOT FS.Exists("C:\BOOKDATA\POSTS.TXT") THEN RETURN
    IF NOT FS.Exists("C:\BOOKDATA\LOG") THEN FS.MakeDir("C:\BOOKDATA\LOG")
    lines = FS.Read("C:\BOOKDATA\POSTS.TXT").Lines()
    FOR EACH line IN lines
        IF line = "" THEN CONTINUE
        chunk = Int((Int(Val(line.Split("|")[0])) - 1) / 500)
        IF chunk <> last AND last >= 0 THEN
            FS.Append("C:\BOOKDATA\LOG\" + Str(last) + ".TXT", text)
            text = ""
        END IF
        last = chunk
        text = text + line + Chr(10)
        moved = moved + 1
    NEXT
    IF last >= 0 THEN FS.Append("C:\BOOKDATA\LOG\" + Str(last) + ".TXT", text)
    IF FS.Exists("C:\BOOKDATA\POSTS.OLD") THEN FS.Delete("C:\BOOKDATA\POSTS.OLD")
    FS.Rename("C:\BOOKDATA\POSTS.TXT", "C:\BOOKDATA\POSTS.OLD")
    Print("  moved " + Str(moved) + " posts into C:\BOOKDATA\LOG")
END SUB

SUB MigrateReplies ()
    VAR files AS Array OF String
    VAR file AS String
    VAR lines AS Array OF String
    VAR i AS Integer
    VAR n AS Integer
    VAR changed AS Bool
    VAR numbered AS Integer
    IF NOT FS.Exists("C:\BOOKDATA\REPLIES") THEN RETURN
    IF FS.Exists("C:\BOOKDATA\NEXTRID.TXT") THEN n = Int(Val(FS.Read("C:\BOOKDATA\NEXTRID.TXT")))
    files = FS.List("C:\BOOKDATA\REPLIES")
    FOR EACH file IN files
        IF file.EndsWith("\") THEN CONTINUE
        lines = FS.Read("C:\BOOKDATA\REPLIES\" + file).Lines()
        changed = FALSE
        FOR i = 0 TO lines.Count - 1
            IF lines[i] <> "" AND lines[i].Split("|").Count = 4 THEN
                n = n + 1
                lines[i] = Str(n) + "|" + lines[i]
                changed = TRUE
                numbered = numbered + 1
            END IF
        NEXT
        IF changed THEN FS.Write("C:\BOOKDATA\REPLIES\" + file, lines.Join(Chr(10)))
    NEXT
    FS.Write("C:\BOOKDATA\NEXTRID.TXT", Str(n))
    IF numbered > 0 THEN Print("  numbered " + Str(numbered) + " replies")
END SUB
