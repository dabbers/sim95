' INSTALL.SPK - puts SimBook on this machine. Generated by tools/build-installer.mjs;
' edit the files in simbook/WEB and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. SimBook becomes
' this machine's home page: its pages go into C:\WEB, and the stock INDEX.HTM is
' moved aside to WELCOME.HTM, so the web server falls back to INDEX.ASP. It
' leaves C:\BOOKDATA (accounts, posts) alone, so running it again upgrades
' SimBook without losing anybody. Then open http://YOURNAME/ in Voyager.

VAR t AS String
VAR NL AS String

SUB Main ()
    NL = Chr(10)
    IF NOT FS.Exists("C:\WEB\PICS") THEN FS.MakeDir("C:\WEB\PICS")
    MoveHomePage()
    File0()
    File1()
    File2()
    File3()
    File4()
    File5()
    File6()
    File7()
    File8()
    File9()
    File10()
    File11()
    Print("SimBook is installed in C:\WEB (12 files).")
    Print("Open http://" + NET.HostName.Lower() + "/ in Voyager.")
END SUB

' HTTPD.SPK serves INDEX.ASP for a folder only when it has no INDEX.HTM, so the
' stock home page steps aside (to the first free name) instead of being deleted.
SUB MoveHomePage ()
    VAR names AS Array OF String
    VAR name AS String
    IF NOT FS.Exists("C:\WEB\INDEX.HTM") THEN RETURN
    names = ["WELCOME.HTM", "INDEX1.HTM", "INDEX2.HTM", "INDEX3.HTM", "INDEX4.HTM", "INDEX5.HTM", "INDEX6.HTM", "INDEX7.HTM", "INDEX8.HTM", "INDEX9.HTM"]
    FOR EACH name IN names
        IF NOT FS.Exists("C:\WEB\" + name) THEN
            FS.Rename("C:\WEB\INDEX.HTM", "C:\WEB\" + name)
            Print("  moved the old home page to C:\WEB\" + name)
            RETURN
        END IF
    NEXT
    THROW "C:\WEB\INDEX.HTM is in the way and there is nowhere to move it. Rename it yourself and run this again."
END SUB

SUB Put (name AS String)
    FS.Write("C:\WEB\" + name, t)
    Print("  wrote C:\WEB\" + name)
END SUB

SUB File0 ()
    t = ""
    t = t + "' BOOK.SPK - SimBook, a little social network for SIM95." + NL
    t = t + "' SimBook is the machine's home page: it lives in C:\WEB, and every page pulls this in with <%@ import file=""BOOK.SPK"" %>." + NL
    t = t + "'" + NL
    t = t + "' There is no database server: everything lives in plain text files under" + NL
    t = t + "' C:\BOOKDATA (outside C:\WEB, so the web server never hands it out), and every" + NL
    t = t + "' change is written to disk the moment it happens. Nothing is kept in memory" + NL
    t = t + "' between requests." + NL
    t = t + "'" + NL
    t = t + "'   C:\BOOKDATA\USERS\<user>.TXT    one profile, key=value per line" + NL
    t = t + "'   C:\BOOKDATA\FRIENDS\<user>.TXT  |ann|bob|cat|  (friendship is mutual)" + NL
    t = t + "'   C:\BOOKDATA\WALLS\<user>.TXT    every post on that user's wall, oldest first" + NL
    t = t + "'   C:\BOOKDATA\POSTS.TXT           every post on every wall: the feed reads this" + NL
    t = t + "'   C:\BOOKDATA\PEOPLE.TXT          user|name, one per member, for the directory" + NL
    t = t + "'   C:\BOOKDATA\SESSIONS\<id>.TXT   who a sign-in cookie belongs to" + NL
    t = t + "'   C:\BOOKDATA\NEXTID.TXT          the last post number handed out" + NL
    t = t + "'   C:\WEB\PICS\<user>.PIC          profile pictures (Sketch .PIC files)" + NL
    t = t + "'" + NL
    t = t + "' A post is one line: id|date time|author|author name|wall|wall name|text" + NL
    t = t + "' Names and text are escaped with Esc so they never contain | or a line break." + NL
    t = t + "'" + NL
    t = t + "' A server page that runs too long is stopped, and the whole page is built" + NL
    t = t + "' before Voyager sees any of it, so loops here stay short: the feed and walls" + NL
    t = t + "' stop after a screenful, and the feed only looks back through recent posts." + NL
    t = t + "" + NL
    t = t + "CONST DATADIR = ""C:\BOOKDATA""" + NL
    t = t + "CONST PICDIR = ""C:\WEB\PICS""" + NL
    t = t + "CONST COOKIE = ""simbook""" + NL
    t = t + "CONST FEEDSIZE = 25" + NL
    t = t + "CONST FEEDSCAN = 1000" + NL
    t = t + "CONST MAXPOST = 1000" + NL
    t = t + "CONST MAXPIC = 40000" + NL
    t = t + "" + NL
    t = t + "VAR viewer AS String          ' who is signed in; """" for nobody" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the disk" + NL
    t = t + "" + NL
    t = t + "SUB EnsureDisk ()" + NL
    t = t + "    IF FS.Exists(DATADIR + ""\SESSIONS"") THEN RETURN" + NL
    t = t + "    IF NOT FS.Exists(DATADIR) THEN FS.MakeDir(DATADIR)" + NL
    t = t + "    IF NOT FS.Exists(DATADIR + ""\USERS"") THEN FS.MakeDir(DATADIR + ""\USERS"")" + NL
    t = t + "    IF NOT FS.Exists(DATADIR + ""\FRIENDS"") THEN FS.MakeDir(DATADIR + ""\FRIENDS"")" + NL
    t = t + "    IF NOT FS.Exists(DATADIR + ""\WALLS"") THEN FS.MakeDir(DATADIR + ""\WALLS"")" + NL
    t = t + "    IF NOT FS.Exists(PICDIR) THEN FS.MakeDir(PICDIR)" + NL
    t = t + "    FS.MakeDir(DATADIR + ""\SESSIONS"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Text that is safe inside one |-separated line, and back again." + NL
    t = t + "FUNCTION Esc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%"", ""%25"").Replace(""|"", ""%7C"").Replace(Chr(13), """").Replace(Chr(10), ""%0A"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unesc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%0A"", Chr(10)).Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Text that is safe inside a page; Br also keeps the line breaks." + NL
    t = t + "FUNCTION H (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.HtmlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Br (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.HtmlEncode(s).Replace(Chr(10), ""<br>"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UrlEnc (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.UrlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Only letters and digits are allowed in characters, so that a name or a session" + NL
    t = t + "' id from a visitor can never reach outside its folder." + NL
    t = t + "FUNCTION OnlyFrom (s AS String, allowed AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        IF NOT allowed.Contains(s.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A user name is also a file name, and file names here are 8.3." + NL
    t = t + "FUNCTION ValidName (u AS String) AS Bool" + NL
    t = t + "    IF u.Length < 3 OR u.Length > 8 THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyFrom(u, ""abcdefghijklmnopqrstuvwxyz0123456789"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CleanName (u AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = u.Trim().Lower()" + NL
    t = t + "    IF ValidName(s) THEN RETURN s" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- users" + NL
    t = t + "" + NL
    t = t + "FUNCTION UserPath (u AS String) AS String" + NL
    t = t + "    RETURN DATADIR + ""\USERS\"" + u + "".TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UserExists (u AS String) AS Bool" + NL
    t = t + "    IF NOT ValidName(u) THEN RETURN FALSE" + NL
    t = t + "    RETURN FS.Exists(UserPath(u))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A profile is the lines of its file; Field and SetField work on that array." + NL
    t = t + "FUNCTION LoadUser (u AS String) AS Array OF String" + NL
    t = t + "    RETURN FS.Read(UserPath(u)).Lines()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SaveUser (u AS String, rec AS Array OF String)" + NL
    t = t + "    FS.Write(UserPath(u), rec.Join(Chr(10)))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Field (rec AS Array OF String, key AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN rec" + NL
    t = t + "        IF line.StartsWith(key + ""="") THEN RETURN Unesc(line.Substring(key.Length + 1, line.Length - key.Length - 1))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SetField (rec AS Array OF String, key AS String, value AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO rec.Count - 1" + NL
    t = t + "        IF rec[i].StartsWith(key + ""="") THEN" + NL
    t = t + "            rec[i] = key + ""="" + Esc(value)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    rec.Add(key + ""="" + Esc(value))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION NameOf (u AS String) AS String" + NL
    t = t + "    RETURN Field(LoadUser(u), ""name"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Not real cryptography - SIM95 has none - but the password itself never" + NL
    t = t + "' touches the disk. Two running hashes over salt + password, kept under 2^31." + NL
    t = t + "FUNCTION Hash (salt AS String, pw AS String) AS String" + NL
    t = t + "    VAR a AS Integer = 7" + NL
    t = t + "    VAR b AS Integer = 31337" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = salt + "":"" + pw + "":"" + salt" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        c = Asc(s.CharAt(i))" + NL
    t = t + "        a = (a * 131 + c) MOD 2147483629" + NL
    t = t + "        b = (b * 257 + c + a) MOD 2147483587" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN Hex(a) + ""-"" + Hex(b)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NewToken () AS String" + NL
    t = t + "    RETURN Hex(268435456 + Rnd(1879048191))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Returns """" on success, otherwise what is wrong." + NL
    t = t + "FUNCTION CreateUser (u AS String, pw AS String, name AS String) AS String" + NL
    t = t + "    VAR rec AS Array OF String" + NL
    t = t + "    VAR salt AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    IF NOT ValidName(u) THEN RETURN ""Pick a user name of 3 to 8 letters or digits.""" + NL
    t = t + "    IF FS.Exists(UserPath(u)) THEN RETURN ""Somebody already has the name "" + u + "".""" + NL
    t = t + "    IF pw.Length < 4 THEN RETURN ""Pick a password of at least 4 characters.""" + NL
    t = t + "    IF name.Trim() = """" THEN RETURN ""Tell us your name.""" + NL
    t = t + "    salt = NewToken()" + NL
    t = t + "    SetField(rec, ""name"", name.Trim())" + NL
    t = t + "    SetField(rec, ""salt"", salt)" + NL
    t = t + "    SetField(rec, ""pass"", Hash(salt, pw))" + NL
    t = t + "    SetField(rec, ""joined"", TIME.Date)" + NL
    t = t + "    SaveUser(u, rec)" + NL
    t = t + "    FS.Write(DATADIR + ""\FRIENDS\"" + u + "".TXT"", ""|"")" + NL
    t = t + "    FS.Append(DATADIR + ""\PEOPLE.TXT"", u + ""|"" + Esc(name.Trim()) + Chr(10))" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CheckPassword (u AS String, pw AS String) AS Bool" + NL
    t = t + "    VAR rec AS Array OF String" + NL
    t = t + "    IF NOT UserExists(u) THEN RETURN FALSE" + NL
    t = t + "    rec = LoadUser(u)" + NL
    t = t + "    RETURN Hash(Field(rec, ""salt""), pw) = Field(rec, ""pass"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Keep the member directory in step when someone changes their name." + NL
    t = t + "SUB RenamePerson (u AS String, name AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    lines = ReadOr(DATADIR + ""\PEOPLE.TXT"", """").Lines()" + NL
    t = t + "    FOR i = 0 TO lines.Count - 1" + NL
    t = t + "        IF lines[i].StartsWith(u + ""|"") THEN lines[i] = u + ""|"" + Esc(name)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Write(DATADIR + ""\PEOPLE.TXT"", lines.Join(Chr(10)))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION HasPicture (u AS String) AS Bool" + NL
    t = t + "    RETURN FS.Exists(PICDIR + ""\"" + u + "".PIC"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- sessions" + NL
    t = t + "" + NL
    t = t + "SUB SignIn (u AS String)" + NL
    t = t + "    VAR token AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    token = NewToken()" + NL
    t = t + "    FS.Write(DATADIR + ""\SESSIONS\"" + token + "".TXT"", u)" + NL
    t = t + "    RESPONSE.SetCookie(COOKIE, token)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SignOut ()" + NL
    t = t + "    VAR token AS String" + NL
    t = t + "    token = REQUEST.Cookie(COOKIE)" + NL
    t = t + "    IF token <> """" AND token.Length <= 8 THEN" + NL
    t = t + "        IF OnlyFrom(token, ""0123456789ABCDEF"") AND FS.Exists(DATADIR + ""\SESSIONS\"" + token + "".TXT"") THEN" + NL
    t = t + "            FS.Delete(DATADIR + ""\SESSIONS\"" + token + "".TXT"")" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    RESPONSE.SetCookie(COOKIE, """")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Who the cookie says is signed in, or """"." + NL
    t = t + "FUNCTION CurrentUser () AS String" + NL
    t = t + "    VAR token AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR u AS String" + NL
    t = t + "    token = REQUEST.Cookie(COOKIE)" + NL
    t = t + "    IF token = """" OR token.Length > 8 THEN RETURN """"" + NL
    t = t + "    IF NOT OnlyFrom(token, ""0123456789ABCDEF"") THEN RETURN """"" + NL
    t = t + "    path = DATADIR + ""\SESSIONS\"" + token + "".TXT""" + NL
    t = t + "    IF NOT FS.Exists(path) THEN RETURN """"" + NL
    t = t + "    u = FS.Read(path).Trim()" + NL
    t = t + "    IF NOT UserExists(u) THEN RETURN """"" + NL
    t = t + "    RETURN u" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The first line of every members-only page." + NL
    t = t + "SUB RequireLogin ()" + NL
    t = t + "    viewer = CurrentUser()" + NL
    t = t + "    IF viewer = """" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- friends" + NL
    t = t + "" + NL
    t = t + "FUNCTION FriendList (u AS String) AS String" + NL
    t = t + "    RETURN ReadOr(DATADIR + ""\FRIENDS\"" + u + "".TXT"", ""|"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsFriend (a AS String, b AS String) AS Bool" + NL
    t = t + "    RETURN FriendList(a).Contains(""|"" + b + ""|"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Friends (u AS String) AS Array OF String" + NL
    t = t + "    VAR all AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    all = FriendList(u).Split(""|"")" + NL
    t = t + "    FOR EACH f IN all" + NL
    t = t + "        IF f <> """" THEN out.Add(f)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB AddFriend (a AS String, b AS String)" + NL
    t = t + "    IF a = b OR IsFriend(a, b) THEN RETURN" + NL
    t = t + "    FS.Write(DATADIR + ""\FRIENDS\"" + a + "".TXT"", FriendList(a) + b + ""|"")" + NL
    t = t + "    FS.Write(DATADIR + ""\FRIENDS\"" + b + "".TXT"", FriendList(b) + a + ""|"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RemoveFriend (a AS String, b AS String)" + NL
    t = t + "    FS.Write(DATADIR + ""\FRIENDS\"" + a + "".TXT"", FriendList(a).Replace(""|"" + b + ""|"", ""|""))" + NL
    t = t + "    FS.Write(DATADIR + ""\FRIENDS\"" + b + "".TXT"", FriendList(b).Replace(""|"" + a + ""|"", ""|""))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- posts" + NL
    t = t + "" + NL
    t = t + "FUNCTION NextId () AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    n = Int(Val(ReadOr(DATADIR + ""\NEXTID.TXT"", ""0""))) + 1" + NL
    t = t + "    FS.Write(DATADIR + ""\NEXTID.TXT"", Str(n))" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Write on someone's wall (your own wall is your status). Returns """" or a problem." + NL
    t = t + "FUNCTION AddPost (author AS String, wall AS String, text AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    text = text.Replace(Chr(13), """").Trim()" + NL
    t = t + "    IF text = """" THEN RETURN ""Write something first.""" + NL
    t = t + "    IF text.Length > MAXPOST THEN RETURN ""Keep it under "" + Str(MAXPOST) + "" characters.""" + NL
    t = t + "    IF NOT UserExists(wall) THEN RETURN ""There is nobody called "" + wall + "".""" + NL
    t = t + "    IF author <> wall AND NOT IsFriend(author, wall) THEN RETURN ""Only friends can write on "" + wall + ""'s Wall.""" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    line = Str(NextId()) + ""|"" + TIME.Date + "" "" + TIME.Clock.Substring(0, 5) + ""|"" + author + ""|"" + Esc(NameOf(author)) + ""|"" + wall + ""|"" + Esc(NameOf(wall)) + ""|"" + Esc(text)" + NL
    t = t + "    FS.Append(DATADIR + ""\POSTS.TXT"", line + Chr(10))" + NL
    t = t + "    FS.Append(DATADIR + ""\WALLS\"" + wall + "".TXT"", line + Chr(10))" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One post as a row of the feed or a wall. onWall leaves out ""on X's Wall""." + NL
    t = t + "FUNCTION PostHtml (line AS String, onWall AS Bool) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR who AS String" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    IF p.Count < 7 THEN RETURN """"" + NL
    t = t + "    who = ""<a href=""""profile.asp?u="" + p[2] + """"""><b>"" + H(Unesc(p[3])) + ""</b></a>""" + NL
    t = t + "    IF p[2] <> p[4] AND NOT onWall THEN" + NL
    t = t + "        who = who + "" &raquo; <a href=""""profile.asp?u="" + p[4] + """"""><b>"" + H(Unesc(p[5])) + ""</b></a>""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN ""<tr><td bgcolor=""""#F7F7F7""""><font size=""""2"""">"" + who + "" <font color=""""#808080"""">"" + p[1] + ""</font><br>"" + Br(Unesc(p[6])) + ""</font></td></tr>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The newest posts on one wall." + NL
    t = t + "FUNCTION WallHtml (u AS String) AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR shown AS Integer" + NL
    t = t + "    lines = ReadOr(DATADIR + ""\WALLS\"" + u + "".TXT"", """").Lines()" + NL
    t = t + "    FOR i = lines.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF lines[i] <> """" THEN" + NL
    t = t + "            out = out + PostHtml(lines[i], TRUE)" + NL
    t = t + "            shown = shown + 1" + NL
    t = t + "            IF shown >= FEEDSIZE THEN BREAK" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF out = """" THEN RETURN ""<tr><td><font size=""""2"""" color=""""#808080"""">Nothing on the Wall yet.</font></td></tr>""" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The News Feed: what you and your friends wrote, or what was written to you or them." + NL
    t = t + "FUNCTION FeedHtml (u AS String) AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR circle AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR stop AS Integer" + NL
    t = t + "    VAR shown AS Integer" + NL
    t = t + "    circle = FriendList(u) + u + ""|""" + NL
    t = t + "    lines = ReadOr(DATADIR + ""\POSTS.TXT"", """").Lines()" + NL
    t = t + "    stop = lines.Count - FEEDSCAN" + NL
    t = t + "    IF stop < 0 THEN stop = 0" + NL
    t = t + "    FOR i = lines.Count - 1 TO stop STEP -1" + NL
    t = t + "        p = lines[i].Split(""|"")" + NL
    t = t + "        IF p.Count >= 7 THEN" + NL
    t = t + "            IF circle.Contains(""|"" + p[2] + ""|"") OR circle.Contains(""|"" + p[4] + ""|"") THEN" + NL
    t = t + "                out = out + PostHtml(lines[i], FALSE)" + NL
    t = t + "                shown = shown + 1" + NL
    t = t + "                IF shown >= FEEDSIZE THEN BREAK" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF out = """" THEN RETURN ""<tr><td><font size=""""2"""" color=""""#808080"""">Nothing here yet. Write something above, or find some <a href=""""people.asp"""">people</a> to be friends with.</font></td></tr>""" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- page furniture" + NL
    t = t + "" + NL
    t = t + "FUNCTION Top (title AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = ""<html><head><title>"" + H(title) + "" - SimBook</title></head>"" _" + NL
    t = t + "      + ""<body bgcolor=""""#FFFFFF"""" text=""""#000000"""" link=""""#3B5998"""" vlink=""""#3B5998"""">"" _" + NL
    t = t + "      + ""<table width=""""100%"""" cellpadding=""""6"""" cellspacing=""""0"""" bgcolor=""""#3B5998""""><tr>"" _" + NL
    t = t + "      + ""<td><a href=""""index.asp""""><font color=""""#FFFFFF"""" size=""""5""""><b>[simbook]</b></font></a></td>"" _" + NL
    t = t + "      + ""<td align=""""right""""><font color=""""#FFFFFF"""" size=""""2"""">""" + NL
    t = t + "    IF viewer <> """" THEN" + NL
    t = t + "        s = s + ""<a href=""""home.asp""""><font color=""""#FFFFFF"""">home</font></a> | "" _" + NL
    t = t + "              + ""<a href=""""profile.asp?u="" + viewer + """"""><font color=""""#FFFFFF"""">profile</font></a> | "" _" + NL
    t = t + "              + ""<a href=""""people.asp""""><font color=""""#FFFFFF"""">people</font></a> | "" _" + NL
    t = t + "              + ""<a href=""""edit.asp""""><font color=""""#FFFFFF"""">edit</font></a> | "" _" + NL
    t = t + "              + ""<a href=""""logout.asp""""><font color=""""#FFFFFF"""">logout</font></a>""" + NL
    t = t + "    ELSE" + NL
    t = t + "        s = s + ""<a href=""""index.asp""""><font color=""""#FFFFFF"""">login</font></a> | <a href=""""index.asp""""><font color=""""#FFFFFF"""">register</font></a>""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN s + ""</font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Bottom () AS String" + NL
    t = t + "    RETURN ""<hr><center><font size=""""1"""" color=""""#808080"""">SimBook on "" + H(SERVER.Name) + "" &middot; "" + TIME.Date + ""</font></center></body></html>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A titled box, the way every section of a profile is drawn." + NL
    t = t + "FUNCTION BoxTop (title AS String) AS String" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""3"""" cellspacing=""""0""""><tr><td bgcolor=""""#6D84B4""""><font color=""""#FFFFFF"""" size=""""2""""><b>"" + title + ""</b></font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Notice (text AS String) AS String" + NL
    t = t + "    IF text = """" THEN RETURN """"" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""4""""><tr><td bgcolor=""""#FFF9D7""""><font size=""""2"""">"" + H(text) + ""</font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One <option> of a <select>, chosen when it is the current value." + NL
    t = t + "FUNCTION Opt (value AS String, current AS String) AS String" + NL
    t = t + "    IF value = current THEN RETURN ""<option selected>"" + H(value) + ""</option>""" + NL
    t = t + "    RETURN ""<option>"" + H(value) + ""</option>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Picture (u AS String) AS String" + NL
    t = t + "    IF HasPicture(u) THEN RETURN ""<img src=""""pics/"" + u + "".pic"""" alt="""""" + u + """""">""" + NL
    t = t + "    RETURN ""<img src=""""nopic.pic"""" alt=""""no picture"""">""" + NL
    t = t + "END FUNCTION" + NL
    Put("BOOK.SPK")
END SUB

SUB File1 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' EDIT.ASP - change your profile and picture. GET shows the form; POST saves it." + NL
    t = t + "VAR rec AS Array OF String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR pic AS String" + NL
    t = t + "VAR size AS Array OF String" + NL
    t = t + "VAR key AS String" + NL
    t = t + "VAR keys AS Array OF String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "rec = LoadUser(viewer)" + NL
    t = t + "" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    IF REQUEST.Form(""name"").Trim() = """" THEN" + NL
    t = t + "        problem = ""Your name cannot be empty.""" + NL
    t = t + "    ELSE" + NL
    t = t + "        keys = [""sex"", ""birthday"", ""hometown"", ""status"", ""interests"", ""music"", ""about""]" + NL
    t = t + "        FOR EACH key IN keys" + NL
    t = t + "            SetField(rec, key, REQUEST.Form(key).Replace(Chr(13), """").Trim())" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF REQUEST.Form(""name"").Trim() <> Field(rec, ""name"") THEN" + NL
    t = t + "            SetField(rec, ""name"", REQUEST.Form(""name"").Trim())" + NL
    t = t + "            RenamePerson(viewer, REQUEST.Form(""name"").Trim())" + NL
    t = t + "        END IF" + NL
    t = t + "        SaveUser(viewer, rec)" + NL
    t = t + "" + NL
    t = t + "        ' A picture is a Sketch .PIC file: ""SIM95PIC width height"", then rows of hex digits." + NL
    t = t + "        pic = REQUEST.Form(""pic"")" + NL
    t = t + "        IF REQUEST.Form(""nopic"") <> """" AND HasPicture(viewer) THEN FS.Delete(PICDIR + ""\"" + viewer + "".PIC"")" + NL
    t = t + "        IF pic <> """" THEN" + NL
    t = t + "            size = pic.Lines()[0].Trim().Split("" "")" + NL
    t = t + "            IF NOT pic.StartsWith(""SIM95PIC "") OR size.Count < 3 THEN" + NL
    t = t + "                problem = ""Your profile was saved, but that is not a picture. Draw one in Sketch and save it as a .PIC file.""" + NL
    t = t + "            ELSEIF pic.Length > MAXPIC OR Val(size[1]) > 200 OR Val(size[2]) > 200 THEN" + NL
    t = t + "                problem = ""Your profile was saved, but the picture is too big. Keep it under 200 by 200.""" + NL
    t = t + "            ELSE" + NL
    t = t + "                EnsureDisk()" + NL
    t = t + "                FS.Write(PICDIR + ""\"" + viewer + "".PIC"", pic)" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        IF problem = """" THEN RESPONSE.Redirect(""profile.asp?u="" + viewer)" + NL
    t = t + "    END IF" + NL
    t = t + "END IF" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Edit My Profile"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<% IF REQUEST.Query(""new"") = ""1"" THEN %>" + NL
    t = t + "<%= Notice(""Welcome to SimBook! Tell people a little about yourself, then go find your friends."") %>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<%= BoxTop(""Edit My Profile"") %>" + NL
    t = t + "<form action=""edit.asp"" method=""post"">" + NL
    t = t + "<table cellpadding=""4"">" + NL
    t = t + "<tr><td><font size=""2"">Name:</font></td><td><input name=""name"" size=""30"" value=""<%= H(Field(rec, ""name"")) %>""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Sex:</font></td><td><select name=""sex""><%= Opt("""", Field(rec, ""sex"")) %><%= Opt(""Female"", Field(rec, ""sex"")) %><%= Opt(""Male"", Field(rec, ""sex"")) %></select></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Birthday:</font></td><td><input name=""birthday"" size=""20"" value=""<%= H(Field(rec, ""birthday"")) %>""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Hometown:</font></td><td><input name=""hometown"" size=""30"" value=""<%= H(Field(rec, ""hometown"")) %>""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Relationship:</font></td><td><select name=""status""><%= Opt("""", Field(rec, ""status"")) %><%= Opt(""Single"", Field(rec, ""status"")) %><%= Opt(""In a Relationship"", Field(rec, ""status"")) %><%= Opt(""Married"", Field(rec, ""status"")) %><%= Opt(""It's Complicated"", Field(rec, ""status"")) %></select></td></tr>" + NL
    t = t + "<tr><td valign=""top""><font size=""2"">Interests:</font></td><td><textarea name=""interests"" rows=""3"" cols=""40""><%= H(Field(rec, ""interests"")) %></textarea></td></tr>" + NL
    t = t + "<tr><td valign=""top""><font size=""2"">Favorite Music:</font></td><td><textarea name=""music"" rows=""3"" cols=""40""><%= H(Field(rec, ""music"")) %></textarea></td></tr>" + NL
    t = t + "<tr><td valign=""top""><font size=""2"">About Me:</font></td><td><textarea name=""about"" rows=""5"" cols=""40""><%= H(Field(rec, ""about"")) %></textarea></td></tr>" + NL
    t = t + "<tr><td valign=""top""><font size=""2"">Picture:</font></td><td><input type=""file"" name=""pic"" size=""24""><br>" + NL
    t = t + "<font size=""1"" color=""#808080"">A .PIC file from Sketch, up to 200 by 200.</font>" + NL
    t = t + "<% IF HasPicture(viewer) THEN %><br><input type=""checkbox"" name=""nopic""> <font size=""2"">Remove my picture</font><% END IF %></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Save Changes""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "</form>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("EDIT.ASP")
END SUB

SUB File2 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' FRIEND.ASP - add or remove a friend. Friendship goes both ways at once." + NL
    t = t + "VAR who AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""home.asp"")" + NL
    t = t + "who = CleanName(REQUEST.Form(""u""))" + NL
    t = t + "IF NOT UserExists(who) THEN RESPONSE.Redirect(""people.asp"")" + NL
    t = t + "IF REQUEST.Form(""do"") = ""remove"" THEN" + NL
    t = t + "    RemoveFriend(viewer, who)" + NL
    t = t + "ELSE" + NL
    t = t + "    AddFriend(viewer, who)" + NL
    t = t + "END IF" + NL
    t = t + "RESPONSE.Redirect(""profile.asp?u="" + who)" + NL
    t = t + "%>" + NL
    Put("FRIEND.ASP")
END SUB

SUB File3 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' HOME.ASP - the News Feed: what you and your friends have been writing." + NL
    t = t + "VAR rec AS Array OF String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "rec = LoadUser(viewer)" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Home"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr>" + NL
    t = t + "<td width=""140"" valign=""top"" bgcolor=""#EDEFF4"">" + NL
    t = t + "<a href=""profile.asp?u=<%= viewer %>""><%= Picture(viewer) %></a><br>" + NL
    t = t + "<font size=""2""><b><%= H(Field(rec, ""name"")) %></b><br>" + NL
    t = t + "<a href=""profile.asp?u=<%= viewer %>"">My Profile</a><br>" + NL
    t = t + "<a href=""edit.asp"">Edit My Profile</a><br>" + NL
    t = t + "<a href=""profile.asp?u=<%= viewer %>#friends"">My Friends (<%= Friends(viewer).Count %>)</a><br>" + NL
    t = t + "<a href=""people.asp"">Find People</a></font>" + NL
    t = t + "</td>" + NL
    t = t + "<td valign=""top"">" + NL
    t = t + "<%= Notice(REQUEST.Query(""why"")) %>" + NL
    t = t + "<%= BoxTop(""What are you doing right now?"") %>" + NL
    t = t + "<form action=""post.asp"" method=""post"">" + NL
    t = t + "<input type=""hidden"" name=""to"" value=""<%= viewer %>"">" + NL
    t = t + "<input type=""hidden"" name=""back"" value=""home"">" + NL
    t = t + "<p><textarea name=""text"" rows=""3"" cols=""50""></textarea><br>" + NL
    t = t + "<input type=""submit"" value=""Share""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<%= BoxTop(""News Feed"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""5"" cellspacing=""2"">" + NL
    t = t + "<%= FeedHtml(viewer) %>" + NL
    t = t + "</table>" + NL
    t = t + "</td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("HOME.ASP")
END SUB

SUB File4 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' INDEX.ASP - the front door: sign in, or sign up. Members go straight to their feed." + NL
    t = t + "VAR problem AS String" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "IF viewer <> """" THEN RESPONSE.Redirect(""home.asp"")" + NL
    t = t + "SELECT CASE REQUEST.Query(""e"")" + NL
    t = t + "    CASE ""login""" + NL
    t = t + "        problem = ""That user name and password do not match.""" + NL
    t = t + "    CASE ""join""" + NL
    t = t + "        problem = REQUEST.Query(""why"")" + NL
    t = t + "    CASE ""bye""" + NL
    t = t + "        problem = ""You have logged out. See you soon.""" + NL
    t = t + "END SELECT" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Welcome"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""10"" cellspacing=""0""><tr>" + NL
    t = t + "<td width=""55%"" valign=""top"">" + NL
    t = t + "<h2><font color=""#3B5998"">Welcome to SimBook</font></h2>" + NL
    t = t + "<p>SimBook is an online directory that connects people on the SIM95 network.</p>" + NL
    t = t + "<p>You can use SimBook to:</p>" + NL
    t = t + "<ul>" + NL
    t = t + "<li>Look up people on the network</li>" + NL
    t = t + "<li>See who your friends are, and who their friends are</li>" + NL
    t = t + "<li>Write on your friends' Walls</li>" + NL
    t = t + "<li>Tell everybody what you are up to</li>" + NL
    t = t + "</ul>" + NL
    t = t + "<p><font size=""2"" color=""#808080"">Everything you write is kept on <%= H(SERVER.Name) %>'s" + NL
    t = t + "disk in C:\BOOKDATA, one plain text file at a time.</font></p>" + NL
    t = t + "</td>" + NL
    t = t + "<td width=""45%"" valign=""top"">" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<%= BoxTop(""Login"") %>" + NL
    t = t + "<form action=""login.asp"" method=""post"">" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td><font size=""2"">User name:</font></td><td><input name=""u"" size=""16""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Password:</font></td><td><input type=""password"" name=""pw"" size=""16""></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Login""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "</form>" + NL
    t = t + "<%= BoxTop(""Register"") %>" + NL
    t = t + "<form action=""join.asp"" method=""post"">" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td><font size=""2"">Full name:</font></td><td><input name=""name"" size=""20""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">User name:</font></td><td><input name=""u"" size=""16""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Password:</font></td><td><input type=""password"" name=""pw"" size=""16""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Again:</font></td><td><input type=""password"" name=""pw2"" size=""16""></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Register""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "<p><font size=""1"" color=""#808080"">User names are 3 to 8 letters or digits.</font></p>" + NL
    t = t + "</form>" + NL
    t = t + "</td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("INDEX.ASP")
END SUB

SUB File5 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' JOIN.ASP - makes a new account and signs it in." + NL
    t = t + "VAR u AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "u = REQUEST.Form(""u"").Trim().Lower()" + NL
    t = t + "IF REQUEST.Form(""pw"") <> REQUEST.Form(""pw2"") THEN" + NL
    t = t + "    problem = ""The two passwords are different.""" + NL
    t = t + "ELSE" + NL
    t = t + "    problem = CreateUser(u, REQUEST.Form(""pw""), REQUEST.Form(""name""))" + NL
    t = t + "END IF" + NL
    t = t + "IF problem <> """" THEN RESPONSE.Redirect(""index.asp?e=join&why="" + UrlEnc(problem))" + NL
    t = t + "SignIn(u)" + NL
    t = t + "RESPONSE.Redirect(""edit.asp?new=1"")" + NL
    t = t + "%>" + NL
    Put("JOIN.ASP")
END SUB

SUB File6 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' LOGIN.ASP - checks the password, hands out a session cookie, and moves on." + NL
    t = t + "VAR u AS String" + NL
    t = t + "u = CleanName(REQUEST.Form(""u""))" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "IF u = """" OR NOT CheckPassword(u, REQUEST.Form(""pw"")) THEN RESPONSE.Redirect(""index.asp?e=login"")" + NL
    t = t + "SignIn(u)" + NL
    t = t + "RESPONSE.Redirect(""home.asp"")" + NL
    t = t + "%>" + NL
    Put("LOGIN.ASP")
END SUB

SUB File7 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' LOGOUT.ASP - forgets the session on disk and in Voyager." + NL
    t = t + "SignOut()" + NL
    t = t + "RESPONSE.Redirect(""index.asp?e=bye"")" + NL
    t = t + "%>" + NL
    Put("LOGOUT.ASP")
END SUB

