' VAPOR|id=SIMBOOK|name=SimBook|kind=web|version=dec0db63|category=Social|run=/|files=C:\WEB\BOOK.SPK;C:\WEB\DELETE.ASP;C:\WEB\EDIT.ASP;C:\WEB\FRIEND.ASP;C:\WEB\HOME.ASP;C:\WEB\INDEX.ASP;C:\WEB\JOIN.ASP;C:\WEB\LOGIN.ASP;C:\WEB\LOGOUT.ASP;C:\WEB\NOPIC.PIC;C:\WEB\NOTIFY.ASP;C:\WEB\PEOPLE.ASP;C:\WEB\PHOTOS.ASP;C:\WEB\PICTURE.ASP;C:\WEB\POKE.ASP;C:\WEB\POST.ASP;C:\WEB\PROFILE.ASP;C:\WEB\REPLY.ASP;C:\WEB\SHRINK.SPK;C:\WEB\SIMBOOK.HTM;C:\WEB\VIEW.ASP;C:\WEB\VOTE.ASP|tasks=|startup=|folder=BOOK|about=The social network for the SIM95 network: profiles, friends, a news feed, walls, photos and pokes. Becomes this machine's home page, or on a SimHost machine gets a folder of its own.
' INSTALL.SPK - puts SimBook on this machine. Generated by tools/build-installer.mjs;
' edit the files in simbook/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. SimBook becomes
' this machine's home page: its pages go into C:\WEB, and the stock INDEX.HTM is
' moved aside to WELCOME.HTM, so the web server falls back to INDEX.ASP. It
' leaves C:\BOOKDATA (accounts, posts) alone, so running it again upgrades
' SimBook without losing anybody. Then open http://YOURNAME/ in Voyager.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)
    ' On a machine set up for several web apps (SimHost: C:\SYSTEM\WEBAPPS.INI
    ' says mode=folders), this one goes in C:\WEB\BOOK and leaves the home page alone.
    IF FS.Exists("C:\SYSTEM\WEBAPPS.INI") THEN
        IF FS.Read("C:\SYSTEM\WEBAPPS.INI").Contains("mode=folders") THEN intoDir = "BOOK"
    END IF
    IF intoDir <> "" AND NOT FS.Exists("C:\WEB\" + intoDir) THEN FS.MakeDir("C:\WEB\" + intoDir)
    IF NOT FS.Exists(Dest("C:\WEB\PICS")) THEN FS.MakeDir(Dest("C:\WEB\PICS"))

    IF intoDir = "" THEN MoveHomePage()
    Migrate()
    File0()
    File1()
    File2()
    File3()
    File4()
    File5()
    File6()
    File7()
    File8()
    File9()
    File10()
    File11()
    File12()
    File13()
    File14()
    File15()
    File16()
    File17()
    File18()
    File19()
    File20()
    File21()
    Print("SimBook is installed (22 files).")

    IF intoDir = "" THEN
        Print("Open http://" + NET.HostName.Lower() + "/ in Voyager.")
    ELSE
        Print("Open http://" + NET.HostName.Lower() + "/" + intoDir.Lower() + "/ in Voyager.")
    END IF
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "' BOOK.SPK - SimBook, a little social network for SIM95." + NL
    t = t + "' SimBook is the machine's home page: it lives in C:\WEB, and every page pulls this in with <%@ import file=""BOOK.SPK"" %>." + NL
    t = t + "'" + NL
    t = t + "' There is no database server: everything lives in plain text files under" + NL
    t = t + "' C:\BOOKDATA (outside C:\WEB, so the web server never hands it out), and every" + NL
    t = t + "' change is written to disk the moment it happens. Nothing is kept in memory" + NL
    t = t + "' between requests." + NL
    t = t + "'" + NL
    t = t + "'   C:\BOOKDATA\USERS\<user>.TXT    one profile, key=value per line" + NL
    t = t + "'   C:\BOOKDATA\FRIENDS\<user>.TXT  |ann|bob|cat|  (friendship is mutual)" + NL
    t = t + "'   C:\BOOKDATA\WALLS\<user>.TXT    every post on that user's wall, oldest first" + NL
    t = t + "'   C:\BOOKDATA\LOG\<n>.TXT         every post, LOGSIZE to a file: the feed reads these" + NL
    t = t + "'   C:\BOOKDATA\PEOPLE.TXT          user|name, one per member, for the directory" + NL
    t = t + "'   C:\BOOKDATA\SESSIONS\<id>.TXT   who a sign-in cookie belongs to, and its form token" + NL
    t = t + "'   C:\BOOKDATA\NEXTID.TXT          the last post number handed out (NEXTRID: replies)" + NL
    t = t + "'   C:\BOOKDATA\VOTES\<post>.TXT    |ann+|bob-|  thumbs up and down on one post" + NL
    t = t + "'   C:\BOOKDATA\REPLIES\<post>.TXT  replies to one post, one per line" + NL
    t = t + "'   C:\BOOKDATA\NOTES\<user>.TXT    their notifications (and .SEE: how far they read)" + NL
    t = t + "'   C:\BOOKDATA\POKES\<user>.TXT    |bob|cat|  who has poked them" + NL
    t = t + "'   C:\BOOKDATA\ALBUMS\<user>.TXT   |12|40|  which posts are their photos" + NL
    t = t + "'   C:\WEB\PICS\<user>.PIC          profile pictures (Sketch .PIC files)" + NL
    t = t + "'   C:\WEB\PHOTOS\<post>.PIC        photos" + NL
    t = t + "'" + NL
    t = t + "' A post is one line: id|date time|author|author name|wall|wall name|text" + NL
    t = t + "' Names and text are escaped with Esc so they never contain | or a line break." + NL
    t = t + "'" + NL
    t = t + "' A server page that runs too long is stopped, and the whole page is built" + NL
    t = t + "' before Voyager sees any of it, so loops here stay short: the feed and walls" + NL
    t = t + "' stop after a screenful, and the feed only looks back through recent posts." + NL
    t = t + "" + NL
    t = t + "CONST DATADIR = ""C:\BOOKDATA""" + NL
    t = t + "' Pictures and photos live beside the pages (C:\WEB\PICS, or C:\WEB\BOOK\PICS" + NL
    t = t + "' when SimBook is in a folder of its own), so the pages can link to them as pics/..." + NL
    t = t + "FUNCTION AppDir () AS String" + NL
    t = t + "    VAR page AS String" + NL
    t = t + "    page = SERVER.ScriptName" + NL
    t = t + "    RETURN page.Substring(0, page.Length - page.Split(""\"")[page.Split(""\"").Count - 1].Length - 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION PicDir () AS String" + NL
    t = t + "    RETURN AppDir() + ""\PICS""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION PhotoDir () AS String" + NL
    t = t + "    RETURN AppDir() + ""\PHOTOS""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "CONST COOKIE = ""simbook""" + NL
    t = t + "CONST FEEDSIZE = 25" + NL
    t = t + "CONST LOGSIZE = 500           ' posts to a log file; MIGRATE.SPK knows this too" + NL
    t = t + "CONST NOTEKEEP = 100          ' notifications kept per member" + NL
    t = t + "CONST NOTESHOW = 40           ' notifications shown at once" + NL
    t = t + "CONST MAXPOST = 1000" + NL
    t = t + "CONST MAXREPLY = 500" + NL
    t = t + "CONST FEEDREPLIES = 2         ' replies shown under a post in the feed and on Walls" + NL
    t = t + "CONST MAXNAME = 40" + NL
    t = t + "CONST SHORTFIELD = 60" + NL
    t = t + "CONST LONGFIELD = 500" + NL
    t = t + "CONST MAXPIC = 20000" + NL
    t = t + "CONST PICSIZE = 100" + NL
    t = t + "CONST MAXPHOTO = 45000" + NL
    t = t + "CONST PHOTOSIZE = 200" + NL
    t = t + "CONST MAXCAPTION = 200" + NL
    t = t + "CONST ALBUMSHOW = 20" + NL
    t = t + "CONST PAGEROOM = 20000        ' how much feed, Wall or replies one page may carry" + NL
    t = t + "" + NL
    t = t + "' HTTPD.SPK sends a whole page as one network message, and a message holds" + NL
    t = t + "' 64K: a bigger page would stop the web server. So names, profile fields and" + NL
    t = t + "' posts are capped, and the feed, Wall and directory stop well before that." + NL
    t = t + "" + NL
    t = t + "VAR viewer AS String          ' who is signed in; """" for nobody" + NL
    t = t + "VAR formToken AS String       ' their session's form token; see RequireToken" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the disk" + NL
    t = t + "" + NL
    t = t + "SUB EnsureDisk ()" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR dirs AS Array OF String" + NL
    t = t + "    dirs = ["""", ""\USERS"", ""\FRIENDS"", ""\WALLS"", ""\SESSIONS"", ""\VOTES"", ""\REPLIES"", ""\LOG"", ""\NOTES"", ""\POKES"", ""\ALBUMS""]" + NL
    t = t + "    FOR EACH dir IN dirs" + NL
    t = t + "        IF NOT FS.Exists(DATADIR + dir) THEN FS.MakeDir(DATADIR + dir)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT FS.Exists(PicDir()) THEN FS.MakeDir(PicDir())" + NL
    t = t + "    IF NOT FS.Exists(PhotoDir()) THEN FS.MakeDir(PhotoDir())" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Text that is safe inside one |-separated line, and back again." + NL
    t = t + "FUNCTION Esc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%"", ""%25"").Replace(""|"", ""%7C"").Replace(Chr(13), """").Replace(Chr(10), ""%0A"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unesc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%0A"", Chr(10)).Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Text that is safe inside a page; Br also keeps the line breaks." + NL
    t = t + "FUNCTION H (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.HtmlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Br (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.HtmlEncode(s).Replace(Chr(10), ""<br>"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UrlEnc (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.UrlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Only letters and digits are allowed in characters, so that a name or a session" + NL
    t = t + "' id from a visitor can never reach outside its folder." + NL
    t = t + "FUNCTION OnlyFrom (s AS String, allowed AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        IF NOT allowed.Contains(s.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A user name is also a file name, and file names here are 8.3." + NL
    t = t + "FUNCTION ValidName (u AS String) AS Bool" + NL
    t = t + "    IF u.Length < 3 OR u.Length > 8 THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyFrom(u, ""abcdefghijklmnopqrstuvwxyz0123456789"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CleanName (u AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = u.Trim().Lower()" + NL
    t = t + "    IF ValidName(s) THEN RETURN s" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- users" + NL
    t = t + "" + NL
    t = t + "FUNCTION UserPath (u AS String) AS String" + NL
    t = t + "    RETURN DATADIR + ""\USERS\"" + u + "".TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UserExists (u AS String) AS Bool" + NL
    t = t + "    IF NOT ValidName(u) THEN RETURN FALSE" + NL
    t = t + "    RETURN FS.Exists(UserPath(u))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A profile is the lines of its file; Field and SetField work on that array." + NL
    t = t + "FUNCTION LoadUser (u AS String) AS Array OF String" + NL
    t = t + "    RETURN FS.Read(UserPath(u)).Lines()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SaveUser (u AS String, rec AS Array OF String)" + NL
    t = t + "    FS.Write(UserPath(u), rec.Join(Chr(10)))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Field (rec AS Array OF String, key AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN rec" + NL
    t = t + "        IF line.StartsWith(key + ""="") THEN RETURN Unesc(line.Substring(key.Length + 1, line.Length - key.Length - 1))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SetField (rec AS Array OF String, key AS String, value AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO rec.Count - 1" + NL
    t = t + "        IF rec[i].StartsWith(key + ""="") THEN" + NL
    t = t + "            rec[i] = key + ""="" + Esc(value)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    rec.Add(key + ""="" + Esc(value))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION NameOf (u AS String) AS String" + NL
    t = t + "    RETURN Field(LoadUser(u), ""name"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Not real cryptography - SIM95 has none - but the password itself never" + NL
    t = t + "' touches the disk. Two running hashes over salt + password, kept under 2^31." + NL
    t = t + "FUNCTION Hash (salt AS String, pw AS String) AS String" + NL
    t = t + "    VAR a AS Integer = 7" + NL
    t = t + "    VAR b AS Integer = 31337" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = salt + "":"" + pw + "":"" + salt" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        c = Asc(s.CharAt(i))" + NL
    t = t + "        a = (a * 131 + c) MOD 2147483629" + NL
    t = t + "        b = (b * 257 + c + a) MOD 2147483587" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN Hex(a) + ""-"" + Hex(b)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NewToken () AS String" + NL
    t = t + "    RETURN Hex(268435456 + Rnd(1879048191))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Returns """" on success, otherwise what is wrong." + NL
    t = t + "FUNCTION CreateUser (u AS String, pw AS String, name AS String) AS String" + NL
    t = t + "    VAR rec AS Array OF String" + NL
    t = t + "    VAR salt AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    IF NOT ValidName(u) THEN RETURN ""Pick a user name of 3 to 8 letters or digits.""" + NL
    t = t + "    IF FS.Exists(UserPath(u)) THEN RETURN ""Somebody already has the name "" + u + "".""" + NL
    t = t + "    IF pw.Length < 4 THEN RETURN ""Pick a password of at least 4 characters.""" + NL
    t = t + "    name = Clip(name, MAXNAME)" + NL
    t = t + "    IF name = """" THEN RETURN ""Tell us your name.""" + NL
    t = t + "    salt = NewToken()" + NL
    t = t + "    SetField(rec, ""name"", name)" + NL
    t = t + "    SetField(rec, ""salt"", salt)" + NL
    t = t + "    SetField(rec, ""pass"", Hash(salt, pw))" + NL
    t = t + "    SetField(rec, ""joined"", TIME.Date)" + NL
    t = t + "    SaveUser(u, rec)" + NL
    t = t + "    FS.Write(DATADIR + ""\FRIENDS\"" + u + "".TXT"", ""|"")" + NL
    t = t + "    FS.Append(DATADIR + ""\PEOPLE.TXT"", u + ""|"" + Esc(name) + Chr(10))" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CheckPassword (u AS String, pw AS String) AS Bool" + NL
    t = t + "    VAR rec AS Array OF String" + NL
    t = t + "    IF NOT UserExists(u) THEN RETURN FALSE" + NL
    t = t + "    rec = LoadUser(u)" + NL
    t = t + "    RETURN Hash(Field(rec, ""salt""), pw) = Field(rec, ""pass"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Keep the member directory in step when someone changes their name." + NL
    t = t + "SUB RenamePerson (u AS String, name AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    lines = ReadOr(DATADIR + ""\PEOPLE.TXT"", """").Lines()" + NL
    t = t + "    FOR i = 0 TO lines.Count - 1" + NL
    t = t + "        IF lines[i].StartsWith(u + ""|"") THEN lines[i] = u + ""|"" + Esc(name)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Write(DATADIR + ""\PEOPLE.TXT"", lines.Join(Chr(10)))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION HasPicture (u AS String) AS Bool" + NL
    t = t + "    RETURN FS.Exists(PicDir() + ""\"" + u + "".PIC"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A picture is a SIM95PIC file: ""SIM95PIC width height"", then a row of hex digits" + NL
    t = t + "' per line. Returns """" when it will do, otherwise what is wrong with it." + NL
    t = t + "FUNCTION CheckPicture (pic AS String, most AS Integer, longest AS Integer) AS String" + NL
    t = t + "    VAR size AS Array OF String" + NL
    t = t + "    IF pic = """" THEN RETURN ""Choose a .PIC file first.""" + NL
    t = t + "    size = pic.Lines()[0].Trim().Split("" "")" + NL
    t = t + "    IF NOT pic.StartsWith(""SIM95PIC "") OR size.Count < 3 THEN RETURN ""That is not a picture. Save one from Sketch as a .PIC file.""" + NL
    t = t + "    IF pic.Length > longest OR Val(size[1]) > most OR Val(size[2]) > most THEN RETURN ""That picture is "" + size[1] + "" by "" + size[2] + "". Shrink it to "" + Str(most) + "" by "" + Str(most) + "" or less with SHRINK.SPK.""" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION SavePicture (u AS String, pic AS String) AS String" + NL
    t = t + "    VAR problem AS String" + NL
    t = t + "    problem = CheckPicture(pic, PICSIZE, MAXPIC)" + NL
    t = t + "    IF problem <> """" THEN RETURN problem" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    FS.Write(PicDir() + ""\"" + u + "".PIC"", pic)" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Text from a form, trimmed and cut to a length." + NL
    t = t + "FUNCTION Clip (s AS String, most AS Integer) AS String" + NL
    t = t + "    s = s.Replace(Chr(13), """").Trim()" + NL
    t = t + "    IF s.Length > most THEN s = s.Substring(0, most)" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- sessions" + NL
    t = t + "" + NL
    t = t + "' A session file holds two lines: who is signed in, and that session's form" + NL
    t = t + "' token. The cookie names the file." + NL
    t = t + "'" + NL
    t = t + "' The form token stops another site from acting in your name. Voyager sends" + NL
    t = t + "' your SimBook cookie with any request to this server, including one made by" + NL
    t = t + "' a form or link on somebody else's page, so the cookie alone proves nothing." + NL
    t = t + "' Every form and action link on SimBook carries the token as a field called t," + NL
    t = t + "' and every page that changes something checks it with RequireToken. Another" + NL
    t = t + "' site cannot read SimBook's pages, so it cannot know the token. Voyager sends" + NL
    t = t + "' no Referer header, so checking where a request came from is not an option." + NL
    t = t + "" + NL
    t = t + "SUB SignIn (u AS String)" + NL
    t = t + "    VAR token AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    token = NewToken()" + NL
    t = t + "    FS.Write(DATADIR + ""\SESSIONS\"" + token + "".TXT"", u + Chr(10) + NewToken() + NewToken())" + NL
    t = t + "    RESPONSE.SetCookie(COOKIE, token)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION SessionPath () AS String" + NL
    t = t + "    VAR token AS String" + NL
    t = t + "    token = REQUEST.Cookie(COOKIE)" + NL
    t = t + "    IF token = """" OR token.Length > 8 THEN RETURN """"" + NL
    t = t + "    IF NOT OnlyFrom(token, ""0123456789ABCDEF"") THEN RETURN """"" + NL
    t = t + "    RETURN DATADIR + ""\SESSIONS\"" + token + "".TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SignOut ()" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    path = SessionPath()" + NL
    t = t + "    IF path <> """" THEN" + NL
    t = t + "        IF FS.Exists(path) THEN FS.Delete(path)" + NL
    t = t + "    END IF" + NL
    t = t + "    RESPONSE.SetCookie(COOKIE, """")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Who the cookie says is signed in, or """". Also sets formToken." + NL
    t = t + "FUNCTION CurrentUser () AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR u AS String" + NL
    t = t + "    path = SessionPath()" + NL
    t = t + "    IF path = """" THEN RETURN """"" + NL
    t = t + "    IF NOT FS.Exists(path) THEN RETURN """"" + NL
    t = t + "    lines = FS.Read(path).Lines()" + NL
    t = t + "    u = lines[0].Trim()" + NL
    t = t + "    IF NOT UserExists(u) THEN RETURN """"" + NL
    t = t + "    ' A session from before form tokens existed gets one now" + NL
    t = t + "    IF lines.Count < 2 OR lines[lines.Count - 1].Trim().Length < 16 THEN" + NL
    t = t + "        FS.Write(path, u + Chr(10) + NewToken() + NewToken())" + NL
    t = t + "        lines = FS.Read(path).Lines()" + NL
    t = t + "    END IF" + NL
    t = t + "    formToken = lines[1].Trim()" + NL
    t = t + "    RETURN u" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The first line of every members-only page." + NL
    t = t + "SUB RequireLogin ()" + NL
    t = t + "    viewer = CurrentUser()" + NL
    t = t + "    IF viewer = """" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The second line of every page that changes something: the request must carry" + NL
    t = t + "' this session's token, in the form (POST) or the link (GET). Anything else is" + NL
    t = t + "' sent home, untouched." + NL
    t = t + "SUB RequireToken ()" + NL
    t = t + "    VAR sent AS String" + NL
    t = t + "    sent = REQUEST.Form(""t"")" + NL
    t = t + "    IF sent = """" THEN sent = REQUEST.Query(""t"")" + NL
    t = t + "    IF sent = """" OR sent <> formToken THEN RESPONSE.Redirect(""home.asp?why="" + UrlEnc(""That did not come from a SimBook page, so nothing was changed.""))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The token as a hidden form field, and as a link parameter." + NL
    t = t + "FUNCTION TokenField () AS String" + NL
    t = t + "    RETURN ""<input type=""""hidden"""" name=""""t"""" value="""""" + formToken + """""">""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION TokenArg () AS String" + NL
    t = t + "    RETURN ""t="" + formToken" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- friends" + NL
    t = t + "" + NL
    t = t + "FUNCTION FriendList (u AS String) AS String" + NL
    t = t + "    RETURN ReadOr(DATADIR + ""\FRIENDS\"" + u + "".TXT"", ""|"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsFriend (a AS String, b AS String) AS Bool" + NL
    t = t + "    RETURN FriendList(a).Contains(""|"" + b + ""|"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Friends (u AS String) AS Array OF String" + NL
    t = t + "    VAR all AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    all = FriendList(u).Split(""|"")" + NL
    t = t + "    FOR EACH f IN all" + NL
    t = t + "        IF f <> """" THEN out.Add(f)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB AddFriend (a AS String, b AS String)" + NL
    t = t + "    IF a = b OR IsFriend(a, b) THEN RETURN" + NL
    t = t + "    FS.Write(DATADIR + ""\FRIENDS\"" + a + "".TXT"", FriendList(a) + b + ""|"")" + NL
    t = t + "    FS.Write(DATADIR + ""\FRIENDS\"" + b + "".TXT"", FriendList(b) + a + ""|"")" + NL
    t = t + "    Notify(b, ""friend"", """")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RemoveFriend (a AS String, b AS String)" + NL
    t = t + "    FS.Write(DATADIR + ""\FRIENDS\"" + a + "".TXT"", FriendList(a).Replace(""|"" + b + ""|"", ""|""))" + NL
    t = t + "    FS.Write(DATADIR + ""\FRIENDS\"" + b + "".TXT"", FriendList(b).Replace(""|"" + a + ""|"", ""|""))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- numbers" + NL
    t = t + "" + NL
    t = t + "' A counter kept in C:\BOOKDATA\<name>.TXT: posts use NEXTID, replies NEXTRID," + NL
    t = t + "' and each one only ever goes up." + NL
    t = t + "FUNCTION Counter (name AS String) AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    n = Int(Val(ReadOr(DATADIR + ""\"" + name + "".TXT"", ""0""))) + 1" + NL
    t = t + "    FS.Write(DATADIR + ""\"" + name + "".TXT"", Str(n))" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The line in text (lines of ""key|..."") that starts with key, or """". IndexOf does" + NL
    t = t + "' the searching, so this costs a handful of steps however long the text is." + NL
    t = t + "FUNCTION FindLine (text AS String, key AS String) AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    text = Chr(10) + text" + NL
    t = t + "    at = text.IndexOf(Chr(10) + key + ""|"")" + NL
    t = t + "    IF at < 0 THEN RETURN """"" + NL
    t = t + "    text = text.Substring(at + 1, text.Length - at - 1)" + NL
    t = t + "    at = text.IndexOf(Chr(10))" + NL
    t = t + "    IF at >= 0 THEN text = text.Substring(0, at)" + NL
    t = t + "    RETURN text" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' text without the whole line given. The line breaks around it make sure a" + NL
    t = t + "' line that merely ends the same way is left alone." + NL
    t = t + "FUNCTION WithoutLine (text AS String, line AS String) AS String" + NL
    t = t + "    text = (Chr(10) + text).Replace(Chr(10) + line + Chr(10), Chr(10))" + NL
    t = t + "    RETURN text.Substring(1, text.Length - 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsNumber (s AS String) AS Bool" + NL
    t = t + "    IF s = """" OR s.Length > 8 THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyFrom(s, ""0123456789"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the post log" + NL
    t = t + "" + NL
    t = t + "' Every post is in the log, in chunks of LOGSIZE: post n lives in" + NL
    t = t + "' C:\BOOKDATA\LOG\<(n - 1) / LOGSIZE>.TXT. Finding a post reads one small" + NL
    t = t + "' file, and writing one rewrites only the newest chunk, however big SimBook" + NL
    t = t + "' grows. The feed reads the newest two chunks." + NL
    t = t + "" + NL
    t = t + "FUNCTION ChunkPath (id AS Integer) AS String" + NL
    t = t + "    RETURN DATADIR + ""\LOG\"" + Str(Int((id - 1) / LOGSIZE)) + "".TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LastId () AS Integer" + NL
    t = t + "    RETURN Int(Val(ReadOr(DATADIR + ""\NEXTID.TXT"", ""0"")))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The newest posts, oldest first: between LOGSIZE and twice that many." + NL
    t = t + "FUNCTION RecentPosts () AS Array OF String" + NL
    t = t + "    VAR last AS Integer" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    last = LastId()" + NL
    t = t + "    IF last = 0 THEN RETURN """".Lines()" + NL
    t = t + "    text = ReadOr(ChunkPath(last), """")" + NL
    t = t + "    IF last > LOGSIZE THEN text = ReadOr(ChunkPath(last - LOGSIZE), """") + text" + NL
    t = t + "    RETURN text.Lines()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The line of post number id, or """" when there is none." + NL
    t = t + "FUNCTION FindPost (id AS String) AS String" + NL
    t = t + "    IF NOT IsNumber(id) THEN RETURN """"" + NL
    t = t + "    RETURN FindLine(ReadOr(ChunkPath(Int(Val(id))), """"), id)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Writes a post into the log and onto the Wall, and returns its number." + NL
    t = t + "FUNCTION WritePost (author AS String, wall AS String, text AS String) AS Integer" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    id = Counter(""NEXTID"")" + NL
    t = t + "    line = Str(id) + ""|"" + Stamp() + ""|"" + author + ""|"" + Esc(NameOf(author)) + ""|"" + wall + ""|"" + Esc(NameOf(wall)) + ""|"" + Esc(text)" + NL
    t = t + "    FS.Append(ChunkPath(id), line + Chr(10))" + NL
    t = t + "    FS.Append(DATADIR + ""\WALLS\"" + wall + "".TXT"", line + Chr(10))" + NL
    t = t + "    RETURN id" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Stamp () AS String" + NL
    t = t + "    RETURN TIME.Date + "" "" + TIME.Clock.Substring(0, 5)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Write on someone's Wall (your own Wall is your status). Returns """" or a problem." + NL
    t = t + "FUNCTION AddPost (author AS String, wall AS String, text AS String) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    text = text.Replace(Chr(13), """").Trim()" + NL
    t = t + "    IF text = """" THEN RETURN ""Write something first.""" + NL
    t = t + "    IF text.Length > MAXPOST THEN RETURN ""Keep it under "" + Str(MAXPOST) + "" characters.""" + NL
    t = t + "    IF NOT UserExists(wall) THEN RETURN ""There is nobody called "" + wall + "".""" + NL
    t = t + "    IF author <> wall AND NOT IsFriend(author, wall) THEN RETURN ""Only friends can write on "" + wall + ""'s Wall.""" + NL
    t = t + "    id = WritePost(author, wall, text)" + NL
    t = t + "    Notify(wall, ""wall"", Str(id))" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Who may give a post a thumb or a reply: the people whose News Feed it reaches." + NL
    t = t + "' That is its author and the owner of its Wall, and their friends." + NL
    t = t + "FUNCTION CanTalk (u AS String, line AS String) AS Bool" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    IF p.Count < 7 THEN RETURN FALSE" + NL
    t = t + "    IF u = p[2] OR u = p[4] THEN RETURN TRUE" + NL
    t = t + "    RETURN IsFriend(u, p[2]) OR IsFriend(u, p[4])" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A post can be deleted by whoever wrote it and by the owner of its Wall." + NL
    t = t + "FUNCTION CanDelete (u AS String, line AS String) AS Bool" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    IF p.Count < 7 THEN RETURN FALSE" + NL
    t = t + "    RETURN u = p[2] OR u = p[4]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Takes a post out of the log and off its Wall, with its thumbs, replies and photo." + NL
    t = t + "SUB DeletePost (line AS String)" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    path = ChunkPath(Int(Val(p[0])))" + NL
    t = t + "    FS.Write(path, WithoutLine(FS.Read(path), line))" + NL
    t = t + "    path = DATADIR + ""\WALLS\"" + p[4] + "".TXT""" + NL
    t = t + "    IF FS.Exists(path) THEN FS.Write(path, WithoutLine(FS.Read(path), line))" + NL
    t = t + "    path = DATADIR + ""\VOTES\"" + p[0] + "".TXT""" + NL
    t = t + "    IF FS.Exists(path) THEN FS.Delete(path)" + NL
    t = t + "    path = DATADIR + ""\REPLIES\"" + p[0] + "".TXT""" + NL
    t = t + "    IF FS.Exists(path) THEN FS.Delete(path)" + NL
    t = t + "    IF IsPhoto(p[0]) THEN" + NL
    t = t + "        FS.Delete(PhotoDir() + ""\"" + p[0] + "".PIC"")" + NL
    t = t + "        path = DATADIR + ""\ALBUMS\"" + p[2] + "".TXT""" + NL
    t = t + "        IF FS.Exists(path) THEN FS.Write(path, FS.Read(path).Replace(""|"" + p[0] + ""|"", ""|""))" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- thumbs" + NL
    t = t + "" + NL
    t = t + "FUNCTION VotesOf (id AS String) AS String" + NL
    t = t + "    RETURN ReadOr(DATADIR + ""\VOTES\"" + id + "".TXT"", ""|"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' How many ""+"" or ""-"" votes a |ann+|bob-| list holds." + NL
    t = t + "FUNCTION CountVotes (votes AS String, sign AS String) AS Integer" + NL
    t = t + "    RETURN (votes.Length - votes.Replace(sign + ""|"", """").Length) / 2" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Thumbs up (""+"") or down (""-"") on a post. The same thumb again takes it back." + NL
    t = t + "SUB Vote (u AS String, line AS String, sign AS String)" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR votes AS String" + NL
    t = t + "    VAR had AS Bool" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    id = line.Split(""|"")[0]" + NL
    t = t + "    votes = VotesOf(id)" + NL
    t = t + "    had = votes.Contains(""|"" + u + sign + ""|"")" + NL
    t = t + "    votes = votes.Replace(""|"" + u + ""+|"", ""|"").Replace(""|"" + u + ""-|"", ""|"")" + NL
    t = t + "    IF NOT had THEN" + NL
    t = t + "        votes = votes + u + sign + ""|""" + NL
    t = t + "        IF sign = ""+"" THEN Notify(line.Split(""|"")[2], ""up"", id)" + NL
    t = t + "        IF sign = ""-"" THEN Notify(line.Split(""|"")[2], ""down"", id)" + NL
    t = t + "    END IF" + NL
    t = t + "    FS.Write(DATADIR + ""\VOTES\"" + id + "".TXT"", votes)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- replies" + NL
    t = t + "" + NL
    t = t + "' A reply is one line of C:\BOOKDATA\REPLIES\<post>.TXT:" + NL
    t = t + "'   reply number|date time|author|author name|text" + NL
    t = t + "" + NL
    t = t + "FUNCTION AddReply (u AS String, id AS String, text AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    line = FindPost(id)" + NL
    t = t + "    text = text.Replace(Chr(13), """").Trim()" + NL
    t = t + "    IF line = """" THEN RETURN ""That post is gone.""" + NL
    t = t + "    IF NOT CanTalk(u, line) THEN RETURN ""Only friends can reply to that.""" + NL
    t = t + "    IF text = """" THEN RETURN ""Write something first.""" + NL
    t = t + "    IF text.Length > MAXREPLY THEN RETURN ""Keep replies under "" + Str(MAXREPLY) + "" characters.""" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    FS.Append(DATADIR + ""\REPLIES\"" + id + "".TXT"", Str(Counter(""NEXTRID"")) + ""|"" + Stamp() + ""|"" + u + ""|"" + Esc(NameOf(u)) + ""|"" + Esc(text) + Chr(10))" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    Notify(p[2], ""reply"", id)" + NL
    t = t + "    IF p[4] <> p[2] THEN Notify(p[4], ""wallreply"", id)" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Replies (id AS String) AS Array OF String" + NL
    t = t + "    VAR all AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    all = ReadOr(DATADIR + ""\REPLIES\"" + id + "".TXT"", """").Lines()" + NL
    t = t + "    FOR EACH line IN all" + NL
    t = t + "        IF line <> """" THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION FindReply (id AS String, rid AS String) AS String" + NL
    t = t + "    IF NOT IsNumber(rid) THEN RETURN """"" + NL
    t = t + "    RETURN FindLine(ReadOr(DATADIR + ""\REPLIES\"" + id + "".TXT"", """"), rid)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A reply can be deleted by whoever wrote it and by the owner of the post's Wall." + NL
    t = t + "FUNCTION CanDeleteReply (u AS String, post AS String, reply AS String) AS Bool" + NL
    t = t + "    RETURN u = reply.Split(""|"")[2] OR u = post.Split(""|"")[4]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB DeleteReply (id AS String, reply AS String)" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    path = DATADIR + ""\REPLIES\"" + id + "".TXT""" + NL
    t = t + "    FS.Write(path, WithoutLine(FS.Read(path), reply))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReplyHtml (line AS String, post AS String) AS String" + NL
    t = t + "    VAR r AS Array OF String" + NL
    t = t + "    VAR del AS String" + NL
    t = t + "    r = line.Split(""|"")" + NL
    t = t + "    IF r.Count < 5 THEN RETURN """"" + NL
    t = t + "    IF CanDeleteReply(viewer, post, line) THEN del = "" <font size=""""1""""><a href=""""delete.asp?id="" + post.Split(""|"")[0] + ""&r="" + r[0] + """""">delete</a></font>""" + NL
    t = t + "    RETURN ""<tr><td width=""""16""""></td><td bgcolor=""""#EDEFF4""""><font size=""""2""""><a href=""""profile.asp?u="" + r[2] + """"""><b>"" + H(Unesc(r[3])) + ""</b></a> <font color=""""#808080"""">"" + r[1] + ""</font>"" + del + ""<br>"" + Br(Unesc(r[4])) + ""</font></td></tr>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The newest replies to a post that fit in room characters, oldest first, with a" + NL
    t = t + "' link to the rest. most = 0 means as many as fit." + NL
    t = t + "FUNCTION RepliesHtml (post AS String, all AS Array OF String, most AS Integer, room AS Integer) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR shown AS Integer" + NL
    t = t + "    IF all.Count = 0 THEN RETURN """"" + NL
    t = t + "    FOR i = all.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF most > 0 AND shown >= most THEN BREAK" + NL
    t = t + "        IF out.Length > room THEN BREAK" + NL
    t = t + "        out = ReplyHtml(all[i], post) + out" + NL
    t = t + "        shown = shown + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF shown < all.Count THEN" + NL
    t = t + "        out = ""<tr><td width=""""16""""></td><td><font size=""""1""""><a href=""""view.asp?id="" + post.Split(""|"")[0] + """""">See all "" + Str(all.Count) + "" replies</a></font></td></tr>"" + out" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""3"""" cellspacing=""""1"""">"" + out + ""</table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- notifications" + NL
    t = t + "" + NL
    t = t + "' C:\BOOKDATA\NOTES\<user>.TXT holds the newest NOTEKEEP of them, one per line:" + NL
    t = t + "'   number|date time|kind|who|their name|post number" + NL
    t = t + "' and <user>.SEE the number of the last one they have looked at. Kinds: wall," + NL
    t = t + "' reply, wallreply, up, down, poke, friend. The one acting is always the viewer." + NL
    t = t + "" + NL
    t = t + "FUNCTION LastNote (lines AS Array OF String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = lines.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF lines[i] <> """" THEN RETURN Int(Val(lines[i].Split(""|"")[0]))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NoteLines (u AS String) AS Array OF String" + NL
    t = t + "    RETURN ReadOr(DATADIR + ""\NOTES\"" + u + "".TXT"", """").Lines()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Notify (u AS String, kind AS String, ref AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR keep AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF u = viewer OR NOT UserExists(u) THEN RETURN" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    lines = NoteLines(u)" + NL
    t = t + "    FOR i = 0 TO lines.Count - 1" + NL
    t = t + "        IF lines[i] <> """" AND i >= lines.Count - NOTEKEEP THEN keep.Add(lines[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    keep.Add(Str(LastNote(lines) + 1) + ""|"" + Stamp() + ""|"" + kind + ""|"" + viewer + ""|"" + Esc(NameOf(viewer)) + ""|"" + ref)" + NL
    t = t + "    FS.Write(DATADIR + ""\NOTES\"" + u + "".TXT"", keep.Join(Chr(10)) + Chr(10))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION SeenNote (u AS String) AS Integer" + NL
    t = t + "    RETURN Int(Val(ReadOr(DATADIR + ""\NOTES\"" + u + "".SEE"", ""0"")))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unread (u AS String) AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    n = LastNote(NoteLines(u)) - SeenNote(u)" + NL
    t = t + "    IF n < 0 THEN RETURN 0" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB MarkSeen (u AS String)" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    FS.Write(DATADIR + ""\NOTES\"" + u + "".SEE"", Str(LastNote(NoteLines(u))))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION NoteHtml (line AS String, fresh AS Bool) AS String" + NL
    t = t + "    VAR n AS Array OF String" + NL
    t = t + "    VAR who AS String" + NL
    t = t + "    VAR what AS String" + NL
    t = t + "    VAR post AS String" + NL
    t = t + "    n = line.Split(""|"")" + NL
    t = t + "    IF n.Count < 6 THEN RETURN """"" + NL
    t = t + "    who = ""<a href=""""profile.asp?u="" + n[3] + """"""><b>"" + H(Unesc(n[4])) + ""</b></a>""" + NL
    t = t + "    post = ""<a href=""""view.asp?id="" + n[5] + """""">""" + NL
    t = t + "    SELECT CASE n[2]" + NL
    t = t + "        CASE ""wall""" + NL
    t = t + "            what = who + "" wrote on your "" + post + ""Wall</a>.""" + NL
    t = t + "        CASE ""reply""" + NL
    t = t + "            what = who + "" replied to "" + post + ""your post</a>.""" + NL
    t = t + "        CASE ""wallreply""" + NL
    t = t + "            what = who + "" replied to "" + post + ""a post on your Wall</a>.""" + NL
    t = t + "        CASE ""up""" + NL
    t = t + "            what = who + "" gave "" + post + ""your post</a> a thumbs up.""" + NL
    t = t + "        CASE ""down""" + NL
    t = t + "            what = who + "" gave "" + post + ""your post</a> a thumbs down.""" + NL
    t = t + "        CASE ""poke""" + NL
    t = t + "            what = who + "" poked you. <a href=""""home.asp"""">Poke back?</a>""" + NL
    t = t + "        CASE ""friend""" + NL
    t = t + "            what = who + "" added you as a friend.""" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            RETURN """"" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF fresh THEN RETURN ""<tr><td bgcolor=""""#FFF9D7""""><font size=""""2"""">"" + what + "" <font color=""""#808080"""">"" + n[1] + ""</font></font></td></tr>""" + NL
    t = t + "    RETURN ""<tr><td><font size=""""2"""">"" + what + "" <font color=""""#808080"""">"" + n[1] + ""</font></font></td></tr>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- pokes" + NL
    t = t + "" + NL
    t = t + "' C:\BOOKDATA\POKES\<user>.TXT: |bob|cat| - who has poked them and not been" + NL
    t = t + "' poked back or brushed off yet." + NL
    t = t + "" + NL
    t = t + "FUNCTION PokesOf (u AS String) AS String" + NL
    t = t + "    RETURN ReadOr(DATADIR + ""\POKES\"" + u + "".TXT"", ""|"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Returns """" or why not. Poking someone back also clears their poke." + NL
    t = t + "FUNCTION Poke (u AS String, target AS String) AS String" + NL
    t = t + "    IF NOT UserExists(target) OR target = u THEN RETURN ""You cannot poke that.""" + NL
    t = t + "    IF NOT IsFriend(u, target) THEN RETURN ""You can only poke your friends.""" + NL
    t = t + "    IF PokesOf(target).Contains(""|"" + u + ""|"") THEN RETURN ""You have already poked "" + NameOf(target) + "". Wait for them to poke back.""" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    FS.Write(DATADIR + ""\POKES\"" + target + "".TXT"", PokesOf(target) + u + ""|"")" + NL
    t = t + "    ClearPoke(u, target)" + NL
    t = t + "    Notify(target, ""poke"", """")" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB ClearPoke (u AS String, from AS String)" + NL
    t = t + "    IF PokesOf(u).Contains(""|"" + from + ""|"") THEN FS.Write(DATADIR + ""\POKES\"" + u + "".TXT"", PokesOf(u).Replace(""|"" + from + ""|"", ""|""))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- photos" + NL
    t = t + "" + NL
    t = t + "' A photo is a post on its owner's own Wall with a picture beside it in" + NL
    t = t + "' C:\WEB\PHOTOS\<post>.PIC, so it gets thumbs, replies and the feed for free." + NL
    t = t + "' C:\BOOKDATA\ALBUMS\<user>.TXT lists their photos: |12|40|" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsPhoto (id AS String) AS Bool" + NL
    t = t + "    RETURN FS.Exists(PhotoDir() + ""\"" + id + "".PIC"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Album (u AS String) AS Array OF String" + NL
    t = t + "    VAR all AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    all = ReadOr(DATADIR + ""\ALBUMS\"" + u + "".TXT"", ""|"").Split(""|"")" + NL
    t = t + "    FOR EACH id IN all" + NL
    t = t + "        IF id <> """" THEN out.Add(id)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION AddPhoto (u AS String, pic AS String, caption AS String) AS String" + NL
    t = t + "    VAR problem AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    caption = caption.Replace(Chr(13), """").Trim()" + NL
    t = t + "    IF caption.Length > MAXCAPTION THEN RETURN ""Keep the caption under "" + Str(MAXCAPTION) + "" characters.""" + NL
    t = t + "    problem = CheckPicture(pic, PHOTOSIZE, MAXPHOTO)" + NL
    t = t + "    IF problem <> """" THEN RETURN problem" + NL
    t = t + "    id = WritePost(u, u, caption)" + NL
    t = t + "    FS.Write(PhotoDir() + ""\"" + Str(id) + "".PIC"", pic)" + NL
    t = t + "    FS.Write(DATADIR + ""\ALBUMS\"" + u + "".TXT"", ReadOr(DATADIR + ""\ALBUMS\"" + u + "".TXT"", ""|"") + Str(id) + ""|"")" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- showing posts" + NL
    t = t + "" + NL
    t = t + "' Thumbs, reply and delete links under a post. back says where a thumb returns" + NL
    t = t + "' to: ""home"", ""view"", or the user whose Wall it is on." + NL
    t = t + "FUNCTION ActionsHtml (line AS String, back AS String, replies AS Integer) AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR votes AS String" + NL
    t = t + "    VAR up AS String" + NL
    t = t + "    VAR down AS String" + NL
    t = t + "    VAR del AS String" + NL
    t = t + "    id = line.Split(""|"")[0]" + NL
    t = t + "    votes = VotesOf(id)" + NL
    t = t + "    up = ""thumbs up ("" + Str(CountVotes(votes, ""+"")) + "")""" + NL
    t = t + "    down = ""thumbs down ("" + Str(CountVotes(votes, ""-"")) + "")""" + NL
    t = t + "    IF votes.Contains(""|"" + viewer + ""+|"") THEN up = ""<b>"" + up + ""</b>""" + NL
    t = t + "    IF votes.Contains(""|"" + viewer + ""-|"") THEN down = ""<b>"" + down + ""</b>""" + NL
    t = t + "    IF CanDelete(viewer, line) THEN del = "" &middot; <a href=""""delete.asp?id="" + id + """""">delete</a>""" + NL
    t = t + "    IF NOT CanTalk(viewer, line) THEN" + NL
    t = t + "        RETURN ""<font size=""""1"""" color=""""#808080"""">"" + up + "" &middot; "" + down + "" &middot; <a href=""""view.asp?id="" + id + """""">"" + Str(replies) + "" replies</a></font>""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN ""<font size=""""1""""><a href=""""vote.asp?id="" + id + ""&v=up&b="" + back + ""&"" + TokenArg() + """""">"" + up + ""</a> &middot; "" _" + NL
    t = t + "         + ""<a href=""""vote.asp?id="" + id + ""&v=down&b="" + back + ""&"" + TokenArg() + """""">"" + down + ""</a> &middot; "" _" + NL
    t = t + "         + ""<a href=""""view.asp?id="" + id + """""">reply</a>"" + del + ""</font>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One post as a row of the feed or a Wall, with its photo, thumbs and newest" + NL
    t = t + "' replies. onWall leaves out the Wall it is on; most is how many replies to" + NL
    t = t + "' show (0 = all that fit)." + NL
    t = t + "FUNCTION PostHtml (line AS String, onWall AS Bool, back AS String, most AS Integer) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR who AS String" + NL
    t = t + "    VAR body AS String" + NL
    t = t + "    VAR all AS Array OF String" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    IF p.Count < 7 THEN RETURN """"" + NL
    t = t + "    who = ""<a href=""""profile.asp?u="" + p[2] + """"""><b>"" + H(Unesc(p[3])) + ""</b></a>""" + NL
    t = t + "    IF p[2] <> p[4] AND NOT onWall THEN" + NL
    t = t + "        who = who + "" &raquo; <a href=""""profile.asp?u="" + p[4] + """"""><b>"" + H(Unesc(p[5])) + ""</b></a>""" + NL
    t = t + "    END IF" + NL
    t = t + "    body = Br(Unesc(p[6]))" + NL
    t = t + "    IF IsPhoto(p[0]) THEN" + NL
    t = t + "        who = who + "" added a photo""" + NL
    t = t + "        body = ""<a href=""""view.asp?id="" + p[0] + """"""><img src=""""photos/"" + p[0] + "".pic"""" alt=""""photo""""></a><br>"" + body" + NL
    t = t + "    END IF" + NL
    t = t + "    all = Replies(p[0])" + NL
    t = t + "    RETURN ""<tr><td bgcolor=""""#F7F7F7""""><font size=""""2"""">"" + who + "" <a href=""""view.asp?id="" + p[0] + """"""><font color=""""#808080"""">"" + p[1] + ""</font></a><br>"" _" + NL
    t = t + "         + body + ""</font><br>"" + ActionsHtml(line, back, all.Count) _" + NL
    t = t + "         + RepliesHtml(line, all, most, PAGEROOM) + ""</td></tr>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The newest posts on one wall." + NL
    t = t + "FUNCTION WallHtml (u AS String) AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR shown AS Integer" + NL
    t = t + "    lines = ReadOr(DATADIR + ""\WALLS\"" + u + "".TXT"", """").Lines()" + NL
    t = t + "    FOR i = lines.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF lines[i] <> """" THEN" + NL
    t = t + "            out = out + PostHtml(lines[i], TRUE, u, FEEDREPLIES)" + NL
    t = t + "            shown = shown + 1" + NL
    t = t + "            IF shown >= FEEDSIZE OR out.Length > PAGEROOM THEN BREAK" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF out = """" THEN RETURN ""<tr><td><font size=""""2"""" color=""""#808080"""">Nothing on the Wall yet.</font></td></tr>""" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The News Feed: what you and your friends wrote, or what was written to you or them." + NL
    t = t + "FUNCTION FeedHtml (u AS String) AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR circle AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR shown AS Integer" + NL
    t = t + "    circle = FriendList(u) + u + ""|""" + NL
    t = t + "    lines = RecentPosts()" + NL
    t = t + "    FOR i = lines.Count - 1 TO 0 STEP -1" + NL
    t = t + "        p = lines[i].Split(""|"")" + NL
    t = t + "        IF p.Count >= 7 THEN" + NL
    t = t + "            IF circle.Contains(""|"" + p[2] + ""|"") OR circle.Contains(""|"" + p[4] + ""|"") THEN" + NL
    t = t + "                out = out + PostHtml(lines[i], FALSE, ""home"", FEEDREPLIES)" + NL
    t = t + "                shown = shown + 1" + NL
    t = t + "                IF shown >= FEEDSIZE OR out.Length > PAGEROOM THEN BREAK" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF out = """" THEN RETURN ""<tr><td><font size=""""2"""" color=""""#808080"""">Nothing here yet. Write something above, or find some <a href=""""people.asp"""">people</a> to be friends with.</font></td></tr>""" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- page furniture" + NL
    t = t + "" + NL
    t = t + "FUNCTION Top (title AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = ""<html><head><title>"" + H(title) + "" - SimBook</title></head>"" _" + NL
    t = t + "      + ""<body bgcolor=""""#FFFFFF"""" text=""""#000000"""" link=""""#3B5998"""" vlink=""""#3B5998"""">"" _" + NL
    t = t + "      + ""<table width=""""100%"""" cellpadding=""""6"""" cellspacing=""""0"""" bgcolor=""""#3B5998""""><tr>"" _" + NL
    t = t + "      + ""<td><a href=""""index.asp""""><font color=""""#FFFFFF"""" size=""""5""""><b>[simbook]</b></font></a></td>"" _" + NL
    t = t + "      + ""<td align=""""right""""><font color=""""#FFFFFF"""" size=""""2"""">""" + NL
    t = t + "    IF viewer <> """" THEN" + NL
    t = t + "        s = s + ""<a href=""""home.asp""""><font color=""""#FFFFFF"""">home</font></a> | "" _" + NL
    t = t + "              + NotesLink() + "" | "" _" + NL
    t = t + "              + ""<a href=""""profile.asp?u="" + viewer + """"""><font color=""""#FFFFFF"""">profile</font></a> | "" _" + NL
    t = t + "              + ""<a href=""""people.asp""""><font color=""""#FFFFFF"""">people</font></a> | "" _" + NL
    t = t + "              + ""<a href=""""edit.asp""""><font color=""""#FFFFFF"""">edit</font></a> | "" _" + NL
    t = t + "              + ""<a href=""""logout.asp?"" + TokenArg() + """"""><font color=""""#FFFFFF"""">logout</font></a>""" + NL
    t = t + "    ELSE" + NL
    t = t + "        s = s + ""<a href=""""index.asp""""><font color=""""#FFFFFF"""">login</font></a> | <a href=""""index.asp""""><font color=""""#FFFFFF"""">register</font></a>""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN s + ""</font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NotesLink () AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    n = Unread(viewer)" + NL
    t = t + "    IF n > 0 THEN RETURN ""<a href=""""notify.asp""""><font color=""""#FFFF00""""><b>notifications ("" + Str(n) + "")</b></font></a>""" + NL
    t = t + "    RETURN ""<a href=""""notify.asp""""><font color=""""#FFFFFF"""">notifications</font></a>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Bottom () AS String" + NL
    t = t + "    RETURN ""<hr><center><font size=""""1"""" color=""""#808080"""">SimBook on "" + H(SERVER.Name) + "" &middot; "" + TIME.Date + "" &middot; <a href=""""simbook.htm"""">About SimBook</a></font></center></body></html>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A titled box, the way every section of a profile is drawn." + NL
    t = t + "FUNCTION BoxTop (title AS String) AS String" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""3"""" cellspacing=""""0""""><tr><td bgcolor=""""#6D84B4""""><font color=""""#FFFFFF"""" size=""""2""""><b>"" + title + ""</b></font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Notice (text AS String) AS String" + NL
    t = t + "    IF text = """" THEN RETURN """"" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""4""""><tr><td bgcolor=""""#FFF9D7""""><font size=""""2"""">"" + H(text) + ""</font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One <option> of a <select>, chosen when it is the current value." + NL
    t = t + "FUNCTION Opt (value AS String, current AS String) AS String" + NL
    t = t + "    IF value = current THEN RETURN ""<option selected>"" + H(value) + ""</option>""" + NL
    t = t + "    RETURN ""<option>"" + H(value) + ""</option>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A text box that counts down as you type, and the page script that does the" + NL
    t = t + "' counting. Voyager sends a whole form as one 64K message and a text area has no" + NL
    t = t + "' maxlength, so this greys out the form's button (id=""go"") while any box on the" + NL
    t = t + "' page holds more than it may. The server checks again anyway." + NL
    t = t + "FUNCTION LimitedBox (name AS String, value AS String, rows AS Integer, cols AS Integer, most AS Integer) AS String" + NL
    t = t + "    RETURN ""<textarea name="""""" + name + """""" id="""""" + name + """""" rows="""""" + Str(rows) + """""" cols="""""" + Str(cols) + """""" onchange=""""Limits_Check"""">"" + H(value) + ""</textarea><br>"" _" + NL
    t = t + "         + ""<font size=""""1"""" color=""""#808080"""" id="""""" + name + ""_n"""">up to "" + Str(most) + "" characters</font>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' names and limits are comma-separated and in step: ""about,music"", ""500,500""." + NL
    t = t + "FUNCTION LimitScript (names AS String, limits AS String) AS String" + NL
    t = t + "    RETURN ""<script type=""""spark"""">"" + Chr(10) _" + NL
    t = t + "         + ""SUB Limits_Check ()"" + Chr(10) _" + NL
    t = t + "         + ""    VAR names AS Array OF String"" + Chr(10) _" + NL
    t = t + "         + ""    VAR limits AS Array OF String"" + Chr(10) _" + NL
    t = t + "         + ""    VAR i AS Integer"" + Chr(10) _" + NL
    t = t + "         + ""    VAR n AS Integer"" + Chr(10) _" + NL
    t = t + "         + ""    VAR most AS Integer"" + Chr(10) _" + NL
    t = t + "         + ""    VAR fits AS Bool = TRUE"" + Chr(10) _" + NL
    t = t + "         + ""    names = """""" + names + """""".Split("""","""")"" + Chr(10) _" + NL
    t = t + "         + ""    limits = """""" + limits + """""".Split("""","""")"" + Chr(10) _" + NL
    t = t + "         + ""    FOR i = 0 TO names.Count - 1"" + Chr(10) _" + NL
    t = t + "         + ""        n = PAGE.Get(names[i]).Value.Length"" + Chr(10) _" + NL
    t = t + "         + ""        most = Int(Val(limits[i]))"" + Chr(10) _" + NL
    t = t + "         + ""        IF n > most THEN"" + Chr(10) _" + NL
    t = t + "         + ""            PAGE.Get(names[i] + """"_n"""").Text = Str(n - most) + """" characters too many"""""" + Chr(10) _" + NL
    t = t + "         + ""            fits = FALSE"" + Chr(10) _" + NL
    t = t + "         + ""        ELSE"" + Chr(10) _" + NL
    t = t + "         + ""            PAGE.Get(names[i] + """"_n"""").Text = Str(most - n) + """" characters left"""""" + Chr(10) _" + NL
    t = t + "         + ""        END IF"" + Chr(10) _" + NL
    t = t + "         + ""    NEXT"" + Chr(10) _" + NL
    t = t + "         + ""    PAGE.Get(""""go"""").Enabled = fits"" + Chr(10) _" + NL
    t = t + "         + ""END SUB"" + Chr(10) _" + NL
    t = t + "         + ""</script>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Picture (u AS String) AS String" + NL
    t = t + "    IF HasPicture(u) THEN RETURN ""<img src=""""pics/"" + u + "".pic"""" alt="""""" + u + """""">""" + NL
    t = t + "    RETURN ""<img src=""""nopic.pic"""" alt=""""no picture"""">""" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\WEB\BOOK.SPK")
END SUB

SUB File1 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' DELETE.ASP?id=N[&r=R] - asks ""are you sure?"" about a post, or one reply to it" + NL
    t = t + "' (GET), and deletes it (POST, with the form token). The author can delete, and" + NL
    t = t + "' so can the owner of the Wall it is on." + NL
    t = t + "VAR id AS String" + NL
    t = t + "VAR rid AS String" + NL
    t = t + "VAR post AS String" + NL
    t = t + "VAR reply AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    RequireToken()" + NL
    t = t + "    id = REQUEST.Form(""id"")" + NL
    t = t + "    rid = REQUEST.Form(""r"")" + NL
    t = t + "ELSE" + NL
    t = t + "    id = REQUEST.Query(""id"")" + NL
    t = t + "    rid = REQUEST.Query(""r"")" + NL
    t = t + "END IF" + NL
    t = t + "post = FindPost(id)" + NL
    t = t + "IF post = """" THEN RESPONSE.Redirect(""home.asp"")" + NL
    t = t + "IF rid <> """" THEN" + NL
    t = t + "    reply = FindReply(id, rid)" + NL
    t = t + "    IF reply = """" OR NOT CanDeleteReply(viewer, post, reply) THEN RESPONSE.Redirect(""view.asp?id="" + id)" + NL
    t = t + "ELSEIF NOT CanDelete(viewer, post) THEN" + NL
    t = t + "    RESPONSE.Redirect(""view.asp?id="" + id)" + NL
    t = t + "END IF" + NL
    t = t + "" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    IF rid <> """" THEN" + NL
    t = t + "        DeleteReply(id, reply)" + NL
    t = t + "        RESPONSE.Redirect(""view.asp?id="" + id)" + NL
    t = t + "    END IF" + NL
    t = t + "    DeletePost(post)" + NL
    t = t + "    RESPONSE.Redirect(""profile.asp?u="" + post.Split(""|"")[4] + ""&why="" + UrlEnc(""The post was deleted.""))" + NL
    t = t + "END IF" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Delete"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<% IF rid <> """" THEN %>" + NL
    t = t + "<%= BoxTop(""Delete this reply?"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""5"" cellspacing=""2""><%= ReplyHtml(reply, post) %></table>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<%= BoxTop(""Delete this post?"") %>" + NL
    t = t + "<p><font size=""2"">Its thumbs and replies go with it<% IF IsPhoto(id) THEN %>, and so does the photo<% END IF %>. There is no undo.</font></p>" + NL
    t = t + "<table width=""100%"" cellpadding=""5"" cellspacing=""2""><%= PostHtml(post, FALSE, ""view"", 2) %></table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<form action=""delete.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<input type=""hidden"" name=""id"" value=""<%= id %>"">" + NL
    t = t + "<input type=""hidden"" name=""r"" value=""<%= rid %>"">" + NL
    t = t + "<p><input type=""submit"" value=""Delete""> <a href=""view.asp?id=<%= id %>"">Cancel</a></p>" + NL
    t = t + "</form>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\DELETE.ASP")
END SUB

SUB File2 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' EDIT.ASP - change your profile. GET shows the form; POST saves it." + NL
    t = t + "' The picture has its own page, PICTURE.ASP." + NL
    t = t + "VAR rec AS Array OF String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR key AS String" + NL
    t = t + "VAR keys AS Array OF String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "rec = LoadUser(viewer)" + NL
    t = t + "" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    RequireToken()" + NL
    t = t + "    IF REQUEST.Form(""name"").Trim() = """" THEN" + NL
    t = t + "        problem = ""Your name cannot be empty.""" + NL
    t = t + "    ELSE" + NL
    t = t + "        ' Short fields and long ones; Clip keeps every page under the 64K a message can carry." + NL
    t = t + "        keys = [""sex"", ""birthday"", ""hometown"", ""status""]" + NL
    t = t + "        FOR EACH key IN keys" + NL
    t = t + "            SetField(rec, key, Clip(REQUEST.Form(key), SHORTFIELD))" + NL
    t = t + "        NEXT" + NL
    t = t + "        keys = [""interests"", ""music"", ""about""]" + NL
    t = t + "        FOR EACH key IN keys" + NL
    t = t + "            SetField(rec, key, Clip(REQUEST.Form(key), LONGFIELD))" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF Clip(REQUEST.Form(""name""), MAXNAME) <> Field(rec, ""name"") THEN" + NL
    t = t + "            SetField(rec, ""name"", Clip(REQUEST.Form(""name""), MAXNAME))" + NL
    t = t + "            RenamePerson(viewer, Clip(REQUEST.Form(""name""), MAXNAME))" + NL
    t = t + "        END IF" + NL
    t = t + "        SaveUser(viewer, rec)" + NL
    t = t + "        RESPONSE.Redirect(""profile.asp?u="" + viewer)" + NL
    t = t + "    END IF" + NL
    t = t + "END IF" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Edit My Profile"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<% IF REQUEST.Query(""new"") = ""1"" THEN %>" + NL
    t = t + "<%= Notice(""Welcome to SimBook! Tell people a little about yourself, then go find your friends."") %>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<%= BoxTop(""Edit My Profile"") %>" + NL
    t = t + "<form action=""edit.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<table cellpadding=""4"">" + NL
    t = t + "<tr><td><font size=""2"">Name:</font></td><td><input name=""name"" size=""30"" maxlength=""<%= MAXNAME %>"" value=""<%= H(Field(rec, ""name"")) %>""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Sex:</font></td><td><select name=""sex""><%= Opt("""", Field(rec, ""sex"")) %><%= Opt(""Female"", Field(rec, ""sex"")) %><%= Opt(""Male"", Field(rec, ""sex"")) %></select></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Birthday:</font></td><td><input name=""birthday"" size=""20"" maxlength=""<%= SHORTFIELD %>"" value=""<%= H(Field(rec, ""birthday"")) %>""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Hometown:</font></td><td><input name=""hometown"" size=""30"" maxlength=""<%= SHORTFIELD %>"" value=""<%= H(Field(rec, ""hometown"")) %>""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Relationship:</font></td><td><select name=""status""><%= Opt("""", Field(rec, ""status"")) %><%= Opt(""Single"", Field(rec, ""status"")) %><%= Opt(""In a Relationship"", Field(rec, ""status"")) %><%= Opt(""Married"", Field(rec, ""status"")) %><%= Opt(""It's Complicated"", Field(rec, ""status"")) %></select></td></tr>" + NL
    t = t + "<tr><td valign=""top""><font size=""2"">Interests:</font></td><td><%= LimitedBox(""interests"", Field(rec, ""interests""), 3, 40, LONGFIELD) %></td></tr>" + NL
    t = t + "<tr><td valign=""top""><font size=""2"">Favorite Music:</font></td><td><%= LimitedBox(""music"", Field(rec, ""music""), 3, 40, LONGFIELD) %></td></tr>" + NL
    t = t + "<tr><td valign=""top""><font size=""2"">About Me:</font></td><td><%= LimitedBox(""about"", Field(rec, ""about""), 5, 40, LONGFIELD) %></td></tr>" + NL
    t = t + "<tr><td valign=""top""><font size=""2"">Picture:</font></td><td><font size=""2""><a href=""picture.asp"">Change my picture</a></font></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" id=""go"" value=""Save Changes""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "</form>" + NL
    t = t + "<%= LimitScript(""interests,music,about"", Str(LONGFIELD) + "","" + Str(LONGFIELD) + "","" + Str(LONGFIELD)) %>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\EDIT.ASP")
END SUB

SUB File3 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' FRIEND.ASP - add or remove a friend. Friendship goes both ways at once." + NL
    t = t + "VAR who AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""home.asp"")" + NL
    t = t + "who = CleanName(REQUEST.Form(""u""))" + NL
    t = t + "IF NOT UserExists(who) THEN RESPONSE.Redirect(""people.asp"")" + NL
    t = t + "IF REQUEST.Form(""do"") = ""remove"" THEN" + NL
    t = t + "    RemoveFriend(viewer, who)" + NL
    t = t + "ELSE" + NL
    t = t + "    AddFriend(viewer, who)" + NL
    t = t + "END IF" + NL
    t = t + "RESPONSE.Redirect(""profile.asp?u="" + who)" + NL
    t = t + "%>" + NL
    Put("C:\WEB\FRIEND.ASP")
END SUB

SUB File4 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' HOME.ASP - the News Feed: what you and your friends have been writing." + NL
    t = t + "VAR rec AS Array OF String" + NL
    t = t + "VAR pokers AS Array OF String" + NL
    t = t + "VAR who AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "rec = LoadUser(viewer)" + NL
    t = t + "pokers = PokesOf(viewer).Split(""|"")" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Home"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr>" + NL
    t = t + "<td width=""140"" valign=""top"" bgcolor=""#EDEFF4"">" + NL
    t = t + "<a href=""profile.asp?u=<%= viewer %>""><%= Picture(viewer) %></a><br>" + NL
    t = t + "<font size=""2""><b><%= H(Field(rec, ""name"")) %></b><br>" + NL
    t = t + "<a href=""profile.asp?u=<%= viewer %>"">My Profile</a><br>" + NL
    t = t + "<a href=""edit.asp"">Edit My Profile</a><br>" + NL
    t = t + "<a href=""picture.asp"">Change My Picture</a><br>" + NL
    t = t + "<a href=""photos.asp?u=<%= viewer %>"">My Photos</a><br>" + NL
    t = t + "<a href=""profile.asp?u=<%= viewer %>#friends"">My Friends (<%= Friends(viewer).Count %>)</a><br>" + NL
    t = t + "<a href=""people.asp"">Find People</a></font>" + NL
    t = t + "</td>" + NL
    t = t + "<td valign=""top"">" + NL
    t = t + "<%= Notice(REQUEST.Query(""why"")) %>" + NL
    t = t + "<% IF PokesOf(viewer) <> ""|"" THEN %>" + NL
    t = t + "<%= BoxTop(""Pokes"") %>" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<% FOR EACH who IN pokers" + NL
    t = t + "     IF who = """" OR NOT UserExists(who) THEN CONTINUE %>" + NL
    t = t + "<tr><td><font size=""2""><a href=""profile.asp?u=<%= who %>""><b><%= H(NameOf(who)) %></b></a> poked you." + NL
    t = t + "<a href=""poke.asp?u=<%= who %>&do=poke&<%= TokenArg() %>"">poke back</a> &middot;" + NL
    t = t + "<a href=""poke.asp?u=<%= who %>&do=clear&<%= TokenArg() %>"">remove</a></font></td></tr>" + NL
    t = t + "<% NEXT %>" + NL
    t = t + "</table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= BoxTop(""What are you doing right now?"") %>" + NL
    t = t + "<form action=""post.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<input type=""hidden"" name=""to"" value=""<%= viewer %>"">" + NL
    t = t + "<input type=""hidden"" name=""back"" value=""home"">" + NL
    t = t + "<p><%= LimitedBox(""text"", """", 3, 50, MAXPOST) %><br>" + NL
    t = t + "<input type=""submit"" id=""go"" value=""Share""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<%= LimitScript(""text"", Str(MAXPOST)) %>" + NL
    t = t + "<%= BoxTop(""News Feed"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""5"" cellspacing=""2"">" + NL
    t = t + "<%= FeedHtml(viewer) %>" + NL
    t = t + "</table>" + NL
    t = t + "</td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\HOME.ASP")
END SUB

SUB File5 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' INDEX.ASP - the front door: sign in, or sign up. Members go straight to their feed." + NL
    t = t + "VAR problem AS String" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "IF viewer <> """" THEN RESPONSE.Redirect(""home.asp"")" + NL
    t = t + "SELECT CASE REQUEST.Query(""e"")" + NL
    t = t + "    CASE ""login""" + NL
    t = t + "        problem = ""That user name and password do not match.""" + NL
    t = t + "    CASE ""join""" + NL
    t = t + "        problem = REQUEST.Query(""why"")" + NL
    t = t + "    CASE ""bye""" + NL
    t = t + "        problem = ""You have logged out. See you soon.""" + NL
    t = t + "END SELECT" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Welcome"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""10"" cellspacing=""0""><tr>" + NL
    t = t + "<td width=""55%"" valign=""top"">" + NL
    t = t + "<h2><font color=""#3B5998"">Welcome to SimBook</font></h2>" + NL
    t = t + "<p>SimBook is an online directory that connects people on the SIM95 network.</p>" + NL
    t = t + "<p>You can use SimBook to:</p>" + NL
    t = t + "<ul>" + NL
    t = t + "<li>Look up people on the network</li>" + NL
    t = t + "<li>See who your friends are, and who their friends are</li>" + NL
    t = t + "<li>Write on your friends' Walls</li>" + NL
    t = t + "<li>Tell everybody what you are up to</li>" + NL
    t = t + "</ul>" + NL
    t = t + "<p><font size=""2"" color=""#808080"">Everything you write is kept on <%= H(SERVER.Name) %>'s" + NL
    t = t + "disk in C:\BOOKDATA, one plain text file at a time.</font></p>" + NL
    t = t + "</td>" + NL
    t = t + "<td width=""45%"" valign=""top"">" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<%= BoxTop(""Login"") %>" + NL
    t = t + "<form action=""login.asp"" method=""post"">" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td><font size=""2"">User name:</font></td><td><input name=""u"" size=""16""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Password:</font></td><td><input type=""password"" name=""pw"" size=""16""></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Login""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "</form>" + NL
    t = t + "<%= BoxTop(""Register"") %>" + NL
    t = t + "<form action=""join.asp"" method=""post"">" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td><font size=""2"">Full name:</font></td><td><input name=""name"" size=""20""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">User name:</font></td><td><input name=""u"" size=""16""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Password:</font></td><td><input type=""password"" name=""pw"" size=""16""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Again:</font></td><td><input type=""password"" name=""pw2"" size=""16""></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Register""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "<p><font size=""1"" color=""#808080"">User names are 3 to 8 letters or digits.</font></p>" + NL
    t = t + "</form>" + NL
    t = t + "</td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\INDEX.ASP")
END SUB

SUB File6 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' JOIN.ASP - makes a new account and signs it in." + NL
    t = t + "VAR u AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "u = REQUEST.Form(""u"").Trim().Lower()" + NL
    t = t + "IF REQUEST.Form(""pw"") <> REQUEST.Form(""pw2"") THEN" + NL
    t = t + "    problem = ""The two passwords are different.""" + NL
    t = t + "ELSE" + NL
    t = t + "    problem = CreateUser(u, REQUEST.Form(""pw""), REQUEST.Form(""name""))" + NL
    t = t + "END IF" + NL
    t = t + "IF problem <> """" THEN RESPONSE.Redirect(""index.asp?e=join&why="" + UrlEnc(problem))" + NL
    t = t + "SignIn(u)" + NL
    t = t + "RESPONSE.Redirect(""edit.asp?new=1"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\JOIN.ASP")
END SUB

SUB File7 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' LOGIN.ASP - checks the password, hands out a session cookie, and moves on." + NL
    t = t + "VAR u AS String" + NL
    t = t + "u = CleanName(REQUEST.Form(""u""))" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "IF u = """" OR NOT CheckPassword(u, REQUEST.Form(""pw"")) THEN RESPONSE.Redirect(""index.asp?e=login"")" + NL
    t = t + "SignIn(u)" + NL
    t = t + "RESPONSE.Redirect(""home.asp"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\LOGIN.ASP")
END SUB

SUB File8 ()
    t = ""
    t = t + "<%@ import file=""BOOK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' LOGOUT.ASP?t=token - forgets the session on disk and in Voyager. The token" + NL
    t = t + "' stops another site from signing you out." + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "SignOut()" + NL
    t = t + "RESPONSE.Redirect(""index.asp?e=bye"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\LOGOUT.ASP")
END SUB

