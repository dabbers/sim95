' VAPOR|id=SIMPLAYR|name=SimPlayer|kind=program|version=e95e5825|category=Multimedia|run=C:\PROGRAMS\PLAYER.SPK|files=C:\PROGRAMS\PLAYER.SPK|tasks=PLAYER|startup=|folder=|about=The movie player for SIM95: plays SimMovies from the disk or streams them from the web, like the ones on SimTube. (Simxplorer has it built in.)
' INSTALL.SPK - puts SimPlayer on this machine. Generated by tools/build-installer.mjs;
' edit the files in simplayer/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It writes
' SimPlayer, the movie player, to C:\PROGRAMS\PLAYER.SPK and starts it. It plays
' SimMovies (.SMV) from the disk, or streams them from a web address such as
' a SimTube movie's. Simxplorer has SimPlayer built in; this is the same
' player on its own, for Voyager users and for movies on the disk.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)




    File0()
    Print("SimPlayer is installed (1 files).")
    SYS.Start("C:\PROGRAMS\PLAYER.SPK", "")

    Print("SimPlayer is running. Next time, start C:\PROGRAMS\PLAYER.SPK from Files, or give it a movie's address.")
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "' PLAYER.SPK - SimPlayer, the movie player for SIM95. Plays SimMovies (.SMV)" + NL
    t = t + "' from this disk or from the web, such as the ones on SimTube." + NL
    t = t + "'" + NL
    t = t + "'   SPARK C:\PROGRAMS\PLAYER.SPK C:\MYFILES\DANCE.SMV" + NL
    t = t + "'   SPARK C:\PROGRAMS\PLAYER.SPK http://alpha/tube/movie.asp?v=2" + NL
    t = t + "'" + NL
    t = t + "' A SimMovie is text: a header, then one line per frame of drawing commands" + NL
    t = t + "' for a GUI_Canvas (see simtube/README.md). A long one is cut into parts of" + NL
    t = t + "' about 15K, each small enough for one network message, and a manifest" + NL
    t = t + "' (it starts ""SIMMOVIE-PARTS 1"") says where the parts are. SimPlayer fetches" + NL
    t = t + "' the parts one at a time and starts playing as soon as it has a few seconds" + NL
    t = t + "' in hand, like the streaming players do." + NL
    t = t + "'" + NL
    t = t + "' Fetches go one at a time and start in a timer tick of their own, inside a" + NL
    t = t + "' TRY with an empty CATCH (see SIM95-NOTES.md); pages come in through the" + NL
    t = t + "' socket's events. Playback runs off a second timer and SYS.Ticks, so a movie" + NL
    t = t + "' plays at its own speed whatever the timer manages." + NL
    t = t + "'" + NL
    t = t + "' A movie can be at a SimDNS name (http://movies.coolsite.sim/...): the name" + NL
    t = t + "' is asked about first, in a tick of its own, with the resolver's Rs..." + NL
    t = t + "' names. On its own, SimPlayer has simweb/src/RESOLVE.SPK joined on the end;" + NL
    t = t + "' built into Simxplorer it shares the browser's (tools/simxplorer-source.mjs)." + NL
    t = t + "' The request still says Host: movies.coolsite.sim." + NL
    t = t + "'" + NL
    t = t + "' For the curious (and for tests): the window's Tag says what is going on," + NL
    t = t + "'   state|frame|frames|loaded|parts in|parts|loop|mute" + NL
    t = t + "" + NL
    t = t + "CONST AHEAD = 3             ' seconds of movie in hand before playing" + NL
    t = t + "CONST PATIENCE = 8000       ' ms to wait for a web server" + NL
    t = t + "CONST MAXTRIES = 3" + NL
    t = t + "CONST MINW = 336" + NL
    t = t + "" + NL
    t = t + "VAR EOL AS String" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR bar AS GUI_Menu" + NL
    t = t + "VAR addrLabel AS GUI_Label" + NL
    t = t + "VAR addr AS GUI_TextBox" + NL
    t = t + "VAR openBtn AS GUI_Button" + NL
    t = t + "VAR screen AS GUI_Canvas" + NL
    t = t + "VAR info AS GUI_Label" + NL
    t = t + "VAR seekBar AS GUI_Canvas" + NL
    t = t + "VAR playBtn AS GUI_Button" + NL
    t = t + "VAR stopBtn AS GUI_Button" + NL
    t = t + "VAR rewBtn AS GUI_Button" + NL
    t = t + "VAR backBtn AS GUI_Button" + NL
    t = t + "VAR fwdBtn AS GUI_Button" + NL
    t = t + "VAR loopBox AS GUI_CheckBox" + NL
    t = t + "VAR muteBox AS GUI_CheckBox" + NL
    t = t + "VAR timeLabel AS GUI_Label" + NL
    t = t + "VAR ticker AS GUI_Timer" + NL
    t = t + "VAR fetcher AS GUI_Timer" + NL
    t = t + "VAR web AS NET_Socket" + NL
    t = t + "" + NL
    t = t + "' the movie" + NL
    t = t + "VAR source AS String          ' the file or URL it came from" + NL
    t = t + "VAR mTitle AS String" + NL
    t = t + "VAR mAuthor AS String" + NL
    t = t + "VAR mW AS Integer = 160" + NL
    t = t + "VAR mH AS Integer = 120" + NL
    t = t + "VAR mFps AS Integer = 10" + NL
    t = t + "VAR mFrames AS Integer        ' as the header says; the frames themselves win once all are in" + NL
    t = t + "VAR mBg AS Integer" + NL
    t = t + "VAR frames AS Array OF String" + NL
    t = t + "VAR picNames AS Array OF String" + NL
    t = t + "VAR picData AS Array OF String" + NL
    t = t + "VAR partRefs AS Array OF String" + NL
    t = t + "VAR partsIn AS Integer" + NL
    t = t + "VAR allIn AS Bool" + NL
    t = t + "VAR remote AS Bool" + NL
    t = t + "VAR gotHeader AS Bool" + NL
    t = t + "" + NL
    t = t + "' playing" + NL
    t = t + "VAR state AS String = ""empty""   ' empty, buffering, playing, paused, stopped, ended, error" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR cur AS Integer = -1         ' the frame on the screen" + NL
    t = t + "VAR wantPlay AS Bool" + NL
    t = t + "VAR t0 AS Integer               ' SYS.Ticks when frame f0 was due" + NL
    t = t + "VAR f0 AS Integer" + NL
    t = t + "VAR dragging AS Bool" + NL
    t = t + "VAR drawing AS Bool" + NL
    t = t + "" + NL
    t = t + "' one fetch at a time" + NL
    t = t + "VAR fetching AS Bool" + NL
    t = t + "VAR fFirst AS Bool              ' the first thing at the address (a movie or a manifest)" + NL
    t = t + "VAR fUrl AS String" + NL
    t = t + "VAR fNumber AS Integer" + NL
    t = t + "VAR fParts AS Array OF String" + NL
    t = t + "VAR fDone AS Bool" + NL
    t = t + "VAR fSince AS Integer" + NL
    t = t + "VAR fError AS String" + NL
    t = t + "VAR wantFirst AS Bool" + NL
    t = t + "VAR tries AS Integer" + NL
    t = t + "VAR inside AS Bool              ' a window of Simxplorer's, not a program of its own" + NL
    t = t + "VAR isOpen AS Bool" + NL
    t = t + "" + NL
    t = t + "' ================================================================ start" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    IF SYS.Args.Count > 0 THEN" + NL
    t = t + "        OpenPlayer(SYS.Args[0], FALSE)" + NL
    t = t + "    ELSE" + NL
    t = t + "        OpenPlayer("""", FALSE)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Opens the player and the movie at where (if any). Simxplorer has this same" + NL
    t = t + "' player built in (tools/build-installer.mjs renames everything Mv...) and" + NL
    t = t + "' calls it with embedded = TRUE: then it is one of the browser's windows, and" + NL
    t = t + "' closing it closes only the window. Opening another movie reuses the window." + NL
    t = t + "SUB OpenPlayer (where AS String, embedded AS Bool)" + NL
    t = t + "    IF isOpen THEN" + NL
    t = t + "        win.Show()" + NL
    t = t + "        win.Focus()" + NL
    t = t + "        IF where <> """" THEN" + NL
    t = t + "            addr.Text = where" + NL
    t = t + "            OpenMovie(where)" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    inside = embedded" + NL
    t = t + "    isOpen = TRUE" + NL
    t = t + "    EOL = Chr(10)" + NL
    t = t + "    win = GUI_Window.New(""SimPlayer"", MINW, 260)" + NL
    t = t + "    win.Icon = ""app""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    win.onKey = Player_OnKey" + NL
    t = t + "    bar = GUI_Menu.New(win)" + NL
    t = t + "    bar.onSelect = Menu_OnSelect" + NL
    t = t + "    bar.AddMenu(""&File"")" + NL
    t = t + "    bar.AddItem(""&File"", ""&Open File..."" + Chr(9) + ""Ctrl+O"")" + NL
    t = t + "    bar.AddItem(""&File"", ""Open &URL..."" + Chr(9) + ""Ctrl+L"")" + NL
    t = t + "    bar.AddSeparator(""&File"")" + NL
    t = t + "    IF inside THEN" + NL
    t = t + "        bar.AddItem(""&File"", ""&Close"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        bar.AddItem(""&File"", ""E&xit"")" + NL
    t = t + "    END IF" + NL
    t = t + "    bar.AddMenu(""&Play"")" + NL
    t = t + "    bar.AddItem(""&Play"", ""&Play/Pause"" + Chr(9) + ""Space"")" + NL
    t = t + "    bar.AddItem(""&Play"", ""&Stop"")" + NL
    t = t + "    bar.AddItem(""&Play"", ""&Rewind"" + Chr(9) + ""Home"")" + NL
    t = t + "    bar.AddItem(""&Play"", ""Step &Forward"" + Chr(9) + ""ArrowRight"")" + NL
    t = t + "    bar.AddItem(""&Play"", ""Step &Back"" + Chr(9) + ""ArrowLeft"")" + NL
    t = t + "    bar.AddSeparator(""&Play"")" + NL
    t = t + "    bar.AddItem(""&Play"", ""&Loop"")" + NL
    t = t + "    bar.AddItem(""&Play"", ""&Mute"")" + NL
    t = t + "    bar.AddMenu(""&Help"")" + NL
    t = t + "    bar.AddItem(""&Help"", ""&About SimPlayer"")" + NL
    t = t + "" + NL
    t = t + "    addrLabel = GUI_Label.New(win)" + NL
    t = t + "    addrLabel.Text = ""Address:""" + NL
    t = t + "    addr = GUI_TextBox.New(win)" + NL
    t = t + "    addr.onEnter = Open_Click" + NL
    t = t + "    openBtn = GUI_Button.New(win)" + NL
    t = t + "    openBtn.Text = ""&Open""" + NL
    t = t + "    openBtn.onClick = Open_Click" + NL
    t = t + "    screen = GUI_Canvas.New(win)" + NL
    t = t + "    screen.onDraw = Screen_OnDraw" + NL
    t = t + "    screen.onKey = Player_OnKey" + NL
    t = t + "    screen.onMouseDown = Screen_OnMouseDown" + NL
    t = t + "    info = GUI_Label.New(win)" + NL
    t = t + "    info.Bold = TRUE" + NL
    t = t + "    seekBar = GUI_Canvas.New(win)" + NL
    t = t + "    seekBar.onDraw = Seek_OnDraw" + NL
    t = t + "    seekBar.onMouseDown = Seek_OnMouseDown" + NL
    t = t + "    seekBar.onMouseMove = Seek_OnMouseMove" + NL
    t = t + "    seekBar.onMouseUp = Seek_OnMouseUp" + NL
    t = t + "    playBtn = GUI_Button.New(win)" + NL
    t = t + "    playBtn.Text = ""&Play""" + NL
    t = t + "    playBtn.onClick = Play_Click" + NL
    t = t + "    stopBtn = GUI_Button.New(win)" + NL
    t = t + "    stopBtn.Text = ""&Stop""" + NL
    t = t + "    stopBtn.onClick = Stop_Click" + NL
    t = t + "    rewBtn = GUI_Button.New(win)" + NL
    t = t + "    rewBtn.Text = ""Re&wind""" + NL
    t = t + "    rewBtn.onClick = Rewind_Click" + NL
    t = t + "    backBtn = GUI_Button.New(win)" + NL
    t = t + "    backBtn.Text = ""<""" + NL
    t = t + "    backBtn.onClick = Back_Click" + NL
    t = t + "    fwdBtn = GUI_Button.New(win)" + NL
    t = t + "    fwdBtn.Text = "">""" + NL
    t = t + "    fwdBtn.onClick = Fwd_Click" + NL
    t = t + "    loopBox = GUI_CheckBox.New(win)" + NL
    t = t + "    loopBox.Text = ""&Loop""" + NL
    t = t + "    loopBox.onChange = Loop_Change" + NL
    t = t + "    muteBox = GUI_CheckBox.New(win)" + NL
    t = t + "    muteBox.Text = ""&Mute""" + NL
    t = t + "    muteBox.onChange = Mute_Change" + NL
    t = t + "    timeLabel = GUI_Label.New(win)" + NL
    t = t + "    timeLabel.Align = ""right""" + NL
    t = t + "" + NL
    t = t + "    web = NET_Socket.New()" + NL
    t = t + "    web.onMessage = Web_OnMessage" + NL
    t = t + "    web.onClose = Web_OnClose" + NL
    t = t + "    ticker = GUI_Timer.New(win)" + NL
    t = t + "    ticker.Interval = 50" + NL
    t = t + "    ticker.onTick = Ticker_OnTick" + NL
    t = t + "    ticker.Start()" + NL
    t = t + "    fetcher = GUI_Timer.New(win)" + NL
    t = t + "    fetcher.Interval = 100" + NL
    t = t + "    fetcher.onTick = Fetcher_OnTick" + NL
    t = t + "    fetcher.Start()" + NL
    t = t + "" + NL
    t = t + "    Layout()" + NL
    t = t + "    win.Show()" + NL
    t = t + "    Splash()" + NL
    t = t + "    Refresh()" + NL
    t = t + "    IF where <> """" THEN" + NL
    t = t + "        addr.Text = where" + NL
    t = t + "        OpenMovie(where)" + NL
    t = t + "    ELSE" + NL
    t = t + "        addr.Focus()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    IF NOT inside THEN SYS.Exit(0)" + NL
    t = t + "    ' inside Simxplorer: stop, and close just this window" + NL
    t = t + "    isOpen = FALSE" + NL
    t = t + "    state = ""empty""" + NL
    t = t + "    ticker.Stop()" + NL
    t = t + "    fetcher.Stop()" + NL
    t = t + "    TRY" + NL
    t = t + "        win.Destroy()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Everything sized round the picture: at least MINW wide, the controls below." + NL
    t = t + "SUB Layout ()" + NL
    t = t + "    VAR cw AS Integer" + NL
    t = t + "    VAR sh AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    cw = MATH.Max(MINW, mW + 16)" + NL
    t = t + "    sh = MATH.Max(120, mH)" + NL
    t = t + "    addrLabel.SetBounds(8, 8, 52, 16)" + NL
    t = t + "    addr.SetBounds(62, 4, cw - 62 - 64, 22)" + NL
    t = t + "    openBtn.SetBounds(cw - 60, 4, 52, 22)" + NL
    t = t + "    screen.SetBounds(Int((cw - mW) / 2), 32 + Int((sh - mH) / 2), mW, mH)" + NL
    t = t + "    y = 32 + sh + 6" + NL
    t = t + "    info.SetBounds(8, y, cw - 16, 16)" + NL
    t = t + "    seekBar.SetBounds(8, y + 20, cw - 16, 14)" + NL
    t = t + "    y = y + 40" + NL
    t = t + "    playBtn.SetBounds(8, y, 56, 24)" + NL
    t = t + "    stopBtn.SetBounds(68, y, 48, 24)" + NL
    t = t + "    rewBtn.SetBounds(120, y, 60, 24)" + NL
    t = t + "    backBtn.SetBounds(184, y, 24, 24)" + NL
    t = t + "    fwdBtn.SetBounds(210, y, 24, 24)" + NL
    t = t + "    loopBox.SetBounds(8, y + 30, 56, 18)" + NL
    t = t + "    muteBox.SetBounds(68, y + 30, 56, 18)" + NL
    t = t + "    timeLabel.SetBounds(cw - 128, y + 4, 120, 16)" + NL
    t = t + "    win.Width = cw" + NL
    t = t + "    win.Height = y + 54" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Nothing loaded yet: the SimPlayer card." + NL
    t = t + "SUB Splash ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    screen.Background = 4" + NL
    t = t + "    screen.Clear()" + NL
    t = t + "    FOR i = 0 TO 7" + NL
    t = t + "        screen.SetColor(4)" + NL
    t = t + "        IF i MOD 2 = 1 THEN screen.SetColor(12)" + NL
    t = t + "        screen.FillRect(0, Int(mH * i / 8), mW, 2)" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' the S logo" + NL
    t = t + "    screen.SetColor(9)" + NL
    t = t + "    screen.FillRect(Int(mW / 2) - 16, Int(mH / 2) - 34, 32, 32)" + NL
    t = t + "    screen.SetColor(15)" + NL
    t = t + "    screen.FillRect(Int(mW / 2) - 8, Int(mH / 2) - 29, 18, 4)" + NL
    t = t + "    screen.FillRect(Int(mW / 2) - 10, Int(mH / 2) - 25, 5, 6)" + NL
    t = t + "    screen.FillRect(Int(mW / 2) - 8, Int(mH / 2) - 20, 16, 4)" + NL
    t = t + "    screen.FillRect(Int(mW / 2) + 5, Int(mH / 2) - 16, 5, 6)" + NL
    t = t + "    screen.FillRect(Int(mW / 2) - 10, Int(mH / 2) - 10, 18, 4)" + NL
    t = t + "    screen.SetColor(15)" + NL
    t = t + "    screen.Text(Int(mW / 2) - 32, Int(mH / 2) + 6, ""SimPlayer"")" + NL
    t = t + "    screen.SetColor(14)" + NL
    t = t + "    screen.Text(Int(mW / 2) - 38, Int(mH / 2) + 22, ""Version 1.0"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ opening" + NL
    t = t + "" + NL
    t = t + "SUB Reset ()" + NL
    t = t + "    frames.Clear()" + NL
    t = t + "    picNames.Clear()" + NL
    t = t + "    picData.Clear()" + NL
    t = t + "    partRefs.Clear()" + NL
    t = t + "    partsIn = 0" + NL
    t = t + "    allIn = FALSE" + NL
    t = t + "    gotHeader = FALSE" + NL
    t = t + "    mTitle = """"" + NL
    t = t + "    mAuthor = """"" + NL
    t = t + "    mFps = 10" + NL
    t = t + "    mFrames = 0" + NL
    t = t + "    mBg = 0" + NL
    t = t + "    cur = -1" + NL
    t = t + "    problem = """"" + NL
    t = t + "    fetching = FALSE" + NL
    t = t + "    wantFirst = FALSE" + NL
    t = t + "    tries = 0" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB OpenMovie (where AS String)" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    where = where.Trim()" + NL
    t = t + "    IF where = """" THEN RETURN" + NL
    t = t + "    Reset()" + NL
    t = t + "    source = where" + NL
    t = t + "    wantPlay = TRUE" + NL
    t = t + "    IF where.Lower().StartsWith(""http://"") THEN" + NL
    t = t + "        remote = TRUE" + NL
    t = t + "        state = ""buffering""" + NL
    t = t + "        wantFirst = TRUE" + NL
    t = t + "        win.Title = ""SimPlayer - "" + where" + NL
    t = t + "        Refresh()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    remote = FALSE" + NL
    t = t + "    IF NOT FS.Exists(where) THEN" + NL
    t = t + "        Fail(""There is no file called "" + where + ""."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    text = FS.Read(where)" + NL
    t = t + "    TakeFirst(text, DirOf(where))" + NL
    t = t + "    ' the parts of a movie on this disk are all here at once" + NL
    t = t + "    WHILE state <> ""error"" AND partsIn < partRefs.Count" + NL
    t = t + "        IF NOT FS.Exists(partRefs[partsIn]) THEN" + NL
    t = t + "            Fail(""A part of this movie is missing: "" + partRefs[partsIn])" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        AddPart(FS.Read(partRefs[partsIn]))" + NL
    t = t + "    END WHILE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Fail (why AS String)" + NL
    t = t + "    state = ""error""" + NL
    t = t + "    problem = why" + NL
    t = t + "    wantPlay = FALSE" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The first thing read from an address: a whole movie, or a manifest that" + NL
    t = t + "' lists its parts." + NL
    t = t + "SUB TakeFirst (text AS String, base AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    lines = text.Lines()" + NL
    t = t + "    IF lines.Count > 0 AND lines[0].StartsWith(""SIMMOVIE-PARTS"") THEN" + NL
    t = t + "        FOR EACH line IN lines" + NL
    t = t + "            IF line.StartsWith(""part="") THEN" + NL
    t = t + "                partRefs.Add(Resolve(line.Substring(5, line.Length - 5).Trim(), base))" + NL
    t = t + "            ELSE" + NL
    t = t + "                HeaderLine(line)" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF partRefs.Count = 0 THEN" + NL
    t = t + "            Fail(""That manifest lists no parts."")" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        Opened()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF lines.Count = 0 OR NOT lines[0].StartsWith(""SIMMOVIE "") THEN" + NL
    t = t + "        Fail(""That is not a SimMovie. A SimMovie starts with the line SIMMOVIE 1."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    partRefs.Add(source)" + NL
    t = t + "    AddPart(text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB HeaderLine (line AS String)" + NL
    t = t + "    VAR field AS String" + NL
    t = t + "    VAR value AS String" + NL
    t = t + "    IF line.IndexOf(""="") < 1 THEN RETURN" + NL
    t = t + "    field = line.Substring(0, line.IndexOf(""="")).Trim().Lower()" + NL
    t = t + "    value = line.Substring(line.IndexOf(""="") + 1, line.Length - line.IndexOf(""="") - 1)" + NL
    t = t + "    SELECT CASE field" + NL
    t = t + "        CASE ""title""" + NL
    t = t + "            mTitle = value" + NL
    t = t + "        CASE ""author""" + NL
    t = t + "            mAuthor = value" + NL
    t = t + "        CASE ""width""" + NL
    t = t + "            mW = Clamp(Int(Val(value)), 16, 320)" + NL
    t = t + "        CASE ""height""" + NL
    t = t + "            mH = Clamp(Int(Val(value)), 16, 240)" + NL
    t = t + "        CASE ""fps""" + NL
    t = t + "            mFps = Clamp(Int(Val(value)), 1, 30)" + NL
    t = t + "        CASE ""frames""" + NL
    t = t + "            mFrames = MATH.Max(0, Int(Val(value)))" + NL
    t = t + "        CASE ""bg""" + NL
    t = t + "            mBg = Clamp(Int(Val(value)), 0, 15)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Clamp (n AS Integer, lo AS Integer, hi AS Integer) AS Integer" + NL
    t = t + "    IF n < lo THEN RETURN lo" + NL
    t = t + "    IF n > hi THEN RETURN hi" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The header is in: size the window to the picture." + NL
    t = t + "SUB Opened ()" + NL
    t = t + "    IF gotHeader THEN RETURN" + NL
    t = t + "    gotHeader = TRUE" + NL
    t = t + "    Layout()" + NL
    t = t + "    screen.Background = mBg" + NL
    t = t + "    screen.Clear()" + NL
    t = t + "    IF mTitle = """" THEN mTitle = ""Untitled""" + NL
    t = t + "    win.Title = ""SimPlayer - "" + mTitle" + NL
    t = t + "    IF wantPlay THEN state = ""buffering""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One part: frames, and pictures for them. The first part starts with the header." + NL
    t = t + "SUB AddPart (text AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    lines = text.Lines()" + NL
    t = t + "    i = 0" + NL
    t = t + "    IF lines.Count > 0 AND lines[0].StartsWith(""SIMMOVIE "") THEN" + NL
    t = t + "        i = 1" + NL
    t = t + "        WHILE i < lines.Count" + NL
    t = t + "            IF lines[i] = ""."" THEN BREAK" + NL
    t = t + "            ' a manifest has said all this already" + NL
    t = t + "            IF NOT gotHeader THEN HeaderLine(lines[i])" + NL
    t = t + "            i = i + 1" + NL
    t = t + "        END WHILE" + NL
    t = t + "        i = i + 1" + NL
    t = t + "    END IF" + NL
    t = t + "    Opened()" + NL
    t = t + "    WHILE i < lines.Count" + NL
    t = t + "        line = lines[i]" + NL
    t = t + "        i = i + 1" + NL
    t = t + "        IF line = """" OR line.StartsWith(""'"") THEN CONTINUE" + NL
    t = t + "        IF line.StartsWith(""!"") THEN" + NL
    t = t + "            AddPicture(line.Substring(1, line.Length - 1))" + NL
    t = t + "        ELSE" + NL
    t = t + "            frames.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    partsIn = partsIn + 1" + NL
    t = t + "    IF partsIn >= partRefs.Count THEN" + NL
    t = t + "        allIn = TRUE" + NL
    t = t + "        mFrames = frames.Count" + NL
    t = t + "    END IF" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' !name|SIM95PIC w h|row|row..." + NL
    t = t + "SUB AddPicture (line AS String)" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    at = line.IndexOf(""|"")" + NL
    t = t + "    IF at < 1 THEN RETURN" + NL
    t = t + "    picNames.Add(line.Substring(0, at))" + NL
    t = t + "    picData.Add(line.Substring(at + 1, line.Length - at - 1).Replace(""|"", EOL))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where a part is, from what the manifest says and where the manifest was." + NL
    t = t + "FUNCTION Resolve (ref AS String, base AS String) AS String" + NL
    t = t + "    VAR host AS String" + NL
    t = t + "    IF ref.Lower().StartsWith(""http://"") THEN RETURN ref" + NL
    t = t + "    IF base.Lower().StartsWith(""http://"") THEN" + NL
    t = t + "        IF ref.StartsWith(""/"") THEN" + NL
    t = t + "            host = base.Substring(7, base.Length - 7)" + NL
    t = t + "            IF host.IndexOf(""/"") >= 0 THEN host = host.Substring(0, host.IndexOf(""/""))" + NL
    t = t + "            RETURN ""http://"" + host + ref" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN base + ref" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ref.Contains("":\"") THEN RETURN ref" + NL
    t = t + "    RETURN base + ref" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The folder an address is in, with its slash: http://a/tube/ or C:\MYFILES\" + NL
    t = t + "FUNCTION DirOf (where AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR sep AS String" + NL
    t = t + "    sep = ""\""" + NL
    t = t + "    IF where.Lower().StartsWith(""http://"") THEN" + NL
    t = t + "        sep = ""/""" + NL
    t = t + "        IF where.IndexOf(""?"") >= 0 THEN where = where.Substring(0, where.IndexOf(""?""))" + NL
    t = t + "        IF where.Substring(7, where.Length - 7).IndexOf(""/"") < 0 THEN RETURN where + ""/""" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = where.Length - 1 TO 0 STEP -1" + NL
    t = t + "        IF where.CharAt(i) = sep THEN RETURN where.Substring(0, i + 1)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Total () AS Integer" + NL
    t = t + "    IF allIn THEN RETURN frames.Count" + NL
    t = t + "    RETURN MATH.Max(mFrames, frames.Count)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Enough is here to play: all of it, or a few seconds past this frame." + NL
    t = t + "FUNCTION Ready () AS Bool" + NL
    t = t + "    IF frames.Count = 0 THEN RETURN FALSE" + NL
    t = t + "    IF allIn THEN RETURN TRUE" + NL
    t = t + "    RETURN frames.Count - 1 - cur >= mFps * AHEAD" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Percent () AS Integer" + NL
    t = t + "    IF partRefs.Count = 0 THEN RETURN 0" + NL
    t = t + "    RETURN Int(partsIn * 100 / partRefs.Count)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ playing" + NL
    t = t + "" + NL
    t = t + "SUB Ticker_OnTick ()" + NL
    t = t + "    IF drawing THEN RETURN" + NL
    t = t + "    drawing = TRUE" + NL
    t = t + "    TRY" + NL
    t = t + "        PlayStep()" + NL
    t = t + "    CATCH err" + NL
    t = t + "        win.Status = ""Could not draw frame "" + Str(cur + 1) + "": "" + err" + NL
    t = t + "    END TRY" + NL
    t = t + "    drawing = FALSE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB PlayStep ()" + NL
    t = t + "    VAR want AS Integer" + NL
    t = t + "    VAR last AS Integer" + NL
    t = t + "    IF state = ""buffering"" THEN" + NL
    t = t + "        IF wantPlay AND Ready() THEN BeginPlay()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF state <> ""playing"" THEN RETURN" + NL
    t = t + "    want = f0 + Int((SYS.Ticks - t0) * mFps / 1000)" + NL
    t = t + "    last = Total() - 1" + NL
    t = t + "    IF want > last AND allIn THEN" + NL
    t = t + "        IF cur < last THEN ShowFrame(last, TRUE)" + NL
    t = t + "        IF loopBox.Checked THEN" + NL
    t = t + "            ShowFrame(0, TRUE)" + NL
    t = t + "            t0 = SYS.Ticks" + NL
    t = t + "            f0 = 0" + NL
    t = t + "        ELSE" + NL
    t = t + "            state = ""ended""" + NL
    t = t + "            wantPlay = FALSE" + NL
    t = t + "        END IF" + NL
    t = t + "        Refresh()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF want > frames.Count - 1 THEN" + NL
    t = t + "        ' caught up with the download: wait for more" + NL
    t = t + "        IF cur < frames.Count - 1 THEN ShowFrame(frames.Count - 1, TRUE)" + NL
    t = t + "        state = ""buffering""" + NL
    t = t + "        Refresh()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF want > cur THEN" + NL
    t = t + "        ShowFrame(want, TRUE)" + NL
    t = t + "        Refresh()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB BeginPlay ()" + NL
    t = t + "    IF cur >= Total() - 1 THEN cur = -1" + NL
    t = t + "    IF cur < 0 THEN ShowFrame(0, TRUE)" + NL
    t = t + "    t0 = SYS.Ticks" + NL
    t = t + "    f0 = cur" + NL
    t = t + "    state = ""playing""" + NL
    t = t + "    wantPlay = TRUE" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Pause ()" + NL
    t = t + "    wantPlay = FALSE" + NL
    t = t + "    IF state = ""playing"" OR state = ""buffering"" THEN state = ""paused""" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION HasMovie () AS Bool" + NL
    t = t + "    RETURN frames.Count > 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Frame n on the screen. Going forward, the frames in between are drawn over" + NL
    t = t + "' what is there (from a keyframe, if one comes first); anywhere else, from the" + NL
    t = t + "' keyframe before n." + NL
    t = t + "SUB ShowFrame (n AS Integer, sound AS Bool)" + NL
    t = t + "    VAR start AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF n < 0 OR n >= frames.Count THEN RETURN" + NL
    t = t + "    start = n" + NL
    t = t + "    WHILE start > 0 AND NOT frames[start].StartsWith(""*"")" + NL
    t = t + "        IF start = cur + 1 AND cur >= 0 AND n > cur THEN BREAK" + NL
    t = t + "        start = start - 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF NOT frames[start].StartsWith(""*"") AND start = 0 THEN Blank()" + NL
    t = t + "    FOR i = start TO n" + NL
    t = t + "        DrawFrame(frames[i], sound AND i = n)" + NL
    t = t + "    NEXT" + NL
    t = t + "    cur = n" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Blank ()" + NL
    t = t + "    screen.Background = mBg" + NL
    t = t + "    screen.Clear()" + NL
    t = t + "    screen.SetColor(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawFrame (line AS String, sound AS Bool)" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    IF line.StartsWith(""*"") THEN" + NL
    t = t + "        Blank()" + NL
    t = t + "        line = line.Substring(1, line.Length - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF line = ""-"" OR line = """" THEN RETURN" + NL
    t = t + "    FOR EACH c IN line.Split("";"")" + NL
    t = t + "        IF c <> """" THEN DrawCmd(c, sound)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One command: a letter and its numbers." + NL
    t = t + "SUB DrawCmd (c AS String, sound AS Bool)" + NL
    t = t + "    VAR op AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    VAR n AS Array OF Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    op = c.CharAt(0)" + NL
    t = t + "    rest = c.Substring(1, c.Length - 1)" + NL
    t = t + "    SELECT CASE op" + NL
    t = t + "        CASE ""C""" + NL
    t = t + "            screen.SetColor(Clamp(Int(Val(rest)), 0, 15))" + NL
    t = t + "        CASE ""B""" + NL
    t = t + "            screen.Background = Clamp(Int(Val(rest)), 0, 15)" + NL
    t = t + "        CASE ""X""" + NL
    t = t + "            screen.Clear()" + NL
    t = t + "        CASE ""T""" + NL
    t = t + "            ' T x,y,text: the text runs to the end of the command" + NL
    t = t + "            n = Nums(rest, 2)" + NL
    t = t + "            at = SecondComma(rest)" + NL
    t = t + "            IF n.Count = 2 AND at > 0 THEN screen.Text(n[0], n[1], rest.Substring(at + 1, rest.Length - at - 1))" + NL
    t = t + "        CASE ""I""" + NL
    t = t + "            n = Nums(rest, 2)" + NL
    t = t + "            at = SecondComma(rest)" + NL
    t = t + "            IF n.Count = 2 AND at > 0 THEN" + NL
    t = t + "                i = picNames.IndexOf(rest.Substring(at + 1, rest.Length - at - 1))" + NL
    t = t + "                IF i >= 0 THEN screen.Picture(n[0], n[1], picData[i])" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""S""" + NL
    t = t + "            n = Nums(rest, 2)" + NL
    t = t + "            IF sound AND NOT muteBox.Checked AND n.Count = 2 THEN SYS.Beep(Clamp(n[0], 37, 8000), Clamp(n[1], 1, 1000))" + NL
    t = t + "        CASE ""R""" + NL
    t = t + "            n = Nums(rest, 4)" + NL
    t = t + "            IF n.Count = 4 THEN screen.Rect(n[0], n[1], n[2], n[3])" + NL
    t = t + "        CASE ""F""" + NL
    t = t + "            n = Nums(rest, 4)" + NL
    t = t + "            IF n.Count = 4 THEN screen.FillRect(n[0], n[1], n[2], n[3])" + NL
    t = t + "        CASE ""O""" + NL
    t = t + "            n = Nums(rest, 3)" + NL
    t = t + "            IF n.Count = 3 THEN screen.Circle(n[0], n[1], n[2])" + NL
    t = t + "        CASE ""D""" + NL
    t = t + "            n = Nums(rest, 3)" + NL
    t = t + "            IF n.Count = 3 THEN screen.FillCircle(n[0], n[1], n[2])" + NL
    t = t + "        CASE ""L""" + NL
    t = t + "            n = Nums(rest, 0)" + NL
    t = t + "            FOR i = 0 TO Int(n.Count / 2) - 2" + NL
    t = t + "                screen.Line(n[i * 2], n[i * 2 + 1], n[i * 2 + 2], n[i * 2 + 3])" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""P""" + NL
    t = t + "            n = Nums(rest, 0)" + NL
    t = t + "            IF n.Count >= 4 THEN" + NL
    t = t + "                FOR i = 0 TO Int(n.Count / 2) - 1" + NL
    t = t + "                    screen.Line(n[i * 2], n[i * 2 + 1], n[((i + 1) * 2) MOD (Int(n.Count / 2) * 2)], n[((i + 1) * 2) MOD (Int(n.Count / 2) * 2) + 1])" + NL
    t = t + "                NEXT" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Q""" + NL
    t = t + "            n = Nums(rest, 0)" + NL
    t = t + "            IF n.Count >= 6 THEN FillPoly(n)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where the text of T x,y,text (or the name of I x,y,name) starts, less one." + NL
    t = t + "FUNCTION SecondComma (s AS String) AS Integer" + NL
    t = t + "    VAR a AS Integer" + NL
    t = t + "    VAR b AS Integer" + NL
    t = t + "    a = s.IndexOf("","")" + NL
    t = t + "    IF a < 0 THEN RETURN -1" + NL
    t = t + "    b = s.Substring(a + 1, s.Length - a - 1).IndexOf("","")" + NL
    t = t + "    IF b < 0 THEN RETURN -1" + NL
    t = t + "    RETURN a + 1 + b" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The numbers in ""10,20,30"". most > 0 reads only that many (T and I have" + NL
    t = t + "' text after theirs)." + NL
    t = t + "FUNCTION Nums (s AS String, most AS Integer) AS Array OF Integer" + NL
    t = t + "    VAR out AS Array OF Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    FOR EACH p IN s.Split("","")" + NL
    t = t + "        IF most > 0 AND out.Count >= most THEN BREAK" + NL
    t = t + "        out.Add(Int(Val(p.Trim())))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A filled polygon, a row at a time: where each row crosses the edges, in" + NL
    t = t + "' pairs." + NL
    t = t + "SUB FillPoly (p AS Array OF Integer)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR top AS Integer" + NL
    t = t + "    VAR bottom AS Integer" + NL
    t = t + "    VAR x1 AS Integer" + NL
    t = t + "    VAR y1 AS Integer" + NL
    t = t + "    VAR x2 AS Integer" + NL
    t = t + "    VAR y2 AS Integer" + NL
    t = t + "    VAR xs AS Array OF Integer" + NL
    t = t + "    k = Int(p.Count / 2)" + NL
    t = t + "    top = p[1]" + NL
    t = t + "    bottom = p[1]" + NL
    t = t + "    FOR i = 1 TO k - 1" + NL
    t = t + "        top = MATH.Min(top, p[i * 2 + 1])" + NL
    t = t + "        bottom = MATH.Max(bottom, p[i * 2 + 1])" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR y = top TO bottom" + NL
    t = t + "        xs.Clear()" + NL
    t = t + "        FOR i = 0 TO k - 1" + NL
    t = t + "            j = (i + 1) MOD k" + NL
    t = t + "            x1 = p[i * 2]" + NL
    t = t + "            y1 = p[i * 2 + 1]" + NL
    t = t + "            x2 = p[j * 2]" + NL
    t = t + "            y2 = p[j * 2 + 1]" + NL
    t = t + "            IF (y1 <= y AND y2 > y) OR (y2 <= y AND y1 > y) THEN xs.Add(x1 + Int((y - y1) * (x2 - x1) / (y2 - y1)))" + NL
    t = t + "        NEXT" + NL
    t = t + "        xs.Sort()" + NL
    t = t + "        FOR i = 0 TO xs.Count - 2" + NL
    t = t + "            IF i MOD 2 = 0 THEN screen.Line(xs[i], y, xs[i + 1], y)" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the controls" + NL
    t = t + "" + NL
    t = t + "SUB Play_Click ()" + NL
    t = t + "    IF state = ""playing"" OR (state = ""buffering"" AND wantPlay) THEN" + NL
    t = t + "        Pause()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT HasMovie() AND NOT remote THEN RETURN" + NL
    t = t + "    IF state = ""error"" THEN RETURN" + NL
    t = t + "    IF state = ""ended"" OR cur >= Total() - 1 THEN cur = -1" + NL
    t = t + "    wantPlay = TRUE" + NL
    t = t + "    IF Ready() THEN" + NL
    t = t + "        BeginPlay()" + NL
    t = t + "    ELSE" + NL
    t = t + "        state = ""buffering""" + NL
    t = t + "        Refresh()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Stop_Click ()" + NL
    t = t + "    IF NOT HasMovie() THEN RETURN" + NL
    t = t + "    wantPlay = FALSE" + NL
    t = t + "    ShowFrame(0, FALSE)" + NL
    t = t + "    state = ""stopped""" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Rewind_Click ()" + NL
    t = t + "    SeekFrame(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Back_Click ()" + NL
    t = t + "    IF NOT HasMovie() THEN RETURN" + NL
    t = t + "    Pause()" + NL
    t = t + "    IF state = ""stopped"" OR state = ""ended"" THEN state = ""paused""" + NL
    t = t + "    IF cur > 0 THEN ShowFrame(cur - 1, FALSE)" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Fwd_Click ()" + NL
    t = t + "    IF NOT HasMovie() THEN RETURN" + NL
    t = t + "    Pause()" + NL
    t = t + "    IF state = ""stopped"" OR state = ""ended"" THEN state = ""paused""" + NL
    t = t + "    IF cur < frames.Count - 1 THEN ShowFrame(cur + 1, TRUE)" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Anywhere in what has arrived so far; playing carries on from there." + NL
    t = t + "SUB SeekFrame (n AS Integer)" + NL
    t = t + "    IF NOT HasMovie() THEN RETURN" + NL
    t = t + "    n = Clamp(n, 0, frames.Count - 1)" + NL
    t = t + "    ShowFrame(n, FALSE)" + NL
    t = t + "    IF state = ""playing"" THEN" + NL
    t = t + "        t0 = SYS.Ticks" + NL
    t = t + "        f0 = n" + NL
    t = t + "    ELSEIF state = ""stopped"" OR state = ""ended"" THEN" + NL
    t = t + "        state = ""paused""" + NL
    t = t + "    END IF" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Loop_Change ()" + NL
    t = t + "    bar.SetChecked(""Loop"", loopBox.Checked)" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Mute_Change ()" + NL
    t = t + "    bar.SetChecked(""Mute"", muteBox.Checked)" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Open_Click ()" + NL
    t = t + "    OpenMovie(addr.Text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB OpenFile ()" + NL
    t = t + "    VAR dlg AS GUI_FileDialog" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    dlg = GUI_FileDialog.New(win)" + NL
    t = t + "    dlg.Title = ""Open a SimMovie""" + NL
    t = t + "    dlg.Filter = ""*.SMV""" + NL
    t = t + "    dlg.Path = ""C:\MYFILES""" + NL
    t = t + "    path = dlg.ShowOpen()" + NL
    t = t + "    IF path <> """" THEN" + NL
    t = t + "        addr.Text = path" + NL
    t = t + "        OpenMovie(path)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Player_OnKey (k AS String)" + NL
    t = t + "    SELECT CASE k" + NL
    t = t + "        CASE ""Space""" + NL
    t = t + "            Play_Click()" + NL
    t = t + "        CASE ""ArrowRight"", "".""" + NL
    t = t + "            Fwd_Click()" + NL
    t = t + "        CASE ""ArrowLeft"", "",""" + NL
    t = t + "            Back_Click()" + NL
    t = t + "        CASE ""Home""" + NL
    t = t + "            Rewind_Click()" + NL
    t = t + "        CASE ""Ctrl+O""" + NL
    t = t + "            OpenFile()" + NL
    t = t + "        CASE ""Ctrl+L""" + NL
    t = t + "            addr.Focus()" + NL
    t = t + "            addr.SelectAll()" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Screen_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    Play_Click()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Screen_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    IF cur >= 0 THEN" + NL
    t = t + "        ShowFrame(cur, FALSE)" + NL
    t = t + "    ELSEIF NOT HasMovie() AND state = ""empty"" THEN" + NL
    t = t + "        Splash()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Menu_OnSelect (item AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    SELECT CASE item" + NL
    t = t + "        CASE ""Open File...""" + NL
    t = t + "            OpenFile()" + NL
    t = t + "        CASE ""Open URL...""" + NL
    t = t + "            addr.Focus()" + NL
    t = t + "            addr.SelectAll()" + NL
    t = t + "        CASE ""Exit"", ""Close""" + NL
    t = t + "            Win_OnClose()" + NL
    t = t + "        CASE ""Play/Pause""" + NL
    t = t + "            Play_Click()" + NL
    t = t + "        CASE ""Stop""" + NL
    t = t + "            Stop_Click()" + NL
    t = t + "        CASE ""Rewind""" + NL
    t = t + "            Rewind_Click()" + NL
    t = t + "        CASE ""Step Forward""" + NL
    t = t + "            Fwd_Click()" + NL
    t = t + "        CASE ""Step Back""" + NL
    t = t + "            Back_Click()" + NL
    t = t + "        CASE ""Loop""" + NL
    t = t + "            loopBox.Checked = NOT loopBox.Checked" + NL
    t = t + "            Loop_Change()" + NL
    t = t + "        CASE ""Mute""" + NL
    t = t + "            muteBox.Checked = NOT muteBox.Checked" + NL
    t = t + "            Mute_Change()" + NL
    t = t + "        CASE ""About SimPlayer""" + NL
    t = t + "            box = GUI_MessageBox.New(win)" + NL
    t = t + "            box.Title = ""About SimPlayer""" + NL
    t = t + "            box.Text = ""SimPlayer 1.0 for SIM95"" + EOL + EOL + ""Plays SimMovies (.SMV) from your disk or the web, and streams the long ones while they download."" + EOL + EOL + ""Find movies on SimTube.""" + NL
    t = t + "            box.Show()" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the seek bar" + NL
    t = t + "" + NL
    t = t + "SUB Seek_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    DrawSeek()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawSeek ()" + NL
    t = t + "    VAR w AS Integer" + NL
    t = t + "    VAR t AS Integer" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    w = seekBar.Width" + NL
    t = t + "    t = MATH.Max(1, Total() - 1)" + NL
    t = t + "    seekBar.Background = 7" + NL
    t = t + "    seekBar.Clear()" + NL
    t = t + "    seekBar.SetColor(8)" + NL
    t = t + "    seekBar.Line(0, 0, w - 1, 0)" + NL
    t = t + "    seekBar.Line(0, 0, 0, 13)" + NL
    t = t + "    seekBar.SetColor(15)" + NL
    t = t + "    seekBar.Line(0, 13, w - 1, 13)" + NL
    t = t + "    ' downloaded, and played" + NL
    t = t + "    IF HasMovie() THEN" + NL
    t = t + "        seekBar.SetColor(6)" + NL
    t = t + "        seekBar.FillRect(2, 5, Int((w - 4) * MATH.Min(1, (frames.Count - 1) / t)), 4)" + NL
    t = t + "        x = Int((w - 12) * MATH.Max(0, cur) / t)" + NL
    t = t + "        seekBar.SetColor(4)" + NL
    t = t + "        seekBar.FillRect(2, 5, x, 4)" + NL
    t = t + "        ' the thumb" + NL
    t = t + "        seekBar.SetColor(7)" + NL
    t = t + "        seekBar.FillRect(x + 1, 1, 10, 12)" + NL
    t = t + "        seekBar.SetColor(15)" + NL
    t = t + "        seekBar.Line(x + 1, 1, x + 10, 1)" + NL
    t = t + "        seekBar.Line(x + 1, 1, x + 1, 12)" + NL
    t = t + "        seekBar.SetColor(0)" + NL
    t = t + "        seekBar.Line(x + 1, 12, x + 10, 12)" + NL
    t = t + "        seekBar.Line(x + 10, 1, x + 10, 12)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION FrameAt (x AS Integer) AS Integer" + NL
    t = t + "    RETURN Int(MATH.Max(0, x - 6) * MATH.Max(1, Total() - 1) / MATH.Max(1, seekBar.Width - 12))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Seek_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    dragging = TRUE" + NL
    t = t + "    SeekFrame(FrameAt(x))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Seek_OnMouseMove (x AS Integer, y AS Integer)" + NL
    t = t + "    IF dragging THEN SeekFrame(FrameAt(x))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Seek_OnMouseUp (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    IF dragging THEN SeekFrame(FrameAt(x))" + NL
    t = t + "    dragging = FALSE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ what it says" + NL
    t = t + "" + NL
    t = t + "FUNCTION Clock (n AS Integer) AS String" + NL
    t = t + "    VAR s AS Integer" + NL
    t = t + "    s = Int(MATH.Max(0, n) / mFps)" + NL
    t = t + "    RETURN Str(Int(s / 60)) + "":"" + Str(100 + s MOD 60).Substring(1, 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Refresh ()" + NL
    t = t + "    VAR what AS String" + NL
    t = t + "    VAR flag AS String" + NL
    t = t + "    SELECT CASE state" + NL
    t = t + "        CASE ""empty""" + NL
    t = t + "            what = ""Ready. Open a SimMovie (.SMV) from your disk, or type its address.""" + NL
    t = t + "        CASE ""buffering""" + NL
    t = t + "            what = ""Buffering... "" + Str(Percent()) + ""%""" + NL
    t = t + "            IF NOT gotHeader THEN what = what + ""  (connecting to "" + HostOf(source) + "")""" + NL
    t = t + "        CASE ""playing""" + NL
    t = t + "            what = ""Playing""" + NL
    t = t + "        CASE ""paused""" + NL
    t = t + "            what = ""Paused""" + NL
    t = t + "        CASE ""stopped""" + NL
    t = t + "            what = ""Stopped""" + NL
    t = t + "        CASE ""ended""" + NL
    t = t + "            what = ""Finished""" + NL
    t = t + "        CASE ""error""" + NL
    t = t + "            what = problem" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF remote AND NOT allIn AND state <> ""buffering"" AND state <> ""error"" THEN what = what + ""  ("" + Str(Percent()) + ""% downloaded)""" + NL
    t = t + "    IF muteBox.Checked AND state <> ""error"" THEN what = what + ""  [muted]""" + NL
    t = t + "    win.Status = what" + NL
    t = t + "    IF state = ""playing"" OR (state = ""buffering"" AND wantPlay) THEN" + NL
    t = t + "        playBtn.Text = ""&Pause""" + NL
    t = t + "    ELSE" + NL
    t = t + "        playBtn.Text = ""&Play""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF gotHeader THEN" + NL
    t = t + "        info.Text = mTitle" + NL
    t = t + "        IF mAuthor <> """" THEN info.Text = mTitle + ""  -  by "" + mAuthor" + NL
    t = t + "        timeLabel.Text = Clock(MATH.Max(cur, 0)) + "" / "" + Clock(Total())" + NL
    t = t + "    ELSE" + NL
    t = t + "        info.Text = """"" + NL
    t = t + "        timeLabel.Text = ""0:00 / 0:00""" + NL
    t = t + "    END IF" + NL
    t = t + "    DrawSeek()" + NL
    t = t + "    flag = ""0|0""" + NL
    t = t + "    IF loopBox.Checked THEN flag = ""1|0""" + NL
    t = t + "    IF muteBox.Checked THEN flag = flag.Substring(0, 2) + ""1""" + NL
    t = t + "    win.Tag = state + ""|"" + Str(cur) + ""|"" + Str(Total()) + ""|"" + Str(frames.Count) + ""|"" + Str(partsIn) + ""|"" + Str(partRefs.Count) + ""|"" + flag" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION HostOf (url AS String) AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    IF NOT url.Lower().StartsWith(""http://"") THEN RETURN url" + NL
    t = t + "    h = url.Substring(7, url.Length - 7)" + NL
    t = t + "    IF h.IndexOf(""/"") >= 0 THEN h = h.Substring(0, h.IndexOf(""/""))" + NL
    t = t + "    RETURN h" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the web" + NL
    t = t + "" + NL
    t = t + "SUB Fetcher_OnTick ()" + NL
    t = t + "    TRY" + NL
    t = t + "        FetchStep()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB FetchStep ()" + NL
    t = t + "    IF fetching THEN" + NL
    t = t + "        IF fDone OR SYS.Ticks - fSince > PATIENCE THEN Arrived()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT remote OR state = ""error"" THEN RETURN" + NL
    t = t + "    IF wantFirst THEN" + NL
    t = t + "        ' a SimDNS name: ask first, in a tick of its own" + NL
    t = t + "        IF RsNext(HostOf(source)) THEN RETURN" + NL
    t = t + "        wantFirst = FALSE" + NL
    t = t + "        fFirst = TRUE" + NL
    t = t + "        ' (last thing in the tick: it may be spoiled)" + NL
    t = t + "        StartFetch(source)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF partsIn < partRefs.Count THEN" + NL
    t = t + "        IF RsNext(HostOf(partRefs[partsIn])) THEN RETURN" + NL
    t = t + "        fFirst = FALSE" + NL
    t = t + "        StartFetch(partRefs[partsIn])" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB StartFetch (url AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR host AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    fetching = TRUE" + NL
    t = t + "    fUrl = url" + NL
    t = t + "    fNumber = fNumber + 1" + NL
    t = t + "    fParts.Clear()" + NL
    t = t + "    fDone = FALSE" + NL
    t = t + "    fError = """"" + NL
    t = t + "    fSince = SYS.Ticks" + NL
    t = t + "    host = url.Substring(7, url.Length - 7)" + NL
    t = t + "    IF host.IndexOf(""/"") < 0 THEN host = host + ""/""" + NL
    t = t + "    path = host.Substring(host.IndexOf(""/""), host.Length - host.IndexOf(""/""))" + NL
    t = t + "    host = host.Substring(0, host.IndexOf(""/""))" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = web.Connect(RsTarget(host), 80)" + NL
    t = t + "        conn.Tag = Str(fNumber)" + NL
    t = t + "        conn.Send(""GET "" + path + "" HTTP/1.0"" + EOL + ""Host: "" + host + EOL + ""User-Agent: SimPlayer/1.0 (SIM95)"" + EOL + ""Accept: video/x-simmovie"")" + NL
    t = t + "    CATCH err" + NL
    t = t + "        fError = err" + NL
    t = t + "        fDone = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    IF conn.Tag = Str(fNumber) AND NOT fDone THEN fParts.Add(message)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnClose (conn AS NET_Connection)" + NL
    t = t + "    IF conn.Tag = Str(fNumber) THEN fDone = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A fetch finished (or gave up): the body, or """" with fError saying why." + NL
    t = t + "FUNCTION Body () AS String" + NL
    t = t + "    VAR raw AS String" + NL
    t = t + "    raw = fParts.Join(EOL)" + NL
    t = t + "    IF fError <> """" THEN RETURN """"" + NL
    t = t + "    IF raw = """" THEN" + NL
    t = t + "        fError = ""no answer""" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT raw.StartsWith(""HTTP/1.0 200"") THEN" + NL
    t = t + "        fError = raw.Lines()[0]" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT raw.Contains(EOL + EOL) THEN RETURN """"" + NL
    t = t + "    RETURN raw.Substring(raw.IndexOf(EOL + EOL) + 2, raw.Length - raw.IndexOf(EOL + EOL) - 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Arrived ()" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    fetching = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        web.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF NOT remote OR source = """" THEN RETURN" + NL
    t = t + "    text = Body()" + NL
    t = t + "    IF text = """" THEN" + NL
    t = t + "        tries = tries + 1" + NL
    t = t + "        IF fError = """" THEN fError = ""it was empty""" + NL
    t = t + "        IF tries >= MAXTRIES OR fError.StartsWith(""HTTP"") THEN" + NL
    t = t + "            Fail(""Could not get "" + fUrl + "" ("" + fError + "")."")" + NL
    t = t + "        ELSEIF fFirst THEN" + NL
    t = t + "            wantFirst = TRUE" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    tries = 0" + NL
    t = t + "    IF fFirst THEN" + NL
    t = t + "        TakeFirst(text, DirOf(fUrl))" + NL
    t = t + "    ELSE" + NL
    t = t + "        AddPart(text)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' RESOLVE.SPK - the SimDNS resolver: asks the name server which machine a" + NL
    t = t + "' name like www.coolsite.sim is on." + NL
    t = t + "'" + NL
    t = t + "' The name server is the central one, STARTHERE.56k.net, where SimNIC (the" + NL
    t = t + "' registrar) and NAMED.SPK run, unless C:\SYSTEM\RESOLV.INI says otherwise." + NL
    t = t + "' To move the whole network to another central host, change RSCENTRAL below" + NL
    t = t + "' (the builder sets it from CENTRAL in tools/simxplorer-source.mjs)." + NL
    t = t + "'" + NL
    t = t + "' A library, not a program: a program has it joined on the end (the builder" + NL
    t = t + "' does this for Simxplorer, SimPlayer, Vapor, Frostbird, MAILD, the Sim Shell," + NL
    t = t + "' AskSim's crawler, DIG and Personal Web Manager; copy C:\PROGRAMS\RESOLVE.SPK" + NL
    t = t + "' onto the end of your own). Every name in it starts with Rs, so it can't clash." + NL
    t = t + "'" + NL
    t = t + "' C:\SYSTEM\RESOLV.INI, shared by every program on the machine (optional):" + NL
    t = t + "'     nameserver=dnsbox          another name server instead of the central one" + NL
    t = t + "'     nameserver=none            no SimDNS at all: SIM95 machine names only" + NL
    t = t + "'     search=coolsite.sim        then ""www"" means www.coolsite.sim" + NL
    t = t + "'" + NL
    t = t + "' How to use it without ever waiting in the wrong place (SIM95-NOTES.md):" + NL
    t = t + "'   1. RsWants(host)  - does this name need asking? FALSE for addresses," + NL
    t = t + "'                       plain machine names, names already known, or when" + NL
    t = t + "'                       there is no name server (or it isn't answering)." + NL
    t = t + "'   2. RsAsk(host, address) - sends the question to the name server at that" + NL
    t = t + "'                       address. It is a Connect: let it be the last thing" + NL
    t = t + "'                       the handler does." + NL
    t = t + "'   3. RsBusy()       - TRUE while the answer is on its way. After RSWAIT" + NL
    t = t + "'                       with no answer the server is left alone for RSQUIET," + NL
    t = t + "'                       and every name goes to SIM95 as before." + NL
    t = t + "'   4. RsTarget(host) - where to connect: the machine name (or address) the" + NL
    t = t + "'                       name server gave, or the name itself when SimDNS" + NL
    t = t + "'                       doesn't know it, for SIM95 to look up." + NL
    t = t + "' Answers are kept for their TTL; names SimDNS doesn't know for RSNEG." + NL
    t = t + "'" + NL
    t = t + "' Or, from a timer tick, all of that in one line (see RsNext):" + NL
    t = t + "'     IF RsNext(host) THEN RETURN          ' asked, or waiting: end the tick" + NL
    t = t + "'     conn = sock.Connect(RsTarget(host), 80)" + NL
    t = t + "' and for mail, the domain's MX first (see RsNextMail):" + NL
    t = t + "'     IF RsNextMail(domain) THEN RETURN" + NL
    t = t + "'     conn = sock.Connect(RsMailTarget(domain), 25)" + NL
    t = t + "" + NL
    t = t + "CONST RSCENTRAL = ""starthere.56k.net""   ' the central name server" + NL
    t = t + "CONST RSINI = ""C:\SYSTEM\RESOLV.INI""" + NL
    t = t + "CONST RSPORT = 53" + NL
    t = t + "CONST RSWAIT = 5000             ' ms to wait for an answer (a slow line takes a while)" + NL
    t = t + "CONST RSQUIET = 30000            ' ms to leave a silent name server alone" + NL
    t = t + "CONST RSNEG = 60000             ' ms to remember that SimDNS doesn't know a name" + NL
    t = t + "CONST RSMOST = 100              ' names kept" + NL
    t = t + "" + NL
    t = t + "VAR rsServer AS String              ' """" when SimDNS is off" + NL
    t = t + "VAR rsByDefault AS Bool               ' TRUE when RESOLV.INI doesn't name one" + NL
    t = t + "VAR rsSearch AS String" + NL
    t = t + "VAR rsRead AS Bool" + NL
    t = t + "VAR rsReadAt AS Integer" + NL
    t = t + "VAR rsSock AS NET_Socket" + NL
    t = t + "VAR rsName AS Array OF String       ' the name as asked, lower case" + NL
    t = t + "VAR rsTo AS Array OF String         ' where it is ("""" when SimDNS doesn't know it)" + NL
    t = t + "VAR rsCanon AS Array OF String      ' its last name in DNS before the machine" + NL
    t = t + "VAR rsUntil AS Array OF Integer     ' SYS.Ticks when it is forgotten" + NL
    t = t + "VAR rsAsking AS String" + NL
    t = t + "VAR rsAskAt AS Integer" + NL
    t = t + "VAR rsRefused AS Bool" + NL
    t = t + "VAR rsDown AS Bool" + NL
    t = t + "VAR rsDownAt AS Integer" + NL
    t = t + "VAR rsWhy AS String                 ' the last thing that went wrong" + NL
    t = t + "VAR rsLastReply AS String           ' the last answer, as it came" + NL
    t = t + "VAR rsServerAddr AS String          ' the name server's address, for RsNext" + NL
    t = t + "VAR rsServerFor AS String" + NL
    t = t + "VAR rsServerAt AS Integer" + NL
    t = t + "VAR rsLooking AS Bool               ' RsNext is finding the name server's address" + NL
    t = t + "VAR rsLookingAt AS Integer" + NL
    t = t + "" + NL
    t = t + "' Reads RESOLV.INI (again after a few seconds, so a new setting takes)." + NL
    t = t + "' With no nameserver= line, the central name server; none (or nothing after" + NL
    t = t + "' the =) turns SimDNS off." + NL
    t = t + "SUB RsConfig ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    IF rsRead AND SYS.Ticks - rsReadAt < 3000 THEN RETURN" + NL
    t = t + "    rsRead = TRUE" + NL
    t = t + "    rsReadAt = SYS.Ticks" + NL
    t = t + "    rsServer = RSCENTRAL" + NL
    t = t + "    rsByDefault = TRUE" + NL
    t = t + "    rsSearch = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                low = line.Trim().Lower()" + NL
    t = t + "                IF low.StartsWith(""nameserver="") THEN" + NL
    t = t + "                    rsServer = low.Substring(11, low.Length - 11).Trim()" + NL
    t = t + "                    rsByDefault = FALSE" + NL
    t = t + "                END IF" + NL
    t = t + "                IF low.StartsWith(""search="") THEN rsSearch = low.Substring(7, low.Length - 7).Trim()" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF rsServer = ""none"" THEN rsServer = """"" + NL
    t = t + "    IF rsSearch.StartsWith(""."") THEN rsSearch = rsSearch.Substring(1, rsSearch.Length - 1)" + NL
    t = t + "    IF rsSearch.EndsWith(""."") THEN rsSearch = rsSearch.Substring(0, rsSearch.Length - 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The name server (a machine name or address), or """" for none." + NL
    t = t + "FUNCTION RsNameServer () AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsServer" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is it the central one, because RESOLV.INI doesn't say?" + NL
    t = t + "FUNCTION RsIsCentral () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsByDefault" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Makes server this machine's name server, keeping the rest of RESOLV.INI," + NL
    t = t + "' and forgets everything it knew. """" (or none) for no SimDNS at all;" + NL
    t = t + "' default for the central one again." + NL
    t = t + "SUB RsSave (server AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    server = server.Trim().Lower()" + NL
    t = t + "    IF server = """" THEN server = ""none""" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                IF line.Trim() <> """" AND NOT line.Trim().Lower().StartsWith(""nameserver="") THEN out.Add(line)" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "        IF server <> ""default"" THEN out.Insert(0, ""nameserver="" + server)" + NL
    t = t + "        IF out.Count = 0 THEN" + NL
    t = t + "            IF FS.Exists(RSINI) THEN FS.Delete(RSINI)" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Write(RSINI, out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsWhy = err" + NL
    t = t + "    END TRY" + NL
    t = t + "    rsRead = FALSE" + NL
    t = t + "    RsForget()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RsForget ()" + NL
    t = t + "    rsName.Clear()" + NL
    t = t + "    rsTo.Clear()" + NL
    t = t + "    rsCanon.Clear()" + NL
    t = t + "    rsUntil.Clear()" + NL
    t = t + "    rsDown = FALSE" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsIsAddress (s AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF s.Split(""."").Count <> 4 THEN RETURN FALSE" + NL
    t = t + "    FOR EACH p IN s.Split(""."")" + NL
    t = t + "        IF p = """" OR p.Length > 3 THEN RETURN FALSE" + NL
    t = t + "        FOR i = 0 TO p.Length - 1" + NL
    t = t + "            IF NOT ""0123456789"".Contains(p.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name the server is asked about: lower case, the search domain added" + NL
    t = t + "' to a single word." + NL
    t = t + "FUNCTION RsFull (host AS String) AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF h.EndsWith(""."") THEN h = h.Substring(0, h.Length - 1)" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch <> """" THEN h = h + ""."" + rsSearch" + NL
    t = t + "    RETURN h" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a name is in the list of answers, or -1 (old answers are dropped)." + NL
    t = t + "FUNCTION RsFind (host AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = rsName.IndexOf(host.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN -1" + NL
    t = t + "    IF SYS.Ticks > rsUntil[i] THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "        RETURN -1" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsWants (host AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(host) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(host) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for a mail domain's MX record." + NL
    t = t + "FUNCTION RsWantsMx (domain AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(domain) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(""mx:"" + domain.Trim().Lower()) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is host a name for the name server at all (whether known yet or not)?" + NL
    t = t + "FUNCTION RsAsks (host AS String) AS Bool" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF rsServer = """" OR h = """" OR h = ""localhost"" THEN RETURN FALSE" + NL
    t = t + "    IF rsDown AND SYS.Ticks - rsDownAt < RSQUIET THEN RETURN FALSE" + NL
    t = t + "    IF RsIsAddress(h) THEN RETURN FALSE" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch = """" THEN RETURN FALSE" + NL
    t = t + "    IF h = rsServer OR h = NET.HostName.Lower() THEN RETURN FALSE" + NL
    t = t + "    ' a machine's full name (bob.56k.net): SIM95's, never SimDNS's to answer" + NL
    t = t + "    IF RsIspName(h) THEN RETURN FALSE" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Does h end in one of SIM95's ISPs (56k.net, dialup.zone...)?" + NL
    t = t + "FUNCTION RsIspName (h AS String) AS Bool" + NL
    t = t + "    VAR isp AS String" + NL
    t = t + "    FOR EACH isp IN [""dialup.zone"", ""56k.net"", ""bbs.club"", ""modem.link"", ""beep.boop""]" + NL
    t = t + "        IF h = isp OR h.EndsWith(""."" + isp) THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Sends the question. A Connect, so it must be the last thing its handler" + NL
    t = t + "' does: if the name server refuses, the handler is spoiled (SIM95-NOTES.md)." + NL
    t = t + "SUB RsAsk (host AS String, address AS String)" + NL
    t = t + "    RsSend(host.Trim().Lower(), ""A"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Asks for a mail domain's MX records (also a Connect: the last thing)." + NL
    t = t + "SUB RsAskMx (domain AS String, address AS String)" + NL
    t = t + "    RsSend(""mx:"" + domain.Trim().Lower(), ""MX"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' key is the name, or mx: and the name; the answer is kept under it." + NL
    t = t + "SUB RsSend (key AS String, qtype AS String, address AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    IF IsNothing(rsSock) THEN" + NL
    t = t + "        rsSock = NET_Socket.New()" + NL
    t = t + "        rsSock.onMessage = Rs_OnMessage" + NL
    t = t + "    END IF" + NL
    t = t + "    name = key" + NL
    t = t + "    IF name.StartsWith(""mx:"") THEN name = name.Substring(3, name.Length - 3)" + NL
    t = t + "    rsAsking = key" + NL
    t = t + "    rsAskAt = SYS.Ticks" + NL
    t = t + "    rsRefused = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = rsSock.Connect(address, RSPORT)" + NL
    t = t + "        conn.Tag = ""rs:"" + key" + NL
    t = t + "        conn.Send(""QUERY "" + RsFull(name) + "" "" + qtype)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsRefused = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Gives up on the name server for a while: every name goes to SIM95." + NL
    t = t + "SUB RsGiveUp (why AS String)" + NL
    t = t + "    rsWhy = why" + NL
    t = t + "    rsDown = TRUE" + NL
    t = t + "    rsDownAt = SYS.Ticks" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "    rsServerAddr = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' For a program that fetches from a timer tick: TRUE when the tick must end" + NL
    t = t + "' now, because a question about host has just been sent (a Connect, so it" + NL
    t = t + "' has to be the last thing the handler does) or an answer is on its way." + NL
    t = t + "' FALSE when there is nothing to ask: RsTarget(host) is where to connect." + NL
    t = t + "' A name server that is missing, refuses or says nothing for RSWAIT is left" + NL
    t = t + "' alone for RSQUIET, and every name goes to SIM95: nothing ever hangs." + NL
    t = t + "FUNCTION RsNext (host AS String) AS Bool" + NL
    t = t + "    RETURN RsStep(host, FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for mail to domain: its MX record (the lowest preference), then" + NL
    t = t + "' the CNAMEs or address of the machine that names. RsMailTarget(domain) is" + NL
    t = t + "' then where to connect; with no MX, the domain's own machine; with no" + NL
    t = t + "' answer at all, the domain itself, for SIM95 to look up." + NL
    t = t + "FUNCTION RsNextMail (domain AS String) AS Bool" + NL
    t = t + "    IF RsStep(domain, TRUE) THEN RETURN TRUE" + NL
    t = t + "    RETURN RsStep(RsMailHost(domain), FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsStep (host AS String, mx AS Bool) AS Bool" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    ' another handler is finding the name server (it waits): wait for it" + NL
    t = t + "    IF rsLooking THEN" + NL
    t = t + "        IF SYS.Ticks - rsLookingAt < RSWAIT THEN RETURN TRUE" + NL
    t = t + "        rsLooking = FALSE" + NL
    t = t + "        RsGiveUp(""no answer about the machine "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF RsBusy() THEN RETURN TRUE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        IF NOT RsWantsMx(host) THEN RETURN FALSE" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF NOT RsWants(host) THEN RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    addr = RsServerAddress()" + NL
    t = t + "    IF addr = """" THEN RETURN FALSE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        RsAskMx(host, addr)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsAsk(host, addr)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name server's address, looked up once a minute (one lookup at a time:" + NL
    t = t + "' see SIM95-NOTES.md). """" when there is no such machine, and then it gives up." + NL
    t = t + "FUNCTION RsServerAddress () AS String" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    IF RsIsAddress(rsServer) THEN RETURN rsServer" + NL
    t = t + "    IF rsServerAddr <> """" AND rsServerFor = rsServer AND SYS.Ticks - rsServerAt < 60000 AND SYS.Ticks >= rsServerAt THEN RETURN rsServerAddr" + NL
    t = t + "    rsLooking = TRUE" + NL
    t = t + "    rsLookingAt = SYS.Ticks" + NL
    t = t + "    addr = NET.Resolve(rsServer)" + NL
    t = t + "    IF NOT rsLooking THEN RETURN """"" + NL
    t = t + "    rsLooking = FALSE" + NL
    t = t + "    IF addr = """" THEN" + NL
    t = t + "        RsGiveUp(""there is no machine called "" + rsServer)" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    rsServerAddr = addr" + NL
    t = t + "    rsServerFor = rsServer" + NL
    t = t + "    rsServerAt = SYS.Ticks" + NL
    t = t + "    RETURN addr" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsBusy () AS Bool" + NL
    t = t + "    IF rsAsking = """" THEN RETURN FALSE" + NL
    t = t + "    IF rsRefused THEN" + NL
    t = t + "        RsGiveUp(""the name server "" + rsServer + "" refused"")" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF SYS.Ticks - rsAskAt > RSWAIT THEN" + NL
    t = t + "        RsGiveUp(""no answer from the name server "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Rs_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    IF NOT conn.Tag.StartsWith(""rs:"") THEN RETURN" + NL
    t = t + "    h = conn.Tag.Substring(3, conn.Tag.Length - 3)" + NL
    t = t + "    conn.Tag = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        conn.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    RsTake(h, message)" + NL
    t = t + "    IF h = rsAsking THEN rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an answer: follows its CNAMEs to an address, or to the machine" + NL
    t = t + "' name the chain ends at." + NL
    t = t + "SUB RsTake (host AS String, reply AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR onward AS String" + NL
    t = t + "    VAR target AS String" + NL
    t = t + "    VAR canon AS String" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR hops AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    rsLastReply = reply" + NL
    t = t + "    IF host.StartsWith(""mx:"") THEN" + NL
    t = t + "        RsTakeMx(host, reply)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(host, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(host, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    cur = RsFull(host)" + NL
    t = t + "    canon = cur" + NL
    t = t + "    FOR hops = 0 TO 8" + NL
    t = t + "        onward = """"" + NL
    t = t + "        FOR i = 1 TO lines.Count - 1" + NL
    t = t + "            w = lines[i].Split("" "")" + NL
    t = t + "            IF w.Count >= 4 THEN" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""A"" AND target = """" THEN target = w[3]" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""CNAME"" THEN onward = w[3]" + NL
    t = t + "                IF w[0] = cur AND (w[2] = ""A"" OR w[2] = ""CNAME"") AND Int(Val(w[1])) < ttl THEN ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF target <> """" THEN" + NL
    t = t + "            canon = cur" + NL
    t = t + "            BREAK" + NL
    t = t + "        END IF" + NL
    t = t + "        IF onward = """" THEN BREAK" + NL
    t = t + "        canon = cur" + NL
    t = t + "        cur = onward" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF target = """" THEN" + NL
    t = t + "        ' a name with no CNAME and no address: not one to connect to" + NL
    t = t + "        IF cur = RsFull(host) THEN" + NL
    t = t + "            RsKeep(host, """", """", RSNEG)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        ' the end of the chain: a SIM95 machine name" + NL
    t = t + "        target = cur" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ttl < 5 THEN ttl = 5" + NL
    t = t + "    RsKeep(host, target, canon, ttl * 1000)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an MX answer: the mail machine with the lowest preference. With no" + NL
    t = t + "' MX, the server answers with the domain's CNAMEs instead, and the domain's" + NL
    t = t + "' own machine takes the mail." + NL
    t = t + "SUB RsTakeMx (key AS String, reply AS String)" + NL
    t = t + "    VAR domain AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR best AS String" + NL
    t = t + "    VAR pref AS Integer = 1000000" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    domain = key.Substring(3, key.Length - 3)" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(key, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RsKeep(domain, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(key, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 1 TO lines.Count - 1" + NL
    t = t + "        w = lines[i].Split("" "")" + NL
    t = t + "        IF w.Count >= 5 THEN" + NL
    t = t + "            IF w[2] = ""MX"" AND Int(Val(w[3])) < pref THEN" + NL
    t = t + "                pref = Int(Val(w[3]))" + NL
    t = t + "                best = w[4]" + NL
    t = t + "                ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF best <> """" THEN" + NL
    t = t + "        IF best.EndsWith(""."") THEN best = best.Substring(0, best.Length - 1)" + NL
    t = t + "        IF ttl < 5 THEN ttl = 5" + NL
    t = t + "        RsKeep(key, best, RsFull(domain), ttl * 1000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    RsTake(domain, reply)" + NL
    t = t + "    IF RsKnown(domain) THEN" + NL
    t = t + "        RsKeep(key, domain, RsFull(domain), RSNEG)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsKeep(key, """", """", RSNEG)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The machine (or name) that takes domain's mail: its MX, or domain itself." + NL
    t = t + "FUNCTION RsMailHost (domain AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN domain" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN domain" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where to connect for domain's mail." + NL
    t = t + "FUNCTION RsMailTarget (domain AS String) AS String" + NL
    t = t + "    RETURN RsTarget(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS say where domain's mail goes (an MX, or the domain's machine)?" + NL
    t = t + "FUNCTION RsMailKnown (domain AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN FALSE" + NL
    t = t + "    RETURN RsKnown(RsMailHost(domain)) OR NOT RsAsks(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB RsKeep (host AS String, target AS String, canon AS String, ms AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    i = rsName.IndexOf(h)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF rsName.Count >= RSMOST THEN" + NL
    t = t + "        rsName.RemoveAt(0)" + NL
    t = t + "        rsTo.RemoveAt(0)" + NL
    t = t + "        rsCanon.RemoveAt(0)" + NL
    t = t + "        rsUntil.RemoveAt(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    rsName.Add(h)" + NL
    t = t + "    rsTo.Add(target)" + NL
    t = t + "    rsCanon.Add(canon)" + NL
    t = t + "    rsUntil.Add(SYS.Ticks + ms)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where to connect for host: what SimDNS said, or host itself." + NL
    t = t + "FUNCTION RsTarget (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name host's machine was found under (www.coolsite.sim), or host." + NL
    t = t + "FUNCTION RsCanonical (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsCanon[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS answer for host (so RsTarget is its machine)?" + NL
    t = t + "FUNCTION RsKnown (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] <> """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did the name server say there is no such name (NXDOMAIN)?" + NL
    t = t + "FUNCTION RsNoSuchName (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] = """" AND rsCanon[i] = ""NXDOMAIN""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is the name server being left alone, because it didn't answer (or there" + NL
    t = t + "' is none)? rsWhy says why." + NL
    t = t + "FUNCTION RsSilent () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    IF rsServer = """" THEN RETURN TRUE" + NL
    t = t + "    RETURN rsDown AND SYS.Ticks - rsDownAt < RSQUIET" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\PROGRAMS\PLAYER.SPK")
END SUB
