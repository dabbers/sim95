' MAILD.SPK - the ColdMail mail server. Listens on port 25 and delivers mail.
'
' Two jobs:
'   1. Receive. Other machines' mail servers connect to port 25 and speak a small
'      SMTP: one command per message, one answer per command.
'          S: 220 ALPHA ColdMail ready
'          C: HELO BRAVO                      S: 250 Hello BRAVO
'          C: MAIL FROM:<bob@bravo>           S: 250 OK
'          C: RCPT TO:<ann@alpha>             S: 250 OK   (or 550 No such user here)
'          C: DATA + line break + the message S: 250 OK delivered
'          C: QUIT                            S: 221 Bye
'      SMTP sends DATA line by line; here the whole message is one network
'      message, so a letter must fit in 64K like everything else.
'   2. Send. The webmail pages cannot open sockets, so they leave each letter in
'      C:\MAILDATA\SPOOL. Every few seconds this program delivers what is there:
'      into a mailbox on this machine, or over port 25 to the recipient's machine.
'      A machine that does not answer is tried again later; a letter that cannot
'      be delivered comes back to its sender from MAILER-DAEMON.
'
' Mailboxes: C:\MAILDATA\BOX\<user>\<n>.MSG, listed in INBOX.TXT (and SENT.TXT)
' as  n|date|from|to|subject|size|flags  - flags holds N while a letter is unread.
' The webmail (C:\WEB\MAIL.SPK) reads and writes the same files.
'
' 3. Collect. Mail programs (Frostbird) connect to port 110 and speak a small
'    POP, one command and one answer per message, to read and send mail:
'          S: +OK ALPHA ColdMail POP ready
'          C: USER ann                  S: +OK
'          C: PASS secret               S: +OK 3 letters  (or -ERR)
'          C: LIST [INBOX|SENT]         S: +OK + one line per letter, as in INBOX.TXT
'          C: RETR 7                    S: +OK + the letter (and it is no longer unread)
'          C: DELE 7                    S: +OK
'          C: SEND + line break + To:/Subject: lines, a blank line, the text
'                                       S: +OK sent  (spooled like the webmail's)
'          C: QUIT                      S: +OK Bye
'
' C:\MAILDATA\MAILD.INI can set  retry=<seconds between tries>  and  tries=<count>.
'
' One SIM95 quirk shapes the sending loop: a failed wait (a Connect nobody
' answers, a Receive that times out) can be caught with TRY, but the handler it
' happened in is spoiled: the error comes back at its next wait, and at the
' next pause the interpreter takes every 512 statements. So after a failed
' delivery the tick ends at once, noting only which letter and why
' (pendingPath, pendingAnswer); the next tick, a fresh handler, writes down the
' retry or the bounce before anything else. The whole tick sits in a TRY with
' an empty CATCH and nothing after it, so a spoiled tick can only end. The
' failed letter then waits for its retry time and cannot hold up the others.

CONST DATA = "C:\MAILDATA"
CONST PORT = 25
CONST POPPORT = 110
CONST MAXBODY = 8000
CONST MAXTO = 10

VAR win AS GUI_Window
VAR log AS GUI_ListBox
VAR sock AS NET_Socket
VAR pop AS NET_Socket
VAR timer AS GUI_Timer
VAR busy AS Bool
VAR busySince AS Integer      ' a tick cut short by a spoiled handler leaves busy set; this lets go
VAR failed AS Bool            ' a wait failed in this tick: it must end now
VAR pendingPath AS String     ' the letter it was, for the next tick to settle
VAR pendingAnswer AS String
VAR outSock AS NET_Socket
VAR retry AS Integer = 30
VAR tries AS Integer = 5
VAR received AS Integer
VAR sent AS Integer

SUB Main ()
    win = GUI_Window.New("ColdMail Server", 460, 240)
    win.Icon = "network"
    win.onClose = Win_OnClose
    win.onResize = Win_OnResize
    log = GUI_ListBox.New(win)
    log.Mono = TRUE
    Win_OnResize()
    EnsureDirs()
    ReadSettings()

    sock = NET_Socket.New()
    sock.onConnect = Sock_OnConnect
    sock.onMessage = Sock_OnMessage
    sock.onError = Sock_OnError
    sock.Listen(PORT)
    Note("Listening on port " + Str(PORT) + " as " + NET.HostName)
    pop = NET_Socket.New()
    pop.onConnect = Pop_OnConnect
    pop.onMessage = Pop_OnMessage
    pop.onError = Sock_OnError
    pop.Listen(POPPORT)
    Note("Mail programs collect on port " + Str(POPPORT))

    timer = GUI_Timer.New(win)
    timer.Interval = 2000
    timer.onTick = Timer_OnTick
    timer.Start()
    Status()
    win.Show()
END SUB

SUB Win_OnResize ()
    log.SetBounds(0, 0, win.Width, win.Height)
END SUB

SUB Win_OnClose ()
    sock.Close()
    SYS.Exit(0)
END SUB

SUB Sock_OnError (message AS String)
    Note("ERROR " + message)
    IF message.Contains("in use") THEN Note("Is another mail server already running? See Tasks.")
END SUB

SUB Note (text AS String)
    log.Add(TIME.Clock + "  " + text)
    IF log.Count > 300 THEN log.RemoveAt(0)
    log.ScrollToEnd()
END SUB

SUB Status ()
    win.Status = NET.HostName.Lower() + " port " + Str(PORT) + " - " + Str(received) + " received, " + Str(sent) + " sent, " + Str(Spooled().Count) + " waiting"
END SUB

SUB EnsureDirs ()
    IF NOT FS.Exists(DATA) THEN FS.MakeDir(DATA)
    IF NOT FS.Exists(DATA + "\BOX") THEN FS.MakeDir(DATA + "\BOX")
    IF NOT FS.Exists(DATA + "\SPOOL") THEN FS.MakeDir(DATA + "\SPOOL")
    IF NOT FS.Exists(DATA + "\USERS") THEN FS.MakeDir(DATA + "\USERS")
END SUB

SUB ReadSettings ()
    VAR line AS String
    IF NOT FS.Exists(DATA + "\MAILD.INI") THEN RETURN
    FOR EACH line IN FS.Read(DATA + "\MAILD.INI").Lines()
        IF line.StartsWith("retry=") THEN retry = Int(Val(line.Substring(6, line.Length - 6)))
        IF line.StartsWith("tries=") THEN tries = Int(Val(line.Substring(6, line.Length - 6)))
    NEXT
END SUB

' ---------------------------------------------------------------- addresses

' "Ann <ann@alpha>" or "ann@alpha" -> "ann@alpha"
FUNCTION Bare (address AS String) AS String
    VAR a AS String
    a = address.Trim()
    IF a.Contains("<") AND a.Contains(">") THEN a = a.Substring(a.IndexOf("<") + 1, a.IndexOf(">") - a.IndexOf("<") - 1)
    RETURN a.Trim().Lower()
END FUNCTION

FUNCTION UserPart (address AS String) AS String
    IF NOT address.Contains("@") THEN RETURN address
    RETURN address.Substring(0, address.IndexOf("@"))
END FUNCTION

FUNCTION HostPart (address AS String) AS String
    IF NOT address.Contains("@") THEN RETURN ""
    RETURN address.Substring(address.IndexOf("@") + 1, address.Length - address.IndexOf("@") - 1)
END FUNCTION

' This machine by its full name, its computer name, or localhost.
FUNCTION IsLocal (host AS String) AS Bool
    VAR h AS String
    h = host.Upper()
    RETURN h = "" OR h = "LOCALHOST" OR h = NET.HostName.Upper() OR h = NET.HostName.Upper().Split(".")[0]
END FUNCTION

FUNCTION ValidUser (u AS String) AS Bool
    VAR i AS Integer
    IF u.Length < 3 OR u.Length > 8 THEN RETURN FALSE
    FOR i = 0 TO u.Length - 1
        IF NOT "abcdefghijklmnopqrstuvwxyz0123456789".Contains(u.CharAt(i)) THEN RETURN FALSE
    NEXT
    RETURN TRUE
END FUNCTION

FUNCTION HasMailbox (u AS String) AS Bool
    IF NOT ValidUser(u) THEN RETURN FALSE
    RETURN FS.Exists(DATA + "\USERS\" + u + ".TXT")
END FUNCTION

' ---------------------------------------------------------------- mailboxes

FUNCTION Esc (s AS String) AS String
    RETURN s.Replace("%", "%25").Replace("|", "%7C").Replace(Chr(13), "").Replace(Chr(10), "%0A")
END FUNCTION

' The value of one header line of a letter, or "".
FUNCTION Header (message AS String, name AS String) AS String
    VAR line AS String
    FOR EACH line IN message.Lines()
        IF line = "" THEN RETURN ""
        IF line.Lower().StartsWith(name.Lower() + ":") THEN RETURN line.Substring(name.Length + 1, line.Length - name.Length - 1).Trim()
    NEXT
    RETURN ""
END FUNCTION

' Puts a letter in a user's Inbox, unread. The webmail's SaveLetter does the same.
SUB Deliver (u AS String, message AS String)
    VAR dir AS String
    VAR n AS Integer
    dir = DATA + "\BOX\" + u
    IF NOT FS.Exists(dir) THEN FS.MakeDir(dir)
    n = 1
    IF FS.Exists(dir + "\NEXT.TXT") THEN n = Int(Val(FS.Read(dir + "\NEXT.TXT"))) + 1
    FS.Write(dir + "\NEXT.TXT", Str(n))
    FS.Write(dir + "\" + Str(n) + ".MSG", message)
    FS.Append(dir + "\INBOX.TXT", Str(n) + "|" + TIME.Date + " " + TIME.Clock.Substring(0, 5) + "|" + Esc(Header(message, "From")) + "|" + Esc(Header(message, "To")) + "|" + Esc(Header(message, "Subject")) + "|" + Str(message.Length) + "|N" + Chr(10))
    received = received + 1
END SUB

' Sends a letter that could not be delivered back to its (local) sender.
SUB Bounce (sender AS String, recipient AS String, reason AS String, message AS String)
    VAR u AS String
    VAR text AS String
    u = UserPart(sender)
    Note("Bounced to " + sender + ": " + reason)
    IF NOT IsLocal(HostPart(sender)) OR NOT HasMailbox(u) THEN RETURN
    IF Header(message, "From").Lower().Contains("mailer-daemon") THEN RETURN
    text = "From: Mail Delivery Subsystem <mailer-daemon@" + NET.HostName.Lower() + ">" + Chr(10) _
         + "To: " + sender + Chr(10) _
         + "Subject: Undeliverable: " + Header(message, "Subject") + Chr(10) _
         + "Date: " + TIME.Date + " " + TIME.Clock + Chr(10) + Chr(10) _
         + "This is the mail server on " + NET.HostName.Lower() + "." + Chr(10) + Chr(10) _
         + "I'm afraid I wasn't able to deliver your message to:" + Chr(10) + Chr(10) _
         + "    " + recipient + Chr(10) + "    " + reason + Chr(10) + Chr(10) _
         + "This is a permanent error. I've given up. Sorry it didn't work out." + Chr(10) + Chr(10) _
         + "------ This is a copy of your message ------" + Chr(10) + Chr(10) + message
    IF text.Length > 60000 THEN text = text.Substring(0, 60000)
    Deliver(u, text)
END SUB

' ---------------------------------------------------------------- receiving

' An answer to the other server. It may already have hung up (it sends QUIT
' and closes without waiting for "221 Bye"); that is no reason to stop.
SUB Reply (conn AS NET_Connection, text AS String)
    IF NOT conn.IsOpen THEN RETURN
    TRY
        conn.Send(text)
    CATCH err
    END TRY
END SUB

' Each connection's state lives in its Tag: helo|from|rcpt1,rcpt2
SUB Sock_OnConnect (conn AS NET_Connection)
    conn.Accept()
    conn.Tag = "||"
    Reply(conn, "220 " + NET.HostName + " ColdMail ready")
END SUB

SUB Sock_OnMessage (conn AS NET_Connection, message AS String)
    VAR state AS Array OF String
    VAR cmd AS String
    VAR arg AS String
    VAR who AS String
    VAR r AS String
    VAR body AS String
    state = conn.Tag.Split("|")
    cmd = message.Lines()[0].Trim()
    arg = ""
    IF cmd.Contains(":") THEN arg = cmd.Substring(cmd.IndexOf(":") + 1, cmd.Length - cmd.IndexOf(":") - 1)
    IF cmd.Contains(" ") AND arg = "" THEN arg = cmd.Substring(cmd.IndexOf(" ") + 1, cmd.Length - cmd.IndexOf(" ") - 1)
    cmd = cmd.Upper()

    IF cmd.StartsWith("HELO") OR cmd.StartsWith("EHLO") THEN
        state[0] = arg.Trim()
        Reply(conn, "250 Hello " + arg.Trim() + ", pleased to meet you")
    ELSEIF cmd.StartsWith("MAIL FROM") THEN
        state[1] = Bare(arg)
        state[2] = ""
        Reply(conn, "250 OK")
    ELSEIF cmd.StartsWith("RCPT TO") THEN
        who = Bare(arg)
        IF state[1] = "" THEN
            Reply(conn, "503 MAIL FROM first")
        ELSEIF NOT IsLocal(HostPart(who)) THEN
            Reply(conn, "551 I only take mail for " + NET.HostName.Lower())
        ELSEIF NOT HasMailbox(UserPart(who)) THEN
            Reply(conn, "550 No such user here: " + UserPart(who))
        ELSE
            IF state[2] <> "" THEN state[2] = state[2] + ","
            state[2] = state[2] + UserPart(who)
            Reply(conn, "250 OK")
        END IF
    ELSEIF cmd.StartsWith("DATA") THEN
        IF state[2] = "" THEN
            Reply(conn, "503 RCPT TO first")
        ELSE
            body = ""
            IF message.Contains(Chr(10)) THEN body = message.Substring(message.IndexOf(Chr(10)) + 1, message.Length - message.IndexOf(Chr(10)) - 1)
            body = "Received: from " + state[0] + " (" + conn.FromAddress + ") by " + NET.HostName.Lower() + "; " + TIME.Date + " " + TIME.Clock + Chr(10) + body
            FOR EACH r IN state[2].Split(",")
                Deliver(r, body)
            NEXT
            Note("Received mail from " + state[1] + " (" + conn.FromAddress + ") for " + state[2])
            state[1] = ""
            state[2] = ""
            Reply(conn, "250 OK delivered")
            Status()
        END IF
    ELSEIF cmd = "RSET" THEN
        state[1] = ""
        state[2] = ""
        Reply(conn, "250 OK")
    ELSEIF cmd = "NOOP" THEN
        Reply(conn, "250 OK")
    ELSEIF cmd = "QUIT" THEN
        Reply(conn, "221 Bye")
        conn.Close()
        RETURN
    ELSE
        Reply(conn, "500 What? I know HELO, MAIL FROM, RCPT TO, DATA, RSET, NOOP and QUIT")
    END IF
    conn.Tag = state.Join("|")
END SUB

' ---------------------------------------------------------------- collecting (port 110)

FUNCTION Unesc (s AS String) AS String
    RETURN s.Replace("%0A", Chr(10)).Replace("%7C", "|").Replace("%25", "%")
END FUNCTION

FUNCTION ReadOr (path AS String, fallback AS String) AS String
    IF FS.Exists(path) THEN RETURN FS.Read(path)
    RETURN fallback
END FUNCTION

' An account's setting (the webmail writes them: name, salt, pass).
FUNCTION Field (u AS String, key AS String) AS String
    VAR line AS String
    FOR EACH line IN ReadOr(DATA + "\USERS\" + u + ".TXT", "").Lines()
        IF line.StartsWith(key + "=") THEN RETURN Unesc(line.Substring(key.Length + 1, line.Length - key.Length - 1))
    NEXT
    RETURN ""
END FUNCTION

' The webmail's password hash, the same to the letter.
FUNCTION Hash (salt AS String, pw AS String) AS String
    VAR a AS Integer = 7
    VAR b AS Integer = 31337
    VAR i AS Integer
    VAR c AS Integer
    VAR s AS String
    s = salt + ":" + pw + ":" + salt
    FOR i = 0 TO s.Length - 1
        c = Asc(s.CharAt(i))
        a = (a * 131 + c) MOD 2147483629
        b = (b * 257 + c + a) MOD 2147483587
    NEXT
    RETURN Hex(a) + "-" + Hex(b)
END FUNCTION

FUNCTION Password (u AS String, pw AS String) AS Bool
    IF NOT HasMailbox(u) THEN RETURN FALSE
    RETURN Hash(Field(u, "salt"), pw) = Field(u, "pass")
END FUNCTION

' The index line of letter n in a user's folders, or "".
FUNCTION IndexLine (u AS String, n AS String, folder AS String) AS String
    VAR line AS String
    FOR EACH line IN ReadOr(DATA + "\BOX\" + u + "\" + folder, "").Lines()
        IF line.Split("|")[0] = n THEN RETURN line
    NEXT
    RETURN ""
END FUNCTION

SUB SwapIndex (u AS String, folder AS String, line AS String, other AS String)
    VAR text AS String
    text = Chr(10) + ReadOr(DATA + "\BOX\" + u + "\" + folder, "")
    IF other = "" THEN
        text = text.Replace(Chr(10) + line + Chr(10), Chr(10))
    ELSE
        text = text.Replace(Chr(10) + line + Chr(10), Chr(10) + other + Chr(10))
    END IF
    FS.Write(DATA + "\BOX\" + u + "\" + folder, text.Substring(1, text.Length - 1))
END SUB

' Each connection's state lives in its Tag: user|signed-in (1 or 0)
SUB Pop_OnConnect (conn AS NET_Connection)
    conn.Accept()
    conn.Tag = "|0"
    Reply(conn, "+OK " + NET.HostName + " ColdMail POP ready")
END SUB

SUB Pop_OnMessage (conn AS NET_Connection, message AS String)
    VAR u AS String
    VAR cmd AS String
    VAR arg AS String
    VAR line AS String
    VAR folder AS String
    VAR n AS Integer
    VAR answer AS String
    u = conn.Tag.Split("|")[0]
    cmd = message.Lines()[0].Trim()
    arg = ""
    IF cmd.Contains(" ") THEN arg = cmd.Substring(cmd.IndexOf(" ") + 1, cmd.Length - cmd.IndexOf(" ") - 1).Trim()
    IF cmd.Contains(" ") THEN cmd = cmd.Substring(0, cmd.IndexOf(" "))
    cmd = cmd.Upper()
    IF cmd = "QUIT" THEN
        Reply(conn, "+OK Bye")
        conn.Close()
        RETURN
    END IF
    IF cmd = "USER" THEN
        conn.Tag = UserPart(Bare(arg)) + "|0"
        Reply(conn, "+OK say PASS")
        RETURN
    END IF
    IF cmd = "PASS" THEN
        IF Password(u, arg) THEN
            conn.Tag = u + "|1"
            n = 0
            FOR EACH line IN ReadOr(DATA + "\BOX\" + u + "\INBOX.TXT", "").Lines()
                IF line <> "" THEN n = n + 1
            NEXT
            Note("Mail program signed in as " + u + " from " + conn.FromAddress)
            Reply(conn, "+OK " + Str(n) + " letters")
        ELSE
            Reply(conn, "-ERR That name and password do not match.")
        END IF
        RETURN
    END IF
    IF NOT conn.Tag.EndsWith("|1") THEN
        Reply(conn, "-ERR USER and PASS first")
        RETURN
    END IF
    SELECT CASE cmd
        CASE "STAT", "LIST"
            folder = "INBOX.TXT"
            IF arg.Upper() = "SENT" THEN folder = "SENT.TXT"
            Reply(conn, "+OK" + Chr(10) + ReadOr(DATA + "\BOX\" + u + "\" + folder, "").Trim())
        CASE "RETR"
            n = Int(Val(arg))
            IF NOT FS.Exists(DATA + "\BOX\" + u + "\" + Str(n) + ".MSG") THEN
                Reply(conn, "-ERR No letter " + arg)
            ELSE
                ' read now: the N flag goes, as when it is opened in the webmail
                line = IndexLine(u, Str(n), "INBOX.TXT")
                IF line <> "" AND line.EndsWith("|N") THEN SwapIndex(u, "INBOX.TXT", line, line.Substring(0, line.Length - 1))
                Reply(conn, "+OK" + Chr(10) + FS.Read(DATA + "\BOX\" + u + "\" + Str(n) + ".MSG"))
            END IF
        CASE "DELE"
            n = Int(Val(arg))
            FOR EACH folder IN ["INBOX.TXT", "SENT.TXT"]
                line = IndexLine(u, Str(n), folder)
                IF line <> "" THEN SwapIndex(u, folder, line, "")
            NEXT
            IF FS.Exists(DATA + "\BOX\" + u + "\" + Str(n) + ".MSG") THEN FS.Delete(DATA + "\BOX\" + u + "\" + Str(n) + ".MSG")
            Reply(conn, "+OK deleted")
        CASE "SEND"
            answer = SendFrom(u, message)
            IF answer = "" THEN
                Reply(conn, "+OK sent")
            ELSE
                Reply(conn, "-ERR " + answer)
            END IF
        CASE "NOOP"
            Reply(conn, "+OK")
        CASE ELSE
            Reply(conn, "-ERR I know USER, PASS, LIST, RETR, DELE, SEND, NOOP and QUIT")
    END SELECT
END SUB

' A letter from a mail program: "SEND", then To: and Subject: lines, a blank
' line and the text. It is spooled, and kept in Sent, just as the webmail does.
FUNCTION SendFrom (u AS String, message AS String) AS String
    VAR head AS String
    VAR text AS String
    VAR toList AS String
    VAR subject AS String
    VAR a AS String
    VAR rcpts AS Array OF String
    VAR letter AS String
    VAR n AS Integer
    VAR dir AS String
    message = message.Replace(Chr(13), "")
    IF message.Contains(Chr(10)) THEN message = message.Substring(message.IndexOf(Chr(10)) + 1, message.Length - message.IndexOf(Chr(10)) - 1)
    IF message.Contains(Chr(10) + Chr(10)) THEN
        head = message.Substring(0, message.IndexOf(Chr(10) + Chr(10)) + 1)
        text = message.Substring(message.IndexOf(Chr(10) + Chr(10)) + 2, message.Length - message.IndexOf(Chr(10) + Chr(10)) - 2)
    ELSE
        head = message + Chr(10)
    END IF
    toList = Header(head + Chr(10), "To")
    subject = Header(head + Chr(10), "Subject")
    IF text.Length > MAXBODY THEN RETURN "Keep letters under " + Str(MAXBODY) + " characters."
    FOR EACH a IN toList.Replace(";", ",").Split(",")
        a = Bare(a)
        IF a = "" THEN CONTINUE
        IF NOT a.Contains("@") THEN a = a + "@" + NET.HostName.Lower()
        IF NOT ValidUser(UserPart(a)) OR HostPart(a) = "" THEN RETURN "'" + a + "' is not an address. Addresses look like ann@alpha."
        IF NOT rcpts.Contains(a) THEN rcpts.Add(a)
    NEXT
    IF rcpts.Count = 0 THEN RETURN "Who is it to?"
    IF rcpts.Count > MAXTO THEN RETURN "Send it to " + Str(MAXTO) + " people at most."
    IF subject = "" THEN subject = "(no subject)"
    IF subject.Length > 100 THEN subject = subject.Substring(0, 100)
    letter = "From: " + Field(u, "name") + " <" + u + "@" + NET.HostName.Lower() + ">" + Chr(10) _
           + "To: " + rcpts.Join(", ") + Chr(10) _
           + "Subject: " + subject + Chr(10) _
           + "Date: " + TIME.Date + " " + TIME.Clock + Chr(10) _
           + "X-Mailer: Frostbird 1.0 (SIM95)" + Chr(10) + Chr(10) + text
    FOR EACH a IN rcpts
        n = Int(Val(ReadOr(DATA + "\SPOOLID.TXT", "0"))) + 1
        FS.Write(DATA + "\SPOOLID.TXT", Str(n))
        FS.Write(DATA + "\SPOOL\" + Str(n) + ".MSG", "X-Sender: " + u + "@" + NET.HostName.Lower() + Chr(10) + "X-Recipient: " + a + Chr(10) + "X-Tries: 0" + Chr(10) + "X-Next: 0" + Chr(10) + Chr(10) + letter)
    NEXT
    ' a copy in Sent
    dir = DATA + "\BOX\" + u
    n = 1
    IF FS.Exists(dir + "\NEXT.TXT") THEN n = Int(Val(FS.Read(dir + "\NEXT.TXT"))) + 1
    FS.Write(dir + "\NEXT.TXT", Str(n))
    FS.Write(dir + "\" + Str(n) + ".MSG", letter)
    FS.Append(dir + "\SENT.TXT", Str(n) + "|" + TIME.Date + " " + TIME.Clock.Substring(0, 5) + "|" + Esc(Header(letter, "From")) + "|" + Esc(Header(letter, "To")) + "|" + Esc(subject) + "|" + Str(letter.Length) + "|" + Chr(10))
    Note(u + " sent mail from a mail program to " + rcpts.Join(", "))
    RETURN ""
END FUNCTION

' ---------------------------------------------------------------- sending

' A spooled letter is C:\MAILDATA\SPOOL\<n>.MSG:
'   X-Sender: ann@alpha
'   X-Recipient: bob@bravo
'   X-Tries: 0
'   X-Next: 0            (TIME.Now when it may be tried again)
'   (blank line, then the letter itself)

FUNCTION Spooled () AS Array OF String
    VAR out AS Array OF String
    VAR f AS String
    FOR EACH f IN FS.List(DATA + "\SPOOL")
        IF f.EndsWith(".MSG") THEN out.Add(f)
    NEXT
    RETURN out
END FUNCTION

SUB Timer_OnTick ()
    TRY
        Tick()
    CATCH err
    END TRY
END SUB

SUB Tick ()
    VAR f AS String
    IF busy AND TIME.Now - busySince < 20 THEN RETURN
    busy = TRUE
    busySince = TIME.Now
    FS.Write(DATA + "\ALIVE.TXT", Str(TIME.Now))
    failed = FALSE
    IF pendingPath <> "" THEN Settle()
    TRY
        FOR EACH f IN Spooled()
            Attempt(DATA + "\SPOOL\" + f)
            IF failed THEN RETURN
        NEXT
    CATCH err
        IF failed THEN RETURN
        Note("ERROR " + err)
    END TRY
    busy = FALSE
    Status()
END SUB

' Finishes the letter a spoiled tick left behind.
SUB Settle ()
    VAR path AS String
    VAR answer AS String
    VAR text AS String
    VAR head AS String
    path = pendingPath
    answer = pendingAnswer
    pendingPath = ""
    pendingAnswer = ""
    IF NOT IsNothing(outSock) THEN outSock.Close()
    IF answer = "" THEN answer = "421 interrupted"
    IF NOT FS.Exists(path) THEN RETURN
    text = FS.Read(path)
    head = text.Substring(0, text.IndexOf(Chr(10) + Chr(10)))
    Conclude(path, Header(head, "X-Sender"), Header(head, "X-Recipient"), Int(Val(Header(head, "X-Tries"))), text.Substring(head.Length + 2, text.Length - head.Length - 2), answer)
END SUB

SUB Attempt (path AS String)
    VAR text AS String
    VAR head AS String
    VAR letter AS String
    VAR sender AS String
    VAR recipient AS String
    VAR n AS Integer
    VAR answer AS String
    IF NOT FS.Exists(path) THEN RETURN
    text = FS.Read(path)
    IF NOT text.Contains(Chr(10) + Chr(10)) THEN
        FS.Delete(path)
        RETURN
    END IF
    head = text.Substring(0, text.IndexOf(Chr(10) + Chr(10)))
    letter = text.Substring(head.Length + 2, text.Length - head.Length - 2)
    sender = Header(head, "X-Sender")
    recipient = Header(head, "X-Recipient")
    n = Int(Val(Header(head, "X-Tries")))
    IF Int(Val(Header(head, "X-Next"))) > TIME.Now THEN RETURN

    IF IsLocal(HostPart(recipient)) THEN
        IF HasMailbox(UserPart(recipient)) THEN
            Deliver(UserPart(recipient), "Received: by " + NET.HostName.Lower() + "; " + TIME.Date + " " + TIME.Clock + Chr(10) + letter)
            Note("Delivered " + sender + " -> " + recipient)
            sent = sent + 1
        ELSE
            Bounce(sender, recipient, "550 No such user here: " + UserPart(recipient), letter)
        END IF
        FS.Delete(path)
        RETURN
    END IF

    pendingPath = path
    pendingAnswer = ""
    answer = Transfer(sender, recipient, letter)
    IF failed THEN RETURN
    pendingPath = ""
    Conclude(path, sender, recipient, n, letter, answer)
END SUB

' What happens to a letter after one try at sending it.
SUB Conclude (path AS String, sender AS String, recipient AS String, n AS Integer, letter AS String, answer AS String)
    IF answer.StartsWith("250") THEN
        Note("Sent " + sender + " -> " + recipient)
        sent = sent + 1
        FS.Delete(path)
    ELSEIF answer.StartsWith("5") THEN
        Bounce(sender, recipient, answer, letter)
        FS.Delete(path)
    ELSEIF n + 1 >= tries THEN
        Bounce(sender, recipient, "Gave up after " + Str(n + 1) + " tries: " + answer, letter)
        FS.Delete(path)
    ELSE
        Note("Will try " + recipient + " again: " + answer)
        FS.Write(path, "X-Sender: " + sender + Chr(10) + "X-Recipient: " + recipient + Chr(10) + "X-Tries: " + Str(n + 1) + Chr(10) + "X-Next: " + Str(TIME.Now + retry) + Chr(10) + Chr(10) + letter)
    END IF
END SUB

' Hands one letter to the recipient's mail server. Returns its final answer:
' "250 ..." delivered, "5xx ..." refused for good, anything else: try later.
FUNCTION Transfer (sender AS String, recipient AS String, letter AS String) AS String
    VAR conn AS NET_Connection
    VAR answer AS String
    outSock = NET_Socket.New()
    TRY
        conn = outSock.Connect(HostPart(recipient), PORT)
    CATCH err
        failed = TRUE
        pendingAnswer = "421 " + err
        busy = FALSE
        RETURN pendingAnswer
    END TRY
    TRY
        answer = conn.Receive(5000)
        IF NOT answer.StartsWith("220") THEN THROW answer
        conn.Send("HELO " + NET.HostName)
        answer = conn.Receive(5000)
        conn.Send("MAIL FROM:<" + sender + ">")
        answer = conn.Receive(5000)
        IF NOT answer.StartsWith("250") THEN THROW answer
        conn.Send("RCPT TO:<" + recipient + ">")
        answer = conn.Receive(5000)
        IF NOT answer.StartsWith("250") THEN THROW answer
        conn.Send("DATA" + Chr(10) + letter)
        answer = conn.Receive(10000)
        IF NOT answer.StartsWith("250") THEN THROW answer
        conn.Send("QUIT")
    CATCH err
        ' An answer we THREW ourselves leaves the handler fine; a failed Receive does not.
        IF NOT (err.StartsWith("5") OR err.StartsWith("4") OR err.StartsWith("2")) THEN
            failed = TRUE
            pendingAnswer = "421 " + err
            busy = FALSE
            RETURN pendingAnswer
        END IF
        answer = err
    END TRY
    outSock.Close()
    RETURN answer
END FUNCTION
