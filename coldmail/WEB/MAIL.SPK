' MAIL.SPK - ColdMail webmail, shared by its pages, which are this machine's home page (C:\WEB).
'
' The pages cannot open network connections, so they never talk to another
' machine themselves. Sending leaves a letter in C:\MAILDATA\SPOOL for the mail
' server (C:\PROGRAMS\MAILD.SPK) to deliver; reading looks at the mailbox files
' the mail server fills in. The two agree on these files:
'
'   C:\MAILDATA\USERS\<user>.TXT      an account: name, salt, pass (key=value)
'   C:\MAILDATA\SESSIONS\<id>.TXT     who a sign-in cookie belongs to, and its form token
'   C:\MAILDATA\BOX\<user>\<n>.MSG    one letter: headers, a blank line, the text
'   C:\MAILDATA\BOX\<user>\INBOX.TXT  n|date|from|to|subject|size|flags, N = unread
'   C:\MAILDATA\BOX\<user>\SENT.TXT   the same, for letters they sent
'   C:\MAILDATA\BOX\<user>\NEXT.TXT   the last letter number used
'   C:\MAILDATA\SPOOL\<n>.MSG         a letter waiting for the mail server
'   C:\MAILDATA\ALIVE.TXT             when the mail server last looked at the spool
'
' Everything is written to disk the moment it changes. Pages are sent as one
' 64K network message, so long lists and long letters are cut short on screen.

CONST DATADIR = "C:\MAILDATA"
CONST COOKIE = "coldmail"
CONST MAXSUBJECT = 100
CONST MAXBODY = 8000
CONST MAXTO = 10
CONST MAXNAME = 40
CONST PAGEROOM = 30000

VAR viewer AS String
VAR formToken AS String

' ---------------------------------------------------------------- text

FUNCTION ReadOr (path AS String, fallback AS String) AS String
    IF FS.Exists(path) THEN RETURN FS.Read(path)
    RETURN fallback
END FUNCTION

FUNCTION Esc (s AS String) AS String
    RETURN s.Replace("%", "%25").Replace("|", "%7C").Replace(Chr(13), "").Replace(Chr(10), "%0A")
END FUNCTION

FUNCTION Unesc (s AS String) AS String
    RETURN s.Replace("%0A", Chr(10)).Replace("%7C", "|").Replace("%25", "%")
END FUNCTION

FUNCTION H (s AS String) AS String
    RETURN SERVER.HtmlEncode(s)
END FUNCTION

FUNCTION UrlEnc (s AS String) AS String
    RETURN SERVER.UrlEncode(s)
END FUNCTION

FUNCTION OnlyFrom (s AS String, allowed AS String) AS Bool
    VAR i AS Integer
    FOR i = 0 TO s.Length - 1
        IF NOT allowed.Contains(s.CharAt(i)) THEN RETURN FALSE
    NEXT
    RETURN TRUE
END FUNCTION

FUNCTION ValidName (u AS String) AS Bool
    IF u.Length < 3 OR u.Length > 8 THEN RETURN FALSE
    RETURN OnlyFrom(u, "abcdefghijklmnopqrstuvwxyz0123456789")
END FUNCTION

FUNCTION Clip (s AS String, most AS Integer) AS String
    s = s.Replace(Chr(13), "").Trim()
    IF s.Length > most THEN s = s.Substring(0, most)
    RETURN s
END FUNCTION

FUNCTION IsNumber (s AS String) AS Bool
    IF s = "" OR s.Length > 8 THEN RETURN FALSE
    RETURN OnlyFrom(s, "0123456789")
END FUNCTION

' At most room characters of page-safe text, never cut inside an &entity;.
FUNCTION HtmlUpTo (s AS String, room AS Integer) AS String
    VAR out AS String
    out = H(s)
    IF out.Length <= room THEN RETURN out
    out = out.Substring(0, room)
    IF out.Substring(out.Length - 8, 8).Contains("&") THEN out = out.Substring(0, out.Length - 8 + out.Substring(out.Length - 8, 8).IndexOf("&"))
    RETURN out + Chr(10) + Chr(10) + "[ColdMail stopped here: the rest is too long to show on one page.]"
END FUNCTION

' ---------------------------------------------------------------- accounts

SUB EnsureDisk ()
    VAR dir AS String
    VAR dirs AS Array OF String
    dirs = ["", "\USERS", "\SESSIONS", "\BOX", "\SPOOL"]
    FOR EACH dir IN dirs
        IF NOT FS.Exists(DATADIR + dir) THEN FS.MakeDir(DATADIR + dir)
    NEXT
END SUB

FUNCTION UserPath (u AS String) AS String
    RETURN DATADIR + "\USERS\" + u + ".TXT"
END FUNCTION

FUNCTION UserExists (u AS String) AS Bool
    IF NOT ValidName(u) THEN RETURN FALSE
    RETURN FS.Exists(UserPath(u))
END FUNCTION

FUNCTION Field (u AS String, key AS String) AS String
    VAR line AS String
    FOR EACH line IN FS.Read(UserPath(u)).Lines()
        IF line.StartsWith(key + "=") THEN RETURN Unesc(line.Substring(key.Length + 1, line.Length - key.Length - 1))
    NEXT
    RETURN ""
END FUNCTION

FUNCTION Hash (salt AS String, pw AS String) AS String
    VAR a AS Integer = 7
    VAR b AS Integer = 31337
    VAR i AS Integer
    VAR c AS Integer
    VAR s AS String
    s = salt + ":" + pw + ":" + salt
    FOR i = 0 TO s.Length - 1
        c = Asc(s.CharAt(i))
        a = (a * 131 + c) MOD 2147483629
        b = (b * 257 + c + a) MOD 2147483587
    NEXT
    RETURN Hex(a) + "-" + Hex(b)
END FUNCTION

FUNCTION NewToken () AS String
    RETURN Hex(268435456 + Rnd(1879048191))
END FUNCTION

FUNCTION CreateUser (u AS String, pw AS String, name AS String) AS String
    VAR salt AS String
    EnsureDisk()
    IF NOT ValidName(u) THEN RETURN "Pick a mail name of 3 to 8 letters or digits."
    IF FS.Exists(UserPath(u)) THEN RETURN "Somebody already has " + u + "@" + NET.HostName.Lower() + "."
    IF u = "postmast" OR u = "mailer" OR u = "root" OR u = "admin" THEN RETURN "That name is spoken for."
    IF pw.Length < 4 THEN RETURN "Pick a password of at least 4 characters."
    name = Clip(name, MAXNAME).Replace("<", "").Replace(">", "").Replace(",", "")
    IF name = "" THEN RETURN "Tell us your name."
    salt = NewToken()
    FS.Write(UserPath(u), "name=" + Esc(name) + Chr(10) + "salt=" + salt + Chr(10) + "pass=" + Hash(salt, pw) + Chr(10) + "joined=" + TIME.Date)
    FS.MakeDir(DATADIR + "\BOX\" + u)
    RETURN ""
END FUNCTION

FUNCTION CheckPassword (u AS String, pw AS String) AS Bool
    IF NOT UserExists(u) THEN RETURN FALSE
    RETURN Hash(Field(u, "salt"), pw) = Field(u, "pass")
END FUNCTION

' ---------------------------------------------------------------- sessions
' The same scheme as SimBook: a cookie names a session file holding the user
' and a form token, and every form that changes something carries the token.

SUB SignIn (u AS String)
    VAR token AS String
    EnsureDisk()
    token = NewToken()
    FS.Write(DATADIR + "\SESSIONS\" + token + ".TXT", u + Chr(10) + NewToken() + NewToken())
    RESPONSE.SetCookie(COOKIE, token)
END SUB

FUNCTION SessionPath () AS String
    VAR token AS String
    token = REQUEST.Cookie(COOKIE)
    IF token = "" OR token.Length > 8 THEN RETURN ""
    IF NOT OnlyFrom(token, "0123456789ABCDEF") THEN RETURN ""
    RETURN DATADIR + "\SESSIONS\" + token + ".TXT"
END FUNCTION

SUB SignOut ()
    VAR path AS String
    path = SessionPath()
    IF path <> "" THEN
        IF FS.Exists(path) THEN FS.Delete(path)
    END IF
    RESPONSE.SetCookie(COOKIE, "")
END SUB

FUNCTION CurrentUser () AS String
    VAR path AS String
    VAR lines AS Array OF String
    path = SessionPath()
    IF path = "" THEN RETURN ""
    IF NOT FS.Exists(path) THEN RETURN ""
    lines = FS.Read(path).Lines()
    IF lines.Count < 2 OR NOT UserExists(lines[0].Trim()) THEN RETURN ""
    formToken = lines[1].Trim()
    RETURN lines[0].Trim()
END FUNCTION

SUB RequireLogin ()
    viewer = CurrentUser()
    IF viewer = "" THEN RESPONSE.Redirect("index.asp")
END SUB

SUB RequireToken ()
    VAR sent AS String
    sent = REQUEST.Form("t")
    IF sent = "" THEN sent = REQUEST.Query("t")
    IF sent = "" OR sent <> formToken THEN RESPONSE.Redirect("inbox.asp?why=" + UrlEnc("That did not come from a ColdMail page, so nothing was changed."))
END SUB

FUNCTION TokenField () AS String
    RETURN "<input type=""hidden"" name=""t"" value=""" + formToken + """>"
END FUNCTION

' ---------------------------------------------------------------- addresses

FUNCTION MyAddress (u AS String) AS String
    RETURN u + "@" + NET.HostName.Lower()
END FUNCTION

' "Ann <ann@alpha>" or "ann@alpha" -> "ann@alpha"
FUNCTION Bare (address AS String) AS String
    VAR a AS String
    a = address.Trim()
    IF a.Contains("<") AND a.Contains(">") THEN a = a.Substring(a.IndexOf("<") + 1, a.IndexOf(">") - a.IndexOf("<") - 1)
    RETURN a.Trim().Lower()
END FUNCTION

' "Ann <ann@alpha>" -> "Ann"; a bare address stays itself.
FUNCTION DisplayName (address AS String) AS String
    IF address.Contains("<") THEN RETURN address.Substring(0, address.IndexOf("<")).Trim()
    RETURN address.Trim()
END FUNCTION

' user@host: a 3-8 letter user (every ColdMail name is one) and a machine name.
FUNCTION ValidAddress (a AS String) AS Bool
    VAR at AS Integer
    at = a.IndexOf("@")
    IF at < 0 THEN RETURN FALSE
    IF NOT ValidName(a.Substring(0, at)) THEN RETURN FALSE
    IF a.Length - at - 1 < 1 OR a.Length - at - 1 > 40 THEN RETURN FALSE
    RETURN OnlyFrom(a.Substring(at + 1, a.Length - at - 1), "abcdefghijklmnopqrstuvwxyz0123456789.-")
END FUNCTION

' ---------------------------------------------------------------- letters

FUNCTION BoxDir (u AS String) AS String
    RETURN DATADIR + "\BOX\" + u
END FUNCTION

FUNCTION FolderFile (f AS String) AS String
    IF f = "sent" THEN RETURN "SENT.TXT"
    RETURN "INBOX.TXT"
END FUNCTION

' The folder's lines, oldest first.
FUNCTION Folder (u AS String, f AS String) AS Array OF String
    VAR all AS Array OF String
    VAR out AS Array OF String
    VAR line AS String
    all = ReadOr(BoxDir(u) + "\" + FolderFile(f), "").Lines()
    FOR EACH line IN all
        IF line <> "" THEN out.Add(line)
    NEXT
    RETURN out
END FUNCTION

FUNCTION FindIndex (u AS String, f AS String, n AS String) AS String
    VAR text AS String
    VAR at AS Integer
    IF NOT IsNumber(n) THEN RETURN ""
    text = Chr(10) + ReadOr(BoxDir(u) + "\" + FolderFile(f), "")
    at = text.IndexOf(Chr(10) + n + "|")
    IF at < 0 THEN RETURN ""
    text = text.Substring(at + 1, text.Length - at - 1)
    IF text.Contains(Chr(10)) THEN text = text.Substring(0, text.IndexOf(Chr(10)))
    RETURN text
END FUNCTION

FUNCTION Unread (u AS String) AS Integer
    VAR line AS String
    VAR n AS Integer
    FOR EACH line IN Folder(u, "inbox")
        IF line.EndsWith("|N") THEN n = n + 1
    NEXT
    RETURN n
END FUNCTION

FUNCTION LoadLetter (u AS String, n AS String) AS String
    RETURN ReadOr(BoxDir(u) + "\" + n + ".MSG", "")
END FUNCTION

' The value of one header of a letter, or "".
FUNCTION Header (letter AS String, name AS String) AS String
    VAR line AS String
    FOR EACH line IN letter.Lines()
        IF line = "" THEN RETURN ""
        IF line.Lower().StartsWith(name.Lower() + ":") THEN RETURN line.Substring(name.Length + 1, line.Length - name.Length - 1).Trim()
    NEXT
    RETURN ""
END FUNCTION

FUNCTION Body (letter AS String) AS String
    IF NOT letter.Contains(Chr(10) + Chr(10)) THEN RETURN ""
    RETURN letter.Substring(letter.IndexOf(Chr(10) + Chr(10)) + 2, letter.Length - letter.IndexOf(Chr(10) + Chr(10)) - 2)
END FUNCTION

' text with one whole line swapped for another ("" takes it out). The line
' breaks around it make sure a line that merely ends the same way is left alone.
FUNCTION SwapLine (text AS String, line AS String, other AS String) AS String
    IF other = "" THEN
        text = (Chr(10) + text).Replace(Chr(10) + line + Chr(10), Chr(10))
    ELSE
        text = (Chr(10) + text).Replace(Chr(10) + line + Chr(10), Chr(10) + other + Chr(10))
    END IF
    RETURN text.Substring(1, text.Length - 1)
END FUNCTION

SUB MarkRead (u AS String, line AS String)
    VAR path AS String
    IF NOT line.EndsWith("|N") THEN RETURN
    path = BoxDir(u) + "\INBOX.TXT"
    FS.Write(path, SwapLine(FS.Read(path), line, line.Substring(0, line.Length - 1)))
END SUB

' Files a letter in one of u's folders, the way the mail server files the Inbox.
SUB SaveLetter (u AS String, f AS String, letter AS String, flags AS String)
    VAR dir AS String
    VAR n AS Integer
    dir = BoxDir(u)
    IF NOT FS.Exists(dir) THEN FS.MakeDir(dir)
    n = Int(Val(ReadOr(dir + "\NEXT.TXT", "0"))) + 1
    FS.Write(dir + "\NEXT.TXT", Str(n))
    FS.Write(dir + "\" + Str(n) + ".MSG", letter)
    FS.Append(dir + "\" + FolderFile(f), Str(n) + "|" + TIME.Date + " " + TIME.Clock.Substring(0, 5) + "|" + Esc(Header(letter, "From")) + "|" + Esc(Header(letter, "To")) + "|" + Esc(Header(letter, "Subject")) + "|" + Str(letter.Length) + "|" + flags + Chr(10))
END SUB

SUB DeleteLetter (u AS String, f AS String, line AS String)
    VAR path AS String
    VAR n AS String
    n = line.Split("|")[0]
    path = BoxDir(u) + "\" + FolderFile(f)
    FS.Write(path, SwapLine(FS.Read(path), line, ""))
    IF FS.Exists(BoxDir(u) + "\" + n + ".MSG") THEN FS.Delete(BoxDir(u) + "\" + n + ".MSG")
END SUB

' Writes a letter and leaves a copy for each recipient in the spool for the mail
' server. Returns "" or what is wrong.
FUNCTION Send (u AS String, toList AS String, subject AS String, text AS String) AS String
    VAR names AS Array OF String
    VAR rcpts AS Array OF String
    VAR a AS String
    VAR letter AS String
    VAR n AS Integer
    subject = Clip(subject, MAXSUBJECT)
    text = text.Replace(Chr(13), "")
    IF text.Length > MAXBODY THEN RETURN "Keep letters under " + Str(MAXBODY) + " characters."
    names = toList.Replace(";", ",").Split(",")
    FOR EACH a IN names
        a = Bare(a)
        IF a = "" THEN CONTINUE
        IF NOT a.Contains("@") THEN a = a + "@" + NET.HostName.Lower()
        IF NOT ValidAddress(a) THEN RETURN "'" + a + "' is not an address. Addresses look like ann@alpha."
        IF NOT rcpts.Contains(a) THEN rcpts.Add(a)
    NEXT
    IF rcpts.Count = 0 THEN RETURN "Who is it to?"
    IF rcpts.Count > MAXTO THEN RETURN "Send it to " + Str(MAXTO) + " people at most."
    IF subject = "" THEN subject = "(no subject)"
    EnsureDisk()
    letter = "From: " + Field(u, "name") + " <" + MyAddress(u) + ">" + Chr(10) _
           + "To: " + rcpts.Join(", ") + Chr(10) _
           + "Subject: " + subject + Chr(10) _
           + "Date: " + TIME.Date + " " + TIME.Clock + Chr(10) _
           + "X-Mailer: ColdMail 1.0 (SIM95)" + Chr(10) + Chr(10) + text
    FOR EACH a IN rcpts
        n = Int(Val(ReadOr(DATADIR + "\SPOOLID.TXT", "0"))) + 1
        FS.Write(DATADIR + "\SPOOLID.TXT", Str(n))
        FS.Write(DATADIR + "\SPOOL\" + Str(n) + ".MSG", "X-Sender: " + MyAddress(u) + Chr(10) + "X-Recipient: " + a + Chr(10) + "X-Tries: 0" + Chr(10) + "X-Next: 0" + Chr(10) + Chr(10) + letter)
    NEXT
    SaveLetter(u, "sent", letter, "")
    RETURN ""
END FUNCTION

' Has the mail server looked at the spool in the last half minute?
FUNCTION ServerAlive () AS Bool
    RETURN TIME.Now - Int(Val(ReadOr(DATADIR + "\ALIVE.TXT", "0"))) < 30
END FUNCTION

FUNCTION Waiting () AS Integer
    RETURN FS.List(DATADIR + "\SPOOL").Count
END FUNCTION

' ---------------------------------------------------------------- page furniture

FUNCTION Top (title AS String) AS String
    VAR s AS String
    VAR n AS Integer
    s = "<html><head><title>" + H(title) + " - ColdMail</title></head>" _
      + "<body bgcolor=""#FFFFFF"" text=""#000000"" link=""#003399"" vlink=""#003399"">" _
      + "<table width=""100%"" cellpadding=""6"" cellspacing=""0"" bgcolor=""#99CCFF""><tr>" _
      + "<td><a href=""index.asp""><font size=""6"" color=""#003399""><b><i>Cold</i>Mail!</b></font></a>" _
      + "<br><font size=""1"" color=""#003366"">Hot mail is so last year.</font></td>" _
      + "<td align=""right"" valign=""bottom""><font size=""2"">"
    IF viewer <> "" THEN
        n = Unread(viewer)
        s = s + "<b>" + H(MyAddress(viewer)) + "</b><br>" _
              + "<a href=""inbox.asp"">Inbox"
        IF n > 0 THEN s = s + " (" + Str(n) + ")"
        s = s + "</a> | <a href=""compose.asp"">Compose</a> | <a href=""inbox.asp?f=sent"">Sent</a> | " _
              + "<a href=""logout.asp?t=" + formToken + """>Sign Out</a>"
    END IF
    RETURN s + "</font></td></tr></table>"
END FUNCTION

FUNCTION Bottom () AS String
    RETURN "<hr><center><font size=""1"" color=""#808080"">ColdMail on " + H(NET.HostName.Lower()) + " &middot; mail is delivered by C:\PROGRAMS\MAILD.SPK on port 25 &middot; <a href=""coldmail.htm"">About ColdMail</a></font></center></body></html>"
END FUNCTION

FUNCTION BoxTop (title AS String) AS String
    RETURN "<table width=""100%"" cellpadding=""3"" cellspacing=""0""><tr><td bgcolor=""#003399""><font color=""#FFFFFF"" size=""2""><b>" + title + "</b></font></td></tr></table>"
END FUNCTION

FUNCTION Notice (text AS String) AS String
    IF text = "" THEN RETURN ""
    RETURN "<table width=""100%"" cellpadding=""4""><tr><td bgcolor=""#FFF9D7""><font size=""2"">" + H(text) + "</font></td></tr></table>"
END FUNCTION

' A warning when letters cannot leave this machine.
FUNCTION ServerWarning () AS String
    IF ServerAlive() THEN RETURN ""
    RETURN "<table width=""100%"" cellpadding=""4""><tr><td bgcolor=""#FFDDDD""><font size=""2""><b>The mail server is not running.</b> " _
         + "Letters will wait in the outbox (" + Str(Waiting()) + " now) until someone starts C:\PROGRAMS\MAILD.SPK on " + H(NET.HostName.Lower()) + ".</font></td></tr></table>"
END FUNCTION

' The same counting text box as SimBook's: the button (id="go") greys out
' while the box holds more than it may.
FUNCTION LimitedBox (name AS String, value AS String, rows AS Integer, cols AS Integer, most AS Integer) AS String
    RETURN "<textarea name=""" + name + """ id=""" + name + """ rows=""" + Str(rows) + """ cols=""" + Str(cols) + """ onchange=""Limits_Check"">" + H(value) + "</textarea><br>" _
         + "<font size=""1"" color=""#808080"" id=""" + name + "_n"">up to " + Str(most) + " characters</font>"
END FUNCTION

FUNCTION LimitScript (name AS String, most AS Integer) AS String
    RETURN "<script type=""spark"">" + Chr(10) _
         + "SUB Limits_Check ()" + Chr(10) _
         + "    VAR n AS Integer" + Chr(10) _
         + "    n = PAGE.Get(""" + name + """).Value.Length" + Chr(10) _
         + "    IF n > " + Str(most) + " THEN" + Chr(10) _
         + "        PAGE.Get(""" + name + "_n"").Text = Str(n - " + Str(most) + ") + "" characters too many""" + Chr(10) _
         + "    ELSE" + Chr(10) _
         + "        PAGE.Get(""" + name + "_n"").Text = Str(" + Str(most) + " - n) + "" characters left""" + Chr(10) _
         + "    END IF" + Chr(10) _
         + "    PAGE.Get(""go"").Enabled = n <= " + Str(most) + Chr(10) _
         + "END SUB" + Chr(10) _
         + "</script>"
END FUNCTION
