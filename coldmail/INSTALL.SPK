' VAPOR|id=COLDMAIL|name=ColdMail|kind=web|version=8066850d|category=Internet|run=/|files=C:\WEB\COLDMAIL.HTM;C:\WEB\COMPOSE.ASP;C:\WEB\DELETE.ASP;C:\WEB\GETMAIL.TXT;C:\WEB\HOST.ASP;C:\WEB\INBOX.ASP;C:\WEB\INDEX.ASP;C:\WEB\JOIN.ASP;C:\WEB\LOGIN.ASP;C:\WEB\LOGOUT.ASP;C:\WEB\MAIL.SPK;C:\WEB\READ.ASP;C:\PROGRAMS\MAILD.SPK;C:\PROGRAMS\MAILPASS.SPK|tasks=MAILD|startup=MAIL.RUN|folder=MAIL|about=Free webmail and a real mail server: send letters to anybody on any machine. Becomes this machine's home page, or on a SimHost machine gets a folder of its own.
' INSTALL.SPK - puts ColdMail on this machine. Generated by tools/build-installer.mjs;
' edit the files in coldmail/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It puts the
' webmail in C:\WEB as this machine's home page (the stock INDEX.HTM moves to
' WELCOME.HTM) and the mail server in C:\PROGRAMS\MAILD.SPK, starts
' the server, and adds it to C:\SYSTEM\STARTUP so it runs whenever the machine
' does. Mailboxes in C:\MAILDATA are left alone, so running it again upgrades
' ColdMail without losing any mail. Then open http://YOURNAME/ in Voyager.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)
    ' On a machine set up for several web apps (SimHost: C:\SYSTEM\WEBAPPS.INI
    ' says mode=folders), this one goes in C:\WEB\MAIL and leaves the home page alone.
    IF FS.Exists("C:\SYSTEM\WEBAPPS.INI") THEN
        IF FS.Read("C:\SYSTEM\WEBAPPS.INI").Contains("mode=folders") THEN intoDir = "MAIL"
    END IF
    IF intoDir <> "" AND NOT FS.Exists("C:\WEB\" + intoDir) THEN FS.MakeDir("C:\WEB\" + intoDir)

    IF NOT FS.Exists(Dest("C:\WEB\DIST")) THEN FS.MakeDir(Dest("C:\WEB\DIST"))
    FS.Write(Dest("C:\WEB\DIST\MANIFEST.TXT"), "")
    IF intoDir = "" THEN MoveHomePage()
    File0()
    File1()
    File2()
    File3()
    File4()
    File5()
    File6()
    File7()
    File8()
    File9()
    File10()
    File11()
    File12()
    File13()
    Print("ColdMail is installed (14 files).")
    StartService("MAILD", "C:\PROGRAMS\MAILD.SPK", "MAIL.RUN")
    ' how it shows on the SimHost front page, which lists every folder with one of these
    IF intoDir <> "" THEN FS.Write("C:\WEB\" + intoDir + "\APP.INF", "ColdMail|Free webmail, with a real mail server behind it.|#2E5E8C")
    IF intoDir = "" THEN
        Print("Open http://" + NET.HostName.Lower() + "/ in Voyager.")
    ELSE
        Print("Open http://" + NET.HostName.Lower() + "/" + intoDir.Lower() + "/ in Voyager.")
    END IF
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "<html><head><title>About ColdMail - free web-based e-mail</title>" + NL
    t = t + "<meta name=""description"" content=""ColdMail is free web-based e-mail for the SIM95 network: get your own email address, send and receive mail from any web browser, and host your own mail server."">" + NL
    t = t + "<meta name=""keywords"" content=""email, e-mail, webmail, web mail, free email, mail, inbox, email address, email account, hotmail, yahoo mail, gmail, outlook, mail server, smtp, post office, send mail, letters, messages, compose, correspondence"">" + NL
    t = t + "</head>" + NL
    t = t + "<body bgcolor=""#FFFFFF"">" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""0""><tr><td bgcolor=""#003399""><font color=""#FFFFFF"" size=""5""><b>ColdMail</b></font>" + NL
    t = t + "<font color=""#CCDDFF"" size=""2"">&nbsp;free e-mail</font></td></tr></table>" + NL
    t = t + "<h2><font color=""#003399"">About ColdMail</font></h2>" + NL
    t = t + "<p><b>ColdMail is free web-based e-mail.</b> Sign up for your own email address and read your" + NL
    t = t + "mail from any web browser on any machine. No software to install, no modem settings, no" + NL
    t = t + "post office protocol to configure.</p>" + NL
    t = t + "<h3>Features</h3>" + NL
    t = t + "<ul>" + NL
    t = t + "<li><b>A free email account</b>: <tt>you@yourmachine</tt>, ready in seconds.</li>" + NL
    t = t + "<li><b>Send mail anywhere</b> on the network: ColdMail's mail server delivers your letters to every" + NL
    t = t + "machine that runs one, and keeps trying for a while if the other end is down.</li>" + NL
    t = t + "<li><b>An Inbox, Sent mail and Compose</b>, like Hotmail and Yahoo! Mail, minus the banner ads.</li>" + NL
    t = t + "<li><b>Bounce messages</b> tell you when a letter could not be delivered, and why.</li>" + NL
    t = t + "<li><b>Host your own mail server.</b> Any SIM95 machine can run ColdMail: one small program copies it over," + NL
    t = t + "starts the SMTP server on port 25, and your machine has webmail too.</li>" + NL
    t = t + "</ul>" + NL
    t = t + "<h3>Webmail? E-mail? Electronic mail?</h3>" + NL
    t = t + "<p>All the same thing: letters sent over the network instead of by the post office. ColdMail is an" + NL
    t = t + "email service, a webmail client and a mail server in one, written in SPARK.</p>" + NL
    t = t + "<p><a href=""index.asp""><b>Get your free ColdMail address</b></a> &middot; <a href=""host.asp"">Host ColdMail on your machine</a></p>" + NL
    t = t + "<hr><center><font size=""1"" color=""#808080"">ColdMail: free email, webmail and mail servers for SIM95.</font></center>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\COLDMAIL.HTM")
    FS.Write(Dest("C:\WEB\DIST\0.TXT"), t)
    FS.Append(Dest("C:\WEB\DIST\MANIFEST.TXT"), "0|C:\WEB\COLDMAIL.HTM" + NL)
END SUB

SUB File1 ()
    t = ""
    t = t + "<%@ import file=""MAIL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' COMPOSE.ASP - write a letter (GET), or send it (POST). ?reply=N or ?fwd=N" + NL
    t = t + "' starts from a letter in folder f, quoted." + NL
    t = t + "VAR toList AS String" + NL
    t = t + "VAR subject AS String" + NL
    t = t + "VAR text AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR old AS String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR f AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    RequireToken()" + NL
    t = t + "    toList = REQUEST.Form(""to"")" + NL
    t = t + "    subject = REQUEST.Form(""subject"")" + NL
    t = t + "    text = REQUEST.Form(""text"")" + NL
    t = t + "    problem = Send(viewer, toList, subject, text)" + NL
    t = t + "    IF problem = """" THEN RESPONSE.Redirect(""inbox.asp?why="" + UrlEnc(""Your letter is on its way.""))" + NL
    t = t + "ELSE" + NL
    t = t + "    toList = REQUEST.Query(""to"")" + NL
    t = t + "    f = REQUEST.Query(""f"")" + NL
    t = t + "    IF f <> ""sent"" THEN f = ""inbox""" + NL
    t = t + "    IF REQUEST.Query(""reply"") <> """" AND FindIndex(viewer, f, REQUEST.Query(""reply"")) <> """" THEN" + NL
    t = t + "        old = LoadLetter(viewer, REQUEST.Query(""reply""))" + NL
    t = t + "        IF f = ""sent"" THEN" + NL
    t = t + "            toList = Header(old, ""To"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            toList = Bare(Header(old, ""From""))" + NL
    t = t + "        END IF" + NL
    t = t + "        subject = Header(old, ""Subject"")" + NL
    t = t + "        IF NOT subject.Lower().StartsWith(""re:"") THEN subject = ""Re: "" + subject" + NL
    t = t + "        text = Chr(10) + Chr(10) + DisplayName(Header(old, ""From"")) + "" wrote:"" + Chr(10)" + NL
    t = t + "        FOR EACH line IN Clip(Body(old), 3000).Lines()" + NL
    t = t + "            text = text + ""> "" + line + Chr(10)" + NL
    t = t + "        NEXT" + NL
    t = t + "    ELSEIF REQUEST.Query(""fwd"") <> """" AND FindIndex(viewer, f, REQUEST.Query(""fwd"")) <> """" THEN" + NL
    t = t + "        old = LoadLetter(viewer, REQUEST.Query(""fwd""))" + NL
    t = t + "        subject = ""Fwd: "" + Header(old, ""Subject"")" + NL
    t = t + "        text = Chr(10) + Chr(10) + ""----- Forwarded letter -----"" + Chr(10) + ""From: "" + Header(old, ""From"") + Chr(10) + ""Date: "" + Header(old, ""Date"") + Chr(10) + ""Subject: "" + Header(old, ""Subject"") + Chr(10) + Chr(10) + Clip(Body(old), 5000)" + NL
    t = t + "    END IF" + NL
    t = t + "END IF" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Compose"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= ServerWarning() %>" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<%= BoxTop(""Compose"") %>" + NL
    t = t + "<form action=""compose.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td><font size=""2"">From:</font></td><td><font size=""2""><%= H(Field(viewer, ""name"")) %> &lt;<%= H(MyAddress(viewer)) %>&gt;</font></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">To:</font></td><td><input name=""to"" size=""50"" maxlength=""400"" value=""<%= H(toList) %>""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Subject:</font></td><td><input name=""subject"" size=""50"" maxlength=""<%= MAXSUBJECT %>"" value=""<%= H(subject) %>""></td></tr>" + NL
    t = t + "<tr><td valign=""top""><font size=""2"">Letter:</font></td><td><%= LimitedBox(""text"", text, 14, 60, MAXBODY) %></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" id=""go"" value=""Send""> <font size=""1"" color=""#808080"">Several people: separate them with commas.</font></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "</form>" + NL
    t = t + "<%= LimitScript(""text"", MAXBODY) %>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\COMPOSE.ASP")
    FS.Write(Dest("C:\WEB\DIST\1.TXT"), t)
    FS.Append(Dest("C:\WEB\DIST\MANIFEST.TXT"), "1|C:\WEB\COMPOSE.ASP" + NL)
END SUB

SUB File2 ()
    t = ""
    t = t + "<%@ import file=""MAIL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' DELETE.ASP - deletes the ticked letters (fields d<n>) of folder f." + NL
    t = t + "VAR f AS String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR gone AS Integer" + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "f = REQUEST.Form(""f"")" + NL
    t = t + "IF f <> ""sent"" THEN f = ""inbox""" + NL
    t = t + "FOR EACH line IN Folder(viewer, f)" + NL
    t = t + "    IF REQUEST.Form(""d"" + line.Split(""|"")[0]) <> """" THEN" + NL
    t = t + "        DeleteLetter(viewer, f, line)" + NL
    t = t + "        gone = gone + 1" + NL
    t = t + "    END IF" + NL
    t = t + "NEXT" + NL
    t = t + "IF gone = 1 THEN RESPONSE.Redirect(""inbox.asp?f="" + f + ""&why="" + UrlEnc(""1 letter deleted.""))" + NL
    t = t + "RESPONSE.Redirect(""inbox.asp?f="" + f + ""&why="" + UrlEnc(Str(gone) + "" letters deleted.""))" + NL
    t = t + "%>" + NL
    Put("C:\WEB\DELETE.ASP")
    FS.Write(Dest("C:\WEB\DIST\2.TXT"), t)
    FS.Append(Dest("C:\WEB\DIST\MANIFEST.TXT"), "2|C:\WEB\DELETE.ASP" + NL)
END SUB

SUB File3 ()
    t = ""
    t = t + "' GETMAIL.SPK - copies ColdMail from %HOST% onto this machine and starts your" + NL
    t = t + "' own mail server. Save it as C:\MYFILES\GETMAIL.SPK in SPARK and press F5." + NL
    t = t + "'" + NL
    t = t + "' It fetches each file over the web (each one fits in a network message, which" + NL
    t = t + "' the whole installer would not), writes it where it belongs, starts" + NL
    t = t + "' C:\PROGRAMS\MAILD.SPK, and adds it to C:\SYSTEM\STARTUP. It also keeps a" + NL
    t = t + "' copy of everything in C:\WEB\DIST, so your machine can hand ColdMail on" + NL
    t = t + "' to the next person in the same way. Your mail in C:\MAILDATA is never touched." + NL
    t = t + "" + NL
    t = t + "CONST FROM = ""%HOST%""" + NL
    t = t + "CONST BASE = ""%BASE%""          ' where ColdMail's pages are on FROM: ""/"" or ""/mail/""" + NL
    t = t + "" + NL
    t = t + "VAR web AS NET_Socket" + NL
    t = t + "VAR parts AS Array OF String" + NL
    t = t + "VAR done AS Bool" + NL
    t = t + "VAR intoDir AS String         ' """" for the web root, or MAIL on a machine that keeps web apps in folders" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    ' A failed Connect spoils the handler it happens in (see Fetch), so all of" + NL
    t = t + "    ' it sits in a TRY with nothing after it." + NL
    t = t + "    TRY" + NL
    t = t + "        Install()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Install ()" + NL
    t = t + "    VAR manifest AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR task AS String" + NL
    t = t + "    VAR shared AS String" + NL
    t = t + "    web = NET_Socket.New()" + NL
    t = t + "    web.onMessage = Web_OnMessage" + NL
    t = t + "    web.onClose = Web_OnClose" + NL
    t = t + "    Print(""Fetching ColdMail from "" + FROM + ""..."")" + NL
    t = t + "    manifest = Fetch(BASE + ""dist/manifest.txt"")" + NL
    t = t + "    IF manifest = """" THEN RETURN" + NL
    t = t + "    IF FS.Exists(""C:\SYSTEM\WEBAPPS.INI"") THEN" + NL
    t = t + "        IF FS.Read(""C:\SYSTEM\WEBAPPS.INI"").Contains(""mode=folders"") THEN intoDir = ""MAIL""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF intoDir <> """" AND NOT FS.Exists(""C:\WEB\MAIL"") THEN FS.MakeDir(""C:\WEB\MAIL"")" + NL
    t = t + "    IF NOT FS.Exists(Dest(""C:\WEB\DIST"")) THEN FS.MakeDir(Dest(""C:\WEB\DIST""))" + NL
    t = t + "    IF intoDir = """" THEN MoveHomePage()" + NL
    t = t + "    FOR EACH line IN manifest.Lines()" + NL
    t = t + "        IF line.Split(""|"").Count < 2 THEN CONTINUE" + NL
    t = t + "        text = Fetch(BASE + ""dist/"" + line.Split(""|"")[0] + "".txt"")" + NL
    t = t + "        IF text = """" THEN RETURN" + NL
    t = t + "        FS.Write(Dest(line.Split(""|"")[1]), text)" + NL
    t = t + "        FS.Write(Dest(""C:\WEB\DIST\"" + line.Split(""|"")[0] + "".TXT""), text)" + NL
    t = t + "        shared = shared + line + Chr(10)" + NL
    t = t + "        Print(""  wrote "" + Dest(line.Split(""|"")[1]))" + NL
    t = t + "        n = n + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Write(Dest(""C:\WEB\DIST\MANIFEST.TXT""), shared)" + NL
    t = t + "    FS.Write(""C:\SYSTEM\STARTUP\MAIL.RUN"", ""C:\PROGRAMS\MAILD.SPK"")" + NL
    t = t + "    FOR EACH task IN SYS.Tasks()" + NL
    t = t + "        IF task.Split(""|"")[1].Upper() = ""MAILD"" THEN SYS.Kill(Int(Val(task.Split(""|"")[0])))" + NL
    t = t + "    NEXT" + NL
    t = t + "    SYS.Run(""C:\PROGRAMS\MAILD.SPK"")" + NL
    t = t + "    Print(""ColdMail is installed ("" + Str(n) + "" files) and your mail server is running."")" + NL
    t = t + "    IF intoDir = """" THEN" + NL
    t = t + "        Print(""Open http://"" + NET.HostName.Lower() + ""/ in Voyager and sign up."")" + NL
    t = t + "    ELSE" + NL
    t = t + "        Print(""Open http://"" + NET.HostName.Lower() + ""/mail/ in Voyager and sign up."")" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where a file goes: in C:\WEB\MAIL, on a machine that keeps web apps in folders." + NL
    t = t + "FUNCTION Dest (path AS String) AS String" + NL
    t = t + "    IF intoDir <> """" AND path.Upper().StartsWith(""C:\WEB\"") THEN RETURN ""C:\WEB\"" + intoDir + ""\"" + path.Substring(7, path.Length - 7)" + NL
    t = t + "    RETURN path" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One file over the web. Answers come in through the socket's events; there is" + NL
    t = t + "' no Receive, because a Receive that ends in ""connection closed"" would spoil" + NL
    t = t + "' the handler: every later wait in it would fail with the same error." + NL
    t = t + "FUNCTION Fetch (path AS String) AS String" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR raw AS String" + NL
    t = t + "    VAR since AS Integer" + NL
    t = t + "    parts.Clear()" + NL
    t = t + "    done = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = web.Connect(FROM, 80)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        Print(""Could not reach "" + FROM + "": "" + err)" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END TRY" + NL
    t = t + "    conn.Send(""GET "" + path + "" HTTP/1.0"" + Chr(10) + ""Host: "" + FROM)" + NL
    t = t + "    since = SYS.Ticks" + NL
    t = t + "    WHILE NOT done AND SYS.Ticks - since < 10000" + NL
    t = t + "        SYS.Sleep(50)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    raw = parts.Join(Chr(10))" + NL
    t = t + "    IF NOT raw.StartsWith(""HTTP/1.0 200"") OR NOT raw.Contains(Chr(10) + Chr(10)) THEN" + NL
    t = t + "        Print(""Could not get "" + path + "" from "" + FROM + "": "" + raw.Lines()[0])" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN raw.Substring(raw.IndexOf(Chr(10) + Chr(10)) + 2, raw.Length - raw.IndexOf(Chr(10) + Chr(10)) - 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ColdMail becomes this machine's home page. The web server shows INDEX.ASP" + NL
    t = t + "' only when there is no INDEX.HTM, so the old home page steps aside." + NL
    t = t + "SUB MoveHomePage ()" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    IF NOT FS.Exists(""C:\WEB\INDEX.HTM"") THEN RETURN" + NL
    t = t + "    FOR EACH name IN [""WELCOME.HTM"", ""INDEX1.HTM"", ""INDEX2.HTM"", ""INDEX3.HTM"", ""INDEX4.HTM"", ""INDEX5.HTM""]" + NL
    t = t + "        IF NOT FS.Exists(""C:\WEB\"" + name) THEN" + NL
    t = t + "            FS.Rename(""C:\WEB\INDEX.HTM"", ""C:\WEB\"" + name)" + NL
    t = t + "            Print(""  moved the old home page to C:\WEB\"" + name)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    parts.Add(message)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnClose (conn AS NET_Connection)" + NL
    t = t + "    done = TRUE" + NL
    t = t + "END SUB" + NL
    Put("C:\WEB\GETMAIL.TXT")
    FS.Write(Dest("C:\WEB\DIST\3.TXT"), t)
    FS.Append(Dest("C:\WEB\DIST\MANIFEST.TXT"), "3|C:\WEB\GETMAIL.TXT" + NL)
END SUB

SUB File4 ()
    t = ""
    t = t + "<%@ import file=""MAIL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' HOST.ASP - run ColdMail on your own machine. Hands out GETMAIL.SPK, a small" + NL
    t = t + "' program that copies ColdMail from this machine over the web; and sends you" + NL
    t = t + "' on to your own webmail once you have it." + NL
    t = t + "VAR there AS String" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "there = REQUEST.Query(""go"").Trim().Lower()" + NL
    t = t + "IF there <> """" THEN" + NL
    t = t + "    IF OnlyFrom(there, ""abcdefghijklmnopqrstuvwxyz0123456789.-"") AND there.Length <= 40 THEN RESPONSE.Redirect(""http://"" + there + ""/"")" + NL
    t = t + "END IF" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Host ColdMail"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= BoxTop(""Run ColdMail on your own machine"") %>" + NL
    t = t + "<p><font size=""2"">Every SIM95 machine can be a mail server. Yours would give out" + NL
    t = t + "addresses like <b>you@yourmachine</b>, keep its own mailboxes, and trade letters with" + NL
    t = t + "<%= H(NET.HostName.Lower()) %> and every other ColdMail machine over port 25.</font></p>" + NL
    t = t + "<ol><font size=""2"">" + NL
    t = t + "<li>On your machine, open <b>Start &gt; Programs &gt; SPARK</b>.</li>" + NL
    t = t + "<li>Copy the program below into it, save it as <tt>C:\MYFILES\GETMAIL.SPK</tt>, and press <b>F5</b>.</li>" + NL
    t = t + "<li>It copies ColdMail from <b><%= H(NET.HostName.Lower()) %></b> file by file, starts your mail" + NL
    t = t + "server, and sets it to start whenever your machine does.</li>" + NL
    t = t + "<li>Then open your own webmail at <tt>http://yourmachine/</tt>.</li>" + NL
    t = t + "</font></ol>" + NL
    t = t + "<form><textarea rows=""14"" cols=""76"" readonly><%= H(ReadOr(AppDir() + ""\GETMAIL.TXT"", """").Replace(""%HOST%"", NET.HostName.Lower()).Replace(""%BASE%"", UrlBase())) %></textarea></form>" + NL
    t = t + "<%= BoxTop(""Already running it?"") %>" + NL
    t = t + "<form action=""host.asp"" method=""get"">" + NL
    t = t + "<p><font size=""2"">Your machine's name:</font> <input name=""go"" size=""30"" maxlength=""40"">" + NL
    t = t + "<input type=""submit"" value=""Go to my webmail""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<%= BoxTop(""This mail server"") %>" + NL
    t = t + "<p><font size=""2"">" + NL
    t = t + "<% IF ServerAlive() THEN %>" + NL
    t = t + "The mail server on <b><%= H(NET.HostName.Lower()) %></b> is <b><font color=""#008000"">running</font></b>, port 25." + NL
    t = t + "<% ELSE %>" + NL
    t = t + "The mail server on <b><%= H(NET.HostName.Lower()) %></b> is <b><font color=""#990000"">not running</font></b>; letters wait in the outbox until it starts." + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= Str(Waiting()) %> letter(s) waiting to go out. <a href=""index.asp"">Use ColdMail here instead</a>." + NL
    t = t + "</font></p>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\HOST.ASP")
    FS.Write(Dest("C:\WEB\DIST\4.TXT"), t)
    FS.Append(Dest("C:\WEB\DIST\MANIFEST.TXT"), "4|C:\WEB\HOST.ASP" + NL)
END SUB

SUB File5 ()
    t = ""
    t = t + "<%@ import file=""MAIL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' INBOX.ASP?f=inbox|sent - a folder, newest first, with boxes to tick for deleting." + NL
    t = t + "VAR f AS String" + NL
    t = t + "VAR lines AS Array OF String" + NL
    t = t + "VAR p AS Array OF String" + NL
    t = t + "VAR rows AS String" + NL
    t = t + "VAR i AS Integer" + NL
    t = t + "VAR shown AS Integer" + NL
    t = t + "VAR who AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "f = REQUEST.Query(""f"")" + NL
    t = t + "IF f <> ""sent"" THEN f = ""inbox""" + NL
    t = t + "lines = Folder(viewer, f)" + NL
    t = t + "FOR i = lines.Count - 1 TO 0 STEP -1" + NL
    t = t + "    p = lines[i].Split(""|"")" + NL
    t = t + "    IF p.Count < 7 THEN CONTINUE" + NL
    t = t + "    IF f = ""sent"" THEN" + NL
    t = t + "        who = ""To: "" + Unesc(p[3])" + NL
    t = t + "    ELSE" + NL
    t = t + "        who = DisplayName(Unesc(p[2]))" + NL
    t = t + "    END IF" + NL
    t = t + "    IF p[6] = ""N"" THEN" + NL
    t = t + "        rows = rows + ""<tr bgcolor=""""#EEF4FF""""><td><input type=""""checkbox"""" name=""""d"" + p[0] + """"""></td><td><font size=""""2""""><b>"" + H(Clip(who, 40)) + ""</b></font></td><td><font size=""""2""""><a href=""""read.asp?f="" + f + ""&n="" + p[0] + """"""><b>"" + H(Unesc(p[4])) + ""</b></a></font></td><td><font size=""""1"""">"" + p[1] + ""</font></td><td align=""""right""""><font size=""""1"""">"" + Str(Int(Val(p[5]) / 1024) + 1) + ""K</font></td></tr>""" + NL
    t = t + "    ELSE" + NL
    t = t + "        rows = rows + ""<tr><td><input type=""""checkbox"""" name=""""d"" + p[0] + """"""></td><td><font size=""""2"""">"" + H(Clip(who, 40)) + ""</font></td><td><font size=""""2""""><a href=""""read.asp?f="" + f + ""&n="" + p[0] + """""">"" + H(Unesc(p[4])) + ""</a></font></td><td><font size=""""1"""">"" + p[1] + ""</font></td><td align=""""right""""><font size=""""1"""">"" + Str(Int(Val(p[5]) / 1024) + 1) + ""K</font></td></tr>""" + NL
    t = t + "    END IF" + NL
    t = t + "    shown = shown + 1" + NL
    t = t + "    IF rows.Length > PAGEROOM OR shown >= 100 THEN BREAK" + NL
    t = t + "NEXT" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Inbox"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= ServerWarning() %>" + NL
    t = t + "<%= Notice(REQUEST.Query(""why"")) %>" + NL
    t = t + "<% IF f = ""sent"" THEN %>" + NL
    t = t + "<%= BoxTop(""Sent ("" + Str(lines.Count) + "")"") %>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<%= BoxTop(""Inbox ("" + Str(lines.Count) + "" letters, "" + Str(Unread(viewer)) + "" new)"") %>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<form action=""delete.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<input type=""hidden"" name=""f"" value=""<%= f %>"">" + NL
    t = t + "<% IF rows = """" THEN %>" + NL
    t = t + "<p><font size=""2"" color=""#808080"">There is nothing in this folder.</font></p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<table width=""100%"" cellpadding=""3"" cellspacing=""1"">" + NL
    t = t + "<tr bgcolor=""#DDDDDD""><td></td><td><font size=""2""><b><% IF f = ""sent"" THEN %>To<% ELSE %>From<% END IF %></b></font></td><td><font size=""2""><b>Subject</b></font></td><td><font size=""2""><b>Date</b></font></td><td><font size=""2""><b>Size</b></font></td></tr>" + NL
    t = t + "<%= rows %>" + NL
    t = t + "</table>" + NL
    t = t + "<% IF shown < lines.Count THEN %><p><font size=""1"" color=""#808080"">The newest <%= shown %> of <%= lines.Count %> are shown. Delete some to see the rest.</font></p><% END IF %>" + NL
    t = t + "<p><input type=""submit"" value=""Delete Ticked""></p>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</form>" + NL
    t = t + "<p><font size=""2""><a href=""compose.asp""><b>Compose a letter</b></a> &middot; <a href=""inbox.asp?f=<%= f %>"">Check for new mail</a></font></p>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\INBOX.ASP")
    FS.Write(Dest("C:\WEB\DIST\5.TXT"), t)
    FS.Append(Dest("C:\WEB\DIST\MANIFEST.TXT"), "5|C:\WEB\INBOX.ASP" + NL)
END SUB

SUB File6 ()
    t = ""
    t = t + "<%@ import file=""MAIL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' INDEX.ASP - the front door: sign in or get a free ColdMail address." + NL
    t = t + "VAR problem AS String" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "IF viewer <> """" THEN RESPONSE.Redirect(""inbox.asp"")" + NL
    t = t + "SELECT CASE REQUEST.Query(""e"")" + NL
    t = t + "    CASE ""login""" + NL
    t = t + "        problem = ""That name and password do not match.""" + NL
    t = t + "    CASE ""join""" + NL
    t = t + "        problem = REQUEST.Query(""why"")" + NL
    t = t + "    CASE ""bye""" + NL
    t = t + "        problem = ""You have signed out of ColdMail.""" + NL
    t = t + "END SELECT" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Welcome"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""10"" cellspacing=""0""><tr>" + NL
    t = t + "<td width=""55%"" valign=""top"">" + NL
    t = t + "<h2><font color=""#003399"">Free e-mail for everyone on the network</font></h2>" + NL
    t = t + "<p>Get your own address, <b>you@<%= H(NET.HostName.Lower()) %></b>, and write to anybody on" + NL
    t = t + "any SIM95 machine that runs a mail server. Read your mail from any Voyager, anywhere.</p>" + NL
    t = t + "<ul>" + NL
    t = t + "<li>Send to people on other machines: <tt>bob@theirmachine</tt></li>" + NL
    t = t + "<li>Letters that cannot be delivered come back to you, with the reason</li>" + NL
    t = t + "<li>No ads. No spam filter either. It is 1996.</li>" + NL
    t = t + "</ul>" + NL
    t = t + "<table width=""100%"" cellpadding=""8""><tr><td bgcolor=""#EEF4FF""><font size=""2"">" + NL
    t = t + "<b>Want your own mail server?</b> Every SIM95 machine can run one." + NL
    t = t + "<a href=""host.asp""><b>Host ColdMail on your machine</b></a>: one small program copies it over" + NL
    t = t + "from here, starts it, and gives you <tt>http://yourmachine/</tt>.<br><br>" + NL
    t = t + "Mail server on <%= H(NET.HostName.Lower()) %>:" + NL
    t = t + "<% IF ServerAlive() THEN %><font color=""#008000""><b>running</b></font><% ELSE %><font color=""#990000""><b>not running</b></font><% END IF %>" + NL
    t = t + "</font></td></tr></table>" + NL
    t = t + "</td>" + NL
    t = t + "<td width=""45%"" valign=""top"">" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<%= BoxTop(""Sign In"") %>" + NL
    t = t + "<form action=""login.asp"" method=""post"">" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td><font size=""2"">Mail name:</font></td><td><input name=""u"" size=""12"" maxlength=""8""> <font size=""2"">@<%= H(NET.HostName.Lower()) %></font></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Password:</font></td><td><input type=""password"" name=""pw"" size=""12""></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Sign In""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "</form>" + NL
    t = t + "<%= BoxTop(""Sign Up for ColdMail"") %>" + NL
    t = t + "<form action=""join.asp"" method=""post"">" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td><font size=""2"">Your name:</font></td><td><input name=""name"" size=""20"" maxlength=""<%= MAXNAME %>""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Mail name:</font></td><td><input name=""u"" size=""12"" maxlength=""8""> <font size=""2"">@<%= H(NET.HostName.Lower()) %></font></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Password:</font></td><td><input type=""password"" name=""pw"" size=""12""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Again:</font></td><td><input type=""password"" name=""pw2"" size=""12""></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Sign Up""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "</form>" + NL
    t = t + "</td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\INDEX.ASP")
    FS.Write(Dest("C:\WEB\DIST\6.TXT"), t)
    FS.Append(Dest("C:\WEB\DIST\MANIFEST.TXT"), "6|C:\WEB\INDEX.ASP" + NL)
END SUB

SUB File7 ()
    t = ""
    t = t + "<%@ import file=""MAIL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' JOIN.ASP - a new ColdMail address, signed in straight away, with a welcome letter." + NL
    t = t + "VAR u AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "u = REQUEST.Form(""u"").Trim().Lower()" + NL
    t = t + "IF REQUEST.Form(""pw"") <> REQUEST.Form(""pw2"") THEN" + NL
    t = t + "    problem = ""The two passwords are different.""" + NL
    t = t + "ELSE" + NL
    t = t + "    problem = CreateUser(u, REQUEST.Form(""pw""), REQUEST.Form(""name""))" + NL
    t = t + "END IF" + NL
    t = t + "IF problem <> """" THEN RESPONSE.Redirect(""index.asp?e=join&why="" + UrlEnc(problem))" + NL
    t = t + "SaveLetter(u, ""inbox"", ""From: ColdMail <postmaster@"" + NET.HostName.Lower() + "">"" + Chr(10) _" + NL
    t = t + "    + ""To: "" + MyAddress(u) + Chr(10) + ""Subject: Welcome to ColdMail!"" + Chr(10) _" + NL
    t = t + "    + ""Date: "" + TIME.Date + "" "" + TIME.Clock + Chr(10) + Chr(10) _" + NL
    t = t + "    + ""Hello "" + Field(u, ""name"") + "","" + Chr(10) + Chr(10) _" + NL
    t = t + "    + ""Your new address is "" + MyAddress(u) + "". Give it to your friends!"" + Chr(10) + Chr(10) _" + NL
    t = t + "    + ""To write to someone on another machine, use their mail name and machine name,"" + Chr(10) _" + NL
    t = t + "    + ""like bob@theirmachine. Their machine needs to be running a mail server too."" + Chr(10) + Chr(10) _" + NL
    t = t + "    + ""Stay cool,"" + Chr(10) + ""The ColdMail team"", ""N"")" + NL
    t = t + "SignIn(u)" + NL
    t = t + "RESPONSE.Redirect(""inbox.asp"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\JOIN.ASP")
    FS.Write(Dest("C:\WEB\DIST\7.TXT"), t)
    FS.Append(Dest("C:\WEB\DIST\MANIFEST.TXT"), "7|C:\WEB\JOIN.ASP" + NL)
END SUB

SUB File8 ()
    t = ""
    t = t + "<%@ import file=""MAIL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' LOGIN.ASP - checks the password and opens the Inbox." + NL
    t = t + "VAR u AS String" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "u = REQUEST.Form(""u"").Trim().Lower()" + NL
    t = t + "IF NOT CheckPassword(u, REQUEST.Form(""pw"")) THEN RESPONSE.Redirect(""index.asp?e=login"")" + NL
    t = t + "SignIn(u)" + NL
    t = t + "RESPONSE.Redirect(""inbox.asp"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\LOGIN.ASP")
    FS.Write(Dest("C:\WEB\DIST\8.TXT"), t)
    FS.Append(Dest("C:\WEB\DIST\MANIFEST.TXT"), "8|C:\WEB\LOGIN.ASP" + NL)
END SUB

SUB File9 ()
    t = ""
    t = t + "<%@ import file=""MAIL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' LOGOUT.ASP?t=token - forgets the session. The token stops other sites signing you out." + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "SignOut()" + NL
    t = t + "RESPONSE.Redirect(""index.asp?e=bye"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\LOGOUT.ASP")
    FS.Write(Dest("C:\WEB\DIST\9.TXT"), t)
    FS.Append(Dest("C:\WEB\DIST\MANIFEST.TXT"), "9|C:\WEB\LOGOUT.ASP" + NL)
END SUB

SUB File10 ()
    t = ""
    t = t + "' MAIL.SPK - ColdMail webmail, shared by its pages, which are this machine's home page (C:\WEB)." + NL
    t = t + "'" + NL
    t = t + "' The pages cannot open network connections, so they never talk to another" + NL
    t = t + "' machine themselves. Sending leaves a letter in C:\MAILDATA\SPOOL for the mail" + NL
    t = t + "' server (C:\PROGRAMS\MAILD.SPK) to deliver; reading looks at the mailbox files" + NL
    t = t + "' the mail server fills in. The two agree on these files:" + NL
    t = t + "'" + NL
    t = t + "'   C:\MAILDATA\USERS\<user>.TXT      an account: name, salt, pass (key=value)" + NL
    t = t + "'   C:\MAILDATA\SESSIONS\<id>.TXT     who a sign-in cookie belongs to, and its form token" + NL
    t = t + "'   C:\MAILDATA\BOX\<user>\<n>.MSG    one letter: headers, a blank line, the text" + NL
    t = t + "'   C:\MAILDATA\BOX\<user>\INBOX.TXT  n|date|from|to|subject|size|flags, N = unread" + NL
    t = t + "'   C:\MAILDATA\BOX\<user>\SENT.TXT   the same, for letters they sent" + NL
    t = t + "'   C:\MAILDATA\BOX\<user>\NEXT.TXT   the last letter number used" + NL
    t = t + "'   C:\MAILDATA\SPOOL\<n>.MSG         a letter waiting for the mail server" + NL
    t = t + "'   C:\MAILDATA\ALIVE.TXT             when the mail server last looked at the spool" + NL
    t = t + "'" + NL
    t = t + "' Everything is written to disk the moment it changes. Pages are sent as one" + NL
    t = t + "' 64K network message, so long lists and long letters are cut short on screen." + NL
    t = t + "" + NL
    t = t + "CONST DATADIR = ""C:\MAILDATA""" + NL
    t = t + "CONST COOKIE = ""coldmail""" + NL
    t = t + "CONST MAXSUBJECT = 100" + NL
    t = t + "CONST MAXBODY = 8000" + NL
    t = t + "CONST MAXTO = 10" + NL
    t = t + "CONST MAXNAME = 40" + NL
    t = t + "CONST PAGEROOM = 30000" + NL
    t = t + "" + NL
    t = t + "VAR viewer AS String" + NL
    t = t + "VAR formToken AS String" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- text" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Esc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%"", ""%25"").Replace(""|"", ""%7C"").Replace(Chr(13), """").Replace(Chr(10), ""%0A"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where ColdMail's pages are: C:\WEB (and ""/""), or a folder of its own" + NL
    t = t + "' (C:\WEB\MAIL and ""/mail/"") on a machine that keeps several web apps." + NL
    t = t + "FUNCTION AppDir () AS String" + NL
    t = t + "    VAR page AS String" + NL
    t = t + "    page = SERVER.ScriptName" + NL
    t = t + "    RETURN page.Substring(0, page.Length - page.Split(""\"")[page.Split(""\"").Count - 1].Length - 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UrlBase () AS String" + NL
    t = t + "    IF AppDir().Upper() = ""C:\WEB"" THEN RETURN ""/""" + NL
    t = t + "    RETURN ""/"" + AppDir().Substring(7, AppDir().Length - 7).Replace(""\"", ""/"").Lower() + ""/""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unesc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%0A"", Chr(10)).Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION H (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.HtmlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UrlEnc (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.UrlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION OnlyFrom (s AS String, allowed AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        IF NOT allowed.Contains(s.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ValidName (u AS String) AS Bool" + NL
    t = t + "    IF u.Length < 3 OR u.Length > 8 THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyFrom(u, ""abcdefghijklmnopqrstuvwxyz0123456789"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Clip (s AS String, most AS Integer) AS String" + NL
    t = t + "    s = s.Replace(Chr(13), """").Trim()" + NL
    t = t + "    IF s.Length > most THEN s = s.Substring(0, most)" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsNumber (s AS String) AS Bool" + NL
    t = t + "    IF s = """" OR s.Length > 8 THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyFrom(s, ""0123456789"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' At most room characters of page-safe text, never cut inside an &entity;." + NL
    t = t + "FUNCTION HtmlUpTo (s AS String, room AS Integer) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    out = H(s)" + NL
    t = t + "    IF out.Length <= room THEN RETURN out" + NL
    t = t + "    out = out.Substring(0, room)" + NL
    t = t + "    IF out.Substring(out.Length - 8, 8).Contains(""&"") THEN out = out.Substring(0, out.Length - 8 + out.Substring(out.Length - 8, 8).IndexOf(""&""))" + NL
    t = t + "    RETURN out + Chr(10) + Chr(10) + ""[ColdMail stopped here: the rest is too long to show on one page.]""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- accounts" + NL
    t = t + "" + NL
    t = t + "SUB EnsureDisk ()" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR dirs AS Array OF String" + NL
    t = t + "    dirs = ["""", ""\USERS"", ""\SESSIONS"", ""\BOX"", ""\SPOOL""]" + NL
    t = t + "    FOR EACH dir IN dirs" + NL
    t = t + "        IF NOT FS.Exists(DATADIR + dir) THEN FS.MakeDir(DATADIR + dir)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION UserPath (u AS String) AS String" + NL
    t = t + "    RETURN DATADIR + ""\USERS\"" + u + "".TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UserExists (u AS String) AS Bool" + NL
    t = t + "    IF NOT ValidName(u) THEN RETURN FALSE" + NL
    t = t + "    RETURN FS.Exists(UserPath(u))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Field (u AS String, key AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN FS.Read(UserPath(u)).Lines()" + NL
    t = t + "        IF line.StartsWith(key + ""="") THEN RETURN Unesc(line.Substring(key.Length + 1, line.Length - key.Length - 1))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Hash (salt AS String, pw AS String) AS String" + NL
    t = t + "    VAR a AS Integer = 7" + NL
    t = t + "    VAR b AS Integer = 31337" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = salt + "":"" + pw + "":"" + salt" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        c = Asc(s.CharAt(i))" + NL
    t = t + "        a = (a * 131 + c) MOD 2147483629" + NL
    t = t + "        b = (b * 257 + c + a) MOD 2147483587" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN Hex(a) + ""-"" + Hex(b)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NewToken () AS String" + NL
    t = t + "    RETURN Hex(268435456 + Rnd(1879048191))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CreateUser (u AS String, pw AS String, name AS String) AS String" + NL
    t = t + "    VAR salt AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    IF NOT ValidName(u) THEN RETURN ""Pick a mail name of 3 to 8 letters or digits.""" + NL
    t = t + "    IF FS.Exists(UserPath(u)) THEN RETURN ""Somebody already has "" + u + ""@"" + NET.HostName.Lower() + "".""" + NL
    t = t + "    IF u = ""postmast"" OR u = ""mailer"" OR u = ""root"" OR u = ""admin"" THEN RETURN ""That name is spoken for.""" + NL
    t = t + "    IF pw.Length < 4 THEN RETURN ""Pick a password of at least 4 characters.""" + NL
    t = t + "    name = Clip(name, MAXNAME).Replace(""<"", """").Replace("">"", """").Replace("","", """")" + NL
    t = t + "    IF name = """" THEN RETURN ""Tell us your name.""" + NL
    t = t + "    salt = NewToken()" + NL
    t = t + "    FS.Write(UserPath(u), ""name="" + Esc(name) + Chr(10) + ""salt="" + salt + Chr(10) + ""pass="" + Hash(salt, pw) + Chr(10) + ""joined="" + TIME.Date)" + NL
    t = t + "    FS.MakeDir(DATADIR + ""\BOX\"" + u)" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CheckPassword (u AS String, pw AS String) AS Bool" + NL
    t = t + "    IF NOT UserExists(u) THEN RETURN FALSE" + NL
    t = t + "    RETURN Hash(Field(u, ""salt""), pw) = Field(u, ""pass"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- sessions" + NL
    t = t + "' The same scheme as SimBook: a cookie names a session file holding the user" + NL
    t = t + "' and a form token, and every form that changes something carries the token." + NL
    t = t + "" + NL
    t = t + "SUB SignIn (u AS String)" + NL
    t = t + "    VAR token AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    token = NewToken()" + NL
    t = t + "    FS.Write(DATADIR + ""\SESSIONS\"" + token + "".TXT"", u + Chr(10) + NewToken() + NewToken())" + NL
    t = t + "    RESPONSE.SetCookie(COOKIE, token)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION SessionPath () AS String" + NL
    t = t + "    VAR token AS String" + NL
    t = t + "    token = REQUEST.Cookie(COOKIE)" + NL
    t = t + "    IF token = """" OR token.Length > 8 THEN RETURN """"" + NL
    t = t + "    IF NOT OnlyFrom(token, ""0123456789ABCDEF"") THEN RETURN """"" + NL
    t = t + "    RETURN DATADIR + ""\SESSIONS\"" + token + "".TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SignOut ()" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    path = SessionPath()" + NL
    t = t + "    IF path <> """" THEN" + NL
    t = t + "        IF FS.Exists(path) THEN FS.Delete(path)" + NL
    t = t + "    END IF" + NL
    t = t + "    RESPONSE.SetCookie(COOKIE, """")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION CurrentUser () AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    path = SessionPath()" + NL
    t = t + "    IF path = """" THEN RETURN """"" + NL
    t = t + "    IF NOT FS.Exists(path) THEN RETURN """"" + NL
    t = t + "    lines = FS.Read(path).Lines()" + NL
    t = t + "    IF lines.Count < 2 OR NOT UserExists(lines[0].Trim()) THEN RETURN """"" + NL
    t = t + "    formToken = lines[1].Trim()" + NL
    t = t + "    RETURN lines[0].Trim()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB RequireLogin ()" + NL
    t = t + "    viewer = CurrentUser()" + NL
    t = t + "    IF viewer = """" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RequireToken ()" + NL
    t = t + "    VAR sent AS String" + NL
    t = t + "    sent = REQUEST.Form(""t"")" + NL
    t = t + "    IF sent = """" THEN sent = REQUEST.Query(""t"")" + NL
    t = t + "    IF sent = """" OR sent <> formToken THEN RESPONSE.Redirect(""inbox.asp?why="" + UrlEnc(""That did not come from a ColdMail page, so nothing was changed.""))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION TokenField () AS String" + NL
    t = t + "    RETURN ""<input type=""""hidden"""" name=""""t"""" value="""""" + formToken + """""">""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- addresses" + NL
    t = t + "" + NL
    t = t + "FUNCTION MyAddress (u AS String) AS String" + NL
    t = t + "    RETURN u + ""@"" + NET.HostName.Lower()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""Ann <ann@alpha>"" or ""ann@alpha"" -> ""ann@alpha""" + NL
    t = t + "FUNCTION Bare (address AS String) AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    a = address.Trim()" + NL
    t = t + "    IF a.Contains(""<"") AND a.Contains("">"") THEN a = a.Substring(a.IndexOf(""<"") + 1, a.IndexOf("">"") - a.IndexOf(""<"") - 1)" + NL
    t = t + "    RETURN a.Trim().Lower()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""Ann <ann@alpha>"" -> ""Ann""; a bare address stays itself." + NL
    t = t + "FUNCTION DisplayName (address AS String) AS String" + NL
    t = t + "    IF address.Contains(""<"") THEN RETURN address.Substring(0, address.IndexOf(""<"")).Trim()" + NL
    t = t + "    RETURN address.Trim()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' user@host: a 3-8 letter user (every ColdMail name is one) and a machine name." + NL
    t = t + "FUNCTION ValidAddress (a AS String) AS Bool" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    at = a.IndexOf(""@"")" + NL
    t = t + "    IF at < 0 THEN RETURN FALSE" + NL
    t = t + "    IF NOT ValidName(a.Substring(0, at)) THEN RETURN FALSE" + NL
    t = t + "    IF a.Length - at - 1 < 1 OR a.Length - at - 1 > 40 THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyFrom(a.Substring(at + 1, a.Length - at - 1), ""abcdefghijklmnopqrstuvwxyz0123456789.-"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- letters" + NL
    t = t + "" + NL
    t = t + "FUNCTION BoxDir (u AS String) AS String" + NL
    t = t + "    RETURN DATADIR + ""\BOX\"" + u" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION FolderFile (f AS String) AS String" + NL
    t = t + "    IF f = ""sent"" THEN RETURN ""SENT.TXT""" + NL
    t = t + "    RETURN ""INBOX.TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The folder's lines, oldest first." + NL
    t = t + "FUNCTION Folder (u AS String, f AS String) AS Array OF String" + NL
    t = t + "    VAR all AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    all = ReadOr(BoxDir(u) + ""\"" + FolderFile(f), """").Lines()" + NL
    t = t + "    FOR EACH line IN all" + NL
    t = t + "        IF line <> """" THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION FindIndex (u AS String, f AS String, n AS String) AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    IF NOT IsNumber(n) THEN RETURN """"" + NL
    t = t + "    text = Chr(10) + ReadOr(BoxDir(u) + ""\"" + FolderFile(f), """")" + NL
    t = t + "    at = text.IndexOf(Chr(10) + n + ""|"")" + NL
    t = t + "    IF at < 0 THEN RETURN """"" + NL
    t = t + "    text = text.Substring(at + 1, text.Length - at - 1)" + NL
    t = t + "    IF text.Contains(Chr(10)) THEN text = text.Substring(0, text.IndexOf(Chr(10)))" + NL
    t = t + "    RETURN text" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unread (u AS String) AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    FOR EACH line IN Folder(u, ""inbox"")" + NL
    t = t + "        IF line.EndsWith(""|N"") THEN n = n + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LoadLetter (u AS String, n AS String) AS String" + NL
    t = t + "    RETURN ReadOr(BoxDir(u) + ""\"" + n + "".MSG"", """")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The value of one header of a letter, or """"." + NL
    t = t + "FUNCTION Header (letter AS String, name AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN letter.Lines()" + NL
    t = t + "        IF line = """" THEN RETURN """"" + NL
    t = t + "        IF line.Lower().StartsWith(name.Lower() + "":"") THEN RETURN line.Substring(name.Length + 1, line.Length - name.Length - 1).Trim()" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Body (letter AS String) AS String" + NL
    t = t + "    IF NOT letter.Contains(Chr(10) + Chr(10)) THEN RETURN """"" + NL
    t = t + "    RETURN letter.Substring(letter.IndexOf(Chr(10) + Chr(10)) + 2, letter.Length - letter.IndexOf(Chr(10) + Chr(10)) - 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' text with one whole line swapped for another ("""" takes it out). The line" + NL
    t = t + "' breaks around it make sure a line that merely ends the same way is left alone." + NL
    t = t + "FUNCTION SwapLine (text AS String, line AS String, other AS String) AS String" + NL
    t = t + "    IF other = """" THEN" + NL
    t = t + "        text = (Chr(10) + text).Replace(Chr(10) + line + Chr(10), Chr(10))" + NL
    t = t + "    ELSE" + NL
    t = t + "        text = (Chr(10) + text).Replace(Chr(10) + line + Chr(10), Chr(10) + other + Chr(10))" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN text.Substring(1, text.Length - 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB MarkRead (u AS String, line AS String)" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    IF NOT line.EndsWith(""|N"") THEN RETURN" + NL
    t = t + "    path = BoxDir(u) + ""\INBOX.TXT""" + NL
    t = t + "    FS.Write(path, SwapLine(FS.Read(path), line, line.Substring(0, line.Length - 1)))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Files a letter in one of u's folders, the way the mail server files the Inbox." + NL
    t = t + "SUB SaveLetter (u AS String, f AS String, letter AS String, flags AS String)" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    dir = BoxDir(u)" + NL
    t = t + "    IF NOT FS.Exists(dir) THEN FS.MakeDir(dir)" + NL
    t = t + "    n = Int(Val(ReadOr(dir + ""\NEXT.TXT"", ""0""))) + 1" + NL
    t = t + "    FS.Write(dir + ""\NEXT.TXT"", Str(n))" + NL
    t = t + "    FS.Write(dir + ""\"" + Str(n) + "".MSG"", letter)" + NL
    t = t + "    FS.Append(dir + ""\"" + FolderFile(f), Str(n) + ""|"" + TIME.Date + "" "" + TIME.Clock.Substring(0, 5) + ""|"" + Esc(Header(letter, ""From"")) + ""|"" + Esc(Header(letter, ""To"")) + ""|"" + Esc(Header(letter, ""Subject"")) + ""|"" + Str(letter.Length) + ""|"" + flags + Chr(10))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DeleteLetter (u AS String, f AS String, line AS String)" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    n = line.Split(""|"")[0]" + NL
    t = t + "    path = BoxDir(u) + ""\"" + FolderFile(f)" + NL
    t = t + "    FS.Write(path, SwapLine(FS.Read(path), line, """"))" + NL
    t = t + "    IF FS.Exists(BoxDir(u) + ""\"" + n + "".MSG"") THEN FS.Delete(BoxDir(u) + ""\"" + n + "".MSG"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Writes a letter and leaves a copy for each recipient in the spool for the mail" + NL
    t = t + "' server. Returns """" or what is wrong." + NL
    t = t + "FUNCTION Send (u AS String, toList AS String, subject AS String, text AS String) AS String" + NL
    t = t + "    VAR names AS Array OF String" + NL
    t = t + "    VAR rcpts AS Array OF String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR letter AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    subject = Clip(subject, MAXSUBJECT)" + NL
    t = t + "    text = text.Replace(Chr(13), """")" + NL
    t = t + "    IF text.Length > MAXBODY THEN RETURN ""Keep letters under "" + Str(MAXBODY) + "" characters.""" + NL
    t = t + "    names = toList.Replace("";"", "","").Split("","")" + NL
    t = t + "    FOR EACH a IN names" + NL
    t = t + "        a = Bare(a)" + NL
    t = t + "        IF a = """" THEN CONTINUE" + NL
    t = t + "        IF NOT a.Contains(""@"") THEN a = a + ""@"" + NET.HostName.Lower()" + NL
    t = t + "        IF NOT ValidAddress(a) THEN RETURN ""'"" + a + ""' is not an address. Addresses look like ann@alpha.""" + NL
    t = t + "        IF NOT rcpts.Contains(a) THEN rcpts.Add(a)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF rcpts.Count = 0 THEN RETURN ""Who is it to?""" + NL
    t = t + "    IF rcpts.Count > MAXTO THEN RETURN ""Send it to "" + Str(MAXTO) + "" people at most.""" + NL
    t = t + "    IF subject = """" THEN subject = ""(no subject)""" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    letter = ""From: "" + Field(u, ""name"") + "" <"" + MyAddress(u) + "">"" + Chr(10) _" + NL
    t = t + "           + ""To: "" + rcpts.Join("", "") + Chr(10) _" + NL
    t = t + "           + ""Subject: "" + subject + Chr(10) _" + NL
    t = t + "           + ""Date: "" + TIME.Date + "" "" + TIME.Clock + Chr(10) _" + NL
    t = t + "           + ""X-Mailer: ColdMail 1.0 (SIM95)"" + Chr(10) + Chr(10) + text" + NL
    t = t + "    FOR EACH a IN rcpts" + NL
    t = t + "        n = Int(Val(ReadOr(DATADIR + ""\SPOOLID.TXT"", ""0""))) + 1" + NL
    t = t + "        FS.Write(DATADIR + ""\SPOOLID.TXT"", Str(n))" + NL
    t = t + "        FS.Write(DATADIR + ""\SPOOL\"" + Str(n) + "".MSG"", ""X-Sender: "" + MyAddress(u) + Chr(10) + ""X-Recipient: "" + a + Chr(10) + ""X-Tries: 0"" + Chr(10) + ""X-Next: 0"" + Chr(10) + Chr(10) + letter)" + NL
    t = t + "    NEXT" + NL
    t = t + "    SaveLetter(u, ""sent"", letter, """")" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Has the mail server looked at the spool in the last half minute?" + NL
    t = t + "FUNCTION ServerAlive () AS Bool" + NL
    t = t + "    RETURN TIME.Now - Int(Val(ReadOr(DATADIR + ""\ALIVE.TXT"", ""0""))) < 30" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Waiting () AS Integer" + NL
    t = t + "    RETURN FS.List(DATADIR + ""\SPOOL"").Count" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- page furniture" + NL
    t = t + "" + NL
    t = t + "FUNCTION Top (title AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    s = ""<html><head><title>"" + H(title) + "" - ColdMail</title></head>"" _" + NL
    t = t + "      + ""<body bgcolor=""""#FFFFFF"""" text=""""#000000"""" link=""""#003399"""" vlink=""""#003399"""">"" _" + NL
    t = t + "      + ""<table width=""""100%"""" cellpadding=""""6"""" cellspacing=""""0"""" bgcolor=""""#99CCFF""""><tr>"" _" + NL
    t = t + "      + ""<td><a href=""""index.asp""""><font size=""""6"""" color=""""#003399""""><b><i>Cold</i>Mail!</b></font></a>"" _" + NL
    t = t + "      + ""<br><font size=""""1"""" color=""""#003366"""">Hot mail is so last year.</font></td>"" _" + NL
    t = t + "      + ""<td align=""""right"""" valign=""""bottom""""><font size=""""2"""">""" + NL
    t = t + "    IF viewer <> """" THEN" + NL
    t = t + "        n = Unread(viewer)" + NL
    t = t + "        s = s + ""<b>"" + H(MyAddress(viewer)) + ""</b><br>"" _" + NL
    t = t + "              + ""<a href=""""inbox.asp"""">Inbox""" + NL
    t = t + "        IF n > 0 THEN s = s + "" ("" + Str(n) + "")""" + NL
    t = t + "        s = s + ""</a> | <a href=""""compose.asp"""">Compose</a> | <a href=""""inbox.asp?f=sent"""">Sent</a> | "" _" + NL
    t = t + "              + ""<a href=""""logout.asp?t="" + formToken + """""">Sign Out</a>""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN s + ""</font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Bottom () AS String" + NL
    t = t + "    RETURN ""<hr><center><font size=""""1"""" color=""""#808080"""">ColdMail on "" + H(NET.HostName.Lower()) + "" &middot; mail is delivered by C:\PROGRAMS\MAILD.SPK on port 25 &middot; <a href=""""coldmail.htm"""">About ColdMail</a></font></center></body></html>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION BoxTop (title AS String) AS String" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""3"""" cellspacing=""""0""""><tr><td bgcolor=""""#003399""""><font color=""""#FFFFFF"""" size=""""2""""><b>"" + title + ""</b></font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Notice (text AS String) AS String" + NL
    t = t + "    IF text = """" THEN RETURN """"" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""4""""><tr><td bgcolor=""""#FFF9D7""""><font size=""""2"""">"" + H(text) + ""</font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A warning when letters cannot leave this machine." + NL
    t = t + "FUNCTION ServerWarning () AS String" + NL
    t = t + "    IF ServerAlive() THEN RETURN """"" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""4""""><tr><td bgcolor=""""#FFDDDD""""><font size=""""2""""><b>The mail server is not running.</b> "" _" + NL
    t = t + "         + ""Letters will wait in the outbox ("" + Str(Waiting()) + "" now) until someone starts C:\PROGRAMS\MAILD.SPK on "" + H(NET.HostName.Lower()) + "".</font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same counting text box as SimBook's: the button (id=""go"") greys out" + NL
    t = t + "' while the box holds more than it may." + NL
    t = t + "FUNCTION LimitedBox (name AS String, value AS String, rows AS Integer, cols AS Integer, most AS Integer) AS String" + NL
    t = t + "    RETURN ""<textarea name="""""" + name + """""" id="""""" + name + """""" rows="""""" + Str(rows) + """""" cols="""""" + Str(cols) + """""" onchange=""""Limits_Check"""">"" + H(value) + ""</textarea><br>"" _" + NL
    t = t + "         + ""<font size=""""1"""" color=""""#808080"""" id="""""" + name + ""_n"""">up to "" + Str(most) + "" characters</font>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LimitScript (name AS String, most AS Integer) AS String" + NL
    t = t + "    RETURN ""<script type=""""spark"""">"" + Chr(10) _" + NL
    t = t + "         + ""SUB Limits_Check ()"" + Chr(10) _" + NL
    t = t + "         + ""    VAR n AS Integer"" + Chr(10) _" + NL
    t = t + "         + ""    n = PAGE.Get("""""" + name + """""").Value.Length"" + Chr(10) _" + NL
    t = t + "         + ""    IF n > "" + Str(most) + "" THEN"" + Chr(10) _" + NL
    t = t + "         + ""        PAGE.Get("""""" + name + ""_n"""").Text = Str(n - "" + Str(most) + "") + """" characters too many"""""" + Chr(10) _" + NL
    t = t + "         + ""    ELSE"" + Chr(10) _" + NL
    t = t + "         + ""        PAGE.Get("""""" + name + ""_n"""").Text = Str("" + Str(most) + "" - n) + """" characters left"""""" + Chr(10) _" + NL
    t = t + "         + ""    END IF"" + Chr(10) _" + NL
    t = t + "         + ""    PAGE.Get(""""go"""").Enabled = n <= "" + Str(most) + Chr(10) _" + NL
    t = t + "         + ""END SUB"" + Chr(10) _" + NL
    t = t + "         + ""</script>""" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\WEB\MAIL.SPK")
    FS.Write(Dest("C:\WEB\DIST\10.TXT"), t)
    FS.Append(Dest("C:\WEB\DIST\MANIFEST.TXT"), "10|C:\WEB\MAIL.SPK" + NL)
END SUB

SUB File11 ()
    t = ""
    t = t + "<%@ import file=""MAIL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' READ.ASP?f=inbox|sent&n=N - one letter. Opening it marks it read." + NL
    t = t + "VAR f AS String" + NL
    t = t + "VAR n AS String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR letter AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "f = REQUEST.Query(""f"")" + NL
    t = t + "IF f <> ""sent"" THEN f = ""inbox""" + NL
    t = t + "n = REQUEST.Query(""n"")" + NL
    t = t + "line = FindIndex(viewer, f, n)" + NL
    t = t + "IF line = """" THEN RESPONSE.Redirect(""inbox.asp?f="" + f)" + NL
    t = t + "letter = LoadLetter(viewer, n)" + NL
    t = t + "IF f = ""inbox"" THEN MarkRead(viewer, line)" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(Header(letter, ""Subject"")) %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= BoxTop(H(Header(letter, ""Subject""))) %>" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td><font size=""2"" color=""#808080"">From:</font></td><td><font size=""2""><b><%= H(Header(letter, ""From"")) %></b></font></td></tr>" + NL
    t = t + "<tr><td><font size=""2"" color=""#808080"">To:</font></td><td><font size=""2""><%= H(Header(letter, ""To"")) %></font></td></tr>" + NL
    t = t + "<tr><td><font size=""2"" color=""#808080"">Date:</font></td><td><font size=""2""><%= H(Header(letter, ""Date"")) %></font></td></tr>" + NL
    t = t + "<% IF Header(letter, ""Received"") <> """" THEN %><tr><td><font size=""2"" color=""#808080"">Received:</font></td><td><font size=""1""><%= H(Header(letter, ""Received"")) %></font></td></tr><% END IF %>" + NL
    t = t + "</table>" + NL
    t = t + "<hr>" + NL
    t = t + "<pre><%= HtmlUpTo(Body(letter), PAGEROOM) %></pre>" + NL
    t = t + "<hr>" + NL
    t = t + "<table cellpadding=""4""><tr>" + NL
    t = t + "<td><form action=""compose.asp"" method=""get""><input type=""hidden"" name=""reply"" value=""<%= n %>""><input type=""hidden"" name=""f"" value=""<%= f %>""><input type=""submit"" value=""Reply""></form></td>" + NL
    t = t + "<td><form action=""compose.asp"" method=""get""><input type=""hidden"" name=""fwd"" value=""<%= n %>""><input type=""hidden"" name=""f"" value=""<%= f %>""><input type=""submit"" value=""Forward""></form></td>" + NL
    t = t + "<td><form action=""delete.asp"" method=""post""><%= TokenField() %><input type=""hidden"" name=""f"" value=""<%= f %>""><input type=""hidden"" name=""d<%= n %>"" value=""1""><input type=""submit"" value=""Delete""></form></td>" + NL
    t = t + "<td><font size=""2""><a href=""inbox.asp?f=<%= f %>"">Back to <% IF f = ""sent"" THEN %>Sent<% ELSE %>Inbox<% END IF %></a></font></td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\READ.ASP")
    FS.Write(Dest("C:\WEB\DIST\11.TXT"), t)
    FS.Append(Dest("C:\WEB\DIST\MANIFEST.TXT"), "11|C:\WEB\READ.ASP" + NL)
END SUB

SUB File12 ()
    t = ""
    t = t + "' MAILD.SPK - the ColdMail mail server. Listens on port 25 and delivers mail." + NL
    t = t + "'" + NL
    t = t + "' Two jobs:" + NL
    t = t + "'   1. Receive. Other machines' mail servers connect to port 25 and speak a small" + NL
    t = t + "'      SMTP: one command per message, one answer per command." + NL
    t = t + "'          S: 220 ALPHA ColdMail ready" + NL
    t = t + "'          C: HELO BRAVO                      S: 250 Hello BRAVO" + NL
    t = t + "'          C: MAIL FROM:<bob@bravo>           S: 250 OK" + NL
    t = t + "'          C: RCPT TO:<ann@alpha>             S: 250 OK   (or 550 No such user here)" + NL
    t = t + "'          C: DATA + line break + the message S: 250 OK delivered" + NL
    t = t + "'          C: QUIT                            S: 221 Bye" + NL
    t = t + "'      SMTP sends DATA line by line; here the whole message is one network" + NL
    t = t + "'      message, so a letter must fit in 64K like everything else." + NL
    t = t + "'   2. Send. The webmail pages cannot open sockets, so they leave each letter in" + NL
    t = t + "'      C:\MAILDATA\SPOOL. Every few seconds this program delivers what is there:" + NL
    t = t + "'      into a mailbox on this machine, or over port 25 to the recipient's machine." + NL
    t = t + "'      A machine that does not answer is tried again later; a letter that cannot" + NL
    t = t + "'      be delivered comes back to its sender from MAILER-DAEMON." + NL
    t = t + "'" + NL
    t = t + "' Mailboxes: C:\MAILDATA\BOX\<user>\<n>.MSG, listed in INBOX.TXT (and SENT.TXT)" + NL
    t = t + "' as  n|date|from|to|subject|size|flags  - flags holds N while a letter is unread." + NL
    t = t + "' The webmail (C:\WEB\MAIL.SPK) reads and writes the same files." + NL
    t = t + "'" + NL
    t = t + "' 3. Collect. Mail programs (Frostbird) connect to port 110 and speak a small" + NL
    t = t + "'    POP, one command and one answer per message, to read and send mail:" + NL
    t = t + "'          S: +OK ALPHA ColdMail POP ready" + NL
    t = t + "'          C: USER ann                  S: +OK" + NL
    t = t + "'          C: PASS secret               S: +OK 3 letters  (or -ERR)" + NL
    t = t + "'          C: LIST [INBOX|SENT]         S: +OK + one line per letter, as in INBOX.TXT" + NL
    t = t + "'          C: RETR 7                    S: +OK + the letter (and it is no longer unread)" + NL
    t = t + "'          C: DELE 7                    S: +OK" + NL
    t = t + "'          C: SEND + line break + To:/Subject: lines, a blank line, the text" + NL
    t = t + "'                                       S: +OK sent  (spooled like the webmail's)" + NL
    t = t + "'          C: QUIT                      S: +OK Bye" + NL
    t = t + "'" + NL
    t = t + "' C:\MAILDATA\MAILD.INI can set  retry=<seconds between tries>  and  tries=<count>." + NL
    t = t + "'" + NL
    t = t + "' Domain names (SimDNS). The builder joins the resolver (simweb/src/RESOLVE.SPK," + NL
    t = t + "' the Rs... names) on the end, and C:\SYSTEM\RESOLV.INI says which name server" + NL
    t = t + "' to ask. Mail for ann@coolsite.sim goes where the domain's MX record says" + NL
    t = t + "' (the lowest preference), or failing that to the domain's own machine, or" + NL
    t = t + "' failing that to a SIM95 machine called coolsite.sim, as before. Each" + NL
    t = t + "' question takes a tick of its own, like a delivery." + NL
    t = t + "' And this server takes mail for a domain as its own when the domain's MX (or" + NL
    t = t + "' the domain itself) points at this machine, or when the domain is listed in" + NL
    t = t + "' C:\MAILDATA\DOMAINS.TXT, one a line: dab@coolsite.sim goes to the mailbox dab." + NL
    t = t + "' For a domain it hasn't looked up yet it answers 451 (try again shortly) and" + NL
    t = t + "' asks in its next tick; the sending server tries again, as servers do." + NL
    t = t + "'" + NL
    t = t + "' One SIM95 quirk shapes the sending loop: a failed wait (a Connect nobody" + NL
    t = t + "' answers, a Receive that times out) can be caught with TRY, but the handler it" + NL
    t = t + "' happened in is spoiled: the error comes back at its next wait, and at the" + NL
    t = t + "' next pause the interpreter takes every 512 statements. So after a failed" + NL
    t = t + "' delivery the tick ends at once, noting only which letter and why" + NL
    t = t + "' (pendingPath, pendingAnswer); the next tick, a fresh handler, writes down the" + NL
    t = t + "' retry or the bounce before anything else. The whole tick sits in a TRY with" + NL
    t = t + "' an empty CATCH and nothing after it, so a spoiled tick can only end. The" + NL
    t = t + "' failed letter then waits for its retry time and cannot hold up the others." + NL
    t = t + "" + NL
    t = t + "CONST DATA = ""C:\MAILDATA""" + NL
    t = t + "CONST PORT = 25" + NL
    t = t + "CONST POPPORT = 110" + NL
    t = t + "CONST MAXBODY = 8000" + NL
    t = t + "CONST MAXTO = 10" + NL
    t = t + "" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR log AS GUI_ListBox" + NL
    t = t + "VAR sock AS NET_Socket" + NL
    t = t + "VAR pop AS NET_Socket" + NL
    t = t + "VAR timer AS GUI_Timer" + NL
    t = t + "VAR busy AS Bool" + NL
    t = t + "VAR busySince AS Integer      ' a tick cut short by a spoiled handler leaves busy set; this lets go" + NL
    t = t + "VAR failed AS Bool            ' a wait failed in this tick: it must end now" + NL
    t = t + "VAR pendingPath AS String     ' the letter it was, for the next tick to settle" + NL
    t = t + "VAR pendingAnswer AS String" + NL
    t = t + "VAR outSock AS NET_Socket" + NL
    t = t + "VAR retry AS Integer = 30" + NL
    t = t + "VAR tries AS Integer = 5" + NL
    t = t + "VAR received AS Integer" + NL
    t = t + "VAR sent AS Integer" + NL
    t = t + "VAR checkDomains AS Array OF String  ' domains a RCPT TO was about, to look up" + NL
    t = t + "VAR mineDom AS Array OF String       ' domains found to be ours, and when" + NL
    t = t + "VAR mineAt AS Array OF Integer" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    win = GUI_Window.New(""ColdMail Server"", 460, 240)" + NL
    t = t + "    win.Icon = ""network""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    win.onResize = Win_OnResize" + NL
    t = t + "    log = GUI_ListBox.New(win)" + NL
    t = t + "    log.Mono = TRUE" + NL
    t = t + "    Win_OnResize()" + NL
    t = t + "    EnsureDirs()" + NL
    t = t + "    ReadSettings()" + NL
    t = t + "" + NL
    t = t + "    sock = NET_Socket.New()" + NL
    t = t + "    sock.onConnect = Sock_OnConnect" + NL
    t = t + "    sock.onMessage = Sock_OnMessage" + NL
    t = t + "    sock.onError = Sock_OnError" + NL
    t = t + "    sock.Listen(PORT)" + NL
    t = t + "    Note(""Listening on port "" + Str(PORT) + "" as "" + NET.HostName)" + NL
    t = t + "    pop = NET_Socket.New()" + NL
    t = t + "    pop.onConnect = Pop_OnConnect" + NL
    t = t + "    pop.onMessage = Pop_OnMessage" + NL
    t = t + "    pop.onError = Sock_OnError" + NL
    t = t + "    pop.Listen(POPPORT)" + NL
    t = t + "    Note(""Mail programs collect on port "" + Str(POPPORT))" + NL
    t = t + "" + NL
    t = t + "    timer = GUI_Timer.New(win)" + NL
    t = t + "    timer.Interval = 2000" + NL
    t = t + "    timer.onTick = Timer_OnTick" + NL
    t = t + "    timer.Start()" + NL
    t = t + "    Status()" + NL
    t = t + "    win.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnResize ()" + NL
    t = t + "    log.SetBounds(0, 0, win.Width, win.Height)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    sock.Close()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnError (message AS String)" + NL
    t = t + "    Note(""ERROR "" + message)" + NL
    t = t + "    IF message.Contains(""in use"") THEN Note(""Is another mail server already running? See Tasks."")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Note (text AS String)" + NL
    t = t + "    log.Add(TIME.Clock + ""  "" + text)" + NL
    t = t + "    IF log.Count > 300 THEN log.RemoveAt(0)" + NL
    t = t + "    log.ScrollToEnd()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Status ()" + NL
    t = t + "    win.Status = NET.HostName.Lower() + "" port "" + Str(PORT) + "" - "" + Str(received) + "" received, "" + Str(sent) + "" sent, "" + Str(Spooled().Count) + "" waiting""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB EnsureDirs ()" + NL
    t = t + "    IF NOT FS.Exists(DATA) THEN FS.MakeDir(DATA)" + NL
    t = t + "    IF NOT FS.Exists(DATA + ""\BOX"") THEN FS.MakeDir(DATA + ""\BOX"")" + NL
    t = t + "    IF NOT FS.Exists(DATA + ""\SPOOL"") THEN FS.MakeDir(DATA + ""\SPOOL"")" + NL
    t = t + "    IF NOT FS.Exists(DATA + ""\USERS"") THEN FS.MakeDir(DATA + ""\USERS"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ReadSettings ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    IF NOT FS.Exists(DATA + ""\MAILD.INI"") THEN RETURN" + NL
    t = t + "    FOR EACH line IN FS.Read(DATA + ""\MAILD.INI"").Lines()" + NL
    t = t + "        IF line.StartsWith(""retry="") THEN retry = Int(Val(line.Substring(6, line.Length - 6)))" + NL
    t = t + "        IF line.StartsWith(""tries="") THEN tries = Int(Val(line.Substring(6, line.Length - 6)))" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- addresses" + NL
    t = t + "" + NL
    t = t + "' ""Ann <ann@alpha>"" or ""ann@alpha"" -> ""ann@alpha""" + NL
    t = t + "FUNCTION Bare (address AS String) AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    a = address.Trim()" + NL
    t = t + "    IF a.Contains(""<"") AND a.Contains("">"") THEN a = a.Substring(a.IndexOf(""<"") + 1, a.IndexOf("">"") - a.IndexOf(""<"") - 1)" + NL
    t = t + "    RETURN a.Trim().Lower()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UserPart (address AS String) AS String" + NL
    t = t + "    IF NOT address.Contains(""@"") THEN RETURN address" + NL
    t = t + "    RETURN address.Substring(0, address.IndexOf(""@""))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION HostPart (address AS String) AS String" + NL
    t = t + "    IF NOT address.Contains(""@"") THEN RETURN """"" + NL
    t = t + "    RETURN address.Substring(address.IndexOf(""@"") + 1, address.Length - address.IndexOf(""@"") - 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' This machine by its full name, its computer name, or localhost." + NL
    t = t + "FUNCTION IsLocal (host AS String) AS Bool" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Upper()" + NL
    t = t + "    RETURN h = """" OR h = ""LOCALHOST"" OR h = NET.HostName.Upper() OR h = NET.HostName.Upper().Split(""."")[0]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' This machine, or a domain whose mail comes here: listed in DOMAINS.TXT, or" + NL
    t = t + "' its MX (or the domain itself, with no MX) points at this machine." + NL
    t = t + "FUNCTION IsMine (host AS String) AS Bool" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR target AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF IsLocal(h) THEN RETURN TRUE" + NL
    t = t + "    IF NOT h.Contains(""."") THEN RETURN FALSE" + NL
    t = t + "    IF FS.Exists(DATA + ""\DOMAINS.TXT"") THEN" + NL
    t = t + "        FOR EACH line IN FS.Read(DATA + ""\DOMAINS.TXT"").Lines()" + NL
    t = t + "            IF line.Trim().Lower() = h THEN RETURN TRUE" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    i = mineDom.IndexOf(h)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        IF TIME.Now - mineAt[i] < 3600 THEN RETURN TRUE" + NL
    t = t + "        mineDom.RemoveAt(i)" + NL
    t = t + "        mineAt.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT RsMailKnown(h) THEN RETURN FALSE" + NL
    t = t + "    target = RsMailTarget(h).Lower()" + NL
    t = t + "    IF NOT (IsLocal(target) OR target = NET.LocalAddress) THEN RETURN FALSE" + NL
    t = t + "    mineDom.Add(h)" + NL
    t = t + "    mineAt.Add(TIME.Now)" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Must the name server be asked about this domain before we know whose it is?" + NL
    t = t + "FUNCTION NeedsLookup (host AS String) AS Bool" + NL
    t = t + "    IF RsWantsMx(host) THEN RETURN TRUE" + NL
    t = t + "    RETURN RsWants(RsMailHost(host))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ValidUser (u AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF u.Length < 3 OR u.Length > 8 THEN RETURN FALSE" + NL
    t = t + "    FOR i = 0 TO u.Length - 1" + NL
    t = t + "        IF NOT ""abcdefghijklmnopqrstuvwxyz0123456789"".Contains(u.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION HasMailbox (u AS String) AS Bool" + NL
    t = t + "    IF NOT ValidUser(u) THEN RETURN FALSE" + NL
    t = t + "    RETURN FS.Exists(DATA + ""\USERS\"" + u + "".TXT"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- mailboxes" + NL
    t = t + "" + NL
    t = t + "FUNCTION Esc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%"", ""%25"").Replace(""|"", ""%7C"").Replace(Chr(13), """").Replace(Chr(10), ""%0A"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The value of one header line of a letter, or """"." + NL
    t = t + "FUNCTION Header (message AS String, name AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN message.Lines()" + NL
    t = t + "        IF line = """" THEN RETURN """"" + NL
    t = t + "        IF line.Lower().StartsWith(name.Lower() + "":"") THEN RETURN line.Substring(name.Length + 1, line.Length - name.Length - 1).Trim()" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Puts a letter in a user's Inbox, unread. The webmail's SaveLetter does the same." + NL
    t = t + "SUB Deliver (u AS String, message AS String)" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    dir = DATA + ""\BOX\"" + u" + NL
    t = t + "    IF NOT FS.Exists(dir) THEN FS.MakeDir(dir)" + NL
    t = t + "    n = 1" + NL
    t = t + "    IF FS.Exists(dir + ""\NEXT.TXT"") THEN n = Int(Val(FS.Read(dir + ""\NEXT.TXT""))) + 1" + NL
    t = t + "    FS.Write(dir + ""\NEXT.TXT"", Str(n))" + NL
    t = t + "    FS.Write(dir + ""\"" + Str(n) + "".MSG"", message)" + NL
    t = t + "    FS.Append(dir + ""\INBOX.TXT"", Str(n) + ""|"" + TIME.Date + "" "" + TIME.Clock.Substring(0, 5) + ""|"" + Esc(Header(message, ""From"")) + ""|"" + Esc(Header(message, ""To"")) + ""|"" + Esc(Header(message, ""Subject"")) + ""|"" + Str(message.Length) + ""|N"" + Chr(10))" + NL
    t = t + "    received = received + 1" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Sends a letter that could not be delivered back to its (local) sender." + NL
    t = t + "SUB Bounce (sender AS String, recipient AS String, reason AS String, message AS String)" + NL
    t = t + "    VAR u AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    u = UserPart(sender)" + NL
    t = t + "    Note(""Bounced to "" + sender + "": "" + reason)" + NL
    t = t + "    IF NOT IsMine(HostPart(sender)) OR NOT HasMailbox(u) THEN RETURN" + NL
    t = t + "    IF Header(message, ""From"").Lower().Contains(""mailer-daemon"") THEN RETURN" + NL
    t = t + "    text = ""From: Mail Delivery Subsystem <mailer-daemon@"" + NET.HostName.Lower() + "">"" + Chr(10) _" + NL
    t = t + "         + ""To: "" + sender + Chr(10) _" + NL
    t = t + "         + ""Subject: Undeliverable: "" + Header(message, ""Subject"") + Chr(10) _" + NL
    t = t + "         + ""Date: "" + TIME.Date + "" "" + TIME.Clock + Chr(10) + Chr(10) _" + NL
    t = t + "         + ""This is the mail server on "" + NET.HostName.Lower() + ""."" + Chr(10) + Chr(10) _" + NL
    t = t + "         + ""I'm afraid I wasn't able to deliver your message to:"" + Chr(10) + Chr(10) _" + NL
    t = t + "         + ""    "" + recipient + Chr(10) + ""    "" + reason + Chr(10) + Chr(10) _" + NL
    t = t + "         + ""This is a permanent error. I've given up. Sorry it didn't work out."" + Chr(10) + Chr(10) _" + NL
    t = t + "         + ""------ This is a copy of your message ------"" + Chr(10) + Chr(10) + message" + NL
    t = t + "    IF text.Length > 60000 THEN text = text.Substring(0, 60000)" + NL
    t = t + "    Deliver(u, text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- receiving" + NL
    t = t + "" + NL
    t = t + "' An answer to the other server. It may already have hung up (it sends QUIT" + NL
    t = t + "' and closes without waiting for ""221 Bye""); that is no reason to stop." + NL
    t = t + "SUB Reply (conn AS NET_Connection, text AS String)" + NL
    t = t + "    IF NOT conn.IsOpen THEN RETURN" + NL
    t = t + "    TRY" + NL
    t = t + "        conn.Send(text)" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Each connection's state lives in its Tag: helo|from|rcpt1,rcpt2" + NL
    t = t + "SUB Sock_OnConnect (conn AS NET_Connection)" + NL
    t = t + "    conn.Accept()" + NL
    t = t + "    conn.Tag = ""||""" + NL
    t = t + "    Reply(conn, ""220 "" + NET.HostName + "" ColdMail ready"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR state AS Array OF String" + NL
    t = t + "    VAR cmd AS String" + NL
    t = t + "    VAR arg AS String" + NL
    t = t + "    VAR who AS String" + NL
    t = t + "    VAR r AS String" + NL
    t = t + "    VAR body AS String" + NL
    t = t + "    state = conn.Tag.Split(""|"")" + NL
    t = t + "    cmd = message.Lines()[0].Trim()" + NL
    t = t + "    arg = """"" + NL
    t = t + "    IF cmd.Contains("":"") THEN arg = cmd.Substring(cmd.IndexOf("":"") + 1, cmd.Length - cmd.IndexOf("":"") - 1)" + NL
    t = t + "    IF cmd.Contains("" "") AND arg = """" THEN arg = cmd.Substring(cmd.IndexOf("" "") + 1, cmd.Length - cmd.IndexOf("" "") - 1)" + NL
    t = t + "    cmd = cmd.Upper()" + NL
    t = t + "" + NL
    t = t + "    IF cmd.StartsWith(""HELO"") OR cmd.StartsWith(""EHLO"") THEN" + NL
    t = t + "        state[0] = arg.Trim()" + NL
    t = t + "        Reply(conn, ""250 Hello "" + arg.Trim() + "", pleased to meet you"")" + NL
    t = t + "    ELSEIF cmd.StartsWith(""MAIL FROM"") THEN" + NL
    t = t + "        state[1] = Bare(arg)" + NL
    t = t + "        state[2] = """"" + NL
    t = t + "        Reply(conn, ""250 OK"")" + NL
    t = t + "    ELSEIF cmd.StartsWith(""RCPT TO"") THEN" + NL
    t = t + "        who = Bare(arg)" + NL
    t = t + "        IF state[1] = """" THEN" + NL
    t = t + "            Reply(conn, ""503 MAIL FROM first"")" + NL
    t = t + "        ELSEIF NOT IsMine(HostPart(who)) AND NeedsLookup(HostPart(who)) THEN" + NL
    t = t + "            ' (no lookups here: the timer asks, and the sender tries again)" + NL
    t = t + "            IF NOT checkDomains.Contains(HostPart(who)) THEN checkDomains.Add(HostPart(who))" + NL
    t = t + "            Reply(conn, ""451 Looking up "" + HostPart(who) + ""; try again shortly"")" + NL
    t = t + "        ELSEIF NOT IsMine(HostPart(who)) THEN" + NL
    t = t + "            Reply(conn, ""551 I only take mail for "" + NET.HostName.Lower())" + NL
    t = t + "        ELSEIF NOT HasMailbox(UserPart(who)) THEN" + NL
    t = t + "            Reply(conn, ""550 No such user here: "" + UserPart(who))" + NL
    t = t + "        ELSE" + NL
    t = t + "            IF state[2] <> """" THEN state[2] = state[2] + "",""" + NL
    t = t + "            state[2] = state[2] + UserPart(who)" + NL
    t = t + "            Reply(conn, ""250 OK"")" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSEIF cmd.StartsWith(""DATA"") THEN" + NL
    t = t + "        IF state[2] = """" THEN" + NL
    t = t + "            Reply(conn, ""503 RCPT TO first"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            body = """"" + NL
    t = t + "            IF message.Contains(Chr(10)) THEN body = message.Substring(message.IndexOf(Chr(10)) + 1, message.Length - message.IndexOf(Chr(10)) - 1)" + NL
    t = t + "            body = ""Received: from "" + state[0] + "" ("" + conn.FromAddress + "") by "" + NET.HostName.Lower() + ""; "" + TIME.Date + "" "" + TIME.Clock + Chr(10) + body" + NL
    t = t + "            FOR EACH r IN state[2].Split("","")" + NL
    t = t + "                Deliver(r, body)" + NL
    t = t + "            NEXT" + NL
    t = t + "            Note(""Received mail from "" + state[1] + "" ("" + conn.FromAddress + "") for "" + state[2])" + NL
    t = t + "            state[1] = """"" + NL
    t = t + "            state[2] = """"" + NL
    t = t + "            Reply(conn, ""250 OK delivered"")" + NL
    t = t + "            Status()" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSEIF cmd = ""RSET"" THEN" + NL
    t = t + "        state[1] = """"" + NL
    t = t + "        state[2] = """"" + NL
    t = t + "        Reply(conn, ""250 OK"")" + NL
    t = t + "    ELSEIF cmd = ""NOOP"" THEN" + NL
    t = t + "        Reply(conn, ""250 OK"")" + NL
    t = t + "    ELSEIF cmd = ""QUIT"" THEN" + NL
    t = t + "        Reply(conn, ""221 Bye"")" + NL
    t = t + "        conn.Close()" + NL
    t = t + "        RETURN" + NL
    t = t + "    ELSE" + NL
    t = t + "        Reply(conn, ""500 What? I know HELO, MAIL FROM, RCPT TO, DATA, RSET, NOOP and QUIT"")" + NL
    t = t + "    END IF" + NL
    t = t + "    conn.Tag = state.Join(""|"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- collecting (port 110)" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unesc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%0A"", Chr(10)).Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' An account's setting (the webmail writes them: name, salt, pass)." + NL
    t = t + "FUNCTION Field (u AS String, key AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(DATA + ""\USERS\"" + u + "".TXT"", """").Lines()" + NL
    t = t + "        IF line.StartsWith(key + ""="") THEN RETURN Unesc(line.Substring(key.Length + 1, line.Length - key.Length - 1))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The webmail's password hash, the same to the letter." + NL
    t = t + "FUNCTION Hash (salt AS String, pw AS String) AS String" + NL
    t = t + "    VAR a AS Integer = 7" + NL
    t = t + "    VAR b AS Integer = 31337" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = salt + "":"" + pw + "":"" + salt" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        c = Asc(s.CharAt(i))" + NL
    t = t + "        a = (a * 131 + c) MOD 2147483629" + NL
    t = t + "        b = (b * 257 + c + a) MOD 2147483587" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN Hex(a) + ""-"" + Hex(b)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Password (u AS String, pw AS String) AS Bool" + NL
    t = t + "    IF NOT HasMailbox(u) THEN RETURN FALSE" + NL
    t = t + "    RETURN Hash(Field(u, ""salt""), pw) = Field(u, ""pass"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The index line of letter n in a user's folders, or """"." + NL
    t = t + "FUNCTION IndexLine (u AS String, n AS String, folder AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(DATA + ""\BOX\"" + u + ""\"" + folder, """").Lines()" + NL
    t = t + "        IF line.Split(""|"")[0] = n THEN RETURN line" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SwapIndex (u AS String, folder AS String, line AS String, other AS String)" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    text = Chr(10) + ReadOr(DATA + ""\BOX\"" + u + ""\"" + folder, """")" + NL
    t = t + "    IF other = """" THEN" + NL
    t = t + "        text = text.Replace(Chr(10) + line + Chr(10), Chr(10))" + NL
    t = t + "    ELSE" + NL
    t = t + "        text = text.Replace(Chr(10) + line + Chr(10), Chr(10) + other + Chr(10))" + NL
    t = t + "    END IF" + NL
    t = t + "    FS.Write(DATA + ""\BOX\"" + u + ""\"" + folder, text.Substring(1, text.Length - 1))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Each connection's state lives in its Tag: user|signed-in (1 or 0)" + NL
    t = t + "SUB Pop_OnConnect (conn AS NET_Connection)" + NL
    t = t + "    conn.Accept()" + NL
    t = t + "    conn.Tag = ""|0""" + NL
    t = t + "    Reply(conn, ""+OK "" + NET.HostName + "" ColdMail POP ready"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Pop_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR u AS String" + NL
    t = t + "    VAR cmd AS String" + NL
    t = t + "    VAR arg AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR folder AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR answer AS String" + NL
    t = t + "    u = conn.Tag.Split(""|"")[0]" + NL
    t = t + "    cmd = message.Lines()[0].Trim()" + NL
    t = t + "    arg = """"" + NL
    t = t + "    IF cmd.Contains("" "") THEN arg = cmd.Substring(cmd.IndexOf("" "") + 1, cmd.Length - cmd.IndexOf("" "") - 1).Trim()" + NL
    t = t + "    IF cmd.Contains("" "") THEN cmd = cmd.Substring(0, cmd.IndexOf("" ""))" + NL
    t = t + "    cmd = cmd.Upper()" + NL
    t = t + "    IF cmd = ""QUIT"" THEN" + NL
    t = t + "        Reply(conn, ""+OK Bye"")" + NL
    t = t + "        conn.Close()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF cmd = ""USER"" THEN" + NL
    t = t + "        conn.Tag = UserPart(Bare(arg)) + ""|0""" + NL
    t = t + "        Reply(conn, ""+OK say PASS"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF cmd = ""PASS"" THEN" + NL
    t = t + "        IF Password(u, arg) THEN" + NL
    t = t + "            conn.Tag = u + ""|1""" + NL
    t = t + "            n = 0" + NL
    t = t + "            FOR EACH line IN ReadOr(DATA + ""\BOX\"" + u + ""\INBOX.TXT"", """").Lines()" + NL
    t = t + "                IF line <> """" THEN n = n + 1" + NL
    t = t + "            NEXT" + NL
    t = t + "            Note(""Mail program signed in as "" + u + "" from "" + conn.FromAddress)" + NL
    t = t + "            Reply(conn, ""+OK "" + Str(n) + "" letters"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            Reply(conn, ""-ERR That name and password do not match."")" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT conn.Tag.EndsWith(""|1"") THEN" + NL
    t = t + "        Reply(conn, ""-ERR USER and PASS first"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE cmd" + NL
    t = t + "        CASE ""STAT"", ""LIST""" + NL
    t = t + "            folder = ""INBOX.TXT""" + NL
    t = t + "            IF arg.Upper() = ""SENT"" THEN folder = ""SENT.TXT""" + NL
    t = t + "            Reply(conn, ""+OK"" + Chr(10) + ReadOr(DATA + ""\BOX\"" + u + ""\"" + folder, """").Trim())" + NL
    t = t + "        CASE ""RETR""" + NL
    t = t + "            n = Int(Val(arg))" + NL
    t = t + "            IF NOT FS.Exists(DATA + ""\BOX\"" + u + ""\"" + Str(n) + "".MSG"") THEN" + NL
    t = t + "                Reply(conn, ""-ERR No letter "" + arg)" + NL
    t = t + "            ELSE" + NL
    t = t + "                ' read now: the N flag goes, as when it is opened in the webmail" + NL
    t = t + "                line = IndexLine(u, Str(n), ""INBOX.TXT"")" + NL
    t = t + "                IF line <> """" AND line.EndsWith(""|N"") THEN SwapIndex(u, ""INBOX.TXT"", line, line.Substring(0, line.Length - 1))" + NL
    t = t + "                Reply(conn, ""+OK"" + Chr(10) + FS.Read(DATA + ""\BOX\"" + u + ""\"" + Str(n) + "".MSG""))" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""DELE""" + NL
    t = t + "            n = Int(Val(arg))" + NL
    t = t + "            FOR EACH folder IN [""INBOX.TXT"", ""SENT.TXT""]" + NL
    t = t + "                line = IndexLine(u, Str(n), folder)" + NL
    t = t + "                IF line <> """" THEN SwapIndex(u, folder, line, """")" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF FS.Exists(DATA + ""\BOX\"" + u + ""\"" + Str(n) + "".MSG"") THEN FS.Delete(DATA + ""\BOX\"" + u + ""\"" + Str(n) + "".MSG"")" + NL
    t = t + "            Reply(conn, ""+OK deleted"")" + NL
    t = t + "        CASE ""SEND""" + NL
    t = t + "            answer = SendFrom(u, message)" + NL
    t = t + "            IF answer = """" THEN" + NL
    t = t + "                Reply(conn, ""+OK sent"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                Reply(conn, ""-ERR "" + answer)" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""NOOP""" + NL
    t = t + "            Reply(conn, ""+OK"")" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            Reply(conn, ""-ERR I know USER, PASS, LIST, RETR, DELE, SEND, NOOP and QUIT"")" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A letter from a mail program: ""SEND"", then To: and Subject: lines, a blank" + NL
    t = t + "' line and the text. It is spooled, and kept in Sent, just as the webmail does." + NL
    t = t + "FUNCTION SendFrom (u AS String, message AS String) AS String" + NL
    t = t + "    VAR head AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR toList AS String" + NL
    t = t + "    VAR subject AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR rcpts AS Array OF String" + NL
    t = t + "    VAR letter AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    message = message.Replace(Chr(13), """")" + NL
    t = t + "    IF message.Contains(Chr(10)) THEN message = message.Substring(message.IndexOf(Chr(10)) + 1, message.Length - message.IndexOf(Chr(10)) - 1)" + NL
    t = t + "    IF message.Contains(Chr(10) + Chr(10)) THEN" + NL
    t = t + "        head = message.Substring(0, message.IndexOf(Chr(10) + Chr(10)) + 1)" + NL
    t = t + "        text = message.Substring(message.IndexOf(Chr(10) + Chr(10)) + 2, message.Length - message.IndexOf(Chr(10) + Chr(10)) - 2)" + NL
    t = t + "    ELSE" + NL
    t = t + "        head = message + Chr(10)" + NL
    t = t + "    END IF" + NL
    t = t + "    toList = Header(head + Chr(10), ""To"")" + NL
    t = t + "    subject = Header(head + Chr(10), ""Subject"")" + NL
    t = t + "    IF text.Length > MAXBODY THEN RETURN ""Keep letters under "" + Str(MAXBODY) + "" characters.""" + NL
    t = t + "    FOR EACH a IN toList.Replace("";"", "","").Split("","")" + NL
    t = t + "        a = Bare(a)" + NL
    t = t + "        IF a = """" THEN CONTINUE" + NL
    t = t + "        IF NOT a.Contains(""@"") THEN a = a + ""@"" + NET.HostName.Lower()" + NL
    t = t + "        IF NOT ValidUser(UserPart(a)) OR HostPart(a) = """" THEN RETURN ""'"" + a + ""' is not an address. Addresses look like ann@alpha.""" + NL
    t = t + "        IF NOT rcpts.Contains(a) THEN rcpts.Add(a)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF rcpts.Count = 0 THEN RETURN ""Who is it to?""" + NL
    t = t + "    IF rcpts.Count > MAXTO THEN RETURN ""Send it to "" + Str(MAXTO) + "" people at most.""" + NL
    t = t + "    IF subject = """" THEN subject = ""(no subject)""" + NL
    t = t + "    IF subject.Length > 100 THEN subject = subject.Substring(0, 100)" + NL
    t = t + "    letter = ""From: "" + Field(u, ""name"") + "" <"" + u + ""@"" + NET.HostName.Lower() + "">"" + Chr(10) _" + NL
    t = t + "           + ""To: "" + rcpts.Join("", "") + Chr(10) _" + NL
    t = t + "           + ""Subject: "" + subject + Chr(10) _" + NL
    t = t + "           + ""Date: "" + TIME.Date + "" "" + TIME.Clock + Chr(10) _" + NL
    t = t + "           + ""X-Mailer: Frostbird 1.0 (SIM95)"" + Chr(10) + Chr(10) + text" + NL
    t = t + "    FOR EACH a IN rcpts" + NL
    t = t + "        n = Int(Val(ReadOr(DATA + ""\SPOOLID.TXT"", ""0""))) + 1" + NL
    t = t + "        FS.Write(DATA + ""\SPOOLID.TXT"", Str(n))" + NL
    t = t + "        FS.Write(DATA + ""\SPOOL\"" + Str(n) + "".MSG"", ""X-Sender: "" + u + ""@"" + NET.HostName.Lower() + Chr(10) + ""X-Recipient: "" + a + Chr(10) + ""X-Tries: 0"" + Chr(10) + ""X-Next: 0"" + Chr(10) + Chr(10) + letter)" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' a copy in Sent" + NL
    t = t + "    dir = DATA + ""\BOX\"" + u" + NL
    t = t + "    n = 1" + NL
    t = t + "    IF FS.Exists(dir + ""\NEXT.TXT"") THEN n = Int(Val(FS.Read(dir + ""\NEXT.TXT""))) + 1" + NL
    t = t + "    FS.Write(dir + ""\NEXT.TXT"", Str(n))" + NL
    t = t + "    FS.Write(dir + ""\"" + Str(n) + "".MSG"", letter)" + NL
    t = t + "    FS.Append(dir + ""\SENT.TXT"", Str(n) + ""|"" + TIME.Date + "" "" + TIME.Clock.Substring(0, 5) + ""|"" + Esc(Header(letter, ""From"")) + ""|"" + Esc(Header(letter, ""To"")) + ""|"" + Esc(subject) + ""|"" + Str(letter.Length) + ""|"" + Chr(10))" + NL
    t = t + "    Note(u + "" sent mail from a mail program to "" + rcpts.Join("", ""))" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- sending" + NL
    t = t + "" + NL
    t = t + "' A spooled letter is C:\MAILDATA\SPOOL\<n>.MSG:" + NL
    t = t + "'   X-Sender: ann@alpha" + NL
    t = t + "'   X-Recipient: bob@bravo" + NL
    t = t + "'   X-Tries: 0" + NL
    t = t + "'   X-Next: 0            (TIME.Now when it may be tried again)" + NL
    t = t + "'   (blank line, then the letter itself)" + NL
    t = t + "" + NL
    t = t + "FUNCTION Spooled () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    FOR EACH f IN FS.List(DATA + ""\SPOOL"")" + NL
    t = t + "        IF f.EndsWith("".MSG"") THEN out.Add(f)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Timer_OnTick ()" + NL
    t = t + "    TRY" + NL
    t = t + "        Tick()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Tick ()" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    IF busy AND TIME.Now - busySince < 20 THEN RETURN" + NL
    t = t + "    busy = TRUE" + NL
    t = t + "    busySince = TIME.Now" + NL
    t = t + "    FS.Write(DATA + ""\ALIVE.TXT"", Str(TIME.Now))" + NL
    t = t + "    failed = FALSE" + NL
    t = t + "    IF pendingPath <> """" THEN Settle()" + NL
    t = t + "    ' domains other servers sent mail for: are they ours? (one question a tick)" + NL
    t = t + "    WHILE checkDomains.Count > 0" + NL
    t = t + "        IF RsNextMail(checkDomains[0]) THEN" + NL
    t = t + "            busy = FALSE" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        IF IsMine(checkDomains[0]) THEN Note(checkDomains[0] + ""'s mail comes here"")" + NL
    t = t + "        checkDomains.RemoveAt(0)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    TRY" + NL
    t = t + "        FOR EACH f IN Spooled()" + NL
    t = t + "            Attempt(DATA + ""\SPOOL\"" + f)" + NL
    t = t + "            IF failed THEN RETURN" + NL
    t = t + "        NEXT" + NL
    t = t + "    CATCH err" + NL
    t = t + "        IF failed THEN RETURN" + NL
    t = t + "        Note(""ERROR "" + err)" + NL
    t = t + "    END TRY" + NL
    t = t + "    busy = FALSE" + NL
    t = t + "    Status()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Finishes the letter a spoiled tick left behind." + NL
    t = t + "SUB Settle ()" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR answer AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR head AS String" + NL
    t = t + "    path = pendingPath" + NL
    t = t + "    answer = pendingAnswer" + NL
    t = t + "    pendingPath = """"" + NL
    t = t + "    pendingAnswer = """"" + NL
    t = t + "    IF NOT IsNothing(outSock) THEN outSock.Close()" + NL
    t = t + "    IF answer = """" THEN answer = ""421 interrupted""" + NL
    t = t + "    IF NOT FS.Exists(path) THEN RETURN" + NL
    t = t + "    text = FS.Read(path)" + NL
    t = t + "    head = text.Substring(0, text.IndexOf(Chr(10) + Chr(10)))" + NL
    t = t + "    Conclude(path, Header(head, ""X-Sender""), Header(head, ""X-Recipient""), Int(Val(Header(head, ""X-Tries""))), text.Substring(head.Length + 2, text.Length - head.Length - 2), answer)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Attempt (path AS String)" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR head AS String" + NL
    t = t + "    VAR letter AS String" + NL
    t = t + "    VAR sender AS String" + NL
    t = t + "    VAR recipient AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR answer AS String" + NL
    t = t + "    IF NOT FS.Exists(path) THEN RETURN" + NL
    t = t + "    text = FS.Read(path)" + NL
    t = t + "    IF NOT text.Contains(Chr(10) + Chr(10)) THEN" + NL
    t = t + "        FS.Delete(path)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    head = text.Substring(0, text.IndexOf(Chr(10) + Chr(10)))" + NL
    t = t + "    letter = text.Substring(head.Length + 2, text.Length - head.Length - 2)" + NL
    t = t + "    sender = Header(head, ""X-Sender"")" + NL
    t = t + "    recipient = Header(head, ""X-Recipient"")" + NL
    t = t + "    n = Int(Val(Header(head, ""X-Tries"")))" + NL
    t = t + "    IF Int(Val(Header(head, ""X-Next""))) > TIME.Now THEN RETURN" + NL
    t = t + "" + NL
    t = t + "    ' a domain: where its mail goes, asked first in ticks of their own" + NL
    t = t + "    IF NOT IsMine(HostPart(recipient)) THEN" + NL
    t = t + "        IF RsNextMail(HostPart(recipient)) THEN" + NL
    t = t + "            failed = TRUE" + NL
    t = t + "            busy = FALSE" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    IF IsMine(HostPart(recipient)) THEN" + NL
    t = t + "        IF HasMailbox(UserPart(recipient)) THEN" + NL
    t = t + "            Deliver(UserPart(recipient), ""Received: by "" + NET.HostName.Lower() + ""; "" + TIME.Date + "" "" + TIME.Clock + Chr(10) + letter)" + NL
    t = t + "            Note(""Delivered "" + sender + "" -> "" + recipient)" + NL
    t = t + "            sent = sent + 1" + NL
    t = t + "        ELSE" + NL
    t = t + "            Bounce(sender, recipient, ""550 No such user here: "" + UserPart(recipient), letter)" + NL
    t = t + "        END IF" + NL
    t = t + "        FS.Delete(path)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "    pendingPath = path" + NL
    t = t + "    pendingAnswer = """"" + NL
    t = t + "    answer = Transfer(sender, recipient, letter)" + NL
    t = t + "    IF failed THEN RETURN" + NL
    t = t + "    pendingPath = """"" + NL
    t = t + "    Conclude(path, sender, recipient, n, letter, answer)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' What happens to a letter after one try at sending it." + NL
    t = t + "SUB Conclude (path AS String, sender AS String, recipient AS String, n AS Integer, letter AS String, answer AS String)" + NL
    t = t + "    IF answer.StartsWith(""250"") THEN" + NL
    t = t + "        Note(""Sent "" + sender + "" -> "" + recipient)" + NL
    t = t + "        sent = sent + 1" + NL
    t = t + "        FS.Delete(path)" + NL
    t = t + "    ELSEIF answer.StartsWith(""5"") THEN" + NL
    t = t + "        Bounce(sender, recipient, answer, letter)" + NL
    t = t + "        FS.Delete(path)" + NL
    t = t + "    ELSEIF n + 1 >= tries THEN" + NL
    t = t + "        Bounce(sender, recipient, ""Gave up after "" + Str(n + 1) + "" tries: "" + answer, letter)" + NL
    t = t + "        FS.Delete(path)" + NL
    t = t + "    ELSE" + NL
    t = t + "        Note(""Will try "" + recipient + "" again: "" + answer)" + NL
    t = t + "        FS.Write(path, ""X-Sender: "" + sender + Chr(10) + ""X-Recipient: "" + recipient + Chr(10) + ""X-Tries: "" + Str(n + 1) + Chr(10) + ""X-Next: "" + Str(TIME.Now + retry) + Chr(10) + Chr(10) + letter)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Hands one letter to the recipient's mail server. Returns its final answer:" + NL
    t = t + "' ""250 ..."" delivered, ""5xx ..."" refused for good, anything else: try later." + NL
    t = t + "FUNCTION Transfer (sender AS String, recipient AS String, letter AS String) AS String" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR answer AS String" + NL
    t = t + "    outSock = NET_Socket.New()" + NL
    t = t + "    TRY" + NL
    t = t + "        ' the machine the domain's MX names, or the domain's, or the name itself" + NL
    t = t + "        conn = outSock.Connect(RsMailTarget(HostPart(recipient)), PORT)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        failed = TRUE" + NL
    t = t + "        pendingAnswer = ""421 "" + err" + NL
    t = t + "        busy = FALSE" + NL
    t = t + "        RETURN pendingAnswer" + NL
    t = t + "    END TRY" + NL
    t = t + "    TRY" + NL
    t = t + "        answer = conn.Receive(5000)" + NL
    t = t + "        IF NOT answer.StartsWith(""220"") THEN THROW answer" + NL
    t = t + "        conn.Send(""HELO "" + NET.HostName)" + NL
    t = t + "        answer = conn.Receive(5000)" + NL
    t = t + "        conn.Send(""MAIL FROM:<"" + sender + "">"")" + NL
    t = t + "        answer = conn.Receive(5000)" + NL
    t = t + "        IF NOT answer.StartsWith(""250"") THEN THROW answer" + NL
    t = t + "        conn.Send(""RCPT TO:<"" + recipient + "">"")" + NL
    t = t + "        answer = conn.Receive(5000)" + NL
    t = t + "        IF NOT answer.StartsWith(""250"") THEN THROW answer" + NL
    t = t + "        conn.Send(""DATA"" + Chr(10) + letter)" + NL
    t = t + "        answer = conn.Receive(10000)" + NL
    t = t + "        IF NOT answer.StartsWith(""250"") THEN THROW answer" + NL
    t = t + "        conn.Send(""QUIT"")" + NL
    t = t + "    CATCH err" + NL
    t = t + "        ' An answer we THREW ourselves leaves the handler fine; a failed Receive does not." + NL
    t = t + "        IF NOT (err.StartsWith(""5"") OR err.StartsWith(""4"") OR err.StartsWith(""2"")) THEN" + NL
    t = t + "            failed = TRUE" + NL
    t = t + "            pendingAnswer = ""421 "" + err" + NL
    t = t + "            busy = FALSE" + NL
    t = t + "            RETURN pendingAnswer" + NL
    t = t + "        END IF" + NL
    t = t + "        answer = err" + NL
    t = t + "    END TRY" + NL
    t = t + "    outSock.Close()" + NL
    t = t + "    RETURN answer" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' RESOLVE.SPK - the SimDNS resolver: asks the name server which machine a" + NL
    t = t + "' name like www.coolsite.sim is on." + NL
    t = t + "'" + NL
    t = t + "' The name server is the central one, STARTHERE.56k.net, where SimNIC (the" + NL
    t = t + "' registrar) and NAMED.SPK run, unless C:\SYSTEM\RESOLV.INI says otherwise." + NL
    t = t + "' To move the whole network to another central host, change RSCENTRAL below" + NL
    t = t + "' (the builder sets it from CENTRAL in tools/simxplorer-source.mjs)." + NL
    t = t + "'" + NL
    t = t + "' A library, not a program: a program has it joined on the end (the builder" + NL
    t = t + "' does this for Simxplorer, SimPlayer, Vapor, Frostbird, MAILD, the Sim Shell," + NL
    t = t + "' AskSim's crawler, DIG and Personal Web Manager; copy C:\PROGRAMS\RESOLVE.SPK" + NL
    t = t + "' onto the end of your own). Every name in it starts with Rs, so it can't clash." + NL
    t = t + "'" + NL
    t = t + "' C:\SYSTEM\RESOLV.INI, shared by every program on the machine (optional):" + NL
    t = t + "'     nameserver=dnsbox          another name server instead of the central one" + NL
    t = t + "'     nameserver=none            no SimDNS at all: SIM95 machine names only" + NL
    t = t + "'     search=coolsite.sim        then ""www"" means www.coolsite.sim" + NL
    t = t + "'" + NL
    t = t + "' How to use it without ever waiting in the wrong place (SIM95-NOTES.md):" + NL
    t = t + "'   1. RsWants(host)  - does this name need asking? FALSE for addresses," + NL
    t = t + "'                       plain machine names, names already known, or when" + NL
    t = t + "'                       there is no name server (or it isn't answering)." + NL
    t = t + "'   2. RsAsk(host, address) - sends the question to the name server at that" + NL
    t = t + "'                       address. It is a Connect: let it be the last thing" + NL
    t = t + "'                       the handler does." + NL
    t = t + "'   3. RsBusy()       - TRUE while the answer is on its way. After RSWAIT" + NL
    t = t + "'                       with no answer the server is left alone for RSQUIET," + NL
    t = t + "'                       and every name goes to SIM95 as before." + NL
    t = t + "'   4. RsTarget(host) - where to connect: the machine name (or address) the" + NL
    t = t + "'                       name server gave, or the name itself when SimDNS" + NL
    t = t + "'                       doesn't know it, for SIM95 to look up." + NL
    t = t + "' Answers are kept for their TTL; names SimDNS doesn't know for RSNEG." + NL
    t = t + "'" + NL
    t = t + "' Or, from a timer tick, all of that in one line (see RsNext):" + NL
    t = t + "'     IF RsNext(host) THEN RETURN          ' asked, or waiting: end the tick" + NL
    t = t + "'     conn = sock.Connect(RsTarget(host), 80)" + NL
    t = t + "' and for mail, the domain's MX first (see RsNextMail):" + NL
    t = t + "'     IF RsNextMail(domain) THEN RETURN" + NL
    t = t + "'     conn = sock.Connect(RsMailTarget(domain), 25)" + NL
    t = t + "" + NL
    t = t + "CONST RSCENTRAL = ""starthere.56k.net""   ' the central name server" + NL
    t = t + "CONST RSINI = ""C:\SYSTEM\RESOLV.INI""" + NL
    t = t + "CONST RSPORT = 53" + NL
    t = t + "CONST RSWAIT = 2000             ' ms to wait for an answer" + NL
    t = t + "CONST RSQUIET = 30000            ' ms to leave a silent name server alone" + NL
    t = t + "CONST RSNEG = 60000             ' ms to remember that SimDNS doesn't know a name" + NL
    t = t + "CONST RSMOST = 100              ' names kept" + NL
    t = t + "" + NL
    t = t + "VAR rsServer AS String              ' """" when SimDNS is off" + NL
    t = t + "VAR rsByDefault AS Bool               ' TRUE when RESOLV.INI doesn't name one" + NL
    t = t + "VAR rsSearch AS String" + NL
    t = t + "VAR rsRead AS Bool" + NL
    t = t + "VAR rsReadAt AS Integer" + NL
    t = t + "VAR rsSock AS NET_Socket" + NL
    t = t + "VAR rsName AS Array OF String       ' the name as asked, lower case" + NL
    t = t + "VAR rsTo AS Array OF String         ' where it is ("""" when SimDNS doesn't know it)" + NL
    t = t + "VAR rsCanon AS Array OF String      ' its last name in DNS before the machine" + NL
    t = t + "VAR rsUntil AS Array OF Integer     ' SYS.Ticks when it is forgotten" + NL
    t = t + "VAR rsAsking AS String" + NL
    t = t + "VAR rsAskAt AS Integer" + NL
    t = t + "VAR rsRefused AS Bool" + NL
    t = t + "VAR rsDown AS Bool" + NL
    t = t + "VAR rsDownAt AS Integer" + NL
    t = t + "VAR rsWhy AS String                 ' the last thing that went wrong" + NL
    t = t + "VAR rsLastReply AS String           ' the last answer, as it came" + NL
    t = t + "VAR rsServerAddr AS String          ' the name server's address, for RsNext" + NL
    t = t + "VAR rsServerFor AS String" + NL
    t = t + "VAR rsServerAt AS Integer" + NL
    t = t + "VAR rsLooking AS Bool               ' RsNext is finding the name server's address" + NL
    t = t + "VAR rsLookingAt AS Integer" + NL
    t = t + "" + NL
    t = t + "' Reads RESOLV.INI (again after a few seconds, so a new setting takes)." + NL
    t = t + "' With no nameserver= line, the central name server; none (or nothing after" + NL
    t = t + "' the =) turns SimDNS off." + NL
    t = t + "SUB RsConfig ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    IF rsRead AND SYS.Ticks - rsReadAt < 3000 THEN RETURN" + NL
    t = t + "    rsRead = TRUE" + NL
    t = t + "    rsReadAt = SYS.Ticks" + NL
    t = t + "    rsServer = RSCENTRAL" + NL
    t = t + "    rsByDefault = TRUE" + NL
    t = t + "    rsSearch = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                low = line.Trim().Lower()" + NL
    t = t + "                IF low.StartsWith(""nameserver="") THEN" + NL
    t = t + "                    rsServer = low.Substring(11, low.Length - 11).Trim()" + NL
    t = t + "                    rsByDefault = FALSE" + NL
    t = t + "                END IF" + NL
    t = t + "                IF low.StartsWith(""search="") THEN rsSearch = low.Substring(7, low.Length - 7).Trim()" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF rsServer = ""none"" THEN rsServer = """"" + NL
    t = t + "    IF rsSearch.StartsWith(""."") THEN rsSearch = rsSearch.Substring(1, rsSearch.Length - 1)" + NL
    t = t + "    IF rsSearch.EndsWith(""."") THEN rsSearch = rsSearch.Substring(0, rsSearch.Length - 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The name server (a machine name or address), or """" for none." + NL
    t = t + "FUNCTION RsNameServer () AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsServer" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is it the central one, because RESOLV.INI doesn't say?" + NL
    t = t + "FUNCTION RsIsCentral () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsByDefault" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Makes server this machine's name server, keeping the rest of RESOLV.INI," + NL
    t = t + "' and forgets everything it knew. """" (or none) for no SimDNS at all;" + NL
    t = t + "' default for the central one again." + NL
    t = t + "SUB RsSave (server AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    server = server.Trim().Lower()" + NL
    t = t + "    IF server = """" THEN server = ""none""" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                IF line.Trim() <> """" AND NOT line.Trim().Lower().StartsWith(""nameserver="") THEN out.Add(line)" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "        IF server <> ""default"" THEN out.Insert(0, ""nameserver="" + server)" + NL
    t = t + "        IF out.Count = 0 THEN" + NL
    t = t + "            IF FS.Exists(RSINI) THEN FS.Delete(RSINI)" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Write(RSINI, out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsWhy = err" + NL
    t = t + "    END TRY" + NL
    t = t + "    rsRead = FALSE" + NL
    t = t + "    RsForget()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RsForget ()" + NL
    t = t + "    rsName.Clear()" + NL
    t = t + "    rsTo.Clear()" + NL
    t = t + "    rsCanon.Clear()" + NL
    t = t + "    rsUntil.Clear()" + NL
    t = t + "    rsDown = FALSE" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsIsAddress (s AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF s.Split(""."").Count <> 4 THEN RETURN FALSE" + NL
    t = t + "    FOR EACH p IN s.Split(""."")" + NL
    t = t + "        IF p = """" OR p.Length > 3 THEN RETURN FALSE" + NL
    t = t + "        FOR i = 0 TO p.Length - 1" + NL
    t = t + "            IF NOT ""0123456789"".Contains(p.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name the server is asked about: lower case, the search domain added" + NL
    t = t + "' to a single word." + NL
    t = t + "FUNCTION RsFull (host AS String) AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF h.EndsWith(""."") THEN h = h.Substring(0, h.Length - 1)" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch <> """" THEN h = h + ""."" + rsSearch" + NL
    t = t + "    RETURN h" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a name is in the list of answers, or -1 (old answers are dropped)." + NL
    t = t + "FUNCTION RsFind (host AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = rsName.IndexOf(host.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN -1" + NL
    t = t + "    IF SYS.Ticks > rsUntil[i] THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "        RETURN -1" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsWants (host AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(host) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(host) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for a mail domain's MX record." + NL
    t = t + "FUNCTION RsWantsMx (domain AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(domain) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(""mx:"" + domain.Trim().Lower()) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is host a name for the name server at all (whether known yet or not)?" + NL
    t = t + "FUNCTION RsAsks (host AS String) AS Bool" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF rsServer = """" OR h = """" OR h = ""localhost"" THEN RETURN FALSE" + NL
    t = t + "    IF rsDown AND SYS.Ticks - rsDownAt < RSQUIET THEN RETURN FALSE" + NL
    t = t + "    IF RsIsAddress(h) THEN RETURN FALSE" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch = """" THEN RETURN FALSE" + NL
    t = t + "    IF h = rsServer OR h = NET.HostName.Lower() THEN RETURN FALSE" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Sends the question. A Connect, so it must be the last thing its handler" + NL
    t = t + "' does: if the name server refuses, the handler is spoiled (SIM95-NOTES.md)." + NL
    t = t + "SUB RsAsk (host AS String, address AS String)" + NL
    t = t + "    RsSend(host.Trim().Lower(), ""A"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Asks for a mail domain's MX records (also a Connect: the last thing)." + NL
    t = t + "SUB RsAskMx (domain AS String, address AS String)" + NL
    t = t + "    RsSend(""mx:"" + domain.Trim().Lower(), ""MX"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' key is the name, or mx: and the name; the answer is kept under it." + NL
    t = t + "SUB RsSend (key AS String, qtype AS String, address AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    IF IsNothing(rsSock) THEN" + NL
    t = t + "        rsSock = NET_Socket.New()" + NL
    t = t + "        rsSock.onMessage = Rs_OnMessage" + NL
    t = t + "    END IF" + NL
    t = t + "    name = key" + NL
    t = t + "    IF name.StartsWith(""mx:"") THEN name = name.Substring(3, name.Length - 3)" + NL
    t = t + "    rsAsking = key" + NL
    t = t + "    rsAskAt = SYS.Ticks" + NL
    t = t + "    rsRefused = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = rsSock.Connect(address, RSPORT)" + NL
    t = t + "        conn.Tag = ""rs:"" + key" + NL
    t = t + "        conn.Send(""QUERY "" + RsFull(name) + "" "" + qtype)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsRefused = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Gives up on the name server for a while: every name goes to SIM95." + NL
    t = t + "SUB RsGiveUp (why AS String)" + NL
    t = t + "    rsWhy = why" + NL
    t = t + "    rsDown = TRUE" + NL
    t = t + "    rsDownAt = SYS.Ticks" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "    rsServerAddr = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' For a program that fetches from a timer tick: TRUE when the tick must end" + NL
    t = t + "' now, because a question about host has just been sent (a Connect, so it" + NL
    t = t + "' has to be the last thing the handler does) or an answer is on its way." + NL
    t = t + "' FALSE when there is nothing to ask: RsTarget(host) is where to connect." + NL
    t = t + "' A name server that is missing, refuses or says nothing for RSWAIT is left" + NL
    t = t + "' alone for RSQUIET, and every name goes to SIM95: nothing ever hangs." + NL
    t = t + "FUNCTION RsNext (host AS String) AS Bool" + NL
    t = t + "    RETURN RsStep(host, FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for mail to domain: its MX record (the lowest preference), then" + NL
    t = t + "' the CNAMEs or address of the machine that names. RsMailTarget(domain) is" + NL
    t = t + "' then where to connect; with no MX, the domain's own machine; with no" + NL
    t = t + "' answer at all, the domain itself, for SIM95 to look up." + NL
    t = t + "FUNCTION RsNextMail (domain AS String) AS Bool" + NL
    t = t + "    IF RsStep(domain, TRUE) THEN RETURN TRUE" + NL
    t = t + "    RETURN RsStep(RsMailHost(domain), FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsStep (host AS String, mx AS Bool) AS Bool" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    ' another handler is finding the name server (it waits): wait for it" + NL
    t = t + "    IF rsLooking THEN" + NL
    t = t + "        IF SYS.Ticks - rsLookingAt < RSWAIT THEN RETURN TRUE" + NL
    t = t + "        rsLooking = FALSE" + NL
    t = t + "        RsGiveUp(""no answer about the machine "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF RsBusy() THEN RETURN TRUE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        IF NOT RsWantsMx(host) THEN RETURN FALSE" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF NOT RsWants(host) THEN RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    addr = RsServerAddress()" + NL
    t = t + "    IF addr = """" THEN RETURN FALSE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        RsAskMx(host, addr)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsAsk(host, addr)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name server's address, looked up once a minute (one lookup at a time:" + NL
    t = t + "' see SIM95-NOTES.md). """" when there is no such machine, and then it gives up." + NL
    t = t + "FUNCTION RsServerAddress () AS String" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    IF RsIsAddress(rsServer) THEN RETURN rsServer" + NL
    t = t + "    IF rsServerAddr <> """" AND rsServerFor = rsServer AND SYS.Ticks - rsServerAt < 60000 AND SYS.Ticks >= rsServerAt THEN RETURN rsServerAddr" + NL
    t = t + "    rsLooking = TRUE" + NL
    t = t + "    rsLookingAt = SYS.Ticks" + NL
    t = t + "    addr = NET.Resolve(rsServer)" + NL
    t = t + "    IF NOT rsLooking THEN RETURN """"" + NL
    t = t + "    rsLooking = FALSE" + NL
    t = t + "    IF addr = """" THEN" + NL
    t = t + "        RsGiveUp(""there is no machine called "" + rsServer)" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    rsServerAddr = addr" + NL
    t = t + "    rsServerFor = rsServer" + NL
    t = t + "    rsServerAt = SYS.Ticks" + NL
    t = t + "    RETURN addr" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsBusy () AS Bool" + NL
    t = t + "    IF rsAsking = """" THEN RETURN FALSE" + NL
    t = t + "    IF rsRefused THEN" + NL
    t = t + "        RsGiveUp(""the name server "" + rsServer + "" refused"")" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF SYS.Ticks - rsAskAt > RSWAIT THEN" + NL
    t = t + "        RsGiveUp(""no answer from the name server "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Rs_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    IF NOT conn.Tag.StartsWith(""rs:"") THEN RETURN" + NL
    t = t + "    h = conn.Tag.Substring(3, conn.Tag.Length - 3)" + NL
    t = t + "    conn.Tag = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        conn.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    RsTake(h, message)" + NL
    t = t + "    IF h = rsAsking THEN rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an answer: follows its CNAMEs to an address, or to the machine" + NL
    t = t + "' name the chain ends at." + NL
    t = t + "SUB RsTake (host AS String, reply AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR onward AS String" + NL
    t = t + "    VAR target AS String" + NL
    t = t + "    VAR canon AS String" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR hops AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    rsLastReply = reply" + NL
    t = t + "    IF host.StartsWith(""mx:"") THEN" + NL
    t = t + "        RsTakeMx(host, reply)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(host, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(host, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    cur = RsFull(host)" + NL
    t = t + "    canon = cur" + NL
    t = t + "    FOR hops = 0 TO 8" + NL
    t = t + "        onward = """"" + NL
    t = t + "        FOR i = 1 TO lines.Count - 1" + NL
    t = t + "            w = lines[i].Split("" "")" + NL
    t = t + "            IF w.Count >= 4 THEN" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""A"" AND target = """" THEN target = w[3]" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""CNAME"" THEN onward = w[3]" + NL
    t = t + "                IF w[0] = cur AND (w[2] = ""A"" OR w[2] = ""CNAME"") AND Int(Val(w[1])) < ttl THEN ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF target <> """" THEN" + NL
    t = t + "            canon = cur" + NL
    t = t + "            BREAK" + NL
    t = t + "        END IF" + NL
    t = t + "        IF onward = """" THEN BREAK" + NL
    t = t + "        canon = cur" + NL
    t = t + "        cur = onward" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF target = """" THEN" + NL
    t = t + "        ' a name with no CNAME and no address: not one to connect to" + NL
    t = t + "        IF cur = RsFull(host) THEN" + NL
    t = t + "            RsKeep(host, """", """", RSNEG)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        ' the end of the chain: a SIM95 machine name" + NL
    t = t + "        target = cur" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ttl < 5 THEN ttl = 5" + NL
    t = t + "    RsKeep(host, target, canon, ttl * 1000)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an MX answer: the mail machine with the lowest preference. With no" + NL
    t = t + "' MX, the server answers with the domain's CNAMEs instead, and the domain's" + NL
    t = t + "' own machine takes the mail." + NL
    t = t + "SUB RsTakeMx (key AS String, reply AS String)" + NL
    t = t + "    VAR domain AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR best AS String" + NL
    t = t + "    VAR pref AS Integer = 1000000" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    domain = key.Substring(3, key.Length - 3)" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(key, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RsKeep(domain, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(key, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 1 TO lines.Count - 1" + NL
    t = t + "        w = lines[i].Split("" "")" + NL
    t = t + "        IF w.Count >= 5 THEN" + NL
    t = t + "            IF w[2] = ""MX"" AND Int(Val(w[3])) < pref THEN" + NL
    t = t + "                pref = Int(Val(w[3]))" + NL
    t = t + "                best = w[4]" + NL
    t = t + "                ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF best <> """" THEN" + NL
    t = t + "        IF best.EndsWith(""."") THEN best = best.Substring(0, best.Length - 1)" + NL
    t = t + "        IF ttl < 5 THEN ttl = 5" + NL
    t = t + "        RsKeep(key, best, RsFull(domain), ttl * 1000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    RsTake(domain, reply)" + NL
    t = t + "    IF RsKnown(domain) THEN" + NL
    t = t + "        RsKeep(key, domain, RsFull(domain), RSNEG)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsKeep(key, """", """", RSNEG)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The machine (or name) that takes domain's mail: its MX, or domain itself." + NL
    t = t + "FUNCTION RsMailHost (domain AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN domain" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN domain" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where to connect for domain's mail." + NL
    t = t + "FUNCTION RsMailTarget (domain AS String) AS String" + NL
    t = t + "    RETURN RsTarget(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS say where domain's mail goes (an MX, or the domain's machine)?" + NL
    t = t + "FUNCTION RsMailKnown (domain AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN FALSE" + NL
    t = t + "    RETURN RsKnown(RsMailHost(domain)) OR NOT RsAsks(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB RsKeep (host AS String, target AS String, canon AS String, ms AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    i = rsName.IndexOf(h)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF rsName.Count >= RSMOST THEN" + NL
    t = t + "        rsName.RemoveAt(0)" + NL
    t = t + "        rsTo.RemoveAt(0)" + NL
    t = t + "        rsCanon.RemoveAt(0)" + NL
    t = t + "        rsUntil.RemoveAt(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    rsName.Add(h)" + NL
    t = t + "    rsTo.Add(target)" + NL
    t = t + "    rsCanon.Add(canon)" + NL
    t = t + "    rsUntil.Add(SYS.Ticks + ms)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where to connect for host: what SimDNS said, or host itself." + NL
    t = t + "FUNCTION RsTarget (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name host's machine was found under (www.coolsite.sim), or host." + NL
    t = t + "FUNCTION RsCanonical (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsCanon[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS answer for host (so RsTarget is its machine)?" + NL
    t = t + "FUNCTION RsKnown (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] <> """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did the name server say there is no such name (NXDOMAIN)?" + NL
    t = t + "FUNCTION RsNoSuchName (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] = """" AND rsCanon[i] = ""NXDOMAIN""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is the name server being left alone, because it didn't answer (or there" + NL
    t = t + "' is none)? rsWhy says why." + NL
    t = t + "FUNCTION RsSilent () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    IF rsServer = """" THEN RETURN TRUE" + NL
    t = t + "    RETURN rsDown AND SYS.Ticks - rsDownAt < RSQUIET" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\PROGRAMS\MAILD.SPK")
    FS.Write(Dest("C:\WEB\DIST\12.TXT"), t)
    FS.Append(Dest("C:\WEB\DIST\MANIFEST.TXT"), "12|C:\PROGRAMS\MAILD.SPK" + NL)
END SUB

SUB File13 ()
    t = ""
    t = t + "' MAILPASS.SPK - gives a ColdMail account a new password. Run it on the" + NL
    t = t + "' machine ColdMail is on (open it in SPARK and press F5): whoever can run" + NL
    t = t + "' programs here owns the mailboxes anyway, so it asks no other password." + NL
    t = t + "'" + NL
    t = t + "' It writes the new password the way the webmail does (a fresh salt and the" + NL
    t = t + "' same hash), so the webmail, the mail server and Frostbird all take it, and" + NL
    t = t + "' signs the account out of the webmail everywhere. Letters are not touched." + NL
    t = t + "" + NL
    t = t + "CONST DATADIR = ""C:\MAILDATA""" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    VAR u AS String" + NL
    t = t + "    VAR pw AS String" + NL
    t = t + "    VAR again AS String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR salt AS String" + NL
    t = t + "    VAR ended AS Integer" + NL
    t = t + "    IF NOT FS.Exists(DATADIR + ""\USERS"") THEN" + NL
    t = t + "        Print(""There is no ColdMail on this machine (no "" + DATADIR + ""\USERS)."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    Print(""ColdMail accounts here:"")" + NL
    t = t + "    FOR EACH f IN FS.List(DATADIR + ""\USERS"")" + NL
    t = t + "        IF f.EndsWith("".TXT"") THEN Print(""  "" + f.Substring(0, f.Length - 4).Lower() + ""@"" + NET.HostName.Lower())" + NL
    t = t + "    NEXT" + NL
    t = t + "    u = Input(""Account (the part before the @): "").Trim().Lower()" + NL
    t = t + "    IF u.Contains(""@"") THEN u = u.Substring(0, u.IndexOf(""@""))" + NL
    t = t + "    IF u = """" OR u.Contains(""\"") OR u.Contains(""."") OR NOT FS.Exists(DATADIR + ""\USERS\"" + u + "".TXT"") THEN" + NL
    t = t + "        Print(""There is no account called '"" + u + ""' here. Nothing was changed."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    pw = Input(""Enter desired password: "")" + NL
    t = t + "    IF pw.Length < 4 THEN" + NL
    t = t + "        Print(""Pick a password of at least 4 characters. Nothing was changed."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    again = Input(""Again: "")" + NL
    t = t + "    IF again <> pw THEN" + NL
    t = t + "        Print(""The two passwords are different. Nothing was changed."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    salt = Hex(268435456 + Rnd(1879048191))" + NL
    t = t + "    FOR EACH line IN FS.Read(DATADIR + ""\USERS\"" + u + "".TXT"").Lines()" + NL
    t = t + "        IF line.StartsWith(""salt="") OR line.StartsWith(""pass="") THEN CONTINUE" + NL
    t = t + "        IF line <> """" THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    out.Add(""salt="" + salt)" + NL
    t = t + "    out.Add(""pass="" + Hash(salt, pw))" + NL
    t = t + "    FS.Write(DATADIR + ""\USERS\"" + u + "".TXT"", out.Join(Chr(10)))" + NL
    t = t + "    ' every webmail sign-in of theirs ends" + NL
    t = t + "    IF FS.Exists(DATADIR + ""\SESSIONS"") THEN" + NL
    t = t + "        FOR EACH f IN FS.List(DATADIR + ""\SESSIONS"")" + NL
    t = t + "            IF f.EndsWith(""\"") THEN CONTINUE" + NL
    t = t + "            IF (FS.Read(DATADIR + ""\SESSIONS\"" + f) + Chr(10)).Split(Chr(10))[0].Trim() = u THEN" + NL
    t = t + "                FS.Delete(DATADIR + ""\SESSIONS\"" + f)" + NL
    t = t + "                ended = ended + 1" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    Print("""")" + NL
    t = t + "    Print(""This is your new password for ColdMail: "" + pw)" + NL
    t = t + "    Print(""  account: "" + u + ""@"" + NET.HostName.Lower())" + NL
    t = t + "    IF ended > 0 THEN Print(""  signed out of the webmail in "" + Str(ended) + "" place(s)"")" + NL
    t = t + "    Print(""Frostbird remembers the old one: in Frostbird, set the account up again with the new password."")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The webmail's password hash (MAIL.SPK), the same to the letter." + NL
    t = t + "FUNCTION Hash (salt AS String, pw AS String) AS String" + NL
    t = t + "    VAR a AS Integer = 7" + NL
    t = t + "    VAR b AS Integer = 31337" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = salt + "":"" + pw + "":"" + salt" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        c = Asc(s.CharAt(i))" + NL
    t = t + "        a = (a * 131 + c) MOD 2147483629" + NL
    t = t + "        b = (b * 257 + c + a) MOD 2147483587" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN Hex(a) + ""-"" + Hex(b)" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\PROGRAMS\MAILPASS.SPK")
    FS.Write(Dest("C:\WEB\DIST\13.TXT"), t)
    FS.Append(Dest("C:\WEB\DIST\MANIFEST.TXT"), "13|C:\PROGRAMS\MAILPASS.SPK" + NL)
END SUB

SUB StartService (name AS String, program AS String, runFile AS String)
    VAR task AS String
    FS.Write("C:\SYSTEM\STARTUP\" + runFile, program)
    Print("  " + name + " will start with the machine (C:\SYSTEM\STARTUP\" + runFile + ")")
    FOR EACH task IN SYS.Tasks()
        IF task.Split("|")[1].Upper() = name THEN
            SYS.Kill(Int(Val(task.Split("|")[0])))
            Print("  stopped the old " + name)
        END IF
    NEXT
    SYS.Run(program)
    Print("  started " + program)
END SUB

' HTTPD.SPK serves INDEX.ASP for a folder only when it has no INDEX.HTM, so the
' stock home page steps aside (to the first free name) instead of being deleted.
SUB MoveHomePage ()
    VAR names AS Array OF String
    VAR name AS String
    IF NOT FS.Exists("C:\WEB\INDEX.HTM") THEN RETURN
    names = ["WELCOME.HTM", "INDEX1.HTM", "INDEX2.HTM", "INDEX3.HTM", "INDEX4.HTM", "INDEX5.HTM", "INDEX6.HTM", "INDEX7.HTM", "INDEX8.HTM", "INDEX9.HTM"]
    FOR EACH name IN names
        IF NOT FS.Exists("C:\WEB\" + name) THEN
            FS.Rename("C:\WEB\INDEX.HTM", "C:\WEB\" + name)
            Print("  moved the old home page to C:\WEB\" + name)
            RETURN
        END IF
    NEXT
    THROW "C:\WEB\INDEX.HTM is in the way and there is nowhere to move it. Rename it yourself and run this again."
END SUB
