' ASK.SPK - AskSim's search, shared by its pages, which are this machine's home page (C:\WEB). The index is
' built by the crawler (C:\PROGRAMS\CRAWLER.SPK); these pages only read it.
'
'   C:\ASKDATA\DOCS.TXT       id|url|title|crawled|state|since   (state ok or gone)
'   C:\ASKDATA\TEXT\<id>.TXT  title, a line break, the page's text
'   C:\ASKDATA\CACHE\<id>.HTM the page as the crawler last saw it
'   C:\ASKDATA\IDX\<c>.TXT    word|id:count id:count ...
'   C:\ASKDATA\STATS.TXT      last crawl, pages, machines, seconds, TIME.Now
'   C:\ASKDATA\SEEDS.TXT      sites people submitted
'   C:\ASKDATA\BANNED.TXT     what's kept out (below; the crawler's Admin button)
'
' Ranking is tf-idf: a word counts for more the more often it is on a page,
' and for less the more pages it is on; a page with all your words beats one
' with some of them; a page that has stopped answering counts for half.

CONST DATADIR = "C:\ASKDATA"
CONST PERPAGE = 10
CONST MAXWORDS = 8
CONST MAXSEEDS = 200
CONST BANFILE = "C:\ASKDATA\BANNED.TXT"
' Words that say nothing about what you are looking for
CONST IGNORE = "|a|an|the|and|or|of|to|in|on|at|by|for|is|it|its|be|as|are|was|with|this|that|from|you|your|i|me|my|we|our|he|she|they|them|but|not|no|so|if|do|does|did|have|has|had|can|will|just|all|any|there|here|what|where|who|how|which|when|why|about|into|out|up|than|then|also|more|some|very|would|could|should|been|were|these|those|their|his|her|him|am|get|got|one|nbsp|find|information|info|page|pages|site|sites|web|please|tell|show|know|want|looking|look|search|need|anything|something|someone|somebody|anyone|anybody|place|places|go|best|good|thing|things|let|lot|lots|like|ask|simms|"

VAR found AS Array OF String     ' "score|id", best first, after Search

FUNCTION ReadOr (path AS String, fallback AS String) AS String
    IF FS.Exists(path) THEN RETURN FS.Read(path)
    RETURN fallback
END FUNCTION

FUNCTION H (s AS String) AS String
    RETURN SERVER.HtmlEncode(s)
END FUNCTION

FUNCTION UrlEnc (s AS String) AS String
    RETURN SERVER.UrlEncode(s)
END FUNCTION

FUNCTION FindLine (text AS String, key AS String) AS String
    VAR at AS Integer
    text = Chr(10) + text
    at = text.IndexOf(Chr(10) + key + "|")
    IF at < 0 THEN RETURN ""
    text = text.Substring(at + 1, text.Length - at - 1)
    IF text.Contains(Chr(10)) THEN text = text.Substring(0, text.IndexOf(Chr(10)))
    RETURN text
END FUNCTION

FUNCTION Clip (s AS String, most AS Integer) AS String
    IF s.Length > most THEN RETURN s.Substring(0, most - 3) + "..."
    RETURN s
END FUNCTION

FUNCTION HostOf (url AS String) AS String
    VAR rest AS String
    rest = url.Substring(7, url.Length - 7)
    IF rest.Contains("/") THEN rest = rest.Substring(0, rest.IndexOf("/"))
    RETURN rest
END FUNCTION

' ---------------------------------------------------------------- the ban list
'
' C:\ASKDATA\BANNED.TXT: what Simms won't show, keep or visit, one rule a line
' (rule|why|when; the crawler's Admin window writes them, a line typed by hand
' needs only the rule; a line starting ' is a note):
'   badguy                   a machine: every page on it (BADGUY.DIALUP.ZONE too)
'   www.gross.sim            a site by name, its subdomains, and the same site
'                            by path on any machine (http://alpha/www.gross.sim/)
'   http://bob/stuff/        an address: that page, or that folder and all in it
' The same rules are in CRAWLER.SPK and ASK.SPK: keep them alike.

FUNCTION BanRules () AS Array OF String
    VAR out AS Array OF String
    VAR line AS String
    VAR r AS String
    FOR EACH line IN ReadOr(BANFILE, "").Lines()
        r = line.Split("|")[0].Trim().Lower()
        IF r = "" OR r.StartsWith("'") THEN CONTINUE
        ' an address that is just a machine is a machine
        IF r.StartsWith("http://") AND (r.Substring(7, r.Length - 7).IndexOf("/") < 0 OR r.Substring(7, r.Length - 7).IndexOf("/") = r.Length - 8) THEN r = r.Substring(7, r.Length - 7).Replace("/", "")
        out.Add(r)
    NEXT
    RETURN out
END FUNCTION

' Does this rule cover this address?
FUNCTION BanCovers (rule AS String, url AS String) AS Bool
    VAR host AS String
    VAR path AS String
    url = url.Lower()
    IF NOT url.StartsWith("http://") THEN url = "http://" + url
    IF rule.StartsWith("http://") THEN RETURN url.StartsWith(rule) OR url + "/" = rule
    host = url.Substring(7, url.Length - 7)
    path = "/"
    IF host.Contains("/") THEN
        path = host.Substring(host.IndexOf("/"), host.Length - host.IndexOf("/"))
        host = host.Substring(0, host.IndexOf("/"))
    END IF
    IF host.Contains(":") THEN host = host.Substring(0, host.IndexOf(":"))
    IF host.EndsWith(".") THEN host = host.Substring(0, host.Length - 1)
    IF host = rule OR host.EndsWith("." + rule) THEN RETURN TRUE
    ' a machine by its short name or its full one (BOB, BOB.DIALUP.ZONE)
    IF NOT rule.Contains(".") AND host.Split(".")[0] = rule THEN RETURN TRUE
    IF NOT host.Contains(".") AND rule.Split(".")[0] = host AND rule.EndsWith(".dialup.zone") THEN RETURN TRUE
    ' a site by name, served by path (http://alpha/www.gross.sim/...)
    IF rule.Contains(".") AND (path.StartsWith("/" + rule + "/") OR path = "/" + rule) THEN RETURN TRUE
    RETURN FALSE
END FUNCTION

' The rule that keeps this address out, or "".
FUNCTION BannedBy (url AS String, rules AS Array OF String) AS String
    VAR r AS String
    FOR EACH r IN rules
        IF BanCovers(r, url) THEN RETURN r
    NEXT
    RETURN ""
END FUNCTION

' Words only, part two: what might be a picture written out as text is not
' kept. A run of 16 or more hex digits (a SIM95 .PIC's rows of pixels, or
' parts of one) or of 60 or more base64 letters becomes [data]. blobShare
' says what share of a page's words looked like pixels (hex, 6 or more), so
' a page that is mostly picture can be left out whole.
VAR blobShare AS Real

FUNCTION NoBlobs (s AS String) AS String
    VAR lines AS Array OF String
    VAR words AS Array OF String
    VAR li AS Integer
    VAR wi AS Integer
    VAR w AS String
    VAR total AS Integer
    VAR hexy AS Integer
    lines = s.Split(Chr(10))
    FOR li = 0 TO lines.Count - 1
        words = lines[li].Split(" ")
        FOR wi = 0 TO words.Count - 1
            w = words[wi]
            IF w = "" THEN CONTINUE
            total = total + 1
            IF w.Length >= 6 AND AllOf(w.Trim(), "0123456789abcdefABCDEF") THEN hexy = hexy + 1
            IF w.Length >= 16 THEN words[wi] = NoRuns(w)
        NEXT
        lines[li] = words.Join(" ")
    NEXT
    blobShare = 0
    IF total > 0 THEN blobShare = hexy / total
    RETURN lines.Join(Chr(10))
END FUNCTION

FUNCTION AllOf (w AS String, chars AS String) AS Bool
    VAR i AS Integer
    IF w = "" THEN RETURN FALSE
    FOR i = 0 TO w.Length - 1
        IF NOT chars.Contains(w.CharAt(i)) THEN RETURN FALSE
    NEXT
    RETURN TRUE
END FUNCTION

' One long word with its hex and base64 runs taken out.
FUNCTION NoRuns (w AS String) AS String
    VAR out AS String
    VAR i AS Integer
    VAR j AS Integer
    VAR allHex AS Bool
    VAR b64 AS String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/="
    i = 0
    WHILE i < w.Length
        IF NOT b64.Contains(w.CharAt(i)) THEN
            out = out + w.CharAt(i)
            i = i + 1
            CONTINUE
        END IF
        j = i
        allHex = TRUE
        WHILE j < w.Length AND b64.Contains(w.CharAt(j))
            IF NOT "0123456789abcdefABCDEF".Contains(w.CharAt(j)) THEN allHex = FALSE
            j = j + 1
        END WHILE
        IF (allHex AND j - i >= 16) OR j - i >= 60 THEN
            out = out + "[data]"
        ELSE
            out = out + w.Substring(i, j - i)
        END IF
        i = j
    END WHILE
    RETURN out
END FUNCTION

' A page with a SIM95 picture in it, or mostly pixel-looking words: not kept.
FUNCTION LooksLikePicture (s AS String) AS Bool
    IF s.Upper().Contains("SIM95PIC") THEN RETURN TRUE
    NoBlobs(s)
    RETURN blobShare > 0.3
END FUNCTION

' A page without its pictures: every <img> (and <input type=image>, <embed>,
' <object>, <applet>) becomes [picture], background= pictures go, and so do
' scripts, canvases, data: addresses and anything that looks like picture
' data written out as text (NoBlobs). AskSim never keeps or shows a site's
' pictures, only its words.
FUNCTION NoPictures (html AS String) AS String
    VAR tag AS String
    VAR low AS String
    VAR at AS Integer
    VAR gt AS Integer
    VAR q AS String
    VAR rest AS String
    FOR EACH tag IN ["<img", "<image", "<embed", "<object", "<applet", "<input type=image", "<input type=""image"""]
        low = html.Lower()
        at = low.IndexOf(tag)
        WHILE at >= 0
            gt = low.Substring(at, low.Length - at).IndexOf(">")
            IF gt < 0 THEN
                html = html.Substring(0, at)
            ELSE
                html = html.Substring(0, at) + "[picture]" + html.Substring(at + gt + 1, html.Length - at - gt - 1)
            END IF
            low = html.Lower()
            at = low.IndexOf(tag)
        END WHILE
    NEXT
    ' background="pic" on <body>, <table>, <td>...
    low = html.Lower()
    at = low.IndexOf(" background=")
    WHILE at >= 0
        rest = html.Substring(at + 12, html.Length - at - 12)
        q = rest.CharAt(0)
        IF q = """" OR q = "'" THEN
            gt = rest.Substring(1, rest.Length - 1).IndexOf(q) + 2
            IF gt < 2 THEN gt = rest.Length
        ELSE
            gt = 0
            WHILE gt < rest.Length AND NOT " >".Contains(rest.CharAt(gt))
                gt = gt + 1
            END WHILE
        END IF
        html = html.Substring(0, at) + rest.Substring(gt, rest.Length - gt)
        low = html.Lower()
        at = low.IndexOf(" background=")
    END WHILE
    ' scripts (a SPARK script could draw a picture) and canvases
    low = html.Lower()
    at = low.IndexOf("<script")
    WHILE at >= 0
        gt = low.Substring(at, low.Length - at).IndexOf("</script>")
        IF gt < 0 THEN
            html = html.Substring(0, at)
        ELSE
            html = html.Substring(0, at) + html.Substring(at + gt + 9, html.Length - at - gt - 9)
        END IF
        low = html.Lower()
        at = low.IndexOf("<script")
    END WHILE
    html = html.Replace("<canvas", "<span").Replace("<CANVAS", "<span")
    ' data: addresses carry a picture (or anything) inside the page itself
    low = html.Lower()
    at = low.IndexOf("data:")
    WHILE at >= 0
        gt = at
        WHILE gt < html.Length AND NOT " ""'>".Contains(html.CharAt(gt))
            gt = gt + 1
        END WHILE
        html = html.Substring(0, at) + "#" + html.Substring(gt, html.Length - gt)
        low = html.Lower()
        at = low.IndexOf("data:")
    END WHILE
    RETURN NoBlobs(html)
END FUNCTION

' ---------------------------------------------------------------- questions

' The words of a question worth looking up, lower case, once each. A word
' "site:host" is not looked up; it keeps the answers to that machine.
VAR siteFilter AS String

FUNCTION QueryWords (q AS String) AS Array OF String
    VAR t AS String
    VAR out AS Array OF String
    VAR w AS String
    VAR i AS Integer
    VAR punct AS String
    siteFilter = ""
    t = " " + q.Lower() + " "
    IF t.Contains(" site:") THEN
        siteFilter = t.Substring(t.IndexOf(" site:") + 6, t.Length - t.IndexOf(" site:") - 6)
        siteFilter = siteFilter.Substring(0, siteFilter.IndexOf(" ")).Trim()
        t = t.Replace(" site:" + siteFilter, " ")
    END IF
    punct = ".,;:!?()[]{}""'<>/\|-_=+*&^%$#@~`"
    FOR i = 0 TO punct.Length - 1
        t = t.Replace(punct.CharAt(i), " ")
    NEXT
    FOR EACH w IN t.Split(" ")
        IF w.Length >= 2 AND w.Length <= 20 AND NOT IGNORE.Contains("|" + w + "|") AND NOT out.Contains(w) AND out.Count < MAXWORDS THEN out.Add(w)
    NEXT
    RETURN out
END FUNCTION

FUNCTION Postings (word AS String) AS String
    VAR b AS String
    VAR line AS String
    b = word.Substring(0, 1).Upper()
    IF NOT "ABCDEFGHIJKLMNOPQRSTUVWXYZ".Contains(b) THEN b = "0"
    line = FindLine(ReadOr(DATADIR + "\IDX\" + b + ".TXT", ""), word)
    IF line = "" THEN RETURN ""
    RETURN line.Substring(word.Length + 1, line.Length - word.Length - 1)
END FUNCTION

FUNCTION PageCount () AS Integer
    VAR n AS Integer
    VAR line AS String
    FOR EACH line IN ReadOr(DATADIR + "\DOCS.TXT", "").Lines()
        IF line <> "" THEN n = n + 1
    NEXT
    RETURN n
END FUNCTION

' Fills found with "score|id", best first.
SUB Search (words AS Array OF String)
    VAR ids AS Array OF String
    VAR scores AS Array OF Real
    VAR hits AS Array OF Integer
    VAR w AS String
    VAR posting AS String
    VAR list AS Array OF String
    VAR id AS String
    VAR tf AS Integer
    VAR idf AS Real
    VAR i AS Integer
    VAR n AS Integer
    VAR doc AS String
    VAR score AS Real
    VAR bans AS Array OF String
    found.Clear()
    bans = BanRules()
    n = PageCount()
    IF n = 0 OR words.Count = 0 THEN RETURN
    FOR EACH w IN words
        list = Postings(w).Split(" ")
        IF list.Count = 0 OR list[0] = "" THEN CONTINUE
        idf = MATH.Log((n + 1) / list.Count) + 1
        FOR EACH posting IN list
            IF NOT posting.Contains(":") THEN CONTINUE
            id = posting.Substring(0, posting.IndexOf(":"))
            tf = Int(Val(posting.Substring(posting.IndexOf(":") + 1, posting.Length - posting.IndexOf(":") - 1)))
            i = ids.IndexOf(id)
            IF i < 0 THEN
                ids.Add(id)
                scores.Add(0)
                hits.Add(0)
                i = ids.Count - 1
            END IF
            scores[i] = scores[i] + (1 + MATH.Log(tf)) * idf
            hits[i] = hits[i] + 1
        NEXT
    NEXT
    FOR i = 0 TO ids.Count - 1
        doc = FindLine(ReadOr(DATADIR + "\DOCS.TXT", ""), ids[i])
        IF doc = "" THEN CONTINUE
        IF BannedBy(doc.Split("|")[1], bans) <> "" THEN CONTINUE
        IF siteFilter <> "" AND NOT HostOf(doc.Split("|")[1]).StartsWith(siteFilter) THEN CONTINUE
        score = scores[i] * hits[i] / words.Count
        IF doc.Split("|")[4] = "gone" THEN score = score / 2
        found.Add(Str(Int(score * 1000)).PadLeft(12) + "|" + ids[i])
    NEXT
    found.Sort()
    found.Reverse()
END SUB

' Every page of one machine, for "site:host" on its own.
SUB SiteOnly ()
    VAR line AS String
    VAR bans AS Array OF String
    found.Clear()
    bans = BanRules()
    FOR EACH line IN ReadOr(DATADIR + "\DOCS.TXT", "").Lines()
        IF line = "" THEN CONTINUE
        IF BannedBy(line.Split("|")[1], bans) <> "" THEN CONTINUE
        IF HostOf(line.Split("|")[1]).StartsWith(siteFilter) THEN found.Add("1|" + line.Split("|")[0])
    NEXT
END SUB

FUNCTION DocLine (id AS String) AS String
    RETURN FindLine(ReadOr(DATADIR + "\DOCS.TXT", ""), id)
END FUNCTION

' The id of the page AskSim knows at this address ("" if none), for
' cache.asp?url=... (Internet Explorer asks for it when a site is down).
FUNCTION DocIdOf (url AS String) AS String
    VAR line AS String
    VAR want AS String
    want = url.Trim().Lower()
    IF NOT want.StartsWith("http://") THEN want = "http://" + want
    IF want.Contains("#") THEN want = want.Substring(0, want.IndexOf("#"))
    IF want.Substring(7, want.Length - 7).IndexOf("/") < 0 THEN want = want + "/"
    FOR EACH line IN ReadOr(DATADIR + "\DOCS.TXT", "").Lines()
        IF line.Split("|").Count < 2 THEN CONTINUE
        IF line.Split("|")[1] = want THEN RETURN line.Split("|")[0]
        IF want.EndsWith("/") AND (line.Split("|")[1] = want + "index.htm" OR line.Split("|")[1] = want + "index.asp") THEN RETURN line.Split("|")[0]
    NEXT
    RETURN ""
END FUNCTION

' A few lines of the page around the first of your words, with your words in bold.
FUNCTION Snippet (id AS String, words AS Array OF String) AS String
    VAR text AS String
    VAR low AS String
    VAR at AS Integer
    VAR w AS String
    VAR piece AS String
    VAR out AS Array OF String
    VAR t AS String
    VAR bare AS String
    text = ReadOr(DATADIR + "\TEXT\" + id + ".TXT", "")
    IF text.Contains(Chr(10)) THEN text = text.Substring(text.IndexOf(Chr(10)) + 1, text.Length - text.IndexOf(Chr(10)) - 1)
    low = text.Lower()
    at = -1
    FOR EACH w IN words
        IF low.IndexOf(w) >= 0 AND (at < 0 OR low.IndexOf(w) < at) THEN at = low.IndexOf(w)
    NEXT
    IF at < 60 THEN
        at = 0
    ELSE
        at = at - 60
    END IF
    piece = text.Substring(at, MATH.Min(220, text.Length - at))
    FOR EACH t IN piece.Split(" ")
        bare = t.Lower()
        WHILE bare.Length > 0 AND NOT "abcdefghijklmnopqrstuvwxyz0123456789".Contains(bare.CharAt(bare.Length - 1))
            bare = bare.Substring(0, bare.Length - 1)
        END WHILE
        IF words.Contains(bare) THEN
            out.Add("<b>" + H(t) + "</b>")
        ELSE
            out.Add(H(t))
        END IF
    NEXT
    t = out.Join(" ")
    IF at > 0 THEN t = "..." + t
    IF at + 220 < text.Length THEN t = t + "..."
    RETURN t
END FUNCTION

' ---------------------------------------------------------------- page furniture

FUNCTION Top (title AS String) AS String
    RETURN TopFor(title, "")
END FUNCTION

' robots: "" for a page worth finding, or what search engines should do with
' it ("noindex,nofollow": results and cached copies are not pages in their own right).
FUNCTION TopFor (title AS String, robots AS String) AS String
    VAR meta AS String
    IF robots <> "" THEN meta = "<meta name=""robots"" content=""" + robots + """>"
    RETURN "<html><head><title>" + H(title) + "</title>" + meta + "</head>" _
         + "<body bgcolor=""#FFFFFF"" text=""#000000"" link=""#660099"" vlink=""#660099"">"
END FUNCTION

FUNCTION AskBox (q AS String) AS String
    RETURN "<form action=""index.asp"" method=""get""><p><input name=""q"" size=""50"" maxlength=""200"" value=""" + H(q) + """> " _
         + "<input type=""submit"" value=""Ask!""></p></form>"
END FUNCTION

FUNCTION Stats () AS String
    VAR s AS Array OF String
    s = ReadOr(DATADIR + "\STATS.TXT", "").Lines()
    IF s.Count < 4 THEN RETURN "Simms has not been round the network yet. Start C:\PROGRAMS\CRAWLER.SPK and press Crawl Now."
    RETURN "Simms knows " + s[1] + " pages on " + s[2] + " machines. He last went round the network on " + s[0] + "."
END FUNCTION

FUNCTION Bottom () AS String
    RETURN "<hr><center><font size=""1"" color=""#808080"">AskSim on " + H(NET.HostName.Lower()) + " &middot; " + H(Stats()) _
         + " &middot; <a href=""addurl.asp"">Add your site</a> &middot; <a href=""asksim.htm"">About AskSim</a></font></center></body></html>"
END FUNCTION
