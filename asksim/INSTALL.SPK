' INSTALL.SPK - puts AskSim on this machine. Generated by tools/build-installer.mjs;
' edit the files in asksim/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It puts the
' search pages in C:\WEB as this machine's home page (the stock INDEX.HTM moves
' to WELCOME.HTM) and the crawler in C:\PROGRAMS\CRAWLER.SPK, starts
' the crawler (it goes round the network straight away, then every hour), and
' adds it to C:\SYSTEM\STARTUP. The index in C:\ASKDATA is kept, so running
' this again upgrades AskSim. Then open http://YOURNAME/ in Voyager.

VAR t AS String
VAR NL AS String

SUB Main ()
    NL = Chr(10)


    MoveHomePage()
    File0()
    File1()
    File2()
    File3()
    File4()
    File5()
    Print("AskSim is installed (6 files).")
    StartService("CRAWLER", "C:\PROGRAMS\CRAWLER.SPK", "ASKSIM.RUN")
    Print("Open http://" + NET.HostName.Lower() + "/ in Voyager.")
END SUB

SUB Put (path AS String)
    FS.Write(path, t)
    Print("  wrote " + path)
END SUB

SUB File0 ()
    t = ""
    t = t + "<%@ import file=""ASK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' ADDURL.ASP - tell Simms about a site; the crawler starts there next time." + NL
    t = t + "VAR url AS String" + NL
    t = t + "VAR said AS String" + NL
    t = t + "VAR seeds AS String" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    url = REQUEST.Form(""url"").Trim().Lower()" + NL
    t = t + "    IF NOT url.StartsWith(""http://"") THEN url = ""http://"" + url" + NL
    t = t + "    seeds = ReadOr(DATADIR + ""\SEEDS.TXT"", """")" + NL
    t = t + "    IF url.Length > 120 OR url.Length < 9 OR url.Contains("" "") OR url.Contains(""|"") THEN" + NL
    t = t + "        said = ""That doesn't look like an address. Try http://machine/ or http://machine/page.htm""" + NL
    t = t + "    ELSEIF (Chr(10) + seeds).Contains(Chr(10) + url + Chr(10)) THEN" + NL
    t = t + "        said = ""Simms already has "" + url + "" on his list.""" + NL
    t = t + "    ELSEIF seeds.Lines().Count > MAXSEEDS THEN" + NL
    t = t + "        said = ""Simms's list is quite full, thank you. He will find more sites by following links.""" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF NOT FS.Exists(DATADIR) THEN FS.MakeDir(DATADIR)" + NL
    t = t + "        FS.Append(DATADIR + ""\SEEDS.TXT"", url + Chr(10))" + NL
    t = t + "        said = ""Thank you! Simms will call on "" + url + "" the next time he goes round the network.""" + NL
    t = t + "    END IF" + NL
    t = t + "END IF" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Add your site - AskSim"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""0"" bgcolor=""#E8DDF0""><tr>" + NL
    t = t + "<td width=""50""><a href=""index.asp""><img src=""simms.pic"" alt=""Simms""></a></td>" + NL
    t = t + "<td><a href=""index.asp""><font size=""5"" color=""#660099""><b>AskSim</b></font></a></td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<h3>Add your site</h3>" + NL
    t = t + "<% IF said <> """" THEN %><p><font size=""2""><b><%= H(said) %></b></font></p><% END IF %>" + NL
    t = t + "<p><font size=""2"">Simms visits every machine he can see, but not every page links to every other." + NL
    t = t + "Tell him where to start, and he will follow the links from there.</font></p>" + NL
    t = t + "<form action=""addurl.asp"" method=""post"">" + NL
    t = t + "<p><input name=""url"" size=""50"" maxlength=""120"" value=""http://""> <input type=""submit"" value=""Add""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<p><font size=""1"" color=""#808080"">Simms is a polite robot: he reads /robots.txt, and stays out of any" + NL
    t = t + "path it lists after ""Disallow:"".</font></p>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\ADDURL.ASP")
END SUB

SUB File1 ()
    t = ""
    t = t + "' ASK.SPK - AskSim's search, shared by its pages, which are this machine's home page (C:\WEB). The index is" + NL
    t = t + "' built by the crawler (C:\PROGRAMS\CRAWLER.SPK); these pages only read it." + NL
    t = t + "'" + NL
    t = t + "'   C:\ASKDATA\DOCS.TXT       id|url|title|crawled|state|since   (state ok or gone)" + NL
    t = t + "'   C:\ASKDATA\TEXT\<id>.TXT  title, a line break, the page's text" + NL
    t = t + "'   C:\ASKDATA\CACHE\<id>.HTM the page as the crawler last saw it" + NL
    t = t + "'   C:\ASKDATA\IDX\<c>.TXT    word|id:count id:count ..." + NL
    t = t + "'   C:\ASKDATA\STATS.TXT      last crawl, pages, machines, seconds, TIME.Now" + NL
    t = t + "'   C:\ASKDATA\SEEDS.TXT      sites people submitted" + NL
    t = t + "'" + NL
    t = t + "' Ranking is tf-idf: a word counts for more the more often it is on a page," + NL
    t = t + "' and for less the more pages it is on; a page with all your words beats one" + NL
    t = t + "' with some of them; a page that has stopped answering counts for half." + NL
    t = t + "" + NL
    t = t + "CONST DATADIR = ""C:\ASKDATA""" + NL
    t = t + "CONST PERPAGE = 10" + NL
    t = t + "CONST MAXWORDS = 8" + NL
    t = t + "CONST MAXSEEDS = 200" + NL
    t = t + "' Words that say nothing about what you are looking for" + NL
    t = t + "CONST IGNORE = ""|a|an|the|and|or|of|to|in|on|at|by|for|is|it|its|be|as|are|was|with|this|that|from|you|your|i|me|my|we|our|he|she|they|them|but|not|no|so|if|do|does|did|have|has|had|can|will|just|all|any|there|here|what|where|who|how|which|when|why|about|into|out|up|than|then|also|more|some|very|would|could|should|been|were|these|those|their|his|her|him|am|get|got|one|nbsp|find|information|info|page|pages|site|sites|web|please|tell|show|know|want|looking|look|search|need|anything|something|someone|somebody|anyone|anybody|place|places|go|best|good|thing|things|let|lot|lots|like|ask|simms|""" + NL
    t = t + "" + NL
    t = t + "VAR found AS Array OF String     ' ""score|id"", best first, after Search" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION H (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.HtmlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UrlEnc (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.UrlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION FindLine (text AS String, key AS String) AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    text = Chr(10) + text" + NL
    t = t + "    at = text.IndexOf(Chr(10) + key + ""|"")" + NL
    t = t + "    IF at < 0 THEN RETURN """"" + NL
    t = t + "    text = text.Substring(at + 1, text.Length - at - 1)" + NL
    t = t + "    IF text.Contains(Chr(10)) THEN text = text.Substring(0, text.IndexOf(Chr(10)))" + NL
    t = t + "    RETURN text" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Clip (s AS String, most AS Integer) AS String" + NL
    t = t + "    IF s.Length > most THEN RETURN s.Substring(0, most - 3) + ""...""" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION HostOf (url AS String) AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    rest = url.Substring(7, url.Length - 7)" + NL
    t = t + "    IF rest.Contains(""/"") THEN rest = rest.Substring(0, rest.IndexOf(""/""))" + NL
    t = t + "    RETURN rest" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- questions" + NL
    t = t + "" + NL
    t = t + "' The words of a question worth looking up, lower case, once each. A word" + NL
    t = t + "' ""site:host"" is not looked up; it keeps the answers to that machine." + NL
    t = t + "VAR siteFilter AS String" + NL
    t = t + "" + NL
    t = t + "FUNCTION QueryWords (q AS String) AS Array OF String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR w AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR punct AS String" + NL
    t = t + "    siteFilter = """"" + NL
    t = t + "    t = "" "" + q.Lower() + "" """ + NL
    t = t + "    IF t.Contains("" site:"") THEN" + NL
    t = t + "        siteFilter = t.Substring(t.IndexOf("" site:"") + 6, t.Length - t.IndexOf("" site:"") - 6)" + NL
    t = t + "        siteFilter = siteFilter.Substring(0, siteFilter.IndexOf("" "")).Trim()" + NL
    t = t + "        t = t.Replace("" site:"" + siteFilter, "" "")" + NL
    t = t + "    END IF" + NL
    t = t + "    punct = "".,;:!?()[]{}""""'<>/\|-_=+*&^%$#@~`""" + NL
    t = t + "    FOR i = 0 TO punct.Length - 1" + NL
    t = t + "        t = t.Replace(punct.CharAt(i), "" "")" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH w IN t.Split("" "")" + NL
    t = t + "        IF w.Length >= 2 AND w.Length <= 20 AND NOT IGNORE.Contains(""|"" + w + ""|"") AND NOT out.Contains(w) AND out.Count < MAXWORDS THEN out.Add(w)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Postings (word AS String) AS String" + NL
    t = t + "    VAR b AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    b = word.Substring(0, 1).Upper()" + NL
    t = t + "    IF NOT ""ABCDEFGHIJKLMNOPQRSTUVWXYZ"".Contains(b) THEN b = ""0""" + NL
    t = t + "    line = FindLine(ReadOr(DATADIR + ""\IDX\"" + b + "".TXT"", """"), word)" + NL
    t = t + "    IF line = """" THEN RETURN """"" + NL
    t = t + "    RETURN line.Substring(word.Length + 1, line.Length - word.Length - 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION PageCount () AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\DOCS.TXT"", """").Lines()" + NL
    t = t + "        IF line <> """" THEN n = n + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Fills found with ""score|id"", best first." + NL
    t = t + "SUB Search (words AS Array OF String)" + NL
    t = t + "    VAR ids AS Array OF String" + NL
    t = t + "    VAR scores AS Array OF Real" + NL
    t = t + "    VAR hits AS Array OF Integer" + NL
    t = t + "    VAR w AS String" + NL
    t = t + "    VAR posting AS String" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR tf AS Integer" + NL
    t = t + "    VAR idf AS Real" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR doc AS String" + NL
    t = t + "    VAR score AS Real" + NL
    t = t + "    found.Clear()" + NL
    t = t + "    n = PageCount()" + NL
    t = t + "    IF n = 0 OR words.Count = 0 THEN RETURN" + NL
    t = t + "    FOR EACH w IN words" + NL
    t = t + "        list = Postings(w).Split("" "")" + NL
    t = t + "        IF list.Count = 0 OR list[0] = """" THEN CONTINUE" + NL
    t = t + "        idf = MATH.Log((n + 1) / list.Count) + 1" + NL
    t = t + "        FOR EACH posting IN list" + NL
    t = t + "            IF NOT posting.Contains("":"") THEN CONTINUE" + NL
    t = t + "            id = posting.Substring(0, posting.IndexOf("":""))" + NL
    t = t + "            tf = Int(Val(posting.Substring(posting.IndexOf("":"") + 1, posting.Length - posting.IndexOf("":"") - 1)))" + NL
    t = t + "            i = ids.IndexOf(id)" + NL
    t = t + "            IF i < 0 THEN" + NL
    t = t + "                ids.Add(id)" + NL
    t = t + "                scores.Add(0)" + NL
    t = t + "                hits.Add(0)" + NL
    t = t + "                i = ids.Count - 1" + NL
    t = t + "            END IF" + NL
    t = t + "            scores[i] = scores[i] + (1 + MATH.Log(tf)) * idf" + NL
    t = t + "            hits[i] = hits[i] + 1" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR i = 0 TO ids.Count - 1" + NL
    t = t + "        doc = FindLine(ReadOr(DATADIR + ""\DOCS.TXT"", """"), ids[i])" + NL
    t = t + "        IF doc = """" THEN CONTINUE" + NL
    t = t + "        IF siteFilter <> """" AND NOT HostOf(doc.Split(""|"")[1]).StartsWith(siteFilter) THEN CONTINUE" + NL
    t = t + "        score = scores[i] * hits[i] / words.Count" + NL
    t = t + "        IF doc.Split(""|"")[4] = ""gone"" THEN score = score / 2" + NL
    t = t + "        found.Add(Str(Int(score * 1000)).PadLeft(12) + ""|"" + ids[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    found.Sort()" + NL
    t = t + "    found.Reverse()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Every page of one machine, for ""site:host"" on its own." + NL
    t = t + "SUB SiteOnly ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    found.Clear()" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\DOCS.TXT"", """").Lines()" + NL
    t = t + "        IF line <> """" AND HostOf(line.Split(""|"")[1]).StartsWith(siteFilter) THEN found.Add(""1|"" + line.Split(""|"")[0])" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION DocLine (id AS String) AS String" + NL
    t = t + "    RETURN FindLine(ReadOr(DATADIR + ""\DOCS.TXT"", """"), id)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A few lines of the page around the first of your words, with your words in bold." + NL
    t = t + "FUNCTION Snippet (id AS String, words AS Array OF String) AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR w AS String" + NL
    t = t + "    VAR piece AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR bare AS String" + NL
    t = t + "    text = ReadOr(DATADIR + ""\TEXT\"" + id + "".TXT"", """")" + NL
    t = t + "    IF text.Contains(Chr(10)) THEN text = text.Substring(text.IndexOf(Chr(10)) + 1, text.Length - text.IndexOf(Chr(10)) - 1)" + NL
    t = t + "    low = text.Lower()" + NL
    t = t + "    at = -1" + NL
    t = t + "    FOR EACH w IN words" + NL
    t = t + "        IF low.IndexOf(w) >= 0 AND (at < 0 OR low.IndexOf(w) < at) THEN at = low.IndexOf(w)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF at < 60 THEN" + NL
    t = t + "        at = 0" + NL
    t = t + "    ELSE" + NL
    t = t + "        at = at - 60" + NL
    t = t + "    END IF" + NL
    t = t + "    piece = text.Substring(at, MATH.Min(220, text.Length - at))" + NL
    t = t + "    FOR EACH t IN piece.Split("" "")" + NL
    t = t + "        bare = t.Lower()" + NL
    t = t + "        WHILE bare.Length > 0 AND NOT ""abcdefghijklmnopqrstuvwxyz0123456789"".Contains(bare.CharAt(bare.Length - 1))" + NL
    t = t + "            bare = bare.Substring(0, bare.Length - 1)" + NL
    t = t + "        END WHILE" + NL
    t = t + "        IF words.Contains(bare) THEN" + NL
    t = t + "            out.Add(""<b>"" + H(t) + ""</b>"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(H(t))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    t = out.Join("" "")" + NL
    t = t + "    IF at > 0 THEN t = ""..."" + t" + NL
    t = t + "    IF at + 220 < text.Length THEN t = t + ""...""" + NL
    t = t + "    RETURN t" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- page furniture" + NL
    t = t + "" + NL
    t = t + "FUNCTION Top (title AS String) AS String" + NL
    t = t + "    RETURN ""<html><head><title>"" + H(title) + ""</title></head>"" _" + NL
    t = t + "         + ""<body bgcolor=""""#FFFFFF"""" text=""""#000000"""" link=""""#660099"""" vlink=""""#660099"""">""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION AskBox (q AS String) AS String" + NL
    t = t + "    RETURN ""<form action=""""index.asp"""" method=""""get""""><p><input name=""""q"""" size=""""50"""" maxlength=""""200"""" value="""""" + H(q) + """"""> "" _" + NL
    t = t + "         + ""<input type=""""submit"""" value=""""Ask!""""></p></form>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Stats () AS String" + NL
    t = t + "    VAR s AS Array OF String" + NL
    t = t + "    s = ReadOr(DATADIR + ""\STATS.TXT"", """").Lines()" + NL
    t = t + "    IF s.Count < 4 THEN RETURN ""Simms has not been round the network yet. Start C:\PROGRAMS\CRAWLER.SPK and press Crawl Now.""" + NL
    t = t + "    RETURN ""Simms knows "" + s[1] + "" pages on "" + s[2] + "" machines. He last went round the network on "" + s[0] + "".""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Bottom () AS String" + NL
    t = t + "    RETURN ""<hr><center><font size=""""1"""" color=""""#808080"""">AskSim on "" + H(NET.HostName.Lower()) + "" &middot; "" + H(Stats()) _" + NL
    t = t + "         + "" &middot; <a href=""""addurl.asp"""">Add your site</a></font></center></body></html>""" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\WEB\ASK.SPK")
END SUB

SUB File2 ()
    t = ""
    t = t + "<%@ import file=""ASK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' CACHE.ASP?id=N - the page as the crawler last saw it, under a banner. Handy" + NL
    t = t + "' when the machine it lives on has gone away." + NL
    t = t + "VAR id AS String" + NL
    t = t + "VAR doc AS Array OF String" + NL
    t = t + "id = REQUEST.Query(""id"")" + NL
    t = t + "IF DocLine(id) = """" OR id.Contains(""\"") OR id.Contains(""."") THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "doc = DocLine(id).Split(""|"")" + NL
    t = t + "%>" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""0"" border=""1""><tr><td bgcolor=""#F3EEF7""><font size=""2"">" + NL
    t = t + "This is <a href=""index.asp""><b>AskSim</b></a>'s copy of <a href=""<%= H(doc[1]) %>""><%= H(doc[1]) %></a>" + NL
    t = t + "as it looked on <b><%= H(doc[3]) %></b>." + NL
    t = t + "<% IF doc[4] = ""gone"" THEN %>" + NL
    t = t + "<font color=""#990000""><b>The real page has not answered since <%= H(doc[5]) %>.</b></font>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "The real page may have changed since." + NL
    t = t + "<% END IF %>" + NL
    t = t + "</font></td></tr></table>" + NL
    t = t + "<%= ReadOr(DATADIR + ""\CACHE\"" + id + "".HTM"", ""<p>Simms has misplaced his copy of this page. Most embarrassing.</p>"") %>" + NL
    Put("C:\WEB\CACHE.ASP")
END SUB

SUB File3 ()
    t = ""
    t = t + "<%@ import file=""ASK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' INDEX.ASP?q=question[&p=page][&go=1] - ask Simms. go=1 takes you straight" + NL
    t = t + "' to the best answer." + NL
    t = t + "VAR q AS String" + NL
    t = t + "VAR words AS Array OF String" + NL
    t = t + "VAR p AS Integer" + NL
    t = t + "VAR i AS Integer" + NL
    t = t + "VAR doc AS Array OF String" + NL
    t = t + "VAR id AS String" + NL
    t = t + "VAR w AS String" + NL
    t = t + "VAR first AS Integer" + NL
    t = t + "q = REQUEST.Query(""q"").Trim()" + NL
    t = t + "IF q.Length > 200 THEN q = q.Substring(0, 200)" + NL
    t = t + "words = QueryWords(q)" + NL
    t = t + "IF words.Count > 0 THEN" + NL
    t = t + "    Search(words)" + NL
    t = t + "ELSEIF siteFilter <> """" THEN" + NL
    t = t + "    SiteOnly()" + NL
    t = t + "END IF" + NL
    t = t + "IF REQUEST.Query(""go"") = ""1"" AND found.Count > 0 THEN RESPONSE.Redirect(DocLine(found[0].Split(""|"")[1]).Split(""|"")[1])" + NL
    t = t + "p = Int(Val(REQUEST.Query(""p"")))" + NL
    t = t + "IF p < 1 THEN p = 1" + NL
    t = t + "first = (p - 1) * PERPAGE" + NL
    t = t + "%>" + NL
    t = t + "<% IF q = """" THEN %>" + NL
    t = t + "<%= Top(""AskSim"") %>" + NL
    t = t + "<center>" + NL
    t = t + "<table cellpadding=""10""><tr>" + NL
    t = t + "<td><img src=""simms.pic"" alt=""Simms the butler""></td>" + NL
    t = t + "<td><font size=""7"" color=""#660099""><b>AskSim</b></font><br>" + NL
    t = t + "<font size=""3""><i>Just ask Simms. He knows the network.</i></font></td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<p>Have a question? Type it in plain English and click <b>Ask!</b></p>" + NL
    t = t + "<%= AskBox("""") %>" + NL
    t = t + "<p><font size=""2"">For example:" + NL
    t = t + "<a href=""index.asp?q=Where+can+I+find+a+social+network%3F"">Where can I find a social network?</a> &middot;" + NL
    t = t + "<a href=""index.asp?q=Who+has+free+e-mail%3F"">Who has free e-mail?</a> &middot;" + NL
    t = t + "<a href=""index.asp?q=How+do+I+write+a+SPARK+program%3F"">How do I write a SPARK program?</a></font></p>" + NL
    t = t + "</center>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<%= Top(q + "" - AskSim"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""0"" bgcolor=""#E8DDF0""><tr>" + NL
    t = t + "<td width=""50""><a href=""index.asp""><img src=""simms.pic"" alt=""Simms""></a></td>" + NL
    t = t + "<td><a href=""index.asp""><font size=""5"" color=""#660099""><b>AskSim</b></font></a><br><%= AskBox(q) %></td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<p><font size=""2"">You asked: <b><%= H(q) %></b></font></p>" + NL
    t = t + "<% IF found.Count = 0 THEN %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8""><tr><td bgcolor=""#FFF9D7""><font size=""2"">" + NL
    t = t + "<% IF words.Count = 0 AND siteFilter = """" THEN %>" + NL
    t = t + "I'm terribly sorry, I couldn't tell what you were looking for. Might you ask it another way, with a word or two about the subject?" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "I'm terribly sorry. I've looked in every corner of the network and found nothing about" + NL
    t = t + "<b><%= H(words.Join("" "")) %></b><% IF siteFilter <> """" THEN %> on <b><%= H(siteFilter) %></b><% END IF %>." + NL
    t = t + "Perhaps try fewer words, or <a href=""addurl.asp"">tell me about a site</a> I ought to visit." + NL
    t = t + "<% END IF %>" + NL
    t = t + "</font></td></tr></table>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<% doc = DocLine(found[0].Split(""|"")[1]).Split(""|"") %>" + NL
    t = t + "<% IF p = 1 THEN %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8""><tr><td bgcolor=""#F3EEF7""><font size=""2"">" + NL
    t = t + "<b>Simms suggests:</b> <a href=""<%= H(doc[1]) %>""><b><%= H(Clip(doc[2], 80)) %></b></a>" + NL
    t = t + "<font color=""#808080"">(<%= H(HostOf(doc[1])) %>)</font>" + NL
    t = t + "</font></td></tr></table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<p><font size=""2"">Simms found <b><%= found.Count %></b> answer<% IF found.Count <> 1 THEN %>s<% END IF %>" + NL
    t = t + "<% IF words.Count > 0 THEN %> about <b><%= H(words.Join("" "")) %></b><% END IF %><% IF siteFilter <> """" THEN %> on <b><%= H(siteFilter) %></b><% END IF %>:</font></p>" + NL
    t = t + "<dl>" + NL
    t = t + "<% FOR i = first TO MATH.Min(first + PERPAGE, found.Count) - 1" + NL
    t = t + "     id = found[i].Split(""|"")[1]" + NL
    t = t + "     doc = DocLine(id).Split(""|"") %>" + NL
    t = t + "<dt><font size=""3""><a href=""<%= H(doc[1]) %>""><b><%= H(Clip(doc[2], 80)) %></b></a></font></dt>" + NL
    t = t + "<dd><font size=""2""><%= Snippet(id, words) %><br>" + NL
    t = t + "<font color=""#008000""><%= H(Clip(doc[1], 80)) %></font> &middot;" + NL
    t = t + "<a href=""cache.asp?id=<%= id %>"">Cached</a>" + NL
    t = t + "<% IF doc[4] = ""gone"" THEN %> &middot; <font color=""#990000"">not answering since <%= H(doc[5]) %></font><% END IF %>" + NL
    t = t + "</font><br><br></dd>" + NL
    t = t + "<% NEXT %>" + NL
    t = t + "</dl>" + NL
    t = t + "<p><font size=""2"">" + NL
    t = t + "<% IF p > 1 THEN %><a href=""index.asp?q=<%= UrlEnc(q) %>&p=<%= p - 1 %>"">&laquo; Previous</a> <% END IF %>" + NL
    t = t + "<% IF first + PERPAGE < found.Count THEN %><a href=""index.asp?q=<%= UrlEnc(q) %>&p=<%= p + 1 %>"">More answers &raquo;</a><% END IF %>" + NL
    t = t + "</font></p>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<% IF words.Count > 0 THEN %>" + NL
    t = t + "<table width=""100%"" cellpadding=""6""><tr><td bgcolor=""#F3EEF7""><font size=""2"">" + NL
    t = t + "<b>Simms can also answer these questions:</b><br>" + NL
    t = t + "<% FOR EACH w IN words %>" + NL
    t = t + "&middot; <a href=""index.asp?q=<%= UrlEnc(""Where can I find pages about "" + w + ""?"") %>"">Where can I find pages about <i><%= H(w) %></i>?</a><br>" + NL
    t = t + "<% NEXT %>" + NL
    t = t + "<% IF found.Count > 0 THEN %>" + NL
    t = t + "&middot; <a href=""index.asp?q=<%= UrlEnc(""site:"" + HostOf(DocLine(found[0].Split(""|"")[1]).Split(""|"")[1])) %>"">What else is on <i><%= H(HostOf(DocLine(found[0].Split(""|"")[1]).Split(""|"")[1])) %></i>?</a><br>" + NL
    t = t + "&middot; <a href=""index.asp?q=<%= UrlEnc(q) %>&go=1"">Just take me to the best answer.</a>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</font></td></tr></table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\INDEX.ASP")
END SUB

