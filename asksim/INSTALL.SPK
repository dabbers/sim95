    t = t + "FFFFFFFFFFFFF777777777777777FFFFFFFFFFFF" + NL
    t = t + "FFFFFFFFFFFF77777777777777777FFFFFFFFFFF" + NL
    t = t + "FFFFFFFFFFFF77777777777777777FFFFFFFFFFF" + NL
