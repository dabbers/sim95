SUB File5 ()
    t = ""
    t = t + "' CRAWLER.SPK - AskSim's web crawler. Walks every web server on the network," + NL
    t = t + "' keeps a copy of each page, and builds the index the search pages read." + NL
    t = t + "'" + NL
    t = t + "' A crawl:" + NL
    t = t + "'   1. Starting points: every machine NET.Machines() can see (http://name/)," + NL
    t = t + "'      the sites people submitted (C:\ASKDATA\SEEDS.TXT), and every page" + NL
    t = t + "'      already known, to see whether it is still there." + NL
    t = t + "'   2. Fetch each page over port 80 (GET, the way Voyager does), at most" + NL
    t = t + "'      PERHOST pages per machine and MAXPAGES in all, minding each machine's" + NL
    t = t + "'      /robots.txt (""Disallow: /path"" lines). Follow its links, to other" + NL
    t = t + "'      machines too." + NL
    t = t + "'   3. Keep the page's text (TEXT\<id>.TXT) and a copy of the page itself with" + NL
    t = t + "'      its links pointing back at the real site (CACHE\<id>.HTM)." + NL
    t = t + "'   4. A known page that does not answer this time is not forgotten: it stays," + NL
    t = t + "'      marked ""gone"" since the first crawl that missed it, and its cached copy" + NL
    t = t + "'      is what the search pages offer instead." + NL
    t = t + "'   5. Build the index: for every word, the pages it is on and how often." + NL
    t = t + "'" + NL
    t = t + "'   C:\ASKDATA\DOCS.TXT       id|url|title|crawled|state|since   (state: ok or gone)" + NL
    t = t + "'   C:\ASKDATA\TEXT\<id>.TXT  the page's title, a line break, then its text" + NL
    t = t + "'   C:\ASKDATA\CACHE\<id>.HTM the page as it was, links made absolute" + NL
    t = t + "'   C:\ASKDATA\IDX\<c>.TXT    word|id:count id:count ...  for words starting with c (0: digits)" + NL
    t = t + "'   C:\ASKDATA\STATS.TXT      when, how many pages and machines, how long it took" + NL
    t = t + "'   C:\ASKDATA\SEEDS.TXT      submitted sites, one URL per line" + NL
    t = t + "'" + NL
    t = t + "' Why the crawl is a timer and not a loop: in SIM95 a failed wait (a Connect" + NL
    t = t + "' nobody answers, a Receive on a closed connection) can be caught with TRY, but" + NL
    t = t + "' the handler it happened in is spoiled: the same error comes back the next" + NL
    t = t + "' time it waits, and also at the next of the pauses the interpreter takes every" + NL
    t = t + "' 512 statements. So each fetch starts in a timer tick of its own, pages arrive" + NL
    t = t + "' through onMessage and onClose instead of Receive, and the whole tick sits in" + NL
    t = t + "' a TRY with an empty CATCH and nothing after it, so a spoiled tick just ends." + NL
    t = t + "" + NL
    t = t + "CONST SKIPDIRS = ""/docs/""            ' folders never crawled, ""|"" between them" + NL
    t = t + "CONST DATA = ""C:\ASKDATA""" + NL
    t = t + "CONST PERHOST = 40" + NL
    t = t + "CONST MAXPAGES = 500" + NL
    t = t + "CONST TEXTMAX = 12000" + NL
    t = t + "CONST CACHEMAX = 40000" + NL
    t = t + "CONST EVERY = 60              ' minutes between crawls" + NL
    t = t + "CONST PATIENCE = 6000         ' milliseconds to wait for a page" + NL
    t = t + "CONST TITLEWEIGHT = 5         ' a word in the title counts this many times" + NL
    t = t + "CONST STOPWORDS = ""|a|an|the|and|or|of|to|in|on|at|by|for|is|it|its|be|as|are|was|with|this|that|from|you|your|i|me|my|we|our|he|she|they|them|but|not|no|so|if|do|does|did|have|has|had|can|will|just|all|any|there|here|what|where|who|how|which|when|why|about|into|out|up|than|then|also|more|some|very|would|could|should|been|were|these|those|their|his|her|him|am|get|got|one|nbsp|""" + NL
    t = t + "" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR log AS GUI_ListBox" + NL
    t = t + "VAR go AS GUI_Button" + NL
    t = t + "VAR timer AS GUI_Timer" + NL
    t = t + "VAR web AS NET_Socket" + NL
    t = t + "VAR NL AS String" + NL
    t = t + "" + NL
    t = t + "' Where the crawl is: idle, start, gathering, next, wait, finish, indexing." + NL
    t = t + "' Ticks keep coming while a step waits (gathering, indexing), and do nothing then." + NL
    t = t + "VAR phase AS String = ""idle""" + NL
    t = t + "VAR started AS Integer" + NL
    t = t + "VAR fetched AS Integer" + NL
    t = t + "VAR kept AS Integer" + NL
    t = t + "" + NL
    t = t + "' One crawl's state" + NL
    t = t + "VAR queue AS Array OF String" + NL
    t = t + "VAR seen AS String" + NL
    t = t + "VAR hosts AS Array OF String" + NL
    t = t + "VAR hostPages AS Array OF Integer" + NL
    t = t + "VAR robotHosts AS Array OF String" + NL
    t = t + "VAR robotRules AS Array OF String" + NL
    t = t + "VAR docUrls AS Array OF String" + NL
    t = t + "VAR docLines AS Array OF String" + NL
    t = t + "VAR fetchedOk AS String" + NL
    t = t + "" + NL
    t = t + "' The fetch in progress, and what it got" + NL
    t = t + "VAR fUrl AS String" + NL
    t = t + "VAR fRobots AS Bool" + NL
    t = t + "VAR fNumber AS Integer" + NL
    t = t + "VAR fParts AS Array OF String" + NL
    t = t + "VAR fDone AS Bool" + NL
    t = t + "VAR fSince AS Integer" + NL
    t = t + "VAR fStatus AS Integer" + NL
    t = t + "VAR fType AS String" + NL
    t = t + "VAR fLocation AS String" + NL
    t = t + "VAR fBody AS String" + NL
    t = t + "VAR fError AS String" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    NL = Chr(10)" + NL
    t = t + "    win = GUI_Window.New(""AskSim Crawler"", 480, 280)" + NL
    t = t + "    win.Icon = ""network""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    win.onResize = Win_OnResize" + NL
    t = t + "    log = GUI_ListBox.New(win)" + NL
    t = t + "    log.Mono = TRUE" + NL
    t = t + "    go = GUI_Button.New(win)" + NL
    t = t + "    go.Text = ""&Crawl Now""" + NL
    t = t + "    go.onClick = Go_OnClick" + NL
    t = t + "    Win_OnResize()" + NL
    t = t + "    EnsureDirs()" + NL
    t = t + "    web = NET_Socket.New()" + NL
    t = t + "    web.onMessage = Web_OnMessage" + NL
    t = t + "    web.onClose = Web_OnClose" + NL
    t = t + "    Note(""AskSim crawler on "" + NET.HostName + "". Crawls every "" + Str(EVERY) + "" minutes."")" + NL
    t = t + "    timer = GUI_Timer.New(win)" + NL
    t = t + "    timer.Interval = 5000" + NL
    t = t + "    timer.onTick = Timer_OnTick" + NL
    t = t + "    timer.Start()" + NL
    t = t + "    win.Status = LastCrawl()" + NL
    t = t + "    win.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnResize ()" + NL
    t = t + "    log.SetBounds(0, 0, win.Width, win.Height - 36)" + NL
    t = t + "    go.SetBounds(8, win.Height - 32, 120, 26)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Note (text AS String)" + NL
    t = t + "    log.Add(TIME.Clock + ""  "" + text)" + NL
    t = t + "    IF log.Count > 400 THEN log.RemoveAt(0)" + NL
    t = t + "    log.ScrollToEnd()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB EnsureDirs ()" + NL
    t = t + "    VAR d AS String" + NL
    t = t + "    FOR EACH d IN ["""", ""\TEXT"", ""\CACHE"", ""\IDX""]" + NL
    t = t + "        IF NOT FS.Exists(DATA + d) THEN FS.MakeDir(DATA + d)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LastCrawl () AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = ReadOr(DATA + ""\STATS.TXT"", """")" + NL
    t = t + "    IF s = """" THEN RETURN ""Not crawled yet""" + NL
    t = t + "    RETURN ""Last crawl: "" + s.Lines()[0]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Every tick moves the crawl one step. When idle, it checks whether a crawl is due." + NL
    t = t + "SUB Timer_OnTick ()" + NL
    t = t + "    TRY" + NL
    t = t + "        Tick()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Tick ()" + NL
    t = t + "    VAR stats AS Array OF String" + NL
    t = t + "    SELECT CASE phase" + NL
    t = t + "        CASE ""idle""" + NL
    t = t + "            IF NOT NET.Online THEN RETURN" + NL
    t = t + "            stats = ReadOr(DATA + ""\STATS.TXT"", """").Lines()" + NL
    t = t + "            IF stats.Count >= 5 THEN" + NL
    t = t + "                IF TIME.Now - Int(Val(stats[4])) < EVERY * 60 THEN RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "            Begin()" + NL
    t = t + "        CASE ""start""" + NL
    t = t + "            Gather()" + NL
    t = t + "        CASE ""next""" + NL
    t = t + "            NextPage()" + NL
    t = t + "        CASE ""wait""" + NL
    t = t + "            IF fDone OR SYS.Ticks - fSince > PATIENCE THEN Arrived()" + NL
    t = t + "        CASE ""finish""" + NL
    t = t + "            Finish()" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Go_OnClick ()" + NL
    t = t + "    IF phase <> ""idle"" THEN" + NL
    t = t + "        Note(""Already crawling."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    Begin()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- URLs" + NL
    t = t + "" + NL
    t = t + "FUNCTION HostOf (url AS String) AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    rest = url.Substring(7, url.Length - 7)" + NL
    t = t + "    IF rest.Contains(""/"") THEN rest = rest.Substring(0, rest.IndexOf(""/""))" + NL
    t = t + "    IF rest.Contains("":"") THEN rest = rest.Substring(0, rest.IndexOf("":""))" + NL
    t = t + "    RETURN rest" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION PortOf (url AS String) AS Integer" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    rest = url.Substring(7, url.Length - 7)" + NL
    t = t + "    IF rest.Contains(""/"") THEN rest = rest.Substring(0, rest.IndexOf(""/""))" + NL
    t = t + "    IF NOT rest.Contains("":"") THEN RETURN 80" + NL
    t = t + "    RETURN Int(Val(rest.Substring(rest.IndexOf("":"") + 1, rest.Length - rest.IndexOf("":"") - 1)))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION PathOf (url AS String) AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    rest = url.Substring(7, url.Length - 7)" + NL
    t = t + "    IF NOT rest.Contains(""/"") THEN RETURN ""/""" + NL
    t = t + "    RETURN rest.Substring(rest.IndexOf(""/""), rest.Length - rest.IndexOf(""/""))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One spelling per page: lower case (SIM95 paths are not case-sensitive), no" + NL
    t = t + "' #fragment, no ./ or dir/../" + NL
    t = t + "FUNCTION Normal (url AS String) AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR query AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    IF url.Contains(""#"") THEN url = url.Substring(0, url.IndexOf(""#""))" + NL
    t = t + "    path = PathOf(url)" + NL
    t = t + "    query = """"" + NL
    t = t + "    IF path.Contains(""?"") THEN" + NL
    t = t + "        query = path.Substring(path.IndexOf(""?""), path.Length - path.IndexOf(""?""))" + NL
    t = t + "        path = path.Substring(0, path.IndexOf(""?""))" + NL
    t = t + "    END IF" + NL
    t = t + "    parts = path.Lower().Split(""/"")" + NL
    t = t + "    FOR EACH p IN parts" + NL
    t = t + "        IF p = "".."" THEN" + NL
    t = t + "            IF out.Count > 1 THEN out.RemoveAt(out.Count - 1)" + NL
    t = t + "        ELSEIF p <> ""."" THEN" + NL
    t = t + "            out.Add(p)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    path = out.Join(""/"")" + NL
    t = t + "    IF NOT path.StartsWith(""/"") THEN path = ""/"" + path" + NL
    t = t + "    ' A folder and its index page are the same page" + NL
    t = t + "    IF path.EndsWith(""/index.htm"") THEN path = path.Substring(0, path.Length - 9)" + NL
    t = t + "    IF path.EndsWith(""/index.asp"") AND query = """" THEN path = path.Substring(0, path.Length - 9)" + NL
    t = t + "    IF PortOf(url) <> 80 THEN RETURN ""http://"" + HostOf(url).Lower() + "":"" + Str(PortOf(url)) + path + query" + NL
    t = t + "    RETURN ""http://"" + HostOf(url).Lower() + path + query" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A link as written on page base, made into a full URL; """" for ones not to follow." + NL
    t = t + "FUNCTION Resolve (link AS String, base AS String) AS String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR colon AS Integer" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    l = link.Trim().Replace(""&amp;"", ""&"")" + NL
    t = t + "    IF l = """" OR l.StartsWith(""#"") THEN RETURN """"" + NL
    t = t + "    IF l.Lower().StartsWith(""http://"") THEN RETURN Normal(l)" + NL
    t = t + "    ' mailto:, ftp:, javascript: and friends - a colon before any / or ?" + NL
    t = t + "    colon = l.IndexOf("":"")" + NL
    t = t + "    IF colon >= 0 AND (l.IndexOf(""/"") < 0 OR colon < l.IndexOf(""/"")) AND (l.IndexOf(""?"") < 0 OR colon < l.IndexOf(""?"")) THEN RETURN """"" + NL
    t = t + "    IF l.StartsWith(""/"") THEN RETURN Normal(""http://"" + HostOf(base) + l)" + NL
    t = t + "    dir = PathOf(base)" + NL
    t = t + "    IF dir.Contains(""?"") THEN dir = dir.Substring(0, dir.IndexOf(""?""))" + NL
    t = t + "    parts = dir.Split(""/"")" + NL
    t = t + "    dir = dir.Substring(0, dir.Length - parts[parts.Count - 1].Length)" + NL
    t = t + "    RETURN Normal(""http://"" + HostOf(base) + dir + l)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Folders every machine has the same copy of (the SIM95 manuals): not worth" + NL
    t = t + "' indexing over and over." + NL
    t = t + "FUNCTION Skipped (url AS String) AS Bool" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    FOR EACH dir IN SKIPDIRS.Split(""|"")" + NL
    t = t + "        IF dir <> """" AND (PathOf(url) + ""/"").StartsWith(dir) THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Links nobody wants a robot to follow: they change things." + NL
    t = t + "FUNCTION Harmless (url AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    p = PathOf(url)" + NL
    t = t + "    IF Skipped(url) THEN RETURN FALSE" + NL
    t = t + "    IF p.Contains(""logout"") OR p.Contains(""delete"") OR p.Contains(""remove"") OR p.Contains(""vote."") OR p.Contains(""poke."") THEN RETURN FALSE" + NL
    t = t + "    IF p.Contains(""?t="") OR p.Contains(""&t="") THEN RETURN FALSE" + NL
    t = t + "    RETURN NOT (p.EndsWith("".pic"") OR p.EndsWith("".spk"") OR p.EndsWith("".inc""))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- fetching" + NL
    t = t + "" + NL
    t = t + "' Starts a GET, the way Voyager does. The page comes in through Web_OnMessage" + NL
    t = t + "' until the server closes (Web_OnClose); Arrived picks it up from there." + NL
    t = t + "SUB StartFetch (url AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    fUrl = url" + NL
    t = t + "    fNumber = fNumber + 1" + NL
    t = t + "    fParts.Clear()" + NL
    t = t + "    fDone = FALSE" + NL
    t = t + "    fSince = SYS.Ticks" + NL
    t = t + "    fError = """"" + NL
    t = t + "    phase = ""wait""" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = web.Connect(HostOf(url), PortOf(url))" + NL
    t = t + "        conn.Tag = Str(fNumber)" + NL
    t = t + "        conn.Send(""GET "" + PathOf(url) + "" HTTP/1.0"" + NL + ""Host: "" + HostOf(url) + NL + ""User-Agent: AskSim/1.0 (http://"" + NET.HostName.Lower() + ""/)"")" + NL
    t = t + "    CATCH err" + NL
    t = t + "        fError = err" + NL
    t = t + "        fDone = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "    ' Nothing else may wait in this tick: see the note at the top." + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    IF conn.Tag = Str(fNumber) AND NOT fDone THEN fParts.Add(message)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnClose (conn AS NET_Connection)" + NL
    t = t + "    IF conn.Tag = Str(fNumber) THEN fDone = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Reads what the last fetch got into fStatus (0 when nobody answered), fType," + NL
    t = t + "' fLocation and fBody." + NL
    t = t + "SUB ReadResponse ()" + NL
    t = t + "    VAR raw AS String" + NL
    t = t + "    VAR head AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    fStatus = 0" + NL
    t = t + "    fType = """"" + NL
    t = t + "    fLocation = """"" + NL
    t = t + "    fBody = """"" + NL
    t = t + "    web.Close()" + NL
    t = t + "    raw = fParts.Join(NL)" + NL
    t = t + "    IF fError <> """" THEN RETURN" + NL
    t = t + "    IF NOT raw.StartsWith(""HTTP/"") THEN" + NL
    t = t + "        IF fDone THEN" + NL
    t = t + "            fError = ""not a web server""" + NL
    t = t + "        ELSE" + NL
    t = t + "            fError = ""no answer in "" + Str(PATIENCE / 1000) + "" seconds""" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    fStatus = Int(Val(raw.Split("" "")[1]))" + NL
    t = t + "    IF raw.Contains(NL + NL) THEN" + NL
    t = t + "        head = raw.Substring(0, raw.IndexOf(NL + NL))" + NL
    t = t + "        fBody = raw.Substring(head.Length + 2, raw.Length - head.Length - 2)" + NL
    t = t + "    ELSE" + NL
    t = t + "        head = raw" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH line IN head.Lines()" + NL
    t = t + "        IF line.Lower().StartsWith(""content-type:"") THEN fType = line.Substring(13, line.Length - 13).Trim().Lower()" + NL
    t = t + "        IF line.Lower().StartsWith(""location:"") THEN fLocation = line.Substring(9, line.Length - 9).Trim()" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' robots.txt: ""Disallow: /path"" lines. """" when this host's rules are not known" + NL
    t = t + "' yet, otherwise ""yes"" or ""no""." + NL
    t = t + "FUNCTION Allowed (url AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR rule AS String" + NL
    t = t + "    i = robotHosts.IndexOf(HostOf(url))" + NL
    t = t + "    IF i < 0 THEN RETURN """"" + NL
    t = t + "    FOR EACH rule IN robotRules[i].Split(""|"")" + NL
    t = t + "        IF rule <> """" AND PathOf(url).StartsWith(rule) THEN RETURN ""no""" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN ""yes""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB LearnRobots (host AS String)" + NL
    t = t + "    VAR rules AS String = ""|""" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR rule AS String" + NL
    t = t + "    IF fStatus = 200 THEN" + NL
    t = t + "        FOR EACH line IN fBody.Lines()" + NL
    t = t + "            IF line.Lower().StartsWith(""disallow:"") THEN" + NL
    t = t + "                rule = line.Substring(9, line.Length - 9).Trim().Lower()" + NL
    t = t + "                IF rule <> """" THEN rules = rules + rule + ""|""" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF rules <> ""|"" THEN Note(""  "" + host + ""/robots.txt keeps me out of "" + rules.Substring(1, rules.Length - 2).Replace(""|"", "", ""))" + NL
    t = t + "    END IF" + NL
    t = t + "    robotHosts.Add(host)" + NL
    t = t + "    robotRules.Add(rules)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Enqueue (url AS String)" + NL
    t = t + "    IF url = """" OR NOT url.StartsWith(""http://"") THEN RETURN" + NL
    t = t + "    ' ""localhost"" means whoever is reading the page, not the machine it is on" + NL
    t = t + "    IF HostOf(url) = ""localhost"" OR HostOf(url).StartsWith(""127."") THEN RETURN" + NL
    t = t + "    IF seen.Contains(""|"" + url + ""|"") OR NOT Harmless(url) THEN RETURN" + NL
    t = t + "    seen = seen + url + ""|""" + NL
    t = t + "    queue.Add(url)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION TakeHost (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = hosts.IndexOf(host)" + NL
    t = t + "    IF i < 0 THEN" + NL
    t = t + "        hosts.Add(host)" + NL
    t = t + "        hostPages.Add(0)" + NL
    t = t + "        i = hosts.Count - 1" + NL
    t = t + "    END IF" + NL
    t = t + "    IF hostPages[i] >= PERHOST THEN RETURN FALSE" + NL
    t = t + "    hostPages[i] = hostPages[i] + 1" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- pages" + NL
    t = t + "" + NL
    t = t + "' text between <tag ...> and </tag>, """" if there is none" + NL
    t = t + "FUNCTION Between (html AS String, low AS String, tag AS String) AS String" + NL
    t = t + "    VAR a AS Integer" + NL
    t = t + "    VAR b AS Integer" + NL
    t = t + "    a = low.IndexOf(""<"" + tag)" + NL
    t = t + "    IF a < 0 THEN RETURN """"" + NL
    t = t + "    a = a + low.Substring(a, low.Length - a).IndexOf("">"") + 1" + NL
    t = t + "    b = low.Substring(a, low.Length - a).IndexOf(""</"" + tag)" + NL
    t = t + "    IF b < 0 THEN RETURN """"" + NL
    t = t + "    RETURN html.Substring(a, b)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION WithoutBlocks (html AS String, tag AS String) AS String" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    VAR a AS Integer" + NL
    t = t + "    VAR b AS Integer" + NL
    t = t + "    low = html.Lower()" + NL
    t = t + "    a = low.IndexOf(""<"" + tag)" + NL
    t = t + "    WHILE a >= 0" + NL
    t = t + "        b = low.Substring(a, low.Length - a).IndexOf(""</"" + tag + "">"")" + NL
    t = t + "        IF b < 0 THEN" + NL
    t = t + "            html = html.Substring(0, a)" + NL
    t = t + "        ELSE" + NL
    t = t + "            html = html.Substring(0, a) + "" "" + html.Substring(a + b + tag.Length + 3, html.Length - a - b - tag.Length - 3)" + NL
    t = t + "        END IF" + NL
    t = t + "        low = html.Lower()" + NL
    t = t + "        a = low.IndexOf(""<"" + tag)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN html" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Decode (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""&nbsp;"", "" "").Replace(""&lt;"", ""<"").Replace(""&gt;"", "">"").Replace(""&quot;"", """""""").Replace(""&#39;"", ""'"").Replace(""&middot;"", ""-"").Replace(""&raquo;"", "">>"").Replace(""&laquo;"", ""<<"").Replace(""&copy;"", ""(c)"").Replace(""&amp;"", ""&"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The words a person would read, on one line." + NL
    t = t + "FUNCTION PlainText (html AS String) AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR gt AS Integer" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    html = WithoutBlocks(WithoutBlocks(WithoutBlocks(html, ""script""), ""style""), ""title"")" + NL
    t = t + "    parts = html.Split(""<"")" + NL
    t = t + "    out.Add(parts[0])" + NL
    t = t + "    FOR i = 1 TO parts.Count - 1" + NL
    t = t + "        gt = parts[i].IndexOf("">"")" + NL
    t = t + "        IF gt >= 0 THEN" + NL
    t = t + "            out.Add(parts[i].Substring(gt + 1, parts[i].Length - gt - 1))" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(parts[i])" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    t = Decode(out.Join("" "")).Replace(Chr(13), "" "").Replace(Chr(10), "" "").Replace(Chr(9), "" "")" + NL
    t = t + "    WHILE t.Contains(""  "")" + NL
    t = t + "        t = t.Replace(""  "", "" "")" + NL
    t = t + "    END WHILE" + NL
    t = t + "    ' Tags around a word left a space before the punctuation after it" + NL
    t = t + "    RETURN t.Replace("" ,"", "","").Replace("" ."", ""."").Replace("" ;"", "";"").Replace("" :"", "":"").Replace("" !"", ""!"").Replace("" ?"", ""?"").Replace("" )"", "")"").Replace(""( "", ""("").Trim()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Every link and picture on the page as a full URL, and the page itself with" + NL
    t = t + "' them rewritten so the cached copy still points at the real site." + NL
    t = t + "VAR pageLinks AS Array OF String" + NL
    t = t + "VAR pageCopy AS String" + NL
    t = t + "" + NL
    t = t + "SUB ReadLinks (html AS String, base AS String)" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    VAR attr AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR q AS String" + NL
    t = t + "    VAR endAt AS Integer" + NL
    t = t + "    VAR raw AS String" + NL
    t = t + "    VAR full AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    pageLinks.Clear()" + NL
    t = t + "    pageCopy = html" + NL
    t = t + "    FOR EACH attr IN [""href="", ""src=""]" + NL
    t = t + "        low = html.Lower()" + NL
    t = t + "        rest = low" + NL
    t = t + "        at = rest.IndexOf(attr)" + NL
    t = t + "        WHILE at >= 0" + NL
    t = t + "            rest = rest.Substring(at + attr.Length, rest.Length - at - attr.Length)" + NL
    t = t + "            q = rest.CharAt(0)" + NL
    t = t + "            IF q = """""""" OR q = ""'"" THEN" + NL
    t = t + "                endAt = rest.Substring(1, rest.Length - 1).IndexOf(q)" + NL
    t = t + "                IF endAt > 0 THEN" + NL
    t = t + "                    raw = html.Substring(html.Length - rest.Length + 1, endAt)" + NL
    t = t + "                    full = Resolve(raw, base)" + NL
    t = t + "                    IF full <> """" AND raw <> full THEN pageCopy = pageCopy.Replace(attr.Substring(0, attr.Length - 1) + ""="" + q + raw + q, attr.Substring(0, attr.Length - 1) + ""="" + q + full + q)" + NL
    t = t + "                    IF attr = ""href="" AND full <> """" THEN pageLinks.Add(full)" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "            at = rest.IndexOf(attr)" + NL
    t = t + "        END WHILE" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the crawl" + NL
    t = t + "" + NL
    t = t + "FUNCTION DocId (url AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    i = docUrls.IndexOf(url)" + NL
    t = t + "    IF i >= 0 THEN RETURN docLines[i].Split(""|"")[0]" + NL
    t = t + "    n = Int(Val(ReadOr(DATA + ""\NEXTDOC.TXT"", ""0""))) + 1" + NL
    t = t + "    FS.Write(DATA + ""\NEXTDOC.TXT"", Str(n))" + NL
    t = t + "    docUrls.Add(url)" + NL
    t = t + "    docLines.Add(Str(n) + ""|"" + url + ""|||new|"")" + NL
    t = t + "    RETURN Str(n)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SetDoc (url AS String, line AS String)" + NL
    t = t + "    docLines[docUrls.IndexOf(url)] = line" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Clean (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""|"", ""/"").Replace(Chr(10), "" "").Replace(Chr(13), "" "").Trim()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Begin ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    phase = ""start""" + NL
    t = t + "    go.Enabled = FALSE" + NL
    t = t + "    timer.Interval = 10" + NL
    t = t + "    started = SYS.Ticks" + NL
    t = t + "    fetched = 0" + NL
    t = t + "    kept = 0" + NL
    t = t + "    queue.Clear()" + NL
    t = t + "    hosts.Clear()" + NL
    t = t + "    hostPages.Clear()" + NL
    t = t + "    robotHosts.Clear()" + NL
    t = t + "    robotRules.Clear()" + NL
    t = t + "    docUrls.Clear()" + NL
    t = t + "    docLines.Clear()" + NL
    t = t + "    seen = ""|""" + NL
    t = t + "    fetchedOk = ""|""" + NL
    t = t + "    EnsureDirs()" + NL
    t = t + "    FOR EACH line IN ReadOr(DATA + ""\DOCS.TXT"", """").Lines()" + NL
    t = t + "        ' (pages from a folder that is skipped now are forgotten)" + NL
    t = t + "        IF line.Split(""|"").Count >= 6 AND NOT Skipped(line.Split(""|"")[1]) THEN" + NL
    t = t + "            docUrls.Add(line.Split(""|"")[1])" + NL
    t = t + "            docLines.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    Note(""Crawl started. Looking for machines..."")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where to start: every machine that answers, submitted sites, known pages." + NL
    t = t + "SUB Gather ()" + NL
    t = t + "    VAR m AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR url AS String" + NL
    t = t + "    VAR machines AS Array OF String" + NL
    t = t + "    phase = ""gathering""" + NL
    t = t + "    machines = NET.Machines()" + NL
    t = t + "    FOR EACH m IN machines" + NL
    t = t + "        Enqueue(Normal(""http://"" + m.Split("" "")[0] + ""/""))" + NL
    t = t + "    NEXT" + NL
    t = t + "    Note(""  "" + Str(machines.Count) + "" machines answered"")" + NL
    t = t + "    FOR EACH line IN ReadOr(DATA + ""\SEEDS.TXT"", """").Lines()" + NL
    t = t + "        IF line.Trim().Lower().StartsWith(""http://"") THEN Enqueue(Normal(line.Trim()))" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH url IN docUrls" + NL
    t = t + "        Enqueue(url)" + NL
    t = t + "    NEXT" + NL
    t = t + "    phase = ""next""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Takes the next page off the queue and starts fetching it (or its machine's" + NL
    t = t + "' robots.txt first)." + NL
    t = t + "SUB NextPage ()" + NL
    t = t + "    VAR url AS String" + NL
    t = t + "    VAR ok AS String" + NL
    t = t + "    WHILE queue.Count > 0 AND fetched < MAXPAGES" + NL
    t = t + "        url = queue[0]" + NL
    t = t + "        ok = Allowed(url)" + NL
    t = t + "        IF ok = """" THEN" + NL
    t = t + "            fRobots = TRUE" + NL
    t = t + "            StartFetch(""http://"" + HostOf(url) + ""/robots.txt"")" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        queue.RemoveAt(0)" + NL
    t = t + "        IF ok = ""yes"" AND TakeHost(HostOf(url)) THEN" + NL
    t = t + "            fRobots = FALSE" + NL
    t = t + "            fetched = fetched + 1" + NL
    t = t + "            win.Status = ""Crawling: "" + Str(fetched) + "" fetched, "" + Str(queue.Count) + "" to go - "" + url" + NL
    t = t + "            StartFetch(url)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    phase = ""finish""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A page (or robots.txt) came in, or gave up: keep what it says." + NL
    t = t + "SUB Arrived ()" + NL
    t = t + "    VAR url AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR title AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR link AS String" + NL
    t = t + "    url = fUrl" + NL
    t = t + "    ReadResponse()" + NL
    t = t + "    phase = ""next""" + NL
    t = t + "    IF fRobots THEN" + NL
    t = t + "        LearnRobots(HostOf(url))" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF fStatus = 200 AND (fType.StartsWith(""text/html"") OR fType.StartsWith(""text/plain"")) THEN" + NL
    t = t + "        id = DocId(url)" + NL
    t = t + "        IF fType.StartsWith(""text/html"") THEN" + NL
    t = t + "            title = Clean(PlainText(Between(fBody, fBody.Lower(), ""title"")))" + NL
    t = t + "            text = PlainText(fBody)" + NL
    t = t + "            ReadLinks(fBody, url)" + NL
    t = t + "            FOR EACH link IN pageLinks" + NL
    t = t + "                Enqueue(link)" + NL
    t = t + "            NEXT" + NL
    t = t + "        ELSE" + NL
    t = t + "            title = """"" + NL
    t = t + "            text = fBody.Replace(Chr(10), "" "")" + NL
    t = t + "            pageCopy = ""<pre>"" + fBody.Replace(""&"", ""&amp;"").Replace(""<"", ""&lt;"") + ""</pre>""" + NL
    t = t + "        END IF" + NL
    t = t + "        IF title = """" THEN title = url" + NL
    t = t + "        IF text.Length > TEXTMAX THEN text = text.Substring(0, TEXTMAX)" + NL
    t = t + "        IF pageCopy.Length > CACHEMAX THEN pageCopy = pageCopy.Substring(0, CACHEMAX)" + NL
    t = t + "        FS.Write(DATA + ""\TEXT\"" + id + "".TXT"", title + NL + text)" + NL
    t = t + "        FS.Write(DATA + ""\CACHE\"" + id + "".HTM"", pageCopy)" + NL
    t = t + "        SetDoc(url, id + ""|"" + url + ""|"" + title + ""|"" + TIME.Date + "" "" + TIME.Clock.Substring(0, 5) + ""|ok|"")" + NL
    t = t + "        fetchedOk = fetchedOk + url + ""|""" + NL
    t = t + "        kept = kept + 1" + NL
    t = t + "    ELSEIF (fStatus = 301 OR fStatus = 302) AND fLocation <> """" THEN" + NL
    t = t + "        Enqueue(Resolve(fLocation, url))" + NL
    t = t + "    ELSEIF fStatus = 0 THEN" + NL
    t = t + "        Note(""  "" + url + "": "" + fError)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Pages that did not answer are marked gone; then the index is rebuilt." + NL
    t = t + "SUB Finish ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR gone AS Integer" + NL
    t = t + "    phase = ""indexing""" + NL
    t = t + "    FOR EACH line IN docLines" + NL
    t = t + "        p = line.Split(""|"")" + NL
    t = t + "        IF NOT fetchedOk.Contains(""|"" + p[1] + ""|"") AND p[4] = ""ok"" THEN SetDoc(p[1], p[0] + ""|"" + p[1] + ""|"" + p[2] + ""|"" + p[3] + ""|gone|"" + TIME.Date)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH line IN docLines" + NL
    t = t + "        p = line.Split(""|"")" + NL
    t = t + "        IF p[4] = ""new"" THEN" + NL
    t = t + "            SetDoc(p[1], """")" + NL
    t = t + "        ELSEIF p[4] = ""gone"" THEN" + NL
    t = t + "            gone = gone + 1" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH line IN docLines" + NL
    t = t + "        IF line <> """" THEN out = out + line + NL" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Write(DATA + ""\DOCS.TXT"", out)" + NL
    t = t + "    Note(""Fetched "" + Str(fetched) + "" pages from "" + Str(hosts.Count) + "" machines: "" + Str(kept) + "" indexed, "" + Str(gone) + "" not answering."")" + NL
    t = t + "    BuildIndex()" + NL
    t = t + "    FS.Write(DATA + ""\STATS.TXT"", TIME.Date + "" "" + TIME.Clock.Substring(0, 5) + NL + Str(kept + gone) + NL + Str(CountMachines(out)) + NL + Str(Int((SYS.Ticks - started) / 1000)) + NL + Str(TIME.Now))" + NL
    t = t + "    Note(""Done in "" + Str(Int((SYS.Ticks - started) / 1000)) + "" seconds."")" + NL
    t = t + "    win.Status = LastCrawl()" + NL
    t = t + "    go.Enabled = TRUE" + NL
    t = t + "    timer.Interval = 5000" + NL
    t = t + "    phase = ""idle""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION CountMachines (docs AS String) AS Integer" + NL
    t = t + "    VAR seenHosts AS String = ""|""" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    FOR EACH line IN docs.Lines()" + NL
    t = t + "        IF line = """" THEN CONTINUE" + NL
    t = t + "        IF NOT seenHosts.Contains(""|"" + HostOf(line.Split(""|"")[1]) + ""|"") THEN" + NL
    t = t + "            seenHosts = seenHosts + HostOf(line.Split(""|"")[1]) + ""|""" + NL
    t = t + "            n = n + 1" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the index" + NL
    t = t + "" + NL
    t = t + "FUNCTION WordsOf (text AS String) AS Array OF String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR w AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR punct AS String" + NL
    t = t + "    t = text.Lower()" + NL
    t = t + "    punct = "".,;:!?()[]{}""""'<>/\|-_=+*&^%$#@~`"" + Chr(9) + Chr(10) + Chr(13)" + NL
    t = t + "    FOR i = 0 TO punct.Length - 1" + NL
    t = t + "        t = t.Replace(punct.CharAt(i), "" "")" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH w IN t.Split("" "")" + NL
    t = t + "        IF w.Length >= 2 AND w.Length <= 20 AND NOT STOPWORDS.Contains(""|"" + w + ""|"") THEN out.Add(w)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Bucket (word AS String) AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    c = Asc(word) - 97" + NL
    t = t + "    IF c < 0 OR c > 25 THEN RETURN 26" + NL
    t = t + "    RETURN c" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB BuildIndex ()" + NL
    t = t + "    VAR buckets AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR words AS Array OF String" + NL
    t = t + "    VAR w AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR run AS Integer" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR last AS String" + NL
    t = t + "    VAR word AS String" + NL
    t = t + "    VAR names AS String = ""ABCDEFGHIJKLMNOPQRSTUVWXYZ0""" + NL
    t = t + "    FOR i = 0 TO 26" + NL
    t = t + "        buckets.Add("""")" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH line IN ReadOr(DATA + ""\DOCS.TXT"", """").Lines()" + NL
    t = t + "        IF line = """" THEN CONTINUE" + NL
    t = t + "        id = line.Split(""|"")[0]" + NL
    t = t + "        text = ReadOr(DATA + ""\TEXT\"" + id + "".TXT"", """")" + NL
    t = t + "        IF text = """" THEN CONTINUE" + NL
    t = t + "        words = WordsOf(text)" + NL
    t = t + "        FOR EACH w IN WordsOf(text.Lines()[0])" + NL
    t = t + "            FOR k = 2 TO TITLEWEIGHT" + NL
    t = t + "                words.Add(w)" + NL
    t = t + "            NEXT" + NL
    t = t + "        NEXT" + NL
    t = t + "        words.Sort()" + NL
    t = t + "        run = 0" + NL
    t = t + "        FOR i = 0 TO words.Count - 1" + NL
    t = t + "            run = run + 1" + NL
    t = t + "            IF i = words.Count - 1 THEN" + NL
    t = t + "                buckets[Bucket(words[i])] = buckets[Bucket(words[i])] + words[i] + ""|"" + id + "":"" + Str(run) + NL" + NL
    t = t + "            ELSEIF words[i + 1] <> words[i] THEN" + NL
    t = t + "                buckets[Bucket(words[i])] = buckets[Bucket(words[i])] + words[i] + ""|"" + id + "":"" + Str(run) + NL" + NL
    t = t + "                run = 0" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        SYS.Sleep(0)" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' Each bucket: sort the postings so a word's are together, then one line per word" + NL
    t = t + "    FOR i = 0 TO 26" + NL
    t = t + "        lines = buckets[i].Lines()" + NL
    t = t + "        lines.Sort()" + NL
    t = t + "        out = """"" + NL
    t = t + "        last = """"" + NL
    t = t + "        FOR EACH line IN lines" + NL
    t = t + "            IF line = """" THEN CONTINUE" + NL
    t = t + "            word = line.Substring(0, line.IndexOf(""|""))" + NL
    t = t + "            IF word = last THEN" + NL
    t = t + "                out = out + "" "" + line.Substring(word.Length + 1, line.Length - word.Length - 1)" + NL
    t = t + "            ELSE" + NL
    t = t + "                IF last <> """" THEN out = out + NL" + NL
    t = t + "                out = out + line" + NL
    t = t + "                last = word" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        FS.Write(DATA + ""\IDX\"" + names.CharAt(i) + "".TXT"", out + NL)" + NL
    t = t + "        SYS.Sleep(0)" + NL
    t = t + "    NEXT" + NL
    t = t + "    Note(""Index built."")" + NL
    t = t + "END SUB" + NL
    Put("C:\PROGRAMS\CRAWLER.SPK")
END SUB

SUB StartService (name AS String, program AS String, runFile AS String)
    VAR task AS String
    FS.Write("C:\SYSTEM\STARTUP\" + runFile, program)
    Print("  " + name + " will start with the machine (C:\SYSTEM\STARTUP\" + runFile + ")")
    FOR EACH task IN SYS.Tasks()
        IF task.Split("|")[1].Upper() = name THEN
            SYS.Kill(Int(Val(task.Split("|")[0])))
            Print("  stopped the old " + name)
        END IF
    NEXT
    SYS.Run(program)
    Print("  started " + program)
END SUB

' HTTPD.SPK serves INDEX.ASP for a folder only when it has no INDEX.HTM, so the
' stock home page steps aside (to the first free name) instead of being deleted.
SUB MoveHomePage ()
    VAR names AS Array OF String
    VAR name AS String
    IF NOT FS.Exists("C:\WEB\INDEX.HTM") THEN RETURN
    names = ["WELCOME.HTM", "INDEX1.HTM", "INDEX2.HTM", "INDEX3.HTM", "INDEX4.HTM", "INDEX5.HTM", "INDEX6.HTM", "INDEX7.HTM", "INDEX8.HTM", "INDEX9.HTM"]
    FOR EACH name IN names
        IF NOT FS.Exists("C:\WEB\" + name) THEN
            FS.Rename("C:\WEB\INDEX.HTM", "C:\WEB\" + name)
            Print("  moved the old home page to C:\WEB\" + name)
            RETURN
        END IF
    NEXT
    THROW "C:\WEB\INDEX.HTM is in the way and there is nowhere to move it. Rename it yourself and run this again."
END SUB
