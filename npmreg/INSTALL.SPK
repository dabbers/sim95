    t = t + "|    } else if (a.substring(0, 2) === ""--"") {" + NL
    t = t + "|      const key = a.substring(2), next = args[i + 1];" + NL
    t = t + "|      if (next !== undefined && String(next).charAt(0) !== ""-"" && takesValue(key)) { set(key, next); i++; }" + NL
    t = t + "|      else set(key, strings.indexOf(key) >= 0 ? """" : true);" + NL
    t = t + "|    } else if (a.charAt(0) === ""-"" && a.length > 1 && !isNumber(a)) {" + NL
    t = t + "|      const letters = a.substring(1);" + NL
    t = t + "|      for (let j = 0; j < letters.length; j++) {" + NL
    t = t + "|        const key = letters.charAt(j), rest = letters.substring(j + 1);" + NL
    t = t + "|        if (rest !== """" && ""0123456789"".indexOf(rest.charAt(0)) >= 0) { set(key, rest); break; }" + NL
    t = t + "|        if (j === letters.length - 1) {" + NL
    t = t + "|          const next = args[i + 1];" + NL
    t = t + "|          if (next !== undefined && String(next).charAt(0) !== ""-"" && takesValue(key)) { set(key, next); i++; }" + NL
    t = t + "|          else set(key, strings.indexOf(key) >= 0 ? """" : true);" + NL
    t = t + "|        } else set(key, true);" + NL
    t = t + "|      }" + NL
    t = t + "|    } else {" + NL
    t = t + "|      argv._.push(isNumber(a) && strings.indexOf(""_"") < 0 ? Number(a) : a);" + NL
    t = t + "|    }" + NL
    t = t + "|    i++;" + NL
    t = t + "|  }" + NL
    t = t + "|  for (const k of Object.keys(opts.default || {})) if (argv[k] === undefined) set(k, opts.default[k]);" + NL
    t = t + "|  return argv;" + NL
    t = t + "|};" + NL
    t = t + "@@F PACKAGE.JSN 1 9" + NL
    t = t + "|{" + NL
    t = t + "|  ""name"": ""minimist""," + NL
    t = t + "|  ""version"": ""1.2.8""," + NL
    t = t + "|  ""description"": ""Parse command-line arguments: --name=value, -abc, --no-color, and the rest in _.""," + NL
    t = t + "|  ""main"": ""INDEX.JS""," + NL
    t = t + "|  ""keywords"": [""argv"", ""arguments"", ""options"", ""parser"", ""command"", ""cli""]," + NL
    t = t + "|  ""author"": ""sim95""," + NL
    t = t + "|  ""license"": ""MIT""" + NL
    t = t + "|}" + NL
    t = t + "@@F README.MD 1 11" + NL
    t = t + "|# minimist" + NL
    t = t + "|" + NL
    t = t + "|Parse command-line arguments." + NL
    t = t + "|" + NL
    t = t + "|```" + NL
    t = t + "|const argv = require('minimist')(process.argv.slice(2));" + NL
    t = t + "|// node app.js file.txt -x 3 -y 4 --name=beep --no-color -abc" + NL
    t = t + "|// { _: ['file.txt'], x: 3, y: 4, name: 'beep', color: false, a: true, b: true, c: true }" + NL
    t = t + "|```" + NL
    t = t + "|" + NL
    t = t + "|Options: `string`, `boolean`, `alias` and `default`, as in the original." + NL
    FS.Write("C:\NPMDATA\P\MINIMIST\V1\1.TXT", t)
    t = ""
    t = t + "# minimist" + NL
    t = t + "" + NL
    t = t + "Parse command-line arguments." + NL
    t = t + "" + NL
    t = t + "```" + NL
    t = t + "const argv = require('minimist')(process.argv.slice(2));" + NL
    t = t + "// node app.js file.txt -x 3 -y 4 --name=beep --no-color -abc" + NL
    t = t + "// { _: ['file.txt'], x: 3, y: 4, name: 'beep', color: false, a: true, b: true, c: true }" + NL
    t = t + "```" + NL
    t = t + "" + NL
    t = t + "Options: `string`, `boolean`, `alias` and `default`, as in the original." + NL
    FS.Write("C:\NPMDATA\P\MINIMIST\V1\README.TXT", t)
    FS.Write("C:\NPMDATA\P\MINIMIST\VERSIONS.TXT", "1.2.8|V1|1|3471|9227f4f6|" + Str(TIME.Now) + "|" + TIME.Date + "|sim95|" + NL)
    FS.Write("C:\NPMDATA\P\MINIMIST\NEXT.TXT", "2")
    FS.Append("C:\NPMDATA\PACKAGES.TXT", "minimist|1.2.8|Parse command-line arguments: --name=value, -abc, --no-color, and the rest in _.|sim95|" + Str(TIME.Now) + "|" + TIME.Date + "|argv arguments options parser command cli" + NL)
    Print("  npm: minimist@1.2.8")
END SUB

SUB NpmSeed5 ()
    IF NOT NpmFresh("ms") THEN RETURN
    t = ""
    t = t + "NPMPACK 1" + NL
    t = t + "@@F INDEX.JS 1 46" + NL
    t = t + "|// ms(""2 days"") -> 172800000; ms(60000) -> ""1m""; ms(60000, {long: true}) -> ""1 minute""" + NL
    t = t + "|const S = 1000, M = S * 60, H = M * 60, D = H * 24, W = D * 7, Y = D * 365.25;" + NL
    t = t + "|const UNITS = {" + NL
    t = t + "|  years: Y, year: Y, yrs: Y, yr: Y, y: Y, weeks: W, week: W, w: W, days: D, day: D, d: D," + NL
    t = t + "|  hours: H, hour: H, hrs: H, hr: H, h: H, minutes: M, minute: M, mins: M, min: M, m: M," + NL
    t = t + "|  seconds: S, second: S, secs: S, sec: S, s: S, milliseconds: 1, millisecond: 1, msecs: 1, msec: 1, ms: 1," + NL
    t = t + "|};" + NL
    t = t + "|" + NL
    t = t + "|function parse(str) {" + NL
    t = t + "|  str = String(str).trim().toLowerCase();" + NL
    t = t + "|  if (str.length === 0 || str.length > 100) return undefined;" + NL
    t = t + "|  let i = 0;" + NL
    t = t + "|  if (str.charAt(0) === ""-"" || str.charAt(0) === ""+"") i = 1;" + NL
    t = t + "|  while (i < str.length && (""0123456789."".indexOf(str.charAt(i)) >= 0)) i++;" + NL
    t = t + "|  const num = parseFloat(str.substring(0, i));" + NL
    t = t + "|  if (isNaN(num)) return undefined;" + NL
    t = t + "|  const unit = str.substring(i).trim() || ""ms"";" + NL
    t = t + "|  if (UNITS[unit] === undefined) return undefined;" + NL
    t = t + "|  return num * UNITS[unit];" + NL
    t = t + "|}" + NL
    t = t + "|" + NL
    t = t + "|function plural(ms, abs, n, name) {" + NL
    t = t + "|  return Math.round(ms / n) + "" "" + name + (abs >= n * 1.5 ? ""s"" : """");" + NL
    t = t + "|}" + NL
    t = t + "|" + NL
    t = t + "|function format(ms, long) {" + NL
    t = t + "|  const abs = Math.abs(ms);" + NL
    t = t + "|  if (long) {" + NL
    t = t + "|    if (abs >= D) return plural(ms, abs, D, ""day"");" + NL
    t = t + "|    if (abs >= H) return plural(ms, abs, H, ""hour"");" + NL
    t = t + "|    if (abs >= M) return plural(ms, abs, M, ""minute"");" + NL
    t = t + "|    if (abs >= S) return plural(ms, abs, S, ""second"");" + NL
    t = t + "|    return ms + "" ms"";" + NL
    t = t + "|  }" + NL
    t = t + "|  if (abs >= D) return Math.round(ms / D) + ""d"";" + NL
    t = t + "|  if (abs >= H) return Math.round(ms / H) + ""h"";" + NL
    t = t + "|  if (abs >= M) return Math.round(ms / M) + ""m"";" + NL
    t = t + "|  if (abs >= S) return Math.round(ms / S) + ""s"";" + NL
    t = t + "|  return ms + ""ms"";" + NL
    t = t + "|}" + NL
    t = t + "|" + NL
    t = t + "|module.exports = function ms(val, options) {" + NL
    t = t + "|  if (typeof val === ""string"" && val.length > 0) return parse(val);" + NL
    t = t + "|  if (typeof val === ""number"" && isFinite(val)) return format(val, options && options.long);" + NL
    t = t + "|  throw new Error(""val is not a non-empty string or a valid number. val="" + JSON.stringify(val));" + NL
    t = t + "|};" + NL
    t = t + "@@F PACKAGE.JSN 1 9" + NL
    t = t + "|{" + NL
    t = t + "|  ""name"": ""ms""," + NL
    t = t + "|  ""version"": ""2.1.3""," + NL
    t = t + "|  ""description"": ""Times as text and back: ms('2 days') is 172800000, ms(60000) is '1m'.""," + NL
    t = t + "|  ""main"": ""INDEX.JS""," + NL
    t = t + "|  ""keywords"": [""ms"", ""time"", ""milliseconds"", ""duration"", ""parse"", ""format""]," + NL
    t = t + "|  ""author"": ""sim95""," + NL
    t = t + "|  ""license"": ""MIT""" + NL
    t = t + "|}" + NL
    t = t + "@@F README.MD 1 12" + NL
    t = t + "|# ms" + NL
    t = t + "|" + NL
    t = t + "|Turn times into milliseconds, and milliseconds into times." + NL
    t = t + "|" + NL
    t = t + "|```" + NL
    t = t + "|const ms = require('ms');" + NL
    t = t + "|ms('2 days')                // 172800000" + NL
    t = t + "|ms('1.5h')                  // 5400000" + NL
    t = t + "|ms(60000)                   // '1m'" + NL
    t = t + "|ms(2 * 60000, { long: true })  // '2 minutes'" + NL
    t = t + "|setTimeout(done, ms('10s'));" + NL
    t = t + "|```" + NL
    FS.Write("C:\NPMDATA\P\MS\V1\1.TXT", t)
    t = ""
    t = t + "# ms" + NL
    t = t + "" + NL
    t = t + "Turn times into milliseconds, and milliseconds into times." + NL
    t = t + "" + NL
    t = t + "```" + NL
    t = t + "const ms = require('ms');" + NL
    t = t + "ms('2 days')                // 172800000" + NL
    t = t + "ms('1.5h')                  // 5400000" + NL
    t = t + "ms(60000)                   // '1m'" + NL
    t = t + "ms(2 * 60000, { long: true })  // '2 minutes'" + NL
    t = t + "setTimeout(done, ms('10s'));" + NL
    t = t + "```" + NL
    FS.Write("C:\NPMDATA\P\MS\V1\README.TXT", t)
    FS.Write("C:\NPMDATA\P\MS\VERSIONS.TXT", "2.1.3|V1|1|2606|1cb1e5df|" + Str(TIME.Now) + "|" + TIME.Date + "|sim95|" + NL)
    FS.Write("C:\NPMDATA\P\MS\NEXT.TXT", "2")
    FS.Append("C:\NPMDATA\PACKAGES.TXT", "ms|2.1.3|Times as text and back: ms('2 days') is 172800000, ms(60000) is '1m'.|sim95|" + Str(TIME.Now) + "|" + TIME.Date + "|ms time milliseconds duration parse format" + NL)
    Print("  npm: ms@2.1.3")
END SUB

SUB NpmSeed6 ()
    IF NOT NpmFresh("uuid") THEN RETURN
    t = ""
    t = t + "NPMPACK 1" + NL
    t = t + "@@F INDEX.JS 1 22" + NL
    t = t + "|// v4(): a random UUID; validate(s): is s one?" + NL
    t = t + "|const HEX = ""0123456789abcdef"";" + NL
    t = t + "|function v4() {" + NL
    t = t + "|  const pattern = ""xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx"";" + NL
    t = t + "|  let out = """";" + NL
    t = t + "|  for (let i = 0; i < pattern.length; i++) {" + NL
    t = t + "|    const c = pattern.charAt(i);" + NL
    t = t + "|    const r = Math.floor(Math.random() * 16);" + NL
    t = t + "|    out += c === ""x"" ? HEX.charAt(r) : c === ""y"" ? HEX.charAt(8 + (r % 4)) : c;" + NL
    t = t + "|  }" + NL
    t = t + "|  return out;" + NL
    t = t + "|}" + NL
    t = t + "|function validate(s) {" + NL
    t = t + "|  if (typeof s !== ""string"" || s.length !== 36) return false;" + NL
    t = t + "|  for (let i = 0; i < 36; i++) {" + NL
    t = t + "|    const c = s.charAt(i).toLowerCase();" + NL
    t = t + "|    if (i === 8 || i === 13 || i === 18 || i === 23) { if (c !== ""-"") return false; }" + NL
    t = t + "|    else if (HEX.indexOf(c) < 0) return false;" + NL
    t = t + "|  }" + NL
    t = t + "|  return true;" + NL
    t = t + "|}" + NL
    t = t + "|module.exports = { v4, validate, NIL: ""00000000-0000-0000-0000-000000000000"" };" + NL
    t = t + "@@F PACKAGE.JSN 1 9" + NL
    t = t + "|{" + NL
    t = t + "|  ""name"": ""uuid""," + NL
    t = t + "|  ""version"": ""9.0.0""," + NL
    t = t + "|  ""description"": ""Random IDs: uuid.v4() is like 1b9d6bcd-bbfd-4b2d-9b5d-ab8dfbbd4bed.""," + NL
    t = t + "|  ""main"": ""INDEX.JS""," + NL
    t = t + "|  ""keywords"": [""uuid"", ""guid"", ""id"", ""random"", ""unique""]," + NL
    t = t + "|  ""author"": ""sim95""," + NL
    t = t + "|  ""license"": ""MIT""" + NL
    t = t + "|}" + NL
    t = t + "@@F README.MD 1 9" + NL
    t = t + "|# uuid" + NL
    t = t + "|" + NL
    t = t + "|Random unique IDs." + NL
    t = t + "|" + NL
    t = t + "|```" + NL
    t = t + "|const { v4: uuidv4 } = require('uuid');" + NL
    t = t + "|uuidv4();                  // '9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d'" + NL
    t = t + "|require('uuid').validate('not one');   // false" + NL
    t = t + "|```" + NL
    FS.Write("C:\NPMDATA\P\UUID\V1\1.TXT", t)
    t = ""
    t = t + "# uuid" + NL
    t = t + "" + NL
    t = t + "Random unique IDs." + NL
    t = t + "" + NL
    t = t + "```" + NL
    t = t + "const { v4: uuidv4 } = require('uuid');" + NL
    t = t + "uuidv4();                  // '9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d'" + NL
    t = t + "require('uuid').validate('not one');   // false" + NL
    t = t + "```" + NL
    FS.Write("C:\NPMDATA\P\UUID\V1\README.TXT", t)
    FS.Write("C:\NPMDATA\P\UUID\VERSIONS.TXT", "9.0.0|V1|1|1337|24d4a7d2|" + Str(TIME.Now) + "|" + TIME.Date + "|sim95|" + NL)
    FS.Write("C:\NPMDATA\P\UUID\NEXT.TXT", "2")
    FS.Append("C:\NPMDATA\PACKAGES.TXT", "uuid|9.0.0|Random IDs: uuid.v4() is like 1b9d6bcd-bbfd-4b2d-9b5d-ab8dfbbd4bed.|sim95|" + Str(TIME.Now) + "|" + TIME.Date + "|uuid guid id random unique" + NL)
    Print("  npm: uuid@9.0.0")
END SUB

SUB NpmSeed7 ()
    IF NOT NpmFresh("wrap") THEN RETURN
    t = ""
    t = t + "NPMPACK 1" + NL
    t = t + "@@F INDEX.JS 1 18" + NL
    t = t + "|// wrap(text, width): an array of lines, none longer than width (unless one word is)" + NL
    t = t + "|function wrap(text, width) {" + NL
    t = t + "|  width = width || 40;" + NL
    t = t + "|  const lines = [];" + NL
    t = t + "|  for (const para of String(text).split(""\n"")) {" + NL
    t = t + "|    let line = """";" + NL
    t = t + "|    for (const word of para.split("" "")) {" + NL
    t = t + "|      if (word === """") continue;" + NL
    t = t + "|      if (line === """") line = word;" + NL
    t = t + "|      else if (line.length + 1 + word.length <= width) line += "" "" + word;" + NL
    t = t + "|      else { lines.push(line); line = word; }" + NL
    t = t + "|    }" + NL
    t = t + "|    lines.push(line);" + NL
    t = t + "|  }" + NL
    t = t + "|  return lines;" + NL
    t = t + "|}" + NL
    t = t + "|module.exports = wrap;" + NL
    t = t + "|module.exports.text = (text, width) => wrap(text, width).join(""\n"");" + NL
    t = t + "@@F PACKAGE.JSN 1 9" + NL
    t = t + "|{" + NL
    t = t + "|  ""name"": ""wrap""," + NL
    t = t + "|  ""version"": ""1.0.0""," + NL
    t = t + "|  ""description"": ""Word-wrap text to a width, at the spaces.""," + NL
    t = t + "|  ""main"": ""INDEX.JS""," + NL
    t = t + "|  ""keywords"": [""wrap"", ""text"", ""word"", ""lines""]," + NL
    t = t + "|  ""author"": ""sim95""," + NL
    t = t + "|  ""license"": ""MIT""" + NL
    t = t + "|}" + NL
    t = t + "@@F README.MD 1 10" + NL
    t = t + "|# wrap" + NL
    t = t + "|" + NL
    t = t + "|Word-wrap text at the spaces." + NL
    t = t + "|" + NL
    t = t + "|```" + NL
    t = t + "|const wrap = require('wrap');" + NL
    t = t + "|wrap('the quick brown fox jumps over the lazy dog', 15);" + NL
    t = t + "|// [ 'the quick brown', 'fox jumps over', 'the lazy dog' ]" + NL
    t = t + "|wrap.text('...', 15);    // the same, joined with line breaks" + NL
    t = t + "|```" + NL
    FS.Write("C:\NPMDATA\P\WRAP\V1\1.TXT", t)
    t = ""
    t = t + "# wrap" + NL
    t = t + "" + NL
    t = t + "Word-wrap text at the spaces." + NL
    t = t + "" + NL
    t = t + "```" + NL
    t = t + "const wrap = require('wrap');" + NL
    t = t + "wrap('the quick brown fox jumps over the lazy dog', 15);" + NL
    t = t + "// [ 'the quick brown', 'fox jumps over', 'the lazy dog' ]" + NL
    t = t + "wrap.text('...', 15);    // the same, joined with line breaks" + NL
    t = t + "```" + NL
    FS.Write("C:\NPMDATA\P\WRAP\V1\README.TXT", t)
    FS.Write("C:\NPMDATA\P\WRAP\VERSIONS.TXT", "1.0.0|V1|1|1175|44a20670|" + Str(TIME.Now) + "|" + TIME.Date + "|sim95|" + NL)
    FS.Write("C:\NPMDATA\P\WRAP\NEXT.TXT", "2")
    FS.Append("C:\NPMDATA\PACKAGES.TXT", "wrap|1.0.0|Word-wrap text to a width, at the spaces.|sim95|" + Str(TIME.Now) + "|" + TIME.Date + "|wrap text word lines" + NL)
    Print("  npm: wrap@1.0.0")
END SUB
