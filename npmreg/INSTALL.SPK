    t = t + "|}" + NL
    t = t + "|" + NL
    t = t + "|module.exports = function minimist(args, opts) {" + NL
    t = t + "|  opts = opts || {};" + NL
    t = t + "|  const strings = [].concat(opts.string || []), bools = [].concat(opts.boolean || []);" + NL
    t = t + "|  const alias = {};" + NL
    t = t + "|  for (const k of Object.keys(opts.alias || {})) {" + NL
    t = t + "|    const names = [].concat(opts.alias[k]);" + NL
