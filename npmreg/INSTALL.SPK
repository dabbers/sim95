SUB NpmSeed1 ()
    IF NOT NpmFresh("express") THEN RETURN
    t = ""
    t = t + "NPMPACK 1" + NL
    t = t + "@@F INDEX.JS 1 152" + NL
    t = t + "|// express for SIM95: app.get/post/put/delete/all/use, routes with :params," + NL
    t = t + "|// req.query/params/body, res.send/json/status/set/redirect/sendFile, and the" + NL
    t = t + "|// static, json and urlencoded middleware. app.listen(port) serves it with http." + NL
    t = t + "|const http = require(""http"");" + NL
    t = t + "|const fs = require(""fs"");" + NL
    t = t + "|const qs = require(""querystring"");" + NL
    t = t + "|" + NL
    t = t + "|const TYPES = { HTM: ""text/html"", HTML: ""text/html"", TXT: ""text/plain"", JS: ""application/javascript"", CSS: ""text/css"", JSN: ""application/json"", JSON: ""application/json"", SPK: ""text/plain"", ASP: ""text/plain"", MD: ""text/plain"", PIC: ""image/x-sim95-pic"" };" + NL
    t = t + "|" + NL
    t = t + "|// ""/users/:id"" against ""/users/7"" -> {id: ""7""}, or null; prefix: ""/api"" matches ""/api/x"" too" + NL
    t = t + "|function match(pattern, path, prefix) {" + NL
    t = t + "|  if (pattern === ""*"" || pattern === ""/*"") return {};" + NL
    t = t + "|  const want = pattern.split(""/"").filter((x) => x !== """"), got = path.split(""/"").filter((x) => x !== """");" + NL
    t = t + "|  if (prefix ? got.length < want.length : got.length !== want.length) return null;" + NL
    t = t + "|  const params = {};" + NL
    t = t + "|  for (let i = 0; i < want.length; i++) {" + NL
    t = t + "|    const w = want[i];" + NL
    t = t + "|    if (w.charAt(0) === "":"") params[w.substring(1)] = decodeURIComponent(got[i]);" + NL
    t = t + "|    else if (w !== ""*"" && w.toLowerCase() !== got[i].toLowerCase()) return null;" + NL
    t = t + "|  }" + NL
    t = t + "|  return params;" + NL
    t = t + "|}" + NL
    t = t + "|" + NL
    t = t + "|function enhance(req, res, app) {" + NL
    t = t + "|  const u = req.url.indexOf(""?"");" + NL
    t = t + "|  req.path = u < 0 ? req.url : req.url.substring(0, u);" + NL
    t = t + "|  req.query = qs.parse(u < 0 ? """" : req.url.substring(u + 1));" + NL
    t = t + "|  req.params = {};" + NL
    t = t + "|  req.app = app;" + NL
    t = t + "|  req.get = req.header = (k) => req.headers[String(k).toLowerCase()];" + NL
    t = t + "|  req.ip = req.socket && req.socket.remoteAddress;" + NL
    t = t + "|  res.locals = {};" + NL
    t = t + "|  res.status = (code) => { res.statusCode = code; return res; };" + NL
    t = t + "|  res.set = res.header = (k, v) => { if (typeof k === ""object"") Object.keys(k).forEach((x) => res.setHeader(x, k[x])); else res.setHeader(k, v); return res; };" + NL
    t = t + "|  res.get = (k) => res.getHeader(k);" + NL
    t = t + "|  res.type = (t) => { res.setHeader(""Content-Type"", t.indexOf(""/"") >= 0 ? t : TYPES[t.toUpperCase()] || ""text/plain""); return res; };" + NL
    t = t + "|  res.send = (body) => {" + NL
    t = t + "|    if (body === undefined || body === null) body = """";" + NL
    t = t + "|    if (typeof body === ""number"") { res.statusCode = body; body = http.STATUS_CODES[body] || String(body); }" + NL
    t = t + "|    if (typeof body === ""object"") return res.json(body);" + NL
    t = t + "|    if (!res.getHeader(""Content-Type"")) res.setHeader(""Content-Type"", ""text/html"");" + NL
    t = t + "|    res.end(String(body));" + NL
    t = t + "|    return res;" + NL
    t = t + "|  };" + NL
    t = t + "|  res.json = (obj) => { res.setHeader(""Content-Type"", ""application/json""); res.end(JSON.stringify(obj)); return res; };" + NL
    t = t + "|  res.sendStatus = (code) => { res.statusCode = code; return res.type(""txt"").send(http.STATUS_CODES[code] || String(code)); };" + NL
    t = t + "|  res.redirect = (a, b) => { const code = typeof a === ""number"" ? a : 302, to = typeof a === ""number"" ? b : a; res.statusCode = code; res.setHeader(""Location"", to); res.end(""Redirecting to "" + to); return res; };" + NL
    t = t + "|  res.sendFile = (file) => {" + NL
    t = t + "|    if (!fs.existsSync(file) || fs.statSync(file).isDirectory()) { res.status(404).type(""txt"").send(""Not Found""); return res; }" + NL
    t = t + "|    const ext = file.substring(file.lastIndexOf(""."") + 1).toUpperCase();" + NL
    t = t + "|    res.setHeader(""Content-Type"", TYPES[ext] || ""text/plain"");" + NL
    t = t + "|    res.end(fs.readFileSync(file));" + NL
    t = t + "|    return res;" + NL
    t = t + "|  };" + NL
    t = t + "|}" + NL
    t = t + "|" + NL
    t = t + "|function createApplication() {" + NL
    t = t + "|  const stack = [];   // {method, path, prefix, fn}" + NL
    t = t + "|  const settings = {};" + NL
    t = t + "|  const app = function (req, res) { app.handle(req, res); };" + NL
    t = t + "|  const add = (method, prefix) => function (path) {" + NL
    t = t + "|    let fns = Array.prototype.slice.call(arguments, 1);" + NL
    t = t + "|    if (typeof path === ""function"") { fns = Array.prototype.slice.call(arguments); path = ""/""; }" + NL
    t = t + "|    fns = [].concat.apply([], fns);" + NL
    t = t + "|    if (method === ""GET"" && fns.length === 0) return settings[path];" + NL
    t = t + "|    for (const fn of fns) stack.push({ method, path, prefix, fn });" + NL
    t = t + "|    return app;" + NL
    t = t + "|  };" + NL
    t = t + "|  app.use = add(null, true);" + NL
    t = t + "|  app.all = add(null, false);" + NL
    t = t + "|  app.get = add(""GET"", false);" + NL
    t = t + "|  app.post = add(""POST"", false);" + NL
    t = t + "|  app.put = add(""PUT"", false);" + NL
    t = t + "|  app.delete = add(""DELETE"", false);" + NL
    t = t + "|  app.set = (k, v) => { settings[k] = v; return app; };" + NL
    t = t + "|  app.locals = {};" + NL
    t = t + "|  app.handle = (req, res) => {" + NL
    t = t + "|    enhance(req, res, app);" + NL
    t = t + "|    let i = 0, inside = false, again = false;" + NL
    t = t + "|    const finalErr = (err) => {" + NL
    t = t + "|      if (res.finished) return;" + NL
    t = t + "|      res.statusCode = err.status || 500;" + NL
    t = t + "|      res.setHeader(""Content-Type"", ""text/html"");" + NL
    t = t + "|      res.end(""<pre>"" + (err.stack || err.message || String(err)) + ""</pre>"");" + NL
    t = t + "|    };" + NL
    t = t + "|    const next = (err) => {" + NL
    t = t + "|      if (err && err !== ""route"") { finalErr(err); return; }" + NL
    t = t + "|      // called while a handler runs: carry on from the loop, not deeper" + NL
    t = t + "|      if (inside) { again = true; return; }" + NL
    t = t + "|      run();" + NL
    t = t + "|    };" + NL
    t = t + "|    const run = () => {" + NL
    t = t + "|      do {" + NL
    t = t + "|        again = false;" + NL
    t = t + "|        let layer = null, params = null;" + NL
    t = t + "|        while (i < stack.length) {" + NL
    t = t + "|          const l = stack[i++];" + NL
    t = t + "|          if (l.method && l.method !== req.method && !(l.method === ""GET"" && req.method === ""HEAD"")) continue;" + NL
    t = t + "|          params = match(l.path, req.path, l.prefix);" + NL
    t = t + "|          if (params) { layer = l; break; }" + NL
    t = t + "|        }" + NL
    t = t + "|        if (!layer) {" + NL
    t = t + "|          if (!res.finished) res.status(404).type(""html"").send(""<pre>Cannot "" + req.method + "" "" + req.path + ""</pre>"");" + NL
    t = t + "|          return;" + NL
    t = t + "|        }" + NL
    t = t + "|        req.params = params;" + NL
    t = t + "|        inside = true;" + NL
    t = t + "|        try { layer.fn(req, res, next); } catch (e) { inside = false; finalErr(e); return; }" + NL
    t = t + "|        inside = false;" + NL
    t = t + "|      } while (again);" + NL
    t = t + "|    };" + NL
    t = t + "|    run();" + NL
    t = t + "|  };" + NL
    t = t + "|  app.listen = function () {" + NL
    t = t + "|    const server = http.createServer(app);" + NL
    t = t + "|    return server.listen.apply(server, arguments);" + NL
    t = t + "|  };" + NL
    t = t + "|  return app;" + NL
    t = t + "|}" + NL
    t = t + "|" + NL
    t = t + "|function readBody(req, done) {" + NL
    t = t + "|  if (req._gotBody) { done(req._gotBody); return; }" + NL
    t = t + "|  let text = """";" + NL
    t = t + "|  req.on(""data"", (d) => (text += d));" + NL
    t = t + "|  req.on(""end"", () => { req._gotBody = text; done(text); });" + NL
    t = t + "|}" + NL
    t = t + "|" + NL
    t = t + "|createApplication.static = (dir) => (req, res, next) => {" + NL
    t = t + "|  if (req.method !== ""GET"" && req.method !== ""HEAD"") { next(); return; }" + NL
    t = t + "|  let rel = decodeURIComponent(req.path).split(""/"").filter((x) => x !== """" && x !== "".."").join(""\\"");" + NL
    t = t + "|  let file = dir + (rel ? ""\\"" + rel : """");" + NL
    t = t + "|  if (fs.existsSync(file) && fs.statSync(file).isDirectory()) file += ""\\INDEX.HTM"";" + NL
    t = t + "|  if (!fs.existsSync(file)) { next(); return; }" + NL
    t = t + "|  res.sendFile(file);" + NL
    t = t + "|};" + NL
    t = t + "|createApplication.json = () => (req, res, next) => {" + NL
    t = t + "|  if ((req.headers[""content-type""] || """").indexOf(""json"") < 0) { req.body = req.body || {}; next(); return; }" + NL
    t = t + "|  readBody(req, (t) => { try { req.body = t ? JSON.parse(t) : {}; next(); } catch (e) { res.status(400).send(""Bad JSON: "" + e.message); } });" + NL
    t = t + "|};" + NL
    t = t + "|createApplication.urlencoded = () => (req, res, next) => {" + NL
    t = t + "|  if ((req.headers[""content-type""] || """").indexOf(""urlencoded"") < 0) { req.body = req.body || {}; next(); return; }" + NL
    t = t + "|  readBody(req, (t) => { req.body = qs.parse(t); next(); });" + NL
    t = t + "|};" + NL
    t = t + "|createApplication.text = () => (req, res, next) => { readBody(req, (t) => { req.body = t; next(); }); };" + NL
    t = t + "|createApplication.Router = () => {" + NL
    t = t + "|  const r = createApplication();" + NL
    t = t + "|  const router = function (req, res, next) { r.handle(req, res); };" + NL
    t = t + "|  [""use"", ""get"", ""post"", ""put"", ""delete"", ""all""].forEach((m) => { router[m] = function () { r[m].apply(r, arguments); return router; }; });" + NL
    t = t + "|  return router;" + NL
    t = t + "|};" + NL
    t = t + "|" + NL
    t = t + "|module.exports = createApplication;" + NL
    t = t + "@@F PACKAGE.JSN 1 9" + NL
    t = t + "|{" + NL
    t = t + "|  ""name"": ""express""," + NL
    t = t + "|  ""version"": ""4.18.2""," + NL
    t = t + "|  ""description"": ""Web servers the easy way: routes with :params, middleware, static files, JSON.""," + NL
    t = t + "|  ""main"": ""INDEX.JS""," + NL
    t = t + "|  ""keywords"": [""express"", ""web"", ""http"", ""server"", ""framework"", ""router"", ""app""]," + NL
    t = t + "|  ""author"": ""sim95""," + NL
    t = t + "|  ""license"": ""MIT""" + NL
    t = t + "|}" + NL
    t = t + "@@F README.MD 1 25" + NL
    t = t + "|# express" + NL
    t = t + "|" + NL
    t = t + "|Web servers the easy way, on Node for SIM95." + NL
    t = t + "|" + NL
    t = t + "|```" + NL
    t = t + "|const express = require('express');" + NL
    t = t + "|const app = express();" + NL
    t = t + "|" + NL
    t = t + "|app.use(express.urlencoded());" + NL
    t = t + "|app.use(express.static('C:\\MYFILES\\PUBLIC'));" + NL
    t = t + "|" + NL
    t = t + "|app.get('/', (req, res) => res.send('<h1>Hello from SIM95</h1>'));" + NL
    t = t + "|app.get('/hello/:name', (req, res) => res.send('Hello, ' + req.params.name));" + NL
    t = t + "|app.get('/api/time', (req, res) => res.json({ now: Date.now() }));" + NL
    t = t + "|app.post('/guestbook', (req, res) => res.redirect('/'));" + NL
    t = t + "|" + NL
    t = t + "|app.listen(8080, () => console.log('Open http://' + require('os').hostname() + ':8080/ in Voyager'));" + NL
    t = t + "|```" + NL
    t = t + "|" + NL
    t = t + "|- Routes: `app.get post put delete all`, with `:params`, and `app.use` for middleware (`next()` to go on)." + NL
    t = t + "|- `req.path query params body ip get()`" + NL
    t = t + "|- `res.send json status set type redirect sendFile sendStatus`" + NL
    t = t + "|- Middleware: `express.static(folder)`, `express.json()`, `express.urlencoded()`, `express.text()`" + NL
    t = t + "|" + NL
    t = t + "|Voyager talks HTTP/1.0 to port 80 unless the address says another, like `http://alpha:8080/`." + NL
    FS.Write("C:\NPMDATA\P\EXPRESS\V1\1.TXT", t)
    t = ""
    t = t + "# express" + NL
    t = t + "" + NL
    t = t + "Web servers the easy way, on Node for SIM95." + NL
    t = t + "" + NL
    t = t + "```" + NL
