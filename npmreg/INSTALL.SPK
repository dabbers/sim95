' INSTALL.SPK - puts the npm registry on this machine. Generated by tools/build-installer.mjs;
' edit the files in npmreg/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5 - on the central
' host, STARTHERE.56K.NET. It puts the npm registry in C:\WEB\NPM:
' http://starthere.56k.net/npm/, where npm (it comes with Node) finds, installs and
' publishes packages. Packages and accounts are kept in C:\NPMDATA and left
' alone, so running this again upgrades the pages; the first time, it stocks
' the registry with a few packages (leftpad, cowsay, express, lodash...). On
' any other machine it asks first: a second registry would split the packages.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)
    ' Always in a folder of its own, whatever the machine.
    intoDir = "NPM"
    IF NOT FS.Exists("C:\WEB\" + intoDir) THEN FS.MakeDir("C:\WEB\" + intoDir)


    IF NOT NpmHere() THEN RETURN
    NpmSetup()
    File0()
    File1()
    File2()
    File3()
    Print("the npm registry is installed (4 files).")

    ' how it shows on the SimHost front page, which lists every folder with one of these
    IF intoDir <> "" THEN FS.Write("C:\WEB\" + intoDir + "\APP.INF", "the npm registry|JavaScript packages for Node: search them, npm install them, publish your own.|#CB3837")
    IF intoDir = "" THEN
        Print("Open http://" + NET.HostName.Lower() + "/ in Voyager.")
    ELSE
        Print("Open http://" + NET.HostName.Lower() + "/" + intoDir.Lower() + "/ in Voyager.")
    END IF
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "<%@ import file=""REG.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' API.ASP?do=... - what npm talks to. Answers are plain text: JSON for info" + NL
    t = t + "' and search, a part as it is, and for the rest ""OK ..."" or ""ERR why"" on the" + NL
    t = t + "' first line." + NL
    t = t + "'   GET  info&p=name               the package and its versions (JSON)" + NL
    t = t + "'   GET  search&q=words            [{name, version, description, owner, ...}]" + NL
    t = t + "'   GET  part&p=name&v=1.0.0&n=1   one part of a version's bundle" + NL
    t = t + "'   POST adduser  (form: u, pw, email)   makes the account, or logs in to it:" + NL
    t = t + "'                                  OK <token>" + NL
    t = t + "'   GET  whoami&u=&t=              OK <name>" + NL
    t = t + "'   POST begin&u=&t=&p=&v=&parts=&bytes=&sum=&deps=&desc=&kw=" + NL
    t = t + "'                                  (the body: the README)  OK <ticket>" + NL
    t = t + "'   POST put&k=ticket&n=1          (the body: the part)    OK" + NL
    t = t + "'   POST finish&k=ticket           OK name@version" + NL
    t = t + "'   POST unpublish&u=&t=&p=&v=     OK" + NL
    t = t + "VAR act AS String" + NL
    t = t + "VAR p AS String" + NL
    t = t + "VAR v AS String" + NL
    t = t + "VAR u AS String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR lines AS Array OF String" + NL
    t = t + "VAR out AS Array OF String" + NL
    t = t + "VAR k AS Integer" + NL
    t = t + "VAR n AS Integer" + NL
    t = t + "VAR f AS String" + NL
    t = t + "VAR text AS String" + NL
    t = t + "VAR info AS String" + NL
    t = t + "VAR dir AS String" + NL
    t = t + "VAR vdir AS String" + NL
    t = t + "VAR total AS Integer" + NL
    t = t + "VAR parts AS Integer" + NL
    t = t + "VAR desc AS String" + NL
    t = t + "" + NL
    t = t + "RESPONSE.Clear()" + NL
    t = t + "RESPONSE.ContentType = ""text/plain""" + NL
    t = t + "act = REQUEST.Query(""do"")" + NL
    t = t + "p = REQUEST.Query(""p"").Lower().Trim()" + NL
    t = t + "v = REQUEST.Query(""v"").Trim()" + NL
    t = t + "MakeDirs()" + NL
    t = t + "" + NL
    t = t + "SELECT CASE act" + NL
    t = t + "CASE ""info""" + NL
    t = t + "    line = PkgLine(p)" + NL
    t = t + "    IF line = """" THEN" + NL
    t = t + "        RESPONSE.Status = ""404 Not Found""" + NL
    t = t + "        RESPONSE.Write(""{"" + Js(""error"") + "":"" + Js(""Not found: "" + p) + ""}"")" + NL
    t = t + "        RESPONSE.End()" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH f IN Versions(p)" + NL
    t = t + "        out.Add(Js(Field(f, 0)) + "":{"" + Js(""parts"") + "":"" + Field(f, 2) + "","" + Js(""bytes"") + "":"" + Field(f, 3) + "","" + Js(""sum"") + "":"" + Js(Field(f, 4)) + "","" + Js(""time"") + "":"" + Field(f, 5) + "","" + Js(""date"") + "":"" + Js(Field(f, 6)) + "","" + Js(""publisher"") + "":"" + Js(Field(f, 7)) + "","" + Js(""dependencies"") + "":"" + DepsJson(Field(f, 8)) + ""}"")" + NL
    t = t + "    NEXT" + NL
    t = t + "    RESPONSE.Write(""{"" + Js(""name"") + "":"" + Js(p) + "","" + Js(""description"") + "":"" + Js(Field(line, 2)) + "","" + Js(""dist-tags"") + "":{"" + Js(""latest"") + "":"" + Js(Field(line, 1)) + ""},"" + Js(""owner"") + "":"" + Js(Field(line, 3)) + "","" + Js(""time"") + "":"" + Field(line, 4) + "","" + Js(""keywords"") + "":"" + Js(Field(line, 6)) + "","" + Js(""downloads"") + "":"" + Str(Downloads(p)) + "","" + Js(""versions"") + "":{"" + out.Join("","") + ""}}"")" + NL
    t = t + "" + NL
    t = t + "CASE ""search""" + NL
    t = t + "    FOR EACH line IN Search(REQUEST.Query(""q""))" + NL
    t = t + "        out.Add(""{"" + Js(""name"") + "":"" + Js(Field(line, 0)) + "","" + Js(""version"") + "":"" + Js(Field(line, 1)) + "","" + Js(""description"") + "":"" + Js(Field(line, 2)) + "","" + Js(""owner"") + "":"" + Js(Field(line, 3)) + "","" + Js(""date"") + "":"" + Js(Field(line, 5)) + "","" + Js(""keywords"") + "":"" + Js(Field(line, 6)) + ""}"")" + NL
    t = t + "        IF out.Count >= 50 THEN BREAK" + NL
    t = t + "    NEXT" + NL
    t = t + "    RESPONSE.Write(""["" + out.Join("","" + Chr(10)) + ""]"")" + NL
    t = t + "" + NL
    t = t + "CASE ""part""" + NL
    t = t + "    line = VersionLine(p, v)" + NL
    t = t + "    n = Num(REQUEST.Query(""n""), 1, MAXPARTS, 0)" + NL
    t = t + "    IF line = """" OR n = 0 OR NOT GoodName(p) THEN" + NL
    t = t + "        RESPONSE.Status = ""404 Not Found""" + NL
    t = t + "        RESPONSE.Write(""ERR There is no "" + p + ""@"" + v + "" here."")" + NL
    t = t + "        RESPONSE.End()" + NL
    t = t + "    END IF" + NL
    t = t + "    f = PkgDir(p) + ""\"" + Field(line, 1) + ""\"" + Str(n) + "".TXT""" + NL
    t = t + "    IF NOT FS.Exists(f) THEN" + NL
    t = t + "        RESPONSE.Status = ""404 Not Found""" + NL
    t = t + "        RESPONSE.Write(""ERR "" + p + ""@"" + v + "" has no part "" + Str(n) + ""."")" + NL
    t = t + "        RESPONSE.End()" + NL
    t = t + "    END IF" + NL
    t = t + "    IF n = 1 THEN FS.Write(PkgDir(p) + ""\DL.TXT"", Str(Downloads(p) + 1))" + NL
    t = t + "    RESPONSE.Write(FS.Read(f))" + NL
    t = t + "" + NL
    t = t + "CASE ""adduser""" + NL
    t = t + "    u = REQUEST.Form(""u"").Lower().Trim()" + NL
    t = t + "    IF NOT GoodUser(u) THEN" + NL
    t = t + "        RESPONSE.Write(""ERR A user name is 1 to "" + Str(USERMAX) + "" letters, digits, - and _."")" + NL
    t = t + "        RESPONSE.End()" + NL
    t = t + "    END IF" + NL
    t = t + "    IF REQUEST.Form(""pw"").Length < 4 THEN" + NL
    t = t + "        RESPONSE.Write(""ERR A password needs at least 4 characters."")" + NL
    t = t + "        RESPONSE.End()" + NL
    t = t + "    END IF" + NL
    t = t + "    line = UserLine(u)" + NL
    t = t + "    IF line <> """" THEN" + NL
    t = t + "        IF Sum(Field(line, 2) + REQUEST.Form(""pw"")) <> Field(line, 1) THEN" + NL
    t = t + "            RESPONSE.Write(""ERR That isn't "" + u + ""'s password. (The name is taken: to make a new account, choose another.)"")" + NL
    t = t + "            RESPONSE.End()" + NL
    t = t + "        END IF" + NL
    t = t + "        RESPONSE.Write(""OK "" + Field(line, 3) + Chr(10) + ""Logged in as "" + u + ""."")" + NL
    t = t + "        RESPONSE.End()" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT TakeLock() THEN" + NL
    t = t + "        RESPONSE.Write(""ERR The registry is busy: try again."")" + NL
    t = t + "        RESPONSE.End()" + NL
    t = t + "    END IF" + NL
    t = t + "    f = Fresh()" + NL
    t = t + "    info = Fresh()" + NL
    t = t + "    FS.Append(DATADIR + ""\USERS.TXT"", u + ""|"" + Sum(f + REQUEST.Form(""pw"")) + ""|"" + f + ""|"" + info + ""|"" + REQUEST.Form(""email"").Replace(""|"", """").Trim() + ""|"" + Str(TIME.Now) + Chr(10))" + NL
    t = t + "    DropLock()" + NL
    t = t + "    RESPONSE.Write(""OK "" + info + Chr(10) + ""Welcome, "" + u + ""! Your account is made."")" + NL
    t = t + "" + NL
    t = t + "CASE ""whoami""" + NL
    t = t + "    u = Who(REQUEST.Query(""u"").Lower(), REQUEST.Query(""t""))" + NL
    t = t + "    IF u = """" THEN" + NL
    t = t + "        RESPONSE.Write(""ERR Not logged in."")" + NL
    t = t + "    ELSE" + NL
    t = t + "        RESPONSE.Write(""OK "" + u)" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "CASE ""begin""" + NL
    t = t + "    u = Who(REQUEST.Query(""u"").Lower(), REQUEST.Query(""t""))" + NL
    t = t + "    parts = Num(REQUEST.Query(""parts""), 1, MAXPARTS, 0)" + NL
    t = t + "    total = Num(REQUEST.Query(""bytes""), 1, PARTMAX * MAXPARTS, 0)" + NL
    t = t + "    IF u = """" THEN" + NL
    t = t + "        RESPONSE.Write(""ERR You need to log in first: npm adduser"")" + NL
    t = t + "    ELSEIF NOT GoodName(p) THEN" + NL
    t = t + "        RESPONSE.Write(""ERR "" + Chr(34) + p + Chr(34) + "" can't be a package name: 1 to 8 of a-z, 0-9, - and _ (it is a folder name on every machine)."")" + NL
    t = t + "    ELSEIF NOT GoodVersion(v) THEN" + NL
    t = t + "        RESPONSE.Write(""ERR "" + Chr(34) + v + Chr(34) + "" isn't a version like 1.0.0."")" + NL
    t = t + "    ELSEIF parts = 0 OR total = 0 THEN" + NL
    t = t + "        RESPONSE.Write(""ERR A package is 1 to "" + Str(MAXPARTS) + "" parts, about "" + Str(PARTMAX * MAXPARTS / 1000) + "" KB at most."")" + NL
    t = t + "    ELSEIF PkgLine(p) <> """" AND Field(PkgLine(p), 3) <> u THEN" + NL
    t = t + "        RESPONSE.Write(""ERR "" + p + "" belongs to "" + Field(PkgLine(p), 3) + "": you can't publish it. Pick another name."")" + NL
    t = t + "    ELSEIF VersionLine(p, v) <> """" THEN" + NL
    t = t + "        RESPONSE.Write(""ERR "" + p + ""@"" + v + "" is published already: change the version (npm version patch) and publish that."")" + NL
    t = t + "    ELSE" + NL
    t = t + "        ' clear away publishes that never finished" + NL
    t = t + "        FOR EACH f IN FS.List(DATADIR + ""\UP"")" + NL
    t = t + "            IF NOT f.EndsWith(""\"") THEN CONTINUE" + NL
    t = t + "            dir = DATADIR + ""\UP\"" + f.Substring(0, f.Length - 1)" + NL
    t = t + "            IF TIME.Now - Int(Val(Field(ReadOr(dir + ""\INFO.TXT"", ""0""), 0))) > STALE THEN Wipe(dir)" + NL
    t = t + "        NEXT" + NL
    t = t + "        k = 0" + NL
    t = t + "        f = """"" + NL
    t = t + "        WHILE f = """" OR FS.Exists(DATADIR + ""\UP\"" + f)" + NL
    t = t + "            f = Fresh().Substring(0, 8).Upper()" + NL
    t = t + "            k = k + 1" + NL
    t = t + "            IF k > 20 THEN BREAK" + NL
    t = t + "        END WHILE" + NL
    t = t + "        dir = DATADIR + ""\UP\"" + f" + NL
    t = t + "        FS.MakeDir(dir)" + NL
    t = t + "        desc = REQUEST.Query(""desc"").Replace(""|"", ""/"").Replace(Chr(10), "" "").Replace(Chr(13), """")" + NL
    t = t + "        IF desc.Length > 200 THEN desc = desc.Substring(0, 200)" + NL
    t = t + "        FS.Write(dir + ""\INFO.TXT"", Str(TIME.Now) + ""|"" + u + ""|"" + p + ""|"" + v + ""|"" + Str(parts) + ""|"" + Str(total) + ""|"" + REQUEST.Query(""sum"").Replace(""|"", """") + ""|"" + REQUEST.Query(""deps"").Replace(""|"", """") + ""|"" + desc + ""|"" + REQUEST.Query(""kw"").Replace(""|"", "" "").Lower())" + NL
    t = t + "        FS.Write(dir + ""\README.TXT"", REQUEST.Body)" + NL
    t = t + "        RESPONSE.Write(""OK "" + f)" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "CASE ""put"", ""finish""" + NL
    t = t + "    f = REQUEST.Query(""k"").Upper()" + NL
    t = t + "    dir = DATADIR + ""\UP\"" + f" + NL
    t = t + "    IF f.Length <> 8 OR NOT Only(f, ""0123456789ABCDEF"") OR NOT FS.Exists(dir + ""\INFO.TXT"") THEN" + NL
    t = t + "        RESPONSE.Write(""ERR That publish isn't going on (it may have taken too long): publish again."")" + NL
    t = t + "        RESPONSE.End()" + NL
    t = t + "    END IF" + NL
    t = t + "    info = FS.Read(dir + ""\INFO.TXT"")" + NL
    t = t + "    parts = Int(Val(Field(info, 4)))" + NL
    t = t + "    IF act = ""put"" THEN" + NL
    t = t + "        n = Num(REQUEST.Query(""n""), 1, parts, 0)" + NL
    t = t + "        text = REQUEST.Body" + NL
    t = t + "        IF n = 0 THEN" + NL
    t = t + "            RESPONSE.Write(""ERR There's no part "" + REQUEST.Query(""n"") + "" in this publish."")" + NL
    t = t + "        ELSEIF text.Length > PARTMAX THEN" + NL
    t = t + "            RESPONSE.Write(""ERR A part can be "" + Str(PARTMAX) + "" characters at most."")" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Write(dir + ""\"" + Str(n) + "".TXT"", text)" + NL
    t = t + "            RESPONSE.Write(""OK"")" + NL
    t = t + "        END IF" + NL
    t = t + "        RESPONSE.End()" + NL
    t = t + "    END IF" + NL
    t = t + "    ' finish: every part here, and all of it" + NL
    t = t + "    FOR k = 1 TO parts" + NL
    t = t + "        IF NOT FS.Exists(dir + ""\"" + Str(k) + "".TXT"") THEN" + NL
    t = t + "            RESPONSE.Write(""ERR Part "" + Str(k) + "" of "" + Str(parts) + "" never arrived: publish again."")" + NL
    t = t + "            RESPONSE.End()" + NL
    t = t + "        END IF" + NL
    t = t + "        total = total + FS.Read(dir + ""\"" + Str(k) + "".TXT"").Length" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF total <> Int(Val(Field(info, 5))) THEN" + NL
    t = t + "        Wipe(dir)" + NL
    t = t + "        RESPONSE.Write(""ERR The package arrived damaged ("" + Str(total) + "" of "" + Field(info, 5) + "" characters): publish again."")" + NL
    t = t + "        RESPONSE.End()" + NL
    t = t + "    END IF" + NL
    t = t + "    u = Field(info, 1)" + NL
    t = t + "    p = Field(info, 2)" + NL
    t = t + "    v = Field(info, 3)" + NL
    t = t + "    IF NOT TakeLock() THEN" + NL
    t = t + "        RESPONSE.Write(""ERR The registry is busy: try npm publish again."")" + NL
    t = t + "        RESPONSE.End()" + NL
    t = t + "    END IF" + NL
    t = t + "    line = PkgLine(p)" + NL
    t = t + "    IF line <> """" AND Field(line, 3) <> u THEN" + NL
    t = t + "        DropLock()" + NL
    t = t + "        Wipe(dir)" + NL
    t = t + "        RESPONSE.Write(""ERR "" + p + "" belongs to "" + Field(line, 3) + ""."")" + NL
    t = t + "        RESPONSE.End()" + NL
    t = t + "    END IF" + NL
    t = t + "    IF VersionLine(p, v) <> """" THEN" + NL
    t = t + "        DropLock()" + NL
    t = t + "        Wipe(dir)" + NL
    t = t + "        RESPONSE.Write(""ERR "" + p + ""@"" + v + "" is published already."")" + NL
    t = t + "        RESPONSE.End()" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT FS.Exists(PkgDir(p)) THEN FS.MakeDir(PkgDir(p))" + NL
    t = t + "    n = Num(ReadOr(PkgDir(p) + ""\NEXT.TXT"", ""1""), 1, 999999, 1)" + NL
    t = t + "    FS.Write(PkgDir(p) + ""\NEXT.TXT"", Str(n + 1))" + NL
    t = t + "    vdir = PkgDir(p) + ""\V"" + Str(n)" + NL
    t = t + "    IF FS.Exists(vdir) THEN Wipe(vdir)" + NL
    t = t + "    FS.MakeDir(vdir)" + NL
    t = t + "    FOR k = 1 TO parts" + NL
    t = t + "        FS.Write(vdir + ""\"" + Str(k) + "".TXT"", FS.Read(dir + ""\"" + Str(k) + "".TXT""))" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Write(vdir + ""\README.TXT"", ReadOr(dir + ""\README.TXT"", """"))" + NL
    t = t + "    FS.Append(PkgDir(p) + ""\VERSIONS.TXT"", v + ""|V"" + Str(n) + ""|"" + Str(parts) + ""|"" + Str(total) + ""|"" + Field(info, 6) + ""|"" + Str(TIME.Now) + ""|"" + TIME.Date + ""|"" + u + ""|"" + Field(info, 7) + Chr(10))" + NL
    t = t + "    f = Latest(Versions(p))" + NL
    t = t + "    desc = Field(line, 2)" + NL
    t = t + "    text = Field(line, 6)" + NL
    t = t + "    IF f = v OR line = """" THEN" + NL
    t = t + "        desc = Field(info, 8)" + NL
    t = t + "        text = Field(info, 9)" + NL
    t = t + "    END IF" + NL
    t = t + "    SetPkgLine(p, p + ""|"" + f + ""|"" + desc + ""|"" + u + ""|"" + Str(TIME.Now) + ""|"" + TIME.Date + ""|"" + text)" + NL
    t = t + "    DropLock()" + NL
    t = t + "    Wipe(dir)" + NL
    t = t + "    RESPONSE.Write(""OK "" + p + ""@"" + v)" + NL
    t = t + "" + NL
    t = t + "CASE ""unpublish""" + NL
    t = t + "    u = Who(REQUEST.Query(""u"").Lower(), REQUEST.Query(""t""))" + NL
    t = t + "    line = PkgLine(p)" + NL
    t = t + "    IF u = """" THEN" + NL
    t = t + "        RESPONSE.Write(""ERR You need to log in first: npm adduser"")" + NL
    t = t + "    ELSEIF line = """" OR VersionLine(p, v) = """" THEN" + NL
    t = t + "        RESPONSE.Write(""ERR There is no "" + p + ""@"" + v + "" here."")" + NL
    t = t + "    ELSEIF Field(line, 3) <> u THEN" + NL
    t = t + "        RESPONSE.Write(""ERR "" + p + "" belongs to "" + Field(line, 3) + ""."")" + NL
    t = t + "    ELSEIF NOT TakeLock() THEN" + NL
    t = t + "        RESPONSE.Write(""ERR The registry is busy: try again."")" + NL
    t = t + "    ELSE" + NL
    t = t + "        FOR EACH f IN Versions(p)" + NL
    t = t + "            IF Field(f, 0) = v THEN" + NL
    t = t + "                Wipe(PkgDir(p) + ""\"" + Field(f, 1))" + NL
    t = t + "            ELSE" + NL
    t = t + "                out.Add(f)" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF out.Count = 0 THEN" + NL
    t = t + "            Wipe(PkgDir(p))" + NL
    t = t + "            SetPkgLine(p, """")" + NL
    t = t + "            RESPONSE.Write(""OK "" + p + "" is gone: that was its last version."")" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Write(PkgDir(p) + ""\VERSIONS.TXT"", out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "            SetPkgLine(p, p + ""|"" + Latest(out) + ""|"" + Field(line, 2) + ""|"" + u + ""|"" + Str(TIME.Now) + ""|"" + TIME.Date + ""|"" + Field(line, 6))" + NL
    t = t + "            RESPONSE.Write(""OK "" + p + ""@"" + v + "" is unpublished."")" + NL
    t = t + "        END IF" + NL
    t = t + "        DropLock()" + NL
    t = t + "    END IF" + NL
    t = t + "" + NL
    t = t + "CASE ELSE" + NL
    t = t + "    IF act = """" THEN" + NL
    t = t + "        RESPONSE.Write(""This is the npm registry's API. npm talks to it; people want index.asp."")" + NL
    t = t + "    ELSE" + NL
    t = t + "        RESPONSE.Write(""ERR Unknown: "" + act)" + NL
    t = t + "    END IF" + NL
    t = t + "END SELECT" + NL
    t = t + "' (and nothing after: the line break that ends this file would go out too)" + NL
    t = t + "RESPONSE.End()" + NL
    t = t + "%>" + NL
    Put("C:\WEB\API.ASP")
END SUB

SUB File1 ()
    t = ""
    t = t + "<%@ import file=""REG.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' INDEX.ASP - the npm registry's front page (http://<machine>/npm/):" + NL
    t = t + "'   ?q=words   search" + NL
    t = t + "'   ?u=name    one person's packages" + NL
    t = t + "' and with neither, the newest packages and how to start." + NL
    t = t + "VAR q AS String" + NL
    t = t + "VAR byUser AS String" + NL
    t = t + "VAR found AS Array OF String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR rows AS String" + NL
    t = t + "VAR shown AS Integer" + NL
    t = t + "VAR heading AS String" + NL
    t = t + "VAR all AS Array OF String" + NL
    t = t + "MakeDirs()" + NL
    t = t + "q = REQUEST.Query(""q"").Trim()" + NL
    t = t + "byUser = REQUEST.Query(""u"").Lower().Trim()" + NL
    t = t + "all = Packages()" + NL
    t = t + "IF byUser <> """" THEN" + NL
    t = t + "    FOR EACH line IN Newest(all)" + NL
    t = t + "        IF Field(line, 3) = byUser THEN found.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    heading = ""Packages by "" + byUser" + NL
    t = t + "ELSEIF q <> """" THEN" + NL
    t = t + "    found = Search(q)" + NL
    t = t + "    heading = Str(found.Count) + "" packages found for "" + Chr(34) + q + Chr(34)" + NL
    t = t + "    IF found.Count = 1 THEN heading = ""1 package found for "" + Chr(34) + q + Chr(34)" + NL
    t = t + "ELSE" + NL
    t = t + "    found = Newest(all)" + NL
    t = t + "    heading = ""Recently updated""" + NL
    t = t + "END IF" + NL
    t = t + "FOR EACH line IN found" + NL
    t = t + "    shown = shown + 1" + NL
    t = t + "    IF shown > 40 THEN BREAK" + NL
    t = t + "    rows = rows + ""<tr><td bgcolor=""""#FFFFFF""""><a href=""""pkg.asp?p="" + Field(line, 0) + """"""><b>"" + Field(line, 0) + ""</b></a> <font size=""""2"""" color=""""#666666"""">"" + SERVER.HtmlEncode(Field(line, 1)) + ""</font><br><font size=""""2"""">"" + SERVER.HtmlEncode(Field(line, 2)) + ""</font>""" + NL
    t = t + "    IF Field(line, 6).Trim() <> """" THEN rows = rows + ""<br><font size=""""1"""" color=""""#666666"""">"" + SERVER.HtmlEncode(Field(line, 6)) + ""</font>""" + NL
    t = t + "    rows = rows + ""</td><td bgcolor=""""#FFFFFF"""" align=""""right"""" valign=""""top"""" width=""""150""""><font size=""""2""""><a href=""""index.asp?u="" + Field(line, 3) + """""">"" + Field(line, 3) + ""</a><br><font color=""""#666666"""">"" + Ago(Int(Val(Field(line, 4)))) + ""</font></font></td></tr>"" + Chr(10)" + NL
    t = t + "NEXT" + NL
    t = t + "%><html><head><title>npm - the SIM95 package registry</title>" + NL
    t = t + "<meta name=""description"" content=""npm for SIM95: JavaScript packages for Node on SIM95. Search, install with npm install, and publish your own."">" + NL
    t = t + "<meta name=""keywords"" content=""npm, node, node.js, javascript, packages, modules, registry, library, libraries, require, install, publish, code, programming"">" + NL
    t = t + "</head>" + NL
    t = t + "<body bgcolor=""#F2F2F2"" text=""#333333"" link=""#CB3837"" vlink=""#8A2522"">" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td bgcolor=""#CB3837"">" + NL
    t = t + "<a href=""index.asp""><font size=""6"" color=""#FFFFFF""><b>npm</b></font></a> <font color=""#FFFFFF"">the package registry on <%= SERVER.Name.Lower() %></font></td>" + NL
    t = t + "<td bgcolor=""#CB3837"" align=""right""><font size=""2"" color=""#FFFFFF""><%= all.Count %> package<% IF all.Count <> 1 THEN %>s<% END IF %> &middot; <%= UserCount() %> <% IF UserCount() = 1 THEN %>person<% ELSE %>people<% END IF %></font></td></tr></table>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td bgcolor=""#FFFFFF"">" + NL
    t = t + "<form action=""index.asp"" method=""get""><input type=""text"" name=""q"" size=""40"" value=""<%= SERVER.HtmlEncode(q) %>""> <input type=""submit"" value=""Search packages""></form>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "" + NL
    t = t + "<% IF q = """" AND byUser = """" THEN %>" + NL
    t = t + "<table width=""100%"" cellpadding=""10"" cellspacing=""0""><tr><td bgcolor=""#FFF7E6"">" + NL
    t = t + "<font size=""4""><b>JavaScript packages for Node on SIM95</b></font>" + NL
    t = t + "<p>npm comes with Node: install <b>Node.js for SIM95</b> from Vapor (or <tt>sim-get install node</tt> in Sim Shell). Then, in Sim Shell:</p>" + NL
    t = t + "<pre>npm init -y                 a PACKAGE.JSN for your project" + NL
    t = t + "npm install leftpad         a package, into NODE_MOD (and your PACKAGE.JSN)" + NL
    t = t + "npm install                 everything your PACKAGE.JSN lists" + NL
    t = t + "npm search color            find packages" + NL
    t = t + "npm adduser                 make an account here (or log in to yours)" + NL
    t = t + "npm publish                 share the package in this folder" + NL
    t = t + "npm install -g cowsay       a package with a command, for the whole machine</pre>" + NL
    t = t + "<p><font size=""2"">Package names are 8.3 folder names: 1 to 8 of a-z, 0-9, - and _. Then <tt>require('leftpad')</tt> finds <tt>NODE_MOD\LEFTPAD</tt>.</font></p>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "" + NL
    t = t + "<h3><%= SERVER.HtmlEncode(heading) %></h3>" + NL
    t = t + "<% IF rows = """" THEN %>" + NL
    t = t + "<p><font color=""#666666""><% IF all.Count = 0 THEN %>Nothing has been published yet. Be the first: <tt>npm adduser</tt>, then <tt>npm publish</tt> in your package's folder.<% ELSE %>No packages match.<% END IF %></font></p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""2""><%= rows %></table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<p><font size=""1"" color=""#666666"">npm for SIM95. Packages are whatever people publish: read before you run.</font></p>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\INDEX.ASP")
END SUB

SUB File2 ()
    t = ""
    t = t + "<%@ import file=""REG.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' PKG.ASP?p=name[&v=version] - one package: how to install it, its README," + NL
    t = t + "' its versions, what it needs and what needs it." + NL
    t = t + "VAR p AS String" + NL
    t = t + "VAR v AS String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR vline AS String" + NL
    t = t + "VAR vers AS Array OF String" + NL
    t = t + "VAR f AS String" + NL
    t = t + "VAR d AS String" + NL
    t = t + "VAR rows AS String" + NL
    t = t + "VAR deps AS String" + NL
    t = t + "VAR users AS String" + NL
    t = t + "VAR readme AS String" + NL
    t = t + "VAR k AS Integer" + NL
    t = t + "p = REQUEST.Query(""p"").Lower().Trim()" + NL
    t = t + "v = REQUEST.Query(""v"").Trim()" + NL
    t = t + "MakeDirs()" + NL
    t = t + "line = PkgLine(p)" + NL
    t = t + "IF line <> """" THEN" + NL
    t = t + "    IF v = """" THEN v = Field(line, 1)" + NL
    t = t + "    vline = VersionLine(p, v)" + NL
    t = t + "    IF vline = """" THEN" + NL
    t = t + "        v = Field(line, 1)" + NL
    t = t + "        vline = VersionLine(p, v)" + NL
    t = t + "    END IF" + NL
    t = t + "    readme = ReadOr(PkgDir(p) + ""\"" + Field(vline, 1) + ""\README.TXT"", """")" + NL
    t = t + "    vers = Versions(p)" + NL
    t = t + "    FOR k = vers.Count - 1 TO 0 STEP -1" + NL
    t = t + "        f = vers[k]" + NL
    t = t + "        rows = rows + ""<tr><td bgcolor=""""#FFFFFF""""><a href=""""pkg.asp?p="" + p + ""&v="" + Field(f, 0) + """""">"" + Field(f, 0) + ""</a>""" + NL
    t = t + "        IF Field(f, 0) = Field(line, 1) THEN rows = rows + "" <font size=""""1"""" color=""""#CB3837"""">latest</font>""" + NL
    t = t + "        rows = rows + ""</td><td bgcolor=""""#FFFFFF""""><font size=""""2"""">"" + Field(f, 6) + ""</font></td><td bgcolor=""""#FFFFFF""""><font size=""""2"""">"" + Size(Int(Val(Field(f, 3)))) + ""</font></td><td bgcolor=""""#FFFFFF""""><font size=""""2"""">"" + Field(f, 7) + ""</font></td></tr>"" + Chr(10)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH d IN Field(vline, 8).Split("";"")" + NL
    t = t + "        IF NOT d.Contains(""="") THEN CONTINUE" + NL
    t = t + "        f = d.Substring(0, d.IndexOf(""=""))" + NL
    t = t + "        deps = deps + ""<li><a href=""""pkg.asp?p="" + f + """""">"" + f + ""</a> <font size=""""2"""" color=""""#666666"""">"" + SERVER.HtmlEncode(d.Substring(d.IndexOf(""="") + 1, d.Length - d.IndexOf(""="") - 1)) + ""</font></li>""" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH f IN Dependents(p)" + NL
    t = t + "        users = users + ""<a href=""""pkg.asp?p="" + f + """""">"" + f + ""</a> """ + NL
    t = t + "    NEXT" + NL
    t = t + "END IF" + NL
    t = t + "%><html><head><title><% IF line = """" THEN %>Not found<% ELSE %><%= p %><% END IF %> - npm</title></head>" + NL
    t = t + "<body bgcolor=""#F2F2F2"" text=""#333333"" link=""#CB3837"" vlink=""#8A2522"">" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td bgcolor=""#CB3837"">" + NL
    t = t + "<a href=""index.asp""><font size=""6"" color=""#FFFFFF""><b>npm</b></font></a> <font color=""#FFFFFF"">the package registry on <%= SERVER.Name.Lower() %></font></td>" + NL
    t = t + "<td bgcolor=""#CB3837"" align=""right""><form action=""index.asp"" method=""get""><input type=""text"" name=""q"" size=""20""> <input type=""submit"" value=""Search""></form></td></tr></table>" + NL
    t = t + "<% IF line = """" THEN %>" + NL
    t = t + "<h2>There's no package called <%= SERVER.HtmlEncode(p) %></h2>" + NL
    t = t + "<p>Nobody has published one yet. <a href=""index.asp?q=<%= SERVER.UrlEncode(p) %>"">Search for it</a>, or publish it yourself: <tt>npm init</tt> with that name, then <tt>npm publish</tt>.</p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<table width=""100%"" cellpadding=""10"" cellspacing=""0""><tr><td bgcolor=""#FFFFFF"" valign=""top"">" + NL
    t = t + "<font size=""6""><b><%= p %></b></font> <font color=""#666666""><%= v %><% IF v <> Field(line, 1) THEN %> (the latest is <a href=""pkg.asp?p=<%= p %>""><%= Field(line, 1) %></a>)<% END IF %></font>" + NL
    t = t + "<p><%= SERVER.HtmlEncode(Field(line, 2)) %></p>" + NL
    t = t + "<table cellpadding=""6""><tr><td bgcolor=""#000000""><font color=""#A4D007""><tt>npm install <%= p %><% IF v <> Field(line, 1) THEN %>@<%= v %><% END IF %></tt></font></td></tr></table>" + NL
    t = t + "<hr>" + NL
    t = t + "<% IF readme.Trim() = """" THEN %><p><font color=""#666666"">This package has no README.</font></p><% ELSE %><%= Markdown(readme) %><% END IF %>" + NL
    t = t + "</td><td bgcolor=""#FFFFFF"" valign=""top"" width=""200""><font size=""2"">" + NL
    t = t + "<b>Version</b><br><%= v %><br><br>" + NL
    t = t + "<b>Published</b><br><%= Field(vline, 6) %> by <a href=""index.asp?u=<%= Field(vline, 7) %>""><%= Field(vline, 7) %></a><br><br>" + NL
    t = t + "<b>Owner</b><br><a href=""index.asp?u=<%= Field(line, 3) %>""><%= Field(line, 3) %></a><br><br>" + NL
    t = t + "<b>Size</b><br><%= Size(Int(Val(Field(vline, 3)))) %> in <%= Field(vline, 2) %> part<% IF Field(vline, 2) <> ""1"" THEN %>s<% END IF %><br><br>" + NL
    t = t + "<b>Downloads</b><br><%= Downloads(p) %><br><br>" + NL
    t = t + "<% IF Field(line, 6).Trim() <> """" THEN %><b>Keywords</b><br><%= SERVER.HtmlEncode(Field(line, 6)) %><br><br><% END IF %>" + NL
    t = t + "<b>Dependencies</b><br><% IF deps = """" THEN %>none<% ELSE %><ul><%= deps %></ul><% END IF %><br>" + NL
    t = t + "<b>Used by</b><br><% IF users = """" THEN %>nothing yet<% ELSE %><%= users %><% END IF %>" + NL
    t = t + "</font></td></tr></table>" + NL
    t = t + "<h3>Versions</h3>" + NL
    t = t + "<table cellpadding=""6"" cellspacing=""2""><tr><td><b>Version</b></td><td><b>Published</b></td><td><b>Size</b></td><td><b>By</b></td></tr>" + NL
    t = t + "<%= rows %></table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\PKG.ASP")
END SUB

SUB File3 ()
    t = ""
    t = t + "' REG.SPK - the npm registry's library, shared by its pages (INDEX.ASP," + NL
    t = t + "' PKG.ASP and API.ASP, the one npm talks to)." + NL
    t = t + "'" + NL
    t = t + "' Everything is kept in C:\NPMDATA, out of the web server's reach:" + NL
    t = t + "'   USERS.TXT     name|password hash|salt|token|email|joined (seconds)" + NL
    t = t + "'   PACKAGES.TXT  name|latest|description|owner|updated (seconds)|date|keywords" + NL
    t = t + "'   P\<NAME>\     one folder for each package (names are 8.3 folder names)" + NL
    t = t + "'     VERSIONS.TXT  version|folder|parts|bytes|sum|when (seconds)|date|publisher|deps" + NL
    t = t + "'                   deps is name=range;name=range" + NL
    t = t + "'     NEXT.TXT      the number of the next version's folder (V1, V2...)" + NL
    t = t + "'     DL.TXT        how many times it has been downloaded" + NL
    t = t + "'     V<n>\         a version: its parts (1.TXT, 2.TXT...) and README.TXT" + NL
    t = t + "'   UP\<ticket>\  a publish on its way: INFO.TXT, README.TXT and the parts" + NL
    t = t + "'" + NL
    t = t + "' A package is a bundle (npm makes it): a text file holding every file in the" + NL
    t = t + "' package, cut into parts of whole lines that each fit in a network message," + NL
    t = t + "' as Vapor cuts its installers. npm sends the parts one at a time, and fetches" + NL
    t = t + "' them the same way; it checks the sum, so the registry needn't read them." + NL
    t = t + "" + NL
    t = t + "CONST DATADIR = ""C:\NPMDATA""" + NL
    t = t + "CONST PARTMAX = 40000           ' the most one part may hold" + NL
    t = t + "CONST MAXPARTS = 40             ' so a package is at most about 1.2 MB" + NL
    t = t + "CONST NAMEMAX = 8               ' package names are folder names" + NL
    t = t + "CONST USERMAX = 16" + NL
    t = t + "CONST STALE = 3600              ' a publish not finished within this long is cleared away" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (p AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(p) THEN RETURN FS.Read(p)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Field (line AS String, i AS Integer) AS String" + NL
    t = t + "    VAR f AS Array OF String" + NL
    t = t + "    f = line.Split(""|"")" + NL
    t = t + "    IF i < f.Count THEN RETURN f[i]" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A whole number from a query or a form, kept between lo and hi ("""" or junk: dflt)." + NL
    t = t + "FUNCTION Num (s AS String, lo AS Integer, hi AS Integer, dflt AS Integer) AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    t = s.Trim()" + NL
    t = t + "    IF t = """" OR t.Length > 9 THEN RETURN dflt" + NL
    t = t + "    FOR k = 0 TO t.Length - 1" + NL
    t = t + "        IF Asc(t.CharAt(k)) < 48 OR Asc(t.CharAt(k)) > 57 THEN RETURN dflt" + NL
    t = t + "    NEXT" + NL
    t = t + "    k = Int(Val(t))" + NL
    t = t + "    IF k < lo OR k > hi THEN RETURN dflt" + NL
    t = t + "    RETURN k" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Only these characters in s?" + NL
    t = t + "FUNCTION Only (s AS String, allowed AS String) AS Bool" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    FOR k = 0 TO s.Length - 1" + NL
    t = t + "        IF NOT allowed.Contains(s.CharAt(k)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Package names: 1 to 8 of a-z, 0-9, - and _, starting with a letter or digit," + NL
    t = t + "' since each is a folder (NODE_MOD\<NAME>) on every machine that installs it." + NL
    t = t + "FUNCTION GoodName (n AS String) AS Bool" + NL
    t = t + "    IF n.Length < 1 OR n.Length > NAMEMAX THEN RETURN FALSE" + NL
    t = t + "    IF n.StartsWith(""-"") OR n.StartsWith(""_"") THEN RETURN FALSE" + NL
    t = t + "    RETURN Only(n, ""abcdefghijklmnopqrstuvwxyz0123456789-_"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION GoodUser (n AS String) AS Bool" + NL
    t = t + "    IF n.Length < 1 OR n.Length > USERMAX THEN RETURN FALSE" + NL
    t = t + "    RETURN Only(n, ""abcdefghijklmnopqrstuvwxyz0123456789-_"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' 1.2.3, or 1.2.3-beta.1" + NL
    t = t + "FUNCTION GoodVersion (v AS String) AS Bool" + NL
    t = t + "    VAR main AS String" + NL
    t = t + "    VAR pre AS String" + NL
    t = t + "    VAR bits AS Array OF String" + NL
    t = t + "    VAR b AS String" + NL
    t = t + "    IF v.Length < 5 OR v.Length > 24 THEN RETURN FALSE" + NL
    t = t + "    main = v" + NL
    t = t + "    IF v.Contains(""-"") THEN" + NL
    t = t + "        main = v.Substring(0, v.IndexOf(""-""))" + NL
    t = t + "        pre = v.Substring(v.IndexOf(""-"") + 1, v.Length - v.IndexOf(""-"") - 1)" + NL
    t = t + "        IF pre = """" OR NOT Only(pre, ""abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-"") THEN RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    bits = main.Split(""."")" + NL
    t = t + "    IF bits.Count <> 3 THEN RETURN FALSE" + NL
    t = t + "    FOR EACH b IN bits" + NL
    t = t + "        IF b = """" OR b.Length > 6 OR NOT Only(b, ""0123456789"") THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' -1, 0 or 1, as version a comes before, is, or comes after b. A prerelease" + NL
    t = t + "' (1.0.0-beta) comes before its release." + NL
    t = t + "FUNCTION CompareVersions (a AS String, b AS String) AS Integer" + NL
    t = t + "    VAR pa AS String" + NL
    t = t + "    VAR pb AS String" + NL
    t = t + "    VAR na AS Array OF String" + NL
    t = t + "    VAR nb AS Array OF String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF a.Contains(""-"") THEN" + NL
    t = t + "        pa = a.Substring(a.IndexOf(""-"") + 1, a.Length - a.IndexOf(""-"") - 1)" + NL
    t = t + "        a = a.Substring(0, a.IndexOf(""-""))" + NL
    t = t + "    END IF" + NL
    t = t + "    IF b.Contains(""-"") THEN" + NL
    t = t + "        pb = b.Substring(b.IndexOf(""-"") + 1, b.Length - b.IndexOf(""-"") - 1)" + NL
    t = t + "        b = b.Substring(0, b.IndexOf(""-""))" + NL
    t = t + "    END IF" + NL
    t = t + "    na = a.Split(""."")" + NL
    t = t + "    nb = b.Split(""."")" + NL
    t = t + "    FOR k = 0 TO 2" + NL
    t = t + "        IF Val(na[k]) < Val(nb[k]) THEN RETURN -1" + NL
    t = t + "        IF Val(na[k]) > Val(nb[k]) THEN RETURN 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF pa = pb THEN RETURN 0" + NL
    t = t + "    IF pa = """" THEN RETURN 1" + NL
    t = t + "    IF pb = """" THEN RETURN -1" + NL
    t = t + "    IF pa < pb THEN RETURN -1" + NL
    t = t + "    RETURN 1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same sum npm works out (31 * sum + each character's code, kept to 32" + NL
    t = t + "' bits), as 8 hex digits: for passwords here." + NL
    t = t + "FUNCTION Sum (s AS String) AS String" + NL
    t = t + "    VAR h AS Real" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    FOR k = 0 TO s.Length - 1" + NL
    t = t + "        h = h * 31 + Asc(s.CharAt(k))" + NL
    t = t + "        h = h - MATH.Floor(h / 4294967296) * 4294967296" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR k = 1 TO 8" + NL
    t = t + "        d = Int(h - MATH.Floor(h / 16) * 16)" + NL
    t = t + "        out = ""0123456789abcdef"".CharAt(d) + out" + NL
    t = t + "        h = MATH.Floor(h / 16)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Fresh () AS String" + NL
    t = t + "    RETURN Sum(Str(TIME.Now) + ""|"" + Str(SYS.Ticks) + ""|"" + Str(Rnd(1000000000))) + Sum(Str(Rnd(1000000000)) + REQUEST.From)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- JSON out" + NL
    t = t + "" + NL
    t = t + "FUNCTION Js (s AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    VAR q AS String" + NL
    t = t + "    q = Chr(34)" + NL
    t = t + "    FOR k = 0 TO s.Length - 1" + NL
    t = t + "        c = s.CharAt(k)" + NL
    t = t + "        IF c = q OR c = ""\"" THEN" + NL
    t = t + "            out = out + ""\"" + c" + NL
    t = t + "        ELSEIF c = Chr(10) THEN" + NL
    t = t + "            out = out + ""\n""" + NL
    t = t + "        ELSEIF c = Chr(13) THEN" + NL
    t = t + "            out = out + ""\r""" + NL
    t = t + "        ELSEIF c = Chr(9) THEN" + NL
    t = t + "            out = out + ""\t""" + NL
    t = t + "        ELSEIF Asc(c) < 32 THEN" + NL
    t = t + "            out = out + "" """ + NL
    t = t + "        ELSE" + NL
    t = t + "            out = out + c" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN q + out + q" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""a=^1.0.0;b=2.x"" as {""a"":""^1.0.0"",""b"":""2.x""}" + NL
    t = t + "FUNCTION DepsJson (deps AS String) AS String" + NL
    t = t + "    VAR d AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    FOR EACH d IN deps.Split("";"")" + NL
    t = t + "        IF d.Contains(""="") THEN out.Add(Js(d.Substring(0, d.IndexOf(""=""))) + "":"" + Js(d.Substring(d.IndexOf(""="") + 1, d.Length - d.IndexOf(""="") - 1)))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN ""{"" + out.Join("","") + ""}""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- users" + NL
    t = t + "" + NL
    t = t + "FUNCTION UserLine (name AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\USERS.TXT"", """").Lines()" + NL
    t = t + "        IF Field(line, 0) = name AND name <> """" THEN RETURN line" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UserCount () AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\USERS.TXT"", """").Lines()" + NL
    t = t + "        IF line.Contains(""|"") THEN n = n + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The user whose token this is, or """"." + NL
    t = t + "FUNCTION Who (name AS String, token AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    line = UserLine(name)" + NL
    t = t + "    IF line = """" OR token = """" OR Field(line, 3) <> token THEN RETURN """"" + NL
    t = t + "    RETURN name" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- packages" + NL
    t = t + "" + NL
    t = t + "FUNCTION PkgDir (name AS String) AS String" + NL
    t = t + "    RETURN DATADIR + ""\P\"" + name.Upper()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Packages () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\PACKAGES.TXT"", """").Lines()" + NL
    t = t + "        IF line.Contains(""|"") THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION PkgLine (name AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN Packages()" + NL
    t = t + "        IF Field(line, 0) = name THEN RETURN line" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' In place of the package's line (a new one goes on the end; """" takes it out)." + NL
    t = t + "SUB SetPkgLine (name AS String, entry AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR found AS Bool" + NL
    t = t + "    FOR EACH line IN Packages()" + NL
    t = t + "        IF Field(line, 0) = name THEN" + NL
    t = t + "            found = TRUE" + NL
    t = t + "            IF entry <> """" THEN out.Add(entry)" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT found AND entry <> """" THEN out.Add(entry)" + NL
    t = t + "    FS.Write(DATADIR + ""\PACKAGES.TXT"", out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Versions (name AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(PkgDir(name) + ""\VERSIONS.TXT"", """").Lines()" + NL
    t = t + "        IF line.Contains(""|"") THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION VersionLine (name AS String, v AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN Versions(name)" + NL
    t = t + "        IF Field(line, 0) = v THEN RETURN line" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The highest release (or, with none, the highest of all)." + NL
    t = t + "FUNCTION Latest (lines AS Array OF String) AS String" + NL
    t = t + "    VAR best AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    FOR EACH line IN lines" + NL
    t = t + "        v = Field(line, 0)" + NL
    t = t + "        IF v.Contains(""-"") THEN CONTINUE" + NL
    t = t + "        IF best = """" THEN" + NL
    t = t + "            best = v" + NL
    t = t + "        ELSEIF CompareVersions(v, best) > 0 THEN" + NL
    t = t + "            best = v" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF best <> """" THEN RETURN best" + NL
    t = t + "    FOR EACH line IN lines" + NL
    t = t + "        v = Field(line, 0)" + NL
    t = t + "        IF best = """" THEN" + NL
    t = t + "            best = v" + NL
    t = t + "        ELSEIF CompareVersions(v, best) > 0 THEN" + NL
    t = t + "            best = v" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN best" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Downloads (name AS String) AS Integer" + NL
    t = t + "    RETURN Int(Val(ReadOr(PkgDir(name) + ""\DL.TXT"", ""0"")))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Packages, most recently updated first." + NL
    t = t + "FUNCTION Newest (lines AS Array OF String) AS Array OF String" + NL
    t = t + "    VAR keyed AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    FOR k = 0 TO lines.Count - 1" + NL
    t = t + "        keyed.Add(Str(9999999999 - Int(Val(Field(lines[k], 4)))).PadLeft(12) + ""|"" + Str(k))" + NL
    t = t + "    NEXT" + NL
    t = t + "    keyed.Sort()" + NL
    t = t + "    FOR EACH line IN keyed" + NL
    t = t + "        out.Add(lines[Int(Val(line.Substring(13, line.Length - 13)))])" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Packages that match every word of q, in the name, description, keywords" + NL
    t = t + "' or owner; the best first (a name that is q, then names with it in them)." + NL
    t = t + "FUNCTION Search (q AS String) AS Array OF String" + NL
    t = t + "    VAR words AS Array OF String" + NL
    t = t + "    VAR w AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR hay AS String" + NL
    t = t + "    VAR ok AS Bool" + NL
    t = t + "    VAR exact AS Array OF String" + NL
    t = t + "    VAR named AS Array OF String" + NL
    t = t + "    VAR rest AS Array OF String" + NL
    t = t + "    q = q.Lower().Trim()" + NL
    t = t + "    FOR EACH w IN q.Split("" "")" + NL
    t = t + "        IF w <> """" THEN words.Add(w)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH line IN Newest(Packages())" + NL
    t = t + "        hay = (Field(line, 0) + "" "" + Field(line, 2) + "" "" + Field(line, 6) + "" "" + Field(line, 3)).Lower()" + NL
    t = t + "        ok = TRUE" + NL
    t = t + "        FOR EACH w IN words" + NL
    t = t + "            IF NOT hay.Contains(w) THEN ok = FALSE" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF NOT ok THEN CONTINUE" + NL
    t = t + "        IF Field(line, 0) = q THEN" + NL
    t = t + "            exact.Add(line)" + NL
    t = t + "        ELSEIF q <> """" AND Field(line, 0).Contains(q) THEN" + NL
    t = t + "            named.Add(line)" + NL
    t = t + "        ELSE" + NL
    t = t + "            rest.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH line IN named" + NL
    t = t + "        exact.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH line IN rest" + NL
    t = t + "        exact.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN exact" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Who depends on this package (in their latest version)." + NL
    t = t + "FUNCTION Dependents (name AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    VAR d AS String" + NL
    t = t + "    FOR EACH line IN Packages()" + NL
    t = t + "        v = VersionLine(Field(line, 0), Field(line, 1))" + NL
    t = t + "        FOR EACH d IN Field(v, 8).Split("";"")" + NL
    t = t + "            IF d.StartsWith(name + ""="") THEN out.Add(Field(line, 0))" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""3 days ago""" + NL
    t = t + "FUNCTION Ago (seconds AS Integer) AS String" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    d = TIME.Now - seconds" + NL
    t = t + "    IF d < 90 THEN RETURN ""just now""" + NL
    t = t + "    IF d < 5400 THEN RETURN Str(Int(d / 60)) + "" minutes ago""" + NL
    t = t + "    IF d < 129600 THEN RETURN Str(Int(d / 3600)) + "" hours ago""" + NL
    t = t + "    RETURN Str(Int(d / 86400)) + "" days ago""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Size (bytes AS Integer) AS String" + NL
    t = t + "    IF bytes < 1024 THEN RETURN Str(bytes) + "" B""" + NL
    t = t + "    RETURN Str(Int(bytes * 10 / 1024) / 10) + "" KB""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the lock" + NL
    t = t + "" + NL
    t = t + "' Two publishes may arrive at once, and each rewrites PACKAGES.TXT. The lock" + NL
    t = t + "' is a folder (FS.MakeDir fails when it's there); one left by a page that" + NL
    t = t + "' died is cleared after a few seconds." + NL
    t = t + "FUNCTION TakeLock () AS Bool" + NL
    t = t + "    VAR tries AS Integer" + NL
    t = t + "    VAR at AS String" + NL
    t = t + "    WHILE tries < 100" + NL
    t = t + "        tries = tries + 1" + NL
    t = t + "        TRY" + NL
    t = t + "            FS.MakeDir(DATADIR + ""\LOCK"")" + NL
    t = t + "            FS.Write(DATADIR + ""\LOCK\AT.TXT"", Str(TIME.Now))" + NL
    t = t + "            RETURN TRUE" + NL
    t = t + "        CATCH err" + NL
    t = t + "            at = ReadOr(DATADIR + ""\LOCK\AT.TXT"", """")" + NL
    t = t + "            IF (at <> """" AND TIME.Now - Int(Val(at)) > 5) OR (at = """" AND tries MOD 25 = 0) THEN" + NL
    t = t + "                DropLock()" + NL
    t = t + "            ELSE" + NL
    t = t + "                SYS.Sleep(10)" + NL
    t = t + "            END IF" + NL
    t = t + "        END TRY" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB DropLock ()" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(DATADIR + ""\LOCK\AT.TXT"") THEN FS.Delete(DATADIR + ""\LOCK\AT.TXT"")" + NL
    t = t + "        IF FS.Exists(DATADIR + ""\LOCK"") THEN FS.Delete(DATADIR + ""\LOCK"")" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A folder and everything in it." + NL
    t = t + "SUB Wipe (dir AS String)" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    IF NOT FS.Exists(dir) THEN RETURN" + NL
    t = t + "    FOR EACH f IN FS.List(dir)" + NL
    t = t + "        IF f.EndsWith(""\"") THEN" + NL
    t = t + "            Wipe(dir + ""\"" + f.Substring(0, f.Length - 1))" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Delete(dir + ""\"" + f)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Delete(dir)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MakeDirs ()" + NL
    t = t + "    IF NOT FS.Exists(DATADIR) THEN FS.MakeDir(DATADIR)" + NL
    t = t + "    IF NOT FS.Exists(DATADIR + ""\P"") THEN FS.MakeDir(DATADIR + ""\P"")" + NL
    t = t + "    IF NOT FS.Exists(DATADIR + ""\UP"") THEN FS.MakeDir(DATADIR + ""\UP"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- READMEs" + NL
    t = t + "" + NL
    t = t + "' Markdown, a little of it, as HTML Voyager can show: # headings, ``` code" + NL
    t = t + "' blocks, - lists, `code`, and paragraphs." + NL
    t = t + "FUNCTION Markdown (text AS String) AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR para AS Array OF String" + NL
    t = t + "    VAR code AS Bool" + NL
    t = t + "    VAR list AS Bool" + NL
    t = t + "    FOR EACH line IN text.Replace(Chr(13), """").Split(Chr(10))" + NL
    t = t + "        IF line.Trim().StartsWith(""```"") THEN" + NL
    t = t + "            IF code THEN" + NL
    t = t + "                out.Add(""</pre>"")" + NL
    t = t + "                code = FALSE" + NL
    t = t + "            ELSE" + NL
    t = t + "                IF para.Count > 0 THEN out.Add(""<p>"" + para.Join("" "") + ""</p>"")" + NL
    t = t + "            para.Clear()" + NL
    t = t + "                IF list THEN out.Add(""</ul>"")" + NL
    t = t + "                list = FALSE" + NL
    t = t + "                out.Add(""<pre>"")" + NL
    t = t + "                code = TRUE" + NL
    t = t + "            END IF" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF code THEN" + NL
    t = t + "            out.Add(SERVER.HtmlEncode(line))" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF line.Trim() = """" THEN" + NL
    t = t + "            IF para.Count > 0 THEN out.Add(""<p>"" + para.Join("" "") + ""</p>"")" + NL
    t = t + "            para.Clear()" + NL
    t = t + "            IF list THEN out.Add(""</ul>"")" + NL
    t = t + "            list = FALSE" + NL
    t = t + "        ELSEIF line.StartsWith(""#"") THEN" + NL
    t = t + "            IF para.Count > 0 THEN out.Add(""<p>"" + para.Join("" "") + ""</p>"")" + NL
    t = t + "            para.Clear()" + NL
    t = t + "            IF line.StartsWith(""###"") THEN" + NL
    t = t + "                out.Add(""<h4>"" + Inline(line.Substring(3, line.Length - 3).Trim()) + ""</h4>"")" + NL
    t = t + "            ELSEIF line.StartsWith(""##"") THEN" + NL
    t = t + "                out.Add(""<h3>"" + Inline(line.Substring(2, line.Length - 2).Trim()) + ""</h3>"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                out.Add(""<h2>"" + Inline(line.Substring(1, line.Length - 1).Trim()) + ""</h2>"")" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSEIF line.StartsWith(""- "") OR line.StartsWith(""* "") THEN" + NL
    t = t + "            IF para.Count > 0 THEN out.Add(""<p>"" + para.Join("" "") + ""</p>"")" + NL
    t = t + "            para.Clear()" + NL
    t = t + "            IF NOT list THEN out.Add(""<ul>"")" + NL
    t = t + "            list = TRUE" + NL
    t = t + "            out.Add(""<li>"" + Inline(line.Substring(2, line.Length - 2)) + ""</li>"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            para.Add(Inline(line))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF para.Count > 0 THEN out.Add(""<p>"" + para.Join("" "") + ""</p>"")" + NL
    t = t + "    IF list THEN out.Add(""</ul>"")" + NL
    t = t + "    IF code THEN out.Add(""</pre>"")" + NL
    t = t + "    RETURN out.Join(Chr(10))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' `code` in a line" + NL
    t = t + "FUNCTION Inline (s AS String) AS String" + NL
    t = t + "    VAR bits AS Array OF String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    bits = s.Split(""`"")" + NL
    t = t + "    FOR k = 0 TO bits.Count - 1" + NL
    t = t + "        IF k MOD 2 = 1 AND k < bits.Count - 1 THEN" + NL
    t = t + "            out = out + ""<tt>"" + SERVER.HtmlEncode(bits[k]) + ""</tt>""" + NL
    t = t + "        ELSEIF k MOD 2 = 1 THEN" + NL
    t = t + "            out = out + ""`"" + SERVER.HtmlEncode(bits[k])" + NL
    t = t + "        ELSE" + NL
    t = t + "            out = out + SERVER.HtmlEncode(bits[k])" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\WEB\REG.SPK")
END SUB

VAR npmWin AS GUI_Window

' The central host, or a yes to installing it somewhere else anyway.
FUNCTION NpmHere () AS Bool
    VAR box AS GUI_MessageBox
    IF NET.HostName.Lower() = "starthere.56k.net" THEN RETURN TRUE
    npmWin = GUI_Window.New("npm Registry Setup", 10, 10)
    box = GUI_MessageBox.New(npmWin)
    box.Title = "npm Registry Setup"
    box.Kind = "warn"
    box.Buttons = "yesno"
    box.Text = "This machine is " + NET.HostName.Upper() + ", not STARTHERE.56K.NET." + NL + NL _
        + "The npm registry is meant for the central host, so that everybody's packages are in one place." + NL + NL _
        + "Install it here anyway (for testing, say)?"
    IF box.Show() THEN
        npmWin.Close()
        Print("  (not the central host, starthere.56k.net: installing anyway)")
        RETURN TRUE
    END IF
    Print("The npm registry was not installed: it belongs on starthere.56k.net.")
    SYS.Exit(0)
    RETURN FALSE
END FUNCTION

' Where packages and accounts are kept, and the first packages, the first time.
SUB NpmSetup ()
    IF NOT FS.Exists("C:\NPMDATA") THEN FS.MakeDir("C:\NPMDATA")
    IF NOT FS.Exists("C:\NPMDATA\P") THEN FS.MakeDir("C:\NPMDATA\P")
    IF NOT FS.Exists("C:\NPMDATA\UP") THEN FS.MakeDir("C:\NPMDATA\UP")
    ' the seed packages' owner, an account nobody can log in to
    IF NOT FS.Exists("C:\NPMDATA\USERS.TXT") THEN FS.Write("C:\NPMDATA\USERS.TXT", "sim95|-|-|" + Hex(Rnd(2000000000)) + Hex(Rnd(2000000000)) + Hex(Rnd(2000000000)) + "||" + Str(TIME.Now) + NL)
    NpmSeed0()
    NpmSeed1()
    NpmSeed2()
    NpmSeed3()
    NpmSeed4()
    NpmSeed5()
    NpmSeed6()
    NpmSeed7()
END SUB

' A seed package, unless that name is published here already.
FUNCTION NpmFresh (name AS String) AS Bool
    VAR dir AS String
    dir = "C:\NPMDATA\P\" + name.Upper()
    IF FS.Exists(dir + "\VERSIONS.TXT") THEN RETURN FALSE
    IF NOT FS.Exists(dir) THEN FS.MakeDir(dir)
    IF NOT FS.Exists(dir + "\V1") THEN FS.MakeDir(dir + "\V1")
    RETURN TRUE
END FUNCTION

SUB NpmSeed0 ()
    IF NOT NpmFresh("cowsay") THEN RETURN
    t = ""
    t = t + "NPMPACK 1" + NL
    t = t + "@@F CLI.JS 1 15" + NL
    t = t + "|// cowsay hello there   (-e eyes, -T tongue, -d dead, -b borg)" + NL
    t = t + "|const cowsay = require(""./INDEX.JS"");" + NL
    t = t + "|const args = process.argv.slice(2);" + NL
    t = t + "|const o = { text: """" };" + NL
    t = t + "|const words = [];" + NL
    t = t + "|for (let i = 0; i < args.length; i++) {" + NL
    t = t + "|  const a = args[i];" + NL
    t = t + "|  if (a === ""-e"") o.eyes = args[++i];" + NL
    t = t + "|  else if (a === ""-T"") o.tongue = args[++i];" + NL
    t = t + "|  else if (a === ""-d"") { o.eyes = ""xx""; o.tongue = ""U ""; }" + NL
    t = t + "|  else if (a === ""-b"") o.eyes = ""=="";" + NL
    t = t + "|  else words.push(a);" + NL
    t = t + "|}" + NL
    t = t + "|o.text = words.join("" "") || ""Moo. (Try: cowsay hello)"";" + NL
    t = t + "|console.log(cowsay.say(o));" + NL
    t = t + "@@F INDEX.JS 1 35" + NL
    t = t + "|// cowsay.say({text, eyes, tongue, width}) or cowsay.say(""text""): the cow, as a string" + NL
    t = t + "|const wrap = require(""wrap"");" + NL
    t = t + "|" + NL
    t = t + "|function bubble(lines) {" + NL
    t = t + "|  const w = Math.max.apply(null, lines.map((l) => l.length));" + NL
    t = t + "|  const out = ["" "" + ""_"".repeat(w + 2)];" + NL
    t = t + "|  lines.forEach((l, i) => {" + NL
    t = t + "|    const pad = l + "" "".repeat(w - l.length);" + NL
    t = t + "|    let a = ""|"", b = ""|"";" + NL
    t = t + "|    if (lines.length === 1) { a = ""<""; b = "">""; }" + NL
    t = t + "|    else if (i === 0) { a = ""/""; b = ""\\""; }" + NL
    t = t + "|    else if (i === lines.length - 1) { a = ""\\""; b = ""/""; }" + NL
    t = t + "|    out.push(a + "" "" + pad + "" "" + b);" + NL
    t = t + "|  });" + NL
    t = t + "|  out.push("" "" + ""-"".repeat(w + 2));" + NL
    t = t + "|  return out.join(""\n"");" + NL
    t = t + "|}" + NL
    t = t + "|" + NL
    t = t + "|function say(o) {" + NL
    t = t + "|  if (typeof o === ""string"") o = { text: o };" + NL
    t = t + "|  const eyes = (o.eyes || ""oo"").substring(0, 2);" + NL
    t = t + "|  const tongue = (o.tongue || ""  "").substring(0, 2);" + NL
    t = t + "|  return bubble(wrap(o.text || ""Moo."", o.width || 36)) + ""\n"" +" + NL
    t = t + "|    ""        \\   ^__^\n"" +" + NL
    t = t + "|    ""         \\  ("" + eyes + "")\\_______\n"" +" + NL
    t = t + "|    ""            (__)\\       )\\/\\\n"" +" + NL
    t = t + "|    ""             "" + tongue + "" ||----w |\n"" +" + NL
    t = t + "|    ""                ||     ||"";" + NL
    t = t + "|}" + NL
    t = t + "|" + NL
    t = t + "|function think(o) {" + NL
    t = t + "|  return say(o).split(""\\   ^"").join(""o   ^"").split("" \\  ("").join("" o  ("");" + NL
    t = t + "|}" + NL
    t = t + "|" + NL
    t = t + "|module.exports = { say, think };" + NL
    t = t + "@@F PACKAGE.JSN 1 11" + NL
    t = t + "|{" + NL
    t = t + "|  ""name"": ""cowsay""," + NL
    t = t + "|  ""version"": ""1.0.0""," + NL
    t = t + "|  ""description"": ""A cow says what you tell it. Install it with -g for the cowsay command.""," + NL
    t = t + "|  ""main"": ""INDEX.JS""," + NL
    t = t + "|  ""bin"": { ""cowsay"": ""CLI.JS"" }," + NL
    t = t + "|  ""keywords"": [""cow"", ""fun"", ""ascii"", ""say""]," + NL
    t = t + "|  ""dependencies"": { ""wrap"": ""^1.0.0"" }," + NL
    t = t + "|  ""author"": ""sim95""," + NL
    t = t + "|  ""license"": ""MIT""" + NL
    t = t + "|}" + NL
    t = t + "@@F README.MD 1 21" + NL
    t = t + "|# cowsay" + NL
    t = t + "|" + NL
    t = t + "|A cow says what you tell it." + NL
    t = t + "|" + NL
    t = t + "|## As a command" + NL
    t = t + "|" + NL
    t = t + "|```" + NL
    t = t + "|npm install -g cowsay" + NL
    t = t + "|cowsay hello from SIM95" + NL
    t = t + "|cowsay -d I have seen things" + NL
    t = t + "|```" + NL
    t = t + "|" + NL
    t = t + "|## In your program" + NL
    t = t + "|" + NL
    t = t + "|```" + NL
    t = t + "|const cowsay = require('cowsay');" + NL
    t = t + "|console.log(cowsay.say({ text: 'Moo!', eyes: '^^' }));" + NL
    t = t + "|console.log(cowsay.think('hmm'));" + NL
    t = t + "|```" + NL
    t = t + "|" + NL
    t = t + "|Uses `wrap` for the speech bubble." + NL
    FS.Write("C:\NPMDATA\P\COWSAY\V1\1.TXT", t)
    t = ""
    t = t + "# cowsay" + NL
    t = t + "" + NL
    t = t + "A cow says what you tell it." + NL
    t = t + "" + NL
    t = t + "## As a command" + NL
    t = t + "" + NL
    t = t + "```" + NL
    t = t + "npm install -g cowsay" + NL
    t = t + "cowsay hello from SIM95" + NL
    t = t + "cowsay -d I have seen things" + NL
    t = t + "```" + NL
    t = t + "" + NL
    t = t + "## In your program" + NL
    t = t + "" + NL
    t = t + "```" + NL
    t = t + "const cowsay = require('cowsay');" + NL
    t = t + "console.log(cowsay.say({ text: 'Moo!', eyes: '^^' }));" + NL
    t = t + "console.log(cowsay.think('hmm'));" + NL
    t = t + "```" + NL
    t = t + "" + NL
    t = t + "Uses `wrap` for the speech bubble." + NL
    FS.Write("C:\NPMDATA\P\COWSAY\V1\README.TXT", t)
    FS.Write("C:\NPMDATA\P\COWSAY\VERSIONS.TXT", "1.0.0|V1|1|2516|72caa909|" + Str(TIME.Now) + "|" + TIME.Date + "|sim95|wrap=^1.0.0" + NL)
    FS.Write("C:\NPMDATA\P\COWSAY\NEXT.TXT", "2")
