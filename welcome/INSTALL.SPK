' INSTALL.SPK - puts the Welcome Wagon on this machine. Generated by tools/build-installer.mjs;
' edit the files in welcome/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5 - on the central
' host, STARTHERE.56K.NET. It writes the Welcome Wagon to C:\PROGRAMS\WELCOME.SPK,
' starts it, and adds it to C:\SYSTEM\STARTUP. It waits in #general on every
' machine's Chat service as StartHereBot, says hello to whoever comes in, and
' tells them about this machine's sites (the SimHost front page's list). It
' links the rooms into one, too: people in #general anywhere are in #general
' everywhere, under their own names. "unlink" in a room keeps it to itself;
' "bye" sends the bot away from that machine for good. Settings:
' C:\WELCOME\WELCOME.INI. (On any other machine it warns you first: a second
' one would greet everybody twice, and link every line twice.)

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)



    IF NOT WelcomeHere() THEN RETURN
    File0()
    Print("the Welcome Wagon is installed (1 files).")
    StartService("WELCOME", "C:\PROGRAMS\WELCOME.SPK", "WELCOME.RUN")

    Print("The Welcome Wagon is running: it greets newcomers in #general on every machine.")
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "' WELCOME.SPK - the Welcome Wagon, for the central host (STARTHERE)." + NL
    t = t + "'" + NL
    t = t + "' Every machine runs a Chat service (port 6667), and the Chat program" + NL
    t = t + "' connects to its own machine's, in #general, out of the box: so somebody" + NL
    t = t + "' new who opens Chat finds an empty room. The Welcome Wagon is in every one" + NL
    t = t + "' of those rooms. It says hello to newcomers (once), tells them what this" + NL
    t = t + "' machine serves (the same list as SimHost's front page), and links the" + NL
    t = t + "' rooms into one: everybody in #general anywhere is in #general everywhere" + NL
    t = t + "' somebody is, under their own name." + NL
    t = t + "'" + NL
    t = t + "' How it keeps up with machines that come and go all the time:" + NL
    t = t + "'   * It looks round the network every few seconds (NET.Machines). A new" + NL
    t = t + "'     machine gets the bot in its room, as StartHereBot, or StartHereBo2," + NL
    t = t + "'     3... when the name is taken. A machine missing from two looks in a row" + NL
    t = t + "'     has gone: its room, its people and their stand-ins go too. (A machine" + NL
    t = t + "'     that leaves doesn't close its connections: they just go quiet.)" + NL
    t = t + "'   * Each look round, it asks every room who is there (WHO) and believes" + NL
    t = t + "'     the answer: anybody it missed coming or going is put right." + NL
    t = t + "'   * The stand-ins (a connection under each person's name in each other" + NL
    t = t + "'     room with somebody in it, saying what they say) are worked out again" + NL
    t = t + "'     from that four times a second: missing ones made, extra ones closed." + NL
    t = t + "'   * A connection that doesn't get through in time is given up and tried" + NL
    t = t + "'     again; so is a room that has said nothing for three looks round." + NL
    t = t + "'" + NL
    t = t + "' One clock (Work) changes everything. The network's events, the dialler" + NL
    t = t + "' and the look round only hand things to it (one Add each), so nothing is" + NL
    t = t + "' changed by two at once; and each thing it is handed is dealt with inside" + NL
    t = t + "' its own TRY, so one bad line is noted, not fatal." + NL
    t = t + "'" + NL
    t = t + "' Connections are closed without QUIT: the stock Chat service can crash on" + NL
    t = t + "' a QUIT followed by a close (see SIM95-NOTES.md), never on a plain close." + NL
    t = t + "' Lines go one a tick on each connection, as the service can shuffle lines" + NL
    t = t + "' that arrive together." + NL
    t = t + "'" + NL
    t = t + "' In a room:" + NL
    t = t + "'   sites    the sites here, one a line" + NL
    t = t + "'   who      who is in the conversation, and where" + NL
    t = t + "'   unlink   this room stays to itself (C:\WELCOME\UNLINK.TXT); link undoes it" + NL
    t = t + "'   bye      the bot leaves that machine's room, for good (C:\WELCOME\OPTOUT.TXT)" + NL
    t = t + "' Settings, in C:\WELCOME\WELCOME.INI:" + NL
    t = t + "'   channel=#general    the room" + NL
    t = t + "'   every=10            seconds between looks round the network" + NL
    t = t + "' Whom it has greeted is in C:\WELCOME\SEEN.TXT (machine|nick)." + NL
    t = t + "" + NL
    t = t + "CONST HOME = ""C:\WELCOME""" + NL
    t = t + "CONST BOTNICK = ""StartHereBot""" + NL
    t = t + "CONST SETTLE = 1500               ' greet and link somebody this long after they come in (ms)" + NL
    t = t + "CONST QUIET = 15000               ' sites or who at most this often in one room (ms)" + NL
    t = t + "CONST MOST = 200                  ' lines kept in the window" + NL
    t = t + "CONST MOSTLINKS = 400             ' stand-ins at most, all told" + NL
    t = t + "CONST MOSTDIALS = 4               ' connections on their way at once" + NL
    t = t + "CONST MISSES = 2                  ' looks round a machine may miss before it has gone" + NL
    t = t + "CONST WAITCONNECT = 12000         ' a connection not through by then is given up (ms)" + NL
    t = t + "CONST RETRY = 300000              ' a machine whose Chat service never answered: again after (ms)" + NL
    t = t + "CONST RETRYSOON = 10000           ' ...one whose did (it may have crashed) (ms)" + NL
    t = t + "CONST CLASHWAIT = 60000           ' a taken name is tried again after (ms)" + NL
    t = t + "" + NL
    t = t + "VAR EOL AS String" + NL
    t = t + "VAR SEP AS String" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR journal AS GUI_ListBox" + NL
    t = t + "VAR sock AS NET_Socket" + NL
    t = t + "VAR worker AS GUI_Timer" + NL
    t = t + "VAR dialer AS GUI_Timer" + NL
    t = t + "VAR scanner AS GUI_Timer" + NL
    t = t + "VAR noted AS Array OF String" + NL
    t = t + "" + NL
    t = t + "VAR channel AS String" + NL
    t = t + "VAR every AS Integer              ' seconds between looks round" + NL
    t = t + "VAR here AS String                ' this machine as people type it: starthere" + NL
    t = t + "VAR seen AS Array OF String       ' MACHINE|nick: greeted already" + NL
    t = t + "VAR greeted AS Integer" + NL
    t = t + "VAR serial AS Integer             ' for tags" + NL
    t = t + "VAR statusAt AS Integer" + NL
    t = t + "" + NL
    t = t + "' Handed to the worker, one Add at a time." + NL
    t = t + "VAR inbox AS Array OF String      ' tag, SEP, then a line, or Chr(1) + CONNECTED / FAILED / CLOSED" + NL
    t = t + "VAR fresh AS Array OF NET_Connection" + NL
    t = t + "VAR dialQ AS Array OF String      ' tag, SEP, address: for the dialler" + NL
    t = t + "VAR flights AS Array OF Integer   ' when each connection on its way set out" + NL
    t = t + "VAR scanned AS Array OF String    ' the last look round: NAME ADDRESS MS" + NL
    t = t + "VAR scanSerial AS Integer" + NL
    t = t + "VAR doneSerial AS Integer" + NL
    t = t + "VAR scanning AS Bool" + NL
    t = t + "VAR scanAt AS Integer" + NL
    t = t + "VAR working AS Bool" + NL
    t = t + "VAR workingAt AS Integer" + NL
    t = t + "" + NL
    t = t + "' The open connections, and the lines waiting for each (the worker's own)." + NL
    t = t + "VAR cTag AS Array OF String" + NL
    t = t + "VAR cConn AS Array OF NET_Connection" + NL
    t = t + "VAR outTag AS Array OF String" + NL
    t = t + "VAR outText AS Array OF String" + NL
    t = t + "" + NL
    t = t + "' The rooms, one a machine (this one's too, as localhost). States:" + NL
    t = t + "'   idle (to dial) - dialing - naming (NICK sent) - in (JOINed)" + NL
    t = t + "'   nochat (nobody answered) - gone (off the network) - left (said bye)" + NL
    t = t + "VAR mName AS Array OF String" + NL
    t = t + "VAR mAddr AS Array OF String" + NL
    t = t + "VAR mState AS Array OF String" + NL
    t = t + "VAR mTag AS Array OF String       ' its connection now: R:<n>" + NL
    t = t + "VAR mNick AS Array OF String      ' the bot's name there" + NL
    t = t + "VAR mSince AS Array OF Integer" + NL
    t = t + "VAR mHeard AS Array OF Integer    ' when it last heard from the room" + NL
    t = t + "VAR mMissed AS Array OF Integer   ' looks round missed in a row" + NL
    t = t + "VAR mTries AS Array OF Integer    ' names tried" + NL
    t = t + "VAR mListed AS Array OF Integer   ' when it last listed sites or people there" + NL
    t = t + "VAR mLinked AS Array OF Bool" + NL
    t = t + "VAR mTold AS Array OF Bool        ' told (since it started) the room is linked" + NL
    t = t + "VAR mWasIn AS Array OF Bool" + NL
    t = t + "VAR mFirst AS Array OF Bool       ' the first WHO since it came in is still to come" + NL
    t = t + "" + NL
    t = t + "' The people in the rooms (not the bot, not stand-ins)." + NL
    t = t + "VAR pRoom AS Array OF String" + NL
    t = t + "VAR pNick AS Array OF String" + NL
    t = t + "VAR pAt AS Array OF Integer" + NL
    t = t + "VAR pDone AS Array OF Bool        ' settled: greeted (or not) and linked" + NL
    t = t + "VAR pQuiet AS Array OF Bool       ' not to be greeted (there before the bot came)" + NL
    t = t + "" + NL
    t = t + "' Stand-ins: in a room, for a person (their room and name), under a name." + NL
    t = t + "'   dialing - naming - in - closing (CLOSE queued) - cancel (close when through)" + NL
    t = t + "VAR sTag AS Array OF String       ' S:<n>" + NL
    t = t + "VAR sRoom AS Array OF String" + NL
    t = t + "VAR sOwner AS Array OF String" + NL
    t = t + "VAR sOwnerNick AS Array OF String" + NL
    t = t + "VAR sNick AS Array OF String" + NL
    t = t + "VAR sState AS Array OF String" + NL
    t = t + "VAR sSince AS Array OF Integer" + NL
    t = t + "" + NL
    t = t + "' Names taken elsewhere: owner room|nick|room, and when; told already." + NL
    t = t + "VAR clashKey AS Array OF String" + NL
    t = t + "VAR clashAt AS Array OF Integer" + NL
    t = t + "VAR told AS Array OF String" + NL
    t = t + "" + NL
    t = t + "' Recent renames (room, old, new, when): a NICK can come before the JOIN it followed." + NL
    t = t + "VAR nRoom AS Array OF String" + NL
    t = t + "VAR nOld AS Array OF String" + NL
    t = t + "VAR nNew AS Array OF String" + NL
    t = t + "VAR nAt AS Array OF Integer" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    EOL = Chr(10)" + NL
    t = t + "    SEP = Chr(9)" + NL
    t = t + "    IF NOT FS.Exists(HOME) THEN FS.MakeDir(HOME)" + NL
    t = t + "    channel = ""#general""" + NL
    t = t + "    every = 10" + NL
    t = t + "    FOR EACH line IN ReadOr(HOME + ""\WELCOME.INI"", """").Lines()" + NL
    t = t + "        IF line.StartsWith(""channel="") THEN channel = line.Substring(8, line.Length - 8).Trim().Lower()" + NL
    t = t + "        IF line.StartsWith(""every="") THEN every = MATH.Max(1, Int(Val(line.Substring(6, line.Length - 6))))" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT channel.StartsWith(""#"") THEN channel = ""#"" + channel" + NL
    t = t + "    here = NET.HostName.Split(""."")[0].Lower()" + NL
    t = t + "    FOR EACH line IN ReadOr(HOME + ""\SEEN.TXT"", """").Lines()" + NL
    t = t + "        IF line <> """" THEN seen.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "" + NL
    t = t + "    win = GUI_Window.New(""Welcome Wagon"", 480, 260)" + NL
    t = t + "    win.Icon = ""chat""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    journal = GUI_ListBox.New(win)" + NL
    t = t + "    journal.SetBounds(6, 6, 468, 226)" + NL
    t = t + "    sock = NET_Socket.New()" + NL
    t = t + "    sock.onMessage = Conn_OnMessage" + NL
    t = t + "    sock.onClose = Conn_OnClose" + NL
    t = t + "    ' this machine's own room too: it is where everybody meets" + NL
    t = t + "    AddRoom(NET.HostName.Upper(), ""localhost"")" + NL
    t = t + "    worker = GUI_Timer.New(win)" + NL
    t = t + "    worker.Interval = 250" + NL
    t = t + "    worker.onTick = Worker_OnTick" + NL
    t = t + "    worker.Start()" + NL
    t = t + "    dialer = GUI_Timer.New(win)" + NL
    t = t + "    dialer.Interval = 100" + NL
    t = t + "    dialer.onTick = Dialer_OnTick" + NL
    t = t + "    dialer.Start()" + NL
    t = t + "    scanner = GUI_Timer.New(win)" + NL
    t = t + "    scanner.Interval = 1000" + NL
    t = t + "    scanner.onTick = Scanner_OnTick" + NL
    t = t + "    scanner.Start()" + NL
    t = t + "    Note(""Greeting people in "" + channel + "" on every machine, for http://"" + here + ""/, and linking the rooms"")" + NL
    t = t + "    Status()" + NL
    t = t + "    win.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Note (text AS String)" + NL
    t = t + "    noted.Add(TIME.Clock + ""  "" + text)" + NL
    t = t + "    IF noted.Count > MOST THEN noted.RemoveAt(0)" + NL
    t = t + "    journal.Items = noted" + NL
    t = t + "    journal.ScrollToEnd()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Status ()" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    FOR EACH s IN mState" + NL
    t = t + "        IF s = ""in"" THEN n = n + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    win.Status = Str(n) + "" room"" + Plural(n) + "" open  -  "" + Str(pRoom.Count) + "" "" + People(pRoom.Count) + "" in them  -  "" + Str(sTag.Count) + "" stand-in"" + Plural(sTag.Count) + ""  -  "" + Str(greeted) + "" greeted since it started""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Plural (n AS Integer) AS String" + NL
    t = t + "    IF n = 1 THEN RETURN """"" + NL
    t = t + "    RETURN ""s""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION People (n AS Integer) AS String" + NL
    t = t + "    IF n = 1 THEN RETURN ""person""" + NL
    t = t + "    RETURN ""people""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The machine as people say it: newbie, starthere" + NL
    t = t + "FUNCTION Called (room AS String) AS String" + NL
    t = t + "    RETURN room.Split(""."")[0].Lower()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is the machine (by computer name) in the file, one name a line?" + NL
    t = t + "FUNCTION InFile (path AS String, name AS String) AS Bool" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(path, """").Lines()" + NL
    t = t + "        IF line.Trim().Lower() = Called(name) THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The lines of text, without the one that is name." + NL
    t = t + "FUNCTION Without (text AS String, name AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN text.Lines()" + NL
    t = t + "        IF line.Trim() <> """" AND line.Trim().Lower() <> name.Lower() THEN out = out + line.Trim() + EOL" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the hand-overs" + NL
    t = t + "" + NL
    t = t + "SUB Conn_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    inbox.Add(conn.Tag + SEP + message)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Conn_OnClose (conn AS NET_Connection)" + NL
    t = t + "    inbox.Add(conn.Tag + SEP + Chr(1) + ""CLOSED"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Every few seconds: who is on the network." + NL
    t = t + "SUB Scanner_OnTick ()" + NL
    t = t + "    TRY" + NL
    t = t + "        IF scanning AND SYS.Ticks - scanAt < 8000 THEN RETURN" + NL
    t = t + "        IF scanAt <> 0 AND SYS.Ticks - scanAt < every * 1000 THEN RETURN" + NL
    t = t + "        scanning = TRUE" + NL
    t = t + "        scanAt = MATH.Max(1, SYS.Ticks)" + NL
    t = t + "        scanned = NET.Machines()" + NL
    t = t + "        scanSerial = scanSerial + 1" + NL
    t = t + "        scanning = FALSE" + NL
    t = t + "    CATCH err" + NL
    t = t + "        scanning = FALSE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A few connections on their way at once, so one to a machine that has" + NL
    t = t + "' just gone can't hold the others up. (A failed Connect spoils the rest of" + NL
    t = t + "' its handler, so after it there are only two statements and the end of" + NL
    t = t + "' the handler: see SIM95-NOTES.md.)" + NL
    t = t + "SUB Dialer_OnTick ()" + NL
    t = t + "    TRY" + NL
    t = t + "        DialOne()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DialOne ()" + NL
    t = t + "    VAR req AS String" + NL
    t = t + "    VAR tag AS String" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR started AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    FOR k = flights.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF SYS.Ticks - flights[k] > WAITCONNECT THEN flights.RemoveAt(k)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF flights.Count >= MOSTDIALS THEN RETURN" + NL
    t = t + "    ' the next one still wanted (a room or stand-in given up on is skipped)" + NL
    t = t + "    req = """"" + NL
    t = t + "    WHILE dialQ.Count > 0 AND req = """"" + NL
    t = t + "        req = dialQ[0]" + NL
    t = t + "        dialQ.RemoveAt(0)" + NL
    t = t + "        tag = req.Substring(0, req.IndexOf(SEP))" + NL
    t = t + "        IF NOT mTag.Contains(tag) AND NOT sTag.Contains(tag) THEN req = """"" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF req = """" THEN RETURN" + NL
    t = t + "    started = SYS.Ticks" + NL
    t = t + "    flights.Add(started)" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = sock.Connect(req.Substring(req.IndexOf(SEP) + 1, req.Length - req.IndexOf(SEP) - 1), 6667)" + NL
    t = t + "        conn.Tag = tag" + NL
    t = t + "        fresh.Add(conn)" + NL
    t = t + "        inbox.Add(tag + SEP + Chr(1) + ""CONNECTED"")" + NL
    t = t + "        k = flights.IndexOf(started)" + NL
    t = t + "        IF k >= 0 THEN flights.RemoveAt(k)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        inbox.Add(tag + SEP + Chr(1) + ""FAILED"")" + NL
    t = t + "        flights.RemoveAt(MATH.Max(0, flights.IndexOf(started)))" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the worker" + NL
    t = t + "" + NL
    t = t + "SUB Worker_OnTick ()" + NL
    t = t + "    IF working AND SYS.Ticks - workingAt < 5000 THEN RETURN" + NL
    t = t + "    working = TRUE" + NL
    t = t + "    workingAt = SYS.Ticks" + NL
    t = t + "    TRY" + NL
    t = t + "        Work()" + NL
    t = t + "    CATCH err" + NL
    t = t + "        Note(""Trouble: "" + err)" + NL
    t = t + "    END TRY" + NL
    t = t + "    working = FALSE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Work ()" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR shown AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    ' new connections into the table (or closed, if nothing wants them now)" + NL
    t = t + "    WHILE fresh.Count > 0" + NL
    t = t + "        TakeIn(fresh[0])" + NL
    t = t + "        fresh.RemoveAt(0)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    ' what came in, in order" + NL
    t = t + "    WHILE inbox.Count > 0 AND n < 300" + NL
    t = t + "        item = inbox[0]" + NL
    t = t + "        inbox.RemoveAt(0)" + NL
    t = t + "        n = n + 1" + NL
    t = t + "        TRY" + NL
    t = t + "            Deal(item)" + NL
    t = t + "        CATCH err" + NL
    t = t + "            shown = item.Replace(SEP, "" "").Replace(Chr(1), """")" + NL
    t = t + "            Note(""Trouble with "" + shown.Substring(0, MATH.Min(60, shown.Length)) + "": "" + err)" + NL
    t = t + "        END TRY" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF scanSerial <> doneSerial THEN" + NL
    t = t + "        doneSerial = scanSerial" + NL
    t = t + "        Census()" + NL
    t = t + "    END IF" + NL
    t = t + "    Timeouts()" + NL
    t = t + "    SettleIn()" + NL
    t = t + "    Reconcile()" + NL
    t = t + "    SendSome()" + NL
    t = t + "    IF SYS.Ticks - statusAt > 1000 THEN" + NL
    t = t + "        statusAt = SYS.Ticks" + NL
    t = t + "        Status()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB TakeIn (conn AS NET_Connection)" + NL
    t = t + "    IF mTag.Contains(conn.Tag) OR sTag.Contains(conn.Tag) THEN" + NL
    t = t + "        cTag.Add(conn.Tag)" + NL
    t = t + "        cConn.Add(conn)" + NL
    t = t + "    ELSE" + NL
    t = t + "        ' (given up on while it connected)" + NL
    t = t + "        TRY" + NL
    t = t + "            conn.Close()" + NL
    t = t + "        CATCH err" + NL
    t = t + "        END TRY" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Deal (item AS String)" + NL
    t = t + "    VAR tag AS String" + NL
    t = t + "    VAR msg AS String" + NL
    t = t + "    IF NOT item.Contains(SEP) THEN RETURN" + NL
    t = t + "    tag = item.Substring(0, item.IndexOf(SEP))" + NL
    t = t + "    msg = item.Substring(item.IndexOf(SEP) + 1, item.Length - item.IndexOf(SEP) - 1)" + NL
    t = t + "    IF tag = """" THEN RETURN" + NL
    t = t + "    IF mTag.Contains(tag) THEN" + NL
    t = t + "        RoomHeard(mTag.IndexOf(tag), tag, msg)" + NL
    t = t + "    ELSEIF sTag.Contains(tag) THEN" + NL
    t = t + "        StandInHeard(sTag.IndexOf(tag), tag, msg)" + NL
    t = t + "    ELSEIF msg <> Chr(1) + ""CLOSED"" AND NOT outTag.Contains(tag) THEN" + NL
    t = t + "        ' a connection nothing wants any more (and with nothing left to say)" + NL
    t = t + "        Forget(tag)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ connections" + NL
    t = t + "" + NL
    t = t + "FUNCTION ConnOf (tag AS String) AS Integer" + NL
    t = t + "    RETURN cTag.IndexOf(tag)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Out of the table, and closed." + NL
    t = t + "SUB Forget (tag AS String)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    k = cTag.IndexOf(tag)" + NL
    t = t + "    IF k < 0 THEN RETURN" + NL
    t = t + "    TRY" + NL
    t = t + "        cConn[k].Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    cTag.RemoveAt(k)" + NL
    t = t + "    cConn.RemoveAt(k)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SendNow (tag AS String, line AS String)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    k = cTag.IndexOf(tag)" + NL
    t = t + "    IF k < 0 THEN RETURN" + NL
    t = t + "    TRY" + NL
    t = t + "        cConn[k].Send(line)" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A line for a connection, in its turn: one a tick for each connection." + NL
    t = t + "' Chr(1) + ""CLOSE"" closes it; Chr(1) + anything else is sent as it is;" + NL
    t = t + "' anything else is said in the room." + NL
    t = t + "SUB Queue (tag AS String, text AS String)" + NL
    t = t + "    outTag.Add(tag)" + NL
    t = t + "    outText.Add(text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SendSome ()" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR done AS String" + NL
    t = t + "    VAR tag AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR s AS Integer" + NL
    t = t + "    done = "",""" + NL
    t = t + "    k = 0" + NL
    t = t + "    WHILE k < outTag.Count" + NL
    t = t + "        IF done.Contains("","" + outTag[k] + "","") THEN" + NL
    t = t + "            k = k + 1" + NL
    t = t + "        ELSE" + NL
    t = t + "            tag = outTag[k]" + NL
    t = t + "            text = outText[k]" + NL
    t = t + "            outTag.RemoveAt(k)" + NL
    t = t + "            outText.RemoveAt(k)" + NL
    t = t + "            IF ConnOf(tag) >= 0 THEN" + NL
    t = t + "                done = done + tag + "",""" + NL
    t = t + "                IF text = Chr(1) + ""CLOSE"" THEN" + NL
    t = t + "                    Forget(tag)" + NL
    t = t + "                    s = sTag.IndexOf(tag)" + NL
    t = t + "                    IF s >= 0 THEN DropStandIn(s)" + NL
    t = t + "                ELSEIF text.StartsWith(Chr(1)) THEN" + NL
    t = t + "                    SendNow(tag, text.Substring(1, text.Length - 1))" + NL
    t = t + "                ELSE" + NL
    t = t + "                    SendNow(tag, ""MSG "" + channel + "" "" + text)" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the network" + NL
    t = t + "" + NL
    t = t + "' What the look round found: new machines get a room; machines missing" + NL
    t = t + "' from it twice have gone; every room is asked who is there." + NL
    t = t + "SUB Census ()" + NL
    t = t + "    VAR m AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR found AS String" + NL
    t = t + "    found = "",""" + NL
    t = t + "    FOR EACH m IN scanned" + NL
    t = t + "        p = m.Split("" "")" + NL
    t = t + "        IF p.Count < 2 THEN CONTINUE" + NL
    t = t + "        IF p[0].Upper() = NET.HostName.Upper() OR p[1] = NET.LocalAddress THEN CONTINUE" + NL
    t = t + "        found = found + p[0].Upper() + "",""" + NL
    t = t + "        i = mName.IndexOf(p[0].Upper())" + NL
    t = t + "        IF i < 0 THEN" + NL
    t = t + "            AddRoom(p[0].Upper(), p[1])" + NL
    t = t + "            Note(""Found "" + p[0])" + NL
    t = t + "        ELSE" + NL
    t = t + "            mMissed[i] = 0" + NL
    t = t + "            IF mAddr[i] <> p[1] THEN" + NL
    t = t + "                ' the same name at a new address: a new machine, really" + NL
    t = t + "                mAddr[i] = p[1]" + NL
    t = t + "                IF mState[i] <> ""left"" AND mState[i] <> ""gone"" THEN RoomDown(i, ""idle"")" + NL
    t = t + "            END IF" + NL
    t = t + "            IF mState[i] = ""gone"" THEN" + NL
    t = t + "                SetState(i, ""idle"")" + NL
    t = t + "                Note(mName[i] + "" is back"")" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR i = 0 TO mName.Count - 1" + NL
    t = t + "        IF IsHub(i) OR found.Contains("","" + mName[i] + "","") THEN CONTINUE" + NL
    t = t + "        mMissed[i] = mMissed[i] + 1" + NL
    t = t + "        IF mMissed[i] >= MISSES AND mState[i] <> ""gone"" AND mState[i] <> ""left"" THEN" + NL
    t = t + "            Note(mName[i] + "" has left the network"")" + NL
    t = t + "            RoomDown(i, ""gone"")" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' who is really there (the answer puts right anything missed)" + NL
    t = t + "    FOR i = 0 TO mName.Count - 1" + NL
    t = t + "        IF mState[i] = ""in"" THEN Queue(mTag[i], Chr(1) + ""WHO "" + channel)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB AddRoom (name AS String, addr AS String)" + NL
    t = t + "    mName.Add(name)" + NL
    t = t + "    mAddr.Add(addr)" + NL
    t = t + "    mState.Add(""idle"")" + NL
    t = t + "    mTag.Add("""")" + NL
    t = t + "    mNick.Add(BOTNICK)" + NL
    t = t + "    mSince.Add(0)" + NL
    t = t + "    mHeard.Add(0)" + NL
    t = t + "    mMissed.Add(0)" + NL
    t = t + "    mTries.Add(0)" + NL
    t = t + "    mListed.Add(0)" + NL
    t = t + "    mLinked.Add(NOT InFile(HOME + ""\UNLINK.TXT"", name))" + NL
    t = t + "    mTold.Add(FALSE)" + NL
    t = t + "    mWasIn.Add(FALSE)" + NL
    t = t + "    mFirst.Add(FALSE)" + NL
    t = t + "    IF InFile(HOME + ""\OPTOUT.TXT"", name) THEN mState[mState.Count - 1] = ""left""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SetState (i AS Integer, s AS String)" + NL
    t = t + "    mState[i] = s" + NL
    t = t + "    mSince[i] = SYS.Ticks" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsHub (i AS Integer) AS Bool" + NL
    t = t + "    RETURN mAddr[i] = ""localhost""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name for the bot, try n: StartHereBot, StartHereBo2... then any." + NL
    t = t + "FUNCTION NameTry (n AS Integer) AS String" + NL
    t = t + "    IF n = 0 THEN RETURN BOTNICK" + NL
    t = t + "    IF n < 9 THEN RETURN BOTNICK.Substring(0, 11) + Str(n + 1)" + NL
    t = t + "    RETURN ""SHBot"" + Str(1000 + Rnd(9000))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Dial (i AS Integer)" + NL
    t = t + "    serial = serial + 1" + NL
    t = t + "    mTag[i] = ""R:"" + Str(serial)" + NL
    t = t + "    SetState(i, ""dialing"")" + NL
    t = t + "    mTries[i] = 0" + NL
    t = t + "    dialQ.Add(mTag[i] + SEP + mAddr[i])" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Room i is closed: its connection, its people, the stand-ins in it." + NL
    t = t + "SUB RoomDown (i AS Integer, state AS String)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF mTag[i] <> """" THEN Forget(mTag[i])" + NL
    t = t + "    mTag[i] = """"" + NL
    t = t + "    FOR k = pRoom.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF pRoom[k] = mName[i] THEN RemovePerson(k)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR k = sTag.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF sRoom[k] = mName[i] THEN" + NL
    t = t + "            Forget(sTag[k])" + NL
    t = t + "            DropStandIn(k)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ClearClashes(mName[i])" + NL
    t = t + "    SetState(i, state)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Rooms that have waited long enough, connections that have taken too long," + NL
    t = t + "' rooms gone quiet, stand-ins stuck on the way." + NL
    t = t + "SUB Timeouts ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR now AS Integer" + NL
    t = t + "    now = SYS.Ticks" + NL
    t = t + "    FOR i = 0 TO mName.Count - 1" + NL
    t = t + "        SELECT CASE mState[i]" + NL
    t = t + "            CASE ""idle""" + NL
    t = t + "                IF now - mSince[i] >= 1000 AND mMissed[i] = 0 THEN Dial(i)" + NL
    t = t + "            CASE ""dialing""" + NL
    t = t + "                IF now - mSince[i] > WAITCONNECT THEN RoomDown(i, ""idle"")" + NL
    t = t + "            CASE ""naming""" + NL
    t = t + "                IF now - mSince[i] > WAITCONNECT THEN RoomDown(i, ""idle"")" + NL
    t = t + "            CASE ""in""" + NL
    t = t + "                IF now - mHeard[i] > every * 3000 + 10000 THEN" + NL
    t = t + "                    Note(""Nothing from "" + mName[i] + "" for a while: trying again"")" + NL
    t = t + "                    RoomDown(i, ""idle"")" + NL
    t = t + "                END IF" + NL
    t = t + "            CASE ""nochat""" + NL
    t = t + "                IF now - mSince[i] > RETRY OR (mWasIn[i] AND now - mSince[i] > RETRYSOON) THEN SetState(i, ""idle"")" + NL
    t = t + "        END SELECT" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR k = sTag.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF (sState[k] = ""dialing"" OR sState[k] = ""cancel"" OR sState[k] = ""naming"") AND now - sSince[k] > WAITCONNECT THEN" + NL
    t = t + "            Forget(sTag[k])" + NL
    t = t + "            DropStandIn(k)" + NL
    t = t + "        ELSEIF sState[k] = ""closing"" AND now - sSince[k] > 10000 THEN" + NL
    t = t + "            Forget(sTag[k])" + NL
    t = t + "            DropStandIn(k)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ a room's lines" + NL
    t = t + "" + NL
    t = t + "SUB RoomHeard (i AS Integer, tag AS String, msg AS String)" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR cut AS Integer" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    mHeard[i] = SYS.Ticks" + NL
    t = t + "    IF msg = Chr(1) + ""CONNECTED"" THEN" + NL
    t = t + "        SetState(i, ""naming"")" + NL
    t = t + "        mTries[i] = 0" + NL
    t = t + "        SendNow(tag, ""NICK "" + NameTry(0))" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF msg = Chr(1) + ""FAILED"" THEN" + NL
    t = t + "        RoomDown(i, ""nochat"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF msg = Chr(1) + ""CLOSED"" THEN" + NL
    t = t + "        IF mState[i] = ""in"" THEN Note(""The room on "" + mName[i] + "" closed"")" + NL
    t = t + "        RoomDown(i, ""idle"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    p = msg.Split("" "")" + NL
    t = t + "    SELECT CASE p[0]" + NL
    t = t + "        CASE ""OK""" + NL
    t = t + "            ' its name is taken: now into the room" + NL
    t = t + "            IF msg.StartsWith(""OK You are now "") THEN" + NL
    t = t + "                mNick[i] = msg.Substring(15, msg.Length - 15).Trim()" + NL
    t = t + "                IF mState[i] = ""naming"" THEN" + NL
    t = t + "                    SetState(i, ""in"")" + NL
    t = t + "                    mWasIn[i] = TRUE" + NL
    t = t + "                    mFirst[i] = TRUE" + NL
    t = t + "                    Queue(tag, Chr(1) + ""JOIN "" + channel)" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""ERR""" + NL
    t = t + "            ' the name is somebody's: the next one" + NL
    t = t + "            IF mState[i] = ""naming"" AND (msg.Contains(""Nick in use"") OR msg.Contains(""Bad nick"")) THEN" + NL
    t = t + "                mTries[i] = mTries[i] + 1" + NL
    t = t + "                SendNow(tag, ""NICK "" + NameTry(mTries[i]))" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""WHO""" + NL
    t = t + "            IF p.Count >= 2 THEN" + NL
    t = t + "                IF p[1] = channel THEN" + NL
    t = t + "                    IF p.Count >= 3 THEN" + NL
    t = t + "                        Sync(i, p[2])" + NL
    t = t + "                    ELSE" + NL
    t = t + "                        Sync(i, """")" + NL
    t = t + "                    END IF" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""JOIN""" + NL
    t = t + "            IF p.Count >= 3 THEN" + NL
    t = t + "                IF p[1] = channel AND NOT Ours(i, p[2]) THEN Arrive(i, p[2], FALSE)" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""PART""" + NL
    t = t + "            IF p.Count >= 3 THEN" + NL
    t = t + "                IF p[1] = channel AND NOT Ours(i, p[2]) THEN Leave(i, p[2])" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""NICK""" + NL
    t = t + "            IF p.Count >= 4 THEN" + NL
    t = t + "                IF NOT Ours(i, p[2]) AND NOT Ours(i, p[3]) THEN Renamed(i, p[2], p[3])" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""MSG""" + NL
    t = t + "            IF p.Count >= 4 THEN" + NL
    t = t + "                IF p[1] = channel AND NOT Ours(i, p[2]) THEN" + NL
    t = t + "                    cut = p[0].Length + p[1].Length + p[2].Length + 3" + NL
    t = t + "                    text = msg.Substring(cut, msg.Length - cut)" + NL
    t = t + "                    Arrive(i, p[2], FALSE)" + NL
    t = t + "                    Relay(i, p[2], text)" + NL
    t = t + "                    Obey(i, p[2], text)" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The bot itself, or one of its stand-ins, in room i." + NL
    t = t + "FUNCTION Ours (i AS Integer, nick AS String) AS Bool" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF nick.Lower() = mNick[i].Lower() THEN RETURN TRUE" + NL
    t = t + "    FOR k = 0 TO sTag.Count - 1" + NL
    t = t + "        IF sRoom[k] = mName[i] AND sNick[k].Lower() = nick.Lower() THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The answer to WHO: everybody there now. Newcomers are added; anybody no" + NL
    t = t + "' longer there (and not just come) is gone." + NL
    t = t + "SUB Sync (i AS Integer, list AS String)" + NL
    t = t + "    VAR names AS String" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR quiet AS Bool" + NL
    t = t + "    ' the regulars on this machine, there when the bot came: no hello for them" + NL
    t = t + "    quiet = mFirst[i] AND IsHub(i)" + NL
    t = t + "    mFirst[i] = FALSE" + NL
    t = t + "    names = "",""" + NL
    t = t + "    FOR EACH n IN list.Split("","")" + NL
    t = t + "        IF n = """" OR Ours(i, n) THEN CONTINUE" + NL
    t = t + "        names = names + n.Lower() + "",""" + NL
    t = t + "        Arrive(i, n, quiet)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR k = pRoom.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF pRoom[k] = mName[i] AND NOT names.Contains("","" + pNick[k].Lower() + "","") AND SYS.Ticks - pAt[k] > 3000 THEN" + NL
    t = t + "            RemovePerson(k)" + NL
    t = t + "            ClearClashes(mName[i])" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ people" + NL
    t = t + "" + NL
    t = t + "SUB Arrive (i AS Integer, nick AS String, quiet AS Bool)" + NL
    t = t + "    nick = Current(mName[i], nick)" + NL
    t = t + "    IF PersonAt(mName[i], nick) >= 0 THEN RETURN" + NL
    t = t + "    pRoom.Add(mName[i])" + NL
    t = t + "    pNick.Add(nick)" + NL
    t = t + "    pAt.Add(SYS.Ticks)" + NL
    t = t + "    pDone.Add(FALSE)" + NL
    t = t + "    pQuiet.Add(quiet)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Leave (i AS Integer, nick AS String)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    k = PersonAt(mName[i], nick)" + NL
    t = t + "    IF k < 0 THEN RETURN" + NL
    t = t + "    RemovePerson(k)" + NL
    t = t + "    ' their name is free here now" + NL
    t = t + "    ClearClashes(mName[i])" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RemovePerson (k AS Integer)" + NL
    t = t + "    pRoom.RemoveAt(k)" + NL
    t = t + "    pNick.RemoveAt(k)" + NL
    t = t + "    pAt.RemoveAt(k)" + NL
    t = t + "    pDone.RemoveAt(k)" + NL
    t = t + "    pQuiet.RemoveAt(k)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION PersonAt (room AS String, nick AS String) AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    FOR k = 0 TO pRoom.Count - 1" + NL
    t = t + "        IF pRoom[k] = room AND pNick[k].Lower() = nick.Lower() THEN RETURN k" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN -1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Somebody in room i changed their name: their stand-ins do too." + NL
    t = t + "SUB Renamed (i AS Integer, old AS String, nick AS String)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR h AS Integer" + NL
    t = t + "    FOR k = nAt.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF SYS.Ticks - nAt[k] > 10000 THEN" + NL
    t = t + "            nRoom.RemoveAt(k)" + NL
    t = t + "            nOld.RemoveAt(k)" + NL
    t = t + "            nNew.RemoveAt(k)" + NL
    t = t + "            nAt.RemoveAt(k)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    nRoom.Add(mName[i])" + NL
    t = t + "    nOld.Add(old)" + NL
    t = t + "    nNew.Add(nick)" + NL
    t = t + "    nAt.Add(SYS.Ticks)" + NL
    t = t + "    h = PersonAt(mName[i], old)" + NL
    t = t + "    IF h < 0 THEN RETURN" + NL
    t = t + "    pNick[h] = nick" + NL
    t = t + "    FOR k = 0 TO sTag.Count - 1" + NL
    t = t + "        IF sOwner[k] = mName[i] AND sOwnerNick[k].Lower() = old.Lower() THEN" + NL
    t = t + "            sOwnerNick[k] = nick" + NL
    t = t + "            IF sState[k] = ""naming"" OR sState[k] = ""in"" THEN" + NL
    t = t + "                sNick[k] = nick" + NL
    t = t + "                Queue(sTag[k], Chr(1) + ""NICK "" + nick)" + NL
    t = t + "            ELSEIF sState[k] = ""dialing"" THEN" + NL
    t = t + "                sNick[k] = nick" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' names have changed here: anything that clashed may not now" + NL
    t = t + "    ClearClashes(mName[i])" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The name somebody has now, after any renames in the last few seconds." + NL
    t = t + "FUNCTION Current (room AS String, nick AS String) AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    FOR k = 0 TO nRoom.Count - 1" + NL
    t = t + "        IF nRoom[k] = room AND nOld[k].Lower() = nick.Lower() AND SYS.Ticks - nAt[k] <= 10000 THEN nick = nNew[k]" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN nick" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Somebody who came in a moment ago (time for their NICK to catch up):" + NL
    t = t + "' hello, once, and from now on they are linked." + NL
    t = t + "SUB SettleIn ()" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    FOR k = 0 TO pRoom.Count - 1" + NL
    t = t + "        IF NOT pDone[k] AND SYS.Ticks - pAt[k] >= SETTLE THEN" + NL
    t = t + "            pDone[k] = TRUE" + NL
    t = t + "            IF NOT pQuiet[k] THEN Greet(mName.IndexOf(pRoom[k]), pNick[k])" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ linking" + NL
    t = t + "" + NL
    t = t + "' Room i shares the conversation: the bot is in it, and it isn't unlinked." + NL
    t = t + "FUNCTION Linked (i AS Integer) AS Bool" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN mLinked[i] AND mState[i] = ""in""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Linked, on the network at the last look, with somebody settled in it." + NL
    t = t + "FUNCTION Active (i AS Integer) AS Bool" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF NOT Linked(i) THEN RETURN FALSE" + NL
    t = t + "    IF mMissed[i] > 0 THEN RETURN FALSE" + NL
    t = t + "    FOR k = 0 TO pRoom.Count - 1" + NL
    t = t + "        IF pRoom[k] = mName[i] AND pDone[k] THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Settled people in linked rooms other than room." + NL
    t = t + "FUNCTION Elsewhere (room AS String) AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    FOR k = 0 TO pRoom.Count - 1" + NL
    t = t + "        IF pRoom[k] <> room AND pDone[k] AND Linked(mName.IndexOf(pRoom[k])) THEN n = n + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Every settled person in a linked room has a stand-in in every other" + NL
    t = t + "' active room; nobody else has one." + NL
    t = t + "SUB Reconcile ()" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR h AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR owner AS Integer" + NL
    t = t + "    VAR want AS Bool" + NL
    t = t + "    ' stand-ins no longer wanted" + NL
    t = t + "    FOR k = sTag.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF sState[k] = ""closing"" OR sState[k] = ""cancel"" THEN CONTINUE" + NL
    t = t + "        h = PersonAt(sOwner[k], sOwnerNick[k])" + NL
    t = t + "        want = h >= 0" + NL
    t = t + "        IF want THEN want = pDone[h] AND sOwner[k] <> sRoom[k] AND Linked(mName.IndexOf(sOwner[k])) AND Active(mName.IndexOf(sRoom[k]))" + NL
    t = t + "        IF NOT want THEN EndStandIn(k)" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' and ones that are wanted" + NL
    t = t + "    FOR h = 0 TO pRoom.Count - 1" + NL
    t = t + "        IF NOT pDone[h] THEN CONTINUE" + NL
    t = t + "        owner = mName.IndexOf(pRoom[h])" + NL
    t = t + "        IF NOT Linked(owner) THEN CONTINUE" + NL
    t = t + "        FOR j = 0 TO mName.Count - 1" + NL
    t = t + "            IF j = owner OR NOT Active(j) THEN CONTINUE" + NL
    t = t + "            IF HasStandIn(pRoom[h], pNick[h], mName[j]) OR Clashed(pRoom[h], pNick[h], mName[j]) THEN CONTINUE" + NL
    t = t + "            IF sTag.Count >= MOSTLINKS THEN RETURN" + NL
    t = t + "            serial = serial + 1" + NL
    t = t + "            sTag.Add(""S:"" + Str(serial))" + NL
    t = t + "            sRoom.Add(mName[j])" + NL
    t = t + "            sOwner.Add(pRoom[h])" + NL
    t = t + "            sOwnerNick.Add(pNick[h])" + NL
    t = t + "            sNick.Add(pNick[h])" + NL
    t = t + "            sState.Add(""dialing"")" + NL
    t = t + "            sSince.Add(SYS.Ticks)" + NL
    t = t + "            dialQ.Add(""S:"" + Str(serial) + SEP + mAddr[j])" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' a room linked to somebody, whose people haven't been told" + NL
    t = t + "    FOR j = 0 TO mName.Count - 1" + NL
    t = t + "        IF NOT mTold[j] THEN" + NL
    t = t + "            IF Active(j) AND Elsewhere(mName[j]) > 0 THEN" + NL
    t = t + "                mTold[j] = TRUE" + NL
    t = t + "                Say(j, ""This room is linked to "" + channel + "" on every machine: people elsewhere on the network see what's said here. Say unlink to keep it to this machine."")" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION HasStandIn (owner AS String, nick AS String, room AS String) AS Bool" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    FOR k = 0 TO sTag.Count - 1" + NL
    t = t + "        IF sOwner[k] = owner AND sOwnerNick[k].Lower() = nick.Lower() AND sRoom[k] = room THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Clashed (owner AS String, nick AS String, room AS String) AS Bool" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    k = clashKey.IndexOf(owner + ""|"" + nick.Lower() + ""|"" + room)" + NL
    t = t + "    IF k < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN SYS.Ticks - clashAt[k] < CLASHWAIT" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Names in room have changed (somebody left, or renamed): try again there." + NL
    t = t + "SUB ClearClashes (room AS String)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    FOR k = clashKey.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF clashKey[k].EndsWith(""|"" + room) THEN" + NL
    t = t + "            clashKey.RemoveAt(k)" + NL
    t = t + "            clashAt.RemoveAt(k)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Stand-in k goes: closed in its turn (after anything it still has to say)," + NL
    t = t + "' or as soon as it is through, if it is on its way." + NL
    t = t + "SUB EndStandIn (k AS Integer)" + NL
    t = t + "    IF sState[k] = ""dialing"" THEN" + NL
    t = t + "        sState[k] = ""cancel""" + NL
    t = t + "        sSince[k] = SYS.Ticks" + NL
    t = t + "    ELSEIF sState[k] = ""naming"" OR sState[k] = ""in"" THEN" + NL
    t = t + "        sState[k] = ""closing""" + NL
    t = t + "        sSince[k] = SYS.Ticks" + NL
    t = t + "        Queue(sTag[k], Chr(1) + ""CLOSE"")" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DropStandIn (k AS Integer)" + NL
    t = t + "    sTag.RemoveAt(k)" + NL
    t = t + "    sRoom.RemoveAt(k)" + NL
    t = t + "    sOwner.RemoveAt(k)" + NL
    t = t + "    sOwnerNick.RemoveAt(k)" + NL
    t = t + "    sNick.RemoveAt(k)" + NL
    t = t + "    sState.RemoveAt(k)" + NL
    t = t + "    sSince.RemoveAt(k)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' What a stand-in's connection hears: only its own name matters." + NL
    t = t + "SUB StandInHeard (k AS Integer, tag AS String, msg AS String)" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF msg = Chr(1) + ""CONNECTED"" THEN" + NL
    t = t + "        IF sState[k] = ""cancel"" THEN" + NL
    t = t + "            Forget(tag)" + NL
    t = t + "            DropStandIn(k)" + NL
    t = t + "        ELSE" + NL
    t = t + "            sState[k] = ""naming""" + NL
    t = t + "            sSince[k] = SYS.Ticks" + NL
    t = t + "            SendNow(tag, ""NICK "" + sNick[k])" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSEIF msg = Chr(1) + ""FAILED"" OR msg = Chr(1) + ""CLOSED"" THEN" + NL
    t = t + "        Forget(tag)" + NL
    t = t + "        DropStandIn(k)" + NL
    t = t + "    ELSEIF msg.StartsWith(""OK You are now "") THEN" + NL
    t = t + "        IF sState[k] = ""naming"" THEN" + NL
    t = t + "            sState[k] = ""in""" + NL
    t = t + "            sSince[k] = SYS.Ticks" + NL
    t = t + "            Queue(tag, Chr(1) + ""JOIN "" + channel)" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSEIF msg.StartsWith(""ERR Nick in use"") OR msg.StartsWith(""ERR Bad nick"") THEN" + NL
    t = t + "        IF sState[k] <> ""naming"" AND sState[k] <> ""in"" THEN RETURN" + NL
    t = t + "        ' the name is somebody else's there: tell its owner, once, at home" + NL
    t = t + "        key = sOwner[k] + ""|"" + sOwnerNick[k].Lower() + ""|"" + sRoom[k]" + NL
    t = t + "        clashKey.Add(key)" + NL
    t = t + "        clashAt.Add(SYS.Ticks)" + NL
    t = t + "        IF NOT told.Contains(key) THEN" + NL
    t = t + "            told.Add(key)" + NL
    t = t + "            i = mName.IndexOf(sOwner[k])" + NL
    t = t + "            IF i >= 0 THEN Say(i, ""Somebody on "" + Called(sRoom[k]) + "" is already called "" + sOwnerNick[k] + "", so you can't be heard there. /nick gives you another name."")" + NL
    t = t + "            Note(sOwnerNick[k] + ""'s name is taken on "" + sRoom[k])" + NL
    t = t + "        END IF" + NL
    t = t + "        EndStandIn(k)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Somebody in room i said text: their stand-ins say it in the other rooms." + NL
    t = t + "SUB Relay (i AS Integer, nick AS String, text AS String)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    FOR k = 0 TO sTag.Count - 1" + NL
    t = t + "        IF sOwner[k] = mName[i] AND sOwnerNick[k].Lower() = nick.Lower() AND sState[k] = ""in"" THEN Queue(sTag[k], text)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ what it says" + NL
    t = t + "" + NL
    t = t + "SUB Say (i AS Integer, text AS String)" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    IF mState[i] <> ""in"" THEN RETURN" + NL
    t = t + "    Queue(mTag[i], text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Hello, once for each person on each machine." + NL
    t = t + "SUB Greet (i AS Integer, nick AS String)" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR names AS Array OF String" + NL
    t = t + "    VAR site AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    key = mName[i].Split(""."")[0] + ""|"" + nick.Lower()" + NL
    t = t + "    IF seen.Contains(key) THEN RETURN" + NL
    t = t + "    seen.Add(key)" + NL
    t = t + "    FS.Append(HOME + ""\SEEN.TXT"", key + EOL)" + NL
    t = t + "    greeted = greeted + 1" + NL
    t = t + "    FOR EACH site IN Sites()" + NL
    t = t + "        names.Add(site.Split(""|"")[0])" + NL
    t = t + "    NEXT" + NL
    t = t + "    Say(i, ""Hi "" + nick + "", welcome to SIM95! I'm the greeter bot from "" + here.Upper() + ""."")" + NL
    t = t + "    IF names.Count = 0 THEN" + NL
    t = t + "        Say(i, ""Open Voyager and go to http://"" + here + ""/ to see what's on."")" + NL
    t = t + "    ELSE" + NL
    t = t + "        Say(i, ""Open Voyager and go to http://"" + here + ""/ for "" + Listed(names) + ""."")" + NL
    t = t + "    END IF" + NL
    t = t + "    n = Elsewhere(mName[i])" + NL
    t = t + "    IF mLinked[i] THEN" + NL
    t = t + "        mTold[i] = TRUE" + NL
    t = t + "        IF n > 0 THEN" + NL
    t = t + "            Say(i, ""This room is linked to "" + channel + "" on every machine: "" + Str(n) + "" "" + People(n) + "" elsewhere on the network can talk with you here, and see what you say."")" + NL
    t = t + "        ELSE" + NL
    t = t + "            Say(i, ""This room is linked to "" + channel + "" on every machine: whoever comes in anywhere on the network will be here too, and see what you say."")" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSE" + NL
    t = t + "        Say(i, ""Say link to talk with everybody in "" + channel + "" across the network ("" + Str(n) + "" "" + People(n) + "" now)."")" + NL
    t = t + "    END IF" + NL
    t = t + "    IF IsHub(i) THEN" + NL
    t = t + "        Say(i, ""Say sites for the list, or who for who's here."")" + NL
    t = t + "    ELSEIF mLinked[i] THEN" + NL
    t = t + "        Say(i, ""Say sites for the list, who for who's here, unlink to keep this room to this machine, or bye and I'll leave it alone."")" + NL
    t = t + "    ELSE" + NL
    t = t + "        Say(i, ""Say sites for the list, or bye and I'll leave this machine alone."")" + NL
    t = t + "    END IF" + NL
    t = t + "    Note(""Greeted "" + nick + "" on "" + mName[i])" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Somebody said something in room i: sites, who, link, unlink or bye." + NL
    t = t + "SUB Obey (i AS Integer, nick AS String, text AS String)" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR site AS String" + NL
    t = t + "    VAR all AS Array OF String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    t = text.Trim().Lower()" + NL
    t = t + "    ' ""StartHereBot: sites"" too" + NL
    t = t + "    IF t.StartsWith(mNick[i].Lower()) THEN t = t.Substring(mNick[i].Length, t.Length - mNick[i].Length)" + NL
    t = t + "    t = Bare(t)" + NL
    t = t + "    IF t = ""sites"" OR t = ""!sites"" OR t = ""help"" THEN" + NL
    t = t + "        IF mListed[i] <> 0 AND SYS.Ticks - mListed[i] < QUIET THEN RETURN" + NL
    t = t + "        mListed[i] = MATH.Max(1, SYS.Ticks)" + NL
    t = t + "        all = Sites()" + NL
    t = t + "        IF all.Count = 0 THEN Say(i, ""Everything is at http://"" + here + ""/"")" + NL
    t = t + "        FOR EACH site IN all" + NL
    t = t + "            p = site.Split(""|"")" + NL
    t = t + "            Say(i, p[0] + "" - "" + p[1] + "" - "" + p[2])" + NL
    t = t + "        NEXT" + NL
    t = t + "        Note(""Listed the sites for "" + nick + "" on "" + mName[i])" + NL
    t = t + "    ELSEIF t = ""who"" OR t = ""!who"" THEN" + NL
    t = t + "        IF mListed[i] <> 0 AND SYS.Ticks - mListed[i] < QUIET THEN RETURN" + NL
    t = t + "        mListed[i] = MATH.Max(1, SYS.Ticks)" + NL
    t = t + "        Say(i, WhoLine(i))" + NL
    t = t + "    ELSEIF t = ""unlink"" AND IsHub(i) THEN" + NL
    t = t + "        Say(i, ""This is where everybody meets: it stays linked."")" + NL
    t = t + "    ELSEIF t = ""unlink"" AND mLinked[i] THEN" + NL
    t = t + "        mLinked[i] = FALSE" + NL
    t = t + "        FS.Append(HOME + ""\UNLINK.TXT"", Called(mName[i]) + EOL)" + NL
    t = t + "        Say(i, ""Unlinked: only people on this machine see this room now. Say link to talk with everybody again."")" + NL
    t = t + "        Note(nick + "" unlinked "" + mName[i])" + NL
    t = t + "    ELSEIF t = ""link"" AND NOT mLinked[i] THEN" + NL
    t = t + "        mLinked[i] = TRUE" + NL
    t = t + "        FS.Write(HOME + ""\UNLINK.TXT"", Without(ReadOr(HOME + ""\UNLINK.TXT"", """"), Called(mName[i])))" + NL
    t = t + "        mTold[i] = TRUE" + NL
    t = t + "        k = Elsewhere(mName[i])" + NL
    t = t + "        Say(i, ""Linked: you're in "" + channel + "" with everybody on the network ("" + Str(k) + "" "" + People(k) + "" elsewhere now). Say unlink to undo it."")" + NL
    t = t + "        Note(nick + "" linked "" + mName[i])" + NL
    t = t + "    ELSEIF (t = ""bye"" OR t = ""go away"" OR t = ""leave"") AND NOT IsHub(i) THEN" + NL
    t = t + "        Say(i, ""OK, I'll leave this machine alone. Find us any time at http://"" + here + ""/ - bye!"")" + NL
    t = t + "        Queue(mTag[i], Chr(1) + ""CLOSE"")" + NL
    t = t + "        FS.Append(HOME + ""\OPTOUT.TXT"", Called(mName[i]) + EOL)" + NL
    t = t + "        Note(nick + "" said bye: leaving "" + mName[i] + "" alone"")" + NL
    t = t + "        ' (its connection closes after the goodbye; the rest at once)" + NL
    t = t + "        mTag[i] = """"" + NL
    t = t + "        RoomDown(i, ""left"")" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ""Here now: newbie (newbie), regular (starthere)"" - everybody in the" + NL
    t = t + "' conversation, as this room sees it." + NL
    t = t + "FUNCTION WhoLine (i AS Integer) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR more AS Integer" + NL
    t = t + "    FOR k = 0 TO pRoom.Count - 1" + NL
    t = t + "        IF NOT pDone[k] THEN CONTINUE" + NL
    t = t + "        IF pRoom[k] <> mName[i] AND NOT (Linked(i) AND Linked(mName.IndexOf(pRoom[k]))) THEN CONTINUE" + NL
    t = t + "        IF out.Length > 300 THEN" + NL
    t = t + "            more = more + 1" + NL
    t = t + "        ELSE" + NL
    t = t + "            IF n > 0 THEN out = out + "", """ + NL
    t = t + "            out = out + pNick[k] + "" ("" + Called(pRoom[k]) + "")""" + NL
    t = t + "            n = n + 1" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF n = 0 THEN RETURN ""Nobody else is here right now.""" + NL
    t = t + "    IF more > 0 THEN out = out + "" and "" + Str(more) + "" more""" + NL
    t = t + "    RETURN ""Here now: "" + out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Without the bits around a word: "": sites!"" -> ""sites""" + NL
    t = t + "FUNCTION Bare (t AS String) AS String" + NL
    t = t + "    WHILE t.Length > 0 AND "":,; "".Contains(t.Substring(0, 1))" + NL
    t = t + "        t = t.Substring(1, t.Length - 1)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    WHILE t.Length > 0 AND ""!.? "".Contains(t.Substring(t.Length - 1, 1))" + NL
    t = t + "        t = t.Substring(0, t.Length - 1)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN t" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""SimBook, ColdMail and AskSim""; after six, ""and more""." + NL
    t = t + "FUNCTION Listed (names AS Array OF String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF names.Count = 1 THEN RETURN names[0]" + NL
    t = t + "    FOR k = 0 TO MATH.Min(names.Count, 6) - 1" + NL
    t = t + "        IF k > 0 THEN" + NL
    t = t + "            IF k = names.Count - 1 THEN" + NL
    t = t + "                out = out + "" and """ + NL
    t = t + "            ELSE" + NL
    t = t + "                out = out + "", """ + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        out = out + names[k]" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF names.Count > 6 THEN out = out + "" and more""" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The sites here, as SimHost's front page lists them: name|address|blurb." + NL
    t = t + "' A folder of C:\WEB with an APP.INF (name|blurb|colour) says how it shows;" + NL
    t = t + "' the list below covers apps installed before they wrote one." + NL
    t = t + "FUNCTION Sites () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR known AS Array OF String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR k AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    known = [""BOOK|BOOK.SPK|SimBook|The social network: profiles, friends, a news feed, walls, photos and pokes."", ""MAIL|MAIL.SPK|ColdMail|Free webmail, with a real mail server behind it."", ""ASK|ASK.SPK|AskSim|A search engine with a real crawler that goes round every machine on the network."", ""GEO|GEO.SPK|GeoSimies|Free homepages for everybody: neighborhoods, hit counters, guestbooks and webrings."", ""WIKI|WIKI.SPK|WikiSim|The encyclopedia: hundreds of articles from Wikipedia, as of 1996."", ""ELIZA|BOT.SPK|ELIZA-95|A chatbot with Language-Model-of-Certain-Size manners."", ""PAL|PAL.SPK|SimPal|Send and request money in SimBucks."", ""TUBE|TUBE.SPK|SimTube|Movies: watch them, put yours up, give them stars."", ""STATS|STATS.SPK|SimStats|Web statistics for any site."", ""VAPOR|CATALOG.TXT|Vapor|The store: games and every SIM95 program, for your own machine.""]" + NL
    t = t + "    IF NOT FS.Exists(""C:\WEB"") THEN RETURN out" + NL
    t = t + "    FOR EACH f IN FS.List(""C:\WEB"")" + NL
    t = t + "        IF NOT f.EndsWith(""\"") THEN CONTINUE" + NL
    t = t + "        f = f.Substring(0, f.Length - 1).Upper()" + NL
    t = t + "        IF FS.Exists(""C:\WEB\"" + f + ""\APP.INF"") THEN" + NL
    t = t + "            p = FS.Read(""C:\WEB\"" + f + ""\APP.INF"").Trim().Split(""|"")" + NL
    t = t + "            IF p.Count >= 2 THEN" + NL
    t = t + "                out.Add(p[0] + ""|http://"" + here + ""/"" + f.Lower() + ""/|"" + p[1])" + NL
    t = t + "                CONTINUE" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        FOR EACH k IN known" + NL
    t = t + "            p = k.Split(""|"")" + NL
    t = t + "            IF p[0] = f AND FS.Exists(""C:\WEB\"" + f + ""\"" + p[1]) THEN out.Add(p[2] + ""|http://"" + here + ""/"" + f.Lower() + ""/|"" + p[3])" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\PROGRAMS\WELCOME.SPK")
END SUB

SUB StartService (name AS String, program AS String, runFile AS String)
    VAR task AS String
    FS.Write("C:\SYSTEM\STARTUP\" + runFile, program)
    Print("  " + name + " will start with the machine (C:\SYSTEM\STARTUP\" + runFile + ")")
    FOR EACH task IN SYS.Tasks()
        IF task.Split("|")[1].Upper() = name THEN
            SYS.Kill(Int(Val(task.Split("|")[0])))
            Print("  stopped the old " + name)
        END IF
    NEXT
    SYS.Run(program)
    Print("  started " + program)
END SUB

VAR welcomeWin AS GUI_Window

' The central host, or a yes to installing it somewhere else anyway.
FUNCTION WelcomeHere () AS Bool
    VAR box AS GUI_MessageBox
    IF NET.HostName.Lower() = "starthere.56k.net" THEN RETURN TRUE
    welcomeWin = GUI_Window.New("Welcome Wagon Setup", 10, 10)
    box = GUI_MessageBox.New(welcomeWin)
    box.Title = "Welcome Wagon Setup"
    box.Kind = "warn"
    box.Buttons = "yesno"
    box.Text = "This machine is " + NET.HostName.Upper() + ", not STARTHERE.56K.NET." + NL + NL _
        + "The Welcome Wagon is meant for the central host: with two of them, every newcomer is greeted twice, and told about two places." + NL + NL _
        + "Install it here anyway (for testing, say)?"
    IF box.Show() THEN
        welcomeWin.Close()
        Print("  (not the central host, starthere.56k.net: installing anyway)")
        RETURN TRUE
    END IF
    Print("The Welcome Wagon was not installed: it belongs on starthere.56k.net.")
    SYS.Exit(0)
    RETURN FALSE
END FUNCTION
