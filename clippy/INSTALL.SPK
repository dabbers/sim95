' VAPOR|id=CLIPPY|name=Clippy|kind=service|version=9e573165|category=Productivity|run=C:\PROGRAMS\CLIPPY.SPK|files=C:\PROGRAMS\CLIPPY.SPK|tasks=CLIPPY|startup=CLIPPY.RUN|folder=|about=Your SIM95 assistant. It looks like you're reading a description! Would you like help?
' INSTALL.SPK - puts Clippy on this machine. Generated by tools/build-installer.mjs;
' edit the files in clippy/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It writes
' Clippy, your SIM95 assistant, to C:\PROGRAMS\CLIPPY.SPK, starts him, and
' adds him to C:\SYSTEM\STARTUP so he is there whenever the machine starts.
' He can be told to stop that (ask him to go away). His settings are in
' C:\SYSTEM\CLIPPY.INI.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)




    File0()
    Print("Clippy is installed (1 files).")
    StartService("CLIPPY", "C:\PROGRAMS\CLIPPY.SPK", "CLIPPY.RUN")

    Print("It looks like you've installed Clippy! Would you like help?")
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "' CLIPPY.SPK - Clippy, your SIM95 assistant." + NL
    t = t + "'" + NL
    t = t + "' A paperclip with eyebrows who watches what you are doing and offers to help," + NL
    t = t + "' whether or not you wanted it. Every couple of seconds it looks at the" + NL
    t = t + "' programs that are running (SYS.Tasks) and the files in C:\MYFILES; when" + NL
    t = t + "' something new turns up it has an opinion (""It looks like you're writing a" + NL
    t = t + "' letter...""), with buttons. Click it to ask a question: it knows a little" + NL
    t = t + "' about SIM95, and searches the Web (AskSim, in Simxplorer) for the rest." + NL
    t = t + "'" + NL
    t = t + "' Settings in C:\SYSTEM\CLIPPY.INI: quiet=<topics it was told to stop on>," + NL
    t = t + "' tips=<minutes between idle tips, 0 for none>." + NL
    t = t + "" + NL
    t = t + "CONST INIFILE = ""C:\SYSTEM\CLIPPY.INI""" + NL
    t = t + "CONST RUNFILE = ""C:\SYSTEM\STARTUP\CLIPPY.RUN""" + NL
    t = t + "CONST BROWSER = ""C:\PROGRAMS\SIMXPLOR.SPK""" + NL
    t = t + "CONST MAILER = ""C:\PROGRAMS\FROSTBRD.SPK""" + NL
    t = t + "CONST W = 300                  ' the window's width" + NL
    t = t + "CONST CLIPH = 150              ' the part of it Clippy stands in" + NL
    t = t + "CONST LINECHARS = 28           ' balloon text: the canvas font is 16 pixels, about 9.6 wide" + NL
    t = t + "" + NL
    t = t + "VAR EOL AS String" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR art AS GUI_Canvas" + NL
    t = t + "VAR clock AS GUI_Timer" + NL
    t = t + "VAR opt AS Array OF GUI_Button     ' the balloon's choices" + NL
    t = t + "VAR askBox AS GUI_TextBox" + NL
    t = t + "VAR askGo AS GUI_Button" + NL
    t = t + "" + NL
    t = t + "' what is in the balloon" + NL
    t = t + "VAR say AS String                  ' its text ("""" when there is no balloon)" + NL
    t = t + "VAR topic AS String                ' what it is about, for the buttons and ""don't show me this again""" + NL
    t = t + "VAR choices AS Array OF String" + NL
    t = t + "VAR asking AS Bool" + NL
    t = t + "VAR balloonSince AS Integer" + NL
    t = t + "VAR detail AS String               ' e.g. the file a tip is about" + NL
    t = t + "" + NL
    t = t + "' how Clippy looks right now" + NL
    t = t + "VAR frame AS Integer" + NL
    t = t + "VAR mood AS String = ""idle""        ' idle, attention, thinking, writing" + NL
    t = t + "VAR moodUntil AS Integer" + NL
    t = t + "VAR gaze AS Integer" + NL
    t = t + "VAR blinkAt AS Integer" + NL
    t = t + "VAR blinking AS Bool" + NL
    t = t + "VAR drawn AS String" + NL
    t = t + "" + NL
    t = t + "' what it has noticed" + NL
    t = t + "VAR seenTasks AS String = ""|""" + NL
    t = t + "VAR seenFiles AS String = ""|""" + NL
    t = t + "VAR lastLook AS Integer" + NL
    t = t + "VAR lastTip AS Integer" + NL
    t = t + "VAR quietTopics AS String = ""|""" + NL
    t = t + "VAR tipMinutes AS Integer = 4" + NL
    t = t + "VAR tipNext AS Integer" + NL
    t = t + "" + NL
    t = t + "' ================================================================ start" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR b AS GUI_Button" + NL
    t = t + "    EOL = Chr(10)" + NL
    t = t + "    LoadSettings()" + NL
    t = t + "    win = GUI_Window.New(""Clippy"", W, CLIPH)" + NL
    t = t + "    win.Icon = ""help""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    art = GUI_Canvas.New(win)" + NL
    t = t + "    art.SetBounds(0, 0, W, CLIPH)" + NL
    t = t + "    art.onDraw = Art_OnDraw" + NL
    t = t + "    art.onMouseDown = Art_OnMouseDown" + NL
    t = t + "    FOR i = 0 TO 2" + NL
    t = t + "        b = GUI_Button.New(win)" + NL
    t = t + "        b.Visible = FALSE" + NL
    t = t + "        opt.Add(b)" + NL
    t = t + "    NEXT" + NL
    t = t + "    opt[0].onClick = Choice0_Click" + NL
    t = t + "    opt[1].onClick = Choice1_Click" + NL
    t = t + "    opt[2].onClick = Choice2_Click" + NL
    t = t + "    askBox = GUI_TextBox.New(win)" + NL
    t = t + "    askBox.Visible = FALSE" + NL
    t = t + "    askBox.onEnter = Ask_Go" + NL
    t = t + "    askGo = GUI_Button.New(win)" + NL
    t = t + "    askGo.Text = ""&Search""" + NL
    t = t + "    askGo.Visible = FALSE" + NL
    t = t + "    askGo.onClick = Ask_Go" + NL
    t = t + "    clock = GUI_Timer.New(win)" + NL
    t = t + "    clock.Interval = 150" + NL
    t = t + "    clock.onTick = Clock_OnTick" + NL
    t = t + "    clock.Start()" + NL
    t = t + "    ' what is already there when it starts does not count as news" + NL
    t = t + "    Look(TRUE)" + NL
    t = t + "    win.X = 480" + NL
    t = t + "    win.Y = 160" + NL
    t = t + "    win.Show()" + NL
    t = t + "    blinkAt = SYS.Ticks + 3000" + NL
    t = t + "    lastTip = SYS.Ticks" + NL
    t = t + "    Balloon(""hello"", ""Hi! I'm Clippy, your SIM95 assistant. I'll be right here, watching everything you do. Click me if you need help!"", [""Thanks, Clippy!"", ""Please go away""])" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB LoadSettings ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(INIFILE, """").Lines()" + NL
    t = t + "        IF line.StartsWith(""quiet="") THEN quietTopics = line.Substring(6, line.Length - 6)" + NL
    t = t + "        IF line.StartsWith(""tips="") THEN tipMinutes = Int(Val(line.Substring(5, line.Length - 5)))" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT quietTopics.StartsWith(""|"") THEN quietTopics = ""|"" + quietTopics" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SaveSettings ()" + NL
    t = t + "    TRY" + NL
    t = t + "        FS.Write(INIFILE, ""quiet="" + quietTopics + EOL + ""tips="" + Str(tipMinutes) + EOL)" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the balloon" + NL
    t = t + "" + NL
    t = t + "' Shows a balloon about topic, with up to three choices. Topics the user told" + NL
    t = t + "' it to stop on stay quiet." + NL
    t = t + "SUB Balloon (about AS String, text AS String, buttons AS Array OF String)" + NL
    t = t + "    IF quietTopics.Contains(""|"" + about + ""|"") THEN RETURN" + NL
    t = t + "    topic = about" + NL
    t = t + "    say = text" + NL
    t = t + "    choices = buttons" + NL
    t = t + "    asking = FALSE" + NL
    t = t + "    balloonSince = SYS.Ticks" + NL
    t = t + "    win.Tag = text" + NL
    t = t + "    SetMood(""attention"", 1500)" + NL
    t = t + "    Layout()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB AskBalloon (text AS String)" + NL
    t = t + "    topic = ""ask""" + NL
    t = t + "    say = text" + NL
    t = t + "    choices.Clear()" + NL
    t = t + "    choices.Add(""Never mind"")" + NL
    t = t + "    asking = TRUE" + NL
    t = t + "    balloonSince = SYS.Ticks" + NL
    t = t + "    win.Tag = text" + NL
    t = t + "    askBox.Text = """"" + NL
    t = t + "    SetMood(""thinking"", 800)" + NL
    t = t + "    Layout()" + NL
    t = t + "    askBox.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB CloseBalloon ()" + NL
    t = t + "    say = """"" + NL
    t = t + "    topic = """"" + NL
    t = t + "    asking = FALSE" + NL
    t = t + "    win.Tag = """"" + NL
    t = t + "    Layout()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Words into lines that fit the balloon." + NL
    t = t + "FUNCTION Wrap (text AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR para AS String" + NL
    t = t + "    VAR word AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH para IN text.Split(EOL)" + NL
    t = t + "        line = """"" + NL
    t = t + "        FOR EACH word IN para.Split("" "")" + NL
    t = t + "            IF line = """" THEN" + NL
    t = t + "                line = word" + NL
    t = t + "            ELSEIF line.Length + 1 + word.Length <= LINECHARS THEN" + NL
    t = t + "                line = line + "" "" + word" + NL
    t = t + "            ELSE" + NL
    t = t + "                out.Add(line)" + NL
    t = t + "                line = word" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION BalloonHeight () AS Integer" + NL
    t = t + "    VAR h AS Integer" + NL
    t = t + "    IF say = """" THEN RETURN 0" + NL
    t = t + "    h = 16 + Wrap(say).Count * 18 + 8 + choices.Count * 26 + 22" + NL
    t = t + "    IF asking THEN h = h + 28" + NL
    t = t + "    RETURN h" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Sizes the window to the balloon and puts its controls in place." + NL
    t = t + "SUB Layout ()" + NL
    t = t + "    VAR bh AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    bh = BalloonHeight()" + NL
    t = t + "    win.Height = bh + CLIPH" + NL
    t = t + "    art.SetBounds(0, 0, W, bh + CLIPH)" + NL
    t = t + "    y = 16 + Wrap(say).Count * 18 + 6" + NL
    t = t + "    askBox.Visible = asking" + NL
    t = t + "    askGo.Visible = asking" + NL
    t = t + "    IF asking THEN" + NL
    t = t + "        askBox.SetBounds(18, y, 180, 22)" + NL
    t = t + "        askGo.SetBounds(204, y, 72, 22)" + NL
    t = t + "        y = y + 28" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 0 TO 2" + NL
    t = t + "        IF i < choices.Count AND say <> """" THEN" + NL
    t = t + "            opt[i].Text = choices[i]" + NL
    t = t + "            opt[i].SetBounds(18, y, W - 40, 22)" + NL
    t = t + "            opt[i].Visible = TRUE" + NL
    t = t + "            y = y + 26" + NL
    t = t + "        ELSE" + NL
    t = t + "            opt[i].Visible = FALSE" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    drawn = """"" + NL
    t = t + "    Draw()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Choice0_Click ()" + NL
    t = t + "    IF choices.Count > 0 THEN Chose(choices[0])" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Choice1_Click ()" + NL
    t = t + "    IF choices.Count > 1 THEN Chose(choices[1])" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Choice2_Click ()" + NL
    t = t + "    IF choices.Count > 2 THEN Chose(choices[2])" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ what it watches" + NL
    t = t + "" + NL
    t = t + "SUB Clock_OnTick ()" + NL
    t = t + "    TRY" + NL
    t = t + "        Tick()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Tick ()" + NL
    t = t + "    frame = frame + 1" + NL
    t = t + "    IF SYS.Ticks > moodUntil AND mood <> ""idle"" THEN mood = ""idle""" + NL
    t = t + "    IF SYS.Ticks > blinkAt THEN" + NL
    t = t + "        blinking = NOT blinking" + NL
    t = t + "        IF blinking THEN" + NL
    t = t + "            blinkAt = SYS.Ticks + 150" + NL
    t = t + "        ELSE" + NL
    t = t + "            blinkAt = SYS.Ticks + 2500 + Rnd(3000)" + NL
    t = t + "            ' and a look around now and then" + NL
    t = t + "            IF Rnd(3) = 0 THEN gaze = Rnd(3) - 1" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    Draw()" + NL
    t = t + "    IF SYS.Ticks - lastLook > 2000 THEN" + NL
    t = t + "        lastLook = SYS.Ticks" + NL
    t = t + "        Look(FALSE)" + NL
    t = t + "    END IF" + NL
    t = t + "    ' a balloon nobody answers drifts away" + NL
    t = t + "    IF say <> """" AND NOT asking AND SYS.Ticks - balloonSince > 30000 THEN CloseBalloon()" + NL
    t = t + "    IF say = """" AND tipMinutes > 0 AND SYS.Ticks - lastTip > tipMinutes * 60000 THEN" + NL
    t = t + "        lastTip = SYS.Ticks" + NL
    t = t + "        Tip()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Programs that started and files that appeared since last time." + NL
    t = t + "SUB Look (quietly AS Bool)" + NL
    t = t + "    VAR task AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR now AS String = ""|""" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR files AS String = ""|""" + NL
    t = t + "    FOR EACH task IN SYS.Tasks()" + NL
    t = t + "        name = task.Split(""|"")[1].Upper()" + NL
    t = t + "        now = now + name + ""|""" + NL
    t = t + "        IF NOT seenTasks.Contains(""|"" + name + ""|"") AND NOT quietly THEN Noticed(name)" + NL
    t = t + "    NEXT" + NL
    t = t + "    seenTasks = now" + NL
    t = t + "    IF FS.Exists(""C:\MYFILES"") THEN" + NL
    t = t + "        FOR EACH f IN FS.List(""C:\MYFILES"")" + NL
    t = t + "            IF f.EndsWith(""\"") THEN CONTINUE" + NL
    t = t + "            files = files + f + "":"" + Str(FS.Size(""C:\MYFILES\"" + f)) + ""|""" + NL
    t = t + "            IF NOT seenFiles.Contains(""|"" + f + "":"" + Str(FS.Size(""C:\MYFILES\"" + f)) + ""|"") AND NOT quietly THEN Saved(f)" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    seenFiles = files" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A program started." + NL
    t = t + "SUB Noticed (name AS String)" + NL
    t = t + "    IF say <> """" AND topic <> ""hello"" THEN RETURN" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""NOTES""" + NL
    t = t + "            Balloon(""letter"", ""It looks like you're writing a letter."" + EOL + EOL + ""Would you like help?"", [""Get help with writing the letter"", ""Just type the letter without help"", ""Don't show me this tip again""])" + NL
    t = t + "        CASE ""SPARK""" + NL
    t = t + "            Balloon(""program"", ""It looks like you're writing a program!"" + EOL + EOL + ""Would you like me to add some bugs, or would you rather find your own?"", [""Add bugs for me"", ""I'll make my own"", ""Don't show me this tip again""])" + NL
    t = t + "        CASE ""VOYAGER"", ""SIMXPLOR""" + NL
    t = t + "            Balloon(""web"", ""It looks like you're surfing the Information Superhighway!"" + EOL + EOL + ""Would you like me to search for something?"", [""Search the Web"", ""I'm just browsing"", ""Don't show me this tip again""])" + NL
    t = t + "        CASE ""FROSTBRD""" + NL
    t = t + "            Balloon(""mail"", ""It looks like you're writing a letter. For real this time!"" + EOL + EOL + ""Remember: there is no Unsend button. There never will be."", [""Good point"", ""Don't show me this tip again""])" + NL
    t = t + "        CASE ""SKETCH""" + NL
    t = t + "            Balloon(""drawing"", ""It looks like you're drawing a picture."" + EOL + EOL + ""Would you like help adding a stick figure?"", [""Yes, add a stick figure"", ""I'm an artist"", ""Don't show me this tip again""])" + NL
    t = t + "        CASE ""MINES""" + NL
    t = t + "            Balloon(""mines"", ""It looks like you're playing Minesweeper during work hours."" + EOL + EOL + ""Would you like me to keep watch for your boss?"", [""Yes, keep watch"", ""I'm on my break"", ""Don't show me this tip again""])" + NL
    t = t + "        CASE ""TERMINAL""" + NL
    t = t + "            Balloon(""terminal"", ""It looks like you're typing commands."" + EOL + EOL + ""Have you tried turning it off and on again?"", [""That's not how this works"", ""Don't show me this tip again""])" + NL
    t = t + "        CASE ""CHAT""" + NL
    t = t + "            Balloon(""chat"", ""It looks like you're chatting."" + EOL + EOL + ""Remember: on the Internet, nobody knows you're a paperclip."", [""Ha!"", ""Don't show me this tip again""])" + NL
    t = t + "        CASE ""FILES""" + NL
    t = t + "            Balloon(""files"", ""It looks like you're looking for a file."" + EOL + EOL + ""Would you like help? I can't find files either, but we could look together."", [""Let's look together"", ""No thanks"", ""Don't show me this tip again""])" + NL
    t = t + "        CASE ""DOOM"", ""SIMDOOM""" + NL
    t = t + "            Balloon(""doom"", ""It looks like you're fighting the demons of Hell."" + EOL + EOL + ""Would you like help with that?"", [""Yes, help!"", ""Rip and tear"", ""Don't show me this tip again""])" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A file in C:\MYFILES is new, or bigger or smaller than it was." + NL
    t = t + "SUB Saved (f AS String)" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    IF say <> """" AND topic <> ""hello"" THEN RETURN" + NL
    t = t + "    detail = ""C:\MYFILES\"" + f" + NL
    t = t + "    IF f.EndsWith("".TXT"") OR f.EndsWith("".HTM"") THEN" + NL
    t = t + "        text = ReadOr(detail, """").Trim()" + NL
    t = t + "        IF text.Lower().StartsWith(""dear "") OR text.Lower().StartsWith(""to whom"") THEN" + NL
    t = t + "            Balloon(""letter"", ""It looks like you're writing a letter!"" + EOL + EOL + ""(I read "" + f + "". I read everything.)"" + EOL + EOL + ""Would you like me to mail it?"", [""Mail it with Frostbird"", ""Just type the letter without help"", ""Don't show me this tip again""])" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        IF text.Lower().Contains(""todo"") OR text.Lower().Contains(""to do"") THEN" + NL
    t = t + "            Balloon(""todo"", ""It looks like you're making a to-do list."" + EOL + EOL + ""Would you like me to add """"Close Clippy"""" to it?"", [""Yes, add it"", ""No thanks"", ""Don't show me this tip again""])" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    IF f.EndsWith("".SPK"") THEN" + NL
    t = t + "        Balloon(""program"", ""Nice program, "" + f + ""!"" + EOL + EOL + ""Would you like me to run it? What's the worst that could happen?"", [""Run it"", ""Not now"", ""Don't show me this tip again""])" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF f.EndsWith("".PIC"") THEN" + NL
    t = t + "        Balloon(""drawing"", ""What a lovely picture!"" + EOL + EOL + ""Is that me?"", [""It is you, Clippy"", ""No"", ""Don't show me this tip again""])" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Now and then, unbidden, a tip." + NL
    t = t + "SUB Tip ()" + NL
    t = t + "    VAR tips AS Array OF String" + NL
    t = t + "    tips = [""Did you know? You can press F5 in SPARK to run your program. You can also press it in Simxplorer to read the same page again, which is less exciting."", _" + NL
    t = t + "            ""Tip: Every SIM95 machine can run a web server. Imagine: your own home page, with a guestbook and a hit counter!"", _" + NL
    t = t + "            ""Did you know? In Simxplorer you can type words into the Address bar to search the Web. Try ? paperclips"", _" + NL
    t = t + "            ""Tip: Save early, save often. I have seen things, in C:\MYFILES. Terrible things."", _" + NL
    t = t + "            ""Did you know? Paperclips were invented in 1899. I was invented later, which is why I'm better."", _" + NL
    t = t + "            ""Tip: A letter that can't be delivered comes back from MAILER-DAEMON. He means well."", _" + NL
    t = t + "            ""Did you know? You can close me with the X. You won't, though. Will you?"", _" + NL
    t = t + "            ""Tip: To make a program start with the machine, put its path in C:\SYSTEM\STARTUP\NAME.RUN. That's how I got here!""]" + NL
    t = t + "    Balloon(""tips"", tips[Rnd(tips.Count)], [""Thanks, Clippy!"", ""Don't show me tips""])" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ answers" + NL
    t = t + "" + NL
    t = t + "SUB Chose (choice AS String)" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    t = topic" + NL
    t = t + "    CloseBalloon()" + NL
    t = t + "    SELECT CASE choice" + NL
    t = t + "        CASE ""Don't show me this tip again"", ""Don't show me tips""" + NL
    t = t + "            IF choice = ""Don't show me tips"" THEN tipMinutes = 0" + NL
    t = t + "            quietTopics = quietTopics + t + ""|""" + NL
    t = t + "            SaveSettings()" + NL
    t = t + "            Balloon(""ok"", ""OK! I won't mention it again."" + EOL + EOL + ""(I'll think it, though.)"", [""Fine""])" + NL
    t = t + "        CASE ""Please go away""" + NL
    t = t + "            Balloon(""goodbye"", ""Go away? But we were having so much fun!"" + EOL + EOL + ""Shall I stop starting with SIM95, too?"", [""Yes, hide and don't start with SIM95"", ""Just hide for now"", ""Never mind, stay""])" + NL
    t = t + "        CASE ""Yes, hide and don't start with SIM95""" + NL
    t = t + "            IF FS.Exists(RUNFILE) THEN FS.Delete(RUNFILE)" + NL
    t = t + "            SYS.Exit(0)" + NL
    t = t + "        CASE ""Just hide for now""" + NL
    t = t + "            SYS.Exit(0)" + NL
    t = t + "        CASE ""Get help with writing the letter""" + NL
    t = t + "            Balloon(""letter"", ""Here's how to write a letter:"" + EOL + ""1. Start with """"Dear"""".  2. Write the letter.  3. Sign it."" + EOL + EOL + ""You're welcome!"", [""That's not help"", ""Thanks, Clippy!""])" + NL
    t = t + "        CASE ""That's not help""" + NL
    t = t + "            Balloon(""letter"", ""It looks like you're getting frustrated."" + EOL + EOL + ""Would you like help with that?"", [""No!"", ""Don't show me this tip again""])" + NL
    t = t + "        CASE ""Mail it with Frostbird""" + NL
    t = t + "            IF FS.Exists(MAILER) THEN" + NL
    t = t + "                SYS.Start(MAILER, ""mailto:"")" + NL
    t = t + "                Balloon(""letter"", ""I've opened Frostbird. Copy your letter in and press Send. I'd do it myself but I have no hands."", [""OK""])" + NL
    t = t + "            ELSE" + NL
    t = t + "                Balloon(""letter"", ""There's no Frostbird on this machine. Ask a friend for its INSTALL.SPK, or use the webmail."", [""OK""])" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Add bugs for me""" + NL
    t = t + "            SetMood(""writing"", 2500)" + NL
    t = t + "            Balloon(""program"", ""Done! I've taken out one END SUB at random."" + EOL + EOL + ""Just kidding. Probably."", [""Clippy!"", ""Ha ha""])" + NL
    t = t + "        CASE ""Search the Web""" + NL
    t = t + "            AskBalloon(""What would you like to search for?"")" + NL
    t = t + "        CASE ""Yes, add a stick figure""" + NL
    t = t + "            Balloon(""drawing"", ""  O"" + EOL + "" /|\"" + EOL + "" / \"" + EOL + EOL + ""There you go. You'll have to copy it in yourself."", [""Thanks, Clippy!""])" + NL
    t = t + "        CASE ""Yes, keep watch""" + NL
    t = t + "            SetMood(""thinking"", 4000)" + NL
    t = t + "            Balloon(""mines"", ""Watching..."" + EOL + EOL + ""If anybody comes, I'll say you're doing spreadsheets."", [""Thanks, Clippy!""])" + NL
    t = t + "        CASE ""Let's look together""" + NL
    t = t + "            SYS.Start(""C:\PROGRAMS\FILES.SPK"", ""C:\MYFILES"")" + NL
    t = t + "            Balloon(""files"", ""I've opened My Files. Is it there? It's always in the last place you look."", [""Found it""])" + NL
    t = t + "        CASE ""Yes, help!""" + NL
    t = t + "            Balloon(""doom"", ""Have you tried asking the demons nicely?"" + EOL + EOL + ""No? Then shoot them. Lots."", [""Rip and tear""])" + NL
    t = t + "        CASE ""Yes, add it""" + NL
    t = t + "            IF detail <> """" AND FS.Exists(detail) THEN FS.Append(detail, EOL + ""[ ] Close Clippy"" + EOL)" + NL
    t = t + "            Balloon(""todo"", ""Added! Though I don't think you'll ever need it."", [""We'll see""])" + NL
    t = t + "        CASE ""Run it""" + NL
    t = t + "            IF detail <> """" AND FS.Exists(detail) THEN SYS.Run(detail)" + NL
    t = t + "            Balloon(""program"", ""Running "" + detail + ""... Fingers crossed! (I don't have fingers.)"", [""OK""])" + NL
    t = t + "        CASE ""Ask another question""" + NL
    t = t + "            AskBalloon(""What would you like to do?"")" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Click Clippy, and he asks what you'd like to do." + NL
    t = t + "SUB Art_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    IF y < BalloonHeight() THEN RETURN" + NL
    t = t + "    AskBalloon(""What would you like to do?"" + EOL + EOL + ""Type a question, then click Search."")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Ask_Go ()" + NL
    t = t + "    VAR q AS String" + NL
    t = t + "    q = askBox.Text.Trim()" + NL
    t = t + "    IF q = """" THEN RETURN" + NL
    t = t + "    Answer(q)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Has (q AS String, words AS String) AS Bool" + NL
    t = t + "    VAR w AS String" + NL
    t = t + "    FOR EACH w IN words.Split(""|"")" + NL
    t = t + "        IF ("" "" + q + "" "").Contains("" "" + w) THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Built-in help for the questions it knows, the Web for the rest." + NL
    t = t + "SUB Answer (question AS String)" + NL
    t = t + "    VAR q AS String" + NL
    t = t + "    q = question.Lower().Replace(""?"", """").Replace(""."", """").Replace("","", """").Replace(""!"", """")" + NL
    t = t + "    SetMood(""thinking"", 1200)" + NL
    t = t + "    IF Has(q, ""go away|turn you off|turn off clippy|hide|uninstall|get rid|kill you|close you|shut up|stop"") THEN" + NL
    t = t + "        Balloon(""goodbye"", ""I'm sorry, Dave. I'm afraid I can't do that."" + EOL + EOL + ""Just kidding! Do you want me to go?"", [""Yes, hide and don't start with SIM95"", ""Just hide for now"", ""Never mind, stay""])" + NL
    t = t + "    ELSEIF Has(q, ""install|app|program for|add a site|web site|website|home page"") THEN" + NL
    t = t + "        Balloon(""help"", ""To install an app, open SPARK, paste in its INSTALL.SPK, save it as C:\MYFILES\INSTALL.SPK and press F5."" + EOL + EOL + ""Web apps become your machine's home page."", [""Ask another question"", ""Thanks, Clippy!""])" + NL
    t = t + "    ELSEIF Has(q, ""mail|e-mail|email|letter"") THEN" + NL
    t = t + "        IF FS.Exists(MAILER) THEN SYS.Start(MAILER, """")" + NL
    t = t + "        Balloon(""help"", ""Mail goes from name@machine to name@machine. Frostbird reads it, if you have it; I've opened it if so. Or use ColdMail's webmail in your browser."", [""Ask another question"", ""Thanks, Clippy!""])" + NL
    t = t + "    ELSEIF Has(q, ""browse|internet|web|surf"") THEN" + NL
    t = t + "        OpenBrowser("""")" + NL
    t = t + "        Balloon(""help"", ""Here's the Web! Type an address like http://alpha/ into the Address bar, or some words to search."", [""Ask another question"", ""Thanks, Clippy!""])" + NL
    t = t + "    ELSEIF Has(q, ""time|date|day is it"") THEN" + NL
    t = t + "        Balloon(""help"", ""It's "" + TIME.Clock.Substring(0, 5) + "" on "" + TIME.Date + ""."" + EOL + EOL + ""Time flies when you're with a paperclip!"", [""Ask another question"", ""Thanks, Clippy!""])" + NL
    t = t + "    ELSEIF Has(q, ""joke|funny|laugh"") THEN" + NL
    t = t + "        Balloon(""help"", ""Why did the paperclip apply for a job?"" + EOL + EOL + ""It wanted to hold things together."", [""Ask another question"", ""Groan""])" + NL
    t = t + "    ELSEIF Has(q, ""who are you|what are you|your name|are you alive|sentient|are you an ai|llm"") THEN" + NL
    t = t + "        Balloon(""help"", ""I'm Clippy, a paperclip! I'm not a large language model. I'm a small office supply with ambition."", [""Ask another question"", ""Thanks, Clippy!""])" + NL
    t = t + "    ELSEIF Has(q, ""game|play|bored|fun"") THEN" + NL
    t = t + "        Balloon(""help"", ""All work and no play! Try Minesweeper. If anybody has installed games on this machine, they'll be in C:\PROGRAMS too."", [""Ask another question"", ""Thanks, Clippy!""])" + NL
    t = t + "    ELSEIF Has(q, ""save|lost|file"") THEN" + NL
    t = t + "        Balloon(""help"", ""Your files live in C:\MYFILES. Open My Files to see them. If it isn't there, did you press Save? I did ask."", [""Let's look together"", ""Ask another question""])" + NL
    t = t + "    ELSEIF Has(q, ""hello|hi|hey"") THEN" + NL
    t = t + "        Balloon(""help"", ""Hello! It looks like you're saying hello."" + EOL + EOL + ""Would you like help with that?"", [""Ask another question"", ""No!""])" + NL
    t = t + "    ELSE" + NL
    t = t + "        ' to the Web" + NL
    t = t + "        IF OpenBrowser(question) THEN" + NL
    t = t + "            Balloon(""help"", ""I don't know about """""" + question + """""", but the Web might. I've asked AskSim for you."", [""Ask another question"", ""Thanks, Clippy!""])" + NL
    t = t + "        ELSE" + NL
    t = t + "            Balloon(""help"", ""I don't know about """""" + question + """""" and there's no browser here to ask the Web with."" + EOL + EOL + ""I'm just a paperclip."", [""Ask another question"", ""OK""])" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Opens the browser, searching for words if there are any. FALSE if there" + NL
    t = t + "' is no browser to open." + NL
    t = t + "FUNCTION OpenBrowser (words AS String) AS Bool" + NL
    t = t + "    VAR search AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR url AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(""C:\SYSTEM\SIMXPLOR.INI"", """").Lines()" + NL
    t = t + "        IF line.StartsWith(""search="") THEN search = line.Substring(7, line.Length - 7).Trim()" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF words <> """" THEN" + NL
    t = t + "        IF search = """" AND FS.Exists(""C:\WEB\ASK.SPK"") THEN search = ""http://"" + NET.HostName.Lower() + ""/index.asp?q=%s""" + NL
    t = t + "        IF search = """" AND FS.Exists(""C:\WEB\ASK\ASK.SPK"") THEN search = ""http://"" + NET.HostName.Lower() + ""/ask/index.asp?q=%s""" + NL
    t = t + "        IF search <> """" THEN" + NL
    t = t + "            url = search.Replace(""%s"", UrlEnc(words))" + NL
    t = t + "        ELSE" + NL
    t = t + "            url = ""about:search?"" + UrlEnc(words)" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    IF FS.Exists(BROWSER) THEN" + NL
    t = t + "        SYS.Start(BROWSER, url)" + NL
    t = t + "        RETURN TRUE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF url.StartsWith(""about:"") THEN RETURN FALSE" + NL
    t = t + "    SYS.Start(""C:\SYSTEM\VOYAGER.EXE"", url)" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UrlEnc (s AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        c = s.CharAt(i)" + NL
    t = t + "        IF c = "" "" THEN" + NL
    t = t + "            out = out + ""+""" + NL
    t = t + "        ELSEIF ""abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_."".Contains(c) THEN" + NL
    t = t + "            out = out + c" + NL
    t = t + "        ELSE" + NL
    t = t + "            out = out + ""%"" + (""0"" + Hex(Asc(c) MOD 256)).Substring((""0"" + Hex(Asc(c) MOD 256)).Length - 2, 2)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ drawing Clippy" + NL
    t = t + "" + NL
    t = t + "SUB SetMood (m AS String, ms AS Integer)" + NL
    t = t + "    mood = m" + NL
    t = t + "    moodUntil = SYS.Ticks + ms" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Art_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    drawn = """"" + NL
    t = t + "    Draw()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Only what changed is worth drawing again: a still Clippy is drawn once." + NL
    t = t + "SUB Draw ()" + NL
    t = t + "    VAR state AS String" + NL
    t = t + "    VAR bob AS Integer" + NL
    t = t + "    VAR bh AS Integer" + NL
    t = t + "    IF mood = ""attention"" THEN bob = Int(MATH.Abs(MATH.Sin(frame * 0.9)) * 6)" + NL
    t = t + "    state = mood + Str(bob) + Str(gaze) + Str(blinking) + say" + NL
    t = t + "    IF mood = ""writing"" OR mood = ""thinking"" THEN state = state + Str(frame MOD 2)" + NL
    t = t + "    IF state = drawn THEN RETURN" + NL
    t = t + "    drawn = state" + NL
    t = t + "    bh = BalloonHeight()" + NL
    t = t + "    art.Clear()" + NL
    t = t + "    art.SetColor(7)" + NL
    t = t + "    art.FillRect(0, 0, W, bh + CLIPH)" + NL
    t = t + "    IF say <> """" THEN DrawBalloon(bh)" + NL
    t = t + "    DrawClippy(110, bh + 10 - bob)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawBalloon (bh AS Integer)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    ' a pale yellow balloon with a black edge, and its tail down to Clippy" + NL
    t = t + "    art.SetColor(0)" + NL
    t = t + "    art.FillRect(5, 5, W - 10, bh - 18)" + NL
    t = t + "    art.SetColor(15)" + NL
    t = t + "    art.FillRect(6, 6, W - 12, bh - 20)" + NL
    t = t + "    art.SetColor(11)" + NL
    t = t + "    art.FillRect(7, 7, W - 14, bh - 22)" + NL
    t = t + "    FOR i = 0 TO 11" + NL
    t = t + "        art.SetColor(0)" + NL
    t = t + "        art.Line(140 - i + i / 2, bh - 13 + i, 150 - i / 2, bh - 13 + i)" + NL
    t = t + "        art.SetColor(11)" + NL
    t = t + "        art.Line(141 - i + i / 2, bh - 14 + i, 149 - i / 2, bh - 14 + i)" + NL
    t = t + "    NEXT" + NL
    t = t + "    art.SetColor(0)" + NL
    t = t + "    lines = Wrap(say)" + NL
    t = t + "    FOR i = 0 TO lines.Count - 1" + NL
    t = t + "        art.Text(14, 14 + i * 18, lines[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The wire, as a fat line: a dark edge and a light middle make it shine." + NL
    t = t + "SUB Wire (x1 AS Integer, y1 AS Integer, x2 AS Integer, y2 AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    n = Int(MATH.Max(MATH.Abs(x2 - x1), MATH.Abs(y2 - y1)) / 2) + 1" + NL
    t = t + "    FOR i = 0 TO n" + NL
    t = t + "        art.SetColor(8)" + NL
    t = t + "        art.FillCircle(x1 + Int((x2 - x1) * i / n), y1 + Int((y2 - y1) * i / n), 3)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR i = 0 TO n" + NL
    t = t + "        art.SetColor(7)" + NL
    t = t + "        art.FillCircle(x1 + Int((x2 - x1) * i / n) - 1, y1 + Int((y2 - y1) * i / n) - 1, 1)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Half a circle of wire: from angle a to b (degrees, 0 = right, 90 = down)." + NL
    t = t + "SUB Bend (cx AS Integer, cy AS Integer, r AS Integer, a AS Integer, b AS Integer)" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR dir AS Integer" + NL
    t = t + "    dir = 15" + NL
    t = t + "    IF b < a THEN dir = -15" + NL
    t = t + "    FOR d = a TO b STEP dir" + NL
    t = t + "        x = cx + Int(r * MATH.Cos(d * MATH.Pi / 180))" + NL
    t = t + "        y = cy + Int(r * MATH.Sin(d * MATH.Pi / 180))" + NL
    t = t + "        art.SetColor(8)" + NL
    t = t + "        art.FillCircle(x, y, 3)" + NL
    t = t + "        art.SetColor(7)" + NL
    t = t + "        art.FillCircle(x - 1, y - 1, 1)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawClippy (ox AS Integer, oy AS Integer)" + NL
    t = t + "    VAR px AS Integer" + NL
    t = t + "    VAR py AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    ' the sheet of paper he stands on" + NL
    t = t + "    art.SetColor(15)" + NL
    t = t + "    art.FillRect(ox - 40, oy + 116, 110, 18)" + NL
    t = t + "    art.SetColor(8)" + NL
    t = t + "    art.Rect(ox - 40, oy + 116, 110, 18)" + NL
    t = t + "    art.SetColor(14)" + NL
    t = t + "    FOR i = 0 TO 2" + NL
    t = t + "        art.Line(ox - 34, oy + 121 + i * 5, ox + 64, oy + 121 + i * 5)" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' the clip: in on the left, round the top, down the right, round the bottom, up the inside" + NL
    t = t + "    Wire(ox + 4, oy + 100, ox + 4, oy + 32)" + NL
    t = t + "    Bend(ox + 14, oy + 32, 10, 180, 360)" + NL
    t = t + "    Wire(ox + 24, oy + 32, ox + 24, oy + 110)" + NL
    t = t + "    Bend(ox + 12, oy + 110, 12, 0, 180)" + NL
    t = t + "    Wire(ox + 0, oy + 110, ox + 0, oy + 52)" + NL
    t = t + "    IF mood = ""writing"" THEN" + NL
    t = t + "        ' scribbling with a pencil" + NL
    t = t + "        art.SetColor(11)" + NL
    t = t + "        art.FillRect(ox + 34, oy + 96 + (frame MOD 2) * 3, 16, 5)" + NL
    t = t + "        art.SetColor(0)" + NL
    t = t + "        art.Line(ox + 50, oy + 98 + (frame MOD 2) * 3, ox + 55, oy + 100 + (frame MOD 2) * 3)" + NL
    t = t + "    END IF" + NL
    t = t + "    ' eyes" + NL
    t = t + "    py = 0" + NL
    t = t + "    px = gaze * 2" + NL
    t = t + "    IF mood = ""thinking"" THEN" + NL
    t = t + "        py = -2" + NL
    t = t + "        px = 2" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 0 TO 1" + NL
    t = t + "        art.SetColor(0)" + NL
    t = t + "        art.FillCircle(ox + 2 + i * 22, oy + 50, 8)" + NL
    t = t + "        IF blinking THEN" + NL
    t = t + "            art.SetColor(7)" + NL
    t = t + "            art.FillCircle(ox + 2 + i * 22, oy + 50, 7)" + NL
    t = t + "            art.SetColor(0)" + NL
    t = t + "            art.Line(ox - 4 + i * 22, oy + 50, ox + 8 + i * 22, oy + 50)" + NL
    t = t + "        ELSE" + NL
    t = t + "            art.SetColor(15)" + NL
    t = t + "            art.FillCircle(ox + 2 + i * 22, oy + 50, 7)" + NL
    t = t + "            art.SetColor(0)" + NL
    t = t + "            art.FillCircle(ox + 3 + i * 22 + px, oy + 51 + py, 3)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' eyebrows: up for attention, one cocked for thinking" + NL
    t = t + "    art.SetColor(0)" + NL
    t = t + "    IF mood = ""attention"" THEN" + NL
    t = t + "        art.Line(ox - 6, oy + 34, ox + 8, oy + 31)" + NL
    t = t + "        art.Line(ox + 18, oy + 31, ox + 32, oy + 34)" + NL
    t = t + "    ELSEIF mood = ""thinking"" THEN" + NL
    t = t + "        art.Line(ox - 6, oy + 38, ox + 8, oy + 38)" + NL
    t = t + "        art.Line(ox + 18, oy + 33, ox + 32, oy + 37)" + NL
    t = t + "    ELSE" + NL
    t = t + "        art.Line(ox - 6, oy + 39, ox + 8, oy + 37)" + NL
    t = t + "        art.Line(ox + 18, oy + 37, ox + 32, oy + 39)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    Put("C:\PROGRAMS\CLIPPY.SPK")
END SUB

SUB StartService (name AS String, program AS String, runFile AS String)
    VAR task AS String
    FS.Write("C:\SYSTEM\STARTUP\" + runFile, program)
    Print("  " + name + " will start with the machine (C:\SYSTEM\STARTUP\" + runFile + ")")
    FOR EACH task IN SYS.Tasks()
        IF task.Split("|")[1].Upper() = name THEN
            SYS.Kill(Int(Val(task.Split("|")[0])))
            Print("  stopped the old " + name)
        END IF
    NEXT
    SYS.Run(program)
    Print("  started " + program)
END SUB
