' INSTALL.SPK - puts The Pixel Wall on this machine. Generated by tools/build-installer.mjs;
' edit the files in pixelwall/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5 - on the central
' host, STARTHERE.56K.NET. It puts the Pixel Wall in C:\WEB\WALL:
' http://starthere.56k.net/wall/. Everyone on the network draws on the one 64 by 64
' wall, a pixel at a time. Voyager gets plain pages; in Simxplorer the wall is
' live. The wall is kept in C:\WALLDATA and left alone, so running this again
' upgrades the pages. (On any other machine it warns you first: a second wall
' would split the people drawing.)

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)
    ' Always in a folder of its own, whatever the machine.
    intoDir = "WALL"
    IF NOT FS.Exists("C:\WEB\" + intoDir) THEN FS.MakeDir("C:\WEB\" + intoDir)


    IF NOT WallHere() THEN RETURN
    WallSetup()
    File0()
    File1()
    File2()
    File3()
    File4()
    File5()
    File6()
    File7()
    File8()
    File9()
    File10()
    File11()
    File12()
    File13()
    File14()
    File15()
    File16()
    File17()
    File18()
    File19()
    File20()
    File21()
    File22()
    File23()
    File24()
    File25()
    File26()
    File27()
    File28()
    File29()
    File30()
    File31()
    File32()
    File33()
    File34()
    File35()
    File36()
    File37()
    Print("The Pixel Wall is installed (38 files).")

    ' how it shows on the SimHost front page, which lists every folder with one of these
    IF intoDir <> "" THEN FS.Write("C:\WEB\" + intoDir + "\APP.INF", "The Pixel Wall|One wall of pixels the whole network draws on together, a pixel at a time.|#800080")
    IF intoDir = "" THEN
        Print("Open http://" + NET.HostName.Lower() + "/ in Voyager.")
    ELSE
        Print("Open http://" + NET.HostName.Lower() + "/" + intoDir.Lower() + "/ in Voyager.")
    END IF
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

