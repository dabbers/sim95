SUB File35 ()
    t = ""
    t = t + "<%@ import file=""WALL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' WALL.ASP - the whole wall as a picture, 64 by 64 (pages show it bigger)." + NL
    t = t + "RESPONSE.Clear()" + NL
    t = t + "RESPONSE.ContentType = ""image/x-sim95pic""" + NL
    t = t + "RESPONSE.Write(Picture())" + NL
    t = t + "RESPONSE.End()" + NL
    t = t + "%>" + NL
    Put("C:\WEB\WALL.ASP")
END SUB

SUB File36 ()
    t = ""
    t = t + "// WALL.JS - the Pixel Wall in Simxplorer. INDEX.ASP sends it with the state" + NL
    t = t + "// of the wall in S, and runs it with eval(CODE)." + NL
    t = t + "//" + NL
    t = t + "// Simxplorer can change a page's text, but not its colours. So when the wall" + NL
    t = t + "// changes, this writes the whole page again with document.write: the new" + NL
    t = t + "// page carries S and this code along, and draws itself. Pixels are placed," + NL
    t = t + "// and parts of the wall visited, with XMLHttpRequest; every few seconds it" + NL
    t = t + "// asks DATA.ASP whether anyone else has placed one." + NL
    t = t + "" + NL
    t = t + "var HEX = ""0123456789ABCDEF"";" + NL
    t = t + "var PAL = [""#000000"", ""#800000"", ""#008000"", ""#808000"", ""#000080"", ""#800080"", ""#008080"", ""#C0C0C0""," + NL
    t = t + "           ""#808080"", ""#FF0000"", ""#00FF00"", ""#FFFF00"", ""#0000FF"", ""#FF00FF"", ""#00FFFF"", ""#FFFFFF""];" + NL
    t = t + "var NAMES = [""Black"", ""Maroon"", ""Green"", ""Olive"", ""Navy"", ""Purple"", ""Teal"", ""Silver""," + NL
    t = t + "             ""Gray"", ""Red"", ""Lime"", ""Yellow"", ""Blue"", ""Magenta"", ""Cyan"", ""White""];" + NL
    t = t + "var busy = false;" + NL
    t = t + "" + NL
    t = t + "function now() { return new Date().getTime(); }" + NL
    t = t + "if (S.left > 0) { S.due = now() + S.left * 1000; }" + NL
    t = t + "S.left = 0;" + NL
    t = t + "" + NL
    t = t + "function dark(k) { return k == 0 || k == 1 || k == 4 || k == 5 || k == 8 || k == 12; }" + NL
    t = t + "function label(r) { return ""ABCD"".charAt(Math.floor(r / 4)) + (r % 4 + 1); }" + NL
    t = t + "function plain(s) { return s.split(""&"").join(""&amp;"").split(""<"").join(""&lt;""); }" + NL
    t = t + "" + NL
    t = t + "function coolText() {" + NL
    t = t + "  var left = Math.ceil((S.due - now()) / 1000);" + NL
    t = t + "  if (left > 0) return ""Next pixel in "" + left + "" seconds"";" + NL
    t = t + "  return ""Ready: click a square"";" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function squares() {" + NL
    t = t + "  var ox = (S.r % 4) * 16, oy = Math.floor(S.r / 4) * 16;" + NL
    t = t + "  var h = ""<table cellspacing=1 cellpadding=0 border=0 bgcolor=#808080>"";" + NL
    t = t + "  for (var y = 0; y < 16; y++) {" + NL
    t = t + "    h += ""<tr>"";" + NL
    t = t + "    for (var x = 0; x < 16; x++) {" + NL
    t = t + "      var k = HEX.indexOf(S.rows.charAt(y * 16 + x));" + NL
    t = t + "      h += ""<td bgcolor="" + PAL[k] + "" width=20 height=20 onclick=\""put("" + (ox + x) + "","" + (oy + y) + "")\""><tt>&nbsp;&nbsp;</tt></td>"";" + NL
    t = t + "    }" + NL
    t = t + "    h += ""</tr>"";" + NL
    t = t + "  }" + NL
    t = t + "  return h + ""</table>"";" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function body() {" + NL
    t = t + "  var h = ""<center><font size=5><b>The Pixel Wall</b></font><br><font size=2>Everyone on the network shares this wall. Pick a colour, then click a square: one pixel every "" + S.cool + "" seconds.</font>"";" + NL
    t = t + "  h += ""<p><table cellspacing=10 border=0><tr><td valign=top>"" + squares() + ""</td><td valign=top>"";" + NL
    t = t + "  h += ""<b>The whole wall</b><br><img src=\""wall.asp?v="" + S.v + ""\"" width=128 height=128 alt=\""the wall\""><br>"";" + NL
    t = t + "  h += ""<font size=2>Go to another part:</font><br><table cellspacing=1 cellpadding=0 border=0 bgcolor=#808080>"";" + NL
    t = t + "  for (var r = 0; r < 16; r++) {" + NL
    t = t + "    if (r % 4 == 0) h += ""<tr>"";" + NL
    t = t + "    if (r == S.r) h += ""<td width=32 height=20 align=center bgcolor=#000080><font size=2 color=#FFFFFF><b>"" + label(r) + ""</b></font></td>"";" + NL
    t = t + "    else h += ""<td width=32 height=20 align=center bgcolor=#FFFFFF onclick=\""go("" + r + "")\""><font size=2 color=#000080>"" + label(r) + ""</font></td>"";" + NL
    t = t + "    if (r % 4 == 3) h += ""</tr>"";" + NL
    t = t + "  }" + NL
    t = t + "  h += ""</table><p><b>Colour:</b> "" + NAMES[S.c] + ""<br><table cellspacing=1 cellpadding=0 border=0 bgcolor=#808080>"";" + NL
    t = t + "  for (var k = 0; k < 16; k++) {" + NL
    t = t + "    if (k % 8 == 0) h += ""<tr>"";" + NL
    t = t + "    // (the colour in use has a dot in it: S0.PIC to SF.PIC)" + NL
    t = t + "    var mark = ""<tt>&nbsp;&nbsp;</tt>"";" + NL
    t = t + "    if (k == S.c) mark = ""<img src=\""s"" + HEX.charAt(k) + "".pic\"" width=20 height=20 alt=\""\"">"";" + NL
    t = t + "    h += ""<td bgcolor="" + PAL[k] + "" width=20 height=20 onclick=\""pick("" + k + "")\"">"" + mark + ""</td>"";" + NL
    t = t + "    if (k % 8 == 7) h += ""</tr>"";" + NL
    t = t + "  }" + NL
    t = t + "  h += ""</table><p><b><span id=cd>"" + coolText() + ""</span></b><br><font size=2><span id=msg>"" + plain(S.msg) + ""</span></font>"";" + NL
    t = t + "  h += ""<p><b>Latest pixels</b><br><font size=2>"" + plain(S.feed).split(""\n"").join(""<br>"") + ""</font>"";" + NL
    t = t + "  h += ""</td></tr></table><p><font size=2>Live: other people's pixels appear by themselves. "";" + NL
    t = t + "  h += ""<a href=\""index.asp?r="" + S.r + ""&c="" + S.c + ""&plain=1\"">Plain version</a></font></center>"";" + NL
    t = t + "  return h;" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "// S, written out as JavaScript for the next page" + NL
    t = t + "function saved() {" + NL
    t = t + "  return ""{r:"" + S.r + "",c:"" + S.c + "",v:"" + S.v + "",cool:"" + S.cool + "",rows:\"""" + S.rows + ""\"",due:"" + S.due +" + NL
    t = t + "    "",left:0,feed:unescape(\"""" + escape(S.feed) + ""\""),msg:unescape(\"""" + escape(S.msg) + ""\"")}"";" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function redraw() {" + NL
    t = t + "  document.write(""<html><head><title>The Pixel Wall</title></head><body bgcolor=#C0C0C0><script language=\""JavaScript\"">var S = "" +" + NL
    t = t + "    saved() + ""; var CODE = unescape(\"""" + escape(CODE) + ""\""); eval(CODE);</"" + ""script></body></html>"");" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function say(text) {" + NL
    t = t + "  S.msg = text;" + NL
    t = t + "  document.getElementById(""msg"").innerText = text;" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "// What DATA.ASP and PLACE.ASP answer: version, seconds to wait, the region's" + NL
    t = t + "// digits, then the latest pixels. True when the page needs drawing again." + NL
    t = t + "function take(lines) {" + NL
    t = t + "  var v = parseInt(lines[0]), left = parseInt(lines[1]), feed = lines.slice(3).join(""\n"");" + NL
    t = t + "  var changed = v != S.v || lines[2] != S.rows || feed != S.feed;" + NL
    t = t + "  S.v = v;" + NL
    t = t + "  S.rows = lines[2];" + NL
    t = t + "  S.feed = feed;" + NL
    t = t + "  S.due = left > 0 ? now() + left * 1000 : 0;" + NL
    t = t + "  return changed;" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function ask(method, url, body, done) {" + NL
    t = t + "  var x = window.XMLHttpRequest ? new XMLHttpRequest() : new ActiveXObject(""Microsoft.XMLHTTP"");" + NL
    t = t + "  busy = true;" + NL
    t = t + "  x.onreadystatechange = function () {" + NL
    t = t + "    if (x.readyState != 4) return;" + NL
    t = t + "    busy = false;" + NL
    t = t + "    if (x.status != 200) { say(""The wall didn't answer. Try again in a moment.""); return; }" + NL
    t = t + "    done(x.responseText.split(""\n""));" + NL
    t = t + "  };" + NL
    t = t + "  x.open(method, url, true);" + NL
    t = t + "  if (method == ""POST"") x.setRequestHeader(""Content-Type"", ""application/x-www-form-urlencoded"");" + NL
    t = t + "  x.send(body);" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function put(x, y) {" + NL
    t = t + "  if (busy) return;" + NL
    t = t + "  if (S.due > now()) { say(""Not yet: one pixel every "" + S.cool + "" seconds.""); return; }" + NL
    t = t + "  say(""Placing "" + NAMES[S.c] + "" at "" + x + "","" + y + ""..."");" + NL
    t = t + "  ask(""POST"", ""place.asp"", ""x="" + x + ""&y="" + y + ""&c="" + S.c + ""&r="" + S.r, function (lines) {" + NL
    t = t + "    var said = lines[0];" + NL
    t = t + "    take(lines.slice(1));" + NL
    t = t + "    if (said == ""OK"") S.msg = ""Placed: "" + NAMES[S.c] + "" at "" + x + "","" + y + ""."";" + NL
    t = t + "    else if (said == ""WAIT"") S.msg = ""Not yet: one pixel every "" + S.cool + "" seconds."";" + NL
    t = t + "    else if (said == ""BUSY"") S.msg = ""The wall was busy: try again."";" + NL
    t = t + "    else S.msg = ""That isn't a square on the wall."";" + NL
    t = t + "    redraw();" + NL
    t = t + "  });" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function pick(k) {" + NL
    t = t + "  S.c = k;" + NL
    t = t + "  S.msg = """";" + NL
    t = t + "  redraw();" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function go(r) {" + NL
    t = t + "  if (busy) return;" + NL
    t = t + "  say(""Going to "" + label(r) + ""..."");" + NL
    t = t + "  ask(""GET"", ""data.asp?r="" + r, null, function (lines) {" + NL
    t = t + "    S.r = r;" + NL
    t = t + "    S.msg = """";" + NL
    t = t + "    take(lines);" + NL
    t = t + "    redraw();" + NL
    t = t + "  });" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function poll() {" + NL
    t = t + "  if (busy) return;" + NL
    t = t + "  ask(""GET"", ""data.asp?r="" + S.r, null, function (lines) {" + NL
    t = t + "    if (take(lines)) redraw();" + NL
    t = t + "  });" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function tick() {" + NL
    t = t + "  document.getElementById(""cd"").innerText = coolText();" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "document.write(body());" + NL
    t = t + "setInterval(""tick()"", 1000);" + NL
    t = t + "setInterval(""poll()"", 4000);" + NL
    Put("C:\WEB\WALL.JS")
END SUB

SUB File37 ()
    t = ""
    t = t + "' WALL.SPK - the Pixel Wall's library, shared by its pages." + NL
    t = t + "'" + NL
    t = t + "' The wall is 64 by 64 pixels in SIM95's 16 colours, one hex digit each:" + NL
    t = t + "' C:\WALLDATA\WALL.TXT is 64 lines of 64 digits. Anyone may set one pixel" + NL
    t = t + "' every COOLDOWN seconds (each machine, by its address)." + NL
    t = t + "'   VER.TXT    a number that goes up with every pixel, so a page can tell" + NL
    t = t + "'              whether the wall has changed" + NL
    t = t + "'   COOL.TXT   address|when (seconds since 1970) each machine last placed one" + NL
    t = t + "'   LOG.TXT    the latest pixels, oldest first: name|x|y|colour|clock" + NL
    t = t + "'   NAMES.TXT  machine names by address (NAME ADDRESS), and when they were" + NL
    t = t + "'              last looked up, so the log can say who" + NL
    t = t + "' The wall is seen 16 by 16 at a time: region r (0-15) is column r MOD 4," + NL
    t = t + "' row r \ 4 of a 4 by 4 grid." + NL
    t = t + "" + NL
    t = t + "CONST DATADIR = ""C:\WALLDATA""" + NL
    t = t + "CONST SIZE = 64" + NL
    t = t + "CONST TILE = 16" + NL
    t = t + "CONST COOLDOWN = 15" + NL
    t = t + "CONST LOGKEEP = 40" + NL
    t = t + "CONST FEEDROWS = 8" + NL
    t = t + "CONST HEXDIGITS = ""0123456789ABCDEF""" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (p AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(p) THEN RETURN FS.Read(p)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ColourHex (c AS Integer) AS String" + NL
    t = t + "    VAR all AS Array OF String" + NL
    t = t + "    all = [""#000000"", ""#800000"", ""#008000"", ""#808000"", ""#000080"", ""#800080"", ""#008080"", ""#C0C0C0"", ""#808080"", ""#FF0000"", ""#00FF00"", ""#FFFF00"", ""#0000FF"", ""#FF00FF"", ""#00FFFF"", ""#FFFFFF""]" + NL
    t = t + "    RETURN all[c]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ColourName (c AS Integer) AS String" + NL
    t = t + "    VAR all AS Array OF String" + NL
    t = t + "    all = [""Black"", ""Maroon"", ""Green"", ""Olive"", ""Navy"", ""Purple"", ""Teal"", ""Silver"", ""Gray"", ""Red"", ""Lime"", ""Yellow"", ""Blue"", ""Magenta"", ""Cyan"", ""White""]" + NL
    t = t + "    RETURN all[c]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A number from a query or a form, kept between lo and hi ("""" or junk: dflt)." + NL
    t = t + "FUNCTION Num (s AS String, lo AS Integer, hi AS Integer, dflt AS Integer) AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    t = s.Trim()" + NL
    t = t + "    IF t = """" OR t.Length > 6 THEN RETURN dflt" + NL
    t = t + "    FOR k = 0 TO t.Length - 1" + NL
    t = t + "        IF Asc(t.CharAt(k)) < 48 OR Asc(t.CharAt(k)) > 57 THEN RETURN dflt" + NL
    t = t + "    NEXT" + NL
    t = t + "    k = Int(Val(t))" + NL
    t = t + "    IF k < lo OR k > hi THEN RETURN dflt" + NL
    t = t + "    RETURN k" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where ch is last in s, or -1." + NL
    t = t + "FUNCTION LastAt (s AS String, ch AS String) AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    FOR k = s.Length - 1 TO 0 STEP -1" + NL
    t = t + "        IF s.CharAt(k) = ch THEN RETURN k" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN -1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Blank () AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    FOR k = 1 TO SIZE" + NL
    t = t + "        line = line + ""F""" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR k = 1 TO SIZE" + NL
    t = t + "        out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out.Join(Chr(10)) + Chr(10)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The wall's 64 rows (a missing or damaged one is white)." + NL
    t = t + "FUNCTION WallRows () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR got AS Array OF String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR row AS String" + NL
    t = t + "    got = ReadOr(DATADIR + ""\WALL.TXT"", Blank()).Replace(Chr(13), """").Split(Chr(10))" + NL
    t = t + "    FOR k = 0 TO SIZE - 1" + NL
    t = t + "        row = """"" + NL
    t = t + "        IF k < got.Count THEN row = got[k].Upper()" + NL
    t = t + "        WHILE row.Length < SIZE" + NL
    t = t + "            row = row + ""F""" + NL
    t = t + "        END WHILE" + NL
    t = t + "        out.Add(row.Substring(0, SIZE))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Version () AS Integer" + NL
    t = t + "    RETURN Int(Val(ReadOr(DATADIR + ""\VER.TXT"", ""0"")))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Region r's 256 digits, row by row." + NL
    t = t + "FUNCTION RegionDigits (rows AS Array OF String, r AS Integer) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    FOR y = 0 TO TILE - 1" + NL
    t = t + "        out = out + rows[Int(r / 4) * TILE + y].Substring((r MOD 4) * TILE, TILE)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Seconds before addr may place another pixel (0: now)." + NL
    t = t + "FUNCTION CoolLeft (addr AS String) AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR left AS Integer" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\COOL.TXT"", """").Split(Chr(10))" + NL
    t = t + "        IF line.StartsWith(addr + ""|"") THEN" + NL
    t = t + "            left = Int(Val(line.Substring(addr.Length + 1, line.Length - addr.Length - 1))) + COOLDOWN - TIME.Now" + NL
    t = t + "            ' (a clock that went back is no reason to wait longer)" + NL
    t = t + "            IF left > COOLDOWN THEN RETURN 0" + NL
    t = t + "            IF left > 0 THEN RETURN left" + NL
    t = t + "            RETURN 0" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The latest pixels, newest first, as ""NAME put Red at 12,40 (14:05)""." + NL
    t = t + "FUNCTION Feed () AS Array OF String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    lines = ReadOr(DATADIR + ""\LOG.TXT"", """").Replace(Chr(13), """").Split(Chr(10))" + NL
    t = t + "    FOR k = lines.Count - 1 TO 0 STEP -1" + NL
    t = t + "        p = lines[k].Split(""|"")" + NL
    t = t + "        IF p.Count < 5 THEN CONTINUE" + NL
    t = t + "        out.Add(p[0] + "" put "" + ColourName(Num(p[3], 0, 15, 0)) + "" at "" + p[1] + "","" + p[2] + "" ("" + p[4] + "")"")" + NL
    t = t + "        IF out.Count >= FEEDROWS THEN BREAK" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' What a page polls for, and what placing a pixel answers with: the version," + NL
    t = t + "' the seconds to wait, region r's digits, then the feed, a line each." + NL
    t = t + "FUNCTION State (r AS Integer, addr AS String) AS String" + NL
    t = t + "    RETURN Str(Version()) + Chr(10) + Str(CoolLeft(addr)) + Chr(10) + RegionDigits(WallRows(), r) + Chr(10) + Feed().Join(Chr(10))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The machine at addr, by name. Looking every machine up takes a moment, so" + NL
    t = t + "' names are kept, and looked up again at most once a minute." + NL
    t = t + "FUNCTION WhoIs (addr AS String) AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR found AS String" + NL
    t = t + "    text = ReadOr(DATADIR + ""\NAMES.TXT"", ""0"" + Chr(10))" + NL
    t = t + "    FOR EACH line IN text.Split(Chr(10))" + NL
    t = t + "        p = line.Trim().Split("" "")" + NL
    t = t + "        IF p.Count >= 2 AND p[p.Count - 1] = addr THEN RETURN p[0]" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF TIME.Now - Int(Val(text.Split(Chr(10))[0])) < 60 THEN RETURN addr" + NL
    t = t + "    TRY" + NL
    t = t + "        text = Str(TIME.Now) + Chr(10)" + NL
    t = t + "        FOR EACH line IN NET.Machines()" + NL
    t = t + "            p = line.Trim().Split("" "")" + NL
    t = t + "            IF p.Count >= 2 THEN" + NL
    t = t + "                text = text + p[0].Upper() + "" "" + p[1] + Chr(10)" + NL
    t = t + "                IF p[1] = addr THEN found = p[0].Upper()" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        FS.Write(DATADIR + ""\NAMES.TXT"", text)" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF found <> """" THEN RETURN found" + NL
    t = t + "    RETURN addr" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Two pixels may arrive at once, and each rewrites the wall. The lock is a" + NL
    t = t + "' folder (FS.MakeDir fails when it's there); one left by a page that died is" + NL
    t = t + "' cleared after a few seconds." + NL
    t = t + "FUNCTION TakeLock () AS Bool" + NL
    t = t + "    VAR tries AS Integer" + NL
    t = t + "    VAR at AS String" + NL
    t = t + "    WHILE tries < 100" + NL
    t = t + "        tries = tries + 1" + NL
    t = t + "        TRY" + NL
    t = t + "            FS.MakeDir(DATADIR + ""\LOCK"")" + NL
    t = t + "            FS.Write(DATADIR + ""\LOCK\AT.TXT"", Str(TIME.Now))" + NL
    t = t + "            RETURN TRUE" + NL
    t = t + "        CATCH err" + NL
    t = t + "            at = ReadOr(DATADIR + ""\LOCK\AT.TXT"", """")" + NL
    t = t + "            IF (at <> """" AND TIME.Now - Int(Val(at)) > 5) OR (at = """" AND tries MOD 25 = 0) THEN" + NL
    t = t + "                DropLock()" + NL
    t = t + "            ELSE" + NL
    t = t + "                SYS.Sleep(10)" + NL
    t = t + "            END IF" + NL
    t = t + "        END TRY" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB DropLock ()" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(DATADIR + ""\LOCK\AT.TXT"") THEN FS.Delete(DATADIR + ""\LOCK\AT.TXT"")" + NL
    t = t + "        IF FS.Exists(DATADIR + ""\LOCK"") THEN FS.Delete(DATADIR + ""\LOCK"")" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A pixel from addr: ""OK"", ""WAIT"" (too soon) or ""BUSY"" (the wall couldn't" + NL
    t = t + "' be had)." + NL
    t = t + "FUNCTION Place (addr AS String, x AS Integer, y AS Integer, c AS Integer) AS String" + NL
    t = t + "    VAR rows AS Array OF String" + NL
    t = t + "    VAR cool AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR logRows AS Array OF String" + NL
    t = t + "    VAR who AS String" + NL
    t = t + "    IF CoolLeft(addr) > 0 THEN RETURN ""WAIT""" + NL
    t = t + "    who = WhoIs(addr)" + NL
    t = t + "    IF NOT TakeLock() THEN RETURN ""BUSY""" + NL
    t = t + "    IF CoolLeft(addr) > 0 THEN" + NL
    t = t + "        DropLock()" + NL
    t = t + "        RETURN ""WAIT""" + NL
    t = t + "    END IF" + NL
    t = t + "    rows = WallRows()" + NL
    t = t + "    rows[y] = rows[y].Substring(0, x) + HEXDIGITS.CharAt(c) + rows[y].Substring(x + 1, SIZE - x - 1)" + NL
    t = t + "    FS.Write(DATADIR + ""\WALL.TXT"", rows.Join(Chr(10)) + Chr(10))" + NL
    t = t + "    FS.Write(DATADIR + ""\VER.TXT"", Str(Version() + 1))" + NL
    t = t + "    cool.Add(addr + ""|"" + Str(TIME.Now))" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\COOL.TXT"", """").Replace(Chr(13), """").Split(Chr(10))" + NL
    t = t + "        ' (others who are still waiting; the rest are forgotten)" + NL
    t = t + "        IF line.Contains(""|"") AND NOT line.StartsWith(addr + ""|"") THEN" + NL
    t = t + "            IF TIME.Now - Int(Val(line.Split(""|"")[1])) < COOLDOWN THEN cool.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Write(DATADIR + ""\COOL.TXT"", cool.Join(Chr(10)) + Chr(10))" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\LOG.TXT"", """").Replace(Chr(13), """").Split(Chr(10))" + NL
    t = t + "        IF line <> """" THEN logRows.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    logRows.Add(who.Replace(""|"", "" "") + ""|"" + Str(x) + ""|"" + Str(y) + ""|"" + Str(c) + ""|"" + TIME.Clock.Substring(0, 5))" + NL
    t = t + "    WHILE logRows.Count > LOGKEEP" + NL
    t = t + "        logRows.RemoveAt(0)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    FS.Write(DATADIR + ""\LOG.TXT"", logRows.Join(Chr(10)) + Chr(10))" + NL
    t = t + "    DropLock()" + NL
    t = t + "    RETURN ""OK""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The wall as a picture: 64 by 64, a hex digit a pixel." + NL
    t = t + "FUNCTION Picture () AS String" + NL
    t = t + "    RETURN ""SIM95PIC "" + Str(SIZE) + "" "" + Str(SIZE) + Chr(10) + WallRows().Join(Chr(10)) + Chr(10)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is it Simxplorer asking (and not asking for the plain page)?" + NL
    t = t + "FUNCTION Fancy () AS Bool" + NL
    t = t + "    IF REQUEST.Query(""plain"") <> """" THEN RETURN FALSE" + NL
    t = t + "    RETURN REQUEST.Header(""User-Agent"").Contains(""Simxplorer"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Text as JavaScript's escape() makes it, for unescape() to read back." + NL
    t = t + "FUNCTION JsEscape (s AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR ch AS String" + NL
    t = t + "    FOR k = 0 TO s.Length - 1" + NL
    t = t + "        ch = s.CharAt(k)" + NL
    t = t + "        c = Asc(ch)" + NL
    t = t + "        IF (c >= 48 AND c <= 57) OR (c >= 65 AND c <= 90) OR (c >= 97 AND c <= 122) OR ch = ""@"" OR ch = ""*"" OR ch = ""_"" OR ch = ""+"" OR ch = ""-"" OR ch = ""."" OR ch = ""/"" THEN" + NL
    t = t + "            out = out + ch" + NL
    t = t + "        ELSEIF c < 256 THEN" + NL
    t = t + "            out = out + ""%"" + HEXDIGITS.CharAt(Int(c / 16)) + HEXDIGITS.CharAt(c MOD 16)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\WEB\WALL.SPK")
END SUB

VAR wallWin AS GUI_Window

' The central host, or a yes to installing it somewhere else anyway.
FUNCTION WallHere () AS Bool
    VAR box AS GUI_MessageBox
    IF NET.HostName.Lower() = "starthere.56k.net" THEN RETURN TRUE
    wallWin = GUI_Window.New("Pixel Wall Setup", 10, 10)
    box = GUI_MessageBox.New(wallWin)
    box.Title = "Pixel Wall Setup"
    box.Kind = "warn"
    box.Buttons = "yesno"
    box.Text = "This machine is " + NET.HostName.Upper() + ", not STARTHERE.56K.NET." + NL + NL _
        + "The Pixel Wall is meant for the central host, so that everybody draws on the same wall." + NL + NL _
        + "Install it here anyway (for testing, say)?"
    IF box.Show() THEN
        wallWin.Close()
        Print("  (not the central host, starthere.56k.net: installing anyway)")
        RETURN TRUE
    END IF
    Print("The Pixel Wall was not installed: it belongs on starthere.56k.net.")
    SYS.Exit(0)
    RETURN FALSE
END FUNCTION

' Where the wall is kept: made, with a white wall, the first time only.
SUB WallSetup ()
    VAR row AS String
    VAR wall AS String
    VAR k AS Integer
    IF NOT FS.Exists("C:\WALLDATA") THEN FS.MakeDir("C:\WALLDATA")
    IF FS.Exists("C:\WALLDATA\WALL.TXT") THEN RETURN
    FOR k = 1 TO 64
        row = row + "F"
    NEXT
    FOR k = 1 TO 64
        wall = wall + row + NL
    NEXT
    FS.Write("C:\WALLDATA\WALL.TXT", wall)
    FS.Write("C:\WALLDATA\VER.TXT", "0")
    Print("  made a white wall in C:\WALLDATA")
END SUB
