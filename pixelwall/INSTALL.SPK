SUB File16 ()
    t = ""
    t = t + "<%@ import file=""WALL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' DATA.ASP?r=n - what the Simxplorer page asks for every few seconds: the" + NL
    t = t + "' version, the seconds this machine must wait, region n, and the latest pixels." + NL
    t = t + "RESPONSE.Clear()" + NL
    t = t + "RESPONSE.ContentType = ""text/plain""" + NL
    t = t + "RESPONSE.Write(State(Num(REQUEST.Query(""r""), 0, 15, 5), REQUEST.From))" + NL
    t = t + "RESPONSE.End()" + NL
    t = t + "%>" + NL
    Put("C:\WEB\DATA.ASP")
END SUB

SUB File17 ()
    t = ""
    t = t + "<%@ import file=""WALL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' INDEX.ASP?r=region&c=colour - the Pixel Wall." + NL
    t = t + "'   Voyager gets plain HTML: each square a link that places a pixel, and a" + NL
    t = t + "'   page script that reloads the page every 30 seconds. In each link is a" + NL
    t = t + "'   one-colour picture, C0.PIC to CF.PIC (S0-SF with a dot, for the colour in" + NL
    t = t + "'   use), since Voyager underlines the text in a link, and a page asks for" + NL
    t = t + "'   each picture only once." + NL
    t = t + "'   Simxplorer gets the same wall drawn by JavaScript (WALL.JS), which places" + NL
    t = t + "'   pixels and goes round the wall without reloading, and shows other" + NL
    t = t + "'   people's pixels as they arrive. ?plain=1 gives it the plain page." + NL
    t = t + "VAR r AS Integer" + NL
    t = t + "VAR c AS Integer" + NL
    t = t + "VAR rows AS Array OF String" + NL
    t = t + "VAR digits AS String" + NL
    t = t + "VAR x AS Integer" + NL
    t = t + "VAR y AS Integer" + NL
    t = t + "VAR k AS Integer" + NL
    t = t + "VAR left AS Integer" + NL
    t = t + "VAR msg AS String" + NL
    t = t + "VAR here AS String" + NL
    t = t + "VAR pics AS String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR mark AS String" + NL
    t = t + "r = Num(REQUEST.Query(""r""), 0, 15, 5)" + NL
    t = t + "c = Num(REQUEST.Query(""c""), 0, 15, 0)" + NL
    t = t + "left = CoolLeft(REQUEST.From)" + NL
    t = t + "SELECT CASE REQUEST.Query(""m"")" + NL
    t = t + "    CASE ""ok""" + NL
    t = t + "        msg = ""Placed: "" + ColourName(c) + "" at "" + Str(Num(REQUEST.Query(""x""), 0, SIZE - 1, 0)) + "","" + Str(Num(REQUEST.Query(""y""), 0, SIZE - 1, 0)) + "".""" + NL
    t = t + "    CASE ""wait""" + NL
    t = t + "        msg = ""Not yet: one pixel every "" + Str(COOLDOWN) + "" seconds.""" + NL
    t = t + "    CASE ""busy""" + NL
    t = t + "        msg = ""The wall was busy: try again.""" + NL
    t = t + "    CASE ""bad""" + NL
    t = t + "        msg = ""That isn't a square on the wall.""" + NL
    t = t + "END SELECT" + NL
    t = t + "IF Fancy() THEN" + NL
    t = t + "    rows = WallRows()" + NL
    t = t + "    here = SERVER.ScriptName.Substring(0, LastAt(SERVER.ScriptName, ""\"") + 1)" + NL
    t = t + "%><html><head><title>The Pixel Wall</title><meta name=""robots"" content=""nofollow""></head><body bgcolor=""#C0C0C0"">" + NL
    t = t + "<script language=""JavaScript"">" + NL
    t = t + "var S = {r:<%= r %>, c:<%= c %>, v:<%= Version() %>, cool:<%= COOLDOWN %>, rows:""<%= RegionDigits(rows, r) %>"", due:0, left:<%= left %>, feed:unescape(""<%= JsEscape(Feed().Join(Chr(10))) %>""), msg:unescape(""<%= JsEscape(msg) %>"")};" + NL
    t = t + "var CODE = unescape(""<%= JsEscape(ReadOr(here + ""WALL.JS"", ""document.write('WALL.JS is missing.');"")) %>"");" + NL
    t = t + "eval(CODE);" + NL
    t = t + "</script>" + NL
    t = t + "</body></html>" + NL
    t = t + "<%" + NL
    t = t + "    RESPONSE.End()" + NL
    t = t + "END IF" + NL
    t = t + "rows = WallRows()" + NL
    t = t + "digits = RegionDigits(rows, r)" + NL
    t = t + "here = REQUEST.Path.Substring(0, LastAt(REQUEST.Path, ""/"") + 1)" + NL
    t = t + "' The pictures by this machine's address, not its name: Voyager asks for them" + NL
    t = t + "' all at once, and when several lookups of one name are out at once, the" + NL
    t = t + "' network keeps only the last (SIM95-NOTES.md). By name, one picture came." + NL
    t = t + "' (A site served by name, under simweb, keeps them by name, as it must.)" + NL
    t = t + "pics = """"" + NL
    t = t + "IF REQUEST.Header(""X-Base-Path"") = """" AND NET.LocalAddress <> """" THEN pics = ""http://"" + NET.LocalAddress + here" + NL
    t = t + "%><html><head><title>The Pixel Wall</title><meta name=""robots"" content=""nofollow""></head>" + NL
    t = t + "<body bgcolor=""#C0C0C0"" link=""#000080"" vlink=""#000080"" onload=""Page_Load"">" + NL
    t = t + "<script type=""spark"">" + NL
    t = t + "SUB Page_Load ()" + NL
    t = t + "    SYS.Sleep(30000)" + NL
    t = t + "    PAGE.Navigate(""http://<%= REQUEST.Host %><%= here %>index.asp?r=<%= r %>&c=<%= c %>"")" + NL
    t = t + "END SUB" + NL
    t = t + "</script>" + NL
    t = t + "<center><font size=""5""><b>The Pixel Wall</b></font><br>" + NL
    t = t + "<font size=""2"">Everyone on the network shares this wall. Pick a colour, then click a square: one pixel every <%= COOLDOWN %> seconds.</font>" + NL
    t = t + "<p><table cellspacing=""10"" border=""0""><tr><td valign=""top"">" + NL
    t = t + "<table cellspacing=""1"" cellpadding=""0"" border=""0"" bgcolor=""#808080"">" + NL
    t = t + "<% FOR y = 0 TO TILE - 1 %><tr><% FOR x = 0 TO TILE - 1" + NL
    t = t + "    k = HEXDIGITS.IndexOf(digits.CharAt(y * TILE + x)) %><td bgcolor=""<%= ColourHex(k) %>""><a href=""place.asp?x=<%= (r MOD 4) * TILE + x %>&y=<%= Int(r / 4) * TILE + y %>&c=<%= c %>&r=<%= r %>""><img src=""<%= pics %>c<%= HEXDIGITS.CharAt(k) %>.pic"" width=""20"" height=""20"" alt=""""></a></td><% NEXT %></tr>" + NL
    t = t + "<% NEXT %></table>" + NL
    t = t + "</td><td valign=""top"">" + NL
    t = t + "<b>The whole wall</b><br><img src=""<%= pics %>wall.asp?v=<%= Version() %>"" width=""128"" height=""128"" alt=""the wall""><br>" + NL
    t = t + "<font size=""2"">Go to another part:</font><br>" + NL
    t = t + "<table cellspacing=""1"" cellpadding=""0"" border=""0"" bgcolor=""#808080"">" + NL
    t = t + "<% FOR k = 0 TO 15" + NL
    t = t + "    IF k MOD 4 = 0 THEN RESPONSE.Write(""<tr>"")" + NL
    t = t + "    IF k = r THEN %><td width=""32"" height=""20"" align=""center"" bgcolor=""#000080""><font size=""2"" color=""#FFFFFF""><b><%= ""ABCD"".CharAt(Int(k / 4)) + Str(k MOD 4 + 1) %></b></font></td><% ELSE %><td width=""32"" height=""20"" align=""center"" bgcolor=""#FFFFFF""><font size=""2""><a href=""index.asp?r=<%= k %>&c=<%= c %>""><%= ""ABCD"".CharAt(Int(k / 4)) + Str(k MOD 4 + 1) %></a></font></td><% END IF" + NL
    t = t + "    IF k MOD 4 = 3 THEN RESPONSE.Write(""</tr>"")" + NL
    t = t + "NEXT %></table>" + NL
    t = t + "<p><b>Colour:</b> <%= ColourName(c) %><br>" + NL
    t = t + "<table cellspacing=""1"" cellpadding=""0"" border=""0"" bgcolor=""#808080"">" + NL
    t = t + "<% FOR k = 0 TO 15" + NL
    t = t + "    IF k MOD 8 = 0 THEN RESPONSE.Write(""<tr>"")" + NL
    t = t + "    ' (a one-colour picture in each link, which a link doesn't underline;" + NL
    t = t + "    ' the colour in use has a dot in it)" + NL
    t = t + "    mark = ""c""" + NL
    t = t + "    IF k = c THEN mark = ""s"" %><td bgcolor=""<%= ColourHex(k) %>""><a href=""index.asp?r=<%= r %>&c=<%= k %>""><img src=""<%= pics %><%= mark + HEXDIGITS.CharAt(k) %>.pic"" width=""20"" height=""20"" alt=""""></a></td><%" + NL
    t = t + "    IF k MOD 8 = 7 THEN RESPONSE.Write(""</tr>"")" + NL
    t = t + "NEXT %></table>" + NL
    t = t + "<p><b><% IF left > 0 THEN %>Next pixel in <%= left %> seconds<% ELSE %>Ready: click a square<% END IF %></b><br>" + NL
    t = t + "<font size=""2""><%= SERVER.HtmlEncode(msg) %></font>" + NL
    t = t + "<p><b>Latest pixels</b><br><font size=""2""><% FOR EACH line IN Feed() %><%= SERVER.HtmlEncode(line) %><br><% NEXT %></font>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<p><font size=""2"">This page reloads itself every 30 seconds. <a href=""index.asp?r=<%= r %>&c=<%= c %>"">Reload now</a>." + NL
    t = t + "Best viewed in Simxplorer, where new pixels appear by themselves.</font></center>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\INDEX.ASP")
END SUB

SUB File18 ()
    t = ""
    t = t + "<%@ import file=""WALL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' PLACE.ASP - one pixel: x and y (0-63) and c (0-15)." + NL
    t = t + "'   GET (a link, from Voyager): back to the page, with how it went in m" + NL
    t = t + "'   POST (Simxplorer's XMLHttpRequest): OK, WAIT, BUSY or BAD on the first" + NL
    t = t + "'        line, then the state of region r, as DATA.ASP gives it" + NL
    t = t + "VAR x AS Integer" + NL
    t = t + "VAR y AS Integer" + NL
    t = t + "VAR c AS Integer" + NL
    t = t + "VAR r AS Integer" + NL
    t = t + "VAR said AS String" + NL
    t = t + "VAR agent AS String" + NL
    t = t + "' Robots don't get to draw: AskSim's crawler follows every link, and each" + NL
    t = t + "' square is one, so it once put Black pixels on the wall from STARTHERE." + NL
    t = t + "agent = REQUEST.Header(""User-Agent"").Lower()" + NL
    t = t + "IF agent.Contains(""asksim"") OR agent.Contains(""bot"") OR agent.Contains(""crawl"") OR agent.Contains(""spider"") THEN" + NL
    t = t + "    RESPONSE.Clear()" + NL
    t = t + "    RESPONSE.Status = ""403 Forbidden""" + NL
    t = t + "    RESPONSE.ContentType = ""text/plain""" + NL
    t = t + "    RESPONSE.Write(""Robots don't get to draw on the wall."")" + NL
    t = t + "    RESPONSE.End()" + NL
    t = t + "END IF" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    x = Num(REQUEST.Form(""x""), 0, SIZE - 1, -1)" + NL
    t = t + "    y = Num(REQUEST.Form(""y""), 0, SIZE - 1, -1)" + NL
    t = t + "    c = Num(REQUEST.Form(""c""), 0, 15, -1)" + NL
    t = t + "    r = Num(REQUEST.Form(""r""), 0, 15, 5)" + NL
    t = t + "ELSE" + NL
    t = t + "    x = Num(REQUEST.Query(""x""), 0, SIZE - 1, -1)" + NL
    t = t + "    y = Num(REQUEST.Query(""y""), 0, SIZE - 1, -1)" + NL
    t = t + "    c = Num(REQUEST.Query(""c""), 0, 15, -1)" + NL
    t = t + "    r = Num(REQUEST.Query(""r""), 0, 15, 5)" + NL
    t = t + "END IF" + NL
    t = t + "IF x < 0 OR y < 0 OR c < 0 THEN" + NL
    t = t + "    said = ""BAD""" + NL
    t = t + "ELSE" + NL
    t = t + "    said = Place(REQUEST.From, x, y, c)" + NL
    t = t + "END IF" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    RESPONSE.Clear()" + NL
    t = t + "    RESPONSE.ContentType = ""text/plain""" + NL
    t = t + "    RESPONSE.Write(said + Chr(10) + State(r, REQUEST.From))" + NL
    t = t + "    RESPONSE.End()" + NL
    t = t + "END IF" + NL
    t = t + "IF c < 0 THEN c = 0" + NL
    t = t + "RESPONSE.Redirect(""index.asp?r="" + Str(r) + ""&c="" + Str(c) + ""&m="" + said.Lower() + ""&x="" + Str(x) + ""&y="" + Str(y))" + NL
    t = t + "%>" + NL
    Put("C:\WEB\PLACE.ASP")
END SUB

