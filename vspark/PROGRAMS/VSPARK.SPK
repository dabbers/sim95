    evtList.onSelect = EvtList_OnSelect
    editor = GUI_TextArea.New(win)
    editor.SetBounds(134, 58, 450, 444)
    editor.Syntax = "SPARK"
    layoutEd = GUI_TextArea.New(win)
    layoutEd.SetBounds(134, 32, 450, 470)
    layoutEd.Syntax = "SPARK"
    layoutEd.Visible = FALSE

    l = GUI_Label.New(win)
    l.Text = "Properties"
    l.Bold = TRUE
    l.SetBounds(592, 8, 180, 16)
    propObj = GUI_DropDown.New(win)
    propObj.SetBounds(592, 26, 128, 21)
    propObj.onSelect = PropObj_OnSelect
    propDel = GUI_Button.New(win)
    propDel.Text = "&Delete"
    propDel.SetBounds(724, 25, 50, 23)
    propDel.onClick = PropDel_OnClick
    propList = GUI_ListBox.New(win)
    propList.SetBounds(592, 52, 182, 300)
    propList.Mono = TRUE
    propList.onSelect = PropList_OnSelect
    propList.onDblClick = PropList_OnDblClick
    propEdit = GUI_TextBox.New(win)
    propEdit.SetBounds(592, 358, 182, 21)
    propEdit.onEnter = PropEdit_OnEnter
    propHelp = GUI_TextArea.New(win)
    propHelp.SetBounds(592, 384, 182, 118)
    propHelp.ReadOnly = TRUE
    propHelp.WordWrap = TRUE

    ' a project to start with: the one asked for, or an empty form
    IF SYS.Args.Count > 0 THEN
        IF FS.Exists(SYS.Args[0]) THEN
            LoadText(FS.Read(SYS.Args[0]), SYS.Args[0])
        END IF
    END IF
    IF kType.Count = 0 THEN LoadTemplate("EMPTY.SPK")
    ShowForm()
    win.Show()
END SUB

' (A window that is closing can't be kept open: so the question is whether
' to save first.)
SUB Win_OnClose ()
    VAR box AS GUI_MessageBox
    EndRun()
    IF Dirty() THEN
        box = GUI_MessageBox.New(win)
        box.Title = "Visual SPARK"
        box.Kind = "confirm"
        box.Buttons = "yesno"
        box.Text = "Save the changes to " + projName + " before closing?"
        IF box.Show() THEN SaveProject()
    END IF
    SYS.Exit(0)
END SUB

SUB Say (text AS String, kind AS String)
    VAR box AS GUI_MessageBox
    box = GUI_MessageBox.New(win)
    box.Title = "Visual SPARK"
    box.Kind = kind
    box.Text = text
    box.Show()
END SUB

' ================================================================ the model

FUNCTION GetP (i AS Integer, key AS String) AS String
    VAR line AS String
    FOR EACH line IN kProps[i].Split(EOL)
        IF line.StartsWith(key + "=") THEN RETURN line.Substring(key.Length + 1, line.Length - key.Length - 1)
    NEXT
    RETURN PropDefault(kType[i], key)
END FUNCTION

FUNCTION GetN (i AS Integer, key AS String) AS Integer
    RETURN Int(Val(GetP(i, key)))
END FUNCTION

FUNCTION GetB (i AS Integer, key AS String) AS Bool
    RETURN GetP(i, key).Upper() = "TRUE"
END FUNCTION

SUB SetP (i AS Integer, key AS String, value AS String)
    VAR out AS Array OF String
    VAR line AS String
    VAR found AS Bool
    FOR EACH line IN kProps[i].Split(EOL)
        IF line = "" THEN CONTINUE
        IF line.StartsWith(key + "=") THEN
            out.Add(key + "=" + value)
            found = TRUE
        ELSE
            out.Add(line)
        END IF
    NEXT
    IF NOT found THEN out.Add(key + "=" + value)
    kProps[i] = out.Join(EOL)
END SUB

' Each type's properties, in order: Key|kind|default. Kinds: name, text,
' int, bool, items (separated by ;), color (0-15), choice:a,b,c.
FUNCTION Props (t AS String) AS Array OF String
    VAR out AS Array OF String
    IF t = "MenuItem" THEN
        out = ["Name|name|", "Caption|text|", "Level|int|0", "Shortcut|shortcut|", "Checked|bool|FALSE", "Enabled|bool|TRUE"]
        RETURN out
    END IF
    IF t = "Form" THEN
        out = ["Name|name|Form1", "Title|text|Form1", "Width|int|320", "Height|int|240", "Status|text|", "Resizable|bool|TRUE", "Icon|choice:app,notes,terminal,spark,voyager,chat,network,settings,sketch,mines,monitor,help,folder,computer,info|app"]
        RETURN out
    END IF
    out.Add("Name|name|")
    IF t <> "Timer" AND t <> "ProgressBar" AND t <> "Canvas" THEN out.Add("Text|text|")
    out.Add("X|int|0")
    out.Add("Y|int|0")
    IF t <> "Timer" THEN
        out.Add("Width|int|64")
        out.Add("Height|int|24")
        out.Add("Visible|bool|TRUE")
        out.Add("Anchor|anchor|Top,Left")
    END IF
    out.Add("Enabled|bool|TRUE")
    SELECT CASE t
        CASE "Label"
            out.Add("Align|choice:left,center,right|left")
            out.Add("Bold|bool|FALSE")
        CASE "Button"
            out.Add("Default|bool|FALSE")
            out.Add("Cancel|bool|FALSE")
        CASE "TextBox"
            out.Add("Password|bool|FALSE")
            out.Add("ReadOnly|bool|FALSE")
            out.Add("MaxLength|int|0")
        CASE "TextArea"
            out.Add("ReadOnly|bool|FALSE")
            out.Add("WordWrap|bool|FALSE")
        CASE "CheckBox"
            out.Add("Checked|bool|FALSE")
        CASE "RadioButton"
            out.Add("Checked|bool|FALSE")
            out.Add("Group|text|")
        CASE "ListBox"
            out.Add("Items|items|")
            out.Add("Selected|int|-1")
            out.Add("Mono|bool|FALSE")
        CASE "DropDown"
            out.Add("Items|items|")
            out.Add("Selected|int|-1")
        CASE "ProgressBar"
            out.Add("Value|int|0")
            out.Add("Max|int|100")
        CASE "Canvas"
            out.Add("Background|color|15")
        CASE "Timer"
            out.Add("Interval|int|1000")
    END SELECT
    RETURN out
END FUNCTION

FUNCTION PropEntry (t AS String, key AS String) AS String
    VAR e AS String
    FOR EACH e IN Props(t)
        IF e.StartsWith(key + "|") THEN RETURN e
    NEXT
    RETURN ""
END FUNCTION

FUNCTION PropKind (t AS String, key AS String) AS String
    VAR e AS String
    e = PropEntry(t, key)
    IF e = "" THEN RETURN "text"
    RETURN e.Split("|")[1]
END FUNCTION

FUNCTION PropDefault (t AS String, key AS String) AS String
    VAR e AS String
    e = PropEntry(t, key)
    IF e = "" THEN RETURN ""
    RETURN e.Split("|")[2]
END FUNCTION

' Command1, Label1...: the names Visual BASIC gave them.
FUNCTION Prefix (t AS String) AS String
    SELECT CASE t
        CASE "Button"
            RETURN "Command"
        CASE "TextBox"
            RETURN "Text"
        CASE "TextArea"
            RETURN "Memo"
        CASE "CheckBox"
            RETURN "Check"
        CASE "RadioButton"
            RETURN "Option"
        CASE "ListBox"
            RETURN "List"
        CASE "DropDown"
            RETURN "Combo"
        CASE "ProgressBar"
            RETURN "Progress"
        CASE "Canvas"
            RETURN "Picture"
    END SELECT
    RETURN t
END FUNCTION

FUNCTION NameTaken (name AS String, but AS Integer) AS Bool
    VAR i AS Integer
    IF name.Lower() = "menubar" THEN RETURN TRUE
    FOR i = 0 TO kType.Count - 1
        IF i <> but AND GetP(i, "Name").Lower() = name.Lower() THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

FUNCTION NextName (t AS String) AS String
    VAR n AS Integer
    n = 1
    WHILE NameTaken(Prefix(t) + Str(n), -1)
        n = n + 1
    END WHILE
    RETURN Prefix(t) + Str(n)
END FUNCTION

FUNCTION DefaultW (t AS String) AS Integer
    SELECT CASE t
        CASE "Label"
            RETURN 80
        CASE "Button"
            RETURN 80
        CASE "TextArea"
            RETURN 160
        CASE "ListBox"
            RETURN 120
        CASE "ProgressBar"
            RETURN 160
        CASE "Canvas"
            RETURN 160
        CASE "Timer"
            RETURN 24
    END SELECT
    RETURN 120
END FUNCTION

FUNCTION DefaultH (t AS String) AS Integer
    SELECT CASE t
        CASE "Label"
            RETURN 16
        CASE "TextBox"
            RETURN 24
        CASE "DropDown"
            RETURN 24
        CASE "CheckBox"
            RETURN 16
        CASE "RadioButton"
            RETURN 16
        CASE "ProgressBar"
            RETURN 16
        CASE "TextArea"
            RETURN 80
        CASE "ListBox"
            RETURN 80
        CASE "Canvas"
            RETURN 96
    END SELECT
    RETURN 24
END FUNCTION

FUNCTION AddControl (t AS String, x AS Integer, y AS Integer, w AS Integer, h AS Integer) AS Integer
    VAR i AS Integer
    VAR name AS String
    name = NextName(t)
    kType.Add(t)
    kProps.Add("")
    i = kType.Count - 1
    SetP(i, "Name", name)
    IF t = "Label" OR t = "Button" OR t = "CheckBox" OR t = "RadioButton" THEN SetP(i, "Text", name)
    SetP(i, "X", Str(x))
    SetP(i, "Y", Str(y))
    IF t <> "Timer" THEN
        SetP(i, "Width", Str(w))
        SetP(i, "Height", Str(h))
    END IF
    RETURN i
END FUNCTION

FUNCTION ClassOf (t AS String) AS String
    IF t = "Form" THEN RETURN "GUI_Window"
    RETURN "GUI_" + t
END FUNCTION

' ================================================================ events

' Each type's events; the first is the one a double-click goes to.
FUNCTION Events (t AS String) AS Array OF String
    VAR out AS Array OF String
    SELECT CASE t
        CASE "Form"
            out = ["Load", "onClose", "onResize", "onActivate", "onKey"]
        CASE "Button"
            out = ["onClick", "onKey"]
        CASE "TextBox"
            out = ["onChange", "onEnter", "onKey"]
        CASE "TextArea"
            out = ["onChange", "onCursor", "onKey"]
        CASE "CheckBox"
            out = ["onChange", "onKey"]
        CASE "RadioButton"
            out = ["onChange", "onKey"]
        CASE "ListBox"
            out = ["onSelect", "onDblClick", "onKey"]
        CASE "DropDown"
            out = ["onSelect", "onKey"]
        CASE "Canvas"
            out = ["onMouseDown", "onMouseMove", "onMouseUp", "onDraw", "onKey"]
        CASE "Timer"
            out = ["onTick"]
        CASE "MenuItem"
            out = ["onClick"]
        CASE ELSE
            out = ["onKey"]
    END SELECT
    RETURN out
END FUNCTION

FUNCTION Params (evt AS String) AS String
    SELECT CASE evt
        CASE "onKey"
            RETURN "key AS String"
        CASE "onDraw"
            RETURN "canvas AS GUI_Canvas"
        CASE "onMouseDown"
            RETURN "x AS Integer, y AS Integer, button AS Integer"
        CASE "onMouseUp"
            RETURN "x AS Integer, y AS Integer, button AS Integer"
        CASE "onMouseMove"
            RETURN "x AS Integer, y AS Integer"
    END SELECT
    RETURN ""
END FUNCTION

' The SUB an event goes to: Command1_OnClick, or Main for the form's Load.
FUNCTION HandlerOf (i AS Integer, evt AS String) AS String
    IF evt = "Load" THEN RETURN "Main"
    RETURN GetP(i, "Name") + "_On" + evt.Substring(2, evt.Length - 2)
END FUNCTION

' What a new SUB starts with: a line on when it runs, and an example.
FUNCTION Body (i AS Integer, evt AS String) AS String
    VAR n AS String
    VAR form AS String
    n = GetP(i, "Name")
    form = GetP(0, "Name")
    SELECT CASE evt
        CASE "Load"
            RETURN "    InitForm()" + EOL + "    " + form + ".Show()"
        CASE "onClick"
            IF kType[i] = "MenuItem" THEN RETURN "    ' when " + Plain(GetP(i, "Caption")) + " is chosen from the menu. For example:" + EOL + "    ' " + form + ".Title = " + Q + "Chosen!" + Q
            RETURN "    ' when " + n + " is clicked. For example:" + EOL + "    ' " + form + ".Title = " + Q + "Clicked!" + Q
        CASE "onChange"
            IF kType[i] = "CheckBox" OR kType[i] = "RadioButton" THEN RETURN "    ' when " + n + " is ticked or unticked: " + n + ".Checked says which"
            RETURN "    ' when the text in " + n + " changes: it's in " + n + ".Text"
        CASE "onEnter"
            RETURN "    ' when Enter is pressed in " + n + ". For example:" + EOL + "    ' " + form + ".Title = " + n + ".Text"
        CASE "onSelect"
            RETURN "    ' when something in " + n + " is picked: " + n + ".Selected is which (from 0)"
        CASE "onDblClick"
            RETURN "    ' when an item in " + n + " is double-clicked"
        CASE "onTick"
            RETURN "    ' every " + n + ".Interval milliseconds (" + n + ".Stop() stops it)"
        CASE "onKey"
            RETURN "    ' a key: " + Q + "A" + Q + ", " + Q + "Enter" + Q + ", " + Q + "ArrowLeft" + Q + ", " + Q + "Ctrl+S" + Q + "..." + EOL + "    IF key = " + Q + "Escape" + Q + " THEN " + form + ".Close()"
        CASE "onMouseDown"
            RETURN "    ' x and y are where, inside " + n + ". For example:" + EOL + "    " + n + ".SetColor(12)" + EOL + "    " + n + ".FillCircle(x, y, 3)"
        CASE "onMouseMove"
            RETURN "    ' the mouse moved over " + n + ", to x, y"
        CASE "onMouseUp"
            RETURN "    ' the mouse button went up over " + n
        CASE "onDraw"
            RETURN "    ' draw " + n + " here: it's shown, or its size changed" + EOL + "    canvas.SetColor(4)" + EOL + "    canvas.Text(8, 8, " + Q + "Hello" + Q + ")"
        CASE "onClose"
            RETURN "    ' the window is closing" + EOL + "    SYS.Exit(0)"
        CASE "onResize"
            RETURN "    ' the window changed size: " + form + ".Width and " + form + ".Height"
        CASE "onActivate"
            RETURN "    ' the window came to the front"
    END SELECT
    RETURN ""
END FUNCTION

' ================================================================ reading and writing projects

FUNCTION Enc (v AS String) AS String
    RETURN v.Replace("%", "%25").Replace("|", "%7C")
END FUNCTION

FUNCTION Dec (v AS String) AS String
    RETURN v.Replace("%7C", "|").Replace("%25", "%")
END FUNCTION

' A SPARK string literal: "He said ""hi"""
FUNCTION Lit (s AS String) AS String
    RETURN Q + s.Replace(Q, Q + Q) + Q
END FUNCTION

' The SUBs in the code, upper case, as ",NAME,NAME,".
FUNCTION SubNames () AS String
    VAR out AS String
    VAR line AS String
    VAR t AS String
    VAR n AS String
    out = ","
    FOR EACH line IN editor.Text.Lines()
        t = line.Trim()
        IF t.Upper().StartsWith("SUB ") OR t.Upper().StartsWith("FUNCTION ") THEN
            n = t.Substring(t.IndexOf(" ") + 1, t.Length - t.IndexOf(" ") - 1).Trim()
            IF n.Contains("(") THEN n = n.Substring(0, n.IndexOf("("))
            IF n.Contains(" ") THEN n = n.Substring(0, n.IndexOf(" "))
            out = out + n.Upper() + ","
        END IF
    NEXT
    RETURN out
END FUNCTION

' The line (from 1) the SUB starts on, or 0.
FUNCTION FindSub (name AS String) AS Integer
    VAR lines AS Array OF String
    VAR k AS Integer
    VAR t AS String
    lines = editor.Text.Lines()
    FOR k = 0 TO lines.Count - 1
        t = lines[k].Trim().Upper()
        IF t.StartsWith("SUB " + name.Upper() + " ") OR t.StartsWith("SUB " + name.Upper() + "(") OR t = "SUB " + name.Upper() THEN RETURN k + 1
    NEXT
    RETURN 0
END FUNCTION

' The designer's part of the file: what it reads back, then what runs.
FUNCTION Block () AS String
    VAR out AS Array OF String
    VAR i AS Integer
    VAR e AS String
    VAR key AS String
    VAR line AS String
    VAR n AS String
    VAR t AS String
    VAR subs AS String
    VAR item AS String
    VAR evt AS String
    VAR top AS String
    VAR cap AS String
    VAR cases AS Array OF String
    subs = SubNames()
    out.Add(MARKSTART + ": the designer writes everything from here to END OF FORM. =====")
    FOR i = 0 TO kType.Count - 1
        line = ""
        FOR EACH e IN Props(kType[i])
            key = e.Split("|")[0]
            line = line + "|" + key + "=" + Enc(GetP(i, key))
        NEXT
        IF i = 0 THEN
            out.Add("' FORM " + kType[i] + line)
        ELSE
            out.Add("' CTRL " + kType[i] + line)
        END IF
    NEXT
    FOR i = 0 TO kType.Count - 1
        IF kType[i] <> "MenuItem" THEN out.Add("VAR " + GetP(i, "Name") + " AS " + ClassOf(kType[i]))
    NEXT
    IF HasMenu() THEN out.Add("VAR MenuBar AS GUI_Menu")
    out.Add("")
    out.Add("SUB InitForm ()")
    n = GetP(0, "Name")
    out.Add("    " + n + " = GUI_Window.New(" + Lit(GetP(0, "Title")) + ", " + Str(GetN(0, "Width")) + ", " + Str(GetN(0, "Height")) + ")")
    IF GetP(0, "Status") <> "" THEN out.Add("    " + n + ".Status = " + Lit(GetP(0, "Status")))
    IF NOT GetB(0, "Resizable") THEN out.Add("    " + n + ".Resizable = FALSE")
    IF GetP(0, "Icon") <> "app" THEN out.Add("    " + n + ".Icon = " + Lit(GetP(0, "Icon")))
    FOR EACH evt IN Events("Form")
        IF evt = "onResize" AND Anchored() THEN CONTINUE
        IF evt <> "Load" AND subs.Contains("," + HandlerOf(0, evt).Upper() + ",") THEN out.Add("    " + n + "." + evt + " = " + HandlerOf(0, evt))
    NEXT
    IF Anchored() THEN out.Add("    " + n + ".onResize = " + n + "_Layout")
    ' the menu bar, and which items have code
    IF HasMenu() THEN
        out.Add("    MenuBar = GUI_Menu.New(" + n + ")")
        top = ""
        FOR i = 1 TO kType.Count - 1
            IF kType[i] <> "MenuItem" THEN CONTINUE
            cap = GetP(i, "Caption")
            IF GetN(i, "Level") = 0 OR top = "" THEN
                top = cap
                out.Add("    MenuBar.AddMenu(" + Lit(cap) + ")")
            ELSEIF cap = "-" THEN
                out.Add("    MenuBar.AddSeparator(" + Lit(top) + ")")
            ELSE
                IF GetP(i, "Shortcut") <> "" THEN
                    out.Add("    MenuBar.AddItem(" + Lit(top) + ", " + Lit(cap) + " + Chr(9) + " + Lit(GetP(i, "Shortcut")) + ")")
                ELSE
                    out.Add("    MenuBar.AddItem(" + Lit(top) + ", " + Lit(cap) + ")")
                END IF
                IF GetB(i, "Checked") THEN out.Add("    MenuBar.SetChecked(" + Lit(Plain(cap)) + ", TRUE)")
                IF NOT GetB(i, "Enabled") THEN out.Add("    MenuBar.SetEnabled(" + Lit(Plain(cap)) + ", FALSE)")
                IF subs.Contains("," + HandlerOf(i, "onClick").Upper() + ",") THEN
                    cases.Add("        CASE " + Lit(Plain(cap)))
                    cases.Add("            " + HandlerOf(i, "onClick") + "()")
                END IF
            END IF
        NEXT
        IF cases.Count > 0 THEN out.Add("    MenuBar.onSelect = MenuBar_OnSelect")
    END IF
    FOR i = 1 TO kType.Count - 1
        n = GetP(i, "Name")
        t = kType[i]
        IF t = "MenuItem" THEN CONTINUE
        out.Add("    " + n + " = " + ClassOf(t) + ".New(" + GetP(0, "Name") + ")")
        IF t <> "Timer" THEN out.Add("    " + n + ".SetBounds(" + Str(GetN(i, "X")) + ", " + Str(GetN(i, "Y")) + ", " + Str(GetN(i, "Width")) + ", " + Str(GetN(i, "Height")) + ")")
        IF PropEntry(t, "Text") <> "" AND GetP(i, "Text") <> "" THEN out.Add("    " + n + ".Text = " + Lit(GetP(i, "Text")))
        IF t <> "Timer" AND NOT GetB(i, "Visible") THEN out.Add("    " + n + ".Visible = FALSE")
        IF t <> "Timer" AND NOT GetB(i, "Enabled") THEN out.Add("    " + n + ".Enabled = FALSE")
        SELECT CASE t
            CASE "Label"
                IF GetP(i, "Align") <> "left" THEN out.Add("    " + n + ".Align = " + Lit(GetP(i, "Align")))
                IF GetB(i, "Bold") THEN out.Add("    " + n + ".Bold = TRUE")
            CASE "Button"
                IF GetB(i, "Default") THEN out.Add("    " + n + ".Default = TRUE")
                IF GetB(i, "Cancel") THEN out.Add("    " + n + ".Cancel = TRUE")
            CASE "TextBox"
                IF GetB(i, "Password") THEN out.Add("    " + n + ".Password = TRUE")
                IF GetB(i, "ReadOnly") THEN out.Add("    " + n + ".ReadOnly = TRUE")
                IF GetN(i, "MaxLength") > 0 THEN out.Add("    " + n + ".MaxLength = " + Str(GetN(i, "MaxLength")))
            CASE "TextArea"
                IF GetB(i, "ReadOnly") THEN out.Add("    " + n + ".ReadOnly = TRUE")
                IF GetB(i, "WordWrap") THEN out.Add("    " + n + ".WordWrap = TRUE")
            CASE "CheckBox"
                IF GetB(i, "Checked") THEN out.Add("    " + n + ".Checked = TRUE")
            CASE "RadioButton"
                IF GetP(i, "Group") <> "" THEN out.Add("    " + n + ".Group = " + Lit(GetP(i, "Group")))
                IF GetB(i, "Checked") THEN out.Add("    " + n + ".Checked = TRUE")
            CASE "ListBox"
                IF GetB(i, "Mono") THEN out.Add("    " + n + ".Mono = TRUE")
                FOR EACH item IN GetP(i, "Items").Split(";")
                    IF item.Trim() <> "" THEN out.Add("    " + n + ".Add(" + Lit(item.Trim()) + ")")
                NEXT
                IF GetN(i, "Selected") >= 0 THEN out.Add("    " + n + ".Selected = " + Str(GetN(i, "Selected")))
            CASE "DropDown"
                FOR EACH item IN GetP(i, "Items").Split(";")
                    IF item.Trim() <> "" THEN out.Add("    " + n + ".Add(" + Lit(item.Trim()) + ")")
                NEXT
                IF GetN(i, "Selected") >= 0 THEN out.Add("    " + n + ".Selected = " + Str(GetN(i, "Selected")))
            CASE "ProgressBar"
                IF GetN(i, "Max") <> 100 THEN out.Add("    " + n + ".Max = " + Str(GetN(i, "Max")))
                IF GetN(i, "Value") <> 0 THEN out.Add("    " + n + ".Value = " + Str(GetN(i, "Value")))
            CASE "Canvas"
                IF GetN(i, "Background") <> 15 THEN
                    out.Add("    " + n + ".Background = " + Str(GetN(i, "Background")))
                    out.Add("    " + n + ".Clear()")
                END IF
            CASE "Timer"
                out.Add("    " + n + ".Interval = " + Str(MATH.Max(1, GetN(i, "Interval"))))
        END SELECT
        FOR EACH evt IN Events(t)
            IF subs.Contains("," + HandlerOf(i, evt).Upper() + ",") THEN out.Add("    " + n + "." + evt + " = " + HandlerOf(i, evt))
        NEXT
    NEXT
    ' timers start last, when everything they might touch is there
    FOR i = 1 TO kType.Count - 1
        IF kType[i] = "Timer" AND GetB(i, "Enabled") THEN out.Add("    " + GetP(i, "Name") + ".Start()")
    NEXT
    out.Add("END SUB")
    ' anchored controls follow the window's edges
    IF Anchored() THEN
        n = GetP(0, "Name")
        out.Add("")
        out.Add("SUB " + n + "_Layout ()")
        out.Add("    VAR dw AS Integer")
        out.Add("    VAR dh AS Integer")
        out.Add("    dw = " + n + ".Width - " + Str(GetN(0, "Width")))
        out.Add("    dh = " + n + ".Height - " + Str(GetN(0, "Height")))
        FOR i = 1 TO kType.Count - 1
            IF Movable(i) AND kType[i] <> "Timer" THEN
                IF GetP(i, "Anchor") <> "Top,Left" THEN out.Add("    " + GetP(i, "Name") + ".SetBounds(" + Span(GetN(i, "X"), GetN(i, "Width"), GetP(i, "Anchor"), "Left", "Right", "dw", TRUE) + ", " + Span(GetN(i, "Y"), GetN(i, "Height"), GetP(i, "Anchor"), "Top", "Bottom", "dh", TRUE) + ", " + Span(GetN(i, "X"), GetN(i, "Width"), GetP(i, "Anchor"), "Left", "Right", "dw", FALSE) + ", " + Span(GetN(i, "Y"), GetN(i, "Height"), GetP(i, "Anchor"), "Top", "Bottom", "dh", FALSE) + ")")
            END IF
        NEXT
        IF subs.Contains("," + HandlerOf(0, "onResize").Upper() + ",") THEN out.Add("    " + HandlerOf(0, "onResize") + "()")
        out.Add("END SUB")
    END IF
    ' a menu has one event for all its items: this hands each to its SUB
    IF cases.Count > 0 THEN
        out.Add("")
        out.Add("SUB MenuBar_OnSelect (item AS String)")
        out.Add("    SELECT CASE item")
        FOR EACH line IN cases
            out.Add(line)
        NEXT
        out.Add("    END SELECT")
        out.Add("END SUB")
    END IF
    out.Add(MARKEND)
    RETURN out.Join(EOL) + EOL
END FUNCTION

' The code without blank lines at its end.
FUNCTION Trimmed (code AS String) AS String
    VAR lines AS Array OF String
    lines = code.Replace(Chr(13), "").Split(EOL)
    WHILE lines.Count > 0
        IF lines[lines.Count - 1].Trim() <> "" THEN BREAK
        lines.RemoveAt(lines.Count - 1)
    END WHILE
    RETURN lines.Join(EOL)
END FUNCTION

' The whole file: the code, then the form.
FUNCTION Assemble () AS String
    RETURN Trimmed(editor.Text) + EOL + EOL + Block()
END FUNCTION

' A project's file into the designer and the code window.
SUB LoadText (text AS String, src AS String)
    VAR code AS Array OF String
    VAR line AS String
    VAR inForm AS Bool
    VAR p AS Array OF String
    VAR k AS Integer
    VAR i AS Integer
    VAR kv AS String
    kType.Clear()
    kProps.Clear()
    FOR EACH line IN text.Replace(Chr(13), "").Split(EOL)
        IF line.StartsWith(MARKSTART) THEN
            inForm = TRUE
            CONTINUE
        END IF
        IF line.StartsWith(MARKEND) THEN
            inForm = FALSE
            CONTINUE
        END IF
        IF NOT inForm THEN
            code.Add(line)
        ELSEIF line.StartsWith("' FORM ") OR line.StartsWith("' CTRL ") THEN
            p = line.Substring(7, line.Length - 7).Split("|")
            kType.Add(p[0])
            kProps.Add("")
            i = kType.Count - 1
            FOR k = 1 TO p.Count - 1
                kv = p[k]
                IF kv.Contains("=") THEN SetP(i, kv.Substring(0, kv.IndexOf("=")), Dec(kv.Substring(kv.IndexOf("=") + 1, kv.Length - kv.IndexOf("=") - 1)))
            NEXT
        END IF
    NEXT
    ' a file with no form (not made here): an empty form to start one
    IF kType.Count = 0 OR kType[0] <> "Form" THEN
        kType.Insert(0, "Form")
        kProps.Insert(0, "")
    END IF
    editor.Text = Trimmed(code.Join(EOL)) + EOL
    projPath = src
    IF src = "" THEN
        projName = "PROJECT1.SPK"
    ELSE
        projName = src.Substring(LastIndex(src, "\") + 1, src.Length - LastIndex(src, "\") - 1)
    END IF
    saved = Assemble()
    undoModel.Clear()
    undoCode.Clear()
    redoModel.Clear()
    redoCode.Clear()
    lastCode = editor.Text
    sel = 0
    tool = ""
    toolbox.Selected = 0
    FillObjects()
    FillProps()
    UpdateTitle()
    Draw()
END SUB

FUNCTION LastIndex (s AS String, c AS String) AS Integer
    VAR k AS Integer
    FOR k = s.Length - 1 TO 0 STEP -1
        IF s.CharAt(k) = c THEN RETURN k
    NEXT
    RETURN -1
END FUNCTION

SUB LoadTemplate (file AS String)
    IF FS.Exists(TEMPLATES + "\" + file) THEN
        LoadText(FS.Read(TEMPLATES + "\" + file), "")
    ELSE
        LoadText("SUB Main ()" + EOL + "    InitForm()" + EOL + "    Form1.Show()" + EOL + "END SUB" + EOL, "")
    END IF
    editor.Text = editor.Text.Replace("PROJECT1.SPK", projName)
    saved = Assemble()
    lastCode = editor.Text
END SUB

SUB UpdateTitle ()
    win.Title = "Visual SPARK - " + projName
END SUB

FUNCTION Dirty () AS Bool
    VAR ok AS Bool
    IF layoutView THEN ok = ApplyLayout()
    RETURN Assemble() <> saved
END FUNCTION

FUNCTION MayDiscard () AS Bool
    VAR box AS GUI_MessageBox
    IF NOT Dirty() THEN RETURN TRUE
    box = GUI_MessageBox.New(win)
    box.Title = "Visual SPARK"
    box.Kind = "confirm"
    box.Buttons = "yesno"
    box.Text = projName + " has changes that aren't saved." + EOL + EOL + "Throw them away?"
    RETURN box.Show()
END FUNCTION

FUNCTION SaveTo (target AS String) AS Bool
    IF layoutView THEN
        IF NOT ApplyLayout() THEN RETURN FALSE
    END IF
    TRY
        FS.Write(target, Assemble())
    CATCH err
        Say("Couldn't save " + target + ":" + EOL + EOL + err, "error")
        RETURN FALSE
    END TRY
    RETURN TRUE
END FUNCTION

SUB SaveProject ()
    IF projPath = "" THEN
        SaveAs()
        RETURN
    END IF
    IF SaveTo(projPath) THEN
        saved = Assemble()
        win.Status = "Saved " + projPath
    END IF
END SUB

SUB SaveAs ()
    VAR fd AS GUI_FileDialog
    VAR p AS String
    fd = GUI_FileDialog.New(win)
    fd.Title = "Save Project As"
    fd.Filter = "*.SPK"
    fd.Path = "C:\MYFILES"
    fd.FileName = projName
    p = fd.ShowSave()
    IF p = "" THEN RETURN
    IF NOT p.Upper().EndsWith(".SPK") THEN p = p + ".SPK"
    projPath = p.Upper()
    projName = projPath.Substring(LastIndex(projPath, "\") + 1, projPath.Length - LastIndex(projPath, "\") - 1)
    UpdateTitle()
    SaveProject()
END SUB

SUB OpenProject ()
    VAR fd AS GUI_FileDialog
    VAR p AS String
    IF NOT MayDiscard() THEN RETURN
    fd = GUI_FileDialog.New(win)
    fd.Title = "Open Project"
    fd.Filter = "*.SPK"
    fd.Path = "C:\MYFILES"
    p = fd.ShowOpen()
    IF p = "" THEN RETURN
    IF NOT FS.Exists(p) THEN
        Say("There is no file called " + p + ".", "error")
        RETURN
    END IF
    LoadText(FS.Read(p), p.Upper())
    ShowForm()
    win.Status = "Opened " + p
END SUB

' ================================================================ File > New Project

SUB NewProject ()
    VAR line AS String
    VAR names AS Array OF String
    VAR b AS GUI_Button
    IF NOT MayDiscard() THEN RETURN
    tplFiles.Clear()
    tplNotes.Clear()
    FOR EACH line IN ReadOr(TEMPLATES + "\INDEX.TXT", "EMPTY.SPK|Empty form|A form with nothing on it yet.").Lines()
        IF line.Split("|").Count < 3 THEN CONTINUE
        tplFiles.Add(line.Split("|")[0])
        names.Add(line.Split("|")[1])
        tplNotes.Add(line.Split("|")[2])
    NEXT
    tplWin = GUI_Window.New("New Project", 320, 230)
    tplWin.Modal = TRUE
    tplWin.Icon = "spark"
    tplList = GUI_ListBox.New(tplWin)
    tplList.SetBounds(8, 8, 304, 130)
    tplList.Items = names
    tplList.Selected = 0
    tplList.onSelect = TplList_OnSelect
    tplList.onDblClick = Tpl_Ok
    tplAbout = GUI_Label.New(tplWin)
    tplAbout.SetBounds(8, 144, 304, 44)
    IF tplNotes.Count > 0 THEN tplAbout.Text = tplNotes[0]
    b = GUI_Button.New(tplWin)
    b.Text = "OK"
    b.Default = TRUE
    b.SetBounds(156, 196, 75, 24)
    b.onClick = Tpl_Ok
    b = GUI_Button.New(tplWin)
    b.Text = "Cancel"
    b.Cancel = TRUE
    b.SetBounds(237, 196, 75, 24)
    b.onClick = Tpl_Cancel
    tplWin.Center()
    tplWin.Show()
    tplList.Focus()
END SUB

FUNCTION ReadOr (p AS String, fallback AS String) AS String
    IF FS.Exists(p) THEN RETURN FS.Read(p)
    RETURN fallback
END FUNCTION

SUB TplList_OnSelect ()
    IF tplList.Selected >= 0 AND tplList.Selected < tplNotes.Count THEN tplAbout.Text = tplNotes[tplList.Selected]
END SUB

SUB Tpl_Ok ()
    VAR k AS Integer
    k = tplList.Selected
    IF k < 0 OR k >= tplFiles.Count THEN RETURN
    tplWin.Close()
    LoadTemplate(tplFiles[k])
    ShowForm()
    win.Status = "A new project, from " + tplFiles[k] + ". Run it with F5."
END SUB

SUB Tpl_Cancel ()
    tplWin.Close()
END SUB

' ================================================================ the designer

FUNCTION Snap (v AS Integer) AS Integer
    RETURN Int((v + GRID / 2) / GRID) * GRID
END FUNCTION

' Text cut to fit w pixels.
FUNCTION Fit (s AS String, w AS Integer) AS String
    VAR most AS Integer
    most = MATH.Max(0, Int(w / CHARW))
    IF s.Length > most THEN RETURN s.Substring(0, most)
    RETURN s
END FUNCTION

SUB Bevel (x AS Integer, y AS Integer, w AS Integer, h AS Integer, raised AS Bool)
    IF raised THEN
        design.SetColor(15)
    ELSE
        design.SetColor(8)
    END IF
    design.Line(x, y, x + w - 1, y)
    design.Line(x, y, x, y + h - 1)
    IF raised THEN
        design.SetColor(0)
    ELSE
        design.SetColor(15)
    END IF
    design.Line(x, y + h - 1, x + w - 1, y + h - 1)
    design.Line(x + w - 1, y, x + w - 1, y + h - 1)
END SUB

SUB Draw ()
    VAR w AS Integer
    VAR h AS Integer
    VAR x AS Integer
    VAR y AS Integer
    VAR i AS Integer
    VAR mh AS Integer
    ' (the layout view follows changes made in Properties, unless it's been edited)
    IF layoutView AND layoutEd.Text = layoutShown THEN
        layoutShown = LayoutText()
        layoutEd.Text = layoutShown
    END IF
    IF codeView OR layoutView THEN RETURN
    w = GetN(0, "Width")
    h = GetN(0, "Height")
    mh = MenuH()
    CY = 32 + mh
    design.Background = 8
    design.Clear()
    ' the window: frame, title bar, menu bar, client area with its grid
    design.SetColor(7)
    design.FillRect(FX, FY, w + 4, h + 24 + mh)
    Bevel(FX, FY, w + 4, h + 24 + mh, TRUE)
    design.SetColor(4)
    design.FillRect(FX + 2, FY + 2, w, 18)
    design.SetColor(15)
    design.Text(FX + 6, FY + 5, Fit(GetP(0, "Title"), w - 12))
    IF mh > 0 THEN
        design.SetColor(0)
        FOR i = 1 TO kType.Count - 1
            IF kType[i] = "MenuItem" AND GetN(i, "Level") = 0 AND BarX(i) + 8 < w THEN design.Text(CX + BarX(i), FY + 23, Fit(Plain(GetP(i, "Caption")), w - BarX(i)))
        NEXT
        design.SetColor(8)
        design.Line(FX + 2, CY - 2, FX + w + 1, CY - 2)
    END IF
    design.SetColor(8)
    FOR y = 0 TO h - 1 STEP 16
        FOR x = 0 TO w - 1 STEP 16
            design.Pixel(CX + x, CY + y)
        NEXT
    NEXT
    FOR i = 1 TO kType.Count - 1
        IF kType[i] <> "MenuItem" THEN DrawControl(i)
    NEXT
    ' the selection, and its handle
    design.SetColor(0)
    IF sel = 0 THEN
        design.FillRect(CX + w - 3, CY + h - 3, 6, 6)
    ELSEIF Movable(sel) THEN
        x = CX + GetN(sel, "X")
        y = CY + GetN(sel, "Y")
        design.SetColor(4)
        design.Rect(x - 2, y - 2, CtlW(sel) + 4, CtlH(sel) + 4)
        ' its anchors to the right and bottom edges, as lines to them
        design.SetColor(9)
        IF kType[sel] <> "Timer" AND GetP(sel, "Anchor").Contains("Right") THEN design.Line(x + CtlW(sel) + 3, y + Int(CtlH(sel) / 2), CX + w - 1, y + Int(CtlH(sel) / 2))
        IF kType[sel] <> "Timer" AND GetP(sel, "Anchor").Contains("Bottom") THEN design.Line(x + Int(CtlW(sel) / 2), y + CtlH(sel) + 3, x + Int(CtlW(sel) / 2), CY + h - 1)
        IF kType[sel] <> "Timer" THEN
            design.SetColor(0)
            design.FillRect(x + CtlW(sel) - 3, y + CtlH(sel) - 3, 6, 6)
        END IF
    END IF
    ' a control being drawn
    IF dragMode = "new" THEN
        design.SetColor(0)
        design.Rect(CX + rx, CY + ry, MATH.Max(1, rw), MATH.Max(1, rh))
    END IF
END SUB

FUNCTION Stars (n AS Integer) AS String
    VAR out AS String
    VAR k AS Integer
    FOR k = 1 TO n
        out = out + "*"
    NEXT
    RETURN out
END FUNCTION

FUNCTION CtlW (i AS Integer) AS Integer
    IF kType[i] = "Timer" THEN RETURN 24
    RETURN GetN(i, "Width")
END FUNCTION

FUNCTION CtlH (i AS Integer) AS Integer
    IF kType[i] = "Timer" THEN RETURN 24
    RETURN GetN(i, "Height")
END FUNCTION

SUB DrawControl (i AS Integer)
    VAR t AS String
    VAR x AS Integer
    VAR y AS Integer
    VAR w AS Integer
    VAR h AS Integer
    VAR s AS String
    VAR ink AS Integer
    VAR k AS Integer
    VAR item AS String
    t = kType[i]
    x = CX + GetN(i, "X")
    y = CY + GetN(i, "Y")
    w = CtlW(i)
    h = CtlH(i)
    s = GetP(i, "Text").Replace("&", "")
    ink = 0
    IF NOT GetB(i, "Enabled") THEN ink = 8
    SELECT CASE t
        CASE "Label"
            design.SetColor(ink)
            s = Fit(s, w)
            IF GetP(i, "Align") = "center" THEN
                design.Text(x + MATH.Max(0, Int((w - s.Length * CHARW) / 2)), y + 2, s)
            ELSEIF GetP(i, "Align") = "right" THEN
                design.Text(x + MATH.Max(0, w - s.Length * CHARW), y + 2, s)
            ELSE
                design.Text(x, y + 2, s)
            END IF
        CASE "Button"
            design.SetColor(7)
            design.FillRect(x, y, w, h)
            Bevel(x, y, w, h, TRUE)
            IF GetB(i, "Default") THEN
                design.SetColor(0)
                design.Rect(x - 1, y - 1, w + 2, h + 2)
            END IF
            s = Fit(s, w - 2)
            design.SetColor(ink)
            design.Text(x + MATH.Max(2, Int((w - s.Length * CHARW) / 2)), y + Int((h - 12) / 2), s)
        CASE "TextBox"
            design.SetColor(15)
            design.FillRect(x, y, w, h)
            Bevel(x, y, w, h, FALSE)
            IF GetB(i, "Password") THEN s = Stars(s.Length)
            design.SetColor(ink)
            design.Text(x + 4, y + Int((h - 12) / 2), Fit(s, w - 8))
        CASE "TextArea"
            design.SetColor(15)
            design.FillRect(x, y, w, h)
            Bevel(x, y, w, h, FALSE)
            design.SetColor(7)
            design.FillRect(x + w - 15, y + 1, 14, h - 2)
            design.SetColor(ink)
            design.Text(x + 4, y + 4, Fit(s, w - 22))
        CASE "CheckBox"
            design.SetColor(15)
            design.FillRect(x, y + Int((h - 13) / 2), 13, 13)
            Bevel(x, y + Int((h - 13) / 2), 13, 13, FALSE)
            IF GetB(i, "Checked") THEN
                design.SetColor(0)
                design.Line(x + 3, y + Int((h - 13) / 2) + 3, x + 9, y + Int((h - 13) / 2) + 9)
                design.Line(x + 9, y + Int((h - 13) / 2) + 3, x + 3, y + Int((h - 13) / 2) + 9)
            END IF
            design.SetColor(ink)
            design.Text(x + 18, y + Int((h - 12) / 2), Fit(s, w - 18))
        CASE "RadioButton"
            design.SetColor(15)
            design.FillCircle(x + 6, y + Int(h / 2), 6)
            design.SetColor(8)
            design.Circle(x + 6, y + Int(h / 2), 6)
            IF GetB(i, "Checked") THEN
                design.SetColor(0)
                design.FillCircle(x + 6, y + Int(h / 2), 2)
            END IF
            design.SetColor(ink)
            design.Text(x + 18, y + Int((h - 12) / 2), Fit(s, w - 18))
        CASE "ListBox"
            design.SetColor(15)
            design.FillRect(x, y, w, h)
            Bevel(x, y, w, h, FALSE)
            design.SetColor(ink)
            k = 0
            FOR EACH item IN GetP(i, "Items").Split(";")
                IF item.Trim() = "" OR 4 + k * 14 + 12 > h THEN CONTINUE
                design.Text(x + 4, y + 3 + k * 14, Fit(item.Trim(), w - 8))
                k = k + 1
            NEXT
        CASE "DropDown"
            design.SetColor(15)
            design.FillRect(x, y, w, h)
            Bevel(x, y, w, h, FALSE)
            design.SetColor(7)
            design.FillRect(x + w - 17, y + 2, 15, h - 4)
            Bevel(x + w - 17, y + 2, 15, h - 4, TRUE)
            design.SetColor(0)
            design.Line(x + w - 13, y + Int(h / 2) - 2, x + w - 6, y + Int(h / 2) - 2)
            design.Line(x + w - 12, y + Int(h / 2) - 1, x + w - 7, y + Int(h / 2) - 1)
            design.Line(x + w - 11, y + Int(h / 2), x + w - 8, y + Int(h / 2))
            k = GetN(i, "Selected")
            IF k >= 0 AND k < GetP(i, "Items").Split(";").Count THEN
                design.SetColor(ink)
                design.Text(x + 4, y + Int((h - 12) / 2), Fit(GetP(i, "Items").Split(";")[k].Trim(), w - 24))
            END IF
        CASE "ProgressBar"
            design.SetColor(7)
            design.FillRect(x, y, w, h)
            Bevel(x, y, w, h, FALSE)
            IF GetN(i, "Max") > 0 THEN
                design.SetColor(4)
                design.FillRect(x + 2, y + 2, Int((w - 4) * MATH.Min(GetN(i, "Value"), GetN(i, "Max")) / GetN(i, "Max")), h - 4)
            END IF
        CASE "Canvas"
            design.SetColor(MATH.Max(0, MATH.Min(15, GetN(i, "Background"))))
            design.FillRect(x, y, w, h)
            design.SetColor(8)
            design.Rect(x, y, w, h)
            design.Text(x + 4, y + 4, Fit(GetP(i, "Name"), w - 8))
        CASE "Timer"
            design.SetColor(7)
            design.FillRect(x, y, 24, 24)
            Bevel(x, y, 24, 24, TRUE)
            design.SetColor(15)
            design.FillCircle(x + 12, y + 12, 8)
            design.SetColor(0)
            design.Circle(x + 12, y + 12, 8)
            design.Line(x + 12, y + 12, x + 12, y + 6)
            design.Line(x + 12, y + 12, x + 16, y + 12)
    END SELECT
END SUB

' Which object is at x, y on the designer: a control (the one on top), the
' form, or -1.
FUNCTION HitAt (x AS Integer, y AS Integer) AS Integer
    VAR i AS Integer
    VAR px AS Integer
    VAR py AS Integer
    px = x - CX
    py = y - CY
    FOR i = kType.Count - 1 TO 1 STEP -1
        IF kType[i] = "MenuItem" THEN CONTINUE
        IF px >= GetN(i, "X") AND py >= GetN(i, "Y") AND px < GetN(i, "X") + CtlW(i) AND py < GetN(i, "Y") + CtlH(i) THEN RETURN i
    NEXT
    IF x >= FX AND y >= FY AND x < CX + GetN(0, "Width") + 2 AND y < CY + GetN(0, "Height") + 2 THEN RETURN 0
    RETURN -1
END FUNCTION

FUNCTION Near (x AS Integer, y AS Integer, hx AS Integer, hy AS Integer) AS Bool
    RETURN Abs(x - hx) <= 4 AND Abs(y - hy) <= 4
END FUNCTION

SUB Design_OnDraw (canvas AS GUI_Canvas)
    Draw()
END SUB

SUB Design_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)
    VAR i AS Integer
    keys.Focus()
    ' the form's menu bar: a menu's items, to write their code
    IF tool = "" AND MenuH() > 0 AND y >= FY + 20 AND y < CY - 1 AND x >= CX AND x < CX + GetN(0, "Width") THEN
        i = TopAt(x - CX)
        IF i < 0 THEN
            MenuEditor()
        ELSE
            ShowMenuPop(i, x, y)
        END IF
        RETURN
    END IF
    ' the right button: select what's there, and offer its menu
    IF button = 2 THEN
        tool = ""
        toolbox.Selected = 0
        i = HitAt(x, y)
        IF i < 0 THEN RETURN
        SelectObj(i)
        IF i > 0 THEN
            ctx.Popup(design.X + x, design.Y + y)
        ELSE
            ctxForm.Popup(design.X + x, design.Y + y)
        END IF
        RETURN
    END IF
    ' (what the form was, in case a drag changes it)
    dragSnap = Snapshot()
    dragCode = editor.Text
    ' drawing a new control
    IF tool <> "" THEN
        dragMode = "new"
        dragX0 = MATH.Max(0, Snap(x - CX))
        dragY0 = MATH.Max(0, Snap(y - CY))
        rx = dragX0
        ry = dragY0
        rw = 0
        rh = 0
        RETURN
    END IF
    ' the selected control's handle: sizing it
    IF sel > 0 AND sel < kType.Count THEN
        IF kType[sel] <> "Timer" AND Near(x, y, CX + GetN(sel, "X") + CtlW(sel), CY + GetN(sel, "Y") + CtlH(sel)) THEN
            dragMode = "size"
            RETURN
        END IF
    END IF
    ' the form's handle: sizing the form
    IF Near(x, y, CX + GetN(0, "Width"), CY + GetN(0, "Height")) THEN
        SelectObj(0)
        dragMode = "form"
        RETURN
    END IF
    i = HitAt(x, y)
    IF i < 0 THEN RETURN
    ' a second click on the same thing, quickly: its code
    IF i = lastDownIdx AND lastDown <> 0 AND SYS.Ticks - lastDown < 450 THEN
        lastDown = 0
        OpenHandler(i, Events(kType[i])[0])
        RETURN
    END IF
    lastDown = SYS.Ticks
    lastDownIdx = i
    SelectObj(i)
    IF i > 0 THEN
        dragMode = "move"
        dragOX = x - CX - GetN(i, "X")
        dragOY = y - CY - GetN(i, "Y")
    END IF
END SUB

SUB Design_OnMouseMove (x AS Integer, y AS Integer)
    VAR nx AS Integer
    VAR ny AS Integer
    SELECT CASE dragMode
        CASE "new"
            nx = MATH.Max(0, Snap(x - CX))
            ny = MATH.Max(0, Snap(y - CY))
            rx = MATH.Min(dragX0, nx)
            ry = MATH.Min(dragY0, ny)
            rw = Int(Abs(nx - dragX0))
            rh = Int(Abs(ny - dragY0))
            Draw()
        CASE "move"
            nx = MATH.Max(0, Snap(x - CX - dragOX))
            ny = MATH.Max(0, Snap(y - CY - dragOY))
            IF nx <> GetN(sel, "X") OR ny <> GetN(sel, "Y") THEN
                SetP(sel, "X", Str(nx))
                SetP(sel, "Y", Str(ny))
                Draw()
            END IF
        CASE "size"
            nx = MATH.Max(GRID, Snap(x - CX - GetN(sel, "X")))
            ny = MATH.Max(GRID, Snap(y - CY - GetN(sel, "Y")))
            IF nx <> GetN(sel, "Width") OR ny <> GetN(sel, "Height") THEN
                SetP(sel, "Width", Str(nx))
                SetP(sel, "Height", Str(ny))
                Draw()
            END IF
        CASE "form"
            nx = MATH.Max(64, Snap(x - CX))
            ny = MATH.Max(32, Snap(y - CY))
            IF nx <> GetN(0, "Width") OR ny <> GetN(0, "Height") THEN
                FollowForm(nx - GetN(0, "Width"), ny - GetN(0, "Height"))
                SetP(0, "Width", Str(nx))
                SetP(0, "Height", Str(ny))
                Draw()
            END IF
    END SELECT
END SUB

SUB Design_OnMouseUp (x AS Integer, y AS Integer, button AS Integer)
    VAR i AS Integer
    VAR mode AS String
    mode = dragMode
    dragMode = ""
    IF mode <> "" AND dragSnap <> "" AND Snapshot() <> dragSnap THEN
        PushUndo(dragSnap, dragCode)
        dragSnap = ""
    END IF
    IF mode = "new" THEN
        ' a click, not a drag: the control's usual size
        IF rw < GRID OR rh < GRID THEN
            rw = DefaultW(tool)
            rh = DefaultH(tool)
        END IF
        PushUndo(dragSnap, dragCode)
        dragSnap = ""
        i = AddControl(tool, rx, ry, rw, rh)
        Did()
        tool = ""
        toolbox.Selected = 0
        FillObjects()
        SelectObj(i)
        win.Status = GetP(i, "Name") + " is on the form. Double-click it to write its code."
    ELSEIF mode <> "" THEN
        FillProps()
        Draw()
    END IF
END SUB

SUB Design_OnKey (key AS String)
    VAR dx AS Integer
    VAR dy AS Integer
    VAR dw AS Integer
    VAR dh AS Integer
    IF NOT Movable(sel) THEN RETURN
    SELECT CASE key
        CASE "Delete"
            DeleteSelected()
            RETURN
        CASE "ArrowLeft"
            dx = -GRID
        CASE "ArrowRight"
            dx = GRID
        CASE "ArrowUp"
            dy = -GRID
        CASE "ArrowDown"
            dy = GRID
        CASE "Shift+ArrowLeft"
            dw = -GRID
        CASE "Shift+ArrowRight"
            dw = GRID
        CASE "Shift+ArrowUp"
            dh = -GRID
        CASE "Shift+ArrowDown"
            dh = GRID
        CASE ELSE
            RETURN
    END SELECT
    IF (dw <> 0 OR dh <> 0) AND kType[sel] = "Timer" THEN RETURN
    Remember()
    IF dx <> 0 OR dy <> 0 THEN
        SetP(sel, "X", Str(MATH.Max(0, GetN(sel, "X") + dx)))
        SetP(sel, "Y", Str(MATH.Max(0, GetN(sel, "Y") + dy)))
    ELSE
        SetP(sel, "Width", Str(MATH.Max(GRID, GetN(sel, "Width") + dw)))
        SetP(sel, "Height", Str(MATH.Max(GRID, GetN(sel, "Height") + dh)))
    END IF
    Did()
    FillProps()
    Draw()
END SUB

SUB DeleteSelected ()
    VAR name AS String
    IF sel <= 0 OR sel >= kType.Count THEN RETURN
    Remember()
    name = GetP(sel, "Name")
    kType.RemoveAt(sel)
    kProps.RemoveAt(sel)
    Did()
    FillObjects()
    SelectObj(0)
    win.Status = name + " is gone from the form. (Its code is still there: delete that too, or it won't run.)"
END SUB

SUB SelectObj (i AS Integer)
    IF i < 0 OR i >= kType.Count THEN RETURN
    sel = i
    propDel.Enabled = i > 0
    IF propObj.Selected <> i THEN propObj.Selected = i
    FillProps()
    Draw()
END SUB

SUB PropDel_OnClick ()
    DeleteSelected()
END SUB

SUB Ctx_OnSelect (item AS String)
    ' (a popup menu leaves the keyboard nowhere: back to the designer)
    keys.Focus()
    IF sel <= 0 OR sel >= kType.Count THEN RETURN
    IF item = "View Code" THEN
        OpenHandler(sel, Events(kType[sel])[0])
    ELSE
        EditCmd(item)
    END IF
END SUB

SUB CtxForm_OnSelect (item AS String)
    keys.Focus()
    SELECT CASE item
        CASE "View Code"
            OpenHandler(0, "Load")
        CASE "Paste"
            EditCmd("Paste")
        CASE "Menu Editor..."
            MenuEditor()
    END SELECT
END SUB

SUB Toolbox_OnSelect ()
    IF toolbox.Selected <= 0 THEN
        tool = ""
    ELSE
        tool = toolbox.Get(toolbox.Selected)
        win.Status = "Drag on the form where the " + tool + " goes."
        IF codeView OR layoutView THEN ShowForm()
    END IF
END SUB

' Double-click: one dropped on the form, a little below the last.
SUB Toolbox_OnDblClick ()
    VAR t AS String
    VAR i AS Integer
    VAR at AS Integer
    IF toolbox.Selected <= 0 THEN RETURN
    t = toolbox.Get(toolbox.Selected)
    at = 8 + ((kType.Count - 1) MOD 8) * 16
    Remember()
    i = AddControl(t, at, at, DefaultW(t), DefaultH(t))
    Did()
    tool = ""
    toolbox.Selected = 0
    FillObjects()
    IF codeView OR layoutView THEN ShowForm()
    SelectObj(i)
END SUB

' ================================================================ properties

FUNCTION ObjLabel (i AS Integer) AS String
    IF kType[i] = "MenuItem" THEN RETURN GetP(i, "Name") + "  (Menu: " + Plain(GetP(i, "Caption")) + ")"
    RETURN GetP(i, "Name") + "  (" + kType[i] + ")"
END FUNCTION

SUB FillObjects ()
    VAR names AS Array OF String
    VAR i AS Integer
    FOR i = 0 TO kType.Count - 1
        names.Add(ObjLabel(i))
    NEXT
    propObj.Items = names
    propObj.Selected = sel
    objList.Items = names
END SUB

SUB FillProps ()
    VAR lines AS Array OF String
    VAR e AS String
    VAR key AS String
    VAR keep AS Integer
    IF sel < 0 OR sel >= kType.Count THEN RETURN
    keep = propList.Selected
    propKeys.Clear()
    FOR EACH e IN Props(kType[sel])
        key = e.Split("|")[0]
        propKeys.Add(key)
        lines.Add(key.PadRight(11) + GetP(sel, key))
    NEXT
    propList.Items = lines
    IF keep >= 0 AND keep < lines.Count THEN propList.Selected = keep
    IF propObj.Selected <> sel THEN propObj.Selected = sel
END SUB

SUB PropObj_OnSelect ()
    IF propObj.Selected >= 0 AND propObj.Selected <> sel THEN SelectObj(propObj.Selected)
END SUB

SUB PropList_OnSelect ()
    VAR key AS String
    VAR kind AS String
    IF propList.Selected < 0 OR propList.Selected >= propKeys.Count THEN RETURN
    key = propKeys[propList.Selected]
    kind = PropKind(kType[sel], key)
    propEdit.Text = GetP(sel, key)
    IF kind = "bool" THEN
        propHelp.Text = key + ": TRUE or FALSE. Double-click it to switch."
    ELSEIF kind.StartsWith("choice:") THEN
        propHelp.Text = key + ": one of " + kind.Substring(7, kind.Length - 7).Replace(",", ", ") + ". Double-click it for the next."
    ELSEIF kind = "items" THEN
        propHelp.Text = key + ": the items, with ; between them. Type them and press Enter."
    ELSEIF kind = "color" THEN
        propHelp.Text = key + ": a colour, 0-15: 0 black, 4 navy, 7 silver, 9 red, 10 lime, 11 yellow, 12 blue, 15 white."
    ELSEIF kind = "name" THEN
        propHelp.Text = "Name: what the code calls it. Letters, digits and _, starting with a letter."
    ELSEIF kind = "anchor" THEN
        propHelp.Text = "Anchor: the window edges it keeps its distance to when the window is resized: Top, Bottom, Left, Right. Left,Right stretches it across. Double-click for the usual ones."
    ELSEIF kind = "shortcut" THEN
        propHelp.Text = "Shortcut: keys that choose this item, like Ctrl+O or F3. Empty for none."
    ELSEIF key = "Level" THEN
        propHelp.Text = "Level: 0 for a menu on the bar, 1 for an item in the menu above it."
    ELSEIF key = "Caption" THEN
        propHelp.Text = "Caption: what the menu shows. & before a letter underlines it; - alone is a line between items."
    ELSE
        propHelp.Text = key + ": type it and press Enter."
    END IF
END SUB

SUB PropList_OnDblClick ()
    VAR key AS String
    VAR kind AS String
    VAR opts AS Array OF String
    VAR k AS Integer
    IF propList.Selected < 0 OR propList.Selected >= propKeys.Count THEN RETURN
    key = propKeys[propList.Selected]
    kind = PropKind(kType[sel], key)
    IF kind = "bool" THEN
        IF GetB(sel, key) THEN
            Apply(key, "FALSE")
        ELSE
            Apply(key, "TRUE")
        END IF
    ELSEIF kind.StartsWith("choice:") THEN
        opts = kind.Substring(7, kind.Length - 7).Split(",")
        k = opts.IndexOf(GetP(sel, key))
        Apply(key, opts[(k + 1) MOD opts.Count])
    ELSEIF kind = "anchor" THEN
        opts = ["Top,Left", "Top,Right", "Bottom,Left", "Bottom,Right", "Top,Left,Right", "Bottom,Left,Right", "Top,Bottom,Left", "Top,Bottom,Right", "Top,Bottom,Left,Right"]
        k = opts.IndexOf(GetP(sel, key))
        Apply(key, opts[(k + 1) MOD opts.Count])
    ELSE
        propEdit.Focus()
        propEdit.SelectAll()
    END IF
END SUB

SUB PropEdit_OnEnter ()
    IF propList.Selected < 0 OR propList.Selected >= propKeys.Count THEN RETURN
    Apply(propKeys[propList.Selected], propEdit.Text)
END SUB

' A property set by hand, checked first.
SUB Apply (key AS String, value AS String)
    VAR kind AS String
    VAR old AS String
    VAR opts AS Array OF String
    VAR noted AS Bool
    kind = PropKind(kType[sel], key)
    value = value.Replace(Chr(13), "").Replace(Chr(10), " ")
    IF kind = "name" THEN
        value = value.Trim()
        IF NOT IsIdent(value) THEN
            Say(Q + value + Q + " can't be a name: use letters, digits and _, starting with a letter.", "warn")
            RETURN
        END IF
        IF NameTaken(value, sel) THEN
            Say("Something else is already called " + value + ".", "warn")
            RETURN
        END IF
        old = GetP(sel, "Name")
        Remember()
        noted = TRUE
        IF old <> value THEN editor.Text = Renamed(editor.Text, old, value)
    ELSEIF kind = "anchor" THEN
        value = Anchors(value)
    ELSEIF kind = "shortcut" THEN
        value = value.Trim()
        IF NOT ShortcutOk(value) THEN
            Say(Q + value + Q + " isn't a shortcut SIM95 knows. Use Ctrl+ a letter or digit (Ctrl+Shift+ too), or F1 to F12.", "warn")
            RETURN
        END IF
    ELSEIF kind = "int" THEN
        value = Str(Int(Val(value)))
        IF key = "Level" THEN value = Str(MATH.Max(0, MATH.Min(1, Val(value))))
        IF (key = "X" OR key = "Y") AND Val(value) < 0 THEN value = "0"
        IF (key = "Width" OR key = "Height") AND Val(value) < GRID THEN value = Str(GRID)
    ELSEIF kind = "bool" THEN
        IF value.Trim().Upper().StartsWith("T") OR value.Trim().Upper().StartsWith("Y") OR value.Trim() = "1" THEN
            value = "TRUE"
        ELSE
            value = "FALSE"
        END IF
    ELSEIF kind = "color" THEN
        value = Str(MATH.Max(0, MATH.Min(15, Int(Val(value)))))
    ELSEIF kind.StartsWith("choice:") THEN
        opts = kind.Substring(7, kind.Length - 7).Split(",")
        IF NOT opts.Contains(value.Trim().Lower()) THEN
            Say(key + " is one of: " + opts.Join(", ") + ".", "warn")
            RETURN
        END IF
        value = value.Trim().Lower()
    END IF
    IF NOT noted THEN Remember()
    IF sel = 0 AND key = "Width" THEN FollowForm(Int(Val(value)) - GetN(0, "Width"), 0)
    IF sel = 0 AND key = "Height" THEN FollowForm(0, Int(Val(value)) - GetN(0, "Height"))
    SetP(sel, key, value)
    Did()
    IF kind = "name" OR key = "Caption" THEN FillObjects()
    FillProps()
    PropList_OnSelect()
    Draw()
END SUB

FUNCTION IsIdent (s AS String) AS Bool
    VAR k AS Integer
    VAR c AS Integer
    IF s = "" OR s.Length > 30 THEN RETURN FALSE
    FOR k = 0 TO s.Length - 1
        c = Asc(s.CharAt(k).Upper())
        IF c >= 65 AND c <= 90 THEN CONTINUE
        IF k > 0 AND ((c >= 48 AND c <= 57) OR c = 95) THEN CONTINUE
        RETURN FALSE
    NEXT
    RETURN TRUE
END FUNCTION

FUNCTION IsIdentChar (ch AS String) AS Bool
    VAR c AS Integer
    c = Asc(ch.Upper())
    RETURN (c >= 65 AND c <= 90) OR (c >= 48 AND c <= 57) OR c = 95
END FUNCTION

' The code with a control's old name changed to its new one wherever it is
' the control: Old.Text, and its SUBs, Old_OnClick (not inside other words).
FUNCTION Renamed (code AS String, old AS String, name AS String) AS String
    VAR out AS String
    VAR rest AS String
    VAR k AS Integer
    VAR after AS String
    VAR before AS String
    rest = code
    WHILE rest <> ""
        k = rest.IndexOf(old)
        IF k < 0 THEN
            out = out + rest
            rest = ""
        ELSE
            before = ""
            IF k > 0 THEN before = rest.CharAt(k - 1)
            IF k = 0 AND out <> "" THEN before = out.CharAt(out.Length - 1)
            after = ""
            IF k + old.Length < rest.Length THEN after = rest.CharAt(k + old.Length)
            IF (before = "" OR NOT IsIdentChar(before)) AND (after = "." OR (after = "_" AND rest.Substring(k + old.Length, MATH.Min(3, rest.Length - k - old.Length)) = "_On")) THEN
                out = out + rest.Substring(0, k) + name
            ELSE
                out = out + rest.Substring(0, k + old.Length)
            END IF
            rest = rest.Substring(k + old.Length, rest.Length - k - old.Length)
        END IF
    END WHILE
    RETURN out
END FUNCTION

' ================================================================ the code window

SUB ShowForm ()
    IF NOT LeaveLayout() THEN RETURN
    codeView = FALSE
    editor.Visible = FALSE
    objList.Visible = FALSE
    evtList.Visible = FALSE
    design.Visible = TRUE
    keys.Visible = TRUE
    formBtn.Enabled = FALSE
    codeBtn.Enabled = TRUE
    layBtn.Enabled = TRUE
    Draw()
END SUB

SUB ShowCode ()
    IF NOT LeaveLayout() THEN RETURN
    codeView = TRUE
    design.Visible = FALSE
    keys.Visible = FALSE
    editor.Visible = TRUE
    objList.Visible = TRUE
    evtList.Visible = TRUE
    formBtn.Enabled = TRUE
    codeBtn.Enabled = FALSE
    layBtn.Enabled = TRUE
    tool = ""
    toolbox.Selected = 0
    FillObjects()
    IF objList.Selected <> sel THEN objList.Selected = sel
    FillEvents(sel)
END SUB

' The events of object i, with "(code)" after those that have a SUB.
SUB FillEvents (i AS Integer)
    VAR names AS Array OF String
    VAR evt AS String
    VAR subs AS String
    IF i < 0 OR i >= kType.Count THEN RETURN
    subs = SubNames()
    evtNames.Clear()
    FOR EACH evt IN Events(kType[i])
        evtNames.Add(evt)
        IF subs.Contains("," + HandlerOf(i, evt).Upper() + ",") THEN
            names.Add(evt + "  (code)")
        ELSE
            names.Add(evt)
        END IF
    NEXT
    evtList.Items = names
END SUB

SUB ObjList_OnSelect ()
    IF objList.Selected < 0 THEN RETURN
    FillEvents(objList.Selected)
END SUB

SUB EvtList_OnSelect ()
    VAR i AS Integer
    i = objList.Selected
    IF i < 0 OR i >= kType.Count OR evtList.Selected < 0 OR evtList.Selected >= evtNames.Count THEN RETURN
    OpenHandler(i, evtNames[evtList.Selected])
END SUB

' The SUB for object i's event: there already, or written from its template.
SUB OpenHandler (i AS Integer, evt AS String)
    VAR name AS String
    VAR line AS Integer
    name = HandlerOf(i, evt)
    line = FindSub(name)
    IF line = 0 THEN
        editor.Text = Trimmed(editor.Text) + EOL + EOL + "SUB " + name + " (" + Params(evt) + ")" + EOL + Body(i, evt) + EOL + "END SUB" + EOL
        line = FindSub(name)
        win.Status = name + " is new: write what happens there."
    END IF
    sel = i
    IF NOT codeView THEN ShowCode()
    IF objList.Selected <> i THEN objList.Selected = i
    FillEvents(i)
    editor.GotoLine(line + 1)
    editor.Focus()
END SUB

' Insert menu: a piece of code at the cursor.
SUB Snippet (which AS String)
    VAR form AS String
    VAR s AS String
    VAR I4 AS String
    form = GetP(0, "Name")
    I4 = EOL + "    "
    SELECT CASE which
        CASE "Message Box"
            s = "VAR box AS GUI_MessageBox" + I4 + "box = GUI_MessageBox.New(" + form + ")" + I4 + "box.Title = " + Lit("Hello") + I4 + "box.Text = " + Lit("Hello from Visual SPARK!") + I4 + "box.Show()"
        CASE "Yes or No Question"
            s = "VAR ask AS GUI_MessageBox" + I4 + "ask = GUI_MessageBox.New(" + form + ")" + I4 + "ask.Kind = " + Lit("confirm") + I4 + "ask.Buttons = " + Lit("yesno") + I4 + "ask.Text = " + Lit("Are you sure?") + I4 + "IF ask.Show() THEN" + I4 + "    ' they said yes" + I4 + "END IF"
        CASE "Open a File"
            s = "VAR openDlg AS GUI_FileDialog" + I4 + "VAR chosen AS String" + I4 + "openDlg = GUI_FileDialog.New(" + form + ")" + I4 + "openDlg.Path = " + Lit("C:\MYFILES") + I4 + "chosen = openDlg.ShowOpen()" + I4 + "IF chosen <> " + Q + Q + " THEN" + I4 + "    ' the file's text: FS.Read(chosen)" + I4 + "END IF"
        CASE "Save a File"
            s = "VAR saveDlg AS GUI_FileDialog" + I4 + "VAR target AS String" + I4 + "saveDlg = GUI_FileDialog.New(" + form + ")" + I4 + "saveDlg.Path = " + Lit("C:\MYFILES") + I4 + "target = saveDlg.ShowSave()" + I4 + "IF target <> " + Q + Q + " THEN FS.Write(target, " + Lit("what to save") + ")"
        CASE "Random Number"
            s = "' a whole number from 1 to 6, like a die" + I4 + "VAR roll AS Integer" + I4 + "roll = 1 + Rnd(6)"
        CASE "Run a Program"
            s = "SYS.Run(" + Lit("C:\PROGRAMS\NOTES.SPK") + ")"
    END SELECT
    IF s = "" THEN RETURN
    IF NOT codeView THEN ShowCode()
    IF NOT codeView THEN RETURN
    ' (whole lines, at the start of the cursor's line, inside a SUB)
    editor.Insert("    " + s + EOL)
    editor.Focus()
END SUB

' ================================================================ undo, the clipboard, order

' A control on the form (not the form itself, nor a menu item).
FUNCTION Movable (i AS Integer) AS Bool
    IF i <= 0 OR i >= kType.Count THEN RETURN FALSE
    RETURN kType[i] <> "MenuItem"
END FUNCTION

' The whole form, as one string, and back.
FUNCTION Snapshot () AS String
    RETURN kType.Join(Chr(1)) + Chr(2) + kProps.Join(Chr(1))
END FUNCTION

SUB LoadSnap (snap AS String)
    VAR parts AS Array OF String
    parts = snap.Split(Chr(2))
    kType = parts[0].Split(Chr(1))
    kProps = parts[1].Split(Chr(1))
END SUB

SUB PushUndo (snap AS String, code AS String)
    IF snap = "" THEN RETURN
    undoModel.Add(snap)
    undoCode.Add(code)
    IF undoModel.Count > 100 THEN
        undoModel.RemoveAt(0)
        undoCode.RemoveAt(0)
    END IF
    redoModel.Clear()
    redoCode.Clear()
END SUB

' Before a change on the form: how to get back.
SUB Remember ()
    PushUndo(Snapshot(), editor.Text)
END SUB

' After a change on the form: the code as it left it. (Undo puts the code
' back too, as a rename changed it, but not once it has been edited since:
' the code has its own undo.)
SUB Did ()
    lastCode = editor.Text
END SUB

SUB Revert (snap AS String, code AS String)
    IF editor.Text = lastCode THEN editor.Text = code
    LoadSnap(snap)
    lastCode = editor.Text
    IF sel >= kType.Count THEN sel = 0
    FillObjects()
    SelectObj(sel)
END SUB

SUB DoUndo ()
    VAR k AS Integer
    k = undoModel.Count - 1
    IF k < 0 THEN
        win.Status = "Nothing to undo."
        RETURN
    END IF
    redoModel.Add(Snapshot())
    redoCode.Add(editor.Text)
    Revert(undoModel[k], undoCode[k])
    undoModel.RemoveAt(k)
    undoCode.RemoveAt(k)
    win.Status = "Undone. (Ctrl+Y does it again.)"
END SUB

SUB DoRedo ()
    VAR k AS Integer
    k = redoModel.Count - 1
    IF k < 0 THEN
        win.Status = "Nothing to redo."
        RETURN
    END IF
    undoModel.Add(Snapshot())
    undoCode.Add(editor.Text)
    Revert(redoModel[k], redoCode[k])
    redoModel.RemoveAt(k)
    redoCode.RemoveAt(k)
    win.Status = "Done again."
END SUB

' The Edit menu, on the form. (In the code, the editor has its own.)
SUB EditCmd (item AS String)
    VAR keepType AS String
    VAR keepProps AS String
    IF codeView OR layoutView THEN
        win.Status = "In the code, use Ctrl+Z, Ctrl+Y, Ctrl+X, Ctrl+C and Ctrl+V. (The Edit menu works on the form.)"
        RETURN
    END IF
    SELECT CASE item
        CASE "Undo"
            DoUndo()
        CASE "Redo"
            DoRedo()
        CASE "Paste"
            PasteCtl()
        CASE ELSE
            IF NOT Movable(sel) THEN
                win.Status = "Select a control on the form first."
                RETURN
            END IF
            SELECT CASE item
                CASE "Copy"
                    CopyCtl()
                CASE "Cut"
                    CopyCtl()
                    DeleteSelected()
                    win.Status = "Cut. Ctrl+V pastes it."
                CASE "Duplicate"
                    keepType = clipType
                    keepProps = clipProps
                    CopyCtl()
                    PasteCtl()
                    clipType = keepType
                    clipProps = keepProps
                CASE "Delete"
                    DeleteSelected()
                CASE "Bring to Front"
                    Restack(TRUE)
                CASE "Send to Back"
                    Restack(FALSE)
            END SELECT
    END SELECT
END SUB

SUB CopyCtl ()
    clipType = kType[sel]
    clipProps = kProps[sel]
    win.Status = GetP(sel, "Name") + " is copied. Ctrl+V pastes it."
END SUB

' The copied control, a little down and to the right, with a name of its own.
SUB PasteCtl ()
    VAR i AS Integer
    IF clipType = "" THEN
        win.Status = "Nothing to paste: copy a control first."
        RETURN
    END IF
    Remember()
    kType.Add(clipType)
    kProps.Add(clipProps)
    i = kType.Count - 1
    IF NameTaken(GetP(i, "Name"), i) THEN SetP(i, "Name", NextName(clipType))
    SetP(i, "X", Str(GetN(i, "X") + GRID * 2))
    SetP(i, "Y", Str(GetN(i, "Y") + GRID * 2))
    ' (so pasting again goes further on)
    clipProps = kProps[i]
    Did()
    FillObjects()
    SelectObj(i)
    win.Status = GetP(i, "Name") + " is pasted. (Its code isn't: copy that in the code.)"
END SUB

' To the front (made last, so drawn over the others) or the back.
SUB Restack (front AS Bool)
    VAR t AS String
    VAR p AS String
    Remember()
    t = kType[sel]
    p = kProps[sel]
    kType.RemoveAt(sel)
    kProps.RemoveAt(sel)
    IF front THEN
        kType.Add(t)
        kProps.Add(p)
        sel = kType.Count - 1
    ELSE
        kType.Insert(1, t)
        kProps.Insert(1, p)
        sel = 1
    END IF
    Did()
    FillObjects()
    SelectObj(sel)
END SUB

' ================================================================ menus on the form

' A caption as the menu reports it: without & (or a shortcut).
FUNCTION Plain (cap AS String) AS String
    RETURN cap.Replace("&", "")
END FUNCTION

FUNCTION HasMenu () AS Bool
    VAR i AS Integer
    FOR i = 1 TO kType.Count - 1
        IF kType[i] = "MenuItem" THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

FUNCTION MenuH () AS Integer
    IF HasMenu() THEN RETURN MENUBAR
    RETURN 0
END FUNCTION

' Where a menu's name starts on the bar, from the form's left edge.
FUNCTION BarX (top AS Integer) AS Integer
    VAR i AS Integer
    VAR x AS Integer
    x = 6
    FOR i = 1 TO top - 1
        IF kType[i] = "MenuItem" AND GetN(i, "Level") = 0 THEN x = x + Plain(GetP(i, "Caption")).Length * CHARW + 14
    NEXT
    RETURN x
END FUNCTION

' The menu on the bar at x (from the form's left edge), or -1.
FUNCTION TopAt (x AS Integer) AS Integer
    VAR i AS Integer
    VAR bx AS Integer
    FOR i = 1 TO kType.Count - 1
        IF kType[i] <> "MenuItem" OR GetN(i, "Level") <> 0 THEN CONTINUE
        bx = BarX(i)
        IF x >= bx - 6 AND x < bx + Plain(GetP(i, "Caption")).Length * CHARW + 8 THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

' A menu of the form, opened on the designer: choosing an item goes to its code.
SUB ShowMenuPop (top AS Integer, x AS Integer, y AS Integer)
    VAR i AS Integer
    menuPop.Clear()
    menuPop.AddMenu("Menu")
    FOR i = top + 1 TO kType.Count - 1
        IF kType[i] <> "MenuItem" THEN CONTINUE
        IF GetN(i, "Level") = 0 THEN BREAK
        IF GetP(i, "Caption") = "-" THEN
            menuPop.AddSeparator("Menu")
        ELSE
            menuPop.AddItem("Menu", GetP(i, "Caption"))
        END IF
    NEXT
    menuPop.AddSeparator("Menu")
    menuPop.AddItem("Menu", "Menu Editor...")
    menuPopTop = top
    menuPop.Popup(design.X + x, design.Y + y)
END SUB

SUB MenuPop_OnSelect (item AS String)
    VAR i AS Integer
    keys.Focus()
    IF item = "Menu Editor..." THEN
        MenuEditor()
        RETURN
    END IF
    FOR i = menuPopTop + 1 TO kType.Count - 1
        IF kType[i] <> "MenuItem" THEN CONTINUE
        IF GetN(i, "Level") = 0 THEN BREAK
        IF Plain(GetP(i, "Caption")) = item THEN
            OpenHandler(i, "onClick")
            RETURN
        END IF
    NEXT
END SUB

' Ctrl+O, Ctrl+Shift+S, Alt+X, F3, Delete: keys a menu can answer to.
FUNCTION ShortcutOk (k AS String) AS Bool
    VAR rest AS String
    VAR c AS Integer
    IF k = "" OR k = "Delete" OR k = "Insert" THEN RETURN TRUE
    IF k.StartsWith("F") AND k.Length <= 3 THEN RETURN Val(k.Substring(1, k.Length - 1)) >= 1 AND Val(k.Substring(1, k.Length - 1)) <= 12
    rest = k
    IF rest.StartsWith("Ctrl+") THEN
        rest = rest.Substring(5, rest.Length - 5)
        IF rest.StartsWith("Shift+") THEN rest = rest.Substring(6, rest.Length - 6)
    ELSEIF rest.StartsWith("Alt+") THEN
        rest = rest.Substring(4, rest.Length - 4)
    ELSE
        RETURN FALSE
    END IF
    IF rest.Length <> 1 THEN RETURN FALSE
    c = Asc(rest)
    RETURN (c >= 65 AND c <= 90) OR (c >= 48 AND c <= 57)
END FUNCTION

' A property left out of an object's lines altogether.
SUB DropP (i AS Integer, key AS String)
    VAR out AS Array OF String
    VAR line AS String
    FOR EACH line IN kProps[i].Split(EOL)
        IF NOT line.StartsWith(key + "=") THEN out.Add(line)
    NEXT
    kProps[i] = out.Join(EOL)
END SUB

' ================================================================ the Menu Editor

' As in Visual BASIC: the form's menus in a list, menus on the bar at the
' left, their items indented under them.
SUB MenuEditor ()
    VAR l AS GUI_Label
    VAR b AS GUI_Button
    VAR i AS Integer
    VAR keys AS Array OF String
    VAR c AS Integer
    IF codeView OR layoutView THEN ShowForm()
    IF layoutView THEN RETURN
    Remember()
    Did()
    FOR i = 1 TO kType.Count - 1
        IF kType[i] = "MenuItem" THEN SetP(i, "Orig", GetP(i, "Name"))
    NEXT
    meDone = FALSE
    meWin = GUI_Window.New("Menu Editor", 380, 334)
    meWin.Modal = TRUE
    meWin.Icon = "spark"
    meWin.onClose = Me_Closed
    l = GUI_Label.New(meWin)
    l.Text = "Ca&ption:"
    l.SetBounds(8, 11, 70, 16)
    meCap = GUI_TextBox.New(meWin)
    meCap.SetBounds(80, 8, 210, 21)
    meCap.onChange = MeCap_OnChange
    meCap.onEnter = Me_Next
    l = GUI_Label.New(meWin)
    l.Text = "Na&me:"
    l.SetBounds(8, 37, 70, 16)
    meName = GUI_TextBox.New(meWin)
    meName.SetBounds(80, 34, 210, 21)
    meName.onChange = MeName_OnChange
    meName.onEnter = Me_Next
    l = GUI_Label.New(meWin)
    l.Text = "&Shortcut:"
    l.SetBounds(8, 63, 70, 16)
    meKey = GUI_DropDown.New(meWin)
    meKey.SetBounds(80, 60, 110, 21)
    keys.Add("(none)")
    FOR c = 65 TO 90
        keys.Add("Ctrl+" + Chr(c))
    NEXT
    FOR c = 1 TO 12
        keys.Add("F" + Str(c))
    NEXT
    keys.Add("Delete")
    meKey.Items = keys
    meKey.onSelect = MeKey_OnSelect
    meChk = GUI_CheckBox.New(meWin)
    meChk.Text = "&Checked"
    meChk.SetBounds(200, 62, 84, 16)
    meChk.onChange = MeChk_OnChange
    meEn = GUI_CheckBox.New(meWin)
    meEn.Text = "&Enabled"
    meEn.SetBounds(290, 62, 84, 16)
    meEn.onChange = MeEn_OnChange
    b = GUI_Button.New(meWin)
    b.Text = "<"
    b.SetBounds(8, 92, 28, 23)
    b.onClick = Me_Out
    b = GUI_Button.New(meWin)
    b.Text = ">"
    b.SetBounds(40, 92, 28, 23)
    b.onClick = Me_In
    b = GUI_Button.New(meWin)
    b.Text = "Up"
    b.SetBounds(76, 92, 40, 23)
    b.onClick = Me_Up
    b = GUI_Button.New(meWin)
    b.Text = "Down"
    b.SetBounds(120, 92, 48, 23)
    b.onClick = Me_Down
    b = GUI_Button.New(meWin)
    b.Text = "&Next"
    b.SetBounds(176, 92, 60, 23)
    b.onClick = Me_Next
    b = GUI_Button.New(meWin)
    b.Text = "&Insert"
    b.SetBounds(240, 92, 60, 23)
    b.onClick = Me_Insert
    b = GUI_Button.New(meWin)
    b.Text = "&Delete"
    b.SetBounds(304, 92, 68, 23)
    b.onClick = Me_Delete
    meList = GUI_ListBox.New(meWin)
    meList.SetBounds(8, 122, 364, 170)
    meList.Mono = TRUE
    meList.onSelect = MeList_OnSelect
    b = GUI_Button.New(meWin)
    b.Text = "OK"
    b.Default = TRUE
    b.SetBounds(216, 302, 75, 24)
    b.onClick = Me_Ok
    b = GUI_Button.New(meWin)
    b.Text = "Cancel"
    b.Cancel = TRUE
    b.SetBounds(297, 302, 75, 24)
    b.onClick = Me_Cancel
    FillMe(-1)
    IF meIdx.Count > 0 THEN
        meList.Selected = 0
        MeShow()
    END IF
    meWin.Center()
    meWin.Show()
    meCap.Focus()
END SUB

' The list, with object k selected (-1: none).
SUB FillMe (k AS Integer)
    VAR rows AS Array OF String
    VAR i AS Integer
    VAR s AS String
    meIdx.Clear()
    FOR i = 1 TO kType.Count - 1
        IF kType[i] <> "MenuItem" THEN CONTINUE
        s = GetP(i, "Caption")
        IF GetN(i, "Level") > 0 THEN s = "...." + s
        IF GetP(i, "Shortcut") <> "" THEN s = s.PadRight(26) + GetP(i, "Shortcut")
        meIdx.Add(i)
        rows.Add(s)
    NEXT
    meList.Items = rows
    meList.Selected = meIdx.IndexOf(k)
    MeShow()
END SUB

FUNCTION MeCur () AS Integer
    IF meList.Selected < 0 OR meList.Selected >= meIdx.Count THEN RETURN -1
    RETURN meIdx[meList.Selected]
END FUNCTION

' The selected item in the boxes.
SUB MeShow ()
    VAR i AS Integer
    i = MeCur()
    meBusy = TRUE
    IF i < 0 THEN
        meCap.Text = ""
        meName.Text = ""
        meKey.Selected = 0
        meChk.Checked = FALSE
        meEn.Checked = TRUE
    ELSE
        IF meCap.Text <> GetP(i, "Caption") THEN meCap.Text = GetP(i, "Caption")
        IF meName.Text <> GetP(i, "Name") THEN meName.Text = GetP(i, "Name")
        meKey.Selected = MATH.Max(0, meKey.Items.IndexOf(GetP(i, "Shortcut")))
        meChk.Checked = GetB(i, "Checked")
        meEn.Checked = GetB(i, "Enabled")
    END IF
    meBusy = FALSE
END SUB

SUB MeList_OnSelect ()
    MeShow()
END SUB

' A new, empty item at object index at.
FUNCTION MeNew (at AS Integer, level AS Integer) AS Integer
    kType.Insert(at, "MenuItem")
    kProps.Insert(at, "")
    SetP(at, "Level", Str(level))
    SetP(at, "Caption", "")
    SetP(at, "Name", "")
    RETURN at
END FUNCTION

' The selected item, made if there isn't one yet.
FUNCTION MeItem () AS Integer
    VAR i AS Integer
    i = MeCur()
    IF i >= 0 THEN RETURN i
    i = MeNew(kType.Count, 0)
    FillMe(i)
    RETURN i
END FUNCTION

' mnuFile, mnuFileOpen: the menu's name, then the item's, as VB programmers wrote them.
FUNCTION AutoName (i AS Integer, cap AS String) AS String
    VAR base AS String
    VAR parentWord AS String
    VAR k AS Integer
    VAR n AS Integer
    IF cap = "-" THEN
        base = "mnuLine"
    ELSE
        IF GetN(i, "Level") > 0 THEN
            FOR k = i - 1 TO 1 STEP -1
                IF kType[k] = "MenuItem" AND GetN(k, "Level") = 0 THEN
                    parentWord = CapWord(GetP(k, "Caption"))
                    BREAK
                END IF
            NEXT
        END IF
        base = "mnu" + parentWord + CapWord(cap)
    END IF
    IF base = "mnu" THEN RETURN ""
    IF NOT NameTaken(base, i) AND cap <> "-" THEN RETURN base
    n = 1
    WHILE NameTaken(base + Str(n), i)
        n = n + 1
    END WHILE
    RETURN base + Str(n)
END FUNCTION

' The letters and digits of a caption, starting with a capital: "&Save As..." is SaveAs.
FUNCTION CapWord (cap AS String) AS String
    VAR out AS String
    VAR k AS Integer
    VAR ch AS String
    FOR k = 0 TO cap.Length - 1
        ch = cap.CharAt(k)
        IF IsIdentChar(ch) AND ch <> "_" THEN out = out + ch
    NEXT
    IF out = "" THEN RETURN ""
    RETURN out.CharAt(0).Upper() + out.Substring(1, out.Length - 1)
END FUNCTION

SUB MeCap_OnChange ()
    VAR i AS Integer
    VAR old AS String
    VAR text AS String
    IF meBusy THEN RETURN
    text = meCap.Text
    i = MeItem()
    old = GetP(i, "Caption")
    SetP(i, "Caption", text)
    ' a name made from the caption follows it, until it's typed by hand
    IF GetP(i, "Name") = "" OR GetP(i, "Name") = AutoName(i, old) THEN SetP(i, "Name", AutoName(i, text))
    MeRow(i)
    MeShow()
END SUB

' One line of the list again, without disturbing the rest.
SUB MeRow (i AS Integer)
    VAR s AS String
    VAR r AS Integer
    r = meIdx.IndexOf(i)
    IF r < 0 THEN RETURN
    s = GetP(i, "Caption")
    IF GetN(i, "Level") > 0 THEN s = "...." + s
    IF GetP(i, "Shortcut") <> "" THEN s = s.PadRight(26) + GetP(i, "Shortcut")
    meList.Set(r, s)
END SUB

' (Each takes what was typed or picked first: making a new item clears the boxes.)
SUB MeName_OnChange ()
    VAR text AS String
    VAR i AS Integer
    IF meBusy THEN RETURN
    text = meName.Text.Trim()
    i = MeItem()
    SetP(i, "Name", text)
    MeShow()
END SUB

SUB MeKey_OnSelect ()
    VAR i AS Integer
    VAR k AS Integer
    IF meBusy THEN RETURN
    k = meKey.Selected
    i = MeItem()
    IF k <= 0 THEN
        SetP(i, "Shortcut", "")
    ELSE
        SetP(i, "Shortcut", meKey.Items[k])
    END IF
    MeRow(i)
    MeShow()
END SUB

SUB MeChk_OnChange ()
    VAR on AS Bool
    VAR i AS Integer
    IF meBusy THEN RETURN
    on = meChk.Checked
    i = MeItem()
    IF on THEN
        SetP(i, "Checked", "TRUE")
    ELSE
        SetP(i, "Checked", "FALSE")
    END IF
    MeShow()
END SUB

SUB MeEn_OnChange ()
    VAR on AS Bool
    VAR i AS Integer
    IF meBusy THEN RETURN
    on = meEn.Checked
    i = MeItem()
    IF on THEN
        SetP(i, "Enabled", "TRUE")
    ELSE
        SetP(i, "Enabled", "FALSE")
    END IF
    MeShow()
END SUB

' Next: the item after this one, or a new one at the end, at the same level.
SUB Me_Next ()
    VAR i AS Integer
    VAR r AS Integer
    i = MeCur()
    r = meList.Selected
    IF i >= 0 AND r < meIdx.Count - 1 THEN
        meList.Selected = r + 1
        MeShow()
    ELSE
        IF i >= 0 AND GetP(i, "Caption") = "" THEN RETURN
        IF i >= 0 THEN
            FillMe(MeNew(kType.Count, GetN(i, "Level")))
        ELSE
            FillMe(MeNew(kType.Count, 0))
        END IF
    END IF
    meCap.Focus()
END SUB

' Insert: a new item before this one.
SUB Me_Insert ()
    VAR i AS Integer
    i = MeCur()
    IF i < 0 THEN
        FillMe(MeNew(kType.Count, 0))
    ELSE
        FillMe(MeNew(i, GetN(i, "Level")))
    END IF
    meCap.Focus()
END SUB

SUB Me_Delete ()
    VAR i AS Integer
    VAR r AS Integer
    i = MeCur()
    IF i < 0 THEN RETURN
    r = meList.Selected
    kType.RemoveAt(i)
    kProps.RemoveAt(i)
    FillMe(-1)
    IF meIdx.Count > 0 THEN
        meList.Selected = MATH.Min(r, meIdx.Count - 1)
        MeShow()
    END IF
    meCap.Focus()
END SUB

' < and >: a menu on the bar, or an item in the menu above.
SUB Me_Out ()
    VAR i AS Integer
    i = MeCur()
    IF i < 0 THEN RETURN
    SetP(i, "Level", "0")
    FillMe(i)
    meCap.Focus()
END SUB

SUB Me_In ()
    VAR i AS Integer
    i = MeCur()
    IF i < 0 THEN RETURN
    IF meList.Selected = 0 THEN
        Say("The first line is a menu on the bar: the items go under it.", "info")
        RETURN
    END IF
    SetP(i, "Level", "1")
    FillMe(i)
    meCap.Focus()
END SUB

SUB Me_Up ()
    MeSwap(-1)
END SUB

SUB Me_Down ()
    MeSwap(1)
END SUB

' The selected item swapped with the one above (-1) or below (1).
SUB MeSwap (dir AS Integer)
    VAR r AS Integer
    VAR a AS Integer
    VAR b AS Integer
    VAR t AS String
    r = meList.Selected
    IF r < 0 OR r + dir < 0 OR r + dir >= meIdx.Count THEN RETURN
    a = meIdx[r]
    b = meIdx[r + dir]
    t = kProps[a]
    kProps[a] = kProps[b]
    kProps[b] = t
    FillMe(b)
    meCap.Focus()
END SUB

SUB Me_Ok ()
    VAR i AS Integer
    VAR n AS String
    VAR o AS String
    ' (empty lines are left out)
    i = kType.Count - 1
    WHILE i >= 1
        IF kType[i] = "MenuItem" AND GetP(i, "Caption").Trim() = "" AND GetP(i, "Name").Trim() = "" THEN
            kType.RemoveAt(i)
            kProps.RemoveAt(i)
        END IF
        i = i - 1
    END WHILE
    FOR i = 1 TO kType.Count - 1
        IF kType[i] <> "MenuItem" THEN CONTINUE
        n = GetP(i, "Name").Trim()
        IF GetP(i, "Caption").Trim() = "" THEN
            FillMe(i)
            Say("Each item needs a caption: what the menu shows.", "warn")
            RETURN
        END IF
        IF NOT IsIdent(n) THEN
            FillMe(i)
            Say(Plain(GetP(i, "Caption")) + " needs a name for the code: letters, digits and _, starting with a letter.", "warn")
            RETURN
        END IF
        IF NameTaken(n, i) THEN
            FillMe(i)
            Say("Something else is already called " + n + ".", "warn")
            RETURN
        END IF
    NEXT
    ' renamed items: their SUBs too
    FOR i = 1 TO kType.Count - 1
        IF kType[i] <> "MenuItem" THEN CONTINUE
        o = GetP(i, "Orig")
        n = GetP(i, "Name")
        IF o <> "" AND o <> n THEN editor.Text = Renamed(editor.Text, o, n)
        DropP(i, "Orig")
    NEXT
    ' (no change: nothing to undo)
    IF undoModel.Count > 0 THEN
        IF undoModel[undoModel.Count - 1] = Snapshot() THEN
            undoModel.RemoveAt(undoModel.Count - 1)
            undoCode.RemoveAt(undoCode.Count - 1)
        END IF
    END IF
    Did()
    meDone = TRUE
    meWin.Close()
    FillObjects()
    SelectObj(0)
    IF HasMenu() THEN win.Status = "Click a menu on the form, then an item, to write what it does."
END SUB

SUB Me_Cancel ()
    meWin.Close()
END SUB

' Closed without OK: the menus as they were.
SUB Me_Closed ()
    VAR k AS Integer
    IF meDone THEN RETURN
    meDone = TRUE
    k = undoModel.Count - 1
    IF k >= 0 THEN
        LoadSnap(undoModel[k])
        undoModel.RemoveAt(k)
        undoCode.RemoveAt(k)
    END IF
    FillObjects()
    SelectObj(0)
END SUB

' ================================================================ anchors

' An Anchor value tidied: the edges named, in order.
FUNCTION Anchors (v AS String) AS String
    VAR out AS Array OF String
    VAR u AS String
    VAR e AS String
    u = "," + v.Upper().Replace(" ", "").Replace(";", ",").Replace("+", ",") + ","
    FOR EACH e IN ["Top", "Bottom", "Left", "Right"]
        IF u.Contains("," + e.Upper() + ",") THEN out.Add(e)
    NEXT
    RETURN out.Join(",")
END FUNCTION

' Is any control anchored other than to the top left (so the program lays them out)?
FUNCTION Anchored () AS Bool
    VAR i AS Integer
    FOR i = 1 TO kType.Count - 1
        IF Movable(i) AND kType[i] <> "Timer" THEN
            IF GetP(i, "Anchor") <> "Top,Left" THEN RETURN TRUE
        END IF
    NEXT
    RETURN FALSE
END FUNCTION

' Code for a position (pos TRUE) or a size along one direction, as the window
' grows by d: anchored at both ends it stretches; at the far end it moves; at
' neither it stays in the middle.
FUNCTION Span (pos AS Integer, size AS Integer, anchor AS String, near AS String, far AS String, d AS String, wantPos AS Bool) AS String
    VAR a AS Bool
    VAR b AS Bool
    a = ("," + anchor + ",").Contains("," + near + ",")
    b = ("," + anchor + ",").Contains("," + far + ",")
    IF NOT wantPos THEN
        IF a AND b THEN RETURN "MATH.Max(" + Str(GRID) + ", " + Str(size) + " + " + d + ")"
        RETURN Str(size)
    END IF
    IF a AND b THEN RETURN Str(pos)
    IF b THEN RETURN Str(pos) + " + " + d
    IF a THEN RETURN Str(pos)
    RETURN Str(pos) + " + Int(" + d + " / 2)"
END FUNCTION

' The form grew by dw, dh on the designer: its anchored controls follow.
SUB FollowForm (dw AS Integer, dh AS Integer)
    VAR i AS Integer
    VAR an AS String
    FOR i = 1 TO kType.Count - 1
        IF NOT Movable(i) OR kType[i] = "Timer" THEN CONTINUE
        an = "," + GetP(i, "Anchor") + ","
        IF dw <> 0 THEN
            IF an.Contains(",Left,") AND an.Contains(",Right,") THEN
                SetP(i, "Width", Str(MATH.Max(GRID, GetN(i, "Width") + dw)))
            ELSEIF an.Contains(",Right,") THEN
                SetP(i, "X", Str(MATH.Max(0, GetN(i, "X") + dw)))
            ELSEIF NOT an.Contains(",Left,") THEN
                SetP(i, "X", Str(MATH.Max(0, GetN(i, "X") + Int(dw / 2))))
            END IF
        END IF
        IF dh <> 0 THEN
            IF an.Contains(",Top,") AND an.Contains(",Bottom,") THEN
                SetP(i, "Height", Str(MATH.Max(GRID, GetN(i, "Height") + dh)))
            ELSEIF an.Contains(",Bottom,") THEN
                SetP(i, "Y", Str(MATH.Max(0, GetN(i, "Y") + dh)))
            ELSEIF NOT an.Contains(",Top,") THEN
                SetP(i, "Y", Str(MATH.Max(0, GetN(i, "Y") + Int(dh / 2))))
            END IF
        END IF
    NEXT
END SUB

' ================================================================ the layout, as text

' As Visual BASIC kept a form in its .FRM file: a Begin...End for each object,
' with every property. Editing it and going back to the Form or the Code
' applies it.
FUNCTION LayoutText () AS String
    VAR out AS Array OF String
    VAR i AS Integer
    VAR e AS String
    VAR key AS String
    VAR kind AS String
    out.Add("' The form's layout. Change values here, then go")
    out.Add("' back to the Form or the Code to apply them.")
    out.Add("' Later objects are drawn over earlier ones.")
    out.Add("' Each one's name is on its Begin line.")
    out.Add("")
    FOR i = 0 TO kType.Count - 1
        out.Add("Begin " + kType[i] + " " + GetP(i, "Name"))
        FOR EACH e IN Props(kType[i])
            key = e.Split("|")[0]
            IF key = "Name" THEN CONTINUE
            kind = PropKind(kType[i], key)
            IF kind = "int" OR kind = "bool" OR kind = "color" THEN
                out.Add("    " + key + " = " + GetP(i, key))
            ELSE
                out.Add("    " + key + " = " + Lit(GetP(i, key)))
            END IF
        NEXT
        out.Add("End")
        out.Add("")
    NEXT
    RETURN out.Join(EOL)
END FUNCTION

SUB ShowLayout ()
    VAR k AS Integer
    VAR lines AS Array OF String
    IF layoutView THEN RETURN
    layoutView = TRUE
    codeView = FALSE
    design.Visible = FALSE
    keys.Visible = FALSE
    editor.Visible = FALSE
    objList.Visible = FALSE
    evtList.Visible = FALSE
    layoutEd.Visible = TRUE
    formBtn.Enabled = TRUE
    codeBtn.Enabled = TRUE
    layBtn.Enabled = FALSE
    tool = ""
    toolbox.Selected = 0
    layoutShown = LayoutText()
    layoutEd.Text = layoutShown
    ' at the selected object
    lines = layoutShown.Split(EOL)
    FOR k = 0 TO lines.Count - 1
        IF lines[k] = "Begin " + kType[sel] + " " + GetP(sel, "Name") THEN
            ' (the cursor at the end of the line, not the line selected)
            layoutEd.GotoLine(k + 1)
            layoutEd.Insert(lines[k])
            layoutShown = layoutEd.Text
            BREAK
        END IF
    NEXT
    layoutEd.Focus()
    win.Status = "The form's layout: change it here, then go back to the Form or the Code."
END SUB

' Out of the layout view, with its changes applied: FALSE (and still there) if they're wrong.
FUNCTION LeaveLayout () AS Bool
    IF NOT layoutView THEN RETURN TRUE
    IF NOT ApplyLayout() THEN RETURN FALSE
    layoutView = FALSE
    layoutEd.Visible = FALSE
    RETURN TRUE
END FUNCTION

FUNCTION ApplyLayout () AS Bool
    VAR before AS String
    VAR beforeCode AS String
    VAR oldTypes AS Array OF String
    VAR oldNames AS Array OF String
    VAR msg AS String
    VAR i AS Integer
    VAR line AS Integer
    IF layoutEd.Text = layoutShown THEN RETURN TRUE
    before = Snapshot()
    beforeCode = editor.Text
    FOR i = 0 TO kType.Count - 1
        oldTypes.Add(kType[i])
        oldNames.Add(GetP(i, "Name"))
    NEXT
    msg = ParseLayout(layoutEd.Text)
    IF msg <> "" THEN
        Say("The layout has a mistake, so it isn't applied yet." + EOL + EOL + msg, "warn")
        line = Int(Val(msg.Substring(5, msg.IndexOf(":") - 5)))
        IF line > 0 THEN layoutEd.GotoLine(line)
        RETURN FALSE
    END IF
    ' an object with a new name in the same place: its code follows
    FOR i = 0 TO MATH.Min(oldTypes.Count, kType.Count) - 1
        IF oldTypes[i] = kType[i] AND oldNames[i] <> GetP(i, "Name") THEN editor.Text = Renamed(editor.Text, oldNames[i], GetP(i, "Name"))
    NEXT
    IF Snapshot() <> before THEN PushUndo(before, beforeCode)
    Did()
    layoutShown = layoutEd.Text
    IF sel >= kType.Count THEN sel = 0
    FillObjects()
    FillProps()
    RETURN TRUE
END FUNCTION

' The layout read into the form. "" when it's good; otherwise what's wrong,
' as "Line n: ...", and the form is as it was.
FUNCTION ParseLayout (text AS String) AS String
    VAR old AS String
    VAR lines AS Array OF String
    VAR k AS Integer
    VAR t AS String
    VAR i AS Integer
    VAR rest AS String
    VAR typ AS String
    VAR nm AS String
    VAR key AS String
    VAR v AS String
    VAR why AS String
    VAR at AS Integer
    old = Snapshot()
    kType.Clear()
    kProps.Clear()
    i = -1
    lines = text.Replace(Chr(13), "").Split(EOL)
    FOR k = 0 TO lines.Count - 1
        t = lines[k].Trim()
        IF t = "" OR t.StartsWith("'") THEN CONTINUE
        IF t.Upper().StartsWith("BEGIN ") THEN
            rest = t.Substring(6, t.Length - 6).Trim()
            at = rest.IndexOf(" ")
            IF i >= 0 THEN
                why = "a Begin before the End of " + GetP(i, "Name") + "."
            ELSEIF at < 0 THEN
                why = "Begin needs a kind and a name, like: Begin Button Command1"
            ELSE
                typ = KindOf(rest.Substring(0, at))
                nm = rest.Substring(at + 1, rest.Length - at - 1).Trim()
                IF typ = "" THEN
                    why = Q + rest.Substring(0, at) + Q + " isn't a kind of object. The kinds: Form, " + KindList() + "."
                ELSEIF typ = "Form" AND kType.Count > 0 THEN
                    why = "there's only one Form, and it comes first."
                ELSEIF typ <> "Form" AND kType.Count = 0 THEN
                    why = "the Form comes first."
                ELSEIF NOT IsIdent(nm) THEN
                    why = Q + nm + Q + " can't be a name: letters, digits and _, starting with a letter."
                ELSEIF NameTaken(nm, -1) THEN
                    why = "two things are called " + nm + "."
                ELSE
                    kType.Add(typ)
                    kProps.Add("")
                    i = kType.Count - 1
                    SetP(i, "Name", nm)
                END IF
            END IF
        ELSEIF t.Upper() = "END" THEN
            IF i < 0 THEN why = "an End without a Begin."
            i = -1
        ELSEIF i < 0 THEN
            why = "this is outside any Begin...End."
        ELSEIF NOT t.Contains("=") THEN
            why = "a property is written Key = value."
        ELSE
            key = KeyOf(kType[i], t.Substring(0, t.IndexOf("=")).Trim())
            v = t.Substring(t.IndexOf("=") + 1, t.Length - t.IndexOf("=") - 1).Trim()
            IF key = "Name" THEN
                why = "the name goes on the Begin line."
            ELSEIF key = "" THEN
                why = "a " + kType[i] + " has no " + t.Substring(0, t.IndexOf("=")).Trim() + ". It has: " + KeyList(kType[i]) + "."
            ELSE
                IF v.StartsWith(Q) THEN v = Unlit(v)
                IF v <> Chr(0) THEN v = Checked(kType[i], key, v)
                IF v = Chr(0) THEN
                    why = "that isn't a good " + key + ". " + KindHelp(PropKind(kType[i], key))
                ELSE
                    SetP(i, key, v)
                END IF
            END IF
        END IF
        IF why <> "" THEN
            LoadSnap(old)
            RETURN "Line " + Str(k + 1) + ": " + why
        END IF
    NEXT
    IF i >= 0 THEN why = GetP(i, "Name") + " has no End."
    IF kType.Count = 0 THEN why = "there's no Begin Form."
    IF why <> "" THEN
        LoadSnap(old)
        RETURN "Line " + Str(lines.Count) + ": " + why
    END IF
    RETURN ""
END FUNCTION

' A kind of object as written (any case), or "".
FUNCTION KindOf (s AS String) AS String
    VAR k AS String
    FOR EACH k IN ["Form", "Label", "Button", "TextBox", "TextArea", "CheckBox", "RadioButton", "ListBox", "DropDown", "ProgressBar", "Canvas", "Timer", "MenuItem"]
        IF k.Lower() = s.Lower() THEN RETURN k
    NEXT
    RETURN ""
END FUNCTION

FUNCTION KindList () AS String
    RETURN "Label, Button, TextBox, TextArea, CheckBox, RadioButton, ListBox, DropDown, ProgressBar, Canvas, Timer and MenuItem"
END FUNCTION

' A property of kind t as written (any case), or "".
FUNCTION KeyOf (t AS String, s AS String) AS String
    VAR e AS String
    FOR EACH e IN Props(t)
        IF e.Split("|")[0].Lower() = s.Lower() THEN RETURN e.Split("|")[0]
    NEXT
    RETURN ""
END FUNCTION

FUNCTION KeyList (t AS String) AS String
    VAR out AS Array OF String
    VAR e AS String
    FOR EACH e IN Props(t)
        IF e.Split("|")[0] <> "Name" THEN out.Add(e.Split("|")[0])
    NEXT
    RETURN out.Join(", ")
END FUNCTION

' "He said ""hi""" as He said "hi"; Chr(0) if it isn't a whole string.
FUNCTION Unlit (v AS String) AS String
    VAR inner AS String
    IF v.Length < 2 OR NOT v.EndsWith(Q) THEN RETURN Chr(0)
    inner = v.Substring(1, v.Length - 2)
    IF inner.Replace(Q + Q, "").Contains(Q) THEN RETURN Chr(0)
    RETURN inner.Replace(Q + Q, Q)
END FUNCTION

' A value for a property, tidied; Chr(0) if it can't be one.
FUNCTION Checked (t AS String, key AS String, v AS String) AS String
    VAR kind AS String
    VAR opts AS Array OF String
    VAR k AS Integer
    VAR ch AS String
    kind = PropKind(t, key)
    IF kind = "int" OR kind = "color" THEN
        IF v = "" OR v = "-" THEN RETURN Chr(0)
        FOR k = 0 TO v.Length - 1
            ch = v.CharAt(k)
            IF NOT (IsDigit(ch) OR (k = 0 AND ch = "-")) THEN RETURN Chr(0)
        NEXT
        IF kind = "color" AND (Val(v) < 0 OR Val(v) > 15) THEN RETURN Chr(0)
        IF (key = "X" OR key = "Y") AND Val(v) < 0 THEN RETURN Chr(0)
        IF (key = "Width" OR key = "Height") AND Val(v) < 1 THEN RETURN Chr(0)
        IF key = "Level" AND (Val(v) < 0 OR Val(v) > 1) THEN RETURN Chr(0)
        RETURN Str(Int(Val(v)))
    END IF
    IF kind = "bool" THEN
        IF v.Upper() = "TRUE" OR v.Upper() = "FALSE" THEN RETURN v.Upper()
        RETURN Chr(0)
    END IF
    IF kind.StartsWith("choice:") THEN
        opts = kind.Substring(7, kind.Length - 7).Split(",")
        IF opts.Contains(v.Lower()) THEN RETURN v.Lower()
        RETURN Chr(0)
    END IF
    IF kind = "anchor" THEN
        IF v.Trim() <> "" AND Anchors(v) = "" THEN RETURN Chr(0)
        RETURN Anchors(v)
    END IF
    IF kind = "shortcut" THEN
        IF ShortcutOk(v) THEN RETURN v
        RETURN Chr(0)
    END IF
    IF v.Contains(Chr(10)) THEN RETURN Chr(0)
    RETURN v
END FUNCTION

FUNCTION IsDigit (ch AS String) AS Bool
    RETURN Asc(ch) >= 48 AND Asc(ch) <= 57
END FUNCTION

FUNCTION KindHelp (kind AS String) AS String
    IF kind = "int" THEN RETURN "It's a whole number (X and Y not below 0, Width and Height at least 1)."
    IF kind = "bool" THEN RETURN "It's TRUE or FALSE."
    IF kind = "color" THEN RETURN "It's a colour from 0 to 15."
    IF kind.StartsWith("choice:") THEN RETURN "It's one of: " + kind.Substring(7, kind.Length - 7).Replace(",", ", ") + "."
    IF kind = "anchor" THEN RETURN "It's edges from Top, Bottom, Left and Right, like " + Q + "Top,Right" + Q + "."
    IF kind = "shortcut" THEN RETURN "It's like " + Q + "Ctrl+O" + Q + " or " + Q + "F3" + Q + ", or " + Q + Q + " for none."
    RETURN "It's text in quotes: " + Q + "like this" + Q + "."
END FUNCTION

' ================================================================ running

FUNCTION Alive (pid AS Integer) AS Bool
    VAR task AS String
    IF pid <= 0 THEN RETURN FALSE
    FOR EACH task IN SYS.Tasks()
        IF Int(Val(task.Split("|")[0])) = pid THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

' Run: the project saved (where it lives, or in C:\VSPARK if it has no
' home yet) and started. A run still going is ended first.
SUB RunIt ()
    VAR target AS String
    target = projPath
    IF target = "" THEN target = SCRATCH
    IF NOT SaveTo(target) THEN RETURN
    IF projPath <> "" THEN saved = Assemble()
    EndRun()
    runPid = SYS.Run(target)
    win.Status = "Running " + projName + ". (Errors show in their own window; Run > End stops it.)"
END SUB

SUB EndRun ()
    IF Alive(runPid) THEN SYS.Kill(runPid)
    runPid = 0
END SUB

' ================================================================ menus and buttons

SUB FormBtn_OnClick ()
    ShowForm()
END SUB

SUB CodeBtn_OnClick ()
    ShowCode()
END SUB

SUB LayBtn_OnClick ()
    ShowLayout()
END SUB

SUB RunBtn_OnClick ()
    RunIt()
END SUB

SUB Menu_OnSelect (item AS String)
    SELECT CASE item
        CASE "New Project..."
            NewProject()
        CASE "Open Project..."
            OpenProject()
        CASE "Save Project"
            SaveProject()
        CASE "Save Project As..."
            SaveAs()
        CASE "Exit"
            win.Close()
        CASE "Undo", "Redo", "Cut", "Copy", "Paste", "Duplicate", "Bring to Front", "Send to Back"
            EditCmd(item)
        CASE "Menu Editor..."
            MenuEditor()
        CASE "Delete Control"
            IF sel > 0 THEN
                DeleteSelected()
            ELSE
                win.Status = "Select a control on the form first. (The form itself stays.)"
            END IF
        CASE "Code"
            ShowCode()
        CASE "Form"
            ShowForm()
        CASE "Layout"
            ShowLayout()
        CASE "Start"
            RunIt()
        CASE "End"
            EndRun()
            win.Status = "Stopped."
        CASE "SPARK Reference"
            SYS.Start("C:\PROGRAMS\NOTES.SPK", "C:\DOCS\SPARK.TXT")
        CASE "About Visual SPARK"
            Say("Visual SPARK 1.0 for SIM95" + EOL + EOL + "Draw a window, double-click what's on it, and write what happens. F5 runs it." + EOL + EOL + "A project is an ordinary .SPK file: your code, then the form, which the designer writes.", "info")
        CASE ELSE
            Snippet(item)
    END SELECT
END SUB
