    l = GUI_Label.New(win)
    l.Text = "Toolbox"
    l.Bold = TRUE
    l.SetBounds(6, 8, 120, 16)
    toolbox = GUI_ListBox.New(win)
    toolbox.SetBounds(6, 26, 120, 220)
    toolbox.Items = ["Pointer", "Label", "Button", "TextBox", "TextArea", "CheckBox", "RadioButton", "ListBox", "DropDown", "ProgressBar", "Canvas", "Timer"]
    toolbox.onSelect = Toolbox_OnSelect
    toolbox.onDblClick = Toolbox_OnDblClick
    ' (labels don't wrap: a line each)
    k = 0
    FOR EACH hint IN ["Pick a control, then", "drag on the form where", "it goes.", "", "Double-click a control", "on the form to write", "its code. F5 runs it."]
        l = GUI_Label.New(win)
        l.Text = hint
        l.SetBounds(6, 252 + k * 16, 124, 16)
        k = k + 1
    NEXT

    formBtn = GUI_Button.New(win)
    formBtn.Text = "&Form"
    formBtn.SetBounds(134, 4, 70, 23)
    formBtn.onClick = FormBtn_OnClick
    codeBtn = GUI_Button.New(win)
    codeBtn.Text = "&Code"
    codeBtn.SetBounds(208, 4, 70, 23)
    codeBtn.onClick = CodeBtn_OnClick
    layBtn = GUI_Button.New(win)
    layBtn.Text = "&Layout"
    layBtn.SetBounds(282, 4, 70, 23)
    layBtn.onClick = LayBtn_OnClick
    runBtn = GUI_Button.New(win)
    runBtn.Text = "Run (F5)"
    runBtn.SetBounds(514, 4, 70, 23)
    runBtn.onClick = RunBtn_OnClick

    ' A Canvas can't hold the keyboard, so the designer focuses this instead:
    ' a button too small to see, under the canvas. Its keys are the designer's.
    keys = GUI_Button.New(win)
    keys.SetBounds(140, 40, 1, 1)
    keys.onKey = Design_OnKey
    ctx = GUI_Menu.New(win)
    ctx.AddMenu("Control")
    ctx.AddItem("Control", "&View Code")
    ctx.AddSeparator("Control")
    ctx.AddItem("Control", "Cu&t")
    ctx.AddItem("Control", "&Copy")
    ctx.AddItem("Control", "&Paste")
    ctx.AddItem("Control", "D&uplicate")
    ctx.AddItem("Control", "&Delete")
    ctx.AddSeparator("Control")
    ctx.AddItem("Control", "Bring to &Front")
    ctx.AddItem("Control", "Send to &Back")
