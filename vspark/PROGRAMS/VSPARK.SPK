    ctxForm.AddItem("Form", "&View Code")
    ctxForm.AddItem("Form", "&Paste")
    ctxForm.AddItem("Form", "&Menu Editor...")
    ctxForm.onSelect = CtxForm_OnSelect
    menuPop = GUI_Menu.New(win)
