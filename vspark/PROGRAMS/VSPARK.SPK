' VSPARK.SPK - Visual SPARK: draw a program's window, then write what happens
' when things in it are clicked, typed into or ticked. In the spirit of a
' certain Visual BASIC.
'
'   Toolbox      pick a control, then drag where it goes on the form (or
'                double-click it to drop one on the form)
'   Designer     click to select, drag to move, the corner handle to size;
'                Delete removes; double-click goes to the control's code
'   Properties   pick a property, type its value, Enter; double-click a
'                TRUE/FALSE or a choice to switch it
'   Code         two drop-downs: an object and one of its events. Picking
'                one goes to its SUB, writing it from a template if need be
'   Run (F5)     saves and runs the program
'
' A project is one ordinary .SPK file that runs without Visual SPARK. Your
' code comes first; the form comes last, between two marker lines, and the
' designer writes that part every time it saves:
'   ' FORM Form|Name=Form1|Title=...    what the designer reads back
'   ' CTRL Button|Name=Command1|X=...
'   VAR Command1 AS GUI_Button          what the program runs
'   SUB InitForm () ... END SUB
' A control's event is joined to its SUB (Command1.onClick =
' Command1_OnClick) when that SUB is in your code.

CONST HOME = "C:\VSPARK"
CONST TEMPLATES = "C:\VSPARK\TEMPLATE"
CONST SCRATCH = "C:\VSPARK\RUN.SPK"
CONST MARKSTART = "' ===== Visual SPARK form"
CONST MARKEND = "' ===== END OF FORM ====="
CONST GRID = 8
CONST FX = 10                     ' where the form is drawn on the designer
CONST FY = 10
CONST CX = 12                     ' the form's client area, on the designer
CONST MENUBAR = 19                ' a window's menu bar
CONST CHARW = 9                   ' a character, roughly, in a canvas's (fixed-pitch) text

VAR EOL AS String
VAR Q AS String
VAR win AS GUI_Window
VAR bar AS GUI_Menu
VAR toolbox AS GUI_ListBox
VAR design AS GUI_Canvas
VAR editor AS GUI_TextArea
VAR objList AS GUI_DropDown
VAR evtList AS GUI_DropDown
VAR formBtn AS GUI_Button
VAR codeBtn AS GUI_Button
VAR runBtn AS GUI_Button
VAR propObj AS GUI_DropDown
VAR propList AS GUI_ListBox
VAR propEdit AS GUI_TextBox
VAR propHelp AS GUI_TextArea
VAR propDel AS GUI_Button
VAR keys AS GUI_Button              ' takes the designer's keys (a Canvas gets none of its own)
VAR ctx AS GUI_Menu                 ' the designer's right-click menu

' The form (0) and its controls: their type, and their properties as
' Key=Value lines.
VAR kType AS Array OF String
VAR kProps AS Array OF String
VAR sel AS Integer                ' the selected object
VAR tool AS String                ' the control the toolbox will draw ("": the pointer)
VAR projPath AS String            ' the project's file ("" until it is saved)
VAR projName AS String
VAR saved AS String               ' the project as last saved or opened
VAR runPid AS Integer
VAR codeView AS Bool
VAR propKeys AS Array OF String   ' the properties behind propList
VAR evtNames AS Array OF String   ' the events behind evtList

' Dragging on the designer: new, move, size or form.
VAR dragMode AS String
VAR dragX0 AS Integer
VAR dragY0 AS Integer
VAR dragOX AS Integer
VAR dragOY AS Integer
VAR rx AS Integer
VAR ry AS Integer
VAR rw AS Integer
VAR rh AS Integer
VAR lastDown AS Integer
VAR lastDownIdx AS Integer

' File > New Project
VAR tplWin AS GUI_Window
VAR tplList AS GUI_ListBox
VAR tplAbout AS GUI_Label
VAR tplFiles AS Array OF String
VAR tplNotes AS Array OF String
VAR layoutEd AS GUI_TextArea      ' the form's layout, as text
VAR layoutView AS Bool
VAR layoutShown AS String         ' the layout as last shown or applied
VAR layBtn AS GUI_Button
VAR CY AS Integer                 ' the form's client area, on the designer: under its menu bar, if any

' undo and redo: the form as it was (and the code, which a rename changes)
VAR undoModel AS Array OF String
VAR undoCode AS Array OF String
VAR redoModel AS Array OF String
VAR redoCode AS Array OF String
VAR lastCode AS String            ' the code after the last change on the form
VAR dragSnap AS String            ' the form when a drag began
VAR dragCode AS String
VAR clipType AS String            ' the copied control
VAR clipProps AS String
VAR ctxForm AS GUI_Menu           ' the form's right-click menu
VAR menuPop AS GUI_Menu           ' a menu of the form, opened on the designer
VAR menuPopTop AS Integer

' the Menu Editor
VAR meWin AS GUI_Window
VAR meList AS GUI_ListBox
VAR meCap AS GUI_TextBox
VAR meName AS GUI_TextBox
VAR meKey AS GUI_DropDown
VAR meChk AS GUI_CheckBox
VAR meEn AS GUI_CheckBox
VAR meIdx AS Array OF Integer     ' the object behind each line of meList
VAR meBusy AS Bool                ' (filling in the boxes: not an edit)
VAR meDone AS Bool

SUB Main ()
    VAR l AS GUI_Label
    VAR hint AS String
    VAR k AS Integer
    EOL = Chr(10)
    Q = Chr(34)
    CY = 32
    IF NOT FS.Exists(HOME) THEN FS.MakeDir(HOME)
    win = GUI_Window.New("Visual SPARK", 780, 510)
    win.Icon = "spark"
    win.onClose = Win_OnClose
    bar = GUI_Menu.New(win)
    bar.onSelect = Menu_OnSelect
    bar.AddMenu("&File")
    bar.AddItem("&File", "&New Project..." + Chr(9) + "Ctrl+N")
    bar.AddItem("&File", "&Open Project..." + Chr(9) + "Ctrl+O")
    bar.AddItem("&File", "&Save Project" + Chr(9) + "Ctrl+S")
    bar.AddItem("&File", "Save Project &As...")
    bar.AddSeparator("&File")
    bar.AddItem("&File", "E&xit")
    bar.AddMenu("&Edit")
    bar.AddItem("&Edit", "&Undo" + Chr(9) + "Ctrl+Z")
    bar.AddItem("&Edit", "&Redo" + Chr(9) + "Ctrl+Y")
    bar.AddSeparator("&Edit")
    bar.AddItem("&Edit", "Cu&t" + Chr(9) + "Ctrl+X")
    bar.AddItem("&Edit", "&Copy" + Chr(9) + "Ctrl+C")
    bar.AddItem("&Edit", "&Paste" + Chr(9) + "Ctrl+V")
    bar.AddItem("&Edit", "D&uplicate" + Chr(9) + "Ctrl+D")
    bar.AddItem("&Edit", "&Delete Control")
    bar.AddSeparator("&Edit")
    bar.AddItem("&Edit", "Bring to &Front")
    bar.AddItem("&Edit", "Send to &Back")
    bar.AddMenu("&View")
    bar.AddItem("&View", "&Code" + Chr(9) + "F7")
    bar.AddItem("&View", "&Form" + Chr(9) + "Shift+F7")
    bar.AddItem("&View", "&Layout" + Chr(9) + "F8")
    bar.AddMenu("&Insert")
    bar.AddItem("&Insert", "&Message Box")
    bar.AddItem("&Insert", "&Yes or No Question")
    bar.AddItem("&Insert", "&Open a File")
    bar.AddItem("&Insert", "&Save a File")
    bar.AddItem("&Insert", "&Random Number")
    bar.AddItem("&Insert", "Run a &Program")
    bar.AddMenu("&Tools")
    bar.AddItem("&Tools", "&Menu Editor..." + Chr(9) + "Ctrl+E")
    bar.AddMenu("&Run")
    bar.AddItem("&Run", "&Start" + Chr(9) + "F5")
    bar.AddItem("&Run", "&End")
    bar.AddMenu("&Help")
    bar.AddItem("&Help", "SPARK &Reference")
