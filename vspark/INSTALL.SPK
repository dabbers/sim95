    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    bar = GUI_Menu.New(win)" + NL
    t = t + "    bar.onSelect = Menu_OnSelect" + NL
    t = t + "    bar.AddMenu(""&File"")" + NL
    t = t + "    bar.AddItem(""&File"", ""&New Project..."" + Chr(9) + ""Ctrl+N"")" + NL
    t = t + "    bar.AddItem(""&File"", ""&Open Project..."" + Chr(9) + ""Ctrl+O"")" + NL
    t = t + "    bar.AddItem(""&File"", ""&Save Project"" + Chr(9) + ""Ctrl+S"")" + NL
