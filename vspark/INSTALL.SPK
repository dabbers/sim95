    t = t + "" + NL
    t = t + "    l = GUI_Label.New(win)" + NL
    t = t + "    l.Text = ""Toolbox""" + NL
    t = t + "    l.Bold = TRUE" + NL
    t = t + "    l.SetBounds(6, 8, 120, 16)" + NL
    t = t + "    toolbox = GUI_ListBox.New(win)" + NL
    t = t + "    toolbox.SetBounds(6, 26, 120, 220)" + NL
    t = t + "    toolbox.Items = [""Pointer"", ""Label"", ""Button"", ""TextBox"", ""TextArea"", ""CheckBox"", ""RadioButton"", ""ListBox"", ""DropDown"", ""ProgressBar"", ""Canvas"", ""Timer""]" + NL
    t = t + "    toolbox.onSelect = Toolbox_OnSelect" + NL
    t = t + "    toolbox.onDblClick = Toolbox_OnDblClick" + NL
    t = t + "    ' (labels don't wrap: a line each)" + NL
    t = t + "    k = 0" + NL
    t = t + "    FOR EACH hint IN [""Pick a control, then"", ""drag on the form where"", ""it goes."", """", ""Double-click a control"", ""on the form to write"", ""its code. F5 runs it.""]" + NL
    t = t + "        l = GUI_Label.New(win)" + NL
    t = t + "        l.Text = hint" + NL
    t = t + "        l.SetBounds(6, 252 + k * 16, 124, 16)" + NL
    t = t + "        k = k + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "" + NL
    t = t + "    formBtn = GUI_Button.New(win)" + NL
    t = t + "    formBtn.Text = ""&Form""" + NL
    t = t + "    formBtn.SetBounds(134, 4, 70, 23)" + NL
    t = t + "    formBtn.onClick = FormBtn_OnClick" + NL
    t = t + "    codeBtn = GUI_Button.New(win)" + NL
    t = t + "    codeBtn.Text = ""&Code""" + NL
    t = t + "    codeBtn.SetBounds(208, 4, 70, 23)" + NL
    t = t + "    codeBtn.onClick = CodeBtn_OnClick" + NL
    t = t + "    layBtn = GUI_Button.New(win)" + NL
    t = t + "    layBtn.Text = ""&Layout""" + NL
    t = t + "    layBtn.SetBounds(282, 4, 70, 23)" + NL
    t = t + "    layBtn.onClick = LayBtn_OnClick" + NL
    t = t + "    runBtn = GUI_Button.New(win)" + NL
    t = t + "    runBtn.Text = ""Run (F5)""" + NL
    t = t + "    runBtn.SetBounds(514, 4, 70, 23)" + NL
    t = t + "    runBtn.onClick = RunBtn_OnClick" + NL
    t = t + "" + NL
    t = t + "    ' A Canvas can't hold the keyboard, so the designer focuses this instead:" + NL
