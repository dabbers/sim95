' VAPOR|id=VSPARK|name=Visual SPARK|kind=program|version=680a32c3|category=Programming|run=C:\PROGRAMS\VSPARK.SPK|files=C:\PROGRAMS\VSPARK.SPK;C:\VSPARK\TEMPLATE\CHAT.SPK;C:\VSPARK\TEMPLATE\COUNTER.SPK;C:\VSPARK\TEMPLATE\EMPTY.SPK;C:\VSPARK\TEMPLATE\GAME.SPK;C:\VSPARK\TEMPLATE\HELLO.SPK;C:\VSPARK\TEMPLATE\INDEX.TXT;C:\VSPARK\TEMPLATE\PAINT.SPK|tasks=VSPARK|startup=|folder=|about=Build programs the Visual BASIC way: draw the window, double-click what's on it, and write what happens. F5 runs it. Templates for a hello, a counter, paint, a chat client and a Vapor game.
' INSTALL.SPK - puts Visual SPARK on this machine. Generated by tools/build-installer.mjs;
' edit the files in vspark/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It writes Visual
' SPARK to C:\PROGRAMS\VSPARK.SPK, and its project templates to
' C:\VSPARK\TEMPLATE, and starts it. Draw a window, double-click what's on it,
' and write what happens; F5 runs it. Projects are ordinary .SPK files (keep
' them in C:\MYFILES): they run without Visual SPARK.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)

    IF NOT FS.Exists(Dest("C:\VSPARK")) THEN FS.MakeDir(Dest("C:\VSPARK"))
    IF NOT FS.Exists(Dest("C:\VSPARK\TEMPLATE")) THEN FS.MakeDir(Dest("C:\VSPARK\TEMPLATE"))


    File0()
    File1()
    File2()
    File3()
    File4()
    File5()
    File6()
    File7()
    Print("Visual SPARK is installed (8 files).")
    SYS.Start("C:\PROGRAMS\VSPARK.SPK", "")

    Print("Visual SPARK is running. Next time, start C:\PROGRAMS\VSPARK.SPK from Files, or open it from Vapor's Library.")
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "' VSPARK.SPK - Visual SPARK: draw a program's window, then write what happens" + NL
    t = t + "' when things in it are clicked, typed into or ticked. In the spirit of a" + NL
    t = t + "' certain Visual BASIC." + NL
    t = t + "'" + NL
    t = t + "'   Toolbox      pick a control, then drag where it goes on the form (or" + NL
    t = t + "'                double-click it to drop one on the form)" + NL
    t = t + "'   Designer     click to select, drag to move, the corner handle to size;" + NL
    t = t + "'                Delete removes; double-click goes to the control's code" + NL
    t = t + "'   Properties   pick a property, type its value, Enter; double-click a" + NL
    t = t + "'                TRUE/FALSE or a choice to switch it" + NL
    t = t + "'   Code         two drop-downs: an object and one of its events. Picking" + NL
    t = t + "'                one goes to its SUB, writing it from a template if need be" + NL
    t = t + "'   Run (F5)     saves and runs the program" + NL
    t = t + "'" + NL
    t = t + "' A project is one ordinary .SPK file that runs without Visual SPARK. Your" + NL
    t = t + "' code comes first; the form comes last, between two marker lines, and the" + NL
    t = t + "' designer writes that part every time it saves:" + NL
    t = t + "'   ' FORM Form|Name=Form1|Title=...    what the designer reads back" + NL
    t = t + "'   ' CTRL Button|Name=Command1|X=..." + NL
    t = t + "'   VAR Command1 AS GUI_Button          what the program runs" + NL
    t = t + "'   SUB InitForm () ... END SUB" + NL
    t = t + "' A control's event is joined to its SUB (Command1.onClick =" + NL
    t = t + "' Command1_OnClick) when that SUB is in your code." + NL
    t = t + "" + NL
    t = t + "CONST HOME = ""C:\VSPARK""" + NL
    t = t + "CONST TEMPLATES = ""C:\VSPARK\TEMPLATE""" + NL
    t = t + "CONST SCRATCH = ""C:\VSPARK\RUN.SPK""" + NL
    t = t + "CONST MARKSTART = ""' ===== Visual SPARK form""" + NL
    t = t + "CONST MARKEND = ""' ===== END OF FORM =====""" + NL
    t = t + "CONST GRID = 8" + NL
    t = t + "CONST FX = 10                     ' where the form is drawn on the designer" + NL
    t = t + "CONST FY = 10" + NL
    t = t + "CONST CX = 12                     ' the form's client area, on the designer" + NL
    t = t + "CONST MENUBAR = 19                ' a window's menu bar" + NL
    t = t + "CONST CHARW = 9                   ' a character, roughly, in a canvas's (fixed-pitch) text" + NL
    t = t + "" + NL
    t = t + "VAR EOL AS String" + NL
    t = t + "VAR Q AS String" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR bar AS GUI_Menu" + NL
    t = t + "VAR toolbox AS GUI_ListBox" + NL
    t = t + "VAR design AS GUI_Canvas" + NL
    t = t + "VAR editor AS GUI_TextArea" + NL
    t = t + "VAR objList AS GUI_DropDown" + NL
    t = t + "VAR evtList AS GUI_DropDown" + NL
    t = t + "VAR formBtn AS GUI_Button" + NL
    t = t + "VAR codeBtn AS GUI_Button" + NL
    t = t + "VAR runBtn AS GUI_Button" + NL
    t = t + "VAR propObj AS GUI_DropDown" + NL
    t = t + "VAR propList AS GUI_ListBox" + NL
    t = t + "VAR propEdit AS GUI_TextBox" + NL
    t = t + "VAR propHelp AS GUI_TextArea" + NL
    t = t + "VAR propDel AS GUI_Button" + NL
    t = t + "VAR keys AS GUI_Button              ' takes the designer's keys (a Canvas gets none of its own)" + NL
    t = t + "VAR ctx AS GUI_Menu                 ' the designer's right-click menu" + NL
    t = t + "" + NL
    t = t + "' The form (0) and its controls: their type, and their properties as" + NL
    t = t + "' Key=Value lines." + NL
    t = t + "VAR kType AS Array OF String" + NL
    t = t + "VAR kProps AS Array OF String" + NL
    t = t + "VAR sel AS Integer                ' the selected object" + NL
    t = t + "VAR tool AS String                ' the control the toolbox will draw ("""": the pointer)" + NL
    t = t + "VAR projPath AS String            ' the project's file ("""" until it is saved)" + NL
    t = t + "VAR projName AS String" + NL
    t = t + "VAR saved AS String               ' the project as last saved or opened" + NL
    t = t + "VAR runPid AS Integer" + NL
    t = t + "VAR codeView AS Bool" + NL
    t = t + "VAR propKeys AS Array OF String   ' the properties behind propList" + NL
    t = t + "VAR evtNames AS Array OF String   ' the events behind evtList" + NL
    t = t + "" + NL
    t = t + "' Dragging on the designer: new, move, size or form." + NL
    t = t + "VAR dragMode AS String" + NL
    t = t + "VAR dragX0 AS Integer" + NL
    t = t + "VAR dragY0 AS Integer" + NL
