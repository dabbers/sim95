SUB File6 ()
    t = ""
    t = t + "EMPTY.SPK|Empty form|A form with nothing on it yet: draw on it, then write its code." + NL
    t = t + "HELLO.SPK|Hello, world|A label and a button that changes it. The smallest real program." + NL
    t = t + "COUNTER.SPK|Counter|A timer that counts the seconds, and a button to start again." + NL
    t = t + "PAINT.SPK|Paint|A canvas to draw on with the mouse, in four colours." + NL
    t = t + "CHAT.SPK|Chat client|Talks to any machine's Chat service (port 6667), in #general." + NL
    t = t + "GAME.SPK|Vapor game|Catch the falling stars, with the arrow keys. Ready to publish in a Vapor store." + NL
    Put("C:\VSPARK\TEMPLATE\INDEX.TXT")
END SUB

SUB File7 ()
    t = ""
    t = t + "' PROJECT1.SPK - made with Visual SPARK: draw with the mouse." + NL
    t = t + "" + NL
    t = t + "VAR drawing AS Bool" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    InitForm()" + NL
    t = t + "    Form1.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The colour picked in Combo1, as a palette number." + NL
    t = t + "FUNCTION Ink () AS Integer" + NL
    t = t + "    VAR inks AS Array OF Integer" + NL
    t = t + "    inks = [0, 9, 2, 12]" + NL
    t = t + "    IF Combo1.Selected < 0 THEN RETURN 0" + NL
    t = t + "    RETURN inks[Combo1.Selected]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Picture1_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    drawing = TRUE" + NL
    t = t + "    Picture1.SetColor(Ink())" + NL
    t = t + "    Picture1.FillCircle(x, y, 2)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Picture1_OnMouseMove (x AS Integer, y AS Integer)" + NL
    t = t + "    IF drawing THEN Picture1.FillCircle(x, y, 2)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Picture1_OnMouseUp (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    drawing = FALSE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Command1_OnClick ()" + NL
    t = t + "    Picture1.Clear()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ===== Visual SPARK form: the designer writes everything from here to END OF FORM. =====" + NL
    t = t + "' FORM Form|Name=Form1|Title=Paint|Width=320|Height=248" + NL
    t = t + "' CTRL Canvas|Name=Picture1|X=8|Y=8|Width=304|Height=200|Background=15" + NL
    t = t + "' CTRL DropDown|Name=Combo1|X=8|Y=216|Width=120|Height=24|Items=Black;Red;Green;Blue|Selected=0" + NL
    t = t + "' CTRL Button|Name=Command1|Text=&Clear|X=232|Y=216|Width=80|Height=24" + NL
    t = t + "' ===== END OF FORM =====" + NL
    Put("C:\VSPARK\TEMPLATE\PAINT.SPK")
END SUB
