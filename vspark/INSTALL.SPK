    t = t + "VAR lastDown AS Integer" + NL
    t = t + "VAR lastDownIdx AS Integer" + NL
    t = t + "" + NL
    t = t + "' File > New Project" + NL
    t = t + "VAR tplWin AS GUI_Window" + NL
    t = t + "VAR tplList AS GUI_ListBox" + NL
    t = t + "VAR tplAbout AS GUI_Label" + NL
    t = t + "VAR tplFiles AS Array OF String" + NL
    t = t + "VAR tplNotes AS Array OF String" + NL
    t = t + "VAR layoutEd AS GUI_TextArea      ' the form's layout, as text" + NL
    t = t + "VAR layoutView AS Bool" + NL
    t = t + "VAR layoutShown AS String         ' the layout as last shown or applied" + NL
    t = t + "VAR layBtn AS GUI_Button" + NL
    t = t + "VAR CY AS Integer                 ' the form's client area, on the designer: under its menu bar, if any" + NL
    t = t + "" + NL
    t = t + "' undo and redo: the form as it was (and the code, which a rename changes)" + NL
