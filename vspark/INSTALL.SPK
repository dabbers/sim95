    t = t + "    propHelp.ReadOnly = TRUE" + NL
    t = t + "    propHelp.WordWrap = TRUE" + NL
    t = t + "" + NL
    t = t + "    ' a project to start with: the one asked for, or an empty form" + NL
    t = t + "    IF SYS.Args.Count > 0 THEN" + NL
    t = t + "        IF FS.Exists(SYS.Args[0]) THEN" + NL
    t = t + "            LoadText(FS.Read(SYS.Args[0]), SYS.Args[0])" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    IF kType.Count = 0 THEN LoadTemplate(""EMPTY.SPK"")" + NL
    t = t + "    ShowForm()" + NL
    t = t + "    win.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' (A window that is closing can't be kept open: so the question is whether" + NL
    t = t + "' to save first.)" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    EndRun()" + NL
    t = t + "    IF Dirty() THEN" + NL
    t = t + "        box = GUI_MessageBox.New(win)" + NL
    t = t + "        box.Title = ""Visual SPARK""" + NL
    t = t + "        box.Kind = ""confirm""" + NL
    t = t + "        box.Buttons = ""yesno""" + NL
    t = t + "        box.Text = ""Save the changes to "" + projName + "" before closing?""" + NL
    t = t + "        IF box.Show() THEN SaveProject()" + NL
    t = t + "    END IF" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Say (text AS String, kind AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = ""Visual SPARK""" + NL
    t = t + "    box.Kind = kind" + NL
    t = t + "    box.Text = text" + NL
    t = t + "    box.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the model" + NL
    t = t + "" + NL
    t = t + "FUNCTION GetP (i AS Integer, key AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN kProps[i].Split(EOL)" + NL
    t = t + "        IF line.StartsWith(key + ""="") THEN RETURN line.Substring(key.Length + 1, line.Length - key.Length - 1)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN PropDefault(kType[i], key)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION GetN (i AS Integer, key AS String) AS Integer" + NL
    t = t + "    RETURN Int(Val(GetP(i, key)))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION GetB (i AS Integer, key AS String) AS Bool" + NL
    t = t + "    RETURN GetP(i, key).Upper() = ""TRUE""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SetP (i AS Integer, key AS String, value AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR found AS Bool" + NL
    t = t + "    FOR EACH line IN kProps[i].Split(EOL)" + NL
    t = t + "        IF line = """" THEN CONTINUE" + NL
    t = t + "        IF line.StartsWith(key + ""="") THEN" + NL
    t = t + "            out.Add(key + ""="" + value)" + NL
    t = t + "            found = TRUE" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT found THEN out.Add(key + ""="" + value)" + NL
    t = t + "    kProps[i] = out.Join(EOL)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Each type's properties, in order: Key|kind|default. Kinds: name, text," + NL
    t = t + "' int, bool, items (separated by ;), color (0-15), choice:a,b,c." + NL
    t = t + "FUNCTION Props (t AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    IF t = ""MenuItem"" THEN" + NL
    t = t + "        out = [""Name|name|"", ""Caption|text|"", ""Level|int|0"", ""Shortcut|shortcut|"", ""Checked|bool|FALSE"", ""Enabled|bool|TRUE""]" + NL
    t = t + "        RETURN out" + NL
    t = t + "    END IF" + NL
    t = t + "    IF t = ""Form"" THEN" + NL
    t = t + "        out = [""Name|name|Form1"", ""Title|text|Form1"", ""Width|int|320"", ""Height|int|240"", ""Status|text|"", ""Resizable|bool|TRUE"", ""Icon|choice:app,notes,terminal,spark,voyager,chat,network,settings,sketch,mines,monitor,help,folder,computer,info|app""]" + NL
    t = t + "        RETURN out" + NL
    t = t + "    END IF" + NL
    t = t + "    out.Add(""Name|name|"")" + NL
    t = t + "    IF t <> ""Timer"" AND t <> ""ProgressBar"" AND t <> ""Canvas"" THEN out.Add(""Text|text|"")" + NL
    t = t + "    out.Add(""X|int|0"")" + NL
    t = t + "    out.Add(""Y|int|0"")" + NL
    t = t + "    IF t <> ""Timer"" THEN" + NL
    t = t + "        out.Add(""Width|int|64"")" + NL
    t = t + "        out.Add(""Height|int|24"")" + NL
    t = t + "        out.Add(""Visible|bool|TRUE"")" + NL
    t = t + "        out.Add(""Anchor|anchor|Top,Left"")" + NL
    t = t + "    END IF" + NL
    t = t + "    out.Add(""Enabled|bool|TRUE"")" + NL
    t = t + "    SELECT CASE t" + NL
    t = t + "        CASE ""Label""" + NL
    t = t + "            out.Add(""Align|choice:left,center,right|left"")" + NL
    t = t + "            out.Add(""Bold|bool|FALSE"")" + NL
    t = t + "        CASE ""Button""" + NL
    t = t + "            out.Add(""Default|bool|FALSE"")" + NL
    t = t + "            out.Add(""Cancel|bool|FALSE"")" + NL
    t = t + "        CASE ""TextBox""" + NL
    t = t + "            out.Add(""Password|bool|FALSE"")" + NL
    t = t + "            out.Add(""ReadOnly|bool|FALSE"")" + NL
    t = t + "            out.Add(""MaxLength|int|0"")" + NL
    t = t + "        CASE ""TextArea""" + NL
    t = t + "            out.Add(""ReadOnly|bool|FALSE"")" + NL
    t = t + "            out.Add(""WordWrap|bool|FALSE"")" + NL
    t = t + "        CASE ""CheckBox""" + NL
    t = t + "            out.Add(""Checked|bool|FALSE"")" + NL
    t = t + "        CASE ""RadioButton""" + NL
    t = t + "            out.Add(""Checked|bool|FALSE"")" + NL
    t = t + "            out.Add(""Group|text|"")" + NL
    t = t + "        CASE ""ListBox""" + NL
    t = t + "            out.Add(""Items|items|"")" + NL
    t = t + "            out.Add(""Selected|int|-1"")" + NL
    t = t + "            out.Add(""Mono|bool|FALSE"")" + NL
    t = t + "        CASE ""DropDown""" + NL
    t = t + "            out.Add(""Items|items|"")" + NL
    t = t + "            out.Add(""Selected|int|-1"")" + NL
    t = t + "        CASE ""ProgressBar""" + NL
    t = t + "            out.Add(""Value|int|0"")" + NL
    t = t + "            out.Add(""Max|int|100"")" + NL
    t = t + "        CASE ""Canvas""" + NL
    t = t + "            out.Add(""Background|color|15"")" + NL
    t = t + "        CASE ""Timer""" + NL
    t = t + "            out.Add(""Interval|int|1000"")" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION PropEntry (t AS String, key AS String) AS String" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    FOR EACH e IN Props(t)" + NL
    t = t + "        IF e.StartsWith(key + ""|"") THEN RETURN e" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION PropKind (t AS String, key AS String) AS String" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    e = PropEntry(t, key)" + NL
    t = t + "    IF e = """" THEN RETURN ""text""" + NL
    t = t + "    RETURN e.Split(""|"")[1]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION PropDefault (t AS String, key AS String) AS String" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    e = PropEntry(t, key)" + NL
    t = t + "    IF e = """" THEN RETURN """"" + NL
    t = t + "    RETURN e.Split(""|"")[2]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Command1, Label1...: the names Visual BASIC gave them." + NL
    t = t + "FUNCTION Prefix (t AS String) AS String" + NL
    t = t + "    SELECT CASE t" + NL
    t = t + "        CASE ""Button""" + NL
    t = t + "            RETURN ""Command""" + NL
    t = t + "        CASE ""TextBox""" + NL
    t = t + "            RETURN ""Text""" + NL
    t = t + "        CASE ""TextArea""" + NL
    t = t + "            RETURN ""Memo""" + NL
    t = t + "        CASE ""CheckBox""" + NL
    t = t + "            RETURN ""Check""" + NL
    t = t + "        CASE ""RadioButton""" + NL
    t = t + "            RETURN ""Option""" + NL
    t = t + "        CASE ""ListBox""" + NL
    t = t + "            RETURN ""List""" + NL
    t = t + "        CASE ""DropDown""" + NL
    t = t + "            RETURN ""Combo""" + NL
    t = t + "        CASE ""ProgressBar""" + NL
    t = t + "            RETURN ""Progress""" + NL
    t = t + "        CASE ""Canvas""" + NL
    t = t + "            RETURN ""Picture""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN t" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NameTaken (name AS String, but AS Integer) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF name.Lower() = ""menubar"" THEN RETURN TRUE" + NL
    t = t + "    FOR i = 0 TO kType.Count - 1" + NL
    t = t + "        IF i <> but AND GetP(i, ""Name"").Lower() = name.Lower() THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NextName (t AS String) AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    n = 1" + NL
    t = t + "    WHILE NameTaken(Prefix(t) + Str(n), -1)" + NL
    t = t + "        n = n + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN Prefix(t) + Str(n)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION DefaultW (t AS String) AS Integer" + NL
    t = t + "    SELECT CASE t" + NL
    t = t + "        CASE ""Label""" + NL
    t = t + "            RETURN 80" + NL
    t = t + "        CASE ""Button""" + NL
    t = t + "            RETURN 80" + NL
    t = t + "        CASE ""TextArea""" + NL
    t = t + "            RETURN 160" + NL
    t = t + "        CASE ""ListBox""" + NL
    t = t + "            RETURN 120" + NL
    t = t + "        CASE ""ProgressBar""" + NL
    t = t + "            RETURN 160" + NL
    t = t + "        CASE ""Canvas""" + NL
    t = t + "            RETURN 160" + NL
    t = t + "        CASE ""Timer""" + NL
    t = t + "            RETURN 24" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN 120" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION DefaultH (t AS String) AS Integer" + NL
    t = t + "    SELECT CASE t" + NL
    t = t + "        CASE ""Label""" + NL
    t = t + "            RETURN 16" + NL
    t = t + "        CASE ""TextBox""" + NL
    t = t + "            RETURN 24" + NL
    t = t + "        CASE ""DropDown""" + NL
    t = t + "            RETURN 24" + NL
    t = t + "        CASE ""CheckBox""" + NL
    t = t + "            RETURN 16" + NL
    t = t + "        CASE ""RadioButton""" + NL
    t = t + "            RETURN 16" + NL
    t = t + "        CASE ""ProgressBar""" + NL
    t = t + "            RETURN 16" + NL
    t = t + "        CASE ""TextArea""" + NL
    t = t + "            RETURN 80" + NL
    t = t + "        CASE ""ListBox""" + NL
    t = t + "            RETURN 80" + NL
    t = t + "        CASE ""Canvas""" + NL
    t = t + "            RETURN 96" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN 24" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION AddControl (t AS String, x AS Integer, y AS Integer, w AS Integer, h AS Integer) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    name = NextName(t)" + NL
    t = t + "    kType.Add(t)" + NL
    t = t + "    kProps.Add("""")" + NL
    t = t + "    i = kType.Count - 1" + NL
    t = t + "    SetP(i, ""Name"", name)" + NL
    t = t + "    IF t = ""Label"" OR t = ""Button"" OR t = ""CheckBox"" OR t = ""RadioButton"" THEN SetP(i, ""Text"", name)" + NL
    t = t + "    SetP(i, ""X"", Str(x))" + NL
    t = t + "    SetP(i, ""Y"", Str(y))" + NL
    t = t + "    IF t <> ""Timer"" THEN" + NL
    t = t + "        SetP(i, ""Width"", Str(w))" + NL
    t = t + "        SetP(i, ""Height"", Str(h))" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ClassOf (t AS String) AS String" + NL
    t = t + "    IF t = ""Form"" THEN RETURN ""GUI_Window""" + NL
    t = t + "    RETURN ""GUI_"" + t" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ events" + NL
    t = t + "" + NL
    t = t + "' Each type's events; the first is the one a double-click goes to." + NL
    t = t + "FUNCTION Events (t AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    SELECT CASE t" + NL
    t = t + "        CASE ""Form""" + NL
    t = t + "            out = [""Load"", ""onClose"", ""onResize"", ""onActivate"", ""onKey""]" + NL
    t = t + "        CASE ""Button""" + NL
    t = t + "            out = [""onClick"", ""onKey""]" + NL
    t = t + "        CASE ""TextBox""" + NL
    t = t + "            out = [""onChange"", ""onEnter"", ""onKey""]" + NL
    t = t + "        CASE ""TextArea""" + NL
    t = t + "            out = [""onChange"", ""onCursor"", ""onKey""]" + NL
    t = t + "        CASE ""CheckBox""" + NL
    t = t + "            out = [""onChange"", ""onKey""]" + NL
    t = t + "        CASE ""RadioButton""" + NL
    t = t + "            out = [""onChange"", ""onKey""]" + NL
    t = t + "        CASE ""ListBox""" + NL
    t = t + "            out = [""onSelect"", ""onDblClick"", ""onKey""]" + NL
    t = t + "        CASE ""DropDown""" + NL
    t = t + "            out = [""onSelect"", ""onKey""]" + NL
    t = t + "        CASE ""Canvas""" + NL
    t = t + "            out = [""onMouseDown"", ""onMouseMove"", ""onMouseUp"", ""onDraw"", ""onKey""]" + NL
    t = t + "        CASE ""Timer""" + NL
    t = t + "            out = [""onTick""]" + NL
    t = t + "        CASE ""MenuItem""" + NL
    t = t + "            out = [""onClick""]" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            out = [""onKey""]" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Params (evt AS String) AS String" + NL
    t = t + "    SELECT CASE evt" + NL
    t = t + "        CASE ""onKey""" + NL
    t = t + "            RETURN ""key AS String""" + NL
    t = t + "        CASE ""onDraw""" + NL
    t = t + "            RETURN ""canvas AS GUI_Canvas""" + NL
    t = t + "        CASE ""onMouseDown""" + NL
    t = t + "            RETURN ""x AS Integer, y AS Integer, button AS Integer""" + NL
    t = t + "        CASE ""onMouseUp""" + NL
    t = t + "            RETURN ""x AS Integer, y AS Integer, button AS Integer""" + NL
    t = t + "        CASE ""onMouseMove""" + NL
    t = t + "            RETURN ""x AS Integer, y AS Integer""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The SUB an event goes to: Command1_OnClick, or Main for the form's Load." + NL
    t = t + "FUNCTION HandlerOf (i AS Integer, evt AS String) AS String" + NL
    t = t + "    IF evt = ""Load"" THEN RETURN ""Main""" + NL
    t = t + "    RETURN GetP(i, ""Name"") + ""_On"" + evt.Substring(2, evt.Length - 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' What a new SUB starts with: a line on when it runs, and an example." + NL
    t = t + "FUNCTION Body (i AS Integer, evt AS String) AS String" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    VAR form AS String" + NL
    t = t + "    n = GetP(i, ""Name"")" + NL
    t = t + "    form = GetP(0, ""Name"")" + NL
    t = t + "    SELECT CASE evt" + NL
    t = t + "        CASE ""Load""" + NL
    t = t + "            RETURN ""    InitForm()"" + EOL + ""    "" + form + "".Show()""" + NL
    t = t + "        CASE ""onClick""" + NL
    t = t + "            IF kType[i] = ""MenuItem"" THEN RETURN ""    ' when "" + Plain(GetP(i, ""Caption"")) + "" is chosen from the menu. For example:"" + EOL + ""    ' "" + form + "".Title = "" + Q + ""Chosen!"" + Q" + NL
    t = t + "            RETURN ""    ' when "" + n + "" is clicked. For example:"" + EOL + ""    ' "" + form + "".Title = "" + Q + ""Clicked!"" + Q" + NL
    t = t + "        CASE ""onChange""" + NL
    t = t + "            IF kType[i] = ""CheckBox"" OR kType[i] = ""RadioButton"" THEN RETURN ""    ' when "" + n + "" is ticked or unticked: "" + n + "".Checked says which""" + NL
    t = t + "            RETURN ""    ' when the text in "" + n + "" changes: it's in "" + n + "".Text""" + NL
    t = t + "        CASE ""onEnter""" + NL
    t = t + "            RETURN ""    ' when Enter is pressed in "" + n + "". For example:"" + EOL + ""    ' "" + form + "".Title = "" + n + "".Text""" + NL
    t = t + "        CASE ""onSelect""" + NL
    t = t + "            RETURN ""    ' when something in "" + n + "" is picked: "" + n + "".Selected is which (from 0)""" + NL
    t = t + "        CASE ""onDblClick""" + NL
    t = t + "            RETURN ""    ' when an item in "" + n + "" is double-clicked""" + NL
    t = t + "        CASE ""onTick""" + NL
    t = t + "            RETURN ""    ' every "" + n + "".Interval milliseconds ("" + n + "".Stop() stops it)""" + NL
    t = t + "        CASE ""onKey""" + NL
    t = t + "            RETURN ""    ' a key: "" + Q + ""A"" + Q + "", "" + Q + ""Enter"" + Q + "", "" + Q + ""ArrowLeft"" + Q + "", "" + Q + ""Ctrl+S"" + Q + ""..."" + EOL + ""    IF key = "" + Q + ""Escape"" + Q + "" THEN "" + form + "".Close()""" + NL
    t = t + "        CASE ""onMouseDown""" + NL
    t = t + "            RETURN ""    ' x and y are where, inside "" + n + "". For example:"" + EOL + ""    "" + n + "".SetColor(12)"" + EOL + ""    "" + n + "".FillCircle(x, y, 3)""" + NL
    t = t + "        CASE ""onMouseMove""" + NL
    t = t + "            RETURN ""    ' the mouse moved over "" + n + "", to x, y""" + NL
    t = t + "        CASE ""onMouseUp""" + NL
    t = t + "            RETURN ""    ' the mouse button went up over "" + n" + NL
    t = t + "        CASE ""onDraw""" + NL
    t = t + "            RETURN ""    ' draw "" + n + "" here: it's shown, or its size changed"" + EOL + ""    canvas.SetColor(4)"" + EOL + ""    canvas.Text(8, 8, "" + Q + ""Hello"" + Q + "")""" + NL
    t = t + "        CASE ""onClose""" + NL
    t = t + "            RETURN ""    ' the window is closing"" + EOL + ""    SYS.Exit(0)""" + NL
    t = t + "        CASE ""onResize""" + NL
    t = t + "            RETURN ""    ' the window changed size: "" + form + "".Width and "" + form + "".Height""" + NL
    t = t + "        CASE ""onActivate""" + NL
    t = t + "            RETURN ""    ' the window came to the front""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ reading and writing projects" + NL
    t = t + "" + NL
    t = t + "FUNCTION Enc (v AS String) AS String" + NL
    t = t + "    RETURN v.Replace(""%"", ""%25"").Replace(""|"", ""%7C"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Dec (v AS String) AS String" + NL
    t = t + "    RETURN v.Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A SPARK string literal: ""He said """"hi""""""" + NL
    t = t + "FUNCTION Lit (s AS String) AS String" + NL
    t = t + "    RETURN Q + s.Replace(Q, Q + Q) + Q" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The SUBs in the code, upper case, as "",NAME,NAME,""." + NL
    t = t + "FUNCTION SubNames () AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    out = "",""" + NL
    t = t + "    FOR EACH line IN editor.Text.Lines()" + NL
    t = t + "        t = line.Trim()" + NL
    t = t + "        IF t.Upper().StartsWith(""SUB "") OR t.Upper().StartsWith(""FUNCTION "") THEN" + NL
    t = t + "            n = t.Substring(t.IndexOf("" "") + 1, t.Length - t.IndexOf("" "") - 1).Trim()" + NL
    t = t + "            IF n.Contains(""("") THEN n = n.Substring(0, n.IndexOf(""(""))" + NL
    t = t + "            IF n.Contains("" "") THEN n = n.Substring(0, n.IndexOf("" ""))" + NL
    t = t + "            out = out + n.Upper() + "",""" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The line (from 1) the SUB starts on, or 0." + NL
    t = t + "FUNCTION FindSub (name AS String) AS Integer" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    lines = editor.Text.Lines()" + NL
    t = t + "    FOR k = 0 TO lines.Count - 1" + NL
    t = t + "        t = lines[k].Trim().Upper()" + NL
    t = t + "        IF t.StartsWith(""SUB "" + name.Upper() + "" "") OR t.StartsWith(""SUB "" + name.Upper() + ""("") OR t = ""SUB "" + name.Upper() THEN RETURN k + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The designer's part of the file: what it reads back, then what runs." + NL
    t = t + "FUNCTION Block () AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR subs AS String" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR evt AS String" + NL
    t = t + "    VAR top AS String" + NL
    t = t + "    VAR cap AS String" + NL
    t = t + "    VAR cases AS Array OF String" + NL
    t = t + "    subs = SubNames()" + NL
    t = t + "    out.Add(MARKSTART + "": the designer writes everything from here to END OF FORM. ====="")" + NL
    t = t + "    FOR i = 0 TO kType.Count - 1" + NL
    t = t + "        line = """"" + NL
    t = t + "        FOR EACH e IN Props(kType[i])" + NL
    t = t + "            key = e.Split(""|"")[0]" + NL
    t = t + "            line = line + ""|"" + key + ""="" + Enc(GetP(i, key))" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF i = 0 THEN" + NL
    t = t + "            out.Add(""' FORM "" + kType[i] + line)" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(""' CTRL "" + kType[i] + line)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR i = 0 TO kType.Count - 1" + NL
    t = t + "        IF kType[i] <> ""MenuItem"" THEN out.Add(""VAR "" + GetP(i, ""Name"") + "" AS "" + ClassOf(kType[i]))" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF HasMenu() THEN out.Add(""VAR MenuBar AS GUI_Menu"")" + NL
    t = t + "    out.Add("""")" + NL
    t = t + "    out.Add(""SUB InitForm ()"")" + NL
    t = t + "    n = GetP(0, ""Name"")" + NL
    t = t + "    out.Add(""    "" + n + "" = GUI_Window.New("" + Lit(GetP(0, ""Title"")) + "", "" + Str(GetN(0, ""Width"")) + "", "" + Str(GetN(0, ""Height"")) + "")"")" + NL
    t = t + "    IF GetP(0, ""Status"") <> """" THEN out.Add(""    "" + n + "".Status = "" + Lit(GetP(0, ""Status"")))" + NL
    t = t + "    IF NOT GetB(0, ""Resizable"") THEN out.Add(""    "" + n + "".Resizable = FALSE"")" + NL
    t = t + "    IF GetP(0, ""Icon"") <> ""app"" THEN out.Add(""    "" + n + "".Icon = "" + Lit(GetP(0, ""Icon"")))" + NL
    t = t + "    FOR EACH evt IN Events(""Form"")" + NL
    t = t + "        IF evt = ""onResize"" AND Anchored() THEN CONTINUE" + NL
    t = t + "        IF evt <> ""Load"" AND subs.Contains("","" + HandlerOf(0, evt).Upper() + "","") THEN out.Add(""    "" + n + ""."" + evt + "" = "" + HandlerOf(0, evt))" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF Anchored() THEN out.Add(""    "" + n + "".onResize = "" + n + ""_Layout"")" + NL
    t = t + "    ' the menu bar, and which items have code" + NL
    t = t + "    IF HasMenu() THEN" + NL
    t = t + "        out.Add(""    MenuBar = GUI_Menu.New("" + n + "")"")" + NL
    t = t + "        top = """"" + NL
    t = t + "        FOR i = 1 TO kType.Count - 1" + NL
    t = t + "            IF kType[i] <> ""MenuItem"" THEN CONTINUE" + NL
    t = t + "            cap = GetP(i, ""Caption"")" + NL
    t = t + "            IF GetN(i, ""Level"") = 0 OR top = """" THEN" + NL
    t = t + "                top = cap" + NL
    t = t + "                out.Add(""    MenuBar.AddMenu("" + Lit(cap) + "")"")" + NL
    t = t + "            ELSEIF cap = ""-"" THEN" + NL
    t = t + "                out.Add(""    MenuBar.AddSeparator("" + Lit(top) + "")"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                IF GetP(i, ""Shortcut"") <> """" THEN" + NL
    t = t + "                    out.Add(""    MenuBar.AddItem("" + Lit(top) + "", "" + Lit(cap) + "" + Chr(9) + "" + Lit(GetP(i, ""Shortcut"")) + "")"")" + NL
    t = t + "                ELSE" + NL
    t = t + "                    out.Add(""    MenuBar.AddItem("" + Lit(top) + "", "" + Lit(cap) + "")"")" + NL
    t = t + "                END IF" + NL
    t = t + "                IF GetB(i, ""Checked"") THEN out.Add(""    MenuBar.SetChecked("" + Lit(Plain(cap)) + "", TRUE)"")" + NL
    t = t + "                IF NOT GetB(i, ""Enabled"") THEN out.Add(""    MenuBar.SetEnabled("" + Lit(Plain(cap)) + "", FALSE)"")" + NL
    t = t + "                IF subs.Contains("","" + HandlerOf(i, ""onClick"").Upper() + "","") THEN" + NL
    t = t + "                    cases.Add(""        CASE "" + Lit(Plain(cap)))" + NL
    t = t + "                    cases.Add(""            "" + HandlerOf(i, ""onClick"") + ""()"")" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF cases.Count > 0 THEN out.Add(""    MenuBar.onSelect = MenuBar_OnSelect"")" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 1 TO kType.Count - 1" + NL
    t = t + "        n = GetP(i, ""Name"")" + NL
    t = t + "        t = kType[i]" + NL
    t = t + "        IF t = ""MenuItem"" THEN CONTINUE" + NL
    t = t + "        out.Add(""    "" + n + "" = "" + ClassOf(t) + "".New("" + GetP(0, ""Name"") + "")"")" + NL
    t = t + "        IF t <> ""Timer"" THEN out.Add(""    "" + n + "".SetBounds("" + Str(GetN(i, ""X"")) + "", "" + Str(GetN(i, ""Y"")) + "", "" + Str(GetN(i, ""Width"")) + "", "" + Str(GetN(i, ""Height"")) + "")"")" + NL
    t = t + "        IF PropEntry(t, ""Text"") <> """" AND GetP(i, ""Text"") <> """" THEN out.Add(""    "" + n + "".Text = "" + Lit(GetP(i, ""Text"")))" + NL
    t = t + "        IF t <> ""Timer"" AND NOT GetB(i, ""Visible"") THEN out.Add(""    "" + n + "".Visible = FALSE"")" + NL
    t = t + "        IF t <> ""Timer"" AND NOT GetB(i, ""Enabled"") THEN out.Add(""    "" + n + "".Enabled = FALSE"")" + NL
    t = t + "        SELECT CASE t" + NL
    t = t + "            CASE ""Label""" + NL
    t = t + "                IF GetP(i, ""Align"") <> ""left"" THEN out.Add(""    "" + n + "".Align = "" + Lit(GetP(i, ""Align"")))" + NL
    t = t + "                IF GetB(i, ""Bold"") THEN out.Add(""    "" + n + "".Bold = TRUE"")" + NL
    t = t + "            CASE ""Button""" + NL
    t = t + "                IF GetB(i, ""Default"") THEN out.Add(""    "" + n + "".Default = TRUE"")" + NL
    t = t + "                IF GetB(i, ""Cancel"") THEN out.Add(""    "" + n + "".Cancel = TRUE"")" + NL
    t = t + "            CASE ""TextBox""" + NL
    t = t + "                IF GetB(i, ""Password"") THEN out.Add(""    "" + n + "".Password = TRUE"")" + NL
    t = t + "                IF GetB(i, ""ReadOnly"") THEN out.Add(""    "" + n + "".ReadOnly = TRUE"")" + NL
    t = t + "                IF GetN(i, ""MaxLength"") > 0 THEN out.Add(""    "" + n + "".MaxLength = "" + Str(GetN(i, ""MaxLength"")))" + NL
    t = t + "            CASE ""TextArea""" + NL
    t = t + "                IF GetB(i, ""ReadOnly"") THEN out.Add(""    "" + n + "".ReadOnly = TRUE"")" + NL
    t = t + "                IF GetB(i, ""WordWrap"") THEN out.Add(""    "" + n + "".WordWrap = TRUE"")" + NL
    t = t + "            CASE ""CheckBox""" + NL
    t = t + "                IF GetB(i, ""Checked"") THEN out.Add(""    "" + n + "".Checked = TRUE"")" + NL
    t = t + "            CASE ""RadioButton""" + NL
    t = t + "                IF GetP(i, ""Group"") <> """" THEN out.Add(""    "" + n + "".Group = "" + Lit(GetP(i, ""Group"")))" + NL
    t = t + "                IF GetB(i, ""Checked"") THEN out.Add(""    "" + n + "".Checked = TRUE"")" + NL
    t = t + "            CASE ""ListBox""" + NL
    t = t + "                IF GetB(i, ""Mono"") THEN out.Add(""    "" + n + "".Mono = TRUE"")" + NL
    t = t + "                FOR EACH item IN GetP(i, ""Items"").Split("";"")" + NL
    t = t + "                    IF item.Trim() <> """" THEN out.Add(""    "" + n + "".Add("" + Lit(item.Trim()) + "")"")" + NL
    t = t + "                NEXT" + NL
    t = t + "                IF GetN(i, ""Selected"") >= 0 THEN out.Add(""    "" + n + "".Selected = "" + Str(GetN(i, ""Selected"")))" + NL
    t = t + "            CASE ""DropDown""" + NL
    t = t + "                FOR EACH item IN GetP(i, ""Items"").Split("";"")" + NL
    t = t + "                    IF item.Trim() <> """" THEN out.Add(""    "" + n + "".Add("" + Lit(item.Trim()) + "")"")" + NL
    t = t + "                NEXT" + NL
    t = t + "                IF GetN(i, ""Selected"") >= 0 THEN out.Add(""    "" + n + "".Selected = "" + Str(GetN(i, ""Selected"")))" + NL
    t = t + "            CASE ""ProgressBar""" + NL
    t = t + "                IF GetN(i, ""Max"") <> 100 THEN out.Add(""    "" + n + "".Max = "" + Str(GetN(i, ""Max"")))" + NL
    t = t + "                IF GetN(i, ""Value"") <> 0 THEN out.Add(""    "" + n + "".Value = "" + Str(GetN(i, ""Value"")))" + NL
    t = t + "            CASE ""Canvas""" + NL
    t = t + "                IF GetN(i, ""Background"") <> 15 THEN" + NL
    t = t + "                    out.Add(""    "" + n + "".Background = "" + Str(GetN(i, ""Background"")))" + NL
    t = t + "                    out.Add(""    "" + n + "".Clear()"")" + NL
    t = t + "                END IF" + NL
    t = t + "            CASE ""Timer""" + NL
    t = t + "                out.Add(""    "" + n + "".Interval = "" + Str(MATH.Max(1, GetN(i, ""Interval""))))" + NL
    t = t + "        END SELECT" + NL
    t = t + "        FOR EACH evt IN Events(t)" + NL
    t = t + "            IF subs.Contains("","" + HandlerOf(i, evt).Upper() + "","") THEN out.Add(""    "" + n + ""."" + evt + "" = "" + HandlerOf(i, evt))" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' timers start last, when everything they might touch is there" + NL
    t = t + "    FOR i = 1 TO kType.Count - 1" + NL
    t = t + "        IF kType[i] = ""Timer"" AND GetB(i, ""Enabled"") THEN out.Add(""    "" + GetP(i, ""Name"") + "".Start()"")" + NL
    t = t + "    NEXT" + NL
    t = t + "    out.Add(""END SUB"")" + NL
    t = t + "    ' anchored controls follow the window's edges" + NL
    t = t + "    IF Anchored() THEN" + NL
    t = t + "        n = GetP(0, ""Name"")" + NL
    t = t + "        out.Add("""")" + NL
    t = t + "        out.Add(""SUB "" + n + ""_Layout ()"")" + NL
    t = t + "        out.Add(""    VAR dw AS Integer"")" + NL
    t = t + "        out.Add(""    VAR dh AS Integer"")" + NL
    t = t + "        out.Add(""    dw = "" + n + "".Width - "" + Str(GetN(0, ""Width"")))" + NL
    t = t + "        out.Add(""    dh = "" + n + "".Height - "" + Str(GetN(0, ""Height"")))" + NL
    t = t + "        FOR i = 1 TO kType.Count - 1" + NL
    t = t + "            IF Movable(i) AND kType[i] <> ""Timer"" THEN" + NL
    t = t + "                IF GetP(i, ""Anchor"") <> ""Top,Left"" THEN out.Add(""    "" + GetP(i, ""Name"") + "".SetBounds("" + Span(GetN(i, ""X""), GetN(i, ""Width""), GetP(i, ""Anchor""), ""Left"", ""Right"", ""dw"", TRUE) + "", "" + Span(GetN(i, ""Y""), GetN(i, ""Height""), GetP(i, ""Anchor""), ""Top"", ""Bottom"", ""dh"", TRUE) + "", "" + Span(GetN(i, ""X""), GetN(i, ""Width""), GetP(i, ""Anchor""), ""Left"", ""Right"", ""dw"", FALSE) + "", "" + Span(GetN(i, ""Y""), GetN(i, ""Height""), GetP(i, ""Anchor""), ""Top"", ""Bottom"", ""dh"", FALSE) + "")"")" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF subs.Contains("","" + HandlerOf(0, ""onResize"").Upper() + "","") THEN out.Add(""    "" + HandlerOf(0, ""onResize"") + ""()"")" + NL
    t = t + "        out.Add(""END SUB"")" + NL
    t = t + "    END IF" + NL
    t = t + "    ' a menu has one event for all its items: this hands each to its SUB" + NL
    t = t + "    IF cases.Count > 0 THEN" + NL
    t = t + "        out.Add("""")" + NL
    t = t + "        out.Add(""SUB MenuBar_OnSelect (item AS String)"")" + NL
    t = t + "        out.Add(""    SELECT CASE item"")" + NL
    t = t + "        FOR EACH line IN cases" + NL
    t = t + "            out.Add(line)" + NL
    t = t + "        NEXT" + NL
    t = t + "        out.Add(""    END SELECT"")" + NL
    t = t + "        out.Add(""END SUB"")" + NL
    t = t + "    END IF" + NL
    t = t + "    out.Add(MARKEND)" + NL
    t = t + "    RETURN out.Join(EOL) + EOL" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The code without blank lines at its end." + NL
    t = t + "FUNCTION Trimmed (code AS String) AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    lines = code.Replace(Chr(13), """").Split(EOL)" + NL
    t = t + "    WHILE lines.Count > 0" + NL
    t = t + "        IF lines[lines.Count - 1].Trim() <> """" THEN BREAK" + NL
    t = t + "        lines.RemoveAt(lines.Count - 1)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN lines.Join(EOL)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The whole file: the code, then the form." + NL
    t = t + "FUNCTION Assemble () AS String" + NL
    t = t + "    RETURN Trimmed(editor.Text) + EOL + EOL + Block()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A project's file into the designer and the code window." + NL
    t = t + "SUB LoadText (text AS String, src AS String)" + NL
    t = t + "    VAR code AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR inForm AS Bool" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR kv AS String" + NL
    t = t + "    kType.Clear()" + NL
    t = t + "    kProps.Clear()" + NL
    t = t + "    FOR EACH line IN text.Replace(Chr(13), """").Split(EOL)" + NL
    t = t + "        IF line.StartsWith(MARKSTART) THEN" + NL
    t = t + "            inForm = TRUE" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF line.StartsWith(MARKEND) THEN" + NL
    t = t + "            inForm = FALSE" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF NOT inForm THEN" + NL
    t = t + "            code.Add(line)" + NL
    t = t + "        ELSEIF line.StartsWith(""' FORM "") OR line.StartsWith(""' CTRL "") THEN" + NL
    t = t + "            p = line.Substring(7, line.Length - 7).Split(""|"")" + NL
    t = t + "            kType.Add(p[0])" + NL
    t = t + "            kProps.Add("""")" + NL
    t = t + "            i = kType.Count - 1" + NL
    t = t + "            FOR k = 1 TO p.Count - 1" + NL
    t = t + "                kv = p[k]" + NL
    t = t + "                IF kv.Contains(""="") THEN SetP(i, kv.Substring(0, kv.IndexOf(""="")), Dec(kv.Substring(kv.IndexOf(""="") + 1, kv.Length - kv.IndexOf(""="") - 1)))" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' a file with no form (not made here): an empty form to start one" + NL
    t = t + "    IF kType.Count = 0 OR kType[0] <> ""Form"" THEN" + NL
    t = t + "        kType.Insert(0, ""Form"")" + NL
    t = t + "        kProps.Insert(0, """")" + NL
    t = t + "    END IF" + NL
    t = t + "    editor.Text = Trimmed(code.Join(EOL)) + EOL" + NL
    t = t + "    projPath = src" + NL
    t = t + "    IF src = """" THEN" + NL
    t = t + "        projName = ""PROJECT1.SPK""" + NL
    t = t + "    ELSE" + NL
    t = t + "        projName = src.Substring(LastIndex(src, ""\"") + 1, src.Length - LastIndex(src, ""\"") - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    saved = Assemble()" + NL
    t = t + "    undoModel.Clear()" + NL
    t = t + "    undoCode.Clear()" + NL
    t = t + "    redoModel.Clear()" + NL
    t = t + "    redoCode.Clear()" + NL
    t = t + "    lastCode = editor.Text" + NL
    t = t + "    sel = 0" + NL
    t = t + "    tool = """"" + NL
    t = t + "    toolbox.Selected = 0" + NL
    t = t + "    FillObjects()" + NL
    t = t + "    FillProps()" + NL
    t = t + "    UpdateTitle()" + NL
    t = t + "    Draw()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION LastIndex (s AS String, c AS String) AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    FOR k = s.Length - 1 TO 0 STEP -1" + NL
    t = t + "        IF s.CharAt(k) = c THEN RETURN k" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN -1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB LoadTemplate (file AS String)" + NL
    t = t + "    IF FS.Exists(TEMPLATES + ""\"" + file) THEN" + NL
    t = t + "        LoadText(FS.Read(TEMPLATES + ""\"" + file), """")" + NL
    t = t + "    ELSE" + NL
    t = t + "        LoadText(""SUB Main ()"" + EOL + ""    InitForm()"" + EOL + ""    Form1.Show()"" + EOL + ""END SUB"" + EOL, """")" + NL
    t = t + "    END IF" + NL
    t = t + "    editor.Text = editor.Text.Replace(""PROJECT1.SPK"", projName)" + NL
    t = t + "    saved = Assemble()" + NL
    t = t + "    lastCode = editor.Text" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB UpdateTitle ()" + NL
    t = t + "    win.Title = ""Visual SPARK - "" + projName" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Dirty () AS Bool" + NL
    t = t + "    VAR ok AS Bool" + NL
    t = t + "    IF layoutView THEN ok = ApplyLayout()" + NL
    t = t + "    RETURN Assemble() <> saved" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION MayDiscard () AS Bool" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    IF NOT Dirty() THEN RETURN TRUE" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = ""Visual SPARK""" + NL
    t = t + "    box.Kind = ""confirm""" + NL
    t = t + "    box.Buttons = ""yesno""" + NL
    t = t + "    box.Text = projName + "" has changes that aren't saved."" + EOL + EOL + ""Throw them away?""" + NL
    t = t + "    RETURN box.Show()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION SaveTo (target AS String) AS Bool" + NL
    t = t + "    IF layoutView THEN" + NL
    t = t + "        IF NOT ApplyLayout() THEN RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    TRY" + NL
    t = t + "        FS.Write(target, Assemble())" + NL
    t = t + "    CATCH err" + NL
    t = t + "        Say(""Couldn't save "" + target + "":"" + EOL + EOL + err, ""error"")" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END TRY" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SaveProject ()" + NL
    t = t + "    IF projPath = """" THEN" + NL
    t = t + "        SaveAs()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF SaveTo(projPath) THEN" + NL
    t = t + "        saved = Assemble()" + NL
    t = t + "        win.Status = ""Saved "" + projPath" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SaveAs ()" + NL
    t = t + "    VAR fd AS GUI_FileDialog" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    fd = GUI_FileDialog.New(win)" + NL
    t = t + "    fd.Title = ""Save Project As""" + NL
    t = t + "    fd.Filter = ""*.SPK""" + NL
    t = t + "    fd.Path = ""C:\MYFILES""" + NL
    t = t + "    fd.FileName = projName" + NL
    t = t + "    p = fd.ShowSave()" + NL
    t = t + "    IF p = """" THEN RETURN" + NL
    t = t + "    IF NOT p.Upper().EndsWith("".SPK"") THEN p = p + "".SPK""" + NL
    t = t + "    projPath = p.Upper()" + NL
    t = t + "    projName = projPath.Substring(LastIndex(projPath, ""\"") + 1, projPath.Length - LastIndex(projPath, ""\"") - 1)" + NL
    t = t + "    UpdateTitle()" + NL
    t = t + "    SaveProject()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB OpenProject ()" + NL
    t = t + "    VAR fd AS GUI_FileDialog" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    IF NOT MayDiscard() THEN RETURN" + NL
    t = t + "    fd = GUI_FileDialog.New(win)" + NL
    t = t + "    fd.Title = ""Open Project""" + NL
    t = t + "    fd.Filter = ""*.SPK""" + NL
    t = t + "    fd.Path = ""C:\MYFILES""" + NL
    t = t + "    p = fd.ShowOpen()" + NL
    t = t + "    IF p = """" THEN RETURN" + NL
    t = t + "    IF NOT FS.Exists(p) THEN" + NL
    t = t + "        Say(""There is no file called "" + p + ""."", ""error"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    LoadText(FS.Read(p), p.Upper())" + NL
    t = t + "    ShowForm()" + NL
    t = t + "    win.Status = ""Opened "" + p" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ File > New Project" + NL
    t = t + "" + NL
    t = t + "SUB NewProject ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR names AS Array OF String" + NL
    t = t + "    VAR b AS GUI_Button" + NL
    t = t + "    IF NOT MayDiscard() THEN RETURN" + NL
    t = t + "    tplFiles.Clear()" + NL
    t = t + "    tplNotes.Clear()" + NL
    t = t + "    FOR EACH line IN ReadOr(TEMPLATES + ""\INDEX.TXT"", ""EMPTY.SPK|Empty form|A form with nothing on it yet."").Lines()" + NL
    t = t + "        IF line.Split(""|"").Count < 3 THEN CONTINUE" + NL
    t = t + "        tplFiles.Add(line.Split(""|"")[0])" + NL
    t = t + "        names.Add(line.Split(""|"")[1])" + NL
    t = t + "        tplNotes.Add(line.Split(""|"")[2])" + NL
    t = t + "    NEXT" + NL
    t = t + "    tplWin = GUI_Window.New(""New Project"", 320, 230)" + NL
    t = t + "    tplWin.Modal = TRUE" + NL
    t = t + "    tplWin.Icon = ""spark""" + NL
    t = t + "    tplList = GUI_ListBox.New(tplWin)" + NL
    t = t + "    tplList.SetBounds(8, 8, 304, 130)" + NL
    t = t + "    tplList.Items = names" + NL
    t = t + "    tplList.Selected = 0" + NL
    t = t + "    tplList.onSelect = TplList_OnSelect" + NL
    t = t + "    tplList.onDblClick = Tpl_Ok" + NL
    t = t + "    tplAbout = GUI_Label.New(tplWin)" + NL
    t = t + "    tplAbout.SetBounds(8, 144, 304, 44)" + NL
    t = t + "    IF tplNotes.Count > 0 THEN tplAbout.Text = tplNotes[0]" + NL
    t = t + "    b = GUI_Button.New(tplWin)" + NL
    t = t + "    b.Text = ""OK""" + NL
    t = t + "    b.Default = TRUE" + NL
    t = t + "    b.SetBounds(156, 196, 75, 24)" + NL
    t = t + "    b.onClick = Tpl_Ok" + NL
    t = t + "    b = GUI_Button.New(tplWin)" + NL
    t = t + "    b.Text = ""Cancel""" + NL
    t = t + "    b.Cancel = TRUE" + NL
    t = t + "    b.SetBounds(237, 196, 75, 24)" + NL
    t = t + "    b.onClick = Tpl_Cancel" + NL
    t = t + "    tplWin.Center()" + NL
    t = t + "    tplWin.Show()" + NL
    t = t + "    tplList.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (p AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(p) THEN RETURN FS.Read(p)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB TplList_OnSelect ()" + NL
    t = t + "    IF tplList.Selected >= 0 AND tplList.Selected < tplNotes.Count THEN tplAbout.Text = tplNotes[tplList.Selected]" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Tpl_Ok ()" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    k = tplList.Selected" + NL
    t = t + "    IF k < 0 OR k >= tplFiles.Count THEN RETURN" + NL
    t = t + "    tplWin.Close()" + NL
    t = t + "    LoadTemplate(tplFiles[k])" + NL
    t = t + "    ShowForm()" + NL
    t = t + "    win.Status = ""A new project, from "" + tplFiles[k] + "". Run it with F5.""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Tpl_Cancel ()" + NL
    t = t + "    tplWin.Close()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the designer" + NL
    t = t + "" + NL
    t = t + "FUNCTION Snap (v AS Integer) AS Integer" + NL
    t = t + "    RETURN Int((v + GRID / 2) / GRID) * GRID" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Text cut to fit w pixels." + NL
    t = t + "FUNCTION Fit (s AS String, w AS Integer) AS String" + NL
    t = t + "    VAR most AS Integer" + NL
    t = t + "    most = MATH.Max(0, Int(w / CHARW))" + NL
    t = t + "    IF s.Length > most THEN RETURN s.Substring(0, most)" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Bevel (x AS Integer, y AS Integer, w AS Integer, h AS Integer, raised AS Bool)" + NL
    t = t + "    IF raised THEN" + NL
    t = t + "        design.SetColor(15)" + NL
    t = t + "    ELSE" + NL
    t = t + "        design.SetColor(8)" + NL
    t = t + "    END IF" + NL
    t = t + "    design.Line(x, y, x + w - 1, y)" + NL
    t = t + "    design.Line(x, y, x, y + h - 1)" + NL
    t = t + "    IF raised THEN" + NL
    t = t + "        design.SetColor(0)" + NL
    t = t + "    ELSE" + NL
    t = t + "        design.SetColor(15)" + NL
    t = t + "    END IF" + NL
    t = t + "    design.Line(x, y + h - 1, x + w - 1, y + h - 1)" + NL
    t = t + "    design.Line(x + w - 1, y, x + w - 1, y + h - 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Draw ()" + NL
    t = t + "    VAR w AS Integer" + NL
    t = t + "    VAR h AS Integer" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR mh AS Integer" + NL
    t = t + "    ' (the layout view follows changes made in Properties, unless it's been edited)" + NL
    t = t + "    IF layoutView AND layoutEd.Text = layoutShown THEN" + NL
    t = t + "        layoutShown = LayoutText()" + NL
    t = t + "        layoutEd.Text = layoutShown" + NL
    t = t + "    END IF" + NL
    t = t + "    IF codeView OR layoutView THEN RETURN" + NL
    t = t + "    w = GetN(0, ""Width"")" + NL
    t = t + "    h = GetN(0, ""Height"")" + NL
    t = t + "    mh = MenuH()" + NL
    t = t + "    CY = 32 + mh" + NL
    t = t + "    design.Background = 8" + NL
    t = t + "    design.Clear()" + NL
    t = t + "    ' the window: frame, title bar, menu bar, client area with its grid" + NL
    t = t + "    design.SetColor(7)" + NL
    t = t + "    design.FillRect(FX, FY, w + 4, h + 24 + mh)" + NL
    t = t + "    Bevel(FX, FY, w + 4, h + 24 + mh, TRUE)" + NL
    t = t + "    design.SetColor(4)" + NL
    t = t + "    design.FillRect(FX + 2, FY + 2, w, 18)" + NL
    t = t + "    design.SetColor(15)" + NL
    t = t + "    design.Text(FX + 6, FY + 5, Fit(GetP(0, ""Title""), w - 12))" + NL
    t = t + "    IF mh > 0 THEN" + NL
    t = t + "        design.SetColor(0)" + NL
    t = t + "        FOR i = 1 TO kType.Count - 1" + NL
    t = t + "            IF kType[i] = ""MenuItem"" AND GetN(i, ""Level"") = 0 AND BarX(i) + 8 < w THEN design.Text(CX + BarX(i), FY + 23, Fit(Plain(GetP(i, ""Caption"")), w - BarX(i)))" + NL
    t = t + "        NEXT" + NL
    t = t + "        design.SetColor(8)" + NL
    t = t + "        design.Line(FX + 2, CY - 2, FX + w + 1, CY - 2)" + NL
    t = t + "    END IF" + NL
    t = t + "    design.SetColor(8)" + NL
    t = t + "    FOR y = 0 TO h - 1 STEP 16" + NL
    t = t + "        FOR x = 0 TO w - 1 STEP 16" + NL
    t = t + "            design.Pixel(CX + x, CY + y)" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR i = 1 TO kType.Count - 1" + NL
    t = t + "        IF kType[i] <> ""MenuItem"" THEN DrawControl(i)" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' the selection, and its handle" + NL
    t = t + "    design.SetColor(0)" + NL
    t = t + "    IF sel = 0 THEN" + NL
    t = t + "        design.FillRect(CX + w - 3, CY + h - 3, 6, 6)" + NL
    t = t + "    ELSEIF Movable(sel) THEN" + NL
    t = t + "        x = CX + GetN(sel, ""X"")" + NL
    t = t + "        y = CY + GetN(sel, ""Y"")" + NL
    t = t + "        design.SetColor(4)" + NL
    t = t + "        design.Rect(x - 2, y - 2, CtlW(sel) + 4, CtlH(sel) + 4)" + NL
    t = t + "        ' its anchors to the right and bottom edges, as lines to them" + NL
    t = t + "        design.SetColor(9)" + NL
    t = t + "        IF kType[sel] <> ""Timer"" AND GetP(sel, ""Anchor"").Contains(""Right"") THEN design.Line(x + CtlW(sel) + 3, y + Int(CtlH(sel) / 2), CX + w - 1, y + Int(CtlH(sel) / 2))" + NL
    t = t + "        IF kType[sel] <> ""Timer"" AND GetP(sel, ""Anchor"").Contains(""Bottom"") THEN design.Line(x + Int(CtlW(sel) / 2), y + CtlH(sel) + 3, x + Int(CtlW(sel) / 2), CY + h - 1)" + NL
    t = t + "        IF kType[sel] <> ""Timer"" THEN" + NL
    t = t + "            design.SetColor(0)" + NL
    t = t + "            design.FillRect(x + CtlW(sel) - 3, y + CtlH(sel) - 3, 6, 6)" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    ' a control being drawn" + NL
    t = t + "    IF dragMode = ""new"" THEN" + NL
    t = t + "        design.SetColor(0)" + NL
    t = t + "        design.Rect(CX + rx, CY + ry, MATH.Max(1, rw), MATH.Max(1, rh))" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Stars (n AS Integer) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    FOR k = 1 TO n" + NL
    t = t + "        out = out + ""*""" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CtlW (i AS Integer) AS Integer" + NL
    t = t + "    IF kType[i] = ""Timer"" THEN RETURN 24" + NL
    t = t + "    RETURN GetN(i, ""Width"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CtlH (i AS Integer) AS Integer" + NL
    t = t + "    IF kType[i] = ""Timer"" THEN RETURN 24" + NL
    t = t + "    RETURN GetN(i, ""Height"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB DrawControl (i AS Integer)" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR w AS Integer" + NL
    t = t + "    VAR h AS Integer" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR ink AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    t = kType[i]" + NL
    t = t + "    x = CX + GetN(i, ""X"")" + NL
    t = t + "    y = CY + GetN(i, ""Y"")" + NL
    t = t + "    w = CtlW(i)" + NL
    t = t + "    h = CtlH(i)" + NL
    t = t + "    s = GetP(i, ""Text"").Replace(""&"", """")" + NL
    t = t + "    ink = 0" + NL
    t = t + "    IF NOT GetB(i, ""Enabled"") THEN ink = 8" + NL
    t = t + "    SELECT CASE t" + NL
    t = t + "        CASE ""Label""" + NL
    t = t + "            design.SetColor(ink)" + NL
    t = t + "            s = Fit(s, w)" + NL
    t = t + "            IF GetP(i, ""Align"") = ""center"" THEN" + NL
    t = t + "                design.Text(x + MATH.Max(0, Int((w - s.Length * CHARW) / 2)), y + 2, s)" + NL
    t = t + "            ELSEIF GetP(i, ""Align"") = ""right"" THEN" + NL
    t = t + "                design.Text(x + MATH.Max(0, w - s.Length * CHARW), y + 2, s)" + NL
    t = t + "            ELSE" + NL
    t = t + "                design.Text(x, y + 2, s)" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Button""" + NL
    t = t + "            design.SetColor(7)" + NL
    t = t + "            design.FillRect(x, y, w, h)" + NL
    t = t + "            Bevel(x, y, w, h, TRUE)" + NL
    t = t + "            IF GetB(i, ""Default"") THEN" + NL
    t = t + "                design.SetColor(0)" + NL
    t = t + "                design.Rect(x - 1, y - 1, w + 2, h + 2)" + NL
    t = t + "            END IF" + NL
    t = t + "            s = Fit(s, w - 2)" + NL
    t = t + "            design.SetColor(ink)" + NL
    t = t + "            design.Text(x + MATH.Max(2, Int((w - s.Length * CHARW) / 2)), y + Int((h - 12) / 2), s)" + NL
    t = t + "        CASE ""TextBox""" + NL
    t = t + "            design.SetColor(15)" + NL
    t = t + "            design.FillRect(x, y, w, h)" + NL
    t = t + "            Bevel(x, y, w, h, FALSE)" + NL
    t = t + "            IF GetB(i, ""Password"") THEN s = Stars(s.Length)" + NL
    t = t + "            design.SetColor(ink)" + NL
    t = t + "            design.Text(x + 4, y + Int((h - 12) / 2), Fit(s, w - 8))" + NL
    t = t + "        CASE ""TextArea""" + NL
    t = t + "            design.SetColor(15)" + NL
    t = t + "            design.FillRect(x, y, w, h)" + NL
    t = t + "            Bevel(x, y, w, h, FALSE)" + NL
    t = t + "            design.SetColor(7)" + NL
    t = t + "            design.FillRect(x + w - 15, y + 1, 14, h - 2)" + NL
    t = t + "            design.SetColor(ink)" + NL
    t = t + "            design.Text(x + 4, y + 4, Fit(s, w - 22))" + NL
    t = t + "        CASE ""CheckBox""" + NL
    t = t + "            design.SetColor(15)" + NL
    t = t + "            design.FillRect(x, y + Int((h - 13) / 2), 13, 13)" + NL
    t = t + "            Bevel(x, y + Int((h - 13) / 2), 13, 13, FALSE)" + NL
    t = t + "            IF GetB(i, ""Checked"") THEN" + NL
    t = t + "                design.SetColor(0)" + NL
    t = t + "                design.Line(x + 3, y + Int((h - 13) / 2) + 3, x + 9, y + Int((h - 13) / 2) + 9)" + NL
    t = t + "                design.Line(x + 9, y + Int((h - 13) / 2) + 3, x + 3, y + Int((h - 13) / 2) + 9)" + NL
    t = t + "            END IF" + NL
    t = t + "            design.SetColor(ink)" + NL
    t = t + "            design.Text(x + 18, y + Int((h - 12) / 2), Fit(s, w - 18))" + NL
    t = t + "        CASE ""RadioButton""" + NL
    t = t + "            design.SetColor(15)" + NL
    t = t + "            design.FillCircle(x + 6, y + Int(h / 2), 6)" + NL
    t = t + "            design.SetColor(8)" + NL
    t = t + "            design.Circle(x + 6, y + Int(h / 2), 6)" + NL
    t = t + "            IF GetB(i, ""Checked"") THEN" + NL
    t = t + "                design.SetColor(0)" + NL
    t = t + "                design.FillCircle(x + 6, y + Int(h / 2), 2)" + NL
    t = t + "            END IF" + NL
    t = t + "            design.SetColor(ink)" + NL
    t = t + "            design.Text(x + 18, y + Int((h - 12) / 2), Fit(s, w - 18))" + NL
    t = t + "        CASE ""ListBox""" + NL
    t = t + "            design.SetColor(15)" + NL
    t = t + "            design.FillRect(x, y, w, h)" + NL
    t = t + "            Bevel(x, y, w, h, FALSE)" + NL
    t = t + "            design.SetColor(ink)" + NL
    t = t + "            k = 0" + NL
    t = t + "            FOR EACH item IN GetP(i, ""Items"").Split("";"")" + NL
    t = t + "                IF item.Trim() = """" OR 4 + k * 14 + 12 > h THEN CONTINUE" + NL
    t = t + "                design.Text(x + 4, y + 3 + k * 14, Fit(item.Trim(), w - 8))" + NL
    t = t + "                k = k + 1" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""DropDown""" + NL
    t = t + "            design.SetColor(15)" + NL
    t = t + "            design.FillRect(x, y, w, h)" + NL
    t = t + "            Bevel(x, y, w, h, FALSE)" + NL
    t = t + "            design.SetColor(7)" + NL
    t = t + "            design.FillRect(x + w - 17, y + 2, 15, h - 4)" + NL
    t = t + "            Bevel(x + w - 17, y + 2, 15, h - 4, TRUE)" + NL
    t = t + "            design.SetColor(0)" + NL
    t = t + "            design.Line(x + w - 13, y + Int(h / 2) - 2, x + w - 6, y + Int(h / 2) - 2)" + NL
    t = t + "            design.Line(x + w - 12, y + Int(h / 2) - 1, x + w - 7, y + Int(h / 2) - 1)" + NL
    t = t + "            design.Line(x + w - 11, y + Int(h / 2), x + w - 8, y + Int(h / 2))" + NL
    t = t + "            k = GetN(i, ""Selected"")" + NL
    t = t + "            IF k >= 0 AND k < GetP(i, ""Items"").Split("";"").Count THEN" + NL
    t = t + "                design.SetColor(ink)" + NL
    t = t + "                design.Text(x + 4, y + Int((h - 12) / 2), Fit(GetP(i, ""Items"").Split("";"")[k].Trim(), w - 24))" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""ProgressBar""" + NL
    t = t + "            design.SetColor(7)" + NL
    t = t + "            design.FillRect(x, y, w, h)" + NL
    t = t + "            Bevel(x, y, w, h, FALSE)" + NL
    t = t + "            IF GetN(i, ""Max"") > 0 THEN" + NL
    t = t + "                design.SetColor(4)" + NL
    t = t + "                design.FillRect(x + 2, y + 2, Int((w - 4) * MATH.Min(GetN(i, ""Value""), GetN(i, ""Max"")) / GetN(i, ""Max"")), h - 4)" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Canvas""" + NL
    t = t + "            design.SetColor(MATH.Max(0, MATH.Min(15, GetN(i, ""Background""))))" + NL
    t = t + "            design.FillRect(x, y, w, h)" + NL
    t = t + "            design.SetColor(8)" + NL
    t = t + "            design.Rect(x, y, w, h)" + NL
    t = t + "            design.Text(x + 4, y + 4, Fit(GetP(i, ""Name""), w - 8))" + NL
    t = t + "        CASE ""Timer""" + NL
    t = t + "            design.SetColor(7)" + NL
    t = t + "            design.FillRect(x, y, 24, 24)" + NL
    t = t + "            Bevel(x, y, 24, 24, TRUE)" + NL
    t = t + "            design.SetColor(15)" + NL
    t = t + "            design.FillCircle(x + 12, y + 12, 8)" + NL
    t = t + "            design.SetColor(0)" + NL
    t = t + "            design.Circle(x + 12, y + 12, 8)" + NL
    t = t + "            design.Line(x + 12, y + 12, x + 12, y + 6)" + NL
    t = t + "            design.Line(x + 12, y + 12, x + 16, y + 12)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Which object is at x, y on the designer: a control (the one on top), the" + NL
    t = t + "' form, or -1." + NL
    t = t + "FUNCTION HitAt (x AS Integer, y AS Integer) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR px AS Integer" + NL
    t = t + "    VAR py AS Integer" + NL
    t = t + "    px = x - CX" + NL
    t = t + "    py = y - CY" + NL
    t = t + "    FOR i = kType.Count - 1 TO 1 STEP -1" + NL
    t = t + "        IF kType[i] = ""MenuItem"" THEN CONTINUE" + NL
    t = t + "        IF px >= GetN(i, ""X"") AND py >= GetN(i, ""Y"") AND px < GetN(i, ""X"") + CtlW(i) AND py < GetN(i, ""Y"") + CtlH(i) THEN RETURN i" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF x >= FX AND y >= FY AND x < CX + GetN(0, ""Width"") + 2 AND y < CY + GetN(0, ""Height"") + 2 THEN RETURN 0" + NL
    t = t + "    RETURN -1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Near (x AS Integer, y AS Integer, hx AS Integer, hy AS Integer) AS Bool" + NL
    t = t + "    RETURN Abs(x - hx) <= 4 AND Abs(y - hy) <= 4" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Design_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    Draw()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Design_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    keys.Focus()" + NL
    t = t + "    ' the form's menu bar: a menu's items, to write their code" + NL
    t = t + "    IF tool = """" AND MenuH() > 0 AND y >= FY + 20 AND y < CY - 1 AND x >= CX AND x < CX + GetN(0, ""Width"") THEN" + NL
    t = t + "        i = TopAt(x - CX)" + NL
    t = t + "        IF i < 0 THEN" + NL
    t = t + "            MenuEditor()" + NL
    t = t + "        ELSE" + NL
    t = t + "            ShowMenuPop(i, x, y)" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' the right button: select what's there, and offer its menu" + NL
    t = t + "    IF button = 2 THEN" + NL
    t = t + "        tool = """"" + NL
    t = t + "        toolbox.Selected = 0" + NL
    t = t + "        i = HitAt(x, y)" + NL
    t = t + "        IF i < 0 THEN RETURN" + NL
    t = t + "        SelectObj(i)" + NL
    t = t + "        IF i > 0 THEN" + NL
    t = t + "            ctx.Popup(design.X + x, design.Y + y)" + NL
    t = t + "        ELSE" + NL
    t = t + "            ctxForm.Popup(design.X + x, design.Y + y)" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' (what the form was, in case a drag changes it)" + NL
    t = t + "    dragSnap = Snapshot()" + NL
    t = t + "    dragCode = editor.Text" + NL
    t = t + "    ' drawing a new control" + NL
    t = t + "    IF tool <> """" THEN" + NL
    t = t + "        dragMode = ""new""" + NL
    t = t + "        dragX0 = MATH.Max(0, Snap(x - CX))" + NL
    t = t + "        dragY0 = MATH.Max(0, Snap(y - CY))" + NL
    t = t + "        rx = dragX0" + NL
    t = t + "        ry = dragY0" + NL
    t = t + "        rw = 0" + NL
    t = t + "        rh = 0" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' the selected control's handle: sizing it" + NL
    t = t + "    IF sel > 0 AND sel < kType.Count THEN" + NL
    t = t + "        IF kType[sel] <> ""Timer"" AND Near(x, y, CX + GetN(sel, ""X"") + CtlW(sel), CY + GetN(sel, ""Y"") + CtlH(sel)) THEN" + NL
    t = t + "            dragMode = ""size""" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    ' the form's handle: sizing the form" + NL
    t = t + "    IF Near(x, y, CX + GetN(0, ""Width""), CY + GetN(0, ""Height"")) THEN" + NL
    t = t + "        SelectObj(0)" + NL
    t = t + "        dragMode = ""form""" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    i = HitAt(x, y)" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    ' a second click on the same thing, quickly: its code" + NL
    t = t + "    IF i = lastDownIdx AND lastDown <> 0 AND SYS.Ticks - lastDown < 450 THEN" + NL
    t = t + "        lastDown = 0" + NL
    t = t + "        OpenHandler(i, Events(kType[i])[0])" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    lastDown = SYS.Ticks" + NL
    t = t + "    lastDownIdx = i" + NL
    t = t + "    SelectObj(i)" + NL
    t = t + "    IF i > 0 THEN" + NL
    t = t + "        dragMode = ""move""" + NL
    t = t + "        dragOX = x - CX - GetN(i, ""X"")" + NL
    t = t + "        dragOY = y - CY - GetN(i, ""Y"")" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Design_OnMouseMove (x AS Integer, y AS Integer)" + NL
    t = t + "    VAR nx AS Integer" + NL
    t = t + "    VAR ny AS Integer" + NL
    t = t + "    SELECT CASE dragMode" + NL
    t = t + "        CASE ""new""" + NL
    t = t + "            nx = MATH.Max(0, Snap(x - CX))" + NL
    t = t + "            ny = MATH.Max(0, Snap(y - CY))" + NL
    t = t + "            rx = MATH.Min(dragX0, nx)" + NL
    t = t + "            ry = MATH.Min(dragY0, ny)" + NL
    t = t + "            rw = Int(Abs(nx - dragX0))" + NL
    t = t + "            rh = Int(Abs(ny - dragY0))" + NL
    t = t + "            Draw()" + NL
    t = t + "        CASE ""move""" + NL
    t = t + "            nx = MATH.Max(0, Snap(x - CX - dragOX))" + NL
    t = t + "            ny = MATH.Max(0, Snap(y - CY - dragOY))" + NL
    t = t + "            IF nx <> GetN(sel, ""X"") OR ny <> GetN(sel, ""Y"") THEN" + NL
    t = t + "                SetP(sel, ""X"", Str(nx))" + NL
    t = t + "                SetP(sel, ""Y"", Str(ny))" + NL
    t = t + "                Draw()" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""size""" + NL
    t = t + "            nx = MATH.Max(GRID, Snap(x - CX - GetN(sel, ""X"")))" + NL
    t = t + "            ny = MATH.Max(GRID, Snap(y - CY - GetN(sel, ""Y"")))" + NL
    t = t + "            IF nx <> GetN(sel, ""Width"") OR ny <> GetN(sel, ""Height"") THEN" + NL
    t = t + "                SetP(sel, ""Width"", Str(nx))" + NL
    t = t + "                SetP(sel, ""Height"", Str(ny))" + NL
    t = t + "                Draw()" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""form""" + NL
    t = t + "            nx = MATH.Max(64, Snap(x - CX))" + NL
    t = t + "            ny = MATH.Max(32, Snap(y - CY))" + NL
    t = t + "            IF nx <> GetN(0, ""Width"") OR ny <> GetN(0, ""Height"") THEN" + NL
    t = t + "                FollowForm(nx - GetN(0, ""Width""), ny - GetN(0, ""Height""))" + NL
    t = t + "                SetP(0, ""Width"", Str(nx))" + NL
    t = t + "                SetP(0, ""Height"", Str(ny))" + NL
    t = t + "                Draw()" + NL
    t = t + "            END IF" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Design_OnMouseUp (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR mode AS String" + NL
    t = t + "    mode = dragMode" + NL
    t = t + "    dragMode = """"" + NL
    t = t + "    IF mode <> """" AND dragSnap <> """" AND Snapshot() <> dragSnap THEN" + NL
    t = t + "        PushUndo(dragSnap, dragCode)" + NL
    t = t + "        dragSnap = """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF mode = ""new"" THEN" + NL
    t = t + "        ' a click, not a drag: the control's usual size" + NL
    t = t + "        IF rw < GRID OR rh < GRID THEN" + NL
    t = t + "            rw = DefaultW(tool)" + NL
    t = t + "            rh = DefaultH(tool)" + NL
    t = t + "        END IF" + NL
    t = t + "        PushUndo(dragSnap, dragCode)" + NL
    t = t + "        dragSnap = """"" + NL
    t = t + "        i = AddControl(tool, rx, ry, rw, rh)" + NL
    t = t + "        Did()" + NL
    t = t + "        tool = """"" + NL
    t = t + "        toolbox.Selected = 0" + NL
    t = t + "        FillObjects()" + NL
    t = t + "        SelectObj(i)" + NL
    t = t + "        win.Status = GetP(i, ""Name"") + "" is on the form. Double-click it to write its code.""" + NL
    t = t + "    ELSEIF mode <> """" THEN" + NL
    t = t + "        FillProps()" + NL
    t = t + "        Draw()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Design_OnKey (key AS String)" + NL
    t = t + "    VAR dx AS Integer" + NL
    t = t + "    VAR dy AS Integer" + NL
    t = t + "    VAR dw AS Integer" + NL
    t = t + "    VAR dh AS Integer" + NL
    t = t + "    IF NOT Movable(sel) THEN RETURN" + NL
    t = t + "    SELECT CASE key" + NL
    t = t + "        CASE ""Delete""" + NL
    t = t + "            DeleteSelected()" + NL
    t = t + "            RETURN" + NL
    t = t + "        CASE ""ArrowLeft""" + NL
    t = t + "            dx = -GRID" + NL
    t = t + "        CASE ""ArrowRight""" + NL
    t = t + "            dx = GRID" + NL
    t = t + "        CASE ""ArrowUp""" + NL
    t = t + "            dy = -GRID" + NL
    t = t + "        CASE ""ArrowDown""" + NL
    t = t + "            dy = GRID" + NL
    t = t + "        CASE ""Shift+ArrowLeft""" + NL
    t = t + "            dw = -GRID" + NL
    t = t + "        CASE ""Shift+ArrowRight""" + NL
    t = t + "            dw = GRID" + NL
    t = t + "        CASE ""Shift+ArrowUp""" + NL
    t = t + "            dh = -GRID" + NL
    t = t + "        CASE ""Shift+ArrowDown""" + NL
    t = t + "            dh = GRID" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            RETURN" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF (dw <> 0 OR dh <> 0) AND kType[sel] = ""Timer"" THEN RETURN" + NL
    t = t + "    Remember()" + NL
    t = t + "    IF dx <> 0 OR dy <> 0 THEN" + NL
    t = t + "        SetP(sel, ""X"", Str(MATH.Max(0, GetN(sel, ""X"") + dx)))" + NL
    t = t + "        SetP(sel, ""Y"", Str(MATH.Max(0, GetN(sel, ""Y"") + dy)))" + NL
    t = t + "    ELSE" + NL
    t = t + "        SetP(sel, ""Width"", Str(MATH.Max(GRID, GetN(sel, ""Width"") + dw)))" + NL
    t = t + "        SetP(sel, ""Height"", Str(MATH.Max(GRID, GetN(sel, ""Height"") + dh)))" + NL
    t = t + "    END IF" + NL
    t = t + "    Did()" + NL
    t = t + "    FillProps()" + NL
    t = t + "    Draw()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DeleteSelected ()" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    IF sel <= 0 OR sel >= kType.Count THEN RETURN" + NL
    t = t + "    Remember()" + NL
    t = t + "    name = GetP(sel, ""Name"")" + NL
    t = t + "    kType.RemoveAt(sel)" + NL
    t = t + "    kProps.RemoveAt(sel)" + NL
    t = t + "    Did()" + NL
    t = t + "    FillObjects()" + NL
    t = t + "    SelectObj(0)" + NL
    t = t + "    win.Status = name + "" is gone from the form. (Its code is still there: delete that too, or it won't run.)""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SelectObj (i AS Integer)" + NL
    t = t + "    IF i < 0 OR i >= kType.Count THEN RETURN" + NL
    t = t + "    sel = i" + NL
    t = t + "    propDel.Enabled = i > 0" + NL
    t = t + "    IF propObj.Selected <> i THEN propObj.Selected = i" + NL
    t = t + "    FillProps()" + NL
    t = t + "    Draw()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB PropDel_OnClick ()" + NL
    t = t + "    DeleteSelected()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Ctx_OnSelect (item AS String)" + NL
    t = t + "    ' (a popup menu leaves the keyboard nowhere: back to the designer)" + NL
    t = t + "    keys.Focus()" + NL
    t = t + "    IF sel <= 0 OR sel >= kType.Count THEN RETURN" + NL
    t = t + "    IF item = ""View Code"" THEN" + NL
    t = t + "        OpenHandler(sel, Events(kType[sel])[0])" + NL
    t = t + "    ELSE" + NL
    t = t + "        EditCmd(item)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB CtxForm_OnSelect (item AS String)" + NL
    t = t + "    keys.Focus()" + NL
    t = t + "    SELECT CASE item" + NL
    t = t + "        CASE ""View Code""" + NL
    t = t + "            OpenHandler(0, ""Load"")" + NL
    t = t + "        CASE ""Paste""" + NL
    t = t + "            EditCmd(""Paste"")" + NL
    t = t + "        CASE ""Menu Editor...""" + NL
    t = t + "            MenuEditor()" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Toolbox_OnSelect ()" + NL
    t = t + "    IF toolbox.Selected <= 0 THEN" + NL
    t = t + "        tool = """"" + NL
    t = t + "    ELSE" + NL
    t = t + "        tool = toolbox.Get(toolbox.Selected)" + NL
    t = t + "        win.Status = ""Drag on the form where the "" + tool + "" goes.""" + NL
    t = t + "        IF codeView OR layoutView THEN ShowForm()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Double-click: one dropped on the form, a little below the last." + NL
    t = t + "SUB Toolbox_OnDblClick ()" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    IF toolbox.Selected <= 0 THEN RETURN" + NL
    t = t + "    t = toolbox.Get(toolbox.Selected)" + NL
    t = t + "    at = 8 + ((kType.Count - 1) MOD 8) * 16" + NL
    t = t + "    Remember()" + NL
    t = t + "    i = AddControl(t, at, at, DefaultW(t), DefaultH(t))" + NL
    t = t + "    Did()" + NL
    t = t + "    tool = """"" + NL
    t = t + "    toolbox.Selected = 0" + NL
    t = t + "    FillObjects()" + NL
    t = t + "    IF codeView OR layoutView THEN ShowForm()" + NL
    t = t + "    SelectObj(i)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ properties" + NL
    t = t + "" + NL
    t = t + "FUNCTION ObjLabel (i AS Integer) AS String" + NL
    t = t + "    IF kType[i] = ""MenuItem"" THEN RETURN GetP(i, ""Name"") + ""  (Menu: "" + Plain(GetP(i, ""Caption"")) + "")""" + NL
    t = t + "    RETURN GetP(i, ""Name"") + ""  ("" + kType[i] + "")""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB FillObjects ()" + NL
    t = t + "    VAR names AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO kType.Count - 1" + NL
    t = t + "        names.Add(ObjLabel(i))" + NL
    t = t + "    NEXT" + NL
    t = t + "    propObj.Items = names" + NL
    t = t + "    propObj.Selected = sel" + NL
    t = t + "    objList.Items = names" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB FillProps ()" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR keep AS Integer" + NL
    t = t + "    IF sel < 0 OR sel >= kType.Count THEN RETURN" + NL
    t = t + "    keep = propList.Selected" + NL
    t = t + "    propKeys.Clear()" + NL
    t = t + "    FOR EACH e IN Props(kType[sel])" + NL
    t = t + "        key = e.Split(""|"")[0]" + NL
    t = t + "        propKeys.Add(key)" + NL
    t = t + "        lines.Add(key.PadRight(11) + GetP(sel, key))" + NL
    t = t + "    NEXT" + NL
    t = t + "    propList.Items = lines" + NL
    t = t + "    IF keep >= 0 AND keep < lines.Count THEN propList.Selected = keep" + NL
    t = t + "    IF propObj.Selected <> sel THEN propObj.Selected = sel" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB PropObj_OnSelect ()" + NL
    t = t + "    IF propObj.Selected >= 0 AND propObj.Selected <> sel THEN SelectObj(propObj.Selected)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB PropList_OnSelect ()" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    IF propList.Selected < 0 OR propList.Selected >= propKeys.Count THEN RETURN" + NL
    t = t + "    key = propKeys[propList.Selected]" + NL
    t = t + "    kind = PropKind(kType[sel], key)" + NL
    t = t + "    propEdit.Text = GetP(sel, key)" + NL
    t = t + "    IF kind = ""bool"" THEN" + NL
    t = t + "        propHelp.Text = key + "": TRUE or FALSE. Double-click it to switch.""" + NL
    t = t + "    ELSEIF kind.StartsWith(""choice:"") THEN" + NL
    t = t + "        propHelp.Text = key + "": one of "" + kind.Substring(7, kind.Length - 7).Replace("","", "", "") + "". Double-click it for the next.""" + NL
    t = t + "    ELSEIF kind = ""items"" THEN" + NL
    t = t + "        propHelp.Text = key + "": the items, with ; between them. Type them and press Enter.""" + NL
    t = t + "    ELSEIF kind = ""color"" THEN" + NL
    t = t + "        propHelp.Text = key + "": a colour, 0-15: 0 black, 4 navy, 7 silver, 9 red, 10 lime, 11 yellow, 12 blue, 15 white.""" + NL
    t = t + "    ELSEIF kind = ""name"" THEN" + NL
    t = t + "        propHelp.Text = ""Name: what the code calls it. Letters, digits and _, starting with a letter.""" + NL
    t = t + "    ELSEIF kind = ""anchor"" THEN" + NL
    t = t + "        propHelp.Text = ""Anchor: the window edges it keeps its distance to when the window is resized: Top, Bottom, Left, Right. Left,Right stretches it across. Double-click for the usual ones.""" + NL
    t = t + "    ELSEIF kind = ""shortcut"" THEN" + NL
    t = t + "        propHelp.Text = ""Shortcut: keys that choose this item, like Ctrl+O or F3. Empty for none.""" + NL
    t = t + "    ELSEIF key = ""Level"" THEN" + NL
    t = t + "        propHelp.Text = ""Level: 0 for a menu on the bar, 1 for an item in the menu above it.""" + NL
    t = t + "    ELSEIF key = ""Caption"" THEN" + NL
    t = t + "        propHelp.Text = ""Caption: what the menu shows. & before a letter underlines it; - alone is a line between items.""" + NL
    t = t + "    ELSE" + NL
    t = t + "        propHelp.Text = key + "": type it and press Enter.""" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB PropList_OnDblClick ()" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR opts AS Array OF String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF propList.Selected < 0 OR propList.Selected >= propKeys.Count THEN RETURN" + NL
    t = t + "    key = propKeys[propList.Selected]" + NL
    t = t + "    kind = PropKind(kType[sel], key)" + NL
    t = t + "    IF kind = ""bool"" THEN" + NL
    t = t + "        IF GetB(sel, key) THEN" + NL
    t = t + "            Apply(key, ""FALSE"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            Apply(key, ""TRUE"")" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSEIF kind.StartsWith(""choice:"") THEN" + NL
    t = t + "        opts = kind.Substring(7, kind.Length - 7).Split("","")" + NL
    t = t + "        k = opts.IndexOf(GetP(sel, key))" + NL
    t = t + "        Apply(key, opts[(k + 1) MOD opts.Count])" + NL
    t = t + "    ELSEIF kind = ""anchor"" THEN" + NL
    t = t + "        opts = [""Top,Left"", ""Top,Right"", ""Bottom,Left"", ""Bottom,Right"", ""Top,Left,Right"", ""Bottom,Left,Right"", ""Top,Bottom,Left"", ""Top,Bottom,Right"", ""Top,Bottom,Left,Right""]" + NL
    t = t + "        k = opts.IndexOf(GetP(sel, key))" + NL
    t = t + "        Apply(key, opts[(k + 1) MOD opts.Count])" + NL
    t = t + "    ELSE" + NL
    t = t + "        propEdit.Focus()" + NL
    t = t + "        propEdit.SelectAll()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB PropEdit_OnEnter ()" + NL
    t = t + "    IF propList.Selected < 0 OR propList.Selected >= propKeys.Count THEN RETURN" + NL
    t = t + "    Apply(propKeys[propList.Selected], propEdit.Text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A property set by hand, checked first." + NL
    t = t + "SUB Apply (key AS String, value AS String)" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR old AS String" + NL
    t = t + "    VAR opts AS Array OF String" + NL
    t = t + "    VAR noted AS Bool" + NL
    t = t + "    kind = PropKind(kType[sel], key)" + NL
    t = t + "    value = value.Replace(Chr(13), """").Replace(Chr(10), "" "")" + NL
    t = t + "    IF kind = ""name"" THEN" + NL
    t = t + "        value = value.Trim()" + NL
    t = t + "        IF NOT IsIdent(value) THEN" + NL
    t = t + "            Say(Q + value + Q + "" can't be a name: use letters, digits and _, starting with a letter."", ""warn"")" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        IF NameTaken(value, sel) THEN" + NL
    t = t + "            Say(""Something else is already called "" + value + ""."", ""warn"")" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        old = GetP(sel, ""Name"")" + NL
    t = t + "        Remember()" + NL
    t = t + "        noted = TRUE" + NL
    t = t + "        IF old <> value THEN editor.Text = Renamed(editor.Text, old, value)" + NL
    t = t + "    ELSEIF kind = ""anchor"" THEN" + NL
    t = t + "        value = Anchors(value)" + NL
    t = t + "    ELSEIF kind = ""shortcut"" THEN" + NL
    t = t + "        value = value.Trim()" + NL
    t = t + "        IF NOT ShortcutOk(value) THEN" + NL
    t = t + "            Say(Q + value + Q + "" isn't a shortcut SIM95 knows. Use Ctrl+ a letter or digit (Ctrl+Shift+ too), or F1 to F12."", ""warn"")" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSEIF kind = ""int"" THEN" + NL
    t = t + "        value = Str(Int(Val(value)))" + NL
    t = t + "        IF key = ""Level"" THEN value = Str(MATH.Max(0, MATH.Min(1, Val(value))))" + NL
    t = t + "        IF (key = ""X"" OR key = ""Y"") AND Val(value) < 0 THEN value = ""0""" + NL
    t = t + "        IF (key = ""Width"" OR key = ""Height"") AND Val(value) < GRID THEN value = Str(GRID)" + NL
    t = t + "    ELSEIF kind = ""bool"" THEN" + NL
    t = t + "        IF value.Trim().Upper().StartsWith(""T"") OR value.Trim().Upper().StartsWith(""Y"") OR value.Trim() = ""1"" THEN" + NL
    t = t + "            value = ""TRUE""" + NL
    t = t + "        ELSE" + NL
    t = t + "            value = ""FALSE""" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSEIF kind = ""color"" THEN" + NL
    t = t + "        value = Str(MATH.Max(0, MATH.Min(15, Int(Val(value)))))" + NL
    t = t + "    ELSEIF kind.StartsWith(""choice:"") THEN" + NL
    t = t + "        opts = kind.Substring(7, kind.Length - 7).Split("","")" + NL
    t = t + "        IF NOT opts.Contains(value.Trim().Lower()) THEN" + NL
    t = t + "            Say(key + "" is one of: "" + opts.Join("", "") + ""."", ""warn"")" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        value = value.Trim().Lower()" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT noted THEN Remember()" + NL
    t = t + "    IF sel = 0 AND key = ""Width"" THEN FollowForm(Int(Val(value)) - GetN(0, ""Width""), 0)" + NL
    t = t + "    IF sel = 0 AND key = ""Height"" THEN FollowForm(0, Int(Val(value)) - GetN(0, ""Height""))" + NL
    t = t + "    SetP(sel, key, value)" + NL
    t = t + "    Did()" + NL
    t = t + "    IF kind = ""name"" OR key = ""Caption"" THEN FillObjects()" + NL
    t = t + "    FillProps()" + NL
    t = t + "    PropList_OnSelect()" + NL
    t = t + "    Draw()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsIdent (s AS String) AS Bool" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    IF s = """" OR s.Length > 30 THEN RETURN FALSE" + NL
    t = t + "    FOR k = 0 TO s.Length - 1" + NL
    t = t + "        c = Asc(s.CharAt(k).Upper())" + NL
    t = t + "        IF c >= 65 AND c <= 90 THEN CONTINUE" + NL
    t = t + "        IF k > 0 AND ((c >= 48 AND c <= 57) OR c = 95) THEN CONTINUE" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsIdentChar (ch AS String) AS Bool" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    c = Asc(ch.Upper())" + NL
    t = t + "    RETURN (c >= 65 AND c <= 90) OR (c >= 48 AND c <= 57) OR c = 95" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The code with a control's old name changed to its new one wherever it is" + NL
    t = t + "' the control: Old.Text, and its SUBs, Old_OnClick (not inside other words)." + NL
    t = t + "FUNCTION Renamed (code AS String, old AS String, name AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR after AS String" + NL
    t = t + "    VAR before AS String" + NL
    t = t + "    rest = code" + NL
    t = t + "    WHILE rest <> """"" + NL
    t = t + "        k = rest.IndexOf(old)" + NL
    t = t + "        IF k < 0 THEN" + NL
    t = t + "            out = out + rest" + NL
    t = t + "            rest = """"" + NL
    t = t + "        ELSE" + NL
    t = t + "            before = """"" + NL
    t = t + "            IF k > 0 THEN before = rest.CharAt(k - 1)" + NL
    t = t + "            IF k = 0 AND out <> """" THEN before = out.CharAt(out.Length - 1)" + NL
    t = t + "            after = """"" + NL
    t = t + "            IF k + old.Length < rest.Length THEN after = rest.CharAt(k + old.Length)" + NL
    t = t + "            IF (before = """" OR NOT IsIdentChar(before)) AND (after = ""."" OR (after = ""_"" AND rest.Substring(k + old.Length, MATH.Min(3, rest.Length - k - old.Length)) = ""_On"")) THEN" + NL
    t = t + "                out = out + rest.Substring(0, k) + name" + NL
    t = t + "            ELSE" + NL
    t = t + "                out = out + rest.Substring(0, k + old.Length)" + NL
    t = t + "            END IF" + NL
    t = t + "            rest = rest.Substring(k + old.Length, rest.Length - k - old.Length)" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the code window" + NL
    t = t + "" + NL
    t = t + "SUB ShowForm ()" + NL
    t = t + "    IF NOT LeaveLayout() THEN RETURN" + NL
    t = t + "    codeView = FALSE" + NL
    t = t + "    editor.Visible = FALSE" + NL
    t = t + "    objList.Visible = FALSE" + NL
    t = t + "    evtList.Visible = FALSE" + NL
    t = t + "    design.Visible = TRUE" + NL
    t = t + "    keys.Visible = TRUE" + NL
    t = t + "    formBtn.Enabled = FALSE" + NL
    t = t + "    codeBtn.Enabled = TRUE" + NL
    t = t + "    layBtn.Enabled = TRUE" + NL
    t = t + "    Draw()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ShowCode ()" + NL
    t = t + "    IF NOT LeaveLayout() THEN RETURN" + NL
    t = t + "    codeView = TRUE" + NL
    t = t + "    design.Visible = FALSE" + NL
    t = t + "    keys.Visible = FALSE" + NL
    t = t + "    editor.Visible = TRUE" + NL
    t = t + "    objList.Visible = TRUE" + NL
    t = t + "    evtList.Visible = TRUE" + NL
    t = t + "    formBtn.Enabled = TRUE" + NL
    t = t + "    codeBtn.Enabled = FALSE" + NL
    t = t + "    layBtn.Enabled = TRUE" + NL
    t = t + "    tool = """"" + NL
    t = t + "    toolbox.Selected = 0" + NL
    t = t + "    FillObjects()" + NL
    t = t + "    IF objList.Selected <> sel THEN objList.Selected = sel" + NL
    t = t + "    FillEvents(sel)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The events of object i, with ""(code)"" after those that have a SUB." + NL
    t = t + "SUB FillEvents (i AS Integer)" + NL
    t = t + "    VAR names AS Array OF String" + NL
    t = t + "    VAR evt AS String" + NL
    t = t + "    VAR subs AS String" + NL
    t = t + "    IF i < 0 OR i >= kType.Count THEN RETURN" + NL
    t = t + "    subs = SubNames()" + NL
    t = t + "    evtNames.Clear()" + NL
    t = t + "    FOR EACH evt IN Events(kType[i])" + NL
    t = t + "        evtNames.Add(evt)" + NL
    t = t + "        IF subs.Contains("","" + HandlerOf(i, evt).Upper() + "","") THEN" + NL
    t = t + "            names.Add(evt + ""  (code)"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            names.Add(evt)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    evtList.Items = names" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ObjList_OnSelect ()" + NL
    t = t + "    IF objList.Selected < 0 THEN RETURN" + NL
    t = t + "    FillEvents(objList.Selected)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB EvtList_OnSelect ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = objList.Selected" + NL
    t = t + "    IF i < 0 OR i >= kType.Count OR evtList.Selected < 0 OR evtList.Selected >= evtNames.Count THEN RETURN" + NL
    t = t + "    OpenHandler(i, evtNames[evtList.Selected])" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The SUB for object i's event: there already, or written from its template." + NL
    t = t + "SUB OpenHandler (i AS Integer, evt AS String)" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    name = HandlerOf(i, evt)" + NL
    t = t + "    line = FindSub(name)" + NL
    t = t + "    IF line = 0 THEN" + NL
    t = t + "        editor.Text = Trimmed(editor.Text) + EOL + EOL + ""SUB "" + name + "" ("" + Params(evt) + "")"" + EOL + Body(i, evt) + EOL + ""END SUB"" + EOL" + NL
    t = t + "        line = FindSub(name)" + NL
    t = t + "        win.Status = name + "" is new: write what happens there.""" + NL
    t = t + "    END IF" + NL
    t = t + "    sel = i" + NL
    t = t + "    IF NOT codeView THEN ShowCode()" + NL
    t = t + "    IF objList.Selected <> i THEN objList.Selected = i" + NL
    t = t + "    FillEvents(i)" + NL
    t = t + "    editor.GotoLine(line + 1)" + NL
    t = t + "    editor.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Insert menu: a piece of code at the cursor." + NL
    t = t + "SUB Snippet (which AS String)" + NL
    t = t + "    VAR form AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR I4 AS String" + NL
    t = t + "    form = GetP(0, ""Name"")" + NL
    t = t + "    I4 = EOL + ""    """ + NL
    t = t + "    SELECT CASE which" + NL
    t = t + "        CASE ""Message Box""" + NL
    t = t + "            s = ""VAR box AS GUI_MessageBox"" + I4 + ""box = GUI_MessageBox.New("" + form + "")"" + I4 + ""box.Title = "" + Lit(""Hello"") + I4 + ""box.Text = "" + Lit(""Hello from Visual SPARK!"") + I4 + ""box.Show()""" + NL
    t = t + "        CASE ""Yes or No Question""" + NL
    t = t + "            s = ""VAR ask AS GUI_MessageBox"" + I4 + ""ask = GUI_MessageBox.New("" + form + "")"" + I4 + ""ask.Kind = "" + Lit(""confirm"") + I4 + ""ask.Buttons = "" + Lit(""yesno"") + I4 + ""ask.Text = "" + Lit(""Are you sure?"") + I4 + ""IF ask.Show() THEN"" + I4 + ""    ' they said yes"" + I4 + ""END IF""" + NL
    t = t + "        CASE ""Open a File""" + NL
    t = t + "            s = ""VAR openDlg AS GUI_FileDialog"" + I4 + ""VAR chosen AS String"" + I4 + ""openDlg = GUI_FileDialog.New("" + form + "")"" + I4 + ""openDlg.Path = "" + Lit(""C:\MYFILES"") + I4 + ""chosen = openDlg.ShowOpen()"" + I4 + ""IF chosen <> "" + Q + Q + "" THEN"" + I4 + ""    ' the file's text: FS.Read(chosen)"" + I4 + ""END IF""" + NL
    t = t + "        CASE ""Save a File""" + NL
    t = t + "            s = ""VAR saveDlg AS GUI_FileDialog"" + I4 + ""VAR target AS String"" + I4 + ""saveDlg = GUI_FileDialog.New("" + form + "")"" + I4 + ""saveDlg.Path = "" + Lit(""C:\MYFILES"") + I4 + ""target = saveDlg.ShowSave()"" + I4 + ""IF target <> "" + Q + Q + "" THEN FS.Write(target, "" + Lit(""what to save"") + "")""" + NL
    t = t + "        CASE ""Random Number""" + NL
    t = t + "            s = ""' a whole number from 1 to 6, like a die"" + I4 + ""VAR roll AS Integer"" + I4 + ""roll = 1 + Rnd(6)""" + NL
    t = t + "        CASE ""Run a Program""" + NL
    t = t + "            s = ""SYS.Run("" + Lit(""C:\PROGRAMS\NOTES.SPK"") + "")""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF s = """" THEN RETURN" + NL
    t = t + "    IF NOT codeView THEN ShowCode()" + NL
    t = t + "    IF NOT codeView THEN RETURN" + NL
    t = t + "    ' (whole lines, at the start of the cursor's line, inside a SUB)" + NL
    t = t + "    editor.Insert(""    "" + s + EOL)" + NL
    t = t + "    editor.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ undo, the clipboard, order" + NL
    t = t + "" + NL
    t = t + "' A control on the form (not the form itself, nor a menu item)." + NL
    t = t + "FUNCTION Movable (i AS Integer) AS Bool" + NL
    t = t + "    IF i <= 0 OR i >= kType.Count THEN RETURN FALSE" + NL
    t = t + "    RETURN kType[i] <> ""MenuItem""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The whole form, as one string, and back." + NL
    t = t + "FUNCTION Snapshot () AS String" + NL
    t = t + "    RETURN kType.Join(Chr(1)) + Chr(2) + kProps.Join(Chr(1))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB LoadSnap (snap AS String)" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    parts = snap.Split(Chr(2))" + NL
    t = t + "    kType = parts[0].Split(Chr(1))" + NL
    t = t + "    kProps = parts[1].Split(Chr(1))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB PushUndo (snap AS String, code AS String)" + NL
    t = t + "    IF snap = """" THEN RETURN" + NL
    t = t + "    undoModel.Add(snap)" + NL
    t = t + "    undoCode.Add(code)" + NL
    t = t + "    IF undoModel.Count > 100 THEN" + NL
    t = t + "        undoModel.RemoveAt(0)" + NL
    t = t + "        undoCode.RemoveAt(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    redoModel.Clear()" + NL
    t = t + "    redoCode.Clear()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Before a change on the form: how to get back." + NL
    t = t + "SUB Remember ()" + NL
    t = t + "    PushUndo(Snapshot(), editor.Text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' After a change on the form: the code as it left it. (Undo puts the code" + NL
    t = t + "' back too, as a rename changed it, but not once it has been edited since:" + NL
    t = t + "' the code has its own undo.)" + NL
    t = t + "SUB Did ()" + NL
    t = t + "    lastCode = editor.Text" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Revert (snap AS String, code AS String)" + NL
    t = t + "    IF editor.Text = lastCode THEN editor.Text = code" + NL
    t = t + "    LoadSnap(snap)" + NL
    t = t + "    lastCode = editor.Text" + NL
    t = t + "    IF sel >= kType.Count THEN sel = 0" + NL
    t = t + "    FillObjects()" + NL
    t = t + "    SelectObj(sel)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DoUndo ()" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    k = undoModel.Count - 1" + NL
    t = t + "    IF k < 0 THEN" + NL
    t = t + "        win.Status = ""Nothing to undo.""" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    redoModel.Add(Snapshot())" + NL
    t = t + "    redoCode.Add(editor.Text)" + NL
    t = t + "    Revert(undoModel[k], undoCode[k])" + NL
    t = t + "    undoModel.RemoveAt(k)" + NL
    t = t + "    undoCode.RemoveAt(k)" + NL
    t = t + "    win.Status = ""Undone. (Ctrl+Y does it again.)""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DoRedo ()" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    k = redoModel.Count - 1" + NL
    t = t + "    IF k < 0 THEN" + NL
    t = t + "        win.Status = ""Nothing to redo.""" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    undoModel.Add(Snapshot())" + NL
    t = t + "    undoCode.Add(editor.Text)" + NL
    t = t + "    Revert(redoModel[k], redoCode[k])" + NL
    t = t + "    redoModel.RemoveAt(k)" + NL
    t = t + "    redoCode.RemoveAt(k)" + NL
    t = t + "    win.Status = ""Done again.""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The Edit menu, on the form. (In the code, the editor has its own.)" + NL
    t = t + "SUB EditCmd (item AS String)" + NL
    t = t + "    VAR keepType AS String" + NL
    t = t + "    VAR keepProps AS String" + NL
    t = t + "    IF codeView OR layoutView THEN" + NL
    t = t + "        win.Status = ""In the code, use Ctrl+Z, Ctrl+Y, Ctrl+X, Ctrl+C and Ctrl+V. (The Edit menu works on the form.)""" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE item" + NL
    t = t + "        CASE ""Undo""" + NL
    t = t + "            DoUndo()" + NL
    t = t + "        CASE ""Redo""" + NL
    t = t + "            DoRedo()" + NL
    t = t + "        CASE ""Paste""" + NL
    t = t + "            PasteCtl()" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            IF NOT Movable(sel) THEN" + NL
    t = t + "                win.Status = ""Select a control on the form first.""" + NL
    t = t + "                RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "            SELECT CASE item" + NL
    t = t + "                CASE ""Copy""" + NL
    t = t + "                    CopyCtl()" + NL
    t = t + "                CASE ""Cut""" + NL
    t = t + "                    CopyCtl()" + NL
    t = t + "                    DeleteSelected()" + NL
    t = t + "                    win.Status = ""Cut. Ctrl+V pastes it.""" + NL
    t = t + "                CASE ""Duplicate""" + NL
    t = t + "                    keepType = clipType" + NL
    t = t + "                    keepProps = clipProps" + NL
    t = t + "                    CopyCtl()" + NL
    t = t + "                    PasteCtl()" + NL
    t = t + "                    clipType = keepType" + NL
    t = t + "                    clipProps = keepProps" + NL
    t = t + "                CASE ""Delete""" + NL
    t = t + "                    DeleteSelected()" + NL
    t = t + "                CASE ""Bring to Front""" + NL
    t = t + "                    Restack(TRUE)" + NL
    t = t + "                CASE ""Send to Back""" + NL
    t = t + "                    Restack(FALSE)" + NL
    t = t + "            END SELECT" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB CopyCtl ()" + NL
    t = t + "    clipType = kType[sel]" + NL
    t = t + "    clipProps = kProps[sel]" + NL
    t = t + "    win.Status = GetP(sel, ""Name"") + "" is copied. Ctrl+V pastes it.""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The copied control, a little down and to the right, with a name of its own." + NL
    t = t + "SUB PasteCtl ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF clipType = """" THEN" + NL
    t = t + "        win.Status = ""Nothing to paste: copy a control first.""" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    Remember()" + NL
    t = t + "    kType.Add(clipType)" + NL
    t = t + "    kProps.Add(clipProps)" + NL
    t = t + "    i = kType.Count - 1" + NL
    t = t + "    IF NameTaken(GetP(i, ""Name""), i) THEN SetP(i, ""Name"", NextName(clipType))" + NL
    t = t + "    SetP(i, ""X"", Str(GetN(i, ""X"") + GRID * 2))" + NL
    t = t + "    SetP(i, ""Y"", Str(GetN(i, ""Y"") + GRID * 2))" + NL
    t = t + "    ' (so pasting again goes further on)" + NL
    t = t + "    clipProps = kProps[i]" + NL
    t = t + "    Did()" + NL
    t = t + "    FillObjects()" + NL
    t = t + "    SelectObj(i)" + NL
    t = t + "    win.Status = GetP(i, ""Name"") + "" is pasted. (Its code isn't: copy that in the code.)""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' To the front (made last, so drawn over the others) or the back." + NL
    t = t + "SUB Restack (front AS Bool)" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    Remember()" + NL
    t = t + "    t = kType[sel]" + NL
    t = t + "    p = kProps[sel]" + NL
    t = t + "    kType.RemoveAt(sel)" + NL
    t = t + "    kProps.RemoveAt(sel)" + NL
    t = t + "    IF front THEN" + NL
    t = t + "        kType.Add(t)" + NL
    t = t + "        kProps.Add(p)" + NL
    t = t + "        sel = kType.Count - 1" + NL
    t = t + "    ELSE" + NL
    t = t + "        kType.Insert(1, t)" + NL
    t = t + "        kProps.Insert(1, p)" + NL
    t = t + "        sel = 1" + NL
    t = t + "    END IF" + NL
    t = t + "    Did()" + NL
    t = t + "    FillObjects()" + NL
    t = t + "    SelectObj(sel)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ menus on the form" + NL
    t = t + "" + NL
    t = t + "' A caption as the menu reports it: without & (or a shortcut)." + NL
    t = t + "FUNCTION Plain (cap AS String) AS String" + NL
    t = t + "    RETURN cap.Replace(""&"", """")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION HasMenu () AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 1 TO kType.Count - 1" + NL
    t = t + "        IF kType[i] = ""MenuItem"" THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION MenuH () AS Integer" + NL
    t = t + "    IF HasMenu() THEN RETURN MENUBAR" + NL
    t = t + "    RETURN 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a menu's name starts on the bar, from the form's left edge." + NL
    t = t + "FUNCTION BarX (top AS Integer) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    x = 6" + NL
    t = t + "    FOR i = 1 TO top - 1" + NL
    t = t + "        IF kType[i] = ""MenuItem"" AND GetN(i, ""Level"") = 0 THEN x = x + Plain(GetP(i, ""Caption"")).Length * CHARW + 14" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN x" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The menu on the bar at x (from the form's left edge), or -1." + NL
    t = t + "FUNCTION TopAt (x AS Integer) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR bx AS Integer" + NL
    t = t + "    FOR i = 1 TO kType.Count - 1" + NL
    t = t + "        IF kType[i] <> ""MenuItem"" OR GetN(i, ""Level"") <> 0 THEN CONTINUE" + NL
    t = t + "        bx = BarX(i)" + NL
    t = t + "        IF x >= bx - 6 AND x < bx + Plain(GetP(i, ""Caption"")).Length * CHARW + 8 THEN RETURN i" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN -1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A menu of the form, opened on the designer: choosing an item goes to its code." + NL
    t = t + "SUB ShowMenuPop (top AS Integer, x AS Integer, y AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    menuPop.Clear()" + NL
    t = t + "    menuPop.AddMenu(""Menu"")" + NL
    t = t + "    FOR i = top + 1 TO kType.Count - 1" + NL
    t = t + "        IF kType[i] <> ""MenuItem"" THEN CONTINUE" + NL
    t = t + "        IF GetN(i, ""Level"") = 0 THEN BREAK" + NL
    t = t + "        IF GetP(i, ""Caption"") = ""-"" THEN" + NL
    t = t + "            menuPop.AddSeparator(""Menu"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            menuPop.AddItem(""Menu"", GetP(i, ""Caption""))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    menuPop.AddSeparator(""Menu"")" + NL
    t = t + "    menuPop.AddItem(""Menu"", ""Menu Editor..."")" + NL
    t = t + "    menuPopTop = top" + NL
    t = t + "    menuPop.Popup(design.X + x, design.Y + y)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MenuPop_OnSelect (item AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    keys.Focus()" + NL
    t = t + "    IF item = ""Menu Editor..."" THEN" + NL
    t = t + "        MenuEditor()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = menuPopTop + 1 TO kType.Count - 1" + NL
    t = t + "        IF kType[i] <> ""MenuItem"" THEN CONTINUE" + NL
    t = t + "        IF GetN(i, ""Level"") = 0 THEN BREAK" + NL
    t = t + "        IF Plain(GetP(i, ""Caption"")) = item THEN" + NL
    t = t + "            OpenHandler(i, ""onClick"")" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Ctrl+O, Ctrl+Shift+S, Alt+X, F3, Delete: keys a menu can answer to." + NL
    t = t + "FUNCTION ShortcutOk (k AS String) AS Bool" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    IF k = """" OR k = ""Delete"" OR k = ""Insert"" THEN RETURN TRUE" + NL
    t = t + "    IF k.StartsWith(""F"") AND k.Length <= 3 THEN RETURN Val(k.Substring(1, k.Length - 1)) >= 1 AND Val(k.Substring(1, k.Length - 1)) <= 12" + NL
    t = t + "    rest = k" + NL
    t = t + "    IF rest.StartsWith(""Ctrl+"") THEN" + NL
    t = t + "        rest = rest.Substring(5, rest.Length - 5)" + NL
    t = t + "        IF rest.StartsWith(""Shift+"") THEN rest = rest.Substring(6, rest.Length - 6)" + NL
    t = t + "    ELSEIF rest.StartsWith(""Alt+"") THEN" + NL
    t = t + "        rest = rest.Substring(4, rest.Length - 4)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF rest.Length <> 1 THEN RETURN FALSE" + NL
    t = t + "    c = Asc(rest)" + NL
    t = t + "    RETURN (c >= 65 AND c <= 90) OR (c >= 48 AND c <= 57)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A property left out of an object's lines altogether." + NL
    t = t + "SUB DropP (i AS Integer, key AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN kProps[i].Split(EOL)" + NL
    t = t + "        IF NOT line.StartsWith(key + ""="") THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    kProps[i] = out.Join(EOL)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the Menu Editor" + NL
    t = t + "" + NL
    t = t + "' As in Visual BASIC: the form's menus in a list, menus on the bar at the" + NL
    t = t + "' left, their items indented under them." + NL
    t = t + "SUB MenuEditor ()" + NL
    t = t + "    VAR l AS GUI_Label" + NL
    t = t + "    VAR b AS GUI_Button" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR keys AS Array OF String" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    IF codeView OR layoutView THEN ShowForm()" + NL
    t = t + "    IF layoutView THEN RETURN" + NL
    t = t + "    Remember()" + NL
    t = t + "    Did()" + NL
    t = t + "    FOR i = 1 TO kType.Count - 1" + NL
    t = t + "        IF kType[i] = ""MenuItem"" THEN SetP(i, ""Orig"", GetP(i, ""Name""))" + NL
    t = t + "    NEXT" + NL
    t = t + "    meDone = FALSE" + NL
    t = t + "    meWin = GUI_Window.New(""Menu Editor"", 380, 334)" + NL
    t = t + "    meWin.Modal = TRUE" + NL
    t = t + "    meWin.Icon = ""spark""" + NL
    t = t + "    meWin.onClose = Me_Closed" + NL
    t = t + "    l = GUI_Label.New(meWin)" + NL
    t = t + "    l.Text = ""Ca&ption:""" + NL
    t = t + "    l.SetBounds(8, 11, 70, 16)" + NL
    t = t + "    meCap = GUI_TextBox.New(meWin)" + NL
    t = t + "    meCap.SetBounds(80, 8, 210, 21)" + NL
    t = t + "    meCap.onChange = MeCap_OnChange" + NL
    t = t + "    meCap.onEnter = Me_Next" + NL
    t = t + "    l = GUI_Label.New(meWin)" + NL
    t = t + "    l.Text = ""Na&me:""" + NL
    t = t + "    l.SetBounds(8, 37, 70, 16)" + NL
    t = t + "    meName = GUI_TextBox.New(meWin)" + NL
    t = t + "    meName.SetBounds(80, 34, 210, 21)" + NL
    t = t + "    meName.onChange = MeName_OnChange" + NL
    t = t + "    meName.onEnter = Me_Next" + NL
    t = t + "    l = GUI_Label.New(meWin)" + NL
    t = t + "    l.Text = ""&Shortcut:""" + NL
    t = t + "    l.SetBounds(8, 63, 70, 16)" + NL
    t = t + "    meKey = GUI_DropDown.New(meWin)" + NL
    t = t + "    meKey.SetBounds(80, 60, 110, 21)" + NL
    t = t + "    keys.Add(""(none)"")" + NL
    t = t + "    FOR c = 65 TO 90" + NL
    t = t + "        keys.Add(""Ctrl+"" + Chr(c))" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR c = 1 TO 12" + NL
    t = t + "        keys.Add(""F"" + Str(c))" + NL
    t = t + "    NEXT" + NL
    t = t + "    keys.Add(""Delete"")" + NL
    t = t + "    meKey.Items = keys" + NL
    t = t + "    meKey.onSelect = MeKey_OnSelect" + NL
    t = t + "    meChk = GUI_CheckBox.New(meWin)" + NL
    t = t + "    meChk.Text = ""&Checked""" + NL
    t = t + "    meChk.SetBounds(200, 62, 84, 16)" + NL
    t = t + "    meChk.onChange = MeChk_OnChange" + NL
    t = t + "    meEn = GUI_CheckBox.New(meWin)" + NL
    t = t + "    meEn.Text = ""&Enabled""" + NL
    t = t + "    meEn.SetBounds(290, 62, 84, 16)" + NL
    t = t + "    meEn.onChange = MeEn_OnChange" + NL
    t = t + "    b = GUI_Button.New(meWin)" + NL
    t = t + "    b.Text = ""<""" + NL
    t = t + "    b.SetBounds(8, 92, 28, 23)" + NL
    t = t + "    b.onClick = Me_Out" + NL
    t = t + "    b = GUI_Button.New(meWin)" + NL
    t = t + "    b.Text = "">""" + NL
    t = t + "    b.SetBounds(40, 92, 28, 23)" + NL
    t = t + "    b.onClick = Me_In" + NL
    t = t + "    b = GUI_Button.New(meWin)" + NL
    t = t + "    b.Text = ""Up""" + NL
    t = t + "    b.SetBounds(76, 92, 40, 23)" + NL
    t = t + "    b.onClick = Me_Up" + NL
    t = t + "    b = GUI_Button.New(meWin)" + NL
    t = t + "    b.Text = ""Down""" + NL
    t = t + "    b.SetBounds(120, 92, 48, 23)" + NL
    t = t + "    b.onClick = Me_Down" + NL
    t = t + "    b = GUI_Button.New(meWin)" + NL
    t = t + "    b.Text = ""&Next""" + NL
    t = t + "    b.SetBounds(176, 92, 60, 23)" + NL
    t = t + "    b.onClick = Me_Next" + NL
    t = t + "    b = GUI_Button.New(meWin)" + NL
    t = t + "    b.Text = ""&Insert""" + NL
    t = t + "    b.SetBounds(240, 92, 60, 23)" + NL
    t = t + "    b.onClick = Me_Insert" + NL
    t = t + "    b = GUI_Button.New(meWin)" + NL
    t = t + "    b.Text = ""&Delete""" + NL
    t = t + "    b.SetBounds(304, 92, 68, 23)" + NL
    t = t + "    b.onClick = Me_Delete" + NL
    t = t + "    meList = GUI_ListBox.New(meWin)" + NL
    t = t + "    meList.SetBounds(8, 122, 364, 170)" + NL
    t = t + "    meList.Mono = TRUE" + NL
    t = t + "    meList.onSelect = MeList_OnSelect" + NL
    t = t + "    b = GUI_Button.New(meWin)" + NL
    t = t + "    b.Text = ""OK""" + NL
    t = t + "    b.Default = TRUE" + NL
    t = t + "    b.SetBounds(216, 302, 75, 24)" + NL
    t = t + "    b.onClick = Me_Ok" + NL
    t = t + "    b = GUI_Button.New(meWin)" + NL
    t = t + "    b.Text = ""Cancel""" + NL
    t = t + "    b.Cancel = TRUE" + NL
    t = t + "    b.SetBounds(297, 302, 75, 24)" + NL
    t = t + "    b.onClick = Me_Cancel" + NL
    t = t + "    FillMe(-1)" + NL
    t = t + "    IF meIdx.Count > 0 THEN" + NL
    t = t + "        meList.Selected = 0" + NL
    t = t + "        MeShow()" + NL
    t = t + "    END IF" + NL
    t = t + "    meWin.Center()" + NL
    t = t + "    meWin.Show()" + NL
    t = t + "    meCap.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The list, with object k selected (-1: none)." + NL
    t = t + "SUB FillMe (k AS Integer)" + NL
    t = t + "    VAR rows AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    meIdx.Clear()" + NL
    t = t + "    FOR i = 1 TO kType.Count - 1" + NL
    t = t + "        IF kType[i] <> ""MenuItem"" THEN CONTINUE" + NL
    t = t + "        s = GetP(i, ""Caption"")" + NL
    t = t + "        IF GetN(i, ""Level"") > 0 THEN s = ""...."" + s" + NL
    t = t + "        IF GetP(i, ""Shortcut"") <> """" THEN s = s.PadRight(26) + GetP(i, ""Shortcut"")" + NL
    t = t + "        meIdx.Add(i)" + NL
    t = t + "        rows.Add(s)" + NL
    t = t + "    NEXT" + NL
    t = t + "    meList.Items = rows" + NL
    t = t + "    meList.Selected = meIdx.IndexOf(k)" + NL
    t = t + "    MeShow()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION MeCur () AS Integer" + NL
    t = t + "    IF meList.Selected < 0 OR meList.Selected >= meIdx.Count THEN RETURN -1" + NL
    t = t + "    RETURN meIdx[meList.Selected]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The selected item in the boxes." + NL
    t = t + "SUB MeShow ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = MeCur()" + NL
    t = t + "    meBusy = TRUE" + NL
    t = t + "    IF i < 0 THEN" + NL
    t = t + "        meCap.Text = """"" + NL
    t = t + "        meName.Text = """"" + NL
    t = t + "        meKey.Selected = 0" + NL
    t = t + "        meChk.Checked = FALSE" + NL
    t = t + "        meEn.Checked = TRUE" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF meCap.Text <> GetP(i, ""Caption"") THEN meCap.Text = GetP(i, ""Caption"")" + NL
    t = t + "        IF meName.Text <> GetP(i, ""Name"") THEN meName.Text = GetP(i, ""Name"")" + NL
    t = t + "        meKey.Selected = MATH.Max(0, meKey.Items.IndexOf(GetP(i, ""Shortcut"")))" + NL
    t = t + "        meChk.Checked = GetB(i, ""Checked"")" + NL
    t = t + "        meEn.Checked = GetB(i, ""Enabled"")" + NL
    t = t + "    END IF" + NL
    t = t + "    meBusy = FALSE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MeList_OnSelect ()" + NL
    t = t + "    MeShow()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A new, empty item at object index at." + NL
    t = t + "FUNCTION MeNew (at AS Integer, level AS Integer) AS Integer" + NL
    t = t + "    kType.Insert(at, ""MenuItem"")" + NL
    t = t + "    kProps.Insert(at, """")" + NL
    t = t + "    SetP(at, ""Level"", Str(level))" + NL
    t = t + "    SetP(at, ""Caption"", """")" + NL
    t = t + "    SetP(at, ""Name"", """")" + NL
    t = t + "    RETURN at" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The selected item, made if there isn't one yet." + NL
    t = t + "FUNCTION MeItem () AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = MeCur()" + NL
    t = t + "    IF i >= 0 THEN RETURN i" + NL
    t = t + "    i = MeNew(kType.Count, 0)" + NL
    t = t + "    FillMe(i)" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' mnuFile, mnuFileOpen: the menu's name, then the item's, as VB programmers wrote them." + NL
    t = t + "FUNCTION AutoName (i AS Integer, cap AS String) AS String" + NL
    t = t + "    VAR base AS String" + NL
    t = t + "    VAR parentWord AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    IF cap = ""-"" THEN" + NL
    t = t + "        base = ""mnuLine""" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF GetN(i, ""Level"") > 0 THEN" + NL
    t = t + "            FOR k = i - 1 TO 1 STEP -1" + NL
    t = t + "                IF kType[k] = ""MenuItem"" AND GetN(k, ""Level"") = 0 THEN" + NL
    t = t + "                    parentWord = CapWord(GetP(k, ""Caption""))" + NL
    t = t + "                    BREAK" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "        base = ""mnu"" + parentWord + CapWord(cap)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF base = ""mnu"" THEN RETURN """"" + NL
    t = t + "    IF NOT NameTaken(base, i) AND cap <> ""-"" THEN RETURN base" + NL
    t = t + "    n = 1" + NL
    t = t + "    WHILE NameTaken(base + Str(n), i)" + NL
    t = t + "        n = n + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN base + Str(n)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The letters and digits of a caption, starting with a capital: ""&Save As..."" is SaveAs." + NL
    t = t + "FUNCTION CapWord (cap AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR ch AS String" + NL
    t = t + "    FOR k = 0 TO cap.Length - 1" + NL
    t = t + "        ch = cap.CharAt(k)" + NL
    t = t + "        IF IsIdentChar(ch) AND ch <> ""_"" THEN out = out + ch" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF out = """" THEN RETURN """"" + NL
    t = t + "    RETURN out.CharAt(0).Upper() + out.Substring(1, out.Length - 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB MeCap_OnChange ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR old AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    IF meBusy THEN RETURN" + NL
    t = t + "    text = meCap.Text" + NL
    t = t + "    i = MeItem()" + NL
    t = t + "    old = GetP(i, ""Caption"")" + NL
    t = t + "    SetP(i, ""Caption"", text)" + NL
    t = t + "    ' a name made from the caption follows it, until it's typed by hand" + NL
    t = t + "    IF GetP(i, ""Name"") = """" OR GetP(i, ""Name"") = AutoName(i, old) THEN SetP(i, ""Name"", AutoName(i, text))" + NL
    t = t + "    MeRow(i)" + NL
    t = t + "    MeShow()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One line of the list again, without disturbing the rest." + NL
    t = t + "SUB MeRow (i AS Integer)" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR r AS Integer" + NL
    t = t + "    r = meIdx.IndexOf(i)" + NL
    t = t + "    IF r < 0 THEN RETURN" + NL
    t = t + "    s = GetP(i, ""Caption"")" + NL
    t = t + "    IF GetN(i, ""Level"") > 0 THEN s = ""...."" + s" + NL
    t = t + "    IF GetP(i, ""Shortcut"") <> """" THEN s = s.PadRight(26) + GetP(i, ""Shortcut"")" + NL
    t = t + "    meList.Set(r, s)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' (Each takes what was typed or picked first: making a new item clears the boxes.)" + NL
    t = t + "SUB MeName_OnChange ()" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF meBusy THEN RETURN" + NL
    t = t + "    text = meName.Text.Trim()" + NL
    t = t + "    i = MeItem()" + NL
    t = t + "    SetP(i, ""Name"", text)" + NL
    t = t + "    MeShow()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MeKey_OnSelect ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF meBusy THEN RETURN" + NL
    t = t + "    k = meKey.Selected" + NL
    t = t + "    i = MeItem()" + NL
    t = t + "    IF k <= 0 THEN" + NL
    t = t + "        SetP(i, ""Shortcut"", """")" + NL
    t = t + "    ELSE" + NL
    t = t + "        SetP(i, ""Shortcut"", meKey.Items[k])" + NL
    t = t + "    END IF" + NL
    t = t + "    MeRow(i)" + NL
    t = t + "    MeShow()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MeChk_OnChange ()" + NL
    t = t + "    VAR on AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF meBusy THEN RETURN" + NL
    t = t + "    on = meChk.Checked" + NL
    t = t + "    i = MeItem()" + NL
    t = t + "    IF on THEN" + NL
    t = t + "        SetP(i, ""Checked"", ""TRUE"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        SetP(i, ""Checked"", ""FALSE"")" + NL
    t = t + "    END IF" + NL
    t = t + "    MeShow()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MeEn_OnChange ()" + NL
    t = t + "    VAR on AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF meBusy THEN RETURN" + NL
    t = t + "    on = meEn.Checked" + NL
    t = t + "    i = MeItem()" + NL
    t = t + "    IF on THEN" + NL
    t = t + "        SetP(i, ""Enabled"", ""TRUE"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        SetP(i, ""Enabled"", ""FALSE"")" + NL
    t = t + "    END IF" + NL
    t = t + "    MeShow()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Next: the item after this one, or a new one at the end, at the same level." + NL
    t = t + "SUB Me_Next ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR r AS Integer" + NL
    t = t + "    i = MeCur()" + NL
    t = t + "    r = meList.Selected" + NL
    t = t + "    IF i >= 0 AND r < meIdx.Count - 1 THEN" + NL
    t = t + "        meList.Selected = r + 1" + NL
    t = t + "        MeShow()" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF i >= 0 AND GetP(i, ""Caption"") = """" THEN RETURN" + NL
    t = t + "        IF i >= 0 THEN" + NL
    t = t + "            FillMe(MeNew(kType.Count, GetN(i, ""Level"")))" + NL
    t = t + "        ELSE" + NL
    t = t + "            FillMe(MeNew(kType.Count, 0))" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    meCap.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Insert: a new item before this one." + NL
    t = t + "SUB Me_Insert ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = MeCur()" + NL
    t = t + "    IF i < 0 THEN" + NL
    t = t + "        FillMe(MeNew(kType.Count, 0))" + NL
    t = t + "    ELSE" + NL
    t = t + "        FillMe(MeNew(i, GetN(i, ""Level"")))" + NL
    t = t + "    END IF" + NL
    t = t + "    meCap.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Me_Delete ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR r AS Integer" + NL
    t = t + "    i = MeCur()" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    r = meList.Selected" + NL
    t = t + "    kType.RemoveAt(i)" + NL
    t = t + "    kProps.RemoveAt(i)" + NL
    t = t + "    FillMe(-1)" + NL
    t = t + "    IF meIdx.Count > 0 THEN" + NL
    t = t + "        meList.Selected = MATH.Min(r, meIdx.Count - 1)" + NL
    t = t + "        MeShow()" + NL
    t = t + "    END IF" + NL
    t = t + "    meCap.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' < and >: a menu on the bar, or an item in the menu above." + NL
    t = t + "SUB Me_Out ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = MeCur()" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    SetP(i, ""Level"", ""0"")" + NL
    t = t + "    FillMe(i)" + NL
    t = t + "    meCap.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Me_In ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = MeCur()" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    IF meList.Selected = 0 THEN" + NL
    t = t + "        Say(""The first line is a menu on the bar: the items go under it."", ""info"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    SetP(i, ""Level"", ""1"")" + NL
    t = t + "    FillMe(i)" + NL
    t = t + "    meCap.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Me_Up ()" + NL
    t = t + "    MeSwap(-1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Me_Down ()" + NL
    t = t + "    MeSwap(1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The selected item swapped with the one above (-1) or below (1)." + NL
    t = t + "SUB MeSwap (dir AS Integer)" + NL
    t = t + "    VAR r AS Integer" + NL
    t = t + "    VAR a AS Integer" + NL
    t = t + "    VAR b AS Integer" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    r = meList.Selected" + NL
    t = t + "    IF r < 0 OR r + dir < 0 OR r + dir >= meIdx.Count THEN RETURN" + NL
    t = t + "    a = meIdx[r]" + NL
    t = t + "    b = meIdx[r + dir]" + NL
    t = t + "    t = kProps[a]" + NL
    t = t + "    kProps[a] = kProps[b]" + NL
    t = t + "    kProps[b] = t" + NL
    t = t + "    FillMe(b)" + NL
    t = t + "    meCap.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Me_Ok ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    VAR o AS String" + NL
    t = t + "    ' (empty lines are left out)" + NL
    t = t + "    i = kType.Count - 1" + NL
    t = t + "    WHILE i >= 1" + NL
    t = t + "        IF kType[i] = ""MenuItem"" AND GetP(i, ""Caption"").Trim() = """" AND GetP(i, ""Name"").Trim() = """" THEN" + NL
    t = t + "            kType.RemoveAt(i)" + NL
    t = t + "            kProps.RemoveAt(i)" + NL
    t = t + "        END IF" + NL
    t = t + "        i = i - 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    FOR i = 1 TO kType.Count - 1" + NL
    t = t + "        IF kType[i] <> ""MenuItem"" THEN CONTINUE" + NL
    t = t + "        n = GetP(i, ""Name"").Trim()" + NL
    t = t + "        IF GetP(i, ""Caption"").Trim() = """" THEN" + NL
    t = t + "            FillMe(i)" + NL
    t = t + "            Say(""Each item needs a caption: what the menu shows."", ""warn"")" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        IF NOT IsIdent(n) THEN" + NL
    t = t + "            FillMe(i)" + NL
    t = t + "            Say(Plain(GetP(i, ""Caption"")) + "" needs a name for the code: letters, digits and _, starting with a letter."", ""warn"")" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        IF NameTaken(n, i) THEN" + NL
    t = t + "            FillMe(i)" + NL
    t = t + "            Say(""Something else is already called "" + n + ""."", ""warn"")" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' renamed items: their SUBs too" + NL
    t = t + "    FOR i = 1 TO kType.Count - 1" + NL
    t = t + "        IF kType[i] <> ""MenuItem"" THEN CONTINUE" + NL
    t = t + "        o = GetP(i, ""Orig"")" + NL
    t = t + "        n = GetP(i, ""Name"")" + NL
    t = t + "        IF o <> """" AND o <> n THEN editor.Text = Renamed(editor.Text, o, n)" + NL
    t = t + "        DropP(i, ""Orig"")" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' (no change: nothing to undo)" + NL
    t = t + "    IF undoModel.Count > 0 THEN" + NL
    t = t + "        IF undoModel[undoModel.Count - 1] = Snapshot() THEN" + NL
    t = t + "            undoModel.RemoveAt(undoModel.Count - 1)" + NL
    t = t + "            undoCode.RemoveAt(undoCode.Count - 1)" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    Did()" + NL
    t = t + "    meDone = TRUE" + NL
    t = t + "    meWin.Close()" + NL
    t = t + "    FillObjects()" + NL
    t = t + "    SelectObj(0)" + NL
    t = t + "    IF HasMenu() THEN win.Status = ""Click a menu on the form, then an item, to write what it does.""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Me_Cancel ()" + NL
    t = t + "    meWin.Close()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Closed without OK: the menus as they were." + NL
    t = t + "SUB Me_Closed ()" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF meDone THEN RETURN" + NL
    t = t + "    meDone = TRUE" + NL
    t = t + "    k = undoModel.Count - 1" + NL
    t = t + "    IF k >= 0 THEN" + NL
    t = t + "        LoadSnap(undoModel[k])" + NL
    t = t + "        undoModel.RemoveAt(k)" + NL
    t = t + "        undoCode.RemoveAt(k)" + NL
    t = t + "    END IF" + NL
    t = t + "    FillObjects()" + NL
    t = t + "    SelectObj(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ anchors" + NL
    t = t + "" + NL
    t = t + "' An Anchor value tidied: the edges named, in order." + NL
    t = t + "FUNCTION Anchors (v AS String) AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR u AS String" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    u = "","" + v.Upper().Replace("" "", """").Replace("";"", "","").Replace(""+"", "","") + "",""" + NL
    t = t + "    FOR EACH e IN [""Top"", ""Bottom"", ""Left"", ""Right""]" + NL
    t = t + "        IF u.Contains("","" + e.Upper() + "","") THEN out.Add(e)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out.Join("","")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is any control anchored other than to the top left (so the program lays them out)?" + NL
    t = t + "FUNCTION Anchored () AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 1 TO kType.Count - 1" + NL
    t = t + "        IF Movable(i) AND kType[i] <> ""Timer"" THEN" + NL
    t = t + "            IF GetP(i, ""Anchor"") <> ""Top,Left"" THEN RETURN TRUE" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Code for a position (pos TRUE) or a size along one direction, as the window" + NL
    t = t + "' grows by d: anchored at both ends it stretches; at the far end it moves; at" + NL
    t = t + "' neither it stays in the middle." + NL
    t = t + "FUNCTION Span (pos AS Integer, size AS Integer, anchor AS String, near AS String, far AS String, d AS String, wantPos AS Bool) AS String" + NL
    t = t + "    VAR a AS Bool" + NL
    t = t + "    VAR b AS Bool" + NL
    t = t + "    a = ("","" + anchor + "","").Contains("","" + near + "","")" + NL
    t = t + "    b = ("","" + anchor + "","").Contains("","" + far + "","")" + NL
    t = t + "    IF NOT wantPos THEN" + NL
    t = t + "        IF a AND b THEN RETURN ""MATH.Max("" + Str(GRID) + "", "" + Str(size) + "" + "" + d + "")""" + NL
    t = t + "        RETURN Str(size)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF a AND b THEN RETURN Str(pos)" + NL
    t = t + "    IF b THEN RETURN Str(pos) + "" + "" + d" + NL
    t = t + "    IF a THEN RETURN Str(pos)" + NL
    t = t + "    RETURN Str(pos) + "" + Int("" + d + "" / 2)""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The form grew by dw, dh on the designer: its anchored controls follow." + NL
    t = t + "SUB FollowForm (dw AS Integer, dh AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR an AS String" + NL
    t = t + "    FOR i = 1 TO kType.Count - 1" + NL
    t = t + "        IF NOT Movable(i) OR kType[i] = ""Timer"" THEN CONTINUE" + NL
    t = t + "        an = "","" + GetP(i, ""Anchor"") + "",""" + NL
    t = t + "        IF dw <> 0 THEN" + NL
    t = t + "            IF an.Contains("",Left,"") AND an.Contains("",Right,"") THEN" + NL
    t = t + "                SetP(i, ""Width"", Str(MATH.Max(GRID, GetN(i, ""Width"") + dw)))" + NL
    t = t + "            ELSEIF an.Contains("",Right,"") THEN" + NL
    t = t + "                SetP(i, ""X"", Str(MATH.Max(0, GetN(i, ""X"") + dw)))" + NL
    t = t + "            ELSEIF NOT an.Contains("",Left,"") THEN" + NL
    t = t + "                SetP(i, ""X"", Str(MATH.Max(0, GetN(i, ""X"") + Int(dw / 2))))" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        IF dh <> 0 THEN" + NL
    t = t + "            IF an.Contains("",Top,"") AND an.Contains("",Bottom,"") THEN" + NL
    t = t + "                SetP(i, ""Height"", Str(MATH.Max(GRID, GetN(i, ""Height"") + dh)))" + NL
    t = t + "            ELSEIF an.Contains("",Bottom,"") THEN" + NL
    t = t + "                SetP(i, ""Y"", Str(MATH.Max(0, GetN(i, ""Y"") + dh)))" + NL
    t = t + "            ELSEIF NOT an.Contains("",Top,"") THEN" + NL
    t = t + "                SetP(i, ""Y"", Str(MATH.Max(0, GetN(i, ""Y"") + Int(dh / 2))))" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the layout, as text" + NL
    t = t + "" + NL
    t = t + "' As Visual BASIC kept a form in its .FRM file: a Begin...End for each object," + NL
    t = t + "' with every property. Editing it and going back to the Form or the Code" + NL
    t = t + "' applies it." + NL
    t = t + "FUNCTION LayoutText () AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    out.Add(""' The form's layout. Change values here, then go"")" + NL
    t = t + "    out.Add(""' back to the Form or the Code to apply them."")" + NL
    t = t + "    out.Add(""' Later objects are drawn over earlier ones."")" + NL
    t = t + "    out.Add(""' Each one's name is on its Begin line."")" + NL
    t = t + "    out.Add("""")" + NL
    t = t + "    FOR i = 0 TO kType.Count - 1" + NL
    t = t + "        out.Add(""Begin "" + kType[i] + "" "" + GetP(i, ""Name""))" + NL
    t = t + "        FOR EACH e IN Props(kType[i])" + NL
    t = t + "            key = e.Split(""|"")[0]" + NL
    t = t + "            IF key = ""Name"" THEN CONTINUE" + NL
    t = t + "            kind = PropKind(kType[i], key)" + NL
    t = t + "            IF kind = ""int"" OR kind = ""bool"" OR kind = ""color"" THEN" + NL
    t = t + "                out.Add(""    "" + key + "" = "" + GetP(i, key))" + NL
    t = t + "            ELSE" + NL
    t = t + "                out.Add(""    "" + key + "" = "" + Lit(GetP(i, key)))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        out.Add(""End"")" + NL
    t = t + "        out.Add("""")" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out.Join(EOL)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB ShowLayout ()" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    IF layoutView THEN RETURN" + NL
    t = t + "    layoutView = TRUE" + NL
    t = t + "    codeView = FALSE" + NL
    t = t + "    design.Visible = FALSE" + NL
    t = t + "    keys.Visible = FALSE" + NL
    t = t + "    editor.Visible = FALSE" + NL
    t = t + "    objList.Visible = FALSE" + NL
    t = t + "    evtList.Visible = FALSE" + NL
    t = t + "    layoutEd.Visible = TRUE" + NL
    t = t + "    formBtn.Enabled = TRUE" + NL
    t = t + "    codeBtn.Enabled = TRUE" + NL
    t = t + "    layBtn.Enabled = FALSE" + NL
    t = t + "    tool = """"" + NL
    t = t + "    toolbox.Selected = 0" + NL
    t = t + "    layoutShown = LayoutText()" + NL
    t = t + "    layoutEd.Text = layoutShown" + NL
    t = t + "    ' at the selected object" + NL
    t = t + "    lines = layoutShown.Split(EOL)" + NL
    t = t + "    FOR k = 0 TO lines.Count - 1" + NL
    t = t + "        IF lines[k] = ""Begin "" + kType[sel] + "" "" + GetP(sel, ""Name"") THEN" + NL
    t = t + "            ' (the cursor at the end of the line, not the line selected)" + NL
    t = t + "            layoutEd.GotoLine(k + 1)" + NL
    t = t + "            layoutEd.Insert(lines[k])" + NL
    t = t + "            layoutShown = layoutEd.Text" + NL
    t = t + "            BREAK" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    layoutEd.Focus()" + NL
    t = t + "    win.Status = ""The form's layout: change it here, then go back to the Form or the Code.""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Out of the layout view, with its changes applied: FALSE (and still there) if they're wrong." + NL
    t = t + "FUNCTION LeaveLayout () AS Bool" + NL
    t = t + "    IF NOT layoutView THEN RETURN TRUE" + NL
    t = t + "    IF NOT ApplyLayout() THEN RETURN FALSE" + NL
    t = t + "    layoutView = FALSE" + NL
    t = t + "    layoutEd.Visible = FALSE" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ApplyLayout () AS Bool" + NL
    t = t + "    VAR before AS String" + NL
    t = t + "    VAR beforeCode AS String" + NL
    t = t + "    VAR oldTypes AS Array OF String" + NL
    t = t + "    VAR oldNames AS Array OF String" + NL
    t = t + "    VAR msg AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    IF layoutEd.Text = layoutShown THEN RETURN TRUE" + NL
    t = t + "    before = Snapshot()" + NL
    t = t + "    beforeCode = editor.Text" + NL
    t = t + "    FOR i = 0 TO kType.Count - 1" + NL
    t = t + "        oldTypes.Add(kType[i])" + NL
    t = t + "        oldNames.Add(GetP(i, ""Name""))" + NL
    t = t + "    NEXT" + NL
    t = t + "    msg = ParseLayout(layoutEd.Text)" + NL
    t = t + "    IF msg <> """" THEN" + NL
    t = t + "        Say(""The layout has a mistake, so it isn't applied yet."" + EOL + EOL + msg, ""warn"")" + NL
    t = t + "        line = Int(Val(msg.Substring(5, msg.IndexOf("":"") - 5)))" + NL
    t = t + "        IF line > 0 THEN layoutEd.GotoLine(line)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    ' an object with a new name in the same place: its code follows" + NL
    t = t + "    FOR i = 0 TO MATH.Min(oldTypes.Count, kType.Count) - 1" + NL
    t = t + "        IF oldTypes[i] = kType[i] AND oldNames[i] <> GetP(i, ""Name"") THEN editor.Text = Renamed(editor.Text, oldNames[i], GetP(i, ""Name""))" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF Snapshot() <> before THEN PushUndo(before, beforeCode)" + NL
    t = t + "    Did()" + NL
    t = t + "    layoutShown = layoutEd.Text" + NL
    t = t + "    IF sel >= kType.Count THEN sel = 0" + NL
    t = t + "    FillObjects()" + NL
    t = t + "    FillProps()" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The layout read into the form. """" when it's good; otherwise what's wrong," + NL
    t = t + "' as ""Line n: ..."", and the form is as it was." + NL
    t = t + "FUNCTION ParseLayout (text AS String) AS String" + NL
    t = t + "    VAR old AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    VAR typ AS String" + NL
    t = t + "    VAR nm AS String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    VAR why AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    old = Snapshot()" + NL
    t = t + "    kType.Clear()" + NL
    t = t + "    kProps.Clear()" + NL
    t = t + "    i = -1" + NL
    t = t + "    lines = text.Replace(Chr(13), """").Split(EOL)" + NL
    t = t + "    FOR k = 0 TO lines.Count - 1" + NL
    t = t + "        t = lines[k].Trim()" + NL
    t = t + "        IF t = """" OR t.StartsWith(""'"") THEN CONTINUE" + NL
    t = t + "        IF t.Upper().StartsWith(""BEGIN "") THEN" + NL
    t = t + "            rest = t.Substring(6, t.Length - 6).Trim()" + NL
    t = t + "            at = rest.IndexOf("" "")" + NL
    t = t + "            IF i >= 0 THEN" + NL
    t = t + "                why = ""a Begin before the End of "" + GetP(i, ""Name"") + "".""" + NL
    t = t + "            ELSEIF at < 0 THEN" + NL
    t = t + "                why = ""Begin needs a kind and a name, like: Begin Button Command1""" + NL
    t = t + "            ELSE" + NL
    t = t + "                typ = KindOf(rest.Substring(0, at))" + NL
    t = t + "                nm = rest.Substring(at + 1, rest.Length - at - 1).Trim()" + NL
    t = t + "                IF typ = """" THEN" + NL
    t = t + "                    why = Q + rest.Substring(0, at) + Q + "" isn't a kind of object. The kinds: Form, "" + KindList() + "".""" + NL
    t = t + "                ELSEIF typ = ""Form"" AND kType.Count > 0 THEN" + NL
    t = t + "                    why = ""there's only one Form, and it comes first.""" + NL
    t = t + "                ELSEIF typ <> ""Form"" AND kType.Count = 0 THEN" + NL
    t = t + "                    why = ""the Form comes first.""" + NL
    t = t + "                ELSEIF NOT IsIdent(nm) THEN" + NL
    t = t + "                    why = Q + nm + Q + "" can't be a name: letters, digits and _, starting with a letter.""" + NL
    t = t + "                ELSEIF NameTaken(nm, -1) THEN" + NL
    t = t + "                    why = ""two things are called "" + nm + "".""" + NL
    t = t + "                ELSE" + NL
    t = t + "                    kType.Add(typ)" + NL
    t = t + "                    kProps.Add("""")" + NL
    t = t + "                    i = kType.Count - 1" + NL
    t = t + "                    SetP(i, ""Name"", nm)" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSEIF t.Upper() = ""END"" THEN" + NL
    t = t + "            IF i < 0 THEN why = ""an End without a Begin.""" + NL
    t = t + "            i = -1" + NL
    t = t + "        ELSEIF i < 0 THEN" + NL
    t = t + "            why = ""this is outside any Begin...End.""" + NL
    t = t + "        ELSEIF NOT t.Contains(""="") THEN" + NL
    t = t + "            why = ""a property is written Key = value.""" + NL
    t = t + "        ELSE" + NL
    t = t + "            key = KeyOf(kType[i], t.Substring(0, t.IndexOf(""="")).Trim())" + NL
    t = t + "            v = t.Substring(t.IndexOf(""="") + 1, t.Length - t.IndexOf(""="") - 1).Trim()" + NL
    t = t + "            IF key = ""Name"" THEN" + NL
    t = t + "                why = ""the name goes on the Begin line.""" + NL
    t = t + "            ELSEIF key = """" THEN" + NL
    t = t + "                why = ""a "" + kType[i] + "" has no "" + t.Substring(0, t.IndexOf(""="")).Trim() + "". It has: "" + KeyList(kType[i]) + "".""" + NL
    t = t + "            ELSE" + NL
    t = t + "                IF v.StartsWith(Q) THEN v = Unlit(v)" + NL
    t = t + "                IF v <> Chr(0) THEN v = Checked(kType[i], key, v)" + NL
    t = t + "                IF v = Chr(0) THEN" + NL
    t = t + "                    why = ""that isn't a good "" + key + "". "" + KindHelp(PropKind(kType[i], key))" + NL
    t = t + "                ELSE" + NL
    t = t + "                    SetP(i, key, v)" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        IF why <> """" THEN" + NL
    t = t + "            LoadSnap(old)" + NL
    t = t + "            RETURN ""Line "" + Str(k + 1) + "": "" + why" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF i >= 0 THEN why = GetP(i, ""Name"") + "" has no End.""" + NL
    t = t + "    IF kType.Count = 0 THEN why = ""there's no Begin Form.""" + NL
    t = t + "    IF why <> """" THEN" + NL
    t = t + "        LoadSnap(old)" + NL
    t = t + "        RETURN ""Line "" + Str(lines.Count) + "": "" + why" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A kind of object as written (any case), or """"." + NL
    t = t + "FUNCTION KindOf (s AS String) AS String" + NL
    t = t + "    VAR k AS String" + NL
    t = t + "    FOR EACH k IN [""Form"", ""Label"", ""Button"", ""TextBox"", ""TextArea"", ""CheckBox"", ""RadioButton"", ""ListBox"", ""DropDown"", ""ProgressBar"", ""Canvas"", ""Timer"", ""MenuItem""]" + NL
    t = t + "        IF k.Lower() = s.Lower() THEN RETURN k" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION KindList () AS String" + NL
    t = t + "    RETURN ""Label, Button, TextBox, TextArea, CheckBox, RadioButton, ListBox, DropDown, ProgressBar, Canvas, Timer and MenuItem""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A property of kind t as written (any case), or """"." + NL
    t = t + "FUNCTION KeyOf (t AS String, s AS String) AS String" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    FOR EACH e IN Props(t)" + NL
    t = t + "        IF e.Split(""|"")[0].Lower() = s.Lower() THEN RETURN e.Split(""|"")[0]" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION KeyList (t AS String) AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    FOR EACH e IN Props(t)" + NL
    t = t + "        IF e.Split(""|"")[0] <> ""Name"" THEN out.Add(e.Split(""|"")[0])" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out.Join("", "")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""He said """"hi"""""" as He said ""hi""; Chr(0) if it isn't a whole string." + NL
    t = t + "FUNCTION Unlit (v AS String) AS String" + NL
    t = t + "    VAR inner AS String" + NL
    t = t + "    IF v.Length < 2 OR NOT v.EndsWith(Q) THEN RETURN Chr(0)" + NL
    t = t + "    inner = v.Substring(1, v.Length - 2)" + NL
    t = t + "    IF inner.Replace(Q + Q, """").Contains(Q) THEN RETURN Chr(0)" + NL
    t = t + "    RETURN inner.Replace(Q + Q, Q)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A value for a property, tidied; Chr(0) if it can't be one." + NL
    t = t + "FUNCTION Checked (t AS String, key AS String, v AS String) AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR opts AS Array OF String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR ch AS String" + NL
    t = t + "    kind = PropKind(t, key)" + NL
    t = t + "    IF kind = ""int"" OR kind = ""color"" THEN" + NL
    t = t + "        IF v = """" OR v = ""-"" THEN RETURN Chr(0)" + NL
    t = t + "        FOR k = 0 TO v.Length - 1" + NL
    t = t + "            ch = v.CharAt(k)" + NL
    t = t + "            IF NOT (IsDigit(ch) OR (k = 0 AND ch = ""-"")) THEN RETURN Chr(0)" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF kind = ""color"" AND (Val(v) < 0 OR Val(v) > 15) THEN RETURN Chr(0)" + NL
    t = t + "        IF (key = ""X"" OR key = ""Y"") AND Val(v) < 0 THEN RETURN Chr(0)" + NL
    t = t + "        IF (key = ""Width"" OR key = ""Height"") AND Val(v) < 1 THEN RETURN Chr(0)" + NL
    t = t + "        IF key = ""Level"" AND (Val(v) < 0 OR Val(v) > 1) THEN RETURN Chr(0)" + NL
    t = t + "        RETURN Str(Int(Val(v)))" + NL
    t = t + "    END IF" + NL
    t = t + "    IF kind = ""bool"" THEN" + NL
    t = t + "        IF v.Upper() = ""TRUE"" OR v.Upper() = ""FALSE"" THEN RETURN v.Upper()" + NL
    t = t + "        RETURN Chr(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF kind.StartsWith(""choice:"") THEN" + NL
    t = t + "        opts = kind.Substring(7, kind.Length - 7).Split("","")" + NL
    t = t + "        IF opts.Contains(v.Lower()) THEN RETURN v.Lower()" + NL
    t = t + "        RETURN Chr(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF kind = ""anchor"" THEN" + NL
    t = t + "        IF v.Trim() <> """" AND Anchors(v) = """" THEN RETURN Chr(0)" + NL
    t = t + "        RETURN Anchors(v)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF kind = ""shortcut"" THEN" + NL
    t = t + "        IF ShortcutOk(v) THEN RETURN v" + NL
    t = t + "        RETURN Chr(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF v.Contains(Chr(10)) THEN RETURN Chr(0)" + NL
    t = t + "    RETURN v" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsDigit (ch AS String) AS Bool" + NL
    t = t + "    RETURN Asc(ch) >= 48 AND Asc(ch) <= 57" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION KindHelp (kind AS String) AS String" + NL
    t = t + "    IF kind = ""int"" THEN RETURN ""It's a whole number (X and Y not below 0, Width and Height at least 1).""" + NL
    t = t + "    IF kind = ""bool"" THEN RETURN ""It's TRUE or FALSE.""" + NL
    t = t + "    IF kind = ""color"" THEN RETURN ""It's a colour from 0 to 15.""" + NL
    t = t + "    IF kind.StartsWith(""choice:"") THEN RETURN ""It's one of: "" + kind.Substring(7, kind.Length - 7).Replace("","", "", "") + "".""" + NL
    t = t + "    IF kind = ""anchor"" THEN RETURN ""It's edges from Top, Bottom, Left and Right, like "" + Q + ""Top,Right"" + Q + "".""" + NL
    t = t + "    IF kind = ""shortcut"" THEN RETURN ""It's like "" + Q + ""Ctrl+O"" + Q + "" or "" + Q + ""F3"" + Q + "", or "" + Q + Q + "" for none.""" + NL
    t = t + "    RETURN ""It's text in quotes: "" + Q + ""like this"" + Q + "".""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ running" + NL
    t = t + "" + NL
    t = t + "FUNCTION Alive (pid AS Integer) AS Bool" + NL
    t = t + "    VAR task AS String" + NL
    t = t + "    IF pid <= 0 THEN RETURN FALSE" + NL
    t = t + "    FOR EACH task IN SYS.Tasks()" + NL
    t = t + "        IF Int(Val(task.Split(""|"")[0])) = pid THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Run: the project saved (where it lives, or in C:\VSPARK if it has no" + NL
    t = t + "' home yet) and started. A run still going is ended first." + NL
    t = t + "SUB RunIt ()" + NL
    t = t + "    VAR target AS String" + NL
    t = t + "    target = projPath" + NL
    t = t + "    IF target = """" THEN target = SCRATCH" + NL
    t = t + "    IF NOT SaveTo(target) THEN RETURN" + NL
    t = t + "    IF projPath <> """" THEN saved = Assemble()" + NL
    t = t + "    EndRun()" + NL
    t = t + "    runPid = SYS.Run(target)" + NL
    t = t + "    win.Status = ""Running "" + projName + "". (Errors show in their own window; Run > End stops it.)""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB EndRun ()" + NL
    t = t + "    IF Alive(runPid) THEN SYS.Kill(runPid)" + NL
    t = t + "    runPid = 0" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ menus and buttons" + NL
    t = t + "" + NL
    t = t + "SUB FormBtn_OnClick ()" + NL
    t = t + "    ShowForm()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB CodeBtn_OnClick ()" + NL
    t = t + "    ShowCode()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB LayBtn_OnClick ()" + NL
    t = t + "    ShowLayout()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RunBtn_OnClick ()" + NL
    t = t + "    RunIt()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Menu_OnSelect (item AS String)" + NL
    t = t + "    SELECT CASE item" + NL
    t = t + "        CASE ""New Project...""" + NL
    t = t + "            NewProject()" + NL
    t = t + "        CASE ""Open Project...""" + NL
    t = t + "            OpenProject()" + NL
    t = t + "        CASE ""Save Project""" + NL
    t = t + "            SaveProject()" + NL
    t = t + "        CASE ""Save Project As...""" + NL
    t = t + "            SaveAs()" + NL
    t = t + "        CASE ""Exit""" + NL
    t = t + "            win.Close()" + NL
    t = t + "        CASE ""Undo"", ""Redo"", ""Cut"", ""Copy"", ""Paste"", ""Duplicate"", ""Bring to Front"", ""Send to Back""" + NL
    t = t + "            EditCmd(item)" + NL
    t = t + "        CASE ""Menu Editor...""" + NL
    t = t + "            MenuEditor()" + NL
    t = t + "        CASE ""Delete Control""" + NL
    t = t + "            IF sel > 0 THEN" + NL
    t = t + "                DeleteSelected()" + NL
    t = t + "            ELSE" + NL
    t = t + "                win.Status = ""Select a control on the form first. (The form itself stays.)""" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Code""" + NL
    t = t + "            ShowCode()" + NL
    t = t + "        CASE ""Form""" + NL
    t = t + "            ShowForm()" + NL
    t = t + "        CASE ""Layout""" + NL
    t = t + "            ShowLayout()" + NL
    t = t + "        CASE ""Start""" + NL
    t = t + "            RunIt()" + NL
    t = t + "        CASE ""End""" + NL
    t = t + "            EndRun()" + NL
    t = t + "            win.Status = ""Stopped.""" + NL
    t = t + "        CASE ""SPARK Reference""" + NL
    t = t + "            SYS.Start(""C:\PROGRAMS\NOTES.SPK"", ""C:\DOCS\SPARK.TXT"")" + NL
    t = t + "        CASE ""About Visual SPARK""" + NL
    t = t + "            Say(""Visual SPARK 1.0 for SIM95"" + EOL + EOL + ""Draw a window, double-click what's on it, and write what happens. F5 runs it."" + EOL + EOL + ""A project is an ordinary .SPK file: your code, then the form, which the designer writes."", ""info"")" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            Snippet(item)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    Put("C:\PROGRAMS\VSPARK.SPK")
END SUB

SUB File1 ()
    t = ""
    t = t + "' PROJECT1.SPK - made with Visual SPARK: a chat client. Every machine runs a" + NL
    t = t + "' Chat service on port 6667; put a machine's name in the box and Connect." + NL
    t = t + "" + NL
    t = t + "VAR sock AS NET_Socket" + NL
    t = t + "VAR conn AS NET_Connection" + NL
    t = t + "VAR connected AS Bool" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    InitForm()" + NL
    t = t + "    sock = NET_Socket.New()" + NL
    t = t + "    sock.onMessage = Sock_OnMessage" + NL
    t = t + "    sock.onClose = Sock_OnClose" + NL
    t = t + "    Text1.Text = NET.HostName.Split(""."")[0].Lower()" + NL
    t = t + "    Form1.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Command1_OnClick ()" + NL
    t = t + "    IF connected THEN RETURN" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = sock.Connect(Text1.Text.Trim(), 6667)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        List1.Add(""*** Can't connect: "" + err)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END TRY" + NL
    t = t + "    connected = TRUE" + NL
    t = t + "    ' (the name first: JOIN goes once the service says it's taken)" + NL
    t = t + "    conn.Send(""NICK "" + NET.HostName.Split(""."")[0].Lower())" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnMessage (c AS NET_Connection, message AS String)" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR cut AS Integer" + NL
    t = t + "    p = message.Split("" "")" + NL
    t = t + "    IF message.StartsWith(""OK You are now "") THEN" + NL
    t = t + "        conn.Send(""JOIN #general"")" + NL
    t = t + "        List1.Add(""*** Connected to "" + Text1.Text)" + NL
    t = t + "    ELSEIF p[0] = ""MSG"" AND p.Count >= 4 THEN" + NL
    t = t + "        cut = p[0].Length + p[1].Length + p[2].Length + 3" + NL
    t = t + "        List1.Add(""<"" + p[2] + ""> "" + message.Substring(cut, message.Length - cut))" + NL
    t = t + "    ELSEIF p[0] = ""JOIN"" AND p.Count >= 3 THEN" + NL
    t = t + "        List1.Add(""*** "" + p[2] + "" came in"")" + NL
    t = t + "    ELSEIF p[0] = ""PART"" AND p.Count >= 3 THEN" + NL
    t = t + "        List1.Add(""*** "" + p[2] + "" left"")" + NL
    t = t + "    END IF" + NL
    t = t + "    List1.ScrollToEnd()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnClose (c AS NET_Connection)" + NL
    t = t + "    connected = FALSE" + NL
    t = t + "    List1.Add(""*** Disconnected"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Command2_OnClick ()" + NL
    t = t + "    IF NOT connected OR Text2.Text.Trim() = """" THEN RETURN" + NL
    t = t + "    conn.Send(""MSG #general "" + Text2.Text)" + NL
    t = t + "    Text2.Text = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ===== Visual SPARK form: the designer writes everything from here to END OF FORM. =====" + NL
    t = t + "' FORM Form|Name=Form1|Title=Chat|Width=360|Height=264" + NL
    t = t + "' CTRL Label|Name=Label1|Text=Machine:|X=8|Y=12|Width=56|Height=16" + NL
    t = t + "' CTRL TextBox|Name=Text1|X=64|Y=8|Width=200|Height=24" + NL
    t = t + "' CTRL Button|Name=Command1|Text=&Connect|X=272|Y=8|Width=80|Height=24" + NL
    t = t + "' CTRL ListBox|Name=List1|X=8|Y=40|Width=344|Height=184" + NL
    t = t + "' CTRL TextBox|Name=Text2|X=8|Y=232|Width=256|Height=24" + NL
    t = t + "' CTRL Button|Name=Command2|Text=&Send|X=272|Y=232|Width=80|Height=24|Default=TRUE" + NL
    t = t + "' ===== END OF FORM =====" + NL
    Put("C:\VSPARK\TEMPLATE\CHAT.SPK")
END SUB

SUB File2 ()
    t = ""
    t = t + "' PROJECT1.SPK - made with Visual SPARK: a timer that counts the seconds." + NL
    t = t + "" + NL
    t = t + "VAR count AS Integer" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    InitForm()" + NL
    t = t + "    Form1.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Timer1_OnTick ()" + NL
    t = t + "    count = count + 1" + NL
    t = t + "    Label1.Text = Str(count) + "" seconds""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Command1_OnClick ()" + NL
    t = t + "    count = 0" + NL
    t = t + "    Label1.Text = ""0 seconds""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ===== Visual SPARK form: the designer writes everything from here to END OF FORM. =====" + NL
    t = t + "' FORM Form|Name=Form1|Title=Counter|Width=200|Height=96" + NL
    t = t + "' CTRL Label|Name=Label1|Text=0 seconds|X=16|Y=16|Width=168|Height=16|Align=center|Bold=TRUE" + NL
    t = t + "' CTRL Button|Name=Command1|Text=&Start again|X=56|Y=48|Width=88|Height=24" + NL
    t = t + "' CTRL Timer|Name=Timer1|X=160|Y=48|Interval=1000|Enabled=TRUE" + NL
    t = t + "' ===== END OF FORM =====" + NL
    Put("C:\VSPARK\TEMPLATE\COUNTER.SPK")
END SUB

SUB File3 ()
    t = ""
    t = t + "' PROJECT1.SPK - made with Visual SPARK. Your code goes here; the form is at" + NL
    t = t + "' the end of the file, and the designer looks after it." + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    InitForm()" + NL
    t = t + "    Form1.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ===== Visual SPARK form: the designer writes everything from here to END OF FORM. =====" + NL
    t = t + "' FORM Form|Name=Form1|Title=Form1|Width=320|Height=240" + NL
    t = t + "' ===== END OF FORM =====" + NL
    Put("C:\VSPARK\TEMPLATE\EMPTY.SPK")
END SUB

SUB File4 ()
    t = ""
    t = t + "' VAPOR|id=MYGAME|name=My Game|kind=game|version=1|category=Fun|run=C:\GAMES\MYGAME\MYGAME.SPK|files=C:\GAMES\MYGAME\MYGAME.SPK|tasks=MYGAME|startup=|folder=|about=Catch the falling stars. Made with Visual SPARK." + NL
    t = t + "' PROJECT1.SPK - a Vapor game made with Visual SPARK. To put it in a store:" + NL
    t = t + "' change id (8 letters at most) and name in the line above, and MYGAME in the" + NL
    t = t + "' paths to the same id; save it in C:\MYFILES on the store's machine; then" + NL
    t = t + "' Vapor > Publish Apps. Raise version each time you publish a new one." + NL
    t = t + "" + NL
    t = t + "VAR px AS Integer     ' the basket" + NL
    t = t + "VAR sx AS Integer     ' the star" + NL
    t = t + "VAR sy AS Integer" + NL
    t = t + "VAR score AS Integer" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    InitForm()" + NL
    t = t + "    Form1.Show()" + NL
    t = t + "    px = 100" + NL
    t = t + "    NewStar()" + NL
    t = t + "    Picture1.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB NewStar ()" + NL
    t = t + "    sx = 8 + Rnd(224)" + NL
    t = t + "    sy = 0" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Timer1_OnTick ()" + NL
    t = t + "    sy = sy + 4" + NL
    t = t + "    IF sy >= 184 THEN" + NL
    t = t + "        IF sx >= px - 4 AND sx <= px + 44 THEN" + NL
    t = t + "            score = score + 1" + NL
    t = t + "        ELSE" + NL
    t = t + "            score = 0" + NL
    t = t + "        END IF" + NL
    t = t + "        Label1.Text = ""Score: "" + Str(score)" + NL
    t = t + "        NewStar()" + NL
    t = t + "    END IF" + NL
    t = t + "    Picture1.Clear()" + NL
    t = t + "    Picture1.SetColor(11)" + NL
    t = t + "    Picture1.FillCircle(sx, sy, 4)" + NL
    t = t + "    Picture1.SetColor(6)" + NL
    t = t + "    Picture1.FillRect(px, 188, 40, 8)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Picture1_OnKey (key AS String)" + NL
    t = t + "    IF key = ""ArrowLeft"" THEN px = MATH.Max(0, px - 12)" + NL
    t = t + "    IF key = ""ArrowRight"" THEN px = MATH.Min(200, px + 12)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ===== Visual SPARK form: the designer writes everything from here to END OF FORM. =====" + NL
    t = t + "' FORM Form|Name=Form1|Title=My Game|Width=256|Height=240|Resizable=FALSE" + NL
    t = t + "' CTRL Label|Name=Label1|Text=Score: 0|X=8|Y=8|Width=240|Height=16|Bold=TRUE" + NL
    t = t + "' CTRL Canvas|Name=Picture1|X=8|Y=32|Width=240|Height=200|Background=0" + NL
    t = t + "' CTRL Timer|Name=Timer1|X=216|Y=4|Interval=80|Enabled=TRUE" + NL
    t = t + "' ===== END OF FORM =====" + NL
    Put("C:\VSPARK\TEMPLATE\GAME.SPK")
END SUB

SUB File5 ()
    t = ""
    t = t + "' PROJECT1.SPK - made with Visual SPARK: a button that says hello." + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    InitForm()" + NL
    t = t + "    Form1.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Command1_OnClick ()" + NL
    t = t + "    Label1.Text = ""Hello, world!""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ===== Visual SPARK form: the designer writes everything from here to END OF FORM. =====" + NL
    t = t + "' FORM Form|Name=Form1|Title=Hello|Width=240|Height=96" + NL
    t = t + "' CTRL Label|Name=Label1|Text=Press the button.|X=16|Y=16|Width=208|Height=16" + NL
    t = t + "' CTRL Button|Name=Command1|Text=Say &Hello|X=16|Y=48|Width=96|Height=24|Default=TRUE" + NL
