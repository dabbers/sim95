    t = t + "    keys = GUI_Button.New(win)" + NL
    t = t + "    keys.SetBounds(140, 40, 1, 1)" + NL
    t = t + "    keys.onKey = Design_OnKey" + NL
    t = t + "    ctx = GUI_Menu.New(win)" + NL
    t = t + "    ctx.AddMenu(""Control"")" + NL
    t = t + "    ctx.AddItem(""Control"", ""&View Code"")" + NL
    t = t + "    ctx.AddSeparator(""Control"")" + NL
    t = t + "    ctx.AddItem(""Control"", ""Cu&t"")" + NL
    t = t + "    ctx.AddItem(""Control"", ""&Copy"")" + NL
    t = t + "    ctx.AddItem(""Control"", ""&Paste"")" + NL
    t = t + "    ctx.AddItem(""Control"", ""D&uplicate"")" + NL
    t = t + "    ctx.AddItem(""Control"", ""&Delete"")" + NL
    t = t + "    ctx.AddSeparator(""Control"")" + NL
    t = t + "    ctx.AddItem(""Control"", ""Bring to &Front"")" + NL
    t = t + "    ctx.AddItem(""Control"", ""Send to &Back"")" + NL
    t = t + "    ctx.onSelect = Ctx_OnSelect" + NL
    t = t + "    ctxForm = GUI_Menu.New(win)" + NL
    t = t + "    ctxForm.AddMenu(""Form"")" + NL
    t = t + "    ctxForm.AddItem(""Form"", ""&View Code"")" + NL
    t = t + "    ctxForm.AddItem(""Form"", ""&Paste"")" + NL
    t = t + "    ctxForm.AddItem(""Form"", ""&Menu Editor..."")" + NL
    t = t + "    ctxForm.onSelect = CtxForm_OnSelect" + NL
    t = t + "    menuPop = GUI_Menu.New(win)" + NL
    t = t + "    menuPop.onSelect = MenuPop_OnSelect" + NL
    t = t + "" + NL
    t = t + "    design = GUI_Canvas.New(win)" + NL
    t = t + "    design.SetBounds(134, 32, 450, 470)" + NL
    t = t + "    design.Background = 8" + NL
    t = t + "    design.onDraw = Design_OnDraw" + NL
    t = t + "    design.onMouseDown = Design_OnMouseDown" + NL
    t = t + "    design.onMouseMove = Design_OnMouseMove" + NL
    t = t + "    design.onMouseUp = Design_OnMouseUp" + NL
    t = t + "    design.onKey = Design_OnKey" + NL
    t = t + "" + NL
    t = t + "    objList = GUI_DropDown.New(win)" + NL
    t = t + "    objList.SetBounds(134, 32, 220, 21)" + NL
    t = t + "    objList.onSelect = ObjList_OnSelect" + NL
    t = t + "    evtList = GUI_DropDown.New(win)" + NL
    t = t + "    evtList.SetBounds(364, 32, 220, 21)" + NL
    t = t + "    evtList.onSelect = EvtList_OnSelect" + NL
    t = t + "    editor = GUI_TextArea.New(win)" + NL
    t = t + "    editor.SetBounds(134, 58, 450, 444)" + NL
    t = t + "    editor.Syntax = ""SPARK""" + NL
    t = t + "    layoutEd = GUI_TextArea.New(win)" + NL
    t = t + "    layoutEd.SetBounds(134, 32, 450, 470)" + NL
    t = t + "    layoutEd.Syntax = ""SPARK""" + NL
    t = t + "    layoutEd.Visible = FALSE" + NL
    t = t + "" + NL
    t = t + "    l = GUI_Label.New(win)" + NL
    t = t + "    l.Text = ""Properties""" + NL
    t = t + "    l.Bold = TRUE" + NL
    t = t + "    l.SetBounds(592, 8, 180, 16)" + NL
    t = t + "    propObj = GUI_DropDown.New(win)" + NL
    t = t + "    propObj.SetBounds(592, 26, 128, 21)" + NL
    t = t + "    propObj.onSelect = PropObj_OnSelect" + NL
    t = t + "    propDel = GUI_Button.New(win)" + NL
    t = t + "    propDel.Text = ""&Delete""" + NL
    t = t + "    propDel.SetBounds(724, 25, 50, 23)" + NL
    t = t + "    propDel.onClick = PropDel_OnClick" + NL
    t = t + "    propList = GUI_ListBox.New(win)" + NL
    t = t + "    propList.SetBounds(592, 52, 182, 300)" + NL
    t = t + "    propList.Mono = TRUE" + NL
    t = t + "    propList.onSelect = PropList_OnSelect" + NL
    t = t + "    propList.onDblClick = PropList_OnDblClick" + NL
    t = t + "    propEdit = GUI_TextBox.New(win)" + NL
    t = t + "    propEdit.SetBounds(592, 358, 182, 21)" + NL
    t = t + "    propEdit.onEnter = PropEdit_OnEnter" + NL
