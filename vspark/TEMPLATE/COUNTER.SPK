' PROJECT1.SPK - made with Visual SPARK: a timer that counts the seconds.

VAR count AS Integer

SUB Main ()
    InitForm()
    Form1.Show()
END SUB

SUB Timer1_OnTick ()
    count = count + 1
    Label1.Text = Str(count) + " seconds"
END SUB

SUB Command1_OnClick ()
    count = 0
    Label1.Text = "0 seconds"
END SUB

' ===== Visual SPARK form: the designer writes everything from here to END OF FORM. =====
' FORM Form|Name=Form1|Title=Counter|Width=200|Height=96
' CTRL Label|Name=Label1|Text=0 seconds|X=16|Y=16|Width=168|Height=16|Align=center|Bold=TRUE
' CTRL Button|Name=Command1|Text=&Start again|X=56|Y=48|Width=88|Height=24
' CTRL Timer|Name=Timer1|X=160|Y=48|Interval=1000|Enabled=TRUE
' ===== END OF FORM =====
