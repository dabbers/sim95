' VAPOR|id=SIMPAL|name=SimPal|kind=web|version=bfceaf5b|category=Internet|run=/|files=C:\WEB\ADMIN.ASP;C:\WEB\CHECKPAY.TXT;C:\WEB\HISTORY.ASP;C:\WEB\HOME.ASP;C:\WEB\INDEX.ASP;C:\WEB\JOIN.ASP;C:\WEB\LOGIN.ASP;C:\WEB\LOGOUT.ASP;C:\WEB\MERCHANT.ASP;C:\WEB\PAL.SPK;C:\WEB\PAY.ASP;C:\WEB\REQUEST.ASP;C:\WEB\SEND.ASP;C:\WEB\SIMMART.ASP;C:\WEB\SIMPAL.HTM;C:\WEB\THANKS.TXT;C:\WEB\VERIFY.ASP;C:\PROGRAMS\PALCHECK.SPK|tasks=|startup=|folder=PAL|about=Send money, request money, and Pay with SimPal on any web site, in SimBucks. Becomes this machine's home page, or on a SimHost machine gets a folder of its own.
' INSTALL.SPK - puts SimPal on this machine. Generated by tools/build-installer.mjs;
' edit the files in simpal/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It puts SimPal
' in C:\WEB as this machine's home page (the stock INDEX.HTM moves to
' WELCOME.HTM), and C:\PROGRAMS\PALCHECK.SPK, which shops' pages on this
' machine import to check receipts. Accounts and the ledger in C:\PALDATA are
' left alone, so running it again upgrades SimPal without losing a penny. Then
' open http://YOURNAME/ in Voyager.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)
    ' On a machine set up for several web apps (SimHost: C:\SYSTEM\WEBAPPS.INI
    ' says mode=folders), this one goes in C:\WEB\PAL and leaves the home page alone.
    IF FS.Exists("C:\SYSTEM\WEBAPPS.INI") THEN
        IF FS.Read("C:\SYSTEM\WEBAPPS.INI").Contains("mode=folders") THEN intoDir = "PAL"
    END IF
    IF intoDir <> "" AND NOT FS.Exists("C:\WEB\" + intoDir) THEN FS.MakeDir("C:\WEB\" + intoDir)


    IF intoDir = "" THEN MoveHomePage()
    File0()
    File1()
    File2()
    File3()
    File4()
    File5()
    File6()
    File7()
    File8()
    File9()
    File10()
    File11()
    File12()
    File13()
    File14()
    File15()
    File16()
    File17()
    Print("SimPal is installed (18 files).")

    IF intoDir = "" THEN
        Print("Open http://" + NET.HostName.Lower() + "/ in Voyager.")
    ELSE
        Print("Open http://" + NET.HostName.Lower() + "/" + intoDir.Lower() + "/ in Voyager.")
    END IF
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "<%@ import file=""PAL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' ADMIN.ASP - the bank manager's office, for whoever runs this machine: the" + NL
    t = t + "' user name and password in C:\SYSTEM\USERS.INI, asked for on every visit and" + NL
    t = t + "' every grant (so another site can't grant anything: it doesn't know them)." + NL
    t = t + "' It lists every account, adds the whole ledger up again from scratch, and" + NL
    t = t + "' checks the money supply: all balances together must equal every welcome" + NL
    t = t + "' bonus plus every grant. It can also grant SimBucks: the only other way money" + NL
    t = t + "' is made." + NL
    t = t + "VAR owner AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR done AS String" + NL
    t = t + "VAR allowed AS Bool" + NL
    t = t + "VAR who AS Array OF String" + NL
    t = t + "VAR sums AS Array OF Integer" + NL
    t = t + "VAR issued AS Integer" + NL
    t = t + "VAR bonuses AS Integer" + NL
    t = t + "VAR grants AS Integer" + NL
    t = t + "VAR txs AS Integer" + NL
    t = t + "VAR total AS Integer" + NL
    t = t + "VAR rows AS String" + NL
    t = t + "VAR shown AS Integer" + NL
    t = t + "VAR listed AS Integer" + NL
    t = t + "VAR u AS String" + NL
    t = t + "VAR p AS Array OF String" + NL
    t = t + "VAR b AS Integer" + NL
    t = t + "VAR fromLedger AS Integer" + NL
    t = t + "VAR c AS Integer" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR k AS Integer" + NL
    t = t + "VAR cents AS Integer" + NL
    t = t + "VAR mismatches AS Integer" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "owner = REQUEST.Form(""owner"").Trim()" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    IF NOT IsOwner(owner, REQUEST.Form(""opw"")) THEN" + NL
    t = t + "        problem = ""That is not this machine's owner (the name and password in C:\SYSTEM\USERS.INI). Nothing was shown, and nothing was granted.""" + NL
    t = t + "    ELSE" + NL
    t = t + "        allowed = TRUE" + NL
    t = t + "        IF REQUEST.Form(""do"") = ""grant"" THEN" + NL
    t = t + "            problem = Grant(REQUEST.Form(""u""), REQUEST.Form(""amount""), REQUEST.Form(""note""))" + NL
    t = t + "            IF problem = """" THEN done = ""Granted "" + Bucks(ParseCents(REQUEST.Form(""amount""))).Replace(""&sect;"", ""§"") + "" to "" + REQUEST.Form(""u"").Trim().Lower() + "".""" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "END IF" + NL
    t = t + "IF allowed THEN" + NL
    t = t + "    ' Add up the whole ledger from scratch: what it says each member holds" + NL
    t = t + "    ' (who, sums), and how much money the bank has made (issued)." + NL
    t = t + "    IF LastId() > 0 THEN" + NL
    t = t + "        FOR c = 0 TO Int((LastId() - 1) / LOGSIZE)" + NL
    t = t + "            FOR EACH line IN ReadOr(DATADIR + ""\LEDGER\"" + Str(c) + "".TXT"", """").Lines()" + NL
    t = t + "                p = line.Split(""|"")" + NL
    t = t + "                IF p.Count < 9 THEN CONTINUE" + NL
    t = t + "                txs = txs + 1" + NL
    t = t + "                cents = Int(Val(p[5]))" + NL
    t = t + "                IF p[3] = BANK THEN" + NL
    t = t + "                    issued = issued + cents" + NL
    t = t + "                    IF p[2] = ""bonus"" THEN bonuses = bonuses + cents" + NL
    t = t + "                    IF p[2] = ""grant"" THEN grants = grants + cents" + NL
    t = t + "                ELSE" + NL
    t = t + "                    k = who.IndexOf(p[3])" + NL
    t = t + "                    IF k < 0 THEN" + NL
    t = t + "                        who.Add(p[3])" + NL
    t = t + "                        sums.Add(0)" + NL
    t = t + "                        k = who.Count - 1" + NL
    t = t + "                    END IF" + NL
    t = t + "                    sums[k] = sums[k] - cents" + NL
    t = t + "                END IF" + NL
    t = t + "                k = who.IndexOf(p[4])" + NL
    t = t + "                IF k < 0 THEN" + NL
    t = t + "                    who.Add(p[4])" + NL
    t = t + "                    sums.Add(0)" + NL
    t = t + "                    k = who.Count - 1" + NL
    t = t + "                END IF" + NL
    t = t + "                sums[k] = sums[k] + cents" + NL
    t = t + "            NEXT" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH u IN People()" + NL
    t = t + "        p = u.Split(""|"")" + NL
    t = t + "        b = Balance(p[0])" + NL
    t = t + "        total = total + b" + NL
    t = t + "        fromLedger = 0" + NL
    t = t + "        IF who.IndexOf(p[0]) >= 0 THEN fromLedger = sums[who.IndexOf(p[0])]" + NL
    t = t + "        IF fromLedger <> b THEN mismatches = mismatches + 1" + NL
    t = t + "        shown = shown + 1" + NL
    t = t + "        IF listed < ADMINSHOW AND rows.Length < ADMINROOM THEN" + NL
    t = t + "            listed = listed + 1" + NL
    t = t + "            rows = rows + ""<tr><td><font size=""""2""""><b>"" + p[0] + ""</b></font></td><td><font size=""""2"""">"" + H(Unesc(p[1])) + ""</font></td><td><font size=""""2"""">"" + Field(LoadUser(p[0]), ""joined"") + ""</font></td><td align=""""right""""><font size=""""2"""">"" + Bucks(b) + ""</font></td><td align=""""right""""><font size=""""2"""">"" + Bucks(fromLedger) + ""</font></td><td><font size=""""2"""">""" + NL
    t = t + "            IF fromLedger = b THEN" + NL
    t = t + "                rows = rows + ""<font color=""""#008000"""">OK</font>""" + NL
    t = t + "            ELSE" + NL
    t = t + "                rows = rows + ""<font color=""""#CC0000""""><b>DIFFERENT</b></font>""" + NL
    t = t + "            END IF" + NL
    t = t + "            rows = rows + ""</font></td></tr>""" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF listed < shown THEN rows = rows + ""<tr><td colspan=""""6""""><font size=""""2"""">... and "" + Str(shown - listed) + "" more (counted in the totals).</font></td></tr>""" + NL
    t = t + "END IF" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Bank Manager"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= BoxTop(""SimPal Bank Manager"") %>" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<%= Notice(done) %>" + NL
    t = t + "<% IF allowed THEN %>" + NL
    t = t + "<table cellpadding=""4"" cellspacing=""0"" border=""1"">" + NL
    t = t + "<tr><td bgcolor=""#E6F0FA""><font size=""2"">Money supply (all balances)</font></td><td align=""right""><font size=""2""><b><%= Bucks(total) %></b></font></td></tr>" + NL
    t = t + "<tr><td bgcolor=""#E6F0FA""><font size=""2"">Made by the bank (bonuses + grants)</font></td><td align=""right""><font size=""2""><b><%= Bucks(issued) %></b></font></td></tr>" + NL
    t = t + "<tr><td bgcolor=""#E6F0FA""><font size=""2"">&nbsp; welcome bonuses</font></td><td align=""right""><font size=""2""><%= Bucks(bonuses) %></font></td></tr>" + NL
    t = t + "<tr><td bgcolor=""#E6F0FA""><font size=""2"">&nbsp; grants</font></td><td align=""right""><font size=""2""><%= Bucks(grants) %></font></td></tr>" + NL
    t = t + "<tr><td bgcolor=""#E6F0FA""><font size=""2"">Transactions in the ledger</font></td><td align=""right""><font size=""2""><%= txs %></font></td></tr>" + NL
    t = t + "<tr><td bgcolor=""#E6F0FA""><font size=""2"">The books</font></td><td><font size=""2""><b><% IF total = issued AND mismatches = 0 THEN %><font color=""#008000"">BALANCE</font><% ELSE %><font color=""#CC0000"">DO NOT BALANCE</font><% END IF %></b></font></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "<p><table width=""100%"" cellpadding=""3"" cellspacing=""1"">" + NL
    t = t + "<tr bgcolor=""#E6F0FA""><td><font size=""2""><b>User</b></font></td><td><font size=""2""><b>Name</b></font></td><td><font size=""2""><b>Joined</b></font></td><td align=""right""><font size=""2""><b>Balance</b></font></td><td align=""right""><font size=""2""><b>Ledger says</b></font></td><td></td></tr>" + NL
    t = t + "<%= rows %>" + NL
    t = t + "</table>" + NL
    t = t + "<%= BoxTop(""Grant SimBucks"") %>" + NL
    t = t + "<p><font size=""2"">Prints new money into an account. It goes in the ledger as a grant, and the money supply grows by the same amount.</font></p>" + NL
    t = t + "<form action=""admin.asp"" method=""post"">" + NL
    t = t + "<input type=""hidden"" name=""do"" value=""grant"">" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td><font size=""2"">To (user name):</font></td><td><input name=""u"" size=""16""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Amount:</font></td><td><font size=""2"">&sect;</font> <input name=""amount"" size=""10""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Note:</font></td><td><input name=""note"" size=""40"" maxlength=""<%= MAXNOTE %>""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Owner's user name:</font></td><td><input name=""owner"" size=""16"" value=""<%= H(owner) %>""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Owner's password:</font></td><td><input type=""password"" name=""opw"" size=""16""> <font size=""1"" color=""#808080"">again, every time</font></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Grant""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "</form>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<p><font size=""2"">This page is for whoever runs <%= H(SERVER.Name.Lower()) %>. Give the user name and password" + NL
    t = t + "from <tt>C:\SYSTEM\USERS.INI</tt> (the ones the Files service takes).</font></p>" + NL
    t = t + "<form action=""admin.asp"" method=""post"">" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td><font size=""2"">Owner's user name:</font></td><td><input name=""owner"" size=""16"" value=""<%= H(owner) %>""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Owner's password:</font></td><td><input type=""password"" name=""opw"" size=""16""></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Open the vault""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "</form>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\ADMIN.ASP")
END SUB

SUB File1 ()
    t = ""
    t = t + "' CHECKPAY.SPK - asks SimPal on %HOST% whether a receipt is good, the way a" + NL
    t = t + "' program (a game shop, Vapor...) checks a payment before handing anything" + NL
    t = t + "' over. Run it with the receipt:   SPARK C:\MYFILES\CHECKPAY.SPK R12-1A2B3C4D" + NL
    t = t + "' Add the merchant, amount and order to have SimPal check those too:" + NL
    t = t + "'   SPARK C:\MYFILES\CHECKPAY.SPK R12-1A2B3C4D myshop 4.99 ORDER17" + NL
    t = t + "' A good receipt answers VALID once; after that it is USED." + NL
    t = t + "CONST PALHOST = ""%HOST%""" + NL
    t = t + "CONST PALPATH = ""%BASE%verify.asp""" + NL
    t = t + "" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR tick AS GUI_Timer" + NL
    t = t + "VAR sock AS NET_Socket" + NL
    t = t + "VAR conn AS NET_Connection" + NL
    t = t + "VAR watch AS GUI_Timer" + NL
    t = t + "VAR reply AS String" + NL
    t = t + "VAR ask AS String" + NL
    t = t + "VAR failed AS String" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    VAR a AS Array OF String" + NL
    t = t + "    a = SYS.Args" + NL
    t = t + "    IF a.Count < 1 THEN" + NL
    t = t + "        Print(""Which receipt? SPARK CHECKPAY.SPK R12-1A2B3C4D [merchant amount order]"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ask = PALPATH + ""?r="" + a[0]" + NL
    t = t + "    IF a.Count >= 4 THEN ask = ask + ""&m="" + a[1] + ""&a="" + a[2] + ""&o="" + a[3]" + NL
    t = t + "    win = GUI_Window.New(""Checking a SimPal receipt"", 320, 40)" + NL
    t = t + "    win.Status = ""Asking "" + PALHOST + ""...""" + NL
    t = t + "    ' Connect from a timer tick, with nothing after the TRY: a refused" + NL
    t = t + "    ' connection spoils the rest of the handler that made it (SIM95-NOTES.md)." + NL
    t = t + "    tick = GUI_Timer.New(win)" + NL
    t = t + "    tick.Interval = 50" + NL
    t = t + "    tick.onTick = Tick_OnTick" + NL
    t = t + "    tick.Start()" + NL
    t = t + "    watch = GUI_Timer.New(win)" + NL
    t = t + "    watch.Interval = 8000" + NL
    t = t + "    watch.onTick = Watch_OnTick" + NL
    t = t + "    watch.Start()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Tick_OnTick ()" + NL
    t = t + "    tick.Stop()" + NL
    t = t + "    sock = NET_Socket.New()" + NL
    t = t + "    sock.onMessage = Sock_OnMessage" + NL
    t = t + "    sock.onClose = Sock_OnClose" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = sock.Connect(PALHOST, 80)" + NL
    t = t + "        conn.Send(""GET "" + ask + "" HTTP/1.0"" + Chr(10) + ""Host: "" + PALHOST.Lower() + Chr(10) + ""User-Agent: CHECKPAY.SPK (SIM95)"")" + NL
    t = t + "    CATCH err" + NL
    t = t + "        failed = err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' No answer in time, or no connection at all." + NL
    t = t + "SUB Watch_OnTick ()" + NL
    t = t + "    IF failed = """" THEN failed = ""no answer""" + NL
    t = t + "    Print(""SimPal on "" + PALHOST + "" did not answer ("" + failed + ""). Don't hand anything over."")" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Sock_OnMessage (c AS NET_Connection, message AS String)" + NL
    t = t + "    reply = reply + message + Chr(10)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The answer is the last line of the page: VALID|merchant|amount|order|buyer|date" + NL
    t = t + "SUB Sock_OnClose (c AS NET_Connection)" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR answer AS String" + NL
    t = t + "    FOR EACH line IN reply.Lines()" + NL
    t = t + "        IF line.Trim() <> """" THEN answer = line.Trim()" + NL
    t = t + "    NEXT" + NL
    t = t + "    Print(answer)" + NL
    t = t + "    IF answer.StartsWith(""VALID|"") THEN" + NL
    t = t + "        Print(""Paid: "" + answer.Split(""|"")[4] + "" paid "" + answer.Split(""|"")[1] + "" "" + answer.Split(""|"")[2] + "" for order "" + answer.Split(""|"")[3] + ""."")" + NL
    t = t + "    ELSE" + NL
    t = t + "        Print(""Not paid. Don't hand anything over."")" + NL
    t = t + "    END IF" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    Put("C:\WEB\CHECKPAY.TXT")
END SUB

SUB File2 ()
    t = ""
    t = t + "<%@ import file=""PAL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' HISTORY.ASP - your transactions, newest first." + NL
    t = t + "RequireLogin()" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""History"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= BoxTop(""Transaction History"") %>" + NL
    t = t + "<p><font size=""2"">Balance: <b><%= Bucks(Balance(viewer)) %></b> &middot; <%= TxCount(viewer) %> transaction(s)<% IF TxCount(viewer) > HISTSHOW THEN %>, the newest <%= HISTSHOW %> shown<% END IF %>.</font></p>" + NL
    t = t + "<table width=""100%"" cellpadding=""3"" cellspacing=""1"">" + NL
    t = t + "<tr bgcolor=""#E6F0FA""><td><font size=""2""><b>Date</b></font></td><td><font size=""2""><b>Description</b></font></td><td align=""right""><font size=""2""><b>Amount</b></font></td><td><font size=""2""><b>No.</b></font></td></tr>" + NL
    t = t + "<%= HistoryHtml(viewer, HISTSHOW) %>" + NL
    t = t + "</table>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\HISTORY.ASP")
END SUB

SUB File3 ()
    t = ""
    t = t + "<%@ import file=""PAL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' HOME.ASP - My Account: the balance, money requests both ways, and the" + NL
    t = t + "' newest transactions." + NL
    t = t + "VAR incoming AS String" + NL
    t = t + "VAR outgoing AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "incoming = RequestsHtml(viewer, TRUE)" + NL
    t = t + "outgoing = RequestsHtml(viewer, FALSE)" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""My Account"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr>" + NL
    t = t + "<td width=""170"" valign=""top"" bgcolor=""#E6F0FA"">" + NL
    t = t + "<font size=""2""><b><%= H(NameOf(viewer)) %></b><br><font color=""#808080""><%= viewer %></font></font>" + NL
    t = t + "<p><font size=""2"">" + NL
    t = t + "<a href=""send.asp""><b>Send Money</b></a><br>" + NL
    t = t + "<a href=""request.asp""><b>Request Money</b></a><br>" + NL
    t = t + "<a href=""history.asp"">History</a><br>" + NL
    t = t + "<a href=""simmart.asp"">Shop at SimMart</a><br>" + NL
    t = t + "<a href=""merchant.asp"">Accept SimPal on your site</a></font></p>" + NL
    t = t + "<%= Padlock() %>" + NL
    t = t + "</td>" + NL
    t = t + "<td valign=""top"">" + NL
    t = t + "<% IF REQUEST.Query(""new"") = ""1"" THEN %>" + NL
    t = t + "<%= Notice(""Welcome to SimPal! We have put "" + Bucks(BONUS).Replace(""&sect;"", ""§"") + "" in your account to get you started."") %>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= Notice(REQUEST.Query(""why"")) %>" + NL
    t = t + "<%= BoxTop(""My Balance"") %>" + NL
    t = t + "<p><font size=""6"" color=""#003087""><b><%= Bucks(Balance(viewer)) %></b></font>" + NL
    t = t + "<font size=""2"" color=""#808080"">&nbsp;available SimBucks</font></p>" + NL
    t = t + "<% IF incoming <> """" THEN %>" + NL
    t = t + "<%= BoxTop(""Money Requests for You"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""3""><%= incoming %></table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<% IF outgoing <> """" THEN %>" + NL
    t = t + "<%= BoxTop(""Your Requests Waiting"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""3""><%= outgoing %></table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= BoxTop(""Recent Activity"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""3"" cellspacing=""1""><%= HistoryHtml(viewer, HOMESHOW) %></table>" + NL
    t = t + "<p><font size=""2""><a href=""history.asp"">See all my transactions</a></font></p>" + NL
    t = t + "</td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\HOME.ASP")
END SUB

SUB File4 ()
    t = ""
    t = t + "<%@ import file=""PAL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' INDEX.ASP - the front door: log in, or sign up and get the welcome bonus." + NL
    t = t + "' Members go straight to their account." + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR nextPage AS String" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "IF viewer <> """" THEN RESPONSE.Redirect(""home.asp"")" + NL
    t = t + "nextPage = REQUEST.Query(""next"")" + NL
    t = t + "SELECT CASE REQUEST.Query(""e"")" + NL
    t = t + "    CASE ""login""" + NL
    t = t + "        problem = ""That user name and password do not match.""" + NL
    t = t + "    CASE ""join""" + NL
    t = t + "        problem = REQUEST.Query(""why"")" + NL
    t = t + "    CASE ""bye""" + NL
    t = t + "        problem = ""You have logged out. Thank you for using SimPal!""" + NL
    t = t + "END SELECT" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Welcome"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""10"" cellspacing=""0""><tr>" + NL
    t = t + "<td width=""55%"" valign=""top"">" + NL
    t = t + "<h2><font color=""#003087"">Send money to anyone with a SimPal account!</font></h2>" + NL
    t = t + "<p>SimPal is the fast, easy and <b>secure</b> way to pay and get paid on the SIM95 network." + NL
    t = t + "No checks, no stamps, no waiting for the bank to open.</p>" + NL
    t = t + "<ul>" + NL
    t = t + "<li><b>Send money</b> to any member in seconds</li>" + NL
    t = t + "<li><b>Request money</b> from friends who owe you</li>" + NL
    t = t + "<li><b>Shop online</b> wherever you see the <b>Pay with SimPal</b> button</li>" + NL
    t = t + "<li><b>Accept payments</b> on your own web site: <a href=""merchant.asp"">find out how</a></li>" + NL
    t = t + "</ul>" + NL
    t = t + "<p>Sign up today and we'll put <b><%= Bucks(BONUS) %></b> in your account. <b>FREE!</b></p>" + NL
    t = t + "<%= Padlock() %>" + NL
    t = t + "<p><font size=""2"" color=""#808080"">All money is in SimBucks (&sect;), kept on <%= H(SERVER.Name) %>'s" + NL
    t = t + "disk in C:\PALDATA. Every penny is written in the ledger before it moves.</font></p>" + NL
    t = t + "</td>" + NL
    t = t + "<td width=""45%"" valign=""top"">" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<%= BoxTop(""Member Log In"") %>" + NL
    t = t + "<form action=""login.asp"" method=""post"">" + NL
    t = t + "<input type=""hidden"" name=""next"" value=""<%= H(nextPage) %>"">" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td><font size=""2"">User name:</font></td><td><input name=""u"" size=""16""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Password:</font></td><td><input type=""password"" name=""pw"" size=""16""></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Log In""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "</form>" + NL
    t = t + "<%= BoxTop(""Sign Up - It's Free!"") %>" + NL
    t = t + "<form action=""join.asp"" method=""post"">" + NL
    t = t + "<input type=""hidden"" name=""next"" value=""<%= H(nextPage) %>"">" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td><font size=""2"">Full name:</font></td><td><input name=""name"" size=""20""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">User name:</font></td><td><input name=""u"" size=""16""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Password:</font></td><td><input type=""password"" name=""pw"" size=""16""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Again:</font></td><td><input type=""password"" name=""pw2"" size=""16""></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Sign Up""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "<p><font size=""1"" color=""#808080"">User names are 3 to 8 letters or digits. Shops sign up the same way.</font></p>" + NL
    t = t + "</form>" + NL
    t = t + "</td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\INDEX.ASP")
END SUB

SUB File5 ()
    t = ""
    t = t + "<%@ import file=""PAL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' JOIN.ASP - opens a new account (with its welcome bonus) and signs it in." + NL
    t = t + "VAR u AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR nextPage AS String" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "u = REQUEST.Form(""u"").Trim().Lower()" + NL
    t = t + "nextPage = REQUEST.Form(""next"")" + NL
    t = t + "IF NOT nextPage.StartsWith(""pay.asp?"") OR nextPage.Contains(Chr(10)) THEN nextPage = ""home.asp?new=1""" + NL
    t = t + "IF REQUEST.Form(""pw"") <> REQUEST.Form(""pw2"") THEN" + NL
    t = t + "    problem = ""The two passwords are different.""" + NL
    t = t + "ELSE" + NL
    t = t + "    problem = CreateUser(u, REQUEST.Form(""pw""), REQUEST.Form(""name""))" + NL
    t = t + "END IF" + NL
    t = t + "IF problem <> """" THEN RESPONSE.Redirect(""index.asp?e=join&why="" + UrlEnc(problem) + ""&next="" + UrlEnc(REQUEST.Form(""next"")))" + NL
    t = t + "SignIn(u)" + NL
    t = t + "RESPONSE.Redirect(nextPage)" + NL
    t = t + "%>" + NL
    Put("C:\WEB\JOIN.ASP")
END SUB

SUB File6 ()
    t = ""
    t = t + "<%@ import file=""PAL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' LOGIN.ASP - checks the password, hands out a session cookie, and moves on:" + NL
    t = t + "' to the account page, or back to a checkout (next=pay.asp?...)." + NL
    t = t + "VAR u AS String" + NL
    t = t + "VAR nextPage AS String" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "u = CleanName(REQUEST.Form(""u""))" + NL
    t = t + "nextPage = REQUEST.Form(""next"")" + NL
    t = t + "IF NOT nextPage.StartsWith(""pay.asp?"") OR nextPage.Contains(Chr(10)) THEN nextPage = ""home.asp""" + NL
    t = t + "IF u = """" OR NOT CheckPassword(u, REQUEST.Form(""pw"")) THEN" + NL
    t = t + "    IF nextPage = ""home.asp"" THEN RESPONSE.Redirect(""index.asp?e=login"")" + NL
    t = t + "    RESPONSE.Redirect(nextPage + ""&e=login"")" + NL
    t = t + "END IF" + NL
    t = t + "SignIn(u)" + NL
    t = t + "RESPONSE.Redirect(nextPage)" + NL
    t = t + "%>" + NL
    Put("C:\WEB\LOGIN.ASP")
END SUB

SUB File7 ()
    t = ""
    t = t + "<%@ import file=""PAL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' LOGOUT.ASP?t=token - forgets the session. The token stops another site from" + NL
    t = t + "' logging you out." + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "SignOut()" + NL
    t = t + "RESPONSE.Redirect(""index.asp?e=bye"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\LOGOUT.ASP")
END SUB

SUB File8 ()
    t = ""
    t = t + "<%@ import file=""PAL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' MERCHANT.ASP - SimPal for your web site: the Pay with SimPal button to copy" + NL
    t = t + "' into your own pages, and the two ways to check a receipt before you ship." + NL
    t = t + "VAR shop AS String" + NL
    t = t + "VAR button AS String" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "shop = viewer" + NL
    t = t + "IF shop = """" THEN shop = ""yourname""" + NL
    t = t + "button = ""<form action="""""" + SiteUrl() + ""pay.asp"""" method=""""post"""">"" + Chr(10) _" + NL
    t = t + "       + ""<input type=""""hidden"""" name=""""to"""" value="""""" + shop + """""">"" + Chr(10) _" + NL
    t = t + "       + ""<input type=""""hidden"""" name=""""amount"""" value=""""4.99"""">"" + Chr(10) _" + NL
    t = t + "       + ""<input type=""""hidden"""" name=""""item"""" value=""""One widget"""">"" + Chr(10) _" + NL
    t = t + "       + ""<input type=""""hidden"""" name=""""order"""" value=""""ORDER17"""">"" + Chr(10) _" + NL
    t = t + "       + ""<input type=""""hidden"""" name=""""return"""" value=""""http://yourmachine/thanks.asp"""">"" + Chr(10) _" + NL
    t = t + "       + ""<input type=""""submit"""" value=""""Pay with SimPal"""">"" + Chr(10) _" + NL
    t = t + "       + ""</form>""" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""SimPal for your web site"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<h2><font color=""#003087"">SimPal for your web site</font></h2>" + NL
    t = t + "<p>Selling something? Put a <b>Pay with SimPal</b> button on your home page and take" + NL
    t = t + "SimBucks from anybody on the network, in three easy steps. No merchant account, no" + NL
    t = t + "monthly fees, no setup charges. <b>It's FREE!</b></p>" + NL
    t = t + "<%= BoxTop(""Step 1: Get a SimPal account for your shop"") %>" + NL
    t = t + "<p><font size=""2""><% IF viewer = """" THEN %><a href=""index.asp"">Sign up</a> (shops sign up just like anybody else). Your user name is your shop's SimPal name.<% ELSE %>You are signed in as <b><%= viewer %></b>, so the button below pays you.<% END IF %></font></p>" + NL
    t = t + "<%= BoxTop(""Step 2: Paste the button into your page"") %>" + NL
    t = t + "<p><font size=""2"">Change the amount, the item and the address SimPal sends the buyer back to. Give every" + NL
    t = t + "sale its own <b>order</b> number (letters, digits and <tt>- _ . # : /</tt>, up to <%= MAXORDER %>): SimPal takes payment for an order once.</font></p>" + NL
    t = t + "<form><textarea rows=""9"" cols=""76"" readonly><%= H(button) %></textarea></form>" + NL
    t = t + "<p><font size=""2"">A link works too:</font><br><tt><font size=""2""><%= H(SiteUrl()) %>pay.asp?to=<%= shop %>&amp;amount=4.99&amp;item=One+widget&amp;order=ORDER17&amp;return=http://yourmachine/thanks.asp</font></tt></p>" + NL
    t = t + "<p><font size=""2"">It looks like this: <%= button.Replace(""action="""""" + SiteUrl() + ""pay.asp"""""", ""action=""""pay.asp"""""") %></font></p>" + NL
    t = t + "<%= BoxTop(""Step 3: Check the receipt, then ship"") %>" + NL
    t = t + "<p><font size=""2"">After paying, the buyer comes back to your address with" + NL
    t = t + "<tt>?receipt=R12-1A2B3C4D&amp;order=ORDER17</tt> on the end. <b>Anybody can type that in.</b> So before you" + NL
    t = t + "hand anything over, ask SimPal whether the receipt is real, paid <i>you</i> the right amount for" + NL
    t = t + "<i>that</i> order, and hasn't been used before. A receipt says yes once only.</font></p>" + NL
    t = t + "<p><font size=""2""><b>(a) Your page is on this machine (<%= H(SERVER.Name.Lower()) %>).</b> Import" + NL
    t = t + "<tt>C:\PROGRAMS\PALCHECK.SPK</tt> and call <tt>VerifyReceipt(receipt, merchant, amount, order)</tt>. It reads" + NL
    t = t + "SimPal's books straight off the disk. A whole return page:</font></p>" + NL
    t = t + "<form><textarea rows=""12"" cols=""76"" readonly><%= H(ReadOr(AppDir() + ""\THANKS.TXT"", """").Replace(""%MERCHANT%"", shop)) %></textarea></form>" + NL
    t = t + "<p><font size=""2"">SimPal's own <a href=""simmart.asp"">SimMart</a> works exactly this way.</font></p>" + NL
    t = t + "<p><font size=""2""><b>(b) Your shop is on another machine.</b> A web page there can't open a connection," + NL
    t = t + "but a SPARK program can (Vapor does). Fetch <tt><%= H(SiteUrl()) %>verify.asp?r=RECEIPT</tt>, adding" + NL
    t = t + "<tt>&amp;m=merchant&amp;a=amount&amp;o=order</tt> to have SimPal check those too. The answer is one line of plain text:</font></p>" + NL
    t = t + "<table cellpadding=""3"" border=""1""><tr><td><tt>VALID|merchant|amount|order|buyer|date</tt></td><td><font size=""2"">Paid. Now used up: ship it.</font></td></tr>" + NL
    t = t + "<tr><td><tt>USED|merchant|amount|order|buyer|date</tt></td><td><font size=""2"">Somebody checked this receipt before. Don't ship twice.</font></td></tr>" + NL
    t = t + "<tr><td><tt>INVALID|why</tt></td><td><font size=""2"">No such receipt, or it doesn't match what you asked.</font></td></tr>" + NL
    t = t + "<tr><td><tt>BUSY|try again</tt></td><td><font size=""2"">SimPal was busy. Ask again.</font></td></tr></table>" + NL
    t = t + "<p><font size=""2"">This program does it. Save it as <tt>C:\MYFILES\CHECKPAY.SPK</tt> and run it with the receipt:</font></p>" + NL
    t = t + "<form><textarea rows=""12"" cols=""76"" readonly><%= H(ReadOr(AppDir() + ""\CHECKPAY.TXT"", """").Replace(""%HOST%"", SERVER.Name.Lower()).Replace(""%BASE%"", SiteUrl().Substring(7 + SERVER.Name.Length, SiteUrl().Length - 7 - SERVER.Name.Length))) %></textarea></form>" + NL
    t = t + "<%= BoxTop(""Read this first: how much to trust SimPal"") %>" + NL
    t = t + "<ul><font size=""2"">" + NL
    t = t + "<li><b>It's play money.</b> SimBucks are worth nothing outside SIM95, and SimPal is a toy. Please don't build a real bank like this.</li>" + NL
    t = t + "<li><b>Whoever runs <%= H(SERVER.Name.Lower()) %> is the bank.</b> They can print SimBucks (the welcome bonus and grants) and read or change anything in <tt>C:\PALDATA</tt>. You are trusting them.</li>" + NL
    t = t + "<li><b>The button is just HTML.</b> A buyer can save your page and change the price. That's why you check the amount when you verify.</li>" + NL
    t = t + "<li><b>Coming back proves nothing.</b> Only a VALID answer does.</li>" + NL
    t = t + "<li><b>Nothing is encrypted.</b> SIM95 has no SSL; anybody running Monitor can read passwords and receipts as they go by. The padlock is decoration.</li>" + NL
    t = t + "<li><b>A receipt is a password for one order.</b> The buyer knows it too and could use it up by checking it first. They'd only be hurting themselves.</li>" + NL
    t = t + "<li><b>Refunds:</b> send the money back by hand, with Send Money.</li>" + NL
    t = t + "</font></ul>" + NL
    t = t + "</td><td width=""200"" valign=""top""><%= Padlock() %></td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\MERCHANT.ASP")
END SUB

SUB File9 ()
    t = ""
    t = t + "' PAL.SPK - SimPal, the way to send money on the SIM95 network (in SimBucks)." + NL
    t = t + "' Every page pulls this in with <%@ import file=""PAL.SPK"" %>. SimPal is the" + NL
    t = t + "' machine's home page (C:\WEB), or on a SimHost machine lives in C:\WEB\PAL." + NL
    t = t + "'" + NL
    t = t + "' Money is kept in whole cents, as Integers, everywhere: §12.50 is 1250." + NL
    t = t + "'" + NL
    t = t + "' Everything lives in plain text files under C:\PALDATA (outside C:\WEB, so the" + NL
    t = t + "' web server never hands it out):" + NL
    t = t + "'" + NL
    t = t + "'   C:\PALDATA\LEDGER\<n>.TXT     every transaction, LOGSIZE to a file: the books" + NL
    t = t + "'   C:\PALDATA\NEXTID.TXT         the last transaction number handed out" + NL
    t = t + "'   C:\PALDATA\APPLIED.TXT        every transaction up to this one is in the balances" + NL
    t = t + "'   C:\PALDATA\BAL\<user>.TXT     cents|last transaction applied to them" + NL
    t = t + "'   C:\PALDATA\HIST\<user>.TXT    |3|7|12|  their transactions, for the history page" + NL
    t = t + "'   C:\PALDATA\USERS\<user>.TXT   profile, key=value per line (password salted + hashed)" + NL
    t = t + "'   C:\PALDATA\PEOPLE.TXT         user|name, one per member" + NL
    t = t + "'   C:\PALDATA\REQUESTS.TXT       money requests, one per line (NEXTREQ.TXT counts them)" + NL
    t = t + "'   C:\PALDATA\ORDERS\<user>.TXT  order|receipt: what each merchant has been paid for" + NL
    t = t + "'   C:\PALDATA\USED\<n>.TXT       receipt n has been verified (see PALCHECK.SPK)" + NL
    t = t + "'   C:\PALDATA\SESSIONS\<id>.TXT  sign-in cookie -> user, form token" + NL
    t = t + "'   C:\PALDATA\LOCK\              exists while a page is moving money" + NL
    t = t + "'" + NL
    t = t + "' A transaction is one ledger line:" + NL
    t = t + "'   id|date time|kind|from|to|cents|note|ref|order" + NL
    t = t + "' kind is bonus or grant (from is ""*"", the bank), send, req (a request paid;" + NL
    t = t + "' ref is Q<request>) or pay (a ""Pay with SimPal"" purchase; ref is its receipt)." + NL
    t = t + "'" + NL
    t = t + "' The ledger is the truth; balances are a cache of it. Moving money goes:" + NL
    t = t + "'   1. take the lock (a folder: FS.MakeDir fails when it exists, so only one page" + NL
    t = t + "'      can make it), and finish anything a page that died left half done;" + NL
    t = t + "'   2. check the payer has the money;" + NL
    t = t + "'   3. append the ledger line - one FS.Append, so it is there or it isn't;" + NL
    t = t + "'   4. apply it: each side's balance file, their history, the merchant's orders," + NL
    t = t + "'      the request's status. Each step looks first and does nothing twice;" + NL
    t = t + "'   5. write APPLIED.TXT, and let go of the lock." + NL
    t = t + "' A page that dies after 3 leaves APPLIED.TXT behind the ledger. The next page" + NL
    t = t + "' to take the lock applies the rest (Recover), and until then every balance" + NL
    t = t + "' read adds in the ledger lines it is missing (Balance). Money can't be made" + NL
    t = t + "' or lost in between. Only lines 1 and 3 ever add to the money supply: bonus" + NL
    t = t + "' and grant, so the sum of all balances is always the sum of those." + NL
    t = t + "" + NL
    t = t + "CONST DATADIR = ""C:\PALDATA""" + NL
    t = t + "CONST LOCKDIR = ""C:\PALDATA\LOCK""" + NL
    t = t + "CONST COOKIE = ""simpal""" + NL
    t = t + "CONST BANK = ""*""" + NL
    t = t + "CONST BONUS = 10000           ' the welcome bonus, in cents: §100.00" + NL
    t = t + "CONST MAXSEND = 1000000       ' at most §10,000.00 in one go" + NL
    t = t + "CONST MAXGRANT = 10000000     ' the owner can print up to §100,000.00 at a time" + NL
    t = t + "CONST LOGSIZE = 500           ' transactions to a ledger file" + NL
    t = t + "CONST MAXNAME = 40" + NL
    t = t + "CONST MAXNOTE = 100" + NL
    t = t + "CONST MAXITEM = 60" + NL
    t = t + "CONST MAXORDER = 40" + NL
    t = t + "CONST MAXURL = 200" + NL
    t = t + "CONST HISTSHOW = 40           ' transactions on the history page" + NL
    t = t + "CONST HOMESHOW = 8            ' and on the account page" + NL
    t = t + "CONST REQSHOW = 15            ' requests listed each way" + NL
    t = t + "CONST LOCKSTALE = 10          ' seconds: a lock older than this was left by a page that died" + NL
    t = t + "CONST ADMINSHOW = 150         ' accounts listed on the admin page," + NL
    t = t + "CONST ADMINROOM = 30000       ' and as many characters of them as fit (64K a page)" + NL
    t = t + "" + NL
    t = t + "VAR viewer AS String          ' who is signed in; """" for nobody" + NL
    t = t + "VAR formToken AS String       ' their session's form token; see RequireToken" + NL
    t = t + "VAR lastRef AS String         ' the receipt of the purchase just made (PayMerchant)" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the disk" + NL
    t = t + "" + NL
    t = t + "' C:\WEB, or C:\WEB\PAL when SimPal is in a folder of its own." + NL
    t = t + "FUNCTION AppDir () AS String" + NL
    t = t + "    VAR page AS String" + NL
    t = t + "    page = SERVER.ScriptName" + NL
    t = t + "    RETURN page.Substring(0, page.Length - page.Split(""\"")[page.Split(""\"").Count - 1].Length - 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where SimPal is on the web: http://host/ or http://host/pal/" + NL
    t = t + "FUNCTION SiteUrl () AS String" + NL
    t = t + "    IF AppDir().Upper() = ""C:\WEB"" THEN RETURN ""http://"" + SERVER.Name.Lower() + ""/""" + NL
    t = t + "    RETURN ""http://"" + SERVER.Name.Lower() + ""/"" + AppDir().Substring(7, AppDir().Length - 7).Replace(""\"", ""/"").Lower() + ""/""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB EnsureDisk ()" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR dirs AS Array OF String" + NL
    t = t + "    dirs = ["""", ""\USERS"", ""\BAL"", ""\HIST"", ""\LEDGER"", ""\ORDERS"", ""\USED"", ""\SESSIONS""]" + NL
    t = t + "    FOR EACH dir IN dirs" + NL
    t = t + "        IF NOT FS.Exists(DATADIR + dir) THEN" + NL
    t = t + "            TRY" + NL
    t = t + "                FS.MakeDir(DATADIR + dir)" + NL
    t = t + "            CATCH err" + NL
    t = t + "            END TRY" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    text = fallback" + NL
    t = t + "    ' another page may delete it between the two, so a failed read is ""not there""" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(path) THEN text = FS.Read(path)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        text = fallback" + NL
    t = t + "    END TRY" + NL
    t = t + "    RETURN text" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Text that is safe inside one |-separated line, and back again." + NL
    t = t + "FUNCTION Esc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%"", ""%25"").Replace(""|"", ""%7C"").Replace(Chr(13), """").Replace(Chr(10), ""%0A"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unesc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%0A"", Chr(10)).Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION H (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.HtmlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UrlEnc (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.UrlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION OnlyFrom (s AS String, allowed AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        IF NOT allowed.Contains(s.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A user name is also a file name, and file names here are 8.3." + NL
    t = t + "FUNCTION ValidName (u AS String) AS Bool" + NL
    t = t + "    IF u.Length < 3 OR u.Length > 8 THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyFrom(u, ""abcdefghijklmnopqrstuvwxyz0123456789"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CleanName (u AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = u.Trim().Lower()" + NL
    t = t + "    IF ValidName(s) THEN RETURN s" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Clip (s AS String, most AS Integer) AS String" + NL
    t = t + "    s = s.Replace(Chr(13), """").Replace(Chr(10), "" "").Trim()" + NL
    t = t + "    IF s.Length > most THEN s = s.Substring(0, most)" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsNumber (s AS String) AS Bool" + NL
    t = t + "    IF s = """" OR s.Length > 8 THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyFrom(s, ""0123456789"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The line in text (lines of ""key|..."") that starts with key, or """"." + NL
    t = t + "FUNCTION FindLine (text AS String, key AS String) AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    text = Chr(10) + text" + NL
    t = t + "    at = text.IndexOf(Chr(10) + key + ""|"")" + NL
    t = t + "    IF at < 0 THEN RETURN """"" + NL
    t = t + "    text = text.Substring(at + 1, text.Length - at - 1)" + NL
    t = t + "    at = text.IndexOf(Chr(10))" + NL
    t = t + "    IF at >= 0 THEN text = text.Substring(0, at)" + NL
    t = t + "    RETURN text" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Stamp () AS String" + NL
    t = t + "    RETURN TIME.Date + "" "" + TIME.Clock.Substring(0, 5)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Counter (name AS String) AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    n = Int(Val(ReadOr(DATADIR + ""\"" + name + "".TXT"", ""0""))) + 1" + NL
    t = t + "    FS.Write(DATADIR + ""\"" + name + "".TXT"", Str(n))" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- money" + NL
    t = t + "" + NL
    t = t + "' What someone typed as cents: ""12"", ""12.5"", ""12.50"", ""§12.50"", ""$1,000""." + NL
    t = t + "' -1 when it is not an amount (negative ones included)." + NL
    t = t + "FUNCTION ParseCents (s AS String) AS Integer" + NL
    t = t + "    VAR whole AS String" + NL
    t = t + "    VAR frac AS String" + NL
    t = t + "    VAR dot AS Integer" + NL
    t = t + "    s = s.Trim().Replace("","", """")" + NL
    t = t + "    IF s.StartsWith(""§"") OR s.StartsWith(""$"") THEN s = s.Substring(1, s.Length - 1).Trim()" + NL
    t = t + "    dot = s.IndexOf(""."")" + NL
    t = t + "    whole = s" + NL
    t = t + "    IF dot >= 0 THEN" + NL
    t = t + "        whole = s.Substring(0, dot)" + NL
    t = t + "        frac = s.Substring(dot + 1, s.Length - dot - 1)" + NL
    t = t + "        IF frac = """" THEN RETURN -1" + NL
    t = t + "    END IF" + NL
    t = t + "    IF whole = """" THEN whole = ""0""" + NL
    t = t + "    IF whole.Length > 7 OR frac.Length > 2 THEN RETURN -1" + NL
    t = t + "    IF NOT OnlyFrom(whole, ""0123456789"") OR NOT OnlyFrom(frac, ""0123456789"") THEN RETURN -1" + NL
    t = t + "    frac = (frac + ""00"").Substring(0, 2)" + NL
    t = t + "    RETURN Int(Val(whole)) * 100 + Int(Val(frac))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Cents as plain text: 1250 -> ""12.50"". This is what buttons and verify.asp use." + NL
    t = t + "FUNCTION Amt (c AS Integer) AS String" + NL
    t = t + "    VAR sign AS String" + NL
    t = t + "    VAR frac AS String" + NL
    t = t + "    IF c < 0 THEN" + NL
    t = t + "        sign = ""-""" + NL
    t = t + "        c = 0 - c" + NL
    t = t + "    END IF" + NL
    t = t + "    frac = Str(c MOD 100)" + NL
    t = t + "    IF frac.Length < 2 THEN frac = ""0"" + frac" + NL
    t = t + "    RETURN sign + Str(Int(c / 100)) + ""."" + frac" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Cents for a page: 123456 -> ""&sect;1,234.56""" + NL
    t = t + "FUNCTION Bucks (c AS Integer) AS String" + NL
    t = t + "    VAR sign AS String" + NL
    t = t + "    VAR whole AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR frac AS String" + NL
    t = t + "    IF c < 0 THEN" + NL
    t = t + "        sign = ""-""" + NL
    t = t + "        c = 0 - c" + NL
    t = t + "    END IF" + NL
    t = t + "    frac = Str(c MOD 100)" + NL
    t = t + "    IF frac.Length < 2 THEN frac = ""0"" + frac" + NL
    t = t + "    whole = Str(Int(c / 100))" + NL
    t = t + "    WHILE whole.Length > 3" + NL
    t = t + "        out = "","" + whole.Substring(whole.Length - 3, 3) + out" + NL
    t = t + "        whole = whole.Substring(0, whole.Length - 3)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN sign + ""&sect;"" + whole + out + ""."" + frac" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the lock" + NL
    t = t + "" + NL
    t = t + "' Only one page at a time may move money. The lock is a folder, because" + NL
    t = t + "' FS.MakeDir fails when the folder is already there: checking and taking it is" + NL
    t = t + "' one step, which no other page can get in between. A page that dies holding" + NL
    t = t + "' it leaves it behind; after LOCKSTALE seconds the next page clears it." + NL
    t = t + "FUNCTION TakeLock () AS Bool" + NL
    t = t + "    VAR tries AS Integer" + NL
    t = t + "    VAR got AS Bool" + NL
    t = t + "    VAR at AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    WHILE NOT got AND tries < 150" + NL
    t = t + "        tries = tries + 1" + NL
    t = t + "        TRY" + NL
    t = t + "            FS.MakeDir(LOCKDIR)" + NL
    t = t + "            got = TRUE" + NL
    t = t + "        CATCH err" + NL
    t = t + "            got = FALSE" + NL
    t = t + "        END TRY" + NL
    t = t + "        IF NOT got THEN" + NL
    t = t + "            at = ReadOr(LOCKDIR + ""\AT.TXT"", """")" + NL
    t = t + "            IF (at <> """" AND TIME.Now - Int(Val(at)) > LOCKSTALE) OR (at = """" AND tries MOD 50 = 0) THEN" + NL
    t = t + "                DropLock()" + NL
    t = t + "            ELSE" + NL
    t = t + "                SYS.Sleep(20)" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF got THEN FS.Write(LOCKDIR + ""\AT.TXT"", Str(TIME.Now))" + NL
    t = t + "    RETURN got" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB DropLock ()" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(LOCKDIR + ""\AT.TXT"") THEN FS.Delete(LOCKDIR + ""\AT.TXT"")" + NL
    t = t + "        IF FS.Exists(LOCKDIR) THEN FS.Delete(LOCKDIR)" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "CONST BUSY = ""SimPal is very busy right now. Nothing was changed: please try again in a moment.""" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the ledger" + NL
    t = t + "" + NL
    t = t + "FUNCTION ChunkPath (id AS Integer) AS String" + NL
    t = t + "    RETURN DATADIR + ""\LEDGER\"" + Str(Int((id - 1) / LOGSIZE)) + "".TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LastId () AS Integer" + NL
    t = t + "    RETURN Int(Val(ReadOr(DATADIR + ""\NEXTID.TXT"", ""0"")))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION AppliedId () AS Integer" + NL
    t = t + "    RETURN Int(Val(ReadOr(DATADIR + ""\APPLIED.TXT"", ""0"")))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Transaction id's ledger line, or """"." + NL
    t = t + "FUNCTION FindTx (id AS Integer) AS String" + NL
    t = t + "    IF id < 1 THEN RETURN """"" + NL
    t = t + "    RETURN FindLine(ReadOr(ChunkPath(id), """"), Str(id))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Every ledger line after transaction number after, oldest first." + NL
    t = t + "FUNCTION LinesAfter (after AS Integer) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR last AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    last = LastId()" + NL
    t = t + "    IF last <= after THEN RETURN out" + NL
    t = t + "    FOR c = Int(after / LOGSIZE) TO Int((last - 1) / LOGSIZE)" + NL
    t = t + "        FOR EACH line IN ReadOr(DATADIR + ""\LEDGER\"" + Str(c) + "".TXT"", """").Lines()" + NL
    t = t + "            IF line = """" THEN CONTINUE" + NL
    t = t + "            IF Int(Val(line.Split(""|"")[0])) > after THEN out.Add(line)" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' What one ledger line does to u's balance." + NL
    t = t + "FUNCTION Effect (line AS String, u AS String) AS Integer" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    IF p.Count < 9 THEN RETURN 0" + NL
    t = t + "    IF p[3] = u THEN RETURN 0 - Int(Val(p[5]))" + NL
    t = t + "    IF p[4] = u THEN RETURN Int(Val(p[5]))" + NL
    t = t + "    RETURN 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' u's balance file: cents, and the last transaction applied to it." + NL
    t = t + "FUNCTION BalRec (u AS String) AS Array OF String" + NL
    t = t + "    VAR rec AS Array OF String" + NL
    t = t + "    rec = (ReadOr(DATADIR + ""\BAL\"" + u + "".TXT"", ""0|0"").Trim() + ""|0"").Split(""|"")" + NL
    t = t + "    RETURN rec" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' u's balance: the cached one, plus any ledger lines not applied yet. APPLIED.TXT" + NL
    t = t + "' is read before the cache, so a transfer finishing meanwhile is counted once." + NL
    t = t + "FUNCTION Balance (u AS String) AS Integer" + NL
    t = t + "    VAR applied AS Integer" + NL
    t = t + "    VAR rec AS Array OF String" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR seen AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    applied = AppliedId()" + NL
    t = t + "    rec = BalRec(u)" + NL
    t = t + "    c = Int(Val(rec[0]))" + NL
    t = t + "    seen = Int(Val(rec[1]))" + NL
    t = t + "    IF applied > seen THEN seen = applied" + NL
    t = t + "    FOR EACH line IN LinesAfter(seen)" + NL
    t = t + "        c = c + Effect(line, u)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN c" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One side of a transaction. Does nothing if u has had it already." + NL
    t = t + "SUB Book (u AS String, id AS Integer, delta AS Integer)" + NL
    t = t + "    VAR rec AS Array OF String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    rec = BalRec(u)" + NL
    t = t + "    IF Int(Val(rec[1])) >= id THEN RETURN" + NL
    t = t + "    path = DATADIR + ""\HIST\"" + u + "".TXT""" + NL
    t = t + "    IF NOT ReadOr(path, ""|"").Contains(""|"" + Str(id) + ""|"") THEN FS.Write(path, ReadOr(path, ""|"") + Str(id) + ""|"")" + NL
    t = t + "    FS.Write(DATADIR + ""\BAL\"" + u + "".TXT"", Str(Int(Val(rec[0])) + delta) + ""|"" + Str(id))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Everything a ledger line means, besides being in the ledger. Safe to repeat." + NL
    t = t + "SUB Apply (line AS String)" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    IF p.Count < 9 THEN RETURN" + NL
    t = t + "    id = Int(Val(p[0]))" + NL
    t = t + "    c = Int(Val(p[5]))" + NL
    t = t + "    IF p[3] <> BANK THEN Book(p[3], id, 0 - c)" + NL
    t = t + "    Book(p[4], id, c)" + NL
    t = t + "    IF p[2] = ""pay"" THEN AddOrder(p[4], Unesc(p[8]), p[7])" + NL
    t = t + "    IF p[2] = ""req"" AND p[7].StartsWith(""Q"") THEN SetReqStatus(p[7].Substring(1, p[7].Length - 1), ""paid"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' With the lock held: apply whatever a page that died left unapplied." + NL
    t = t + "SUB Recover ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR last AS Integer" + NL
    t = t + "    last = LastId()" + NL
    t = t + "    IF AppliedId() >= last THEN RETURN" + NL
    t = t + "    FOR EACH line IN LinesAfter(AppliedId())" + NL
    t = t + "        Apply(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Write(DATADIR + ""\APPLIED.TXT"", Str(last))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' With the lock held and the checks done: one transaction, ledger first." + NL
    t = t + "' Returns its number; a purchase's receipt is left in lastRef." + NL
    t = t + "FUNCTION Post (kind AS String, from AS String, payee AS String, cents AS Integer, note AS String, ref AS String, order AS String) AS Integer" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    id = Counter(""NEXTID"")" + NL
    t = t + "    IF kind = ""pay"" THEN ref = ""R"" + Str(id) + ""-"" + NewToken()" + NL
    t = t + "    line = Str(id) + ""|"" + Stamp() + ""|"" + kind + ""|"" + from + ""|"" + payee + ""|"" + Str(cents) + ""|"" + Esc(note) + ""|"" + ref + ""|"" + Esc(order)" + NL
    t = t + "    FS.Append(ChunkPath(id), line + Chr(10))" + NL
    t = t + "    Apply(line)" + NL
    t = t + "    FS.Write(DATADIR + ""\APPLIED.TXT"", Str(id))" + NL
    t = t + "    lastRef = ref" + NL
    t = t + "    RETURN id" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Checks an amount someone typed. Returns """" or what is wrong." + NL
    t = t + "FUNCTION AmountProblem (cents AS Integer, most AS Integer) AS String" + NL
    t = t + "    IF cents < 0 THEN RETURN ""That isn't an amount of money. Type it like 5 or 12.50 (and no minus signs, please).""" + NL
    t = t + "    IF cents = 0 THEN RETURN ""Type an amount, like 5 or 12.50.""" + NL
    t = t + "    IF cents > most THEN RETURN ""The most you can move at once is "" + Bucks(most).Replace(""&sect;"", ""§"") + "".""" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Money from one member to another. Returns """" or what is wrong." + NL
    t = t + "FUNCTION SendMoney (from AS String, payee AS String, amount AS String, note AS String) AS String" + NL
    t = t + "    VAR cents AS Integer" + NL
    t = t + "    VAR problem AS String" + NL
    t = t + "    cents = ParseCents(amount)" + NL
    t = t + "    problem = AmountProblem(cents, MAXSEND)" + NL
    t = t + "    IF problem <> """" THEN RETURN problem" + NL
    t = t + "    payee = payee.Trim().Lower()" + NL
    t = t + "    IF NOT UserExists(payee) THEN RETURN ""There is no SimPal member called """""" + Clip(payee, 20) + """""".""" + NL
    t = t + "    IF payee = from THEN RETURN ""You can't send money to yourself. (Nice try!)""" + NL
    t = t + "    note = Clip(note, MAXNOTE)" + NL
    t = t + "    IF NOT TakeLock() THEN RETURN BUSY" + NL
    t = t + "    Recover()" + NL
    t = t + "    IF Balance(from) < cents THEN" + NL
    t = t + "        problem = ""Insufficient funds: you have "" + Bucks(Balance(from)).Replace(""&sect;"", ""§"") + "".""" + NL
    t = t + "    ELSE" + NL
    t = t + "        Post(""send"", from, payee, cents, note, """", """")" + NL
    t = t + "    END IF" + NL
    t = t + "    DropLock()" + NL
    t = t + "    RETURN problem" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The machine's owner prints money. Returns """" or what is wrong." + NL
    t = t + "FUNCTION Grant (payee AS String, amount AS String, note AS String) AS String" + NL
    t = t + "    VAR cents AS Integer" + NL
    t = t + "    VAR problem AS String" + NL
    t = t + "    cents = ParseCents(amount)" + NL
    t = t + "    problem = AmountProblem(cents, MAXGRANT)" + NL
    t = t + "    IF problem <> """" THEN RETURN problem" + NL
    t = t + "    payee = payee.Trim().Lower()" + NL
    t = t + "    IF NOT UserExists(payee) THEN RETURN ""There is no SimPal member called """""" + Clip(payee, 20) + """""".""" + NL
    t = t + "    note = Clip(note, MAXNOTE)" + NL
    t = t + "    IF note = """" THEN note = ""A grant from the bank""" + NL
    t = t + "    IF NOT TakeLock() THEN RETURN BUSY" + NL
    t = t + "    Recover()" + NL
    t = t + "    Post(""grant"", BANK, payee, cents, note, """", """")" + NL
    t = t + "    DropLock()" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- members" + NL
    t = t + "" + NL
    t = t + "FUNCTION UserPath (u AS String) AS String" + NL
    t = t + "    RETURN DATADIR + ""\USERS\"" + u + "".TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UserExists (u AS String) AS Bool" + NL
    t = t + "    IF NOT ValidName(u) THEN RETURN FALSE" + NL
    t = t + "    RETURN FS.Exists(UserPath(u))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LoadUser (u AS String) AS Array OF String" + NL
    t = t + "    RETURN ReadOr(UserPath(u), """").Lines()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Field (rec AS Array OF String, key AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN rec" + NL
    t = t + "        IF line.StartsWith(key + ""="") THEN RETURN Unesc(line.Substring(key.Length + 1, line.Length - key.Length - 1))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NameOf (u AS String) AS String" + NL
    t = t + "    IF u = BANK THEN RETURN ""SimPal""" + NL
    t = t + "    RETURN Field(LoadUser(u), ""name"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Not real cryptography - SIM95 has none - but the password itself never" + NL
    t = t + "' touches the disk. Two running hashes over salt + password, kept under 2^31." + NL
    t = t + "FUNCTION Hash (salt AS String, pw AS String) AS String" + NL
    t = t + "    VAR a AS Integer = 7" + NL
    t = t + "    VAR b AS Integer = 31337" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = salt + "":"" + pw + "":"" + salt" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        c = Asc(s.CharAt(i))" + NL
    t = t + "        a = (a * 131 + c) MOD 2147483629" + NL
    t = t + "        b = (b * 257 + c + a) MOD 2147483587" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN Hex(a) + ""-"" + Hex(b)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NewToken () AS String" + NL
    t = t + "    RETURN Hex(268435456 + Rnd(1879048191))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A new account, with its welcome bonus in the same locked step, so there is" + NL
    t = t + "' never an account without one. Returns """" or what is wrong." + NL
    t = t + "FUNCTION CreateUser (u AS String, pw AS String, name AS String) AS String" + NL
    t = t + "    VAR salt AS String" + NL
    t = t + "    VAR problem AS String" + NL
    t = t + "    IF NOT ValidName(u) THEN RETURN ""Pick a user name of 3 to 8 letters or digits.""" + NL
    t = t + "    IF pw.Length < 4 THEN RETURN ""Pick a password of at least 4 characters.""" + NL
    t = t + "    name = Clip(name, MAXNAME)" + NL
    t = t + "    IF name = """" THEN RETURN ""Tell us your name.""" + NL
    t = t + "    IF NOT TakeLock() THEN RETURN BUSY" + NL
    t = t + "    Recover()" + NL
    t = t + "    IF FS.Exists(UserPath(u)) THEN" + NL
    t = t + "        problem = ""Somebody already has the name "" + u + "".""" + NL
    t = t + "    ELSE" + NL
    t = t + "        salt = NewToken()" + NL
    t = t + "        FS.Write(UserPath(u), ""name="" + Esc(name) + Chr(10) + ""salt="" + salt + Chr(10) + ""pass="" + Hash(salt, pw) + Chr(10) + ""joined="" + TIME.Date)" + NL
    t = t + "        FS.Append(DATADIR + ""\PEOPLE.TXT"", u + ""|"" + Esc(name) + Chr(10))" + NL
    t = t + "        Post(""bonus"", BANK, u, BONUS, ""Welcome to SimPal!"", """", """")" + NL
    t = t + "    END IF" + NL
    t = t + "    DropLock()" + NL
    t = t + "    RETURN problem" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CheckPassword (u AS String, pw AS String) AS Bool" + NL
    t = t + "    VAR rec AS Array OF String" + NL
    t = t + "    IF NOT UserExists(u) THEN RETURN FALSE" + NL
    t = t + "    rec = LoadUser(u)" + NL
    t = t + "    RETURN Hash(Field(rec, ""salt""), pw) = Field(rec, ""pass"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Every member, as user|name lines." + NL
    t = t + "FUNCTION People () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\PEOPLE.TXT"", """").Lines()" + NL
    t = t + "        IF line.Contains(""|"") THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The machine's owner: the user name and password in C:\SYSTEM\USERS.INI," + NL
    t = t + "' the same ones the Files service asks for." + NL
    t = t + "FUNCTION IsOwner (name AS String, pw AS String) AS Bool" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR owner AS String" + NL
    t = t + "    VAR pass AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(""C:\SYSTEM\USERS.INI"", """").Lines()" + NL
    t = t + "        line = line.Trim()" + NL
    t = t + "        IF line.Lower().StartsWith(""name="") THEN owner = line.Substring(5, line.Length - 5).Trim()" + NL
    t = t + "        IF line.Lower().StartsWith(""password="") THEN pass = line.Substring(9, line.Length - 9)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF owner = """" OR pw = """" THEN RETURN FALSE" + NL
    t = t + "    RETURN owner.Lower() = name.Trim().Lower() AND pass = pw" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- sessions" + NL
    t = t + "" + NL
    t = t + "' A session file holds who is signed in and that session's form token. Every" + NL
    t = t + "' form that changes something carries the token as t, and RequireToken checks" + NL
    t = t + "' it, so another site can't move your money with your cookie (see SimBook)." + NL
    t = t + "" + NL
    t = t + "SUB SignIn (u AS String)" + NL
    t = t + "    VAR token AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    token = NewToken()" + NL
    t = t + "    FS.Write(DATADIR + ""\SESSIONS\"" + token + "".TXT"", u + Chr(10) + NewToken() + NewToken())" + NL
    t = t + "    RESPONSE.SetCookie(COOKIE, token)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION SessionPath () AS String" + NL
    t = t + "    VAR token AS String" + NL
    t = t + "    token = REQUEST.Cookie(COOKIE)" + NL
    t = t + "    IF token = """" OR token.Length > 8 THEN RETURN """"" + NL
    t = t + "    IF NOT OnlyFrom(token, ""0123456789ABCDEF"") THEN RETURN """"" + NL
    t = t + "    RETURN DATADIR + ""\SESSIONS\"" + token + "".TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SignOut ()" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    path = SessionPath()" + NL
    t = t + "    IF path <> """" THEN" + NL
    t = t + "        IF FS.Exists(path) THEN FS.Delete(path)" + NL
    t = t + "    END IF" + NL
    t = t + "    RESPONSE.SetCookie(COOKIE, """")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Who the cookie says is signed in, or """". Also sets formToken." + NL
    t = t + "FUNCTION CurrentUser () AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR u AS String" + NL
    t = t + "    path = SessionPath()" + NL
    t = t + "    IF path = """" THEN RETURN """"" + NL
    t = t + "    lines = (ReadOr(path, """") + Chr(10) + Chr(10)).Split(Chr(10))" + NL
    t = t + "    u = lines[0].Trim()" + NL
    t = t + "    IF NOT UserExists(u) OR lines[1].Trim().Length < 16 THEN RETURN """"" + NL
    t = t + "    formToken = lines[1].Trim()" + NL
    t = t + "    RETURN u" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB RequireLogin ()" + NL
    t = t + "    viewer = CurrentUser()" + NL
    t = t + "    IF viewer = """" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RequireToken ()" + NL
    t = t + "    VAR sent AS String" + NL
    t = t + "    sent = REQUEST.Form(""t"")" + NL
    t = t + "    IF sent = """" THEN sent = REQUEST.Query(""t"")" + NL
    t = t + "    IF sent = """" OR sent <> formToken THEN RESPONSE.Redirect(""home.asp?why="" + UrlEnc(""That did not come from a SimPal page, so no money moved.""))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION TokenField () AS String" + NL
    t = t + "    RETURN ""<input type=""""hidden"""" name=""""t"""" value="""""" + formToken + """""">""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION TokenArg () AS String" + NL
    t = t + "    RETURN ""t="" + formToken" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- requests" + NL
    t = t + "" + NL
    t = t + "' C:\PALDATA\REQUESTS.TXT, one per line:" + NL
    t = t + "'   number|date time|who asks|who should pay|cents|note|open, paid, declined or cancelled" + NL
    t = t + "" + NL
    t = t + "FUNCTION FindRequest (rid AS String) AS String" + NL
    t = t + "    IF NOT IsNumber(rid) THEN RETURN """"" + NL
    t = t + "    RETURN FindLine(ReadOr(DATADIR + ""\REQUESTS.TXT"", """"), rid)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SetReqStatus (rid AS String, status AS String)" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR old AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    text = ReadOr(DATADIR + ""\REQUESTS.TXT"", """")" + NL
    t = t + "    old = FindLine(text, rid)" + NL
    t = t + "    IF old = """" THEN RETURN" + NL
    t = t + "    p = old.Split(""|"")" + NL
    t = t + "    IF p.Count < 7 OR p[6] = status THEN RETURN" + NL
    t = t + "    p[6] = status" + NL
    t = t + "    text = (Chr(10) + text).Replace(Chr(10) + old + Chr(10), Chr(10) + p.Join(""|"") + Chr(10))" + NL
    t = t + "    FS.Write(DATADIR + ""\REQUESTS.TXT"", text.Substring(1, text.Length - 1))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION AskMoney (asker AS String, payer AS String, amount AS String, note AS String) AS String" + NL
    t = t + "    VAR cents AS Integer" + NL
    t = t + "    VAR problem AS String" + NL
    t = t + "    cents = ParseCents(amount)" + NL
    t = t + "    problem = AmountProblem(cents, MAXSEND)" + NL
    t = t + "    IF problem <> """" THEN RETURN problem" + NL
    t = t + "    payer = payer.Trim().Lower()" + NL
    t = t + "    IF NOT UserExists(payer) THEN RETURN ""There is no SimPal member called """""" + Clip(payer, 20) + """""".""" + NL
    t = t + "    IF payer = asker THEN RETURN ""You can't ask yourself for money. (We have all tried.)""" + NL
    t = t + "    note = Clip(note, MAXNOTE)" + NL
    t = t + "    IF NOT TakeLock() THEN RETURN BUSY" + NL
    t = t + "    FS.Append(DATADIR + ""\REQUESTS.TXT"", Str(Counter(""NEXTREQ"")) + ""|"" + Stamp() + ""|"" + asker + ""|"" + payer + ""|"" + Str(cents) + ""|"" + Esc(note) + ""|open"" + Chr(10))" + NL
    t = t + "    DropLock()" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' u pays a request made of them. Returns """" or what is wrong." + NL
    t = t + "FUNCTION PayRequest (u AS String, rid AS String) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR problem AS String" + NL
    t = t + "    IF NOT TakeLock() THEN RETURN BUSY" + NL
    t = t + "    Recover()" + NL
    t = t + "    p = (FindRequest(rid) + ""||||||"").Split(""|"")" + NL
    t = t + "    IF p[3] <> u THEN" + NL
    t = t + "        problem = ""That request isn't for you.""" + NL
    t = t + "    ELSEIF p[6] <> ""open"" THEN" + NL
    t = t + "        problem = ""That request has already been "" + p[6] + "".""" + NL
    t = t + "    ELSEIF Balance(u) < Int(Val(p[4])) THEN" + NL
    t = t + "        problem = ""Insufficient funds: you have "" + Bucks(Balance(u)).Replace(""&sect;"", ""§"") + "".""" + NL
    t = t + "    ELSE" + NL
    t = t + "        Post(""req"", u, p[2], Int(Val(p[4])), Unesc(p[5]), ""Q"" + rid, """")" + NL
    t = t + "    END IF" + NL
    t = t + "    DropLock()" + NL
    t = t + "    RETURN problem" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The payer declines a request, or the one who asked cancels it." + NL
    t = t + "FUNCTION DropRequest (u AS String, rid AS String) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR problem AS String" + NL
    t = t + "    IF NOT TakeLock() THEN RETURN BUSY" + NL
    t = t + "    p = (FindRequest(rid) + ""||||||"").Split(""|"")" + NL
    t = t + "    IF p[3] <> u AND p[2] <> u THEN" + NL
    t = t + "        problem = ""That request isn't yours.""" + NL
    t = t + "    ELSEIF p[6] <> ""open"" THEN" + NL
    t = t + "        problem = ""That request has already been "" + p[6] + "".""" + NL
    t = t + "    ELSEIF p[3] = u THEN" + NL
    t = t + "        SetReqStatus(rid, ""declined"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        SetReqStatus(rid, ""cancelled"")" + NL
    t = t + "    END IF" + NL
    t = t + "    DropLock()" + NL
    t = t + "    RETURN problem" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Open requests to (toMe) or from u, newest first, as table rows." + NL
    t = t + "FUNCTION RequestsHtml (u AS String, toMe AS Bool) AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR shown AS Integer" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    lines = ReadOr(DATADIR + ""\REQUESTS.TXT"", """").Lines()" + NL
    t = t + "    FOR i = lines.Count - 1 TO 0 STEP -1" + NL
    t = t + "        p = lines[i].Split(""|"")" + NL
    t = t + "        IF p.Count < 7 THEN CONTINUE" + NL
    t = t + "        IF p[6] <> ""open"" THEN CONTINUE" + NL
    t = t + "        IF toMe AND p[3] = u THEN" + NL
    t = t + "            out = out + ""<tr><td><font size=""""2""""><b>"" + H(NameOf(p[2])) + ""</b> ("" + p[2] + "") asks you for <b>"" + Bucks(Int(Val(p[4]))) + ""</b>"" + NoteText(p[5]) + ""<br><font color=""""#808080"""" size=""""1"""">"" + p[1] + ""</font></font></td>"" _" + NL
    t = t + "                + ""<td align=""""right"""" nowrap><form action=""""request.asp"""" method=""""post"""">"" + TokenField() + ""<input type=""""hidden"""" name=""""id"""" value="""""" + p[0] + """"""><input type=""""hidden"""" name=""""do"""" value=""""pay""""><input type=""""submit"""" value=""""Pay""""></form></td>"" _" + NL
    t = t + "                + ""<td nowrap><form action=""""request.asp"""" method=""""post"""">"" + TokenField() + ""<input type=""""hidden"""" name=""""id"""" value="""""" + p[0] + """"""><input type=""""hidden"""" name=""""do"""" value=""""decline""""><input type=""""submit"""" value=""""Decline""""></form></td></tr>""" + NL
    t = t + "            shown = shown + 1" + NL
    t = t + "        ELSEIF NOT toMe AND p[2] = u THEN" + NL
    t = t + "            out = out + ""<tr><td><font size=""""2"""">You asked <b>"" + H(NameOf(p[3])) + ""</b> ("" + p[3] + "") for <b>"" + Bucks(Int(Val(p[4]))) + ""</b>"" + NoteText(p[5]) + ""<br><font color=""""#808080"""" size=""""1"""">"" + p[1] + ""</font></font></td>"" _" + NL
    t = t + "                + ""<td align=""""right""""><form action=""""request.asp"""" method=""""post"""">"" + TokenField() + ""<input type=""""hidden"""" name=""""id"""" value="""""" + p[0] + """"""><input type=""""hidden"""" name=""""do"""" value=""""cancel""""><input type=""""submit"""" value=""""Cancel""""></form></td></tr>""" + NL
    t = t + "            shown = shown + 1" + NL
    t = t + "        END IF" + NL
    t = t + "        IF shown >= REQSHOW THEN BREAK" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NoteText (note AS String) AS String" + NL
    t = t + "    IF note = """" THEN RETURN """"" + NL
    t = t + "    RETURN "" for &quot;"" + H(Unesc(note)) + ""&quot;""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- Pay with SimPal" + NL
    t = t + "" + NL
    t = t + "' C:\PALDATA\ORDERS\<merchant>.TXT: order|receipt, one per order paid, so an" + NL
    t = t + "' order is never paid twice." + NL
    t = t + "FUNCTION OrderReceipt (merchant AS String, order AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    line = FindLine(ReadOr(DATADIR + ""\ORDERS\"" + merchant + "".TXT"", """"), Esc(order))" + NL
    t = t + "    IF line = """" THEN RETURN """"" + NL
    t = t + "    RETURN line.Split(""|"")[1]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB AddOrder (merchant AS String, order AS String, receipt AS String)" + NL
    t = t + "    IF OrderReceipt(merchant, order) <> """" THEN RETURN" + NL
    t = t + "    FS.Append(DATADIR + ""\ORDERS\"" + merchant + "".TXT"", Esc(order) + ""|"" + receipt + Chr(10))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Order numbers come from the merchant's page. They travel back on a URL and" + NL
    t = t + "' come out of verify.asp between |s, so keep them plain." + NL
    t = t + "FUNCTION ValidOrder (order AS String) AS Bool" + NL
    t = t + "    IF order = """" OR order.Length > MAXORDER THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyFrom(order, ""abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.#:/"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where the buyer goes back to: an http:// address with nothing odd in it." + NL
    t = t + "FUNCTION ValidReturn (url AS String) AS Bool" + NL
    t = t + "    IF url = """" THEN RETURN TRUE" + NL
    t = t + "    IF url.Length > MAXURL OR NOT url.Lower().StartsWith(""http://"") THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyFrom(url, ""abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._~:/?#@!$&()*+,;=%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' What is wrong with a Pay with SimPal button, or """"." + NL
    t = t + "FUNCTION CheckoutProblem (merchant AS String, amount AS String, order AS String, back AS String) AS String" + NL
    t = t + "    VAR problem AS String" + NL
    t = t + "    IF NOT UserExists(merchant) THEN RETURN ""This shop's SimPal account ("""""" + Clip(merchant, 20) + """""") doesn't exist, so it can't be paid.""" + NL
    t = t + "    problem = AmountProblem(ParseCents(amount), MAXSEND)" + NL
    t = t + "    IF problem <> """" THEN RETURN ""This shop's button has a bad price. "" + problem" + NL
    t = t + "    IF NOT ValidOrder(order) THEN RETURN ""This shop's button has no order number we can use (up to "" + Str(MAXORDER) + "" letters, digits and - _ . # : /).""" + NL
    t = t + "    IF NOT ValidReturn(back) THEN RETURN ""This shop's button has a return address we won't send you to. It must start with http://""" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The buyer pays for an order. On success lastRef is the receipt. An order" + NL
    t = t + "' the same buyer already paid (pressing Pay twice) gives back that receipt." + NL
    t = t + "FUNCTION PayMerchant (buyer AS String, merchant AS String, amount AS String, item AS String, order AS String) AS String" + NL
    t = t + "    VAR cents AS Integer" + NL
    t = t + "    VAR problem AS String" + NL
    t = t + "    VAR had AS String" + NL
    t = t + "    cents = ParseCents(amount)" + NL
    t = t + "    IF buyer = merchant THEN RETURN ""You can't buy from yourself.""" + NL
    t = t + "    IF NOT TakeLock() THEN RETURN BUSY" + NL
    t = t + "    Recover()" + NL
    t = t + "    had = OrderReceipt(merchant, order)" + NL
    t = t + "    IF had <> """" THEN" + NL
    t = t + "        IF (FindTx(ReceiptTx(had)) + ""||||"").Split(""|"")[3] = buyer THEN" + NL
    t = t + "            lastRef = had" + NL
    t = t + "        ELSE" + NL
    t = t + "            problem = ""Order "" + order + "" at "" + merchant + "" has already been paid for.""" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSEIF Balance(buyer) < cents THEN" + NL
    t = t + "        problem = ""Insufficient funds: this costs "" + Bucks(cents).Replace(""&sect;"", ""§"") + "" and you have "" + Bucks(Balance(buyer)).Replace(""&sect;"", ""§"") + "".""" + NL
    t = t + "    ELSE" + NL
    t = t + "        Post(""pay"", buyer, merchant, cents, Clip(item, MAXITEM), """", order)" + NL
    t = t + "    END IF" + NL
    t = t + "    DropLock()" + NL
    t = t + "    RETURN problem" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' R12-1A2B3C4D -> 12" + NL
    t = t + "FUNCTION ReceiptTx (receipt AS String) AS Integer" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    p = receipt.Split(""-"")" + NL
    t = t + "    IF p.Count <> 2 OR NOT p[0].StartsWith(""R"") THEN RETURN 0" + NL
    t = t + "    IF NOT IsNumber(p[0].Substring(1, p[0].Length - 1)) THEN RETURN 0" + NL
    t = t + "    RETURN Int(Val(p[0].Substring(1, p[0].Length - 1)))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- history" + NL
    t = t + "" + NL
    t = t + "' What a ledger line means to u, as a table row." + NL
    t = t + "FUNCTION TxHtml (line AS String, u AS String) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR what AS String" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR money AS String" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    IF p.Count < 9 THEN RETURN """"" + NL
    t = t + "    c = Effect(line, u)" + NL
    t = t + "    SELECT CASE p[2]" + NL
    t = t + "        CASE ""bonus""" + NL
    t = t + "            what = ""Welcome bonus from SimPal""" + NL
    t = t + "        CASE ""grant""" + NL
    t = t + "            what = ""Grant from the SimPal bank""" + NL
    t = t + "        CASE ""send""" + NL
    t = t + "            IF c < 0 THEN" + NL
    t = t + "                what = ""Sent to <b>"" + H(NameOf(p[4])) + ""</b> ("" + p[4] + "")""" + NL
    t = t + "            ELSE" + NL
    t = t + "                what = ""Received from <b>"" + H(NameOf(p[3])) + ""</b> ("" + p[3] + "")""" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""req""" + NL
    t = t + "            IF c < 0 THEN" + NL
    t = t + "                what = ""Paid <b>"" + H(NameOf(p[4])) + ""</b>'s request""" + NL
    t = t + "            ELSE" + NL
    t = t + "                what = ""<b>"" + H(NameOf(p[3])) + ""</b> paid your request""" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""pay""" + NL
    t = t + "            IF c < 0 THEN" + NL
    t = t + "                what = ""Purchase at <b>"" + H(NameOf(p[4])) + ""</b> ("" + p[4] + "")""" + NL
    t = t + "            ELSE" + NL
    t = t + "                what = ""Sale to <b>"" + H(NameOf(p[3])) + ""</b> ("" + p[3] + "")""" + NL
    t = t + "            END IF" + NL
    t = t + "            what = what + ""<br><font size=""""1"""" color=""""#808080"""">order "" + H(Unesc(p[8])) + "" &middot; receipt "" + p[7] + ""</font>""" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            RETURN """"" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF p[6] <> """" THEN what = what + ""<br><font size=""""1"""">&quot;"" + H(Unesc(p[6])) + ""&quot;</font>""" + NL
    t = t + "    IF c < 0 THEN" + NL
    t = t + "        money = ""<font color=""""#CC0000"""">"" + Bucks(c) + ""</font>""" + NL
    t = t + "    ELSE" + NL
    t = t + "        money = ""<font color=""""#008000"""">+"" + Bucks(c) + ""</font>""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN ""<tr><td valign=""""top"""" nowrap><font size=""""2"""">"" + p[1] + ""</font></td><td valign=""""top""""><font size=""""2"""">"" + what + ""</font></td><td valign=""""top"""" align=""""right"""" nowrap><font size=""""2""""><b>"" + money + ""</b></font></td><td valign=""""top""""><font size=""""1"""" color=""""#808080"""">#"" + p[0] + ""</font></td></tr>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' u's newest transactions, newest first." + NL
    t = t + "FUNCTION HistoryHtml (u AS String, most AS Integer) AS String" + NL
    t = t + "    VAR ids AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR shown AS Integer" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    ids = ReadOr(DATADIR + ""\HIST\"" + u + "".TXT"", ""|"").Split(""|"")" + NL
    t = t + "    FOR i = ids.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF NOT IsNumber(ids[i]) THEN CONTINUE" + NL
    t = t + "        out = out + TxHtml(FindTx(Int(Val(ids[i]))), u)" + NL
    t = t + "        shown = shown + 1" + NL
    t = t + "        IF shown >= most THEN BREAK" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF out = """" THEN RETURN ""<tr><td><font size=""""2"""" color=""""#808080"""">No transactions yet.</font></td></tr>""" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION TxCount (u AS String) AS Integer" + NL
    t = t + "    RETURN ReadOr(DATADIR + ""\HIST\"" + u + "".TXT"", ""|"").Split(""|"").Count - 2" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- page furniture" + NL
    t = t + "" + NL
    t = t + "FUNCTION Top (title AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = ""<html><head><title>"" + H(title) + "" - SimPal</title></head>"" _" + NL
    t = t + "      + ""<body bgcolor=""""#FFFFFF"""" text=""""#000000"""" link=""""#003087"""" vlink=""""#003087"""">"" _" + NL
    t = t + "      + ""<table width=""""100%"""" cellpadding=""""6"""" cellspacing=""""0"""" bgcolor=""""#003087""""><tr>"" _" + NL
    t = t + "      + ""<td><a href=""""index.asp""""><font size=""""6"""" color=""""#FFFFFF""""><b><i>Sim</i></b></font><font size=""""6"""" color=""""#009CDE""""><b><i>Pal</i></b></font></a>"" _" + NL
    t = t + "      + ""<font color=""""#FFCC00"""" size=""""2"""">&nbsp; the way to send money on the information superhighway</font></td>"" _" + NL
    t = t + "      + ""<td align=""""right""""><font color=""""#FFFFFF"""" size=""""2"""">""" + NL
    t = t + "    IF viewer <> """" THEN" + NL
    t = t + "        s = s + ""<a href=""""home.asp""""><font color=""""#FFFFFF"""">My Account</font></a> | "" _" + NL
    t = t + "              + ""<a href=""""send.asp""""><font color=""""#FFFFFF"""">Send</font></a> | "" _" + NL
    t = t + "              + ""<a href=""""request.asp""""><font color=""""#FFFFFF"""">Request</font></a> | "" _" + NL
    t = t + "              + ""<a href=""""history.asp""""><font color=""""#FFFFFF"""">History</font></a> | "" _" + NL
    t = t + "              + ""<a href=""""logout.asp?"" + TokenArg() + """"""><font color=""""#FFFFFF"""">Log Out</font></a>""" + NL
    t = t + "    ELSE" + NL
    t = t + "        s = s + ""<a href=""""index.asp""""><font color=""""#FFFFFF"""">Log In</font></a> | <a href=""""index.asp""""><font color=""""#FFFFFF"""">Sign Up</font></a>""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN s + ""</font></td></tr></table>"" _" + NL
    t = t + "         + ""<table width=""""100%"""" cellpadding=""""2"""" cellspacing=""""0"""" bgcolor=""""#FFCC00""""><tr><td align=""""center""""><font size=""""1"""" color=""""#003087""""><b>NEW!</b> Sign up today and get "" + Bucks(BONUS) + "" FREE! &middot; Your money is safe with us!!</font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Bottom () AS String" + NL
    t = t + "    RETURN ""<hr><center><font size=""""1"""" color=""""#808080"""">SimPal on "" + H(SERVER.Name) + "" &middot; "" + TIME.Date + "" &middot; "" _" + NL
    t = t + "         + ""<a href=""""merchant.asp"""">SimPal for your web site</a> &middot; <a href=""""simmart.asp"""">Shop at SimMart</a> &middot; <a href=""""simpal.htm"""">About SimPal</a><br>"" _" + NL
    t = t + "         + ""Copyright &copy; 1999 SimPal. All rights reserved. SimBucks (&sect;) have no value outside SIM95. Best viewed in Voyager at 640x480.</font></center></body></html>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION BoxTop (title AS String) AS String" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""3"""" cellspacing=""""0""""><tr><td bgcolor=""""#009CDE""""><font color=""""#FFFFFF"""" size=""""2""""><b>"" + title + ""</b></font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Notice (text AS String) AS String" + NL
    t = t + "    IF text = """" THEN RETURN """"" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""4""""><tr><td bgcolor=""""#FFF9D7""""><font size=""""2"""">"" + H(text) + ""</font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The ""Secure transaction"" padlock, drawn in text, as every serious site had." + NL
    t = t + "FUNCTION Padlock () AS String" + NL
    t = t + "    RETURN ""<table cellpadding=""""4"""" cellspacing=""""0"""" border=""""1"""" bgcolor=""""#FFFFE0""""><tr><td bgcolor=""""#FFCC00""""><pre><font color=""""#003087"""">"" _" + NL
    t = t + "         + ""  .--.  "" + Chr(10) _" + NL
    t = t + "         + "" / .. \ "" + Chr(10) _" + NL
    t = t + "         + "" | || | "" + Chr(10) _" + NL
    t = t + "         + ""[======]"" + Chr(10) _" + NL
    t = t + "         + ""[  ()  ]"" + Chr(10) _" + NL
    t = t + "         + ""[  ||  ]"" + Chr(10) _" + NL
    t = t + "         + ""[======]</font></pre></td><td valign=""""middle""""><font size=""""2"""" color=""""#003087""""><b>Secure transaction</b></font><br>"" _" + NL
    t = t + "         + ""<font size=""""1"""">Protected by SimCrypt&trade; 40-bit<br>export-grade security.<br>Your money is safe with us!!</font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\WEB\PAL.SPK")
END SUB

SUB File10 ()
    t = ""
    t = t + "<%@ import file=""PAL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' PAY.ASP - ""Pay with SimPal"": the checkout another web site sends its buyers" + NL
    t = t + "' to, by form (GET or POST) or by link, with" + NL
    t = t + "'   to=the shop's SimPal user name   amount=4.99   item=what it is" + NL
    t = t + "'   order=the shop's order number    return=http://... (where to come back to)" + NL
    t = t + "' The buyer logs in, checks the details and presses Pay. The money moves, and" + NL
    t = t + "' the buyer goes back to return with ?receipt=R12-1A2B3C4D&order=... added." + NL
    t = t + "' The shop then checks that receipt (verify.asp, or PALCHECK.SPK on this" + NL
    t = t + "' machine) before it hands anything over." + NL
    t = t + "VAR merchant AS String" + NL
    t = t + "VAR amount AS String" + NL
    t = t + "VAR item AS String" + NL
    t = t + "VAR order AS String" + NL
    t = t + "VAR back AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR args AS String" + NL
    t = t + "VAR sep AS String" + NL
    t = t + "VAR paid AS Bool" + NL
    t = t + "merchant = Arg(""to"").Trim().Lower()" + NL
    t = t + "amount = Arg(""amount"").Trim()" + NL
    t = t + "item = Clip(Arg(""item""), MAXITEM)" + NL
    t = t + "order = Arg(""order"").Trim()" + NL
    t = t + "back = Arg(""return"").Trim()" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "problem = CheckoutProblem(merchant, amount, order, back)" + NL
    t = t + "args = ""to="" + UrlEnc(merchant) + ""&amount="" + UrlEnc(amount) + ""&item="" + UrlEnc(item) + ""&order="" + UrlEnc(order) + ""&return="" + UrlEnc(back)" + NL
    t = t + "sep = ""?""" + NL
    t = t + "IF back.Contains(""?"") THEN sep = ""&""" + NL
    t = t + "IF problem = """" AND viewer <> """" AND REQUEST.Form(""do"") = ""pay"" THEN" + NL
    t = t + "    RequireToken()" + NL
    t = t + "    problem = PayMerchant(viewer, merchant, amount, item, order)" + NL
    t = t + "    IF problem = """" AND back <> """" THEN RESPONSE.Redirect(back + sep + ""receipt="" + lastRef + ""&order="" + UrlEnc(order))" + NL
    t = t + "    IF problem = """" THEN paid = TRUE" + NL
    t = t + "END IF" + NL
    t = t + "IF problem = """" AND viewer = """" AND REQUEST.Query(""e"") = ""login"" THEN problem = ""That user name and password do not match.""" + NL
    t = t + "%>" + NL
    t = t + "<script runat=""server"">" + NL
    t = t + "' A field from the shop's form (POST) or link (GET)." + NL
    t = t + "FUNCTION Arg (name AS String) AS String" + NL
    t = t + "    IF REQUEST.Form(name) <> """" THEN RETURN REQUEST.Form(name)" + NL
    t = t + "    RETURN REQUEST.Query(name)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Hidden (name AS String, value AS String) AS String" + NL
    t = t + "    RETURN ""<input type=""""hidden"""" name="""""" + name + """""" value="""""" + H(value) + """""">""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "</script>" + NL
    t = t + "<%= Top(""Pay with SimPal"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= BoxTop(""Pay with SimPal"") %>" + NL
    t = t + "<% IF CheckoutProblem(merchant, amount, order, back) = """" THEN %>" + NL
    t = t + "<table cellpadding=""4"" cellspacing=""0"" border=""1"" width=""100%"">" + NL
    t = t + "<tr><td bgcolor=""#E6F0FA"" width=""120""><font size=""2""><b>Pay to</b></font></td><td><font size=""2""><b><%= H(NameOf(merchant)) %></b> (<%= merchant %>)</font></td></tr>" + NL
    t = t + "<tr><td bgcolor=""#E6F0FA""><font size=""2""><b>For</b></font></td><td><font size=""2""><%= H(item) %><% IF item = """" THEN %>(no description)<% END IF %></font></td></tr>" + NL
    t = t + "<tr><td bgcolor=""#E6F0FA""><font size=""2""><b>Order number</b></font></td><td><font size=""2""><tt><%= H(order) %></tt></font></td></tr>" + NL
    t = t + "<tr><td bgcolor=""#E6F0FA""><font size=""2""><b>Amount</b></font></td><td><font size=""4"" color=""#003087""><b><%= Bucks(ParseCents(amount)) %></b></font></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<% IF paid THEN %>" + NL
    t = t + "<p><font size=""3""><b>Payment complete. Thank you!</b></font></p>" + NL
    t = t + "<p><font size=""2"">Your receipt number is <b><tt><%= lastRef %></tt></b>. Give it to <%= H(NameOf(merchant)) %> if they ask for it." + NL
    t = t + "<a href=""home.asp"">Back to My Account</a></font></p>" + NL
    t = t + "<% ELSEIF CheckoutProblem(merchant, amount, order, back) <> """" THEN %>" + NL
    t = t + "<p><font size=""2"">Nothing has been paid. <% IF ValidReturn(back) AND back <> """" THEN %><a href=""<%= H(back) %>"">Go back to the shop</a><% END IF %></font></p>" + NL
    t = t + "<% ELSEIF viewer = """" THEN %>" + NL
    t = t + "<p><font size=""2""><b>Log in to SimPal to pay.</b> We never tell the shop your password.</font></p>" + NL
    t = t + "<form action=""login.asp"" method=""post"">" + NL
    t = t + "<%= Hidden(""next"", ""pay.asp?"" + args) %>" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td><font size=""2"">User name:</font></td><td><input name=""u"" size=""16""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Password:</font></td><td><input type=""password"" name=""pw"" size=""16""></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Log In""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "</form>" + NL
    t = t + "<p><font size=""2"">New to SimPal? <a href=""index.asp?next=<%= UrlEnc(""pay.asp?"" + args) %>"">Sign up</a>. It's free, and you get <%= Bucks(BONUS) %> to spend!</font></p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<p><font size=""2"">You are logged in as <b><%= H(NameOf(viewer)) %></b> (<%= viewer %>). Your balance is <b><%= Bucks(Balance(viewer)) %></b>.</font></p>" + NL
    t = t + "<form action=""pay.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<%= Hidden(""do"", ""pay"") %><%= Hidden(""to"", merchant) %><%= Hidden(""amount"", amount) %><%= Hidden(""item"", item) %><%= Hidden(""order"", order) %><%= Hidden(""return"", back) %>" + NL
    t = t + "<p><input type=""submit"" value=""Pay <%= Bucks(ParseCents(amount)) %> Now""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<p><font size=""2""><% IF back <> """" THEN %><a href=""<%= H(back + sep + ""cancelled=1&order="" + UrlEnc(order)) %>"">Cancel and go back to the shop</a><% ELSE %><a href=""home.asp"">Cancel</a><% END IF %></font></p>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</td><td width=""200"" valign=""top""><%= Padlock() %>" + NL
    t = t + "<p><font size=""1"" color=""#808080"">SimPal pays the shop straight from your SimPal balance. The shop never sees your password.</font></p></td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\PAY.ASP")
END SUB

SUB File11 ()
    t = ""
    t = t + "<%@ import file=""PAL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' REQUEST.ASP - ask another member for money. They see it on their account" + NL
    t = t + "' page and can pay or decline it; you can cancel it until then. Those buttons" + NL
    t = t + "' post here too (do=pay, decline or cancel, id=the request)." + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR act AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    RequireToken()" + NL
    t = t + "    act = REQUEST.Form(""do"")" + NL
    t = t + "    IF act = ""pay"" THEN" + NL
    t = t + "        problem = PayRequest(viewer, REQUEST.Form(""id""))" + NL
    t = t + "        IF problem = """" THEN RESPONSE.Redirect(""home.asp?why="" + UrlEnc(""Paid! The request is settled.""))" + NL
    t = t + "        RESPONSE.Redirect(""home.asp?why="" + UrlEnc(problem))" + NL
    t = t + "    ELSEIF act = ""decline"" OR act = ""cancel"" THEN" + NL
    t = t + "        problem = DropRequest(viewer, REQUEST.Form(""id""))" + NL
    t = t + "        IF problem = """" AND act = ""decline"" THEN problem = ""Request declined. No money moved.""" + NL
    t = t + "        IF problem = """" THEN problem = ""Request cancelled.""" + NL
    t = t + "        RESPONSE.Redirect(""home.asp?why="" + UrlEnc(problem))" + NL
    t = t + "    ELSE" + NL
    t = t + "        problem = AskMoney(viewer, REQUEST.Form(""from""), REQUEST.Form(""amount""), REQUEST.Form(""note""))" + NL
    t = t + "        IF problem = """" THEN RESPONSE.Redirect(""home.asp?why="" + UrlEnc(""Your request is on its way to "" + REQUEST.Form(""from"").Trim().Lower() + "".""))" + NL
    t = t + "    END IF" + NL
    t = t + "END IF" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Request Money"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<%= BoxTop(""Request Money"") %>" + NL
    t = t + "<p><font size=""2"">Somebody owes you? Send them a request. It waits on their account page until they pay it or decline it.</font></p>" + NL
    t = t + "<form action=""request.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<table cellpadding=""4"">" + NL
    t = t + "<tr><td><font size=""2"">From (user name):</font></td><td><input name=""from"" size=""16"" value=""<%= H(REQUEST.Form(""from"")) %>""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Amount:</font></td><td><font size=""2"">&sect;</font> <input name=""amount"" size=""10"" value=""<%= H(REQUEST.Form(""amount"")) %>""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">What for:</font></td><td><input name=""note"" size=""40"" maxlength=""<%= MAXNOTE %>"" value=""<%= H(REQUEST.Form(""note"")) %>""></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Send Request""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "</form>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\REQUEST.ASP")
END SUB

SUB File12 ()
    t = ""
    t = t + "<%@ import file=""PAL.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' SEND.ASP - send money to another member, with a note. The form posts back" + NL
    t = t + "' here; the money moves and you land on your account." + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR p AS Array OF String" + NL
    t = t + "VAR who AS String" + NL
    t = t + "VAR whoList AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    RequireToken()" + NL
    t = t + "    problem = SendMoney(viewer, REQUEST.Form(""to""), REQUEST.Form(""amount""), REQUEST.Form(""note""))" + NL
    t = t + "    IF problem = """" THEN RESPONSE.Redirect(""home.asp?why="" + UrlEnc(""Sent! "" + Bucks(ParseCents(REQUEST.Form(""amount""))).Replace(""&sect;"", ""§"") + "" is on its way to "" + REQUEST.Form(""to"").Trim().Lower() + "".""))" + NL
    t = t + "END IF" + NL
    t = t + "FOR EACH who IN People()" + NL
    t = t + "    p = who.Split(""|"")" + NL
    t = t + "    IF p[0] <> viewer AND whoList.Length < 3000 THEN whoList = whoList + ""<a href=""""send.asp?to="" + p[0] + """""">"" + p[0] + ""</a> """ + NL
    t = t + "NEXT" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Send Money"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<%= BoxTop(""Send Money"") %>" + NL
    t = t + "<form action=""send.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<table cellpadding=""4"">" + NL
    t = t + "<tr><td><font size=""2"">To (user name):</font></td><td><input name=""to"" size=""16"" value=""<%= H(REQUEST.Form(""to"") + REQUEST.Query(""to"")) %>""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Amount:</font></td><td><font size=""2"">&sect;</font> <input name=""amount"" size=""10"" value=""<%= H(REQUEST.Form(""amount"")) %>""> <font size=""1"" color=""#808080"">like 5 or 12.50</font></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Note:</font></td><td><input name=""note"" size=""40"" maxlength=""<%= MAXNOTE %>"" value=""<%= H(REQUEST.Form(""note"")) %>""></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Send Money Now""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "</form>" + NL
    t = t + "<p><font size=""2"">You have <b><%= Bucks(Balance(viewer)) %></b>.</font></p>" + NL
    t = t + "<% IF whoList <> """" THEN %><p><font size=""2"">Members: <%= whoList %></font></p><% END IF %>" + NL
    t = t + "</td><td width=""200"" valign=""top""><%= Padlock() %></td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\SEND.ASP")
END SUB

SUB File13 ()
    t = ""
    t = t + "<%@ import file=""C:\PROGRAMS\PALCHECK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' SIMMART.ASP - SimMart, a pretend shop that takes SimPal: the example for" + NL
    t = t + "' anyone who wants a Pay with SimPal button on their own pages. It is an" + NL
    t = t + "' ordinary shop page, as one on any machine would be. It doesn't use PAL.SPK," + NL
    t = t + "' only C:\PROGRAMS\PALCHECK.SPK, which any page on this machine can import." + NL
    t = t + "'   1. The page makes up an order number and shows the button: a form that" + NL
    t = t + "'      goes to SimPal's pay.asp with the price, the order and where to come back." + NL
    t = t + "'   2. SimPal sends the buyer back here with ?receipt=...&order=..." + NL
    t = t + "'   3. VerifyReceipt says whether that receipt really paid SimMart the price for" + NL
    t = t + "'      that order, and uses it up, so coming back twice ships nothing twice." + NL
    t = t + "CONST MART = ""simmart""" + NL
    t = t + "CONST PRICE = ""4.99""" + NL
    t = t + "CONST WARE = ""Genuine Y2K Bug (in a jar)""" + NL
    t = t + "VAR order AS String" + NL
    t = t + "VAR receipt AS String" + NL
    t = t + "VAR info AS Array OF String" + NL
    t = t + "VAR said AS String" + NL
    t = t + "VAR good AS Bool" + NL
    t = t + "receipt = REQUEST.Query(""receipt"").Trim()" + NL
    t = t + "IF receipt <> """" THEN" + NL
    t = t + "    info = (ReceiptInfo(receipt) + ""|||||"").Split(""|"")" + NL
    t = t + "    good = VerifyReceipt(receipt, MART, PRICE, REQUEST.Query(""order""))" + NL
    t = t + "    IF good THEN" + NL
    t = t + "        said = ""Thank you, "" + info[3] + ""! Order "" + REQUEST.Query(""order"") + "" is paid (SimPal receipt "" + receipt + ""). Your Y2K bug ships in 6 to 8 weeks.""" + NL
    t = t + "    ELSEIF PalWhy = ""used"" THEN" + NL
    t = t + "        said = ""That receipt has already been used for order "" + info[2] + "". One receipt, one bug.""" + NL
    t = t + "    ELSE" + NL
    t = t + "        said = ""Sorry, SimPal says that receipt is no good ("" + PalWhy + ""). Nothing will ship.""" + NL
    t = t + "    END IF" + NL
    t = t + "ELSEIF REQUEST.Query(""cancelled"") = ""1"" THEN" + NL
    t = t + "    said = ""No problem. Maybe next millennium.""" + NL
    t = t + "END IF" + NL
    t = t + "order = ""SM"" + Str(TIME.Now) + Hex(Rnd(65536))" + NL
    t = t + "%><html><head><title>SimMart - Shop Online with Confidence!</title>" + NL
    t = t + "<meta name=""description"" content=""SimMart: the online shopping mall for SIM95. Pay with SimPal."">" + NL
    t = t + "<meta name=""keywords"" content=""shop, shopping, online shopping, store, mall, buy, y2k, pay with simpal, e-commerce"">" + NL
    t = t + "</head>" + NL
    t = t + "<body bgcolor=""#FFFFFF"" link=""#CC0000"" vlink=""#CC0000"">" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0"" bgcolor=""#CC0000""><tr><td>" + NL
    t = t + "<font size=""6"" color=""#FFFFFF""><b>SimMart</b></font> <font color=""#FFFF00""><b><i>Shop online with confidence!</i></b></font></td>" + NL
    t = t + "<td align=""right""><font size=""2"" color=""#FFFFFF"">Open 24 hours &middot; Now Y2K compliant</font></td></tr></table>" + NL
    t = t + "<% IF said <> """" THEN %>" + NL
    t = t + "<table width=""100%"" cellpadding=""6""><tr><td bgcolor=""<% IF good THEN %>#E0FFE0<% ELSE %>#FFF9D7<% END IF %>""><font size=""3""><b><%= SERVER.HtmlEncode(said) %></b></font></td></tr></table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<table cellpadding=""10""><tr>" + NL
    t = t + "<td valign=""top""><pre><font color=""#808080"">" + NL
    t = t + "   _______" + NL
    t = t + "  [_______]" + NL
    t = t + "   |     |" + NL
    t = t + "   | {*} |" + NL
    t = t + "   | /|\ |" + NL
    t = t + "   |_____|" + NL
    t = t + "</font></pre></td>" + NL
    t = t + "<td valign=""top"">" + NL
    t = t + "<h2><%= WARE %></h2>" + NL
    t = t + "<p>Caught live in a 1970s COBOL mainframe. Two digits for the year, air holes in the lid." + NL
    t = t + "Set it free on 1 January 2000 and watch the fun!<br><font size=""2"" color=""#808080"">Batteries not included. Not a real bug.</font></p>" + NL
    t = t + "<p><font size=""5"" color=""#CC0000""><b>&sect;<%= PRICE %></b></font> <font size=""2""><s>&sect;19.99</s> SAVE 75%!!</font></p>" + NL
    t = t + "<% IF PalMember(MART) THEN %>" + NL
    t = t + "<form action=""<%= PalPayUrl() %>"" method=""post"">" + NL
    t = t + "<input type=""hidden"" name=""to"" value=""<%= MART %>"">" + NL
    t = t + "<input type=""hidden"" name=""amount"" value=""<%= PRICE %>"">" + NL
    t = t + "<input type=""hidden"" name=""item"" value=""<%= WARE %>"">" + NL
    t = t + "<input type=""hidden"" name=""order"" value=""<%= order %>"">" + NL
    t = t + "<input type=""hidden"" name=""return"" value=""<%= PalPayUrl().Replace(""pay.asp"", ""simmart.asp"") %>"">" + NL
    t = t + "<table cellpadding=""2"" bgcolor=""#003087""><tr><td><input type=""submit"" value=""Pay with SimPal""></td><td><font size=""1"" color=""#FFCC00""><b>Secure!</b></font></td></tr></table>" + NL
    t = t + "</form>" + NL
    t = t + "<font size=""1"" color=""#808080"">Your order number: <%= order %></font>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<p><font size=""2""><b>SimMart is closed.</b> It takes money through a SimPal account called" + NL
    t = t + "<b><%= MART %></b>, and there isn't one yet. Sign up for SimPal as <%= MART %> (this is a demo: anyone may) and the shop opens.</font></p>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<hr><center><font size=""1"" color=""#808080"">SimMart is a demo shop for <a href=""merchant.asp"">SimPal for your web site</a>. &copy; 1999 SimMart Inc.</font></center>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\SIMMART.ASP")
END SUB

SUB File14 ()
    t = ""
    t = t + "<html><head><title>About SimPal - send money, pay online and shop with your SimPal wallet</title>" + NL
    t = t + "<meta name=""description"" content=""SimPal is the easy, secure way to send money and pay online on the SIM95 network. Send money to anyone with an e-mail-free account, request money, shop at any site with a Pay with SimPal button, and accept payments on your own web site."">" + NL
    t = t + "<meta name=""keywords"" content=""payments, online payments, money, send money, request money, pay online, paypal, wallet, digital wallet, e-wallet, shop, shopping, online shopping, checkout, pay with simpal, merchant, accept payments, e-commerce, bank, banking, online banking, money transfer, transfer money, secure, simbucks, cash"">" + NL
    t = t + "</head>" + NL
    t = t + "<body bgcolor=""#FFFFFF"">" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""0""><tr><td bgcolor=""#003087""><font size=""6"" color=""#FFFFFF""><b><i>Sim</i></b></font><font size=""6"" color=""#009CDE""><b><i>Pal</i></b></font>" + NL
    t = t + "<font color=""#FFCC00"" size=""2"">&nbsp;the way to send money on the information superhighway</font></td></tr></table>" + NL
    t = t + "<h2><font color=""#003087"">About SimPal</font></h2>" + NL
    t = t + "<p><b>SimPal is the easy, secure way to send money and pay online on the SIM95 network.</b>" + NL
    t = t + "It is a wallet for your SimBucks (&sect;): sign up, and you can pay anybody else with a" + NL
    t = t + "SimPal account in seconds. Sign up today and get &sect;100.00 FREE!</p>" + NL
    t = t + "<h3>What you can do with SimPal</h3>" + NL
    t = t + "<ul>" + NL
    t = t + "<li><b>Send money</b> to friends, family or that guy who sold you a modem, with a note.</li>" + NL
    t = t + "<li><b>Request money</b> from people who owe you. They pay or decline with one click.</li>" + NL
    t = t + "<li><b>Shop online</b> at any web site with a <b>Pay with SimPal</b> button, like SimMart. The shop never sees your password.</li>" + NL
    t = t + "<li><b>Accept payments</b> on your own home page with a button you copy and paste, and check every receipt before you ship.</li>" + NL
    t = t + "<li><b>See your history</b>: every payment, purchase and sale, with receipt numbers.</li>" + NL
    t = t + "</ul>" + NL
    t = t + "<h3>Is my money safe?</h3>" + NL
    t = t + "<p>Your money is safe with us!! Every SimBuck is written in the ledger before it moves, so a" + NL
    t = t + "crash can't make money or lose it, and nobody can spend more than they have. Our Secure" + NL
    t = t + "transaction padlock is drawn in genuine text art.</p>" + NL
    t = t + "<p><font size=""2"">(Honestly: SimBucks are play money, SimPal is a toy, there is no encryption on SIM95," + NL
    t = t + "and whoever runs this machine can print as much as they like. See" + NL
    t = t + "<a href=""merchant.asp"">SimPal for your web site</a> for the fine print.)</font></p>" + NL
    t = t + "<h3>Is it like PayPal?</h3>" + NL
    t = t + "<p>Quite a lot like it, a few years early. SimPal is a digital wallet, an online payments service" + NL
    t = t + "and a checkout for online shopping, written in SPARK and running on one SIM95 machine.</p>" + NL
    t = t + "<p><a href=""index.asp""><b>Sign up for SimPal</b></a> or <a href=""index.asp"">log in</a>. It's free!</p>" + NL
    t = t + "<hr><center><font size=""1"" color=""#808080"">SimPal: send money, online payments, wallet and shopping for SIM95.</font></center>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\SIMPAL.HTM")
END SUB

SUB File15 ()
    t = ""
    t = t + "<%@ import file=""C:\PROGRAMS\PALCHECK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' THANKS.ASP - where SimPal sends buyers back to (the button's return=)." + NL
    t = t + "' It must be on the same machine as SimPal to use PALCHECK.SPK." + NL
    t = t + "VAR receipt AS String" + NL
    t = t + "VAR order AS String" + NL
    t = t + "receipt = REQUEST.Query(""receipt"")" + NL
    t = t + "order = REQUEST.Query(""order"")" + NL
    t = t + "%>" + NL
    t = t + "<html><body>" + NL
    t = t + "<% IF VerifyReceipt(receipt, ""%MERCHANT%"", ""4.99"", order) THEN %>" + NL
    t = t + "<h2>Thank you!</h2>" + NL
    t = t + "<p>Order <%= SERVER.HtmlEncode(order) %> is paid. Your widget ships in 6 to 8 weeks.</p>" + NL
    t = t + "<% ELSEIF PalWhy = ""used"" THEN %>" + NL
    t = t + "<p>That receipt has been used already.</p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<p>Sorry, SimPal says that receipt is no good (<%= PalWhy %>).</p>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\THANKS.TXT")
END SUB

SUB File16 ()
    t = ""
    t = t + "<%@ import file=""C:\PROGRAMS\PALCHECK.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' VERIFY.ASP?r=R12-1A2B3C4D[&m=shop&a=4.99&o=order] - is this receipt good?" + NL
    t = t + "' For shops on other machines: a page can't open connections, but a SPARK" + NL
    t = t + "' program (Vapor, say) can fetch this. The answer is one line of plain text:" + NL
    t = t + "'   VALID|merchant|amount|order|buyer|date   the first time; now it is used up" + NL
    t = t + "'   USED|merchant|amount|order|buyer|date    somebody verified it already" + NL
    t = t + "'   INVALID|why                               no such receipt, or m/a/o don't match" + NL
    t = t + "'   BUSY|try again" + NL
    t = t + "' It is PalAnswer in C:\PROGRAMS\PALCHECK.SPK, the same check a shop on this" + NL
    t = t + "' machine makes with VerifyReceipt." + NL
    t = t + "RESPONSE.ContentType = ""text/plain""" + NL
    t = t + "RESPONSE.Clear()" + NL
    t = t + "RESPONSE.Write(PalAnswer(REQUEST.Query(""r""), REQUEST.Query(""m""), REQUEST.Query(""a""), REQUEST.Query(""o"")))" + NL
    t = t + "RESPONSE.End()" + NL
    t = t + "%>" + NL
    Put("C:\WEB\VERIFY.ASP")
END SUB

SUB File17 ()
    t = ""
    t = t + "' PALCHECK.SPK - check a SimPal receipt from a page on the same machine." + NL
    t = t + "'" + NL
    t = t + "' A shop's .ASP page on the machine SimPal runs on (a SimHost machine, say)" + NL
    t = t + "' pulls this in with" + NL
    t = t + "'     <%@ import file=""C:\PROGRAMS\PALCHECK.SPK"" %>" + NL
    t = t + "' and, when a buyer comes back from SimPal with ?receipt=...&order=..., asks" + NL
    t = t + "'     IF VerifyReceipt(REQUEST.Query(""receipt""), ""myshop"", ""4.99"", REQUEST.Query(""order"")) THEN" + NL
    t = t + "' which is TRUE only if that receipt is real, paid myshop exactly 4.99 for" + NL
    t = t + "' that order, and has not been verified before. The second time it is FALSE:" + NL
    t = t + "' a receipt pays for one order, once. PalWhy then says why not." + NL
    t = t + "'" + NL
    t = t + "' It reads SimPal's books in C:\PALDATA directly, so it needs no connection," + NL
    t = t + "' and uses no names from PAL.SPK: everything here starts with Pal or Receipt." + NL
    t = t + "' Pages on other machines can't do this; they ask verify.asp instead." + NL
    t = t + "" + NL
    t = t + "VAR PalWhy AS String          ' after a FALSE: unknown, merchant, amount, order, used or busy" + NL
    t = t + "" + NL
    t = t + "' The receipt's line in SimPal's ledger, or """" when it is not a real receipt." + NL
    t = t + "' A receipt is R<transaction>-<secret>, so it can't be guessed from another." + NL
    t = t + "FUNCTION PalReceiptLine (receipt AS String) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    receipt = receipt.Trim()" + NL
    t = t + "    p = receipt.Split(""-"")" + NL
    t = t + "    IF p.Count <> 2 OR receipt.Length > 20 OR NOT p[0].StartsWith(""R"") THEN RETURN """"" + NL
    t = t + "    id = p[0].Substring(1, p[0].Length - 1)" + NL
    t = t + "    IF id = """" OR id.Length > 8 OR NOT PalOnly(id, ""0123456789"") THEN RETURN """"" + NL
    t = t + "    text = Chr(10) + PalRead(""C:\PALDATA\LEDGER\"" + Str(Int((Int(Val(id)) - 1) / 500)) + "".TXT"")" + NL
    t = t + "    at = text.IndexOf(Chr(10) + id + ""|"")" + NL
    t = t + "    IF at < 0 THEN RETURN """"" + NL
    t = t + "    text = text.Substring(at + 1, text.Length - at - 1)" + NL
    t = t + "    IF text.IndexOf(Chr(10)) >= 0 THEN text = text.Substring(0, text.IndexOf(Chr(10)))" + NL
    t = t + "    p = text.Split(""|"")" + NL
    t = t + "    IF p.Count < 9 THEN RETURN """"" + NL
    t = t + "    IF p[2] <> ""pay"" OR p[7] <> receipt THEN RETURN """"" + NL
    t = t + "    RETURN text" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' merchant|amount|order|buyer|date for a real receipt, or """". Uses nothing up." + NL
    t = t + "FUNCTION ReceiptInfo (receipt AS String) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    line = PalReceiptLine(receipt)" + NL
    t = t + "    IF line = """" THEN RETURN """"" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    RETURN p[4] + ""|"" + PalAmt(Int(Val(p[5]))) + ""|"" + PalUnesc(p[8]) + ""|"" + p[3] + ""|"" + p[1]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' TRUE once: the receipt is real, matches all three, and is now used up." + NL
    t = t + "FUNCTION VerifyReceipt (receipt AS String, merchant AS String, amount AS String, order AS String) AS Bool" + NL
    t = t + "    IF merchant.Trim() = """" OR amount.Trim() = """" OR order.Trim() = """" THEN" + NL
    t = t + "        PalWhy = ""merchant, amount and order are all needed""" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN PalAnswer(receipt, merchant, amount, order).StartsWith(""VALID|"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' What verify.asp says about a receipt; merchant, amount and order may be """"" + NL
    t = t + "' (not checked). One line:" + NL
    t = t + "'   VALID|merchant|amount|order|buyer|date   the first time: now it is used" + NL
    t = t + "'   USED|merchant|amount|order|buyer|date    it was verified before" + NL
    t = t + "'   INVALID|why                               not a receipt, or not this one" + NL
    t = t + "'   BUSY|try again                            SimPal was busy; nothing changed" + NL
    t = t + "FUNCTION PalAnswer (receipt AS String, merchant AS String, amount AS String, order AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR info AS String" + NL
    t = t + "    VAR answer AS String" + NL
    t = t + "    VAR used AS String" + NL
    t = t + "    PalWhy = """"" + NL
    t = t + "    line = PalReceiptLine(receipt)" + NL
    t = t + "    IF line = """" THEN" + NL
    t = t + "        PalWhy = ""unknown""" + NL
    t = t + "        RETURN ""INVALID|no such receipt""" + NL
    t = t + "    END IF" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    IF merchant.Trim() <> """" AND merchant.Trim().Lower() <> p[4] THEN PalWhy = ""merchant""" + NL
    t = t + "    IF amount.Trim() <> """" AND PalCents(amount) <> Int(Val(p[5])) THEN PalWhy = ""amount""" + NL
    t = t + "    IF order.Trim() <> """" AND order.Trim() <> PalUnesc(p[8]) THEN PalWhy = ""order""" + NL
    t = t + "    IF PalWhy <> """" THEN RETURN ""INVALID|wrong "" + PalWhy" + NL
    t = t + "    info = p[4] + ""|"" + PalAmt(Int(Val(p[5]))) + ""|"" + PalUnesc(p[8]) + ""|"" + p[3] + ""|"" + p[1]" + NL
    t = t + "    used = ""C:\PALDATA\USED\"" + p[0] + "".TXT""" + NL
    t = t + "    IF NOT PalLock() THEN" + NL
    t = t + "        PalWhy = ""busy""" + NL
    t = t + "        RETURN ""BUSY|try again""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF FS.Exists(used) THEN" + NL
    t = t + "        PalWhy = ""used""" + NL
    t = t + "        answer = ""USED|"" + info" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF NOT FS.Exists(""C:\PALDATA\USED"") THEN FS.MakeDir(""C:\PALDATA\USED"")" + NL
    t = t + "        FS.Write(used, TIME.Date + "" "" + TIME.Clock)" + NL
    t = t + "        answer = ""VALID|"" + info" + NL
    t = t + "    END IF" + NL
    t = t + "    PalUnlock()" + NL
    t = t + "    RETURN answer" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where buyers pay on this machine: http://host/pal/pay.asp or http://host/pay.asp" + NL
    t = t + "FUNCTION PalPayUrl () AS String" + NL
    t = t + "    IF FS.Exists(""C:\WEB\PAL\PAL.SPK"") THEN RETURN ""http://"" + SERVER.Name.Lower() + ""/pal/pay.asp""" + NL
    t = t + "    RETURN ""http://"" + SERVER.Name.Lower() + ""/pay.asp""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is there a SimPal account by this name?" + NL
    t = t + "FUNCTION PalMember (u AS String) AS Bool" + NL
    t = t + "    IF u.Length < 3 OR u.Length > 8 OR NOT PalOnly(u, ""abcdefghijklmnopqrstuvwxyz0123456789"") THEN RETURN FALSE" + NL
    t = t + "    RETURN FS.Exists(""C:\PALDATA\USERS\"" + u + "".TXT"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- helpers" + NL
    t = t + "" + NL
    t = t + "' SimPal's lock (see PAL.SPK): a folder only one page at a time can make." + NL
    t = t + "FUNCTION PalLock () AS Bool" + NL
    t = t + "    VAR tries AS Integer" + NL
    t = t + "    VAR got AS Bool" + NL
    t = t + "    VAR at AS String" + NL
    t = t + "    WHILE NOT got AND tries < 150" + NL
    t = t + "        tries = tries + 1" + NL
    t = t + "        TRY" + NL
    t = t + "            FS.MakeDir(""C:\PALDATA\LOCK"")" + NL
    t = t + "            got = TRUE" + NL
    t = t + "        CATCH err" + NL
    t = t + "            got = FALSE" + NL
    t = t + "        END TRY" + NL
    t = t + "        IF NOT got THEN" + NL
    t = t + "            at = PalRead(""C:\PALDATA\LOCK\AT.TXT"")" + NL
    t = t + "            IF (at <> """" AND TIME.Now - Int(Val(at)) > 10) OR (at = """" AND tries MOD 50 = 0) THEN" + NL
    t = t + "                PalUnlock()" + NL
    t = t + "            ELSE" + NL
    t = t + "                SYS.Sleep(20)" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF got THEN FS.Write(""C:\PALDATA\LOCK\AT.TXT"", Str(TIME.Now))" + NL
    t = t + "    RETURN got" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB PalUnlock ()" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(""C:\PALDATA\LOCK\AT.TXT"") THEN FS.Delete(""C:\PALDATA\LOCK\AT.TXT"")" + NL
    t = t + "        IF FS.Exists(""C:\PALDATA\LOCK"") THEN FS.Delete(""C:\PALDATA\LOCK"")" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION PalRead (path AS String) AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(path) THEN text = FS.Read(path)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        text = """"" + NL
    t = t + "    END TRY" + NL
    t = t + "    RETURN text" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION PalOnly (s AS String, allowed AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        IF NOT allowed.Contains(s.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION PalUnesc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%0A"", Chr(10)).Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""4.99"", ""4.9"", ""§4.99"" -> 499; -1 when it is not an amount." + NL
    t = t + "FUNCTION PalCents (s AS String) AS Integer" + NL
    t = t + "    VAR whole AS String" + NL
    t = t + "    VAR frac AS String" + NL
    t = t + "    VAR dot AS Integer" + NL
    t = t + "    s = s.Trim().Replace("","", """")" + NL
    t = t + "    IF s.StartsWith(""§"") OR s.StartsWith(""$"") THEN s = s.Substring(1, s.Length - 1).Trim()" + NL
    t = t + "    dot = s.IndexOf(""."")" + NL
    t = t + "    whole = s" + NL
    t = t + "    IF dot >= 0 THEN" + NL
    t = t + "        whole = s.Substring(0, dot)" + NL
    t = t + "        frac = s.Substring(dot + 1, s.Length - dot - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF whole = """" THEN whole = ""0""" + NL
    t = t + "    IF whole.Length > 7 OR frac.Length > 2 OR NOT PalOnly(whole + frac, ""0123456789"") THEN RETURN -1" + NL
    t = t + "    frac = (frac + ""00"").Substring(0, 2)" + NL
    t = t + "    RETURN Int(Val(whole)) * 100 + Int(Val(frac))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION PalAmt (c AS Integer) AS String" + NL
    t = t + "    VAR frac AS String" + NL
    t = t + "    frac = Str(c MOD 100)" + NL
    t = t + "    IF frac.Length < 2 THEN frac = ""0"" + frac" + NL
    t = t + "    RETURN Str(Int(c / 100)) + ""."" + frac" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\PROGRAMS\PALCHECK.SPK")
END SUB

' HTTPD.SPK serves INDEX.ASP for a folder only when it has no INDEX.HTM, so the
' stock home page steps aside (to the first free name) instead of being deleted.
SUB MoveHomePage ()
    VAR names AS Array OF String
    VAR name AS String
    IF NOT FS.Exists("C:\WEB\INDEX.HTM") THEN RETURN
    names = ["WELCOME.HTM", "INDEX1.HTM", "INDEX2.HTM", "INDEX3.HTM", "INDEX4.HTM", "INDEX5.HTM", "INDEX6.HTM", "INDEX7.HTM", "INDEX8.HTM", "INDEX9.HTM"]
    FOR EACH name IN names
        IF NOT FS.Exists("C:\WEB\" + name) THEN
            FS.Rename("C:\WEB\INDEX.HTM", "C:\WEB\" + name)
            Print("  moved the old home page to C:\WEB\" + name)
            RETURN
        END IF
    NEXT
    THROW "C:\WEB\INDEX.HTM is in the way and there is nowhere to move it. Rename it yourself and run this again."
END SUB
