' VAPOR|id=SIMXPLOR|name=Simxplorer|kind=program|version=00beabf3|category=Internet|run=C:\PROGRAMS\SIMXPLOR.SPK|files=C:\WEB\SXDEMO\BADGE.PIC;C:\WEB\SXDEMO\GETSX.HTM;C:\WEB\SXDEMO\INDEX.ASP;C:\WEB\SXDEMO\SNIFF.SPK;C:\WEB\SXDEMO\TIME.ASP;C:\PROGRAMS\SIMXPLOR.SPK|tasks=SIMXPLOR|startup=|folder=|about=A web browser with JavaScript, favorites, history, find on page and AutoSearch.
' INSTALL.SPK - puts Simxplorer on this machine. Generated by tools/build-installer.mjs;
' edit the files in simxplorer/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It writes
' Simxplorer to C:\PROGRAMS\SIMXPLOR.SPK: the browser window and its
' JavaScript engine in one program. Start it from Files (double-click it) or
' from SPARK. Your Voyager bookmarks become its Favorites the first time, and
' the two share cookies (C:\SYSTEM\COOKIES.TXT). Settings are kept in
' C:\SYSTEM\SIMXPLOR.INI. It also puts a demo in C:\WEB\SXDEMO (the Live
' Page, at http://YOURNAME/sxdemo/ when the web server runs) with SNIFF.SPK,
' which tells server pages which browser is asking. The home page is not touched.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)

    IF NOT FS.Exists(Dest("C:\WEB\SXDEMO")) THEN FS.MakeDir(Dest("C:\WEB\SXDEMO"))


    File0()
    File1()
    File2()
    File3()
    File4()
    File5()
    Print("Simxplorer is installed (6 files).")
    SYS.Start("C:\PROGRAMS\SIMXPLOR.SPK", "")

    Print("Simxplorer is running. Next time, start C:\PROGRAMS\SIMXPLOR.SPK from Files. Its demo: http://" + NET.HostName.Lower() + "/sxdemo/")
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

