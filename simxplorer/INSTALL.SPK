SUB File1 ()
    t = ""
    t = t + "<html><head><title>Get Simxplorer</title></head>" + NL
    t = t + "<body bgcolor=""#FFFFFF"">" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""0""><tr><td bgcolor=""#000080"">" + NL
    t = t + "<font color=""#FFFFFF"" size=""5""><b>Get Simxplorer 3</b></font></td></tr></table>" + NL
    t = t + "<p><img src=""badge.pic"" width=""88"" height=""31"" alt=""Best viewed in Simxplorer""></p>" + NL
    t = t + "<p><b>Simxplorer</b> is the web browser for SIM95 that runs JavaScript: pages that talk back," + NL
    t = t + "forms that check themselves, alerts, cookies, timers, and pages that keep up with the server" + NL
    t = t + "without reloading (XMLHttpRequest). It is free.</p>" + NL
    t = t + "<h3>Three ways to get it</h3>" + NL
    t = t + "<ol>" + NL
    t = t + "<li><b>From a Vapor store.</b> Any machine running Vapor has a store at <tt>http://THATMACHINE/vapor/</tt>." + NL
    t = t + "Simxplorer is on its Apps shelf: install it from Vapor with one click.</li>" + NL
    t = t + "<li><b>From the person who runs this site.</b> Ask for Simxplorer's <tt>INSTALL.SPK</tt>. Paste it into SPARK," + NL
    t = t + "save it as <tt>C:\MYFILES\INSTALL.SPK</tt> and press F5.</li>" + NL
    t = t + "<li><b>From a friend's machine.</b> If a machine has Simxplorer, its Files service can copy" + NL
    t = t + "<tt>C:\PROGRAMS\SIMXPLOR.SPK</tt> across.</li>" + NL
    t = t + "</ol>" + NL
    t = t + "<p>Then double-click <tt>SIMXPLOR.SPK</tt> in Files, and come <a href=""index.asp"">back here</a>.</p>" + NL
    t = t + "<hr><p><font size=""2"">Simxplorer keeps Voyager's cookies and turns your bookmarks into Favorites, so you lose nothing by switching.</font></p>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\SXDEMO\GETSX.HTM")
END SUB

SUB File2 ()
    t = ""
    t = t + "<%@ import file=""SNIFF.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' INDEX.ASP - Simxplorer's demo page (http://YOURNAME/sxdemo/): a clock and a" + NL
    t = t + "' counter that keep up with the server through XMLHttpRequest, without the" + NL
    t = t + "' page ever reloading. Other browsers are sent to get Simxplorer." + NL
    t = t + "VAR gate AS String" + NL
    t = t + "gate = NeedsSimxplorer(""3.0"")" + NL
    t = t + "IF gate <> """" THEN" + NL
    t = t + "    RESPONSE.Write(""<html><head><title>Simxplorer required</title></head><body bgcolor=""""#008080"""" text=""""#FFFFFF""""><br>"" + gate _" + NL
    t = t + "        + ""<p align=""""center""""><a href=""""getsx.htm""""><img src=""""badge.pic"""" width=""""88"""" height=""""31"""" border=""""0"""" alt=""""Best viewed in Simxplorer""""></a></p></body></html>"")" + NL
    t = t + "    RESPONSE.End()" + NL
    t = t + "END IF" + NL
    t = t + "%><html><head><title>The Live Page</title></head>" + NL
    t = t + "<body bgcolor=""#FFFFFF"" onload=""start()"">" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""0""><tr><td bgcolor=""#000080"">" + NL
    t = t + "<font color=""#FFFF00"" size=""5""><b>The Live Page</b></font>" + NL
    t = t + "<font color=""#FFFFFF"" size=""2"">on <%= SERVER.Name.Lower() %>, served to <%= BrowserName() %> <%= BrowserVersion() %></font>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "" + NL
    t = t + "<p>Watch this. The clock below comes from the <b>server</b>, a second at a time, and the page never reloads." + NL
    t = t + "Your browser asks for it in the background with <tt>XMLHttpRequest</tt>, the trick behind tomorrow's web.</p>" + NL
    t = t + "" + NL
    t = t + "<table border=""2"" cellpadding=""8"" cellspacing=""0"" bgcolor=""#000000""><tr>" + NL
    t = t + "<td><font color=""#00FF00"" size=""6""><tt><b><span id=""clock"">--:--:--</span></b></tt></font></td>" + NL
    t = t + "<td><font color=""#00FF00"">Visitors' requests answered:<br><font size=""5""><b><span id=""hits"">0</span></b></font></font></td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<p><font size=""2""><span id=""state"">Connecting to the server...</span></font></p>" + NL
    t = t + "" + NL
    t = t + "<h3>Talk to the server</h3>" + NL
    t = t + "<p>Type something and send it. It goes by POST, and the answer lands here without a new page.</p>" + NL
    t = t + "<p><input id=""said"" size=""30"" onenter=""shout()""> <input type=""button"" value=""Send"" onclick=""shout()"">" + NL
    t = t + "<br><b><span id=""echo""></span></b></p>" + NL
    t = t + "" + NL
    t = t + "<hr>" + NL
    t = t + "<p><a href=""getsx.htm""><img src=""badge.pic"" width=""88"" height=""31"" border=""0"" alt=""Best viewed in Simxplorer""></a>" + NL
    t = t + "<font size=""2"">This page is best viewed in Simxplorer 3.0 or higher, at 640x480 in 16 colours.</font></p>" + NL
    t = t + "" + NL
    t = t + "<script language=""JavaScript"">" + NL
    t = t + "<!--" + NL
    t = t + "var answers = 0, timer;" + NL
    t = t + "" + NL
    t = t + "// Simxplorer and IE 5 both know it under one name or the other" + NL
    t = t + "function request() {" + NL
    t = t + "  if (window.XMLHttpRequest) return new XMLHttpRequest();" + NL
    t = t + "  return new ActiveXObject(""Microsoft.XMLHTTP"");" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function tick() {" + NL
    t = t + "  var x = request();" + NL
    t = t + "  x.onreadystatechange = function () {" + NL
    t = t + "    if (x.readyState != 4) return;" + NL
    t = t + "    if (x.status == 200) {" + NL
    t = t + "      var parts = x.responseText.split(""|"");" + NL
    t = t + "      document.getElementById(""clock"").innerText = parts[0];" + NL
    t = t + "      document.getElementById(""hits"").innerText = parts[1];" + NL
    t = t + "      answers++;" + NL
    t = t + "      document.getElementById(""state"").innerText = ""Updated "" + answers + "" times without reloading the page."";" + NL
    t = t + "    } else {" + NL
    t = t + "      document.getElementById(""state"").innerText = ""The server did not answer (status "" + x.status + "")."";" + NL
    t = t + "    }" + NL
    t = t + "  };" + NL
    t = t + "  x.open(""GET"", ""time.asp?n="" + answers, true);" + NL
    t = t + "  x.send(null);" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function shout() {" + NL
    t = t + "  var box = document.getElementById(""said"");" + NL
    t = t + "  var x = request();" + NL
    t = t + "  x.onreadystatechange = function () {" + NL
    t = t + "    if (x.readyState == 4) document.getElementById(""echo"").innerText = x.status == 200 ? x.responseText : ""No answer."";" + NL
    t = t + "  };" + NL
    t = t + "  x.open(""POST"", ""time.asp"", true);" + NL
    t = t + "  x.setRequestHeader(""Content-Type"", ""application/x-www-form-urlencoded"");" + NL
    t = t + "  x.send(""say="" + escape(box.value));" + NL
    t = t + "  box.value = """";" + NL
    t = t + "}" + NL
    t = t + "" + NL
    t = t + "function start() {" + NL
    t = t + "  tick();" + NL
    t = t + "  timer = setInterval(""tick()"", 1000);" + NL
    t = t + "}" + NL
    t = t + "// -->" + NL
    t = t + "</script>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\SXDEMO\INDEX.ASP")
END SUB

SUB File3 ()
    t = ""
    t = t + "' SNIFF.SPK - which browser is asking? For ActiveSparkPages that want to" + NL
    t = t + "' know, or that are best viewed in Simxplorer. Import it into a page:" + NL
    t = t + "'" + NL
    t = t + "'     <%@ import file=""SNIFF.SPK"" %>                  (a copy next to the page)" + NL
    t = t + "'     <%@ import file=""../SXDEMO/SNIFF.SPK"" %>        (Simxplorer's own copy)" + NL
    t = t + "'     <%@ import file=""C:\WEB\SXDEMO\SNIFF.SPK"" %>    (the same, from anywhere)" + NL
    t = t + "'" + NL
    t = t + "' Simxplorer's installer puts it in C:\WEB\SXDEMO. It reads the request's" + NL
    t = t + "' User-Agent:" + NL
    t = t + "'     Voyager      Voyager/1.1 (SIM95)" + NL
    t = t + "'     Simxplorer   Mozilla/2.0 (compatible; Simxplorer 3.02; SIM95)" + NL
    t = t + "'" + NL
    t = t + "'     IsSimxplorer(), IsVoyager()   TRUE when that browser asked" + NL
    t = t + "'     BrowserName()                 ""Simxplorer"", ""Voyager"", whatever else" + NL
    t = t + "'                                   said who it was, or ""Unknown""" + NL
    t = t + "'     BrowserVersion()              ""3.02"", ""1.1"", or """"" + NL
    t = t + "'     NeedsSimxplorer(""3.0"")        """" in Simxplorer 3.0 or newer; anywhere" + NL
    t = t + "'                                   else, a ""This page requires Simxplorer""" + NL
    t = t + "'                                   block to send instead of the page:" + NL
    t = t + "'" + NL
    t = t + "'     <% VAR gate AS String" + NL
    t = t + "'        gate = NeedsSimxplorer(""3.0"")" + NL
    t = t + "'        IF gate <> """" THEN" + NL
    t = t + "'            RESPONSE.Write(""<html><body>"" + gate + ""</body></html>"")" + NL
    t = t + "'            RESPONSE.End()" + NL
    t = t + "'        END IF %>" + NL
    t = t + "'" + NL
    t = t + "' Its own names all start with Sniff, to stay out of the page's way." + NL
    t = t + "" + NL
    t = t + "FUNCTION SniffAgent () AS String" + NL
    t = t + "    RETURN REQUEST.Header(""User-Agent"").Trim()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsSimxplorer () AS Bool" + NL
    t = t + "    RETURN SniffAgent().Contains(""Simxplorer"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsVoyager () AS Bool" + NL
    t = t + "    RETURN SniffAgent().StartsWith(""Voyager/"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION BrowserName () AS String" + NL
    t = t + "    VAR ua AS String" + NL
    t = t + "    ua = SniffAgent()" + NL
    t = t + "    IF IsSimxplorer() THEN RETURN ""Simxplorer""" + NL
    t = t + "    IF IsVoyager() THEN RETURN ""Voyager""" + NL
    t = t + "    IF ua = """" THEN RETURN ""Unknown""" + NL
    t = t + "    RETURN ua.Split(""/"")[0].Split("" "")[0]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION BrowserVersion () AS String" + NL
    t = t + "    VAR ua AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    ua = SniffAgent()" + NL
    t = t + "    IF IsSimxplorer() THEN" + NL
    t = t + "        ' the version is the browser's own, not the Mozilla/2.0 it starts with" + NL
    t = t + "        v = ua.Substring(ua.IndexOf(""Simxplorer"") + 10, ua.Length - ua.IndexOf(""Simxplorer"") - 10)" + NL
    t = t + "        RETURN v.Split("";"")[0].Split("")"")[0].Trim()" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT ua.Contains(""/"") THEN RETURN """"" + NL
    t = t + "    RETURN ua.Split(""/"")[1].Split("" "")[0].Trim()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where to get Simxplorer: this machine's Vapor store, or the page about it" + NL
    t = t + "' that comes with Simxplorer. """" when neither is here." + NL
    t = t + "FUNCTION SniffGetUrl () AS String" + NL
    t = t + "    IF FS.Exists(""C:\WEB\VAPOR\CATALOG.TXT"") THEN" + NL
    t = t + "        IF FS.Read(""C:\WEB\VAPOR\CATALOG.TXT"").Contains(""SIMXPLOR|"") THEN RETURN ""/vapor/#apps""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF FS.Exists(""C:\WEB\SXDEMO\GETSX.HTM"") THEN RETURN ""/sxdemo/getsx.htm""" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NeedsSimxplorer (minVersion AS String) AS String" + NL
    t = t + "    VAR html AS String" + NL
    t = t + "    VAR where AS String" + NL
    t = t + "    VAR yours AS String" + NL
    t = t + "    IF IsSimxplorer() AND Val(BrowserVersion()) >= Val(minVersion) THEN RETURN """"" + NL
    t = t + "    yours = BrowserName()" + NL
    t = t + "    IF BrowserVersion() <> """" THEN yours = yours + "" "" + BrowserVersion()" + NL
    t = t + "    where = SniffGetUrl()" + NL
    t = t + "    html = ""<center><table width=""""90%"""" border=""""4"""" cellpadding=""""10"""" cellspacing=""""0"""" bgcolor=""""#000080""""><tr><td align=""""center"""">"" _" + NL
    t = t + "         + ""<font color=""""#FFFF00"""" size=""""5""""><b><blink>Attention, surfer!</blink></b></font><br><br>"" _" + NL
    t = t + "         + ""<font color=""""#FFFFFF"""" size=""""4""""><b>This page requires Simxplorer "" + SERVER.HtmlEncode(minVersion) + "" or higher - """ + NL
    t = t + "    IF where = """" THEN" + NL
    t = t + "        html = html + ""Download it now!</b></font>""" + NL
    t = t + "    ELSE" + NL
    t = t + "        html = html + ""<a href="""""" + where + """"""><font color=""""#00FF00"""">Download it now!</font></a></b></font>""" + NL
    t = t + "    END IF" + NL
    t = t + "    html = html + ""<br><br><font color=""""#C0C0C0"""">You are using <b>"" + SERVER.HtmlEncode(yours) + ""</b>. This site uses JavaScript and"" _" + NL
    t = t + "         + "" XMLHttpRequest, so it looks best in Simxplorer, the browser with JavaScript for SIM95.</font>""" + NL
    t = t + "    IF where = """" THEN html = html + ""<br><font color=""""#C0C0C0"""" size=""""2"""">Ask at any Vapor store: Simxplorer is on the Apps shelf, free.</font>""" + NL
    t = t + "    RETURN html + ""</td></tr></table></center>""" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\WEB\SXDEMO\SNIFF.SPK")
END SUB

SUB File4 ()
    t = ""
    t = t + "<%@ import file=""SNIFF.SPK"" %><%" + NL
    t = t + "' TIME.ASP - what the Live Page asks for in the background: the server's" + NL
    t = t + "' clock and how many requests it has answered, as ""14:05:09|42"". A POST" + NL
    t = t + "' with say= is answered too, shouted back." + NL
    t = t + "VAR here AS String" + NL
    t = t + "VAR file AS String" + NL
    t = t + "VAR count AS Integer" + NL
    t = t + "here = SERVER.ScriptName" + NL
    t = t + "here = here.Substring(0, here.Length - here.Split(""\"")[here.Split(""\"").Count - 1].Length)" + NL
    t = t + "file = here + ""HITS.TXT""" + NL
    t = t + "IF FS.Exists(file) THEN count = Int(Val(FS.Read(file)))" + NL
    t = t + "count = count + 1" + NL
    t = t + "FS.Write(file, Str(count))" + NL
    t = t + "RESPONSE.ContentType = ""text/plain""" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    RESPONSE.Write(TIME.Clock + "" "" + BrowserName() + "" "" + BrowserVersion() + "" said: "" + REQUEST.Form(""say"").Upper() + ""!"")" + NL
    t = t + "ELSE" + NL
    t = t + "    RESPONSE.Write(TIME.Clock + ""|"" + Str(count))" + NL
    t = t + "END IF" + NL
    t = t + "RESPONSE.End()" + NL
    t = t + "%>" + NL
    Put("C:\WEB\SXDEMO\TIME.ASP")
END SUB

SUB File5 ()
    t = ""
    t = t + "' JSCRIPT.SPK - a JavaScript interpreter written in SPARK, for the browser." + NL
    t = t + "'" + NL
    t = t + "' It aims at the JavaScript of 1996 (what the browsers of 1996" + NL
    t = t + "' ran) plus a few later conveniences: var, functions and closures, if / while /" + NL
    t = t + "' do / for / for-in / switch / try-catch, objects and arrays, new and this," + NL
    t = t + "' Math, Date, String (with the HTML helpers like ""x"".bold()), Array, parseInt," + NL
    t = t + "' escape, eval, setTimeout, and the page itself through document and window." + NL
    t = t + "' No regular expressions, no bitwise operators, no getters or prototypes" + NL
    t = t + "' beyond the ones built in." + NL
    t = t + "'" + NL
    t = t + "' How it is put together, since SPARK has no records:" + NL
    t = t + "'   * Tokens are parallel arrays (jtType, jtText, jtLine, jtNl)." + NL
    t = t + "'   * The syntax tree is parallel arrays indexed by node number (nk = kind," + NL
    t = t + "'     na/nb/nc/nd = child nodes, ns = a name or literal, nl = a list of nodes)." + NL
    t = t + "'   * A value is a tagged string: ""u"" undefined, ""l"" null, ""t"" / ""f"" booleans," + NL
    t = t + "'     ""n"" + number, ""s"" + text, ""o"" + object number." + NL
    t = t + "'   * Objects (and scopes, which are objects too) live in one property table:" + NL
    t = t + "'     jpKey holds ""object:name"", jpVal the value. joClass, joProto, joA, joB and" + NL
    t = t + "'     joS describe each object: an Array, a Function (joA = its node, joB = the" + NL
    t = t + "'     scope it closes over), a Native function (joS = which one), a Host" + NL
    t = t + "'     element (joS = its id on the page)..." + NL
    t = t + "'" + NL
    t = t + "' The page it runs in is reached through Host... functions, which the browser" + NL
    t = t + "' defines: HostAlert, HostConfirm, HostPrompt, HostStatus, HostNavigate," + NL
    t = t + "' HostGet, HostSet, HostHas, HostInfo, HostSetInfo, HostTimeout," + NL
    t = t + "' HostClearTimeout, HostHistory, HostOpen, HostSubmit, HostYield, HostSlow," + NL
    t = t + "' and HostXhrSend and HostXhrAbort for XMLHttpRequest." + NL
    t = t + "'" + NL
    t = t + "' JsReset() starts a fresh page. JsRun(source) runs a script and returns """"" + NL
    t = t + "' or an error (""line|message""). What document.write wrote is in jsOut." + NL
    t = t + "'" + NL
    t = t + "' XMLHttpRequest (and IE's ActiveXObject(""Microsoft.XMLHTTP"")): send() hands" + NL
    t = t + "' the request to HostXhrSend and returns at once. The browser fetches it and" + NL
    t = t + "' reports back through JsXhrUpdate, which runs onreadystatechange. fetch()" + NL
    t = t + "' rides on the same machinery and returns a small promise (then and catch)." + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- state" + NL
    t = t + "" + NL
    t = t + "VAR jtType AS Array OF String" + NL
    t = t + "VAR jtText AS Array OF String" + NL
    t = t + "VAR jtLine AS Array OF Integer" + NL
    t = t + "VAR jtNl AS Array OF Bool" + NL
    t = t + "VAR jp AS Integer" + NL
    t = t + "VAR jsLineBase AS Integer" + NL
    t = t + "" + NL
    t = t + "VAR nk AS Array OF String" + NL
    t = t + "VAR na AS Array OF Integer" + NL
    t = t + "VAR nb AS Array OF Integer" + NL
    t = t + "VAR nc AS Array OF Integer" + NL
    t = t + "VAR nd AS Array OF Integer" + NL
    t = t + "VAR ns AS Array OF String" + NL
    t = t + "VAR nl AS Array OF String" + NL
    t = t + "VAR nline AS Array OF Integer" + NL
    t = t + "" + NL
    t = t + "VAR jpKey AS Array OF String" + NL
    t = t + "VAR jpVal AS Array OF String" + NL
    t = t + "VAR joClass AS Array OF String" + NL
    t = t + "VAR joProto AS Array OF Integer" + NL
    t = t + "VAR joA AS Array OF Integer" + NL
    t = t + "VAR joB AS Array OF Integer" + NL
    t = t + "VAR joS AS Array OF String" + NL
    t = t + "VAR joKeys AS Array OF String" + NL
    t = t + "" + NL
    t = t + "VAR jsGlobal AS Integer" + NL
    t = t + "VAR jsObjectProto AS Integer" + NL
    t = t + "VAR jsFunctionProto AS Integer" + NL
    t = t + "VAR jsArrayProto AS Integer" + NL
    t = t + "VAR jsStringProto AS Integer" + NL
    t = t + "VAR jsNumberProto AS Integer" + NL
    t = t + "VAR jsDateProto AS Integer" + NL
    t = t + "VAR jsDocument AS Integer" + NL
    t = t + "VAR jsLocation AS Integer" + NL
    t = t + "VAR jsFormsArray AS Integer" + NL
    t = t + "VAR jsXhrProto AS Integer" + NL
    t = t + "VAR jsPromiseProto AS Integer" + NL
    t = t + "VAR jsErrorProto AS Integer" + NL
    t = t + "VAR jsHostCache AS Array OF String   ' ""id|object"" for page elements already wrapped" + NL
    t = t + "" + NL
    t = t + "VAR jsSig AS String                  ' """" or ""b"" break, ""c"" continue, ""r"" return" + NL
    t = t + "VAR jsRet AS String" + NL
    t = t + "VAR jsLine AS Integer" + NL
    t = t + "VAR jsDepth AS Integer" + NL
    t = t + "VAR jsSteps AS Integer" + NL
    t = t + "VAR jsLimit AS Integer" + NL
    t = t + "VAR jsOut AS String" + NL
    t = t + "VAR jsThrown AS String               ' a value a script threw, while it unwinds" + NL
    t = t + "" + NL
    t = t + "CONST JSMAXDEPTH = 24" + NL
    t = t + "CONST JSSTEPLIMIT = 300000" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the lexer" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsPeek (src AS String, i AS Integer, count AS Integer) AS String" + NL
    t = t + "    IF i >= src.Length THEN RETURN """"" + NL
    t = t + "    IF i + count > src.Length THEN RETURN src.Substring(i, src.Length - i)" + NL
    t = t + "    RETURN src.Substring(i, count)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JsAddToken (kind AS String, text AS String, line AS Integer, newline AS Bool)" + NL
    t = t + "    jtType.Add(kind)" + NL
    t = t + "    jtText.Add(text)" + NL
    t = t + "    jtLine.Add(line)" + NL
    t = t + "    jtNl.Add(newline)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB JsLex (src AS String)" + NL
    t = t + "    VAR hexLen AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR fresh AS Bool" + NL
    t = t + "    VAR start AS Integer" + NL
    t = t + "    VAR word AS String" + NL
    t = t + "    VAR q AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    VAR op AS String" + NL
    t = t + "    VAR ops AS Array OF String" + NL
    t = t + "    VAR found AS Bool" + NL
    t = t + "    jtType.Clear()" + NL
    t = t + "    jtText.Clear()" + NL
    t = t + "    jtLine.Clear()" + NL
    t = t + "    jtNl.Clear()" + NL
    t = t + "    ops = [""==="", ""!=="", ""=="", ""=>"", ""!="", ""<="", "">="", ""&&"", ""||"", ""++"", ""--"", ""+="", ""-="", ""*="", ""/="", ""%="", ""+"", ""-"", ""*"", ""/"", ""%"", ""<"", "">"", ""="", ""!"", ""?"", "":"", ""."", "","", "";"", ""("", "")"", ""{"", ""}"", ""["", ""]""]" + NL
    t = t + "    n = src.Length" + NL
    t = t + "    line = jsLineBase" + NL
    t = t + "    fresh = TRUE" + NL
    t = t + "    WHILE i < n" + NL
    t = t + "        c = src.CharAt(i)" + NL
    t = t + "        IF c = Chr(10) THEN" + NL
    t = t + "            line = line + 1" + NL
    t = t + "            fresh = TRUE" + NL
    t = t + "            i = i + 1" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF c = "" "" OR c = Chr(9) OR c = Chr(13) THEN" + NL
    t = t + "            i = i + 1" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        ' Comments, including the <!-- and --> that hid scripts from old browsers" + NL
    t = t + "        IF JsPeek(src, i, 2) = ""//"" OR JsPeek(src, i, 4) = ""<!--"" OR (fresh AND JsPeek(src, i, 3) = ""-->"") THEN" + NL
    t = t + "            WHILE i < n AND src.CharAt(i) <> Chr(10)" + NL
    t = t + "                i = i + 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF JsPeek(src, i, 2) = ""/*"" THEN" + NL
    t = t + "            i = i + 2" + NL
    t = t + "            WHILE i < n AND JsPeek(src, i, 2) <> ""*/""" + NL
    t = t + "                IF src.CharAt(i) = Chr(10) THEN line = line + 1" + NL
    t = t + "                i = i + 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "            i = i + 2" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        ' Numbers: 12, 3.5, .5, 1e3, 0x1F" + NL
    t = t + "        IF ""0123456789"".Contains(c) OR (c = ""."" AND ""0123456789"".Contains(JsPeek(src, i + 1, 1)) AND JsPeek(src, i + 1, 1) <> """") THEN" + NL
    t = t + "            start = i" + NL
    t = t + "            IF JsPeek(src, i, 2).Lower() = ""0x"" THEN" + NL
    t = t + "                i = i + 2" + NL
    t = t + "                WHILE i < n AND ""0123456789abcdefABCDEF"".Contains(src.CharAt(i))" + NL
    t = t + "                    i = i + 1" + NL
    t = t + "                END WHILE" + NL
    t = t + "            ELSE" + NL
    t = t + "                WHILE i < n AND ""0123456789."".Contains(src.CharAt(i))" + NL
    t = t + "                    i = i + 1" + NL
    t = t + "                END WHILE" + NL
    t = t + "                IF i < n AND (src.CharAt(i) = ""e"" OR src.CharAt(i) = ""E"") THEN" + NL
    t = t + "                    i = i + 1" + NL
    t = t + "                    IF i < n AND (src.CharAt(i) = ""+"" OR src.CharAt(i) = ""-"") THEN i = i + 1" + NL
    t = t + "                    WHILE i < n AND ""0123456789"".Contains(src.CharAt(i))" + NL
    t = t + "                        i = i + 1" + NL
    t = t + "                    END WHILE" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "            JsAddToken(""num"", src.Substring(start, i - start), line, fresh)" + NL
    t = t + "            fresh = FALSE" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        ' Names and keywords" + NL
    t = t + "        IF ""abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$"".Contains(c) THEN" + NL
    t = t + "            start = i" + NL
    t = t + "            WHILE i < n AND ""abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$0123456789"".Contains(src.CharAt(i))" + NL
    t = t + "                i = i + 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "            word = src.Substring(start, i - start)" + NL
    t = t + "            IF ""|var|function|return|if|else|while|for|in|do|break|continue|new|this|true|false|null|typeof|void|delete|switch|case|default|try|catch|finally|throw|instanceof|"".Contains(""|"" + word + ""|"") THEN" + NL
    t = t + "                JsAddToken(""kw"", word, line, fresh)" + NL
    t = t + "            ELSE" + NL
    t = t + "                JsAddToken(""id"", word, line, fresh)" + NL
    t = t + "            END IF" + NL
    t = t + "            fresh = FALSE" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        ' Strings, with backslash escapes" + NL
    t = t + "        IF c = """""""" OR c = ""'"" THEN" + NL
    t = t + "            q = c" + NL
    t = t + "            text = """"" + NL
    t = t + "            i = i + 1" + NL
    t = t + "            WHILE i < n AND src.CharAt(i) <> q" + NL
    t = t + "                c = src.CharAt(i)" + NL
    t = t + "                IF c = Chr(10) THEN THROW Str(line) + ""|Unterminated string constant""" + NL
    t = t + "                IF c = ""\"" AND i + 1 < n THEN" + NL
    t = t + "                    i = i + 1" + NL
    t = t + "                    e = src.CharAt(i)" + NL
    t = t + "                    SELECT CASE e" + NL
    t = t + "                        CASE ""n""" + NL
    t = t + "                            text = text + Chr(10)" + NL
    t = t + "                        CASE ""t""" + NL
    t = t + "                            text = text + Chr(9)" + NL
    t = t + "                        CASE ""r""" + NL
    t = t + "                            text = text + Chr(13)" + NL
    t = t + "                        CASE ""b""" + NL
    t = t + "                            text = text + Chr(8)" + NL
    t = t + "                        CASE Chr(10)" + NL
    t = t + "                            line = line + 1" + NL
    t = t + "                        CASE ""u"", ""x""" + NL
    t = t + "                            hexLen = 4" + NL
    t = t + "                            IF e = ""x"" THEN hexLen = 2" + NL
    t = t + "                            IF i + hexLen < n AND OnlyChars(src.Substring(i + 1, hexLen).Lower(), ""0123456789abcdef"") THEN" + NL
    t = t + "                                text = text + Chr(Int(Val(JsNumberText(""0x"" + src.Substring(i + 1, hexLen)))))" + NL
    t = t + "                                i = i + hexLen" + NL
    t = t + "                            ELSE" + NL
    t = t + "                                text = text + e" + NL
    t = t + "                            END IF" + NL
    t = t + "                        CASE ELSE" + NL
    t = t + "                            text = text + e" + NL
    t = t + "                    END SELECT" + NL
    t = t + "                ELSE" + NL
    t = t + "                    text = text + c" + NL
    t = t + "                END IF" + NL
    t = t + "                i = i + 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "            IF i >= n THEN THROW Str(line) + ""|Unterminated string constant""" + NL
    t = t + "            i = i + 1" + NL
    t = t + "            JsAddToken(""str"", text, line, fresh)" + NL
    t = t + "            fresh = FALSE" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        ' Operators, longest first" + NL
    t = t + "        found = FALSE" + NL
    t = t + "        FOR EACH op IN ops" + NL
    t = t + "            IF JsPeek(src, i, op.Length) = op THEN" + NL
    t = t + "                JsAddToken(""op"", op, line, fresh)" + NL
    t = t + "                i = i + op.Length" + NL
    t = t + "                found = TRUE" + NL
    t = t + "                BREAK" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF NOT found THEN THROW Str(line) + ""|Invalid character""" + NL
    t = t + "        fresh = FALSE" + NL
    t = t + "    END WHILE" + NL
    t = t + "    JsAddToken(""eof"", """", line, TRUE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the parser" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNode (kind AS String, a AS Integer, b AS Integer, c AS Integer, d AS Integer, s AS String, list AS String, line AS Integer) AS Integer" + NL
    t = t + "    nk.Add(kind)" + NL
    t = t + "    na.Add(a)" + NL
    t = t + "    nb.Add(b)" + NL
    t = t + "    nc.Add(c)" + NL
    t = t + "    nd.Add(d)" + NL
    t = t + "    ns.Add(s)" + NL
    t = t + "    nl.Add(list)" + NL
    t = t + "    nline.Add(line)" + NL
    t = t + "    RETURN nk.Count - 1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsIsOp (op AS String) AS Bool" + NL
    t = t + "    RETURN jtType[jp] = ""op"" AND jtText[jp] = op" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsIsKw (kw AS String) AS Bool" + NL
    t = t + "    RETURN jtType[jp] = ""kw"" AND jtText[jp] = kw" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsAt () AS Integer" + NL
    t = t + "    RETURN jtLine[jp]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JsExpect (op AS String)" + NL
    t = t + "    IF NOT JsIsOp(op) THEN THROW Str(JsAt()) + ""|Expected '"" + op + ""'""" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsName () AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    IF jtType[jp] <> ""id"" THEN THROW Str(JsAt()) + ""|Expected identifier""" + NL
    t = t + "    s = jtText[jp]" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The end of a statement: a ;, or a line break, a } or the end (as browsers allowed)." + NL
    t = t + "SUB JsSemi ()" + NL
    t = t + "    IF JsIsOp("";"") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "    ELSEIF NOT (jtType[jp] = ""eof"" OR JsIsOp(""}"") OR jtNl[jp]) THEN" + NL
    t = t + "        THROW Str(JsAt()) + ""|Expected ';'""" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsParse (src AS String) AS Integer" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    JsLex(src)" + NL
    t = t + "    jp = 0" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    WHILE jtType[jp] <> ""eof""" + NL
    t = t + "        list.Add(Str(JsStatement()))" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN JsNode(""block"", 0, 0, 0, 0, """", list.Join("",""), line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsBlock () AS Integer" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    JsExpect(""{"")" + NL
    t = t + "    WHILE NOT JsIsOp(""}"")" + NL
    t = t + "        IF jtType[jp] = ""eof"" THEN THROW Str(JsAt()) + ""|Expected '}'""" + NL
    t = t + "        list.Add(Str(JsStatement()))" + NL
    t = t + "    END WHILE" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "    RETURN JsNode(""block"", 0, 0, 0, 0, """", list.Join("",""), line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsVarList () AS Integer" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR init AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "    WHILE TRUE" + NL
    t = t + "        name = JsName()" + NL
    t = t + "        init = 0" + NL
    t = t + "        IF JsIsOp(""="") THEN" + NL
    t = t + "            jp = jp + 1" + NL
    t = t + "            init = JsAssign()" + NL
    t = t + "        END IF" + NL
    t = t + "        list.Add(Str(JsNode(""decl"", init, 0, 0, 0, name, """", line)))" + NL
    t = t + "        IF NOT JsIsOp("","") THEN BREAK" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN JsNode(""var"", 0, 0, 0, 0, """", list.Join("",""), line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' function name(a, b) { ... } - as a statement or an expression" + NL
    t = t + "FUNCTION JsFunction (kind AS String) AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR params AS Array OF String" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR body AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "    IF jtType[jp] = ""id"" THEN name = JsName()" + NL
    t = t + "    IF kind = ""func"" AND name = """" THEN THROW Str(JsAt()) + ""|Expected identifier""" + NL
    t = t + "    JsExpect(""("")" + NL
    t = t + "    WHILE NOT JsIsOp("")"")" + NL
    t = t + "        params.Add(JsName())" + NL
    t = t + "        IF NOT JsIsOp("")"") THEN JsExpect("","")" + NL
    t = t + "    END WHILE" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "    body = JsBlock()" + NL
    t = t + "    RETURN JsNode(kind, body, 0, 0, 0, name, params.Join("",""), line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsStatement () AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR a AS Integer" + NL
    t = t + "    VAR b AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR isVar AS Bool" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    IF JsIsOp(""{"") THEN RETURN JsBlock()" + NL
    t = t + "    IF JsIsOp("";"") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""empty"", 0, 0, 0, 0, """", """", line)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF jtType[jp] = ""kw"" THEN" + NL
    t = t + "        SELECT CASE jtText[jp]" + NL
    t = t + "            CASE ""var""" + NL
    t = t + "                a = JsVarList()" + NL
    t = t + "                JsSemi()" + NL
    t = t + "                RETURN a" + NL
    t = t + "            CASE ""function""" + NL
    t = t + "                RETURN JsFunction(""func"")" + NL
    t = t + "            CASE ""if""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                JsExpect(""("")" + NL
    t = t + "                a = JsExpr()" + NL
    t = t + "                JsExpect("")"")" + NL
    t = t + "                b = JsStatement()" + NL
    t = t + "                c = 0" + NL
    t = t + "                IF JsIsKw(""else"") THEN" + NL
    t = t + "                    jp = jp + 1" + NL
    t = t + "                    c = JsStatement()" + NL
    t = t + "                END IF" + NL
    t = t + "                RETURN JsNode(""if"", a, b, c, 0, """", """", line)" + NL
    t = t + "            CASE ""while""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                JsExpect(""("")" + NL
    t = t + "                a = JsExpr()" + NL
    t = t + "                JsExpect("")"")" + NL
    t = t + "                RETURN JsNode(""while"", a, JsStatement(), 0, 0, """", """", line)" + NL
    t = t + "            CASE ""do""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                b = JsStatement()" + NL
    t = t + "                IF NOT JsIsKw(""while"") THEN THROW Str(JsAt()) + ""|Expected 'while'""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                JsExpect(""("")" + NL
    t = t + "                a = JsExpr()" + NL
    t = t + "                JsExpect("")"")" + NL
    t = t + "                IF JsIsOp("";"") THEN jp = jp + 1" + NL
    t = t + "                RETURN JsNode(""do"", a, b, 0, 0, """", """", line)" + NL
    t = t + "            CASE ""for""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                JsExpect(""("")" + NL
    t = t + "                a = 0" + NL
    t = t + "                isVar = FALSE" + NL
    t = t + "                IF JsIsKw(""var"") THEN" + NL
    t = t + "                    IF jtType[jp + 1] = ""id"" AND jtType[jp + 2] = ""kw"" AND jtText[jp + 2] = ""in"" THEN" + NL
    t = t + "                        jp = jp + 1" + NL
    t = t + "                        isVar = TRUE" + NL
    t = t + "                    ELSE" + NL
    t = t + "                        a = JsVarList()" + NL
    t = t + "                    END IF" + NL
    t = t + "                END IF" + NL
    t = t + "                IF a = 0 AND NOT JsIsOp("";"") THEN" + NL
    t = t + "                    IF jtType[jp] = ""id"" AND jtType[jp + 1] = ""kw"" AND jtText[jp + 1] = ""in"" THEN" + NL
    t = t + "                        name = JsName()" + NL
    t = t + "                        jp = jp + 1" + NL
    t = t + "                        b = JsExpr()" + NL
    t = t + "                        JsExpect("")"")" + NL
    t = t + "                        RETURN JsNode(""forin"", b, 0, 0, JsStatement(), name, """", line)" + NL
    t = t + "                    END IF" + NL
    t = t + "                    a = JsNode(""exprst"", JsExpr(), 0, 0, 0, """", """", line)" + NL
    t = t + "                END IF" + NL
    t = t + "                JsExpect("";"")" + NL
    t = t + "                b = 0" + NL
    t = t + "                IF NOT JsIsOp("";"") THEN b = JsExpr()" + NL
    t = t + "                JsExpect("";"")" + NL
    t = t + "                c = 0" + NL
    t = t + "                IF NOT JsIsOp("")"") THEN c = JsExpr()" + NL
    t = t + "                JsExpect("")"")" + NL
    t = t + "                RETURN JsNode(""for"", a, b, c, JsStatement(), """", """", line)" + NL
    t = t + "            CASE ""return""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                a = 0" + NL
    t = t + "                IF NOT (JsIsOp("";"") OR JsIsOp(""}"") OR jtType[jp] = ""eof"" OR jtNl[jp]) THEN a = JsExpr()" + NL
    t = t + "                JsSemi()" + NL
    t = t + "                RETURN JsNode(""return"", a, 0, 0, 0, """", """", line)" + NL
    t = t + "            CASE ""break""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                JsSemi()" + NL
    t = t + "                RETURN JsNode(""break"", 0, 0, 0, 0, """", """", line)" + NL
    t = t + "            CASE ""continue""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                JsSemi()" + NL
    t = t + "                RETURN JsNode(""continue"", 0, 0, 0, 0, """", """", line)" + NL
    t = t + "            CASE ""throw""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                a = JsExpr()" + NL
    t = t + "                JsSemi()" + NL
    t = t + "                RETURN JsNode(""throw"", a, 0, 0, 0, """", """", line)" + NL
    t = t + "            CASE ""try""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                a = JsBlock()" + NL
    t = t + "                b = 0" + NL
    t = t + "                c = 0" + NL
    t = t + "                IF JsIsKw(""catch"") THEN" + NL
    t = t + "                    jp = jp + 1" + NL
    t = t + "                    JsExpect(""("")" + NL
    t = t + "                    name = JsName()" + NL
    t = t + "                    JsExpect("")"")" + NL
    t = t + "                    b = JsBlock()" + NL
    t = t + "                END IF" + NL
    t = t + "                IF JsIsKw(""finally"") THEN" + NL
    t = t + "                    jp = jp + 1" + NL
    t = t + "                    c = JsBlock()" + NL
    t = t + "                END IF" + NL
    t = t + "                RETURN JsNode(""try"", a, b, c, 0, name, """", line)" + NL
    t = t + "            CASE ""switch""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                JsExpect(""("")" + NL
    t = t + "                a = JsExpr()" + NL
    t = t + "                JsExpect("")"")" + NL
    t = t + "                JsExpect(""{"")" + NL
    t = t + "                ' each case is a node: na = its test (0 for default), nl = its statements" + NL
    t = t + "                WHILE NOT JsIsOp(""}"")" + NL
    t = t + "                    IF JsIsKw(""case"") THEN" + NL
    t = t + "                        jp = jp + 1" + NL
    t = t + "                        b = JsExpr()" + NL
    t = t + "                    ELSEIF JsIsKw(""default"") THEN" + NL
    t = t + "                        jp = jp + 1" + NL
    t = t + "                        b = 0" + NL
    t = t + "                    ELSE" + NL
    t = t + "                        THROW Str(JsAt()) + ""|Expected 'case'""" + NL
    t = t + "                    END IF" + NL
    t = t + "                    JsExpect("":"")" + NL
    t = t + "                    c = JsNode(""case"", b, 0, 0, 0, """", """", JsAt())" + NL
    t = t + "                    WHILE NOT (JsIsKw(""case"") OR JsIsKw(""default"") OR JsIsOp(""}"") OR jtType[jp] = ""eof"")" + NL
    t = t + "                        IF nl[c] <> """" THEN nl[c] = nl[c] + "",""" + NL
    t = t + "                        nl[c] = nl[c] + Str(JsStatement())" + NL
    t = t + "                    END WHILE" + NL
    t = t + "                    list.Add(Str(c))" + NL
    t = t + "                END WHILE" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                RETURN JsNode(""switch"", a, 0, 0, 0, """", list.Join("",""), line)" + NL
    t = t + "        END SELECT" + NL
    t = t + "    END IF" + NL
    t = t + "    a = JsExpr()" + NL
    t = t + "    JsSemi()" + NL
    t = t + "    RETURN JsNode(""exprst"", a, 0, 0, 0, """", """", line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsExpr () AS Integer" + NL
    t = t + "    VAR a AS Integer" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    a = JsAssign()" + NL
    t = t + "    IF NOT JsIsOp("","") THEN RETURN a" + NL
    t = t + "    list.Add(Str(a))" + NL
    t = t + "    WHILE JsIsOp("","")" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        list.Add(Str(JsAssign()))" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN JsNode(""seq"", 0, 0, 0, 0, """", list.Join("",""), JsAt())" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsAssign () AS Integer" + NL
    t = t + "    VAR left AS Integer" + NL
    t = t + "    VAR op AS String" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    IF JsArrowAhead() THEN RETURN JsArrow()" + NL
    t = t + "    left = JsConditional()" + NL
    t = t + "    IF jtType[jp] = ""op"" AND ""|=|+=|-=|*=|/=|%=|"".Contains(""|"" + jtText[jp] + ""|"") THEN" + NL
    t = t + "        op = jtText[jp]" + NL
    t = t + "        IF nk[left] <> ""id"" AND nk[left] <> ""member"" AND nk[left] <> ""index"" THEN THROW Str(line) + ""|Cannot assign to '"" + JsDescribe(left) + ""'""" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""assign"", left, JsAssign(), 0, 0, op, """", line)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN left" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is an arrow function next: x => ..., () => ..., (a, b) => ...?" + NL
    t = t + "FUNCTION JsArrowAhead () AS Bool" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF jtType[jp] = ""id"" THEN RETURN jtType[jp + 1] = ""op"" AND jtText[jp + 1] = ""=>""" + NL
    t = t + "    IF NOT JsIsOp(""("") THEN RETURN FALSE" + NL
    t = t + "    k = jp + 1" + NL
    t = t + "    WHILE jtType[k] = ""id"" OR (jtType[k] = ""op"" AND jtText[k] = "","")" + NL
    t = t + "        k = k + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF jtType[k] <> ""op"" OR jtText[k] <> "")"" THEN RETURN FALSE" + NL
    t = t + "    RETURN jtType[k + 1] = ""op"" AND jtText[k + 1] = ""=>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' An arrow function, a later convenience: a function expression marked" + NL
    t = t + "' (nd = 1) to keep the this of where it was made. A body that is just an" + NL
    t = t + "' expression returns it." + NL
    t = t + "FUNCTION JsArrow () AS Integer" + NL
    t = t + "    VAR params AS Array OF String" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR body AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    IF jtType[jp] = ""id"" THEN" + NL
    t = t + "        params.Add(JsName())" + NL
    t = t + "    ELSE" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        WHILE NOT JsIsOp("")"")" + NL
    t = t + "            params.Add(JsName())" + NL
    t = t + "            IF NOT JsIsOp("")"") THEN JsExpect("","")" + NL
    t = t + "        END WHILE" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "    END IF" + NL
    t = t + "    JsExpect(""=>"")" + NL
    t = t + "    IF JsIsOp(""{"") THEN" + NL
    t = t + "        body = JsBlock()" + NL
    t = t + "    ELSE" + NL
    t = t + "        body = JsNode(""return"", JsAssign(), 0, 0, 0, """", """", line)" + NL
    t = t + "        body = JsNode(""block"", 0, 0, 0, 0, """", Str(body), line)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN JsNode(""funcexpr"", body, 0, 0, 1, """", params.Join("",""), line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsConditional () AS Integer" + NL
    t = t + "    VAR test AS Integer" + NL
    t = t + "    VAR a AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    test = JsBinary(1)" + NL
    t = t + "    IF NOT JsIsOp(""?"") THEN RETURN test" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "    a = JsAssign()" + NL
    t = t + "    JsExpect("":"")" + NL
    t = t + "    RETURN JsNode(""cond"", test, a, JsAssign(), 0, """", """", line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsPrec (op AS String) AS Integer" + NL
    t = t + "    SELECT CASE op" + NL
    t = t + "        CASE ""||""" + NL
    t = t + "            RETURN 1" + NL
    t = t + "        CASE ""&&""" + NL
    t = t + "            RETURN 2" + NL
    t = t + "        CASE ""=="", ""!="", ""==="", ""!==""" + NL
    t = t + "            RETURN 3" + NL
    t = t + "        CASE ""<"", "">"", ""<="", "">="", ""in"", ""instanceof""" + NL
    t = t + "            RETURN 4" + NL
    t = t + "        CASE ""+"", ""-""" + NL
    t = t + "            RETURN 5" + NL
    t = t + "        CASE ""*"", ""/"", ""%""" + NL
    t = t + "            RETURN 6" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Precedence climbing: one loop for every binary operator level." + NL
    t = t + "FUNCTION JsBinary (least AS Integer) AS Integer" + NL
    t = t + "    VAR left AS Integer" + NL
    t = t + "    VAR op AS String" + NL
    t = t + "    VAR prec AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    left = JsUnary()" + NL
    t = t + "    WHILE jtType[jp] = ""op"" OR (jtType[jp] = ""kw"" AND (jtText[jp] = ""in"" OR jtText[jp] = ""instanceof""))" + NL
    t = t + "        op = jtText[jp]" + NL
    t = t + "        prec = JsPrec(op)" + NL
    t = t + "        IF prec = 0 OR prec < least THEN BREAK" + NL
    t = t + "        line = JsAt()" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        left = JsNode(""bin"", left, JsBinary(prec + 1), 0, 0, op, """", line)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN left" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsUnary () AS Integer" + NL
    t = t + "    VAR op AS String" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR a AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    IF jtType[jp] = ""op"" AND (jtText[jp] = ""!"" OR jtText[jp] = ""-"" OR jtText[jp] = ""+"") THEN" + NL
    t = t + "        op = jtText[jp]" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""unary"", JsUnary(), 0, 0, 0, op, """", line)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF JsIsKw(""typeof"") OR JsIsKw(""void"") OR JsIsKw(""delete"") THEN" + NL
    t = t + "        op = jtText[jp]" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""unary"", JsUnary(), 0, 0, 0, op, """", line)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF JsIsOp(""++"") OR JsIsOp(""--"") THEN" + NL
    t = t + "        op = jtText[jp]" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        a = JsUnary()" + NL
    t = t + "        IF nk[a] <> ""id"" AND nk[a] <> ""member"" AND nk[a] <> ""index"" THEN THROW Str(line) + ""|Cannot assign to '"" + JsDescribe(a) + ""'""" + NL
    t = t + "        RETURN JsNode(""incdec"", a, 0, 0, 0, op, ""pre"", line)" + NL
    t = t + "    END IF" + NL
    t = t + "    a = JsPostfix()" + NL
    t = t + "    IF (JsIsOp(""++"") OR JsIsOp(""--"")) AND NOT jtNl[jp] THEN" + NL
    t = t + "        IF nk[a] <> ""id"" AND nk[a] <> ""member"" AND nk[a] <> ""index"" THEN THROW Str(line) + ""|Cannot assign to '"" + JsDescribe(a) + ""'""" + NL
    t = t + "        op = jtText[jp]" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""incdec"", a, 0, 0, 0, op, ""post"", line)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN a" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsArgs () AS String" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    JsExpect(""("")" + NL
    t = t + "    WHILE NOT JsIsOp("")"")" + NL
    t = t + "        list.Add(Str(JsAssign()))" + NL
    t = t + "        IF NOT JsIsOp("")"") THEN JsExpect("","")" + NL
    t = t + "    END WHILE" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "    RETURN list.Join("","")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Members, calls and new: a.b, a[b], a(b), new A(b)" + NL
    t = t + "FUNCTION JsPostfix () AS Integer" + NL
    t = t + "    VAR e AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR callee AS Integer" + NL
    t = t + "    VAR args AS String" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    IF JsIsKw(""new"") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        callee = JsPrimary()" + NL
    t = t + "        WHILE JsIsOp(""."") OR JsIsOp(""["")" + NL
    t = t + "            callee = JsMemberStep(callee)" + NL
    t = t + "        END WHILE" + NL
    t = t + "        args = """"" + NL
    t = t + "        IF JsIsOp(""("") THEN args = JsArgs()" + NL
    t = t + "        e = JsNode(""new"", callee, 0, 0, 0, """", args, line)" + NL
    t = t + "    ELSE" + NL
    t = t + "        e = JsPrimary()" + NL
    t = t + "    END IF" + NL
    t = t + "    WHILE JsIsOp(""."") OR JsIsOp(""["") OR JsIsOp(""("")" + NL
    t = t + "        IF JsIsOp(""("") THEN" + NL
    t = t + "            line = JsAt()" + NL
    t = t + "            e = JsNode(""call"", e, 0, 0, 0, """", JsArgs(), line)" + NL
    t = t + "        ELSE" + NL
    t = t + "            e = JsMemberStep(e)" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN e" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsMemberStep (e AS Integer) AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR key AS Integer" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    IF JsIsOp(""."") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        IF jtType[jp] <> ""id"" AND jtType[jp] <> ""kw"" THEN THROW Str(JsAt()) + ""|Expected identifier""" + NL
    t = t + "        name = jtText[jp]" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""member"", e, 0, 0, 0, name, """", line)" + NL
    t = t + "    END IF" + NL
    t = t + "    jp = jp + 1" + NL
    t = t + "    key = JsExpr()" + NL
    t = t + "    JsExpect(""]"")" + NL
    t = t + "    RETURN JsNode(""index"", e, key, 0, 0, """", """", line)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsPrimary () AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR a AS Integer" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    line = JsAt()" + NL
    t = t + "    t = jtType[jp]" + NL
    t = t + "    text = jtText[jp]" + NL
    t = t + "    IF t = ""num"" THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""num"", 0, 0, 0, 0, JsNumberText(text), """", line)" + NL
    t = t + "    ELSEIF t = ""str"" THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""str"", 0, 0, 0, 0, text, """", line)" + NL
    t = t + "    ELSEIF t = ""id"" THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""id"", 0, 0, 0, 0, text, """", line)" + NL
    t = t + "    ELSEIF t = ""kw"" THEN" + NL
    t = t + "        SELECT CASE text" + NL
    t = t + "            CASE ""this"", ""true"", ""false"", ""null""" + NL
    t = t + "                jp = jp + 1" + NL
    t = t + "                RETURN JsNode(text, 0, 0, 0, 0, """", """", line)" + NL
    t = t + "            CASE ""function""" + NL
    t = t + "                RETURN JsFunction(""funcexpr"")" + NL
    t = t + "        END SELECT" + NL
    t = t + "    ELSEIF JsIsOp(""("") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        a = JsExpr()" + NL
    t = t + "        JsExpect("")"")" + NL
    t = t + "        RETURN a" + NL
    t = t + "    ELSEIF JsIsOp(""["") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        WHILE NOT JsIsOp(""]"")" + NL
    t = t + "            list.Add(Str(JsAssign()))" + NL
    t = t + "            IF NOT JsIsOp(""]"") THEN JsExpect("","")" + NL
    t = t + "        END WHILE" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""array"", 0, 0, 0, 0, """", list.Join("",""), line)" + NL
    t = t + "    ELSEIF JsIsOp(""{"") THEN" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        WHILE NOT JsIsOp(""}"")" + NL
    t = t + "            IF jtType[jp] = ""id"" OR jtType[jp] = ""str"" OR jtType[jp] = ""kw"" THEN" + NL
    t = t + "                key = jtText[jp]" + NL
    t = t + "            ELSEIF jtType[jp] = ""num"" THEN" + NL
    t = t + "                key = JsNumberText(jtText[jp])" + NL
    t = t + "            ELSE" + NL
    t = t + "                THROW Str(JsAt()) + ""|Expected identifier""" + NL
    t = t + "            END IF" + NL
    t = t + "            jp = jp + 1" + NL
    t = t + "            JsExpect("":"")" + NL
    t = t + "            list.Add(Str(JsNode(""prop"", JsAssign(), 0, 0, 0, key, """", line)))" + NL
    t = t + "            IF NOT JsIsOp(""}"") THEN JsExpect("","")" + NL
    t = t + "        END WHILE" + NL
    t = t + "        jp = jp + 1" + NL
    t = t + "        RETURN JsNode(""object"", 0, 0, 0, 0, """", list.Join("",""), line)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF t = ""eof"" THEN THROW Str(line) + ""|Syntax error""" + NL
    t = t + "    THROW Str(line) + ""|Syntax error""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsDescribe (n AS Integer) AS String" + NL
    t = t + "    SELECT CASE nk[n]" + NL
    t = t + "        CASE ""id""" + NL
    t = t + "            RETURN ns[n]" + NL
    t = t + "        CASE ""member""" + NL
    t = t + "            RETURN JsDescribe(na[n]) + ""."" + ns[n]" + NL
    t = t + "        CASE ""index""" + NL
    t = t + "            RETURN JsDescribe(na[n]) + ""[...]""" + NL
    t = t + "        CASE ""call""" + NL
    t = t + "            RETURN JsDescribe(na[n]) + ""(...)""" + NL
    t = t + "        CASE ""this""" + NL
    t = t + "            RETURN ""this""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""Object""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' v, which the program is about to use as an object (node n): stops with" + NL
    t = t + "' the message 1996 browsers gave when it is null or undefined." + NL
    t = t + "FUNCTION JsNeed (v AS String, n AS Integer) AS String" + NL
    t = t + "    IF v = ""u"" OR v = ""l"" THEN THROW Str(nline[n]) + ""|'"" + JsDescribe(n) + ""' is null or not an object""" + NL
    t = t + "    RETURN v" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The value a number literal stands for, in canonical form." + NL
    t = t + "FUNCTION JsNumberText (text AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR v AS Real" + NL
    t = t + "    IF text.Lower().StartsWith(""0x"") THEN" + NL
    t = t + "        FOR i = 2 TO text.Length - 1" + NL
    t = t + "            v = v * 16 + ""0123456789abcdef"".IndexOf(text.CharAt(i).Lower())" + NL
    t = t + "        NEXT" + NL
    t = t + "        RETURN JsFmt(v)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN JsFmt(Val(text))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- numbers" + NL
    t = t + "" + NL
    t = t + "' A number the way JavaScript writes it: the shortest form that reads back" + NL
    t = t + "' exactly (SPARK's Str rounds to six digits)." + NL
    t = t + "FUNCTION JsFmt (r AS Real) AS String" + NL
    t = t + "    VAR p AS Integer" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    IF r <> r THEN RETURN ""NaN""" + NL
    t = t + "    IF r > 1.7976931348623157E308 THEN RETURN ""Infinity""" + NL
    t = t + "    IF r < -1.7976931348623157E308 THEN RETURN ""-Infinity""" + NL
    t = t + "    IF r = Int(r) AND Abs(r) < 1E21 THEN RETURN Str(Int(r))" + NL
    t = t + "    FOR p = 1 TO 17" + NL
    t = t + "        s = JsDigits(r, p, 0)" + NL
    t = t + "        IF Val(s) = r THEN RETURN s" + NL
    t = t + "        IF p >= 15 THEN" + NL
    t = t + "            IF Val(JsDigits(r, p, -1)) = r THEN RETURN JsDigits(r, p, -1)" + NL
    t = t + "            IF Val(JsDigits(r, p, 1)) = r THEN RETURN JsDigits(r, p, 1)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' r to p significant digits. Where 10^k is exact the digits are worked out" + NL
    t = t + "' exactly (Dekker's product); elsewhere they may be one out in the last" + NL
    t = t + "' place, which nudge makes up for." + NL
    t = t + "FUNCTION JsDigits (r AS Real, p AS Integer, nudge AS Integer) AS String" + NL
    t = t + "    VAR a AS Real" + NL
    t = t + "    VAR e AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR digits AS Real" + NL
    t = t + "    VAR ds AS String" + NL
    t = t + "    VAR sign AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR frac AS String" + NL
    t = t + "    IF r < 0 THEN sign = ""-""" + NL
    t = t + "    a = Abs(r)" + NL
    t = t + "    e = MATH.Floor(MATH.Log(a) / MATH.Log(10))" + NL
    t = t + "    IF 10 ^ e > a THEN e = e - 1" + NL
    t = t + "    IF 10 ^ (e + 1) <= a THEN e = e + 1" + NL
    t = t + "    k = p - 1 - e" + NL
    t = t + "    IF k >= 0 AND k <= 22 THEN" + NL
    t = t + "        ds = JsScaled(a, 10 ^ k, nudge)" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF k > 300 THEN" + NL
    t = t + "            digits = MATH.Round(a * 10 ^ 300 * 10 ^ (k - 300)) + nudge" + NL
    t = t + "        ELSEIF k > 0 THEN" + NL
    t = t + "            digits = MATH.Round(a * 10 ^ k) + nudge" + NL
    t = t + "        ELSE" + NL
    t = t + "            digits = MATH.Round(a / 10 ^ (-k)) + nudge" + NL
    t = t + "        END IF" + NL
    t = t + "        ds = Str(Int(digits))" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ds.Length > p THEN" + NL
    t = t + "        ds = ds.Substring(0, p)" + NL
    t = t + "        e = e + 1" + NL
    t = t + "    END IF" + NL
    t = t + "    WHILE ds.Length < p" + NL
    t = t + "        ds = ds + ""0""" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF e >= 21 OR e < -6 THEN" + NL
    t = t + "        frac = ds.Substring(1, ds.Length - 1)" + NL
    t = t + "        WHILE frac.EndsWith(""0"")" + NL
    t = t + "            frac = frac.Substring(0, frac.Length - 1)" + NL
    t = t + "        END WHILE" + NL
    t = t + "        out = ds.Substring(0, 1)" + NL
    t = t + "        IF frac <> """" THEN out = out + ""."" + frac" + NL
    t = t + "        IF e > 0 THEN RETURN sign + out + ""e+"" + Str(e)" + NL
    t = t + "        RETURN sign + out + ""e"" + Str(e)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF e >= 0 THEN" + NL
    t = t + "        out = ds.Substring(0, e + 1)" + NL
    t = t + "        frac = ds.Substring(e + 1, ds.Length - e - 1)" + NL
    t = t + "    ELSE" + NL
    t = t + "        out = ""0""" + NL
    t = t + "        frac = """"" + NL
    t = t + "        WHILE frac.Length < -e - 1" + NL
    t = t + "            frac = frac + ""0""" + NL
    t = t + "        END WHILE" + NL
    t = t + "        frac = frac + ds" + NL
    t = t + "    END IF" + NL
    t = t + "    WHILE frac.EndsWith(""0"")" + NL
    t = t + "        frac = frac.Substring(0, frac.Length - 1)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF frac = """" THEN RETURN sign + out" + NL
    t = t + "    RETURN sign + out + ""."" + frac" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "'' round(a * scale) as digits, exactly: Dekker's two-product gives the" + NL
    t = t + "' rounding error of a * scale, and the digits are put together in two halves" + NL
    t = t + "' so no part of them goes past what a Real holds exactly." + NL
    t = t + "FUNCTION JsScaled (a AS Real, scale AS Real, nudge AS Integer) AS String" + NL
    t = t + "    VAR prod AS Real" + NL
    t = t + "    VAR err AS Real" + NL
    t = t + "    VAR ah AS Real" + NL
    t = t + "    VAR al AS Real" + NL
    t = t + "    VAR bh AS Real" + NL
    t = t + "    VAR bl AS Real" + NL
    t = t + "    VAR c AS Real" + NL
    t = t + "    VAR high AS Real" + NL
    t = t + "    VAR low AS Real" + NL
    t = t + "    VAR ls AS String" + NL
    t = t + "    prod = a * scale" + NL
    t = t + "    c = 134217729.0 * a" + NL
    t = t + "    ah = c - (c - a)" + NL
    t = t + "    al = a - ah" + NL
    t = t + "    c = 134217729.0 * scale" + NL
    t = t + "    bh = c - (c - scale)" + NL
    t = t + "    bl = scale - bh" + NL
    t = t + "    err = ((ah * bh - prod) + ah * bl + al * bh) + al * bl" + NL
    t = t + "    high = MATH.Floor(prod / 100000000.0)" + NL
    t = t + "    low = prod - high * 100000000.0" + NL
    t = t + "    low = MATH.Floor(low + err + 0.5) + nudge" + NL
    t = t + "    WHILE low >= 100000000.0" + NL
    t = t + "        low = low - 100000000.0" + NL
    t = t + "        high = high + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    WHILE low < 0" + NL
    t = t + "        low = low + 100000000.0" + NL
    t = t + "        high = high - 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF high <= 0 THEN RETURN Str(Int(low))" + NL
    t = t + "    ls = Str(Int(low))" + NL
    t = t + "    WHILE ls.Length < 8" + NL
    t = t + "        ls = ""0"" + ls" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN Str(Int(high)) + ls" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Text to number the JavaScript way: """" is 0, ""12px"" is NaN." + NL
    t = t + "FUNCTION JsParseNumber (text AS String) AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR body AS String" + NL
    t = t + "    t = text.Trim()" + NL
    t = t + "    IF t = """" THEN RETURN ""0""" + NL
    t = t + "    IF t = ""Infinity"" OR t = ""+Infinity"" THEN RETURN ""Infinity""" + NL
    t = t + "    IF t = ""-Infinity"" THEN RETURN ""-Infinity""" + NL
    t = t + "    body = t" + NL
    t = t + "    IF body.StartsWith(""-"") OR body.StartsWith(""+"") THEN body = body.Substring(1, body.Length - 1)" + NL
    t = t + "    IF body.Lower().StartsWith(""0x"") AND body.Length > 2 THEN" + NL
    t = t + "        IF OnlyChars(body.Substring(2, body.Length - 2).Lower(), ""0123456789abcdef"") THEN" + NL
    t = t + "            IF t.StartsWith(""-"") THEN RETURN ""NaN""" + NL
    t = t + "            RETURN JsNumberText(body)" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN ""NaN""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF body = """" OR body = ""."" OR NOT OnlyChars(body.Lower(), ""0123456789.e+-"") THEN RETURN ""NaN""" + NL
    t = t + "    IF NOT ""0123456789."".Contains(body.CharAt(0)) THEN RETURN ""NaN""" + NL
    t = t + "    RETURN JsFmt(Val(t))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION OnlyChars (s AS String, allowed AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        IF NOT allowed.Contains(s.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsFinite (n AS String) AS Bool" + NL
    t = t + "    RETURN n <> ""NaN"" AND n <> ""Infinity"" AND n <> ""-Infinity""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Arithmetic on number texts, minding NaN, Infinity and division by zero." + NL
    t = t + "FUNCTION JsArith (op AS String, a AS String, b AS String) AS String" + NL
    t = t + "    VAR x AS Real" + NL
    t = t + "    VAR y AS Real" + NL
    t = t + "    IF a = ""NaN"" OR b = ""NaN"" THEN RETURN ""NaN""" + NL
    t = t + "    IF NOT JsFinite(a) OR NOT JsFinite(b) THEN" + NL
    t = t + "        IF op = ""+"" AND a = b THEN RETURN a" + NL
    t = t + "        IF op = ""+"" AND JsFinite(b) THEN RETURN a" + NL
    t = t + "        IF op = ""+"" AND JsFinite(a) THEN RETURN b" + NL
    t = t + "        IF op = ""-"" AND JsFinite(b) THEN RETURN a" + NL
    t = t + "        IF op = ""*"" AND JsFinite(b) AND Val(b) <> 0 THEN" + NL
    t = t + "            IF (Val(b) > 0) = (a = ""Infinity"") THEN RETURN ""Infinity""" + NL
    t = t + "            RETURN ""-Infinity""" + NL
    t = t + "        END IF" + NL
    t = t + "        IF op = ""/"" AND JsFinite(b) THEN RETURN a" + NL
    t = t + "        IF op = ""/"" AND JsFinite(a) THEN RETURN ""0""" + NL
    t = t + "        RETURN ""NaN""" + NL
    t = t + "    END IF" + NL
    t = t + "    x = Val(a)" + NL
    t = t + "    y = Val(b)" + NL
    t = t + "    SELECT CASE op" + NL
    t = t + "        CASE ""+""" + NL
    t = t + "            RETURN JsFmt(x + y)" + NL
    t = t + "        CASE ""-""" + NL
    t = t + "            RETURN JsFmt(x - y)" + NL
    t = t + "        CASE ""*""" + NL
    t = t + "            RETURN JsFmt(x * y)" + NL
    t = t + "        CASE ""/""" + NL
    t = t + "            IF y = 0 THEN" + NL
    t = t + "                IF x = 0 THEN RETURN ""NaN""" + NL
    t = t + "                IF x > 0 THEN RETURN ""Infinity""" + NL
    t = t + "                RETURN ""-Infinity""" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsFmt(x / y)" + NL
    t = t + "        CASE ""%""" + NL
    t = t + "            IF y = 0 THEN RETURN ""NaN""" + NL
    t = t + "            RETURN JsFmt(x - y * Int(x / y))" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""NaN""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- values" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNum (v AS String) AS String" + NL
    t = t + "    SELECT CASE v.Substring(0, 1)" + NL
    t = t + "        CASE ""n""" + NL
    t = t + "            RETURN v.Substring(1, v.Length - 1)" + NL
    t = t + "        CASE ""s""" + NL
    t = t + "            RETURN JsParseNumber(v.Substring(1, v.Length - 1))" + NL
    t = t + "        CASE ""t""" + NL
    t = t + "            RETURN ""1""" + NL
    t = t + "        CASE ""f"", ""l""" + NL
    t = t + "            RETURN ""0""" + NL
    t = t + "        CASE ""o""" + NL
    t = t + "            IF joClass[JsId(v)] = ""Date"" THEN RETURN joS[JsId(v)]" + NL
    t = t + "            RETURN JsParseNumber(JsStr(v))" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""NaN""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsReal (v AS String) AS Real" + NL
    t = t + "    VAR n AS String" + NL
    t = t + "    n = JsNum(v)" + NL
    t = t + "    IF NOT JsFinite(n) THEN RETURN 0" + NL
    t = t + "    RETURN Val(n)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsInt (v AS String) AS Integer" + NL
    t = t + "    RETURN Int(JsReal(v))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsStr (v AS String) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    SELECT CASE v.Substring(0, 1)" + NL
    t = t + "        CASE ""s"", ""n""" + NL
    t = t + "            RETURN v.Substring(1, v.Length - 1)" + NL
    t = t + "        CASE ""u""" + NL
    t = t + "            RETURN ""undefined""" + NL
    t = t + "        CASE ""l""" + NL
    t = t + "            RETURN ""null""" + NL
    t = t + "        CASE ""t""" + NL
    t = t + "            RETURN ""true""" + NL
    t = t + "        CASE ""f""" + NL
    t = t + "            RETURN ""false""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    id = Int(Val(v.Substring(1, v.Length - 1)))" + NL
    t = t + "    SELECT CASE joClass[id]" + NL
    t = t + "        CASE ""Array""" + NL
    t = t + "            RETURN JsJoin(id, "","")" + NL
    t = t + "        CASE ""Function""" + NL
    t = t + "            RETURN Chr(10) + ""function "" + ns[joA[id]] + ""("" + nl[joA[id]] + "") {"" + Chr(10) + ""    [native code]"" + Chr(10) + ""}"" + Chr(10)" + NL
    t = t + "        CASE ""Native""" + NL
    t = t + "            RETURN Chr(10) + ""function "" + joS[id] + ""() {"" + Chr(10) + ""    [native code]"" + Chr(10) + ""}"" + Chr(10)" + NL
    t = t + "        CASE ""Date""" + NL
    t = t + "            RETURN JsDateText(Val(joS[id]))" + NL
    t = t + "        CASE ""Error""" + NL
    t = t + "            RETURN JsStr(JsGetProp(id, ""message""))" + NL
    t = t + "        CASE ""Location""" + NL
    t = t + "            RETURN HostInfo(""location"")" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""[object Object]""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsBool (v AS String) AS Bool" + NL
    t = t + "    SELECT CASE v.Substring(0, 1)" + NL
    t = t + "        CASE ""t"", ""o""" + NL
    t = t + "            RETURN TRUE" + NL
    t = t + "        CASE ""n""" + NL
    t = t + "            RETURN v <> ""n0"" AND v <> ""nNaN"" AND v <> ""n-0""" + NL
    t = t + "        CASE ""s""" + NL
    t = t + "            RETURN v.Length > 1" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsB (b AS Bool) AS String" + NL
    t = t + "    IF b THEN RETURN ""t""" + NL
    t = t + "    RETURN ""f""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsN (r AS Real) AS String" + NL
    t = t + "    RETURN ""n"" + JsFmt(r)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsS (s AS String) AS String" + NL
    t = t + "    RETURN ""s"" + s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsO (id AS Integer) AS String" + NL
    t = t + "    RETURN ""o"" + Str(id)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsId (v AS String) AS Integer" + NL
    t = t + "    IF NOT v.StartsWith(""o"") THEN RETURN 0" + NL
    t = t + "    RETURN Int(Val(v.Substring(1, v.Length - 1)))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsTypeOf (v AS String) AS String" + NL
    t = t + "    SELECT CASE v.Substring(0, 1)" + NL
    t = t + "        CASE ""u""" + NL
    t = t + "            RETURN ""undefined""" + NL
    t = t + "        CASE ""l""" + NL
    t = t + "            RETURN ""object""" + NL
    t = t + "        CASE ""t"", ""f""" + NL
    t = t + "            RETURN ""boolean""" + NL
    t = t + "        CASE ""n""" + NL
    t = t + "            RETURN ""number""" + NL
    t = t + "        CASE ""s""" + NL
    t = t + "            RETURN ""string""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF joClass[JsId(v)] = ""Function"" OR joClass[JsId(v)] = ""Native"" THEN RETURN ""function""" + NL
    t = t + "    RETURN ""object""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsCallable (v AS String) AS Bool" + NL
    t = t + "    RETURN JsTypeOf(v) = ""function""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' == : same-type compare, null equals undefined, numbers and strings meet as numbers" + NL
    t = t + "FUNCTION JsLooseEq (a AS String, b AS String) AS Bool" + NL
    t = t + "    VAR ta AS String" + NL
    t = t + "    VAR tb AS String" + NL
    t = t + "    ta = a.Substring(0, 1)" + NL
    t = t + "    tb = b.Substring(0, 1)" + NL
    t = t + "    IF (ta = ""u"" OR ta = ""l"") AND (tb = ""u"" OR tb = ""l"") THEN RETURN TRUE" + NL
    t = t + "    IF ta = ""u"" OR ta = ""l"" OR tb = ""u"" OR tb = ""l"" THEN RETURN FALSE" + NL
    t = t + "    IF ta = tb THEN" + NL
    t = t + "        IF ta = ""n"" THEN RETURN JsNumEq(JsNum(a), JsNum(b))" + NL
    t = t + "        RETURN a = b" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ta = ""o"" THEN RETURN JsLooseEq(JsS(JsStr(a)), b)" + NL
    t = t + "    IF tb = ""o"" THEN RETURN JsLooseEq(a, JsS(JsStr(b)))" + NL
    t = t + "    RETURN JsNumEq(JsNum(a), JsNum(b))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNumEq (a AS String, b AS String) AS Bool" + NL
    t = t + "    IF a = ""NaN"" OR b = ""NaN"" THEN RETURN FALSE" + NL
    t = t + "    IF NOT JsFinite(a) OR NOT JsFinite(b) THEN RETURN a = b" + NL
    t = t + "    RETURN Val(a) = Val(b)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsStrictEq (a AS String, b AS String) AS Bool" + NL
    t = t + "    IF a.Substring(0, 1) <> b.Substring(0, 1) THEN RETURN FALSE" + NL
    t = t + "    IF a.StartsWith(""n"") THEN RETURN JsNumEq(JsNum(a), JsNum(b))" + NL
    t = t + "    RETURN a = b" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' < > <= >= : strings compare as strings, anything else as numbers" + NL
    t = t + "FUNCTION JsCompare (op AS String, a AS String, b AS String) AS String" + NL
    t = t + "    VAR x AS String" + NL
    t = t + "    VAR y AS String" + NL
    t = t + "    VAR less AS Bool" + NL
    t = t + "    VAR same AS Bool" + NL
    t = t + "    IF a.StartsWith(""o"") THEN a = JsS(JsStr(a))" + NL
    t = t + "    IF b.StartsWith(""o"") THEN b = JsS(JsStr(b))" + NL
    t = t + "    IF a.StartsWith(""s"") AND b.StartsWith(""s"") THEN" + NL
    t = t + "        x = a.Substring(1, a.Length - 1)" + NL
    t = t + "        y = b.Substring(1, b.Length - 1)" + NL
    t = t + "        less = x < y" + NL
    t = t + "        same = x = y" + NL
    t = t + "    ELSE" + NL
    t = t + "        x = JsNum(a)" + NL
    t = t + "        y = JsNum(b)" + NL
    t = t + "        IF x = ""NaN"" OR y = ""NaN"" THEN RETURN ""f""" + NL
    t = t + "        IF NOT JsFinite(x) OR NOT JsFinite(y) THEN" + NL
    t = t + "            same = x = y" + NL
    t = t + "            less = (x = ""-Infinity"" AND y <> ""-Infinity"") OR (y = ""Infinity"" AND x <> ""Infinity"")" + NL
    t = t + "        ELSE" + NL
    t = t + "            less = Val(x) < Val(y)" + NL
    t = t + "            same = Val(x) = Val(y)" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE op" + NL
    t = t + "        CASE ""<""" + NL
    t = t + "            RETURN JsB(less)" + NL
    t = t + "        CASE "">""" + NL
    t = t + "            RETURN JsB(NOT less AND NOT same)" + NL
    t = t + "        CASE ""<=""" + NL
    t = t + "            RETURN JsB(less OR same)" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN JsB(NOT less)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsAdd (a AS String, b AS String) AS String" + NL
    t = t + "    IF a.StartsWith(""o"") THEN a = JsS(JsStr(a))" + NL
    t = t + "    IF b.StartsWith(""o"") THEN b = JsS(JsStr(b))" + NL
    t = t + "    IF a.StartsWith(""s"") OR b.StartsWith(""s"") THEN RETURN JsS(JsStr(a) + JsStr(b))" + NL
    t = t + "    RETURN ""n"" + JsArith(""+"", JsNum(a), JsNum(b))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsBinOp (op AS String, a AS String, b AS String) AS String" + NL
    t = t + "    SELECT CASE op" + NL
    t = t + "        CASE ""+""" + NL
    t = t + "            RETURN JsAdd(a, b)" + NL
    t = t + "        CASE ""-"", ""*"", ""/"", ""%""" + NL
    t = t + "            RETURN ""n"" + JsArith(op, JsNum(a), JsNum(b))" + NL
    t = t + "        CASE ""==""" + NL
    t = t + "            RETURN JsB(JsLooseEq(a, b))" + NL
    t = t + "        CASE ""!=""" + NL
    t = t + "            RETURN JsB(NOT JsLooseEq(a, b))" + NL
    t = t + "        CASE ""===""" + NL
    t = t + "            RETURN JsB(JsStrictEq(a, b))" + NL
    t = t + "        CASE ""!==""" + NL
    t = t + "            RETURN JsB(NOT JsStrictEq(a, b))" + NL
    t = t + "        CASE ""<"", "">"", ""<="", "">=""" + NL
    t = t + "            RETURN JsCompare(op, a, b)" + NL
    t = t + "        CASE ""in""" + NL
    t = t + "            IF NOT b.StartsWith(""o"") THEN THROW Str(jsLine) + ""|Object expected""" + NL
    t = t + "            RETURN JsB(JsGet(b, JsKey(a)) <> ""u"" OR JsOwn(JsId(b), JsKey(a)) >= 0)" + NL
    t = t + "        CASE ""instanceof""" + NL
    t = t + "            IF NOT JsCallable(b) THEN THROW Str(jsLine) + ""|Function expected""" + NL
    t = t + "            RETURN JsB(JsInstanceOf(a, JsGet(b, ""prototype"")))" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(jsLine) + ""|Syntax error""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsInstanceOf (v AS String, proto AS String) AS Bool" + NL
    t = t + "    VAR o AS Integer" + NL
    t = t + "    IF NOT v.StartsWith(""o"") OR NOT proto.StartsWith(""o"") THEN RETURN FALSE" + NL
    t = t + "    o = joProto[JsId(v)]" + NL
    t = t + "    WHILE o <> 0" + NL
    t = t + "        IF o = JsId(proto) THEN RETURN TRUE" + NL
    t = t + "        o = joProto[o]" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- objects" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNewObject (class AS String, proto AS Integer) AS Integer" + NL
    t = t + "    joClass.Add(class)" + NL
    t = t + "    joProto.Add(proto)" + NL
    t = t + "    joA.Add(0)" + NL
    t = t + "    joB.Add(0)" + NL
    t = t + "    joS.Add("""")" + NL
    t = t + "    joKeys.Add(""|"")" + NL
    t = t + "    RETURN joClass.Count - 1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsOwn (id AS Integer, name AS String) AS Integer" + NL
    t = t + "    RETURN jpKey.IndexOf(Str(id) + "":"" + name)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Sets a property on the object itself (no host magic)." + NL
    t = t + "SUB JsPutOwn (id AS Integer, name AS String, v AS String)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    k = JsOwn(id, name)" + NL
    t = t + "    IF k >= 0 THEN" + NL
    t = t + "        jpVal[k] = v" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    jpKey.Add(Str(id) + "":"" + name)" + NL
    t = t + "    jpVal.Add(v)" + NL
    t = t + "    IF NOT name.StartsWith(""@"") THEN joKeys[id] = joKeys[id] + name + ""|""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsGetProp (id AS Integer, name AS String) AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR o AS Integer" + NL
    t = t + "    o = id" + NL
    t = t + "    WHILE o <> 0" + NL
    t = t + "        k = JsOwn(o, name)" + NL
    t = t + "        IF k >= 0 THEN RETURN jpVal[k]" + NL
    t = t + "        o = joProto[o]" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN ""u""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsIsIndex (name AS String) AS Bool" + NL
    t = t + "    RETURN name <> """" AND name.Length < 10 AND OnlyChars(name, ""0123456789"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' v.name, for any value" + NL
    t = t + "FUNCTION JsGet (v AS String, name AS String) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    SELECT CASE v.Substring(0, 1)" + NL
    t = t + "        CASE ""u"", ""l""" + NL
    t = t + "            THROW Str(jsLine) + ""|'"" + name + ""' is null or not an object""" + NL
    t = t + "        CASE ""s""" + NL
    t = t + "            text = v.Substring(1, v.Length - 1)" + NL
    t = t + "            IF name = ""length"" THEN RETURN JsN(text.Length)" + NL
    t = t + "            IF JsIsIndex(name) THEN" + NL
    t = t + "                IF Int(Val(name)) < text.Length THEN RETURN JsS(text.CharAt(Int(Val(name))))" + NL
    t = t + "                RETURN ""u""" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsGetProp(jsStringProto, name)" + NL
    t = t + "        CASE ""n""" + NL
    t = t + "            RETURN JsGetProp(jsNumberProto, name)" + NL
    t = t + "        CASE ""t"", ""f""" + NL
    t = t + "            RETURN JsGetProp(jsObjectProto, name)" + NL
    t = t + "    END SELECT" + NL
    t = t + "    id = JsId(v)" + NL
    t = t + "    SELECT CASE joClass[id]" + NL
    t = t + "        CASE ""Host""" + NL
    t = t + "            RETURN JsHostGet(id, name)" + NL
    t = t + "        CASE ""Style""" + NL
    t = t + "            RETURN JsStyleGet(id, name)" + NL
    t = t + "        CASE ""Location""" + NL
    t = t + "            RETURN JsLocationGet(name)" + NL
    t = t + "        CASE ""All""" + NL
    t = t + "            ' IE's document.all: every element with an id" + NL
    t = t + "            IF name = ""item"" THEN RETURN JsNative(""All.item"")" + NL
    t = t + "            IF name <> """" AND JsOwn(id, name) < 0 THEN" + NL
    t = t + "                IF HostHas(name) THEN RETURN JsElement(name)" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Document""" + NL
    t = t + "            IF ""|title|cookie|URL|lastModified|referrer|domain|"".Contains(""|"" + name + ""|"") THEN RETURN JsDocumentGet(name)" + NL
    t = t + "        CASE ""Global""" + NL
    t = t + "            IF name = ""status"" OR name = ""defaultStatus"" THEN RETURN JsS(HostInfo(""status""))" + NL
    t = t + "            IF name = ""location"" THEN RETURN JsO(jsLocation)" + NL
    t = t + "        CASE ""Function""" + NL
    t = t + "            IF name = ""prototype"" AND JsOwn(id, ""prototype"") < 0 THEN JsPutOwn(id, ""prototype"", JsO(JsNewProtoFor(id)))" + NL
    t = t + "            IF name = ""length"" THEN" + NL
    t = t + "                IF nl[joA[id]] = """" THEN RETURN ""n0""" + NL
    t = t + "                RETURN JsN(nl[joA[id]].Split("","").Count)" + NL
    t = t + "            END IF" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN JsGetProp(id, name)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNewProtoFor (fn AS Integer) AS Integer" + NL
    t = t + "    VAR p AS Integer" + NL
    t = t + "    p = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsPutOwn(p, ""constructor"", JsO(fn))" + NL
    t = t + "    RETURN p" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' v.name = value" + NL
    t = t + "SUB JsPut (v AS String, name AS String, value AS String)" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    IF v.StartsWith(""u"") OR v.StartsWith(""l"") THEN THROW Str(jsLine) + ""|'"" + name + ""' is null or not an object""" + NL
    t = t + "    IF NOT v.StartsWith(""o"") THEN RETURN" + NL
    t = t + "    id = JsId(v)" + NL
    t = t + "    SELECT CASE joClass[id]" + NL
    t = t + "        CASE ""Host""" + NL
    t = t + "            JsHostSet(id, name, value)" + NL
    t = t + "            RETURN" + NL
    t = t + "        CASE ""Style""" + NL
    t = t + "            JsStyleSet(id, name, value)" + NL
    t = t + "            RETURN" + NL
    t = t + "        CASE ""Location""" + NL
    t = t + "            IF name = ""href"" THEN HostNavigate(JsStr(value))" + NL
    t = t + "            RETURN" + NL
    t = t + "        CASE ""Document""" + NL
    t = t + "            IF name = ""title"" OR name = ""cookie"" THEN" + NL
    t = t + "                HostSetInfo(name, JsStr(value))" + NL
    t = t + "                RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "            IF name = ""location"" OR name = ""URL"" THEN" + NL
    t = t + "                HostNavigate(JsStr(value))" + NL
    t = t + "                RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Global""" + NL
    t = t + "            IF name = ""status"" OR name = ""defaultStatus"" THEN" + NL
    t = t + "                HostStatus(JsStr(value))" + NL
    t = t + "                RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "            IF name = ""location"" THEN" + NL
    t = t + "                HostNavigate(JsStr(value))" + NL
    t = t + "                RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Array""" + NL
    t = t + "            IF name = ""length"" THEN" + NL
    t = t + "                JsSetLength(id, JsInt(value))" + NL
    t = t + "                RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "            IF JsIsIndex(name) THEN" + NL
    t = t + "                IF Int(Val(name)) >= JsInt(JsGetProp(id, ""length"")) THEN JsPutOwn(id, ""length"", JsN(Int(Val(name)) + 1))" + NL
    t = t + "            END IF" + NL
    t = t + "    END SELECT" + NL
    t = t + "    JsPutOwn(id, name, value)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB JsSetLength (id AS Integer, n AS Integer)" + NL
    t = t + "    VAR old AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    old = JsInt(JsGetProp(id, ""length""))" + NL
    t = t + "    FOR i = n TO old - 1" + NL
    t = t + "        k = JsOwn(id, Str(i))" + NL
    t = t + "        IF k >= 0 THEN jpVal[k] = ""u""" + NL
    t = t + "    NEXT" + NL
    t = t + "    JsPutOwn(id, ""length"", JsN(n))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsKey (v AS String) AS String" + NL
    t = t + "    IF v.StartsWith(""n"") AND JsFinite(JsNum(v)) THEN" + NL
    t = t + "        IF JsReal(v) = Int(JsReal(v)) THEN RETURN Str(Int(JsReal(v)))" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN JsStr(v)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNewArray (items AS Array OF String) AS Integer" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    id = JsNewObject(""Array"", jsArrayProto)" + NL
    t = t + "    FOR i = 0 TO items.Count - 1" + NL
    t = t + "        JsPutOwn(id, Str(i), items[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    JsPutOwn(id, ""length"", JsN(items.Count))" + NL
    t = t + "    RETURN id" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsItems (id AS Integer) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    n = JsInt(JsGetProp(id, ""length""))" + NL
    t = t + "    FOR i = 0 TO n - 1" + NL
    t = t + "        out.Add(JsGetProp(id, Str(i)))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsJoin (id AS Integer, sep AS String) AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    FOR EACH v IN JsItems(id)" + NL
    t = t + "        IF v = ""u"" OR v = ""l"" THEN" + NL
    t = t + "            parts.Add("""")" + NL
    t = t + "        ELSE" + NL
    t = t + "            parts.Add(JsStr(v))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN parts.Join(sep)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNative (name AS String) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    id = JsNewObject(""Native"", jsFunctionProto)" + NL
    t = t + "    joS[id] = name" + NL
    t = t + "    RETURN JsO(id)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JsMethods (owner AS Integer, prefix AS String, names AS String)" + NL
    t = t + "    VAR m AS String" + NL
    t = t + "    FOR EACH m IN names.Split("","")" + NL
    t = t + "        JsPutOwn(owner, m, JsNative(prefix + m))" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the page's objects" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsElement (elementId AS String) AS String" + NL
    t = t + "    VAR entry AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR style AS Integer" + NL
    t = t + "    FOR EACH entry IN jsHostCache" + NL
    t = t + "        IF entry.StartsWith(elementId + ""|"") THEN RETURN ""o"" + entry.Substring(elementId.Length + 1, entry.Length - elementId.Length - 1)" + NL
    t = t + "    NEXT" + NL
    t = t + "    id = JsNewObject(""Host"", jsObjectProto)" + NL
    t = t + "    joS[id] = elementId" + NL
    t = t + "    style = JsNewObject(""Style"", jsObjectProto)" + NL
    t = t + "    joS[style] = elementId" + NL
    t = t + "    joA[id] = style" + NL
    t = t + "    jsHostCache.Add(elementId + ""|"" + Str(id))" + NL
    t = t + "    RETURN JsO(id)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsHostGet (id AS Integer, name AS String) AS String" + NL
    t = t + "    VAR el AS String" + NL
    t = t + "    el = joS[id]" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""value""" + NL
    t = t + "            RETURN JsS(HostGet(el, ""Value""))" + NL
    t = t + "        CASE ""innerText"", ""innerHTML"", ""text"", ""textContent""" + NL
    t = t + "            RETURN JsS(HostGet(el, ""Text""))" + NL
    t = t + "        CASE ""checked""" + NL
    t = t + "            RETURN JsB(HostGet(el, ""Checked"") = ""True"")" + NL
    t = t + "        CASE ""disabled""" + NL
    t = t + "            RETURN JsB(HostGet(el, ""Enabled"") <> ""True"")" + NL
    t = t + "        CASE ""id""" + NL
    t = t + "            RETURN JsS(HostGet(el, ""Id""))" + NL
    t = t + "        CASE ""name""" + NL
    t = t + "            IF JsOwn(id, ""name"") >= 0 THEN RETURN JsGetProp(id, ""name"")" + NL
    t = t + "            RETURN JsS(HostGet(el, ""Id""))" + NL
    t = t + "        CASE ""tagName"", ""nodeName""" + NL
    t = t + "            RETURN JsS(HostGet(el, ""TagName""))" + NL
    t = t + "        CASE ""style""" + NL
    t = t + "            RETURN JsO(joA[id])" + NL
    t = t + "        CASE ""focus"", ""blur"", ""select"", ""click""" + NL
    t = t + "            RETURN JsNative(""Element."" + name)" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN JsGetProp(id, name)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JsHostSet (id AS Integer, name AS String, value AS String)" + NL
    t = t + "    VAR el AS String" + NL
    t = t + "    el = joS[id]" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""value""" + NL
    t = t + "            HostSet(el, ""Value"", JsStr(value))" + NL
    t = t + "        CASE ""innerText"", ""innerHTML"", ""text"", ""textContent""" + NL
    t = t + "            HostSet(el, ""Text"", JsStr(value))" + NL
    t = t + "        CASE ""checked""" + NL
    t = t + "            HostSet(el, ""Checked"", Str(JsBool(value)))" + NL
    t = t + "        CASE ""disabled""" + NL
    t = t + "            HostSet(el, ""Enabled"", Str(NOT JsBool(value)))" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            JsPutOwn(id, name, value)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsStyleGet (id AS Integer, name AS String) AS String" + NL
    t = t + "    IF name = ""display"" THEN" + NL
    t = t + "        IF HostGet(joS[id], ""Visible"") = ""True"" THEN RETURN JsS("""")" + NL
    t = t + "        RETURN JsS(""none"")" + NL
    t = t + "    END IF" + NL
    t = t + "    IF name = ""visibility"" THEN" + NL
    t = t + "        IF HostGet(joS[id], ""Visible"") = ""True"" THEN RETURN JsS(""visible"")" + NL
    t = t + "        RETURN JsS(""hidden"")" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN JsGetProp(id, name)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JsStyleSet (id AS Integer, name AS String, value AS String)" + NL
    t = t + "    IF name = ""display"" THEN" + NL
    t = t + "        HostSet(joS[id], ""Visible"", Str(JsStr(value) <> ""none""))" + NL
    t = t + "    ELSEIF name = ""visibility"" THEN" + NL
    t = t + "        HostSet(joS[id], ""Visible"", Str(JsStr(value) <> ""hidden""))" + NL
    t = t + "    ELSE" + NL
    t = t + "        JsPutOwn(id, name, value)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsLocationGet (name AS String) AS String" + NL
    t = t + "    VAR url AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    url = HostInfo(""location"")" + NL
    t = t + "    rest = url" + NL
    t = t + "    IF rest.StartsWith(""http://"") THEN rest = rest.Substring(7, rest.Length - 7)" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""href""" + NL
    t = t + "            RETURN JsS(url)" + NL
    t = t + "        CASE ""protocol""" + NL
    t = t + "            RETURN JsS(url.Substring(0, url.IndexOf("":"") + 1))" + NL
    t = t + "        CASE ""host"", ""hostname""" + NL
    t = t + "            IF rest.Contains(""/"") THEN rest = rest.Substring(0, rest.IndexOf(""/""))" + NL
    t = t + "            RETURN JsS(rest)" + NL
    t = t + "        CASE ""pathname""" + NL
    t = t + "            IF NOT rest.Contains(""/"") THEN RETURN JsS(""/"")" + NL
    t = t + "            rest = rest.Substring(rest.IndexOf(""/""), rest.Length - rest.IndexOf(""/""))" + NL
    t = t + "            IF rest.Contains(""?"") THEN rest = rest.Substring(0, rest.IndexOf(""?""))" + NL
    t = t + "            RETURN JsS(rest)" + NL
    t = t + "        CASE ""search""" + NL
    t = t + "            IF NOT url.Contains(""?"") THEN RETURN JsS("""")" + NL
    t = t + "            rest = url.Substring(url.IndexOf(""?""), url.Length - url.IndexOf(""?""))" + NL
    t = t + "            IF rest.Contains(""#"") THEN rest = rest.Substring(0, rest.IndexOf(""#""))" + NL
    t = t + "            RETURN JsS(rest)" + NL
    t = t + "        CASE ""hash""" + NL
    t = t + "            IF NOT url.Contains(""#"") THEN RETURN JsS("""")" + NL
    t = t + "            RETURN JsS(url.Substring(url.IndexOf(""#""), url.Length - url.IndexOf(""#"")))" + NL
    t = t + "        CASE ""reload"", ""replace"", ""assign"", ""toString""" + NL
    t = t + "            RETURN JsNative(""location."" + name)" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""u""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsDocumentGet (name AS String) AS String" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""URL""" + NL
    t = t + "            RETURN JsS(HostInfo(""location""))" + NL
    t = t + "        CASE ""lastModified""" + NL
    t = t + "            RETURN JsS(TIME.Date + "" "" + TIME.Clock)" + NL
    t = t + "        CASE ""domain""" + NL
    t = t + "            RETURN JsLocationGet(""host"")" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN JsS(HostInfo(name))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A form on the page: document.forms[i], and document.<its name> if it has one." + NL
    t = t + "FUNCTION JsAddForm (name AS String, index AS Integer) AS Integer" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    id = JsNewObject(""Form"", jsObjectProto)" + NL
    t = t + "    joA[id] = index" + NL
    t = t + "    JsPutOwn(id, ""name"", JsS(name))" + NL
    t = t + "    JsPutOwn(id, ""elements"", JsO(JsNewArray(none)))" + NL
    t = t + "    JsPutOwn(id, ""submit"", JsNative(""Form.submit""))" + NL
    t = t + "    JsPutOwn(id, ""reset"", JsNative(""Element.focus""))" + NL
    t = t + "    JsPut(JsO(jsFormsArray), Str(index), JsO(id))" + NL
    t = t + "    IF name <> """" THEN JsPutOwn(jsDocument, name, JsO(id))" + NL
    t = t + "    RETURN id" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A field of a form: form.<name>, and form.elements[i]." + NL
    t = t + "SUB JsAddField (form AS Integer, name AS String, elementId AS String)" + NL
    t = t + "    VAR el AS String" + NL
    t = t + "    VAR list AS Integer" + NL
    t = t + "    el = JsElement(elementId)" + NL
    t = t + "    JsPutOwn(JsId(el), ""name"", JsS(name))" + NL
    t = t + "    JsPutOwn(JsId(el), ""form"", JsO(form))" + NL
    t = t + "    ' fields hide the form's own properties (a field called ""name"" wins), but" + NL
    t = t + "    ' the first of several fields with one name keeps it" + NL
    t = t + "    IF name <> """" THEN" + NL
    t = t + "        IF JsOwn(form, name) < 0 THEN" + NL
    t = t + "            JsPutOwn(form, name, el)" + NL
    t = t + "        ELSEIF NOT jpVal[JsOwn(form, name)].StartsWith(""o"") OR joClass[JsId(jpVal[JsOwn(form, name)])] <> ""Host"" THEN" + NL
    t = t + "            JsPutOwn(form, name, el)" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    list = JsId(JsGetProp(form, ""elements""))" + NL
    t = t + "    JsPut(JsO(list), Str(JsInt(JsGetProp(list, ""length""))), el)" + NL
    t = t + "    JsPutOwn(form, ""length"", JsGetProp(list, ""length""))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- scopes" + NL
    t = t + "" + NL
    t = t + "' A scope is an object too: its variables are its properties, joA its parent" + NL
    t = t + "' and ""@this"" what this means inside it. The global scope is window itself." + NL
    t = t + "FUNCTION JsNewScope (parent AS Integer, thisVal AS String) AS Integer" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    id = JsNewObject(""Scope"", 0)" + NL
    t = t + "    joA[id] = parent" + NL
    t = t + "    JsPutOwn(id, ""@this"", thisVal)" + NL
    t = t + "    RETURN id" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsFindScope (name AS String, scope AS Integer) AS Integer" + NL
    t = t + "    VAR s AS Integer" + NL
    t = t + "    s = scope" + NL
    t = t + "    WHILE s <> 0" + NL
    t = t + "        IF JsOwn(s, name) >= 0 THEN RETURN s" + NL
    t = t + "        s = joA[s]" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsLookup (name AS String, scope AS Integer) AS String" + NL
    t = t + "    VAR s AS Integer" + NL
    t = t + "    IF name = ""undefined"" THEN RETURN ""u""" + NL
    t = t + "    IF name = ""status"" OR name = ""location"" OR name = ""defaultStatus"" THEN" + NL
    t = t + "        IF JsFindScope(name, scope) = 0 OR JsFindScope(name, scope) = jsGlobal THEN RETURN JsGet(JsO(jsGlobal), name)" + NL
    t = t + "    END IF" + NL
    t = t + "    s = JsFindScope(name, scope)" + NL
    t = t + "    IF s = 0 THEN THROW Str(jsLine) + ""|'"" + name + ""' is undefined""" + NL
    t = t + "    RETURN jpVal[JsOwn(s, name)]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JsSetVar (name AS String, v AS String, scope AS Integer)" + NL
    t = t + "    VAR s AS Integer" + NL
    t = t + "    s = JsFindScope(name, scope)" + NL
    t = t + "    IF s = 0 OR s = jsGlobal THEN" + NL
    t = t + "        JsPut(JsO(jsGlobal), name, v)" + NL
    t = t + "    ELSE" + NL
    t = t + "        jpVal[JsOwn(s, name)] = v" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsThisOf (scope AS Integer) AS String" + NL
    t = t + "    VAR s AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    s = scope" + NL
    t = t + "    WHILE s <> 0" + NL
    t = t + "        k = JsOwn(s, ""@this"")" + NL
    t = t + "        IF k >= 0 THEN RETURN jpVal[k]" + NL
    t = t + "        s = joA[s]" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN JsO(jsGlobal)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Functions and vars are known before a body runs (JavaScript ""hoisting"")." + NL
    t = t + "SUB JsHoist (n AS Integer, scope AS Integer)" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR d AS String" + NL
    t = t + "    IF n = 0 THEN RETURN" + NL
    t = t + "    SELECT CASE nk[n]" + NL
    t = t + "        CASE ""block""" + NL
    t = t + "            FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "                IF item <> """" THEN JsHoist(Int(Val(item)), scope)" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""func""" + NL
    t = t + "            JsPutOwn(scope, ns[n], JsMakeFunction(n, scope))" + NL
    t = t + "        CASE ""var""" + NL
    t = t + "            FOR EACH d IN nl[n].Split("","")" + NL
    t = t + "                IF JsOwn(scope, ns[Int(Val(d))]) < 0 THEN JsPutOwn(scope, ns[Int(Val(d))], ""u"")" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""if""" + NL
    t = t + "            JsHoist(nb[n], scope)" + NL
    t = t + "            JsHoist(nc[n], scope)" + NL
    t = t + "        CASE ""while"", ""do""" + NL
    t = t + "            JsHoist(nb[n], scope)" + NL
    t = t + "        CASE ""for""" + NL
    t = t + "            JsHoist(na[n], scope)" + NL
    t = t + "            JsHoist(nd[n], scope)" + NL
    t = t + "        CASE ""forin""" + NL
    t = t + "            IF JsOwn(scope, ns[n]) < 0 AND scope <> jsGlobal THEN JsPutOwn(scope, ns[n], ""u"")" + NL
    t = t + "            JsHoist(nd[n], scope)" + NL
    t = t + "        CASE ""try""" + NL
    t = t + "            JsHoist(na[n], scope)" + NL
    t = t + "            JsHoist(nb[n], scope)" + NL
    t = t + "            JsHoist(nc[n], scope)" + NL
    t = t + "        CASE ""switch""" + NL
    t = t + "            FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "                FOR EACH d IN nl[Int(Val(item))].Split("","")" + NL
    t = t + "                    IF d <> """" THEN JsHoist(Int(Val(d)), scope)" + NL
    t = t + "                NEXT" + NL
    t = t + "            NEXT" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A function value: the code (node) and the scope it was made in. That scope" + NL
    t = t + "' may now outlive the call that made it, so it is marked kept (joB = 1)." + NL
    t = t + "FUNCTION JsMakeFunction (n AS Integer, scope AS Integer) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR s AS Integer" + NL
    t = t + "    id = JsNewObject(""Function"", jsFunctionProto)" + NL
    t = t + "    joA[id] = n" + NL
    t = t + "    joB[id] = scope" + NL
    t = t + "    s = scope" + NL
    t = t + "    WHILE s <> 0 AND s <> jsGlobal" + NL
    t = t + "        joB[s] = 1" + NL
    t = t + "        s = joA[s]" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN JsO(id)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A finished call's scope, if nothing kept it: its properties go, so the" + NL
    t = t + "' property table does not grow with every call." + NL
    t = t + "SUB JsFreeScope (scope AS Integer)" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF joB[scope] = 1 THEN RETURN" + NL
    t = t + "    FOR EACH name IN (joKeys[scope] + ""@this|"").Split(""|"")" + NL
    t = t + "        IF name = """" THEN CONTINUE" + NL
    t = t + "        k = JsOwn(scope, name)" + NL
    t = t + "        IF k >= 0 THEN" + NL
    t = t + "            jpKey.RemoveAt(k)" + NL
    t = t + "            jpVal.RemoveAt(k)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    joKeys[scope] = ""|""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- running statements" + NL
    t = t + "" + NL
    t = t + "SUB JsTick ()" + NL
    t = t + "    jsSteps = jsSteps + 1" + NL
    t = t + "    IF jsSteps MOD 2000 = 0 THEN HostYield()" + NL
    t = t + "    IF jsSteps > jsLimit THEN" + NL
    t = t + "        IF HostSlow() THEN THROW Str(jsLine) + ""|@aborted""" + NL
    t = t + "        jsLimit = jsLimit * 2" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB JsExec (n AS Integer, scope AS Integer)" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    VAR keys AS Array OF String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR depth AS Integer" + NL
    t = t + "    VAR caught AS String" + NL
    t = t + "    VAR pending AS String" + NL
    t = t + "    VAR sig AS String" + NL
    t = t + "    VAR ret AS String" + NL
    t = t + "    VAR cases AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR start AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    IF n = 0 THEN RETURN" + NL
    t = t + "    jsLine = nline[n]" + NL
    t = t + "    JsTick()" + NL
    t = t + "    SELECT CASE nk[n]" + NL
    t = t + "        CASE ""block""" + NL
    t = t + "            FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "                IF item = """" THEN CONTINUE" + NL
    t = t + "                JsExec(Int(Val(item)), scope)" + NL
    t = t + "                IF jsSig <> """" THEN RETURN" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""var""" + NL
    t = t + "            FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "                d = Int(Val(item))" + NL
    t = t + "                IF na[d] <> 0 THEN JsSetVar(ns[d], JsEval(na[d], scope), scope)" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""exprst""" + NL
    t = t + "            jsRet = JsEval(na[n], scope)" + NL
    t = t + "        CASE ""if""" + NL
    t = t + "            IF JsBool(JsEval(na[n], scope)) THEN" + NL
    t = t + "                JsExec(nb[n], scope)" + NL
    t = t + "            ELSE" + NL
    t = t + "                JsExec(nc[n], scope)" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""while""" + NL
    t = t + "            WHILE JsBool(JsEval(na[n], scope))" + NL
    t = t + "                JsExec(nb[n], scope)" + NL
    t = t + "                IF jsSig = ""b"" THEN" + NL
    t = t + "                    jsSig = """"" + NL
    t = t + "                    BREAK" + NL
    t = t + "                END IF" + NL
    t = t + "                IF jsSig = ""c"" THEN jsSig = """"" + NL
    t = t + "                IF jsSig = ""r"" THEN RETURN" + NL
    t = t + "                JsTick()" + NL
    t = t + "            END WHILE" + NL
    t = t + "        CASE ""do""" + NL
    t = t + "            WHILE TRUE" + NL
    t = t + "                JsExec(nb[n], scope)" + NL
    t = t + "                IF jsSig = ""b"" THEN" + NL
    t = t + "                    jsSig = """"" + NL
    t = t + "                    BREAK" + NL
    t = t + "                END IF" + NL
    t = t + "                IF jsSig = ""c"" THEN jsSig = """"" + NL
    t = t + "                IF jsSig = ""r"" THEN RETURN" + NL
    t = t + "                IF NOT JsBool(JsEval(na[n], scope)) THEN BREAK" + NL
    t = t + "                JsTick()" + NL
    t = t + "            END WHILE" + NL
    t = t + "        CASE ""for""" + NL
    t = t + "            JsExec(na[n], scope)" + NL
    t = t + "            WHILE TRUE" + NL
    t = t + "                IF nb[n] <> 0 THEN" + NL
    t = t + "                    IF NOT JsBool(JsEval(nb[n], scope)) THEN BREAK" + NL
    t = t + "                END IF" + NL
    t = t + "                JsExec(nd[n], scope)" + NL
    t = t + "                IF jsSig = ""b"" THEN" + NL
    t = t + "                    jsSig = """"" + NL
    t = t + "                    BREAK" + NL
    t = t + "                END IF" + NL
    t = t + "                IF jsSig = ""c"" THEN jsSig = """"" + NL
    t = t + "                IF jsSig = ""r"" THEN RETURN" + NL
    t = t + "                IF nc[n] <> 0 THEN v = JsEval(nc[n], scope)" + NL
    t = t + "                JsTick()" + NL
    t = t + "            END WHILE" + NL
    t = t + "        CASE ""forin""" + NL
    t = t + "            v = JsEval(na[n], scope)" + NL
    t = t + "            IF v.StartsWith(""o"") THEN" + NL
    t = t + "                keys = joKeys[JsId(v)].Split(""|"")" + NL
    t = t + "                FOR EACH key IN keys" + NL
    t = t + "                    IF key = """" OR (joClass[JsId(v)] = ""Array"" AND key = ""length"") THEN CONTINUE" + NL
    t = t + "                    JsSetVar(ns[n], JsS(key), scope)" + NL
    t = t + "                    JsExec(nd[n], scope)" + NL
    t = t + "                    IF jsSig = ""b"" THEN" + NL
    t = t + "                        jsSig = """"" + NL
    t = t + "                        BREAK" + NL
    t = t + "                    END IF" + NL
    t = t + "                    IF jsSig = ""c"" THEN jsSig = """"" + NL
    t = t + "                    IF jsSig = ""r"" THEN RETURN" + NL
    t = t + "                NEXT" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""return""" + NL
    t = t + "            IF na[n] = 0 THEN" + NL
    t = t + "                jsRet = ""u""" + NL
    t = t + "            ELSE" + NL
    t = t + "                jsRet = JsEval(na[n], scope)" + NL
    t = t + "            END IF" + NL
    t = t + "            jsSig = ""r""" + NL
    t = t + "        CASE ""break""" + NL
    t = t + "            jsSig = ""b""" + NL
    t = t + "        CASE ""continue""" + NL
    t = t + "            jsSig = ""c""" + NL
    t = t + "        CASE ""throw""" + NL
    t = t + "            jsThrown = JsEval(na[n], scope)" + NL
    t = t + "            THROW Str(nline[n]) + ""|@thrown""" + NL
    t = t + "        CASE ""try""" + NL
    t = t + "            depth = jsDepth" + NL
    t = t + "            pending = """"" + NL
    t = t + "            TRY" + NL
    t = t + "                JsExec(na[n], scope)" + NL
    t = t + "            CATCH err" + NL
    t = t + "                jsDepth = depth" + NL
    t = t + "                IF err.Contains(""@aborted"") THEN THROW err" + NL
    t = t + "                IF nb[n] = 0 THEN" + NL
    t = t + "                    pending = err" + NL
    t = t + "                ELSE" + NL
    t = t + "                    IF jsThrown <> """" THEN" + NL
    t = t + "                        caught = jsThrown" + NL
    t = t + "                    ELSE" + NL
    t = t + "                        caught = JsMakeError(err)" + NL
    t = t + "                    END IF" + NL
    t = t + "                    jsThrown = """"" + NL
    t = t + "                    JsSetVar(ns[n], caught, scope)" + NL
    t = t + "                    TRY" + NL
    t = t + "                        JsExec(nb[n], scope)" + NL
    t = t + "                    CATCH again" + NL
    t = t + "                        jsDepth = depth" + NL
    t = t + "                        IF again.Contains(""@aborted"") THEN THROW again" + NL
    t = t + "                        pending = again" + NL
    t = t + "                    END TRY" + NL
    t = t + "                END IF" + NL
    t = t + "            END TRY" + NL
    t = t + "            IF nc[n] <> 0 THEN" + NL
    t = t + "                ' finally runs whatever happened, and keeps the return or" + NL
    t = t + "                ' error that was on its way out unless it makes its own" + NL
    t = t + "                sig = jsSig" + NL
    t = t + "                ret = jsRet" + NL
    t = t + "                caught = jsThrown" + NL
    t = t + "                jsSig = """"" + NL
    t = t + "                JsExec(nc[n], scope)" + NL
    t = t + "                IF jsSig = """" THEN" + NL
    t = t + "                    jsSig = sig" + NL
    t = t + "                    jsRet = ret" + NL
    t = t + "                    jsThrown = caught" + NL
    t = t + "                ELSE" + NL
    t = t + "                    pending = """"" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "            IF pending <> """" THEN THROW pending" + NL
    t = t + "        CASE ""switch""" + NL
    t = t + "            v = JsEval(na[n], scope)" + NL
    t = t + "            cases = nl[n].Split("","")" + NL
    t = t + "            start = -1" + NL
    t = t + "            FOR i = 0 TO cases.Count - 1" + NL
    t = t + "                c = Int(Val(cases[i]))" + NL
    t = t + "                IF na[c] <> 0 THEN" + NL
    t = t + "                    IF JsStrictEq(v, JsEval(na[c], scope)) THEN" + NL
    t = t + "                        start = i" + NL
    t = t + "                        BREAK" + NL
    t = t + "                    END IF" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF start < 0 THEN" + NL
    t = t + "                FOR i = 0 TO cases.Count - 1" + NL
    t = t + "                    IF na[Int(Val(cases[i]))] = 0 THEN start = i" + NL
    t = t + "                NEXT" + NL
    t = t + "            END IF" + NL
    t = t + "            IF start < 0 THEN RETURN" + NL
    t = t + "            FOR i = start TO cases.Count - 1" + NL
    t = t + "                FOR EACH item IN nl[Int(Val(cases[i]))].Split("","")" + NL
    t = t + "                    IF item = """" THEN CONTINUE" + NL
    t = t + "                    JsExec(Int(Val(item)), scope)" + NL
    t = t + "                    IF jsSig = ""b"" THEN" + NL
    t = t + "                        jsSig = """"" + NL
    t = t + "                        RETURN" + NL
    t = t + "                    END IF" + NL
    t = t + "                    IF jsSig <> """" THEN RETURN" + NL
    t = t + "                NEXT" + NL
    t = t + "            NEXT" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' An Error object for an error the interpreter raised (""line|message"")." + NL
    t = t + "FUNCTION JsMakeError (err AS String) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR message AS String" + NL
    t = t + "    message = err" + NL
    t = t + "    IF message.Contains(""|"") THEN message = message.Substring(message.IndexOf(""|"") + 1, message.Length - message.IndexOf(""|"") - 1)" + NL
    t = t + "    id = JsNewObject(""Error"", jsErrorProto)" + NL
    t = t + "    IF jsErrorProto = 0 THEN joProto[id] = jsObjectProto" + NL
    t = t + "    JsPutOwn(id, ""message"", JsS(message))" + NL
    t = t + "    JsPutOwn(id, ""description"", JsS(message))" + NL
    t = t + "    JsPutOwn(id, ""stack"", JsS(""Error: "" + message))" + NL
    t = t + "    RETURN JsO(id)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- evaluating expressions" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsEval (n AS Integer, scope AS Integer) AS String" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR items AS Array OF String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    VAR op AS String" + NL
    t = t + "    SELECT CASE nk[n]" + NL
    t = t + "        CASE ""num""" + NL
    t = t + "            RETURN ""n"" + ns[n]" + NL
    t = t + "        CASE ""str""" + NL
    t = t + "            RETURN ""s"" + ns[n]" + NL
    t = t + "        CASE ""true""" + NL
    t = t + "            RETURN ""t""" + NL
    t = t + "        CASE ""false""" + NL
    t = t + "            RETURN ""f""" + NL
    t = t + "        CASE ""null""" + NL
    t = t + "            RETURN ""l""" + NL
    t = t + "        CASE ""this""" + NL
    t = t + "            RETURN JsThisOf(scope)" + NL
    t = t + "        CASE ""id""" + NL
    t = t + "            RETURN JsLookup(ns[n], scope)" + NL
    t = t + "        CASE ""array""" + NL
    t = t + "            FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "                IF item <> """" THEN items.Add(JsEval(Int(Val(item)), scope))" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsO(JsNewArray(items))" + NL
    t = t + "        CASE ""object""" + NL
    t = t + "            id = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "            FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "                IF item <> """" THEN JsPutOwn(id, ns[Int(Val(item))], JsEval(na[Int(Val(item))], scope))" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsO(id)" + NL
    t = t + "        CASE ""funcexpr""" + NL
    t = t + "            RETURN JsMakeFunction(n, scope)" + NL
    t = t + "        CASE ""member""" + NL
    t = t + "            jsLine = nline[n]" + NL
    t = t + "            RETURN JsGet(JsNeed(JsEval(na[n], scope), na[n]), ns[n])" + NL
    t = t + "        CASE ""index""" + NL
    t = t + "            a = JsNeed(JsEval(na[n], scope), na[n])" + NL
    t = t + "            jsLine = nline[n]" + NL
    t = t + "            RETURN JsGet(a, JsKey(JsEval(nb[n], scope)))" + NL
    t = t + "        CASE ""assign""" + NL
    t = t + "            RETURN JsAssignment(n, scope)" + NL
    t = t + "        CASE ""incdec""" + NL
    t = t + "            RETURN JsIncDec(n, scope)" + NL
    t = t + "        CASE ""cond""" + NL
    t = t + "            IF JsBool(JsEval(na[n], scope)) THEN RETURN JsEval(nb[n], scope)" + NL
    t = t + "            RETURN JsEval(nc[n], scope)" + NL
    t = t + "        CASE ""bin""" + NL
    t = t + "            op = ns[n]" + NL
    t = t + "            IF op = ""&&"" THEN" + NL
    t = t + "                a = JsEval(na[n], scope)" + NL
    t = t + "                IF NOT JsBool(a) THEN RETURN a" + NL
    t = t + "                RETURN JsEval(nb[n], scope)" + NL
    t = t + "            END IF" + NL
    t = t + "            IF op = ""||"" THEN" + NL
    t = t + "                a = JsEval(na[n], scope)" + NL
    t = t + "                IF JsBool(a) THEN RETURN a" + NL
    t = t + "                RETURN JsEval(nb[n], scope)" + NL
    t = t + "            END IF" + NL
    t = t + "            a = JsEval(na[n], scope)" + NL
    t = t + "            v = JsEval(nb[n], scope)" + NL
    t = t + "            jsLine = nline[n]" + NL
    t = t + "            RETURN JsBinOp(op, a, v)" + NL
    t = t + "        CASE ""unary""" + NL
    t = t + "            RETURN JsUnaryOp(n, scope)" + NL
    t = t + "        CASE ""call""" + NL
    t = t + "            RETURN JsCallNode(n, scope)" + NL
    t = t + "        CASE ""new""" + NL
    t = t + "            RETURN JsNewNode(n, scope)" + NL
    t = t + "        CASE ""seq""" + NL
    t = t + "            FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "                v = JsEval(Int(Val(item)), scope)" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN v" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(nline[n]) + ""|Syntax error""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsUnaryOp (n AS Integer, scope AS Integer) AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    VAR t AS Integer" + NL
    t = t + "    VAR obj AS String" + NL
    t = t + "    t = na[n]" + NL
    t = t + "    SELECT CASE ns[n]" + NL
    t = t + "        CASE ""typeof""" + NL
    t = t + "            IF nk[t] = ""id"" THEN" + NL
    t = t + "                IF ns[t] <> ""undefined"" AND ns[t] <> ""status"" AND ns[t] <> ""location"" AND JsFindScope(ns[t], scope) = 0 THEN RETURN ""sundefined""" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsS(JsTypeOf(JsEval(t, scope)))" + NL
    t = t + "        CASE ""void""" + NL
    t = t + "            v = JsEval(t, scope)" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""delete""" + NL
    t = t + "            IF nk[t] = ""member"" OR nk[t] = ""index"" THEN" + NL
    t = t + "                obj = JsNeed(JsEval(na[t], scope), na[t])" + NL
    t = t + "                IF nk[t] = ""member"" THEN" + NL
    t = t + "                    JsDeleteProp(JsId(obj), ns[t])" + NL
    t = t + "                ELSE" + NL
    t = t + "                    JsDeleteProp(JsId(obj), JsKey(JsEval(nb[t], scope)))" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN ""t""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    v = JsEval(t, scope)" + NL
    t = t + "    SELECT CASE ns[n]" + NL
    t = t + "        CASE ""!""" + NL
    t = t + "            RETURN JsB(NOT JsBool(v))" + NL
    t = t + "        CASE ""-""" + NL
    t = t + "            IF JsNum(v) = ""0"" THEN RETURN ""n0""" + NL
    t = t + "            RETURN ""n"" + JsArith(""-"", ""0"", JsNum(v))" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""n"" + JsNum(v)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JsDeleteProp (id AS Integer, name AS String)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    IF id = 0 THEN RETURN" + NL
    t = t + "    k = JsOwn(id, name)" + NL
    t = t + "    IF k < 0 THEN RETURN" + NL
    t = t + "    jpKey.RemoveAt(k)" + NL
    t = t + "    jpVal.RemoveAt(k)" + NL
    t = t + "    joKeys[id] = joKeys[id].Replace(""|"" + name + ""|"", ""|"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' x = v, x += v, a.b = v, a[k] = v" + NL
    t = t + "FUNCTION JsAssignment (n AS Integer, scope AS Integer) AS String" + NL
    t = t + "    VAR t AS Integer" + NL
    t = t + "    VAR op AS String" + NL
    t = t + "    VAR obj AS String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    t = na[n]" + NL
    t = t + "    op = ns[n]" + NL
    t = t + "    IF nk[t] = ""id"" THEN" + NL
    t = t + "        IF op = ""="" THEN" + NL
    t = t + "            v = JsEval(nb[n], scope)" + NL
    t = t + "        ELSE" + NL
    t = t + "            v = JsBinOp(op.Substring(0, 1), JsLookup(ns[t], scope), JsEval(nb[n], scope))" + NL
    t = t + "        END IF" + NL
    t = t + "        JsSetVar(ns[t], v, scope)" + NL
    t = t + "        RETURN v" + NL
    t = t + "    END IF" + NL
    t = t + "    obj = JsNeed(JsEval(na[t], scope), na[t])" + NL
    t = t + "    IF nk[t] = ""member"" THEN" + NL
    t = t + "        key = ns[t]" + NL
    t = t + "    ELSE" + NL
    t = t + "        key = JsKey(JsEval(nb[t], scope))" + NL
    t = t + "    END IF" + NL
    t = t + "    jsLine = nline[n]" + NL
    t = t + "    IF op = ""="" THEN" + NL
    t = t + "        v = JsEval(nb[n], scope)" + NL
    t = t + "    ELSE" + NL
    t = t + "        v = JsBinOp(op.Substring(0, 1), JsGet(obj, key), JsEval(nb[n], scope))" + NL
    t = t + "    END IF" + NL
    t = t + "    JsPut(obj, key, v)" + NL
    t = t + "    RETURN v" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ++x, x++, --x, x--" + NL
    t = t + "FUNCTION JsIncDec (n AS Integer, scope AS Integer) AS String" + NL
    t = t + "    VAR t AS Integer" + NL
    t = t + "    VAR obj AS String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR old AS String" + NL
    t = t + "    VAR fresh AS String" + NL
    t = t + "    t = na[n]" + NL
    t = t + "    IF nk[t] = ""id"" THEN" + NL
    t = t + "        old = JsNum(JsLookup(ns[t], scope))" + NL
    t = t + "    ELSE" + NL
    t = t + "        obj = JsNeed(JsEval(na[t], scope), na[t])" + NL
    t = t + "        IF nk[t] = ""member"" THEN" + NL
    t = t + "            key = ns[t]" + NL
    t = t + "        ELSE" + NL
    t = t + "            key = JsKey(JsEval(nb[t], scope))" + NL
    t = t + "        END IF" + NL
    t = t + "        old = JsNum(JsGet(obj, key))" + NL
    t = t + "    END IF" + NL
    t = t + "    fresh = JsArith(ns[n].Substring(0, 1), old, ""1"")" + NL
    t = t + "    IF nk[t] = ""id"" THEN" + NL
    t = t + "        JsSetVar(ns[t], ""n"" + fresh, scope)" + NL
    t = t + "    ELSE" + NL
    t = t + "        JsPut(obj, key, ""n"" + fresh)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF nl[n] = ""pre"" THEN RETURN ""n"" + fresh" + NL
    t = t + "    RETURN ""n"" + old" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsArgList (n AS Integer, scope AS Integer) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    FOR EACH item IN nl[n].Split("","")" + NL
    t = t + "        IF item <> """" THEN out.Add(JsEval(Int(Val(item)), scope))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsCallNode (n AS Integer, scope AS Integer) AS String" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR thisVal AS String" + NL
    t = t + "    VAR fn AS String" + NL
    t = t + "    VAR args AS Array OF String" + NL
    t = t + "    VAR prog AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    c = na[n]" + NL
    t = t + "    IF nk[c] = ""member"" THEN" + NL
    t = t + "        thisVal = JsNeed(JsEval(na[c], scope), na[c])" + NL
    t = t + "        jsLine = nline[n]" + NL
    t = t + "        fn = JsGet(thisVal, ns[c])" + NL
    t = t + "        name = ns[c]" + NL
    t = t + "    ELSEIF nk[c] = ""index"" THEN" + NL
    t = t + "        thisVal = JsNeed(JsEval(na[c], scope), na[c])" + NL
    t = t + "        name = JsKey(JsEval(nb[c], scope))" + NL
    t = t + "        jsLine = nline[n]" + NL
    t = t + "        fn = JsGet(thisVal, name)" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF nk[c] = ""id"" AND ns[c] = ""eval"" THEN RETURN JsEvalCode(JsArgList(n, scope), scope)" + NL
    t = t + "        fn = JsEval(c, scope)" + NL
    t = t + "        thisVal = JsO(jsGlobal)" + NL
    t = t + "        name = JsDescribe(c)" + NL
    t = t + "    END IF" + NL
    t = t + "    args = JsArgList(n, scope)" + NL
    t = t + "    jsLine = nline[n]" + NL
    t = t + "    IF NOT JsCallable(fn) THEN" + NL
    t = t + "        IF nk[c] = ""member"" OR nk[c] = ""index"" THEN THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "        THROW Str(jsLine) + ""|Function expected""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN JsCall(fn, thisVal, args)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' eval(""code""): runs in the scope that called it; its value is the last expression's." + NL
    t = t + "FUNCTION JsEvalCode (args AS Array OF String, scope AS Integer) AS String" + NL
    t = t + "    VAR prog AS Integer" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    IF args.Count = 0 THEN RETURN ""u""" + NL
    t = t + "    IF NOT args[0].StartsWith(""s"") THEN RETURN args[0]" + NL
    t = t + "    line = jsLine" + NL
    t = t + "    prog = JsParse(args[0].Substring(1, args[0].Length - 1))" + NL
    t = t + "    jsLine = line" + NL
    t = t + "    JsHoist(prog, scope)" + NL
    t = t + "    jsRet = ""u""" + NL
    t = t + "    JsExec(prog, scope)" + NL
    t = t + "    IF jsSig = ""r"" THEN jsSig = """"" + NL
    t = t + "    RETURN jsRet" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsCall (fn AS String, thisVal AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR node AS Integer" + NL
    t = t + "    VAR scope AS Integer" + NL
    t = t + "    VAR params AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR result AS String" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    id = JsId(fn)" + NL
    t = t + "    IF joClass[id] = ""Native"" THEN RETURN JsCallNative(joS[id], thisVal, args)" + NL
    t = t + "    node = joA[id]" + NL
    t = t + "    jsDepth = jsDepth + 1" + NL
    t = t + "    IF jsDepth > JSMAXDEPTH THEN THROW Str(jsLine) + ""|Out of stack space""" + NL
    t = t + "    line = jsLine" + NL
    t = t + "    scope = JsNewScope(joB[id], thisVal)" + NL
    t = t + "    ' an arrow function's this is the one where it was made" + NL
    t = t + "    IF nd[node] = 1 THEN JsDeleteProp(scope, ""@this"")" + NL
    t = t + "    IF nl[node] <> """" THEN params = nl[node].Split("","")" + NL
    t = t + "    FOR i = 0 TO params.Count - 1" + NL
    t = t + "        IF i < args.Count THEN" + NL
    t = t + "            JsPutOwn(scope, params[i], args[i])" + NL
    t = t + "        ELSE" + NL
    t = t + "            JsPutOwn(scope, params[i], ""u"")" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    JsPutOwn(scope, ""arguments"", JsO(JsNewArray(args)))" + NL
    t = t + "    IF nk[node] = ""funcexpr"" AND ns[node] <> """" AND JsOwn(scope, ns[node]) < 0 THEN JsPutOwn(scope, ns[node], fn)" + NL
    t = t + "    JsHoist(na[node], scope)" + NL
    t = t + "    JsExec(na[node], scope)" + NL
    t = t + "    result = ""u""" + NL
    t = t + "    IF jsSig = ""r"" THEN result = jsRet" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    jsDepth = jsDepth - 1" + NL
    t = t + "    jsLine = line" + NL
    t = t + "    JsFreeScope(scope)" + NL
    t = t + "    RETURN result" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' new F(args): a fresh object whose prototype is F.prototype, with F run on it." + NL
    t = t + "FUNCTION JsNewNode (n AS Integer, scope AS Integer) AS String" + NL
    t = t + "    VAR fn AS String" + NL
    t = t + "    VAR args AS Array OF String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR result AS String" + NL
    t = t + "    fn = JsEval(na[n], scope)" + NL
    t = t + "    args = JsArgList(n, scope)" + NL
    t = t + "    jsLine = nline[n]" + NL
    t = t + "    IF NOT JsCallable(fn) THEN THROW Str(jsLine) + ""|Object doesn't support this action""" + NL
    t = t + "    IF joClass[JsId(fn)] = ""Native"" THEN RETURN JsConstruct(joS[JsId(fn)], args)" + NL
    t = t + "    id = JsNewObject(""Object"", JsId(JsGet(fn, ""prototype"")))" + NL
    t = t + "    result = JsCall(fn, JsO(id), args)" + NL
    t = t + "    IF result.StartsWith(""o"") THEN RETURN result" + NL
    t = t + "    RETURN JsO(id)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- dates" + NL
    t = t + "" + NL
    t = t + "' Seconds to add to UTC for local time, worked out from the machine's clock." + NL
    t = t + "FUNCTION JsZone () AS Integer" + NL
    t = t + "    VAR z AS Integer" + NL
    t = t + "    z = Int(TIME.Ticks / 1000) - (TIME.Now MOD 86400)" + NL
    t = t + "    IF z > 43200 THEN z = z - 86400" + NL
    t = t + "    IF z < -43200 THEN z = z + 86400" + NL
    t = t + "    RETURN Int(MATH.Round(z / 900)) * 900" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Days since 1970-01-01 for a date, and back (Howard Hinnant's algorithms)." + NL
    t = t + "FUNCTION JsDaysFrom (y AS Integer, m AS Integer, d AS Integer) AS Integer" + NL
    t = t + "    VAR era AS Integer" + NL
    t = t + "    VAR yoe AS Integer" + NL
    t = t + "    VAR doy AS Integer" + NL
    t = t + "    VAR doe AS Integer" + NL
    t = t + "    IF m <= 2 THEN y = y - 1" + NL
    t = t + "    era = MATH.Floor(y / 400)" + NL
    t = t + "    yoe = y - era * 400" + NL
    t = t + "    IF m > 2 THEN" + NL
    t = t + "        doy = Int((153 * (m - 3) + 2) / 5) + d - 1" + NL
    t = t + "    ELSE" + NL
    t = t + "        doy = Int((153 * (m + 9) + 2) / 5) + d - 1" + NL
    t = t + "    END IF" + NL
    t = t + "    doe = yoe * 365 + Int(yoe / 4) - Int(yoe / 100) + doy" + NL
    t = t + "    RETURN era * 146097 + doe - 719468" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' y|m|d for a day number" + NL
    t = t + "FUNCTION JsCivil (days AS Integer) AS String" + NL
    t = t + "    VAR z AS Integer" + NL
    t = t + "    VAR era AS Integer" + NL
    t = t + "    VAR doe AS Integer" + NL
    t = t + "    VAR yoe AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR doy AS Integer" + NL
    t = t + "    VAR mp AS Integer" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    VAR m AS Integer" + NL
    t = t + "    z = days + 719468" + NL
    t = t + "    era = MATH.Floor(z / 146097)" + NL
    t = t + "    doe = z - era * 146097" + NL
    t = t + "    yoe = Int((doe - Int(doe / 1460) + Int(doe / 36524) - Int(doe / 146096)) / 365)" + NL
    t = t + "    y = yoe + era * 400" + NL
    t = t + "    doy = doe - (365 * yoe + Int(yoe / 4) - Int(yoe / 100))" + NL
    t = t + "    mp = Int((5 * doy + 2) / 153)" + NL
    t = t + "    d = doy - Int((153 * mp + 2) / 5) + 1" + NL
    t = t + "    IF mp < 10 THEN" + NL
    t = t + "        m = mp + 3" + NL
    t = t + "    ELSE" + NL
    t = t + "        m = mp - 9" + NL
    t = t + "    END IF" + NL
    t = t + "    IF m <= 2 THEN y = y + 1" + NL
    t = t + "    RETURN Str(y) + ""|"" + Str(m) + ""|"" + Str(d)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One part of a time (milliseconds since 1970), in local time." + NL
    t = t + "FUNCTION JsDatePart (ms AS Real, part AS String) AS Integer" + NL
    t = t + "    VAR local AS Real" + NL
    t = t + "    VAR days AS Integer" + NL
    t = t + "    VAR secs AS Integer" + NL
    t = t + "    VAR ymd AS Array OF String" + NL
    t = t + "    local = MATH.Floor(ms / 1000) + JsZone()" + NL
    t = t + "    days = MATH.Floor(local / 86400)" + NL
    t = t + "    secs = Int(local - days * 86400)" + NL
    t = t + "    SELECT CASE part" + NL
    t = t + "        CASE ""hours""" + NL
    t = t + "            RETURN Int(secs / 3600)" + NL
    t = t + "        CASE ""minutes""" + NL
    t = t + "            RETURN Int((secs MOD 3600) / 60)" + NL
    t = t + "        CASE ""seconds""" + NL
    t = t + "            RETURN secs MOD 60" + NL
    t = t + "        CASE ""ms""" + NL
    t = t + "            RETURN Int(ms - MATH.Floor(ms / 1000) * 1000)" + NL
    t = t + "        CASE ""day""" + NL
    t = t + "            RETURN ((days MOD 7) + 11) MOD 7" + NL
    t = t + "    END SELECT" + NL
    t = t + "    ymd = JsCivil(days).Split(""|"")" + NL
    t = t + "    SELECT CASE part" + NL
    t = t + "        CASE ""year""" + NL
    t = t + "            RETURN Int(Val(ymd[0]))" + NL
    t = t + "        CASE ""month""" + NL
    t = t + "            RETURN Int(Val(ymd[1])) - 1" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN Int(Val(ymd[2]))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Pad2 (n AS Integer) AS String" + NL
    t = t + "    IF n < 10 THEN RETURN ""0"" + Str(n)" + NL
    t = t + "    RETURN Str(n)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""Thu Jul 4 12:00:00 1996"", the way 1996 browsers wrote dates" + NL
    t = t + "FUNCTION JsDateText (ms AS Real) AS String" + NL
    t = t + "    IF ms <> ms THEN RETURN ""NaN""" + NL
    t = t + "    RETURN ""Sun,Mon,Tue,Wed,Thu,Fri,Sat"".Split("","")[JsDatePart(ms, ""day"")] + "" "" + ""Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec"".Split("","")[JsDatePart(ms, ""month"")] + "" "" + Str(JsDatePart(ms, ""date"")) + "" "" _" + NL
    t = t + "        + Pad2(JsDatePart(ms, ""hours"")) + "":"" + Pad2(JsDatePart(ms, ""minutes"")) + "":"" + Pad2(JsDatePart(ms, ""seconds"")) + "" "" + Str(JsDatePart(ms, ""year""))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNow () AS Real" + NL
    t = t + "    RETURN TIME.Now * 1000.0 + (TIME.Ticks MOD 1000)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A moment from local date parts; months and days may run over, as in JS." + NL
    t = t + "FUNCTION JsLocalMs (y AS Real, mon AS Real, d AS Real, h AS Real, mi AS Real, sec AS Real, ms AS Real) AS Real" + NL
    t = t + "    VAR years AS Integer" + NL
    t = t + "    years = MATH.Floor(mon / 12)" + NL
    t = t + "    mon = mon - years * 12" + NL
    t = t + "    RETURN ((JsDaysFrom(Int(y) + years, Int(mon) + 1, 1) + d - 1) * 86400.0 + h * 3600 + mi * 60 + sec - JsZone()) * 1000 + ms" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNewDate (ms AS Real) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    id = JsNewObject(""Date"", jsDateProto)" + NL
    t = t + "    joS[id] = JsFmt(ms)" + NL
    t = t + "    RETURN JsO(id)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- built-in functions" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsArg (args AS Array OF String, i AS Integer) AS String" + NL
    t = t + "    IF i < args.Count THEN RETURN args[i]" + NL
    t = t + "    RETURN ""u""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' new Array(...), new Date(...), new Object(), new String(...)..." + NL
    t = t + "FUNCTION JsConstruct (name AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR ms AS Real" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""Array""" + NL
    t = t + "            IF args.Count = 1 AND args[0].StartsWith(""n"") THEN" + NL
    t = t + "                id = JsNewArray(none)" + NL
    t = t + "                JsPutOwn(id, ""length"", args[0])" + NL
    t = t + "                RETURN JsO(id)" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsO(JsNewArray(args))" + NL
    t = t + "        CASE ""Object""" + NL
    t = t + "            RETURN JsO(JsNewObject(""Object"", jsObjectProto))" + NL
    t = t + "        CASE ""Date""" + NL
    t = t + "            IF args.Count = 0 THEN RETURN JsNewDate(JsNow())" + NL
    t = t + "            IF args.Count = 1 THEN" + NL
    t = t + "                IF args[0].StartsWith(""n"") THEN RETURN JsNewDate(JsReal(args[0]))" + NL
    t = t + "                id = JsNewObject(""Date"", jsDateProto)" + NL
    t = t + "                joS[id] = ""NaN""" + NL
    t = t + "                RETURN JsO(id)" + NL
    t = t + "            END IF" + NL
    t = t + "            id = JsInt(args[0])" + NL
    t = t + "            IF id >= 0 AND id < 100 THEN id = id + 1900" + NL
    t = t + "            ms = 1" + NL
    t = t + "            IF args.Count >= 3 THEN ms = JsReal(args[2])" + NL
    t = t + "            RETURN JsNewDate(JsLocalMs(id, JsReal(args[1]), ms, JsReal(JsArg(args, 3)), JsReal(JsArg(args, 4)), JsReal(JsArg(args, 5)), JsReal(JsArg(args, 6))))" + NL
    t = t + "        CASE ""Error"", ""TypeError"", ""RangeError"", ""SyntaxError"", ""ReferenceError""" + NL
    t = t + "            IF JsArg(args, 0) = ""u"" THEN RETURN JsMakeTypedError(name, """")" + NL
    t = t + "            RETURN JsMakeTypedError(name, JsStr(JsArg(args, 0)))" + NL
    t = t + "        CASE ""Promise""" + NL
    t = t + "            RETURN JsNewPromiseFrom(JsArg(args, 0))" + NL
    t = t + "        CASE ""XMLHttpRequest""" + NL
    t = t + "            RETURN JsO(JsNewXhr())" + NL
    t = t + "        CASE ""ActiveXObject""" + NL
    t = t + "            ' IE's way: only the XMLHTTP objects are here" + NL
    t = t + "            IF JsStr(JsArg(args, 0)).Lower() = ""microsoft.xmlhttp"" OR JsStr(JsArg(args, 0)).Lower().StartsWith(""msxml2.xmlhttp"") THEN RETURN JsO(JsNewXhr())" + NL
    t = t + "            THROW Str(jsLine) + ""|Automation server can't create object""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN JsCallNative(name, JsO(jsGlobal), args)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsCallNative (name AS String, thisVal AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR r AS Real" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    a = JsArg(args, 0)" + NL
    t = t + "    IF name.StartsWith(""String."") AND name <> ""String.fromCharCode"" THEN RETURN JsStringMethod(name.Substring(7, name.Length - 7), JsStr(thisVal), args)" + NL
    t = t + "    IF name.StartsWith(""Array."") THEN RETURN JsArrayMethod(name.Substring(6, name.Length - 6), JsId(thisVal), args)" + NL
    t = t + "    IF name.StartsWith(""Math."") THEN RETURN JsMath(name.Substring(5, name.Length - 5), args)" + NL
    t = t + "    IF name.StartsWith(""Date."") THEN RETURN JsDateMethod(name.Substring(5, name.Length - 5), thisVal, args)" + NL
    t = t + "    IF name.StartsWith(""XHR."") THEN RETURN JsXhrMethod(name.Substring(4, name.Length - 4), thisVal, args)" + NL
    t = t + "    IF name.StartsWith(""Promise.part:"") OR name.StartsWith(""Bound:"") OR name.StartsWith(""ObjectS."") OR name.StartsWith(""ArrayS."") OR name.StartsWith(""NumberS."") OR name.StartsWith(""JSON."") OR name.StartsWith(""PromiseS."") OR name = ""Function.bind"" THEN RETURN JsLib(name, thisVal, args)" + NL
    t = t + "    IF name.StartsWith(""Promise."") OR name.StartsWith(""Response."") THEN RETURN JsPromiseMethod(name, thisVal, args)" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""alert""" + NL
    t = t + "            HostAlert(JsStr(a))" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""confirm""" + NL
    t = t + "            RETURN JsB(HostConfirm(JsStr(a)))" + NL
    t = t + "        CASE ""prompt""" + NL
    t = t + "            text = JsArg(args, 1)" + NL
    t = t + "            IF text = ""u"" THEN text = ""s""" + NL
    t = t + "            text = HostPrompt(JsStr(a), JsStr(text))" + NL
    t = t + "            IF text = Chr(0) THEN RETURN ""l""" + NL
    t = t + "            RETURN JsS(text)" + NL
    t = t + "        CASE ""parseInt""" + NL
    t = t + "            RETURN ""n"" + JsParseInt(JsStr(a), JsInt(JsArg(args, 1)))" + NL
    t = t + "        CASE ""parseFloat""" + NL
    t = t + "            RETURN ""n"" + JsParseFloat(JsStr(a))" + NL
    t = t + "        CASE ""isNaN""" + NL
    t = t + "            RETURN JsB(JsNum(a) = ""NaN"")" + NL
    t = t + "        CASE ""isFinite""" + NL
    t = t + "            RETURN JsB(JsFinite(JsNum(a)))" + NL
    t = t + "        CASE ""escape""" + NL
    t = t + "            RETURN JsS(JsEscape(JsStr(a)))" + NL
    t = t + "        CASE ""unescape""" + NL
    t = t + "            RETURN JsS(JsUnescape(JsStr(a)))" + NL
    t = t + "        CASE ""String""" + NL
    t = t + "            IF args.Count = 0 THEN RETURN ""s""" + NL
    t = t + "            RETURN JsS(JsStr(a))" + NL
    t = t + "        CASE ""Number""" + NL
    t = t + "            IF args.Count = 0 THEN RETURN ""n0""" + NL
    t = t + "            RETURN ""n"" + JsNum(a)" + NL
    t = t + "        CASE ""Boolean""" + NL
    t = t + "            RETURN JsB(JsBool(a))" + NL
    t = t + "        CASE ""Array"", ""Object"", ""Error"", ""XMLHttpRequest"", ""ActiveXObject"", ""TypeError"", ""RangeError"", ""SyntaxError"", ""ReferenceError""" + NL
    t = t + "            RETURN JsConstruct(name, args)" + NL
    t = t + "        CASE ""Promise""" + NL
    t = t + "            jsThrown = JsMakeTypedError(""TypeError"", ""Promise constructor cannot be invoked without 'new'"")" + NL
    t = t + "            THROW Str(jsLine) + ""|@thrown""" + NL
    t = t + "        CASE ""fetch""" + NL
    t = t + "            RETURN JsFetch(args)" + NL
    t = t + "        CASE ""All.item""" + NL
    t = t + "            IF HostHas(JsStr(a)) THEN RETURN JsElement(JsStr(a))" + NL
    t = t + "            RETURN ""l""" + NL
    t = t + "        CASE ""Date""" + NL
    t = t + "            RETURN JsS(JsDateText(JsNow()))" + NL
    t = t + "        CASE ""String.fromCharCode""" + NL
    t = t + "            FOR i = 0 TO args.Count - 1" + NL
    t = t + "                out = out + Chr(JsInt(args[i]))" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsS(out)" + NL
    t = t + "        CASE ""setTimeout"", ""setInterval""" + NL
    t = t + "            IF JsCallable(a) THEN" + NL
    t = t + "                RETURN JsN(HostTimeout("""", a, JsInt(JsArg(args, 1)), name = ""setInterval""))" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsN(HostTimeout(JsStr(a), """", JsInt(JsArg(args, 1)), name = ""setInterval""))" + NL
    t = t + "        CASE ""clearTimeout"", ""clearInterval""" + NL
    t = t + "            HostClearTimeout(JsInt(a))" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""open""" + NL
    t = t + "            HostOpen(JsStr(a))" + NL
    t = t + "            RETURN ""l""" + NL
    t = t + "        CASE ""document.write"", ""document.writeln""" + NL
    t = t + "            FOR i = 0 TO args.Count - 1" + NL
    t = t + "                jsOut = jsOut + JsStr(args[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF name = ""document.writeln"" THEN jsOut = jsOut + Chr(10)" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""document.getElementById""" + NL
    t = t + "            IF HostHas(JsStr(a)) THEN RETURN JsElement(JsStr(a))" + NL
    t = t + "            RETURN ""l""" + NL
    t = t + "        CASE ""history.back""" + NL
    t = t + "            HostHistory(-1)" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""history.forward""" + NL
    t = t + "            HostHistory(1)" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""history.go""" + NL
    t = t + "            HostHistory(JsInt(a))" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""location.reload""" + NL
    t = t + "            HostNavigate(HostInfo(""location""))" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""location.replace"", ""location.assign""" + NL
    t = t + "            HostNavigate(JsStr(a))" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""location.toString""" + NL
    t = t + "            RETURN JsS(HostInfo(""location""))" + NL
    t = t + "        CASE ""Form.submit""" + NL
    t = t + "            HostSubmit(joA[JsId(thisVal)])" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""navigator.javaEnabled"", ""Element.focus"", ""Element.blur"", ""Element.select"", ""Element.click"", ""noop""" + NL
    t = t + "            RETURN ""f""" + NL
    t = t + "        CASE ""Object.toString""" + NL
    t = t + "            IF thisVal.StartsWith(""o"") THEN RETURN JsS(JsStr(thisVal))" + NL
    t = t + "            RETURN JsS(JsStr(thisVal))" + NL
    t = t + "        CASE ""Object.hasOwnProperty""" + NL
    t = t + "            RETURN JsB(JsOwn(JsId(thisVal), JsStr(a)) >= 0)" + NL
    t = t + "        CASE ""Number.toString""" + NL
    t = t + "            n = JsInt(a)" + NL
    t = t + "            IF n < 2 OR n > 36 OR n = 10 THEN RETURN JsS(JsStr(thisVal))" + NL
    t = t + "            RETURN JsS(JsRadix(JsReal(thisVal), n))" + NL
    t = t + "        CASE ""Number.toFixed""" + NL
    t = t + "            RETURN JsS(JsFixed(JsReal(thisVal), JsInt(a)))" + NL
    t = t + "        CASE ""Function.call""" + NL
    t = t + "            FOR i = 1 TO args.Count - 1" + NL
    t = t + "                list.Add(args[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsCall(thisVal, JsThisArg(a), list)" + NL
    t = t + "        CASE ""Function.apply""" + NL
    t = t + "            IF JsArg(args, 1).StartsWith(""o"") THEN list = JsItems(JsId(args[1]))" + NL
    t = t + "            RETURN JsCall(thisVal, JsThisArg(a), list)" + NL
    t = t + "    END SELECT" + NL
    t = t + "    ' anything else is the host's own (Node's modules, say)" + NL
    t = t + "    RETURN HostNative(name, thisVal, args)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsThisArg (v AS String) AS String" + NL
    t = t + "    IF v = ""u"" OR v = ""l"" THEN RETURN JsO(jsGlobal)" + NL
    t = t + "    RETURN v" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsRadix (r AS Real, radix AS Integer) AS String" + NL
    t = t + "    VAR n AS Real" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR sign AS String" + NL
    t = t + "    n = Int(Abs(r))" + NL
    t = t + "    IF r < 0 THEN sign = ""-""" + NL
    t = t + "    IF n = 0 THEN RETURN ""0""" + NL
    t = t + "    WHILE n > 0" + NL
    t = t + "        out = ""0123456789abcdefghijklmnopqrstuvwxyz"".CharAt(Int(n - Int(n / radix) * radix)) + out" + NL
    t = t + "        n = Int(n / radix)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN sign + out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsFixed (r AS Real, digits AS Integer) AS String" + NL
    t = t + "    VAR scaled AS Real" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR sign AS String" + NL
    t = t + "    IF digits < 0 THEN digits = 0" + NL
    t = t + "    IF digits > 20 THEN digits = 20" + NL
    t = t + "    IF r < 0 THEN" + NL
    t = t + "        sign = ""-""" + NL
    t = t + "        r = -r" + NL
    t = t + "    END IF" + NL
    t = t + "    scaled = MATH.Round(r * 10 ^ digits)" + NL
    t = t + "    s = Str(Int(scaled))" + NL
    t = t + "    IF digits = 0 THEN RETURN sign + s" + NL
    t = t + "    WHILE s.Length <= digits" + NL
    t = t + "        s = ""0"" + s" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN sign + s.Substring(0, s.Length - digits) + ""."" + s.Substring(s.Length - digits, digits)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsParseInt (text AS String, radix AS Integer) AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR sign AS Integer = 1" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    VAR v AS Real" + NL
    t = t + "    VAR digits AS String" + NL
    t = t + "    VAR any AS Bool" + NL
    t = t + "    t = text.Trim().Lower()" + NL
    t = t + "    IF t.StartsWith(""-"") THEN" + NL
    t = t + "        sign = -1" + NL
    t = t + "        t = t.Substring(1, t.Length - 1)" + NL
    t = t + "    ELSEIF t.StartsWith(""+"") THEN" + NL
    t = t + "        t = t.Substring(1, t.Length - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF radix = 0 THEN" + NL
    t = t + "        radix = 10" + NL
    t = t + "        IF t.StartsWith(""0x"") THEN" + NL
    t = t + "            radix = 16" + NL
    t = t + "            t = t.Substring(2, t.Length - 2)" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSEIF radix = 16 AND t.StartsWith(""0x"") THEN" + NL
    t = t + "        t = t.Substring(2, t.Length - 2)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF radix < 2 OR radix > 36 THEN RETURN ""NaN""" + NL
    t = t + "    digits = ""0123456789abcdefghijklmnopqrstuvwxyz"".Substring(0, radix)" + NL
    t = t + "    FOR i = 0 TO t.Length - 1" + NL
    t = t + "        d = digits.IndexOf(t.CharAt(i))" + NL
    t = t + "        IF d < 0 THEN BREAK" + NL
    t = t + "        v = v * radix + d" + NL
    t = t + "        any = TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT any THEN RETURN ""NaN""" + NL
    t = t + "    RETURN JsFmt(sign * v)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsParseFloat (text AS String) AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR best AS String" + NL
    t = t + "    t = text.Trim()" + NL
    t = t + "    best = ""NaN""" + NL
    t = t + "    FOR i = 1 TO MATH.Min(t.Length, 40)" + NL
    t = t + "        IF JsParseNumber(t.Substring(0, i)) <> ""NaN"" AND NOT t.Substring(0, i).Lower().EndsWith(""e"") AND NOT t.Substring(0, i).EndsWith(""x"") THEN best = JsParseNumber(t.Substring(0, i))" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF t.StartsWith(""Infinity"") THEN RETURN ""Infinity""" + NL
    t = t + "    RETURN best" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsEscape (s AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        c = s.CharAt(i)" + NL
    t = t + "        IF ""ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@*_+-./"".Contains(c) THEN" + NL
    t = t + "            out = out + c" + NL
    t = t + "        ELSE" + NL
    t = t + "            out = out + ""%"" + Hex(Asc(c)).PadLeft(2).Replace("" "", ""0"")" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsUnescape (s AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    WHILE i < s.Length" + NL
    t = t + "        IF s.CharAt(i) = ""%"" AND i + 2 < s.Length + 0 AND OnlyChars(JsPeek(s, i + 1, 2).Lower(), ""0123456789abcdef"") AND JsPeek(s, i + 1, 2).Length = 2 THEN" + NL
    t = t + "            h = JsPeek(s, i + 1, 2).Lower()" + NL
    t = t + "            out = out + Chr(""0123456789abcdef"".IndexOf(h.CharAt(0)) * 16 + ""0123456789abcdef"".IndexOf(h.CharAt(1)))" + NL
    t = t + "            i = i + 3" + NL
    t = t + "        ELSE" + NL
    t = t + "            out = out + s.CharAt(i)" + NL
    t = t + "            i = i + 1" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsMath (name AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR x AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR best AS String" + NL
    t = t + "    x = JsNum(JsArg(args, 0))" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""random""" + NL
    t = t + "            RETURN JsN(Rnd())" + NL
    t = t + "        CASE ""max"", ""min""" + NL
    t = t + "            IF args.Count = 0 THEN" + NL
    t = t + "                IF name = ""max"" THEN RETURN ""n-Infinity""" + NL
    t = t + "                RETURN ""nInfinity""" + NL
    t = t + "            END IF" + NL
    t = t + "            best = ""n"" + JsNum(args[0])" + NL
    t = t + "            FOR i = 1 TO args.Count - 1" + NL
    t = t + "                IF JsNum(args[i]) = ""NaN"" THEN RETURN ""nNaN""" + NL
    t = t + "                IF name = ""max"" AND JsCompare("">"", ""n"" + JsNum(args[i]), best) = ""t"" THEN best = ""n"" + JsNum(args[i])" + NL
    t = t + "                IF name = ""min"" AND JsCompare(""<"", ""n"" + JsNum(args[i]), best) = ""t"" THEN best = ""n"" + JsNum(args[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN best" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF NOT JsFinite(x) THEN RETURN ""nNaN""" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""abs""" + NL
    t = t + "            RETURN JsN(Abs(Val(x)))" + NL
    t = t + "        CASE ""floor""" + NL
    t = t + "            RETURN JsN(MATH.Floor(Val(x)))" + NL
    t = t + "        CASE ""ceil""" + NL
    t = t + "            RETURN JsN(MATH.Ceil(Val(x)))" + NL
    t = t + "        CASE ""round""" + NL
    t = t + "            RETURN JsN(MATH.Floor(Val(x) + 0.5))" + NL
    t = t + "        CASE ""sqrt""" + NL
    t = t + "            IF Val(x) < 0 THEN RETURN ""nNaN""" + NL
    t = t + "            RETURN JsN(MATH.Sqrt(Val(x)))" + NL
    t = t + "        CASE ""pow""" + NL
    t = t + "            RETURN JsN(Val(x) ^ JsReal(JsArg(args, 1)))" + NL
    t = t + "        CASE ""sin""" + NL
    t = t + "            RETURN JsN(MATH.Sin(Val(x)))" + NL
    t = t + "        CASE ""cos""" + NL
    t = t + "            RETURN JsN(MATH.Cos(Val(x)))" + NL
    t = t + "        CASE ""tan""" + NL
    t = t + "            RETURN JsN(MATH.Tan(Val(x)))" + NL
    t = t + "        CASE ""atan""" + NL
    t = t + "            RETURN JsN(MATH.Atan(Val(x)))" + NL
    t = t + "        CASE ""exp""" + NL
    t = t + "            RETURN JsN(MATH.Exp(Val(x)))" + NL
    t = t + "        CASE ""log""" + NL
    t = t + "            IF Val(x) <= 0 THEN RETURN ""nNaN""" + NL
    t = t + "            RETURN JsN(MATH.Log(Val(x)))" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsStringMethod (name AS String, s AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR found AS Integer" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    a = JsArg(args, 0)" + NL
    t = t + "    n = s.Length" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""replace"", ""replaceAll""" + NL
    t = t + "            IF a.StartsWith(""o"") THEN" + NL
    t = t + "                jsThrown = JsMakeTypedError(""TypeError"", ""Regular expressions are not supported yet: give replace a string"")" + NL
    t = t + "                THROW Str(jsLine) + ""|@thrown""" + NL
    t = t + "            END IF" + NL
    t = t + "            t = JsStr(a)" + NL
    t = t + "            out.Clear()" + NL
    t = t + "            i = 0" + NL
    t = t + "            WHILE TRUE" + NL
    t = t + "                found = -1" + NL
    t = t + "                IF i <= n THEN found = s.Substring(i, n - i).IndexOf(t)" + NL
    t = t + "                IF found < 0 THEN BREAK" + NL
    t = t + "                found = found + i" + NL
    t = t + "                out.Add(JsS(s.Substring(i, found - i)))" + NL
    t = t + "                IF JsCallable(JsArg(args, 1)) THEN" + NL
    t = t + "                    parts.Clear()" + NL
    t = t + "                    parts.Add(JsS(t))" + NL
    t = t + "                    parts.Add(JsN(found))" + NL
    t = t + "                    parts.Add(JsS(s))" + NL
    t = t + "                    out.Add(JsS(JsStr(JsCall(args[1], JsO(jsGlobal), parts))))" + NL
    t = t + "                ELSE" + NL
    t = t + "                    out.Add(JsS(JsStr(JsArg(args, 1)).Replace(""$&"", t).Replace(""$$"", ""$"")))" + NL
    t = t + "                END IF" + NL
    t = t + "                i = found + MATH.Max(1, t.Length)" + NL
    t = t + "                IF t = """" THEN" + NL
    t = t + "                    IF found < n THEN out.Add(JsS(s.CharAt(found)))" + NL
    t = t + "                END IF" + NL
    t = t + "                IF name = ""replace"" OR i > n THEN BREAK" + NL
    t = t + "            END WHILE" + NL
    t = t + "            IF i <= n THEN out.Add(JsS(s.Substring(i, n - i)))" + NL
    t = t + "            t = """"" + NL
    t = t + "            FOR EACH a IN out" + NL
    t = t + "                t = t + a.Substring(1, a.Length - 1)" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsS(t)" + NL
    t = t + "        CASE ""startsWith""" + NL
    t = t + "            i = MATH.Max(0, JsInt(JsArg(args, 1)))" + NL
    t = t + "            t = JsStr(a)" + NL
    t = t + "            IF i + t.Length > n THEN RETURN ""f""" + NL
    t = t + "            RETURN JsB(s.Substring(i, t.Length) = t)" + NL
    t = t + "        CASE ""endsWith""" + NL
    t = t + "            i = n" + NL
    t = t + "            IF args.Count > 1 AND args[1] <> ""u"" THEN i = MATH.Min(n, JsInt(args[1]))" + NL
    t = t + "            t = JsStr(a)" + NL
    t = t + "            IF t.Length > i THEN RETURN ""f""" + NL
    t = t + "            RETURN JsB(s.Substring(i - t.Length, t.Length) = t)" + NL
    t = t + "        CASE ""includes""" + NL
    t = t + "            i = MATH.Max(0, JsInt(JsArg(args, 1)))" + NL
    t = t + "            IF i > n THEN RETURN ""f""" + NL
    t = t + "            RETURN JsB(s.Substring(i, n - i).Contains(JsStr(a)))" + NL
    t = t + "        CASE ""repeat""" + NL
    t = t + "            j = JsInt(a)" + NL
    t = t + "            IF j < 0 THEN" + NL
    t = t + "                jsThrown = JsMakeTypedError(""RangeError"", ""Invalid count value: "" + Str(j))" + NL
    t = t + "                THROW Str(jsLine) + ""|@thrown""" + NL
    t = t + "            END IF" + NL
    t = t + "            t = """"" + NL
    t = t + "            FOR i = 1 TO j" + NL
    t = t + "                t = t + s" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsS(t)" + NL
    t = t + "        CASE ""padStart"", ""padEnd""" + NL
    t = t + "            j = JsInt(a)" + NL
    t = t + "            t = "" """ + NL
    t = t + "            IF args.Count > 1 AND args[1] <> ""u"" THEN t = JsStr(args[1])" + NL
    t = t + "            IF j <= n OR t = """" THEN RETURN JsS(s)" + NL
    t = t + "            a = """"" + NL
    t = t + "            WHILE a.Length < j - n" + NL
    t = t + "                a = a + t" + NL
    t = t + "            END WHILE" + NL
    t = t + "            a = a.Substring(0, j - n)" + NL
    t = t + "            IF name = ""padStart"" THEN RETURN JsS(a + s)" + NL
    t = t + "            RETURN JsS(s + a)" + NL
    t = t + "        CASE ""trimStart"", ""trimLeft""" + NL
    t = t + "            i = 0" + NL
    t = t + "            WHILE i < n AND ("" "" + Chr(9) + Chr(10) + Chr(13)).Contains(s.CharAt(i))" + NL
    t = t + "                i = i + 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "            RETURN JsS(s.Substring(i, n - i))" + NL
    t = t + "        CASE ""trimEnd"", ""trimRight""" + NL
    t = t + "            i = n" + NL
    t = t + "            WHILE i > 0 AND ("" "" + Chr(9) + Chr(10) + Chr(13)).Contains(s.CharAt(i - 1))" + NL
    t = t + "                i = i - 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "            RETURN JsS(s.Substring(0, i))" + NL
    t = t + "        CASE ""charAt""" + NL
    t = t + "            i = JsInt(a)" + NL
    t = t + "            IF i < 0 OR i >= n THEN RETURN ""s""" + NL
    t = t + "            RETURN JsS(s.CharAt(i))" + NL
    t = t + "        CASE ""charCodeAt""" + NL
    t = t + "            i = JsInt(a)" + NL
    t = t + "            IF i < 0 OR i >= n THEN RETURN ""nNaN""" + NL
    t = t + "            RETURN JsN(Asc(s.CharAt(i)))" + NL
    t = t + "        CASE ""indexOf""" + NL
    t = t + "            i = MATH.Max(0, JsInt(JsArg(args, 1)))" + NL
    t = t + "            IF i > n THEN RETURN ""n-1""" + NL
    t = t + "            found = s.Substring(i, n - i).IndexOf(JsStr(a))" + NL
    t = t + "            IF found < 0 THEN RETURN ""n-1""" + NL
    t = t + "            RETURN JsN(found + i)" + NL
    t = t + "        CASE ""lastIndexOf""" + NL
    t = t + "            t = JsStr(a)" + NL
    t = t + "            found = -1" + NL
    t = t + "            FOR i = n - t.Length TO 0 STEP -1" + NL
    t = t + "                IF s.Substring(i, t.Length) = t THEN" + NL
    t = t + "                    found = i" + NL
    t = t + "                    BREAK" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsN(found)" + NL
    t = t + "        CASE ""substring""" + NL
    t = t + "            i = MATH.Min(MATH.Max(JsInt(a), 0), n)" + NL
    t = t + "            j = n" + NL
    t = t + "            IF JsArg(args, 1) <> ""u"" THEN j = MATH.Min(MATH.Max(JsInt(args[1]), 0), n)" + NL
    t = t + "            IF i > j THEN" + NL
    t = t + "                found = i" + NL
    t = t + "                i = j" + NL
    t = t + "                j = found" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsS(s.Substring(i, j - i))" + NL
    t = t + "        CASE ""substr""" + NL
    t = t + "            i = JsInt(a)" + NL
    t = t + "            IF i < 0 THEN i = MATH.Max(0, n + i)" + NL
    t = t + "            IF i > n THEN i = n" + NL
    t = t + "            j = n - i" + NL
    t = t + "            IF JsArg(args, 1) <> ""u"" THEN j = MATH.Min(MATH.Max(JsInt(args[1]), 0), n - i)" + NL
    t = t + "            RETURN JsS(s.Substring(i, j))" + NL
    t = t + "        CASE ""slice""" + NL
    t = t + "            i = JsInt(a)" + NL
    t = t + "            IF i < 0 THEN i = MATH.Max(0, n + i)" + NL
    t = t + "            j = n" + NL
    t = t + "            IF JsArg(args, 1) <> ""u"" THEN j = JsInt(args[1])" + NL
    t = t + "            IF j < 0 THEN j = MATH.Max(0, n + j)" + NL
    t = t + "            i = MATH.Min(i, n)" + NL
    t = t + "            j = MATH.Min(j, n)" + NL
    t = t + "            IF j <= i THEN RETURN ""s""" + NL
    t = t + "            RETURN JsS(s.Substring(i, j - i))" + NL
    t = t + "        CASE ""toUpperCase"", ""toLocaleUpperCase""" + NL
    t = t + "            RETURN JsS(s.Upper())" + NL
    t = t + "        CASE ""toLowerCase"", ""toLocaleLowerCase""" + NL
    t = t + "            RETURN JsS(s.Lower())" + NL
    t = t + "        CASE ""trim""" + NL
    t = t + "            RETURN JsS(s.Trim())" + NL
    t = t + "        CASE ""split""" + NL
    t = t + "            IF a = ""u"" THEN" + NL
    t = t + "                out.Add(JsS(s))" + NL
    t = t + "            ELSEIF JsStr(a) = """" THEN" + NL
    t = t + "                FOR i = 0 TO n - 1" + NL
    t = t + "                    out.Add(JsS(s.CharAt(i)))" + NL
    t = t + "                NEXT" + NL
    t = t + "            ELSE" + NL
    t = t + "                FOR EACH t IN s.Split(JsStr(a))" + NL
    t = t + "                    out.Add(JsS(t))" + NL
    t = t + "                NEXT" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsO(JsNewArray(out))" + NL
    t = t + "        CASE ""concat""" + NL
    t = t + "            t = s" + NL
    t = t + "            FOR i = 0 TO args.Count - 1" + NL
    t = t + "                t = t + JsStr(args[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsS(t)" + NL
    t = t + "        CASE ""toString"", ""valueOf""" + NL
    t = t + "            RETURN JsS(s)" + NL
    t = t + "        CASE ""bold""" + NL
    t = t + "            RETURN JsS(""<B>"" + s + ""</B>"")" + NL
    t = t + "        CASE ""italics""" + NL
    t = t + "            RETURN JsS(""<I>"" + s + ""</I>"")" + NL
    t = t + "        CASE ""fixed""" + NL
    t = t + "            RETURN JsS(""<TT>"" + s + ""</TT>"")" + NL
    t = t + "        CASE ""big""" + NL
    t = t + "            RETURN JsS(""<BIG>"" + s + ""</BIG>"")" + NL
    t = t + "        CASE ""small""" + NL
    t = t + "            RETURN JsS(""<SMALL>"" + s + ""</SMALL>"")" + NL
    t = t + "        CASE ""blink""" + NL
    t = t + "            RETURN JsS(""<BLINK>"" + s + ""</BLINK>"")" + NL
    t = t + "        CASE ""strike""" + NL
    t = t + "            RETURN JsS(""<STRIKE>"" + s + ""</STRIKE>"")" + NL
    t = t + "        CASE ""sub""" + NL
    t = t + "            RETURN JsS(""<SUB>"" + s + ""</SUB>"")" + NL
    t = t + "        CASE ""sup""" + NL
    t = t + "            RETURN JsS(""<SUP>"" + s + ""</SUP>"")" + NL
    t = t + "        CASE ""fontcolor""" + NL
    t = t + "            RETURN JsS(""<FONT COLOR="""""" + JsStr(a) + """""">"" + s + ""</FONT>"")" + NL
    t = t + "        CASE ""fontsize""" + NL
    t = t + "            RETURN JsS(""<FONT SIZE="""""" + JsStr(a) + """""">"" + s + ""</FONT>"")" + NL
    t = t + "        CASE ""anchor""" + NL
    t = t + "            RETURN JsS(""<A NAME="""""" + JsStr(a) + """""">"" + s + ""</A>"")" + NL
    t = t + "        CASE ""link""" + NL
    t = t + "            RETURN JsS(""<A HREF="""""" + JsStr(a) + """""">"" + s + ""</A>"")" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsArrayMethod (name AS String, id AS Integer, args AS Array OF String) AS String" + NL
    t = t + "    VAR fn AS String" + NL
    t = t + "    VAR self AS String" + NL
    t = t + "    VAR r AS String" + NL
    t = t + "    VAR acc AS String" + NL
    t = t + "    VAR cb AS Array OF String" + NL
    t = t + "    VAR items AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR keys AS Array OF String" + NL
    t = t + "    VAR tmp AS String" + NL
    t = t + "    VAR pair AS Array OF String" + NL
    t = t + "    IF id = 0 OR joClass[id] <> ""Array"" THEN THROW Str(jsLine) + ""|Array object expected""" + NL
    t = t + "    items = JsItems(id)" + NL
    t = t + "    n = items.Count" + NL
    t = t + "    IF ""|forEach|map|filter|some|every|find|findIndex|"".Contains(""|"" + name + ""|"") THEN" + NL
    t = t + "        fn = JsNeedFn(JsArg(args, 0), ""callback"")" + NL
    t = t + "        self = JsThisArg(JsArg(args, 1))" + NL
    t = t + "        FOR i = 0 TO n - 1" + NL
    t = t + "            r = JsCall(fn, self, JsArgs3(items[i], JsN(i), JsO(id)))" + NL
    t = t + "            SELECT CASE name" + NL
    t = t + "                CASE ""map""" + NL
    t = t + "                    out.Add(r)" + NL
    t = t + "                CASE ""filter""" + NL
    t = t + "                    IF JsBool(r) THEN out.Add(items[i])" + NL
    t = t + "                CASE ""some""" + NL
    t = t + "                    IF JsBool(r) THEN RETURN ""t""" + NL
    t = t + "                CASE ""every""" + NL
    t = t + "                    IF NOT JsBool(r) THEN RETURN ""f""" + NL
    t = t + "                CASE ""find""" + NL
    t = t + "                    IF JsBool(r) THEN RETURN items[i]" + NL
    t = t + "                CASE ""findIndex""" + NL
    t = t + "                    IF JsBool(r) THEN RETURN JsN(i)" + NL
    t = t + "            END SELECT" + NL
    t = t + "        NEXT" + NL
    t = t + "        SELECT CASE name" + NL
    t = t + "            CASE ""map"", ""filter""" + NL
    t = t + "                RETURN JsO(JsNewArray(out))" + NL
    t = t + "            CASE ""some""" + NL
    t = t + "                RETURN ""f""" + NL
    t = t + "            CASE ""every""" + NL
    t = t + "                RETURN ""t""" + NL
    t = t + "            CASE ""findIndex""" + NL
    t = t + "                RETURN ""n-1""" + NL
    t = t + "        END SELECT" + NL
    t = t + "        RETURN ""u""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF name = ""reduce"" OR name = ""reduceRight"" THEN" + NL
    t = t + "        fn = JsNeedFn(JsArg(args, 0), ""callback"")" + NL
    t = t + "        IF name = ""reduceRight"" THEN items.Reverse()" + NL
    t = t + "        k = 0" + NL
    t = t + "        IF args.Count > 1 THEN" + NL
    t = t + "            acc = args[1]" + NL
    t = t + "        ELSE" + NL
    t = t + "            IF n = 0 THEN" + NL
    t = t + "                jsThrown = JsMakeTypedError(""TypeError"", ""Reduce of empty array with no initial value"")" + NL
    t = t + "                THROW Str(jsLine) + ""|@thrown""" + NL
    t = t + "            END IF" + NL
    t = t + "            acc = items[0]" + NL
    t = t + "            k = 1" + NL
    t = t + "        END IF" + NL
    t = t + "        FOR i = k TO n - 1" + NL
    t = t + "            cb.Clear()" + NL
    t = t + "            cb.Add(acc)" + NL
    t = t + "            cb.Add(items[i])" + NL
    t = t + "            IF name = ""reduceRight"" THEN" + NL
    t = t + "                cb.Add(JsN(n - 1 - i))" + NL
    t = t + "            ELSE" + NL
    t = t + "                cb.Add(JsN(i))" + NL
    t = t + "            END IF" + NL
    t = t + "            cb.Add(JsO(id))" + NL
    t = t + "            acc = JsCall(fn, JsO(jsGlobal), cb)" + NL
    t = t + "        NEXT" + NL
    t = t + "        RETURN acc" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""includes""" + NL
    t = t + "            v = JsArg(args, 0)" + NL
    t = t + "            FOR i = 0 TO n - 1" + NL
    t = t + "                IF JsStrictEq(items[i], v) THEN RETURN ""t""" + NL
    t = t + "                IF v.StartsWith(""n"") AND items[i].StartsWith(""n"") AND JsNum(v) = ""NaN"" AND JsNum(items[i]) = ""NaN"" THEN RETURN ""t""" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN ""f""" + NL
    t = t + "        CASE ""lastIndexOf""" + NL
    t = t + "            FOR i = n - 1 TO 0 STEP -1" + NL
    t = t + "                IF JsStrictEq(items[i], JsArg(args, 0)) THEN RETURN JsN(i)" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN ""n-1""" + NL
    t = t + "        CASE ""fill""" + NL
    t = t + "            j = 0" + NL
    t = t + "            IF args.Count > 1 THEN j = JsInt(args[1])" + NL
    t = t + "            IF j < 0 THEN j = MATH.Max(0, n + j)" + NL
    t = t + "            k = n" + NL
    t = t + "            IF args.Count > 2 AND args[2] <> ""u"" THEN k = JsInt(args[2])" + NL
    t = t + "            IF k < 0 THEN k = MATH.Max(0, n + k)" + NL
    t = t + "            FOR i = j TO MATH.Min(k, n) - 1" + NL
    t = t + "                JsPutOwn(id, Str(i), JsArg(args, 0))" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsO(id)" + NL
    t = t + "    END SELECT" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""join""" + NL
    t = t + "            IF JsArg(args, 0) = ""u"" THEN RETURN JsS(JsJoin(id, "",""))" + NL
    t = t + "            RETURN JsS(JsJoin(id, JsStr(args[0])))" + NL
    t = t + "        CASE ""toString""" + NL
    t = t + "            RETURN JsS(JsJoin(id, "",""))" + NL
    t = t + "        CASE ""push""" + NL
    t = t + "            FOR i = 0 TO args.Count - 1" + NL
    t = t + "                JsPutOwn(id, Str(n + i), args[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            JsPutOwn(id, ""length"", JsN(n + args.Count))" + NL
    t = t + "            RETURN JsN(n + args.Count)" + NL
    t = t + "        CASE ""pop""" + NL
    t = t + "            IF n = 0 THEN RETURN ""u""" + NL
    t = t + "            v = items[n - 1]" + NL
    t = t + "            JsSetLength(id, n - 1)" + NL
    t = t + "            RETURN v" + NL
    t = t + "        CASE ""shift""" + NL
    t = t + "            IF n = 0 THEN RETURN ""u""" + NL
    t = t + "            v = items[0]" + NL
    t = t + "            FOR i = 1 TO n - 1" + NL
    t = t + "                JsPutOwn(id, Str(i - 1), items[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            JsSetLength(id, n - 1)" + NL
    t = t + "            RETURN v" + NL
    t = t + "        CASE ""unshift""" + NL
    t = t + "            FOR i = 0 TO args.Count - 1" + NL
    t = t + "                out.Add(args[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            FOR EACH v IN items" + NL
    t = t + "                out.Add(v)" + NL
    t = t + "            NEXT" + NL
    t = t + "            FOR i = 0 TO out.Count - 1" + NL
    t = t + "                JsPutOwn(id, Str(i), out[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            JsPutOwn(id, ""length"", JsN(out.Count))" + NL
    t = t + "            RETURN JsN(out.Count)" + NL
    t = t + "        CASE ""reverse""" + NL
    t = t + "            FOR i = 0 TO n - 1" + NL
    t = t + "                JsPutOwn(id, Str(i), items[n - 1 - i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsO(id)" + NL
    t = t + "        CASE ""concat""" + NL
    t = t + "            FOR EACH v IN items" + NL
    t = t + "                out.Add(v)" + NL
    t = t + "            NEXT" + NL
    t = t + "            FOR i = 0 TO args.Count - 1" + NL
    t = t + "                IF args[i].StartsWith(""o"") AND joClass[JsId(args[i])] = ""Array"" THEN" + NL
    t = t + "                    FOR EACH v IN JsItems(JsId(args[i]))" + NL
    t = t + "                        out.Add(v)" + NL
    t = t + "                    NEXT" + NL
    t = t + "                ELSE" + NL
    t = t + "                    out.Add(args[i])" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsO(JsNewArray(out))" + NL
    t = t + "        CASE ""slice""" + NL
    t = t + "            i = JsInt(JsArg(args, 0))" + NL
    t = t + "            IF i < 0 THEN i = MATH.Max(0, n + i)" + NL
    t = t + "            j = n" + NL
    t = t + "            IF JsArg(args, 1) <> ""u"" THEN j = JsInt(args[1])" + NL
    t = t + "            IF j < 0 THEN j = MATH.Max(0, n + j)" + NL
    t = t + "            FOR k = i TO MATH.Min(j, n) - 1" + NL
    t = t + "                out.Add(items[k])" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsO(JsNewArray(out))" + NL
    t = t + "        CASE ""splice""" + NL
    t = t + "            i = JsInt(JsArg(args, 0))" + NL
    t = t + "            IF i < 0 THEN i = MATH.Max(0, n + i)" + NL
    t = t + "            IF i > n THEN i = n" + NL
    t = t + "            k = n - i" + NL
    t = t + "            IF args.Count > 1 THEN k = MATH.Max(0, MATH.Min(JsInt(args[1]), n - i))" + NL
    t = t + "            FOR j = i TO i + k - 1" + NL
    t = t + "                out.Add(items[j])" + NL
    t = t + "            NEXT" + NL
    t = t + "            FOR j = 0 TO i - 1" + NL
    t = t + "                keys.Add(items[j])" + NL
    t = t + "            NEXT" + NL
    t = t + "            FOR j = 2 TO args.Count - 1" + NL
    t = t + "                keys.Add(args[j])" + NL
    t = t + "            NEXT" + NL
    t = t + "            FOR j = i + k TO n - 1" + NL
    t = t + "                keys.Add(items[j])" + NL
    t = t + "            NEXT" + NL
    t = t + "            FOR j = 0 TO keys.Count - 1" + NL
    t = t + "                JsPutOwn(id, Str(j), keys[j])" + NL
    t = t + "            NEXT" + NL
    t = t + "            JsSetLength(id, keys.Count)" + NL
    t = t + "            RETURN JsO(JsNewArray(out))" + NL
    t = t + "        CASE ""indexOf""" + NL
    t = t + "            FOR i = 0 TO n - 1" + NL
    t = t + "                IF JsStrictEq(items[i], JsArg(args, 0)) THEN RETURN JsN(i)" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN ""n-1""" + NL
    t = t + "        CASE ""sort""" + NL
    t = t + "            IF JsCallable(JsArg(args, 0)) THEN" + NL
    t = t + "                ' insertion sort with the page's own comparison" + NL
    t = t + "                FOR i = 1 TO n - 1" + NL
    t = t + "                    v = items[i]" + NL
    t = t + "                    j = i - 1" + NL
    t = t + "                    WHILE j >= 0" + NL
    t = t + "                        pair.Clear()" + NL
    t = t + "                        pair.Add(items[j])" + NL
    t = t + "                        pair.Add(v)" + NL
    t = t + "                        IF JsReal(JsCall(args[0], JsO(jsGlobal), pair)) <= 0 THEN BREAK" + NL
    t = t + "                        items[j + 1] = items[j]" + NL
    t = t + "                        j = j - 1" + NL
    t = t + "                    END WHILE" + NL
    t = t + "                    items[j + 1] = v" + NL
    t = t + "                NEXT" + NL
    t = t + "            ELSE" + NL
    t = t + "                ' as text: sort ""text<tab>index"" and read the order back" + NL
    t = t + "                FOR i = 0 TO n - 1" + NL
    t = t + "                    IF items[i] = ""u"" THEN" + NL
    t = t + "                        keys.Add(Chr(65535) + Chr(9) + Str(i))" + NL
    t = t + "                    ELSE" + NL
    t = t + "                        keys.Add(JsStr(items[i]) + Chr(9) + Str(i))" + NL
    t = t + "                    END IF" + NL
    t = t + "                NEXT" + NL
    t = t + "                keys.Sort()" + NL
    t = t + "                FOR EACH tmp IN keys" + NL
    t = t + "                    out.Add(items[Int(Val(tmp.Split(Chr(9))[tmp.Split(Chr(9)).Count - 1]))])" + NL
    t = t + "                NEXT" + NL
    t = t + "                items = out" + NL
    t = t + "            END IF" + NL
    t = t + "            FOR i = 0 TO n - 1" + NL
    t = t + "                JsPutOwn(id, Str(i), items[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsO(id)" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsDateMethod (name AS String, thisVal AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR ms AS Real" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR y AS Real" + NL
    t = t + "    VAR mon AS Real" + NL
    t = t + "    VAR d AS Real" + NL
    t = t + "    VAR h AS Real" + NL
    t = t + "    VAR mi AS Real" + NL
    t = t + "    VAR sec AS Real" + NL
    t = t + "    VAR part AS Real" + NL
    t = t + "    id = JsId(thisVal)" + NL
    t = t + "    IF id = 0 OR joClass[id] <> ""Date"" THEN THROW Str(jsLine) + ""|Date object expected""" + NL
    t = t + "    IF joS[id] = ""NaN"" THEN RETURN ""nNaN""" + NL
    t = t + "    ms = Val(joS[id])" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""getTime"", ""valueOf""" + NL
    t = t + "            RETURN JsN(ms)" + NL
    t = t + "        CASE ""getFullYear""" + NL
    t = t + "            RETURN JsN(JsDatePart(ms, ""year""))" + NL
    t = t + "        CASE ""getYear""" + NL
    t = t + "            ' the famous quirk of 1996 browsers: 96 for 1996, but 2001 for 2001" + NL
    t = t + "            IF JsDatePart(ms, ""year"") >= 1900 AND JsDatePart(ms, ""year"") < 2000 THEN RETURN JsN(JsDatePart(ms, ""year"") - 1900)" + NL
    t = t + "            RETURN JsN(JsDatePart(ms, ""year""))" + NL
    t = t + "        CASE ""getMonth""" + NL
    t = t + "            RETURN JsN(JsDatePart(ms, ""month""))" + NL
    t = t + "        CASE ""getDate""" + NL
    t = t + "            RETURN JsN(JsDatePart(ms, ""date""))" + NL
    t = t + "        CASE ""getDay""" + NL
    t = t + "            RETURN JsN(JsDatePart(ms, ""day""))" + NL
    t = t + "        CASE ""getHours""" + NL
    t = t + "            RETURN JsN(JsDatePart(ms, ""hours""))" + NL
    t = t + "        CASE ""getMinutes""" + NL
    t = t + "            RETURN JsN(JsDatePart(ms, ""minutes""))" + NL
    t = t + "        CASE ""getSeconds""" + NL
    t = t + "            RETURN JsN(JsDatePart(ms, ""seconds""))" + NL
    t = t + "        CASE ""getMilliseconds""" + NL
    t = t + "            RETURN JsN(JsDatePart(ms, ""ms""))" + NL
    t = t + "        CASE ""getTimezoneOffset""" + NL
    t = t + "            RETURN JsN(-JsZone() / 60)" + NL
    t = t + "        CASE ""toString"", ""toLocaleString"", ""toGMTString"", ""toUTCString""" + NL
    t = t + "            RETURN JsS(JsDateText(ms))" + NL
    t = t + "        CASE ""setTime""" + NL
    t = t + "            joS[id] = JsNum(JsArg(args, 0))" + NL
    t = t + "            RETURN ""n"" + joS[id]" + NL
    t = t + "        CASE ""setFullYear"", ""setYear"", ""setMonth"", ""setDate"", ""setHours"", ""setMinutes"", ""setSeconds"", ""setMilliseconds""" + NL
    t = t + "            y = JsDatePart(ms, ""year"")" + NL
    t = t + "            mon = JsDatePart(ms, ""month"")" + NL
    t = t + "            d = JsDatePart(ms, ""date"")" + NL
    t = t + "            h = JsDatePart(ms, ""hours"")" + NL
    t = t + "            mi = JsDatePart(ms, ""minutes"")" + NL
    t = t + "            sec = JsDatePart(ms, ""seconds"")" + NL
    t = t + "            part = JsDatePart(ms, ""ms"")" + NL
    t = t + "            IF NOT JsFinite(JsNum(JsArg(args, 0))) THEN" + NL
    t = t + "                joS[id] = ""NaN""" + NL
    t = t + "                RETURN ""nNaN""" + NL
    t = t + "            END IF" + NL
    t = t + "            SELECT CASE name" + NL
    t = t + "                CASE ""setFullYear"", ""setYear""" + NL
    t = t + "                    y = JsReal(args[0])" + NL
    t = t + "                    IF name = ""setYear"" AND y >= 0 AND y < 100 THEN y = y + 1900" + NL
    t = t + "                CASE ""setMonth""" + NL
    t = t + "                    mon = JsReal(args[0])" + NL
    t = t + "                CASE ""setDate""" + NL
    t = t + "                    d = JsReal(args[0])" + NL
    t = t + "                CASE ""setHours""" + NL
    t = t + "                    h = JsReal(args[0])" + NL
    t = t + "                CASE ""setMinutes""" + NL
    t = t + "                    mi = JsReal(args[0])" + NL
    t = t + "                CASE ""setSeconds""" + NL
    t = t + "                    sec = JsReal(args[0])" + NL
    t = t + "                CASE ""setMilliseconds""" + NL
    t = t + "                    part = JsReal(args[0])" + NL
    t = t + "            END SELECT" + NL
    t = t + "            joS[id] = JsFmt(JsLocalMs(y, mon, d, h, mi, sec, part))" + NL
    t = t + "            RETURN ""n"" + joS[id]" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- XMLHttpRequest" + NL
    t = t + "'" + NL
    t = t + "' An XMLHttpRequest is an object of class XHR. Besides what the page sees" + NL
    t = t + "' (readyState, status, statusText, responseText, the handlers) it keeps" + NL
    t = t + "' hidden properties: @method, @url, @headers (one ""Name: value"" a line) and" + NL
    t = t + "' @rheaders for the response's, and @req, the browser's number for the" + NL
    t = t + "' request on its way (0 when there is none). fetch() makes one too, with" + NL
    t = t + "' @promise, the promise it answers." + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNewXhr () AS Integer" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    id = JsNewObject(""XHR"", jsXhrProto)" + NL
    t = t + "    JsPutOwn(id, ""readyState"", ""n0"")" + NL
    t = t + "    JsPutOwn(id, ""status"", ""n0"")" + NL
    t = t + "    JsPutOwn(id, ""statusText"", ""s"")" + NL
    t = t + "    JsPutOwn(id, ""responseText"", ""s"")" + NL
    t = t + "    JsPutOwn(id, ""responseXML"", ""l"")" + NL
    t = t + "    JsPutOwn(id, ""onreadystatechange"", ""l"")" + NL
    t = t + "    JsPutOwn(id, ""onload"", ""l"")" + NL
    t = t + "    JsPutOwn(id, ""onerror"", ""l"")" + NL
    t = t + "    JsPutOwn(id, ""@req"", ""n0"")" + NL
    t = t + "    JsPutOwn(id, ""@headers"", ""s"")" + NL
    t = t + "    JsPutOwn(id, ""@rheaders"", ""s"")" + NL
    t = t + "    RETURN id" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' readyState becomes state, and onreadystatechange hears of it." + NL
    t = t + "SUB JsXhrState (id AS Integer, state AS Integer)" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    VAR fn AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    JsPutOwn(id, ""readyState"", JsN(state))" + NL
    t = t + "    fn = JsGetProp(id, ""onreadystatechange"")" + NL
    t = t + "    IF JsCallable(fn) THEN v = JsCall(fn, JsO(id), none)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsXhrMethod (name AS String, thisVal AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR body AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR want AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    id = JsId(thisVal)" + NL
    t = t + "    IF id = 0 OR joClass[id] <> ""XHR"" THEN THROW Str(jsLine) + ""|Object expected""" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""open""" + NL
    t = t + "            ' A script cannot stop and wait for the network: the browser fetches" + NL
    t = t + "            ' between scripts, a tick at a time" + NL
    t = t + "            IF args.Count > 2 THEN" + NL
    t = t + "                IF args[2] <> ""u"" AND NOT JsBool(args[2]) THEN THROW Str(jsLine) + ""|Simxplorer cannot wait for the network in the middle of a script. Use open(method, url, true) and onreadystatechange""" + NL
    t = t + "            END IF" + NL
    t = t + "            IF JsInt(JsGetProp(id, ""@req"")) > 0 THEN HostXhrAbort(JsInt(JsGetProp(id, ""@req"")))" + NL
    t = t + "            JsPutOwn(id, ""@method"", JsS(JsStr(JsArg(args, 0)).Upper()))" + NL
    t = t + "            JsPutOwn(id, ""@url"", JsS(JsStr(JsArg(args, 1))))" + NL
    t = t + "            JsPutOwn(id, ""@headers"", ""s"")" + NL
    t = t + "            JsPutOwn(id, ""@rheaders"", ""s"")" + NL
    t = t + "            JsPutOwn(id, ""@req"", ""n0"")" + NL
    t = t + "            JsPutOwn(id, ""status"", ""n0"")" + NL
    t = t + "            JsPutOwn(id, ""statusText"", ""s"")" + NL
    t = t + "            JsPutOwn(id, ""responseText"", ""s"")" + NL
    t = t + "            JsXhrState(id, 1)" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""setRequestHeader""" + NL
    t = t + "            IF JsInt(JsGetProp(id, ""readyState"")) <> 1 OR JsInt(JsGetProp(id, ""@req"")) <> 0 THEN THROW Str(jsLine) + ""|Unspecified error""" + NL
    t = t + "            line = JsStr(JsArg(args, 0)).Replace(Chr(10), """").Replace(Chr(13), """") + "": "" + JsStr(JsArg(args, 1)).Replace(Chr(10), "" "").Replace(Chr(13), """")" + NL
    t = t + "            JsPutOwn(id, ""@headers"", JsS(JsStr(JsGetProp(id, ""@headers"")) + line + Chr(10)))" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""send""" + NL
    t = t + "            IF JsInt(JsGetProp(id, ""readyState"")) <> 1 OR JsInt(JsGetProp(id, ""@req"")) <> 0 THEN THROW Str(jsLine) + ""|Unspecified error""" + NL
    t = t + "            IF args.Count > 0 THEN" + NL
    t = t + "                IF args[0] <> ""u"" AND args[0] <> ""l"" THEN body = JsStr(args[0])" + NL
    t = t + "            END IF" + NL
    t = t + "            JsPutOwn(id, ""@req"", JsN(HostXhrSend(JsStr(JsGetProp(id, ""@method"")), JsStr(JsGetProp(id, ""@url"")), JsStr(JsGetProp(id, ""@headers"")), body, id)))" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""abort""" + NL
    t = t + "            IF JsInt(JsGetProp(id, ""@req"")) > 0 THEN HostXhrAbort(JsInt(JsGetProp(id, ""@req"")))" + NL
    t = t + "            JsPutOwn(id, ""@req"", ""n0"")" + NL
    t = t + "            JsPutOwn(id, ""readyState"", ""n0"")" + NL
    t = t + "            JsPutOwn(id, ""status"", ""n0"")" + NL
    t = t + "            JsPutOwn(id, ""responseText"", ""s"")" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        CASE ""getResponseHeader""" + NL
    t = t + "            want = JsStr(JsArg(args, 0)).Lower().Trim() + "":""" + NL
    t = t + "            FOR EACH line IN JsStr(JsGetProp(id, ""@rheaders"")).Split(Chr(10))" + NL
    t = t + "                IF line.Lower().StartsWith(want) THEN RETURN JsS(line.Substring(want.Length, line.Length - want.Length).Trim())" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN ""l""" + NL
    t = t + "        CASE ""getAllResponseHeaders""" + NL
    t = t + "            FOR EACH line IN JsStr(JsGetProp(id, ""@rheaders"")).Split(Chr(10))" + NL
    t = t + "                IF line <> """" THEN out.Add(line)" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF out.Count = 0 THEN RETURN ""s""" + NL
    t = t + "            RETURN JsS(out.Join(Chr(13) + Chr(10)) + Chr(13) + Chr(10))" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The browser's news of request req, which XMLHttpRequest id made: readyState" + NL
    t = t + "' 2, 3 or 4 (at 4, status 0 means it failed). Runs the page's handlers, and" + NL
    t = t + "' settles fetch()'s promise. Returns """" or an error (""line|message"")." + NL
    t = t + "FUNCTION JsXhrUpdate (id AS Integer, req AS Integer, state AS Integer, status AS Integer, statusText AS String, headers AS String, body AS String) AS String" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    VAR fn AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    jsDepth = 0" + NL
    t = t + "    jsSteps = 0" + NL
    t = t + "    jsLimit = JSSTEPLIMIT" + NL
    t = t + "    jsThrown = """"" + NL
    t = t + "    IF id <= 0 OR id >= joClass.Count THEN RETURN """"" + NL
    t = t + "    IF joClass[id] <> ""XHR"" THEN RETURN """"" + NL
    t = t + "    ' aborted, or opened again since" + NL
    t = t + "    IF JsInt(JsGetProp(id, ""@req"")) <> req THEN RETURN """"" + NL
    t = t + "    TRY" + NL
    t = t + "        JsPutOwn(id, ""status"", JsN(status))" + NL
    t = t + "        JsPutOwn(id, ""statusText"", JsS(statusText))" + NL
    t = t + "        JsPutOwn(id, ""@rheaders"", JsS(headers))" + NL
    t = t + "        JsPutOwn(id, ""responseText"", JsS(body))" + NL
    t = t + "        IF state = 4 THEN JsPutOwn(id, ""@req"", ""n0"")" + NL
    t = t + "        JsXhrState(id, state)" + NL
    t = t + "        IF state = 4 THEN" + NL
    t = t + "            IF JsGetProp(id, ""@promise"").StartsWith(""o"") THEN JsFetched(id, JsId(JsGetProp(id, ""@promise"")), status, statusText, body)" + NL
    t = t + "            IF status = 0 THEN" + NL
    t = t + "                fn = JsGetProp(id, ""onerror"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                fn = JsGetProp(id, ""onload"")" + NL
    t = t + "            END IF" + NL
    t = t + "            IF JsCallable(fn) THEN v = JsCall(fn, JsO(id), none)" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "        RETURN JsTidyError(err)" + NL
    t = t + "    END TRY" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' fetch(url[, {method, body, headers}]): a promise of a response." + NL
    t = t + "FUNCTION JsFetch (args AS Array OF String) AS String" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    VAR p AS Integer" + NL
    t = t + "    VAR init AS String" + NL
    t = t + "    VAR method AS String" + NL
    t = t + "    VAR body AS String" + NL
    t = t + "    VAR headers AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    method = ""GET""" + NL
    t = t + "    init = JsArg(args, 1)" + NL
    t = t + "    IF init.StartsWith(""o"") THEN" + NL
    t = t + "        IF JsGet(init, ""method"") <> ""u"" THEN method = JsStr(JsGet(init, ""method"")).Upper()" + NL
    t = t + "        IF JsGet(init, ""body"") <> ""u"" AND JsGet(init, ""body"") <> ""l"" THEN body = JsStr(JsGet(init, ""body""))" + NL
    t = t + "        h = JsGet(init, ""headers"")" + NL
    t = t + "        IF h.StartsWith(""o"") THEN" + NL
    t = t + "            FOR EACH key IN joKeys[JsId(h)].Split(""|"")" + NL
    t = t + "                IF key <> """" THEN headers = headers + key + "": "" + JsStr(JsGet(h, key)) + Chr(10)" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    x = JsNewXhr()" + NL
    t = t + "    p = JsNewPromise()" + NL
    t = t + "    JsPutOwn(x, ""@promise"", JsO(p))" + NL
    t = t + "    JsPutOwn(x, ""@method"", JsS(method))" + NL
    t = t + "    JsPutOwn(x, ""@url"", JsS(JsStr(JsArg(args, 0))))" + NL
    t = t + "    JsPutOwn(x, ""readyState"", ""n1"")" + NL
    t = t + "    JsPutOwn(x, ""@req"", JsN(HostXhrSend(method, JsStr(JsArg(args, 0)), headers, body, x)))" + NL
    t = t + "    RETURN JsO(p)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' fetch()'s answer: a Response, or (when nothing came back) a rejection." + NL
    t = t + "SUB JsFetched (x AS Integer, p AS Integer, status AS Integer, statusText AS String, body AS String)" + NL
    t = t + "    VAR r AS Integer" + NL
    t = t + "    VAR hd AS Integer" + NL
    t = t + "    IF status = 0 THEN" + NL
    t = t + "        JsResolve(p, FALSE, JsMakeError(""0|Failed to fetch "" + JsStr(JsGetProp(x, ""@url""))))" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    r = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsPutOwn(r, ""status"", JsN(status))" + NL
    t = t + "    JsPutOwn(r, ""statusText"", JsS(statusText))" + NL
    t = t + "    JsPutOwn(r, ""ok"", JsB(status >= 200 AND status < 300))" + NL
    t = t + "    JsPutOwn(r, ""url"", JsGetProp(x, ""@url""))" + NL
    t = t + "    JsPutOwn(r, ""@body"", JsS(body))" + NL
    t = t + "    JsPutOwn(r, ""text"", JsNative(""Response.text""))" + NL
    t = t + "    JsPutOwn(r, ""json"", JsNative(""Response.json""))" + NL
    t = t + "    hd = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsPutOwn(hd, ""@xhr"", JsO(x))" + NL
    t = t + "    JsPutOwn(hd, ""get"", JsNative(""Response.header""))" + NL
    t = t + "    JsPutOwn(r, ""headers"", JsO(hd))" + NL
    t = t + "    JsResolve(p, TRUE, JsO(r))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- promises, small ones" + NL
    t = t + "'" + NL
    t = t + "' Enough for fetch(url).then(function (r) { return r.text(); }).then(...):" + NL
    t = t + "' then and catch, chaining, and a callback's thenable followed. @state is" + NL
    t = t + "' pending, ok or err; @value what it settled with; @then the callbacks" + NL
    t = t + "' waiting, three to an entry (on ok, on err, the promise then() returned)." + NL
    t = t + "' Callbacks run as soon as there is something to give them." + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNewPromise () AS Integer" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    id = JsNewObject(""Promise"", jsPromiseProto)" + NL
    t = t + "    JsPutOwn(id, ""@state"", ""spending"")" + NL
    t = t + "    JsPutOwn(id, ""@value"", ""u"")" + NL
    t = t + "    JsPutOwn(id, ""@then"", JsO(JsNewArray(none)))" + NL
    t = t + "    RETURN id" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A function that settles promise p (kind ""ok"" or ""err"") with its argument." + NL
    t = t + "FUNCTION JsSettler (p AS Integer, kind AS String) AS String" + NL
    t = t + "    RETURN JsNative(""Promise.settle:"" + kind + "":"" + Str(p))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JsResolve (p AS Integer, ok AS Bool, v AS String)" + NL
    t = t + "    VAR args AS Array OF String" + NL
    t = t + "    VAR fn AS String" + NL
    t = t + "    VAR r AS String" + NL
    t = t + "    VAR waiting AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    IF JsGetProp(p, ""@state"") <> ""spending"" THEN RETURN" + NL
    t = t + "    ' a thenable is followed: p ends as it does" + NL
    t = t + "    IF ok AND v.StartsWith(""o"") AND JsId(v) <> p THEN" + NL
    t = t + "        fn = JsGet(v, ""then"")" + NL
    t = t + "        IF JsCallable(fn) THEN" + NL
    t = t + "            args.Add(JsSettler(p, ""ok""))" + NL
    t = t + "            args.Add(JsSettler(p, ""err""))" + NL
    t = t + "            r = JsCall(fn, v, args)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ok THEN" + NL
    t = t + "        JsPutOwn(p, ""@state"", ""sok"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        JsPutOwn(p, ""@state"", ""serr"")" + NL
    t = t + "    END IF" + NL
    t = t + "    JsPutOwn(p, ""@value"", v)" + NL
    t = t + "    waiting = JsItems(JsId(JsGetProp(p, ""@then"")))" + NL
    t = t + "    JsPutOwn(p, ""@then"", JsO(JsNewArray(none)))" + NL
    t = t + "    i = 0" + NL
    t = t + "    WHILE i + 2 < waiting.Count" + NL
    t = t + "        JsQueueThen(p, waiting[i], waiting[i + 1], JsId(waiting[i + 2]))" + NL
    t = t + "        i = i + 3" + NL
    t = t + "    END WHILE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A settled promise p gives its value to the callback that fits; what that" + NL
    t = t + "' returns (or throws) settles child." + NL
    t = t + "SUB JsRunThen (p AS Integer, onOk AS String, onErr AS String, child AS Integer)" + NL
    t = t + "    VAR ok AS Bool" + NL
    t = t + "    VAR fn AS String" + NL
    t = t + "    VAR args AS Array OF String" + NL
    t = t + "    VAR r AS String" + NL
    t = t + "    VAR depth AS Integer" + NL
    t = t + "    VAR failed AS Bool" + NL
    t = t + "    ok = JsGetProp(p, ""@state"") = ""sok""" + NL
    t = t + "    fn = onErr" + NL
    t = t + "    IF ok THEN fn = onOk" + NL
    t = t + "    IF NOT JsCallable(fn) THEN" + NL
    t = t + "        JsResolve(child, ok, JsGetProp(p, ""@value""))" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    args.Add(JsGetProp(p, ""@value""))" + NL
    t = t + "    depth = jsDepth" + NL
    t = t + "    TRY" + NL
    t = t + "        r = JsCall(fn, JsO(jsGlobal), args)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        jsDepth = depth" + NL
    t = t + "        IF err.Contains(""@aborted"") THEN THROW err" + NL
    t = t + "        IF jsThrown <> """" THEN" + NL
    t = t + "            r = jsThrown" + NL
    t = t + "        ELSE" + NL
    t = t + "            r = JsMakeError(err)" + NL
    t = t + "        END IF" + NL
    t = t + "        jsThrown = """"" + NL
    t = t + "        jsSig = """"" + NL
    t = t + "        failed = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "    JsResolve(child, NOT failed, r)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsPromiseMethod (name AS String, thisVal AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR child AS Integer" + NL
    t = t + "    VAR list AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR want AS String" + NL
    t = t + "    VAR code AS Array OF String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    id = JsId(thisVal)" + NL
    t = t + "    IF name.StartsWith(""Promise.settle:"") THEN" + NL
    t = t + "        parts = name.Split("":"")" + NL
    t = t + "        JsResolve(Int(Val(parts[2])), parts[1] = ""ok"", JsArg(args, 0))" + NL
    t = t + "        RETURN ""u""" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""Promise.then"", ""Promise.catch""" + NL
    t = t + "            IF id = 0 OR joClass[id] <> ""Promise"" THEN THROW Str(jsLine) + ""|Object expected""" + NL
    t = t + "            child = JsNewPromise()" + NL
    t = t + "            IF name = ""Promise.catch"" THEN" + NL
    t = t + "                args.Insert(0, ""u"")" + NL
    t = t + "            END IF" + NL
    t = t + "            IF JsGetProp(id, ""@state"") = ""spending"" THEN" + NL
    t = t + "                list = JsId(JsGetProp(id, ""@then""))" + NL
    t = t + "                n = JsInt(JsGetProp(list, ""length""))" + NL
    t = t + "                JsPutOwn(list, Str(n), JsArg(args, 0))" + NL
    t = t + "                JsPutOwn(list, Str(n + 1), JsArg(args, 1))" + NL
    t = t + "                JsPutOwn(list, Str(n + 2), JsO(child))" + NL
    t = t + "                JsPutOwn(list, ""length"", JsN(n + 3))" + NL
    t = t + "            ELSE" + NL
    t = t + "                JsQueueThen(id, JsArg(args, 0), JsArg(args, 1), child)" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsO(child)" + NL
    t = t + "        CASE ""Response.text""" + NL
    t = t + "            child = JsNewPromise()" + NL
    t = t + "            JsResolve(child, TRUE, JsGet(thisVal, ""@body""))" + NL
    t = t + "            RETURN JsO(child)" + NL
    t = t + "        CASE ""Response.json""" + NL
    t = t + "            ' JSON is JavaScript, so eval reads it" + NL
    t = t + "            child = JsNewPromise()" + NL
    t = t + "            code.Add(JsS(""("" + JsStr(JsGet(thisVal, ""@body"")) + "")""))" + NL
    t = t + "            TRY" + NL
    t = t + "                v = JsEvalCode(code, jsGlobal)" + NL
    t = t + "            CATCH err" + NL
    t = t + "                JsResolve(child, FALSE, JsMakeError(err))" + NL
    t = t + "                RETURN JsO(child)" + NL
    t = t + "            END TRY" + NL
    t = t + "            JsResolve(child, TRUE, v)" + NL
    t = t + "            RETURN JsO(child)" + NL
    t = t + "        CASE ""Response.header""" + NL
    t = t + "            want = JsStr(JsArg(args, 0)).Lower().Trim() + "":""" + NL
    t = t + "            FOR EACH line IN JsStr(JsGetProp(JsId(JsGet(thisVal, ""@xhr"")), ""@rheaders"")).Split(Chr(10))" + NL
    t = t + "                IF line.Lower().StartsWith(want) THEN RETURN JsS(line.Substring(want.Length, line.Length - want.Length).Trim())" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN ""l""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the later library" + NL
    t = t + "" + NL
    t = t + "' What came after 1996 and every program now expects: JSON, Object.keys," + NL
    t = t + "' Array.isArray, Number.isInteger, fn.bind, Promise.resolve/reject/all/race." + NL
    t = t + "' (Array and String methods like map and startsWith are with the others.)" + NL
    t = t + "" + NL
    t = t + "VAR jsonSrc AS String" + NL
    t = t + "VAR jsonAt AS Integer" + NL
    t = t + "" + NL
    t = t + "' Three arguments, as callbacks get them: (item, index, array)." + NL
    t = t + "FUNCTION JsArgs3 (a AS String, b AS String, c AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    out.Add(a)" + NL
    t = t + "    out.Add(b)" + NL
    t = t + "    out.Add(c)" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsNeedFn (v AS String, what AS String) AS String" + NL
    t = t + "    IF NOT JsCallable(v) THEN" + NL
    t = t + "        jsThrown = JsMakeTypedError(""TypeError"", what + "" is not a function"")" + NL
    t = t + "        THROW Str(jsLine) + ""|@thrown""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN v" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' An object's own keys, in the order they were made (an array's length left out)." + NL
    t = t + "FUNCTION JsOwnKeys (id AS Integer) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    FOR EACH key IN joKeys[id].Split(""|"")" + NL
    t = t + "        IF key = """" OR (joClass[id] = ""Array"" AND key = ""length"") THEN CONTINUE" + NL
    t = t + "        out.Add(key)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsMakeTypedError (kind AS String, message AS String) AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    v = JsMakeError(""0|"" + message)" + NL
    t = t + "    JsPutOwn(JsId(v), ""name"", JsS(kind))" + NL
    t = t + "    JsPutOwn(JsId(v), ""stack"", JsS(kind + "": "" + message))" + NL
    t = t + "    IF JsGetProp(jsGlobal, kind).StartsWith(""o"") THEN joProto[JsId(v)] = JsId(JsGetProp(JsId(JsGetProp(jsGlobal, kind)), ""prototype""))" + NL
    t = t + "    RETURN v" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsLib (name AS String, thisVal AS String, args AS Array OF String) AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    VAR p AS Integer" + NL
    t = t + "    VAR holder AS Integer" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR pair AS Array OF String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    a = JsArg(args, 0)" + NL
    t = t + "    IF name.StartsWith(""Bound:"") THEN" + NL
    t = t + "        holder = Int(Val(name.Substring(6, name.Length - 6)))" + NL
    t = t + "        list = JsItems(JsId(JsGetProp(holder, ""@args"")))" + NL
    t = t + "        FOR EACH v IN args" + NL
    t = t + "            list.Add(v)" + NL
    t = t + "        NEXT" + NL
    t = t + "        RETURN JsCall(JsGetProp(holder, ""@fn""), JsGetProp(holder, ""@this""), list)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF name.StartsWith(""Promise.part:"") THEN" + NL
    t = t + "        ' one of Promise.all's promises settled: its value in its place, and" + NL
    t = t + "        ' the whole thing settled when the last is in" + NL
    t = t + "        parts = name.Split("":"")" + NL
    t = t + "        holder = Int(Val(parts[1]))" + NL
    t = t + "        p = Int(Val(parts[2]))" + NL
    t = t + "        IF JsGetProp(p, ""@state"") <> ""spending"" THEN RETURN ""u""" + NL
    t = t + "        IF parts[4] = ""err"" THEN" + NL
    t = t + "            JsResolve(p, FALSE, a)" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        END IF" + NL
    t = t + "        IF parts[4] = ""race"" THEN" + NL
    t = t + "            JsResolve(p, TRUE, a)" + NL
    t = t + "            RETURN ""u""" + NL
    t = t + "        END IF" + NL
    t = t + "        JsPut(JsO(holder), parts[3], a)" + NL
    t = t + "        i = JsInt(JsGetProp(holder, ""@left"")) - 1" + NL
    t = t + "        JsPutOwn(holder, ""@left"", JsN(i))" + NL
    t = t + "        IF i = 0 THEN JsResolve(p, TRUE, JsO(holder))" + NL
    t = t + "        RETURN ""u""" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE name" + NL
    t = t + "        CASE ""Function.bind""" + NL
    t = t + "            holder = JsNewObject(""Object"", 0)" + NL
    t = t + "            JsPutOwn(holder, ""@fn"", thisVal)" + NL
    t = t + "            JsPutOwn(holder, ""@this"", JsThisArg(a))" + NL
    t = t + "            FOR i = 1 TO args.Count - 1" + NL
    t = t + "                out.Add(args[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            JsPutOwn(holder, ""@args"", JsO(JsNewArray(out)))" + NL
    t = t + "            RETURN JsNative(""Bound:"" + Str(holder))" + NL
    t = t + "        CASE ""ObjectS.keys"", ""ObjectS.values"", ""ObjectS.entries"", ""ObjectS.getOwnPropertyNames""" + NL
    t = t + "            IF NOT a.StartsWith(""o"") THEN" + NL
    t = t + "                IF a.StartsWith(""s"") THEN" + NL
    t = t + "                    FOR i = 0 TO a.Length - 2" + NL
    t = t + "                        out.Add(JsS(Str(i)))" + NL
    t = t + "                    NEXT" + NL
    t = t + "                END IF" + NL
    t = t + "                RETURN JsO(JsNewArray(out))" + NL
    t = t + "            END IF" + NL
    t = t + "            id = JsId(a)" + NL
    t = t + "            FOR EACH key IN JsOwnKeys(id)" + NL
    t = t + "                IF name = ""ObjectS.values"" THEN" + NL
    t = t + "                    out.Add(JsGet(a, key))" + NL
    t = t + "                ELSEIF name = ""ObjectS.entries"" THEN" + NL
    t = t + "                    pair.Clear()" + NL
    t = t + "                    pair.Add(JsS(key))" + NL
    t = t + "                    pair.Add(JsGet(a, key))" + NL
    t = t + "                    out.Add(JsO(JsNewArray(pair)))" + NL
    t = t + "                ELSE" + NL
    t = t + "                    out.Add(JsS(key))" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsO(JsNewArray(out))" + NL
    t = t + "        CASE ""ObjectS.assign""" + NL
    t = t + "            IF NOT a.StartsWith(""o"") THEN RETURN a" + NL
    t = t + "            FOR i = 1 TO args.Count - 1" + NL
    t = t + "                IF args[i].StartsWith(""o"") THEN" + NL
    t = t + "                    FOR EACH key IN JsOwnKeys(JsId(args[i]))" + NL
    t = t + "                        JsPut(a, key, JsGet(args[i], key))" + NL
    t = t + "                    NEXT" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN a" + NL
    t = t + "        CASE ""ObjectS.create""" + NL
    t = t + "            IF a = ""l"" THEN RETURN JsO(JsNewObject(""Object"", 0))" + NL
    t = t + "            IF NOT a.StartsWith(""o"") THEN RETURN JsO(JsNewObject(""Object"", jsObjectProto))" + NL
    t = t + "            id = JsNewObject(""Object"", JsId(a))" + NL
    t = t + "            IF JsArg(args, 1).StartsWith(""o"") THEN" + NL
    t = t + "                FOR EACH key IN JsOwnKeys(JsId(args[1]))" + NL
    t = t + "                    JsPutOwn(id, key, JsGet(JsGet(args[1], key), ""value""))" + NL
    t = t + "                NEXT" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsO(id)" + NL
    t = t + "        CASE ""ObjectS.getPrototypeOf""" + NL
    t = t + "            IF NOT a.StartsWith(""o"") THEN RETURN ""l""" + NL
    t = t + "            IF joProto[JsId(a)] = 0 THEN RETURN ""l""" + NL
    t = t + "            RETURN JsO(joProto[JsId(a)])" + NL
    t = t + "        CASE ""ObjectS.setPrototypeOf""" + NL
    t = t + "            IF a.StartsWith(""o"") AND JsArg(args, 1).StartsWith(""o"") THEN joProto[JsId(a)] = JsId(args[1])" + NL
    t = t + "            RETURN a" + NL
    t = t + "        CASE ""ObjectS.freeze"", ""ObjectS.seal"", ""ObjectS.preventExtensions""" + NL
    t = t + "            RETURN a" + NL
    t = t + "        CASE ""ObjectS.defineProperty""" + NL
    t = t + "            IF a.StartsWith(""o"") AND JsArg(args, 2).StartsWith(""o"") THEN JsPut(a, JsKey(JsArg(args, 1)), JsGet(args[2], ""value""))" + NL
    t = t + "            RETURN a" + NL
    t = t + "        CASE ""ObjectS.is""" + NL
    t = t + "            IF JsNum(a) = ""NaN"" AND JsNum(JsArg(args, 1)) = ""NaN"" AND a.StartsWith(""n"") AND JsArg(args, 1).StartsWith(""n"") THEN RETURN ""t""" + NL
    t = t + "            RETURN JsB(JsStrictEq(a, JsArg(args, 1)))" + NL
    t = t + "        CASE ""ArrayS.isArray""" + NL
    t = t + "            IF NOT a.StartsWith(""o"") THEN RETURN ""f""" + NL
    t = t + "            RETURN JsB(joClass[JsId(a)] = ""Array"")" + NL
    t = t + "        CASE ""ArrayS.of""" + NL
    t = t + "            RETURN JsO(JsNewArray(args))" + NL
    t = t + "        CASE ""ArrayS.from""" + NL
    t = t + "            IF a.StartsWith(""s"") THEN" + NL
    t = t + "                FOR i = 1 TO a.Length - 1" + NL
    t = t + "                    out.Add(JsS(a.Substring(i, 1)))" + NL
    t = t + "                NEXT" + NL
    t = t + "            ELSEIF a.StartsWith(""o"") THEN" + NL
    t = t + "                IF joClass[JsId(a)] = ""Array"" THEN" + NL
    t = t + "                    out = JsItems(JsId(a))" + NL
    t = t + "                ELSE" + NL
    t = t + "                    FOR i = 0 TO JsInt(JsGet(a, ""length"")) - 1" + NL
    t = t + "                        out.Add(JsGet(a, Str(i)))" + NL
    t = t + "                    NEXT" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "            IF JsCallable(JsArg(args, 1)) THEN" + NL
    t = t + "                FOR i = 0 TO out.Count - 1" + NL
    t = t + "                    list.Clear()" + NL
    t = t + "                    list.Add(out[i])" + NL
    t = t + "                    list.Add(JsN(i))" + NL
    t = t + "                    out[i] = JsCall(args[1], JsO(jsGlobal), list)" + NL
    t = t + "                NEXT" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN JsO(JsNewArray(out))" + NL
    t = t + "        CASE ""NumberS.isInteger""" + NL
    t = t + "            RETURN JsB(a.StartsWith(""n"") AND JsFinite(JsNum(a)) AND JsReal(a) = Int(JsReal(a)))" + NL
    t = t + "        CASE ""NumberS.isFinite""" + NL
    t = t + "            RETURN JsB(a.StartsWith(""n"") AND JsFinite(JsNum(a)))" + NL
    t = t + "        CASE ""NumberS.isNaN""" + NL
    t = t + "            RETURN JsB(a.StartsWith(""n"") AND JsNum(a) = ""NaN"")" + NL
    t = t + "        CASE ""JSON.stringify""" + NL
    t = t + "            text = """"" + NL
    t = t + "            v = JsArg(args, 2)" + NL
    t = t + "            IF v.StartsWith(""n"") THEN" + NL
    t = t + "                FOR i = 1 TO MATH.Min(10, JsInt(v))" + NL
    t = t + "                    text = text + "" """ + NL
    t = t + "                NEXT" + NL
    t = t + "            ELSEIF v.StartsWith(""s"") THEN" + NL
    t = t + "                text = JsStr(v)" + NL
    t = t + "            END IF" + NL
    t = t + "            v = JsJsonOut(a, text, """")" + NL
    t = t + "            IF v = Chr(0) THEN RETURN ""u""" + NL
    t = t + "            RETURN JsS(v)" + NL
    t = t + "        CASE ""JSON.parse""" + NL
    t = t + "            jsonSrc = JsStr(a)" + NL
    t = t + "            jsonAt = 0" + NL
    t = t + "            v = JsJsonValue()" + NL
    t = t + "            JsJsonSpace()" + NL
    t = t + "            IF jsonAt < jsonSrc.Length THEN JsJsonFail()" + NL
    t = t + "            RETURN v" + NL
    t = t + "        CASE ""PromiseS.resolve"", ""PromiseS.reject""" + NL
    t = t + "            IF name = ""PromiseS.resolve"" AND a.StartsWith(""o"") THEN" + NL
    t = t + "                IF joClass[JsId(a)] = ""Promise"" THEN RETURN a" + NL
    t = t + "            END IF" + NL
    t = t + "            p = JsNewPromise()" + NL
    t = t + "            JsResolve(p, name = ""PromiseS.resolve"", a)" + NL
    t = t + "            RETURN JsO(p)" + NL
    t = t + "        CASE ""PromiseS.all"", ""PromiseS.race""" + NL
    t = t + "            p = JsNewPromise()" + NL
    t = t + "            IF a.StartsWith(""o"") THEN list = JsItems(JsId(a))" + NL
    t = t + "            holder = JsNewArray(out)" + NL
    t = t + "            JsPutOwn(holder, ""length"", JsN(list.Count))" + NL
    t = t + "            JsPutOwn(holder, ""@left"", JsN(list.Count))" + NL
    t = t + "            IF list.Count = 0 AND name = ""PromiseS.all"" THEN JsResolve(p, TRUE, JsO(holder))" + NL
    t = t + "            FOR i = 0 TO list.Count - 1" + NL
    t = t + "                v = list[i]" + NL
    t = t + "                IF NOT v.StartsWith(""o"") OR joClass[JsId(v)] <> ""Promise"" THEN" + NL
    t = t + "                    id = JsNewPromise()" + NL
    t = t + "                    JsResolve(id, TRUE, v)" + NL
    t = t + "                    v = JsO(id)" + NL
    t = t + "                END IF" + NL
    t = t + "                pair.Clear()" + NL
    t = t + "                IF name = ""PromiseS.race"" THEN" + NL
    t = t + "                    pair.Add(JsNative(""Promise.part:"" + Str(holder) + "":"" + Str(p) + "":"" + Str(i) + "":race""))" + NL
    t = t + "                ELSE" + NL
    t = t + "                    pair.Add(JsNative(""Promise.part:"" + Str(holder) + "":"" + Str(p) + "":"" + Str(i) + "":ok""))" + NL
    t = t + "                END IF" + NL
    t = t + "                pair.Add(JsNative(""Promise.part:"" + Str(holder) + "":"" + Str(p) + "":"" + Str(i) + "":err""))" + NL
    t = t + "                v = JsPromiseMethod(""Promise.then"", v, pair)" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN JsO(p)" + NL
    t = t + "    END SELECT" + NL
    t = t + "    THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' new Promise(function (resolve, reject) { ... })" + NL
    t = t + "FUNCTION JsNewPromiseFrom (executor AS String) AS String" + NL
    t = t + "    VAR p AS Integer" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    VAR r AS String" + NL
    t = t + "    VAR depth AS Integer" + NL
    t = t + "    p = JsNewPromise()" + NL
    t = t + "    list.Add(JsSettler(p, ""ok""))" + NL
    t = t + "    list.Add(JsSettler(p, ""err""))" + NL
    t = t + "    depth = jsDepth" + NL
    t = t + "    TRY" + NL
    t = t + "        r = JsCall(JsNeedFn(executor, ""Promise resolver""), JsO(jsGlobal), list)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        jsDepth = depth" + NL
    t = t + "        IF err.Contains(""@aborted"") THEN THROW err" + NL
    t = t + "        IF jsThrown <> """" THEN" + NL
    t = t + "            r = jsThrown" + NL
    t = t + "        ELSE" + NL
    t = t + "            r = JsMakeError(err)" + NL
    t = t + "        END IF" + NL
    t = t + "        jsThrown = """"" + NL
    t = t + "        jsSig = """"" + NL
    t = t + "        JsResolve(p, FALSE, r)" + NL
    t = t + "    END TRY" + NL
    t = t + "    RETURN JsO(p)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---- JSON" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsJsonQuote (s AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    out = """"""""" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        c = s.CharAt(i)" + NL
    t = t + "        k = Asc(c)" + NL
    t = t + "        IF c = """""""" THEN" + NL
    t = t + "            out = out + ""\""""""" + NL
    t = t + "        ELSEIF c = ""\"" THEN" + NL
    t = t + "            out = out + ""\\""" + NL
    t = t + "        ELSEIF k = 10 THEN" + NL
    t = t + "            out = out + ""\n""" + NL
    t = t + "        ELSEIF k = 13 THEN" + NL
    t = t + "            out = out + ""\r""" + NL
    t = t + "        ELSEIF k = 9 THEN" + NL
    t = t + "            out = out + ""\t""" + NL
    t = t + "        ELSEIF k < 32 THEN" + NL
    t = t + "            out = out + ""\u00"" + ""0123456789abcdef"".CharAt(Int(k / 16)) + ""0123456789abcdef"".CharAt(k MOD 16)" + NL
    t = t + "        ELSE" + NL
    t = t + "            out = out + c" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out + """"""""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' v as JSON; Chr(0) for what JSON leaves out (undefined, functions)." + NL
    t = t + "FUNCTION JsJsonOut (v AS String, indent AS String, cur AS String) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR item AS String" + NL
    t = t + "    VAR inner AS String" + NL
    t = t + "    VAR sep AS String" + NL
    t = t + "    VAR fn AS String" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    SELECT CASE v.Substring(0, 1)" + NL
    t = t + "        CASE ""u""" + NL
    t = t + "            RETURN Chr(0)" + NL
    t = t + "        CASE ""l""" + NL
    t = t + "            RETURN ""null""" + NL
    t = t + "        CASE ""t""" + NL
    t = t + "            RETURN ""true""" + NL
    t = t + "        CASE ""f""" + NL
    t = t + "            RETURN ""false""" + NL
    t = t + "        CASE ""n""" + NL
    t = t + "            IF NOT JsFinite(JsNum(v)) THEN RETURN ""null""" + NL
    t = t + "            RETURN JsStr(v)" + NL
    t = t + "        CASE ""s""" + NL
    t = t + "            RETURN JsJsonQuote(v.Substring(1, v.Length - 1))" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF JsCallable(v) THEN RETURN Chr(0)" + NL
    t = t + "    id = JsId(v)" + NL
    t = t + "    fn = JsGet(v, ""toJSON"")" + NL
    t = t + "    IF JsCallable(fn) THEN RETURN JsJsonOut(JsCall(fn, v, none), indent, cur)" + NL
    t = t + "    IF joClass[id] = ""Date"" THEN RETURN JsJsonQuote(JsStr(v))" + NL
    t = t + "    inner = cur + indent" + NL
    t = t + "    sep = "",""" + NL
    t = t + "    IF indent <> """" THEN sep = "","" + Chr(10) + inner" + NL
    t = t + "    IF joClass[id] = ""Array"" THEN" + NL
    t = t + "        FOR EACH item IN JsItems(id)" + NL
    t = t + "            key = JsJsonOut(item, indent, inner)" + NL
    t = t + "            IF key = Chr(0) THEN key = ""null""" + NL
    t = t + "            parts.Add(key)" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF parts.Count = 0 THEN RETURN ""[]""" + NL
    t = t + "        IF indent = """" THEN RETURN ""["" + parts.Join("","") + ""]""" + NL
    t = t + "        RETURN ""["" + Chr(10) + inner + parts.Join(sep) + Chr(10) + cur + ""]""" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH key IN JsOwnKeys(id)" + NL
    t = t + "        item = JsJsonOut(JsGet(v, key), indent, inner)" + NL
    t = t + "        IF item = Chr(0) THEN CONTINUE" + NL
    t = t + "        IF indent = """" THEN" + NL
    t = t + "            parts.Add(JsJsonQuote(key) + "":"" + item)" + NL
    t = t + "        ELSE" + NL
    t = t + "            parts.Add(JsJsonQuote(key) + "": "" + item)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF parts.Count = 0 THEN RETURN ""{}""" + NL
    t = t + "    IF indent = """" THEN RETURN ""{"" + parts.Join("","") + ""}""" + NL
    t = t + "    RETURN ""{"" + Chr(10) + inner + parts.Join(sep) + Chr(10) + cur + ""}""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB JsJsonFail ()" + NL
    t = t + "    VAR what AS String" + NL
    t = t + "    IF jsonAt >= jsonSrc.Length THEN" + NL
    t = t + "        what = ""Unexpected end of JSON input""" + NL
    t = t + "    ELSE" + NL
    t = t + "        what = ""Unexpected token "" + jsonSrc.CharAt(jsonAt) + "" in JSON at position "" + Str(jsonAt)" + NL
    t = t + "    END IF" + NL
    t = t + "    jsThrown = JsMakeTypedError(""SyntaxError"", what)" + NL
    t = t + "    THROW Str(jsLine) + ""|@thrown""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB JsJsonSpace ()" + NL
    t = t + "    WHILE jsonAt < jsonSrc.Length" + NL
    t = t + "        IF NOT ("" "" + Chr(9) + Chr(10) + Chr(13)).Contains(jsonSrc.CharAt(jsonAt)) THEN RETURN" + NL
    t = t + "        jsonAt = jsonAt + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsJsonValue () AS String" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    VAR items AS Array OF String" + NL
    t = t + "    VAR key AS String" + NL
    t = t + "    VAR start AS Integer" + NL
    t = t + "    JsJsonSpace()" + NL
    t = t + "    IF jsonAt >= jsonSrc.Length THEN JsJsonFail()" + NL
    t = t + "    c = jsonSrc.CharAt(jsonAt)" + NL
    t = t + "    IF c = ""{"" THEN" + NL
    t = t + "        jsonAt = jsonAt + 1" + NL
    t = t + "        id = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "        JsJsonSpace()" + NL
    t = t + "        IF jsonAt < jsonSrc.Length AND jsonSrc.CharAt(jsonAt) = ""}"" THEN" + NL
    t = t + "            jsonAt = jsonAt + 1" + NL
    t = t + "            RETURN JsO(id)" + NL
    t = t + "        END IF" + NL
    t = t + "        WHILE TRUE" + NL
    t = t + "            JsJsonSpace()" + NL
    t = t + "            IF jsonAt >= jsonSrc.Length OR jsonSrc.CharAt(jsonAt) <> """""""" THEN JsJsonFail()" + NL
    t = t + "            key = JsJsonString()" + NL
    t = t + "            JsJsonSpace()" + NL
    t = t + "            IF jsonAt >= jsonSrc.Length OR jsonSrc.CharAt(jsonAt) <> "":"" THEN JsJsonFail()" + NL
    t = t + "            jsonAt = jsonAt + 1" + NL
    t = t + "            JsPut(JsO(id), key, JsJsonValue())" + NL
    t = t + "            JsJsonSpace()" + NL
    t = t + "            IF jsonAt < jsonSrc.Length AND jsonSrc.CharAt(jsonAt) = "","" THEN" + NL
    t = t + "                jsonAt = jsonAt + 1" + NL
    t = t + "            ELSEIF jsonAt < jsonSrc.Length AND jsonSrc.CharAt(jsonAt) = ""}"" THEN" + NL
    t = t + "                jsonAt = jsonAt + 1" + NL
    t = t + "                RETURN JsO(id)" + NL
    t = t + "            ELSE" + NL
    t = t + "                JsJsonFail()" + NL
    t = t + "            END IF" + NL
    t = t + "        END WHILE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF c = ""["" THEN" + NL
    t = t + "        jsonAt = jsonAt + 1" + NL
    t = t + "        JsJsonSpace()" + NL
    t = t + "        IF jsonAt < jsonSrc.Length AND jsonSrc.CharAt(jsonAt) = ""]"" THEN" + NL
    t = t + "            jsonAt = jsonAt + 1" + NL
    t = t + "            RETURN JsO(JsNewArray(items))" + NL
    t = t + "        END IF" + NL
    t = t + "        WHILE TRUE" + NL
    t = t + "            items.Add(JsJsonValue())" + NL
    t = t + "            JsJsonSpace()" + NL
    t = t + "            IF jsonAt < jsonSrc.Length AND jsonSrc.CharAt(jsonAt) = "","" THEN" + NL
    t = t + "                jsonAt = jsonAt + 1" + NL
    t = t + "            ELSEIF jsonAt < jsonSrc.Length AND jsonSrc.CharAt(jsonAt) = ""]"" THEN" + NL
    t = t + "                jsonAt = jsonAt + 1" + NL
    t = t + "                RETURN JsO(JsNewArray(items))" + NL
    t = t + "            ELSE" + NL
    t = t + "                JsJsonFail()" + NL
    t = t + "            END IF" + NL
    t = t + "        END WHILE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF c = """""""" THEN RETURN JsS(JsJsonString())" + NL
    t = t + "    IF jsonSrc.Substring(jsonAt, MATH.Min(4, jsonSrc.Length - jsonAt)) = ""true"" THEN" + NL
    t = t + "        jsonAt = jsonAt + 4" + NL
    t = t + "        RETURN ""t""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF jsonSrc.Substring(jsonAt, MATH.Min(5, jsonSrc.Length - jsonAt)) = ""false"" THEN" + NL
    t = t + "        jsonAt = jsonAt + 5" + NL
    t = t + "        RETURN ""f""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF jsonSrc.Substring(jsonAt, MATH.Min(4, jsonSrc.Length - jsonAt)) = ""null"" THEN" + NL
    t = t + "        jsonAt = jsonAt + 4" + NL
    t = t + "        RETURN ""l""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ""-0123456789"".Contains(c) THEN" + NL
    t = t + "        start = jsonAt" + NL
    t = t + "        jsonAt = jsonAt + 1" + NL
    t = t + "        WHILE jsonAt < jsonSrc.Length AND ""0123456789.eE+-"".Contains(jsonSrc.CharAt(jsonAt))" + NL
    t = t + "            jsonAt = jsonAt + 1" + NL
    t = t + "        END WHILE" + NL
    t = t + "        RETURN ""n"" + JsNum(JsS(jsonSrc.Substring(start, jsonAt - start)))" + NL
    t = t + "    END IF" + NL
    t = t + "    JsJsonFail()" + NL
    t = t + "    RETURN ""u""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A JSON string at jsonAt (the opening quote), unescaped." + NL
    t = t + "FUNCTION JsJsonString () AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    VAR e AS String" + NL
    t = t + "    jsonAt = jsonAt + 1" + NL
    t = t + "    WHILE jsonAt < jsonSrc.Length" + NL
    t = t + "        c = jsonSrc.CharAt(jsonAt)" + NL
    t = t + "        IF c = """""""" THEN" + NL
    t = t + "            jsonAt = jsonAt + 1" + NL
    t = t + "            RETURN out" + NL
    t = t + "        END IF" + NL
    t = t + "        IF c = ""\"" THEN" + NL
    t = t + "            jsonAt = jsonAt + 1" + NL
    t = t + "            IF jsonAt >= jsonSrc.Length THEN JsJsonFail()" + NL
    t = t + "            e = jsonSrc.CharAt(jsonAt)" + NL
    t = t + "            SELECT CASE e" + NL
    t = t + "                CASE ""n""" + NL
    t = t + "                    out = out + Chr(10)" + NL
    t = t + "                CASE ""t""" + NL
    t = t + "                    out = out + Chr(9)" + NL
    t = t + "                CASE ""r""" + NL
    t = t + "                    out = out + Chr(13)" + NL
    t = t + "                CASE ""b""" + NL
    t = t + "                    out = out + Chr(8)" + NL
    t = t + "                CASE ""f""" + NL
    t = t + "                    out = out + Chr(12)" + NL
    t = t + "                CASE ""u""" + NL
    t = t + "                    IF jsonAt + 4 >= jsonSrc.Length THEN JsJsonFail()" + NL
    t = t + "                    out = out + Chr(Int(Val(JsNumberText(""0x"" + jsonSrc.Substring(jsonAt + 1, 4)))))" + NL
    t = t + "                    jsonAt = jsonAt + 4" + NL
    t = t + "                CASE ELSE" + NL
    t = t + "                    out = out + e" + NL
    t = t + "            END SELECT" + NL
    t = t + "        ELSE" + NL
    t = t + "            out = out + c" + NL
    t = t + "        END IF" + NL
    t = t + "        jsonAt = jsonAt + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    JsJsonFail()" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---- promise jobs: with jsDefer on (Node), then-callbacks wait until the" + NL
    t = t + "' running code is done, as JavaScript says; JsDrainJobs runs them." + NL
    t = t + "" + NL
    t = t + "VAR jsDefer AS Bool" + NL
    t = t + "VAR jqP AS Array OF Integer" + NL
    t = t + "VAR jqOk AS Array OF String" + NL
    t = t + "VAR jqErr AS Array OF String" + NL
    t = t + "VAR jqChild AS Array OF Integer" + NL
    t = t + "" + NL
    t = t + "SUB JsQueueThen (p AS Integer, onOk AS String, onErr AS String, child AS Integer)" + NL
    t = t + "    IF NOT jsDefer THEN" + NL
    t = t + "        JsRunThen(p, onOk, onErr, child)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    jqP.Add(p)" + NL
    t = t + "    jqOk.Add(onOk)" + NL
    t = t + "    jqErr.Add(onErr)" + NL
    t = t + "    jqChild.Add(child)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB JsDrainJobs ()" + NL
    t = t + "    VAR p AS Integer" + NL
    t = t + "    VAR ok AS String" + NL
    t = t + "    VAR er AS String" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    WHILE jqP.Count > 0" + NL
    t = t + "        p = jqP[0]" + NL
    t = t + "        ok = jqOk[0]" + NL
    t = t + "        er = jqErr[0]" + NL
    t = t + "        c = jqChild[0]" + NL
    t = t + "        jqP.RemoveAt(0)" + NL
    t = t + "        jqOk.RemoveAt(0)" + NL
    t = t + "        jqErr.RemoveAt(0)" + NL
    t = t + "        jqChild.RemoveAt(0)" + NL
    t = t + "        jsSig = """"" + NL
    t = t + "        jsDepth = 0" + NL
    t = t + "        JsRunThen(p, ok, er, c)" + NL
    t = t + "    END WHILE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- a fresh page" + NL
    t = t + "" + NL
    t = t + "SUB JsReset ()" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR mathObj AS Integer" + NL
    t = t + "    VAR o AS Integer" + NL
    t = t + "    VAR f AS Integer" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    jtType.Clear()" + NL
    t = t + "    jtText.Clear()" + NL
    t = t + "    jtLine.Clear()" + NL
    t = t + "    jtNl.Clear()" + NL
    t = t + "    nk.Clear()" + NL
    t = t + "    na.Clear()" + NL
    t = t + "    nb.Clear()" + NL
    t = t + "    nc.Clear()" + NL
    t = t + "    nd.Clear()" + NL
    t = t + "    ns.Clear()" + NL
    t = t + "    nl.Clear()" + NL
    t = t + "    nline.Clear()" + NL
    t = t + "    jpKey.Clear()" + NL
    t = t + "    jpVal.Clear()" + NL
    t = t + "    joClass.Clear()" + NL
    t = t + "    joProto.Clear()" + NL
    t = t + "    joA.Clear()" + NL
    t = t + "    joB.Clear()" + NL
    t = t + "    joS.Clear()" + NL
    t = t + "    joKeys.Clear()" + NL
    t = t + "    jsHostCache.Clear()" + NL
    t = t + "    f = JsNode(""none"", 0, 0, 0, 0, """", """", 0)" + NL
    t = t + "    o = JsNewObject(""Nothing"", 0)" + NL
    t = t + "    jsOut = """"" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    jsRet = ""u""" + NL
    t = t + "    jsDepth = 0" + NL
    t = t + "    jsSteps = 0" + NL
    t = t + "    jsLimit = JSSTEPLIMIT" + NL
    t = t + "    jsThrown = """"" + NL
    t = t + "    jsLineBase = 1" + NL
    t = t + "" + NL
    t = t + "    jsObjectProto = JsNewObject(""Object"", 0)" + NL
    t = t + "    JsMethods(jsObjectProto, ""Object."", ""toString,hasOwnProperty"")" + NL
    t = t + "    jsFunctionProto = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(jsFunctionProto, ""Function."", ""call,apply,bind"")" + NL
    t = t + "    jsArrayProto = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(jsArrayProto, ""Array."", ""join,toString,push,pop,shift,unshift,reverse,concat,slice,splice,indexOf,sort,forEach,map,filter,reduce,reduceRight,some,every,find,findIndex,includes,lastIndexOf,fill"")" + NL
    t = t + "    jsStringProto = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(jsStringProto, ""String."", ""charAt,charCodeAt,indexOf,lastIndexOf,substring,substr,slice,toUpperCase,toLowerCase,toLocaleUpperCase,toLocaleLowerCase,trim,split,concat,toString,valueOf,bold,italics,fixed,big,small,blink,strike,sub,sup,fontcolor,fontsize,anchor,link,replace,replaceAll,startsWith,endsWith,includes,repeat,padStart,padEnd,trimStart,trimEnd,trimLeft,trimRight"")" + NL
    t = t + "    jsNumberProto = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(jsNumberProto, ""Number."", ""toString,toFixed"")" + NL
    t = t + "    jsDateProto = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(jsDateProto, ""Date."", ""getTime,valueOf,getFullYear,getYear,getMonth,getDate,getDay,getHours,getMinutes,getSeconds,getMilliseconds,getTimezoneOffset,toString,toLocaleString,toGMTString,toUTCString,setTime,setFullYear,setYear,setMonth,setDate,setHours,setMinutes,setSeconds,setMilliseconds"")" + NL
    t = t + "" + NL
    t = t + "    ' window, which is also the global scope" + NL
    t = t + "    jsGlobal = JsNewObject(""Global"", jsObjectProto)" + NL
    t = t + "    JsPutOwn(jsGlobal, ""window"", JsO(jsGlobal))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""self"", JsO(jsGlobal))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""top"", JsO(jsGlobal))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""parent"", JsO(jsGlobal))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""NaN"", ""nNaN"")" + NL
    t = t + "    JsPutOwn(jsGlobal, ""Infinity"", ""nInfinity"")" + NL
    t = t + "    JsMethods(jsGlobal, """", ""alert,confirm,prompt,parseInt,parseFloat,isNaN,isFinite,escape,unescape,setTimeout,setInterval,clearTimeout,clearInterval,open,String,Number,Boolean,Array,Object,Date,Error,TypeError,RangeError,SyntaxError,ReferenceError,Promise"")" + NL
    t = t + "    JsPutOwn(jsGlobal, ""eval"", JsNative(""eval""))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""close"", JsNative(""noop""))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""focus"", JsNative(""noop""))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""blur"", JsNative(""noop""))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""scroll"", JsNative(""noop""))" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""String"")), ""fromCharCode"", JsNative(""String.fromCharCode""))" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""String"")), ""prototype"", JsO(jsStringProto))" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""Number"")), ""prototype"", JsO(jsNumberProto))" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""Array"")), ""prototype"", JsO(jsArrayProto))" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""Object"")), ""prototype"", JsO(jsObjectProto))" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""Date"")), ""prototype"", JsO(jsDateProto))" + NL
    t = t + "    JsMethods(JsId(JsGetProp(jsGlobal, ""Object"")), ""ObjectS."", ""keys,values,entries,assign,create,getPrototypeOf,setPrototypeOf,freeze,seal,preventExtensions,defineProperty,getOwnPropertyNames,is"")" + NL
    t = t + "    JsMethods(JsId(JsGetProp(jsGlobal, ""Array"")), ""ArrayS."", ""isArray,from,of"")" + NL
    t = t + "    JsMethods(JsId(JsGetProp(jsGlobal, ""Number"")), ""NumberS."", ""isInteger,isFinite,isNaN"")" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""Number"")), ""parseInt"", JsNative(""parseInt""))" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""Number"")), ""parseFloat"", JsNative(""parseFloat""))" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""Number"")), ""MAX_SAFE_INTEGER"", JsN(9007199254740991))" + NL
    t = t + "    o = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(o, ""JSON."", ""parse,stringify"")" + NL
    t = t + "    JsPutOwn(jsGlobal, ""JSON"", JsO(o))" + NL
    t = t + "    ' the errors: Error.prototype, and its kinds made from it" + NL
    t = t + "    o = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsPutOwn(o, ""name"", JsS(""Error""))" + NL
    t = t + "    JsPutOwn(o, ""message"", JsS(""""))" + NL
    t = t + "    JsPutOwn(o, ""constructor"", JsGetProp(jsGlobal, ""Error""))" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""Error"")), ""prototype"", JsO(o))" + NL
    t = t + "    jsErrorProto = o" + NL
    t = t + "    FOR EACH kind IN [""TypeError"", ""RangeError"", ""SyntaxError"", ""ReferenceError""]" + NL
    t = t + "        o = JsNewObject(""Object"", jsErrorProto)" + NL
    t = t + "        JsPutOwn(o, ""name"", JsS(kind))" + NL
    t = t + "        JsPutOwn(JsId(JsGetProp(jsGlobal, kind)), ""prototype"", JsO(o))" + NL
    t = t + "    NEXT" + NL
    t = t + "" + NL
    t = t + "    mathObj = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(mathObj, ""Math."", ""abs,floor,ceil,round,random,max,min,sqrt,pow,sin,cos,tan,atan,exp,log"")" + NL
    t = t + "    JsPutOwn(mathObj, ""PI"", JsN(MATH.Pi))" + NL
    t = t + "    JsPutOwn(mathObj, ""E"", JsN(MATH.Exp(1)))" + NL
    t = t + "    JsPutOwn(mathObj, ""LN2"", JsN(MATH.Log(2)))" + NL
    t = t + "    JsPutOwn(mathObj, ""LN10"", JsN(MATH.Log(10)))" + NL
    t = t + "    JsPutOwn(mathObj, ""SQRT2"", JsN(MATH.Sqrt(2)))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""Math"", JsO(mathObj))" + NL
    t = t + "" + NL
    t = t + "    jsDocument = JsNewObject(""Document"", jsObjectProto)" + NL
    t = t + "    JsMethods(jsDocument, ""document."", ""write,writeln,getElementById"")" + NL
    t = t + "    JsPutOwn(jsDocument, ""open"", JsNative(""noop""))" + NL
    t = t + "    JsPutOwn(jsDocument, ""close"", JsNative(""noop""))" + NL
    t = t + "    jsFormsArray = JsNewArray(none)" + NL
    t = t + "    JsPutOwn(jsDocument, ""forms"", JsO(jsFormsArray))" + NL
    t = t + "    JsPutOwn(jsDocument, ""images"", JsO(JsNewArray(none)))" + NL
    t = t + "    JsPutOwn(jsDocument, ""links"", JsO(JsNewArray(none)))" + NL
    t = t + "    JsPutOwn(jsDocument, ""bgColor"", JsS(""#FFFFFF""))" + NL
    t = t + "    JsPutOwn(jsDocument, ""fgColor"", JsS(""#000000""))" + NL
    t = t + "    JsPutOwn(jsDocument, ""all"", JsO(JsNewObject(""All"", jsObjectProto)))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""document"", JsO(jsDocument))" + NL
    t = t + "" + NL
    t = t + "    ' XMLHttpRequest, IE's ActiveXObject for it, and fetch" + NL
    t = t + "    jsXhrProto = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(jsXhrProto, ""XHR."", ""open,setRequestHeader,send,abort,getResponseHeader,getAllResponseHeaders"")" + NL
    t = t + "    jsPromiseProto = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(jsPromiseProto, ""Promise."", ""then,catch"")" + NL
    t = t + "    JsPutOwn(JsId(JsGetProp(jsGlobal, ""Promise"")), ""prototype"", JsO(jsPromiseProto))" + NL
    t = t + "    JsMethods(JsId(JsGetProp(jsGlobal, ""Promise"")), ""PromiseS."", ""resolve,reject,all,race"")" + NL
    t = t + "    jqP.Clear()" + NL
    t = t + "    jqOk.Clear()" + NL
    t = t + "    jqErr.Clear()" + NL
    t = t + "    jqChild.Clear()" + NL
    t = t + "    JsMethods(jsGlobal, """", ""XMLHttpRequest,ActiveXObject,fetch"")" + NL
    t = t + "" + NL
    t = t + "    jsLocation = JsNewObject(""Location"", jsObjectProto)" + NL
    t = t + "    JsPutOwn(jsDocument, ""location"", JsO(jsLocation))" + NL
    t = t + "" + NL
    t = t + "    o = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsMethods(o, ""history."", ""back,forward,go"")" + NL
    t = t + "    JsPutOwn(o, ""length"", JsN(HostHistory(0)))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""history"", JsO(o))" + NL
    t = t + "" + NL
    t = t + "    o = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsPutOwn(o, ""appName"", JsS(""Simxplorer""))" + NL
    t = t + "    JsPutOwn(o, ""appCodeName"", JsS(""Mozilla""))" + NL
    t = t + "    JsPutOwn(o, ""appVersion"", JsS(""2.0 (compatible; Simxplorer 3.02; SIM95)""))" + NL
    t = t + "    JsPutOwn(o, ""userAgent"", JsS(""Mozilla/2.0 (compatible; Simxplorer 3.02; SIM95)""))" + NL
    t = t + "    JsPutOwn(o, ""platform"", JsS(""SIM95""))" + NL
    t = t + "    JsPutOwn(o, ""javaEnabled"", JsNative(""navigator.javaEnabled""))" + NL
    t = t + "    JsPutOwn(jsGlobal, ""navigator"", JsO(o))" + NL
    t = t + "" + NL
    t = t + "    o = JsNewObject(""Object"", jsObjectProto)" + NL
    t = t + "    JsPutOwn(o, ""width"", ""n640"")" + NL
    t = t + "    JsPutOwn(o, ""height"", ""n480"")" + NL
    t = t + "    JsPutOwn(o, ""colorDepth"", ""n4"")" + NL
    t = t + "    JsPutOwn(jsGlobal, ""screen"", JsO(o))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Runs a script on the page. Returns """" or ""line|message""." + NL
    t = t + "FUNCTION JsRun (source AS String, firstLine AS Integer) AS String" + NL
    t = t + "    VAR prog AS Integer" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    jsDepth = 0" + NL
    t = t + "    jsSteps = 0" + NL
    t = t + "    jsLimit = JSSTEPLIMIT" + NL
    t = t + "    jsThrown = """"" + NL
    t = t + "    jsRet = ""u""" + NL
    t = t + "    jsLineBase = firstLine" + NL
    t = t + "    TRY" + NL
    t = t + "        prog = JsParse(source)" + NL
    t = t + "        JsHoist(prog, jsGlobal)" + NL
    t = t + "        JsExec(prog, jsGlobal)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        RETURN JsTidyError(err)" + NL
    t = t + "    END TRY" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Runs an event handler (onclick=""...""): like a function body, so ""return" + NL
    t = t + "' false"" works. The value it returned is in jsRet." + NL
    t = t + "FUNCTION JsHandler (code AS String) AS String" + NL
    t = t + "    RETURN JsRun(code, 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' An event handler on an element: a function body whose this is the element" + NL
    t = t + "' (thisVal), so onclick=""check(this.form)"" works. Its vars are its own." + NL
    t = t + "FUNCTION JsHandlerOn (code AS String, thisVal AS String) AS String" + NL
    t = t + "    VAR prog AS Integer" + NL
    t = t + "    VAR scope AS Integer" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    jsDepth = 0" + NL
    t = t + "    jsSteps = 0" + NL
    t = t + "    jsLimit = JSSTEPLIMIT" + NL
    t = t + "    jsThrown = """"" + NL
    t = t + "    jsRet = ""u""" + NL
    t = t + "    jsLineBase = 1" + NL
    t = t + "    TRY" + NL
    t = t + "        prog = JsParse(code)" + NL
    t = t + "        scope = JsNewScope(jsGlobal, thisVal)" + NL
    t = t + "        JsHoist(prog, scope)" + NL
    t = t + "        JsExec(prog, scope)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        RETURN JsTidyError(err)" + NL
    t = t + "    END TRY" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Calls a function value (for setTimeout(f, ms)). Returns """" or an error." + NL
    t = t + "FUNCTION JsCallValue (fn AS String) AS String" + NL
    t = t + "    VAR none AS Array OF String" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    jsDepth = 0" + NL
    t = t + "    jsSteps = 0" + NL
    t = t + "    jsLimit = JSSTEPLIMIT" + NL
    t = t + "    jsThrown = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        jsRet = JsCall(fn, JsO(jsGlobal), none)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        RETURN JsTidyError(err)" + NL
    t = t + "    END TRY" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JsTidyError (err AS String) AS String" + NL
    t = t + "    VAR thrown AS String" + NL
    t = t + "    jsSig = """"" + NL
    t = t + "    jsDepth = 0" + NL
    t = t + "    thrown = jsThrown" + NL
    t = t + "    jsThrown = """"" + NL
    t = t + "    IF err.Contains(""@thrown"") THEN" + NL
    t = t + "        IF thrown.StartsWith(""o"") THEN RETURN err.Substring(0, err.IndexOf(""|"")) + ""|Exception thrown and not caught: "" + JsStr(JsGet(thrown, ""message""))" + NL
    t = t + "        RETURN err.Substring(0, err.IndexOf(""|"")) + ""|Exception thrown and not caught: "" + JsStr(thrown)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF err.Contains(""@aborted"") THEN RETURN Str(jsLine) + ""|@aborted""" + NL
    t = t + "    IF err.Contains(""Stack overflow"") THEN RETURN Str(jsLine) + ""|Out of stack space""" + NL
    t = t + "    IF err.Contains(""|"") AND OnlyChars(err.Substring(0, err.IndexOf(""|"")), ""0123456789"") AND err.IndexOf(""|"") > 0 THEN RETURN err" + NL
    t = t + "    RETURN Str(jsLine) + ""|"" + err" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' BROWSER.SPK - Simxplorer for SIM95: the window, fetching," + NL
    t = t + "' and the glue between pages and the JavaScript engine (JSCRIPT.SPK). The" + NL
    t = t + "' builder joins the two into C:\PROGRAMS\SIMXPLOR.SPK." + NL
    t = t + "'" + NL
    t = t + "' How a page is shown:" + NL
    t = t + "'   1. It is fetched with HTTP/1.0, the way Voyager does (same cookie jar)." + NL
    t = t + "'   2. Its <script> blocks come out (SPARK ones are left to Voyager)." + NL
    t = t + "'   3. Forms and event attributes are rewritten so the page talks to us:" + NL
    t = t + "'      every form field gets an id, onclick=""code"" becomes onclick=""js:N""" + NL
    t = t + "'      (N indexes the code here), and every form's action becomes" + NL
    t = t + "'      ""sxsubmit:N"" so a sent form comes back to us first, for its onsubmit." + NL
    t = t + "'   4. The scripts run in order, and what they document.write() takes their" + NL
    t = t + "'      place. Then the page is drawn, and <body onload> runs." + NL
    t = t + "'" + NL
    t = t + "' Everything that waits on the network starts from a timer tick of its own," + NL
    t = t + "' inside a TRY with an empty CATCH: see the note in SIM95-NOTES.md." + NL
    t = t + "'" + NL
    t = t + "' Files: C:\SYSTEM\SIMXPLOR.INI (home, search, mail), C:\SYSTEM\FAVORITE.TXT" + NL
    t = t + "' (title|url), C:\SYSTEM\HISTORY.TXT (when|title|url), and Voyager's" + NL
    t = t + "' C:\SYSTEM\COOKIES.TXT (HOST|name|value). Names like www.coolsite.sim are" + NL
    t = t + "' asked of the SimDNS name server (the central one, or the one in" + NL
    t = t + "' C:\SYSTEM\RESOLV.INI; the builder adds simweb/src/RESOLVE.SPK, the Rs..." + NL
    t = t + "' names): see AskFirst." + NL
    t = t + "" + NL
    t = t + "CONST APPTITLE = ""Simxplorer""" + NL
    t = t + "CONST APPAGENT = ""Mozilla/2.0 (compatible; Simxplorer 3.02; SIM95)""" + NL
    t = t + "CONST APPPATH = ""C:\PROGRAMS\SIMXPLOR.SPK""" + NL
    t = t + "CONST INIFILE = ""C:\SYSTEM\SIMXPLOR.INI""" + NL
    t = t + "CONST FAVFILE = ""C:\SYSTEM\FAVORITE.TXT""" + NL
    t = t + "CONST HISTFILE = ""C:\SYSTEM\HISTORY.TXT""" + NL
    t = t + "CONST JARFILE = ""C:\SYSTEM\COOKIES.TXT""" + NL
    t = t + "CONST BOOKFILE = ""C:\SYSTEM\BOOKMARK.TXT""" + NL
    t = t + "CONST PATIENCE = 6000          ' milliseconds to wait for a server, as Voyager does" + NL
    t = t + "CONST TICKMS = 50                ' the clock: fetches, timers, the spinning logo" + NL
    t = t + "CONST MAXIMAGES = 40           ' pictures kept for the next page" + NL
    t = t + "" + NL
    t = t + "VAR EOL AS String" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the window" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR bar AS GUI_Menu" + NL
    t = t + "VAR tools AS GUI_Canvas            ' the toolbar, drawn: icons over labels" + NL
    t = t + "VAR tbPressed AS Integer = -1      ' the button held down" + NL
    t = t + "VAR tbDrawn AS String              ' what the toolbar looked like last time" + NL
    t = t + "VAR throb AS GUI_Canvas" + NL
    t = t + "VAR lblAddress AS GUI_Label" + NL
    t = t + "VAR address AS GUI_TextBox" + NL
    t = t + "VAR bGo AS GUI_Button" + NL
    t = t + "VAR view AS GUI_HtmlView" + NL
    t = t + "VAR progress AS GUI_ProgressBar" + NL
    t = t + "VAR zone AS GUI_Label" + NL
    t = t + "VAR clock AS GUI_Timer" + NL
    t = t + "VAR web AS NET_Socket" + NL
    t = t + "VAR favMenu AS Array OF String     ' the Favorites items as they are in the menu" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- settings" + NL
    t = t + "VAR optHome AS String" + NL
    t = t + "VAR optSearch AS String            ' with %s where the words go" + NL
    t = t + "VAR optMail AS String" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- where we are" + NL
    t = t + "VAR hist AS Array OF String        ' Back and Forward" + NL
    t = t + "VAR histPos AS Integer = -1" + NL
    t = t + "VAR curUrl AS String" + NL
    t = t + "VAR curSource AS String            ' the page as it came, for View Source" + NL
    t = t + "VAR curTitle AS String" + NL
    t = t + "VAR curStatus AS String = ""Done""" + NL
    t = t + "VAR referrer AS String" + NL
    t = t + "VAR throbStep AS Integer" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- fetching" + NL
    t = t + "' One fetch at a time: the page first, then its pictures." + NL
    t = t + "VAR pPending AS Bool               ' a page is wanted" + NL
    t = t + "VAR pUrl AS String" + NL
    t = t + "VAR pBody AS String                ' POST body, or """" for GET" + NL
    t = t + "VAR pPost AS Bool" + NL
    t = t + "VAR pHist AS Bool                  ' add it to Back/Forward" + NL
    t = t + "VAR pHops AS Integer               ' redirects followed so far" + NL
    t = t + "VAR imgWant AS Array OF String     ' absolute URLs still to fetch" + NL
    t = t + "VAR imgSrc AS Array OF String      ' the src the page used for each" + NL
    t = t + "VAR imgUrls AS Array OF String     ' pictures already here" + NL
    t = t + "VAR imgData AS Array OF String" + NL
    t = t + "" + NL
    t = t + "VAR fetching AS Bool" + NL
    t = t + "VAR fKind AS String                ' ""page"" or ""img""" + NL
    t = t + "VAR fUrl AS String" + NL
    t = t + "VAR fSrc AS String" + NL
    t = t + "VAR fNumber AS Integer" + NL
    t = t + "VAR fParts AS Array OF String" + NL
    t = t + "VAR fDone AS Bool" + NL
    t = t + "VAR fSince AS Integer" + NL
    t = t + "VAR fError AS String" + NL
    t = t + "VAR fStatus AS Integer" + NL
    t = t + "VAR fHeaders AS Array OF String    ' ""name: value"", names in lower case" + NL
    t = t + "VAR fBodyText AS String" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- XMLHttpRequest" + NL
    t = t + "' What the page's scripts asked for, each on a connection of its own (xweb)," + NL
    t = t + "' several at once. Like everything else they start from a timer tick, one a" + NL
    t = t + "' tick. A request is forgotten when its page goes." + NL
    t = t + "VAR xweb AS NET_Socket" + NL
    t = t + "VAR xSerial AS Array OF Integer    ' its number; its connection's Tag is ""x"" + it" + NL
    t = t + "VAR xObj AS Array OF Integer       ' the XMLHttpRequest in the engine" + NL
    t = t + "VAR xMethod AS Array OF String" + NL
    t = t + "VAR xUrl AS Array OF String" + NL
    t = t + "VAR xHeaders AS Array OF String    ' the script's own, one ""Name: value"" a line" + NL
    t = t + "VAR xBody AS Array OF String" + NL
    t = t + "VAR xState AS Array OF String      ' ""wait"" (to be sent), ""sent"", ""done"" (in, or failed)" + NL
    t = t + "VAR xRaw AS Array OF String        ' what came back so far, the messages joined" + NL
    t = t + "VAR xGot AS Array OF Integer       ' how many messages that is" + NL
    t = t + "VAR xError AS Array OF String" + NL
    t = t + "VAR xSince AS Array OF Integer" + NL
    t = t + "VAR xShown AS Array OF Integer     ' the readyState the page has been told" + NL
    t = t + "VAR xCount AS Integer              ' numbers handed out so far" + NL
    t = t + "VAR xLast AS Integer               ' when the last one started" + NL
    t = t + "VAR hpStatus AS Integer            ' a response taken apart by XhrParse" + NL
    t = t + "VAR hpReason AS String" + NL
    t = t + "VAR hpHeaders AS String" + NL
    t = t + "VAR hpBody AS String" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- names" + NL
    t = t + "' Two lookups of one name at once lose the first for good (SIM95-NOTES.md)," + NL
    t = t + "' so they go one at a time, and an address found is kept for a while." + NL
    t = t + "VAR resolving AS Bool" + NL
    t = t + "VAR dnsName AS Array OF String" + NL
    t = t + "VAR dnsAddr AS Array OF String" + NL
    t = t + "VAR dnsAt AS Array OF Integer" + NL
    t = t + "CONST DNSKEEP = 30000          ' milliseconds an address is kept" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the page's scripts" + NL
    t = t + "VAR busy AS Bool                   ' the engine or the page is in use: events wait" + NL
    t = t + "VAR rendered AS Bool               ' the HtmlView has the page" + NL
    t = t + "VAR scriptsOn AS Bool              ' FALSE once the user says No to a script error" + NL
    t = t + "VAR sparkSubs AS String            ' ""|name|"" for every SUB in a SPARK script (Voyager's)" + NL
    t = t + "VAR scCode AS Array OF String      ' the page's JavaScript blocks, in order" + NL
    t = t + "VAR scLine AS Array OF Integer     ' the line each starts on" + NL
    t = t + "VAR hCode AS Array OF String       ' js:N handlers: the code" + NL
    t = t + "VAR hHref AS Array OF String       ' for a link, where it goes afterwards" + NL
    t = t + "VAR hAfter AS Array OF String      ' ""submit:form:field"" to send a form afterwards" + NL
    t = t + "VAR hThis AS Array OF String       ' the element's id, for this" + NL
    t = t + "VAR hTyped AS Array OF Bool        ' on a text box: onchange waits for a pause in the typing" + NL
    t = t + "VAR changeWait AS Integer = -1     ' that handler, and when it is due" + NL
    t = t + "VAR changeAt AS Integer" + NL
    t = t + "VAR fmAction AS Array OF String" + NL
    t = t + "VAR fmMethod AS Array OF String" + NL
    t = t + "VAR fmName AS Array OF String" + NL
    t = t + "VAR fmSubmit AS Array OF String    ' onsubmit code" + NL
    t = t + "VAR fmObj AS Array OF Integer      ' its object in the engine (0 until registered)" + NL
    t = t + "VAR fdForm AS Array OF Integer" + NL
    t = t + "VAR fdName AS Array OF String" + NL
    t = t + "VAR fdId AS Array OF String" + NL
    t = t + "VAR fdType AS Array OF String" + NL
    t = t + "VAR fdValue AS Array OF String" + NL
    t = t + "VAR shKey AS Array OF String       ' ""id|Prop"" for elements the view does not have (yet)" + NL
    t = t + "VAR shVal AS Array OF String" + NL
    t = t + "VAR shDirty AS Array OF String     ' shKey entries a script changed before the page was drawn" + NL
    t = t + "VAR inForm AS Integer = -1" + NL
    t = t + "VAR autoIds AS Integer             ' ids given to elements that had none" + NL
    t = t + "VAR bodyOnload AS String" + NL
    t = t + "VAR refreshAt AS Integer" + NL
    t = t + "VAR refreshUrl AS String" + NL
    t = t + "VAR tmId AS Array OF Integer       ' setTimeout / setInterval" + NL
    t = t + "VAR tmDue AS Array OF Integer" + NL
    t = t + "VAR tmCode AS Array OF String" + NL
    t = t + "VAR tmFn AS Array OF String" + NL
    t = t + "VAR tmEvery AS Array OF Integer" + NL
    t = t + "VAR tmNext AS Integer = 1" + NL
    t = t + "" + NL
    t = t + "' ================================================================ start" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    VAR first AS String" + NL
    t = t + "    VAR zw AS String" + NL
    t = t + "    EOL = Chr(10)" + NL
    t = t + "    zw = Chr(8203)    ' shown, but left to the text boxes: they cut, copy and paste themselves" + NL
    t = t + "    LoadSettings()" + NL
    t = t + "    win = GUI_Window.New(APPTITLE, 720, 480)" + NL
    t = t + "    win.Icon = ""voyager""" + NL
    t = t + "    win.Resizable = TRUE" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    win.onResize = Win_OnResize" + NL
    t = t + "    win.onKey = Win_OnKey" + NL
    t = t + "" + NL
    t = t + "    ' Shortcuts are written the way SIM95 names keys, so the menu fires them itself" + NL
    t = t + "    bar = GUI_Menu.New(win)" + NL
    t = t + "    bar.onSelect = Menu_OnSelect" + NL
    t = t + "    bar.AddMenu(""&File"")" + NL
    t = t + "    bar.AddItem(""&File"", ""&New Window"" + Chr(9) + ""Ctrl+N"")" + NL
    t = t + "    bar.AddItem(""&File"", ""&Open..."" + Chr(9) + ""Ctrl+O"")" + NL
    t = t + "    bar.AddItem(""&File"", ""Save &As File..."" + Chr(9) + ""Ctrl+S"")" + NL
    t = t + "    bar.AddSeparator(""&File"")" + NL
    t = t + "    bar.AddItem(""&File"", ""&Close"" + Chr(9) + ""Ctrl+W"")" + NL
    t = t + "    bar.AddMenu(""&Edit"")" + NL
    t = t + "    bar.AddItem(""&Edit"", ""Cu&t"" + Chr(9) + ""Ctrl+X"" + zw)" + NL
    t = t + "    bar.AddItem(""&Edit"", ""&Copy"" + Chr(9) + ""Ctrl+C"" + zw)" + NL
    t = t + "    bar.AddItem(""&Edit"", ""&Paste"" + Chr(9) + ""Ctrl+V"" + zw)" + NL
    t = t + "    bar.AddSeparator(""&Edit"")" + NL
    t = t + "    bar.AddItem(""&Edit"", ""Select &All"" + Chr(9) + ""Ctrl+A"" + zw)" + NL
    t = t + "    bar.AddSeparator(""&Edit"")" + NL
    t = t + "    bar.AddItem(""&Edit"", ""&Find (on This Page)..."" + Chr(9) + ""Ctrl+F"")" + NL
    t = t + "    bar.AddItem(""&Edit"", ""Find &Next"" + Chr(9) + ""F3"")" + NL
    t = t + "    bar.AddMenu(""&View"")" + NL
    t = t + "    bar.AddItem(""&View"", ""&Stop"" + Chr(9) + ""Esc"")" + NL
    t = t + "    bar.AddItem(""&View"", ""&Refresh"" + Chr(9) + ""F5"")" + NL
    t = t + "    bar.AddItem(""&View"", ""Sour&ce"" + Chr(9) + ""Ctrl+U"")" + NL
    t = t + "    bar.AddSeparator(""&View"")" + NL
    t = t + "    bar.AddItem(""&View"", ""&Options..."")" + NL
    t = t + "    bar.AddMenu(""&Go"")" + NL
    t = t + "    bar.AddItem(""&Go"", ""&Back"" + Chr(9) + ""Alt+Left"")" + NL
    t = t + "    bar.AddItem(""&Go"", ""&Forward"" + Chr(9) + ""Alt+Right"")" + NL
    t = t + "    bar.AddItem(""&Go"", ""&Address Bar"" + Chr(9) + ""Alt+D"")" + NL
    t = t + "    bar.AddSeparator(""&Go"")" + NL
    t = t + "    bar.AddItem(""&Go"", ""&Start Page"" + Chr(9) + ""Alt+Home"")" + NL
    t = t + "    bar.AddItem(""&Go"", ""Search the &Web..."" + Chr(9) + ""Ctrl+E"")" + NL
    t = t + "    bar.AddItem(""&Go"", ""Read &Mail"" + Chr(9) + ""Ctrl+M"")" + NL
    t = t + "    bar.AddSeparator(""&Go"")" + NL
    t = t + "    bar.AddItem(""&Go"", ""&History"" + Chr(9) + ""Ctrl+H"")" + NL
    t = t + "    bar.AddMenu(""F&avorites"")" + NL
    t = t + "    BuildFavoritesMenu()" + NL
    t = t + "    bar.AddMenu(""&Help"")" + NL
    t = t + "    bar.AddItem(""&Help"", ""&Keyboard Shortcuts"" + Chr(9) + ""F1"")" + NL
    t = t + "    bar.AddItem(""&Help"", ""&About Simxplorer"")" + NL
    t = t + "" + NL
    t = t + "    tools = GUI_Canvas.New(win)" + NL
    t = t + "    tools.Background = 7" + NL
    t = t + "    tools.onDraw = Tools_OnDraw" + NL
    t = t + "    tools.onMouseDown = Tools_OnMouseDown" + NL
    t = t + "    tools.onMouseUp = Tools_OnMouseUp" + NL
    t = t + "    throb = GUI_Canvas.New(win)" + NL
    t = t + "    throb.onDraw = Throb_OnDraw" + NL
    t = t + "    throb.onMouseDown = Throb_OnMouseDown" + NL
    t = t + "    lblAddress = GUI_Label.New(win)" + NL
    t = t + "    lblAddress.Text = ""A&ddress""" + NL
    t = t + "    address = GUI_TextBox.New(win)" + NL
    t = t + "    address.onEnter = Address_OnEnter" + NL
    t = t + "    bGo = GUI_Button.New(win)" + NL
    t = t + "    bGo.Text = ""Go""" + NL
    t = t + "    bGo.onClick = Go_Click" + NL
    t = t + "    view = GUI_HtmlView.New(win)" + NL
    t = t + "    view.onNavigate = View_OnNavigate" + NL
    t = t + "    view.onSubmit = View_OnSubmit" + NL
    t = t + "    view.onScript = View_OnScript" + NL
    t = t + "    view.onStatus = View_OnStatus" + NL
    t = t + "    view.onImage = View_OnImage" + NL
    t = t + "    progress = GUI_ProgressBar.New(win)" + NL
    t = t + "    progress.Max = 100" + NL
    t = t + "    MakeFindWindow()" + NL
    t = t + "    zone = GUI_Label.New(win)" + NL
    t = t + "    zone.Align = ""right""" + NL
    t = t + "    Win_OnResize()" + NL
    t = t + "" + NL
    t = t + "    web = NET_Socket.New()" + NL
    t = t + "    web.onMessage = Web_OnMessage" + NL
    t = t + "    web.onClose = Web_OnClose" + NL
    t = t + "    xweb = NET_Socket.New()" + NL
    t = t + "    xweb.onMessage = Xhr_OnMessage" + NL
    t = t + "    xweb.onClose = Xhr_OnClose" + NL
    t = t + "    clock = GUI_Timer.New(win)" + NL
    t = t + "    clock.Interval = TICKMS" + NL
    t = t + "    clock.onTick = Clock_OnTick" + NL
    t = t + "    clock.Start()" + NL
    t = t + "" + NL
    t = t + "    JsReset()" + NL
    t = t + "    Buttons()" + NL
    t = t + "    win.Status = ""Done""" + NL
    t = t + "    win.Show()" + NL
    t = t + "    first = optHome" + NL
    t = t + "    IF SYS.Args.Count > 0 THEN" + NL
    t = t + "        IF SYS.Args[0].Trim() <> """" THEN first = SYS.Args[0]" + NL
    t = t + "    END IF" + NL
    t = t + "    IF first = """" THEN first = ""about:blank""" + NL
    t = t + "    Go(Typed(first))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnResize ()" + NL
    t = t + "    VAR w AS Integer" + NL
    t = t + "    w = win.Width" + NL
    t = t + "    tools.SetBounds(0, 0, MATH.Min(w - 46, TBCOUNT * TBW + 4), TBH + 3)" + NL
    t = t + "    throb.SetBounds(w - 44, 1, 42, 46)" + NL
    t = t + "    lblAddress.SetBounds(6, 54, 50, 14)" + NL
    t = t + "    address.SetBounds(58, 50, w - 100, 21)" + NL
    t = t + "    bGo.SetBounds(w - 38, 50, 34, 21)" + NL
    t = t + "    view.SetBounds(2, 75, w - 4, win.Height - 97)" + NL
    t = t + "    progress.SetBounds(w - 260, win.Height - 19, 120, 16)" + NL
    t = t + "    zone.SetBounds(w - 136, win.Height - 18, 132, 14)" + NL
    t = t + "    tbDrawn = """"" + NL
    t = t + "    DrawTools()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Keys the menus do not take (only Ctrl, Alt and F-keys reach a menu)." + NL
    t = t + "SUB Win_OnKey (key AS String)" + NL
    t = t + "    SELECT CASE key" + NL
    t = t + "        CASE ""Alt+ArrowLeft""" + NL
    t = t + "            Back_Click()" + NL
    t = t + "        CASE ""Alt+ArrowRight""" + NL
    t = t + "            Forward_Click()" + NL
    t = t + "        CASE ""Escape""" + NL
    t = t + "            IF findWin.Visible THEN" + NL
    t = t + "                findWin.Hide()" + NL
    t = t + "            ELSE" + NL
    t = t + "                Stop_Click()" + NL
    t = t + "            END IF" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- settings" + NL
    t = t + "" + NL
    t = t + "SUB LoadSettings ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR here AS String" + NL
    t = t + "    here = ""http://"" + NET.HostName.Lower() + ""/""" + NL
    t = t + "    IF NOT FS.Exists(INIFILE) THEN" + NL
    t = t + "        ' First run: home is this machine, and the search engine and mail are" + NL
    t = t + "        ' this machine's AskSim and ColdMail when it has them." + NL
    t = t + "        optHome = here" + NL
    t = t + "        IF FS.Exists(""C:\WEB\ASK.SPK"") THEN optSearch = here + ""index.asp?q=%s""" + NL
    t = t + "        IF FS.Exists(""C:\WEB\ASK\ASK.SPK"") THEN optSearch = here + ""ask/index.asp?q=%s""" + NL
    t = t + "        IF FS.Exists(""C:\WEB\MAIL.SPK"") THEN optMail = here" + NL
    t = t + "        IF FS.Exists(""C:\WEB\MAIL\MAIL.SPK"") THEN optMail = here + ""mail/""" + NL
    t = t + "        SaveSettings()" + NL
    t = t + "        IF NOT FS.Exists(FAVFILE) THEN ImportBookmarks()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH line IN FS.Read(INIFILE).Lines()" + NL
    t = t + "        IF line.StartsWith(""home="") THEN optHome = line.Substring(5, line.Length - 5).Trim()" + NL
    t = t + "        IF line.StartsWith(""search="") THEN optSearch = line.Substring(7, line.Length - 7).Trim()" + NL
    t = t + "        IF line.StartsWith(""mail="") THEN optMail = line.Substring(5, line.Length - 5).Trim()" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SaveSettings ()" + NL
    t = t + "    TRY" + NL
    t = t + "        FS.Write(INIFILE, ""[Simxplorer]"" + EOL + ""home="" + optHome + EOL + ""search="" + optSearch + EOL + ""mail="" + optMail + EOL)" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Your Voyager bookmarks become Favorites the first time." + NL
    t = t + "SUB ImportBookmarks ()" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    IF FS.Exists(BOOKFILE) THEN out = FS.Read(BOOKFILE)" + NL
    t = t + "    IF out <> """" AND NOT out.EndsWith(EOL) THEN out = out + EOL" + NL
    t = t + "    TRY" + NL
    t = t + "        FS.Write(FAVFILE, out)" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- addresses" + NL
    t = t + "" + NL
    t = t + "FUNCTION HasScheme (u AS String) AS Bool" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    c = u.IndexOf("":"")" + NL
    t = t + "    IF c < 2 THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyChars(u.Substring(0, c).Lower(), ""abcdefghijklmnopqrstuvwxyz"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""bravo/x.htm"" -> ""http://bravo/x.htm""; host in lower case, a path always." + NL
    t = t + "FUNCTION Normal (u AS String) AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    VAR host AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    u = u.Trim()" + NL
    t = t + "    IF NOT HasScheme(u) THEN u = ""http://"" + u" + NL
    t = t + "    IF NOT u.Lower().StartsWith(""http://"") THEN RETURN u" + NL
    t = t + "    rest = u.Substring(7, u.Length - 7)" + NL
    t = t + "    IF rest.Contains(""/"") THEN" + NL
    t = t + "        host = rest.Substring(0, rest.IndexOf(""/""))" + NL
    t = t + "        path = rest.Substring(rest.IndexOf(""/""), rest.Length - rest.IndexOf(""/""))" + NL
    t = t + "    ELSE" + NL
    t = t + "        host = rest" + NL
    t = t + "        path = ""/""" + NL
    t = t + "        IF host.Contains(""?"") THEN" + NL
    t = t + "            path = ""/"" + host.Substring(host.IndexOf(""?""), host.Length - host.IndexOf(""?""))" + NL
    t = t + "            host = host.Substring(0, host.IndexOf(""?""))" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    IF host.EndsWith("":80"") THEN host = host.Substring(0, host.Length - 3)" + NL
    t = t + "    RETURN ""http://"" + host.Lower() + Dots(path)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Takes out ./ and dir/../ from a path (the query is left alone)." + NL
    t = t + "FUNCTION Dots (path AS String) AS String" + NL
    t = t + "    VAR query AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    IF path.Contains(""?"") THEN" + NL
    t = t + "        query = path.Substring(path.IndexOf(""?""), path.Length - path.IndexOf(""?""))" + NL
    t = t + "        path = path.Substring(0, path.IndexOf(""?""))" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT path.Contains(""./"") THEN RETURN path + query" + NL
    t = t + "    parts = path.Split(""/"")" + NL
    t = t + "    FOR EACH p IN parts" + NL
    t = t + "        IF p = "".."" THEN" + NL
    t = t + "            IF out.Count > 1 THEN out.RemoveAt(out.Count - 1)" + NL
    t = t + "        ELSEIF p <> ""."" THEN" + NL
    t = t + "            out.Add(p)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    p = out.Join(""/"")" + NL
    t = t + "    IF path.EndsWith(""/."") OR path.EndsWith(""/.."") THEN p = p + ""/""" + NL
    t = t + "    IF NOT p.StartsWith(""/"") THEN p = ""/"" + p" + NL
    t = t + "    RETURN p + query" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION HostOf (u AS String) AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    IF NOT u.Lower().StartsWith(""http://"") THEN RETURN """"" + NL
    t = t + "    rest = u.Substring(7, u.Length - 7)" + NL
    t = t + "    IF rest.Contains(""/"") THEN rest = rest.Substring(0, rest.IndexOf(""/""))" + NL
    t = t + "    IF rest.Contains("":"") THEN rest = rest.Substring(0, rest.IndexOf("":""))" + NL
    t = t + "    RETURN rest" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION PortOf (u AS String) AS Integer" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    rest = u.Substring(7, u.Length - 7)" + NL
    t = t + "    IF rest.Contains(""/"") THEN rest = rest.Substring(0, rest.IndexOf(""/""))" + NL
    t = t + "    IF NOT rest.Contains("":"") THEN RETURN 80" + NL
    t = t + "    RETURN Int(Val(rest.Substring(rest.IndexOf("":"") + 1, rest.Length - rest.IndexOf("":"") - 1)))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The path and query, without any #fragment." + NL
    t = t + "FUNCTION PathOf (u AS String) AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    rest = u.Substring(7, u.Length - 7)" + NL
    t = t + "    IF rest.Contains(""#"") THEN rest = rest.Substring(0, rest.IndexOf(""#""))" + NL
    t = t + "    IF NOT rest.Contains(""/"") THEN RETURN ""/""" + NL
    t = t + "    RETURN rest.Substring(rest.IndexOf(""/""), rest.Length - rest.IndexOf(""/""))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A link on the page at base, as a full address." + NL
    t = t + "FUNCTION Absolute (base AS String, href AS String) AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    VAR origin AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    h = href.Trim()" + NL
    t = t + "    IF h = """" THEN RETURN base" + NL
    t = t + "    IF HasScheme(h) THEN" + NL
    t = t + "        IF h.Lower().StartsWith(""http:"") THEN RETURN Normal(h)" + NL
    t = t + "        RETURN h" + NL
    t = t + "    END IF" + NL
    t = t + "    IF base.Lower().StartsWith(""file:"") THEN" + NL
    t = t + "        IF h.Contains("":\"") THEN RETURN ""file:"" + h" + NL
    t = t + "        RETURN base.Substring(0, LastAt(base, ""\"") + 1) + h.Replace(""/"", ""\"")" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT base.Lower().StartsWith(""http://"") THEN RETURN Normal(h)" + NL
    t = t + "    IF h.StartsWith(""//"") THEN RETURN Normal(""http:"" + h)" + NL
    t = t + "    origin = ""http://"" + base.Substring(7, base.Length - 7).Split(""/"")[0]" + NL
    t = t + "    path = PathOf(base)" + NL
    t = t + "    IF h.StartsWith(""/"") THEN RETURN Normal(origin + h)" + NL
    t = t + "    IF h.StartsWith(""?"") THEN" + NL
    t = t + "        IF path.Contains(""?"") THEN path = path.Substring(0, path.IndexOf(""?""))" + NL
    t = t + "        RETURN Normal(origin + path + h)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF h.StartsWith(""#"") THEN RETURN Normal(origin + path) + h" + NL
    t = t + "    IF path.Contains(""?"") THEN path = path.Substring(0, path.IndexOf(""?""))" + NL
    t = t + "    RETURN Normal(origin + Folder(path) + h)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LastAt (s AS String, part AS String) AS Integer" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR found AS Integer = -1" + NL
    t = t + "    at = s.IndexOf(part)" + NL
    t = t + "    WHILE at >= 0" + NL
    t = t + "        found = found + at + 1" + NL
    t = t + "        s = s.Substring(at + 1, s.Length - at - 1)" + NL
    t = t + "        at = s.IndexOf(part)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN found" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""/a/b.htm"" -> ""/a/""" + NL
    t = t + "FUNCTION Folder (path AS String) AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    parts = path.Split(""/"")" + NL
    t = t + "    RETURN path.Substring(0, path.Length - parts[parts.Count - 1].Length)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' What was typed in the Address box: an address, or (AutoSearch) words" + NL
    t = t + "' to look up: ""? chess"", ""go chess"", ""find chess clubs"", or any words at all." + NL
    t = t + "FUNCTION Typed (t AS String) AS String" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    t = t.Trim()" + NL
    t = t + "    low = t.Lower()" + NL
    t = t + "    IF t = """" THEN RETURN """"" + NL
    t = t + "    IF low.StartsWith(""? "") THEN RETURN SearchUrl(t.Substring(2, t.Length - 2))" + NL
    t = t + "    IF low.StartsWith(""go "") THEN RETURN SearchUrl(t.Substring(3, t.Length - 3))" + NL
    t = t + "    IF low.StartsWith(""find "") THEN RETURN SearchUrl(t.Substring(5, t.Length - 5))" + NL
    t = t + "    IF HasScheme(t) THEN" + NL
    t = t + "        IF low.StartsWith(""http:"") THEN RETURN Normal(t)" + NL
    t = t + "        RETURN t" + NL
    t = t + "    END IF" + NL
    t = t + "    IF t.Contains("" "") THEN RETURN SearchUrl(t)" + NL
    t = t + "    IF t.Contains("":\"") THEN RETURN ""file:"" + t" + NL
    t = t + "    RETURN Normal(t)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION SearchUrl (words AS String) AS String" + NL
    t = t + "    IF optSearch = """" THEN RETURN ""about:search?"" + UrlEnc(words.Trim())" + NL
    t = t + "    RETURN optSearch.Replace(""%s"", UrlEnc(words.Trim()))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UrlEnc (s AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        c = s.CharAt(i)" + NL
    t = t + "        IF c = "" "" THEN" + NL
    t = t + "            out = out + ""+""" + NL
    t = t + "        ELSEIF OnlyChars(c, ""abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_.*"") THEN" + NL
    t = t + "            out = out + c" + NL
    t = t + "        ELSEIF Asc(c) < 16 THEN" + NL
    t = t + "            out = out + ""%0"" + Hex(Asc(c))" + NL
    t = t + "        ELSEIF Asc(c) < 256 THEN" + NL
    t = t + "            out = out + ""%"" + Hex(Asc(c))" + NL
    t = t + "        ELSE" + NL
    t = t + "            out = out + ""%3F""" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UrlDec (s AS String) AS String" + NL
    t = t + "    RETURN JsUnescape(s.Replace(""+"", "" ""))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Text safe to put in a page." + NL
    t = t + "FUNCTION Esc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""&"", ""&amp;"").Replace(""<"", ""&lt;"").Replace("">"", ""&gt;"").Replace("""""""", ""&quot;"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unentity (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""&quot;"", """""""").Replace(""&#39;"", ""'"").Replace(""&lt;"", ""<"").Replace(""&gt;"", "">"").Replace(""&nbsp;"", "" "").Replace(""&amp;"", ""&"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ going places" + NL
    t = t + "" + NL
    t = t + "' Asks for a page. It is fetched on the next tick, never in the middle of a" + NL
    t = t + "' script or an event." + NL
    t = t + "SUB Go (url AS String)" + NL
    t = t + "    GoWith(url, """", FALSE, TRUE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB GoWith (url AS String, body AS String, post AS Bool, addHist AS Bool)" + NL
    t = t + "    IF url = """" THEN RETURN" + NL
    t = t + "    pUrl = url" + NL
    t = t + "    pBody = body" + NL
    t = t + "    pPost = post" + NL
    t = t + "    pHist = addHist" + NL
    t = t + "    pHops = 0" + NL
    t = t + "    pPending = TRUE" + NL
    t = t + "    ' a page that is still arriving is forgotten" + NL
    t = t + "    IF fetching AND fKind = ""page"" THEN CancelFetch()" + NL
    t = t + "    imgWant.Clear()" + NL
    t = t + "    imgSrc.Clear()" + NL
    t = t + "    Buttons()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB CancelFetch ()" + NL
    t = t + "    fetching = FALSE" + NL
    t = t + "    fNumber = fNumber + 1" + NL
    t = t + "    TRY" + NL
    t = t + "        web.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Buttons ()" + NL
    t = t + "    DrawTools()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Back_Click ()" + NL
    t = t + "    IF histPos > 0 THEN" + NL
    t = t + "        histPos = histPos - 1" + NL
    t = t + "        GoWith(hist[histPos], """", FALSE, FALSE)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Forward_Click ()" + NL
    t = t + "    IF histPos < hist.Count - 1 THEN" + NL
    t = t + "        histPos = histPos + 1" + NL
    t = t + "        GoWith(hist[histPos], """", FALSE, FALSE)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Stop_Click ()" + NL
    t = t + "    pPending = FALSE" + NL
    t = t + "    IF fetching THEN CancelFetch()" + NL
    t = t + "    imgWant.Clear()" + NL
    t = t + "    imgSrc.Clear()" + NL
    t = t + "    refreshAt = 0" + NL
    t = t + "    progress.Value = 0" + NL
    t = t + "    SetStatus(""Done"")" + NL
    t = t + "    Buttons()" + NL
    t = t + "    DrawThrob()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Refresh_Click ()" + NL
    t = t + "    IF curUrl <> """" THEN GoWith(curUrl, """", FALSE, FALSE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Home_Click ()" + NL
    t = t + "    IF optHome = """" THEN" + NL
    t = t + "        Go(""about:blank"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        Go(Typed(optHome))" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Search_Click ()" + NL
    t = t + "    IF optSearch = """" THEN" + NL
    t = t + "        Go(""about:search"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        Go(optSearch.Replace(""%s"", """").Replace(""?q="", """").Replace(""&q="", """"))" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "CONST MAILPROGRAM = ""C:\PROGRAMS\FROSTBRD.SPK""" + NL
    t = t + "" + NL
    t = t + "' The Mail button opens the mail program if this machine has one (Frostbird)," + NL
    t = t + "' or else the webmail set in Options." + NL
    t = t + "SUB Mail_Click ()" + NL
    t = t + "    IF FS.Exists(MAILPROGRAM) THEN" + NL
    t = t + "        SYS.Start(MAILPROGRAM, """")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF optMail = """" THEN" + NL
    t = t + "        Go(""about:mail"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        Go(Typed(optMail))" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Favorites_Click ()" + NL
    t = t + "    Go(""about:favorites"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB History_Click ()" + NL
    t = t + "    Go(""about:history"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Address_OnEnter ()" + NL
    t = t + "    Go(Typed(address.Text))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Go_Click ()" + NL
    t = t + "    Go(Typed(address.Text))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SetStatus (text AS String)" + NL
    t = t + "    curStatus = text" + NL
    t = t + "    win.Status = text" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the clock" + NL
    t = t + "" + NL
    t = t + "SUB Clock_OnTick ()" + NL
    t = t + "    ' Nothing may come after this TRY: a tick whose Connect failed is" + NL
    t = t + "    ' spoiled (see SIM95-NOTES.md), and this is how it ends quietly." + NL
    t = t + "    TRY" + NL
    t = t + "        Tick()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Tick ()" + NL
    t = t + "    throbStep = throbStep + 1" + NL
    t = t + "    IF (pPending OR fetching) AND throbStep MOD 2 = 0 THEN DrawThrob()" + NL
    t = t + "    IF NOT busy THEN" + NL
    t = t + "        TRY" + NL
    t = t + "            IF fetching AND (fDone OR SYS.Ticks - fSince > PATIENCE) THEN Arrived()" + NL
    t = t + "            IF pPending AND NOT fetching AND NOT pUrl.Lower().StartsWith(""http:"") THEN ShowLocal()" + NL
    t = t + "            IF NOT busy THEN RunTimers()" + NL
    t = t + "            IF NOT busy AND xSerial.Count > 0 THEN XhrPump()" + NL
    t = t + "            IF changeWait >= 0 AND SYS.Ticks >= changeAt AND NOT busy THEN FlushChange()" + NL
    t = t + "            IF refreshAt > 0 AND SYS.Ticks >= refreshAt AND NOT pPending AND NOT busy THEN" + NL
    t = t + "                refreshAt = 0" + NL
    t = t + "                GoWith(refreshUrl, """", FALSE, refreshUrl <> curUrl)" + NL
    t = t + "            END IF" + NL
    t = t + "        CATCH problem" + NL
    t = t + "            busy = FALSE" + NL
    t = t + "            fetching = FALSE" + NL
    t = t + "            Oops(problem)" + NL
    t = t + "        END TRY" + NL
    t = t + "    END IF" + NL
    t = t + "    ' Last of all, because it may be spoiled: start the next fetch. Only one" + NL
    t = t + "    ' Connect a tick: the page, else a script's request, else a picture. A" + NL
    t = t + "    ' name the name server must be asked about first takes a tick of its own." + NL
    t = t + "    IF resolving OR RsBusy() THEN RETURN" + NL
    t = t + "    IF NOT fetching AND NOT busy AND pPending THEN" + NL
    t = t + "        IF AskFirst(pUrl, TRUE) THEN RETURN" + NL
    t = t + "        StartFetch(""page"", pUrl, """")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' (spaced out even when ticks come late and all at once: answers that" + NL
    t = t + "    ' arrive together can lose their last message, see SIM95-NOTES.md)" + NL
    t = t + "    IF xState.IndexOf(""wait"") >= 0 AND SYS.Ticks - xLast >= TICKMS THEN" + NL
    t = t + "        IF AskFirst(xUrl[xState.IndexOf(""wait"")], FALSE) THEN RETURN" + NL
    t = t + "        xLast = SYS.Ticks" + NL
    t = t + "        StartXhr(xSerial[xState.IndexOf(""wait"")])" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT fetching AND NOT busy THEN" + NL
    t = t + "        IF imgWant.Count > 0 THEN" + NL
    t = t + "            IF AskFirst(imgWant[0], FALSE) THEN RETURN" + NL
    t = t + "            fSrc = imgSrc[0]" + NL
    t = t + "            imgSrc.RemoveAt(0)" + NL
    t = t + "            fUrl = imgWant[0]" + NL
    t = t + "            imgWant.RemoveAt(0)" + NL
    t = t + "            StartFetch(""img"", fUrl, fSrc)" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Oops (problem AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = APPTITLE" + NL
    t = t + "    box.Kind = ""error""" + NL
    t = t + "    box.Text = ""Simxplorer has run into a problem of its own:"" + EOL + EOL + problem" + NL
    t = t + "    box.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ fetching" + NL
    t = t + "" + NL
    t = t + "' A name the SimDNS name server may know (www.coolsite.sim) is asked about" + NL
    t = t + "' before anything is fetched from it: the name server's address (one" + NL
    t = t + "' lookup at a time, like any other), then the question, which is a Connect" + NL
    t = t + "' and so ends the tick. TRUE when it asked; the answer comes to RESOLVE.SPK," + NL
    t = t + "' and while it is on its way (RsBusy) nothing else starts. A name server" + NL
    t = t + "' that is down or silent is left alone for a while, and names go to SIM95" + NL
    t = t + "' as before. The address bar, the Host header and the cookies keep the" + NL
    t = t + "' name as typed; only the connection goes to the machine SimDNS named." + NL
    t = t + "FUNCTION AskFirst (url AS String, isPage AS Bool) AS Bool" + NL
    t = t + "    VAR host AS String" + NL
    t = t + "    IF NOT url.Lower().StartsWith(""http:"") THEN RETURN FALSE" + NL
    t = t + "    host = HostOf(url)" + NL
    t = t + "    IF host = """" OR NOT RsWants(host) THEN RETURN FALSE" + NL
    t = t + "    IF isPage THEN" + NL
    t = t + "        progress.Value = 5" + NL
    t = t + "        SetStatus(""Looking up "" + host + ""..."")" + NL
    t = t + "        DrawThrob()" + NL
    t = t + "    END IF" + NL
    t = t + "    ' the name server's address (one lookup at a time, shared with the" + NL
    t = t + "    ' built-in SimPlayer), then the question: a Connect, the last thing" + NL
    t = t + "    RETURN RsNext(host)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The address of a host. Only one lookup is ever under way (the tick waits" + NL
    t = t + "' for it); an address found is kept for DNSKEEP. """" when nobody has the name." + NL
    t = t + "FUNCTION Lookup (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    i = dnsName.IndexOf(host.Upper())" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        IF SYS.Ticks - dnsAt[i] < DNSKEEP THEN RETURN dnsAddr[i]" + NL
    t = t + "        dnsName.RemoveAt(i)" + NL
    t = t + "        dnsAddr.RemoveAt(i)" + NL
    t = t + "        dnsAt.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    resolving = TRUE" + NL
    t = t + "    addr = NET.Resolve(host)" + NL
    t = t + "    resolving = FALSE" + NL
    t = t + "    IF addr <> """" AND dnsName.IndexOf(host.Upper()) < 0 THEN" + NL
    t = t + "        dnsName.Add(host.Upper())" + NL
    t = t + "        dnsAddr.Add(addr)" + NL
    t = t + "        dnsAt.Add(SYS.Ticks)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN addr" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Opens the connection and sends the request, as Voyager does. What comes back" + NL
    t = t + "' arrives through Web_OnMessage until the server closes." + NL
    t = t + "SUB StartFetch (kind AS String, url AS String, src AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    VAR mine AS Integer" + NL
    t = t + "    VAR request AS String" + NL
    t = t + "    VAR cookie AS String" + NL
    t = t + "    fetching = TRUE" + NL
    t = t + "    fKind = kind" + NL
    t = t + "    fUrl = url" + NL
    t = t + "    fSrc = src" + NL
    t = t + "    fNumber = fNumber + 1" + NL
    t = t + "    fParts.Clear()" + NL
    t = t + "    fDone = FALSE" + NL
    t = t + "    fSince = SYS.Ticks" + NL
    t = t + "    fError = """"" + NL
    t = t + "    IF kind = ""page"" THEN" + NL
    t = t + "        pPending = FALSE" + NL
    t = t + "        progress.Value = 10" + NL
    t = t + "        SetStatus(""Finding site: "" + HostOf(url))" + NL
    t = t + "        Buttons()" + NL
    t = t + "        request = ""GET""" + NL
    t = t + "        IF pPost THEN request = ""POST""" + NL
    t = t + "    ELSE" + NL
    t = t + "        request = ""GET""" + NL
    t = t + "    END IF" + NL
    t = t + "    request = request + "" "" + PathOf(url) + "" HTTP/1.0"" + EOL + ""Host: "" + HostOf(url) + EOL + ""User-Agent: "" + APPAGENT + EOL + ""Accept: */*""" + NL
    t = t + "    IF kind = ""page"" AND referrer.StartsWith(""http:"") THEN request = request + EOL + ""Referer: "" + referrer" + NL
    t = t + "    cookie = CookieHeader(HostOf(url))" + NL
    t = t + "    IF cookie <> """" THEN request = request + EOL + ""Cookie: "" + cookie" + NL
    t = t + "    IF kind = ""page"" AND pPost THEN" + NL
    t = t + "        request = request + EOL + ""Content-Type: application/x-www-form-urlencoded"" + EOL + ""Content-Length: "" + Str(pBody.Length) + EOL + EOL + pBody" + NL
    t = t + "    ELSE" + NL
    t = t + "        request = request + EOL" + NL
    t = t + "    END IF" + NL
    t = t + "    IF request.Length > 65000 THEN" + NL
    t = t + "        fError = ""Message too long: the form is too big to send.""" + NL
    t = t + "        fDone = TRUE" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    mine = fNumber" + NL
    t = t + "    ' (www.coolsite.sim: to the machine SimDNS said it is on)" + NL
    t = t + "    IF kind = ""page"" AND RsKnown(HostOf(url)) THEN SetStatus(""Connecting to "" + RsTarget(HostOf(url)) + ""..."")" + NL
    t = t + "    addr = Lookup(RsTarget(HostOf(url)))" + NL
    t = t + "    ' (Stop, or another page, while we looked)" + NL
    t = t + "    IF mine <> fNumber THEN RETURN" + NL
    t = t + "    IF addr = """" THEN" + NL
    t = t + "        fError = ""Unknown host: "" + HostOf(url)" + NL
    t = t + "        fDone = TRUE" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = web.Connect(addr, PortOf(url))" + NL
    t = t + "        conn.Tag = Str(fNumber)" + NL
    t = t + "        IF kind = ""page"" THEN" + NL
    t = t + "            progress.Value = 40" + NL
    t = t + "            SetStatus(""Web site found. Waiting for reply..."")" + NL
    t = t + "        END IF" + NL
    t = t + "        conn.Send(request)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        fError = err" + NL
    t = t + "        fDone = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "    ' Nothing else may wait in this tick." + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    IF conn.Tag = Str(fNumber) AND fetching AND NOT fDone THEN" + NL
    t = t + "        fParts.Add(message)" + NL
    t = t + "        IF fKind = ""page"" THEN progress.Value = 70" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnClose (conn AS NET_Connection)" + NL
    t = t + "    IF conn.Tag = Str(fNumber) THEN fDone = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The response is in: fStatus (0 when there was none), fHeaders, fBodyText." + NL
    t = t + "SUB ReadResponse ()" + NL
    t = t + "    VAR raw AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR body AS Array OF String" + NL
    t = t + "    fStatus = 0" + NL
    t = t + "    fHeaders.Clear()" + NL
    t = t + "    fBodyText = """"" + NL
    t = t + "    raw = fParts.Join(EOL)" + NL
    t = t + "    IF fError <> """" THEN RETURN" + NL
    t = t + "    IF raw = """" THEN" + NL
    t = t + "        fError = ""Connection timed out""" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT raw.StartsWith(""HTTP/"") THEN" + NL
    t = t + "        ' an old-fashioned server that sends just the page" + NL
    t = t + "        fStatus = 200" + NL
    t = t + "        fBodyText = raw" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    lines = raw.Split(EOL)" + NL
    t = t + "    fStatus = Int(Val(lines[0].Split("" "")[1]))" + NL
    t = t + "    i = 1" + NL
    t = t + "    WHILE i < lines.Count" + NL
    t = t + "        line = lines[i].Replace(Chr(13), """")" + NL
    t = t + "        i = i + 1" + NL
    t = t + "        IF line.Trim() = """" THEN BREAK" + NL
    t = t + "        IF line.Contains("":"") THEN fHeaders.Add(line.Substring(0, line.IndexOf("":"")).Trim().Lower() + "": "" + line.Substring(line.IndexOf("":"") + 1, line.Length - line.IndexOf("":"") - 1).Trim())" + NL
    t = t + "    END WHILE" + NL
    t = t + "    WHILE i < lines.Count" + NL
    t = t + "        body.Add(lines[i])" + NL
    t = t + "        i = i + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    fBodyText = body.Join(EOL)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Header (name AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN fHeaders" + NL
    t = t + "        IF line.StartsWith(name + "": "") THEN RETURN line.Substring(name.Length + 2, line.Length - name.Length - 2)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Arrived ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR moved AS String" + NL
    t = t + "    fetching = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        web.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    ReadResponse()" + NL
    t = t + "    FOR EACH line IN fHeaders" + NL
    t = t + "        IF line.StartsWith(""set-cookie: "") THEN TakeCookie(HostOf(fUrl), line.Substring(12, line.Length - 12))" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF fKind = ""img"" THEN" + NL
    t = t + "        IF fStatus = 200 AND fBodyText.StartsWith(""SIM95PIC"") THEN" + NL
    t = t + "            KeepImage(fUrl, fBodyText)" + NL
    t = t + "            view.SetImage(fSrc, fBodyText)" + NL
    t = t + "            ' the same picture may be on the page more than once" + NL
    t = t + "            WHILE imgWant.IndexOf(fUrl) >= 0" + NL
    t = t + "                view.SetImage(imgSrc[imgWant.IndexOf(fUrl)], fBodyText)" + NL
    t = t + "                imgSrc.RemoveAt(imgWant.IndexOf(fUrl))" + NL
    t = t + "                imgWant.RemoveAt(imgWant.IndexOf(fUrl))" + NL
    t = t + "            END WHILE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF imgWant.Count = 0 AND NOT pPending THEN" + NL
    t = t + "            progress.Value = 0" + NL
    t = t + "            DrawThrob()" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    moved = Header(""location"")" + NL
    t = t + "    IF fStatus >= 300 AND fStatus < 400 AND moved <> """" AND pHops < 5 THEN" + NL
    t = t + "        pUrl = Absolute(fUrl, moved)" + NL
    t = t + "        pPost = FALSE" + NL
    t = t + "        pBody = """"" + NL
    t = t + "        pHops = pHops + 1" + NL
    t = t + "        pPending = TRUE" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF fStatus = 0 THEN" + NL
    t = t + "        CannotOpen(fUrl, fError)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF fStatus >= 400 AND fBodyText.Trim() = """" THEN" + NL
    t = t + "        ShowPage(fUrl, FriendlyError(fStatus, fUrl), pHist)" + NL
    t = t + "    ELSEIF fBodyText.StartsWith(""SIM95PIC"") THEN" + NL
    t = t + "        KeepImage(fUrl, fBodyText)" + NL
    t = t + "        ShowPage(fUrl, ""<html><head><title>"" + Esc(fUrl) + ""</title></head><body><img src="""""" + Esc(fUrl) + """"""></body></html>"", pHist)" + NL
    t = t + "    ELSEIF Header(""content-type"").StartsWith(""video/x-simmovie"") OR fBodyText.StartsWith(""SIMMOVIE"") THEN" + NL
    t = t + "        PlayMovie(fUrl)" + NL
    t = t + "    ELSEIF Header(""content-type"").StartsWith(""text/plain"") THEN" + NL
    t = t + "        ShowPage(fUrl, ""<html><body><pre>"" + Esc(fBodyText) + ""</pre></body></html>"", pHist)" + NL
    t = t + "        ' Save As keeps the text itself, not the page made to show it" + NL
    t = t + "        curSource = fBodyText" + NL
    t = t + "    ELSE" + NL
    t = t + "        ShowPage(fUrl, fBodyText, pHist)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A SimMovie (SimTube's video/x-simmovie) plays in SimPlayer, which is built in" + NL
    t = t + "' (tools/simxplorer-source.mjs adds simplayer/src/PLAYER.SPK as Mv...): a window" + NL
    t = t + "' of the browser's own pops up, and the browser stays on the page it was on." + NL
    t = t + "SUB PlayMovie (url AS String)" + NL
    t = t + "    progress.Value = 0" + NL
    t = t + "    Buttons()" + NL
    t = t + "    DrawThrob()" + NL
    t = t + "    MvOpenPlayer(url, TRUE)" + NL
    t = t + "    SetStatus(""Playing "" + url + "" in SimPlayer"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Browsers of 1996 said so in a box, and stayed where they were. This one" + NL
    t = t + "' also offers AskSim's cached copy, if there is a search engine to ask." + NL
    t = t + "SUB CannotOpen (url AS String, why AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    VAR reason AS String" + NL
    t = t + "    progress.Value = 0" + NL
    t = t + "    SetStatus(""Done"")" + NL
    t = t + "    Buttons()" + NL
    t = t + "    DrawThrob()" + NL
    t = t + "    reason = why" + NL
    t = t + "    IF why.Contains(""refused"") THEN reason = ""A connection with the server could not be established.""" + NL
    t = t + "    IF why.Contains(""Unknown host"") THEN reason = ""The server name or address could not be resolved.""" + NL
    t = t + "    IF why.Contains(""timed out"") THEN reason = ""The operation timed out.""" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = APPTITLE" + NL
    t = t + "    box.Text = ""Simxplorer cannot open the Internet site "" + url + ""."" + EOL + EOL + reason" + NL
    t = t + "    IF optSearch <> """" AND optSearch.StartsWith(""http:"") THEN" + NL
    t = t + "        box.Kind = ""confirm""" + NL
    t = t + "        box.Buttons = ""yesno""" + NL
    t = t + "        box.Text = box.Text + EOL + EOL + ""AskSim may have kept a copy of this page. Would you like to see it?""" + NL
    t = t + "        IF box.Show() THEN Go(SearchHome() + ""cache.asp?url="" + UrlEnc(url))" + NL
    t = t + "    ELSE" + NL
    t = t + "        box.Kind = ""error""" + NL
    t = t + "        box.Show()" + NL
    t = t + "    END IF" + NL
    t = t + "    IF curUrl = """" THEN ShowPage(""about:blank"", """", FALSE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The search engine's own folder: ""http://asksim/index.asp?q=%s"" -> ""http://asksim/""" + NL
    t = t + "FUNCTION SearchHome () AS String" + NL
    t = t + "    VAR u AS String" + NL
    t = t + "    u = optSearch" + NL
    t = t + "    IF u.Contains(""?"") THEN u = u.Substring(0, u.IndexOf(""?""))" + NL
    t = t + "    RETURN Absolute(u, ""./"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION FriendlyError (status AS Integer, url AS String) AS String" + NL
    t = t + "    VAR what AS String" + NL
    t = t + "    what = ""The page cannot be displayed""" + NL
    t = t + "    IF status = 404 THEN what = ""The page cannot be found""" + NL
    t = t + "    IF status = 403 THEN what = ""You are not authorized to view this page""" + NL
    t = t + "    IF status >= 500 THEN what = ""The page cannot be displayed""" + NL
    t = t + "    RETURN ""<html><head><title>"" + what + ""</title></head><body bgcolor=""""#FFFFFF"""">"" _" + NL
    t = t + "         + ""<h3>"" + what + ""</h3><p>The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.</p><hr>"" _" + NL
    t = t + "         + ""<p>Please try the following:</p><ul><li>If you typed the page address in the Address bar, make sure that it is spelled correctly.</li>"" _" + NL
    t = t + "         + ""<li>Open the <a href="""""" + Esc(Absolute(url, ""/"")) + """""">"" + Esc(HostOf(url)) + ""</a> home page, and then look for links to the information you want.</li>"" _" + NL
    t = t + "         + ""<li>Click the <b>Back</b> button to try another link.</li></ul>"" _" + NL
    t = t + "         + ""<p><font size=""""2"""">HTTP "" + Str(status) + "" - Simxplorer</font></p></body></html>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the scripts' requests" + NL
    t = t + "" + NL
    t = t + "SUB XhrForget (i AS Integer)" + NL
    t = t + "    xSerial.RemoveAt(i)" + NL
    t = t + "    xObj.RemoveAt(i)" + NL
    t = t + "    xMethod.RemoveAt(i)" + NL
    t = t + "    xUrl.RemoveAt(i)" + NL
    t = t + "    xHeaders.RemoveAt(i)" + NL
    t = t + "    xBody.RemoveAt(i)" + NL
    t = t + "    xState.RemoveAt(i)" + NL
    t = t + "    xRaw.RemoveAt(i)" + NL
    t = t + "    xGot.RemoveAt(i)" + NL
    t = t + "    xError.RemoveAt(i)" + NL
    t = t + "    xSince.RemoveAt(i)" + NL
    t = t + "    xShown.RemoveAt(i)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Opens a request's connection and sends it, with this machine's cookies for" + NL
    t = t + "' that server and our User-Agent, as a page fetch does. Nothing may wait" + NL
    t = t + "' after the Connect in this tick (see StartFetch)." + NL
    t = t + "SUB StartXhr (serial AS Integer)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR url AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR request AS String" + NL
    t = t + "    VAR cookie AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR hasType AS Bool" + NL
    t = t + "    i = xSerial.IndexOf(serial)" + NL
    t = t + "    url = xUrl[i]" + NL
    t = t + "    xState[i] = ""sent""" + NL
    t = t + "    xSince[i] = SYS.Ticks" + NL
    t = t + "    ' a page on this disk may read files next to it" + NL
    t = t + "    IF url.Lower().StartsWith(""file:"") THEN" + NL
    t = t + "        path = url.Substring(5, url.Length - 5)" + NL
    t = t + "        IF FS.Exists(path) AND NOT FS.IsDir(path) THEN" + NL
    t = t + "            xRaw[i] = ""HTTP/1.0 200 OK"" + EOL + EOL + FS.Read(path)" + NL
    t = t + "        ELSE" + NL
    t = t + "            xRaw[i] = ""HTTP/1.0 404 Not Found"" + EOL + EOL" + NL
    t = t + "        END IF" + NL
    t = t + "        xGot[i] = 1" + NL
    t = t + "        xState[i] = ""done""" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT url.Lower().StartsWith(""http://"") THEN" + NL
    t = t + "        xError[i] = ""Simxplorer cannot fetch "" + url" + NL
    t = t + "        xState[i] = ""done""" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    request = xMethod[i] + "" "" + PathOf(url) + "" HTTP/1.0"" + EOL + ""Host: "" + HostOf(url) + EOL + ""User-Agent: "" + APPAGENT + EOL + ""Accept: */*""" + NL
    t = t + "    IF curUrl.StartsWith(""http:"") THEN request = request + EOL + ""Referer: "" + curUrl" + NL
    t = t + "    cookie = CookieHeader(HostOf(url))" + NL
    t = t + "    IF cookie <> """" THEN request = request + EOL + ""Cookie: "" + cookie" + NL
    t = t + "    FOR EACH line IN xHeaders[i].Split(EOL)" + NL
    t = t + "        IF NOT line.Contains("":"") THEN CONTINUE" + NL
    t = t + "        ' the browser says these itself" + NL
    t = t + "        IF ""|host|user-agent|cookie|content-length|referer|"".Contains(""|"" + line.Substring(0, line.IndexOf("":"")).Trim().Lower() + ""|"") THEN CONTINUE" + NL
    t = t + "        IF line.Lower().StartsWith(""content-type:"") THEN hasType = TRUE" + NL
    t = t + "        request = request + EOL + line" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF xBody[i] <> """" OR xMethod[i] = ""POST"" THEN" + NL
    t = t + "        IF NOT hasType THEN request = request + EOL + ""Content-Type: application/x-www-form-urlencoded""" + NL
    t = t + "        request = request + EOL + ""Content-Length: "" + Str(xBody[i].Length) + EOL + EOL + xBody[i]" + NL
    t = t + "    ELSE" + NL
    t = t + "        request = request + EOL" + NL
    t = t + "    END IF" + NL
    t = t + "    IF request.Length > 65000 THEN" + NL
    t = t + "        xError[i] = ""Message too long""" + NL
    t = t + "        xState[i] = ""done""" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    addr = Lookup(RsTarget(HostOf(url)))" + NL
    t = t + "    i = xSerial.IndexOf(serial)" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    IF addr = """" THEN" + NL
    t = t + "        xError[i] = ""Unknown host: "" + HostOf(url)" + NL
    t = t + "        xState[i] = ""done""" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = xweb.Connect(addr, PortOf(url))" + NL
    t = t + "        conn.Tag = ""x"" + Str(serial)" + NL
    t = t + "        conn.Send(request)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        ' (the page may have gone while we waited)" + NL
    t = t + "        i = xSerial.IndexOf(serial)" + NL
    t = t + "        IF i >= 0 THEN" + NL
    t = t + "            xError[i] = err" + NL
    t = t + "            xState[i] = ""done""" + NL
    t = t + "        END IF" + NL
    t = t + "    END TRY" + NL
    t = t + "    ' Nothing else may wait in this tick." + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION XhrOf (conn AS NET_Connection) AS Integer" + NL
    t = t + "    IF NOT conn.Tag.StartsWith(""x"") THEN RETURN -1" + NL
    t = t + "    RETURN xSerial.IndexOf(Int(Val(conn.Tag.Substring(1, conn.Tag.Length - 1))))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Xhr_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = XhrOf(conn)" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    IF xState[i] <> ""sent"" THEN RETURN" + NL
    t = t + "    IF xGot[i] = 0 THEN" + NL
    t = t + "        xRaw[i] = message" + NL
    t = t + "    ELSE" + NL
    t = t + "        xRaw[i] = xRaw[i] + EOL + message" + NL
    t = t + "    END IF" + NL
    t = t + "    xGot[i] = xGot[i] + 1" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Xhr_OnClose (conn AS NET_Connection)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = XhrOf(conn)" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    IF xState[i] = ""sent"" THEN xState[i] = ""done""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Tells the page about one request a tick: one that is in (or failed, or" + NL
    t = t + "' took too long), or one that has started to arrive." + NL
    t = t + "SUB XhrPump ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO xSerial.Count - 1" + NL
    t = t + "        IF xState[i] = ""sent"" AND SYS.Ticks - xSince[i] > PATIENCE THEN" + NL
    t = t + "            IF xGot[i] = 0 THEN xError[i] = ""The operation timed out.""" + NL
    t = t + "            xState[i] = ""done""" + NL
    t = t + "        END IF" + NL
    t = t + "        IF xState[i] = ""done"" THEN" + NL
    t = t + "            XhrReport(xSerial[i])" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        IF xState[i] = ""sent"" AND xGot[i] > 0 AND xShown[i] < 3 THEN" + NL
    t = t + "            XhrParse(xRaw[i], """")" + NL
    t = t + "            IF hpStatus > 0 THEN" + NL
    t = t + "                XhrReport(xSerial[i])" + NL
    t = t + "                RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' readyState 2 and 3 when the answer starts to come, 4 when it is all in:" + NL
    t = t + "' status 0 then if nothing came. Set-Cookie is kept, as for a page." + NL
    t = t + "SUB XhrReport (serial AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR obj AS Integer" + NL
    t = t + "    VAR done AS Bool" + NL
    t = t + "    VAR state AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR status AS Integer" + NL
    t = t + "    VAR reason AS String" + NL
    t = t + "    VAR headers AS String" + NL
    t = t + "    VAR body AS String" + NL
    t = t + "    i = xSerial.IndexOf(serial)" + NL
    t = t + "    obj = xObj[i]" + NL
    t = t + "    done = xState[i] = ""done""" + NL
    t = t + "    ' (kept here: another tick may parse another while a handler waits)" + NL
    t = t + "    XhrParse(xRaw[i], xError[i])" + NL
    t = t + "    status = hpStatus" + NL
    t = t + "    reason = hpReason" + NL
    t = t + "    headers = hpHeaders" + NL
    t = t + "    body = hpBody" + NL
    t = t + "    IF done THEN" + NL
    t = t + "        IF status > 0 THEN" + NL
    t = t + "            FOR EACH line IN headers.Split(EOL)" + NL
    t = t + "                IF line.Lower().StartsWith(""set-cookie:"") THEN TakeCookie(HostOf(xUrl[i]), line.Substring(11, line.Length - 11).Trim())" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "        state = xShown[i]" + NL
    t = t + "        XhrForget(i)" + NL
    t = t + "        ' (an answer that never arrived goes straight to 4)" + NL
    t = t + "        IF status > 0 THEN" + NL
    t = t + "            WHILE state < 3" + NL
    t = t + "                state = state + 1" + NL
    t = t + "                XhrFire(obj, serial, state, status, reason, headers, body)" + NL
    t = t + "            END WHILE" + NL
    t = t + "        END IF" + NL
    t = t + "        XhrFire(obj, serial, 4, status, reason, headers, body)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    state = xShown[i]" + NL
    t = t + "    xShown[i] = 3" + NL
    t = t + "    WHILE state < 3" + NL
    t = t + "        state = state + 1" + NL
    t = t + "        XhrFire(obj, serial, state, status, reason, headers, body)" + NL
    t = t + "        IF xSerial.IndexOf(serial) < 0 THEN RETURN" + NL
    t = t + "    END WHILE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Runs the page's handlers for a request's news, as RunCode runs others." + NL
    t = t + "SUB XhrFire (obj AS Integer, serial AS Integer, state AS Integer, status AS Integer, reason AS String, headers AS String, body AS String)" + NL
    t = t + "    VAR err AS String" + NL
    t = t + "    VAR written AS String" + NL
    t = t + "    IF NOT scriptsOn OR busy THEN RETURN" + NL
    t = t + "    busy = TRUE" + NL
    t = t + "    jsOut = """"" + NL
    t = t + "    err = JsXhrUpdate(obj, serial, state, status, reason, headers, body)" + NL
    t = t + "    written = jsOut" + NL
    t = t + "    jsOut = """"" + NL
    t = t + "    busy = FALSE" + NL
    t = t + "    IF err <> """" THEN" + NL
    t = t + "        ScriptError(err)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF written <> """" THEN Rewrite(written)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A response taken apart: hpStatus (0 when there was none), hpReason," + NL
    t = t + "' hpHeaders (as they came, a line each) and hpBody." + NL
    t = t + "SUB XhrParse (raw AS String, failure AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR head AS Array OF String" + NL
    t = t + "    VAR body AS Array OF String" + NL
    t = t + "    VAR first AS Array OF String" + NL
    t = t + "    hpStatus = 0" + NL
    t = t + "    hpReason = """"" + NL
    t = t + "    hpHeaders = """"" + NL
    t = t + "    hpBody = """"" + NL
    t = t + "    IF failure <> """" OR raw = """" THEN RETURN" + NL
    t = t + "    IF NOT raw.StartsWith(""HTTP/"") THEN" + NL
    t = t + "        hpStatus = 200" + NL
    t = t + "        hpReason = ""OK""" + NL
    t = t + "        hpBody = raw" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    lines = raw.Split(EOL)" + NL
    t = t + "    first = lines[0].Replace(Chr(13), """").Split("" "")" + NL
    t = t + "    IF first.Count > 1 THEN hpStatus = Int(Val(first[1]))" + NL
    t = t + "    FOR i = 2 TO first.Count - 1" + NL
    t = t + "        IF hpReason <> """" THEN hpReason = hpReason + "" """ + NL
    t = t + "        hpReason = hpReason + first[i]" + NL
    t = t + "    NEXT" + NL
    t = t + "    i = 1" + NL
    t = t + "    WHILE i < lines.Count" + NL
    t = t + "        line = lines[i].Replace(Chr(13), """")" + NL
    t = t + "        i = i + 1" + NL
    t = t + "        IF line.Trim() = """" THEN BREAK" + NL
    t = t + "        IF line.Contains("":"") THEN head.Add(line)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    WHILE i < lines.Count" + NL
    t = t + "        body.Add(lines[i])" + NL
    t = t + "        i = i + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    hpHeaders = head.Join(EOL)" + NL
    t = t + "    hpBody = body.Join(EOL)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- pictures" + NL
    t = t + "" + NL
    t = t + "SUB View_OnImage (src AS String)" + NL
    t = t + "    VAR url AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    url = Absolute(curUrl, src)" + NL
    t = t + "    i = imgUrls.IndexOf(url)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        view.SetImage(src, imgData[i])" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF url.Lower().StartsWith(""file:"") THEN" + NL
    t = t + "        TRY" + NL
    t = t + "            view.SetImage(src, FS.Read(url.Substring(5, url.Length - 5)))" + NL
    t = t + "        CATCH err" + NL
    t = t + "        END TRY" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT url.StartsWith(""http:"") THEN RETURN" + NL
    t = t + "    imgWant.Add(url)" + NL
    t = t + "    imgSrc.Add(src)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB KeepImage (url AS String, data AS String)" + NL
    t = t + "    IF imgUrls.IndexOf(url) >= 0 THEN RETURN" + NL
    t = t + "    imgUrls.Add(url)" + NL
    t = t + "    imgData.Add(data)" + NL
    t = t + "    IF imgUrls.Count > MAXIMAGES THEN" + NL
    t = t + "        imgUrls.RemoveAt(0)" + NL
    t = t + "        imgData.RemoveAt(0)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- cookies (Voyager's jar)" + NL
    t = t + "" + NL
    t = t + "FUNCTION CookieHeader (host AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    FOR EACH line IN ReadOr(JARFILE, """").Lines()" + NL
    t = t + "        p = line.Split(""|"")" + NL
    t = t + "        IF p.Count >= 3 THEN" + NL
    t = t + "            IF p[0] = host.Upper() THEN out.Add(p[1] + ""="" + p[2])" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out.Join(""; "")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One Set-Cookie (or document.cookie = ""...""): name=value; the rest is ignored." + NL
    t = t + "SUB TakeCookie (host AS String, cookie AS String)" + NL
    t = t + "    VAR pair AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR value AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR found AS Bool" + NL
    t = t + "    pair = cookie.Split("";"")[0]" + NL
    t = t + "    IF NOT pair.Contains(""="") OR host = """" THEN RETURN" + NL
    t = t + "    name = pair.Substring(0, pair.IndexOf(""="")).Trim()" + NL
    t = t + "    value = pair.Substring(pair.IndexOf(""="") + 1, pair.Length - pair.IndexOf(""="") - 1).Trim().Replace(""|"", """").Replace(Chr(13), """")" + NL
    t = t + "    IF name = """" THEN RETURN" + NL
    t = t + "    FOR EACH line IN ReadOr(JARFILE, """").Lines()" + NL
    t = t + "        IF line = """" THEN CONTINUE" + NL
    t = t + "        IF line.StartsWith(host.Upper() + ""|"" + name + ""|"") THEN" + NL
    t = t + "            found = TRUE" + NL
    t = t + "            IF value <> """" THEN out.Add(host.Upper() + ""|"" + name + ""|"" + value)" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT found AND value <> """" THEN out.Add(host.Upper() + ""|"" + name + ""|"" + value)" + NL
    t = t + "    TRY" + NL
    t = t + "        FS.Write(JARFILE, out.Join(EOL))" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ preparing a page" + NL
    t = t + "" + NL
    t = t + "' Attributes of a tag (the text between < and >), in any case, quoted or not." + NL
    t = t + "FUNCTION AttrAt (tag AS String, name AS String) AS Integer" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    low = "" "" + tag.Lower().Replace(Chr(10), "" "").Replace(Chr(13), "" "").Replace(Chr(9), "" "")" + NL
    t = t + "    at = low.IndexOf("" "" + name)" + NL
    t = t + "    WHILE at >= 0" + NL
    t = t + "        c = low.Substring(at + name.Length + 1, 1)" + NL
    t = t + "        IF c = ""="" OR c = "" "" OR c = """" OR c = ""/"" THEN RETURN at" + NL
    t = t + "        IF low.Substring(at + 1, low.Length - at - 1).IndexOf("" "" + name) < 0 THEN RETURN -1" + NL
    t = t + "        at = at + 1 + low.Substring(at + 1, low.Length - at - 1).IndexOf("" "" + name)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN -1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION HasAttr (tag AS String, name AS String) AS Bool" + NL
    t = t + "    RETURN AttrAt(tag, name) >= 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where an attribute's text ends (one past it), from where it starts." + NL
    t = t + "FUNCTION AttrEnd (tag AS String, at AS Integer, name AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR q AS String" + NL
    t = t + "    i = at + name.Length" + NL
    t = t + "    WHILE i < tag.Length AND tag.CharAt(i) = "" """ + NL
    t = t + "        i = i + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF i >= tag.Length OR tag.CharAt(i) <> ""="" THEN RETURN at + name.Length" + NL
    t = t + "    i = i + 1" + NL
    t = t + "    WHILE i < tag.Length AND tag.CharAt(i) = "" """ + NL
    t = t + "        i = i + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF i >= tag.Length THEN RETURN i" + NL
    t = t + "    q = tag.CharAt(i)" + NL
    t = t + "    IF q = """""""" OR q = ""'"" THEN" + NL
    t = t + "        IF tag.Substring(i + 1, tag.Length - i - 1).IndexOf(q) < 0 THEN RETURN tag.Length" + NL
    t = t + "        RETURN i + 2 + tag.Substring(i + 1, tag.Length - i - 1).IndexOf(q)" + NL
    t = t + "    END IF" + NL
    t = t + "    WHILE i < tag.Length AND NOT "" >"".Contains(tag.CharAt(i))" + NL
    t = t + "        i = i + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Attr (tag AS String, name AS String) AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    at = AttrAt(tag, name)" + NL
    t = t + "    IF at < 0 THEN RETURN """"" + NL
    t = t + "    v = tag.Substring(at, AttrEnd(tag, at, name) - at)" + NL
    t = t + "    IF NOT v.Contains(""="") THEN RETURN """"" + NL
    t = t + "    v = v.Substring(v.IndexOf(""="") + 1, v.Length - v.IndexOf(""="") - 1).Trim()" + NL
    t = t + "    IF v.StartsWith("""""""") OR v.StartsWith(""'"") THEN" + NL
    t = t + "        v = v.Substring(1, v.Length - 1)" + NL
    t = t + "        IF v.EndsWith("""""""") OR v.EndsWith(""'"") THEN v = v.Substring(0, v.Length - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN Unentity(v)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION WithoutAttr (tag AS String, name AS String) AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR stop AS Integer" + NL
    t = t + "    at = AttrAt(tag, name)" + NL
    t = t + "    IF at < 0 THEN RETURN tag" + NL
    t = t + "    ' (at is the space before the name in "" "" + tag, so the name starts at ""at""" + NL
    t = t + "    ' in tag; the space before it goes too)" + NL
    t = t + "    stop = AttrEnd(tag, at, name)" + NL
    t = t + "    IF at > 0 THEN at = at - 1" + NL
    t = t + "    RETURN tag.Substring(0, at) + tag.Substring(stop, tag.Length - stop)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION WithAttr (tag AS String, name AS String, value AS String) AS String" + NL
    t = t + "    tag = WithoutAttr(tag, name).Trim()" + NL
    t = t + "    IF tag.EndsWith(""/"") THEN RETURN tag.Substring(0, tag.Length - 1).Trim() + "" "" + name + ""="""""" + Esc(value) + """""" /""" + NL
    t = t + "    RETURN tag + "" "" + name + ""="""""" + Esc(value) + """"""""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION TagName (tag AS String) AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    t = tag.Replace(Chr(10), "" "").Replace(Chr(13), "" "").Replace(Chr(9), "" "")" + NL
    t = t + "    IF t.Contains("" "") THEN t = t.Substring(0, t.IndexOf("" ""))" + NL
    t = t + "    IF t.EndsWith(""/"") AND t.Length > 1 THEN t = t.Substring(0, t.Length - 1)" + NL
    t = t + "    RETURN t.Lower()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LinesIn (s AS String) AS Integer" + NL
    t = t + "    RETURN s.Split(EOL).Count - 1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Step 2: the <script> blocks come out. JavaScript ones are kept in scCode" + NL
    t = t + "' and leave a marker (Chr(1) n Chr(2)) where their output goes; SPARK ones" + NL
    t = t + "' (Voyager's) are noted and dropped, and so is <noscript>." + NL
    t = t + "FUNCTION ExtractScripts (html AS String) AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR tag AS String" + NL
    t = t + "    VAR code AS String" + NL
    t = t + "    VAR after AS String" + NL
    t = t + "    VAR line AS Integer" + NL
    t = t + "    VAR lang AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR word AS String" + NL
    t = t + "    parts = html.Split(""<"")" + NL
    t = t + "    out.Add(parts[0])" + NL
    t = t + "    line = 1 + LinesIn(parts[0])" + NL
    t = t + "    i = 1" + NL
    t = t + "    WHILE i < parts.Count" + NL
    t = t + "        p = parts[i]" + NL
    t = t + "        name = TagName(p.Split("">"")[0])" + NL
    t = t + "        IF name = ""script"" AND p.Contains("">"") THEN" + NL
    t = t + "            tag = p.Substring(0, p.IndexOf("">""))" + NL
    t = t + "            code = p.Substring(p.IndexOf("">"") + 1, p.Length - p.IndexOf("">"") - 1)" + NL
    t = t + "            j = i + 1" + NL
    t = t + "            WHILE j < parts.Count AND NOT parts[j].Lower().StartsWith(""/script"")" + NL
    t = t + "                code = code + ""<"" + parts[j]" + NL
    t = t + "                j = j + 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "            after = """"" + NL
    t = t + "            IF j < parts.Count THEN" + NL
    t = t + "                IF parts[j].Contains("">"") THEN after = parts[j].Substring(parts[j].IndexOf("">"") + 1, parts[j].Length - parts[j].IndexOf("">"") - 1)" + NL
    t = t + "            END IF" + NL
    t = t + "            lang = (Attr(tag, ""language"") + "" "" + Attr(tag, ""type"")).Lower()" + NL
    t = t + "            IF lang.Contains(""spark"") OR (NOT lang.Contains(""java"") AND NOT lang.Contains(""jscript"") AND (code.Upper().Contains(EOL + ""END SUB"") OR code.Upper().Trim().StartsWith(""SUB ""))) THEN" + NL
    t = t + "                FOR EACH word IN code.Replace(Chr(13), """").Split(EOL)" + NL
    t = t + "                    IF word.Trim().Upper().StartsWith(""SUB "") THEN sparkSubs = sparkSubs + ""|"" + word.Trim().Substring(4, word.Trim().Length - 4).Split(""("")[0].Trim().Lower() + ""|""" + NL
    t = t + "                NEXT" + NL
    t = t + "            ELSEIF lang.Contains(""vbs"") THEN" + NL
    t = t + "                ' VBScript: not in this edition" + NL
    t = t + "            ELSEIF Attr(tag, ""src"") = """" THEN" + NL
    t = t + "                ' HTML comments around a script were how old browsers were kept" + NL
    t = t + "                ' out: they become JavaScript comments (lines stay where they are)" + NL
    t = t + "                IF code.Trim().StartsWith(""<!--"") THEN code = code.Substring(0, code.IndexOf(""<!--"")) + ""//"" + code.Substring(code.IndexOf(""<!--"") + 4, code.Length - code.IndexOf(""<!--"") - 4)" + NL
    t = t + "                IF code.Trim().EndsWith(""-->"") THEN code = code.Substring(0, LastAt(code, ""-->"")) + code.Substring(LastAt(code, ""-->"") + 3, code.Length - LastAt(code, ""-->"") - 3)" + NL
    t = t + "                scCode.Add(code)" + NL
    t = t + "                scLine.Add(line)" + NL
    t = t + "                out.Add(Chr(1) + Str(scCode.Count - 1) + Chr(2))" + NL
    t = t + "            END IF" + NL
    t = t + "            FOR i = i TO Int(MATH.Min(j, parts.Count - 1))" + NL
    t = t + "                line = line + LinesIn(parts[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            out.Add(after)" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF name = ""noscript"" THEN" + NL
    t = t + "            j = i + 1" + NL
    t = t + "            WHILE j < parts.Count AND NOT parts[j].Lower().StartsWith(""/noscript"")" + NL
    t = t + "                j = j + 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "            FOR i = i TO Int(MATH.Min(j, parts.Count - 1))" + NL
    t = t + "                line = line + LinesIn(parts[i])" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF j < parts.Count THEN" + NL
    t = t + "                IF parts[j].Contains("">"") THEN out.Add(parts[j].Substring(parts[j].IndexOf("">"") + 1, parts[j].Length - parts[j].IndexOf("">"") - 1))" + NL
    t = t + "            END IF" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        out.Add(""<"" + p)" + NL
    t = t + "        line = line + LinesIn(p)" + NL
    t = t + "        i = i + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN out.Join("""")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A js:N handler for an element." + NL
    t = t + "FUNCTION Handler (code AS String, href AS String, after AS String, thisId AS String) AS String" + NL
    t = t + "    hTyped.Add(FALSE)" + NL
    t = t + "    hCode.Add(code)" + NL
    t = t + "    hHref.Add(href)" + NL
    t = t + "    hAfter.Add(after)" + NL
    t = t + "    hThis.Add(thisId)" + NL
    t = t + "    RETURN ""js:"" + Str(hCode.Count - 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is an event attribute JavaScript, or the name of a Voyager SPARK SUB?" + NL
    t = t + "FUNCTION IsSpark (code AS String) AS Bool" + NL
    t = t + "    RETURN sparkSubs <> """" AND sparkSubs.Contains(""|"" + code.Trim().Lower() + ""|"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Step 3: forms and event attributes, for a piece of page (the page itself," + NL
    t = t + "' or what a script wrote)." + NL
    t = t + "FUNCTION ProcessTags (html AS String) AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR tag AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR ev AS String" + NL
    t = t + "    VAR code AS String" + NL
    t = t + "    VAR after AS String" + NL
    t = t + "    VAR f AS Integer" + NL
    t = t + "    VAR content AS String" + NL
    t = t + "    parts = html.Split(""<"")" + NL
    t = t + "    out.Add(parts[0])" + NL
    t = t + "    FOR i = 1 TO parts.Count - 1" + NL
    t = t + "        p = parts[i]" + NL
    t = t + "        IF NOT p.Contains("">"") THEN" + NL
    t = t + "            out.Add(""<"" + p)" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        tag = p.Substring(0, p.IndexOf("">""))" + NL
    t = t + "        rest = p.Substring(p.IndexOf("">"") + 1, p.Length - p.IndexOf("">"") - 1)" + NL
    t = t + "        name = TagName(tag)" + NL
    t = t + "        id = Attr(tag, ""id"")" + NL
    t = t + "        after = """"" + NL
    t = t + "        SELECT CASE name" + NL
    t = t + "            CASE ""form""" + NL
    t = t + "                fmAction.Add(Attr(tag, ""action""))" + NL
    t = t + "                fmMethod.Add(Attr(tag, ""method"").Lower())" + NL
    t = t + "                fmName.Add(Attr(tag, ""name""))" + NL
    t = t + "                code = Attr(tag, ""onsubmit"")" + NL
    t = t + "                IF IsSpark(code) THEN code = """"" + NL
    t = t + "                fmSubmit.Add(code)" + NL
    t = t + "                fmObj.Add(0)" + NL
    t = t + "                inForm = fmAction.Count - 1" + NL
    t = t + "                tag = WithAttr(WithoutAttr(tag, ""onsubmit""), ""action"", ""sxsubmit:"" + Str(inForm))" + NL
    t = t + "            CASE ""/form""" + NL
    t = t + "                inForm = -1" + NL
    t = t + "            CASE ""input"", ""select"", ""textarea"", ""button""" + NL
    t = t + "                kind = Attr(tag, ""type"").Lower()" + NL
    t = t + "                IF name = ""select"" THEN kind = ""select""" + NL
    t = t + "                IF name = ""textarea"" THEN kind = ""textarea""" + NL
    t = t + "                IF name = ""button"" AND kind = """" THEN kind = ""submit""" + NL
    t = t + "                IF name = ""input"" AND kind = """" THEN kind = ""text""" + NL
    t = t + "                IF id = """" THEN" + NL
    t = t + "                    autoIds = autoIds + 1" + NL
    t = t + "                    id = ""sxf"" + Str(autoIds)" + NL
    t = t + "                    tag = WithAttr(tag, ""id"", id)" + NL
    t = t + "                END IF" + NL
    t = t + "                IF inForm >= 0 THEN" + NL
    t = t + "                    fdForm.Add(inForm)" + NL
    t = t + "                    fdName.Add(Attr(tag, ""name""))" + NL
    t = t + "                    fdId.Add(id)" + NL
    t = t + "                    fdType.Add(kind)" + NL
    t = t + "                    IF kind = ""textarea"" THEN" + NL
    t = t + "                        content = rest" + NL
    t = t + "                        IF content.Lower().Contains(""</textarea"") THEN content = content.Substring(0, content.Lower().IndexOf(""</textarea""))" + NL
    t = t + "                        fdValue.Add(Unentity(content))" + NL
    t = t + "                    ELSE" + NL
    t = t + "                        fdValue.Add(Attr(tag, ""value""))" + NL
    t = t + "                    END IF" + NL
    t = t + "                    Shadow(id, ""Value"", fdValue[fdValue.Count - 1])" + NL
    t = t + "                    Shadow(id, ""Text"", fdValue[fdValue.Count - 1])" + NL
    t = t + "                    Shadow(id, ""Checked"", Str(HasAttr(tag, ""checked"")))" + NL
    t = t + "                    Shadow(id, ""TagName"", name.Upper())" + NL
    t = t + "                    Shadow(id, ""Id"", id)" + NL
    t = t + "                    ' a submit button that runs script first sends its form itself" + NL
    t = t + "                    IF (kind = ""submit"" OR kind = ""image"") AND Attr(tag, ""onclick"") <> """" AND NOT IsSpark(Attr(tag, ""onclick"")) THEN" + NL
    t = t + "                        after = ""submit:"" + Str(inForm) + "":"" + Str(fdId.Count - 1)" + NL
    t = t + "                        tag = WithAttr(tag, ""type"", ""button"")" + NL
    t = t + "                        IF kind = ""image"" THEN tag = WithAttr(WithoutAttr(tag, ""src""), ""value"", Attr(tag, ""alt""))" + NL
    t = t + "                    END IF" + NL
    t = t + "                END IF" + NL
    t = t + "            CASE ""body""" + NL
    t = t + "                IF bodyOnload = """" AND NOT IsSpark(Attr(tag, ""onload"")) THEN bodyOnload = Attr(tag, ""onload"")" + NL
    t = t + "                IF NOT IsSpark(Attr(tag, ""onload"")) THEN tag = WithoutAttr(tag, ""onload"")" + NL
    t = t + "            CASE ""meta""" + NL
    t = t + "                IF Attr(tag, ""http-equiv"").Lower() = ""refresh"" THEN" + NL
    t = t + "                    code = Attr(tag, ""content"")" + NL
    t = t + "                    refreshAt = SYS.Ticks + Int(Val(code.Split("";"")[0])) * 1000 + 1" + NL
    t = t + "                    refreshUrl = curUrl" + NL
    t = t + "                    IF code.Lower().Contains(""url="") THEN refreshUrl = Absolute(curUrl, code.Substring(code.Lower().IndexOf(""url="") + 4, code.Length - code.Lower().IndexOf(""url="") - 4).Trim())" + NL
    t = t + "                END IF" + NL
    t = t + "        END SELECT" + NL
    t = t + "        FOR EACH ev IN [""onclick"", ""onchange"", ""onenter""]" + NL
    t = t + "            code = Attr(tag, ev)" + NL
    t = t + "            IF code <> """" AND NOT IsSpark(code) THEN" + NL
    t = t + "                IF id = """" THEN" + NL
    t = t + "                    autoIds = autoIds + 1" + NL
    t = t + "                    id = ""sxe"" + Str(autoIds)" + NL
    t = t + "                    tag = WithAttr(tag, ""id"", id)" + NL
    t = t + "                END IF" + NL
    t = t + "                IF name = ""a"" THEN" + NL
    t = t + "                    tag = WithAttr(tag, ev, Handler(code, Attr(tag, ""href""), """", id))" + NL
    t = t + "                ELSEIF ev = ""onclick"" THEN" + NL
    t = t + "                    tag = WithAttr(tag, ev, Handler(code, """", after, id))" + NL
    t = t + "                ELSE" + NL
    t = t + "                    tag = WithAttr(tag, ev, Handler(code, """", """", id))" + NL
    t = t + "                    ' the view says onchange at every key; browsers said" + NL
    t = t + "                    ' it once, on leaving the box" + NL
    t = t + "                    IF ev = ""onchange"" AND (name = ""textarea"" OR (name = ""input"" AND (kind = ""text"" OR kind = ""password""))) THEN hTyped[hTyped.Count - 1] = TRUE" + NL
    t = t + "                END IF" + NL
    t = t + "            ELSEIF ev = ""onclick"" AND after <> """" THEN" + NL
    t = t + "                tag = WithAttr(tag, ev, Handler("""", """", after, id))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        out.Add(""<"" + tag + "">"" + rest)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out.Join("""")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- elements the view has not got" + NL
    t = t + "" + NL
    t = t + "SUB Shadow (id AS String, prop AS String, value AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = shKey.IndexOf(id + ""|"" + prop)" + NL
    t = t + "    IF i < 0 THEN" + NL
    t = t + "        shKey.Add(id + ""|"" + prop)" + NL
    t = t + "        shVal.Add(value)" + NL
    t = t + "    ELSE" + NL
    t = t + "        shVal[i] = value" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Shadowed (id AS String, prop AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = shKey.IndexOf(id + ""|"" + prop)" + NL
    t = t + "    IF i < 0 THEN RETURN """"" + NL
    t = t + "    RETURN shVal[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ showing a page" + NL
    t = t + "" + NL
    t = t + "SUB NewPage ()" + NL
    t = t + "    JsReset()" + NL
    t = t + "    scCode.Clear()" + NL
    t = t + "    scLine.Clear()" + NL
    t = t + "    hCode.Clear()" + NL
    t = t + "    hHref.Clear()" + NL
    t = t + "    hAfter.Clear()" + NL
    t = t + "    hThis.Clear()" + NL
    t = t + "    hTyped.Clear()" + NL
    t = t + "    changeWait = -1" + NL
    t = t + "    fmAction.Clear()" + NL
    t = t + "    fmMethod.Clear()" + NL
    t = t + "    fmName.Clear()" + NL
    t = t + "    fmSubmit.Clear()" + NL
    t = t + "    fmObj.Clear()" + NL
    t = t + "    fdForm.Clear()" + NL
    t = t + "    fdName.Clear()" + NL
    t = t + "    fdId.Clear()" + NL
    t = t + "    fdType.Clear()" + NL
    t = t + "    fdValue.Clear()" + NL
    t = t + "    shKey.Clear()" + NL
    t = t + "    shVal.Clear()" + NL
    t = t + "    shDirty.Clear()" + NL
    t = t + "    tmId.Clear()" + NL
    t = t + "    tmDue.Clear()" + NL
    t = t + "    tmCode.Clear()" + NL
    t = t + "    tmFn.Clear()" + NL
    t = t + "    tmEvery.Clear()" + NL
    t = t + "    ' the old page's requests: whatever still comes back is let go" + NL
    t = t + "    WHILE xSerial.Count > 0" + NL
    t = t + "        XhrForget(0)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    sparkSubs = """"" + NL
    t = t + "    bodyOnload = """"" + NL
    t = t + "    refreshAt = 0" + NL
    t = t + "    inForm = -1" + NL
    t = t + "    autoIds = 0" + NL
    t = t + "    rendered = FALSE" + NL
    t = t + "    scriptsOn = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Forms the engine has not heard of yet: document.forms, form.field." + NL
    t = t + "SUB RegisterForms ()" + NL
    t = t + "    VAR f AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    FOR f = 0 TO fmAction.Count - 1" + NL
    t = t + "        IF fmObj[f] = 0 THEN" + NL
    t = t + "            fmObj[f] = JsAddForm(fmName[f], f)" + NL
    t = t + "            FOR k = 0 TO fdForm.Count - 1" + NL
    t = t + "                IF fdForm[k] = f THEN JsAddField(fmObj[f], fdName[k], fdId[k])" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ShowPage (url AS String, html AS String, addHist AS Bool)" + NL
    t = t + "    VAR pageHtml AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR err AS String" + NL
    t = t + "    VAR written AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR title AS String" + NL
    t = t + "    busy = TRUE" + NL
    t = t + "    NewPage()" + NL
    t = t + "    referrer = curUrl" + NL
    t = t + "    curUrl = url" + NL
    t = t + "    curSource = html" + NL
    t = t + "    IF addHist THEN" + NL
    t = t + "        WHILE hist.Count > histPos + 1" + NL
    t = t + "            hist.RemoveAt(hist.Count - 1)" + NL
    t = t + "        END WHILE" + NL
    t = t + "        hist.Add(url)" + NL
    t = t + "        histPos = hist.Count - 1" + NL
    t = t + "    END IF" + NL
    t = t + "    address.Text = url" + NL
    t = t + "    title = TitleOf(html)" + NL
    t = t + "    curTitle = title" + NL
    t = t + "    SetTitle(title)" + NL
    t = t + "    IF url.StartsWith(""http:"") THEN" + NL
    t = t + "        zone.Text = ""Internet zone""" + NL
    t = t + "    ELSE" + NL
    t = t + "        zone.Text = ""My Computer""" + NL
    t = t + "    END IF" + NL
    t = t + "    progress.Value = 90" + NL
    t = t + "    SetStatus(""Opening page "" + url + ""..."")" + NL
    t = t + "    pageHtml = ProcessTags(ExtractScripts(html))" + NL
    t = t + "    RegisterForms()" + NL
    t = t + "    ' the scripts, in order; what each writes goes where it was" + NL
    t = t + "    FOR k = 0 TO scCode.Count - 1" + NL
    t = t + "        written = """"" + NL
    t = t + "        IF scriptsOn THEN" + NL
    t = t + "            jsOut = """"" + NL
    t = t + "            err = JsRun(scCode[k], scLine[k])" + NL
    t = t + "            written = jsOut" + NL
    t = t + "            jsOut = """"" + NL
    t = t + "            IF err <> """" THEN ScriptError(err)" + NL
    t = t + "            IF written <> """" THEN" + NL
    t = t + "                written = ProcessTags(written)" + NL
    t = t + "                RegisterForms()" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        pageHtml = pageHtml.Replace(Chr(1) + Str(k) + Chr(2), written)" + NL
    t = t + "    NEXT" + NL
    t = t + "    view.Base = url" + NL
    t = t + "    view.Html = pageHtml" + NL
    t = t + "    curDrawn = pageHtml" + NL
    t = t + "    liveKey.Clear()" + NL
    t = t + "    liveVal.Clear()" + NL
    t = t + "    pageAll = FALSE" + NL
    t = t + "    findAt = -1" + NL
    t = t + "    rendered = TRUE" + NL
    t = t + "    ' what scripts did to fields before there were any" + NL
    t = t + "    FOR EACH err IN shDirty" + NL
    t = t + "        i = err.IndexOf(""|"")" + NL
    t = t + "        HostSet(err.Substring(0, i), err.Substring(i + 1, err.Length - i - 1), Shadowed(err.Substring(0, i), err.Substring(i + 1, err.Length - i - 1)))" + NL
    t = t + "    NEXT" + NL
    t = t + "    shDirty.Clear()" + NL
    t = t + "    IF url.StartsWith(""http:"") THEN RememberVisit(url, title)" + NL
    t = t + "    progress.Value = 100" + NL
    t = t + "    SetStatus(""Done"")" + NL
    t = t + "    IF scCode.Count > 0 AND NOT scriptsOn THEN SetStatus(""Done, but with errors on page."")" + NL
    t = t + "    IF sparkSubs <> """" THEN SetStatus(""Done (this page's SPARK scripts are for Voyager)"")" + NL
    t = t + "    Buttons()" + NL
    t = t + "    busy = FALSE" + NL
    t = t + "    IF bodyOnload <> """" AND scriptsOn THEN RunCode(bodyOnload, """", """")" + NL
    t = t + "    IF imgWant.Count = 0 THEN progress.Value = 0" + NL
    t = t + "    DrawThrob()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION TitleOf (html AS String) AS String" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    VAR a AS Integer" + NL
    t = t + "    VAR b AS Integer" + NL
    t = t + "    low = html.Lower()" + NL
    t = t + "    a = low.IndexOf(""<title"")" + NL
    t = t + "    IF a < 0 THEN RETURN """"" + NL
    t = t + "    a = a + low.Substring(a, low.Length - a).IndexOf("">"") + 1" + NL
    t = t + "    b = low.Substring(a, low.Length - a).IndexOf(""</title"")" + NL
    t = t + "    IF b < 0 THEN RETURN """"" + NL
    t = t + "    RETURN Unentity(html.Substring(a, b).Replace(EOL, "" "").Trim())" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SetTitle (title AS String)" + NL
    t = t + "    IF title = """" THEN" + NL
    t = t + "        win.Title = APPTITLE" + NL
    t = t + "    ELSE" + NL
    t = t + "        win.Title = title + "" - "" + APPTITLE" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' After the page is up, document.write starts a new one (as it did in 1996)." + NL
    t = t + "SUB Rewrite (html AS String)" + NL
    t = t + "    VAR keepUrl AS String" + NL
    t = t + "    keepUrl = curUrl" + NL
    t = t + "    busy = FALSE" + NL
    t = t + "    ShowPage(keepUrl, html, FALSE)" + NL
    t = t + "    referrer = keepUrl" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Pages that are not on the network: about: and file:" + NL
    t = t + "SUB ShowLocal ()" + NL
    t = t + "    VAR url AS String" + NL
    t = t + "    VAR html AS String" + NL
    t = t + "    url = pUrl" + NL
    t = t + "    pPending = FALSE" + NL
    t = t + "    IF url.Lower().StartsWith(""javascript:"") THEN" + NL
    t = t + "        RunJavaScriptUrl(url)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF url.Lower().StartsWith(""file:"") THEN" + NL
    t = t + "        IF NOT FS.Exists(url.Substring(5, url.Length - 5)) THEN" + NL
    t = t + "            CannotOpen(url, ""The file could not be found."")" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        html = FS.Read(url.Substring(5, url.Length - 5))" + NL
    t = t + "        IF NOT url.Lower().EndsWith("".htm"") AND NOT url.Lower().EndsWith("".html"") AND NOT url.Lower().EndsWith("".asp"") THEN" + NL
    t = t + "            IF html.StartsWith(""SIM95PIC"") THEN" + NL
    t = t + "                html = ""<html><body><img src="""""" + Esc(url) + """"""></body></html>""" + NL
    t = t + "            ELSE" + NL
    t = t + "                html = ""<html><body><pre>"" + Esc(html) + ""</pre></body></html>""" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        ShowPage(url, html, pHist)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF url.Lower().StartsWith(""about:"") THEN" + NL
    t = t + "        ShowPage(url, AboutPage(url.Substring(6, url.Length - 6)), pHist)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    CannotOpen(url, ""Simxplorer does not know how to open "" + url.Split("":"")[0] + "": addresses."")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- script errors" + NL
    t = t + "" + NL
    t = t + "' ""line|message"" from the engine, as the browsers of 1996 showed it." + NL
    t = t + "SUB ScriptError (err AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR message AS String" + NL
    t = t + "    line = err.Substring(0, err.IndexOf(""|""))" + NL
    t = t + "    message = err.Substring(err.IndexOf(""|"") + 1, err.Length - err.IndexOf(""|"") - 1)" + NL
    t = t + "    IF message = ""@aborted"" THEN" + NL
    t = t + "        scriptsOn = FALSE" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = ""Simxplorer Script Error""" + NL
    t = t + "    box.Kind = ""warn""" + NL
    t = t + "    box.Buttons = ""yesno""" + NL
    t = t + "    box.Text = ""An error has occurred in the script on this page."" + EOL + EOL + ""Line:  "" + line + EOL + ""Char:  1"" + EOL + ""Error:  "" + message + EOL + ""Code:  0"" + EOL + ""URL:  "" + curUrl + EOL + EOL + ""Do you want to continue running scripts on this page?""" + NL
    t = t + "    IF NOT box.Show() THEN scriptsOn = FALSE" + NL
    t = t + "    SetStatus(""Done, but with errors on page."")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- events from the page" + NL
    t = t + "" + NL
    t = t + "' Runs a piece of script for the page: a handler, onload, a timer. Returns" + NL
    t = t + "' FALSE when it said ""return false""." + NL
    t = t + "' thisVal is what this is: """" for window." + NL
    t = t + "FUNCTION RunCode (code AS String, thisVal AS String, fn AS String) AS Bool" + NL
    t = t + "    VAR err AS String" + NL
    t = t + "    VAR written AS String" + NL
    t = t + "    IF NOT scriptsOn OR busy THEN RETURN TRUE" + NL
    t = t + "    busy = TRUE" + NL
    t = t + "    jsOut = """"" + NL
    t = t + "    IF thisVal = """" THEN thisVal = JsO(jsGlobal)" + NL
    t = t + "    IF fn <> """" THEN" + NL
    t = t + "        err = JsCallValue(fn)" + NL
    t = t + "    ELSE" + NL
    t = t + "        err = JsHandlerOn(code, thisVal)" + NL
    t = t + "    END IF" + NL
    t = t + "    written = jsOut" + NL
    t = t + "    jsOut = """"" + NL
    t = t + "    busy = FALSE" + NL
    t = t + "    IF err <> """" THEN" + NL
    t = t + "        ScriptError(err)" + NL
    t = t + "        RETURN TRUE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF written <> """" THEN" + NL
    t = t + "        Rewrite(written)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN jsRet <> ""f""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB View_OnScript (ev AS String, code AS String)" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    IF busy OR NOT code.StartsWith(""js:"") THEN RETURN" + NL
    t = t + "    n = Int(Val(code.Substring(3, code.Length - 3)))" + NL
    t = t + "    IF n < 0 OR n >= hCode.Count THEN RETURN" + NL
    t = t + "    IF ev = ""onchange"" AND hTyped[n] THEN" + NL
    t = t + "        changeWait = n" + NL
    t = t + "        changeAt = SYS.Ticks + 800" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FlushChange()" + NL
    t = t + "    IF n < hCode.Count THEN RunHandler(n)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A click or a submit leaves the text box: its onchange comes first." + NL
    t = t + "SUB FlushChange ()" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    IF changeWait < 0 THEN RETURN" + NL
    t = t + "    n = changeWait" + NL
    t = t + "    changeWait = -1" + NL
    t = t + "    RunHandler(n)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RunHandler (n AS Integer)" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    IF hCode[n] <> """" AND scriptsOn THEN" + NL
    t = t + "        IF hThis[n] = """" THEN" + NL
    t = t + "            IF NOT RunCode(hCode[n], """", """") THEN RETURN" + NL
    t = t + "        ELSE" + NL
    t = t + "            IF NOT RunCode(hCode[n], JsElement(hThis[n]), """") THEN RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    IF n >= hCode.Count THEN RETURN" + NL
    t = t + "    IF hHref[n] <> """" AND NOT hHref[n].StartsWith(""#"") THEN FollowLink(hHref[n])" + NL
    t = t + "    IF hAfter[n].StartsWith(""submit:"") THEN" + NL
    t = t + "        parts = hAfter[n].Split("":"")" + NL
    t = t + "        SendForm(Int(Val(parts[1])), Int(Val(parts[2])), TRUE)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB View_OnNavigate (url AS String)" + NL
    t = t + "    IF busy THEN RETURN" + NL
    t = t + "    FlushChange()" + NL
    t = t + "    IF url.Contains(""sxsubmit:"") THEN" + NL
    t = t + "        url = url.Substring(url.IndexOf(""sxsubmit:"") + 9, url.Length - url.IndexOf(""sxsubmit:"") - 9)" + NL
    t = t + "        IF url.Contains(""?"") THEN" + NL
    t = t + "            FormSent(Int(Val(url.Split(""?"")[0])), url.Substring(url.IndexOf(""?"") + 1, url.Length - url.IndexOf(""?"") - 1), """")" + NL
    t = t + "        ELSE" + NL
    t = t + "            FormSent(Int(Val(url)), """", """")" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FollowLink(url)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB FollowLink (href AS String)" + NL
    t = t + "    IF href.Lower().StartsWith(""javascript:"") THEN" + NL
    t = t + "        RunJavaScriptUrl(href)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF href.StartsWith(""#"") THEN RETURN" + NL
    t = t + "    IF href.Lower().StartsWith(""mailto:"") THEN" + NL
    t = t + "        IF FS.Exists(MAILPROGRAM) THEN" + NL
    t = t + "            SYS.Start(MAILPROGRAM, ""mailto:"" + href.Substring(7, href.Length - 7).Split(""?"")[0])" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        IF optMail <> """" THEN Go(Typed(optMail) + ""compose.asp?to="" + UrlEnc(href.Substring(7, href.Length - 7)))" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    Go(Absolute(curUrl, href))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RunJavaScriptUrl (url AS String)" + NL
    t = t + "    IF NOT scriptsOn THEN RETURN" + NL
    t = t + "    RunCode(UrlDec(url.Substring(11, url.Length - 11)), """", """")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB View_OnSubmit (url AS String, body AS String, files AS String)" + NL
    t = t + "    IF busy THEN RETURN" + NL
    t = t + "    FlushChange()" + NL
    t = t + "    IF url.Contains(""sxsubmit:"") THEN" + NL
    t = t + "        FormSent(Int(Val(url.Substring(url.IndexOf(""sxsubmit:"") + 9, url.Length - url.IndexOf(""sxsubmit:"") - 9))), body, files)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    GoWith(Absolute(curUrl, url), body, TRUE, TRUE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB View_OnStatus (text AS String)" + NL
    t = t + "    IF text = """" THEN" + NL
    t = t + "        win.Status = curStatus" + NL
    t = t + "    ELSEIF text.StartsWith(""js:"") THEN" + NL
    t = t + "        win.Status = """"" + NL
    t = t + "    ELSE" + NL
    t = t + "        win.Status = ""Shortcut to "" + text" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- forms" + NL
    t = t + "" + NL
    t = t + "' The view sent form f (data is what it collected). onsubmit has its say first." + NL
    t = t + "SUB FormSent (f AS Integer, data AS String, files AS String)" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    IF f < 0 OR f >= fmAction.Count THEN RETURN" + NL
    t = t + "    IF fmSubmit[f] <> """" AND scriptsOn THEN" + NL
    t = t + "        IF NOT RunCode(fmSubmit[f], JsO(fmObj[f]), """") THEN RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' scripts may have changed fields (hidden ones too): collect them again" + NL
    t = t + "    IF scCode.Count > 0 OR hCode.Count > 0 THEN data = FormData(f, -1, data)" + NL
    t = t + "    ' file fields: the file itself goes, as Voyager sends it" + NL
    t = t + "    FOR EACH line IN files.Lines()" + NL
    t = t + "        IF NOT line.Contains(""="") THEN CONTINUE" + NL
    t = t + "        path = line.Substring(line.IndexOf(""="") + 1, line.Length - line.IndexOf(""="") - 1)" + NL
    t = t + "        TRY" + NL
    t = t + "            data = data + ""&"" + UrlEnc(line.Split(""="")[0]) + ""="" + UrlEnc(FS.Read(path)) + ""&"" + UrlEnc(line.Split(""="")[0] + "".filename"") + ""="" + UrlEnc(path.Substring(LastAt(path, ""\"") + 1, path.Length - LastAt(path, ""\"") - 1))" + NL
    t = t + "        CATCH err" + NL
    t = t + "        END TRY" + NL
    t = t + "    NEXT" + NL
    t = t + "    Send(f, data)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' form.submit(), or a submit button that ran script first." + NL
    t = t + "SUB SendForm (f AS Integer, field AS Integer, runOnSubmit AS Bool)" + NL
    t = t + "    IF f < 0 OR f >= fmAction.Count THEN RETURN" + NL
    t = t + "    IF runOnSubmit AND fmSubmit[f] <> """" AND scriptsOn THEN" + NL
    t = t + "        IF NOT RunCode(fmSubmit[f], JsO(fmObj[f]), """") THEN RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    Send(f, FormData(f, field, """"))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Send (f AS Integer, data AS String)" + NL
    t = t + "    VAR action AS String" + NL
    t = t + "    action = Absolute(curUrl, fmAction[f])" + NL
    t = t + "    IF fmMethod[f] = ""post"" THEN" + NL
    t = t + "        GoWith(action, data, TRUE, TRUE)" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF action.Contains(""?"") THEN action = action.Substring(0, action.IndexOf(""?""))" + NL
    t = t + "        Go(action + ""?"" + data)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' name=value&... for form f as it is now. field is the button that sent it" + NL
    t = t + "' (-1: none). Fields the view does not draw (hidden ones) come from fallback." + NL
    t = t + "FUNCTION FormData (f AS Integer, field AS Integer, fallback AS String) AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    FOR k = 0 TO fdForm.Count - 1" + NL
    t = t + "        IF fdForm[k] <> f OR fdName[k] = """" THEN CONTINUE" + NL
    t = t + "        kind = fdType[k]" + NL
    t = t + "        IF kind = ""submit"" OR kind = ""image"" OR kind = ""button"" OR kind = ""reset"" THEN" + NL
    t = t + "            IF k = field AND kind <> ""button"" THEN out.Add(UrlEnc(fdName[k]) + ""="" + UrlEnc(fdValue[k]))" + NL
    t = t + "            ' the button the view says was pressed" + NL
    t = t + "            IF field < 0 AND (""&"" + fallback + ""&"").Contains(""&"" + UrlEnc(fdName[k]) + ""="" + UrlEnc(fdValue[k]) + ""&"") THEN out.Add(UrlEnc(fdName[k]) + ""="" + UrlEnc(fdValue[k]))" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF kind = ""file"" THEN CONTINUE" + NL
    t = t + "        IF kind = ""checkbox"" OR kind = ""radio"" THEN" + NL
    t = t + "            IF HostGet(fdId[k], ""Checked"") = ""True"" THEN" + NL
    t = t + "                IF fdValue[k] = """" THEN" + NL
    t = t + "                    out.Add(UrlEnc(fdName[k]) + ""=on"")" + NL
    t = t + "                ELSE" + NL
    t = t + "                    out.Add(UrlEnc(fdName[k]) + ""="" + UrlEnc(fdValue[k]))" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        out.Add(UrlEnc(fdName[k]) + ""="" + UrlEnc(HostGet(fdId[k], ""Value"")))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out.Join(""&"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- timers" + NL
    t = t + "" + NL
    t = t + "SUB RunTimers ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR code AS String" + NL
    t = t + "    VAR fn AS String" + NL
    t = t + "    VAR now AS Integer" + NL
    t = t + "    now = SYS.Ticks" + NL
    t = t + "    FOR i = 0 TO tmId.Count - 1" + NL
    t = t + "        IF tmDue[i] <= now THEN" + NL
    t = t + "            code = tmCode[i]" + NL
    t = t + "            fn = tmFn[i]" + NL
    t = t + "            IF tmEvery[i] > 0 THEN" + NL
    t = t + "                tmDue[i] = now + tmEvery[i]" + NL
    t = t + "            ELSE" + NL
    t = t + "                tmId.RemoveAt(i)" + NL
    t = t + "                tmDue.RemoveAt(i)" + NL
    t = t + "                tmCode.RemoveAt(i)" + NL
    t = t + "                tmFn.RemoveAt(i)" + NL
    t = t + "                tmEvery.RemoveAt(i)" + NL
    t = t + "            END IF" + NL
    t = t + "            RunCode(code, """", fn)" + NL
    t = t + "            ' one a tick, so a busy page still lets the browser breathe" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the engine's way to the page" + NL
    t = t + "" + NL
    t = t + "' A native the engine doesn't know: none, in a page." + NL
    t = t + "FUNCTION HostNative (name AS String, thisVal AS String, args AS Array OF String) AS String" + NL
    t = t + "    THROW Str(jsLine) + ""|Object doesn't support this property or method""" + NL
    t = t + "    RETURN ""u""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB HostAlert (text AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = APPTITLE" + NL
    t = t + "    box.Kind = ""warn""" + NL
    t = t + "    box.Text = text" + NL
    t = t + "    box.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION HostConfirm (text AS String) AS Bool" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = APPTITLE" + NL
    t = t + "    box.Kind = ""confirm""" + NL
    t = t + "    box.Buttons = ""okcancel""" + NL
    t = t + "    box.Text = text" + NL
    t = t + "    RETURN box.Show()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The Simxplorer User Prompt: a little window of our own, since a message box" + NL
    t = t + "' cannot be typed into. Chr(0) means Cancel." + NL
    t = t + "VAR askWin AS GUI_Window" + NL
    t = t + "VAR askBox AS GUI_TextBox" + NL
    t = t + "VAR askDone AS Bool" + NL
    t = t + "VAR askOk AS Bool" + NL
    t = t + "" + NL
    t = t + "FUNCTION HostPrompt (text AS String, initial AS String) AS String" + NL
    t = t + "    RETURN Ask(""Simxplorer User Prompt"", ""JavaScript Prompt:"" + EOL + text, initial)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A little window with a question and a box to type in. Chr(0) means Cancel." + NL
    t = t + "FUNCTION Ask (title AS String, text AS String, initial AS String) AS String" + NL
    t = t + "    VAR lbl AS GUI_Label" + NL
    t = t + "    VAR ok AS GUI_Button" + NL
    t = t + "    VAR cancel AS GUI_Button" + NL
    t = t + "    VAR t AS Integer" + NL
    t = t + "    askWin = GUI_Window.New(title, 380, 120)" + NL
    t = t + "    askWin.Modal = TRUE" + NL
    t = t + "    askWin.Icon = ""question""" + NL
    t = t + "    askWin.onClose = Ask_Cancel" + NL
    t = t + "    lbl = GUI_Label.New(askWin)" + NL
    t = t + "    lbl.Text = text" + NL
    t = t + "    lbl.SetBounds(10, 8, 270, 50)" + NL
    t = t + "    ok = GUI_Button.New(askWin)" + NL
    t = t + "    ok.Text = ""OK""" + NL
    t = t + "    ok.Default = TRUE" + NL
    t = t + "    ok.SetBounds(292, 8, 78, 24)" + NL
    t = t + "    ok.onClick = Ask_Ok" + NL
    t = t + "    cancel = GUI_Button.New(askWin)" + NL
    t = t + "    cancel.Text = ""Cancel""" + NL
    t = t + "    cancel.Cancel = TRUE" + NL
    t = t + "    cancel.SetBounds(292, 36, 78, 24)" + NL
    t = t + "    cancel.onClick = Ask_Cancel" + NL
    t = t + "    askBox = GUI_TextBox.New(askWin)" + NL
    t = t + "    askBox.Text = initial" + NL
    t = t + "    askBox.SetBounds(10, 84, 360, 22)" + NL
    t = t + "    askBox.onEnter = Ask_Ok" + NL
    t = t + "    askDone = FALSE" + NL
    t = t + "    askOk = FALSE" + NL
    t = t + "    askWin.Center()" + NL
    t = t + "    askWin.Show()" + NL
    t = t + "    askBox.Focus()" + NL
    t = t + "    askBox.SelectAll()" + NL
    t = t + "    t = SYS.Ticks" + NL
    t = t + "    WHILE NOT askDone" + NL
    t = t + "        SYS.Sleep(30)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    text = askBox.Text" + NL
    t = t + "    TRY" + NL
    t = t + "        askWin.Destroy()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF askOk THEN RETURN text" + NL
    t = t + "    RETURN Chr(0)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Ask_Ok ()" + NL
    t = t + "    askOk = TRUE" + NL
    t = t + "    askDone = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Ask_Cancel ()" + NL
    t = t + "    askDone = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB HostStatus (text AS String)" + NL
    t = t + "    curStatus = text" + NL
    t = t + "    win.Status = text" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB HostNavigate (url AS String)" + NL
    t = t + "    IF url.Lower().StartsWith(""javascript:"") THEN" + NL
    t = t + "        ' runs once this script is done" + NL
    t = t + "        pUrl = url" + NL
    t = t + "        pPending = TRUE" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    Go(Absolute(curUrl, url))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION HostHas (id AS String) AS Bool" + NL
    t = t + "    IF rendered THEN" + NL
    t = t + "        IF view.HasElement(id) THEN RETURN TRUE" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN shKey.IndexOf(id + ""|Id"") >= 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION HostGet (id AS String, prop AS String) AS String" + NL
    t = t + "    IF rendered THEN" + NL
    t = t + "        IF view.HasElement(id) THEN RETURN Str(view.GetElement(id, prop))" + NL
    t = t + "    END IF" + NL
    t = t + "    IF prop = ""Visible"" OR prop = ""Enabled"" THEN" + NL
    t = t + "        IF shKey.IndexOf(id + ""|"" + prop) < 0 THEN RETURN ""True""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN Shadowed(id, prop)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB HostSet (id AS String, prop AS String, value AS String)" + NL
    t = t + "    IF rendered THEN" + NL
    t = t + "        IF view.HasElement(id) THEN" + NL
    t = t + "            IF liveKey.IndexOf(id + ""|"" + prop) < 0 THEN" + NL
    t = t + "                liveKey.Add(id + ""|"" + prop)" + NL
    t = t + "                liveVal.Add(value)" + NL
    t = t + "            ELSE" + NL
    t = t + "                liveVal[liveKey.IndexOf(id + ""|"" + prop)] = value" + NL
    t = t + "            END IF" + NL
    t = t + "            IF prop = ""Checked"" OR prop = ""Visible"" OR prop = ""Enabled"" THEN" + NL
    t = t + "                view.SetElement(id, prop, value = ""True"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                view.SetElement(id, prop, value)" + NL
    t = t + "            END IF" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    Shadow(id, prop, value)" + NL
    t = t + "    IF prop = ""Value"" THEN Shadow(id, ""Text"", value)" + NL
    t = t + "    IF NOT rendered AND shDirty.IndexOf(id + ""|"" + prop) < 0 THEN shDirty.Add(id + ""|"" + prop)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION HostInfo (key AS String) AS String" + NL
    t = t + "    SELECT CASE key" + NL
    t = t + "        CASE ""location""" + NL
    t = t + "            RETURN curUrl" + NL
    t = t + "        CASE ""title""" + NL
    t = t + "            RETURN curTitle" + NL
    t = t + "        CASE ""cookie""" + NL
    t = t + "            RETURN CookieHeader(HostOf(curUrl))" + NL
    t = t + "        CASE ""status""" + NL
    t = t + "            RETURN curStatus" + NL
    t = t + "        CASE ""referrer""" + NL
    t = t + "            RETURN referrer" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB HostSetInfo (key AS String, value AS String)" + NL
    t = t + "    SELECT CASE key" + NL
    t = t + "        CASE ""title""" + NL
    t = t + "            curTitle = value" + NL
    t = t + "            SetTitle(value)" + NL
    t = t + "        CASE ""cookie""" + NL
    t = t + "            TakeCookie(HostOf(curUrl), value)" + NL
    t = t + "        CASE ""status""" + NL
    t = t + "            HostStatus(value)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION HostTimeout (code AS String, fn AS String, ms AS Integer, again AS Bool) AS Integer" + NL
    t = t + "    tmId.Add(tmNext)" + NL
    t = t + "    tmDue.Add(SYS.Ticks + MATH.Max(10, ms))" + NL
    t = t + "    tmCode.Add(code)" + NL
    t = t + "    tmFn.Add(fn)" + NL
    t = t + "    IF again THEN" + NL
    t = t + "        tmEvery.Add(MATH.Max(10, ms))" + NL
    t = t + "    ELSE" + NL
    t = t + "        tmEvery.Add(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    tmNext = tmNext + 1" + NL
    t = t + "    RETURN tmNext - 1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB HostClearTimeout (id AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = tmId.IndexOf(id)" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    tmId.RemoveAt(i)" + NL
    t = t + "    tmDue.RemoveAt(i)" + NL
    t = t + "    tmCode.RemoveAt(i)" + NL
    t = t + "    tmFn.RemoveAt(i)" + NL
    t = t + "    tmEvery.RemoveAt(i)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' history.length (n = 0), or history.go(n)" + NL
    t = t + "FUNCTION HostHistory (n AS Integer) AS Integer" + NL
    t = t + "    IF n = 0 THEN RETURN hist.Count" + NL
    t = t + "    IF histPos + n >= 0 AND histPos + n < hist.Count THEN" + NL
    t = t + "        histPos = histPos + n" + NL
    t = t + "        GoWith(hist[histPos], """", FALSE, FALSE)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN hist.Count" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB HostOpen (url AS String)" + NL
    t = t + "    IF url = """" THEN url = ""about:blank""" + NL
    t = t + "    SYS.Start(APPPATH, Absolute(curUrl, url))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB HostSubmit (form AS Integer)" + NL
    t = t + "    SendForm(form, -1, FALSE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' xhr.send(): the request waits for a tick of its own. Returns its number." + NL
    t = t + "FUNCTION HostXhrSend (method AS String, url AS String, headers AS String, body AS String, obj AS Integer) AS Integer" + NL
    t = t + "    xCount = xCount + 1" + NL
    t = t + "    xSerial.Add(xCount)" + NL
    t = t + "    xObj.Add(obj)" + NL
    t = t + "    xMethod.Add(method)" + NL
    t = t + "    xUrl.Add(Absolute(curUrl, url))" + NL
    t = t + "    xHeaders.Add(headers)" + NL
    t = t + "    xBody.Add(body)" + NL
    t = t + "    xState.Add(""wait"")" + NL
    t = t + "    xRaw.Add("""")" + NL
    t = t + "    xGot.Add(0)" + NL
    t = t + "    xError.Add("""")" + NL
    t = t + "    xSince.Add(SYS.Ticks)" + NL
    t = t + "    xShown.Add(1)" + NL
    t = t + "    RETURN xCount" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB HostXhrAbort (req AS Integer)" + NL
    t = t + "    IF xSerial.IndexOf(req) >= 0 THEN XhrForget(xSerial.IndexOf(req))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB HostYield ()" + NL
    t = t + "    SYS.Sleep(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION HostSlow () AS Bool" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = APPTITLE" + NL
    t = t + "    box.Kind = ""warn""" + NL
    t = t + "    box.Buttons = ""yesno""" + NL
    t = t + "    box.Text = ""A script on this page is causing Simxplorer to run slowly. If it continues to run, your computer may become unresponsive."" + EOL + EOL + ""Do you want to abort the script?""" + NL
    t = t + "    RETURN box.Show()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ edit, find and search" + NL
    t = t + "" + NL
    t = t + "CONST CLIPFILE = ""C:\SYSTEM\CLIPBRD.TXT""" + NL
    t = t + "VAR curDrawn AS String             ' the page as given to the view, before any find marks" + NL
    t = t + "VAR liveKey AS Array OF String     ' what scripts changed after drawing (""id|Prop"")" + NL
    t = t + "VAR liveVal AS Array OF String" + NL
    t = t + "VAR pageAll AS Bool                ' Select All was chosen for the page" + NL
    t = t + "" + NL
    t = t + "' SPARK cannot reach the real clipboard: Ctrl+X/C/V in a text box use it" + NL
    t = t + "' directly, and these menu commands use SIM95's own, a file." + NL
    t = t + "SUB EditCommand (what AS String)" + NL
    t = t + "    VAR clip AS String" + NL
    t = t + "    SELECT CASE what" + NL
    t = t + "        CASE ""Cut""" + NL
    t = t + "            IF address.Focused THEN" + NL
    t = t + "                FS.Write(CLIPFILE, address.Text)" + NL
    t = t + "                address.Text = """"" + NL
    t = t + "            ELSE" + NL
    t = t + "                EditCommand(""Copy"")" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Copy""" + NL
    t = t + "            IF address.Focused THEN" + NL
    t = t + "                clip = address.Text" + NL
    t = t + "            ELSEIF pageAll THEN" + NL
    t = t + "                clip = PlainText(curDrawn)" + NL
    t = t + "            ELSE" + NL
    t = t + "                clip = curUrl" + NL
    t = t + "                SetStatus(""Copied this page's address (choose Select All first to copy its text)"")" + NL
    t = t + "            END IF" + NL
    t = t + "            FS.Write(CLIPFILE, clip)" + NL
    t = t + "        CASE ""Paste""" + NL
    t = t + "            address.Text = ReadOr(CLIPFILE, """").Replace(Chr(13), """").Split(EOL)[0]" + NL
    t = t + "            address.Focus()" + NL
    t = t + "        CASE ""Select All""" + NL
    t = t + "            IF address.Focused THEN" + NL
    t = t + "                address.SelectAll()" + NL
    t = t + "            ELSE" + NL
    t = t + "                pageAll = TRUE" + NL
    t = t + "                SetStatus(""The whole page is selected: Copy takes all of its text"")" + NL
    t = t + "            END IF" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The words of a page, a line per paragraph." + NL
    t = t + "FUNCTION PlainText (html AS String) AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR skip AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    parts = html.Split(""<"")" + NL
    t = t + "    out.Add(parts[0])" + NL
    t = t + "    FOR EACH p IN parts" + NL
    t = t + "        IF NOT p.Contains("">"") THEN CONTINUE" + NL
    t = t + "        name = TagName(p.Substring(0, p.IndexOf("">"")))" + NL
    t = t + "        IF skip <> """" THEN" + NL
    t = t + "            IF name = ""/"" + skip THEN skip = """"" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF name = ""title"" OR name = ""script"" OR name = ""style"" THEN" + NL
    t = t + "            skip = name" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        IF ""|br|p|/p|tr|li|h1|h2|h3|h4|h5|h6|div|hr|table|/table|pre|/pre|"".Contains(""|"" + name + ""|"") THEN out.Add(EOL)" + NL
    t = t + "        IF name = ""td"" THEN out.Add("" "")" + NL
    t = t + "        out.Add(Unentity(p.Substring(p.IndexOf("">"") + 1, p.Length - p.IndexOf("">"") - 1)))" + NL
    t = t + "    NEXT" + NL
    t = t + "    t = out.Join("""")" + NL
    t = t + "    WHILE t.Contains(""  "")" + NL
    t = t + "        t = t.Replace(""  "", "" "")" + NL
    t = t + "    END WHILE" + NL
    t = t + "    WHILE t.Contains(EOL + "" "")" + NL
    t = t + "        t = t.Replace(EOL + "" "", EOL)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    WHILE t.Contains(EOL + EOL + EOL)" + NL
    t = t + "        t = t.Replace(EOL + EOL + EOL, EOL + EOL)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN t.Trim()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- Find (on This Page)" + NL
    t = t + "" + NL
    t = t + "VAR findWin AS GUI_Window" + NL
    t = t + "VAR findBox AS GUI_TextBox" + NL
    t = t + "VAR findCase AS GUI_CheckBox" + NL
    t = t + "VAR findAt AS Integer = -1         ' which match is showing" + NL
    t = t + "" + NL
    t = t + "SUB MakeFindWindow ()" + NL
    t = t + "    VAR lbl AS GUI_Label" + NL
    t = t + "    VAR b AS GUI_Button" + NL
    t = t + "    findWin = GUI_Window.New(""Find"", 360, 78)" + NL
    t = t + "    findWin.Icon = ""question""" + NL
    t = t + "    findWin.onClose = Find_Close" + NL
    t = t + "    lbl = GUI_Label.New(findWin)" + NL
    t = t + "    lbl.Text = ""Fi&nd what:""" + NL
    t = t + "    lbl.SetBounds(8, 12, 64, 14)" + NL
    t = t + "    findBox = GUI_TextBox.New(findWin)" + NL
    t = t + "    findBox.SetBounds(74, 8, 186, 21)" + NL
    t = t + "    findBox.onEnter = Find_Next" + NL
    t = t + "    findBox.onChange = Find_Changed" + NL
    t = t + "    findCase = GUI_CheckBox.New(findWin)" + NL
    t = t + "    findCase.Text = ""Match &case""" + NL
    t = t + "    findCase.SetBounds(8, 44, 120, 18)" + NL
    t = t + "    findCase.onChange = Find_Changed" + NL
    t = t + "    b = GUI_Button.New(findWin)" + NL
    t = t + "    b.Text = ""&Find Next""" + NL
    t = t + "    b.Default = TRUE" + NL
    t = t + "    b.SetBounds(270, 8, 82, 24)" + NL
    t = t + "    b.onClick = Find_Next" + NL
    t = t + "    b = GUI_Button.New(findWin)" + NL
    t = t + "    b.Text = ""Cancel""" + NL
    t = t + "    b.Cancel = TRUE" + NL
    t = t + "    b.SetBounds(270, 38, 82, 24)" + NL
    t = t + "    b.onClick = Find_Close" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ShowFind ()" + NL
    t = t + "    findWin.Show()" + NL
    t = t + "    findBox.Focus()" + NL
    t = t + "    findBox.SelectAll()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Find_Close ()" + NL
    t = t + "    findWin.Hide()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Find_Changed ()" + NL
    t = t + "    findAt = -1" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Find_Next ()" + NL
    t = t + "    FindNext()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where the word is in the page's text: the n-th place, or -1. Text inside" + NL
    t = t + "' tags, titles, scripts and form fields does not count." + NL
    t = t + "FUNCTION FindIn (html AS String, word AS String, n AS Integer, exact AS Bool) AS Integer" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR found AS Integer" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR offset AS Integer" + NL
    t = t + "    VAR from AS Integer" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR skip AS String" + NL
    t = t + "    IF NOT exact THEN" + NL
    t = t + "        html = html.Lower()" + NL
    t = t + "        word = word.Lower()" + NL
    t = t + "    END IF" + NL
    t = t + "    parts = html.Split(""<"")" + NL
    t = t + "    offset = parts[0].Length" + NL
    t = t + "    FOR i = 1 TO parts.Count - 1" + NL
    t = t + "        p = parts[i]" + NL
    t = t + "        offset = offset + 1" + NL
    t = t + "        IF p.Contains("">"") THEN" + NL
    t = t + "            name = TagName(p.Substring(0, p.IndexOf("">"")))" + NL
    t = t + "            IF skip <> """" THEN" + NL
    t = t + "                IF name = ""/"" + skip THEN skip = """"" + NL
    t = t + "            ELSEIF name = ""title"" OR name = ""script"" OR name = ""style"" OR name = ""textarea"" OR name = ""select"" THEN" + NL
    t = t + "                skip = name" + NL
    t = t + "            ELSE" + NL
    t = t + "                text = p.Substring(p.IndexOf("">"") + 1, p.Length - p.IndexOf("">"") - 1)" + NL
    t = t + "                from = 0" + NL
    t = t + "                at = text.IndexOf(word)" + NL
    t = t + "                WHILE at >= 0" + NL
    t = t + "                    IF found = n THEN RETURN offset + p.IndexOf("">"") + 1 + from + at" + NL
    t = t + "                    found = found + 1" + NL
    t = t + "                    from = from + at + word.Length" + NL
    t = t + "                    at = text.Substring(from, text.Length - from).IndexOf(word)" + NL
    t = t + "                END WHILE" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        offset = offset + p.Length" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN -1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The next place the word is, marked in red and scrolled to (roughly: the" + NL
    t = t + "' view cannot say where things are, so it counts the lines before it)." + NL
    t = t + "SUB FindNext ()" + NL
    t = t + "    VAR word AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR marked AS String" + NL
    t = t + "    VAR before AS String" + NL
    t = t + "    VAR lines AS Integer" + NL
    t = t + "    VAR total AS Integer" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    word = findBox.Text" + NL
    t = t + "    IF word = """" OR curDrawn = """" OR busy THEN RETURN" + NL
    t = t + "    findAt = findAt + 1" + NL
    t = t + "    at = FindIn(curDrawn, word, findAt, findCase.Checked)" + NL
    t = t + "    IF at < 0 THEN" + NL
    t = t + "        Redraw(curDrawn)" + NL
    t = t + "        box = GUI_MessageBox.New(findWin)" + NL
    t = t + "        box.Title = ""Find""" + NL
    t = t + "        box.Kind = ""info""" + NL
    t = t + "        IF findAt = 0 THEN" + NL
    t = t + "            box.Text = ""Simxplorer could not find """""" + word + """""" on this page.""" + NL
    t = t + "        ELSE" + NL
    t = t + "            box.Text = ""Finished searching the page.""" + NL
    t = t + "        END IF" + NL
    t = t + "        findAt = -1" + NL
    t = t + "        box.Show()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    total = findAt + 1" + NL
    t = t + "    WHILE FindIn(curDrawn, word, total, findCase.Checked) >= 0" + NL
    t = t + "        total = total + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    marked = curDrawn.Substring(0, at) + ""<b><u><font color=""""#CC0000"""">"" + curDrawn.Substring(at, word.Length) + ""</font></u></b>"" + curDrawn.Substring(at + word.Length, curDrawn.Length - at - word.Length)" + NL
    t = t + "    Redraw(marked)" + NL
    t = t + "    before = curDrawn.Substring(0, at).Lower()" + NL
    t = t + "    lines = before.Split(""<br"").Count + before.Split(""<p"").Count + before.Split(""<tr"").Count + before.Split(""<li"").Count + before.Split(""<h"").Count + before.Split(""<div"").Count - 6" + NL
    t = t + "    view.ScrollTo(MATH.Max(0, lines * 18 - 80))" + NL
    t = t + "    SetStatus(""Found """""" + word + """""" ("" + Str(findAt + 1) + "" of "" + Str(total) + "")"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Draws the page again (with find marks), keeping what was typed into it" + NL
    t = t + "' and what scripts changed since it was drawn." + NL
    t = t + "SUB Redraw (html AS String)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR values AS Array OF String" + NL
    t = t + "    VAR checks AS Array OF String" + NL
    t = t + "    FOR k = 0 TO fdId.Count - 1" + NL
    t = t + "        IF view.HasElement(fdId[k]) THEN" + NL
    t = t + "            values.Add(Str(view.GetElement(fdId[k], ""Value"")))" + NL
    t = t + "            checks.Add(Str(view.GetElement(fdId[k], ""Checked"")))" + NL
    t = t + "        ELSE" + NL
    t = t + "            values.Add(Chr(0))" + NL
    t = t + "            checks.Add("""")" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    view.Html = html" + NL
    t = t + "    FOR k = 0 TO liveKey.Count - 1" + NL
    t = t + "        IF view.HasElement(liveKey[k].Split(""|"")[0]) THEN HostSet(liveKey[k].Split(""|"")[0], liveKey[k].Split(""|"")[1], liveVal[k])" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR k = 0 TO fdId.Count - 1" + NL
    t = t + "        IF values[k] <> Chr(0) AND view.HasElement(fdId[k]) THEN" + NL
    t = t + "            IF fdType[k] = ""checkbox"" OR fdType[k] = ""radio"" THEN" + NL
    t = t + "                view.SetElement(fdId[k], ""Checked"", checks[k] = ""True"")" + NL
    t = t + "            ELSEIF fdType[k] <> ""submit"" AND fdType[k] <> ""button"" AND fdType[k] <> ""reset"" THEN" + NL
    t = t + "                view.SetElement(fdId[k], ""Value"", values[k])" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- Search the Web (Ctrl+E)" + NL
    t = t + "" + NL
    t = t + "SUB QuickSearch ()" + NL
    t = t + "    VAR words AS String" + NL
    t = t + "    words = Ask(""Search the Web"", ""Search the Web for:"", """")" + NL
    t = t + "    IF words = Chr(0) OR words.Trim() = """" THEN RETURN" + NL
    t = t + "    Go(SearchUrl(words))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ favorites and history" + NL
    t = t + "" + NL
    t = t + "FUNCTION Favorites () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(FAVFILE, """").Lines()" + NL
    t = t + "        IF line.Contains(""|"") THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION MenuText (title AS String) AS String" + NL
    t = t + "    RETURN title.Replace(""&"", ""and"").Replace(Chr(9), "" "")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB BuildFavoritesMenu ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    bar.AddItem(""F&avorites"", ""&Add To Favorites..."" + Chr(9) + ""Ctrl+D"")" + NL
    t = t + "    bar.AddItem(""F&avorites"", ""&Organize Favorites..."" + Chr(9) + ""Ctrl+B"")" + NL
    t = t + "    bar.AddItem(""F&avorites"", ""&Show Favorites"" + Chr(9) + ""Ctrl+I"")" + NL
    t = t + "    favMenu.Clear()" + NL
    t = t + "    FOR EACH line IN Favorites()" + NL
    t = t + "        IF favMenu.Count = 0 THEN bar.AddSeparator(""F&avorites"")" + NL
    t = t + "        bar.AddItem(""F&avorites"", MenuText(line.Split(""|"")[0]))" + NL
    t = t + "        favMenu.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB AddFavorite ()" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    IF curUrl = """" OR curUrl.StartsWith(""about:"") THEN RETURN" + NL
    t = t + "    name = curTitle" + NL
    t = t + "    IF name = """" THEN name = curUrl" + NL
    t = t + "    name = Ask(""Add to Favorites"", ""Simxplorer will add this page to your Favorites."" + EOL + ""Name:"", name)" + NL
    t = t + "    IF name = Chr(0) OR name.Trim() = """" THEN RETURN" + NL
    t = t + "    name = name.Replace(""|"", ""-"").Trim()" + NL
    t = t + "    TRY" + NL
    t = t + "        FS.Append(FAVFILE, name + ""|"" + curUrl + EOL)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        RETURN" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF favMenu.Count = 0 THEN bar.AddSeparator(""F&avorites"")" + NL
    t = t + "    bar.AddItem(""F&avorites"", MenuText(name))" + NL
    t = t + "    favMenu.Add(name + ""|"" + curUrl)" + NL
    t = t + "    SetStatus(""Added to Favorites: "" + name)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RememberVisit (url AS String, title AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    IF title = """" THEN title = url" + NL
    t = t + "    TRY" + NL
    t = t + "        FS.Append(HISTFILE, TIME.Date + "" "" + TIME.Clock.Substring(0, 5) + ""|"" + title.Replace(""|"", ""-"") + ""|"" + url + EOL)" + NL
    t = t + "        IF FS.Size(HISTFILE) > 30000 THEN" + NL
    t = t + "            lines = FS.Read(HISTFILE).Lines()" + NL
    t = t + "            WHILE lines.Count > 150" + NL
    t = t + "                lines.RemoveAt(0)" + NL
    t = t + "            END WHILE" + NL
    t = t + "            FS.Write(HISTFILE, lines.Join(EOL) + EOL)" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ about: pages" + NL
    t = t + "" + NL
    t = t + "FUNCTION AboutTop (title AS String) AS String" + NL
    t = t + "    RETURN ""<html><head><title>"" + Esc(title) + ""</title></head><body bgcolor=""""#FFFFFF"""">"" _" + NL
    t = t + "         + ""<table width=""""100%"""" cellpadding=""""6"""" cellspacing=""""0""""><tr><td bgcolor=""""#000080""""><font color=""""#FFFFFF"""" size=""""4""""><b>"" + Esc(title) + ""</b></font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION AboutPage (what AS String) AS String" + NL
    t = t + "    VAR query AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR day AS String" + NL
    t = t + "    VAR pair AS String" + NL
    t = t + "    IF what.Contains(""?"") THEN" + NL
    t = t + "        query = what.Substring(what.IndexOf(""?"") + 1, what.Length - what.IndexOf(""?"") - 1)" + NL
    t = t + "        what = what.Substring(0, what.IndexOf(""?""))" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE what.Lower()" + NL
    t = t + "        CASE ""blank""" + NL
    t = t + "            RETURN """"" + NL
    t = t + "        CASE ""history""" + NL
    t = t + "            IF query.Contains(""clear=1"") THEN" + NL
    t = t + "                TRY" + NL
    t = t + "                    FS.Write(HISTFILE, """")" + NL
    t = t + "                CATCH err" + NL
    t = t + "                END TRY" + NL
    t = t + "            END IF" + NL
    t = t + "            out = AboutTop(""History"")" + NL
    t = t + "            lines = ReadOr(HISTFILE, """").Lines()" + NL
    t = t + "            IF lines.Count = 0 OR ReadOr(HISTFILE, """").Trim() = """" THEN out = out + ""<p>You have not visited any pages yet.</p>""" + NL
    t = t + "            FOR i = lines.Count - 1 TO 0 STEP -1" + NL
    t = t + "                p = lines[i].Split(""|"")" + NL
    t = t + "                IF p.Count < 3 THEN CONTINUE" + NL
    t = t + "                IF p[0].Substring(0, 10) <> day THEN" + NL
    t = t + "                    IF day <> """" THEN out = out + ""</ul>""" + NL
    t = t + "                    day = p[0].Substring(0, 10)" + NL
    t = t + "                    out = out + ""<h4>"" + Esc(day) + ""</h4><ul>""" + NL
    t = t + "                END IF" + NL
    t = t + "                out = out + ""<li><font size=""""2"""">"" + Esc(p[0].Substring(11, p[0].Length - 11)) + ""</font> <a href="""""" + Esc(p[2]) + """""">"" + Esc(p[1]) + ""</a>""" + NL
    t = t + "                IF out.Length > 40000 THEN BREAK" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF day <> """" THEN out = out + ""</ul>""" + NL
    t = t + "            RETURN out + ""<hr><p><a href=""""about:history?clear=1"""">Clear History</a></p></body></html>""" + NL
    t = t + "        CASE ""favorites""" + NL
    t = t + "            out = AboutTop(""Favorites"")" + NL
    t = t + "            lines = Favorites()" + NL
    t = t + "            IF lines.Count = 0 THEN out = out + ""<p>You have no Favorites yet. When you find a page you like, choose <b>Add To Favorites</b> from the Favorites menu.</p>""" + NL
    t = t + "            out = out + ""<ul>""" + NL
    t = t + "            FOR EACH line IN lines" + NL
    t = t + "                out = out + ""<li><a href="""""" + Esc(line.Split(""|"")[1]) + """""">"" + Esc(line.Split(""|"")[0]) + ""</a>""" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN out + ""</ul></body></html>""" + NL
    t = t + "        CASE ""options""" + NL
    t = t + "            IF query <> """" THEN" + NL
    t = t + "                FOR EACH pair IN query.Split(""&"")" + NL
    t = t + "                    IF pair.StartsWith(""home="") THEN optHome = UrlDec(pair.Substring(5, pair.Length - 5)).Trim()" + NL
    t = t + "                    IF pair.StartsWith(""search="") THEN optSearch = UrlDec(pair.Substring(7, pair.Length - 7)).Trim()" + NL
    t = t + "                    IF pair.StartsWith(""mail="") THEN optMail = UrlDec(pair.Substring(5, pair.Length - 5)).Trim()" + NL
    t = t + "                    ' the name server is every program's: C:\SYSTEM\RESOLV.INI" + NL
    t = t + "                    ' (left alone when it is what it was, so the central one stays the default)" + NL
    t = t + "                    IF pair.StartsWith(""dns="") THEN" + NL
    t = t + "                        IF UrlDec(pair.Substring(4, pair.Length - 4)).Trim().Lower() <> RsNameServer() THEN RsSave(UrlDec(pair.Substring(4, pair.Length - 4)).Trim())" + NL
    t = t + "                    END IF" + NL
    t = t + "                    IF pair = ""cookies=1"" THEN" + NL
    t = t + "                        TRY" + NL
    t = t + "                            FS.Write(JARFILE, """")" + NL
    t = t + "                        CATCH err" + NL
    t = t + "                        END TRY" + NL
    t = t + "                    END IF" + NL
    t = t + "                NEXT" + NL
    t = t + "                IF optSearch <> """" AND NOT optSearch.Contains(""%s"") THEN optSearch = Typed(optSearch) + ""index.asp?q=%s""" + NL
    t = t + "                SaveSettings()" + NL
    t = t + "            END IF" + NL
    t = t + "            out = AboutTop(""Options"")" + NL
    t = t + "            IF query <> """" THEN out = out + ""<p><font color=""""#008000""""><b>Your settings have been saved.</b></font></p>""" + NL
    t = t + "            RETURN out + ""<form action=""""about:options"""" method=""""get""""><table cellpadding=""""4"""">"" _" + NL
    t = t + "                 + ""<tr><td>Start page:</td><td><input name=""""home"""" size=""""40"""" value="""""" + Esc(optHome) + """"""></td></tr>"" _" + NL
    t = t + "                 + ""<tr><td>Search page:</td><td><input name=""""search"""" size=""""40"""" value="""""" + Esc(optSearch) + """"""></td></tr>"" _" + NL
    t = t + "                 + ""<tr><td></td><td><font size=""""2"""">%s is where your words go, as in http://asksim/index.asp?q=%s. The Address bar searches there too: type <tt>? chess</tt> or <tt>go chess</tt>.</font></td></tr>"" _" + NL
    t = t + "                 + ""<tr><td>Mail:</td><td><input name=""""mail"""" size=""""40"""" value="""""" + Esc(optMail) + """"""></td></tr>"" _" + NL
    t = t + "                 + ""<tr><td>Name server:</td><td><input name=""""dns"""" size=""""40"""" value="""""" + Esc(RsNameServer()) + """"""></td></tr>"" _" + NL
    t = t + "                 + ""<tr><td></td><td><font size=""""2"""">The machine running SimDNS, which knows names like www.coolsite.sim: the central one, "" + RSCENTRAL + "", unless you say otherwise. Leave it empty for machine names only, or type <tt>default</tt> for the central one. Every program on this computer uses it (C:\SYSTEM\RESOLV.INI).</font></td></tr>"" _" + NL
    t = t + "                 + ""<tr><td></td><td><input type=""""submit"""" value=""""OK""""></td></tr></table></form>"" _" + NL
    t = t + "                 + ""<hr><p><a href=""""about:options?cookies=1"""">Delete all cookies</a> &middot; <a href=""""about:history?clear=1"""">Clear History</a></p></body></html>""" + NL
    t = t + "        CASE ""search""" + NL
    t = t + "            out = AboutTop(""Search the Web"")" + NL
    t = t + "            out = out + ""<p>Simxplorer does not know a search engine on this network yet.</p>"" _" + NL
    t = t + "                + ""<p>Find a machine that runs <b>AskSim</b> and type its address below; Simxplorer will search there from now on, from the Search button and from the Address bar.</p>"" _" + NL
    t = t + "                + ""<form action=""""about:options"""" method=""""get""""><input type=""""hidden"""" name=""""home"""" value="""""" + Esc(optHome) + """"""><input type=""""hidden"""" name=""""mail"""" value="""""" + Esc(optMail) + """""">"" _" + NL
    t = t + "                + ""Search engine: <input name=""""search"""" size=""""30"""" value=""""http://""""> <input type=""""submit"""" value=""""Use it""""></form>""" + NL
    t = t + "            IF query <> """" THEN out = out + ""<p>(You were looking for <b>"" + Esc(UrlDec(query)) + ""</b>.)</p>""" + NL
    t = t + "            RETURN out + ""</body></html>""" + NL
    t = t + "        CASE ""keys""" + NL
    t = t + "            out = AboutTop(""Keyboard Shortcuts"") + ""<table cellpadding=""""3"""">""" + NL
    t = t + "            FOR EACH line IN [""Alt+Left|Back"", ""Alt+Right|Forward"", ""Esc|Stop"", ""F5|Refresh"", ""Alt+Home|Start page"", ""Alt+D|Go to the Address bar"", ""Ctrl+O|Open an address"", _" + NL
    t = t + "                    ""Ctrl+E|Search the Web"", ""Ctrl+F|Find on this page"", ""F3|Find the next one"", ""Ctrl+D|Add to Favorites"", ""Ctrl+I|Show Favorites"", ""Ctrl+B|Organize Favorites"", _" + NL
    t = t + "                    ""Ctrl+H|History"", ""Ctrl+M|Read mail"", ""Ctrl+U|View the page's source"", ""Ctrl+N|New window"", ""Ctrl+S|Save the page"", ""Ctrl+W|Close the window"", _" + NL
    t = t + "                    ""Ctrl+X, Ctrl+C, Ctrl+V|Cut, copy and paste"", ""Ctrl+A|Select all"", ""F1|This page""]" + NL
    t = t + "                out = out + ""<tr><td><tt><b>"" + Esc(line.Split(""|"")[0]) + ""</b></tt></td><td>"" + Esc(line.Split(""|"")[1]) + ""</td></tr>""" + NL
    t = t + "            NEXT" + NL
    t = t + "            RETURN out + ""</table><p><font size=""""2"""">In the Address bar, type words (or <tt>? words</tt>) to search the Web.</font></p></body></html>""" + NL
    t = t + "        CASE ""mail""" + NL
    t = t + "            RETURN AboutTop(""Mail"") + ""<p>Simxplorer does not know where your mail is.</p><p>If a machine on the network runs <b>ColdMail</b>, put its address in <a href=""""about:options"""">Options</a>.</p></body></html>""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN AboutTop(""Simxplorer"") + ""<p>Simxplorer does not have a page called about:"" + Esc(what) + "".</p></body></html>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ menus" + NL
    t = t + "" + NL
    t = t + "SUB Menu_OnSelect (item AS String)" + NL
    t = t + "    ' a menu command that goes wrong says so, rather than closing the browser" + NL
    t = t + "    TRY" + NL
    t = t + "        MenuCommand(item)" + NL
    t = t + "    CATCH problem" + NL
    t = t + "        Oops(problem)" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MenuCommand (item AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    VAR dlg AS GUI_FileDialog" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    SELECT CASE item" + NL
    t = t + "        CASE ""New Window""" + NL
    t = t + "            SYS.Start(APPPATH, curUrl)" + NL
    t = t + "        CASE ""Open...""" + NL
    t = t + "            address.Focus()" + NL
    t = t + "            address.SelectAll()" + NL
    t = t + "        CASE ""Save As File...""" + NL
    t = t + "            dlg = GUI_FileDialog.New(win)" + NL
    t = t + "            dlg.Title = ""Save As""" + NL
    t = t + "            dlg.Filter = ""*.HTM""" + NL
    t = t + "            dlg.Path = ""C:\MYFILES""" + NL
    t = t + "            path = dlg.ShowSave()" + NL
    t = t + "            IF path <> """" THEN FS.Write(path, curSource)" + NL
    t = t + "        CASE ""Close""" + NL
    t = t + "            win.Close()" + NL
    t = t + "        CASE ""Cut"", ""Copy"", ""Paste"", ""Select All""" + NL
    t = t + "            EditCommand(item)" + NL
    t = t + "        CASE ""Find (on This Page)...""" + NL
    t = t + "            ShowFind()" + NL
    t = t + "        CASE ""Find Next""" + NL
    t = t + "            IF findBox.Text = """" THEN" + NL
    t = t + "                ShowFind()" + NL
    t = t + "            ELSE" + NL
    t = t + "                FindNext()" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Address Bar""" + NL
    t = t + "            address.Focus()" + NL
    t = t + "            address.SelectAll()" + NL
    t = t + "        CASE ""Search the Web...""" + NL
    t = t + "            QuickSearch()" + NL
    t = t + "        CASE ""History""" + NL
    t = t + "            History_Click()" + NL
    t = t + "        CASE ""Keyboard Shortcuts""" + NL
    t = t + "            Go(""about:keys"")" + NL
    t = t + "        CASE ""Stop""" + NL
    t = t + "            Stop_Click()" + NL
    t = t + "        CASE ""Refresh""" + NL
    t = t + "            Refresh_Click()" + NL
    t = t + "        CASE ""Source""" + NL
    t = t + "            path = ""C:\MYFILES\VIEWSRC.HTM""" + NL
    t = t + "            FS.Write(path, curSource)" + NL
    t = t + "            SYS.Start(""C:\PROGRAMS\NOTES.SPK"", path)" + NL
    t = t + "        CASE ""Options...""" + NL
    t = t + "            Go(""about:options"")" + NL
    t = t + "        CASE ""Back""" + NL
    t = t + "            Back_Click()" + NL
    t = t + "        CASE ""Forward""" + NL
    t = t + "            Forward_Click()" + NL
    t = t + "        CASE ""Start Page""" + NL
    t = t + "            Home_Click()" + NL
    t = t + "        CASE ""Search the Web""" + NL
    t = t + "            Search_Click()" + NL
    t = t + "        CASE ""Read Mail""" + NL
    t = t + "            Mail_Click()" + NL
    t = t + "        CASE ""Open History Folder""" + NL
    t = t + "            History_Click()" + NL
    t = t + "        CASE ""Add To Favorites...""" + NL
    t = t + "            AddFavorite()" + NL
    t = t + "        CASE ""Show Favorites""" + NL
    t = t + "            Favorites_Click()" + NL
    t = t + "        CASE ""Organize Favorites...""" + NL
    t = t + "            IF NOT FS.Exists(FAVFILE) THEN FS.Write(FAVFILE, """")" + NL
    t = t + "            SYS.Start(""C:\PROGRAMS\NOTES.SPK"", FAVFILE)" + NL
    t = t + "        CASE ""About Simxplorer""" + NL
    t = t + "            box = GUI_MessageBox.New(win)" + NL
    t = t + "            box.Title = ""About Simxplorer""" + NL
    t = t + "            box.Kind = ""info""" + NL
    t = t + "            box.Text = ""Simxplorer"" + EOL + ""Version 3.02 for SIM95"" + EOL + EOL _" + NL
    t = t + "                + ""With a JavaScript interpreter written in SPARK: functions, objects, arrays, Date and Math, forms, alert, confirm and prompt, setTimeout, document.write, cookies, and XMLHttpRequest for pages that talk to their server in the background."" + EOL + EOL _" + NL
    t = t + "                + ""Extras of this edition: AutoSearch from the Address bar (type ? chess), AskSim's cached copy when a site is down, and Voyager's cookies and bookmarks."" + EOL + EOL _" + NL
    t = t + "                + ""Pages with SPARK scripts are for Voyager; Simxplorer shows them without.""" + NL
    t = t + "            box.Show()" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            FOR EACH line IN favMenu" + NL
    t = t + "                IF MenuText(line.Split(""|"")[0]) = item THEN" + NL
    t = t + "                    Go(line.Split(""|"")[1])" + NL
    t = t + "                    RETURN" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the toolbar" + NL
    t = t + "" + NL
    t = t + "CONST TBW = 58                 ' a toolbar button" + NL
    t = t + "CONST TBH = 44" + NL
    t = t + "CONST TBCOUNT = 9" + NL
    t = t + "" + NL
    t = t + "FUNCTION ToolLabel (i AS Integer) AS String" + NL
    t = t + "    RETURN ""Back|Forward|Stop|Refresh|Home|Search|Favorites|History|Mail"".Split(""|"")[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ToolEnabled (i AS Integer) AS Bool" + NL
    t = t + "    IF i = 0 THEN RETURN histPos > 0" + NL
    t = t + "    IF i = 1 THEN RETURN histPos < hist.Count - 1" + NL
    t = t + "    IF i = 2 THEN RETURN pPending OR fetching" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Redraws the toolbar when something on it changed." + NL
    t = t + "SUB DrawTools ()" + NL
    t = t + "    VAR state AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    state = Str(tbPressed) + Str(tools.Width)" + NL
    t = t + "    FOR i = 0 TO TBCOUNT - 1" + NL
    t = t + "        state = state + Str(ToolEnabled(i))" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF state = tbDrawn THEN RETURN" + NL
    t = t + "    tbDrawn = state" + NL
    t = t + "    tools.Clear()" + NL
    t = t + "    tools.SetColor(7)" + NL
    t = t + "    tools.FillRect(0, 0, tools.Width, tools.Height)" + NL
    t = t + "    FOR i = 0 TO TBCOUNT - 1" + NL
    t = t + "        DrawTool(i, 2 + i * TBW, 1, ToolEnabled(i), i = tbPressed)" + NL
    t = t + "    NEXT" + NL
    t = t + "    tools.SetColor(8)" + NL
    t = t + "    tools.Line(0, TBH + 2, tools.Width, TBH + 2)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawTool (i AS Integer, x AS Integer, y AS Integer, on AS Bool, down AS Bool)" + NL
    t = t + "    VAR label AS String" + NL
    t = t + "    VAR ox AS Integer" + NL
    t = t + "    VAR oy AS Integer" + NL
    t = t + "    VAR ink AS Integer" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    ' a raised button (sunken while held down)" + NL
    t = t + "    IF down THEN" + NL
    t = t + "        d = 1" + NL
    t = t + "        Bevel(x, y, TBW - 2, TBH, 0, 15)" + NL
    t = t + "    ELSE" + NL
    t = t + "        Bevel(x, y, TBW - 2, TBH, 15, 8)" + NL
    t = t + "    END IF" + NL
    t = t + "    ox = x + Int((TBW - 2 - 22) / 2) + d" + NL
    t = t + "    oy = y + 4 + d" + NL
    t = t + "    DrawIcon(i, ox, oy, on)" + NL
    t = t + "    ink = 0" + NL
    t = t + "    IF NOT on THEN ink = 8" + NL
    t = t + "    label = ToolLabel(i)" + NL
    t = t + "    IF NOT on THEN TinyText(x + Int((TBW - 2 - (label.Length * 6 - 1)) / 2) + 1 + d, y + 31 + d, label, 15)" + NL
    t = t + "    TinyText(x + Int((TBW - 2 - (label.Length * 6 - 1)) / 2) + d, y + 30 + d, label, ink)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Bevel (x AS Integer, y AS Integer, w AS Integer, h AS Integer, light AS Integer, dark AS Integer)" + NL
    t = t + "    tools.SetColor(light)" + NL
    t = t + "    tools.Line(x, y, x + w - 1, y)" + NL
    t = t + "    tools.Line(x, y, x, y + h - 1)" + NL
    t = t + "    tools.SetColor(dark)" + NL
    t = t + "    tools.Line(x, y + h - 1, x + w - 1, y + h - 1)" + NL
    t = t + "    tools.Line(x + w - 1, y, x + w - 1, y + h - 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A polygon, filled: points as ""x,y x,y ..."", offset by ox, oy (flip mirrors it)." + NL
    t = t + "SUB Poly (c AS GUI_Canvas, points AS String, ox AS Integer, oy AS Integer, flip AS Bool, colour AS Integer)" + NL
    t = t + "    VAR xs AS Array OF Real" + NL
    t = t + "    VAR ys AS Array OF Real" + NL
    t = t + "    VAR pt AS String" + NL
    t = t + "    VAR hits AS Array OF Real" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR top AS Real = 9999" + NL
    t = t + "    VAR bottom AS Real = -9999" + NL
    t = t + "    VAR t AS Real" + NL
    t = t + "    VAR yy AS Real" + NL
    t = t + "    FOR EACH pt IN points.Split("" "")" + NL
    t = t + "        IF flip THEN" + NL
    t = t + "            xs.Add(21 - Val(pt.Split("","")[0]))" + NL
    t = t + "        ELSE" + NL
    t = t + "            xs.Add(Val(pt.Split("","")[0]))" + NL
    t = t + "        END IF" + NL
    t = t + "        ys.Add(Val(pt.Split("","")[1]))" + NL
    t = t + "        top = MATH.Min(top, ys[ys.Count - 1])" + NL
    t = t + "        bottom = MATH.Max(bottom, ys[ys.Count - 1])" + NL
    t = t + "    NEXT" + NL
    t = t + "    c.SetColor(colour)" + NL
    t = t + "    FOR y = Int(top) TO Int(bottom)" + NL
    t = t + "        yy = y + 0.5" + NL
    t = t + "        hits.Clear()" + NL
    t = t + "        FOR i = 0 TO xs.Count - 1" + NL
    t = t + "            j = (i + 1) MOD xs.Count" + NL
    t = t + "            IF (ys[i] <= yy AND ys[j] > yy) OR (ys[j] <= yy AND ys[i] > yy) THEN hits.Add(xs[i] + (yy - ys[i]) * (xs[j] - xs[i]) / (ys[j] - ys[i]))" + NL
    t = t + "        NEXT" + NL
    t = t + "        ' (few crossings: a simple sort)" + NL
    t = t + "        FOR i = 0 TO hits.Count - 2" + NL
    t = t + "            FOR j = i + 1 TO hits.Count - 1" + NL
    t = t + "                IF hits[j] < hits[i] THEN" + NL
    t = t + "                    t = hits[i]" + NL
    t = t + "                    hits[i] = hits[j]" + NL
    t = t + "                    hits[j] = t" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "        NEXT" + NL
    t = t + "        i = 0" + NL
    t = t + "        WHILE i + 1 < hits.Count" + NL
    t = t + "            c.FillRect(ox + MATH.Round(hits[i]), oy + y, MATH.Max(1, MATH.Round(hits[i + 1]) - MATH.Round(hits[i])), 1)" + NL
    t = t + "            i = i + 2" + NL
    t = t + "        END WHILE" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The toolbar's pictures, 22 by 22. Greyed out (on = FALSE) they are all grey." + NL
    t = t + "SUB DrawIcon (i AS Integer, ox AS Integer, oy AS Integer, on AS Bool)" + NL
    t = t + "    VAR grey AS Integer" + NL
    t = t + "    grey = 8" + NL
    t = t + "    SELECT CASE i" + NL
    t = t + "        CASE 0, 1" + NL
    t = t + "            ' a fat arrow, left for Back and right for Forward" + NL
    t = t + "            Poly(tools, ""0,11 10,1 10,7 21,7 21,15 10,15 10,21"", ox, oy, i = 1, Pick(on, 0, grey))" + NL
    t = t + "            Poly(tools, ""2,11 9,4 9,9 20,9 20,13 9,13 9,18"", ox, oy, i = 1, Pick(on, 2, 7))" + NL
    t = t + "        CASE 2" + NL
    t = t + "            ' a red stop sign with a white cross" + NL
    t = t + "            Poly(tools, ""6,0 15,0 21,6 21,15 15,21 6,21 0,15 0,6"", ox, oy, FALSE, Pick(on, 9, grey))" + NL
    t = t + "            tools.SetColor(Pick(on, 15, 7))" + NL
    t = t + "            tools.Line(ox + 6, oy + 6, ox + 15, oy + 15)" + NL
    t = t + "            tools.Line(ox + 7, oy + 6, ox + 16, oy + 15)" + NL
    t = t + "            tools.Line(ox + 15, oy + 6, ox + 6, oy + 15)" + NL
    t = t + "            tools.Line(ox + 16, oy + 6, ox + 7, oy + 15)" + NL
    t = t + "        CASE 3" + NL
    t = t + "            ' a page with a green arrow going round it" + NL
    t = t + "            tools.SetColor(15)" + NL
    t = t + "            tools.FillRect(ox + 5, oy + 2, 12, 17)" + NL
    t = t + "            tools.SetColor(8)" + NL
    t = t + "            tools.Rect(ox + 5, oy + 2, 12, 17)" + NL
    t = t + "            tools.SetColor(Pick(on, 2, grey))" + NL
    t = t + "            tools.FillCircle(ox + 11, oy + 11, 8)" + NL
    t = t + "            tools.SetColor(15)" + NL
    t = t + "            tools.FillCircle(ox + 11, oy + 11, 5)" + NL
    t = t + "            tools.SetColor(7)" + NL
    t = t + "            tools.FillRect(ox + 12, oy + 1, 9, 9)" + NL
    t = t + "            Poly(tools, ""11,0 18,3 11,7"", ox, oy, FALSE, Pick(on, 2, grey))" + NL
    t = t + "        CASE 4" + NL
    t = t + "            ' a house: red roof, white walls, a door" + NL
    t = t + "            Poly(tools, ""0,11 11,1 22,11"", ox, oy, FALSE, Pick(on, 9, grey))" + NL
    t = t + "            tools.SetColor(Pick(on, 15, 7))" + NL
    t = t + "            tools.FillRect(ox + 4, oy + 11, 14, 10)" + NL
    t = t + "            tools.SetColor(Pick(on, 0, grey))" + NL
    t = t + "            tools.Rect(ox + 4, oy + 11, 14, 10)" + NL
    t = t + "            tools.SetColor(Pick(on, 1, grey))" + NL
    t = t + "            tools.FillRect(ox + 9, oy + 14, 4, 7)" + NL
    t = t + "        CASE 5" + NL
    t = t + "            ' a magnifying glass" + NL
    t = t + "            tools.SetColor(Pick(on, 0, grey))" + NL
    t = t + "            tools.FillCircle(ox + 9, oy + 9, 8)" + NL
    t = t + "            tools.SetColor(Pick(on, 14, 7))" + NL
    t = t + "            tools.FillCircle(ox + 9, oy + 9, 5)" + NL
    t = t + "            tools.SetColor(Pick(on, 1, grey))" + NL
    t = t + "            Poly(tools, ""14,12 21,19 19,21 12,14"", ox, oy, FALSE, Pick(on, 1, grey))" + NL
    t = t + "        CASE 6" + NL
    t = t + "            ' a gold star" + NL
    t = t + "            Poly(tools, ""11,0 14,8 22,8 16,13 18,21 11,16 4,21 6,13 0,8 8,8"", ox, oy, FALSE, Pick(on, 3, grey))" + NL
    t = t + "            Poly(tools, ""11,3 13,9 19,9 14,13 16,19 11,15 6,19 8,13 3,9 9,9"", ox, oy, FALSE, Pick(on, 11, 7))" + NL
    t = t + "        CASE 7" + NL
    t = t + "            ' a clock" + NL
    t = t + "            tools.SetColor(Pick(on, 4, grey))" + NL
    t = t + "            tools.FillCircle(ox + 11, oy + 11, 10)" + NL
    t = t + "            tools.SetColor(15)" + NL
    t = t + "            tools.FillCircle(ox + 11, oy + 11, 8)" + NL
    t = t + "            tools.SetColor(Pick(on, 0, grey))" + NL
    t = t + "            tools.Line(ox + 11, oy + 11, ox + 11, oy + 5)" + NL
    t = t + "            tools.Line(ox + 11, oy + 11, ox + 16, oy + 11)" + NL
    t = t + "        CASE 8" + NL
    t = t + "            ' an envelope" + NL
    t = t + "            tools.SetColor(Pick(on, 15, 7))" + NL
    t = t + "            tools.FillRect(ox + 1, oy + 5, 20, 13)" + NL
    t = t + "            tools.SetColor(Pick(on, 0, grey))" + NL
    t = t + "            tools.Rect(ox + 1, oy + 5, 20, 13)" + NL
    t = t + "            tools.Line(ox + 1, oy + 5, ox + 11, oy + 12)" + NL
    t = t + "            tools.Line(ox + 11, oy + 12, ox + 20, oy + 5)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Pick (on AS Bool, yes AS Integer, no AS Integer) AS Integer" + NL
    t = t + "    IF on THEN RETURN yes" + NL
    t = t + "    RETURN no" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A tiny bitmap font for the labels (the canvas's own is 16 pixels high)." + NL
    t = t + "FUNCTION Glyph (c AS String) AS String" + NL
    t = t + "    SELECT CASE Asc(c)" + NL
    t = t + "        CASE 66" + NL
    t = t + "            RETURN ""####.|#...#|#...#|####.|#...#|#...#|####.|.....""" + NL
    t = t + "        CASE 70" + NL
    t = t + "            RETURN ""#####|#....|#....|####.|#....|#....|#....|.....""" + NL
    t = t + "        CASE 72" + NL
    t = t + "            RETURN ""#...#|#...#|#...#|#####|#...#|#...#|#...#|.....""" + NL
    t = t + "        CASE 77" + NL
    t = t + "            RETURN ""#...#|##.##|#.#.#|#.#.#|#...#|#...#|#...#|.....""" + NL
    t = t + "        CASE 82" + NL
    t = t + "            RETURN ""####.|#...#|#...#|####.|#.#..|#..#.|#...#|.....""" + NL
    t = t + "        CASE 83" + NL
    t = t + "            RETURN "".####|#....|#....|.###.|....#|....#|####.|.....""" + NL
    t = t + "        CASE 97" + NL
    t = t + "            RETURN "".....|.....|.###.|....#|.####|#...#|.####|.....""" + NL
    t = t + "        CASE 99" + NL
    t = t + "            RETURN "".....|.....|.###.|#....|#....|#....|.###.|.....""" + NL
    t = t + "        CASE 100" + NL
    t = t + "            RETURN ""....#|....#|.####|#...#|#...#|#...#|.####|.....""" + NL
    t = t + "        CASE 101" + NL
    t = t + "            RETURN "".....|.....|.###.|#...#|#####|#....|.###.|.....""" + NL
    t = t + "        CASE 102" + NL
    t = t + "            RETURN ""..##.|.#...|###..|.#...|.#...|.#...|.#...|.....""" + NL
    t = t + "        CASE 104" + NL
    t = t + "            RETURN ""#....|#....|#.##.|##..#|#...#|#...#|#...#|.....""" + NL
    t = t + "        CASE 105" + NL
    t = t + "            RETURN ""..#..|.....|.##..|..#..|..#..|..#..|.###.|.....""" + NL
    t = t + "        CASE 107" + NL
    t = t + "            RETURN ""#....|#....|#..#.|#.#..|##...|#.#..|#..#.|.....""" + NL
    t = t + "        CASE 108" + NL
    t = t + "            RETURN "".##..|..#..|..#..|..#..|..#..|..#..|.###.|.....""" + NL
    t = t + "        CASE 109" + NL
    t = t + "            RETURN "".....|.....|##.#.|#.#.#|#.#.#|#.#.#|#.#.#|.....""" + NL
    t = t + "        CASE 111" + NL
    t = t + "            RETURN "".....|.....|.###.|#...#|#...#|#...#|.###.|.....""" + NL
    t = t + "        CASE 112" + NL
    t = t + "            RETURN "".....|.....|####.|#...#|#...#|####.|#....|#....""" + NL
    t = t + "        CASE 114" + NL
    t = t + "            RETURN "".....|.....|#.##.|##..#|#....|#....|#....|.....""" + NL
    t = t + "        CASE 115" + NL
    t = t + "            RETURN "".....|.....|.####|#....|.###.|....#|####.|.....""" + NL
    t = t + "        CASE 116" + NL
    t = t + "            RETURN "".#...|.#...|###..|.#...|.#...|.#..#|..##.|.....""" + NL
    t = t + "        CASE 118" + NL
    t = t + "            RETURN "".....|.....|#...#|#...#|#...#|.#.#.|..#..|.....""" + NL
    t = t + "        CASE 119" + NL
    t = t + "            RETURN "".....|.....|#...#|#...#|#.#.#|#.#.#|.#.#.|.....""" + NL
    t = t + "        CASE 121" + NL
    t = t + "            RETURN "".....|.....|#...#|#...#|#...#|.####|....#|.###.""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN "".....|.....|.....|.....|.....|.....|.....|.....""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB TinyText (x AS Integer, y AS Integer, text AS String, colour AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR r AS Integer" + NL
    t = t + "    VAR rows AS Array OF String" + NL
    t = t + "    VAR row AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR start AS Integer" + NL
    t = t + "    tools.SetColor(colour)" + NL
    t = t + "    FOR i = 0 TO text.Length - 1" + NL
    t = t + "        rows = Glyph(text.CharAt(i)).Split(""|"")" + NL
    t = t + "        FOR r = 0 TO 7" + NL
    t = t + "            row = rows[r] + "".""" + NL
    t = t + "            start = -1" + NL
    t = t + "            FOR k = 0 TO 5" + NL
    t = t + "                IF row.CharAt(k) = ""#"" AND start < 0 THEN start = k" + NL
    t = t + "                IF row.CharAt(k) <> ""#"" AND start >= 0 THEN" + NL
    t = t + "                    tools.FillRect(x + i * 6 + start, y + r, k - start, 1)" + NL
    t = t + "                    start = -1" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Tools_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    tbDrawn = """"" + NL
    t = t + "    DrawTools()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ToolAt (x AS Integer, y AS Integer) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF x < 2 OR y > TBH THEN RETURN -1" + NL
    t = t + "    i = Int((x - 2) / TBW)" + NL
    t = t + "    IF i < 0 OR i >= TBCOUNT THEN RETURN -1" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Tools_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = ToolAt(x, y)" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    IF NOT ToolEnabled(i) THEN RETURN" + NL
    t = t + "    tbPressed = i" + NL
    t = t + "    DrawTools()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Tools_OnMouseUp (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = tbPressed" + NL
    t = t + "    tbPressed = -1" + NL
    t = t + "    DrawTools()" + NL
    t = t + "    IF i < 0 OR ToolAt(x, y) <> i THEN RETURN" + NL
    t = t + "    SELECT CASE i" + NL
    t = t + "        CASE 0" + NL
    t = t + "            Back_Click()" + NL
    t = t + "        CASE 1" + NL
    t = t + "            Forward_Click()" + NL
    t = t + "        CASE 2" + NL
    t = t + "            Stop_Click()" + NL
    t = t + "        CASE 3" + NL
    t = t + "            Refresh_Click()" + NL
    t = t + "        CASE 4" + NL
    t = t + "            Home_Click()" + NL
    t = t + "        CASE 5" + NL
    t = t + "            Search_Click()" + NL
    t = t + "        CASE 6" + NL
    t = t + "            Favorites_Click()" + NL
    t = t + "        CASE 7" + NL
    t = t + "            History_Click()" + NL
    t = t + "        CASE 8" + NL
    t = t + "            Mail_Click()" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the logo" + NL
    t = t + "" + NL
    t = t + "' A blue S, with a gold swoosh round it that spins while a page is coming." + NL
    t = t + "SUB DrawThrob ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR a AS Real" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR spin AS Bool" + NL
    t = t + "    spin = pPending OR fetching OR imgWant.Count > 0" + NL
    t = t + "    throb.Clear()" + NL
    t = t + "    throb.SetColor(15)" + NL
    t = t + "    throb.FillRect(0, 0, 42, 46)" + NL
    t = t + "    throb.SetColor(8)" + NL
    t = t + "    throb.Rect(0, 0, 42, 46)" + NL
    t = t + "    ' the S: round the top bowl one way, the bottom bowl the other" + NL
    t = t + "    throb.SetColor(12)" + NL
    t = t + "    FOR i = 0 TO 15" + NL
    t = t + "        a = (-40 - i * 15) * MATH.Pi / 180" + NL
    t = t + "        throb.FillCircle(Int(21 + 7 * MATH.Cos(a)), Int(16 + 6 * MATH.Sin(a)), 2)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR i = 0 TO 15" + NL
    t = t + "        a = (-90 + i * 15) * MATH.Pi / 180" + NL
    t = t + "        throb.FillCircle(Int(21 + 7 * MATH.Cos(a)), Int(28 + 6 * MATH.Sin(a)), 2)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR i = 0 TO 17" + NL
    t = t + "        a = i * 20 * MATH.Pi / 180" + NL
    t = t + "        x = Int(21 + 18 * MATH.Cos(a) * 0.94 - 6 * MATH.Sin(a) * 0.34)" + NL
    t = t + "        y = Int(23 + 18 * MATH.Cos(a) * -0.34 + 6 * MATH.Sin(a) * 0.94)" + NL
    t = t + "        throb.SetColor(3)" + NL
    t = t + "        throb.Pixel(x, y)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF spin THEN" + NL
    t = t + "        FOR i = 0 TO 2" + NL
    t = t + "            a = ((throbStep / 2) * 40 + i * 14) * MATH.Pi / 180" + NL
    t = t + "            x = Int(21 + 18 * MATH.Cos(a) * 0.94 - 6 * MATH.Sin(a) * 0.34)" + NL
    t = t + "            y = Int(23 + 18 * MATH.Cos(a) * -0.34 + 6 * MATH.Sin(a) * 0.94)" + NL
    t = t + "            throb.SetColor(11)" + NL
    t = t + "            throb.FillCircle(x, y, Int(2 - i / 2))" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Throb_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    DrawThrob()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Clicking the logo goes home" + NL
    t = t + "SUB Throb_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    Home_Click()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' RESOLVE.SPK - the SimDNS resolver: asks the name server which machine a" + NL
    t = t + "' name like www.coolsite.sim is on." + NL
    t = t + "'" + NL
    t = t + "' The name server is the central one, STARTHERE.56k.net, where SimNIC (the" + NL
    t = t + "' registrar) and NAMED.SPK run, unless C:\SYSTEM\RESOLV.INI says otherwise." + NL
    t = t + "' To move the whole network to another central host, change RSCENTRAL below" + NL
    t = t + "' (the builder sets it from CENTRAL in tools/simxplorer-source.mjs)." + NL
    t = t + "'" + NL
    t = t + "' A library, not a program: a program has it joined on the end (the builder" + NL
    t = t + "' does this for Simxplorer, SimPlayer, Vapor, Frostbird, MAILD, the Sim Shell," + NL
    t = t + "' AskSim's crawler, DIG and Personal Web Manager; copy C:\PROGRAMS\RESOLVE.SPK" + NL
    t = t + "' onto the end of your own). Every name in it starts with Rs, so it can't clash." + NL
    t = t + "'" + NL
    t = t + "' C:\SYSTEM\RESOLV.INI, shared by every program on the machine (optional):" + NL
    t = t + "'     nameserver=dnsbox          another name server instead of the central one" + NL
    t = t + "'     nameserver=none            no SimDNS at all: SIM95 machine names only" + NL
    t = t + "'     search=coolsite.sim        then ""www"" means www.coolsite.sim" + NL
    t = t + "'" + NL
    t = t + "' How to use it without ever waiting in the wrong place (SIM95-NOTES.md):" + NL
    t = t + "'   1. RsWants(host)  - does this name need asking? FALSE for addresses," + NL
    t = t + "'                       plain machine names, names already known, or when" + NL
    t = t + "'                       there is no name server (or it isn't answering)." + NL
    t = t + "'   2. RsAsk(host, address) - sends the question to the name server at that" + NL
    t = t + "'                       address. It is a Connect: let it be the last thing" + NL
    t = t + "'                       the handler does." + NL
    t = t + "'   3. RsBusy()       - TRUE while the answer is on its way. After RSWAIT" + NL
    t = t + "'                       with no answer the server is left alone for RSQUIET," + NL
    t = t + "'                       and every name goes to SIM95 as before." + NL
    t = t + "'   4. RsTarget(host) - where to connect: the machine name (or address) the" + NL
    t = t + "'                       name server gave, or the name itself when SimDNS" + NL
    t = t + "'                       doesn't know it, for SIM95 to look up." + NL
    t = t + "' Answers are kept for their TTL; names SimDNS doesn't know for RSNEG." + NL
    t = t + "'" + NL
    t = t + "' Or, from a timer tick, all of that in one line (see RsNext):" + NL
    t = t + "'     IF RsNext(host) THEN RETURN          ' asked, or waiting: end the tick" + NL
    t = t + "'     conn = sock.Connect(RsTarget(host), 80)" + NL
    t = t + "' and for mail, the domain's MX first (see RsNextMail):" + NL
    t = t + "'     IF RsNextMail(domain) THEN RETURN" + NL
    t = t + "'     conn = sock.Connect(RsMailTarget(domain), 25)" + NL
    t = t + "" + NL
    t = t + "CONST RSCENTRAL = ""starthere.56k.net""   ' the central name server" + NL
    t = t + "CONST RSINI = ""C:\SYSTEM\RESOLV.INI""" + NL
    t = t + "CONST RSPORT = 53" + NL
    t = t + "CONST RSWAIT = 2000             ' ms to wait for an answer" + NL
    t = t + "CONST RSQUIET = 30000            ' ms to leave a silent name server alone" + NL
    t = t + "CONST RSNEG = 60000             ' ms to remember that SimDNS doesn't know a name" + NL
    t = t + "CONST RSMOST = 100              ' names kept" + NL
    t = t + "" + NL
    t = t + "VAR rsServer AS String              ' """" when SimDNS is off" + NL
    t = t + "VAR rsByDefault AS Bool               ' TRUE when RESOLV.INI doesn't name one" + NL
    t = t + "VAR rsSearch AS String" + NL
    t = t + "VAR rsRead AS Bool" + NL
    t = t + "VAR rsReadAt AS Integer" + NL
    t = t + "VAR rsSock AS NET_Socket" + NL
    t = t + "VAR rsName AS Array OF String       ' the name as asked, lower case" + NL
    t = t + "VAR rsTo AS Array OF String         ' where it is ("""" when SimDNS doesn't know it)" + NL
    t = t + "VAR rsCanon AS Array OF String      ' its last name in DNS before the machine" + NL
    t = t + "VAR rsUntil AS Array OF Integer     ' SYS.Ticks when it is forgotten" + NL
    t = t + "VAR rsAsking AS String" + NL
    t = t + "VAR rsAskAt AS Integer" + NL
    t = t + "VAR rsRefused AS Bool" + NL
    t = t + "VAR rsDown AS Bool" + NL
    t = t + "VAR rsDownAt AS Integer" + NL
    t = t + "VAR rsWhy AS String                 ' the last thing that went wrong" + NL
    t = t + "VAR rsLastReply AS String           ' the last answer, as it came" + NL
    t = t + "VAR rsServerAddr AS String          ' the name server's address, for RsNext" + NL
    t = t + "VAR rsServerFor AS String" + NL
    t = t + "VAR rsServerAt AS Integer" + NL
    t = t + "VAR rsLooking AS Bool               ' RsNext is finding the name server's address" + NL
    t = t + "VAR rsLookingAt AS Integer" + NL
    t = t + "" + NL
    t = t + "' Reads RESOLV.INI (again after a few seconds, so a new setting takes)." + NL
    t = t + "' With no nameserver= line, the central name server; none (or nothing after" + NL
    t = t + "' the =) turns SimDNS off." + NL
    t = t + "SUB RsConfig ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    IF rsRead AND SYS.Ticks - rsReadAt < 3000 THEN RETURN" + NL
    t = t + "    rsRead = TRUE" + NL
    t = t + "    rsReadAt = SYS.Ticks" + NL
    t = t + "    rsServer = RSCENTRAL" + NL
    t = t + "    rsByDefault = TRUE" + NL
    t = t + "    rsSearch = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                low = line.Trim().Lower()" + NL
    t = t + "                IF low.StartsWith(""nameserver="") THEN" + NL
    t = t + "                    rsServer = low.Substring(11, low.Length - 11).Trim()" + NL
    t = t + "                    rsByDefault = FALSE" + NL
    t = t + "                END IF" + NL
    t = t + "                IF low.StartsWith(""search="") THEN rsSearch = low.Substring(7, low.Length - 7).Trim()" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF rsServer = ""none"" THEN rsServer = """"" + NL
    t = t + "    IF rsSearch.StartsWith(""."") THEN rsSearch = rsSearch.Substring(1, rsSearch.Length - 1)" + NL
    t = t + "    IF rsSearch.EndsWith(""."") THEN rsSearch = rsSearch.Substring(0, rsSearch.Length - 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The name server (a machine name or address), or """" for none." + NL
    t = t + "FUNCTION RsNameServer () AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsServer" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is it the central one, because RESOLV.INI doesn't say?" + NL
    t = t + "FUNCTION RsIsCentral () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsByDefault" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Makes server this machine's name server, keeping the rest of RESOLV.INI," + NL
    t = t + "' and forgets everything it knew. """" (or none) for no SimDNS at all;" + NL
    t = t + "' default for the central one again." + NL
    t = t + "SUB RsSave (server AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    server = server.Trim().Lower()" + NL
    t = t + "    IF server = """" THEN server = ""none""" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                IF line.Trim() <> """" AND NOT line.Trim().Lower().StartsWith(""nameserver="") THEN out.Add(line)" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "        IF server <> ""default"" THEN out.Insert(0, ""nameserver="" + server)" + NL
    t = t + "        IF out.Count = 0 THEN" + NL
    t = t + "            IF FS.Exists(RSINI) THEN FS.Delete(RSINI)" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Write(RSINI, out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsWhy = err" + NL
    t = t + "    END TRY" + NL
    t = t + "    rsRead = FALSE" + NL
    t = t + "    RsForget()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RsForget ()" + NL
    t = t + "    rsName.Clear()" + NL
    t = t + "    rsTo.Clear()" + NL
    t = t + "    rsCanon.Clear()" + NL
    t = t + "    rsUntil.Clear()" + NL
    t = t + "    rsDown = FALSE" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsIsAddress (s AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF s.Split(""."").Count <> 4 THEN RETURN FALSE" + NL
    t = t + "    FOR EACH p IN s.Split(""."")" + NL
    t = t + "        IF p = """" OR p.Length > 3 THEN RETURN FALSE" + NL
    t = t + "        FOR i = 0 TO p.Length - 1" + NL
    t = t + "            IF NOT ""0123456789"".Contains(p.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name the server is asked about: lower case, the search domain added" + NL
    t = t + "' to a single word." + NL
    t = t + "FUNCTION RsFull (host AS String) AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF h.EndsWith(""."") THEN h = h.Substring(0, h.Length - 1)" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch <> """" THEN h = h + ""."" + rsSearch" + NL
    t = t + "    RETURN h" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a name is in the list of answers, or -1 (old answers are dropped)." + NL
    t = t + "FUNCTION RsFind (host AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = rsName.IndexOf(host.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN -1" + NL
    t = t + "    IF SYS.Ticks > rsUntil[i] THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "        RETURN -1" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsWants (host AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(host) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(host) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for a mail domain's MX record." + NL
    t = t + "FUNCTION RsWantsMx (domain AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(domain) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(""mx:"" + domain.Trim().Lower()) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is host a name for the name server at all (whether known yet or not)?" + NL
    t = t + "FUNCTION RsAsks (host AS String) AS Bool" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF rsServer = """" OR h = """" OR h = ""localhost"" THEN RETURN FALSE" + NL
    t = t + "    IF rsDown AND SYS.Ticks - rsDownAt < RSQUIET THEN RETURN FALSE" + NL
    t = t + "    IF RsIsAddress(h) THEN RETURN FALSE" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch = """" THEN RETURN FALSE" + NL
    t = t + "    IF h = rsServer OR h = NET.HostName.Lower() THEN RETURN FALSE" + NL
    t = t + "    ' a machine's full name (bob.56k.net): SIM95's, never SimDNS's to answer" + NL
    t = t + "    IF RsIspName(h) THEN RETURN FALSE" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Does h end in one of SIM95's ISPs (56k.net, dialup.zone...)?" + NL
    t = t + "FUNCTION RsIspName (h AS String) AS Bool" + NL
    t = t + "    VAR isp AS String" + NL
    t = t + "    FOR EACH isp IN [""dialup.zone"", ""56k.net"", ""bbs.club"", ""modem.link"", ""beep.boop""]" + NL
    t = t + "        IF h = isp OR h.EndsWith(""."" + isp) THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Sends the question. A Connect, so it must be the last thing its handler" + NL
    t = t + "' does: if the name server refuses, the handler is spoiled (SIM95-NOTES.md)." + NL
    t = t + "SUB RsAsk (host AS String, address AS String)" + NL
    t = t + "    RsSend(host.Trim().Lower(), ""A"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Asks for a mail domain's MX records (also a Connect: the last thing)." + NL
    t = t + "SUB RsAskMx (domain AS String, address AS String)" + NL
    t = t + "    RsSend(""mx:"" + domain.Trim().Lower(), ""MX"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' key is the name, or mx: and the name; the answer is kept under it." + NL
    t = t + "SUB RsSend (key AS String, qtype AS String, address AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    IF IsNothing(rsSock) THEN" + NL
    t = t + "        rsSock = NET_Socket.New()" + NL
    t = t + "        rsSock.onMessage = Rs_OnMessage" + NL
    t = t + "    END IF" + NL
    t = t + "    name = key" + NL
    t = t + "    IF name.StartsWith(""mx:"") THEN name = name.Substring(3, name.Length - 3)" + NL
    t = t + "    rsAsking = key" + NL
    t = t + "    rsAskAt = SYS.Ticks" + NL
    t = t + "    rsRefused = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = rsSock.Connect(address, RSPORT)" + NL
    t = t + "        conn.Tag = ""rs:"" + key" + NL
    t = t + "        conn.Send(""QUERY "" + RsFull(name) + "" "" + qtype)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsRefused = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Gives up on the name server for a while: every name goes to SIM95." + NL
    t = t + "SUB RsGiveUp (why AS String)" + NL
    t = t + "    rsWhy = why" + NL
    t = t + "    rsDown = TRUE" + NL
    t = t + "    rsDownAt = SYS.Ticks" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "    rsServerAddr = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' For a program that fetches from a timer tick: TRUE when the tick must end" + NL
    t = t + "' now, because a question about host has just been sent (a Connect, so it" + NL
    t = t + "' has to be the last thing the handler does) or an answer is on its way." + NL
    t = t + "' FALSE when there is nothing to ask: RsTarget(host) is where to connect." + NL
    t = t + "' A name server that is missing, refuses or says nothing for RSWAIT is left" + NL
    t = t + "' alone for RSQUIET, and every name goes to SIM95: nothing ever hangs." + NL
    t = t + "FUNCTION RsNext (host AS String) AS Bool" + NL
    t = t + "    RETURN RsStep(host, FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for mail to domain: its MX record (the lowest preference), then" + NL
    t = t + "' the CNAMEs or address of the machine that names. RsMailTarget(domain) is" + NL
    t = t + "' then where to connect; with no MX, the domain's own machine; with no" + NL
    t = t + "' answer at all, the domain itself, for SIM95 to look up." + NL
    t = t + "FUNCTION RsNextMail (domain AS String) AS Bool" + NL
    t = t + "    IF RsStep(domain, TRUE) THEN RETURN TRUE" + NL
    t = t + "    RETURN RsStep(RsMailHost(domain), FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsStep (host AS String, mx AS Bool) AS Bool" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    ' another handler is finding the name server (it waits): wait for it" + NL
    t = t + "    IF rsLooking THEN" + NL
    t = t + "        IF SYS.Ticks - rsLookingAt < RSWAIT THEN RETURN TRUE" + NL
    t = t + "        rsLooking = FALSE" + NL
    t = t + "        RsGiveUp(""no answer about the machine "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF RsBusy() THEN RETURN TRUE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        IF NOT RsWantsMx(host) THEN RETURN FALSE" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF NOT RsWants(host) THEN RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    addr = RsServerAddress()" + NL
    t = t + "    IF addr = """" THEN RETURN FALSE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        RsAskMx(host, addr)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsAsk(host, addr)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name server's address, looked up once a minute (one lookup at a time:" + NL
    t = t + "' see SIM95-NOTES.md). """" when there is no such machine, and then it gives up." + NL
    t = t + "FUNCTION RsServerAddress () AS String" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    IF RsIsAddress(rsServer) THEN RETURN rsServer" + NL
    t = t + "    IF rsServerAddr <> """" AND rsServerFor = rsServer AND SYS.Ticks - rsServerAt < 60000 AND SYS.Ticks >= rsServerAt THEN RETURN rsServerAddr" + NL
    t = t + "    rsLooking = TRUE" + NL
    t = t + "    rsLookingAt = SYS.Ticks" + NL
    t = t + "    addr = NET.Resolve(rsServer)" + NL
    t = t + "    IF NOT rsLooking THEN RETURN """"" + NL
    t = t + "    rsLooking = FALSE" + NL
    t = t + "    IF addr = """" THEN" + NL
    t = t + "        RsGiveUp(""there is no machine called "" + rsServer)" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    rsServerAddr = addr" + NL
    t = t + "    rsServerFor = rsServer" + NL
    t = t + "    rsServerAt = SYS.Ticks" + NL
    t = t + "    RETURN addr" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsBusy () AS Bool" + NL
    t = t + "    IF rsAsking = """" THEN RETURN FALSE" + NL
    t = t + "    IF rsRefused THEN" + NL
    t = t + "        RsGiveUp(""the name server "" + rsServer + "" refused"")" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF SYS.Ticks - rsAskAt > RSWAIT THEN" + NL
    t = t + "        RsGiveUp(""no answer from the name server "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Rs_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    IF NOT conn.Tag.StartsWith(""rs:"") THEN RETURN" + NL
    t = t + "    h = conn.Tag.Substring(3, conn.Tag.Length - 3)" + NL
    t = t + "    conn.Tag = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        conn.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    RsTake(h, message)" + NL
    t = t + "    IF h = rsAsking THEN rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an answer: follows its CNAMEs to an address, or to the machine" + NL
    t = t + "' name the chain ends at." + NL
    t = t + "SUB RsTake (host AS String, reply AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR onward AS String" + NL
    t = t + "    VAR target AS String" + NL
    t = t + "    VAR canon AS String" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR hops AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    rsLastReply = reply" + NL
    t = t + "    IF host.StartsWith(""mx:"") THEN" + NL
    t = t + "        RsTakeMx(host, reply)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(host, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(host, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    cur = RsFull(host)" + NL
    t = t + "    canon = cur" + NL
    t = t + "    FOR hops = 0 TO 8" + NL
    t = t + "        onward = """"" + NL
    t = t + "        FOR i = 1 TO lines.Count - 1" + NL
    t = t + "            w = lines[i].Split("" "")" + NL
    t = t + "            IF w.Count >= 4 THEN" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""A"" AND target = """" THEN target = w[3]" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""CNAME"" THEN onward = w[3]" + NL
    t = t + "                IF w[0] = cur AND (w[2] = ""A"" OR w[2] = ""CNAME"") AND Int(Val(w[1])) < ttl THEN ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF target <> """" THEN" + NL
    t = t + "            canon = cur" + NL
    t = t + "            BREAK" + NL
    t = t + "        END IF" + NL
    t = t + "        IF onward = """" THEN BREAK" + NL
    t = t + "        canon = cur" + NL
    t = t + "        cur = onward" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF target = """" THEN" + NL
    t = t + "        ' a name with no CNAME and no address: not one to connect to" + NL
    t = t + "        IF cur = RsFull(host) THEN" + NL
    t = t + "            RsKeep(host, """", """", RSNEG)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        ' the end of the chain: a SIM95 machine name" + NL
    t = t + "        target = cur" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ttl < 5 THEN ttl = 5" + NL
    t = t + "    RsKeep(host, target, canon, ttl * 1000)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an MX answer: the mail machine with the lowest preference. With no" + NL
    t = t + "' MX, the server answers with the domain's CNAMEs instead, and the domain's" + NL
    t = t + "' own machine takes the mail." + NL
    t = t + "SUB RsTakeMx (key AS String, reply AS String)" + NL
    t = t + "    VAR domain AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR best AS String" + NL
    t = t + "    VAR pref AS Integer = 1000000" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    domain = key.Substring(3, key.Length - 3)" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(key, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RsKeep(domain, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(key, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 1 TO lines.Count - 1" + NL
    t = t + "        w = lines[i].Split("" "")" + NL
    t = t + "        IF w.Count >= 5 THEN" + NL
    t = t + "            IF w[2] = ""MX"" AND Int(Val(w[3])) < pref THEN" + NL
    t = t + "                pref = Int(Val(w[3]))" + NL
    t = t + "                best = w[4]" + NL
    t = t + "                ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF best <> """" THEN" + NL
    t = t + "        IF best.EndsWith(""."") THEN best = best.Substring(0, best.Length - 1)" + NL
    t = t + "        IF ttl < 5 THEN ttl = 5" + NL
    t = t + "        RsKeep(key, best, RsFull(domain), ttl * 1000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    RsTake(domain, reply)" + NL
    t = t + "    IF RsKnown(domain) THEN" + NL
    t = t + "        RsKeep(key, domain, RsFull(domain), RSNEG)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsKeep(key, """", """", RSNEG)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The machine (or name) that takes domain's mail: its MX, or domain itself." + NL
    t = t + "FUNCTION RsMailHost (domain AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN domain" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN domain" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where to connect for domain's mail." + NL
    t = t + "FUNCTION RsMailTarget (domain AS String) AS String" + NL
    t = t + "    RETURN RsTarget(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS say where domain's mail goes (an MX, or the domain's machine)?" + NL
    t = t + "FUNCTION RsMailKnown (domain AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN FALSE" + NL
    t = t + "    RETURN RsKnown(RsMailHost(domain)) OR NOT RsAsks(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB RsKeep (host AS String, target AS String, canon AS String, ms AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    i = rsName.IndexOf(h)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF rsName.Count >= RSMOST THEN" + NL
    t = t + "        rsName.RemoveAt(0)" + NL
    t = t + "        rsTo.RemoveAt(0)" + NL
    t = t + "        rsCanon.RemoveAt(0)" + NL
    t = t + "        rsUntil.RemoveAt(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    rsName.Add(h)" + NL
    t = t + "    rsTo.Add(target)" + NL
    t = t + "    rsCanon.Add(canon)" + NL
    t = t + "    rsUntil.Add(SYS.Ticks + ms)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where to connect for host: what SimDNS said, or host itself." + NL
    t = t + "FUNCTION RsTarget (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name host's machine was found under (www.coolsite.sim), or host." + NL
    t = t + "FUNCTION RsCanonical (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsCanon[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS answer for host (so RsTarget is its machine)?" + NL
    t = t + "FUNCTION RsKnown (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] <> """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did the name server say there is no such name (NXDOMAIN)?" + NL
    t = t + "FUNCTION RsNoSuchName (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] = """" AND rsCanon[i] = ""NXDOMAIN""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is the name server being left alone, because it didn't answer (or there" + NL
    t = t + "' is none)? rsWhy says why." + NL
    t = t + "FUNCTION RsSilent () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    IF rsServer = """" THEN RETURN TRUE" + NL
    t = t + "    RETURN rsDown AND SYS.Ticks - rsDownAt < RSQUIET" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ SimPlayer, built in" + NL
    t = t + "' PLAYER.SPK - SimPlayer, the movie player for SIM95. Plays SimMovies (.SMV)" + NL
    t = t + "' from this disk or from the web, such as the ones on SimTube." + NL
    t = t + "'" + NL
    t = t + "'   SPARK C:\PROGRAMS\PLAYER.SPK C:\MYFILES\DANCE.SMV" + NL
    t = t + "'   SPARK C:\PROGRAMS\PLAYER.SPK http://alpha/tube/movie.asp?v=2" + NL
    t = t + "'" + NL
    t = t + "' A SimMovie is text: a header, then one line per frame of drawing commands" + NL
    t = t + "' for a GUI_Canvas (see simtube/README.md). A long one is cut into parts of" + NL
    t = t + "' about 15K, each small enough for one network message, and a manifest" + NL
    t = t + "' (it starts ""SIMMOVIE-PARTS 1"") says where the parts are. SimPlayer fetches" + NL
    t = t + "' the parts one at a time and starts playing as soon as it has a few seconds" + NL
    t = t + "' in hand, like the streaming players do." + NL
    t = t + "'" + NL
    t = t + "' Fetches go one at a time and start in a timer tick of their own, inside a" + NL
    t = t + "' TRY with an empty CATCH (see SIM95-NOTES.md); pages come in through the" + NL
    t = t + "' socket's events. Playback runs off a second timer and SYS.Ticks, so a movie" + NL
    t = t + "' plays at its own speed whatever the timer manages." + NL
    t = t + "'" + NL
    t = t + "' A movie can be at a SimDNS name (http://movies.coolsite.sim/...): the name" + NL
    t = t + "' is asked about first, in a tick of its own, with the resolver's Rs..." + NL
    t = t + "' names. On its own, SimPlayer has simweb/src/RESOLVE.SPK joined on the end;" + NL
    t = t + "' built into Simxplorer it shares the browser's (tools/simxplorer-source.mjs)." + NL
    t = t + "' The request still says Host: movies.coolsite.sim." + NL
    t = t + "'" + NL
    t = t + "' For the curious (and for tests): the window's Tag says what is going on," + NL
    t = t + "'   state|frame|frames|loaded|parts in|parts|loop|mute" + NL
    t = t + "" + NL
    t = t + "CONST MvAHEAD = 3             ' seconds of movie in hand before playing" + NL
    t = t + "CONST MvPATIENCE = 8000       ' ms to wait for a web server" + NL
    t = t + "CONST MvMAXTRIES = 3" + NL
    t = t + "CONST MvMINW = 336" + NL
    t = t + "" + NL
    t = t + "VAR MvEOL AS String" + NL
    t = t + "VAR Mvwin AS GUI_Window" + NL
    t = t + "VAR Mvbar AS GUI_Menu" + NL
    t = t + "VAR MvaddrLabel AS GUI_Label" + NL
    t = t + "VAR Mvaddr AS GUI_TextBox" + NL
    t = t + "VAR MvopenBtn AS GUI_Button" + NL
    t = t + "VAR Mvscreen AS GUI_Canvas" + NL
    t = t + "VAR Mvinfo AS GUI_Label" + NL
    t = t + "VAR MvseekBar AS GUI_Canvas" + NL
    t = t + "VAR MvplayBtn AS GUI_Button" + NL
    t = t + "VAR MvstopBtn AS GUI_Button" + NL
    t = t + "VAR MvrewBtn AS GUI_Button" + NL
    t = t + "VAR MvbackBtn AS GUI_Button" + NL
    t = t + "VAR MvfwdBtn AS GUI_Button" + NL
    t = t + "VAR MvloopBox AS GUI_CheckBox" + NL
    t = t + "VAR MvmuteBox AS GUI_CheckBox" + NL
    t = t + "VAR MvtimeLabel AS GUI_Label" + NL
    t = t + "VAR Mvticker AS GUI_Timer" + NL
    t = t + "VAR Mvfetcher AS GUI_Timer" + NL
    t = t + "VAR Mvweb AS NET_Socket" + NL
    t = t + "" + NL
    t = t + "' the movie" + NL
    t = t + "VAR Mvsource AS String          ' the file or URL it came from" + NL
    t = t + "VAR MvmTitle AS String" + NL
    t = t + "VAR MvmAuthor AS String" + NL
    t = t + "VAR MvmW AS Integer = 160" + NL
    t = t + "VAR MvmH AS Integer = 120" + NL
    t = t + "VAR MvmFps AS Integer = 10" + NL
    t = t + "VAR MvmFrames AS Integer        ' as the header says; the frames themselves win once all are in" + NL
    t = t + "VAR MvmBg AS Integer" + NL
    t = t + "VAR Mvframes AS Array OF String" + NL
    t = t + "VAR MvpicNames AS Array OF String" + NL
    t = t + "VAR MvpicData AS Array OF String" + NL
    t = t + "VAR MvpartRefs AS Array OF String" + NL
    t = t + "VAR MvpartsIn AS Integer" + NL
    t = t + "VAR MvallIn AS Bool" + NL
    t = t + "VAR Mvremote AS Bool" + NL
    t = t + "VAR MvgotHeader AS Bool" + NL
    t = t + "" + NL
    t = t + "' playing" + NL
    t = t + "VAR Mvstate AS String = ""empty""   ' empty, buffering, playing, paused, stopped, ended, error" + NL
    t = t + "VAR Mvproblem AS String" + NL
    t = t + "VAR Mvcur AS Integer = -1         ' the frame on the screen" + NL
    t = t + "VAR MvwantPlay AS Bool" + NL
    t = t + "VAR Mvt0 AS Integer               ' SYS.Ticks when frame f0 was due" + NL
    t = t + "VAR Mvf0 AS Integer" + NL
    t = t + "VAR Mvdragging AS Bool" + NL
    t = t + "VAR Mvdrawing AS Bool" + NL
    t = t + "" + NL
    t = t + "' one fetch at a time" + NL
    t = t + "VAR Mvfetching AS Bool" + NL
    t = t + "VAR MvfFirst AS Bool              ' the first thing at the address (a movie or a manifest)" + NL
    t = t + "VAR MvfUrl AS String" + NL
    t = t + "VAR MvfNumber AS Integer" + NL
    t = t + "VAR MvfParts AS Array OF String" + NL
    t = t + "VAR MvfDone AS Bool" + NL
    t = t + "VAR MvfSince AS Integer" + NL
    t = t + "VAR MvfError AS String" + NL
    t = t + "VAR MvwantFirst AS Bool" + NL
    t = t + "VAR Mvtries AS Integer" + NL
    t = t + "VAR Mvinside AS Bool              ' a window of Simxplorer's, not a program of its own" + NL
    t = t + "VAR MvisOpen AS Bool" + NL
    t = t + "" + NL
    t = t + "' ================================================================ start" + NL
    t = t + "" + NL
    t = t + "SUB MvMain ()" + NL
    t = t + "    IF SYS.Args.Count > 0 THEN" + NL
    t = t + "        MvOpenPlayer(SYS.Args[0], FALSE)" + NL
    t = t + "    ELSE" + NL
    t = t + "        MvOpenPlayer("""", FALSE)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Opens the player and the movie at where (if any). Simxplorer has this same" + NL
    t = t + "' player built in (tools/build-installer.mjs renames everything Mv...) and" + NL
    t = t + "' calls it with embedded = TRUE: then it is one of the browser's windows, and" + NL
    t = t + "' closing it closes only the window. Opening another movie reuses the window." + NL
    t = t + "SUB MvOpenPlayer (where AS String, embedded AS Bool)" + NL
    t = t + "    IF MvisOpen THEN" + NL
    t = t + "        Mvwin.Show()" + NL
    t = t + "        Mvwin.Focus()" + NL
    t = t + "        IF where <> """" THEN" + NL
    t = t + "            Mvaddr.Text = where" + NL
    t = t + "            MvOpenMovie(where)" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    Mvinside = embedded" + NL
    t = t + "    MvisOpen = TRUE" + NL
    t = t + "    MvEOL = Chr(10)" + NL
    t = t + "    Mvwin = GUI_Window.New(""SimPlayer"", MvMINW, 260)" + NL
    t = t + "    Mvwin.Icon = ""app""" + NL
    t = t + "    Mvwin.onClose = MvWin_OnClose" + NL
    t = t + "    Mvwin.onKey = MvPlayer_OnKey" + NL
    t = t + "    Mvbar = GUI_Menu.New(Mvwin)" + NL
    t = t + "    Mvbar.onSelect = MvMenu_OnSelect" + NL
    t = t + "    Mvbar.AddMenu(""&File"")" + NL
    t = t + "    Mvbar.AddItem(""&File"", ""&Open File..."" + Chr(9) + ""Ctrl+O"")" + NL
    t = t + "    Mvbar.AddItem(""&File"", ""Open &URL..."" + Chr(9) + ""Ctrl+L"")" + NL
    t = t + "    Mvbar.AddSeparator(""&File"")" + NL
    t = t + "    IF Mvinside THEN" + NL
    t = t + "        Mvbar.AddItem(""&File"", ""&Close"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        Mvbar.AddItem(""&File"", ""E&xit"")" + NL
    t = t + "    END IF" + NL
    t = t + "    Mvbar.AddMenu(""&Play"")" + NL
    t = t + "    Mvbar.AddItem(""&Play"", ""&Play/Pause"" + Chr(9) + ""Space"")" + NL
    t = t + "    Mvbar.AddItem(""&Play"", ""&Stop"")" + NL
    t = t + "    Mvbar.AddItem(""&Play"", ""&Rewind"" + Chr(9) + ""Home"")" + NL
    t = t + "    Mvbar.AddItem(""&Play"", ""Step &Forward"" + Chr(9) + ""ArrowRight"")" + NL
    t = t + "    Mvbar.AddItem(""&Play"", ""Step &Back"" + Chr(9) + ""ArrowLeft"")" + NL
    t = t + "    Mvbar.AddSeparator(""&Play"")" + NL
    t = t + "    Mvbar.AddItem(""&Play"", ""&Loop"")" + NL
    t = t + "    Mvbar.AddItem(""&Play"", ""&Mute"")" + NL
    t = t + "    Mvbar.AddMenu(""&Help"")" + NL
    t = t + "    Mvbar.AddItem(""&Help"", ""&About SimPlayer"")" + NL
    t = t + "" + NL
    t = t + "    MvaddrLabel = GUI_Label.New(Mvwin)" + NL
    t = t + "    MvaddrLabel.Text = ""Address:""" + NL
    t = t + "    Mvaddr = GUI_TextBox.New(Mvwin)" + NL
    t = t + "    Mvaddr.onEnter = MvOpen_Click" + NL
    t = t + "    MvopenBtn = GUI_Button.New(Mvwin)" + NL
    t = t + "    MvopenBtn.Text = ""&Open""" + NL
    t = t + "    MvopenBtn.onClick = MvOpen_Click" + NL
    t = t + "    Mvscreen = GUI_Canvas.New(Mvwin)" + NL
    t = t + "    Mvscreen.onDraw = MvScreen_OnDraw" + NL
    t = t + "    Mvscreen.onKey = MvPlayer_OnKey" + NL
    t = t + "    Mvscreen.onMouseDown = MvScreen_OnMouseDown" + NL
    t = t + "    Mvinfo = GUI_Label.New(Mvwin)" + NL
    t = t + "    Mvinfo.Bold = TRUE" + NL
    t = t + "    MvseekBar = GUI_Canvas.New(Mvwin)" + NL
    t = t + "    MvseekBar.onDraw = MvSeek_OnDraw" + NL
    t = t + "    MvseekBar.onMouseDown = MvSeek_OnMouseDown" + NL
    t = t + "    MvseekBar.onMouseMove = MvSeek_OnMouseMove" + NL
    t = t + "    MvseekBar.onMouseUp = MvSeek_OnMouseUp" + NL
    t = t + "    MvplayBtn = GUI_Button.New(Mvwin)" + NL
    t = t + "    MvplayBtn.Text = ""&Play""" + NL
    t = t + "    MvplayBtn.onClick = MvPlay_Click" + NL
    t = t + "    MvstopBtn = GUI_Button.New(Mvwin)" + NL
    t = t + "    MvstopBtn.Text = ""&Stop""" + NL
    t = t + "    MvstopBtn.onClick = MvStop_Click" + NL
    t = t + "    MvrewBtn = GUI_Button.New(Mvwin)" + NL
    t = t + "    MvrewBtn.Text = ""Re&wind""" + NL
    t = t + "    MvrewBtn.onClick = MvRewind_Click" + NL
    t = t + "    MvbackBtn = GUI_Button.New(Mvwin)" + NL
    t = t + "    MvbackBtn.Text = ""<""" + NL
    t = t + "    MvbackBtn.onClick = MvBack_Click" + NL
    t = t + "    MvfwdBtn = GUI_Button.New(Mvwin)" + NL
    t = t + "    MvfwdBtn.Text = "">""" + NL
    t = t + "    MvfwdBtn.onClick = MvFwd_Click" + NL
    t = t + "    MvloopBox = GUI_CheckBox.New(Mvwin)" + NL
    t = t + "    MvloopBox.Text = ""&Loop""" + NL
    t = t + "    MvloopBox.onChange = MvLoop_Change" + NL
    t = t + "    MvmuteBox = GUI_CheckBox.New(Mvwin)" + NL
    t = t + "    MvmuteBox.Text = ""&Mute""" + NL
    t = t + "    MvmuteBox.onChange = MvMute_Change" + NL
    t = t + "    MvtimeLabel = GUI_Label.New(Mvwin)" + NL
    t = t + "    MvtimeLabel.Align = ""right""" + NL
    t = t + "" + NL
    t = t + "    Mvweb = NET_Socket.New()" + NL
    t = t + "    Mvweb.onMessage = MvWeb_OnMessage" + NL
    t = t + "    Mvweb.onClose = MvWeb_OnClose" + NL
    t = t + "    Mvticker = GUI_Timer.New(Mvwin)" + NL
    t = t + "    Mvticker.Interval = 50" + NL
    t = t + "    Mvticker.onTick = MvTicker_OnTick" + NL
    t = t + "    Mvticker.Start()" + NL
    t = t + "    Mvfetcher = GUI_Timer.New(Mvwin)" + NL
    t = t + "    Mvfetcher.Interval = 100" + NL
    t = t + "    Mvfetcher.onTick = MvFetcher_OnTick" + NL
    t = t + "    Mvfetcher.Start()" + NL
    t = t + "" + NL
    t = t + "    MvLayout()" + NL
    t = t + "    Mvwin.Show()" + NL
    t = t + "    MvSplash()" + NL
    t = t + "    MvRefresh()" + NL
    t = t + "    IF where <> """" THEN" + NL
    t = t + "        Mvaddr.Text = where" + NL
    t = t + "        MvOpenMovie(where)" + NL
    t = t + "    ELSE" + NL
    t = t + "        Mvaddr.Focus()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvWin_OnClose ()" + NL
    t = t + "    IF NOT Mvinside THEN SYS.Exit(0)" + NL
    t = t + "    ' inside Simxplorer: stop, and close just this window" + NL
    t = t + "    MvisOpen = FALSE" + NL
    t = t + "    Mvstate = ""empty""" + NL
    t = t + "    Mvticker.Stop()" + NL
    t = t + "    Mvfetcher.Stop()" + NL
    t = t + "    TRY" + NL
    t = t + "        Mvwin.Destroy()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Everything sized round the picture: at least MINW wide, the controls below." + NL
    t = t + "SUB MvLayout ()" + NL
    t = t + "    VAR cw AS Integer" + NL
    t = t + "    VAR sh AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    cw = MATH.Max(MvMINW, MvmW + 16)" + NL
    t = t + "    sh = MATH.Max(120, MvmH)" + NL
    t = t + "    MvaddrLabel.SetBounds(8, 8, 52, 16)" + NL
    t = t + "    Mvaddr.SetBounds(62, 4, cw - 62 - 64, 22)" + NL
    t = t + "    MvopenBtn.SetBounds(cw - 60, 4, 52, 22)" + NL
    t = t + "    Mvscreen.SetBounds(Int((cw - MvmW) / 2), 32 + Int((sh - MvmH) / 2), MvmW, MvmH)" + NL
    t = t + "    y = 32 + sh + 6" + NL
    t = t + "    Mvinfo.SetBounds(8, y, cw - 16, 16)" + NL
    t = t + "    MvseekBar.SetBounds(8, y + 20, cw - 16, 14)" + NL
    t = t + "    y = y + 40" + NL
    t = t + "    MvplayBtn.SetBounds(8, y, 56, 24)" + NL
    t = t + "    MvstopBtn.SetBounds(68, y, 48, 24)" + NL
    t = t + "    MvrewBtn.SetBounds(120, y, 60, 24)" + NL
    t = t + "    MvbackBtn.SetBounds(184, y, 24, 24)" + NL
    t = t + "    MvfwdBtn.SetBounds(210, y, 24, 24)" + NL
    t = t + "    MvloopBox.SetBounds(8, y + 30, 56, 18)" + NL
    t = t + "    MvmuteBox.SetBounds(68, y + 30, 56, 18)" + NL
    t = t + "    MvtimeLabel.SetBounds(cw - 128, y + 4, 120, 16)" + NL
    t = t + "    Mvwin.Width = cw" + NL
    t = t + "    Mvwin.Height = y + 54" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Nothing loaded yet: the SimPlayer card." + NL
    t = t + "SUB MvSplash ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    Mvscreen.Background = 4" + NL
    t = t + "    Mvscreen.Clear()" + NL
    t = t + "    FOR i = 0 TO 7" + NL
    t = t + "        Mvscreen.SetColor(4)" + NL
    t = t + "        IF i MOD 2 = 1 THEN Mvscreen.SetColor(12)" + NL
    t = t + "        Mvscreen.FillRect(0, Int(MvmH * i / 8), MvmW, 2)" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' the S logo" + NL
    t = t + "    Mvscreen.SetColor(9)" + NL
    t = t + "    Mvscreen.FillRect(Int(MvmW / 2) - 16, Int(MvmH / 2) - 34, 32, 32)" + NL
    t = t + "    Mvscreen.SetColor(15)" + NL
    t = t + "    Mvscreen.FillRect(Int(MvmW / 2) - 8, Int(MvmH / 2) - 29, 18, 4)" + NL
    t = t + "    Mvscreen.FillRect(Int(MvmW / 2) - 10, Int(MvmH / 2) - 25, 5, 6)" + NL
    t = t + "    Mvscreen.FillRect(Int(MvmW / 2) - 8, Int(MvmH / 2) - 20, 16, 4)" + NL
    t = t + "    Mvscreen.FillRect(Int(MvmW / 2) + 5, Int(MvmH / 2) - 16, 5, 6)" + NL
    t = t + "    Mvscreen.FillRect(Int(MvmW / 2) - 10, Int(MvmH / 2) - 10, 18, 4)" + NL
    t = t + "    Mvscreen.SetColor(15)" + NL
    t = t + "    Mvscreen.Text(Int(MvmW / 2) - 32, Int(MvmH / 2) + 6, ""SimPlayer"")" + NL
    t = t + "    Mvscreen.SetColor(14)" + NL
    t = t + "    Mvscreen.Text(Int(MvmW / 2) - 38, Int(MvmH / 2) + 22, ""Version 1.0"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ opening" + NL
    t = t + "" + NL
    t = t + "SUB MvReset ()" + NL
    t = t + "    Mvframes.Clear()" + NL
    t = t + "    MvpicNames.Clear()" + NL
    t = t + "    MvpicData.Clear()" + NL
    t = t + "    MvpartRefs.Clear()" + NL
    t = t + "    MvpartsIn = 0" + NL
    t = t + "    MvallIn = FALSE" + NL
    t = t + "    MvgotHeader = FALSE" + NL
    t = t + "    MvmTitle = """"" + NL
    t = t + "    MvmAuthor = """"" + NL
    t = t + "    MvmFps = 10" + NL
    t = t + "    MvmFrames = 0" + NL
    t = t + "    MvmBg = 0" + NL
    t = t + "    Mvcur = -1" + NL
    t = t + "    Mvproblem = """"" + NL
    t = t + "    Mvfetching = FALSE" + NL
    t = t + "    MvwantFirst = FALSE" + NL
    t = t + "    Mvtries = 0" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvOpenMovie (where AS String)" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    where = where.Trim()" + NL
    t = t + "    IF where = """" THEN RETURN" + NL
    t = t + "    MvReset()" + NL
    t = t + "    Mvsource = where" + NL
    t = t + "    MvwantPlay = TRUE" + NL
    t = t + "    IF where.Lower().StartsWith(""http://"") THEN" + NL
    t = t + "        Mvremote = TRUE" + NL
    t = t + "        Mvstate = ""buffering""" + NL
    t = t + "        MvwantFirst = TRUE" + NL
    t = t + "        Mvwin.Title = ""SimPlayer - "" + where" + NL
    t = t + "        MvRefresh()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    Mvremote = FALSE" + NL
    t = t + "    IF NOT FS.Exists(where) THEN" + NL
    t = t + "        MvFail(""There is no file called "" + where + ""."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    text = FS.Read(where)" + NL
    t = t + "    MvTakeFirst(text, MvDirOf(where))" + NL
    t = t + "    ' the parts of a movie on this disk are all here at once" + NL
    t = t + "    WHILE Mvstate <> ""error"" AND MvpartsIn < MvpartRefs.Count" + NL
    t = t + "        IF NOT FS.Exists(MvpartRefs[MvpartsIn]) THEN" + NL
    t = t + "            MvFail(""A part of this movie is missing: "" + MvpartRefs[MvpartsIn])" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        MvAddPart(FS.Read(MvpartRefs[MvpartsIn]))" + NL
    t = t + "    END WHILE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvFail (why AS String)" + NL
    t = t + "    Mvstate = ""error""" + NL
    t = t + "    Mvproblem = why" + NL
    t = t + "    MvwantPlay = FALSE" + NL
    t = t + "    MvRefresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The first thing read from an address: a whole movie, or a manifest that" + NL
    t = t + "' lists its parts." + NL
    t = t + "SUB MvTakeFirst (text AS String, base AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    lines = text.Lines()" + NL
    t = t + "    IF lines.Count > 0 AND lines[0].StartsWith(""SIMMOVIE-PARTS"") THEN" + NL
    t = t + "        FOR EACH line IN lines" + NL
    t = t + "            IF line.StartsWith(""part="") THEN" + NL
    t = t + "                MvpartRefs.Add(MvResolve(line.Substring(5, line.Length - 5).Trim(), base))" + NL
    t = t + "            ELSE" + NL
    t = t + "                MvHeaderLine(line)" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF MvpartRefs.Count = 0 THEN" + NL
    t = t + "            MvFail(""That manifest lists no parts."")" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        MvOpened()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF lines.Count = 0 OR NOT lines[0].StartsWith(""SIMMOVIE "") THEN" + NL
    t = t + "        MvFail(""That is not a SimMovie. A SimMovie starts with the line SIMMOVIE 1."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    MvpartRefs.Add(Mvsource)" + NL
    t = t + "    MvAddPart(text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvHeaderLine (line AS String)" + NL
    t = t + "    VAR field AS String" + NL
    t = t + "    VAR value AS String" + NL
    t = t + "    IF line.IndexOf(""="") < 1 THEN RETURN" + NL
    t = t + "    field = line.Substring(0, line.IndexOf(""="")).Trim().Lower()" + NL
    t = t + "    value = line.Substring(line.IndexOf(""="") + 1, line.Length - line.IndexOf(""="") - 1)" + NL
    t = t + "    SELECT CASE field" + NL
    t = t + "        CASE ""title""" + NL
    t = t + "            MvmTitle = value" + NL
    t = t + "        CASE ""author""" + NL
    t = t + "            MvmAuthor = value" + NL
    t = t + "        CASE ""width""" + NL
    t = t + "            MvmW = MvClamp(Int(Val(value)), 16, 320)" + NL
    t = t + "        CASE ""height""" + NL
    t = t + "            MvmH = MvClamp(Int(Val(value)), 16, 240)" + NL
    t = t + "        CASE ""fps""" + NL
    t = t + "            MvmFps = MvClamp(Int(Val(value)), 1, 30)" + NL
    t = t + "        CASE ""frames""" + NL
    t = t + "            MvmFrames = MATH.Max(0, Int(Val(value)))" + NL
    t = t + "        CASE ""bg""" + NL
    t = t + "            MvmBg = MvClamp(Int(Val(value)), 0, 15)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION MvClamp (n AS Integer, lo AS Integer, hi AS Integer) AS Integer" + NL
    t = t + "    IF n < lo THEN RETURN lo" + NL
    t = t + "    IF n > hi THEN RETURN hi" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The header is in: size the window to the picture." + NL
    t = t + "SUB MvOpened ()" + NL
    t = t + "    IF MvgotHeader THEN RETURN" + NL
    t = t + "    MvgotHeader = TRUE" + NL
    t = t + "    MvLayout()" + NL
    t = t + "    Mvscreen.Background = MvmBg" + NL
    t = t + "    Mvscreen.Clear()" + NL
    t = t + "    IF MvmTitle = """" THEN MvmTitle = ""Untitled""" + NL
    t = t + "    Mvwin.Title = ""SimPlayer - "" + MvmTitle" + NL
    t = t + "    IF MvwantPlay THEN Mvstate = ""buffering""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One part: frames, and pictures for them. The first part starts with the header." + NL
    t = t + "SUB MvAddPart (text AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    lines = text.Lines()" + NL
    t = t + "    i = 0" + NL
    t = t + "    IF lines.Count > 0 AND lines[0].StartsWith(""SIMMOVIE "") THEN" + NL
    t = t + "        i = 1" + NL
    t = t + "        WHILE i < lines.Count" + NL
    t = t + "            IF lines[i] = ""."" THEN BREAK" + NL
    t = t + "            ' a manifest has said all this already" + NL
    t = t + "            IF NOT MvgotHeader THEN MvHeaderLine(lines[i])" + NL
    t = t + "            i = i + 1" + NL
    t = t + "        END WHILE" + NL
    t = t + "        i = i + 1" + NL
    t = t + "    END IF" + NL
    t = t + "    MvOpened()" + NL
    t = t + "    WHILE i < lines.Count" + NL
    t = t + "        line = lines[i]" + NL
    t = t + "        i = i + 1" + NL
    t = t + "        IF line = """" OR line.StartsWith(""'"") THEN CONTINUE" + NL
    t = t + "        IF line.StartsWith(""!"") THEN" + NL
    t = t + "            MvAddPicture(line.Substring(1, line.Length - 1))" + NL
    t = t + "        ELSE" + NL
    t = t + "            Mvframes.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    MvpartsIn = MvpartsIn + 1" + NL
    t = t + "    IF MvpartsIn >= MvpartRefs.Count THEN" + NL
    t = t + "        MvallIn = TRUE" + NL
    t = t + "        MvmFrames = Mvframes.Count" + NL
    t = t + "    END IF" + NL
    t = t + "    MvRefresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' !name|SIM95PIC w h|row|row..." + NL
    t = t + "SUB MvAddPicture (line AS String)" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    at = line.IndexOf(""|"")" + NL
    t = t + "    IF at < 1 THEN RETURN" + NL
    t = t + "    MvpicNames.Add(line.Substring(0, at))" + NL
    t = t + "    MvpicData.Add(line.Substring(at + 1, line.Length - at - 1).Replace(""|"", MvEOL))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where a part is, from what the manifest says and where the manifest was." + NL
    t = t + "FUNCTION MvResolve (ref AS String, base AS String) AS String" + NL
    t = t + "    VAR host AS String" + NL
    t = t + "    IF ref.Lower().StartsWith(""http://"") THEN RETURN ref" + NL
    t = t + "    IF base.Lower().StartsWith(""http://"") THEN" + NL
    t = t + "        IF ref.StartsWith(""/"") THEN" + NL
    t = t + "            host = base.Substring(7, base.Length - 7)" + NL
    t = t + "            IF host.IndexOf(""/"") >= 0 THEN host = host.Substring(0, host.IndexOf(""/""))" + NL
    t = t + "            RETURN ""http://"" + host + ref" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN base + ref" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ref.Contains("":\"") THEN RETURN ref" + NL
    t = t + "    RETURN base + ref" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The folder an address is in, with its slash: http://a/tube/ or C:\MYFILES\" + NL
    t = t + "FUNCTION MvDirOf (where AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR sep AS String" + NL
    t = t + "    sep = ""\""" + NL
    t = t + "    IF where.Lower().StartsWith(""http://"") THEN" + NL
    t = t + "        sep = ""/""" + NL
    t = t + "        IF where.IndexOf(""?"") >= 0 THEN where = where.Substring(0, where.IndexOf(""?""))" + NL
    t = t + "        IF where.Substring(7, where.Length - 7).IndexOf(""/"") < 0 THEN RETURN where + ""/""" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = where.Length - 1 TO 0 STEP -1" + NL
    t = t + "        IF where.CharAt(i) = sep THEN RETURN where.Substring(0, i + 1)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION MvTotal () AS Integer" + NL
    t = t + "    IF MvallIn THEN RETURN Mvframes.Count" + NL
    t = t + "    RETURN MATH.Max(MvmFrames, Mvframes.Count)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Enough is here to play: all of it, or a few seconds past this frame." + NL
    t = t + "FUNCTION MvReady () AS Bool" + NL
    t = t + "    IF Mvframes.Count = 0 THEN RETURN FALSE" + NL
    t = t + "    IF MvallIn THEN RETURN TRUE" + NL
    t = t + "    RETURN Mvframes.Count - 1 - Mvcur >= MvmFps * MvAHEAD" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION MvPercent () AS Integer" + NL
    t = t + "    IF MvpartRefs.Count = 0 THEN RETURN 0" + NL
    t = t + "    RETURN Int(MvpartsIn * 100 / MvpartRefs.Count)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ playing" + NL
    t = t + "" + NL
    t = t + "SUB MvTicker_OnTick ()" + NL
    t = t + "    IF Mvdrawing THEN RETURN" + NL
    t = t + "    Mvdrawing = TRUE" + NL
    t = t + "    TRY" + NL
    t = t + "        MvPlayStep()" + NL
    t = t + "    CATCH err" + NL
    t = t + "        Mvwin.Status = ""Could not draw frame "" + Str(Mvcur + 1) + "": "" + err" + NL
    t = t + "    END TRY" + NL
    t = t + "    Mvdrawing = FALSE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvPlayStep ()" + NL
    t = t + "    VAR want AS Integer" + NL
    t = t + "    VAR last AS Integer" + NL
    t = t + "    IF Mvstate = ""buffering"" THEN" + NL
    t = t + "        IF MvwantPlay AND MvReady() THEN MvBeginPlay()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF Mvstate <> ""playing"" THEN RETURN" + NL
    t = t + "    want = Mvf0 + Int((SYS.Ticks - Mvt0) * MvmFps / 1000)" + NL
    t = t + "    last = MvTotal() - 1" + NL
    t = t + "    IF want > last AND MvallIn THEN" + NL
    t = t + "        IF Mvcur < last THEN MvShowFrame(last, TRUE)" + NL
    t = t + "        IF MvloopBox.Checked THEN" + NL
    t = t + "            MvShowFrame(0, TRUE)" + NL
    t = t + "            Mvt0 = SYS.Ticks" + NL
    t = t + "            Mvf0 = 0" + NL
    t = t + "        ELSE" + NL
    t = t + "            Mvstate = ""ended""" + NL
    t = t + "            MvwantPlay = FALSE" + NL
    t = t + "        END IF" + NL
    t = t + "        MvRefresh()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF want > Mvframes.Count - 1 THEN" + NL
    t = t + "        ' caught up with the download: wait for more" + NL
    t = t + "        IF Mvcur < Mvframes.Count - 1 THEN MvShowFrame(Mvframes.Count - 1, TRUE)" + NL
    t = t + "        Mvstate = ""buffering""" + NL
    t = t + "        MvRefresh()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF want > Mvcur THEN" + NL
    t = t + "        MvShowFrame(want, TRUE)" + NL
    t = t + "        MvRefresh()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvBeginPlay ()" + NL
    t = t + "    IF Mvcur >= MvTotal() - 1 THEN Mvcur = -1" + NL
    t = t + "    IF Mvcur < 0 THEN MvShowFrame(0, TRUE)" + NL
    t = t + "    Mvt0 = SYS.Ticks" + NL
    t = t + "    Mvf0 = Mvcur" + NL
    t = t + "    Mvstate = ""playing""" + NL
    t = t + "    MvwantPlay = TRUE" + NL
    t = t + "    MvRefresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvPause ()" + NL
    t = t + "    MvwantPlay = FALSE" + NL
    t = t + "    IF Mvstate = ""playing"" OR Mvstate = ""buffering"" THEN Mvstate = ""paused""" + NL
    t = t + "    MvRefresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION MvHasMovie () AS Bool" + NL
    t = t + "    RETURN Mvframes.Count > 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Frame n on the screen. Going forward, the frames in between are drawn over" + NL
    t = t + "' what is there (from a keyframe, if one comes first); anywhere else, from the" + NL
    t = t + "' keyframe before n." + NL
    t = t + "SUB MvShowFrame (n AS Integer, sound AS Bool)" + NL
    t = t + "    VAR start AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF n < 0 OR n >= Mvframes.Count THEN RETURN" + NL
    t = t + "    start = n" + NL
    t = t + "    WHILE start > 0 AND NOT Mvframes[start].StartsWith(""*"")" + NL
    t = t + "        IF start = Mvcur + 1 AND Mvcur >= 0 AND n > Mvcur THEN BREAK" + NL
    t = t + "        start = start - 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF NOT Mvframes[start].StartsWith(""*"") AND start = 0 THEN MvBlank()" + NL
    t = t + "    FOR i = start TO n" + NL
    t = t + "        MvDrawFrame(Mvframes[i], sound AND i = n)" + NL
    t = t + "    NEXT" + NL
    t = t + "    Mvcur = n" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvBlank ()" + NL
    t = t + "    Mvscreen.Background = MvmBg" + NL
    t = t + "    Mvscreen.Clear()" + NL
    t = t + "    Mvscreen.SetColor(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvDrawFrame (line AS String, sound AS Bool)" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    IF line.StartsWith(""*"") THEN" + NL
    t = t + "        MvBlank()" + NL
    t = t + "        line = line.Substring(1, line.Length - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF line = ""-"" OR line = """" THEN RETURN" + NL
    t = t + "    FOR EACH c IN line.Split("";"")" + NL
    t = t + "        IF c <> """" THEN MvDrawCmd(c, sound)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One command: a letter and its numbers." + NL
    t = t + "SUB MvDrawCmd (c AS String, sound AS Bool)" + NL
    t = t + "    VAR op AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    VAR n AS Array OF Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    op = c.CharAt(0)" + NL
    t = t + "    rest = c.Substring(1, c.Length - 1)" + NL
    t = t + "    SELECT CASE op" + NL
    t = t + "        CASE ""C""" + NL
    t = t + "            Mvscreen.SetColor(MvClamp(Int(Val(rest)), 0, 15))" + NL
    t = t + "        CASE ""B""" + NL
    t = t + "            Mvscreen.Background = MvClamp(Int(Val(rest)), 0, 15)" + NL
    t = t + "        CASE ""X""" + NL
    t = t + "            Mvscreen.Clear()" + NL
    t = t + "        CASE ""T""" + NL
    t = t + "            ' T x,y,text: the text runs to the end of the command" + NL
    t = t + "            n = MvNums(rest, 2)" + NL
    t = t + "            at = MvSecondComma(rest)" + NL
    t = t + "            IF n.Count = 2 AND at > 0 THEN Mvscreen.Text(n[0], n[1], rest.Substring(at + 1, rest.Length - at - 1))" + NL
    t = t + "        CASE ""I""" + NL
    t = t + "            n = MvNums(rest, 2)" + NL
    t = t + "            at = MvSecondComma(rest)" + NL
    t = t + "            IF n.Count = 2 AND at > 0 THEN" + NL
    t = t + "                i = MvpicNames.IndexOf(rest.Substring(at + 1, rest.Length - at - 1))" + NL
    t = t + "                IF i >= 0 THEN Mvscreen.Picture(n[0], n[1], MvpicData[i])" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""S""" + NL
    t = t + "            n = MvNums(rest, 2)" + NL
    t = t + "            IF sound AND NOT MvmuteBox.Checked AND n.Count = 2 THEN SYS.Beep(MvClamp(n[0], 37, 8000), MvClamp(n[1], 1, 1000))" + NL
    t = t + "        CASE ""R""" + NL
    t = t + "            n = MvNums(rest, 4)" + NL
    t = t + "            IF n.Count = 4 THEN Mvscreen.Rect(n[0], n[1], n[2], n[3])" + NL
    t = t + "        CASE ""F""" + NL
    t = t + "            n = MvNums(rest, 4)" + NL
    t = t + "            IF n.Count = 4 THEN Mvscreen.FillRect(n[0], n[1], n[2], n[3])" + NL
    t = t + "        CASE ""O""" + NL
    t = t + "            n = MvNums(rest, 3)" + NL
    t = t + "            IF n.Count = 3 THEN Mvscreen.Circle(n[0], n[1], n[2])" + NL
    t = t + "        CASE ""D""" + NL
    t = t + "            n = MvNums(rest, 3)" + NL
    t = t + "            IF n.Count = 3 THEN Mvscreen.FillCircle(n[0], n[1], n[2])" + NL
    t = t + "        CASE ""L""" + NL
    t = t + "            n = MvNums(rest, 0)" + NL
    t = t + "            FOR i = 0 TO Int(n.Count / 2) - 2" + NL
    t = t + "                Mvscreen.Line(n[i * 2], n[i * 2 + 1], n[i * 2 + 2], n[i * 2 + 3])" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""P""" + NL
    t = t + "            n = MvNums(rest, 0)" + NL
    t = t + "            IF n.Count >= 4 THEN" + NL
    t = t + "                FOR i = 0 TO Int(n.Count / 2) - 1" + NL
    t = t + "                    Mvscreen.Line(n[i * 2], n[i * 2 + 1], n[((i + 1) * 2) MOD (Int(n.Count / 2) * 2)], n[((i + 1) * 2) MOD (Int(n.Count / 2) * 2) + 1])" + NL
    t = t + "                NEXT" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Q""" + NL
    t = t + "            n = MvNums(rest, 0)" + NL
    t = t + "            IF n.Count >= 6 THEN MvFillPoly(n)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where the text of T x,y,text (or the name of I x,y,name) starts, less one." + NL
    t = t + "FUNCTION MvSecondComma (s AS String) AS Integer" + NL
    t = t + "    VAR a AS Integer" + NL
    t = t + "    VAR b AS Integer" + NL
    t = t + "    a = s.IndexOf("","")" + NL
    t = t + "    IF a < 0 THEN RETURN -1" + NL
    t = t + "    b = s.Substring(a + 1, s.Length - a - 1).IndexOf("","")" + NL
    t = t + "    IF b < 0 THEN RETURN -1" + NL
    t = t + "    RETURN a + 1 + b" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The numbers in ""10,20,30"". most > 0 reads only that many (T and I have" + NL
    t = t + "' text after theirs)." + NL
    t = t + "FUNCTION MvNums (s AS String, most AS Integer) AS Array OF Integer" + NL
    t = t + "    VAR out AS Array OF Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    FOR EACH p IN s.Split("","")" + NL
    t = t + "        IF most > 0 AND out.Count >= most THEN BREAK" + NL
    t = t + "        out.Add(Int(Val(p.Trim())))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A filled polygon, a row at a time: where each row crosses the edges, in" + NL
    t = t + "' pairs." + NL
    t = t + "SUB MvFillPoly (p AS Array OF Integer)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR top AS Integer" + NL
    t = t + "    VAR bottom AS Integer" + NL
    t = t + "    VAR x1 AS Integer" + NL
    t = t + "    VAR y1 AS Integer" + NL
    t = t + "    VAR x2 AS Integer" + NL
    t = t + "    VAR y2 AS Integer" + NL
    t = t + "    VAR xs AS Array OF Integer" + NL
    t = t + "    k = Int(p.Count / 2)" + NL
    t = t + "    top = p[1]" + NL
    t = t + "    bottom = p[1]" + NL
    t = t + "    FOR i = 1 TO k - 1" + NL
    t = t + "        top = MATH.Min(top, p[i * 2 + 1])" + NL
    t = t + "        bottom = MATH.Max(bottom, p[i * 2 + 1])" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR y = top TO bottom" + NL
    t = t + "        xs.Clear()" + NL
    t = t + "        FOR i = 0 TO k - 1" + NL
    t = t + "            j = (i + 1) MOD k" + NL
    t = t + "            x1 = p[i * 2]" + NL
    t = t + "            y1 = p[i * 2 + 1]" + NL
    t = t + "            x2 = p[j * 2]" + NL
    t = t + "            y2 = p[j * 2 + 1]" + NL
    t = t + "            IF (y1 <= y AND y2 > y) OR (y2 <= y AND y1 > y) THEN xs.Add(x1 + Int((y - y1) * (x2 - x1) / (y2 - y1)))" + NL
    t = t + "        NEXT" + NL
    t = t + "        xs.Sort()" + NL
    t = t + "        FOR i = 0 TO xs.Count - 2" + NL
    t = t + "            IF i MOD 2 = 0 THEN Mvscreen.Line(xs[i], y, xs[i + 1], y)" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the controls" + NL
    t = t + "" + NL
    t = t + "SUB MvPlay_Click ()" + NL
    t = t + "    IF Mvstate = ""playing"" OR (Mvstate = ""buffering"" AND MvwantPlay) THEN" + NL
    t = t + "        MvPause()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT MvHasMovie() AND NOT Mvremote THEN RETURN" + NL
    t = t + "    IF Mvstate = ""error"" THEN RETURN" + NL
    t = t + "    IF Mvstate = ""ended"" OR Mvcur >= MvTotal() - 1 THEN Mvcur = -1" + NL
    t = t + "    MvwantPlay = TRUE" + NL
    t = t + "    IF MvReady() THEN" + NL
    t = t + "        MvBeginPlay()" + NL
    t = t + "    ELSE" + NL
    t = t + "        Mvstate = ""buffering""" + NL
    t = t + "        MvRefresh()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvStop_Click ()" + NL
    t = t + "    IF NOT MvHasMovie() THEN RETURN" + NL
    t = t + "    MvwantPlay = FALSE" + NL
    t = t + "    MvShowFrame(0, FALSE)" + NL
    t = t + "    Mvstate = ""stopped""" + NL
    t = t + "    MvRefresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvRewind_Click ()" + NL
    t = t + "    MvSeekFrame(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvBack_Click ()" + NL
    t = t + "    IF NOT MvHasMovie() THEN RETURN" + NL
    t = t + "    MvPause()" + NL
    t = t + "    IF Mvstate = ""stopped"" OR Mvstate = ""ended"" THEN Mvstate = ""paused""" + NL
    t = t + "    IF Mvcur > 0 THEN MvShowFrame(Mvcur - 1, FALSE)" + NL
    t = t + "    MvRefresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvFwd_Click ()" + NL
    t = t + "    IF NOT MvHasMovie() THEN RETURN" + NL
    t = t + "    MvPause()" + NL
    t = t + "    IF Mvstate = ""stopped"" OR Mvstate = ""ended"" THEN Mvstate = ""paused""" + NL
    t = t + "    IF Mvcur < Mvframes.Count - 1 THEN MvShowFrame(Mvcur + 1, TRUE)" + NL
    t = t + "    MvRefresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Anywhere in what has arrived so far; playing carries on from there." + NL
    t = t + "SUB MvSeekFrame (n AS Integer)" + NL
    t = t + "    IF NOT MvHasMovie() THEN RETURN" + NL
    t = t + "    n = MvClamp(n, 0, Mvframes.Count - 1)" + NL
    t = t + "    MvShowFrame(n, FALSE)" + NL
    t = t + "    IF Mvstate = ""playing"" THEN" + NL
    t = t + "        Mvt0 = SYS.Ticks" + NL
    t = t + "        Mvf0 = n" + NL
    t = t + "    ELSEIF Mvstate = ""stopped"" OR Mvstate = ""ended"" THEN" + NL
    t = t + "        Mvstate = ""paused""" + NL
    t = t + "    END IF" + NL
    t = t + "    MvRefresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvLoop_Change ()" + NL
    t = t + "    Mvbar.SetChecked(""Loop"", MvloopBox.Checked)" + NL
    t = t + "    MvRefresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvMute_Change ()" + NL
    t = t + "    Mvbar.SetChecked(""Mute"", MvmuteBox.Checked)" + NL
    t = t + "    MvRefresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvOpen_Click ()" + NL
    t = t + "    MvOpenMovie(Mvaddr.Text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvOpenFile ()" + NL
    t = t + "    VAR dlg AS GUI_FileDialog" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    dlg = GUI_FileDialog.New(Mvwin)" + NL
    t = t + "    dlg.Title = ""Open a SimMovie""" + NL
    t = t + "    dlg.Filter = ""*.SMV""" + NL
    t = t + "    dlg.Path = ""C:\MYFILES""" + NL
    t = t + "    path = dlg.ShowOpen()" + NL
    t = t + "    IF path <> """" THEN" + NL
    t = t + "        Mvaddr.Text = path" + NL
    t = t + "        MvOpenMovie(path)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvPlayer_OnKey (k AS String)" + NL
    t = t + "    SELECT CASE k" + NL
    t = t + "        CASE ""Space""" + NL
    t = t + "            MvPlay_Click()" + NL
    t = t + "        CASE ""ArrowRight"", "".""" + NL
    t = t + "            MvFwd_Click()" + NL
    t = t + "        CASE ""ArrowLeft"", "",""" + NL
    t = t + "            MvBack_Click()" + NL
    t = t + "        CASE ""Home""" + NL
    t = t + "            MvRewind_Click()" + NL
    t = t + "        CASE ""Ctrl+O""" + NL
    t = t + "            MvOpenFile()" + NL
    t = t + "        CASE ""Ctrl+L""" + NL
    t = t + "            Mvaddr.Focus()" + NL
    t = t + "            Mvaddr.SelectAll()" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvScreen_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    MvPlay_Click()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvScreen_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    IF Mvcur >= 0 THEN" + NL
    t = t + "        MvShowFrame(Mvcur, FALSE)" + NL
    t = t + "    ELSEIF NOT MvHasMovie() AND Mvstate = ""empty"" THEN" + NL
    t = t + "        MvSplash()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvMenu_OnSelect (item AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    SELECT CASE item" + NL
    t = t + "        CASE ""Open File...""" + NL
    t = t + "            MvOpenFile()" + NL
    t = t + "        CASE ""Open URL...""" + NL
    t = t + "            Mvaddr.Focus()" + NL
    t = t + "            Mvaddr.SelectAll()" + NL
    t = t + "        CASE ""Exit"", ""Close""" + NL
    t = t + "            MvWin_OnClose()" + NL
    t = t + "        CASE ""Play/Pause""" + NL
    t = t + "            MvPlay_Click()" + NL
    t = t + "        CASE ""Stop""" + NL
    t = t + "            MvStop_Click()" + NL
    t = t + "        CASE ""Rewind""" + NL
    t = t + "            MvRewind_Click()" + NL
    t = t + "        CASE ""Step Forward""" + NL
    t = t + "            MvFwd_Click()" + NL
    t = t + "        CASE ""Step Back""" + NL
    t = t + "            MvBack_Click()" + NL
    t = t + "        CASE ""Loop""" + NL
    t = t + "            MvloopBox.Checked = NOT MvloopBox.Checked" + NL
    t = t + "            MvLoop_Change()" + NL
    t = t + "        CASE ""Mute""" + NL
    t = t + "            MvmuteBox.Checked = NOT MvmuteBox.Checked" + NL
    t = t + "            MvMute_Change()" + NL
    t = t + "        CASE ""About SimPlayer""" + NL
    t = t + "            box = GUI_MessageBox.New(Mvwin)" + NL
    t = t + "            box.Title = ""About SimPlayer""" + NL
    t = t + "            box.Text = ""SimPlayer 1.0 for SIM95"" + MvEOL + MvEOL + ""Plays SimMovies (.SMV) from your disk or the web, and streams the long ones while they download."" + MvEOL + MvEOL + ""Find movies on SimTube.""" + NL
    t = t + "            box.Show()" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the seek bar" + NL
    t = t + "" + NL
    t = t + "SUB MvSeek_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    MvDrawSeek()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvDrawSeek ()" + NL
    t = t + "    VAR w AS Integer" + NL
    t = t + "    VAR t AS Integer" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    w = MvseekBar.Width" + NL
    t = t + "    t = MATH.Max(1, MvTotal() - 1)" + NL
    t = t + "    MvseekBar.Background = 7" + NL
    t = t + "    MvseekBar.Clear()" + NL
    t = t + "    MvseekBar.SetColor(8)" + NL
    t = t + "    MvseekBar.Line(0, 0, w - 1, 0)" + NL
    t = t + "    MvseekBar.Line(0, 0, 0, 13)" + NL
    t = t + "    MvseekBar.SetColor(15)" + NL
    t = t + "    MvseekBar.Line(0, 13, w - 1, 13)" + NL
    t = t + "    ' downloaded, and played" + NL
    t = t + "    IF MvHasMovie() THEN" + NL
    t = t + "        MvseekBar.SetColor(6)" + NL
    t = t + "        MvseekBar.FillRect(2, 5, Int((w - 4) * MATH.Min(1, (Mvframes.Count - 1) / t)), 4)" + NL
    t = t + "        x = Int((w - 12) * MATH.Max(0, Mvcur) / t)" + NL
    t = t + "        MvseekBar.SetColor(4)" + NL
    t = t + "        MvseekBar.FillRect(2, 5, x, 4)" + NL
    t = t + "        ' the thumb" + NL
    t = t + "        MvseekBar.SetColor(7)" + NL
    t = t + "        MvseekBar.FillRect(x + 1, 1, 10, 12)" + NL
    t = t + "        MvseekBar.SetColor(15)" + NL
    t = t + "        MvseekBar.Line(x + 1, 1, x + 10, 1)" + NL
    t = t + "        MvseekBar.Line(x + 1, 1, x + 1, 12)" + NL
    t = t + "        MvseekBar.SetColor(0)" + NL
    t = t + "        MvseekBar.Line(x + 1, 12, x + 10, 12)" + NL
    t = t + "        MvseekBar.Line(x + 10, 1, x + 10, 12)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION MvFrameAt (x AS Integer) AS Integer" + NL
    t = t + "    RETURN Int(MATH.Max(0, x - 6) * MATH.Max(1, MvTotal() - 1) / MATH.Max(1, MvseekBar.Width - 12))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB MvSeek_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    Mvdragging = TRUE" + NL
    t = t + "    MvSeekFrame(MvFrameAt(x))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvSeek_OnMouseMove (x AS Integer, y AS Integer)" + NL
    t = t + "    IF Mvdragging THEN MvSeekFrame(MvFrameAt(x))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvSeek_OnMouseUp (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    IF Mvdragging THEN MvSeekFrame(MvFrameAt(x))" + NL
    t = t + "    Mvdragging = FALSE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ what it says" + NL
    t = t + "" + NL
    t = t + "FUNCTION MvClock (n AS Integer) AS String" + NL
    t = t + "    VAR s AS Integer" + NL
    t = t + "    s = Int(MATH.Max(0, n) / MvmFps)" + NL
    t = t + "    RETURN Str(Int(s / 60)) + "":"" + Str(100 + s MOD 60).Substring(1, 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB MvRefresh ()" + NL
    t = t + "    VAR what AS String" + NL
    t = t + "    VAR flag AS String" + NL
    t = t + "    SELECT CASE Mvstate" + NL
    t = t + "        CASE ""empty""" + NL
    t = t + "            what = ""Ready. Open a SimMovie (.SMV) from your disk, or type its address.""" + NL
    t = t + "        CASE ""buffering""" + NL
    t = t + "            what = ""Buffering... "" + Str(MvPercent()) + ""%""" + NL
    t = t + "            IF NOT MvgotHeader THEN what = what + ""  (connecting to "" + MvHostOf(Mvsource) + "")""" + NL
    t = t + "        CASE ""playing""" + NL
    t = t + "            what = ""Playing""" + NL
    t = t + "        CASE ""paused""" + NL
    t = t + "            what = ""Paused""" + NL
    t = t + "        CASE ""stopped""" + NL
    t = t + "            what = ""Stopped""" + NL
    t = t + "        CASE ""ended""" + NL
    t = t + "            what = ""Finished""" + NL
    t = t + "        CASE ""error""" + NL
    t = t + "            what = Mvproblem" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF Mvremote AND NOT MvallIn AND Mvstate <> ""buffering"" AND Mvstate <> ""error"" THEN what = what + ""  ("" + Str(MvPercent()) + ""% downloaded)""" + NL
    t = t + "    IF MvmuteBox.Checked AND Mvstate <> ""error"" THEN what = what + ""  [muted]""" + NL
    t = t + "    Mvwin.Status = what" + NL
    t = t + "    IF Mvstate = ""playing"" OR (Mvstate = ""buffering"" AND MvwantPlay) THEN" + NL
    t = t + "        MvplayBtn.Text = ""&Pause""" + NL
    t = t + "    ELSE" + NL
    t = t + "        MvplayBtn.Text = ""&Play""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF MvgotHeader THEN" + NL
    t = t + "        Mvinfo.Text = MvmTitle" + NL
    t = t + "        IF MvmAuthor <> """" THEN Mvinfo.Text = MvmTitle + ""  -  by "" + MvmAuthor" + NL
    t = t + "        MvtimeLabel.Text = MvClock(MATH.Max(Mvcur, 0)) + "" / "" + MvClock(MvTotal())" + NL
    t = t + "    ELSE" + NL
    t = t + "        Mvinfo.Text = """"" + NL
    t = t + "        MvtimeLabel.Text = ""0:00 / 0:00""" + NL
    t = t + "    END IF" + NL
    t = t + "    MvDrawSeek()" + NL
    t = t + "    flag = ""0|0""" + NL
    t = t + "    IF MvloopBox.Checked THEN flag = ""1|0""" + NL
    t = t + "    IF MvmuteBox.Checked THEN flag = flag.Substring(0, 2) + ""1""" + NL
    t = t + "    Mvwin.Tag = Mvstate + ""|"" + Str(Mvcur) + ""|"" + Str(MvTotal()) + ""|"" + Str(Mvframes.Count) + ""|"" + Str(MvpartsIn) + ""|"" + Str(MvpartRefs.Count) + ""|"" + flag" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION MvHostOf (url AS String) AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    IF NOT url.Lower().StartsWith(""http://"") THEN RETURN url" + NL
    t = t + "    h = url.Substring(7, url.Length - 7)" + NL
    t = t + "    IF h.IndexOf(""/"") >= 0 THEN h = h.Substring(0, h.IndexOf(""/""))" + NL
    t = t + "    RETURN h" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the web" + NL
    t = t + "" + NL
    t = t + "SUB MvFetcher_OnTick ()" + NL
    t = t + "    TRY" + NL
    t = t + "        MvFetchStep()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvFetchStep ()" + NL
    t = t + "    IF Mvfetching THEN" + NL
    t = t + "        IF MvfDone OR SYS.Ticks - MvfSince > MvPATIENCE THEN MvArrived()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT Mvremote OR Mvstate = ""error"" THEN RETURN" + NL
    t = t + "    IF MvwantFirst THEN" + NL
    t = t + "        ' a SimDNS name: ask first, in a tick of its own" + NL
    t = t + "        IF RsNext(MvHostOf(Mvsource)) THEN RETURN" + NL
    t = t + "        MvwantFirst = FALSE" + NL
    t = t + "        MvfFirst = TRUE" + NL
    t = t + "        ' (last thing in the tick: it may be spoiled)" + NL
    t = t + "        MvStartFetch(Mvsource)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF MvpartsIn < MvpartRefs.Count THEN" + NL
    t = t + "        IF RsNext(MvHostOf(MvpartRefs[MvpartsIn])) THEN RETURN" + NL
    t = t + "        MvfFirst = FALSE" + NL
    t = t + "        MvStartFetch(MvpartRefs[MvpartsIn])" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvStartFetch (url AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR host AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    Mvfetching = TRUE" + NL
    t = t + "    MvfUrl = url" + NL
    t = t + "    MvfNumber = MvfNumber + 1" + NL
    t = t + "    MvfParts.Clear()" + NL
    t = t + "    MvfDone = FALSE" + NL
    t = t + "    MvfError = """"" + NL
    t = t + "    MvfSince = SYS.Ticks" + NL
    t = t + "    host = url.Substring(7, url.Length - 7)" + NL
    t = t + "    IF host.IndexOf(""/"") < 0 THEN host = host + ""/""" + NL
    t = t + "    path = host.Substring(host.IndexOf(""/""), host.Length - host.IndexOf(""/""))" + NL
    t = t + "    host = host.Substring(0, host.IndexOf(""/""))" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = Mvweb.Connect(RsTarget(host), 80)" + NL
    t = t + "        conn.Tag = Str(MvfNumber)" + NL
    t = t + "        conn.Send(""GET "" + path + "" HTTP/1.0"" + MvEOL + ""Host: "" + host + MvEOL + ""User-Agent: SimPlayer/1.0 (SIM95)"" + MvEOL + ""Accept: video/x-simmovie"")" + NL
    t = t + "    CATCH err" + NL
    t = t + "        MvfError = err" + NL
    t = t + "        MvfDone = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvWeb_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    IF conn.Tag = Str(MvfNumber) AND NOT MvfDone THEN MvfParts.Add(message)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MvWeb_OnClose (conn AS NET_Connection)" + NL
    t = t + "    IF conn.Tag = Str(MvfNumber) THEN MvfDone = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A fetch finished (or gave up): the body, or """" with fError saying why." + NL
    t = t + "FUNCTION MvBody () AS String" + NL
    t = t + "    VAR raw AS String" + NL
    t = t + "    raw = MvfParts.Join(MvEOL)" + NL
    t = t + "    IF MvfError <> """" THEN RETURN """"" + NL
    t = t + "    IF raw = """" THEN" + NL
    t = t + "        MvfError = ""no answer""" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT raw.StartsWith(""HTTP/1.0 200"") THEN" + NL
    t = t + "        MvfError = raw.Lines()[0]" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT raw.Contains(MvEOL + MvEOL) THEN RETURN """"" + NL
    t = t + "    RETURN raw.Substring(raw.IndexOf(MvEOL + MvEOL) + 2, raw.Length - raw.IndexOf(MvEOL + MvEOL) - 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB MvArrived ()" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    Mvfetching = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        Mvweb.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF NOT Mvremote OR Mvsource = """" THEN RETURN" + NL
    t = t + "    text = MvBody()" + NL
    t = t + "    IF text = """" THEN" + NL
    t = t + "        Mvtries = Mvtries + 1" + NL
    t = t + "        IF MvfError = """" THEN MvfError = ""it was empty""" + NL
    t = t + "        IF Mvtries >= MvMAXTRIES OR MvfError.StartsWith(""HTTP"") THEN" + NL
    t = t + "            MvFail(""Could not get "" + MvfUrl + "" ("" + MvfError + "")."")" + NL
    t = t + "        ELSEIF MvfFirst THEN" + NL
    t = t + "            MvwantFirst = TRUE" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    Mvtries = 0" + NL
    t = t + "    IF MvfFirst THEN" + NL
    t = t + "        MvTakeFirst(text, MvDirOf(MvfUrl))" + NL
    t = t + "    ELSE" + NL
    t = t + "        MvAddPart(text)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    Put("C:\PROGRAMS\SIMXPLOR.SPK")
END SUB
