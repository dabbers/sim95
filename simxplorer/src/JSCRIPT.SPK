' JSCRIPT.SPK - a JavaScript interpreter written in SPARK, for the browser.
'
' It aims at the JavaScript of 1996 (what the browsers of 1996
' ran) plus a few later conveniences: var, functions and closures, if / while /
' do / for / for-in / switch / try-catch, objects and arrays, new and this,
' Math, Date, String (with the HTML helpers like "x".bold()), Array, parseInt,
' escape, eval, setTimeout, and the page itself through document and window.
' No regular expressions, no bitwise operators, no getters or prototypes
' beyond the ones built in.
'
' How it is put together, since SPARK has no records:
'   * Tokens are parallel arrays (jtType, jtText, jtLine, jtNl).
'   * The syntax tree is parallel arrays indexed by node number (nk = kind,
'     na/nb/nc/nd = child nodes, ns = a name or literal, nl = a list of nodes).
'   * A value is a tagged string: "u" undefined, "l" null, "t" / "f" booleans,
'     "n" + number, "s" + text, "o" + object number.
'   * Objects (and scopes, which are objects too) keep their properties in
'     jpVal, a slot each; joIdx is each object's index of its own, a string of
'     Chr(1) name Chr(2) slot (9 wide), searched with IndexOf. Freed slots
'     (a deleted property, a finished call's scope) go in jpFree and are used
'     again. joClass, joProto, joA, joB and
'     joS describe each object: an Array, a Function (joA = its node, joB = the
'     scope it closes over), a Native function (joS = which one), a Host
'     element (joS = its id on the page)...
'
' The page it runs in is reached through Host... functions, which the browser
' defines: HostAlert, HostConfirm, HostPrompt, HostStatus, HostNavigate,
' HostGet, HostSet, HostHas, HostInfo, HostSetInfo, HostTimeout,
' HostClearTimeout, HostHistory, HostOpen, HostSubmit, HostYield, HostSlow,
' and HostXhrSend and HostXhrAbort for XMLHttpRequest.
'
' JsReset() starts a fresh page. JsRun(source) runs a script and returns ""
' or an error ("line|message"). What document.write wrote is in jsOut.
'
' XMLHttpRequest (and IE's ActiveXObject("Microsoft.XMLHTTP")): send() hands
' the request to HostXhrSend and returns at once. The browser fetches it and
' reports back through JsXhrUpdate, which runs onreadystatechange. fetch()
' rides on the same machinery and returns a small promise (then and catch).

' ---------------------------------------------------------------- state

VAR jtType AS Array OF String
VAR jtText AS Array OF String
VAR jtLine AS Array OF Integer
VAR jtNl AS Array OF Bool
VAR jp AS Integer
VAR jsLineBase AS Integer
VAR jsLexLine AS Integer
VAR jsNodeAt AS Integer              ' the statement running (the host can tell which file it's from)

VAR nk AS Array OF String
VAR na AS Array OF Integer
VAR nb AS Array OF Integer
VAR nc AS Array OF Integer
VAR nd AS Array OF Integer
VAR ns AS Array OF String
VAR nl AS Array OF String
VAR nline AS Array OF Integer

VAR jpVal AS Array OF String
VAR jpFree AS Array OF Integer
VAR joIdx AS Array OF String
VAR joClass AS Array OF String
VAR joProto AS Array OF Integer
VAR joA AS Array OF Integer
VAR joB AS Array OF Integer
VAR joS AS Array OF String
VAR joKeys AS Array OF String

VAR jsGlobal AS Integer
VAR jsObjectProto AS Integer
VAR jsFunctionProto AS Integer
VAR jsArrayProto AS Integer
VAR jsStringProto AS Integer
VAR jsNumberProto AS Integer
VAR jsDateProto AS Integer
VAR jsDocument AS Integer
VAR jsLocation AS Integer
VAR jsFormsArray AS Integer
VAR jsXhrProto AS Integer
VAR jsPromiseProto AS Integer
VAR jsErrorProto AS Integer
VAR jsHostCache AS Array OF String   ' "id|object" for page elements already wrapped

VAR jsSig AS String                  ' "" or "b" break, "c" continue, "r" return
VAR jsRet AS String
VAR jsLine AS Integer
VAR jsDepth AS Integer
VAR jsSteps AS Integer
VAR jsLimit AS Integer
VAR jsOut AS String
VAR jsThrown AS String               ' a value a script threw, while it unwinds

CONST JSMAXDEPTH = 24
CONST JSSTEPLIMIT = 300000

' ---------------------------------------------------------------- the lexer

FUNCTION JsPeek (src AS String, i AS Integer, count AS Integer) AS String
    IF i >= src.Length THEN RETURN ""
    IF i + count > src.Length THEN RETURN src.Substring(i, src.Length - i)
    RETURN src.Substring(i, count)
END FUNCTION

SUB JsAddToken (kind AS String, text AS String, line AS Integer, newline AS Bool)
    jtType.Add(kind)
    jtText.Add(text)
    jtLine.Add(line)
    jtNl.Add(newline)
END SUB

SUB JsLex (src AS String)
    jtType.Clear()
    jtText.Clear()
    jtLine.Clear()
    jtNl.Clear()
    jsLexLine = jsLineBase
    JsLexInto(src)
    JsAddToken("eof", "", jsLexLine, TRUE)
END SUB

' The tokens of src, added to the ones so far (a template's ${...} is lexed
' this way, in the middle of the rest). jsLexLine is the line it starts on,
' and ends on.
SUB JsLexInto (src AS String)
    VAR depth AS Integer
    VAR j AS Integer
    VAR ch AS String
    VAR hexLen AS Integer
    VAR i AS Integer
    VAR n AS Integer
    VAR c AS String
    VAR line AS Integer
    VAR fresh AS Bool
    VAR start AS Integer
    VAR word AS String
    VAR q AS String
    VAR text AS String
    VAR e AS String
    VAR op AS String
    VAR ops AS Array OF String
    VAR found AS Bool
    ops = ["...", "===", "!==", "==", "=>", "!=", "<=", ">=", "&&", "||", "??", "?.", "++", "--", "+=", "-=", "*=", "/=", "%=", "+", "-", "*", "/", "%", "<", ">", "=", "!", "?", ":", ".", ",", ";", "(", ")", "{", "}", "[", "]"]
    n = src.Length
    line = jsLexLine
    fresh = TRUE
    WHILE i < n
        c = src.CharAt(i)
        IF c = Chr(10) THEN
            line = line + 1
            fresh = TRUE
            i = i + 1
            CONTINUE
        END IF
        IF c = " " OR c = Chr(9) OR c = Chr(13) THEN
            i = i + 1
            CONTINUE
        END IF
        ' Comments, including the <!-- and --> that hid scripts from old browsers
        IF JsPeek(src, i, 2) = "//" OR JsPeek(src, i, 4) = "<!--" OR (fresh AND JsPeek(src, i, 3) = "-->") THEN
            WHILE i < n AND src.CharAt(i) <> Chr(10)
                i = i + 1
            END WHILE
            CONTINUE
        END IF
        IF JsPeek(src, i, 2) = "/*" THEN
            i = i + 2
            WHILE i < n AND JsPeek(src, i, 2) <> "*/"
                IF src.CharAt(i) = Chr(10) THEN line = line + 1
                i = i + 1
            END WHILE
            i = i + 2
            CONTINUE
        END IF
        ' Numbers: 12, 3.5, .5, 1e3, 0x1F
        IF "0123456789".Contains(c) OR (c = "." AND "0123456789".Contains(JsPeek(src, i + 1, 1)) AND JsPeek(src, i + 1, 1) <> "") THEN
            start = i
            IF JsPeek(src, i, 2).Lower() = "0x" THEN
                i = i + 2
                WHILE i < n AND "0123456789abcdefABCDEF".Contains(src.CharAt(i))
                    i = i + 1
                END WHILE
            ELSE
                WHILE i < n AND "0123456789.".Contains(src.CharAt(i))
                    i = i + 1
                END WHILE
                IF i < n AND (src.CharAt(i) = "e" OR src.CharAt(i) = "E") THEN
                    i = i + 1
                    IF i < n AND (src.CharAt(i) = "+" OR src.CharAt(i) = "-") THEN i = i + 1
                    WHILE i < n AND "0123456789".Contains(src.CharAt(i))
                        i = i + 1
                    END WHILE
                END IF
            END IF
            JsAddToken("num", src.Substring(start, i - start), line, fresh)
            fresh = FALSE
            CONTINUE
        END IF
        ' Names and keywords
        IF "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$".Contains(c) THEN
            start = i
            WHILE i < n AND "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_$0123456789".Contains(src.CharAt(i))
                i = i + 1
            END WHILE
            word = src.Substring(start, i - start)
            IF "|var|let|const|class|extends|super|function|return|if|else|while|for|in|do|break|continue|new|this|true|false|null|typeof|void|delete|switch|case|default|try|catch|finally|throw|instanceof|".Contains("|" + word + "|") THEN
                JsAddToken("kw", word, line, fresh)
            ELSE
                JsAddToken("id", word, line, fresh)
            END IF
            fresh = FALSE
            CONTINUE
        END IF
        ' Strings, with backslash escapes
        IF c = """" OR c = "'" THEN
            q = c
            text = ""
            i = i + 1
            WHILE i < n AND src.CharAt(i) <> q
                c = src.CharAt(i)
                IF c = Chr(10) THEN THROW Str(line) + "|Unterminated string constant"
                IF c = "\" AND i + 1 < n THEN
                    i = i + 1
                    e = src.CharAt(i)
                    SELECT CASE e
                        CASE "n"
                            text = text + Chr(10)
                        CASE "t"
                            text = text + Chr(9)
                        CASE "r"
                            text = text + Chr(13)
                        CASE "b"
                            text = text + Chr(8)
                        CASE Chr(10)
                            line = line + 1
                        CASE "u", "x"
                            hexLen = 4
                            IF e = "x" THEN hexLen = 2
                            IF i + hexLen < n AND OnlyChars(src.Substring(i + 1, hexLen).Lower(), "0123456789abcdef") THEN
                                text = text + Chr(Int(Val(JsNumberText("0x" + src.Substring(i + 1, hexLen)))))
                                i = i + hexLen
                            ELSE
                                text = text + e
                            END IF
                        CASE ELSE
                            text = text + e
                    END SELECT
                ELSE
                    text = text + c
                END IF
                i = i + 1
            END WHILE
            IF i >= n THEN THROW Str(line) + "|Unterminated string constant"
            i = i + 1
            JsAddToken("str", text, line, fresh)
            fresh = FALSE
            CONTINUE
        END IF
        ' Template literals: `a ${b} c` is lexed as ("a" + (b) + " c")
        IF c = "`" THEN
            JsAddToken("op", "(", line, fresh)
            fresh = FALSE
            text = ""
            i = i + 1
            WHILE TRUE
                IF i >= n THEN THROW Str(line) + "|Unterminated template literal"
                c = src.CharAt(i)
                IF c = "`" THEN
                    i = i + 1
                    BREAK
                END IF
                IF c = "\" AND i + 1 < n THEN
                    i = i + 1
                    e = src.CharAt(i)
                    IF e = "n" THEN
                        text = text + Chr(10)
                    ELSEIF e = "t" THEN
                        text = text + Chr(9)
                    ELSEIF e = "r" THEN
                        text = text + Chr(13)
                    ELSEIF e = Chr(10) THEN
                        line = line + 1
                    ELSE
                        text = text + e
                    END IF
                    i = i + 1
                    CONTINUE
                END IF
                IF c = "$" AND JsPeek(src, i + 1, 1) = "{" THEN
                    JsAddToken("str", text, line, FALSE)
                    JsAddToken("op", "+", line, FALSE)
                    JsAddToken("op", "(", line, FALSE)
                    ' the expression runs to the matching }, past any strings in it
                    depth = 1
                    j = i + 2
                    WHILE j < n
                        ch = src.CharAt(j)
                        IF ch = "{" THEN
                            depth = depth + 1
                        ELSEIF ch = "}" THEN
                            depth = depth - 1
                            IF depth = 0 THEN BREAK
                        ELSEIF ch = """" OR ch = "'" OR ch = "`" THEN
                            j = j + 1
                            WHILE j < n AND src.CharAt(j) <> ch
                                IF src.CharAt(j) = "\" THEN j = j + 1
                                j = j + 1
                            END WHILE
                        END IF
                        j = j + 1
                    END WHILE
                    IF j >= n THEN THROW Str(line) + "|Unterminated template literal"
                    jsLexLine = line
                    JsLexInto(src.Substring(i + 2, j - i - 2))
                    line = jsLexLine
                    JsAddToken("op", ")", line, FALSE)
                    JsAddToken("op", "+", line, FALSE)
                    text = ""
                    i = j + 1
                    CONTINUE
                END IF
                IF c = Chr(10) THEN line = line + 1
                text = text + c
                i = i + 1
            END WHILE
            JsAddToken("str", text, line, FALSE)
            JsAddToken("op", ")", line, FALSE)
            CONTINUE
        END IF
        ' Operators, longest first (but "a ? .5 : 1" is a ? and a number)
        found = FALSE
        FOR EACH op IN ops
            IF op = "?." AND "0123456789".Contains(JsPeek(src, i + 2, 1)) AND JsPeek(src, i + 2, 1) <> "" THEN CONTINUE
            IF JsPeek(src, i, op.Length) = op THEN
                JsAddToken("op", op, line, fresh)
                i = i + op.Length
                found = TRUE
                BREAK
            END IF
        NEXT
        IF NOT found THEN THROW Str(line) + "|Invalid character"
        fresh = FALSE
    END WHILE
    jsLexLine = line
END SUB

' ---------------------------------------------------------------- the parser

FUNCTION JsNode (kind AS String, a AS Integer, b AS Integer, c AS Integer, d AS Integer, s AS String, list AS String, line AS Integer) AS Integer
    nk.Add(kind)
    na.Add(a)
    nb.Add(b)
    nc.Add(c)
    nd.Add(d)
    ns.Add(s)
    nl.Add(list)
    nline.Add(line)
    RETURN nk.Count - 1
END FUNCTION

FUNCTION JsIsOp (op AS String) AS Bool
    RETURN jtType[jp] = "op" AND jtText[jp] = op
END FUNCTION

FUNCTION JsIsKw (kw AS String) AS Bool
    RETURN jtType[jp] = "kw" AND jtText[jp] = kw
END FUNCTION

FUNCTION JsAt () AS Integer
    RETURN jtLine[jp]
END FUNCTION

SUB JsExpect (op AS String)
    IF NOT JsIsOp(op) THEN THROW Str(JsAt()) + "|Expected '" + op + "'"
    jp = jp + 1
END SUB

FUNCTION JsName () AS String
    VAR s AS String
    IF jtType[jp] <> "id" THEN THROW Str(JsAt()) + "|Expected identifier"
    s = jtText[jp]
    jp = jp + 1
    RETURN s
END FUNCTION

' The end of a statement: a ;, or a line break, a } or the end (as browsers allowed).
SUB JsSemi ()
    IF JsIsOp(";") THEN
        jp = jp + 1
    ELSEIF NOT (jtType[jp] = "eof" OR JsIsOp("}") OR jtNl[jp]) THEN
        THROW Str(JsAt()) + "|Expected ';'"
    END IF
END SUB

FUNCTION JsParse (src AS String) AS Integer
    VAR list AS Array OF String
    VAR line AS Integer
    JsLex(src)
    jp = 0
    line = JsAt()
    WHILE jtType[jp] <> "eof"
        list.Add(Str(JsStatement()))
    END WHILE
    ' (the program's own lets and consts are kept like its vars: nd = 2)
    RETURN JsNode("block", 0, 0, 0, 2, "", list.Join(","), line)
END FUNCTION

' A block with let, const or class of its own gets a scope of its own: nd = 1.
FUNCTION JsBlockNode (list AS Array OF String, line AS Integer) AS Integer
    VAR item AS String
    VAR own AS Integer
    FOR EACH item IN list
        IF item = "" THEN CONTINUE
        IF nk[Int(Val(item))] = "let" OR nk[Int(Val(item))] = "classdecl" THEN own = 1
    NEXT
    RETURN JsNode("block", 0, 0, 0, own, "", list.Join(","), line)
END FUNCTION

FUNCTION JsBlock () AS Integer
    VAR list AS Array OF String
    VAR line AS Integer
    line = JsAt()
    JsExpect("{")
    WHILE NOT JsIsOp("}")
        IF jtType[jp] = "eof" THEN THROW Str(JsAt()) + "|Expected '}'"
        list.Add(Str(JsStatement()))
    END WHILE
    jp = jp + 1
    RETURN JsBlockNode(list, line)
END FUNCTION

' var, let or const: each a name or a pattern ({a, b} = o, [x, y] = list),
' with or without a value. let and const make a "let" node.
FUNCTION JsVarList () AS Integer
    VAR list AS Array OF String
    VAR name AS String
    VAR init AS Integer
    VAR line AS Integer
    VAR kind AS String
    VAR pat AS Integer
    line = JsAt()
    kind = jtText[jp]
    jp = jp + 1
    WHILE TRUE
        name = ""
        pat = 0
        IF JsIsOp("{") OR JsIsOp("[") THEN
            pat = JsTarget(FALSE)
        ELSE
            name = JsName()
        END IF
        init = 0
        IF JsIsOp("=") THEN
            jp = jp + 1
            init = JsAssign()
        END IF
        list.Add(Str(JsNode("decl", init, pat, 0, 0, name, "", line)))
        IF NOT JsIsOp(",") THEN BREAK
        jp = jp + 1
    END WHILE
    IF kind = "var" THEN RETURN JsNode("var", 0, 0, 0, 0, "", list.Join(","), line)
    RETURN JsNode("let", 0, 0, 0, 0, kind, list.Join(","), line)
END FUNCTION

' A place a value is put: a name, or a pattern of them.
'   pname: ns = the name
'   pobj:  nl = its pprop nodes (ns = key, nb = target), nc = a ...rest target
'   parr:  nl = its targets (0 for a gap), nc = a ...rest target
' na is the default, when withDefault allows one (x = 1).
FUNCTION JsTarget (withDefault AS Bool) AS Integer
    VAR t AS Integer
    VAR line AS Integer
    VAR list AS Array OF String
    VAR key AS String
    VAR inner AS Integer
    VAR rest AS Integer
    line = JsAt()
    IF JsIsOp("{") THEN
        jp = jp + 1
        WHILE NOT JsIsOp("}")
            IF JsIsOp("...") THEN
                jp = jp + 1
                rest = JsTarget(FALSE)
            ELSE
                IF jtType[jp] = "id" OR jtType[jp] = "str" OR jtType[jp] = "kw" THEN
                    key = jtText[jp]
                ELSEIF jtType[jp] = "num" THEN
                    key = JsNumberText(jtText[jp])
                ELSE
                    THROW Str(JsAt()) + "|Expected identifier"
                END IF
                IF jtType[jp + 1] = "op" AND jtText[jp + 1] = ":" THEN
                    jp = jp + 2
                    inner = JsTarget(TRUE)
                ELSE
                    inner = JsNode("pname", 0, 0, 0, 0, JsName(), "", line)
                    IF JsIsOp("=") THEN
                        jp = jp + 1
                        na[inner] = JsAssign()
                    END IF
                END IF
                list.Add(Str(JsNode("pprop", 0, inner, 0, 0, key, "", line)))
            END IF
            IF NOT JsIsOp("}") THEN JsExpect(",")
        END WHILE
        jp = jp + 1
        t = JsNode("pobj", 0, 0, rest, 0, "", list.Join(","), line)
    ELSEIF JsIsOp("[") THEN
        jp = jp + 1
        WHILE NOT JsIsOp("]")
            IF JsIsOp(",") THEN
                list.Add("0")
                jp = jp + 1
                CONTINUE
            END IF
            IF JsIsOp("...") THEN
                jp = jp + 1
                rest = JsTarget(FALSE)
            ELSE
                list.Add(Str(JsTarget(TRUE)))
            END IF
            IF NOT JsIsOp("]") THEN JsExpect(",")
        END WHILE
        jp = jp + 1
        t = JsNode("parr", 0, 0, rest, 0, "", list.Join(","), line)
    ELSE
        t = JsNode("pname", 0, 0, 0, 0, JsName(), "", line)
    END IF
    IF withDefault AND JsIsOp("=") THEN
        jp = jp + 1
        na[t] = JsAssign()
    END IF
    RETURN t
END FUNCTION

' A function's parameters, after its "(": plain names (a, b) go in names;
' anything more (defaults, patterns, ...rest) makes a "params" node, whose nl
' is its targets and nc its rest target. Returns that node, or 0.
FUNCTION JsParams (names AS Array OF String) AS Integer
    VAR list AS Array OF String
    VAR rest AS Integer
    VAR fancy AS Bool
    VAR t AS Integer
    VAR line AS Integer
    line = JsAt()
    WHILE NOT JsIsOp(")")
        IF JsIsOp("...") THEN
            jp = jp + 1
            rest = JsTarget(FALSE)
            fancy = TRUE
        ELSE
            t = JsTarget(TRUE)
            IF nk[t] <> "pname" OR na[t] <> 0 THEN fancy = TRUE
            list.Add(Str(t))
            names.Add(ns[t])
        END IF
        IF NOT JsIsOp(")") THEN JsExpect(",")
    END WHILE
    jp = jp + 1
    IF NOT fancy THEN RETURN 0
    names.Clear()
    RETURN JsNode("params", 0, 0, rest, 0, "", list.Join(","), line)
END FUNCTION

' function name(a, b) { ... } - as a statement or an expression
FUNCTION JsFunction (kind AS String) AS Integer
    VAR name AS String
    VAR params AS Array OF String
    VAR line AS Integer
    VAR body AS Integer
    line = JsAt()
    jp = jp + 1
    IF jtType[jp] = "id" THEN name = JsName()
    IF kind = "func" AND name = "" THEN THROW Str(JsAt()) + "|Expected identifier"
    RETURN JsFunctionRest(kind, name, line)
END FUNCTION

' A function from its "(": the parameters and the body.
FUNCTION JsFunctionRest (kind AS String, name AS String, line AS Integer) AS Integer
    VAR params AS Array OF String
    VAR fancy AS Integer
    VAR body AS Integer
    JsExpect("(")
    fancy = JsParams(params)
    body = JsBlock()
    ' (a body's own lets, consts and classes are in the function's scope, beside its functions)
    nd[body] = 2
    RETURN JsNode(kind, body, fancy, 0, 0, name, params.Join(","), line)
END FUNCTION

FUNCTION JsStatement () AS Integer
    VAR line AS Integer
    VAR a AS Integer
    VAR b AS Integer
    VAR c AS Integer
    VAR d AS Integer
    VAR name AS String
    VAR list AS Array OF String
    VAR isVar AS Bool
    line = JsAt()
    IF JsIsOp("{") THEN RETURN JsBlock()
    IF JsIsOp(";") THEN
        jp = jp + 1
        RETURN JsNode("empty", 0, 0, 0, 0, "", "", line)
    END IF
    IF jtType[jp] = "kw" THEN
        SELECT CASE jtText[jp]
            CASE "var", "let", "const"
                a = JsVarList()
                JsSemi()
                RETURN a
            CASE "class"
                RETURN JsClass("classdecl")
            CASE "function"
                RETURN JsFunction("func")
            CASE "if"
                jp = jp + 1
                JsExpect("(")
                a = JsExpr()
                JsExpect(")")
                b = JsStatement()
                c = 0
                IF JsIsKw("else") THEN
                    jp = jp + 1
                    c = JsStatement()
                END IF
                RETURN JsNode("if", a, b, c, 0, "", "", line)
            CASE "while"
                jp = jp + 1
                JsExpect("(")
                a = JsExpr()
                JsExpect(")")
                RETURN JsNode("while", a, JsStatement(), 0, 0, "", "", line)
            CASE "do"
                jp = jp + 1
                b = JsStatement()
                IF NOT JsIsKw("while") THEN THROW Str(JsAt()) + "|Expected 'while'"
                jp = jp + 1
                JsExpect("(")
                a = JsExpr()
                JsExpect(")")
                IF JsIsOp(";") THEN jp = jp + 1
                RETURN JsNode("do", a, b, 0, 0, "", "", line)
            CASE "for"
                jp = jp + 1
                JsExpect("(")
                a = 0
                isVar = FALSE
                ' for (x in o), for (var x of list), for (const [k, v] of pairs)...
                d = jp
                c = 0
                IF JsIsKw("var") OR JsIsKw("let") OR JsIsKw("const") THEN
                    IF NOT JsIsKw("var") THEN c = 1
                    jp = jp + 1
                END IF
                IF jtType[jp] = "id" OR JsIsOp("{") OR JsIsOp("[") THEN
                    a = JsTarget(FALSE)
                    IF JsIsKw("in") OR (jtType[jp] = "id" AND jtText[jp] = "of") THEN
                        name = jtText[jp]
                        jp = jp + 1
                        b = JsExpr()
                        JsExpect(")")
                        IF nk[a] = "pname" THEN
                            IF name = "in" THEN RETURN JsNode("forin", b, 0, c, JsStatement(), ns[a], "", line)
                            RETURN JsNode("forof", b, 0, c, JsStatement(), ns[a], "", line)
                        END IF
                        IF name = "in" THEN RETURN JsNode("forin", b, a, c, JsStatement(), "", "", line)
                        RETURN JsNode("forof", b, a, c, JsStatement(), "", "", line)
                    END IF
                END IF
                jp = d
                a = 0
                IF JsIsKw("var") OR JsIsKw("let") OR JsIsKw("const") THEN a = JsVarList()
                IF a = 0 AND NOT JsIsOp(";") THEN
                    a = JsNode("exprst", JsExpr(), 0, 0, 0, "", "", line)
                END IF
                JsExpect(";")
                b = 0
                IF NOT JsIsOp(";") THEN b = JsExpr()
                JsExpect(";")
                c = 0
                IF NOT JsIsOp(")") THEN c = JsExpr()
                JsExpect(")")
                RETURN JsNode("for", a, b, c, JsStatement(), "", "", line)
            CASE "return"
                jp = jp + 1
                a = 0
                IF NOT (JsIsOp(";") OR JsIsOp("}") OR jtType[jp] = "eof" OR jtNl[jp]) THEN a = JsExpr()
                JsSemi()
                RETURN JsNode("return", a, 0, 0, 0, "", "", line)
            CASE "break"
                jp = jp + 1
                JsSemi()
                RETURN JsNode("break", 0, 0, 0, 0, "", "", line)
            CASE "continue"
                jp = jp + 1
                JsSemi()
                RETURN JsNode("continue", 0, 0, 0, 0, "", "", line)
            CASE "throw"
                jp = jp + 1
                a = JsExpr()
                JsSemi()
                RETURN JsNode("throw", a, 0, 0, 0, "", "", line)
            CASE "try"
                jp = jp + 1
                a = JsBlock()
                b = 0
                c = 0
                IF JsIsKw("catch") THEN
                    jp = jp + 1
                    JsExpect("(")
                    name = JsName()
                    JsExpect(")")
                    b = JsBlock()
                END IF
                IF JsIsKw("finally") THEN
                    jp = jp + 1
                    c = JsBlock()
                END IF
                RETURN JsNode("try", a, b, c, 0, name, "", line)
            CASE "switch"
                jp = jp + 1
                JsExpect("(")
                a = JsExpr()
                JsExpect(")")
                JsExpect("{")
                ' each case is a node: na = its test (0 for default), nl = its statements
                WHILE NOT JsIsOp("}")
                    IF JsIsKw("case") THEN
                        jp = jp + 1
                        b = JsExpr()
                    ELSEIF JsIsKw("default") THEN
                        jp = jp + 1
                        b = 0
                    ELSE
                        THROW Str(JsAt()) + "|Expected 'case'"
                    END IF
                    JsExpect(":")
                    c = JsNode("case", b, 0, 0, 0, "", "", JsAt())
                    WHILE NOT (JsIsKw("case") OR JsIsKw("default") OR JsIsOp("}") OR jtType[jp] = "eof")
                        IF nl[c] <> "" THEN nl[c] = nl[c] + ","
                        nl[c] = nl[c] + Str(JsStatement())
                    END WHILE
                    list.Add(Str(c))
                END WHILE
                jp = jp + 1
                RETURN JsNode("switch", a, 0, 0, 0, "", list.Join(","), line)
        END SELECT
    END IF
    a = JsExpr()
    JsSemi()
    RETURN JsNode("exprst", a, 0, 0, 0, "", "", line)
END FUNCTION

FUNCTION JsExpr () AS Integer
    VAR a AS Integer
    VAR list AS Array OF String
    a = JsAssign()
    IF NOT JsIsOp(",") THEN RETURN a
    list.Add(Str(a))
    WHILE JsIsOp(",")
        jp = jp + 1
        list.Add(Str(JsAssign()))
    END WHILE
    RETURN JsNode("seq", 0, 0, 0, 0, "", list.Join(","), JsAt())
END FUNCTION

FUNCTION JsAssign () AS Integer
    VAR left AS Integer
    VAR op AS String
    VAR line AS Integer
    line = JsAt()
    IF JsArrowAhead() THEN RETURN JsArrow()
    left = JsConditional()
    IF jtType[jp] = "op" AND "|=|+=|-=|*=|/=|%=|".Contains("|" + jtText[jp] + "|") THEN
        op = jtText[jp]
        IF nk[left] <> "id" AND nk[left] <> "member" AND nk[left] <> "index" THEN THROW Str(line) + "|Cannot assign to '" + JsDescribe(left) + "'"
        jp = jp + 1
        RETURN JsNode("assign", left, JsAssign(), 0, 0, op, "", line)
    END IF
    RETURN left
END FUNCTION

' Is an arrow function next: x => ..., () => ..., (a, b) => ...?
FUNCTION JsArrowAhead () AS Bool
    VAR k AS Integer
    VAR depth AS Integer
    IF jtType[jp] = "id" THEN RETURN jtType[jp + 1] = "op" AND jtText[jp + 1] = "=>"
    IF NOT JsIsOp("(") THEN RETURN FALSE
    ' the ) that matches, then =>
    k = jp
    WHILE jtType[k] <> "eof"
        IF jtType[k] = "op" THEN
            IF jtText[k] = "(" OR jtText[k] = "[" OR jtText[k] = "{" THEN depth = depth + 1
            IF jtText[k] = ")" OR jtText[k] = "]" OR jtText[k] = "}" THEN
                depth = depth - 1
                IF depth = 0 THEN RETURN jtType[k + 1] = "op" AND jtText[k + 1] = "=>"
            END IF
        END IF
        k = k + 1
    END WHILE
    RETURN FALSE
END FUNCTION

' An arrow function, a later convenience: a function expression marked
' (nd = 1) to keep the this of where it was made. A body that is just an
' expression returns it.
FUNCTION JsArrow () AS Integer
    VAR params AS Array OF String
    VAR line AS Integer
    VAR body AS Integer
    VAR fancy AS Integer
    line = JsAt()
    IF jtType[jp] = "id" THEN
        params.Add(JsName())
    ELSE
        jp = jp + 1
        fancy = JsParams(params)
    END IF
    JsExpect("=>")
    IF JsIsOp("{") THEN
        body = JsBlock()
        nd[body] = 2
    ELSE
        body = JsNode("return", JsAssign(), 0, 0, 0, "", "", line)
        body = JsNode("block", 0, 0, 0, 0, "", Str(body), line)
    END IF
    RETURN JsNode("funcexpr", body, fancy, 0, 1, "", params.Join(","), line)
END FUNCTION

FUNCTION JsConditional () AS Integer
    VAR test AS Integer
    VAR a AS Integer
    VAR line AS Integer
    line = JsAt()
    test = JsBinary(1)
    IF NOT JsIsOp("?") THEN RETURN test
    jp = jp + 1
    a = JsAssign()
    JsExpect(":")
    RETURN JsNode("cond", test, a, JsAssign(), 0, "", "", line)
END FUNCTION

FUNCTION JsPrec (op AS String) AS Integer
    SELECT CASE op
        CASE "||", "??"
            RETURN 1
        CASE "&&"
            RETURN 2
        CASE "==", "!=", "===", "!=="
            RETURN 3
        CASE "<", ">", "<=", ">=", "in", "instanceof"
            RETURN 4
        CASE "+", "-"
            RETURN 5
        CASE "*", "/", "%"
            RETURN 6
    END SELECT
    RETURN 0
END FUNCTION

' Precedence climbing: one loop for every binary operator level.
FUNCTION JsBinary (least AS Integer) AS Integer
    VAR left AS Integer
    VAR op AS String
    VAR prec AS Integer
    VAR line AS Integer
    left = JsUnary()
    WHILE jtType[jp] = "op" OR (jtType[jp] = "kw" AND (jtText[jp] = "in" OR jtText[jp] = "instanceof"))
        op = jtText[jp]
        prec = JsPrec(op)
        IF prec = 0 OR prec < least THEN BREAK
        line = JsAt()
        jp = jp + 1
        left = JsNode("bin", left, JsBinary(prec + 1), 0, 0, op, "", line)
    END WHILE
    RETURN left
END FUNCTION

FUNCTION JsUnary () AS Integer
    VAR op AS String
    VAR line AS Integer
    VAR a AS Integer
    line = JsAt()
    IF jtType[jp] = "op" AND (jtText[jp] = "!" OR jtText[jp] = "-" OR jtText[jp] = "+") THEN
        op = jtText[jp]
        jp = jp + 1
        RETURN JsNode("unary", JsUnary(), 0, 0, 0, op, "", line)
    END IF
    IF JsIsKw("typeof") OR JsIsKw("void") OR JsIsKw("delete") THEN
        op = jtText[jp]
        jp = jp + 1
        RETURN JsNode("unary", JsUnary(), 0, 0, 0, op, "", line)
    END IF
    IF JsIsOp("++") OR JsIsOp("--") THEN
        op = jtText[jp]
        jp = jp + 1
        a = JsUnary()
        IF nk[a] <> "id" AND nk[a] <> "member" AND nk[a] <> "index" THEN THROW Str(line) + "|Cannot assign to '" + JsDescribe(a) + "'"
        RETURN JsNode("incdec", a, 0, 0, 0, op, "pre", line)
    END IF
    a = JsPostfix()
    IF (JsIsOp("++") OR JsIsOp("--")) AND NOT jtNl[jp] THEN
        IF nk[a] <> "id" AND nk[a] <> "member" AND nk[a] <> "index" THEN THROW Str(line) + "|Cannot assign to '" + JsDescribe(a) + "'"
        op = jtText[jp]
        jp = jp + 1
        RETURN JsNode("incdec", a, 0, 0, 0, op, "post", line)
    END IF
    RETURN a
END FUNCTION

FUNCTION JsArgs () AS String
    VAR list AS Array OF String
    JsExpect("(")
    WHILE NOT JsIsOp(")")
        list.Add(Str(JsSpreadOr()))
        IF NOT JsIsOp(")") THEN JsExpect(",")
    END WHILE
    jp = jp + 1
    RETURN list.Join(",")
END FUNCTION

' ...list (a "spread" node), or an ordinary value.
FUNCTION JsSpreadOr () AS Integer
    VAR line AS Integer
    line = JsAt()
    IF JsIsOp("...") THEN
        jp = jp + 1
        RETURN JsNode("spread", JsAssign(), 0, 0, 0, "", "", line)
    END IF
    RETURN JsAssign()
END FUNCTION

' Members, calls and new: a.b, a[b], a(b), new A(b)
FUNCTION JsPostfix () AS Integer
    VAR chained AS Bool
    VAR e AS Integer
    VAR line AS Integer
    VAR callee AS Integer
    VAR args AS String
    line = JsAt()
    IF JsIsKw("new") THEN
        jp = jp + 1
        callee = JsPrimary()
        WHILE JsIsOp(".") OR JsIsOp("[")
            callee = JsMemberStep(callee)
        END WHILE
        args = ""
        IF JsIsOp("(") THEN args = JsArgs()
        e = JsNode("new", callee, 0, 0, 0, "", args, line)
    ELSE
        e = JsPrimary()
    END IF
    WHILE JsIsOp(".") OR JsIsOp("[") OR JsIsOp("(") OR JsIsOp("?.")
        IF JsIsOp("?.") THEN
            ' a?.b, a?.[k], a?.(x): undefined when a is null or undefined (nd = 1)
            line = JsAt()
            jp = jp + 1
            IF JsIsOp("(") THEN
                e = JsNode("call", e, 0, 0, 1, "", JsArgs(), line)
            ELSEIF JsIsOp("[") THEN
                e = JsMemberStep(e)
                nd[e] = 1
            ELSE
                IF jtType[jp] <> "id" AND jtType[jp] <> "kw" THEN THROW Str(JsAt()) + "|Expected identifier"
                e = JsNode("member", e, 0, 0, 1, jtText[jp], "", line)
                jp = jp + 1
            END IF
        ELSEIF JsIsOp("(") THEN
            line = JsAt()
            e = JsNode("call", e, 0, 0, 0, "", JsArgs(), line)
            IF chained THEN nd[e] = 1
        ELSE
            e = JsMemberStep(e)
            IF chained THEN nd[e] = 1
        END IF
        ' (after a ?., the rest of the chain is skipped too: a?.b.c)
        IF nd[e] = 1 THEN chained = TRUE
    END WHILE
    RETURN e
END FUNCTION

FUNCTION JsMemberStep (e AS Integer) AS Integer
    VAR line AS Integer
    VAR name AS String
    VAR key AS Integer
    line = JsAt()
    IF JsIsOp(".") THEN
        jp = jp + 1
        IF jtType[jp] <> "id" AND jtType[jp] <> "kw" THEN THROW Str(JsAt()) + "|Expected identifier"
        name = jtText[jp]
        jp = jp + 1
        RETURN JsNode("member", e, 0, 0, 0, name, "", line)
    END IF
    jp = jp + 1
    key = JsExpr()
    JsExpect("]")
    RETURN JsNode("index", e, key, 0, 0, "", "", line)
END FUNCTION

FUNCTION JsPrimary () AS Integer
    VAR line AS Integer
    VAR t AS String
    VAR text AS String
    VAR a AS Integer
    VAR list AS Array OF String
    VAR key AS String
    line = JsAt()
    t = jtType[jp]
    text = jtText[jp]
    IF t = "num" THEN
        jp = jp + 1
        RETURN JsNode("num", 0, 0, 0, 0, JsNumberText(text), "", line)
    ELSEIF t = "str" THEN
        jp = jp + 1
        RETURN JsNode("str", 0, 0, 0, 0, text, "", line)
    ELSEIF t = "id" THEN
        jp = jp + 1
        RETURN JsNode("id", 0, 0, 0, 0, text, "", line)
    ELSEIF t = "kw" THEN
        SELECT CASE text
            CASE "this", "true", "false", "null"
                jp = jp + 1
                RETURN JsNode(text, 0, 0, 0, 0, "", "", line)
            CASE "function"
                RETURN JsFunction("funcexpr")
            CASE "class"
                RETURN JsClass("classexpr")
            CASE "super"
                jp = jp + 1
                IF JsIsOp("(") THEN RETURN JsNode("supercall", 0, 0, 0, 0, "", JsArgs(), line)
                JsExpect(".")
                text = jtText[jp]
                jp = jp + 1
                RETURN JsNode("supermember", 0, 0, 0, 0, text, "", line)
        END SELECT
    ELSEIF JsIsOp("(") THEN
        jp = jp + 1
        a = JsExpr()
        JsExpect(")")
        RETURN a
    ELSEIF JsIsOp("[") THEN
        jp = jp + 1
        WHILE NOT JsIsOp("]")
            list.Add(Str(JsSpreadOr()))
            IF NOT JsIsOp("]") THEN JsExpect(",")
        END WHILE
        jp = jp + 1
        RETURN JsNode("array", 0, 0, 0, 0, "", list.Join(","), line)
    ELSEIF JsIsOp("{") THEN
        jp = jp + 1
        WHILE NOT JsIsOp("}")
            ' ...other (nb = 2), [computed]: v (nb = the key's node), a(), a
            IF JsIsOp("...") THEN
                jp = jp + 1
                list.Add(Str(JsNode("prop", JsAssign(), 2, 0, 0, "", "", line)))
                IF NOT JsIsOp("}") THEN JsExpect(",")
                CONTINUE
            END IF
            a = 0
            IF JsIsOp("[") THEN
                jp = jp + 1
                a = JsAssign()
                JsExpect("]")
                key = ""
            ELSEIF jtType[jp] = "id" OR jtType[jp] = "str" OR jtType[jp] = "kw" THEN
                key = jtText[jp]
                jp = jp + 1
            ELSEIF jtType[jp] = "num" THEN
                key = JsNumberText(jtText[jp])
                jp = jp + 1
            ELSE
                THROW Str(JsAt()) + "|Expected identifier"
            END IF
            IF JsIsOp("(") THEN
                list.Add(Str(JsNode("prop", JsFunctionRest("funcexpr", "", line), a, 0, 0, key, "", line)))
            ELSEIF a = 0 AND jtType[jp - 1] = "id" AND (JsIsOp(",") OR JsIsOp("}")) THEN
                list.Add(Str(JsNode("prop", JsNode("id", 0, 0, 0, 0, key, "", line), 0, 0, 0, key, "", line)))
            ELSE
                JsExpect(":")
                list.Add(Str(JsNode("prop", JsAssign(), a, 0, 0, key, "", line)))
            END IF
            IF NOT JsIsOp("}") THEN JsExpect(",")
        END WHILE
        jp = jp + 1
        RETURN JsNode("object", 0, 0, 0, 0, "", list.Join(","), line)
    END IF
    IF t = "eof" THEN THROW Str(line) + "|Syntax error"
    THROW Str(line) + "|Syntax error"
END FUNCTION

'class A extends B { constructor() {} m() {} static s() {} x = 1 }
' na = what it extends (0: nothing), nb = the constructor (a made-up one
' when it has none), nl = its methods and fields: "method" or "field"
' nodes, ns = the name, nb = 1 when static.
FUNCTION JsClass (kind AS String) AS Integer
    VAR line AS Integer
    VAR name AS String
    VAR sup AS Integer
    VAR ctor AS Integer
    VAR list AS Array OF String
    VAR key AS String
    VAR isStatic AS Integer
    VAR body AS Integer
    line = JsAt()
    jp = jp + 1
    IF jtType[jp] = "id" THEN name = JsName()
    IF kind = "classdecl" AND name = "" THEN THROW Str(JsAt()) + "|Expected identifier"
    IF JsIsKw("extends") THEN
        jp = jp + 1
        sup = JsPostfix()
    END IF
    JsExpect("{")
    WHILE NOT JsIsOp("}")
        IF jtType[jp] = "eof" THEN THROW Str(JsAt()) + "|Expected '}'"
        IF JsIsOp(";") THEN
            jp = jp + 1
            CONTINUE
        END IF
        isStatic = 0
        IF jtType[jp] = "id" AND jtText[jp] = "static" AND NOT (jtType[jp + 1] = "op" AND (jtText[jp + 1] = "(" OR jtText[jp + 1] = "=")) THEN
            isStatic = 1
            jp = jp + 1
        END IF
        IF jtType[jp] = "id" AND (jtText[jp] = "get" OR jtText[jp] = "set" OR jtText[jp] = "async") AND jtType[jp + 1] <> "op" THEN THROW Str(JsAt()) + "|'" + jtText[jp] + "' methods are not supported yet"
        IF jtType[jp] = "id" OR jtType[jp] = "kw" OR jtType[jp] = "str" THEN
            key = jtText[jp]
        ELSE
            THROW Str(JsAt()) + "|Expected identifier"
        END IF
        jp = jp + 1
        IF JsIsOp("(") THEN
            body = JsFunctionRest("funcexpr", "", JsAt())
            IF key = "constructor" AND isStatic = 0 THEN
                ctor = body
            ELSE
                list.Add(Str(JsNode("method", body, isStatic, 0, 0, key, "", line)))
            END IF
        ELSE
            body = 0
            IF JsIsOp("=") THEN
                jp = jp + 1
                body = JsAssign()
            END IF
            JsSemi()
            list.Add(Str(JsNode("field", body, isStatic, 0, 0, key, "", line)))
        END IF
    END WHILE
    jp = jp + 1
    IF ctor = 0 THEN
        ' class A {} gets constructor() {}; class B extends A {} gets
        ' constructor(...args) { super(...args) }
        IF sup <> 0 THEN
            body = JsNode("exprst", JsNode("supercall", 0, 0, 0, 0, "", "@all", line), 0, 0, 0, "", "", line)
            ctor = JsNode("funcexpr", JsNode("block", 0, 0, 0, 0, "", Str(body), line), 0, 0, 0, "", "", line)
        ELSE
            ctor = JsNode("funcexpr", JsNode("block", 0, 0, 0, 0, "", "", line), 0, 0, 0, "", "", line)
        END IF
    END IF
    RETURN JsNode(kind, sup, ctor, 0, 0, name, list.Join(","), line)
END FUNCTION

FUNCTION JsDescribe (n AS Integer) AS String
    SELECT CASE nk[n]
        CASE "id"
            RETURN ns[n]
        CASE "member"
            RETURN JsDescribe(na[n]) + "." + ns[n]
        CASE "index"
            RETURN JsDescribe(na[n]) + "[...]"
        CASE "call"
            RETURN JsDescribe(na[n]) + "(...)"
        CASE "this"
            RETURN "this"
    END SELECT
    RETURN "Object"
END FUNCTION

' v, which the program is about to use as an object (node n): stops with
' the message 1996 browsers gave when it is null or undefined.
FUNCTION JsNeed (v AS String, n AS Integer) AS String
    IF v = "u" OR v = "l" THEN THROW Str(nline[n]) + "|'" + JsDescribe(n) + "' is null or not an object"
    RETURN v
END FUNCTION

' The value a number literal stands for, in canonical form.
FUNCTION JsNumberText (text AS String) AS String
    VAR i AS Integer
    VAR v AS Real
    IF text.Lower().StartsWith("0x") THEN
        FOR i = 2 TO text.Length - 1
            v = v * 16 + "0123456789abcdef".IndexOf(text.CharAt(i).Lower())
        NEXT
        RETURN JsFmt(v)
    END IF
    RETURN JsFmt(Val(text))
END FUNCTION

' ---------------------------------------------------------------- numbers

' A number the way JavaScript writes it: the shortest form that reads back
' exactly (SPARK's Str rounds to six digits).
FUNCTION JsFmt (r AS Real) AS String
    VAR p AS Integer
    VAR s AS String
    IF r <> r THEN RETURN "NaN"
    IF r > 1.7976931348623157E308 THEN RETURN "Infinity"
    IF r < -1.7976931348623157E308 THEN RETURN "-Infinity"
    IF r = Int(r) AND Abs(r) < 1E21 THEN RETURN Str(Int(r))
    FOR p = 1 TO 17
        s = JsDigits(r, p, 0)
        IF Val(s) = r THEN RETURN s
        IF p >= 15 THEN
            IF Val(JsDigits(r, p, -1)) = r THEN RETURN JsDigits(r, p, -1)
            IF Val(JsDigits(r, p, 1)) = r THEN RETURN JsDigits(r, p, 1)
        END IF
    NEXT
    RETURN s
END FUNCTION

' r to p significant digits. Where 10^k is exact the digits are worked out
' exactly (Dekker's product); elsewhere they may be one out in the last
' place, which nudge makes up for.
FUNCTION JsDigits (r AS Real, p AS Integer, nudge AS Integer) AS String
    VAR a AS Real
    VAR e AS Integer
    VAR k AS Integer
    VAR digits AS Real
    VAR ds AS String
    VAR sign AS String
    VAR out AS String
    VAR frac AS String
    IF r < 0 THEN sign = "-"
    a = Abs(r)
    e = MATH.Floor(MATH.Log(a) / MATH.Log(10))
    IF 10 ^ e > a THEN e = e - 1
    IF 10 ^ (e + 1) <= a THEN e = e + 1
    k = p - 1 - e
    IF k >= 0 AND k <= 22 THEN
        ds = JsScaled(a, 10 ^ k, nudge)
    ELSE
        IF k > 300 THEN
            digits = MATH.Round(a * 10 ^ 300 * 10 ^ (k - 300)) + nudge
        ELSEIF k > 0 THEN
            digits = MATH.Round(a * 10 ^ k) + nudge
        ELSE
            digits = MATH.Round(a / 10 ^ (-k)) + nudge
        END IF
        ds = Str(Int(digits))
    END IF
    IF ds.Length > p THEN
        ds = ds.Substring(0, p)
        e = e + 1
    END IF
    WHILE ds.Length < p
        ds = ds + "0"
    END WHILE
    IF e >= 21 OR e < -6 THEN
        frac = ds.Substring(1, ds.Length - 1)
        WHILE frac.EndsWith("0")
            frac = frac.Substring(0, frac.Length - 1)
        END WHILE
        out = ds.Substring(0, 1)
        IF frac <> "" THEN out = out + "." + frac
        IF e > 0 THEN RETURN sign + out + "e+" + Str(e)
        RETURN sign + out + "e" + Str(e)
    END IF
    IF e >= 0 THEN
        out = ds.Substring(0, e + 1)
        frac = ds.Substring(e + 1, ds.Length - e - 1)
    ELSE
        out = "0"
        frac = ""
        WHILE frac.Length < -e - 1
            frac = frac + "0"
        END WHILE
        frac = frac + ds
    END IF
    WHILE frac.EndsWith("0")
        frac = frac.Substring(0, frac.Length - 1)
    END WHILE
    IF frac = "" THEN RETURN sign + out
    RETURN sign + out + "." + frac
END FUNCTION

'' round(a * scale) as digits, exactly: Dekker's two-product gives the
' rounding error of a * scale, and the digits are put together in two halves
' so no part of them goes past what a Real holds exactly.
FUNCTION JsScaled (a AS Real, scale AS Real, nudge AS Integer) AS String
    VAR prod AS Real
    VAR err AS Real
    VAR ah AS Real
    VAR al AS Real
    VAR bh AS Real
    VAR bl AS Real
    VAR c AS Real
    VAR high AS Real
    VAR low AS Real
    VAR ls AS String
    prod = a * scale
    c = 134217729.0 * a
    ah = c - (c - a)
    al = a - ah
    c = 134217729.0 * scale
    bh = c - (c - scale)
    bl = scale - bh
    err = ((ah * bh - prod) + ah * bl + al * bh) + al * bl
    high = MATH.Floor(prod / 100000000.0)
    low = prod - high * 100000000.0
    low = MATH.Floor(low + err + 0.5) + nudge
    WHILE low >= 100000000.0
        low = low - 100000000.0
        high = high + 1
    END WHILE
    WHILE low < 0
        low = low + 100000000.0
        high = high - 1
    END WHILE
    IF high <= 0 THEN RETURN Str(Int(low))
    ls = Str(Int(low))
    WHILE ls.Length < 8
        ls = "0" + ls
    END WHILE
    RETURN Str(Int(high)) + ls
END FUNCTION

' Text to number the JavaScript way: "" is 0, "12px" is NaN.
FUNCTION JsParseNumber (text AS String) AS String
    VAR t AS String
    VAR body AS String
    t = text.Trim()
    IF t = "" THEN RETURN "0"
    IF t = "Infinity" OR t = "+Infinity" THEN RETURN "Infinity"
    IF t = "-Infinity" THEN RETURN "-Infinity"
    body = t
    IF body.StartsWith("-") OR body.StartsWith("+") THEN body = body.Substring(1, body.Length - 1)
    IF body.Lower().StartsWith("0x") AND body.Length > 2 THEN
        IF OnlyChars(body.Substring(2, body.Length - 2).Lower(), "0123456789abcdef") THEN
            IF t.StartsWith("-") THEN RETURN "NaN"
            RETURN JsNumberText(body)
        END IF
        RETURN "NaN"
    END IF
    IF body = "" OR body = "." OR NOT OnlyChars(body.Lower(), "0123456789.e+-") THEN RETURN "NaN"
    IF NOT "0123456789.".Contains(body.CharAt(0)) THEN RETURN "NaN"
    RETURN JsFmt(Val(t))
END FUNCTION

FUNCTION OnlyChars (s AS String, allowed AS String) AS Bool
    VAR i AS Integer
    FOR i = 0 TO s.Length - 1
        IF NOT allowed.Contains(s.CharAt(i)) THEN RETURN FALSE
    NEXT
    RETURN TRUE
END FUNCTION

FUNCTION JsFinite (n AS String) AS Bool
    RETURN n <> "NaN" AND n <> "Infinity" AND n <> "-Infinity"
END FUNCTION

' Arithmetic on number texts, minding NaN, Infinity and division by zero.
FUNCTION JsArith (op AS String, a AS String, b AS String) AS String
    VAR x AS Real
    VAR y AS Real
    IF a = "NaN" OR b = "NaN" THEN RETURN "NaN"
    IF NOT JsFinite(a) OR NOT JsFinite(b) THEN
        IF op = "+" AND a = b THEN RETURN a
        IF op = "+" AND JsFinite(b) THEN RETURN a
        IF op = "+" AND JsFinite(a) THEN RETURN b
        IF op = "-" AND JsFinite(b) THEN RETURN a
        IF op = "*" AND JsFinite(b) AND Val(b) <> 0 THEN
            IF (Val(b) > 0) = (a = "Infinity") THEN RETURN "Infinity"
            RETURN "-Infinity"
        END IF
        IF op = "/" AND JsFinite(b) THEN RETURN a
        IF op = "/" AND JsFinite(a) THEN RETURN "0"
        RETURN "NaN"
    END IF
    x = Val(a)
    y = Val(b)
    SELECT CASE op
        CASE "+"
            RETURN JsFmt(x + y)
        CASE "-"
            RETURN JsFmt(x - y)
        CASE "*"
            RETURN JsFmt(x * y)
        CASE "/"
            IF y = 0 THEN
                IF x = 0 THEN RETURN "NaN"
                IF x > 0 THEN RETURN "Infinity"
                RETURN "-Infinity"
            END IF
            RETURN JsFmt(x / y)
        CASE "%"
            IF y = 0 THEN RETURN "NaN"
            RETURN JsFmt(x - y * Int(x / y))
    END SELECT
    RETURN "NaN"
END FUNCTION

' ---------------------------------------------------------------- values

FUNCTION JsNum (v AS String) AS String
    SELECT CASE v.Substring(0, 1)
        CASE "n"
            RETURN v.Substring(1, v.Length - 1)
        CASE "s"
            RETURN JsParseNumber(v.Substring(1, v.Length - 1))
        CASE "t"
            RETURN "1"
        CASE "f", "l"
            RETURN "0"
        CASE "o"
            IF joClass[JsId(v)] = "Date" THEN RETURN joS[JsId(v)]
            RETURN JsParseNumber(JsStr(v))
    END SELECT
    RETURN "NaN"
END FUNCTION

FUNCTION JsReal (v AS String) AS Real
    VAR n AS String
    n = JsNum(v)
    IF NOT JsFinite(n) THEN RETURN 0
    RETURN Val(n)
END FUNCTION

FUNCTION JsInt (v AS String) AS Integer
    RETURN Int(JsReal(v))
END FUNCTION

FUNCTION JsStr (v AS String) AS String
    VAR id AS Integer
    SELECT CASE v.Substring(0, 1)
        CASE "s", "n"
            RETURN v.Substring(1, v.Length - 1)
        CASE "u"
            RETURN "undefined"
        CASE "l"
            RETURN "null"
        CASE "t"
            RETURN "true"
        CASE "f"
            RETURN "false"
    END SELECT
    id = Int(Val(v.Substring(1, v.Length - 1)))
    SELECT CASE joClass[id]
        CASE "Array"
            RETURN JsJoin(id, ",")
        CASE "Function"
            RETURN Chr(10) + "function " + ns[joA[id]] + "(" + nl[joA[id]] + ") {" + Chr(10) + "    [native code]" + Chr(10) + "}" + Chr(10)
        CASE "Native"
            RETURN Chr(10) + "function " + joS[id] + "() {" + Chr(10) + "    [native code]" + Chr(10) + "}" + Chr(10)
        CASE "Date"
            RETURN JsDateText(Val(joS[id]))
        CASE "Error"
            RETURN JsStr(JsGetProp(id, "message"))
        CASE "Location"
            RETURN HostInfo("location")
    END SELECT
    RETURN "[object Object]"
END FUNCTION

FUNCTION JsBool (v AS String) AS Bool
    SELECT CASE v.Substring(0, 1)
        CASE "t", "o"
            RETURN TRUE
        CASE "n"
            RETURN v <> "n0" AND v <> "nNaN" AND v <> "n-0"
        CASE "s"
            RETURN v.Length > 1
    END SELECT
    RETURN FALSE
END FUNCTION

FUNCTION JsB (b AS Bool) AS String
    IF b THEN RETURN "t"
    RETURN "f"
END FUNCTION

FUNCTION JsN (r AS Real) AS String
    RETURN "n" + JsFmt(r)
END FUNCTION

FUNCTION JsS (s AS String) AS String
    RETURN "s" + s
END FUNCTION

FUNCTION JsO (id AS Integer) AS String
    RETURN "o" + Str(id)
END FUNCTION

FUNCTION JsId (v AS String) AS Integer
    IF NOT v.StartsWith("o") THEN RETURN 0
    RETURN Int(Val(v.Substring(1, v.Length - 1)))
END FUNCTION

FUNCTION JsTypeOf (v AS String) AS String
    SELECT CASE v.Substring(0, 1)
        CASE "u"
            RETURN "undefined"
        CASE "l"
            RETURN "object"
        CASE "t", "f"
            RETURN "boolean"
        CASE "n"
            RETURN "number"
        CASE "s"
            RETURN "string"
    END SELECT
    IF joClass[JsId(v)] = "Function" OR joClass[JsId(v)] = "Native" THEN RETURN "function"
    RETURN "object"
END FUNCTION

FUNCTION JsCallable (v AS String) AS Bool
    RETURN JsTypeOf(v) = "function"
END FUNCTION

' == : same-type compare, null equals undefined, numbers and strings meet as numbers
FUNCTION JsLooseEq (a AS String, b AS String) AS Bool
    VAR ta AS String
    VAR tb AS String
    ta = a.Substring(0, 1)
    tb = b.Substring(0, 1)
    IF (ta = "u" OR ta = "l") AND (tb = "u" OR tb = "l") THEN RETURN TRUE
    IF ta = "u" OR ta = "l" OR tb = "u" OR tb = "l" THEN RETURN FALSE
    IF ta = tb THEN
        IF ta = "n" THEN RETURN JsNumEq(JsNum(a), JsNum(b))
        RETURN a = b
    END IF
    IF ta = "o" THEN RETURN JsLooseEq(JsS(JsStr(a)), b)
    IF tb = "o" THEN RETURN JsLooseEq(a, JsS(JsStr(b)))
    RETURN JsNumEq(JsNum(a), JsNum(b))
END FUNCTION

FUNCTION JsNumEq (a AS String, b AS String) AS Bool
    IF a = "NaN" OR b = "NaN" THEN RETURN FALSE
    IF NOT JsFinite(a) OR NOT JsFinite(b) THEN RETURN a = b
    RETURN Val(a) = Val(b)
END FUNCTION

FUNCTION JsStrictEq (a AS String, b AS String) AS Bool
    IF a.Substring(0, 1) <> b.Substring(0, 1) THEN RETURN FALSE
    IF a.StartsWith("n") THEN RETURN JsNumEq(JsNum(a), JsNum(b))
    RETURN a = b
END FUNCTION

' < > <= >= : strings compare as strings, anything else as numbers
FUNCTION JsCompare (op AS String, a AS String, b AS String) AS String
    VAR x AS String
    VAR y AS String
    VAR less AS Bool
    VAR same AS Bool
    IF a.StartsWith("o") THEN a = JsS(JsStr(a))
    IF b.StartsWith("o") THEN b = JsS(JsStr(b))
    IF a.StartsWith("s") AND b.StartsWith("s") THEN
        x = a.Substring(1, a.Length - 1)
        y = b.Substring(1, b.Length - 1)
        less = x < y
        same = x = y
    ELSE
        x = JsNum(a)
        y = JsNum(b)
        IF x = "NaN" OR y = "NaN" THEN RETURN "f"
        IF NOT JsFinite(x) OR NOT JsFinite(y) THEN
            same = x = y
            less = (x = "-Infinity" AND y <> "-Infinity") OR (y = "Infinity" AND x <> "Infinity")
        ELSE
            less = Val(x) < Val(y)
            same = Val(x) = Val(y)
        END IF
    END IF
    SELECT CASE op
        CASE "<"
            RETURN JsB(less)
        CASE ">"
            RETURN JsB(NOT less AND NOT same)
        CASE "<="
            RETURN JsB(less OR same)
    END SELECT
    RETURN JsB(NOT less)
END FUNCTION

FUNCTION JsAdd (a AS String, b AS String) AS String
    IF a.StartsWith("o") THEN a = JsS(JsStr(a))
    IF b.StartsWith("o") THEN b = JsS(JsStr(b))
    IF a.StartsWith("s") OR b.StartsWith("s") THEN RETURN JsS(JsStr(a) + JsStr(b))
    RETURN "n" + JsArith("+", JsNum(a), JsNum(b))
END FUNCTION

FUNCTION JsBinOp (op AS String, a AS String, b AS String) AS String
    SELECT CASE op
        CASE "+"
            RETURN JsAdd(a, b)
        CASE "-", "*", "/", "%"
            RETURN "n" + JsArith(op, JsNum(a), JsNum(b))
        CASE "=="
            RETURN JsB(JsLooseEq(a, b))
        CASE "!="
            RETURN JsB(NOT JsLooseEq(a, b))
        CASE "==="
            RETURN JsB(JsStrictEq(a, b))
        CASE "!=="
            RETURN JsB(NOT JsStrictEq(a, b))
        CASE "<", ">", "<=", ">="
            RETURN JsCompare(op, a, b)
        CASE "in"
            IF NOT b.StartsWith("o") THEN THROW Str(jsLine) + "|Object expected"
            RETURN JsB(JsGet(b, JsKey(a)) <> "u" OR JsOwn(JsId(b), JsKey(a)) >= 0)
        CASE "instanceof"
            IF NOT JsCallable(b) THEN THROW Str(jsLine) + "|Function expected"
            RETURN JsB(JsInstanceOf(a, JsGet(b, "prototype")))
    END SELECT
    THROW Str(jsLine) + "|Syntax error"
END FUNCTION

FUNCTION JsInstanceOf (v AS String, proto AS String) AS Bool
    VAR o AS Integer
    IF NOT v.StartsWith("o") OR NOT proto.StartsWith("o") THEN RETURN FALSE
    o = joProto[JsId(v)]
    WHILE o <> 0
        IF o = JsId(proto) THEN RETURN TRUE
        o = joProto[o]
    END WHILE
    RETURN FALSE
END FUNCTION

' ---------------------------------------------------------------- objects

FUNCTION JsNewObject (class AS String, proto AS Integer) AS Integer
    joClass.Add(class)
    joProto.Add(proto)
    joA.Add(0)
    joB.Add(0)
    joS.Add("")
    joKeys.Add("|")
    joIdx.Add("")
    RETURN joClass.Count - 1
END FUNCTION

' The slot of the object's own property, or -1.
FUNCTION JsOwn (id AS Integer, name AS String) AS Integer
    VAR p AS Integer
    p = joIdx[id].IndexOf(Chr(1) + name + Chr(2))
    IF p < 0 THEN RETURN -1
    RETURN Int(Val(joIdx[id].Substring(p + name.Length + 2, 9).Trim()))
END FUNCTION

' Takes the object's own property away, and frees its slot.
SUB JsDropOwn (id AS Integer, name AS String)
    VAR k AS Integer
    k = JsOwn(id, name)
    IF k < 0 THEN RETURN
    joIdx[id] = joIdx[id].Replace(Chr(1) + name + Chr(2) + Str(k).PadLeft(9), "")
    jpVal[k] = "u"
    jpFree.Add(k)
END SUB

' Sets a property on the object itself (no host magic).
SUB JsPutOwn (id AS Integer, name AS String, v AS String)
    VAR k AS Integer
    k = JsOwn(id, name)
    IF k >= 0 THEN
        jpVal[k] = v
        RETURN
    END IF
    IF jpFree.Count > 0 THEN
        k = jpFree[jpFree.Count - 1]
        jpFree.RemoveAt(jpFree.Count - 1)
        jpVal[k] = v
    ELSE
        k = jpVal.Count
        jpVal.Add(v)
    END IF
    joIdx[id] = joIdx[id] + Chr(1) + name + Chr(2) + Str(k).PadLeft(9)
    IF NOT name.StartsWith("@") THEN joKeys[id] = joKeys[id] + name + "|"
END SUB

FUNCTION JsGetProp (id AS Integer, name AS String) AS String
    VAR k AS Integer
    VAR o AS Integer
    o = id
    WHILE o <> 0
        k = JsOwn(o, name)
        IF k >= 0 THEN RETURN jpVal[k]
        o = joProto[o]
    END WHILE
    RETURN "u"
END FUNCTION

FUNCTION JsIsIndex (name AS String) AS Bool
    RETURN name <> "" AND name.Length < 10 AND OnlyChars(name, "0123456789")
END FUNCTION

' v.name, for any value
FUNCTION JsGet (v AS String, name AS String) AS String
    VAR id AS Integer
    VAR text AS String
    SELECT CASE v.Substring(0, 1)
        CASE "u", "l"
            THROW Str(jsLine) + "|'" + name + "' is null or not an object"
        CASE "s"
            text = v.Substring(1, v.Length - 1)
            IF name = "length" THEN RETURN JsN(text.Length)
            IF JsIsIndex(name) THEN
                IF Int(Val(name)) < text.Length THEN RETURN JsS(text.CharAt(Int(Val(name))))
                RETURN "u"
            END IF
            RETURN JsGetProp(jsStringProto, name)
        CASE "n"
            RETURN JsGetProp(jsNumberProto, name)
        CASE "t", "f"
            RETURN JsGetProp(jsObjectProto, name)
    END SELECT
    id = JsId(v)
    SELECT CASE joClass[id]
        CASE "Host"
            RETURN JsHostGet(id, name)
        CASE "Style"
            RETURN JsStyleGet(id, name)
        CASE "Location"
            RETURN JsLocationGet(name)
        CASE "All"
            ' IE's document.all: every element with an id
            IF name = "item" THEN RETURN JsNative("All.item")
            IF name <> "" AND JsOwn(id, name) < 0 THEN
                IF HostHas(name) THEN RETURN JsElement(name)
            END IF
        CASE "Document"
            IF "|title|cookie|URL|lastModified|referrer|domain|".Contains("|" + name + "|") THEN RETURN JsDocumentGet(name)
        CASE "Global"
            IF name = "status" OR name = "defaultStatus" THEN RETURN JsS(HostInfo("status"))
            IF name = "location" THEN RETURN JsO(jsLocation)
        CASE "Native"
            IF name = "name" AND JsOwn(id, "name") < 0 THEN
                IF joS[id].Contains(".") THEN RETURN JsS(joS[id].Substring(joS[id].IndexOf(".") + 1, joS[id].Length - joS[id].IndexOf(".") - 1))
                RETURN JsS(joS[id])
            END IF
        CASE "Function"
            IF name = "name" AND JsOwn(id, "name") < 0 THEN
                IF JsOwn(id, "@name") >= 0 THEN RETURN JsGetProp(id, "@name")
                RETURN JsS(ns[joA[id]])
            END IF
            IF name = "prototype" AND JsOwn(id, "prototype") < 0 THEN JsPutOwn(id, "prototype", JsO(JsNewProtoFor(id)))
            IF name = "length" THEN
                IF nl[joA[id]] = "" THEN RETURN "n0"
                RETURN JsN(nl[joA[id]].Split(",").Count)
            END IF
    END SELECT
    RETURN JsGetProp(id, name)
END FUNCTION

FUNCTION JsNewProtoFor (fn AS Integer) AS Integer
    VAR p AS Integer
    p = JsNewObject("Object", jsObjectProto)
    JsPutOwn(p, "constructor", JsO(fn))
    RETURN p
END FUNCTION

' v.name = value
SUB JsPut (v AS String, name AS String, value AS String)
    VAR id AS Integer
    IF v.StartsWith("u") OR v.StartsWith("l") THEN THROW Str(jsLine) + "|'" + name + "' is null or not an object"
    IF NOT v.StartsWith("o") THEN RETURN
    id = JsId(v)
    SELECT CASE joClass[id]
        CASE "Host"
            JsHostSet(id, name, value)
            RETURN
        CASE "Style"
            JsStyleSet(id, name, value)
            RETURN
        CASE "Location"
            IF name = "href" THEN HostNavigate(JsStr(value))
            RETURN
        CASE "Document"
            IF name = "title" OR name = "cookie" THEN
                HostSetInfo(name, JsStr(value))
                RETURN
            END IF
            IF name = "location" OR name = "URL" THEN
                HostNavigate(JsStr(value))
                RETURN
            END IF
        CASE "Global"
            IF name = "status" OR name = "defaultStatus" THEN
                HostStatus(JsStr(value))
                RETURN
            END IF
            IF name = "location" THEN
                HostNavigate(JsStr(value))
                RETURN
            END IF
        CASE "Array"
            IF name = "length" THEN
                JsSetLength(id, JsInt(value))
                RETURN
            END IF
            IF JsIsIndex(name) THEN
                IF Int(Val(name)) >= JsInt(JsGetProp(id, "length")) THEN JsPutOwn(id, "length", JsN(Int(Val(name)) + 1))
            END IF
    END SELECT
    JsPutOwn(id, name, value)
END SUB

SUB JsSetLength (id AS Integer, n AS Integer)
    VAR old AS Integer
    VAR i AS Integer
    VAR k AS Integer
    old = JsInt(JsGetProp(id, "length"))
    FOR i = n TO old - 1
        IF JsOwn(id, Str(i)) >= 0 THEN
            JsDropOwn(id, Str(i))
            joKeys[id] = joKeys[id].Replace("|" + Str(i) + "|", "|")
        END IF
    NEXT
    JsPutOwn(id, "length", JsN(n))
END SUB

FUNCTION JsKey (v AS String) AS String
    IF v.StartsWith("n") AND JsFinite(JsNum(v)) THEN
        IF JsReal(v) = Int(JsReal(v)) THEN RETURN Str(Int(JsReal(v)))
    END IF
    RETURN JsStr(v)
END FUNCTION

FUNCTION JsNewArray (items AS Array OF String) AS Integer
    VAR id AS Integer
    VAR i AS Integer
    id = JsNewObject("Array", jsArrayProto)
    FOR i = 0 TO items.Count - 1
        JsPutOwn(id, Str(i), items[i])
    NEXT
    JsPutOwn(id, "length", JsN(items.Count))
    RETURN id
END FUNCTION

FUNCTION JsItems (id AS Integer) AS Array OF String
    VAR out AS Array OF String
    VAR i AS Integer
    VAR n AS Integer
    n = JsInt(JsGetProp(id, "length"))
    FOR i = 0 TO n - 1
        out.Add(JsGetProp(id, Str(i)))
    NEXT
    RETURN out
END FUNCTION

FUNCTION JsJoin (id AS Integer, sep AS String) AS String
    VAR parts AS Array OF String
    VAR v AS String
    FOR EACH v IN JsItems(id)
        IF v = "u" OR v = "l" THEN
            parts.Add("")
        ELSE
            parts.Add(JsStr(v))
        END IF
    NEXT
    RETURN parts.Join(sep)
END FUNCTION

FUNCTION JsNative (name AS String) AS String
    VAR id AS Integer
    id = JsNewObject("Native", jsFunctionProto)
    joS[id] = name
    RETURN JsO(id)
END FUNCTION

SUB JsMethods (owner AS Integer, prefix AS String, names AS String)
    VAR m AS String
    FOR EACH m IN names.Split(",")
        JsPutOwn(owner, m, JsNative(prefix + m))
    NEXT
END SUB

' ---------------------------------------------------------------- the page's objects

FUNCTION JsElement (elementId AS String) AS String
    VAR entry AS String
    VAR id AS Integer
    VAR style AS Integer
    FOR EACH entry IN jsHostCache
        IF entry.StartsWith(elementId + "|") THEN RETURN "o" + entry.Substring(elementId.Length + 1, entry.Length - elementId.Length - 1)
    NEXT
    id = JsNewObject("Host", jsObjectProto)
    joS[id] = elementId
    style = JsNewObject("Style", jsObjectProto)
    joS[style] = elementId
    joA[id] = style
    jsHostCache.Add(elementId + "|" + Str(id))
    RETURN JsO(id)
END FUNCTION

FUNCTION JsHostGet (id AS Integer, name AS String) AS String
    VAR el AS String
    el = joS[id]
    SELECT CASE name
        CASE "value"
            RETURN JsS(HostGet(el, "Value"))
        CASE "innerText", "innerHTML", "text", "textContent"
            RETURN JsS(HostGet(el, "Text"))
        CASE "checked"
            RETURN JsB(HostGet(el, "Checked") = "True")
        CASE "disabled"
            RETURN JsB(HostGet(el, "Enabled") <> "True")
        CASE "id"
            RETURN JsS(HostGet(el, "Id"))
        CASE "name"
            IF JsOwn(id, "name") >= 0 THEN RETURN JsGetProp(id, "name")
            RETURN JsS(HostGet(el, "Id"))
        CASE "tagName", "nodeName"
            RETURN JsS(HostGet(el, "TagName"))
        CASE "style"
            RETURN JsO(joA[id])
        CASE "focus", "blur", "select", "click"
            RETURN JsNative("Element." + name)
    END SELECT
    RETURN JsGetProp(id, name)
END FUNCTION

SUB JsHostSet (id AS Integer, name AS String, value AS String)
    VAR el AS String
    el = joS[id]
    SELECT CASE name
        CASE "value"
            HostSet(el, "Value", JsStr(value))
        CASE "innerText", "innerHTML", "text", "textContent"
            HostSet(el, "Text", JsStr(value))
        CASE "checked"
            HostSet(el, "Checked", Str(JsBool(value)))
        CASE "disabled"
            HostSet(el, "Enabled", Str(NOT JsBool(value)))
        CASE ELSE
            JsPutOwn(id, name, value)
    END SELECT
END SUB

FUNCTION JsStyleGet (id AS Integer, name AS String) AS String
    IF name = "display" THEN
        IF HostGet(joS[id], "Visible") = "True" THEN RETURN JsS("")
        RETURN JsS("none")
    END IF
    IF name = "visibility" THEN
        IF HostGet(joS[id], "Visible") = "True" THEN RETURN JsS("visible")
        RETURN JsS("hidden")
    END IF
    RETURN JsGetProp(id, name)
END FUNCTION

SUB JsStyleSet (id AS Integer, name AS String, value AS String)
    IF name = "display" THEN
        HostSet(joS[id], "Visible", Str(JsStr(value) <> "none"))
    ELSEIF name = "visibility" THEN
        HostSet(joS[id], "Visible", Str(JsStr(value) <> "hidden"))
    ELSE
        JsPutOwn(id, name, value)
    END IF
END SUB

FUNCTION JsLocationGet (name AS String) AS String
    VAR url AS String
    VAR rest AS String
    url = HostInfo("location")
    rest = url
    IF rest.StartsWith("http://") THEN rest = rest.Substring(7, rest.Length - 7)
    SELECT CASE name
        CASE "href"
            RETURN JsS(url)
        CASE "protocol"
            RETURN JsS(url.Substring(0, url.IndexOf(":") + 1))
        CASE "host", "hostname"
            IF rest.Contains("/") THEN rest = rest.Substring(0, rest.IndexOf("/"))
            RETURN JsS(rest)
        CASE "pathname"
            IF NOT rest.Contains("/") THEN RETURN JsS("/")
            rest = rest.Substring(rest.IndexOf("/"), rest.Length - rest.IndexOf("/"))
            IF rest.Contains("?") THEN rest = rest.Substring(0, rest.IndexOf("?"))
            RETURN JsS(rest)
        CASE "search"
            IF NOT url.Contains("?") THEN RETURN JsS("")
            rest = url.Substring(url.IndexOf("?"), url.Length - url.IndexOf("?"))
            IF rest.Contains("#") THEN rest = rest.Substring(0, rest.IndexOf("#"))
            RETURN JsS(rest)
        CASE "hash"
            IF NOT url.Contains("#") THEN RETURN JsS("")
            RETURN JsS(url.Substring(url.IndexOf("#"), url.Length - url.IndexOf("#")))
        CASE "reload", "replace", "assign", "toString"
            RETURN JsNative("location." + name)
    END SELECT
    RETURN "u"
END FUNCTION

FUNCTION JsDocumentGet (name AS String) AS String
    SELECT CASE name
        CASE "URL"
            RETURN JsS(HostInfo("location"))
        CASE "lastModified"
            RETURN JsS(TIME.Date + " " + TIME.Clock)
        CASE "domain"
            RETURN JsLocationGet("host")
    END SELECT
    RETURN JsS(HostInfo(name))
END FUNCTION

' A form on the page: document.forms[i], and document.<its name> if it has one.
FUNCTION JsAddForm (name AS String, index AS Integer) AS Integer
    VAR id AS Integer
    VAR none AS Array OF String
    id = JsNewObject("Form", jsObjectProto)
    joA[id] = index
    JsPutOwn(id, "name", JsS(name))
    JsPutOwn(id, "elements", JsO(JsNewArray(none)))
    JsPutOwn(id, "submit", JsNative("Form.submit"))
    JsPutOwn(id, "reset", JsNative("Element.focus"))
    JsPut(JsO(jsFormsArray), Str(index), JsO(id))
    IF name <> "" THEN JsPutOwn(jsDocument, name, JsO(id))
    RETURN id
END FUNCTION

' A field of a form: form.<name>, and form.elements[i].
SUB JsAddField (form AS Integer, name AS String, elementId AS String)
    VAR el AS String
    VAR list AS Integer
    el = JsElement(elementId)
    JsPutOwn(JsId(el), "name", JsS(name))
    JsPutOwn(JsId(el), "form", JsO(form))
    ' fields hide the form's own properties (a field called "name" wins), but
    ' the first of several fields with one name keeps it
    IF name <> "" THEN
        IF JsOwn(form, name) < 0 THEN
            JsPutOwn(form, name, el)
        ELSEIF NOT jpVal[JsOwn(form, name)].StartsWith("o") OR joClass[JsId(jpVal[JsOwn(form, name)])] <> "Host" THEN
            JsPutOwn(form, name, el)
        END IF
    END IF
    list = JsId(JsGetProp(form, "elements"))
    JsPut(JsO(list), Str(JsInt(JsGetProp(list, "length"))), el)
    JsPutOwn(form, "length", JsGetProp(list, "length"))
END SUB

' ---------------------------------------------------------------- scopes

' A scope is an object too: its variables are its properties, joA its parent
' and "@this" what this means inside it. The global scope is window itself.
FUNCTION JsNewScope (parent AS Integer, thisVal AS String) AS Integer
    VAR id AS Integer
    id = JsNewObject("Scope", 0)
    joA[id] = parent
    JsPutOwn(id, "@this", thisVal)
    RETURN id
END FUNCTION

FUNCTION JsFindScope (name AS String, scope AS Integer) AS Integer
    VAR s AS Integer
    s = scope
    WHILE s <> 0
        IF JsOwn(s, name) >= 0 THEN RETURN s
        s = joA[s]
    END WHILE
    RETURN 0
END FUNCTION

FUNCTION JsLookup (name AS String, scope AS Integer) AS String
    VAR s AS Integer
    IF name = "undefined" THEN RETURN "u"
    IF name = "status" OR name = "location" OR name = "defaultStatus" THEN
        IF JsFindScope(name, scope) = 0 OR JsFindScope(name, scope) = jsGlobal THEN RETURN JsGet(JsO(jsGlobal), name)
    END IF
    s = JsFindScope(name, scope)
    IF s = 0 THEN THROW Str(jsLine) + "|'" + name + "' is undefined"
    RETURN jpVal[JsOwn(s, name)]
END FUNCTION

SUB JsSetVar (name AS String, v AS String, scope AS Integer)
    VAR s AS Integer
    s = JsFindScope(name, scope)
    IF s = 0 OR s = jsGlobal THEN
        JsPut(JsO(jsGlobal), name, v)
    ELSE
        jpVal[JsOwn(s, name)] = v
    END IF
END SUB

FUNCTION JsThisOf (scope AS Integer) AS String
    VAR s AS Integer
    VAR k AS Integer
    s = scope
    WHILE s <> 0
        k = JsOwn(s, "@this")
        IF k >= 0 THEN RETURN jpVal[k]
        s = joA[s]
    END WHILE
    RETURN JsO(jsGlobal)
END FUNCTION

' Functions and vars are known before a body runs (JavaScript "hoisting").
SUB JsHoist (n AS Integer, scope AS Integer)
    VAR item AS String
    VAR d AS String
    IF n = 0 THEN RETURN
    SELECT CASE nk[n]
        CASE "block"
            FOR EACH item IN nl[n].Split(",")
                IF item = "" THEN CONTINUE
                ' the program's own lets, consts and classes are kept like vars
                IF nd[n] = 2 AND (nk[Int(Val(item))] = "let" OR nk[Int(Val(item))] = "classdecl") THEN
                    FOR EACH d IN JsDeclNames(Int(Val(item)))
                        IF JsOwn(scope, d) < 0 THEN JsPutOwn(scope, d, "u")
                    NEXT
                END IF
                JsHoist(Int(Val(item)), scope)
            NEXT
        CASE "func"
            JsPutOwn(scope, ns[n], JsMakeFunction(n, scope))
        CASE "var"
            FOR EACH d IN JsDeclNames(n)
                IF JsOwn(scope, d) < 0 THEN JsPutOwn(scope, d, "u")
            NEXT
        CASE "if"
            JsHoist(nb[n], scope)
            JsHoist(nc[n], scope)
        CASE "while", "do"
            JsHoist(nb[n], scope)
        CASE "for"
            JsHoist(na[n], scope)
            JsHoist(nd[n], scope)
        CASE "forin", "forof"
            IF nc[n] = 0 THEN
                IF nb[n] <> 0 THEN
                    FOR EACH d IN JsPatternNames(nb[n])
                        IF JsOwn(scope, d) < 0 AND scope <> jsGlobal THEN JsPutOwn(scope, d, "u")
                    NEXT
                ELSEIF JsOwn(scope, ns[n]) < 0 AND scope <> jsGlobal THEN
                    JsPutOwn(scope, ns[n], "u")
                END IF
            END IF
            JsHoist(nd[n], scope)
        CASE "try"
            JsHoist(na[n], scope)
            JsHoist(nb[n], scope)
            JsHoist(nc[n], scope)
        CASE "switch"
            FOR EACH item IN nl[n].Split(",")
                FOR EACH d IN nl[Int(Val(item))].Split(",")
                    IF d <> "" THEN JsHoist(Int(Val(d)), scope)
                NEXT
            NEXT
    END SELECT
END SUB

' A function value: the code (node) and the scope it was made in. That scope
' may now outlive the call that made it, so it is marked kept (joB = 1).
FUNCTION JsMakeFunction (n AS Integer, scope AS Integer) AS String
    VAR id AS Integer
    VAR s AS Integer
    id = JsNewObject("Function", jsFunctionProto)
    joA[id] = n
    joB[id] = scope
    s = scope
    WHILE s <> 0 AND s <> jsGlobal
        joB[s] = 1
        s = joA[s]
    END WHILE
    RETURN JsO(id)
END FUNCTION

' A finished call's scope, if nothing kept it: its properties go, so the
' property table does not grow with every call.
SUB JsFreeScope (scope AS Integer)
    VAR name AS String
    VAR k AS Integer
    IF joB[scope] = 1 THEN RETURN
    FOR EACH name IN joIdx[scope].Split(Chr(1))
        IF name = "" THEN CONTINUE
        k = Int(Val(name.Substring(name.IndexOf(Chr(2)) + 1, 9).Trim()))
        jpVal[k] = "u"
        jpFree.Add(k)
    NEXT
    joIdx[scope] = ""
    joKeys[scope] = "|"
END SUB

' ---------------------------------------------------------------- running statements

SUB JsTick ()
    jsSteps = jsSteps + 1
    IF jsSteps MOD 2000 = 0 THEN HostYield()
    IF jsSteps > jsLimit THEN
        IF HostSlow() THEN THROW Str(jsLine) + "|@aborted"
        jsLimit = jsLimit * 2
    END IF
END SUB

SUB JsExec (n AS Integer, scope AS Integer)
    VAR bs AS Integer
    VAR item AS String
    VAR d AS Integer
    VAR v AS String
    VAR keys AS Array OF String
    VAR key AS String
    VAR depth AS Integer
    VAR caught AS String
    VAR pending AS String
    VAR sig AS String
    VAR ret AS String
    VAR cases AS Array OF String
    VAR i AS Integer
    VAR start AS Integer
    VAR c AS Integer
    IF n = 0 THEN RETURN
    jsLine = nline[n]
    jsNodeAt = n
    JsTick()
    SELECT CASE nk[n]
        CASE "block"
            IF nd[n] = 1 THEN
                bs = JsBlockScope(n, scope)
                FOR EACH item IN nl[n].Split(",")
                    IF item = "" THEN CONTINUE
                    JsExec(Int(Val(item)), bs)
                    IF jsSig <> "" THEN BREAK
                NEXT
                JsFreeScope(bs)
                RETURN
            END IF
            FOR EACH item IN nl[n].Split(",")
                IF item = "" THEN CONTINUE
                JsExec(Int(Val(item)), scope)
                IF jsSig <> "" THEN RETURN
            NEXT
        CASE "var", "let"
            FOR EACH item IN nl[n].Split(",")
                d = Int(Val(item))
                IF nb[d] <> 0 THEN
                    v = "u"
                    IF na[d] <> 0 THEN v = JsEval(na[d], scope)
                    JsBind(nb[d], v, scope)
                ELSEIF na[d] <> 0 THEN
                    JsSetVar(ns[d], JsEval(na[d], scope), scope)
                ELSEIF nk[n] = "let" THEN
                    JsSetVar(ns[d], "u", scope)
                END IF
            NEXT
        CASE "classdecl"
            JsSetVar(ns[n], JsMakeClass(n, scope), scope)
        CASE "exprst"
            jsRet = JsEval(na[n], scope)
        CASE "if"
            IF JsBool(JsEval(na[n], scope)) THEN
                JsExec(nb[n], scope)
            ELSE
                JsExec(nc[n], scope)
            END IF
        CASE "while"
            WHILE JsBool(JsEval(na[n], scope))
                JsExec(nb[n], scope)
                IF jsSig = "b" THEN
                    jsSig = ""
                    BREAK
                END IF
                IF jsSig = "c" THEN jsSig = ""
                IF jsSig = "r" THEN RETURN
                JsTick()
            END WHILE
        CASE "do"
            WHILE TRUE
                JsExec(nb[n], scope)
                IF jsSig = "b" THEN
                    jsSig = ""
                    BREAK
                END IF
                IF jsSig = "c" THEN jsSig = ""
                IF jsSig = "r" THEN RETURN
                IF NOT JsBool(JsEval(na[n], scope)) THEN BREAK
                JsTick()
            END WHILE
        CASE "for"
            ' for (let i...): each time round has an i of its own, for closures
            bs = scope
            IF na[n] <> 0 THEN
                IF nk[na[n]] = "let" THEN bs = JsBlockScope(n, scope)
            END IF
            JsExec(na[n], bs)
            WHILE TRUE
                IF nb[n] <> 0 THEN
                    IF NOT JsBool(JsEval(nb[n], bs)) THEN BREAK
                END IF
                JsExec(nd[n], bs)
                IF jsSig = "b" THEN
                    jsSig = ""
                    BREAK
                END IF
                IF jsSig = "c" THEN jsSig = ""
                IF jsSig = "r" THEN RETURN
                IF bs <> scope THEN bs = JsCopyScope(bs)
                IF nc[n] <> 0 THEN v = JsEval(nc[n], bs)
                JsTick()
            END WHILE
        CASE "forin", "forof"
            v = JsEval(na[n], scope)
            keys.Clear()
            IF nk[n] = "forin" THEN
                IF v.StartsWith("o") THEN
                    FOR EACH key IN joKeys[JsId(v)].Split("|")
                        IF key = "" OR (joClass[JsId(v)] = "Array" AND key = "length") THEN CONTINUE
                        keys.Add(JsS(key))
                    NEXT
                END IF
            ELSE
                keys = JsIterate(v)
            END IF
            FOR EACH key IN keys
                bs = scope
                IF nc[n] = 1 THEN bs = JsBlockScope(n, scope)
                IF nb[n] <> 0 THEN
                    JsBind(nb[n], key, bs)
                ELSE
                    JsSetVar(ns[n], key, bs)
                END IF
                JsExec(nd[n], bs)
                IF bs <> scope THEN JsFreeScope(bs)
                IF jsSig = "b" THEN
                    jsSig = ""
                    BREAK
                END IF
                IF jsSig = "c" THEN jsSig = ""
                IF jsSig = "r" THEN RETURN
            NEXT
        CASE "return"
            IF na[n] = 0 THEN
                jsRet = "u"
            ELSE
                jsRet = JsEval(na[n], scope)
            END IF
            jsSig = "r"
        CASE "break"
            jsSig = "b"
        CASE "continue"
            jsSig = "c"
        CASE "throw"
            jsThrown = JsEval(na[n], scope)
            THROW Str(nline[n]) + "|@thrown"
        CASE "try"
            depth = jsDepth
            pending = ""
            TRY
                JsExec(na[n], scope)
            CATCH err
                jsDepth = depth
                IF err.Contains("@aborted") THEN THROW err
                IF nb[n] = 0 THEN
                    pending = err
                ELSE
                    IF jsThrown <> "" THEN
                        caught = jsThrown
                    ELSE
                        caught = JsMakeError(err)
                    END IF
                    jsThrown = ""
                    JsSetVar(ns[n], caught, scope)
                    TRY
                        JsExec(nb[n], scope)
                    CATCH again
                        jsDepth = depth
                        IF again.Contains("@aborted") THEN THROW again
                        pending = again
                    END TRY
                END IF
            END TRY
            IF nc[n] <> 0 THEN
                ' finally runs whatever happened, and keeps the return or
                ' error that was on its way out unless it makes its own
                sig = jsSig
                ret = jsRet
                caught = jsThrown
                jsSig = ""
                JsExec(nc[n], scope)
                IF jsSig = "" THEN
                    jsSig = sig
                    jsRet = ret
                    jsThrown = caught
                ELSE
                    pending = ""
                END IF
            END IF
            IF pending <> "" THEN THROW pending
        CASE "switch"
            v = JsEval(na[n], scope)
            cases = nl[n].Split(",")
            start = -1
            FOR i = 0 TO cases.Count - 1
                c = Int(Val(cases[i]))
                IF na[c] <> 0 THEN
                    IF JsStrictEq(v, JsEval(na[c], scope)) THEN
                        start = i
                        BREAK
                    END IF
                END IF
            NEXT
            IF start < 0 THEN
                FOR i = 0 TO cases.Count - 1
                    IF na[Int(Val(cases[i]))] = 0 THEN start = i
                NEXT
            END IF
            IF start < 0 THEN RETURN
            FOR i = start TO cases.Count - 1
                FOR EACH item IN nl[Int(Val(cases[i]))].Split(",")
                    IF item = "" THEN CONTINUE
                    JsExec(Int(Val(item)), scope)
                    IF jsSig = "b" THEN
                        jsSig = ""
                        RETURN
                    END IF
                    IF jsSig <> "" THEN RETURN
                NEXT
            NEXT
    END SELECT
END SUB

' An Error object for an error the interpreter raised ("line|message").
FUNCTION JsMakeError (err AS String) AS String
    VAR id AS Integer
    VAR message AS String
    message = err
    IF message.Contains("|") THEN message = message.Substring(message.IndexOf("|") + 1, message.Length - message.IndexOf("|") - 1)
    id = JsNewObject("Error", jsErrorProto)
    IF jsErrorProto = 0 THEN joProto[id] = jsObjectProto
    JsPutOwn(id, "message", JsS(message))
    JsPutOwn(id, "description", JsS(message))
    IF HostWhere() = "" THEN
        JsPutOwn(id, "stack", JsS("Error: " + message))
    ELSE
        JsPutOwn(id, "stack", JsS("Error: " + message + Chr(10) + "    at " + HostWhere()))
    END IF
    RETURN JsO(id)
END FUNCTION

' ---------------------------------------------------------------- evaluating expressions

FUNCTION JsEval (n AS Integer, scope AS Integer) AS String
    VAR k AS Integer
    VAR item AS String
    VAR items AS Array OF String
    VAR id AS Integer
    VAR a AS String
    VAR v AS String
    VAR op AS String
    SELECT CASE nk[n]
        CASE "num"
            RETURN "n" + ns[n]
        CASE "str"
            RETURN "s" + ns[n]
        CASE "true"
            RETURN "t"
        CASE "false"
            RETURN "f"
        CASE "null"
            RETURN "l"
        CASE "this"
            RETURN JsThisOf(scope)
        CASE "id"
            RETURN JsLookup(ns[n], scope)
        CASE "array"
            items = JsArgList(n, scope)
            RETURN JsO(JsNewArray(items))
        CASE "object"
            id = JsNewObject("Object", jsObjectProto)
            FOR EACH item IN nl[n].Split(",")
                IF item = "" THEN CONTINUE
                k = Int(Val(item))
                IF nb[k] = 2 THEN
                    ' ...other: its own properties
                    v = JsEval(na[k], scope)
                    IF v.StartsWith("o") THEN
                        FOR EACH a IN JsOwnKeys(JsId(v))
                            JsPutOwn(id, a, JsGet(v, a))
                        NEXT
                    END IF
                ELSEIF nb[k] <> 0 THEN
                    a = JsKey(JsEval(nb[k], scope))
                    JsPut(JsO(id), a, JsEval(na[k], scope))
                ELSE
                    JsPut(JsO(id), ns[k], JsEval(na[k], scope))
                END IF
            NEXT
            RETURN JsO(id)
        CASE "classexpr"
            RETURN JsMakeClass(n, scope)
        CASE "supercall"
            RETURN JsSuperCall(n, scope)
        CASE "supermember"
            RETURN JsGet(JsLookup("@superproto", scope), ns[n])
        CASE "funcexpr"
            RETURN JsMakeFunction(n, scope)
        CASE "member"
            jsLine = nline[n]
            a = JsEval(na[n], scope)
            IF nd[n] = 1 AND (a = "u" OR a = "l") THEN RETURN "u"
            RETURN JsGet(JsNeed(a, na[n]), ns[n])
        CASE "index"
            a = JsEval(na[n], scope)
            IF nd[n] = 1 AND (a = "u" OR a = "l") THEN RETURN "u"
            a = JsNeed(a, na[n])
            jsLine = nline[n]
            RETURN JsGet(a, JsKey(JsEval(nb[n], scope)))
        CASE "assign"
            RETURN JsAssignment(n, scope)
        CASE "incdec"
            RETURN JsIncDec(n, scope)
        CASE "cond"
            IF JsBool(JsEval(na[n], scope)) THEN RETURN JsEval(nb[n], scope)
            RETURN JsEval(nc[n], scope)
        CASE "bin"
            op = ns[n]
            IF op = "&&" THEN
                a = JsEval(na[n], scope)
                IF NOT JsBool(a) THEN RETURN a
                RETURN JsEval(nb[n], scope)
            END IF
            IF op = "||" THEN
                a = JsEval(na[n], scope)
                IF JsBool(a) THEN RETURN a
                RETURN JsEval(nb[n], scope)
            END IF
            IF op = "??" THEN
                a = JsEval(na[n], scope)
                IF a <> "u" AND a <> "l" THEN RETURN a
                RETURN JsEval(nb[n], scope)
            END IF
            a = JsEval(na[n], scope)
            v = JsEval(nb[n], scope)
            jsLine = nline[n]
            RETURN JsBinOp(op, a, v)
        CASE "unary"
            RETURN JsUnaryOp(n, scope)
        CASE "call"
            RETURN JsCallNode(n, scope)
        CASE "new"
            RETURN JsNewNode(n, scope)
        CASE "seq"
            FOR EACH item IN nl[n].Split(",")
                v = JsEval(Int(Val(item)), scope)
            NEXT
            RETURN v
    END SELECT
    THROW Str(nline[n]) + "|Syntax error"
END FUNCTION

FUNCTION JsUnaryOp (n AS Integer, scope AS Integer) AS String
    VAR v AS String
    VAR t AS Integer
    VAR obj AS String
    t = na[n]
    SELECT CASE ns[n]
        CASE "typeof"
            IF nk[t] = "id" THEN
                IF ns[t] <> "undefined" AND ns[t] <> "status" AND ns[t] <> "location" AND JsFindScope(ns[t], scope) = 0 THEN RETURN "sundefined"
            END IF
            RETURN JsS(JsTypeOf(JsEval(t, scope)))
        CASE "void"
            v = JsEval(t, scope)
            RETURN "u"
        CASE "delete"
            IF nk[t] = "member" OR nk[t] = "index" THEN
                obj = JsNeed(JsEval(na[t], scope), na[t])
                IF nk[t] = "member" THEN
                    JsDeleteProp(JsId(obj), ns[t])
                ELSE
                    JsDeleteProp(JsId(obj), JsKey(JsEval(nb[t], scope)))
                END IF
            END IF
            RETURN "t"
    END SELECT
    v = JsEval(t, scope)
    SELECT CASE ns[n]
        CASE "!"
            RETURN JsB(NOT JsBool(v))
        CASE "-"
            IF JsNum(v) = "0" THEN RETURN "n0"
            RETURN "n" + JsArith("-", "0", JsNum(v))
    END SELECT
    RETURN "n" + JsNum(v)
END FUNCTION

SUB JsDeleteProp (id AS Integer, name AS String)
    VAR k AS Integer
    IF id = 0 THEN RETURN
    IF JsOwn(id, name) < 0 THEN RETURN
    JsDropOwn(id, name)
    joKeys[id] = joKeys[id].Replace("|" + name + "|", "|")
END SUB

' x = v, x += v, a.b = v, a[k] = v
FUNCTION JsAssignment (n AS Integer, scope AS Integer) AS String
    VAR t AS Integer
    VAR op AS String
    VAR obj AS String
    VAR key AS String
    VAR v AS String
    t = na[n]
    op = ns[n]
    IF nk[t] = "id" THEN
        IF op = "=" THEN
            v = JsEval(nb[n], scope)
        ELSE
            v = JsBinOp(op.Substring(0, 1), JsLookup(ns[t], scope), JsEval(nb[n], scope))
        END IF
        JsSetVar(ns[t], v, scope)
        RETURN v
    END IF
    obj = JsNeed(JsEval(na[t], scope), na[t])
    IF nk[t] = "member" THEN
        key = ns[t]
    ELSE
        key = JsKey(JsEval(nb[t], scope))
    END IF
    jsLine = nline[n]
    IF op = "=" THEN
        v = JsEval(nb[n], scope)
    ELSE
        v = JsBinOp(op.Substring(0, 1), JsGet(obj, key), JsEval(nb[n], scope))
    END IF
    JsPut(obj, key, v)
    RETURN v
END FUNCTION

' ++x, x++, --x, x--
FUNCTION JsIncDec (n AS Integer, scope AS Integer) AS String
    VAR t AS Integer
    VAR obj AS String
    VAR key AS String
    VAR old AS String
    VAR fresh AS String
    t = na[n]
    IF nk[t] = "id" THEN
        old = JsNum(JsLookup(ns[t], scope))
    ELSE
        obj = JsNeed(JsEval(na[t], scope), na[t])
        IF nk[t] = "member" THEN
            key = ns[t]
        ELSE
            key = JsKey(JsEval(nb[t], scope))
        END IF
        old = JsNum(JsGet(obj, key))
    END IF
    fresh = JsArith(ns[n].Substring(0, 1), old, "1")
    IF nk[t] = "id" THEN
        JsSetVar(ns[t], "n" + fresh, scope)
    ELSE
        JsPut(obj, key, "n" + fresh)
    END IF
    IF nl[n] = "pre" THEN RETURN "n" + fresh
    RETURN "n" + old
END FUNCTION

FUNCTION JsArgList (n AS Integer, scope AS Integer) AS Array OF String
    VAR out AS Array OF String
    VAR item AS String
    VAR v AS String
    VAR k AS Integer
    FOR EACH item IN nl[n].Split(",")
        IF item = "" THEN CONTINUE
        k = Int(Val(item))
        IF nk[k] = "spread" THEN
            FOR EACH v IN JsIterate(JsEval(na[k], scope))
                out.Add(v)
            NEXT
        ELSE
            out.Add(JsEval(k, scope))
        END IF
    NEXT
    RETURN out
END FUNCTION

FUNCTION JsCallNode (n AS Integer, scope AS Integer) AS String
    VAR c AS Integer
    VAR thisVal AS String
    VAR fn AS String
    VAR args AS Array OF String
    VAR prog AS Integer
    VAR name AS String
    c = na[n]
    IF nk[c] = "supermember" THEN
        thisVal = JsThisOf(scope)
        fn = JsGet(JsLookup("@superproto", scope), ns[c])
        name = "super." + ns[c]
    ELSEIF nk[c] = "member" THEN
        thisVal = JsEval(na[c], scope)
        IF nd[c] = 1 AND (thisVal = "u" OR thisVal = "l") THEN RETURN "u"
        thisVal = JsNeed(thisVal, na[c])
        jsLine = nline[n]
        fn = JsGet(thisVal, ns[c])
        name = ns[c]
    ELSEIF nk[c] = "index" THEN
        thisVal = JsNeed(JsEval(na[c], scope), na[c])
        name = JsKey(JsEval(nb[c], scope))
        jsLine = nline[n]
        fn = JsGet(thisVal, name)
    ELSE
        IF nk[c] = "id" AND ns[c] = "eval" THEN RETURN JsEvalCode(JsArgList(n, scope), scope)
        fn = JsEval(c, scope)
        thisVal = JsO(jsGlobal)
        name = JsDescribe(c)
    END IF
    args = JsArgList(n, scope)
    jsLine = nline[n]
    IF nd[n] = 1 AND (fn = "u" OR fn = "l") THEN RETURN "u"
    IF NOT JsCallable(fn) THEN
        IF nk[c] = "member" OR nk[c] = "index" OR nk[c] = "supermember" THEN THROW Str(jsLine) + "|Object doesn't support this property or method"
        THROW Str(jsLine) + "|Function expected"
    END IF
    RETURN JsCall(fn, thisVal, args)
END FUNCTION

' eval("code"): runs in the scope that called it; its value is the last expression's.
FUNCTION JsEvalCode (args AS Array OF String, scope AS Integer) AS String
    VAR prog AS Integer
    VAR line AS Integer
    IF args.Count = 0 THEN RETURN "u"
    IF NOT args[0].StartsWith("s") THEN RETURN args[0]
    line = jsLine
    prog = JsParse(args[0].Substring(1, args[0].Length - 1))
    jsLine = line
    JsHoist(prog, scope)
    jsRet = "u"
    JsExec(prog, scope)
    IF jsSig = "r" THEN jsSig = ""
    RETURN jsRet
END FUNCTION

FUNCTION JsCall (fn AS String, thisVal AS String, args AS Array OF String) AS String
    VAR id AS Integer
    VAR node AS Integer
    VAR scope AS Integer
    VAR params AS Array OF String
    VAR i AS Integer
    VAR result AS String
    VAR line AS Integer
    id = JsId(fn)
    IF joClass[id] = "Native" THEN RETURN JsCallNative(joS[id], thisVal, args)
    node = joA[id]
    jsDepth = jsDepth + 1
    IF jsDepth > JSMAXDEPTH THEN THROW Str(jsLine) + "|Out of stack space"
    line = jsLine
    scope = JsNewScope(joB[id], thisVal)
    ' an arrow function's this is the one where it was made
    IF nd[node] = 1 THEN JsDeleteProp(scope, "@this")
    JsPutOwn(scope, "arguments", JsO(JsNewArray(args)))
    IF nb[node] <> 0 THEN
        JsBindParams(nb[node], args, scope)
    ELSE
        IF nl[node] <> "" THEN params = nl[node].Split(",")
        FOR i = 0 TO params.Count - 1
            IF i < args.Count THEN
                JsPutOwn(scope, params[i], args[i])
            ELSE
                JsPutOwn(scope, params[i], "u")
            END IF
        NEXT
    END IF
    IF nk[node] = "funcexpr" AND ns[node] <> "" AND JsOwn(scope, ns[node]) < 0 THEN JsPutOwn(scope, ns[node], fn)
    JsHoist(na[node], scope)
    JsExec(na[node], scope)
    result = "u"
    IF jsSig = "r" THEN result = jsRet
    jsSig = ""
    jsDepth = jsDepth - 1
    jsLine = line
    JsFreeScope(scope)
    RETURN result
END FUNCTION

' new F(args): a fresh object whose prototype is F.prototype, with F run on it.
FUNCTION JsNewNode (n AS Integer, scope AS Integer) AS String
    VAR fn AS String
    VAR args AS Array OF String
    VAR id AS Integer
    VAR result AS String
    fn = JsEval(na[n], scope)
    args = JsArgList(n, scope)
    jsLine = nline[n]
    IF NOT JsCallable(fn) THEN THROW Str(jsLine) + "|Object doesn't support this action"
    IF joClass[JsId(fn)] = "Native" THEN RETURN JsConstruct(joS[JsId(fn)], args)
    id = JsNewObject("Object", JsId(JsGet(fn, "prototype")))
    ' a class with nothing to extend sets its fields before its constructor runs
    IF JsOwn(JsId(fn), "@cscope") >= 0 THEN
        IF JsGetProp(JsInt(JsGetProp(JsId(fn), "@cscope")), "@super") = "u" THEN JsInitFields(fn, JsO(id))
    END IF
    result = JsCall(fn, JsO(id), args)
    IF result.StartsWith("o") THEN RETURN result
    RETURN JsO(id)
END FUNCTION

' ---------------------------------------------------------------- dates

' Seconds to add to UTC for local time, worked out from the machine's clock.
FUNCTION JsZone () AS Integer
    VAR z AS Integer
    z = Int(TIME.Ticks / 1000) - (TIME.Now MOD 86400)
    IF z > 43200 THEN z = z - 86400
    IF z < -43200 THEN z = z + 86400
    RETURN Int(MATH.Round(z / 900)) * 900
END FUNCTION

' Days since 1970-01-01 for a date, and back (Howard Hinnant's algorithms).
FUNCTION JsDaysFrom (y AS Integer, m AS Integer, d AS Integer) AS Integer
    VAR era AS Integer
    VAR yoe AS Integer
    VAR doy AS Integer
    VAR doe AS Integer
    IF m <= 2 THEN y = y - 1
    era = MATH.Floor(y / 400)
    yoe = y - era * 400
    IF m > 2 THEN
        doy = Int((153 * (m - 3) + 2) / 5) + d - 1
    ELSE
        doy = Int((153 * (m + 9) + 2) / 5) + d - 1
    END IF
    doe = yoe * 365 + Int(yoe / 4) - Int(yoe / 100) + doy
    RETURN era * 146097 + doe - 719468
END FUNCTION

' y|m|d for a day number
FUNCTION JsCivil (days AS Integer) AS String
    VAR z AS Integer
    VAR era AS Integer
    VAR doe AS Integer
    VAR yoe AS Integer
    VAR y AS Integer
    VAR doy AS Integer
    VAR mp AS Integer
    VAR d AS Integer
    VAR m AS Integer
    z = days + 719468
    era = MATH.Floor(z / 146097)
    doe = z - era * 146097
    yoe = Int((doe - Int(doe / 1460) + Int(doe / 36524) - Int(doe / 146096)) / 365)
    y = yoe + era * 400
    doy = doe - (365 * yoe + Int(yoe / 4) - Int(yoe / 100))
    mp = Int((5 * doy + 2) / 153)
    d = doy - Int((153 * mp + 2) / 5) + 1
    IF mp < 10 THEN
        m = mp + 3
    ELSE
        m = mp - 9
    END IF
    IF m <= 2 THEN y = y + 1
    RETURN Str(y) + "|" + Str(m) + "|" + Str(d)
END FUNCTION

' One part of a time (milliseconds since 1970), in local time.
FUNCTION JsDatePart (ms AS Real, part AS String) AS Integer
    VAR local AS Real
    VAR days AS Integer
    VAR secs AS Integer
    VAR ymd AS Array OF String
    local = MATH.Floor(ms / 1000) + JsZone()
    days = MATH.Floor(local / 86400)
    secs = Int(local - days * 86400)
    SELECT CASE part
        CASE "hours"
            RETURN Int(secs / 3600)
        CASE "minutes"
            RETURN Int((secs MOD 3600) / 60)
        CASE "seconds"
            RETURN secs MOD 60
        CASE "ms"
            RETURN Int(ms - MATH.Floor(ms / 1000) * 1000)
        CASE "day"
            RETURN ((days MOD 7) + 11) MOD 7
    END SELECT
    ymd = JsCivil(days).Split("|")
    SELECT CASE part
        CASE "year"
            RETURN Int(Val(ymd[0]))
        CASE "month"
            RETURN Int(Val(ymd[1])) - 1
    END SELECT
    RETURN Int(Val(ymd[2]))
END FUNCTION

FUNCTION Pad2 (n AS Integer) AS String
    IF n < 10 THEN RETURN "0" + Str(n)
    RETURN Str(n)
END FUNCTION

' "Thu Jul 4 12:00:00 1996", the way 1996 browsers wrote dates
FUNCTION JsDateText (ms AS Real) AS String
    IF ms <> ms THEN RETURN "NaN"
    RETURN "Sun,Mon,Tue,Wed,Thu,Fri,Sat".Split(",")[JsDatePart(ms, "day")] + " " + "Jan,Feb,Mar,Apr,May,Jun,Jul,Aug,Sep,Oct,Nov,Dec".Split(",")[JsDatePart(ms, "month")] + " " + Str(JsDatePart(ms, "date")) + " " _
        + Pad2(JsDatePart(ms, "hours")) + ":" + Pad2(JsDatePart(ms, "minutes")) + ":" + Pad2(JsDatePart(ms, "seconds")) + " " + Str(JsDatePart(ms, "year"))
END FUNCTION

FUNCTION JsNow () AS Real
    RETURN TIME.Now * 1000.0 + (TIME.Ticks MOD 1000)
END FUNCTION

' A moment from local date parts; months and days may run over, as in JS.
FUNCTION JsLocalMs (y AS Real, mon AS Real, d AS Real, h AS Real, mi AS Real, sec AS Real, ms AS Real) AS Real
    VAR years AS Integer
    years = MATH.Floor(mon / 12)
    mon = mon - years * 12
    RETURN ((JsDaysFrom(Int(y) + years, Int(mon) + 1, 1) + d - 1) * 86400.0 + h * 3600 + mi * 60 + sec - JsZone()) * 1000 + ms
END FUNCTION

FUNCTION JsNewDate (ms AS Real) AS String
    VAR id AS Integer
    id = JsNewObject("Date", jsDateProto)
    joS[id] = JsFmt(ms)
    RETURN JsO(id)
END FUNCTION

' ---------------------------------------------------------------- built-in functions

FUNCTION JsArg (args AS Array OF String, i AS Integer) AS String
    IF i < args.Count THEN RETURN args[i]
    RETURN "u"
END FUNCTION

' new Array(...), new Date(...), new Object(), new String(...)...
FUNCTION JsConstruct (name AS String, args AS Array OF String) AS String
    VAR none AS Array OF String
    VAR id AS Integer
    VAR ms AS Real
    SELECT CASE name
        CASE "Array"
            IF args.Count = 1 AND args[0].StartsWith("n") THEN
                id = JsNewArray(none)
                JsPutOwn(id, "length", args[0])
                RETURN JsO(id)
            END IF
            RETURN JsO(JsNewArray(args))
        CASE "Object"
            RETURN JsO(JsNewObject("Object", jsObjectProto))
        CASE "Date"
            IF args.Count = 0 THEN RETURN JsNewDate(JsNow())
            IF args.Count = 1 THEN
                IF args[0].StartsWith("n") THEN RETURN JsNewDate(JsReal(args[0]))
                id = JsNewObject("Date", jsDateProto)
                joS[id] = "NaN"
                RETURN JsO(id)
            END IF
            id = JsInt(args[0])
            IF id >= 0 AND id < 100 THEN id = id + 1900
            ms = 1
            IF args.Count >= 3 THEN ms = JsReal(args[2])
            RETURN JsNewDate(JsLocalMs(id, JsReal(args[1]), ms, JsReal(JsArg(args, 3)), JsReal(JsArg(args, 4)), JsReal(JsArg(args, 5)), JsReal(JsArg(args, 6))))
        CASE "Error", "TypeError", "RangeError", "SyntaxError", "ReferenceError"
            IF JsArg(args, 0) = "u" THEN RETURN JsMakeTypedError(name, "")
            RETURN JsMakeTypedError(name, JsStr(JsArg(args, 0)))
        CASE "Promise"
            RETURN JsNewPromiseFrom(JsArg(args, 0))
        CASE "XMLHttpRequest"
            RETURN JsO(JsNewXhr())
        CASE "ActiveXObject"
            ' IE's way: only the XMLHTTP objects are here
            IF JsStr(JsArg(args, 0)).Lower() = "microsoft.xmlhttp" OR JsStr(JsArg(args, 0)).Lower().StartsWith("msxml2.xmlhttp") THEN RETURN JsO(JsNewXhr())
            THROW Str(jsLine) + "|Automation server can't create object"
    END SELECT
    RETURN JsCallNative(name, JsO(jsGlobal), args)
END FUNCTION

FUNCTION JsCallNative (name AS String, thisVal AS String, args AS Array OF String) AS String
    VAR a AS String
    VAR text AS String
    VAR i AS Integer
    VAR n AS Integer
    VAR r AS Real
    VAR out AS String
    VAR list AS Array OF String
    VAR id AS Integer
    a = JsArg(args, 0)
    IF name.StartsWith("String.") AND name <> "String.fromCharCode" THEN RETURN JsStringMethod(name.Substring(7, name.Length - 7), JsStr(thisVal), args)
    IF name.StartsWith("Array.") THEN RETURN JsArrayMethod(name.Substring(6, name.Length - 6), JsId(thisVal), args)
    IF name.StartsWith("Math.") THEN RETURN JsMath(name.Substring(5, name.Length - 5), args)
    IF name.StartsWith("Date.") THEN RETURN JsDateMethod(name.Substring(5, name.Length - 5), thisVal, args)
    IF name.StartsWith("XHR.") THEN RETURN JsXhrMethod(name.Substring(4, name.Length - 4), thisVal, args)
    IF name.StartsWith("Promise.part:") OR name.StartsWith("Bound:") OR name.StartsWith("ObjectS.") OR name.StartsWith("ArrayS.") OR name.StartsWith("NumberS.") OR name = "DateS.now" OR name.StartsWith("JSON.") OR name.StartsWith("PromiseS.") OR name = "Function.bind" THEN RETURN JsLib(name, thisVal, args)
    IF name.StartsWith("Promise.") OR name.StartsWith("Response.") THEN RETURN JsPromiseMethod(name, thisVal, args)
    SELECT CASE name
        CASE "alert"
            HostAlert(JsStr(a))
            RETURN "u"
        CASE "confirm"
            RETURN JsB(HostConfirm(JsStr(a)))
        CASE "prompt"
            text = JsArg(args, 1)
            IF text = "u" THEN text = "s"
            text = HostPrompt(JsStr(a), JsStr(text))
            IF text = Chr(0) THEN RETURN "l"
            RETURN JsS(text)
        CASE "parseInt"
            RETURN "n" + JsParseInt(JsStr(a), JsInt(JsArg(args, 1)))
        CASE "parseFloat"
            RETURN "n" + JsParseFloat(JsStr(a))
        CASE "isNaN"
            RETURN JsB(JsNum(a) = "NaN")
        CASE "isFinite"
            RETURN JsB(JsFinite(JsNum(a)))
        CASE "escape"
            RETURN JsS(JsEscape(JsStr(a)))
        CASE "unescape"
            RETURN JsS(JsUnescape(JsStr(a)))
        CASE "encodeURIComponent"
            RETURN JsS(JsEncodeUri(JsStr(a), "-_.!~*'()"))
        CASE "encodeURI"
            RETURN JsS(JsEncodeUri(JsStr(a), "-_.!~*'();/?:@&=+$,#"))
        CASE "decodeURIComponent", "decodeURI"
            text = JsDecodeUri(JsStr(a), name = "decodeURI")
            IF text = Chr(0) THEN THROW Str(jsLine) + "|URIError: URI malformed"
            RETURN JsS(text)
        CASE "String"
            IF args.Count = 0 THEN RETURN "s"
            RETURN JsS(JsStr(a))
        CASE "Number"
            IF args.Count = 0 THEN RETURN "n0"
            RETURN "n" + JsNum(a)
        CASE "Boolean"
            RETURN JsB(JsBool(a))
        CASE "Array", "Object", "Error", "XMLHttpRequest", "ActiveXObject", "TypeError", "RangeError", "SyntaxError", "ReferenceError"
            RETURN JsConstruct(name, args)
        CASE "Promise"
            jsThrown = JsMakeTypedError("TypeError", "Promise constructor cannot be invoked without 'new'")
            THROW Str(jsLine) + "|@thrown"
        CASE "fetch"
            RETURN JsFetch(args)
        CASE "All.item"
            IF HostHas(JsStr(a)) THEN RETURN JsElement(JsStr(a))
            RETURN "l"
        CASE "Date"
            RETURN JsS(JsDateText(JsNow()))
        CASE "String.fromCharCode"
            FOR i = 0 TO args.Count - 1
                out = out + Chr(JsInt(args[i]))
            NEXT
            RETURN JsS(out)
        CASE "setTimeout", "setInterval"
            IF JsCallable(a) THEN
                RETURN JsN(HostTimeout("", a, JsInt(JsArg(args, 1)), name = "setInterval"))
            END IF
            RETURN JsN(HostTimeout(JsStr(a), "", JsInt(JsArg(args, 1)), name = "setInterval"))
        CASE "clearTimeout", "clearInterval"
            HostClearTimeout(JsInt(a))
            RETURN "u"
        CASE "open"
            HostOpen(JsStr(a))
            RETURN "l"
        CASE "document.write", "document.writeln"
            FOR i = 0 TO args.Count - 1
                jsOut = jsOut + JsStr(args[i])
            NEXT
            IF name = "document.writeln" THEN jsOut = jsOut + Chr(10)
            RETURN "u"
        CASE "document.getElementById"
            IF HostHas(JsStr(a)) THEN RETURN JsElement(JsStr(a))
            RETURN "l"
        CASE "history.back"
            HostHistory(-1)
            RETURN "u"
        CASE "history.forward"
            HostHistory(1)
            RETURN "u"
        CASE "history.go"
            HostHistory(JsInt(a))
            RETURN "u"
        CASE "location.reload"
            HostNavigate(HostInfo("location"))
            RETURN "u"
        CASE "location.replace", "location.assign"
            HostNavigate(JsStr(a))
            RETURN "u"
        CASE "location.toString"
            RETURN JsS(HostInfo("location"))
        CASE "Form.submit"
            HostSubmit(joA[JsId(thisVal)])
            RETURN "u"
        CASE "navigator.javaEnabled", "Element.focus", "Element.blur", "Element.select", "Element.click", "noop"
            RETURN "f"
        CASE "Object.toString"
            IF thisVal.StartsWith("o") THEN RETURN JsS(JsStr(thisVal))
            RETURN JsS(JsStr(thisVal))
        CASE "Object.hasOwnProperty"
            RETURN JsB(JsOwn(JsId(thisVal), JsStr(a)) >= 0)
        CASE "Number.toString"
            n = JsInt(a)
            IF n < 2 OR n > 36 OR n = 10 THEN RETURN JsS(JsStr(thisVal))
            RETURN JsS(JsRadix(JsReal(thisVal), n))
        CASE "Number.toFixed"
            RETURN JsS(JsFixed(JsReal(thisVal), JsInt(a)))
        CASE "Function.call"
            FOR i = 1 TO args.Count - 1
                list.Add(args[i])
            NEXT
            RETURN JsCall(thisVal, JsThisArg(a), list)
        CASE "Function.apply"
            IF JsArg(args, 1).StartsWith("o") THEN list = JsItems(JsId(args[1]))
            RETURN JsCall(thisVal, JsThisArg(a), list)
    END SELECT
    ' anything else is the host's own (Node's modules, say)
    RETURN HostNative(name, thisVal, args)
END FUNCTION

FUNCTION JsThisArg (v AS String) AS String
    IF v = "u" OR v = "l" THEN RETURN JsO(jsGlobal)
    RETURN v
END FUNCTION

FUNCTION JsRadix (r AS Real, radix AS Integer) AS String
    VAR n AS Real
    VAR out AS String
    VAR sign AS String
    n = Int(Abs(r))
    IF r < 0 THEN sign = "-"
    IF n = 0 THEN RETURN "0"
    WHILE n > 0
        out = "0123456789abcdefghijklmnopqrstuvwxyz".CharAt(Int(n - Int(n / radix) * radix)) + out
        n = Int(n / radix)
    END WHILE
    RETURN sign + out
END FUNCTION

FUNCTION JsFixed (r AS Real, digits AS Integer) AS String
    VAR scaled AS Real
    VAR s AS String
    VAR sign AS String
    IF digits < 0 THEN digits = 0
    IF digits > 20 THEN digits = 20
    IF r < 0 THEN
        sign = "-"
        r = -r
    END IF
    scaled = MATH.Round(r * 10 ^ digits)
    s = Str(Int(scaled))
    IF digits = 0 THEN RETURN sign + s
    WHILE s.Length <= digits
        s = "0" + s
    END WHILE
    RETURN sign + s.Substring(0, s.Length - digits) + "." + s.Substring(s.Length - digits, digits)
END FUNCTION

FUNCTION JsParseInt (text AS String, radix AS Integer) AS String
    VAR t AS String
    VAR sign AS Integer = 1
    VAR i AS Integer
    VAR d AS Integer
    VAR v AS Real
    VAR digits AS String
    VAR any AS Bool
    t = text.Trim().Lower()
    IF t.StartsWith("-") THEN
        sign = -1
        t = t.Substring(1, t.Length - 1)
    ELSEIF t.StartsWith("+") THEN
        t = t.Substring(1, t.Length - 1)
    END IF
    IF radix = 0 THEN
        radix = 10
        IF t.StartsWith("0x") THEN
            radix = 16
            t = t.Substring(2, t.Length - 2)
        END IF
    ELSEIF radix = 16 AND t.StartsWith("0x") THEN
        t = t.Substring(2, t.Length - 2)
    END IF
    IF radix < 2 OR radix > 36 THEN RETURN "NaN"
    digits = "0123456789abcdefghijklmnopqrstuvwxyz".Substring(0, radix)
    FOR i = 0 TO t.Length - 1
        d = digits.IndexOf(t.CharAt(i))
        IF d < 0 THEN BREAK
        v = v * radix + d
        any = TRUE
    NEXT
    IF NOT any THEN RETURN "NaN"
    RETURN JsFmt(sign * v)
END FUNCTION

FUNCTION JsParseFloat (text AS String) AS String
    VAR t AS String
    VAR i AS Integer
    VAR best AS String
    t = text.Trim()
    best = "NaN"
    FOR i = 1 TO MATH.Min(t.Length, 40)
        IF JsParseNumber(t.Substring(0, i)) <> "NaN" AND NOT t.Substring(0, i).Lower().EndsWith("e") AND NOT t.Substring(0, i).EndsWith("x") THEN best = JsParseNumber(t.Substring(0, i))
    NEXT
    IF t.StartsWith("Infinity") THEN RETURN "Infinity"
    RETURN best
END FUNCTION

FUNCTION JsEscape (s AS String) AS String
    VAR out AS String
    VAR i AS Integer
    VAR c AS String
    FOR i = 0 TO s.Length - 1
        c = s.CharAt(i)
        IF "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@*_+-./".Contains(c) THEN
            out = out + c
        ELSE
            out = out + "%" + Hex(Asc(c)).PadLeft(2).Replace(" ", "0")
        END IF
    NEXT
    RETURN out
END FUNCTION

'' encodeURIComponent and encodeURI: letters, digits and keep stay; the rest
' as %XX, in UTF-8
FUNCTION JsEncodeUri (s AS String, keep AS String) AS String
    VAR out AS String
    VAR i AS Integer
    VAR c AS String
    VAR n AS Integer
    FOR i = 0 TO s.Length - 1
        c = s.CharAt(i)
        n = Asc(c)
        IF "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789".Contains(c) OR keep.Contains(c) THEN
            out = out + c
        ELSEIF n < 128 THEN
            out = out + "%" + JsHex2(n)
        ELSEIF n < 2048 THEN
            out = out + "%" + JsHex2(192 + Int(n / 64)) + "%" + JsHex2(128 + n MOD 64)
        ELSE
            out = out + "%" + JsHex2(224 + Int(n / 4096)) + "%" + JsHex2(128 + Int(n / 64) MOD 64) + "%" + JsHex2(128 + n MOD 64)
        END IF
    NEXT
    RETURN out
END FUNCTION

FUNCTION JsHex2 (n AS Integer) AS String
    RETURN "0123456789ABCDEF".CharAt(Int(n / 16)) + "0123456789ABCDEF".CharAt(n MOD 16)
END FUNCTION

' decodeURIComponent (and decodeURI, which leaves the reserved characters
' encoded): %XX as UTF-8. Chr(0) when it is malformed.
FUNCTION JsDecodeUri (s AS String, reserved AS Bool) AS String
    VAR out AS String
    VAR i AS Integer
    VAR h AS String
    VAR b AS Integer
    VAR more AS Integer
    VAR code AS Integer
    VAR k AS Integer
    WHILE i < s.Length
        IF s.CharAt(i) <> "%" THEN
            out = out + s.CharAt(i)
            i = i + 1
            CONTINUE
        END IF
        h = JsPeek(s, i + 1, 2).Lower()
        IF h.Length < 2 OR NOT OnlyChars(h, "0123456789abcdef") THEN RETURN Chr(0)
        b = "0123456789abcdef".IndexOf(h.CharAt(0)) * 16 + "0123456789abcdef".IndexOf(h.CharAt(1))
        IF b < 128 THEN
            IF reserved AND ";/?:@&=+$,#".Contains(Chr(b)) THEN
                out = out + s.Substring(i, 3)
            ELSE
                out = out + Chr(b)
            END IF
            i = i + 3
            CONTINUE
        END IF
        IF b >= 224 THEN
            more = 2
            code = b - 224
        ELSEIF b >= 192 THEN
            more = 1
            code = b - 192
        ELSE
            RETURN Chr(0)
        END IF
        i = i + 3
        FOR k = 1 TO more
            h = JsPeek(s, i + 1, 2).Lower()
            IF s.CharAt(i) <> "%" OR h.Length < 2 OR NOT OnlyChars(h, "0123456789abcdef") THEN RETURN Chr(0)
            b = "0123456789abcdef".IndexOf(h.CharAt(0)) * 16 + "0123456789abcdef".IndexOf(h.CharAt(1))
            IF b < 128 OR b >= 192 THEN RETURN Chr(0)
            code = code * 64 + b - 128
            i = i + 3
        NEXT
        out = out + Chr(code)
    END WHILE
    RETURN out
END FUNCTION

FUNCTION JsUnescape (s AS String) AS String
    VAR out AS String
    VAR i AS Integer
    VAR h AS String
    WHILE i < s.Length
        IF s.CharAt(i) = "%" AND i + 2 < s.Length + 0 AND OnlyChars(JsPeek(s, i + 1, 2).Lower(), "0123456789abcdef") AND JsPeek(s, i + 1, 2).Length = 2 THEN
            h = JsPeek(s, i + 1, 2).Lower()
            out = out + Chr("0123456789abcdef".IndexOf(h.CharAt(0)) * 16 + "0123456789abcdef".IndexOf(h.CharAt(1)))
            i = i + 3
        ELSE
            out = out + s.CharAt(i)
            i = i + 1
        END IF
    END WHILE
    RETURN out
END FUNCTION

FUNCTION JsMath (name AS String, args AS Array OF String) AS String
    VAR x AS String
    VAR i AS Integer
    VAR best AS String
    x = JsNum(JsArg(args, 0))
    SELECT CASE name
        CASE "random"
            RETURN JsN(Rnd())
        CASE "max", "min"
            IF args.Count = 0 THEN
                IF name = "max" THEN RETURN "n-Infinity"
                RETURN "nInfinity"
            END IF
            best = "n" + JsNum(args[0])
            FOR i = 1 TO args.Count - 1
                IF JsNum(args[i]) = "NaN" THEN RETURN "nNaN"
                IF name = "max" AND JsCompare(">", "n" + JsNum(args[i]), best) = "t" THEN best = "n" + JsNum(args[i])
                IF name = "min" AND JsCompare("<", "n" + JsNum(args[i]), best) = "t" THEN best = "n" + JsNum(args[i])
            NEXT
            RETURN best
    END SELECT
    IF NOT JsFinite(x) THEN RETURN "nNaN"
    SELECT CASE name
        CASE "abs"
            RETURN JsN(Abs(Val(x)))
        CASE "floor"
            RETURN JsN(MATH.Floor(Val(x)))
        CASE "ceil"
            RETURN JsN(MATH.Ceil(Val(x)))
        CASE "round"
            RETURN JsN(MATH.Floor(Val(x) + 0.5))
        CASE "sqrt"
            IF Val(x) < 0 THEN RETURN "nNaN"
            RETURN JsN(MATH.Sqrt(Val(x)))
        CASE "pow"
            RETURN JsN(Val(x) ^ JsReal(JsArg(args, 1)))
        CASE "sin"
            RETURN JsN(MATH.Sin(Val(x)))
        CASE "cos"
            RETURN JsN(MATH.Cos(Val(x)))
        CASE "tan"
            RETURN JsN(MATH.Tan(Val(x)))
        CASE "atan"
            RETURN JsN(MATH.Atan(Val(x)))
        CASE "exp"
            RETURN JsN(MATH.Exp(Val(x)))
        CASE "log"
            IF Val(x) <= 0 THEN RETURN "nNaN"
            RETURN JsN(MATH.Log(Val(x)))
    END SELECT
    THROW Str(jsLine) + "|Object doesn't support this property or method"
END FUNCTION

FUNCTION JsStringMethod (name AS String, s AS String, args AS Array OF String) AS String
    VAR a AS String
    VAR i AS Integer
    VAR j AS Integer
    VAR n AS Integer
    VAR found AS Integer
    VAR parts AS Array OF String
    VAR out AS Array OF String
    VAR t AS String
    a = JsArg(args, 0)
    n = s.Length
    SELECT CASE name
        CASE "replace", "replaceAll"
            IF a.StartsWith("o") THEN
                jsThrown = JsMakeTypedError("TypeError", "Regular expressions are not supported yet: give replace a string")
                THROW Str(jsLine) + "|@thrown"
            END IF
            t = JsStr(a)
            out.Clear()
            i = 0
            WHILE TRUE
                found = -1
                IF i <= n THEN found = s.Substring(i, n - i).IndexOf(t)
                IF found < 0 THEN BREAK
                found = found + i
                out.Add(JsS(s.Substring(i, found - i)))
                IF JsCallable(JsArg(args, 1)) THEN
                    parts.Clear()
                    parts.Add(JsS(t))
                    parts.Add(JsN(found))
                    parts.Add(JsS(s))
                    out.Add(JsS(JsStr(JsCall(args[1], JsO(jsGlobal), parts))))
                ELSE
                    out.Add(JsS(JsStr(JsArg(args, 1)).Replace("$&", t).Replace("$$", "$")))
                END IF
                i = found + MATH.Max(1, t.Length)
                IF t = "" THEN
                    IF found < n THEN out.Add(JsS(s.CharAt(found)))
                END IF
                IF name = "replace" OR i > n THEN BREAK
            END WHILE
            IF i <= n THEN out.Add(JsS(s.Substring(i, n - i)))
            t = ""
            FOR EACH a IN out
                t = t + a.Substring(1, a.Length - 1)
            NEXT
            RETURN JsS(t)
        CASE "startsWith"
            i = MATH.Max(0, JsInt(JsArg(args, 1)))
            t = JsStr(a)
            IF i + t.Length > n THEN RETURN "f"
            RETURN JsB(s.Substring(i, t.Length) = t)
        CASE "endsWith"
            i = n
            IF args.Count > 1 AND args[1] <> "u" THEN i = MATH.Min(n, JsInt(args[1]))
            t = JsStr(a)
            IF t.Length > i THEN RETURN "f"
            RETURN JsB(s.Substring(i - t.Length, t.Length) = t)
        CASE "includes"
            i = MATH.Max(0, JsInt(JsArg(args, 1)))
            IF i > n THEN RETURN "f"
            RETURN JsB(s.Substring(i, n - i).Contains(JsStr(a)))
        CASE "repeat"
            j = JsInt(a)
            IF j < 0 THEN
                jsThrown = JsMakeTypedError("RangeError", "Invalid count value: " + Str(j))
                THROW Str(jsLine) + "|@thrown"
            END IF
            t = ""
            FOR i = 1 TO j
                t = t + s
            NEXT
            RETURN JsS(t)
        CASE "padStart", "padEnd"
            j = JsInt(a)
            t = " "
            IF args.Count > 1 AND args[1] <> "u" THEN t = JsStr(args[1])
            IF j <= n OR t = "" THEN RETURN JsS(s)
            a = ""
            WHILE a.Length < j - n
                a = a + t
            END WHILE
            a = a.Substring(0, j - n)
            IF name = "padStart" THEN RETURN JsS(a + s)
            RETURN JsS(s + a)
        CASE "trimStart", "trimLeft"
            i = 0
            WHILE i < n AND (" " + Chr(9) + Chr(10) + Chr(13)).Contains(s.CharAt(i))
                i = i + 1
            END WHILE
            RETURN JsS(s.Substring(i, n - i))
        CASE "trimEnd", "trimRight"
            i = n
            WHILE i > 0 AND (" " + Chr(9) + Chr(10) + Chr(13)).Contains(s.CharAt(i - 1))
                i = i - 1
            END WHILE
            RETURN JsS(s.Substring(0, i))
        CASE "charAt"
            i = JsInt(a)
            IF i < 0 OR i >= n THEN RETURN "s"
            RETURN JsS(s.CharAt(i))
        CASE "charCodeAt"
            i = JsInt(a)
            IF i < 0 OR i >= n THEN RETURN "nNaN"
            RETURN JsN(Asc(s.CharAt(i)))
        CASE "indexOf"
            i = MATH.Max(0, JsInt(JsArg(args, 1)))
            IF i > n THEN RETURN "n-1"
            found = s.Substring(i, n - i).IndexOf(JsStr(a))
            IF found < 0 THEN RETURN "n-1"
            RETURN JsN(found + i)
        CASE "lastIndexOf"
            t = JsStr(a)
            found = -1
            j = n - t.Length
            IF args.Count > 1 AND JsArg(args, 1) <> "u" THEN j = MATH.Min(j, JsInt(args[1]))
            FOR i = j TO 0 STEP -1
                IF s.Substring(i, t.Length) = t THEN
                    found = i
                    BREAK
                END IF
            NEXT
            RETURN JsN(found)
        CASE "substring"
            i = MATH.Min(MATH.Max(JsInt(a), 0), n)
            j = n
            IF JsArg(args, 1) <> "u" THEN j = MATH.Min(MATH.Max(JsInt(args[1]), 0), n)
            IF i > j THEN
                found = i
                i = j
                j = found
            END IF
            RETURN JsS(s.Substring(i, j - i))
        CASE "substr"
            i = JsInt(a)
            IF i < 0 THEN i = MATH.Max(0, n + i)
            IF i > n THEN i = n
            j = n - i
            IF JsArg(args, 1) <> "u" THEN j = MATH.Min(MATH.Max(JsInt(args[1]), 0), n - i)
            RETURN JsS(s.Substring(i, j))
        CASE "slice"
            i = JsInt(a)
            IF i < 0 THEN i = MATH.Max(0, n + i)
            j = n
            IF JsArg(args, 1) <> "u" THEN j = JsInt(args[1])
            IF j < 0 THEN j = MATH.Max(0, n + j)
            i = MATH.Min(i, n)
            j = MATH.Min(j, n)
            IF j <= i THEN RETURN "s"
            RETURN JsS(s.Substring(i, j - i))
        CASE "toUpperCase", "toLocaleUpperCase"
            RETURN JsS(s.Upper())
        CASE "toLowerCase", "toLocaleLowerCase"
            RETURN JsS(s.Lower())
        CASE "trim"
            RETURN JsS(s.Trim())
        CASE "split"
            IF a = "u" THEN
                out.Add(JsS(s))
            ELSEIF JsStr(a) = "" THEN
                FOR i = 0 TO n - 1
                    out.Add(JsS(s.CharAt(i)))
                NEXT
            ELSE
                FOR EACH t IN s.Split(JsStr(a))
                    out.Add(JsS(t))
                NEXT
            END IF
            RETURN JsO(JsNewArray(out))
        CASE "concat"
            t = s
            FOR i = 0 TO args.Count - 1
                t = t + JsStr(args[i])
            NEXT
            RETURN JsS(t)
        CASE "toString", "valueOf"
            RETURN JsS(s)
        CASE "bold"
            RETURN JsS("<B>" + s + "</B>")
        CASE "italics"
            RETURN JsS("<I>" + s + "</I>")
        CASE "fixed"
            RETURN JsS("<TT>" + s + "</TT>")
        CASE "big"
            RETURN JsS("<BIG>" + s + "</BIG>")
        CASE "small"
            RETURN JsS("<SMALL>" + s + "</SMALL>")
        CASE "blink"
            RETURN JsS("<BLINK>" + s + "</BLINK>")
        CASE "strike"
            RETURN JsS("<STRIKE>" + s + "</STRIKE>")
        CASE "sub"
            RETURN JsS("<SUB>" + s + "</SUB>")
        CASE "sup"
            RETURN JsS("<SUP>" + s + "</SUP>")
        CASE "fontcolor"
            RETURN JsS("<FONT COLOR=""" + JsStr(a) + """>" + s + "</FONT>")
        CASE "fontsize"
            RETURN JsS("<FONT SIZE=""" + JsStr(a) + """>" + s + "</FONT>")
        CASE "anchor"
            RETURN JsS("<A NAME=""" + JsStr(a) + """>" + s + "</A>")
        CASE "link"
            RETURN JsS("<A HREF=""" + JsStr(a) + """>" + s + "</A>")
    END SELECT
    THROW Str(jsLine) + "|Object doesn't support this property or method"
END FUNCTION

FUNCTION JsArrayMethod (name AS String, id AS Integer, args AS Array OF String) AS String
    VAR fn AS String
    VAR self AS String
    VAR r AS String
    VAR acc AS String
    VAR cb AS Array OF String
    VAR items AS Array OF String
    VAR out AS Array OF String
    VAR v AS String
    VAR i AS Integer
    VAR j AS Integer
    VAR n AS Integer
    VAR k AS Integer
    VAR keys AS Array OF String
    VAR tmp AS String
    VAR pair AS Array OF String
    IF id = 0 OR joClass[id] <> "Array" THEN THROW Str(jsLine) + "|Array object expected"
    ' (these two need only the end of the array, not a copy of it all)
    IF name = "push" THEN
        n = JsInt(JsGetProp(id, "length"))
        FOR i = 0 TO args.Count - 1
            JsPutOwn(id, Str(n + i), args[i])
        NEXT
        JsPutOwn(id, "length", JsN(n + args.Count))
        RETURN JsN(n + args.Count)
    END IF
    IF name = "pop" THEN
        n = JsInt(JsGetProp(id, "length"))
        IF n = 0 THEN RETURN "u"
        v = JsGetProp(id, Str(n - 1))
        JsSetLength(id, n - 1)
        RETURN v
    END IF
    items = JsItems(id)
    n = items.Count
    IF "|forEach|map|filter|some|every|find|findIndex|".Contains("|" + name + "|") THEN
        fn = JsNeedFn(JsArg(args, 0), "callback")
        self = JsThisArg(JsArg(args, 1))
        FOR i = 0 TO n - 1
            r = JsCall(fn, self, JsArgs3(items[i], JsN(i), JsO(id)))
            SELECT CASE name
                CASE "map"
                    out.Add(r)
                CASE "filter"
                    IF JsBool(r) THEN out.Add(items[i])
                CASE "some"
                    IF JsBool(r) THEN RETURN "t"
                CASE "every"
                    IF NOT JsBool(r) THEN RETURN "f"
                CASE "find"
                    IF JsBool(r) THEN RETURN items[i]
                CASE "findIndex"
                    IF JsBool(r) THEN RETURN JsN(i)
            END SELECT
        NEXT
        SELECT CASE name
            CASE "map", "filter"
                RETURN JsO(JsNewArray(out))
            CASE "some"
                RETURN "f"
            CASE "every"
                RETURN "t"
            CASE "findIndex"
                RETURN "n-1"
        END SELECT
        RETURN "u"
    END IF
    IF name = "reduce" OR name = "reduceRight" THEN
        fn = JsNeedFn(JsArg(args, 0), "callback")
        IF name = "reduceRight" THEN items.Reverse()
        k = 0
        IF args.Count > 1 THEN
            acc = args[1]
        ELSE
            IF n = 0 THEN
                jsThrown = JsMakeTypedError("TypeError", "Reduce of empty array with no initial value")
                THROW Str(jsLine) + "|@thrown"
            END IF
            acc = items[0]
            k = 1
        END IF
        FOR i = k TO n - 1
            cb.Clear()
            cb.Add(acc)
            cb.Add(items[i])
            IF name = "reduceRight" THEN
                cb.Add(JsN(n - 1 - i))
            ELSE
                cb.Add(JsN(i))
            END IF
            cb.Add(JsO(id))
            acc = JsCall(fn, JsO(jsGlobal), cb)
        NEXT
        RETURN acc
    END IF
    SELECT CASE name
        CASE "includes"
            v = JsArg(args, 0)
            FOR i = 0 TO n - 1
                IF JsStrictEq(items[i], v) THEN RETURN "t"
                IF v.StartsWith("n") AND items[i].StartsWith("n") AND JsNum(v) = "NaN" AND JsNum(items[i]) = "NaN" THEN RETURN "t"
            NEXT
            RETURN "f"
        CASE "lastIndexOf"
            FOR i = n - 1 TO 0 STEP -1
                IF JsStrictEq(items[i], JsArg(args, 0)) THEN RETURN JsN(i)
            NEXT
            RETURN "n-1"
        CASE "fill"
            j = 0
            IF args.Count > 1 THEN j = JsInt(args[1])
            IF j < 0 THEN j = MATH.Max(0, n + j)
            k = n
            IF args.Count > 2 AND args[2] <> "u" THEN k = JsInt(args[2])
            IF k < 0 THEN k = MATH.Max(0, n + k)
            FOR i = j TO MATH.Min(k, n) - 1
                JsPutOwn(id, Str(i), JsArg(args, 0))
            NEXT
            RETURN JsO(id)
    END SELECT
    SELECT CASE name
        CASE "join"
            IF JsArg(args, 0) = "u" THEN RETURN JsS(JsJoin(id, ","))
            RETURN JsS(JsJoin(id, JsStr(args[0])))
        CASE "toString"
            RETURN JsS(JsJoin(id, ","))
        CASE "push"
            FOR i = 0 TO args.Count - 1
                JsPutOwn(id, Str(n + i), args[i])
            NEXT
            JsPutOwn(id, "length", JsN(n + args.Count))
            RETURN JsN(n + args.Count)
        CASE "pop"
            IF n = 0 THEN RETURN "u"
            v = items[n - 1]
            JsSetLength(id, n - 1)
            RETURN v
        CASE "shift"
            IF n = 0 THEN RETURN "u"
            v = items[0]
            FOR i = 1 TO n - 1
                JsPutOwn(id, Str(i - 1), items[i])
            NEXT
            JsSetLength(id, n - 1)
            RETURN v
        CASE "unshift"
            FOR i = 0 TO args.Count - 1
                out.Add(args[i])
            NEXT
            FOR EACH v IN items
                out.Add(v)
            NEXT
            FOR i = 0 TO out.Count - 1
                JsPutOwn(id, Str(i), out[i])
            NEXT
            JsPutOwn(id, "length", JsN(out.Count))
            RETURN JsN(out.Count)
        CASE "reverse"
            FOR i = 0 TO n - 1
                JsPutOwn(id, Str(i), items[n - 1 - i])
            NEXT
            RETURN JsO(id)
        CASE "concat"
            FOR EACH v IN items
                out.Add(v)
            NEXT
            FOR i = 0 TO args.Count - 1
                IF args[i].StartsWith("o") AND joClass[JsId(args[i])] = "Array" THEN
                    FOR EACH v IN JsItems(JsId(args[i]))
                        out.Add(v)
                    NEXT
                ELSE
                    out.Add(args[i])
                END IF
            NEXT
            RETURN JsO(JsNewArray(out))
        CASE "slice"
            i = JsInt(JsArg(args, 0))
            IF i < 0 THEN i = MATH.Max(0, n + i)
            j = n
            IF JsArg(args, 1) <> "u" THEN j = JsInt(args[1])
            IF j < 0 THEN j = MATH.Max(0, n + j)
            FOR k = i TO MATH.Min(j, n) - 1
                out.Add(items[k])
            NEXT
            RETURN JsO(JsNewArray(out))
        CASE "splice"
            i = JsInt(JsArg(args, 0))
            IF i < 0 THEN i = MATH.Max(0, n + i)
            IF i > n THEN i = n
            k = n - i
            IF args.Count > 1 THEN k = MATH.Max(0, MATH.Min(JsInt(args[1]), n - i))
            FOR j = i TO i + k - 1
                out.Add(items[j])
            NEXT
            FOR j = 0 TO i - 1
                keys.Add(items[j])
            NEXT
            FOR j = 2 TO args.Count - 1
                keys.Add(args[j])
            NEXT
            FOR j = i + k TO n - 1
                keys.Add(items[j])
            NEXT
            FOR j = 0 TO keys.Count - 1
                JsPutOwn(id, Str(j), keys[j])
            NEXT
            JsSetLength(id, keys.Count)
            RETURN JsO(JsNewArray(out))
        CASE "indexOf"
            FOR i = 0 TO n - 1
                IF JsStrictEq(items[i], JsArg(args, 0)) THEN RETURN JsN(i)
            NEXT
            RETURN "n-1"
        CASE "sort"
            IF JsCallable(JsArg(args, 0)) THEN
                ' insertion sort with the page's own comparison
                FOR i = 1 TO n - 1
                    v = items[i]
                    j = i - 1
                    WHILE j >= 0
                        pair.Clear()
                        pair.Add(items[j])
                        pair.Add(v)
                        IF JsReal(JsCall(args[0], JsO(jsGlobal), pair)) <= 0 THEN BREAK
                        items[j + 1] = items[j]
                        j = j - 1
                    END WHILE
                    items[j + 1] = v
                NEXT
            ELSE
                ' as text: sort "text<tab>index" and read the order back
                FOR i = 0 TO n - 1
                    IF items[i] = "u" THEN
                        keys.Add(Chr(65535) + Chr(9) + Str(i))
                    ELSE
                        keys.Add(JsStr(items[i]) + Chr(9) + Str(i))
                    END IF
                NEXT
                keys.Sort()
                FOR EACH tmp IN keys
                    out.Add(items[Int(Val(tmp.Split(Chr(9))[tmp.Split(Chr(9)).Count - 1]))])
                NEXT
                items = out
            END IF
            FOR i = 0 TO n - 1
                JsPutOwn(id, Str(i), items[i])
            NEXT
            RETURN JsO(id)
    END SELECT
    THROW Str(jsLine) + "|Object doesn't support this property or method"
END FUNCTION

FUNCTION JsDateMethod (name AS String, thisVal AS String, args AS Array OF String) AS String
    VAR ms AS Real
    VAR id AS Integer
    VAR y AS Real
    VAR mon AS Real
    VAR d AS Real
    VAR h AS Real
    VAR mi AS Real
    VAR sec AS Real
    VAR part AS Real
    id = JsId(thisVal)
    IF id = 0 OR joClass[id] <> "Date" THEN THROW Str(jsLine) + "|Date object expected"
    IF joS[id] = "NaN" THEN RETURN "nNaN"
    ms = Val(joS[id])
    SELECT CASE name
        CASE "getTime", "valueOf"
            RETURN JsN(ms)
        CASE "getFullYear"
            RETURN JsN(JsDatePart(ms, "year"))
        CASE "getYear"
            ' the famous quirk of 1996 browsers: 96 for 1996, but 2001 for 2001
            IF JsDatePart(ms, "year") >= 1900 AND JsDatePart(ms, "year") < 2000 THEN RETURN JsN(JsDatePart(ms, "year") - 1900)
            RETURN JsN(JsDatePart(ms, "year"))
        CASE "getMonth"
            RETURN JsN(JsDatePart(ms, "month"))
        CASE "getDate"
            RETURN JsN(JsDatePart(ms, "date"))
        CASE "getDay"
            RETURN JsN(JsDatePart(ms, "day"))
        CASE "getHours"
            RETURN JsN(JsDatePart(ms, "hours"))
        CASE "getMinutes"
            RETURN JsN(JsDatePart(ms, "minutes"))
        CASE "getSeconds"
            RETURN JsN(JsDatePart(ms, "seconds"))
        CASE "getMilliseconds"
            RETURN JsN(JsDatePart(ms, "ms"))
        CASE "getTimezoneOffset"
            RETURN JsN(-JsZone() / 60)
        CASE "toString", "toLocaleString", "toGMTString", "toUTCString"
            RETURN JsS(JsDateText(ms))
        CASE "setTime"
            joS[id] = JsNum(JsArg(args, 0))
            RETURN "n" + joS[id]
        CASE "setFullYear", "setYear", "setMonth", "setDate", "setHours", "setMinutes", "setSeconds", "setMilliseconds"
            y = JsDatePart(ms, "year")
            mon = JsDatePart(ms, "month")
            d = JsDatePart(ms, "date")
            h = JsDatePart(ms, "hours")
            mi = JsDatePart(ms, "minutes")
            sec = JsDatePart(ms, "seconds")
            part = JsDatePart(ms, "ms")
            IF NOT JsFinite(JsNum(JsArg(args, 0))) THEN
                joS[id] = "NaN"
                RETURN "nNaN"
            END IF
            SELECT CASE name
                CASE "setFullYear", "setYear"
                    y = JsReal(args[0])
                    IF name = "setYear" AND y >= 0 AND y < 100 THEN y = y + 1900
                CASE "setMonth"
                    mon = JsReal(args[0])
                CASE "setDate"
                    d = JsReal(args[0])
                CASE "setHours"
                    h = JsReal(args[0])
                CASE "setMinutes"
                    mi = JsReal(args[0])
                CASE "setSeconds"
                    sec = JsReal(args[0])
                CASE "setMilliseconds"
                    part = JsReal(args[0])
            END SELECT
            joS[id] = JsFmt(JsLocalMs(y, mon, d, h, mi, sec, part))
            RETURN "n" + joS[id]
    END SELECT
    THROW Str(jsLine) + "|Object doesn't support this property or method"
END FUNCTION

' ---------------------------------------------------------------- XMLHttpRequest
'
' An XMLHttpRequest is an object of class XHR. Besides what the page sees
' (readyState, status, statusText, responseText, the handlers) it keeps
' hidden properties: @method, @url, @headers (one "Name: value" a line) and
' @rheaders for the response's, and @req, the browser's number for the
' request on its way (0 when there is none). fetch() makes one too, with
' @promise, the promise it answers.

FUNCTION JsNewXhr () AS Integer
    VAR id AS Integer
    id = JsNewObject("XHR", jsXhrProto)
    JsPutOwn(id, "readyState", "n0")
    JsPutOwn(id, "status", "n0")
    JsPutOwn(id, "statusText", "s")
    JsPutOwn(id, "responseText", "s")
    JsPutOwn(id, "responseXML", "l")
    JsPutOwn(id, "onreadystatechange", "l")
    JsPutOwn(id, "onload", "l")
    JsPutOwn(id, "onerror", "l")
    JsPutOwn(id, "@req", "n0")
    JsPutOwn(id, "@headers", "s")
    JsPutOwn(id, "@rheaders", "s")
    RETURN id
END FUNCTION

' readyState becomes state, and onreadystatechange hears of it.
SUB JsXhrState (id AS Integer, state AS Integer)
    VAR none AS Array OF String
    VAR fn AS String
    VAR v AS String
    JsPutOwn(id, "readyState", JsN(state))
    fn = JsGetProp(id, "onreadystatechange")
    IF JsCallable(fn) THEN v = JsCall(fn, JsO(id), none)
END SUB

FUNCTION JsXhrMethod (name AS String, thisVal AS String, args AS Array OF String) AS String
    VAR id AS Integer
    VAR body AS String
    VAR line AS String
    VAR want AS String
    VAR out AS Array OF String
    id = JsId(thisVal)
    IF id = 0 OR joClass[id] <> "XHR" THEN THROW Str(jsLine) + "|Object expected"
    SELECT CASE name
        CASE "open"
            ' A script cannot stop and wait for the network: the browser fetches
            ' between scripts, a tick at a time
            IF args.Count > 2 THEN
                IF args[2] <> "u" AND NOT JsBool(args[2]) THEN THROW Str(jsLine) + "|Simxplorer cannot wait for the network in the middle of a script. Use open(method, url, true) and onreadystatechange"
            END IF
            IF JsInt(JsGetProp(id, "@req")) > 0 THEN HostXhrAbort(JsInt(JsGetProp(id, "@req")))
            JsPutOwn(id, "@method", JsS(JsStr(JsArg(args, 0)).Upper()))
            JsPutOwn(id, "@url", JsS(JsStr(JsArg(args, 1))))
            JsPutOwn(id, "@headers", "s")
            JsPutOwn(id, "@rheaders", "s")
            JsPutOwn(id, "@req", "n0")
            JsPutOwn(id, "status", "n0")
            JsPutOwn(id, "statusText", "s")
            JsPutOwn(id, "responseText", "s")
            JsXhrState(id, 1)
            RETURN "u"
        CASE "setRequestHeader"
            IF JsInt(JsGetProp(id, "readyState")) <> 1 OR JsInt(JsGetProp(id, "@req")) <> 0 THEN THROW Str(jsLine) + "|Unspecified error"
            line = JsStr(JsArg(args, 0)).Replace(Chr(10), "").Replace(Chr(13), "") + ": " + JsStr(JsArg(args, 1)).Replace(Chr(10), " ").Replace(Chr(13), "")
            JsPutOwn(id, "@headers", JsS(JsStr(JsGetProp(id, "@headers")) + line + Chr(10)))
            RETURN "u"
        CASE "send"
            IF JsInt(JsGetProp(id, "readyState")) <> 1 OR JsInt(JsGetProp(id, "@req")) <> 0 THEN THROW Str(jsLine) + "|Unspecified error"
            IF args.Count > 0 THEN
                IF args[0] <> "u" AND args[0] <> "l" THEN body = JsStr(args[0])
            END IF
            JsPutOwn(id, "@req", JsN(HostXhrSend(JsStr(JsGetProp(id, "@method")), JsStr(JsGetProp(id, "@url")), JsStr(JsGetProp(id, "@headers")), body, id)))
            RETURN "u"
        CASE "abort"
            IF JsInt(JsGetProp(id, "@req")) > 0 THEN HostXhrAbort(JsInt(JsGetProp(id, "@req")))
            JsPutOwn(id, "@req", "n0")
            JsPutOwn(id, "readyState", "n0")
            JsPutOwn(id, "status", "n0")
            JsPutOwn(id, "responseText", "s")
            RETURN "u"
        CASE "getResponseHeader"
            want = JsStr(JsArg(args, 0)).Lower().Trim() + ":"
            FOR EACH line IN JsStr(JsGetProp(id, "@rheaders")).Split(Chr(10))
                IF line.Lower().StartsWith(want) THEN RETURN JsS(line.Substring(want.Length, line.Length - want.Length).Trim())
            NEXT
            RETURN "l"
        CASE "getAllResponseHeaders"
            FOR EACH line IN JsStr(JsGetProp(id, "@rheaders")).Split(Chr(10))
                IF line <> "" THEN out.Add(line)
            NEXT
            IF out.Count = 0 THEN RETURN "s"
            RETURN JsS(out.Join(Chr(13) + Chr(10)) + Chr(13) + Chr(10))
    END SELECT
    THROW Str(jsLine) + "|Object doesn't support this property or method"
END FUNCTION

' The browser's news of request req, which XMLHttpRequest id made: readyState
' 2, 3 or 4 (at 4, status 0 means it failed). Runs the page's handlers, and
' settles fetch()'s promise. Returns "" or an error ("line|message").
FUNCTION JsXhrUpdate (id AS Integer, req AS Integer, state AS Integer, status AS Integer, statusText AS String, headers AS String, body AS String) AS String
    VAR none AS Array OF String
    VAR fn AS String
    VAR v AS String
    jsSig = ""
    jsDepth = 0
    jsSteps = 0
    jsLimit = JSSTEPLIMIT
    jsThrown = ""
    IF id <= 0 OR id >= joClass.Count THEN RETURN ""
    IF joClass[id] <> "XHR" THEN RETURN ""
    ' aborted, or opened again since
    IF JsInt(JsGetProp(id, "@req")) <> req THEN RETURN ""
    TRY
        JsPutOwn(id, "status", JsN(status))
        JsPutOwn(id, "statusText", JsS(statusText))
        JsPutOwn(id, "@rheaders", JsS(headers))
        JsPutOwn(id, "responseText", JsS(body))
        IF state = 4 THEN JsPutOwn(id, "@req", "n0")
        JsXhrState(id, state)
        IF state = 4 THEN
            IF JsGetProp(id, "@promise").StartsWith("o") THEN JsFetched(id, JsId(JsGetProp(id, "@promise")), status, statusText, body)
            IF status = 0 THEN
                fn = JsGetProp(id, "onerror")
            ELSE
                fn = JsGetProp(id, "onload")
            END IF
            IF JsCallable(fn) THEN v = JsCall(fn, JsO(id), none)
        END IF
    CATCH err
        RETURN JsTidyError(err)
    END TRY
    jsSig = ""
    RETURN ""
END FUNCTION

' fetch(url[, {method, body, headers}]): a promise of a response.
FUNCTION JsFetch (args AS Array OF String) AS String
    VAR x AS Integer
    VAR p AS Integer
    VAR init AS String
    VAR method AS String
    VAR body AS String
    VAR headers AS String
    VAR h AS String
    VAR key AS String
    method = "GET"
    init = JsArg(args, 1)
    IF init.StartsWith("o") THEN
        IF JsGet(init, "method") <> "u" THEN method = JsStr(JsGet(init, "method")).Upper()
        IF JsGet(init, "body") <> "u" AND JsGet(init, "body") <> "l" THEN body = JsStr(JsGet(init, "body"))
        h = JsGet(init, "headers")
        IF h.StartsWith("o") THEN
            FOR EACH key IN joKeys[JsId(h)].Split("|")
                IF key <> "" THEN headers = headers + key + ": " + JsStr(JsGet(h, key)) + Chr(10)
            NEXT
        END IF
    END IF
    x = JsNewXhr()
    p = JsNewPromise()
    JsPutOwn(x, "@promise", JsO(p))
    JsPutOwn(x, "@method", JsS(method))
    JsPutOwn(x, "@url", JsS(JsStr(JsArg(args, 0))))
    JsPutOwn(x, "readyState", "n1")
    JsPutOwn(x, "@req", JsN(HostXhrSend(method, JsStr(JsArg(args, 0)), headers, body, x)))
    RETURN JsO(p)
END FUNCTION

' fetch()'s answer: a Response, or (when nothing came back) a rejection.
SUB JsFetched (x AS Integer, p AS Integer, status AS Integer, statusText AS String, body AS String)
    VAR r AS Integer
    VAR hd AS Integer
    IF status = 0 THEN
        JsResolve(p, FALSE, JsMakeError("0|Failed to fetch " + JsStr(JsGetProp(x, "@url"))))
        RETURN
    END IF
    r = JsNewObject("Object", jsObjectProto)
    JsPutOwn(r, "status", JsN(status))
    JsPutOwn(r, "statusText", JsS(statusText))
    JsPutOwn(r, "ok", JsB(status >= 200 AND status < 300))
    JsPutOwn(r, "url", JsGetProp(x, "@url"))
    JsPutOwn(r, "@body", JsS(body))
    JsPutOwn(r, "text", JsNative("Response.text"))
    JsPutOwn(r, "json", JsNative("Response.json"))
    hd = JsNewObject("Object", jsObjectProto)
    JsPutOwn(hd, "@xhr", JsO(x))
    JsPutOwn(hd, "get", JsNative("Response.header"))
    JsPutOwn(r, "headers", JsO(hd))
    JsResolve(p, TRUE, JsO(r))
END SUB

' ---------------------------------------------------------------- promises, small ones
'
' Enough for fetch(url).then(function (r) { return r.text(); }).then(...):
' then and catch, chaining, and a callback's thenable followed. @state is
' pending, ok or err; @value what it settled with; @then the callbacks
' waiting, three to an entry (on ok, on err, the promise then() returned).
' Callbacks run as soon as there is something to give them.

FUNCTION JsNewPromise () AS Integer
    VAR id AS Integer
    VAR none AS Array OF String
    id = JsNewObject("Promise", jsPromiseProto)
    JsPutOwn(id, "@state", "spending")
    JsPutOwn(id, "@value", "u")
    JsPutOwn(id, "@then", JsO(JsNewArray(none)))
    RETURN id
END FUNCTION

' A function that settles promise p (kind "ok" or "err") with its argument.
FUNCTION JsSettler (p AS Integer, kind AS String) AS String
    RETURN JsNative("Promise.settle:" + kind + ":" + Str(p))
END FUNCTION

SUB JsResolve (p AS Integer, ok AS Bool, v AS String)
    VAR args AS Array OF String
    VAR fn AS String
    VAR r AS String
    VAR waiting AS Array OF String
    VAR i AS Integer
    VAR none AS Array OF String
    IF JsGetProp(p, "@state") <> "spending" THEN RETURN
    ' a thenable is followed: p ends as it does
    IF ok AND v.StartsWith("o") AND JsId(v) <> p THEN
        fn = JsGet(v, "then")
        IF JsCallable(fn) THEN
            args.Add(JsSettler(p, "ok"))
            args.Add(JsSettler(p, "err"))
            r = JsCall(fn, v, args)
            RETURN
        END IF
    END IF
    IF ok THEN
        JsPutOwn(p, "@state", "sok")
    ELSE
        JsPutOwn(p, "@state", "serr")
    END IF
    JsPutOwn(p, "@value", v)
    waiting = JsItems(JsId(JsGetProp(p, "@then")))
    JsPutOwn(p, "@then", JsO(JsNewArray(none)))
    i = 0
    WHILE i + 2 < waiting.Count
        JsQueueThen(p, waiting[i], waiting[i + 1], JsId(waiting[i + 2]))
        i = i + 3
    END WHILE
END SUB

' A settled promise p gives its value to the callback that fits; what that
' returns (or throws) settles child.
SUB JsRunThen (p AS Integer, onOk AS String, onErr AS String, child AS Integer)
    VAR ok AS Bool
    VAR fn AS String
    VAR args AS Array OF String
    VAR r AS String
    VAR depth AS Integer
    VAR failed AS Bool
    ok = JsGetProp(p, "@state") = "sok"
    fn = onErr
    IF ok THEN fn = onOk
    IF NOT JsCallable(fn) THEN
        JsResolve(child, ok, JsGetProp(p, "@value"))
        RETURN
    END IF
    args.Add(JsGetProp(p, "@value"))
    depth = jsDepth
    TRY
        r = JsCall(fn, JsO(jsGlobal), args)
    CATCH err
        jsDepth = depth
        IF err.Contains("@aborted") THEN THROW err
        IF jsThrown <> "" THEN
            r = jsThrown
        ELSE
            r = JsMakeError(err)
        END IF
        jsThrown = ""
        jsSig = ""
        failed = TRUE
    END TRY
    JsResolve(child, NOT failed, r)
END SUB

FUNCTION JsPromiseMethod (name AS String, thisVal AS String, args AS Array OF String) AS String
    VAR id AS Integer
    VAR child AS Integer
    VAR list AS Integer
    VAR n AS Integer
    VAR parts AS Array OF String
    VAR line AS String
    VAR want AS String
    VAR code AS Array OF String
    VAR v AS String
    id = JsId(thisVal)
    IF name.StartsWith("Promise.settle:") THEN
        parts = name.Split(":")
        JsResolve(Int(Val(parts[2])), parts[1] = "ok", JsArg(args, 0))
        RETURN "u"
    END IF
    SELECT CASE name
        CASE "Promise.then", "Promise.catch"
            IF id = 0 OR joClass[id] <> "Promise" THEN THROW Str(jsLine) + "|Object expected"
            child = JsNewPromise()
            IF name = "Promise.catch" THEN
                args.Insert(0, "u")
            END IF
            IF JsGetProp(id, "@state") = "spending" THEN
                list = JsId(JsGetProp(id, "@then"))
                n = JsInt(JsGetProp(list, "length"))
                JsPutOwn(list, Str(n), JsArg(args, 0))
                JsPutOwn(list, Str(n + 1), JsArg(args, 1))
                JsPutOwn(list, Str(n + 2), JsO(child))
                JsPutOwn(list, "length", JsN(n + 3))
            ELSE
                JsQueueThen(id, JsArg(args, 0), JsArg(args, 1), child)
            END IF
            RETURN JsO(child)
        CASE "Response.text"
            child = JsNewPromise()
            JsResolve(child, TRUE, JsGet(thisVal, "@body"))
            RETURN JsO(child)
        CASE "Response.json"
            ' JSON is JavaScript, so eval reads it
            child = JsNewPromise()
            code.Add(JsS("(" + JsStr(JsGet(thisVal, "@body")) + ")"))
            TRY
                v = JsEvalCode(code, jsGlobal)
            CATCH err
                JsResolve(child, FALSE, JsMakeError(err))
                RETURN JsO(child)
            END TRY
            JsResolve(child, TRUE, v)
            RETURN JsO(child)
        CASE "Response.header"
            want = JsStr(JsArg(args, 0)).Lower().Trim() + ":"
            FOR EACH line IN JsStr(JsGetProp(JsId(JsGet(thisVal, "@xhr")), "@rheaders")).Split(Chr(10))
                IF line.Lower().StartsWith(want) THEN RETURN JsS(line.Substring(want.Length, line.Length - want.Length).Trim())
            NEXT
            RETURN "l"
    END SELECT
    THROW Str(jsLine) + "|Object doesn't support this property or method"
END FUNCTION

' ---------------------------------------------------------------- patterns, block scopes and classes

' The names a var/let declaration (or a class) makes.
FUNCTION JsDeclNames (n AS Integer) AS Array OF String
    VAR out AS Array OF String
    VAR item AS String
    VAR d AS Integer
    VAR name AS String
    IF nk[n] = "classdecl" THEN
        out.Add(ns[n])
        RETURN out
    END IF
    FOR EACH item IN nl[n].Split(",")
        IF item = "" THEN CONTINUE
        d = Int(Val(item))
        IF nb[d] <> 0 THEN
            FOR EACH name IN JsPatternNames(nb[d])
                out.Add(name)
            NEXT
        ELSE
            out.Add(ns[d])
        END IF
    NEXT
    RETURN out
END FUNCTION

FUNCTION JsPatternNames (t AS Integer) AS Array OF String
    VAR out AS Array OF String
    VAR item AS String
    VAR name AS String
    VAR k AS Integer
    IF t = 0 THEN RETURN out
    SELECT CASE nk[t]
        CASE "pname"
            out.Add(ns[t])
        CASE "pobj", "parr", "params"
            FOR EACH item IN nl[t].Split(",")
                IF item = "" OR item = "0" THEN CONTINUE
                k = Int(Val(item))
                IF nk[k] = "pprop" THEN k = nb[k]
                FOR EACH name IN JsPatternNames(k)
                    out.Add(name)
                NEXT
            NEXT
            FOR EACH name IN JsPatternNames(nc[t])
                out.Add(name)
            NEXT
    END SELECT
    RETURN out
END FUNCTION

' The values for ... and for-of: an array's items, a string's characters,
' or anything with a length.
FUNCTION JsIterate (v AS String) AS Array OF String
    VAR out AS Array OF String
    VAR i AS Integer
    VAR text AS String
    IF v.StartsWith("s") THEN
        text = v.Substring(1, v.Length - 1)
        FOR i = 0 TO text.Length - 1
            out.Add(JsS(text.CharAt(i)))
        NEXT
        RETURN out
    END IF
    IF v.StartsWith("o") THEN
        IF joClass[JsId(v)] = "Array" THEN RETURN JsItems(JsId(v))
        IF JsGet(v, "length").StartsWith("n") THEN
            FOR i = 0 TO JsInt(JsGet(v, "length")) - 1
                out.Add(JsGet(v, Str(i)))
            NEXT
            RETURN out
        END IF
    END IF
    jsThrown = JsMakeTypedError("TypeError", JsStr(JsS(JsTypeOf(v))) + " is not iterable")
    THROW Str(jsLine) + "|@thrown"
    RETURN out
END FUNCTION

' v put into target t: a name, or a pattern taking v apart.
SUB JsBind (t AS Integer, v AS String, scope AS Integer)
    VAR item AS String
    VAR k AS Integer
    VAR used AS String
    VAR items AS Array OF String
    VAR rest AS Array OF String
    VAR i AS Integer
    VAR key AS String
    VAR id AS Integer
    IF v = "u" AND na[t] <> 0 THEN v = JsEval(na[t], scope)
    SELECT CASE nk[t]
        CASE "pname"
            JsSetVar(ns[t], v, scope)
        CASE "pobj"
            IF v = "u" OR v = "l" THEN
                jsThrown = JsMakeTypedError("TypeError", "Cannot destructure '" + JsStr(v) + "' as it is " + JsStr(v) + ".")
                THROW Str(jsLine) + "|@thrown"
            END IF
            used = "|"
            FOR EACH item IN nl[t].Split(",")
                IF item = "" THEN CONTINUE
                k = Int(Val(item))
                JsBind(nb[k], JsGet(v, ns[k]), scope)
                used = used + ns[k] + "|"
            NEXT
            IF nc[t] <> 0 THEN
                id = JsNewObject("Object", jsObjectProto)
                IF v.StartsWith("o") THEN
                    FOR EACH key IN JsOwnKeys(JsId(v))
                        IF NOT used.Contains("|" + key + "|") THEN JsPutOwn(id, key, JsGet(v, key))
                    NEXT
                END IF
                JsBind(nc[t], JsO(id), scope)
            END IF
        CASE "parr"
            items = JsIterate(v)
            i = 0
            FOR EACH item IN nl[t].Split(",")
                IF item = "" THEN CONTINUE
                IF item <> "0" THEN
                    IF i < items.Count THEN
                        JsBind(Int(Val(item)), items[i], scope)
                    ELSE
                        JsBind(Int(Val(item)), "u", scope)
                    END IF
                END IF
                i = i + 1
            NEXT
            IF nc[t] <> 0 THEN
                FOR k = i TO items.Count - 1
                    rest.Add(items[k])
                NEXT
                JsBind(nc[t], JsO(JsNewArray(rest)), scope)
            END IF
    END SELECT
END SUB

' A call's arguments into its parameters, when they're more than names.
SUB JsBindParams (p AS Integer, args AS Array OF String, scope AS Integer)
    VAR name AS String
    VAR item AS String
    VAR i AS Integer
    VAR rest AS Array OF String
    FOR EACH name IN JsPatternNames(p)
        JsPutOwn(scope, name, "u")
    NEXT
    FOR EACH item IN nl[p].Split(",")
        IF item = "" THEN CONTINUE
        IF i < args.Count THEN
            JsBind(Int(Val(item)), args[i], scope)
        ELSE
            JsBind(Int(Val(item)), "u", scope)
        END IF
        i = i + 1
    NEXT
    IF nc[p] <> 0 THEN
        FOR i = i TO args.Count - 1
            rest.Add(args[i])
        NEXT
        JsBind(nc[p], JsO(JsNewArray(rest)), scope)
    END IF
END SUB

' A scope for a block's (or a loop's) let, const and class names.
FUNCTION JsBlockScope (n AS Integer, scope AS Integer) AS Integer
    VAR s AS Integer
    VAR item AS String
    VAR name AS String
    VAR k AS Integer
    s = JsNewObject("Scope", 0)
    joA[s] = scope
    SELECT CASE nk[n]
        CASE "block"
            FOR EACH item IN nl[n].Split(",")
                IF item = "" THEN CONTINUE
                k = Int(Val(item))
                IF nk[k] = "let" OR nk[k] = "classdecl" THEN
                    FOR EACH name IN JsDeclNames(k)
                        JsPutOwn(s, name, "u")
                    NEXT
                END IF
            NEXT
        CASE "for"
            FOR EACH name IN JsDeclNames(na[n])
                JsPutOwn(s, name, "u")
            NEXT
        CASE "forin", "forof"
            IF nb[n] <> 0 THEN
                FOR EACH name IN JsPatternNames(nb[n])
                    JsPutOwn(s, name, "u")
                NEXT
            ELSE
                JsPutOwn(s, ns[n], "u")
            END IF
    END SELECT
    RETURN s
END FUNCTION

' The next time round a for (let ...) loop: the same names, in a new scope,
' so a closure made last time keeps last time's values.
FUNCTION JsCopyScope (s AS Integer) AS Integer
    VAR t AS Integer
    VAR name AS String
    t = JsNewObject("Scope", 0)
    joA[t] = joA[s]
    FOR EACH name IN joKeys[s].Split("|")
        IF name <> "" THEN JsPutOwn(t, name, jpVal[JsOwn(s, name)])
    NEXT
    JsFreeScope(s)
    RETURN t
END FUNCTION

' A class: its constructor function, with the methods on its prototype and
' the static ones on itself. Its methods close over a scope that knows what
' super is (@super, @superproto) and which class this is (@class).
FUNCTION JsMakeClass (n AS Integer, scope AS Integer) AS String
    VAR sup AS String
    VAR superProto AS Integer
    VAR cs AS Integer
    VAR proto AS Integer
    VAR fn AS String
    VAR fid AS Integer
    VAR item AS String
    VAR m AS Integer
    VAR fields AS Array OF String
    VAR st AS Integer
    sup = "u"
    superProto = jsObjectProto
    IF na[n] <> 0 THEN
        sup = JsEval(na[n], scope)
        IF sup = "l" THEN
            superProto = 0
        ELSE
            IF NOT JsCallable(sup) THEN
                jsThrown = JsMakeTypedError("TypeError", "Class extends value " + JsStr(sup) + " is not a constructor or null")
                THROW Str(nline[n]) + "|@thrown"
            END IF
            superProto = JsId(JsGet(sup, "prototype"))
        END IF
    END IF
    cs = JsNewObject("Scope", 0)
    joA[cs] = scope
    proto = JsNewObject("Object", superProto)
    fn = JsMakeFunction(nb[n], cs)
    fid = JsId(fn)
    JsPutOwn(fid, "prototype", JsO(proto))
    JsPutOwn(proto, "constructor", fn)
    joKeys[proto] = "|"
    IF JsCallable(sup) THEN joProto[fid] = JsId(sup)
    JsPutOwn(cs, "@super", sup)
    JsPutOwn(cs, "@superproto", JsO(superProto))
    JsPutOwn(cs, "@class", fn)
    IF ns[n] <> "" THEN JsPutOwn(cs, ns[n], fn)
    JsPutOwn(fid, "@name", JsS(ns[n]))
    JsPutOwn(fid, "@cscope", JsN(cs))
    FOR EACH item IN nl[n].Split(",")
        IF item = "" THEN CONTINUE
        m = Int(Val(item))
        IF nk[m] = "method" THEN
            IF nb[m] = 1 THEN
                JsPutOwn(fid, ns[m], JsMakeFunction(na[m], cs))
            ELSE
                JsPutOwn(proto, ns[m], JsMakeFunction(na[m], cs))
            END IF
        ELSEIF nb[m] = 1 THEN
            ' static x = ...: worked out now, with this the class
            st = JsNewScope(cs, fn)
            IF na[m] = 0 THEN
                JsPutOwn(fid, ns[m], "u")
            ELSE
                JsPutOwn(fid, ns[m], JsEval(na[m], st))
            END IF
        ELSE
            fields.Add(item)
        END IF
    NEXT
    ' (methods aren't counted among the prototype's keys, so for-in skips them)
    joKeys[proto] = "|"
    JsPutOwn(fid, "@fields", JsS(fields.Join(",")))
    joB[cs] = 1
    RETURN fn
END FUNCTION

' A new object's fields (x = 1 in its class).
SUB JsInitFields (cls AS String, thisVal AS String)
    VAR list AS String
    VAR item AS String
    VAR m AS Integer
    VAR st AS Integer
    list = JsStr(JsGetProp(JsId(cls), "@fields"))
    IF list = "" OR list = "undefined" THEN RETURN
    st = JsNewScope(JsInt(JsGetProp(JsId(cls), "@cscope")), thisVal)
    FOR EACH item IN list.Split(",")
        IF item = "" THEN CONTINUE
        m = Int(Val(item))
        IF na[m] = 0 THEN
            JsPut(thisVal, ns[m], "u")
        ELSE
            JsPut(thisVal, ns[m], JsEval(na[m], st))
        END IF
    NEXT
END SUB

' super(...): the class this extends, run on this; then this class's fields.
FUNCTION JsSuperCall (n AS Integer, scope AS Integer) AS String
    VAR thisVal AS String
    VAR sup AS String
    VAR cls AS String
    VAR args AS Array OF String
    VAR r AS String
    VAR key AS String
    thisVal = JsThisOf(scope)
    sup = JsLookup("@super", scope)
    cls = JsLookup("@class", scope)
    IF nl[n] = "@all" THEN
        args = JsItems(JsId(JsLookup("arguments", scope)))
    ELSE
        args = JsArgList(n, scope)
    END IF
    jsLine = nline[n]
    IF NOT JsCallable(sup) THEN THROW Str(jsLine) + "|'super' keyword unexpected here"
    IF joClass[JsId(sup)] = "Native" THEN
        ' Error and the like make an object: what they put on it comes over
        r = JsConstruct(joS[JsId(sup)], args)
        IF r.StartsWith("o") THEN
            FOR EACH key IN JsOwnKeys(JsId(r))
                IF key <> "name" THEN JsPut(thisVal, key, JsGet(r, key))
            NEXT
        END IF
    ELSE
        IF JsOwn(JsId(sup), "@cscope") >= 0 THEN
            IF JsGetProp(JsInt(JsGetProp(JsId(sup), "@cscope")), "@super") = "u" THEN JsInitFields(sup, thisVal)
        END IF
        r = JsCall(sup, thisVal, args)
    END IF
    JsInitFields(cls, thisVal)
    RETURN "u"
END FUNCTION

' ---------------------------------------------------------------- the later library

' What came after 1996 and every program now expects: JSON, Object.keys,
' Array.isArray, Number.isInteger, fn.bind, Promise.resolve/reject/all/race.
' (Array and String methods like map and startsWith are with the others.)

VAR jsonSrc AS String
VAR jsonAt AS Integer

' Three arguments, as callbacks get them: (item, index, array).
FUNCTION JsArgs3 (a AS String, b AS String, c AS String) AS Array OF String
    VAR out AS Array OF String
    out.Add(a)
    out.Add(b)
    out.Add(c)
    RETURN out
END FUNCTION

FUNCTION JsNeedFn (v AS String, what AS String) AS String
    IF NOT JsCallable(v) THEN
        jsThrown = JsMakeTypedError("TypeError", what + " is not a function")
        THROW Str(jsLine) + "|@thrown"
    END IF
    RETURN v
END FUNCTION

' An object's own keys, in the order they were made (an array's length left out).
FUNCTION JsOwnKeys (id AS Integer) AS Array OF String
    VAR out AS Array OF String
    VAR key AS String
    FOR EACH key IN joKeys[id].Split("|")
        IF key = "" OR (joClass[id] = "Array" AND key = "length") THEN CONTINUE
        out.Add(key)
    NEXT
    RETURN out
END FUNCTION

FUNCTION JsMakeTypedError (kind AS String, message AS String) AS String
    VAR v AS String
    v = JsMakeError("0|" + message)
    JsPutOwn(JsId(v), "name", JsS(kind))
    IF HostWhere() = "" THEN
        JsPutOwn(JsId(v), "stack", JsS(kind + ": " + message))
    ELSE
        JsPutOwn(JsId(v), "stack", JsS(kind + ": " + message + Chr(10) + "    at " + HostWhere()))
    END IF
    IF JsGetProp(jsGlobal, kind).StartsWith("o") THEN joProto[JsId(v)] = JsId(JsGetProp(JsId(JsGetProp(jsGlobal, kind)), "prototype"))
    RETURN v
END FUNCTION

FUNCTION JsLib (name AS String, thisVal AS String, args AS Array OF String) AS String
    VAR a AS String
    VAR id AS Integer
    VAR out AS Array OF String
    VAR key AS String
    VAR i AS Integer
    VAR v AS String
    VAR p AS Integer
    VAR holder AS Integer
    VAR list AS Array OF String
    VAR pair AS Array OF String
    VAR parts AS Array OF String
    VAR text AS String
    a = JsArg(args, 0)
    IF name.StartsWith("Bound:") THEN
        holder = Int(Val(name.Substring(6, name.Length - 6)))
        list = JsItems(JsId(JsGetProp(holder, "@args")))
        FOR EACH v IN args
            list.Add(v)
        NEXT
        RETURN JsCall(JsGetProp(holder, "@fn"), JsGetProp(holder, "@this"), list)
    END IF
    IF name.StartsWith("Promise.part:") THEN
        ' one of Promise.all's promises settled: its value in its place, and
        ' the whole thing settled when the last is in
        parts = name.Split(":")
        holder = Int(Val(parts[1]))
        p = Int(Val(parts[2]))
        IF JsGetProp(p, "@state") <> "spending" THEN RETURN "u"
        IF parts[4] = "err" THEN
            JsResolve(p, FALSE, a)
            RETURN "u"
        END IF
        IF parts[4] = "race" THEN
            JsResolve(p, TRUE, a)
            RETURN "u"
        END IF
        JsPut(JsO(holder), parts[3], a)
        i = JsInt(JsGetProp(holder, "@left")) - 1
        JsPutOwn(holder, "@left", JsN(i))
        IF i = 0 THEN JsResolve(p, TRUE, JsO(holder))
        RETURN "u"
    END IF
    SELECT CASE name
        CASE "Function.bind"
            holder = JsNewObject("Object", 0)
            JsPutOwn(holder, "@fn", thisVal)
            JsPutOwn(holder, "@this", JsThisArg(a))
            FOR i = 1 TO args.Count - 1
                out.Add(args[i])
            NEXT
            JsPutOwn(holder, "@args", JsO(JsNewArray(out)))
            RETURN JsNative("Bound:" + Str(holder))
        CASE "ObjectS.keys", "ObjectS.values", "ObjectS.entries", "ObjectS.getOwnPropertyNames"
            IF NOT a.StartsWith("o") THEN
                IF a.StartsWith("s") THEN
                    FOR i = 0 TO a.Length - 2
                        out.Add(JsS(Str(i)))
                    NEXT
                END IF
                RETURN JsO(JsNewArray(out))
            END IF
            id = JsId(a)
            FOR EACH key IN JsOwnKeys(id)
                IF name = "ObjectS.values" THEN
                    out.Add(JsGet(a, key))
                ELSEIF name = "ObjectS.entries" THEN
                    pair.Clear()
                    pair.Add(JsS(key))
                    pair.Add(JsGet(a, key))
                    out.Add(JsO(JsNewArray(pair)))
                ELSE
                    out.Add(JsS(key))
                END IF
            NEXT
            RETURN JsO(JsNewArray(out))
        CASE "ObjectS.assign"
            IF NOT a.StartsWith("o") THEN RETURN a
            FOR i = 1 TO args.Count - 1
                IF args[i].StartsWith("o") THEN
                    FOR EACH key IN JsOwnKeys(JsId(args[i]))
                        JsPut(a, key, JsGet(args[i], key))
                    NEXT
                END IF
            NEXT
            RETURN a
        CASE "ObjectS.create"
            IF a = "l" THEN RETURN JsO(JsNewObject("Object", 0))
            IF NOT a.StartsWith("o") THEN RETURN JsO(JsNewObject("Object", jsObjectProto))
            id = JsNewObject("Object", JsId(a))
            IF JsArg(args, 1).StartsWith("o") THEN
                FOR EACH key IN JsOwnKeys(JsId(args[1]))
                    JsPutOwn(id, key, JsGet(JsGet(args[1], key), "value"))
                NEXT
            END IF
            RETURN JsO(id)
        CASE "ObjectS.getPrototypeOf"
            IF NOT a.StartsWith("o") THEN RETURN "l"
            IF joProto[JsId(a)] = 0 THEN RETURN "l"
            RETURN JsO(joProto[JsId(a)])
        CASE "ObjectS.setPrototypeOf"
            IF a.StartsWith("o") AND JsArg(args, 1).StartsWith("o") THEN joProto[JsId(a)] = JsId(args[1])
            RETURN a
        CASE "ObjectS.freeze", "ObjectS.seal", "ObjectS.preventExtensions"
            RETURN a
        CASE "ObjectS.defineProperty"
            IF a.StartsWith("o") AND JsArg(args, 2).StartsWith("o") THEN JsPut(a, JsKey(JsArg(args, 1)), JsGet(args[2], "value"))
            RETURN a
        CASE "ObjectS.is"
            IF JsNum(a) = "NaN" AND JsNum(JsArg(args, 1)) = "NaN" AND a.StartsWith("n") AND JsArg(args, 1).StartsWith("n") THEN RETURN "t"
            RETURN JsB(JsStrictEq(a, JsArg(args, 1)))
        CASE "ArrayS.isArray"
            IF NOT a.StartsWith("o") THEN RETURN "f"
            RETURN JsB(joClass[JsId(a)] = "Array")
        CASE "ArrayS.of"
            RETURN JsO(JsNewArray(args))
        CASE "ArrayS.from"
            IF a.StartsWith("s") THEN
                FOR i = 1 TO a.Length - 1
                    out.Add(JsS(a.Substring(i, 1)))
                NEXT
            ELSEIF a.StartsWith("o") THEN
                IF joClass[JsId(a)] = "Array" THEN
                    out = JsItems(JsId(a))
                ELSE
                    FOR i = 0 TO JsInt(JsGet(a, "length")) - 1
                        out.Add(JsGet(a, Str(i)))
                    NEXT
                END IF
            END IF
            IF JsCallable(JsArg(args, 1)) THEN
                FOR i = 0 TO out.Count - 1
                    list.Clear()
                    list.Add(out[i])
                    list.Add(JsN(i))
                    out[i] = JsCall(args[1], JsO(jsGlobal), list)
                NEXT
            END IF
            RETURN JsO(JsNewArray(out))
        CASE "DateS.now"
            RETURN JsN(JsNow())
        CASE "NumberS.isInteger"
            RETURN JsB(a.StartsWith("n") AND JsFinite(JsNum(a)) AND JsReal(a) = Int(JsReal(a)))
        CASE "NumberS.isFinite"
            RETURN JsB(a.StartsWith("n") AND JsFinite(JsNum(a)))
        CASE "NumberS.isNaN"
            RETURN JsB(a.StartsWith("n") AND JsNum(a) = "NaN")
        CASE "JSON.stringify"
            text = ""
            v = JsArg(args, 2)
            IF v.StartsWith("n") THEN
                FOR i = 1 TO MATH.Min(10, JsInt(v))
                    text = text + " "
                NEXT
            ELSEIF v.StartsWith("s") THEN
                text = JsStr(v)
            END IF
            v = JsJsonOut(a, text, "")
            IF v = Chr(0) THEN RETURN "u"
            RETURN JsS(v)
        CASE "JSON.parse"
            jsonSrc = JsStr(a)
            jsonAt = 0
            v = JsJsonValue()
            JsJsonSpace()
            IF jsonAt < jsonSrc.Length THEN JsJsonFail()
            RETURN v
        CASE "PromiseS.resolve", "PromiseS.reject"
            IF name = "PromiseS.resolve" AND a.StartsWith("o") THEN
                IF joClass[JsId(a)] = "Promise" THEN RETURN a
            END IF
            p = JsNewPromise()
            JsResolve(p, name = "PromiseS.resolve", a)
            RETURN JsO(p)
        CASE "PromiseS.all", "PromiseS.race"
            p = JsNewPromise()
            IF a.StartsWith("o") THEN list = JsItems(JsId(a))
            holder = JsNewArray(out)
            JsPutOwn(holder, "length", JsN(list.Count))
            JsPutOwn(holder, "@left", JsN(list.Count))
            IF list.Count = 0 AND name = "PromiseS.all" THEN JsResolve(p, TRUE, JsO(holder))
            FOR i = 0 TO list.Count - 1
                v = list[i]
                IF NOT v.StartsWith("o") OR joClass[JsId(v)] <> "Promise" THEN
                    id = JsNewPromise()
                    JsResolve(id, TRUE, v)
                    v = JsO(id)
                END IF
                pair.Clear()
                IF name = "PromiseS.race" THEN
                    pair.Add(JsNative("Promise.part:" + Str(holder) + ":" + Str(p) + ":" + Str(i) + ":race"))
                ELSE
                    pair.Add(JsNative("Promise.part:" + Str(holder) + ":" + Str(p) + ":" + Str(i) + ":ok"))
                END IF
                pair.Add(JsNative("Promise.part:" + Str(holder) + ":" + Str(p) + ":" + Str(i) + ":err"))
                v = JsPromiseMethod("Promise.then", v, pair)
            NEXT
            RETURN JsO(p)
    END SELECT
    THROW Str(jsLine) + "|Object doesn't support this property or method"
END FUNCTION

' new Promise(function (resolve, reject) { ... })
FUNCTION JsNewPromiseFrom (executor AS String) AS String
    VAR p AS Integer
    VAR list AS Array OF String
    VAR r AS String
    VAR depth AS Integer
    p = JsNewPromise()
    list.Add(JsSettler(p, "ok"))
    list.Add(JsSettler(p, "err"))
    depth = jsDepth
    TRY
        r = JsCall(JsNeedFn(executor, "Promise resolver"), JsO(jsGlobal), list)
    CATCH err
        jsDepth = depth
        IF err.Contains("@aborted") THEN THROW err
        IF jsThrown <> "" THEN
            r = jsThrown
        ELSE
            r = JsMakeError(err)
        END IF
        jsThrown = ""
        jsSig = ""
        JsResolve(p, FALSE, r)
    END TRY
    RETURN JsO(p)
END FUNCTION

' ---- JSON

FUNCTION JsJsonQuote (s AS String) AS String
    VAR out AS String
    VAR i AS Integer
    VAR c AS String
    VAR k AS Integer
    out = """"
    FOR i = 0 TO s.Length - 1
        c = s.CharAt(i)
        k = Asc(c)
        IF c = """" THEN
            out = out + "\"""
        ELSEIF c = "\" THEN
            out = out + "\\"
        ELSEIF k = 10 THEN
            out = out + "\n"
        ELSEIF k = 13 THEN
            out = out + "\r"
        ELSEIF k = 9 THEN
            out = out + "\t"
        ELSEIF k < 32 THEN
            out = out + "\u00" + "0123456789abcdef".CharAt(Int(k / 16)) + "0123456789abcdef".CharAt(k MOD 16)
        ELSE
            out = out + c
        END IF
    NEXT
    RETURN out + """"
END FUNCTION

' v as JSON; Chr(0) for what JSON leaves out (undefined, functions).
FUNCTION JsJsonOut (v AS String, indent AS String, cur AS String) AS String
    VAR id AS Integer
    VAR parts AS Array OF String
    VAR key AS String
    VAR item AS String
    VAR inner AS String
    VAR sep AS String
    VAR fn AS String
    VAR none AS Array OF String
    SELECT CASE v.Substring(0, 1)
        CASE "u"
            RETURN Chr(0)
        CASE "l"
            RETURN "null"
        CASE "t"
            RETURN "true"
        CASE "f"
            RETURN "false"
        CASE "n"
            IF NOT JsFinite(JsNum(v)) THEN RETURN "null"
            RETURN JsStr(v)
        CASE "s"
            RETURN JsJsonQuote(v.Substring(1, v.Length - 1))
    END SELECT
    IF JsCallable(v) THEN RETURN Chr(0)
    id = JsId(v)
    fn = JsGet(v, "toJSON")
    IF JsCallable(fn) THEN RETURN JsJsonOut(JsCall(fn, v, none), indent, cur)
    IF joClass[id] = "Date" THEN RETURN JsJsonQuote(JsStr(v))
    inner = cur + indent
    sep = ","
    IF indent <> "" THEN sep = "," + Chr(10) + inner
    IF joClass[id] = "Array" THEN
        FOR EACH item IN JsItems(id)
            key = JsJsonOut(item, indent, inner)
            IF key = Chr(0) THEN key = "null"
            parts.Add(key)
        NEXT
        IF parts.Count = 0 THEN RETURN "[]"
        IF indent = "" THEN RETURN "[" + parts.Join(",") + "]"
        RETURN "[" + Chr(10) + inner + parts.Join(sep) + Chr(10) + cur + "]"
    END IF
    FOR EACH key IN JsOwnKeys(id)
        item = JsJsonOut(JsGet(v, key), indent, inner)
        IF item = Chr(0) THEN CONTINUE
        IF indent = "" THEN
            parts.Add(JsJsonQuote(key) + ":" + item)
        ELSE
            parts.Add(JsJsonQuote(key) + ": " + item)
        END IF
    NEXT
    IF parts.Count = 0 THEN RETURN "{}"
    IF indent = "" THEN RETURN "{" + parts.Join(",") + "}"
    RETURN "{" + Chr(10) + inner + parts.Join(sep) + Chr(10) + cur + "}"
END FUNCTION

SUB JsJsonFail ()
    VAR what AS String
    IF jsonAt >= jsonSrc.Length THEN
        what = "Unexpected end of JSON input"
    ELSE
        what = "Unexpected token " + jsonSrc.CharAt(jsonAt) + " in JSON at position " + Str(jsonAt)
    END IF
    jsThrown = JsMakeTypedError("SyntaxError", what)
    THROW Str(jsLine) + "|@thrown"
END SUB

SUB JsJsonSpace ()
    WHILE jsonAt < jsonSrc.Length
        IF NOT (" " + Chr(9) + Chr(10) + Chr(13)).Contains(jsonSrc.CharAt(jsonAt)) THEN RETURN
        jsonAt = jsonAt + 1
    END WHILE
END SUB

FUNCTION JsJsonValue () AS String
    VAR c AS String
    VAR id AS Integer
    VAR items AS Array OF String
    VAR key AS String
    VAR start AS Integer
    JsJsonSpace()
    IF jsonAt >= jsonSrc.Length THEN JsJsonFail()
    c = jsonSrc.CharAt(jsonAt)
    IF c = "{" THEN
        jsonAt = jsonAt + 1
        id = JsNewObject("Object", jsObjectProto)
        JsJsonSpace()
        IF jsonAt < jsonSrc.Length AND jsonSrc.CharAt(jsonAt) = "}" THEN
            jsonAt = jsonAt + 1
            RETURN JsO(id)
        END IF
        WHILE TRUE
            JsJsonSpace()
            IF jsonAt >= jsonSrc.Length OR jsonSrc.CharAt(jsonAt) <> """" THEN JsJsonFail()
            key = JsJsonString()
            JsJsonSpace()
            IF jsonAt >= jsonSrc.Length OR jsonSrc.CharAt(jsonAt) <> ":" THEN JsJsonFail()
            jsonAt = jsonAt + 1
            JsPut(JsO(id), key, JsJsonValue())
            JsJsonSpace()
            IF jsonAt < jsonSrc.Length AND jsonSrc.CharAt(jsonAt) = "," THEN
                jsonAt = jsonAt + 1
            ELSEIF jsonAt < jsonSrc.Length AND jsonSrc.CharAt(jsonAt) = "}" THEN
                jsonAt = jsonAt + 1
                RETURN JsO(id)
            ELSE
                JsJsonFail()
            END IF
        END WHILE
    END IF
    IF c = "[" THEN
        jsonAt = jsonAt + 1
        JsJsonSpace()
        IF jsonAt < jsonSrc.Length AND jsonSrc.CharAt(jsonAt) = "]" THEN
            jsonAt = jsonAt + 1
            RETURN JsO(JsNewArray(items))
        END IF
        WHILE TRUE
            items.Add(JsJsonValue())
            JsJsonSpace()
            IF jsonAt < jsonSrc.Length AND jsonSrc.CharAt(jsonAt) = "," THEN
                jsonAt = jsonAt + 1
            ELSEIF jsonAt < jsonSrc.Length AND jsonSrc.CharAt(jsonAt) = "]" THEN
                jsonAt = jsonAt + 1
                RETURN JsO(JsNewArray(items))
            ELSE
                JsJsonFail()
            END IF
        END WHILE
    END IF
    IF c = """" THEN RETURN JsS(JsJsonString())
    IF jsonSrc.Substring(jsonAt, MATH.Min(4, jsonSrc.Length - jsonAt)) = "true" THEN
        jsonAt = jsonAt + 4
        RETURN "t"
    END IF
    IF jsonSrc.Substring(jsonAt, MATH.Min(5, jsonSrc.Length - jsonAt)) = "false" THEN
        jsonAt = jsonAt + 5
        RETURN "f"
    END IF
    IF jsonSrc.Substring(jsonAt, MATH.Min(4, jsonSrc.Length - jsonAt)) = "null" THEN
        jsonAt = jsonAt + 4
        RETURN "l"
    END IF
    IF "-0123456789".Contains(c) THEN
        start = jsonAt
        jsonAt = jsonAt + 1
        WHILE jsonAt < jsonSrc.Length AND "0123456789.eE+-".Contains(jsonSrc.CharAt(jsonAt))
            jsonAt = jsonAt + 1
        END WHILE
        RETURN "n" + JsNum(JsS(jsonSrc.Substring(start, jsonAt - start)))
    END IF
    JsJsonFail()
    RETURN "u"
END FUNCTION

' A JSON string at jsonAt (the opening quote), unescaped.
FUNCTION JsJsonString () AS String
    VAR out AS String
    VAR c AS String
    VAR e AS String
    jsonAt = jsonAt + 1
    WHILE jsonAt < jsonSrc.Length
        c = jsonSrc.CharAt(jsonAt)
        IF c = """" THEN
            jsonAt = jsonAt + 1
            RETURN out
        END IF
        IF c = "\" THEN
            jsonAt = jsonAt + 1
            IF jsonAt >= jsonSrc.Length THEN JsJsonFail()
            e = jsonSrc.CharAt(jsonAt)
            SELECT CASE e
                CASE "n"
                    out = out + Chr(10)
                CASE "t"
                    out = out + Chr(9)
                CASE "r"
                    out = out + Chr(13)
                CASE "b"
                    out = out + Chr(8)
                CASE "f"
                    out = out + Chr(12)
                CASE "u"
                    IF jsonAt + 4 >= jsonSrc.Length THEN JsJsonFail()
                    out = out + Chr(Int(Val(JsNumberText("0x" + jsonSrc.Substring(jsonAt + 1, 4)))))
                    jsonAt = jsonAt + 4
                CASE ELSE
                    out = out + e
            END SELECT
        ELSE
            out = out + c
        END IF
        jsonAt = jsonAt + 1
    END WHILE
    JsJsonFail()
    RETURN out
END FUNCTION

' ---- promise jobs: with jsDefer on (Node), then-callbacks wait until the
' running code is done, as JavaScript says; JsDrainJobs runs them.

VAR jsDefer AS Bool
VAR jqP AS Array OF Integer
VAR jqOk AS Array OF String
VAR jqErr AS Array OF String
VAR jqChild AS Array OF Integer

SUB JsQueueThen (p AS Integer, onOk AS String, onErr AS String, child AS Integer)
    IF NOT jsDefer THEN
        JsRunThen(p, onOk, onErr, child)
        RETURN
    END IF
    jqP.Add(p)
    jqOk.Add(onOk)
    jqErr.Add(onErr)
    jqChild.Add(child)
END SUB

SUB JsDrainJobs ()
    VAR p AS Integer
    VAR ok AS String
    VAR er AS String
    VAR c AS Integer
    WHILE jqP.Count > 0
        p = jqP[0]
        ok = jqOk[0]
        er = jqErr[0]
        c = jqChild[0]
        jqP.RemoveAt(0)
        jqOk.RemoveAt(0)
        jqErr.RemoveAt(0)
        jqChild.RemoveAt(0)
        jsSig = ""
        jsDepth = 0
        JsRunThen(p, ok, er, c)
    END WHILE
END SUB

' ---------------------------------------------------------------- a fresh page

SUB JsReset ()
    VAR kind AS String
    VAR mathObj AS Integer
    VAR o AS Integer
    VAR f AS Integer
    VAR none AS Array OF String
    jtType.Clear()
    jtText.Clear()
    jtLine.Clear()
    jtNl.Clear()
    nk.Clear()
    na.Clear()
    nb.Clear()
    nc.Clear()
    nd.Clear()
    ns.Clear()
    nl.Clear()
    nline.Clear()
    jpVal.Clear()
    jpFree.Clear()
    joIdx.Clear()
    joClass.Clear()
    joProto.Clear()
    joA.Clear()
    joB.Clear()
    joS.Clear()
    joKeys.Clear()
    jsHostCache.Clear()
    f = JsNode("none", 0, 0, 0, 0, "", "", 0)
    o = JsNewObject("Nothing", 0)
    jsOut = ""
    jsSig = ""
    jsRet = "u"
    jsDepth = 0
    jsSteps = 0
    jsLimit = JSSTEPLIMIT
    jsThrown = ""
    jsLineBase = 1

    jsObjectProto = JsNewObject("Object", 0)
    JsMethods(jsObjectProto, "Object.", "toString,hasOwnProperty")
    jsFunctionProto = JsNewObject("Object", jsObjectProto)
    JsMethods(jsFunctionProto, "Function.", "call,apply,bind")
    jsArrayProto = JsNewObject("Object", jsObjectProto)
    JsMethods(jsArrayProto, "Array.", "join,toString,push,pop,shift,unshift,reverse,concat,slice,splice,indexOf,sort,forEach,map,filter,reduce,reduceRight,some,every,find,findIndex,includes,lastIndexOf,fill")
    jsStringProto = JsNewObject("Object", jsObjectProto)
    JsMethods(jsStringProto, "String.", "charAt,charCodeAt,indexOf,lastIndexOf,substring,substr,slice,toUpperCase,toLowerCase,toLocaleUpperCase,toLocaleLowerCase,trim,split,concat,toString,valueOf,bold,italics,fixed,big,small,blink,strike,sub,sup,fontcolor,fontsize,anchor,link,replace,replaceAll,startsWith,endsWith,includes,repeat,padStart,padEnd,trimStart,trimEnd,trimLeft,trimRight")
    jsNumberProto = JsNewObject("Object", jsObjectProto)
    JsMethods(jsNumberProto, "Number.", "toString,toFixed")
    jsDateProto = JsNewObject("Object", jsObjectProto)
    JsMethods(jsDateProto, "Date.", "getTime,valueOf,getFullYear,getYear,getMonth,getDate,getDay,getHours,getMinutes,getSeconds,getMilliseconds,getTimezoneOffset,toString,toLocaleString,toGMTString,toUTCString,setTime,setFullYear,setYear,setMonth,setDate,setHours,setMinutes,setSeconds,setMilliseconds")

    ' window, which is also the global scope
    jsGlobal = JsNewObject("Global", jsObjectProto)
    JsPutOwn(jsGlobal, "window", JsO(jsGlobal))
    JsPutOwn(jsGlobal, "self", JsO(jsGlobal))
    JsPutOwn(jsGlobal, "top", JsO(jsGlobal))
    JsPutOwn(jsGlobal, "parent", JsO(jsGlobal))
    JsPutOwn(jsGlobal, "NaN", "nNaN")
    JsPutOwn(jsGlobal, "Infinity", "nInfinity")
    JsMethods(jsGlobal, "", "alert,confirm,prompt,parseInt,parseFloat,isNaN,isFinite,escape,unescape,encodeURIComponent,decodeURIComponent,encodeURI,decodeURI,setTimeout,setInterval,clearTimeout,clearInterval,open,String,Number,Boolean,Array,Object,Date,Error,TypeError,RangeError,SyntaxError,ReferenceError,Promise")
    JsPutOwn(jsGlobal, "eval", JsNative("eval"))
    JsPutOwn(jsGlobal, "close", JsNative("noop"))
    JsPutOwn(jsGlobal, "focus", JsNative("noop"))
    JsPutOwn(jsGlobal, "blur", JsNative("noop"))
    JsPutOwn(jsGlobal, "scroll", JsNative("noop"))
    JsPutOwn(JsId(JsGetProp(jsGlobal, "String")), "fromCharCode", JsNative("String.fromCharCode"))
    JsPutOwn(JsId(JsGetProp(jsGlobal, "String")), "prototype", JsO(jsStringProto))
    JsPutOwn(JsId(JsGetProp(jsGlobal, "Number")), "prototype", JsO(jsNumberProto))
    JsPutOwn(JsId(JsGetProp(jsGlobal, "Array")), "prototype", JsO(jsArrayProto))
    JsPutOwn(JsId(JsGetProp(jsGlobal, "Object")), "prototype", JsO(jsObjectProto))
    JsPutOwn(JsId(JsGetProp(jsGlobal, "Date")), "prototype", JsO(jsDateProto))
    JsMethods(JsId(JsGetProp(jsGlobal, "Object")), "ObjectS.", "keys,values,entries,assign,create,getPrototypeOf,setPrototypeOf,freeze,seal,preventExtensions,defineProperty,getOwnPropertyNames,is")
    JsMethods(JsId(JsGetProp(jsGlobal, "Array")), "ArrayS.", "isArray,from,of")
    JsMethods(JsId(JsGetProp(jsGlobal, "Number")), "NumberS.", "isInteger,isFinite,isNaN")
    JsMethods(JsId(JsGetProp(jsGlobal, "Date")), "DateS.", "now")
    JsPutOwn(JsId(JsGetProp(jsGlobal, "Number")), "parseInt", JsNative("parseInt"))
    JsPutOwn(JsId(JsGetProp(jsGlobal, "Number")), "parseFloat", JsNative("parseFloat"))
    JsPutOwn(JsId(JsGetProp(jsGlobal, "Number")), "MAX_SAFE_INTEGER", JsN(9007199254740991))
    o = JsNewObject("Object", jsObjectProto)
    JsMethods(o, "JSON.", "parse,stringify")
    JsPutOwn(jsGlobal, "JSON", JsO(o))
    ' the errors: Error.prototype, and its kinds made from it
    o = JsNewObject("Object", jsObjectProto)
    JsPutOwn(o, "name", JsS("Error"))
    JsPutOwn(o, "message", JsS(""))
    JsPutOwn(o, "constructor", JsGetProp(jsGlobal, "Error"))
    JsPutOwn(JsId(JsGetProp(jsGlobal, "Error")), "prototype", JsO(o))
    jsErrorProto = o
    FOR EACH kind IN ["TypeError", "RangeError", "SyntaxError", "ReferenceError"]
        o = JsNewObject("Object", jsErrorProto)
        JsPutOwn(o, "name", JsS(kind))
        JsPutOwn(JsId(JsGetProp(jsGlobal, kind)), "prototype", JsO(o))
    NEXT

    mathObj = JsNewObject("Object", jsObjectProto)
    JsMethods(mathObj, "Math.", "abs,floor,ceil,round,random,max,min,sqrt,pow,sin,cos,tan,atan,exp,log")
    JsPutOwn(mathObj, "PI", JsN(MATH.Pi))
    JsPutOwn(mathObj, "E", JsN(MATH.Exp(1)))
    JsPutOwn(mathObj, "LN2", JsN(MATH.Log(2)))
    JsPutOwn(mathObj, "LN10", JsN(MATH.Log(10)))
    JsPutOwn(mathObj, "SQRT2", JsN(MATH.Sqrt(2)))
    JsPutOwn(jsGlobal, "Math", JsO(mathObj))

    jsDocument = JsNewObject("Document", jsObjectProto)
    JsMethods(jsDocument, "document.", "write,writeln,getElementById")
    JsPutOwn(jsDocument, "open", JsNative("noop"))
    JsPutOwn(jsDocument, "close", JsNative("noop"))
    jsFormsArray = JsNewArray(none)
    JsPutOwn(jsDocument, "forms", JsO(jsFormsArray))
    JsPutOwn(jsDocument, "images", JsO(JsNewArray(none)))
    JsPutOwn(jsDocument, "links", JsO(JsNewArray(none)))
    JsPutOwn(jsDocument, "bgColor", JsS("#FFFFFF"))
    JsPutOwn(jsDocument, "fgColor", JsS("#000000"))
    JsPutOwn(jsDocument, "all", JsO(JsNewObject("All", jsObjectProto)))
    JsPutOwn(jsGlobal, "document", JsO(jsDocument))

    ' XMLHttpRequest, IE's ActiveXObject for it, and fetch
    jsXhrProto = JsNewObject("Object", jsObjectProto)
    JsMethods(jsXhrProto, "XHR.", "open,setRequestHeader,send,abort,getResponseHeader,getAllResponseHeaders")
    jsPromiseProto = JsNewObject("Object", jsObjectProto)
    JsMethods(jsPromiseProto, "Promise.", "then,catch")
    JsPutOwn(JsId(JsGetProp(jsGlobal, "Promise")), "prototype", JsO(jsPromiseProto))
    JsMethods(JsId(JsGetProp(jsGlobal, "Promise")), "PromiseS.", "resolve,reject,all,race")
    jqP.Clear()
    jqOk.Clear()
    jqErr.Clear()
    jqChild.Clear()
    JsMethods(jsGlobal, "", "XMLHttpRequest,ActiveXObject,fetch")

    jsLocation = JsNewObject("Location", jsObjectProto)
    JsPutOwn(jsDocument, "location", JsO(jsLocation))

    o = JsNewObject("Object", jsObjectProto)
    JsMethods(o, "history.", "back,forward,go")
    JsPutOwn(o, "length", JsN(HostHistory(0)))
    JsPutOwn(jsGlobal, "history", JsO(o))

    o = JsNewObject("Object", jsObjectProto)
    JsPutOwn(o, "appName", JsS("Simxplorer"))
    JsPutOwn(o, "appCodeName", JsS("Mozilla"))
    JsPutOwn(o, "appVersion", JsS("2.0 (compatible; Simxplorer 3.02; SIM95)"))
    JsPutOwn(o, "userAgent", JsS("Mozilla/2.0 (compatible; Simxplorer 3.02; SIM95)"))
    JsPutOwn(o, "platform", JsS("SIM95"))
    JsPutOwn(o, "javaEnabled", JsNative("navigator.javaEnabled"))
    JsPutOwn(jsGlobal, "navigator", JsO(o))

    o = JsNewObject("Object", jsObjectProto)
    JsPutOwn(o, "width", "n640")
    JsPutOwn(o, "height", "n480")
    JsPutOwn(o, "colorDepth", "n4")
    JsPutOwn(jsGlobal, "screen", JsO(o))
END SUB

' Runs a script on the page. Returns "" or "line|message".
FUNCTION JsRun (source AS String, firstLine AS Integer) AS String
    VAR prog AS Integer
    jsSig = ""
    jsDepth = 0
    jsSteps = 0
    jsLimit = JSSTEPLIMIT
    jsThrown = ""
    jsRet = "u"
    jsLineBase = firstLine
    TRY
        prog = JsParse(source)
        JsHoist(prog, jsGlobal)
        JsExec(prog, jsGlobal)
    CATCH err
        RETURN JsTidyError(err)
    END TRY
    jsSig = ""
    RETURN ""
END FUNCTION

' Runs an event handler (onclick="..."): like a function body, so "return
' false" works. The value it returned is in jsRet.
FUNCTION JsHandler (code AS String) AS String
    RETURN JsRun(code, 1)
END FUNCTION

' An event handler on an element: a function body whose this is the element
' (thisVal), so onclick="check(this.form)" works. Its vars are its own.
FUNCTION JsHandlerOn (code AS String, thisVal AS String) AS String
    VAR prog AS Integer
    VAR scope AS Integer
    jsSig = ""
    jsDepth = 0
    jsSteps = 0
    jsLimit = JSSTEPLIMIT
    jsThrown = ""
    jsRet = "u"
    jsLineBase = 1
    TRY
        prog = JsParse(code)
        scope = JsNewScope(jsGlobal, thisVal)
        JsHoist(prog, scope)
        JsExec(prog, scope)
    CATCH err
        RETURN JsTidyError(err)
    END TRY
    jsSig = ""
    RETURN ""
END FUNCTION

' Calls a function value (for setTimeout(f, ms)). Returns "" or an error.
FUNCTION JsCallValue (fn AS String) AS String
    VAR none AS Array OF String
    jsSig = ""
    jsDepth = 0
    jsSteps = 0
    jsLimit = JSSTEPLIMIT
    jsThrown = ""
    TRY
        jsRet = JsCall(fn, JsO(jsGlobal), none)
    CATCH err
        RETURN JsTidyError(err)
    END TRY
    RETURN ""
END FUNCTION

FUNCTION JsTidyError (err AS String) AS String
    VAR thrown AS String
    jsSig = ""
    jsDepth = 0
    thrown = jsThrown
    jsThrown = ""
    IF err.Contains("@thrown") THEN
        IF thrown.StartsWith("o") THEN RETURN err.Substring(0, err.IndexOf("|")) + "|Exception thrown and not caught: " + JsStr(JsGet(thrown, "message"))
        RETURN err.Substring(0, err.IndexOf("|")) + "|Exception thrown and not caught: " + JsStr(thrown)
    END IF
    IF err.Contains("@aborted") THEN RETURN Str(jsLine) + "|@aborted"
    IF err.Contains("Stack overflow") THEN RETURN Str(jsLine) + "|Out of stack space"
    IF err.Contains("|") AND OnlyChars(err.Substring(0, err.IndexOf("|")), "0123456789") AND err.IndexOf("|") > 0 THEN RETURN err
    RETURN Str(jsLine) + "|" + err
END FUNCTION
