' VAPOR|id=SIMSTATS|name=SimStats|kind=web|version=b9240bbb|category=Internet|run=/|files=C:\WEB\ADDSITE.ASP;C:\WEB\ADMIN.ASP;C:\WEB\BADGE.PIC;C:\WEB\CODE.ASP;C:\WEB\DASH.ASP;C:\WEB\EDIT.ASP;C:\WEB\HIT.ASP;C:\WEB\INDEX.ASP;C:\WEB\JOIN.ASP;C:\WEB\LIVE.ASP;C:\WEB\LOGIN.ASP;C:\WEB\LOGOUT.ASP;C:\WEB\OPTOUT.ASP;C:\WEB\PRIVACY.HTM;C:\WEB\PUBLIC.ASP;C:\WEB\SIMSTATS.HTM;C:\WEB\STATS.SPK;C:\WEB\TRACK.SPK|tasks=|startup=|folder=STATS|about=Free web statistics for any site on the network: hits, unique visitors, top pages, referrers, browsers, live traffic and LED hit counters. Becomes this machine's home page, or on a SimHost machine gets a folder of its own.
' INSTALL.SPK - puts SimStats on this machine. Generated by tools/build-installer.mjs;
' edit the files in simstats/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. SimStats becomes
' this machine's home page: its pages go into C:\WEB (the stock INDEX.HTM moves
' to WELCOME.HTM). On a SimHost machine it goes in C:\WEB\STATS instead, and
' the front page counts its own visitors with it. Accounts and statistics are
' kept in C:\STATDATA, which is left alone, so running it again upgrades
' SimStats without losing a hit. It also adds a line to C:\WEB\ROBOTS.TXT so
' AskSim's crawler leaves the tracking tag alone. Then open http://YOURNAME/
' in Voyager.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)
    ' On a machine set up for several web apps (SimHost: C:\SYSTEM\WEBAPPS.INI
    ' says mode=folders), this one goes in C:\WEB\STATS and leaves the home page alone.
    IF FS.Exists("C:\SYSTEM\WEBAPPS.INI") THEN
        IF FS.Read("C:\SYSTEM\WEBAPPS.INI").Contains("mode=folders") THEN intoDir = "STATS"
    END IF
    IF intoDir <> "" AND NOT FS.Exists("C:\WEB\" + intoDir) THEN FS.MakeDir("C:\WEB\" + intoDir)


    IF intoDir = "" THEN MoveHomePage()
    StatsSetup()
    File0()
    File1()
    File2()
    File3()
    File4()
    File5()
    File6()
    File7()
    File8()
    File9()
    File10()
    File11()
    File12()
    File13()
    File14()
    File15()
    File16()
    File17()
    Print("SimStats is installed (18 files).")

    ' how it shows on the SimHost front page, which lists every folder with one of these
    IF intoDir <> "" THEN FS.Write("C:\WEB\" + intoDir + "\APP.INF", "SimStats|Web statistics for any site: hits, visitors, top pages, referrers and a hit counter.|#003366")
    IF intoDir = "" THEN
        Print("Open http://" + NET.HostName.Lower() + "/ in Voyager.")
    ELSE
        Print("Open http://" + NET.HostName.Lower() + "/" + intoDir.Lower() + "/ in Voyager.")
    END IF
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "<%@ import file=""TRACK.SPK"" %>" + NL
    t = t + "<%@ import file=""STATS.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' ADDSITE.ASP - a new site to count (POST name, url, t). It gets an id of 8" + NL
    t = t + "' hex digits, and the next stop is the code to paste into its pages." + NL
    t = t + "VAR problem AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "RequireToken()" + NL
    t = t + "problem = AddSite(viewer, REQUEST.Form(""name""), REQUEST.Form(""url""))" + NL
    t = t + "IF problem <> """" THEN RESPONSE.Redirect(""index.asp?e=site&why="" + UrlEnc(problem))" + NL
    t = t + "RESPONSE.Redirect(""code.asp?s="" + lastSite + ""&new=1"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\ADDSITE.ASP")
END SUB

SUB File1 ()
    t = ""
    t = t + "<%@ import file=""TRACK.SPK"" %>" + NL
    t = t + "<%@ import file=""STATS.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' ADMIN.ASP - the overview, for whoever runs this machine: the user name and" + NL
    t = t + "' password in C:\SYSTEM\USERS.INI, asked for on every visit (so another site" + NL
    t = t + "' can't do anything here: it doesn't know them). Every site SimStats counts," + NL
    t = t + "' whose it is, and its totals. That includes ""this machine"", the site the" + NL
    t = t + "' installer made for the SimHost front page, which belongs to nobody: the" + NL
    t = t + "' owner can hand it (or any site nobody has) to an account." + NL
    t = t + "VAR owner AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR allowed AS Bool" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR id AS String" + NL
    t = t + "VAR who AS String" + NL
    t = t + "VAR home AS String" + NL
    t = t + "VAR all AS Array OF String" + NL
    t = t + "VAR today AS Integer" + NL
    t = t + "VAR week AS Integer" + NL
    t = t + "VAR month AS Integer" + NL
    t = t + "VAR ever AS Integer" + NL
    t = t + "VAR sumToday AS Integer" + NL
    t = t + "VAR sumWeek AS Integer" + NL
    t = t + "VAR sumMonth AS Integer" + NL
    t = t + "VAR sumEver AS Integer" + NL
    t = t + "VAR people AS Integer" + NL
    t = t + "VAR f AS String" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "owner = REQUEST.Form(""owner"").Trim()" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    IF NOT IsOwner(owner, REQUEST.Form(""opw"")) THEN" + NL
    t = t + "        problem = ""That is not this machine's owner (the name and password in C:\SYSTEM\USERS.INI). Nothing was shown.""" + NL
    t = t + "    ELSE" + NL
    t = t + "        allowed = TRUE" + NL
    t = t + "        IF REQUEST.Form(""do"") = ""give"" THEN" + NL
    t = t + "            line = SiteLine(REQUEST.Form(""s"").Trim().Upper())" + NL
    t = t + "            who = CleanName(REQUEST.Form(""to""))" + NL
    t = t + "            IF line = """" OR SF(line, 1) <> """" THEN" + NL
    t = t + "                problem = ""Only a site that belongs to nobody can be handed over.""" + NL
    t = t + "            ELSEIF NOT UserExists(who) THEN" + NL
    t = t + "                problem = ""There is no account called "" + REQUEST.Form(""to"") + "".""" + NL
    t = t + "            ELSE" + NL
    t = t + "                SetSiteField(SF(line, 0), 1, who)" + NL
    t = t + "                problem = SF(line, 2) + "" now belongs to "" + who + "".""" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "END IF" + NL
    t = t + "IF allowed THEN" + NL
    t = t + "    all = AllSites()" + NL
    t = t + "    home = ReadOr(DATADIR + ""\HOME.TXT"", """").Trim()" + NL
    t = t + "    IF FS.Exists(DATADIR + ""\USERS"") THEN" + NL
    t = t + "        FOR EACH f IN FS.List(DATADIR + ""\USERS"")" + NL
    t = t + "            IF NOT f.EndsWith(""\"") THEN people = people + 1" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "END IF" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Machine Owner"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<% IF NOT allowed THEN %>" + NL
    t = t + "<%= BoxTop(""Machine Owner: All Sites"") %>" + NL
    t = t + "<p><font size=""2"">Every site this SimStats counts, and their totals, for whoever runs this machine. Sign in" + NL
    t = t + "here with the machine's own user name and password (the ones in C:\SYSTEM\USERS.INI).</font></p>" + NL
    t = t + "<form action=""admin.asp"" method=""post"">" + NL
    t = t + "<table cellpadding=""3""><tr><td><font size=""2"">Owner:</font></td><td><input name=""owner"" size=""16"" value=""<%= H(owner) %>""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Password:</font></td><td><input type=""password"" name=""opw"" size=""16""></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Show me""></td></tr></table>" + NL
    t = t + "</form>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<%= BoxTop(""All Sites on "" + H(SERVER.Name)) %>" + NL
    t = t + "<p><font size=""2""><%= Plural(all.Count, ""site"", ""sites"") %>, <%= Plural(people, ""account"", ""accounts"") %>.</font></p>" + NL
    t = t + "<table width=""100%"" cellpadding=""3"" cellspacing=""0"">" + NL
    t = t + "<tr bgcolor=""#E8F0F8""><td><font size=""2""><b>Site</b></font></td><td><font size=""2""><b>Whose</b></font></td><td align=""right""><font size=""2""><b>Today</b></font></td><td align=""right""><font size=""2""><b>7 days</b></font></td><td align=""right""><font size=""2""><b>30 days</b></font></td><td align=""right""><font size=""2""><b>All time</b></font></td></tr>" + NL
    t = t + "<% FOR EACH line IN all" + NL
    t = t + "    id = SF(line, 0)" + NL
    t = t + "    today = HitsIn(id, 1)" + NL
    t = t + "    week = HitsIn(id, 7)" + NL
    t = t + "    month = HitsIn(id, 30)" + NL
    t = t + "    ever = TotalHits(id)" + NL
    t = t + "    sumToday = sumToday + today" + NL
    t = t + "    sumWeek = sumWeek + week" + NL
    t = t + "    sumMonth = sumMonth + month" + NL
    t = t + "    sumEver = sumEver + ever %>" + NL
    t = t + "<tr><td><font size=""2""><b><%= H(SF(line, 2)) %></b> <tt><%= id %></tt><br><font size=""1""><%= H(SF(line, 3)) %><% IF SF(line, 4) = ""1"" THEN %> (public)<% END IF %><% IF SF(line, 6) <> ""1"" THEN %> (paused)<% END IF %></font></font></td>" + NL
    t = t + "<td><font size=""2""><% IF SF(line, 1) = """" THEN %><i>nobody</i><% IF id = home THEN %> (this machine)<% END IF %><% ELSE %><%= H(SF(line, 1)) %><% END IF %></font></td>" + NL
    t = t + "<td align=""right""><font size=""2""><%= Commas(today) %></font></td><td align=""right""><font size=""2""><%= Commas(week) %></font></td><td align=""right""><font size=""2""><%= Commas(month) %></font></td><td align=""right""><font size=""2""><%= Commas(ever) %></font></td></tr>" + NL
    t = t + "<% NEXT %>" + NL
    t = t + "<tr bgcolor=""#E8F0F8""><td colspan=""2""><font size=""2""><b>Total</b></font></td><td align=""right""><font size=""2""><b><%= Commas(sumToday) %></b></font></td><td align=""right""><font size=""2""><b><%= Commas(sumWeek) %></b></font></td><td align=""right""><font size=""2""><b><%= Commas(sumMonth) %></b></font></td><td align=""right""><font size=""2""><b><%= Commas(sumEver) %></b></font></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "<br>" + NL
    t = t + "<%= BoxTop(""Hand a Site to an Account"") %>" + NL
    t = t + "<form action=""admin.asp"" method=""post""><input type=""hidden"" name=""owner"" value=""<%= H(owner) %>""><input type=""hidden"" name=""do"" value=""give"">" + NL
    t = t + "<p><font size=""2"">A site that belongs to nobody (like this machine's own) can be given to an account, which then sees its full statistics.<br>" + NL
    t = t + "Site id: <input name=""s"" size=""10""> to user name: <input name=""to"" size=""10"">" + NL
    t = t + "Your password again: <input type=""password"" name=""opw"" size=""10""> <input type=""submit"" value=""Hand it over""></font></p>" + NL
    t = t + "</form>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\ADMIN.ASP")
END SUB

