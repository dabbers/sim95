SUB File3 ()
    t = ""
    t = t + "<%@ import file=""TRACK.SPK"" %>" + NL
    t = t + "<%@ import file=""STATS.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' CODE.ASP?s=ID[&page=/path] - the HTML to paste into a site's pages: the" + NL
    t = t + "' plain tag (every browser), the JavaScript one (Simxplorer, which also tells" + NL
    t = t + "' us the page's title and where the visitor came from), and the counter." + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR id AS String" + NL
    t = t + "VAR page AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "line = MySite(REQUEST.Query(""s""))" + NL
    t = t + "id = SF(line, 0)" + NL
    t = t + "page = Clip(REQUEST.Query(""page""), 120)" + NL
    t = t + "IF page = """" THEN page = ""/""" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Get the Code"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<% IF REQUEST.Query(""new"") <> """" THEN %>" + NL
    t = t + "<%= Notice(""Your site is set up! Its SimStats id is "" + id + "". Now paste one of these into every page you want counted."") %>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<h2><%= H(SF(line, 2)) %> <font size=""2"">(<%= H(SF(line, 3)) %>, id <tt><%= id %></tt>)</font></h2>" + NL
    t = t + "<p><font size=""2""><a href=""dash.asp?s=<%= id %>"">See the stats</a> | <a href=""edit.asp?s=<%= id %>"">Settings</a></font></p>" + NL
    t = t + "" + NL
    t = t + "<form action=""code.asp"" method=""get""><input type=""hidden"" name=""s"" value=""<%= id %>"">" + NL
    t = t + "<font size=""2"">The page the code goes on: <input name=""page"" size=""30"" value=""<%= H(page) %>""> <input type=""submit"" value=""Make the code""></font>" + NL
    t = t + "<br><font size=""1"" color=""#808080"">Like /index.htm or /area95/1001/. Voyager doesn't tell anybody which page it is on, so the plain tag says it itself. Make a tag for each page.</font>" + NL
    t = t + "</form>" + NL
    t = t + "" + NL
    t = t + "<%= BoxTop(""1. The plain tag - works in every browser"") %>" + NL
    t = t + "<p><font size=""2"">An invisible picture, one pixel big. Put it anywhere between <tt>&lt;body&gt;</tt> and <tt>&lt;/body&gt;</tt>." + NL
    t = t + "It works in Voyager and Simxplorer, and on GeoSimies homepages.</font></p>" + NL
    t = t + "<textarea name=""plain"" rows=""3"" cols=""72""><%= H(PlainTag(id, page)) %></textarea>" + NL
    t = t + "" + NL
    t = t + "<%= BoxTop(""2. The JavaScript tag - for Simxplorer, with titles and referrers"") %>" + NL
    t = t + "<p><font size=""2"">Simxplorer runs the script, which tells SimStats the page's address and title and the page the visitor came from." + NL
    t = t + "Voyager skips JavaScript and uses the plain tag inside <tt>&lt;noscript&gt;</tt>, so everybody is counted exactly once.</font></p>" + NL
    t = t + "<textarea name=""script"" rows=""8"" cols=""72""><%= H(ScriptTag(id, page)) %></textarea>" + NL
    t = t + "" + NL
    t = t + "<%= BoxTop(""3. The hit counter - show the world how popular you are"") %>" + NL
    t = t + "<p><font size=""2"">Counts like the plain tag, and shows your total in glowing LED digits:</font>" + NL
    t = t + "<a href=""dash.asp?s=<%= id %>""><img src=""hit.asp?s=<%= id %>&b=1&n=1"" width=""88"" height=""31"" border=""0"" alt=""Your counter""></a></p>" + NL
    t = t + "<% IF SF(line, 4) = ""1"" THEN %>" + NL
    t = t + "<p><font size=""2"">Your stats are public, so the counter links to them.</font></p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<p><font size=""2"">It links to SimStats. Make your stats <a href=""edit.asp?s=<%= id %>"">public</a> and it links to them instead.</font></p>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<textarea name=""badge"" rows=""3"" cols=""72""><%= H(BadgeTag(line, page)) %></textarea>" + NL
    t = t + "<p><font size=""1"" color=""#808080"">Use one of the three on a page, not two: each one counts.</font></p>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\CODE.ASP")
END SUB

SUB File4 ()
    t = ""
    t = t + "<%@ import file=""TRACK.SPK"" %>" + NL
    t = t + "<%@ import file=""STATS.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' DASH.ASP?s=ID&r=1|7|30 - a site's statistics, for its owner: hits and" + NL
    t = t + "' visitors by day, hours, top pages, referrers, browsers, the machines" + NL
    t = t + "' visitors came from, and the last 20 hits (kept up to date by" + NL
    t = t + "' XMLHttpRequest in Simxplorer)." + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR id AS String" + NL
    t = t + "VAR days AS Integer" + NL
    t = t + "RequireLogin()" + NL
    t = t + "line = MySite(REQUEST.Query(""s""))" + NL
    t = t + "id = SF(line, 0)" + NL
    t = t + "days = RangeOf(REQUEST.Query(""r""))" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Stats for "" + SF(line, 2)) %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<table width=""100%"" cellpadding=""0"" cellspacing=""0""><tr><td><font size=""5""><b><%= H(SF(line, 2)) %></b></font>" + NL
    t = t + "<br><font size=""2""><a href=""<%= H(SF(line, 3)) %>""><%= H(SF(line, 3)) %></a></font></td>" + NL
    t = t + "<td align=""right"" valign=""bottom""><%= RangeBar(""dash.asp"", id, days) %><br><font size=""2""><a href=""code.asp?s=<%= id %>"">Get the code</a> | <a href=""edit.asp?s=<%= id %>"">Settings</a><% IF SF(line, 4) = ""1"" THEN %> | <a href=""public.asp?s=<%= id %>"">Public page</a><% END IF %></font></td></tr></table>" + NL
    t = t + "<% IF SF(line, 6) <> ""1"" THEN %><%= Notice(""Counting is paused for this site: visits are not being counted. Switch it back on in Settings."") %><% END IF %>" + NL
    t = t + "<br>" + NL
    t = t + "<%= Dashboard(line, days, FALSE) %>" + NL
    t = t + "<%= LiveBox(id, FALSE) %>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\DASH.ASP")
END SUB

SUB File5 ()
    t = ""
    t = t + "<%@ import file=""TRACK.SPK"" %>" + NL
    t = t + "<%@ import file=""STATS.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' EDIT.ASP?s=ID - a site's settings: its name and address, public stats (a" + NL
    t = t + "' page anybody may see, without visitors' addresses), counting on or paused," + NL
    t = t + "' and deleting it with all its numbers." + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR id AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR url AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "line = MySite(REQUEST.Query(""s"") + REQUEST.Form(""s""))" + NL
    t = t + "id = SF(line, 0)" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    RequireToken()" + NL
    t = t + "    IF REQUEST.Form(""do"") = ""delete"" THEN" + NL
    t = t + "        IF REQUEST.Form(""sure"") = """" THEN" + NL
    t = t + "            problem = ""Tick the box to say you're sure. Deleted statistics can't be brought back.""" + NL
    t = t + "        ELSE" + NL
    t = t + "            DeleteSite(id)" + NL
    t = t + "            RESPONSE.Redirect(""index.asp?e=gone"")" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSE" + NL
    t = t + "        url = CleanUrl(REQUEST.Form(""url""))" + NL
    t = t + "        IF Clip(REQUEST.Form(""name""), MAXNAME) = """" THEN" + NL
    t = t + "            problem = ""Give your site a name.""" + NL
    t = t + "        ELSEIF url = """" THEN" + NL
    t = t + "            problem = ""Type your site's address, like http://bravo/.""" + NL
    t = t + "        ELSE" + NL
    t = t + "            SetSiteField(id, 2, Clip(REQUEST.Form(""name""), MAXNAME))" + NL
    t = t + "            SetSiteField(id, 3, url)" + NL
    t = t + "            IF REQUEST.Form(""public"") = """" THEN" + NL
    t = t + "                SetSiteField(id, 4, ""0"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                SetSiteField(id, 4, ""1"")" + NL
    t = t + "            END IF" + NL
    t = t + "            IF REQUEST.Form(""on"") = """" THEN" + NL
    t = t + "                SetSiteField(id, 6, ""0"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                SetSiteField(id, 6, ""1"")" + NL
    t = t + "            END IF" + NL
    t = t + "            problem = ""Saved.""" + NL
    t = t + "        END IF" + NL
    t = t + "        line = SiteLine(id)" + NL
    t = t + "    END IF" + NL
    t = t + "END IF" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Settings"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<h2><%= H(SF(line, 2)) %> <font size=""2"">(id <tt><%= id %></tt>)</font></h2>" + NL
    t = t + "<p><font size=""2""><a href=""dash.asp?s=<%= id %>"">See the stats</a> | <a href=""code.asp?s=<%= id %>"">Get the code</a></font></p>" + NL
    t = t + "<%= BoxTop(""Settings"") %>" + NL
    t = t + "<form action=""edit.asp"" method=""post""><%= TokenField() %><input type=""hidden"" name=""s"" value=""<%= id %>"">" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td><font size=""2"">Name:</font></td><td><input name=""name"" size=""30"" maxlength=""<%= MAXNAME %>"" value=""<%= H(SF(line, 2)) %>""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Address:</font></td><td><input name=""url"" size=""30"" maxlength=""<%= MAXURL %>"" value=""<%= H(SF(line, 3)) %>""></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""checkbox"" name=""public"" value=""1""<% IF SF(line, 4) = ""1"" THEN %> checked<% END IF %>> <font size=""2"">Public stats: anybody can see them at" + NL
    t = t + "<a href=""public.asp?s=<%= id %>"">public.asp?s=<%= id %></a> (never your visitors' addresses)</font></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""checkbox"" name=""on"" value=""1""<% IF SF(line, 6) = ""1"" THEN %> checked<% END IF %>> <font size=""2"">Counting is on (untick to pause it)</font></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Save""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "</form>" + NL
    t = t + "<%= BoxTop(""Delete This Site"") %>" + NL
    t = t + "<form action=""edit.asp"" method=""post""><%= TokenField() %><input type=""hidden"" name=""s"" value=""<%= id %>""><input type=""hidden"" name=""do"" value=""delete"">" + NL
    t = t + "<p><font size=""2""><input type=""checkbox"" name=""sure"" value=""1""> I'm sure: delete <b><%= H(SF(line, 2)) %></b> and every number SimStats has for it." + NL
    t = t + "<input type=""submit"" value=""Delete""></font></p>" + NL
    t = t + "<p><font size=""1"" color=""#808080"">The tags on your pages keep showing their picture, but nothing is counted any more.</font></p>" + NL
    t = t + "</form>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\EDIT.ASP")
END SUB

SUB File6 ()
    t = ""
    t = t + "<%@ import file=""TRACK.SPK"" %><%" + NL
    t = t + "' HIT.ASP?s=ID&p=PATH&t=TITLE&r=REFERRER - the tracking tag. Any page on any" + NL
    t = t + "' machine shows it as a picture; showing it counts a hit for site ID. It" + NL
    t = t + "' always answers with a picture (one white pixel, or with b=1 the 88x31" + NL
    t = t + "' counter), even for a site it doesn't know, which it then doesn't count." + NL
    t = t + "' Nothing is counted for a visitor who opted out (optout.asp), for crawlers," + NL
    t = t + "' for a site that is switched off, or with n=1 (the preview on code.asp)." + NL
    t = t + "'" + NL
    t = t + "' Kept small and quick on purpose: it imports only TRACK.SPK, appends one raw" + NL
    t = t + "' line, and updates the day's rollup." + NL
    t = t + "VAR id AS String" + NL
    t = t + "VAR site AS String" + NL
    t = t + "VAR given AS String" + NL
    t = t + "VAR page AS String" + NL
    t = t + "VAR ref AS String" + NL
    t = t + "VAR here AS String" + NL
    t = t + "RESPONSE.Clear()" + NL
    t = t + "RESPONSE.ContentType = ""image/x-sim95pic""" + NL
    t = t + "id = REQUEST.Query(""s"").Trim().Upper()" + NL
    t = t + "site = SiteLine(id)" + NL
    t = t + "IF site <> """" AND SF(site, 6) = ""1"" AND REQUEST.Query(""n"") = """" AND REQUEST.Cookie(OUTCOOKIE) <> ""1"" AND NOT IsRobot(REQUEST.Header(""User-Agent"")) THEN" + NL
    t = t + "    page = REQUEST.Query(""p"")" + NL
    t = t + "    ref = REQUEST.Query(""r"")" + NL
    t = t + "    ' Voyager sends no Referer, and Simxplorer only with a page; when one" + NL
    t = t + "    ' comes, it is the page the picture is on" + NL
    t = t + "    IF page = """" THEN page = REQUEST.Header(""Referer"")" + NL
    t = t + "    given = RecordHit(id, TIME.Date, TIME.Clock, REQUEST.From, REQUEST.Cookie(VIDCOOKIE), REQUEST.Header(""User-Agent""), page, REQUEST.Query(""t""), ref)" + NL
    t = t + "    IF given <> """" THEN RESPONSE.SetCookie(VIDCOOKIE, given)" + NL
    t = t + "END IF" + NL
    t = t + "IF REQUEST.Query(""b"") <> """" THEN" + NL
    t = t + "    ' the counter's picture is next to this page" + NL
    t = t + "    here = SERVER.ScriptName" + NL
    t = t + "    here = here.Substring(0, here.Length - here.Split(""\"")[here.Split(""\"").Count - 1].Length)" + NL
    t = t + "    IF site <> """" THEN" + NL
    t = t + "        RESPONSE.Write(Badge(ReadOr(here + ""BADGE.PIC"", """"), TotalHits(id)))" + NL
    t = t + "    ELSE" + NL
    t = t + "        RESPONSE.Write(Badge(ReadOr(here + ""BADGE.PIC"", """"), 0))" + NL
    t = t + "    END IF" + NL
    t = t + "ELSE" + NL
    t = t + "    RESPONSE.Write(Dot())" + NL
    t = t + "END IF" + NL
    t = t + "RESPONSE.End()" + NL
    t = t + "%>" + NL
    Put("C:\WEB\HIT.ASP")
END SUB

SUB File7 ()
    t = ""
    t = t + "<%@ import file=""TRACK.SPK"" %>" + NL
    t = t + "<%@ import file=""STATS.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' INDEX.ASP - the front door: what SimStats is, and the way in. Signed in, it" + NL
    t = t + "' is My Sites: every site you count, with today's hits, and a form to add one." + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR mine AS Array OF String" + NL
    t = t + "VAR id AS String" + NL
    t = t + "indexable = TRUE" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "SELECT CASE REQUEST.Query(""e"")" + NL
    t = t + "    CASE ""login""" + NL
    t = t + "        problem = ""That user name and password do not match. (Or you need to log in first.)""" + NL
    t = t + "    CASE ""join"", ""site""" + NL
    t = t + "        problem = REQUEST.Query(""why"")" + NL
    t = t + "    CASE ""bye""" + NL
    t = t + "        problem = ""You have logged out. Come back soon!""" + NL
    t = t + "    CASE ""token""" + NL
    t = t + "        problem = ""That did not come from a SimStats page, so nothing was changed.""" + NL
    t = t + "    CASE ""gone""" + NL
    t = t + "        problem = ""The site was deleted, with all its statistics.""" + NL
    t = t + "END SELECT" + NL
    t = t + "IF viewer <> """" THEN mine = SitesOf(viewer)" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Free Web Statistics"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr>" + NL
    t = t + "<td valign=""top"">" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<% IF viewer <> """" THEN %>" + NL
    t = t + "<%= BoxTop(""My Sites"") %>" + NL
    t = t + "<% IF mine.Count = 0 THEN %>" + NL
    t = t + "<p><font size=""2"">You aren't counting any sites yet. Add your first one below: it takes ten seconds.</font></p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<table width=""100%"" cellpadding=""3"" cellspacing=""0"">" + NL
    t = t + "<tr bgcolor=""#E8F0F8""><td><font size=""2""><b>Site</b></font></td><td align=""right""><font size=""2""><b>Today</b></font></td><td align=""right""><font size=""2""><b>7 days</b></font></td><td align=""right""><font size=""2""><b>All time</b></font></td><td></td></tr>" + NL
    t = t + "<% FOR EACH line IN mine" + NL
    t = t + "    id = SF(line, 0) %>" + NL
    t = t + "<tr><td><font size=""2""><a href=""dash.asp?s=<%= id %>""><b><%= H(SF(line, 2)) %></b></a><br><font size=""1""><%= H(SF(line, 3)) %><% IF SF(line, 6) <> ""1"" THEN %> <font color=""#CC0000"">(paused)</font><% END IF %><% IF SF(line, 4) = ""1"" THEN %> (public)<% END IF %></font></font></td>" + NL
    t = t + "<td align=""right""><font size=""2""><%= Commas(HitsIn(id, 1)) %></font></td><td align=""right""><font size=""2""><%= Commas(HitsIn(id, 7)) %></font></td><td align=""right""><font size=""2""><%= Commas(TotalHits(id)) %></font></td>" + NL
    t = t + "<td align=""right""><font size=""2""><a href=""dash.asp?s=<%= id %>"">Stats</a> | <a href=""code.asp?s=<%= id %>"">Get the code</a> | <a href=""edit.asp?s=<%= id %>"">Settings</a></font></td></tr>" + NL
    t = t + "<% NEXT %>" + NL
    t = t + "</table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<br>" + NL
    t = t + "<%= BoxTop(""Add a Site"") %>" + NL
    t = t + "<form action=""addsite.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<table cellpadding=""3""><tr><td><font size=""2"">Name:</font></td><td><input name=""name"" size=""30"" maxlength=""<%= MAXNAME %>""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Address:</font></td><td><input name=""url"" size=""30"" maxlength=""<%= MAXURL %>"" value=""http://""></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Start Counting""></td></tr></table>" + NL
    t = t + "</form>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<%= BoxTop(""Who's visiting YOUR web site?"") %>" + NL
    t = t + "<p><font size=""3"">Find out with <b>SimStats</b>, the FREE web statistics service for the SIM95 network." + NL
    t = t + "Paste one line of HTML into your pages and see, live:</font></p>" + NL
    t = t + "<ul><font size=""2"">" + NL
    t = t + "<li><b>How many hits</b> and <b>unique visitors</b> you get, day by day</li>" + NL
    t = t + "<li>Your <b>most popular pages</b></li>" + NL
    t = t + "<li><b>Where your visitors come from</b> (referrers)</li>" + NL
    t = t + "<li>Which <b>browsers</b> they use: Voyager? Simxplorer?</li>" + NL
    t = t + "<li>What <b>time of day</b> they surf, and which machines they surf from</li>" + NL
    t = t + "<li>The <b>last 20 hits</b>, as they happen</li>" + NL
    t = t + "<li>A <b>hit counter</b> for your page, in classic LED style</li>" + NL
    t = t + "</font></ul>" + NL
    t = t + "<p><font size=""2"">It works on any page, on any machine: your homepage, your GeoSimies site, your SimHost." + NL
    t = t + "No software to install, no banner ads, no cost. Ever.</font></p>" + NL
    t = t + "<p align=""center""><img src=""hit.asp?s=00000000&b=1&n=1"" width=""88"" height=""31"" alt=""A SimStats counter""></p>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</td>" + NL
    t = t + "<td width=""220"" valign=""top"" bgcolor=""#EEEEEE"">" + NL
    t = t + "<% IF viewer <> """" THEN %>" + NL
    t = t + "<%= BoxTop(""Hello, "" + H(NameOf(viewer))) %>" + NL
    t = t + "<p><font size=""2""><a href=""logout.asp?<%= TokenArg() %>"">Log out</a></font></p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<%= BoxTop(""Log In"") %>" + NL
    t = t + "<form action=""login.asp"" method=""post"">" + NL
    t = t + "<font size=""2"">User name:<br><input name=""u"" size=""14""><br>" + NL
    t = t + "Password:<br><input type=""password"" name=""pw"" size=""14""><br>" + NL
    t = t + "<input type=""submit"" value=""Log In""></font>" + NL
    t = t + "</form>" + NL
    t = t + "<a name=""join""></a>" + NL
    t = t + "<%= BoxTop(""Sign Up FREE"") %>" + NL
    t = t + "<form action=""join.asp"" method=""post"">" + NL
    t = t + "<font size=""2"">Your name:<br><input name=""name"" size=""18""><br>" + NL
    t = t + "User name:<br><input name=""u"" size=""14""><br>" + NL
    t = t + "Password:<br><input type=""password"" name=""pw"" size=""14""><br>" + NL
    t = t + "Again:<br><input type=""password"" name=""pw2"" size=""14""><br>" + NL
    t = t + "<input type=""submit"" value=""Sign Up""></font>" + NL
    t = t + "<p><font size=""1"" color=""#808080"">User names are 3 to 8 letters or digits.</font></p>" + NL
    t = t + "</form>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= BoxTop(""For Visitors"") %>" + NL
    t = t + "<p><font size=""1"">SimStats counts visits to the sites that use it. <a href=""privacy.htm"">What we keep</a>, and" + NL
    t = t + "<a href=""optout.asp"">how to not be counted</a>.</font></p>" + NL
    t = t + "<p><font size=""1""><a href=""admin.asp"">Machine owner</a></font></p>" + NL
    t = t + "</td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\INDEX.ASP")
END SUB

SUB File8 ()
    t = ""
    t = t + "<%@ import file=""TRACK.SPK"" %>" + NL
    t = t + "<%@ import file=""STATS.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' JOIN.ASP - makes a new account and signs it in." + NL
    t = t + "VAR u AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "u = REQUEST.Form(""u"").Trim().Lower()" + NL
    t = t + "IF REQUEST.Form(""pw"") <> REQUEST.Form(""pw2"") THEN" + NL
    t = t + "    problem = ""The two passwords are different.""" + NL
    t = t + "ELSE" + NL
    t = t + "    problem = CreateUser(u, REQUEST.Form(""pw""), REQUEST.Form(""name""))" + NL
    t = t + "END IF" + NL
    t = t + "IF problem <> """" THEN RESPONSE.Redirect(""index.asp?e=join&why="" + UrlEnc(problem))" + NL
    t = t + "SignIn(u)" + NL
    t = t + "RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\JOIN.ASP")
END SUB

SUB File9 ()
    t = ""
    t = t + "<%@ import file=""TRACK.SPK"" %>" + NL
    t = t + "<%@ import file=""STATS.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' LIVE.ASP?s=ID - the last 20 hits. For the site's owner they show where each" + NL
    t = t + "' visitor came from; for anybody else (pub=1, or not the owner) only public" + NL
    t = t + "' sites answer, and without addresses." + NL
    t = t + "'   f=text   plain lines, newest first: what the Live box's XMLHttpRequest" + NL
    t = t + "'            asks for every few seconds in Simxplorer" + NL
    t = t + "'   w=1      a page that reloads itself every 15 seconds: a <meta> refresh" + NL
    t = t + "'            for Simxplorer, and a SPARK page script for Voyager, which" + NL
    t = t + "'            knows no <meta> refresh" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR id AS String" + NL
    t = t + "VAR pub AS Bool" + NL
    t = t + "VAR rows AS Array OF String" + NL
    t = t + "VAR row AS String" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "line = SiteLine(REQUEST.Query(""s"").Trim().Upper())" + NL
    t = t + "pub = TRUE" + NL
    t = t + "IF line <> """" THEN" + NL
    t = t + "    IF viewer <> """" AND SF(line, 1) = viewer AND REQUEST.Query(""pub"") = """" THEN" + NL
    t = t + "        pub = FALSE" + NL
    t = t + "    ELSEIF SF(line, 4) <> ""1"" THEN" + NL
    t = t + "        line = """"" + NL
    t = t + "    END IF" + NL
    t = t + "END IF" + NL
    t = t + "IF REQUEST.Query(""f"") = ""text"" THEN" + NL
    t = t + "    RESPONSE.Clear()" + NL
    t = t + "    RESPONSE.ContentType = ""text/plain""" + NL
    t = t + "    IF line = """" THEN" + NL
    t = t + "        RESPONSE.Status = ""403 Forbidden""" + NL
    t = t + "    ELSE" + NL
    t = t + "        RESPONSE.Write(LiveLines(SF(line, 0), pub).Join(Chr(10)))" + NL
    t = t + "    END IF" + NL
    t = t + "    RESPONSE.End()" + NL
    t = t + "END IF" + NL
    t = t + "%><html><head><title>Live - SimStats</title><meta name=""robots"" content=""noindex,nofollow"">" + NL
    t = t + "<% IF REQUEST.Query(""w"") <> """" THEN %><meta http-equiv=""refresh"" content=""15""><% END IF %>" + NL
    t = t + "</head>" + NL
    t = t + "<% IF REQUEST.Query(""w"") <> """" THEN %>" + NL
    t = t + "<body bgcolor=""#000000"" text=""#00FF00"" link=""#FFCC00"" vlink=""#FFCC00"" onload=""Page_Load"">" + NL
    t = t + "<script type=""spark"">" + NL
    t = t + "SUB Page_Load ()" + NL
    t = t + "    SYS.Sleep(15000)" + NL
    t = t + "    PAGE.Navigate(PAGE.Location)" + NL
    t = t + "END SUB" + NL
    t = t + "</script>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<body bgcolor=""#000000"" text=""#00FF00"" link=""#FFCC00"" vlink=""#FFCC00"">" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<% IF line = """" THEN %>" + NL
    t = t + "<p>There is nothing to see here: the site keeps its statistics private, or the address is wrong.</p>" + NL
    t = t + "<% ELSE" + NL
    t = t + "    id = SF(line, 0)" + NL
    t = t + "    rows = LiveLines(id, pub) %>" + NL
    t = t + "<font size=""4""><b>Live: <%= H(SF(line, 2)) %></b></font> <font size=""2"">the last <%= LIVEROWS %> hits, as of <%= TIME.Clock %></font>" + NL
    t = t + "<pre><% FOR EACH row IN rows %><%= H(row) %>" + NL
    t = t + "<% NEXT %><% IF rows.Count = 0 THEN %>Waiting for the first visitor...<% END IF %></pre>" + NL
    t = t + "<font size=""2""><a href=""live.asp?s=<%= id %><% IF REQUEST.Query(""pub"") <> """" THEN %>&pub=1<% END IF %>&w=1"">Reload</a><% IF REQUEST.Query(""w"") <> """" THEN %> (this page reloads itself every 15 seconds)<% END IF %>" + NL
    t = t + "<% IF pub THEN %>| <a href=""public.asp?s=<%= id %>"">All the stats</a><% ELSE %>| <a href=""dash.asp?s=<%= id %>"">All the stats</a><% END IF %></font>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\LIVE.ASP")
END SUB

SUB File10 ()
    t = ""
    t = t + "<%@ import file=""TRACK.SPK"" %>" + NL
    t = t + "<%@ import file=""STATS.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' LOGIN.ASP - checks the password, hands out a session cookie, and goes home." + NL
    t = t + "VAR u AS String" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "u = CleanName(REQUEST.Form(""u""))" + NL
    t = t + "IF u = """" OR NOT CheckPassword(u, REQUEST.Form(""pw"")) THEN RESPONSE.Redirect(""index.asp?e=login"")" + NL
    t = t + "SignIn(u)" + NL
    t = t + "RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\LOGIN.ASP")
END SUB

SUB File11 ()
    t = ""
    t = t + "<%@ import file=""TRACK.SPK"" %>" + NL
    t = t + "<%@ import file=""STATS.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' LOGOUT.ASP?t=token - forgets the session on disk and in the browser. The" + NL
    t = t + "' token stops another site from logging you out." + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "SignOut()" + NL
    t = t + "RESPONSE.Redirect(""index.asp?e=bye"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\LOGOUT.ASP")
END SUB

SUB File12 ()
    t = ""
    t = t + "<%@ import file=""TRACK.SPK"" %>" + NL
    t = t + "<%@ import file=""STATS.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' OPTOUT.ASP - a visitor can tell SimStats not to count them. It is a cookie" + NL
    t = t + "' on this machine (ssout=1), which the browser sends along with every SimStats" + NL
    t = t + "' tag on every site, so hit.asp sees it and counts nothing. It lasts as long" + NL
    t = t + "' as the browser keeps the cookie (C:\SYSTEM\COOKIES.TXT)." + NL
    t = t + "VAR said AS String" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "indexable = TRUE" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    IF REQUEST.Form(""do"") = ""out"" THEN" + NL
    t = t + "        RESPONSE.SetCookie(OUTCOOKIE, ""1"")" + NL
    t = t + "        RESPONSE.SetCookie(VIDCOOKIE, """")" + NL
    t = t + "        RESPONSE.Redirect(""optout.asp?done=out"")" + NL
    t = t + "    ELSEIF REQUEST.Form(""do"") = ""in"" THEN" + NL
    t = t + "        RESPONSE.SetCookie(OUTCOOKIE, """")" + NL
    t = t + "        RESPONSE.Redirect(""optout.asp?done=in"")" + NL
    t = t + "    END IF" + NL
    t = t + "END IF" + NL
    t = t + "IF REQUEST.Query(""done"") = ""out"" THEN said = ""Done. SimStats will not count you on any site, from now on.""" + NL
    t = t + "IF REQUEST.Query(""done"") = ""in"" THEN said = ""Welcome back! SimStats counts your visits again.""" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Don't Count Me"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= Notice(said) %>" + NL
    t = t + "<%= BoxTop(""Don't Count Me"") %>" + NL
    t = t + "<p><font size=""3"">Sites all over the network use SimStats to see how many people visit them." + NL
    t = t + "If you'd rather not be one of the numbers, that's fine with us. Press the button and SimStats" + NL
    t = t + "won't count you on <b>any</b> site that uses it.</font></p>" + NL
    t = t + "<% IF REQUEST.Cookie(OUTCOOKIE) = ""1"" THEN %>" + NL
    t = t + "<p><font size=""3"" color=""#006600""><b>Right now, SimStats is NOT counting you.</b></font></p>" + NL
    t = t + "<form action=""optout.asp"" method=""post""><input type=""hidden"" name=""do"" value=""in""><input type=""submit"" value=""Count me again""></form>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<p><font size=""3"" color=""#CC0000""><b>Right now, SimStats is counting your visits.</b></font></p>" + NL
    t = t + "<form action=""optout.asp"" method=""post""><input type=""hidden"" name=""do"" value=""out""><input type=""submit"" value=""Don't count me""></form>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<p><font size=""2""><b>How it works:</b> the button leaves a cookie from <%= H(SERVER.Name.Lower()) %> in your browser." + NL
    t = t + "Your browser shows it to SimStats every time a page with a SimStats tag loads, and SimStats then" + NL
    t = t + "counts nothing: no hit, no page, no address. Pages still look the same, and counters still show" + NL
    t = t + "their number (you just aren't in it). It works in Voyager and Simxplorer, which share their cookies.</font></p>" + NL
    t = t + "<p><font size=""2""><b>The catch:</b> it's a cookie. If you delete your cookies (Simxplorer: View, Options)," + NL
    t = t + "or use another machine, SimStats can't know, and counts you again until you come back here.</font></p>" + NL
    t = t + "<p><font size=""2"">What SimStats keeps about a visit, and for how long: our <a href=""privacy.htm"">privacy page</a>.</font></p>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\OPTOUT.ASP")
END SUB

SUB File13 ()
    t = ""
    t = t + "<html><head><title>Privacy - SimStats</title>" + NL
    t = t + "<meta name=""description"" content=""What SimStats, the free web statistics service for SIM95, keeps about the visitors it counts, for how long, and how not to be counted."">" + NL
    t = t + "</head>" + NL
    t = t + "<body bgcolor=""#FFFFFF"" text=""#000000"" link=""#003366"" vlink=""#663366"">" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""0"" bgcolor=""#003366""><tr><td><a href=""index.asp""><font size=""6"" color=""#FFCC00""><b>Sim</b></font><font size=""6"" color=""#FFFFFF""><b>Stats</b></font></a>" + NL
    t = t + "<font color=""#99CCFF"" size=""2"">&nbsp; who's visiting your web site?</font></td></tr></table>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<h2><font color=""#003366"">Your Privacy and SimStats</font></h2>" + NL
    t = t + "<p><b>Hey there, surfer!</b> You're probably here because a page you like has a SimStats tag on it." + NL
    t = t + "We believe the Information Superhighway works best when everybody knows the rules of the road. So here," + NL
    t = t + "in plain English and with no lawyers involved, is exactly what we keep.</p>" + NL
    t = t + "" + NL
    t = t + "<h3>What we write down when you visit a page that uses SimStats</h3>" + NL
    t = t + "<ul>" + NL
    t = t + "<li><b>The time</b> of your visit.</li>" + NL
    t = t + "<li><b>Your machine's network address</b> (like 65.16.0.3). Every machine on the SIM95 network tells" + NL
    t = t + "every web server it talks to who it is. That's how the network works, and we can't help seeing it.</li>" + NL
    t = t + "<li><b>Your browser and its version</b> (Voyager 1.1, Simxplorer 3.02...), which your browser" + NL
    t = t + "announces to every web server it visits.</li>" + NL
    t = t + "<li><b>Which page</b> you looked at, and in Simxplorer <b>its title</b> and <b>the page you came from</b>" + NL
    t = t + "(the ""referrer""). Voyager doesn't tell anybody where you came from, so with Voyager we don't know.</li>" + NL
    t = t + "<li><b>A visitor number</b> in a cookie from this machine, so we can count you once a day instead of" + NL
    t = t + "once a page. It's a random number. It isn't your name, and we don't have your name.</li>" + NL
    t = t + "</ul>" + NL
    t = t + "" + NL
    t = t + "<h3>What we do NOT do</h3>" + NL
    t = t + "<ul>" + NL
    t = t + "<li>We don't know who you are. No names, no e-mail addresses, nothing you typed anywhere.</li>" + NL
    t = t + "<li>We don't sell anything to anybody. There's nobody to sell it to anyway.</li>" + NL
    t = t + "<li>We don't read your other cookies, your files, or anything else on your machine.</li>" + NL
    t = t + "</ul>" + NL
    t = t + "" + NL
    t = t + "<h3>Who sees it</h3>" + NL
    t = t + "<p>The owner of the site you visited sees its statistics, <b>including the addresses of the machines that" + NL
    t = t + "visited</b> and the last 20 visits as they happen. Some sites make their statistics public: the public" + NL
    t = t + "page shows the numbers, pages, browsers and referrers, but <b>never anybody's address</b>." + NL
    t = t + "The person who runs this machine can see every site's totals.</p>" + NL
    t = t + "" + NL
    t = t + "<h3>How long we keep it</h3>" + NL
    t = t + "<p>The visit-by-visit log (with addresses) is kept for <b>14 days</b>, then thrown away. The daily" + NL
    t = t + "totals (how many hits, which pages, which browsers, and which machines visited how often) are kept" + NL
    t = t + "for <b>100 days</b>, then they go too. Each site's Live box keeps its last 20 visits (with" + NL
    t = t + "addresses) until newer ones push them out. A site's all-time hit count is kept for as long as the site is here." + NL
    t = t + "When a site's owner deletes it, every number for it goes at once.</p>" + NL
    t = t + "" + NL
    t = t + "<h3>Don't want to be counted?</h3>" + NL
    t = t + "<p>No problem, and no hard feelings. Go to <a href=""optout.asp""><b>Don't count me</b></a> and press the button." + NL
    t = t + "SimStats then counts nothing about you on any site, for as long as your browser keeps our cookie.</p>" + NL
    t = t + "" + NL
    t = t + "<p><font size=""2""><i>Last updated: 1998. Questions? Ask the person who runs this machine.</i></font></p>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<hr><center><font size=""1"" color=""#808080""><a href=""index.asp"">SimStats</a> &middot; <a href=""simstats.htm"">About SimStats</a> &middot; <a href=""optout.asp"">Don't count me</a></font></center>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\PRIVACY.HTM")
END SUB

SUB File14 ()
    t = ""
    t = t + "<%@ import file=""TRACK.SPK"" %>" + NL
    t = t + "<%@ import file=""STATS.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' PUBLIC.ASP?s=ID&r=1|7|30 - a site's statistics for anybody, when its owner" + NL
    t = t + "' made them public: the same as the dashboard, minus every visitor's address" + NL
    t = t + "' (no Visiting Machines, and none in the Live box)." + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR id AS String" + NL
    t = t + "VAR days AS Integer" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "line = SiteLine(REQUEST.Query(""s"").Trim().Upper())" + NL
    t = t + "IF line <> """" AND SF(line, 4) <> ""1"" THEN line = """"" + NL
    t = t + "days = RangeOf(REQUEST.Query(""r""))" + NL
    t = t + "%>" + NL
    t = t + "<% IF line = """" THEN %>" + NL
    t = t + "<%= Top(""No Such Stats"") %>" + NL
    t = t + "<%= Notice(""There are no public statistics here. The site may keep its statistics private, or the address is wrong."") %>" + NL
    t = t + "<% ELSE" + NL
    t = t + "    id = SF(line, 0) %>" + NL
    t = t + "<%= Top(""Public Stats for "" + SF(line, 2)) %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<table width=""100%"" cellpadding=""0"" cellspacing=""0""><tr><td><font size=""5""><b><%= H(SF(line, 2)) %></b></font>" + NL
    t = t + "<br><font size=""2""><a href=""<%= H(SF(line, 3)) %>""><%= H(SF(line, 3)) %></a> &middot; public statistics</font></td>" + NL
    t = t + "<td align=""right"" valign=""bottom""><%= RangeBar(""public.asp"", id, days) %></td></tr></table>" + NL
    t = t + "<br>" + NL
    t = t + "<%= Dashboard(line, days, TRUE) %>" + NL
    t = t + "<%= LiveBox(id, TRUE) %>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\PUBLIC.ASP")
END SUB

SUB File15 ()
    t = ""
    t = t + "<html><head><title>About SimStats - free web statistics and hit counters for SIM95</title>" + NL
    t = t + "<meta name=""description"" content=""SimStats is free web statistics for the SIM95 network: hit counters, unique visitors, top pages, referrers, browsers and live traffic for any web site, like Google Analytics before Google."">" + NL
    t = t + "<meta name=""keywords"" content=""analytics, web analytics, web statistics, web stats, statistics, stats, hit counter, counter, traffic, visitors, unique visitors, page views, referrers, browsers, log analyzer, google analytics, hitbox, urchin, webtrends, site meter, simstats"">" + NL
    t = t + "</head>" + NL
    t = t + "<body bgcolor=""#FFFFFF"" text=""#000000"" link=""#003366"" vlink=""#663366"">" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""0"" bgcolor=""#003366""><tr><td><a href=""index.asp""><font size=""6"" color=""#FFCC00""><b>Sim</b></font><font size=""6"" color=""#FFFFFF""><b>Stats</b></font></a>" + NL
    t = t + "<font color=""#99CCFF"" size=""2"">&nbsp; who's visiting your web site?</font></td></tr></table>" + NL
    t = t + "<table width=""100%"" cellpadding=""2"" cellspacing=""0"" bgcolor=""#FFCC00""><tr><td align=""center""><font size=""1"" color=""#003366""><b>FREE</b> web statistics &middot; hit counters &middot; real-time visitor tracking &middot; no banner ads!</font></td></tr></table>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<h2><font color=""#003366"">About SimStats</font></h2>" + NL
    t = t + "<p><b>SimStats is free web statistics for the SIM95 network.</b> How many people visit your site? Which" + NL
    t = t + "pages do they like? Where do they come from, and what browser do they use? Paste one line of HTML into" + NL
    t = t + "your pages, and SimStats tells you, day by day and live as it happens. It's web analytics for the rest" + NL
    t = t + "of us: think Hitbox, think Urchin, think the Google Analytics of 1998.</p>" + NL
    t = t + "" + NL
    t = t + "<h3>What you get</h3>" + NL
    t = t + "<ul>" + NL
    t = t + "<li><b>Hits and unique visitors</b>, today, for the last 7 days or the last 30, as a bar chart.</li>" + NL
    t = t + "<li><b>Top pages</b>, with their titles.</li>" + NL
    t = t + "<li><b>Top referrers</b>: the pages your visitors clicked through from.</li>" + NL
    t = t + "<li><b>Browsers</b>: Voyager or Simxplorer, and which version.</li>" + NL
    t = t + "<li><b>Hours of the day</b> your visitors surf at.</li>" + NL
    t = t + "<li><b>Visiting machines</b>: which machines on the network your visitors used.</li>" + NL
    t = t + "<li><b>Live</b>: the last 20 hits, updating by themselves in Simxplorer.</li>" + NL
    t = t + "<li>A <b>hit counter</b> for your page, 88x31 in glowing LED digits.</li>" + NL
    t = t + "<li><b>Public stats</b>, if you want to show off.</li>" + NL
    t = t + "</ul>" + NL
    t = t + "" + NL
    t = t + "<h3>How it works</h3>" + NL
    t = t + "<p>Sign up, add your site, and SimStats gives you its <b>tracking tag</b>: a tiny picture that lives on this" + NL
    t = t + "machine. Put it in your pages, on any machine. Every time somebody's browser shows the picture, SimStats" + NL
    t = t + "counts a hit. Three flavours:</p>" + NL
    t = t + "<ol>" + NL
    t = t + "<li><b>The plain tag</b>, an invisible <tt>&lt;img&gt;</tt>, one pixel big. Works in every browser and on" + NL
    t = t + "GeoSimies homepages.</li>" + NL
    t = t + "<li><b>The JavaScript tag</b> for Simxplorer, which also sends the page's title and where the visitor" + NL
    t = t + "came from, with the plain tag in <tt>&lt;noscript&gt;</tt> for Voyager.</li>" + NL
    t = t + "<li><b>The hit counter</b>: like the plain tag, but you can see it.</li>" + NL
    t = t + "</ol>" + NL
    t = t + "<p>Unique visitors are counted with a cookie from this machine, which both Voyager and Simxplorer send" + NL
    t = t + "along with the picture even when it's on somebody else's page. A browser that won't keep cookies is" + NL
    t = t + "counted once a day per machine.</p>" + NL
    t = t + "" + NL
    t = t + "<h3>For visitors</h3>" + NL
    t = t + "<p>SimStats tells site owners what it sees and no more: see our <a href=""privacy.htm"">privacy page</a>." + NL
    t = t + "You can tell SimStats <a href=""optout.asp"">not to count you</a> at all.</p>" + NL
    t = t + "" + NL
    t = t + "<p><a href=""index.asp""><b>Sign up now. It's FREE!</b></a></p>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<hr><center><font size=""1"" color=""#808080""><a href=""index.asp"">SimStats</a> &middot; <a href=""privacy.htm"">Privacy</a> &middot; <a href=""optout.asp"">Don't count me</a><br>Copyright &copy; 1998 SimStats. Best viewed at 640x480.</font></center>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\SIMSTATS.HTM")
END SUB

SUB File16 ()
    t = ""
    t = t + "' STATS.SPK - SimStats' pages: accounts, sites, the tracking code to paste," + NL
    t = t + "' and the dashboards. Every page imports TRACK.SPK (the counting, and the" + NL
    t = t + "' files it keeps) and then this:" + NL
    t = t + "'     <%@ import file=""TRACK.SPK"" %>" + NL
    t = t + "'     <%@ import file=""STATS.SPK"" %>" + NL
    t = t + "'" + NL
    t = t + "' A dashboard reads one small rollup file per day (see TRACK.SPK), never the" + NL
    t = t + "' raw hits, so thirty busy days come up inside a server page's time limit," + NL
    t = t + "' and every list stops at a screenful so the page stays under 64K." + NL
    t = t + "" + NL
    t = t + "CONST COOKIE = ""simstats""" + NL
    t = t + "CONST MAXNAME = 40" + NL
    t = t + "CONST MAXURL = 100" + NL
    t = t + "CONST MAXSITES = 20            ' sites to an account" + NL
    t = t + "CONST TOPN = 12                ' rows in each Top list" + NL
    t = t + "CONST BARW = 300               ' pixels for the longest bar" + NL
    t = t + "" + NL
    t = t + "VAR viewer AS String           ' who is signed in; """" for nobody" + NL
    t = t + "VAR formToken AS String" + NL
    t = t + "VAR lastSite AS String         ' the id AddSite handed out" + NL
    t = t + "VAR indexable AS Bool          ' TRUE: AskSim may keep this page" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the disk" + NL
    t = t + "" + NL
    t = t + "SUB EnsureDisk ()" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR dirs AS Array OF String" + NL
    t = t + "    dirs = ["""", ""\USERS"", ""\SESSIONS"", ""\S""]" + NL
    t = t + "    FOR EACH dir IN dirs" + NL
    t = t + "        IF NOT FS.Exists(DATADIR + dir) THEN FS.MakeDir(DATADIR + dir)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION H (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.HtmlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UrlEnc (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.UrlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ValidName (u AS String) AS Bool" + NL
    t = t + "    IF u.Length < 3 OR u.Length > 8 THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyFrom(u, ""abcdefghijklmnopqrstuvwxyz0123456789"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CleanName (u AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = u.Trim().Lower()" + NL
    t = t + "    IF ValidName(s) THEN RETURN s" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Plural (n AS Integer, one AS String, many AS String) AS String" + NL
    t = t + "    IF n = 1 THEN RETURN ""1 "" + one" + NL
    t = t + "    RETURN Str(n) + "" "" + many" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' 1234567 as 1,234,567" + NL
    t = t + "FUNCTION Commas (n AS Integer) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    s = Str(n)" + NL
    t = t + "    WHILE s.Length > 3" + NL
    t = t + "        out = "","" + s.Substring(s.Length - 3, 3) + out" + NL
    t = t + "        s = s.Substring(0, s.Length - 3)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN s + out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where this page is: C:\WEB, or C:\WEB\STATS when SimStats has a folder of its own." + NL
    t = t + "FUNCTION AppDir () AS String" + NL
    t = t + "    VAR page AS String" + NL
    t = t + "    page = SERVER.ScriptName" + NL
    t = t + "    RETURN page.Substring(0, page.Length - page.Split(""\"")[page.Split(""\"").Count - 1].Length - 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where SimStats is on the web: http://host/ or http://host/stats/" + NL
    t = t + "FUNCTION SiteUrl () AS String" + NL
    t = t + "    IF AppDir().Upper() = ""C:\WEB"" THEN RETURN ""http://"" + SERVER.Name.Lower() + ""/""" + NL
    t = t + "    RETURN ""http://"" + SERVER.Name.Lower() + ""/"" + AppDir().Substring(7, AppDir().Length - 7).Replace(""\"", ""/"").Lower() + ""/""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- accounts" + NL
    t = t + "' The same as SimBook's: a salted hash, never the password; a session file" + NL
    t = t + "' named by the cookie; a form token on everything that changes something." + NL
    t = t + "" + NL
    t = t + "FUNCTION UserPath (u AS String) AS String" + NL
    t = t + "    RETURN DATADIR + ""\USERS\"" + u + "".TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UserExists (u AS String) AS Bool" + NL
    t = t + "    IF NOT ValidName(u) THEN RETURN FALSE" + NL
    t = t + "    RETURN FS.Exists(UserPath(u))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LoadUser (u AS String) AS Array OF String" + NL
    t = t + "    RETURN FS.Read(UserPath(u)).Lines()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SaveUser (u AS String, rec AS Array OF String)" + NL
    t = t + "    FS.Write(UserPath(u), rec.Join(Chr(10)))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Field (rec AS Array OF String, name AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN rec" + NL
    t = t + "        IF line.StartsWith(name + ""="") THEN RETURN Unesc(line.Substring(name.Length + 1, line.Length - name.Length - 1))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SetField (rec AS Array OF String, name AS String, value AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO rec.Count - 1" + NL
    t = t + "        IF rec[i].StartsWith(name + ""="") THEN" + NL
    t = t + "            rec[i] = name + ""="" + Esc(value)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    rec.Add(name + ""="" + Esc(value))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION NameOf (u AS String) AS String" + NL
    t = t + "    IF NOT UserExists(u) THEN RETURN u" + NL
    t = t + "    RETURN Field(LoadUser(u), ""name"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Not real cryptography - SIM95 has none - but the password itself never" + NL
    t = t + "' touches the disk." + NL
    t = t + "FUNCTION Hash (salt AS String, pw AS String) AS String" + NL
    t = t + "    VAR a AS Integer = 7" + NL
    t = t + "    VAR b AS Integer = 31337" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = salt + "":"" + pw + "":"" + salt" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        c = Asc(s.CharAt(i))" + NL
    t = t + "        a = (a * 131 + c) MOD 2147483629" + NL
    t = t + "        b = (b * 257 + c + a) MOD 2147483587" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN Hex(a) + ""-"" + Hex(b)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CreateUser (u AS String, pw AS String, name AS String) AS String" + NL
    t = t + "    VAR rec AS Array OF String" + NL
    t = t + "    VAR salt AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    IF NOT ValidName(u) THEN RETURN ""Pick a user name of 3 to 8 letters or digits.""" + NL
    t = t + "    IF FS.Exists(UserPath(u)) THEN RETURN ""Somebody already has the name "" + u + "".""" + NL
    t = t + "    IF pw.Length < 4 THEN RETURN ""Pick a password of at least 4 characters.""" + NL
    t = t + "    name = Clip(name, MAXNAME)" + NL
    t = t + "    IF name = """" THEN RETURN ""Tell us your name.""" + NL
    t = t + "    salt = NewToken()" + NL
    t = t + "    SetField(rec, ""name"", name)" + NL
    t = t + "    SetField(rec, ""salt"", salt)" + NL
    t = t + "    SetField(rec, ""pass"", Hash(salt, pw))" + NL
    t = t + "    SetField(rec, ""joined"", TIME.Date)" + NL
    t = t + "    SaveUser(u, rec)" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CheckPassword (u AS String, pw AS String) AS Bool" + NL
    t = t + "    VAR rec AS Array OF String" + NL
    t = t + "    IF NOT UserExists(u) THEN RETURN FALSE" + NL
    t = t + "    rec = LoadUser(u)" + NL
    t = t + "    RETURN Hash(Field(rec, ""salt""), pw) = Field(rec, ""pass"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SignIn (u AS String)" + NL
    t = t + "    VAR token AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    token = NewToken()" + NL
    t = t + "    FS.Write(DATADIR + ""\SESSIONS\"" + token + "".TXT"", u + Chr(10) + NewToken() + NewToken())" + NL
    t = t + "    RESPONSE.SetCookie(COOKIE, token)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION SessionPath () AS String" + NL
    t = t + "    VAR token AS String" + NL
    t = t + "    token = REQUEST.Cookie(COOKIE)" + NL
    t = t + "    IF NOT IsId(token) THEN RETURN """"" + NL
    t = t + "    RETURN DATADIR + ""\SESSIONS\"" + token + "".TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SignOut ()" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    path = SessionPath()" + NL
    t = t + "    IF path <> """" THEN" + NL
    t = t + "        IF FS.Exists(path) THEN FS.Delete(path)" + NL
    t = t + "    END IF" + NL
    t = t + "    RESPONSE.SetCookie(COOKIE, """")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Who the cookie says is signed in, or """". Also sets formToken." + NL
    t = t + "FUNCTION CurrentUser () AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR u AS String" + NL
    t = t + "    path = SessionPath()" + NL
    t = t + "    IF path = """" THEN RETURN """"" + NL
    t = t + "    IF NOT FS.Exists(path) THEN RETURN """"" + NL
    t = t + "    lines = FS.Read(path).Lines()" + NL
    t = t + "    IF lines.Count < 2 THEN RETURN """"" + NL
    t = t + "    u = lines[0].Trim()" + NL
    t = t + "    IF NOT UserExists(u) THEN RETURN """"" + NL
    t = t + "    formToken = lines[1].Trim()" + NL
    t = t + "    RETURN u" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB RequireLogin ()" + NL
    t = t + "    viewer = CurrentUser()" + NL
    t = t + "    IF viewer = """" THEN RESPONSE.Redirect(""index.asp?e=login"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Voyager sends SimStats' cookie with a form on any site, so the cookie alone" + NL
    t = t + "' proves nothing: every form carries the session's token too." + NL
    t = t + "SUB RequireToken ()" + NL
    t = t + "    VAR sent AS String" + NL
    t = t + "    sent = REQUEST.Form(""t"")" + NL
    t = t + "    IF sent = """" THEN sent = REQUEST.Query(""t"")" + NL
    t = t + "    IF sent = """" OR sent <> formToken THEN RESPONSE.Redirect(""index.asp?e=token"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION TokenField () AS String" + NL
    t = t + "    RETURN ""<input type=""""hidden"""" name=""""t"""" value="""""" + formToken + """""">""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION TokenArg () AS String" + NL
    t = t + "    RETURN ""t="" + formToken" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The machine's owner: the user name and password in C:\SYSTEM\USERS.INI," + NL
    t = t + "' the same ones the Files service asks for." + NL
    t = t + "FUNCTION IsOwner (name AS String, pw AS String) AS Bool" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR owner AS String" + NL
    t = t + "    VAR pass AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(""C:\SYSTEM\USERS.INI"", """").Lines()" + NL
    t = t + "        line = line.Trim()" + NL
    t = t + "        IF line.Lower().StartsWith(""name="") THEN owner = line.Substring(5, line.Length - 5).Trim()" + NL
    t = t + "        IF line.Lower().StartsWith(""password="") THEN pass = line.Substring(9, line.Length - 9)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF owner = """" OR pw = """" THEN RETURN FALSE" + NL
    t = t + "    RETURN owner.Lower() = name.Trim().Lower() AND pass = pw" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- sites" + NL
    t = t + "" + NL
    t = t + "FUNCTION AllSites () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\SITES.TXT"", """").Lines()" + NL
    t = t + "        IF line.Split(""|"").Count >= 7 THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION SitesOf (u AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN AllSites()" + NL
    t = t + "        IF SF(line, 1) = u THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Site id, which must be the viewer's. Anybody else's (or none) goes home:" + NL
    t = t + "' one account never sees another's numbers." + NL
    t = t + "FUNCTION MySite (id AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    line = SiteLine(id.Trim().Upper())" + NL
    t = t + "    IF line = """" OR SF(line, 1) <> viewer THEN RESPONSE.Redirect(""index.asp?e=site&why="" + UrlEnc(""That isn't one of your sites.""))" + NL
    t = t + "    RETURN line" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' An address people type: http:// is added when it is missing." + NL
    t = t + "FUNCTION CleanUrl (url AS String) AS String" + NL
    t = t + "    url = Clip(url, MAXURL)" + NL
    t = t + "    IF url = """" THEN RETURN """"" + NL
    t = t + "    IF NOT url.Lower().StartsWith(""http://"") THEN url = ""http://"" + url" + NL
    t = t + "    IF url.Contains("" "") OR url.Contains("""""""") OR url.Contains(""<"") OR url.Contains("">"") THEN RETURN """"" + NL
    t = t + "    RETURN url" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION SiteRecord (id AS String, owner AS String, name AS String, url AS String, pub AS String, created AS String, isOn AS String) AS String" + NL
    t = t + "    RETURN id + ""|"" + Esc(owner) + ""|"" + Esc(name) + ""|"" + Esc(url) + ""|"" + pub + ""|"" + created + ""|"" + isOn" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A new site for owner. Returns """" (and sets lastSite) or what is wrong." + NL
    t = t + "FUNCTION AddSite (owner AS String, name AS String, url AS String) AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    name = Clip(name, MAXNAME)" + NL
    t = t + "    IF name = """" THEN RETURN ""Give your site a name.""" + NL
    t = t + "    url = CleanUrl(url)" + NL
    t = t + "    IF url = """" THEN RETURN ""Type your site's address, like http://bravo/.""" + NL
    t = t + "    IF SitesOf(owner).Count >= MAXSITES THEN RETURN ""You can count up to "" + Str(MAXSITES) + "" sites. Delete one first.""" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    id = NewToken()" + NL
    t = t + "    WHILE SiteLine(id) <> """"" + NL
    t = t + "        id = NewToken()" + NL
    t = t + "    END WHILE" + NL
    t = t + "    FS.MakeDir(SiteDir(id))" + NL
    t = t + "    FS.Append(DATADIR + ""\SITES.TXT"", SiteRecord(id, owner, name, url, ""0"", TIME.Date, ""1"") + Chr(10))" + NL
    t = t + "    lastSite = id" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A site's line, changed." + NL
    t = t + "SUB ReplaceSite (old AS String, line AS String)" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    text = (Chr(10) + ReadOr(DATADIR + ""\SITES.TXT"", """")).Replace(Chr(10) + old + Chr(10), Chr(10) + line + Chr(10))" + NL
    t = t + "    FS.Write(DATADIR + ""\SITES.TXT"", text.Substring(1, text.Length - 1))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Changes field i of site id." + NL
    t = t + "SUB SetSiteField (id AS String, i AS Integer, value AS String)" + NL
    t = t + "    VAR old AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    old = SiteLine(id)" + NL
    t = t + "    IF old = """" THEN RETURN" + NL
    t = t + "    p = old.Split(""|"")" + NL
    t = t + "    p[i] = Esc(value)" + NL
    t = t + "    ReplaceSite(old, p.Join(""|""))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A site and all its numbers go." + NL
    t = t + "SUB DeleteSite (id AS String)" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR old AS String" + NL
    t = t + "    old = SiteLine(id)" + NL
    t = t + "    IF old = """" THEN RETURN" + NL
    t = t + "    ReplaceSite(old, """")" + NL
    t = t + "    FS.Write(DATADIR + ""\SITES.TXT"", ReadOr(DATADIR + ""\SITES.TXT"", """").Replace(Chr(10) + Chr(10), Chr(10)))" + NL
    t = t + "    IF FS.Exists(SiteDir(id)) THEN" + NL
    t = t + "        FOR EACH f IN FS.List(SiteDir(id))" + NL
    t = t + "            IF NOT f.EndsWith(""\"") THEN FS.Delete(SiteDir(id) + ""\"" + f)" + NL
    t = t + "        NEXT" + NL
    t = t + "        TRY" + NL
    t = t + "            FS.Delete(SiteDir(id))" + NL
    t = t + "        CATCH err" + NL
    t = t + "        END TRY" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Hits over the last days days (1 is today)." + NL
    t = t + "FUNCTION HitsIn (id AS String, days AS Integer) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR t0 AS Integer" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    t0 = DayNum(TIME.Date)" + NL
    t = t + "    FOR i = 0 TO days - 1" + NL
    t = t + "        text = Chr(10) + ReadOr(SiteDir(id) + ""\"" + DayFile(DateOf(t0 - i)) + "".TXT"", """")" + NL
    t = t + "        at = text.IndexOf(Chr(10) + ""h|all|"")" + NL
    t = t + "        IF at >= 0 THEN n = n + Int(Val(text.Substring(at + 7, text.Length - at - 7).Split(Chr(10))[0]))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the code to paste" + NL
    t = t + "" + NL
    t = t + "' A page's address in a tag's query: what would break it is escaped, but the" + NL
    t = t + "' slashes stay, so the tag still reads well." + NL
    t = t + "FUNCTION QueryEnc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%"", ""%25"").Replace(""&"", ""%26"").Replace(""+"", ""%2B"").Replace("" "", ""+"").Replace(""#"", ""%23"").Replace(""?"", ""%3F"").Replace("""""""", ""%22"").Replace(""<"", ""%3C"").Replace("">"", ""%3E"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION HitUrl (id AS String) AS String" + NL
    t = t + "    RETURN SiteUrl() + ""hit.asp?s="" + id" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The plain tag: any browser that shows pictures counts with it." + NL
    t = t + "FUNCTION PlainTag (id AS String, page AS String) AS String" + NL
    t = t + "    RETURN ""<img src="""""" + HitUrl(id) + ""&p="" + QueryEnc(page) + """""" width=""""1"""" height=""""1"""" border=""""0"""" alt="""""""">""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' For Simxplorer: JavaScript fills in the page, its title and where the" + NL
    t = t + "' visitor came from. Voyager skips the script and takes the plain tag inside" + NL
    t = t + "' <noscript>; Simxplorer drops <noscript>, so nobody is counted twice." + NL
    t = t + "FUNCTION ScriptTag (id AS String, page AS String) AS String" + NL
    t = t + "    RETURN ""<script language=""""JavaScript"""">"" + Chr(10) + ""<!--"" + Chr(10) _" + NL
    t = t + "         + ""document.write('<img src="""""" + HitUrl(id) + ""&p=' + escape(location.pathname) + '&t=' + escape(document.title) + '&r=' + escape(document.referrer) + '&z=' + (new Date()).getTime() + '"""" width=""""1"""" height=""""1"""" border=""""0"""" alt="""""""">');"" + Chr(10) _" + NL
    t = t + "         + ""// -->"" + Chr(10) + ""</script>"" + Chr(10) _" + NL
    t = t + "         + ""<noscript>"" + PlainTag(id, page) + ""</noscript>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The visible counter, linking to the public stats (or to SimStats)." + NL
    t = t + "FUNCTION BadgeTag (line AS String, page AS String) AS String" + NL
    t = t + "    VAR link AS String" + NL
    t = t + "    link = SiteUrl() + ""simstats.htm""" + NL
    t = t + "    IF SF(line, 4) = ""1"" THEN link = SiteUrl() + ""public.asp?s="" + SF(line, 0)" + NL
    t = t + "    RETURN ""<a href="""""" + link + """"""><img src="""""" + HitUrl(SF(line, 0)) + ""&b=1&p="" + QueryEnc(page) + """""" width=""""88"""" height=""""31"""" border=""""0"""" alt=""""SimStats counter""""></a>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- page furniture" + NL
    t = t + "" + NL
    t = t + "FUNCTION Top (title AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = ""<html><head><title>"" + H(title) + "" - SimStats</title>""" + NL
    t = t + "    IF NOT indexable THEN s = s + ""<meta name=""""robots"""" content=""""noindex,nofollow"""">""" + NL
    t = t + "    s = s + ""</head><body bgcolor=""""#FFFFFF"""" text=""""#000000"""" link=""""#003366"""" vlink=""""#663366"""">"" _" + NL
    t = t + "      + ""<table width=""""100%"""" cellpadding=""""6"""" cellspacing=""""0"""" bgcolor=""""#003366""""><tr>"" _" + NL
    t = t + "      + ""<td><a href=""""index.asp""""><font size=""""6"""" color=""""#FFCC00""""><b>Sim</b></font><font size=""""6"""" color=""""#FFFFFF""""><b>Stats</b></font></a>"" _" + NL
    t = t + "      + ""<font color=""""#99CCFF"""" size=""""2"""">&nbsp; who's visiting your web site?</font></td>"" _" + NL
    t = t + "      + ""<td align=""""right""""><font color=""""#FFFFFF"""" size=""""2"""">""" + NL
    t = t + "    IF viewer <> """" THEN" + NL
    t = t + "        s = s + ""<a href=""""index.asp""""><font color=""""#FFFFFF"""">My Sites</font></a> | "" _" + NL
    t = t + "              + ""<a href=""""logout.asp?"" + TokenArg() + """"""><font color=""""#FFFFFF"""">Log Out</font></a>""" + NL
    t = t + "    ELSE" + NL
    t = t + "        s = s + ""<a href=""""index.asp""""><font color=""""#FFFFFF"""">Log In</font></a> | <a href=""""index.asp#join""""><font color=""""#FFFFFF"""">Sign Up FREE</font></a>""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN s + ""</font></td></tr></table>"" _" + NL
    t = t + "         + ""<table width=""""100%"""" cellpadding=""""2"""" cellspacing=""""0"""" bgcolor=""""#FFCC00""""><tr><td align=""""center""""><font size=""""1"""" color=""""#003366""""><b>FREE</b> web statistics &middot; hit counters &middot; real-time visitor tracking &middot; no banner ads!</font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Bottom () AS String" + NL
    t = t + "    RETURN ""<hr><center><font size=""""1"""" color=""""#808080"""">SimStats on "" + H(SERVER.Name) + "" &middot; "" + TIME.Date + "" &middot; "" _" + NL
    t = t + "         + ""<a href=""""simstats.htm"""">About SimStats</a> &middot; <a href=""""privacy.htm"""">Privacy</a> &middot; <a href=""""optout.asp"""">Don't count me</a><br>"" _" + NL
    t = t + "         + ""Copyright &copy; 1998 SimStats. Best viewed at 640x480.</font></center></body></html>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION BoxTop (title AS String) AS String" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""3"""" cellspacing=""""0""""><tr><td bgcolor=""""#336699""""><font color=""""#FFFFFF"""" size=""""2""""><b>"" + title + ""</b></font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Notice (text AS String) AS String" + NL
    t = t + "    IF text = """" THEN RETURN """"" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""4""""><tr><td bgcolor=""""#FFF9D7""""><font size=""""2"""">"" + H(text) + ""</font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A bar of n against the most, as a table cell of that width and colour." + NL
    t = t + "FUNCTION Bar (n AS Integer, most AS Integer, colour AS String, room AS Integer) AS String" + NL
    t = t + "    VAR w AS Integer" + NL
    t = t + "    IF most < 1 OR n < 1 THEN RETURN """"" + NL
    t = t + "    w = MATH.Max(1, Int(room * n / most))" + NL
    t = t + "    RETURN ""<table cellpadding=""""0"""" cellspacing=""""0""""><tr><td bgcolor="""""" + colour + """""" width="""""" + Str(w) + """""" height=""""9""""></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' 1970-01-01 was a Thursday." + NL
    t = t + "FUNCTION DayName (d AS String) AS String" + NL
    t = t + "    VAR names AS Array OF String" + NL
    t = t + "    names = [""Thu"", ""Fri"", ""Sat"", ""Sun"", ""Mon"", ""Tue"", ""Wed""]" + NL
    t = t + "    RETURN names[DayNum(d) MOD 7]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the dashboard" + NL
    t = t + "" + NL
    t = t + "VAR pKey AS Array OF String      ' pages" + NL
    t = t + "VAR pCnt AS Array OF Integer" + NL
    t = t + "VAR tKey AS Array OF String      ' their titles" + NL
    t = t + "VAR tVal AS Array OF String" + NL
    t = t + "VAR bKey AS Array OF String      ' browsers" + NL
    t = t + "VAR bCnt AS Array OF Integer" + NL
    t = t + "VAR rKey AS Array OF String      ' referrers" + NL
    t = t + "VAR rCnt AS Array OF Integer" + NL
    t = t + "VAR mKey AS Array OF String      ' machines" + NL
    t = t + "VAR mCnt AS Array OF Integer" + NL
    t = t + "VAR vKey AS Array OF String      ' visitors, all the days together" + NL
    t = t + "VAR hourCnt AS Array OF Integer" + NL
    t = t + "VAR dayDate AS Array OF String" + NL
    t = t + "VAR dayHits AS Array OF Integer" + NL
    t = t + "VAR dayVisitors AS Array OF Integer" + NL
    t = t + "" + NL
    t = t + "SUB Tally (keys AS Array OF String, counts AS Array OF Integer, key AS String, n AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = keys.IndexOf(key)" + NL
    t = t + "    IF i < 0 THEN" + NL
    t = t + "        keys.Add(key)" + NL
    t = t + "        counts.Add(n)" + NL
    t = t + "    ELSE" + NL
    t = t + "        counts[i] = counts[i] + n" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Reads the rollups of the last days days, oldest first." + NL
    t = t + "SUB LoadDays (id AS String, days AS Integer)" + NL
    t = t + "    VAR t0 AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR d AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR hits AS Integer" + NL
    t = t + "    VAR seen AS Integer" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    FOR i = 0 TO 23" + NL
    t = t + "        hourCnt.Add(0)" + NL
    t = t + "    NEXT" + NL
    t = t + "    t0 = DayNum(TIME.Date)" + NL
    t = t + "    FOR i = days - 1 TO 0 STEP -1" + NL
    t = t + "        d = DateOf(t0 - i)" + NL
    t = t + "        hits = 0" + NL
    t = t + "        seen = 0" + NL
    t = t + "        FOR EACH line IN ReadOr(SiteDir(id) + ""\"" + DayFile(d) + "".TXT"", """").Split(Chr(10))" + NL
    t = t + "            p = line.Split(""|"")" + NL
    t = t + "            IF p.Count < 3 THEN CONTINUE" + NL
    t = t + "            n = Int(Val(p[2]))" + NL
    t = t + "            SELECT CASE p[0]" + NL
    t = t + "                CASE ""h""" + NL
    t = t + "                    hits = n" + NL
    t = t + "                CASE ""u""" + NL
    t = t + "                    seen = seen + 1" + NL
    t = t + "                    IF vKey.IndexOf(p[1]) < 0 THEN vKey.Add(p[1])" + NL
    t = t + "                CASE ""p""" + NL
    t = t + "                    Tally(pKey, pCnt, p[1], n)" + NL
    t = t + "                CASE ""t""" + NL
    t = t + "                    at = tKey.IndexOf(p[1])" + NL
    t = t + "                    IF at < 0 THEN" + NL
    t = t + "                        tKey.Add(p[1])" + NL
    t = t + "                        tVal.Add(p[2])" + NL
    t = t + "                    ELSE" + NL
    t = t + "                        tVal[at] = p[2]" + NL
    t = t + "                    END IF" + NL
    t = t + "                CASE ""b""" + NL
    t = t + "                    Tally(bKey, bCnt, p[1], n)" + NL
    t = t + "                CASE ""o""" + NL
    t = t + "                    at = Int(Val(p[1]))" + NL
    t = t + "                    IF at >= 0 AND at < 24 THEN hourCnt[at] = hourCnt[at] + n" + NL
    t = t + "                CASE ""r""" + NL
    t = t + "                    Tally(rKey, rCnt, p[1], n)" + NL
    t = t + "                CASE ""m""" + NL
    t = t + "                    Tally(mKey, mCnt, p[1], n)" + NL
    t = t + "            END SELECT" + NL
    t = t + "        NEXT" + NL
    t = t + "        dayDate.Add(d)" + NL
    t = t + "        dayHits.Add(hits)" + NL
    t = t + "        dayVisitors.Add(seen)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The positions of the biggest counts, biggest first, at most most of them." + NL
    t = t + "FUNCTION TopOf (counts AS Array OF Integer, most AS Integer) AS Array OF Integer" + NL
    t = t + "    VAR keys AS Array OF String" + NL
    t = t + "    VAR out AS Array OF Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO counts.Count - 1" + NL
    t = t + "        keys.Add(Str(counts[i]).PadLeft(9) + ""|"" + Str(100000 - i).PadLeft(6) + ""|"" + Str(i))" + NL
    t = t + "    NEXT" + NL
    t = t + "    keys.Sort()" + NL
    t = t + "    keys.Reverse()" + NL
    t = t + "    FOR i = 0 TO MATH.Min(most, keys.Count) - 1" + NL
    t = t + "        out.Add(Int(Val(keys[i].Split(""|"")[2])))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION SumOf (counts AS Array OF Integer) AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    FOR EACH c IN counts" + NL
    t = t + "        n = n + c" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Pct (n AS Integer, total AS Integer) AS String" + NL
    t = t + "    IF total < 1 THEN RETURN ""0%""" + NL
    t = t + "    RETURN Str(MATH.Round(n * 100 / total)) + ""%""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A Top list: what, how many, a bar. kind: ""p"" pages, ""r"" referrers," + NL
    t = t + "' ""b"" browsers, ""m"" machines." + NL
    t = t + "FUNCTION TopTable (title AS String, kind AS String, keys AS Array OF String, counts AS Array OF Integer, colour AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR k AS String" + NL
    t = t + "    VAR shown AS String" + NL
    t = t + "    VAR total AS Integer" + NL
    t = t + "    VAR most AS Integer" + NL
    t = t + "    VAR order AS Array OF Integer" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    total = SumOf(counts)" + NL
    t = t + "    s = BoxTop(title) + ""<table cellpadding=""""2"""" cellspacing=""""0"""" width=""""100%"""">""" + NL
    t = t + "    IF keys.Count = 0 THEN RETURN s + ""<tr><td><font size=""""2"""" color=""""#808080"""">Nothing yet.</font></td></tr></table>""" + NL
    t = t + "    order = TopOf(counts, TOPN)" + NL
    t = t + "    most = counts[order[0]]" + NL
    t = t + "    FOR EACH i IN order" + NL
    t = t + "        k = Unesc(keys[i])" + NL
    t = t + "        shown = H(k)" + NL
    t = t + "        IF kind = ""p"" THEN" + NL
    t = t + "            at = tKey.IndexOf(keys[i])" + NL
    t = t + "            IF at >= 0 THEN shown = ""<b>"" + H(Clip(Unesc(tVal[at]), 50)) + ""</b><br><font size=""""1"""">"" + H(k) + ""</font>""" + NL
    t = t + "        ELSEIF kind = ""r"" AND k.StartsWith(""http://"") THEN" + NL
    t = t + "            shown = ""<a href="""""" + H(k) + """""">"" + H(Clip(k, 60)) + ""</a>""" + NL
    t = t + "        END IF" + NL
    t = t + "        s = s + ""<tr><td width=""""45%""""><font size=""""2"""">"" + shown + ""</font></td><td align=""""right"""" width=""""60""""><font size=""""2"""">"" + Commas(counts[i]) + ""</font></td>"" _" + NL
    t = t + "              + ""<td align=""""right"""" width=""""40""""><font size=""""1"""">"" + Pct(counts[i], total) + ""</font></td><td>"" + Bar(counts[i], most, colour, 160) + ""</td></tr>""" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF keys.Count > TOPN THEN s = s + ""<tr><td colspan=""""4""""><font size=""""1"""" color=""""#808080"""">The top "" + Str(TOPN) + "" of "" + Str(keys.Count) + "".</font></td></tr>""" + NL
    t = t + "    RETURN s + ""</table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Everything about a site over the last days days. pub: the public page," + NL
    t = t + "' which shows no visitor's address." + NL
    t = t + "FUNCTION Dashboard (line AS String, days AS Integer, pub AS Bool) AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR hits AS Integer" + NL
    t = t + "    VAR most AS Integer" + NL
    t = t + "    VAR total AS Array OF String" + NL
    t = t + "    id = SF(line, 0)" + NL
    t = t + "    LoadDays(id, days)" + NL
    t = t + "    hits = SumOf(dayHits)" + NL
    t = t + "    total = ReadOr(SiteDir(id) + ""\TOTAL.TXT"", ""0|"" + TIME.Date).Split(""|"")" + NL
    t = t + "    ' the numbers that matter" + NL
    t = t + "    s = ""<table width=""""100%"""" cellpadding=""""6"""" cellspacing=""""2""""><tr>"" _" + NL
    t = t + "      + ""<td bgcolor=""""#E8F0F8"""" align=""""center""""><font size=""""5""""><b>"" + Commas(hits) + ""</b></font><br><font size=""""1"""">HITS</font></td>"" _" + NL
    t = t + "      + ""<td bgcolor=""""#E8F0F8"""" align=""""center""""><font size=""""5""""><b>"" + Commas(vKey.Count) + ""</b></font><br><font size=""""1"""">UNIQUE VISITORS</font></td>"" _" + NL
    t = t + "      + ""<td bgcolor=""""#E8F0F8"""" align=""""center""""><font size=""""5""""><b>"" + Commas(pKey.Count) + ""</b></font><br><font size=""""1"""">PAGES SEEN</font></td>"" _" + NL
    t = t + "      + ""<td bgcolor=""""#E8F0F8"""" align=""""center""""><font size=""""5""""><b>"" + Commas(Int(Val(total[0]))) + ""</b></font><br><font size=""""1"""">ALL TIME, SINCE "" + H(total[1].Trim()) + ""</font></td>"" _" + NL
    t = t + "      + ""</tr></table>""" + NL
    t = t + "    ' hits and visitors a day" + NL
    t = t + "    most = 1" + NL
    t = t + "    FOR i = 0 TO dayHits.Count - 1" + NL
    t = t + "        most = MATH.Max(most, dayHits[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    s = s + BoxTop(""Hits and Visitors by Day"") + ""<table cellpadding=""""1"""" cellspacing=""""0"""">""" + NL
    t = t + "    FOR i = dayHits.Count - 1 TO 0 STEP -1" + NL
    t = t + "        s = s + ""<tr><td><font size=""""1"""">"" + DayName(dayDate[i]) + "" "" + dayDate[i].Substring(5, 5) + ""</font></td><td align=""""right"""" width=""""40""""><font size=""""1"""">"" + Str(dayHits[i]) + ""<br>"" + Str(dayVisitors[i]) + ""</font></td><td>"" _" + NL
    t = t + "              + Bar(dayHits[i], most, ""#3366CC"", BARW) + Bar(dayVisitors[i], most, ""#FF9900"", BARW) + ""</td></tr>""" + NL
    t = t + "    NEXT" + NL
    t = t + "    s = s + ""</table><font size=""""1""""><font color=""""#3366CC"""">&#9632;</font> hits &nbsp; <font color=""""#FF9900"""">&#9632;</font> unique visitors</font><br><br>""" + NL
    t = t + "    ' the hours, as a histogram of upright bars" + NL
    t = t + "    most = 1" + NL
    t = t + "    FOR i = 0 TO 23" + NL
    t = t + "        most = MATH.Max(most, hourCnt[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    s = s + BoxTop(""Hits by Hour of the Day"") + ""<table cellpadding=""""0"""" cellspacing=""""2""""><tr>""" + NL
    t = t + "    FOR i = 0 TO 23" + NL
    t = t + "        s = s + ""<td valign=""""bottom"""" align=""""center""""><font size=""""1"""">"" + Str(hourCnt[i]) + ""</font>""" + NL
    t = t + "        IF hourCnt[i] > 0 THEN s = s + ""<table cellpadding=""""0"""" cellspacing=""""0""""><tr><td bgcolor=""""#339966"""" width=""""14"""" height="""""" + Str(MATH.Max(1, Int(60 * hourCnt[i] / most))) + """"""></td></tr></table>""" + NL
    t = t + "        s = s + ""</td>""" + NL
    t = t + "    NEXT" + NL
    t = t + "    s = s + ""</tr><tr>""" + NL
    t = t + "    FOR i = 0 TO 23" + NL
    t = t + "        s = s + ""<td align=""""center""""><font size=""""1"""">"" + Str(i) + ""</font></td>""" + NL
    t = t + "    NEXT" + NL
    t = t + "    s = s + ""</tr></table><br>""" + NL
    t = t + "    s = s + TopTable(""Top Pages"", ""p"", pKey, pCnt, ""#3366CC"") + ""<br>""" + NL
    t = t + "    s = s + TopTable(""Top Referrers (where visitors came from)"", ""r"", rKey, rCnt, ""#CC6633"") + ""<br>""" + NL
    t = t + "    s = s + TopTable(""Browsers"", ""b"", bKey, bCnt, ""#9933CC"") + ""<br>""" + NL
    t = t + "    IF NOT pub THEN s = s + TopTable(""Visiting Machines"", ""m"", mKey, mCnt, ""#339966"") + ""<br>""" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- live" + NL
    t = t + "" + NL
    t = t + "' The last 20 hits, newest first, one line each. pub leaves out addresses." + NL
    t = t + "FUNCTION LiveLines (id AS String, pub AS Bool) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR when AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    lines = ReadOr(SiteDir(id) + ""\LIVE.TXT"", """").Lines()" + NL
    t = t + "    FOR i = lines.Count - 1 TO 0 STEP -1" + NL
    t = t + "        p = lines[i].Split(""|"")" + NL
    t = t + "        IF p.Count < 6 THEN CONTINUE" + NL
    t = t + "        when = p[0]" + NL
    t = t + "        IF when.StartsWith(TIME.Date) THEN when = when.Substring(11, when.Length - 11)" + NL
    t = t + "        s = when + ""  """ + NL
    t = t + "        IF NOT pub THEN s = s + Unesc(p[1]).PadRight(12) + ""  """ + NL
    t = t + "        s = s + Unesc(p[2]).PadRight(16) + ""  "" + Unesc(p[3])" + NL
    t = t + "        IF p[5] <> """" THEN s = s + ""  from "" + Unesc(p[5])" + NL
    t = t + "        out.Add(Clip(s, 150))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The Live box: a line per hit, each in a span that the page's JavaScript" + NL
    t = t + "' fills in again from live.asp every few seconds (Simxplorer). Voyager" + NL
    t = t + "' gets a Reload link, and live.asp reloads itself." + NL
    t = t + "FUNCTION LiveBox (id AS String, pub AS Bool) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR rows AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR url AS String" + NL
    t = t + "    url = ""live.asp?s="" + id" + NL
    t = t + "    IF pub THEN url = url + ""&pub=1""" + NL
    t = t + "    rows = LiveLines(id, pub)" + NL
    t = t + "    s = BoxTop(""Live: the Last "" + Str(LIVEROWS) + "" Hits"") + ""<table width=""""100%"""" cellpadding=""""4"""" cellspacing=""""0"""" bgcolor=""""#000000""""><tr><td><font color=""""#00FF00"""" size=""""2""""><tt>""" + NL
    t = t + "    FOR i = 0 TO LIVEROWS - 1" + NL
    t = t + "        IF i < rows.Count THEN" + NL
    t = t + "            s = s + ""<span id=""""live"" + Str(i) + """""">"" + H(rows[i]) + ""</span><br>""" + NL
    t = t + "        ELSE" + NL
    t = t + "            s = s + ""<span id=""""live"" + Str(i) + """"""></span><br>""" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF rows.Count = 0 THEN s = s + ""Waiting for the first visitor...""" + NL
    t = t + "    s = s + ""</tt></font></td></tr></table><font size=""""1""""><span id=""""livestate"""">As of "" + TIME.Clock + "".</span> <a href="""""" + url + """""">Reload</a> &middot; <a href="""""" + url + ""&w=1"""">Watch live</a> (reloads itself)</font>"" _" + NL
    t = t + "      + ""<script language=""""JavaScript"""">"" + Chr(10) _" + NL
    t = t + "      + ""var liveN = 0;"" + Chr(10) _" + NL
    t = t + "      + ""function liveTick() {"" + Chr(10) _" + NL
    t = t + "      + ""  var x = window.XMLHttpRequest ? new XMLHttpRequest() : new ActiveXObject(""""Microsoft.XMLHTTP"""");"" + Chr(10) _" + NL
    t = t + "      + ""  x.onreadystatechange = function () {"" + Chr(10) _" + NL
    t = t + "      + ""    if (x.readyState != 4 || x.status != 200) return;"" + Chr(10) _" + NL
    t = t + "      + ""    var rows = x.responseText.split(""""\n"""");"" + Chr(10) _" + NL
    t = t + "      + ""    for (var i = 0; i < "" + Str(LIVEROWS) + ""; i++) document.getElementById(""""live"""" + i).innerText = i < rows.length ? rows[i] : """""""";"" + Chr(10) _" + NL
    t = t + "      + ""    liveN++;"" + Chr(10) _" + NL
    t = t + "      + ""    document.getElementById(""""livestate"""").innerText = """"Live: updated """" + liveN + """" times without reloading."""";"" + Chr(10) _" + NL
    t = t + "      + ""  };"" + Chr(10) _" + NL
    t = t + "      + ""  x.open(""""GET"""", """""" + url + ""&f=text&n="""" + liveN, true);"" + Chr(10) _" + NL
    t = t + "      + ""  x.send(null);"" + Chr(10) _" + NL
    t = t + "      + ""}"" + Chr(10) _" + NL
    t = t + "      + ""setInterval(""""liveTick()"""", 5000);"" + Chr(10) _" + NL
    t = t + "      + ""</script>""" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The range links: Today, 7 days, 30 days." + NL
    t = t + "FUNCTION RangeBar (page AS String, id AS String, days AS Integer) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    VAR names AS Array OF String" + NL
    t = t + "    VAR spans AS Array OF Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    names = [""Today"", ""Last 7 days"", ""Last 30 days""]" + NL
    t = t + "    spans = [1, 7, 30]" + NL
    t = t + "    s = ""<font size=""""2""""><b>Show:</b> """ + NL
    t = t + "    FOR i = 0 TO 2" + NL
    t = t + "        d = spans[i]" + NL
    t = t + "        IF i > 0 THEN s = s + "" | """ + NL
    t = t + "        IF d = days THEN" + NL
    t = t + "            s = s + ""<b>"" + names[i] + ""</b>""" + NL
    t = t + "        ELSE" + NL
    t = t + "            s = s + ""<a href="""""" + page + ""?s="" + id + ""&r="" + Str(d) + """""">"" + names[i] + ""</a>""" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN s + ""</font>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RangeOf (r AS String) AS Integer" + NL
    t = t + "    IF r = ""7"" THEN RETURN 7" + NL
    t = t + "    IF r = ""30"" THEN RETURN 30" + NL
    t = t + "    RETURN 1" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\WEB\STATS.SPK")
END SUB

SUB File17 ()
    t = ""
    t = t + "' TRACK.SPK - the counting half of SimStats: what hit.asp does for every" + NL
    t = t + "' visit, kept small because it runs on every page view of every site we" + NL
    t = t + "' count. The dashboards import STATS.SPK as well, which builds on this." + NL
    t = t + "'" + NL
    t = t + "' It uses nothing of the web server's (REQUEST, RESPONSE, SERVER): hit.asp" + NL
    t = t + "' hands it what the request said, so it also runs as a plain SPARK program." + NL
    t = t + "'" + NL
    t = t + "' Everything lives under C:\STATDATA, outside C:\WEB:" + NL
    t = t + "'" + NL
    t = t + "'   SITES.TXT            one line per site: id|owner|name|url|public|created|on" + NL
    t = t + "'   HOME.TXT             the id of ""this machine"", the site the installer made" + NL
    t = t + "'   USERS\<user>.TXT     an account, key=value per line" + NL
    t = t + "'   SESSIONS\<id>.TXT    who a sign-in cookie belongs to, and its form token" + NL
    t = t + "'   S\<id>\TOTAL.TXT     hits since the start|the day it started" + NL
    t = t + "'   S\<id>\LIVE.TXT      the last 20 hits, oldest first" + NL
    t = t + "'   S\<id>\<yyyymmdd>.TXT  one day's rollup (see Bump): hits, visitors, pages," + NL
    t = t + "'                        browsers, hours, referrers and machines, counted as" + NL
    t = t + "'                        they come, so a dashboard never reads a raw log" + NL
    t = t + "'   S\<id>\<yyyymmdd>.LOG  the day's raw hits, one line each (then .L2, .L3..." + NL
    t = t + "'                        when a day outgrows one network message). Kept RAWDAYS days." + NL
    t = t + "'" + NL
    t = t + "' A rollup line is kind|key|count:" + NL
    t = t + "'   h|all|n      hits          u|<visitor>|n   one per visitor" + NL
    t = t + "'   p|<path>|n   pages         t|<path>|title  the page's latest title" + NL
    t = t + "'   b|<browser>|n browsers     o|<hour>|n      hours of the day" + NL
    t = t + "'   r|<ref>|n    referrers     m|<address>|n   visiting machines" + NL
    t = t + "'   n|<address>|<visitor>      the visitor id handed to a machine whose" + NL
    t = t + "'                              browser sent no SimStats cookie" + NL
    t = t + "'" + NL
    t = t + "' Visitors: hit.asp gives each browser a cookie (ssvid) on the stats machine." + NL
    t = t + "' Voyager and Simxplorer both send the stats machine's cookies with a picture" + NL
    t = t + "' from it, even on another machine's page, so the cookie is the visitor. A" + NL
    t = t + "' browser that never sends it back is counted once per machine per day." + NL
    t = t + "" + NL
    t = t + "CONST DATADIR = ""C:\STATDATA""" + NL
    t = t + "CONST VIDCOOKIE = ""ssvid""        ' the visitor's id, on the stats machine" + NL
    t = t + "CONST OUTCOOKIE = ""ssout""        ' ""1"": this visitor asked not to be counted" + NL
    t = t + "CONST RAWDAYS = 14               ' days of raw hits kept" + NL
    t = t + "CONST KEEPDAYS = 100             ' days of rollups kept" + NL
    t = t + "CONST LIVEROWS = 20" + NL
    t = t + "CONST LOGMAX = 50000             ' a raw log stays under one network message" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- little helpers" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Text that is safe inside one |-separated line, and back again." + NL
    t = t + "FUNCTION Esc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%"", ""%25"").Replace(""|"", ""%7C"").Replace(Chr(13), """").Replace(Chr(10), ""%0A"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unesc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%0A"", Chr(10)).Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION OnlyFrom (s AS String, allowed AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        IF NOT allowed.Contains(s.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Clip (s AS String, most AS Integer) AS String" + NL
    t = t + "    s = s.Replace(Chr(13), "" "").Replace(Chr(10), "" "").Trim()" + NL
    t = t + "    IF s.Length > most THEN s = s.Substring(0, most)" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The invisible tag: one white pixel." + NL
    t = t + "FUNCTION Dot () AS String" + NL
    t = t + "    RETURN ""SIM95PIC 1 1"" + Chr(10) + ""F"" + Chr(10)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NewToken () AS String" + NL
    t = t + "    RETURN Hex(268435456 + Rnd(1879048191))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A site id or a visitor id: 8 hex digits." + NL
    t = t + "FUNCTION IsId (s AS String) AS Bool" + NL
    t = t + "    IF s.Length <> 8 THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyFrom(s, ""0123456789ABCDEF"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the calendar" + NL
    t = t + "' Days are counted from 1970-01-01, so ""seven days ago"" works across months." + NL
    t = t + "" + NL
    t = t + "FUNCTION DayNum (d AS String) AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR m AS Integer" + NL
    t = t + "    VAR dd AS Integer" + NL
    t = t + "    VAR era AS Integer" + NL
    t = t + "    VAR yoe AS Integer" + NL
    t = t + "    VAR doy AS Integer" + NL
    t = t + "    y = Int(Val(d.Substring(0, 4)))" + NL
    t = t + "    m = Int(Val(d.Substring(5, 2)))" + NL
    t = t + "    dd = Int(Val(d.Substring(8, 2)))" + NL
    t = t + "    IF m <= 2 THEN y = y - 1" + NL
    t = t + "    era = Int(y / 400)" + NL
    t = t + "    yoe = y - era * 400" + NL
    t = t + "    doy = Int((153 * ((m + 9) MOD 12) + 2) / 5) + dd - 1" + NL
    t = t + "    RETURN era * 146097 + yoe * 365 + Int(yoe / 4) - Int(yoe / 100) + doy - 719468" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION DateOf (n AS Integer) AS String" + NL
    t = t + "    VAR z AS Integer" + NL
    t = t + "    VAR era AS Integer" + NL
    t = t + "    VAR doe AS Integer" + NL
    t = t + "    VAR yoe AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR doy AS Integer" + NL
    t = t + "    VAR mp AS Integer" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    VAR m AS Integer" + NL
    t = t + "    z = n + 719468" + NL
    t = t + "    era = Int(z / 146097)" + NL
    t = t + "    doe = z - era * 146097" + NL
    t = t + "    yoe = Int((doe - Int(doe / 1460) + Int(doe / 36524) - Int(doe / 146096)) / 365)" + NL
    t = t + "    y = yoe + era * 400" + NL
    t = t + "    doy = doe - (365 * yoe + Int(yoe / 4) - Int(yoe / 100))" + NL
    t = t + "    mp = Int((5 * doy + 2) / 153)" + NL
    t = t + "    d = doy - Int((153 * mp + 2) / 5) + 1" + NL
    t = t + "    IF mp < 10 THEN" + NL
    t = t + "        m = mp + 3" + NL
    t = t + "    ELSE" + NL
    t = t + "        m = mp - 9" + NL
    t = t + "    END IF" + NL
    t = t + "    IF m <= 2 THEN y = y + 1" + NL
    t = t + "    RETURN Str(y) + ""-"" + Str(100 + m).Substring(1, 2) + ""-"" + Str(100 + d).Substring(1, 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ""2026-10-01"" is in 20261001.TXT and 20261001.LOG" + NL
    t = t + "FUNCTION DayFile (d AS String) AS String" + NL
    t = t + "    RETURN d.Replace(""-"", """")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- sites" + NL
    t = t + "" + NL
    t = t + "' The line of site id, or """"." + NL
    t = t + "FUNCTION SiteLine (id AS String) AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    IF NOT IsId(id) THEN RETURN """"" + NL
    t = t + "    text = Chr(10) + ReadOr(DATADIR + ""\SITES.TXT"", """")" + NL
    t = t + "    at = text.IndexOf(Chr(10) + id + ""|"")" + NL
    t = t + "    IF at < 0 THEN RETURN """"" + NL
    t = t + "    text = text.Substring(at + 1, text.Length - at - 1)" + NL
    t = t + "    IF text.IndexOf(Chr(10)) >= 0 THEN text = text.Substring(0, text.IndexOf(Chr(10)))" + NL
    t = t + "    RETURN text" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Field i of a site's line: 0 id, 1 owner, 2 name, 3 url, 4 public, 5 created, 6 on" + NL
    t = t + "FUNCTION SF (line AS String, i AS Integer) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    IF i >= p.Count THEN RETURN """"" + NL
    t = t + "    RETURN Unesc(p[i])" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION SiteDir (id AS String) AS String" + NL
    t = t + "    RETURN DATADIR + ""\S\"" + id" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION TotalHits (id AS String) AS Integer" + NL
    t = t + "    RETURN Int(Val(ReadOr(SiteDir(id) + ""\TOTAL.TXT"", ""0"").Split(""|"")[0]))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- browsers" + NL
    t = t + "' The same reading as Simxplorer's SNIFF.SPK, from the User-Agent:" + NL
    t = t + "'   Voyager/1.1 (SIM95)                                  Voyager 1.1" + NL
    t = t + "'   Mozilla/2.0 (compatible; Simxplorer 3.02; SIM95)     Simxplorer 3.02" + NL
    t = t + "" + NL
    t = t + "FUNCTION BrowserOf (ua AS String) AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    ua = ua.Trim()" + NL
    t = t + "    IF ua.Contains(""Simxplorer"") THEN" + NL
    t = t + "        v = ua.Substring(ua.IndexOf(""Simxplorer"") + 10, ua.Length - ua.IndexOf(""Simxplorer"") - 10)" + NL
    t = t + "        RETURN Clip(""Simxplorer "" + v.Split("";"")[0].Split("")"")[0].Trim(), 40)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ua = """" THEN RETURN ""Unknown""" + NL
    t = t + "    IF NOT ua.Contains(""/"") THEN RETURN Clip(ua.Split("" "")[0], 40)" + NL
    t = t + "    RETURN Clip(ua.Split(""/"")[0].Split("" "")[0] + "" "" + ua.Split(""/"")[1].Split("" "")[0].Trim(), 40)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Crawlers are not visitors." + NL
    t = t + "FUNCTION IsRobot (ua AS String) AS Bool" + NL
    t = t + "    ua = ua.Lower()" + NL
    t = t + "    RETURN ua.StartsWith(""asksim/"") OR ua.Contains(""crawler"") OR ua.Contains(""spider"") OR ua.Contains(""robot"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- counting" + NL
    t = t + "" + NL
    t = t + "' Adds one to kind|key in a rollup (text starts with a line break). A day" + NL
    t = t + "' keeps at most most different keys of a kind; the rest go under (other)." + NL
    t = t + "FUNCTION Bump (text AS String, kind AS String, key AS String, most AS Integer) AS String" + NL
    t = t + "    VAR head AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    VAR stop AS Integer" + NL
    t = t + "    head = Chr(10) + kind + ""|"" + key + ""|""" + NL
    t = t + "    at = text.IndexOf(head)" + NL
    t = t + "    IF at < 0 THEN" + NL
    t = t + "        IF text.Split(Chr(10) + kind + ""|"").Count > most THEN" + NL
    t = t + "            head = Chr(10) + kind + ""|(other)|""" + NL
    t = t + "            at = text.IndexOf(head)" + NL
    t = t + "        END IF" + NL
    t = t + "        IF at < 0 THEN RETURN text + head.Substring(1, head.Length - 1) + ""1"" + Chr(10)" + NL
    t = t + "    END IF" + NL
    t = t + "    at = at + head.Length" + NL
    t = t + "    rest = text.Substring(at, text.Length - at)" + NL
    t = t + "    stop = rest.IndexOf(Chr(10))" + NL
    t = t + "    RETURN text.Substring(0, at) + Str(Int(Val(rest.Substring(0, stop))) + 1) + rest.Substring(stop, rest.Length - stop)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Sets kind|key|value, replacing what was there." + NL
    t = t + "FUNCTION SetLine (text AS String, kind AS String, key AS String, value AS String) AS String" + NL
    t = t + "    VAR head AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    head = Chr(10) + kind + ""|"" + key + ""|""" + NL
    t = t + "    at = text.IndexOf(head)" + NL
    t = t + "    IF at < 0 THEN RETURN text + head.Substring(1, head.Length - 1) + value + Chr(10)" + NL
    t = t + "    at = at + head.Length" + NL
    t = t + "    rest = text.Substring(at, text.Length - at)" + NL
    t = t + "    RETURN text.Substring(0, at) + value + rest.Substring(rest.IndexOf(Chr(10)), rest.Length - rest.IndexOf(Chr(10)))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Two hits for one site may arrive at once, and each rewrites the day's" + NL
    t = t + "' rollup. The lock is a folder: FS.MakeDir fails when it is already there, so" + NL
    t = t + "' taking it is one step (SimPal locks its ledger the same way). A lock left by" + NL
    t = t + "' a page that died is cleared after a few seconds." + NL
    t = t + "FUNCTION TakeLock (id AS String) AS Bool" + NL
    t = t + "    VAR tries AS Integer" + NL
    t = t + "    VAR at AS String" + NL
    t = t + "    WHILE tries < 100" + NL
    t = t + "        tries = tries + 1" + NL
    t = t + "        TRY" + NL
    t = t + "            FS.MakeDir(SiteDir(id) + ""\LOCK"")" + NL
    t = t + "            FS.Write(SiteDir(id) + ""\LOCK\AT.TXT"", Str(TIME.Now))" + NL
    t = t + "            RETURN TRUE" + NL
    t = t + "        CATCH err" + NL
    t = t + "            at = ReadOr(SiteDir(id) + ""\LOCK\AT.TXT"", """")" + NL
    t = t + "            IF (at <> """" AND TIME.Now - Int(Val(at)) > 5) OR (at = """" AND tries MOD 25 = 0) THEN" + NL
    t = t + "                DropLock(id)" + NL
    t = t + "            ELSE" + NL
    t = t + "                SYS.Sleep(10)" + NL
    t = t + "            END IF" + NL
    t = t + "        END TRY" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB DropLock (id AS String)" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(SiteDir(id) + ""\LOCK\AT.TXT"") THEN FS.Delete(SiteDir(id) + ""\LOCK\AT.TXT"")" + NL
    t = t + "        IF FS.Exists(SiteDir(id) + ""\LOCK"") THEN FS.Delete(SiteDir(id) + ""\LOCK"")" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One hit: the raw line, and the day's rollup, the last 20 and the total." + NL
    t = t + "' vid is the visitor's cookie ("""" if their browser sent none). Returns the" + NL
    t = t + "' visitor id to hand them in a cookie, or """" when theirs is fine." + NL
    t = t + "FUNCTION RecordHit (id AS String, day AS String, clock AS String, addr AS String, vid AS String, agent AS String, path AS String, title AS String, ref AS String) AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR file AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR fresh AS Bool" + NL
    t = t + "    VAR given AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR browser AS String" + NL
    t = t + "    VAR log AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR live AS Array OF String" + NL
    t = t + "    VAR total AS Array OF String" + NL
    t = t + "    dir = SiteDir(id)" + NL
    t = t + "    IF NOT FS.Exists(DATADIR + ""\S"") THEN FS.MakeDir(DATADIR + ""\S"")" + NL
    t = t + "    IF NOT FS.Exists(dir) THEN FS.MakeDir(dir)" + NL
    t = t + "    path = Esc(Clip(path, 120))" + NL
    t = t + "    IF path = """" THEN path = ""/""" + NL
    t = t + "    title = Esc(Clip(title, 80))" + NL
    t = t + "    ref = Esc(Clip(ref, 150))" + NL
    t = t + "    addr = Esc(Clip(addr, 40))" + NL
    t = t + "    browser = Esc(BrowserOf(agent))" + NL
    t = t + "    IF NOT TakeLock(id) THEN RETURN """"" + NL
    t = t + "    file = dir + ""\"" + DayFile(day) + "".TXT""" + NL
    t = t + "    IF FS.Exists(file) THEN" + NL
    t = t + "        text = Chr(10) + FS.Read(file)" + NL
    t = t + "    ELSE" + NL
    t = t + "        text = Chr(10)" + NL
    t = t + "        fresh = TRUE" + NL
    t = t + "    END IF" + NL
    t = t + "    ' who it is: their cookie, or what this machine was given today" + NL
    t = t + "    IF NOT IsId(vid) THEN" + NL
    t = t + "        at = text.IndexOf(Chr(10) + ""n|"" + addr + ""|"")" + NL
    t = t + "        IF at >= 0 THEN" + NL
    t = t + "            vid = text.Substring(at + addr.Length + 4, 8)" + NL
    t = t + "        ELSE" + NL
    t = t + "            vid = NewToken()" + NL
    t = t + "            text = text + ""n|"" + addr + ""|"" + vid + Chr(10)" + NL
    t = t + "        END IF" + NL
    t = t + "        given = vid" + NL
    t = t + "    END IF" + NL
    t = t + "    text = Bump(text, ""h"", ""all"", 1)" + NL
    t = t + "    text = Bump(text, ""u"", vid, 1000)" + NL
    t = t + "    text = Bump(text, ""p"", path, 200)" + NL
    t = t + "    IF title <> """" THEN text = SetLine(text, ""t"", path, title)" + NL
    t = t + "    text = Bump(text, ""b"", browser, 50)" + NL
    t = t + "    text = Bump(text, ""o"", clock.Substring(0, 2), 24)" + NL
    t = t + "    IF ref <> """" THEN text = Bump(text, ""r"", ref, 200)" + NL
    t = t + "    text = Bump(text, ""m"", addr, 1000)" + NL
    t = t + "    FS.Write(file, text.Substring(1, text.Length - 1))" + NL
    t = t + "    ' the raw line, in the day's log (or the next part of it)" + NL
    t = t + "    log = dir + ""\"" + DayFile(day) + "".LOG""" + NL
    t = t + "    n = 1" + NL
    t = t + "    WHILE FS.Exists(log) AND n < 10" + NL
    t = t + "        IF FS.Size(log) < LOGMAX THEN BREAK" + NL
    t = t + "        n = n + 1" + NL
    t = t + "        log = dir + ""\"" + DayFile(day) + "".L"" + Str(n)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF n < 10 THEN FS.Append(log, clock + ""|"" + addr + ""|"" + vid + ""|"" + browser + ""|"" + path + ""|"" + title + ""|"" + ref + Chr(10))" + NL
    t = t + "    ' the last 20, for the Live box" + NL
    t = t + "    live = ReadOr(dir + ""\LIVE.TXT"", """").Lines()" + NL
    t = t + "    IF live.Count > 0 THEN" + NL
    t = t + "        IF live[live.Count - 1] = """" THEN live.RemoveAt(live.Count - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    live.Add(day + "" "" + clock + ""|"" + addr + ""|"" + browser + ""|"" + path + ""|"" + title + ""|"" + ref)" + NL
    t = t + "    WHILE live.Count > LIVEROWS" + NL
    t = t + "        live.RemoveAt(0)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    FS.Write(dir + ""\LIVE.TXT"", live.Join(Chr(10)) + Chr(10))" + NL
    t = t + "    total = ReadOr(dir + ""\TOTAL.TXT"", ""0|"" + day).Split(""|"")" + NL
    t = t + "    FS.Write(dir + ""\TOTAL.TXT"", Str(Int(Val(total[0])) + 1) + ""|"" + total[1].Trim())" + NL
    t = t + "    IF fresh THEN Prune(id, day)" + NL
    t = t + "    DropLock(id)" + NL
    t = t + "    RETURN given" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The first hit of a day clears out raw logs older than RAWDAYS and rollups" + NL
    t = t + "' older than KEEPDAYS." + NL
    t = t + "SUB Prune (id AS String, day AS String)" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR oldRaw AS String" + NL
    t = t + "    VAR oldDay AS String" + NL
    t = t + "    oldRaw = DayFile(DateOf(DayNum(day) - RAWDAYS))" + NL
    t = t + "    oldDay = DayFile(DateOf(DayNum(day) - KEEPDAYS))" + NL
    t = t + "    FOR EACH f IN FS.List(SiteDir(id))" + NL
    t = t + "        IF f.EndsWith(""\"") OR f.Length < 12 THEN CONTINUE" + NL
    t = t + "        IF NOT OnlyFrom(f.Substring(0, 8), ""0123456789"") THEN CONTINUE" + NL
    t = t + "        IF f.Substring(9, 1).Upper() = ""L"" AND f.Substring(0, 8) < oldRaw THEN FS.Delete(SiteDir(id) + ""\"" + f)" + NL
    t = t + "        IF f.Substring(9, 3).Upper() = ""TXT"" AND f.Substring(0, 8) < oldDay THEN FS.Delete(SiteDir(id) + ""\"" + f)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the badge" + NL
    t = t + "' An 88x31 counter in the old style: green LED digits in a black window, on" + NL
    t = t + "' the picture in BADGE.PIC (which has the window empty)." + NL
    t = t + "" + NL
    t = t + "CONST LED = """"" + NL
    t = t + "" + NL
    t = t + "FUNCTION Badge (template AS String, count AS Integer) AS String" + NL
    t = t + "    VAR rows AS Array OF String" + NL
    t = t + "    VAR digits AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR r AS Integer" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    VAR seg AS String" + NL
    t = t + "    rows = template.Replace(Chr(13), """").Split(Chr(10))" + NL
    t = t + "    IF rows.Count < 32 THEN RETURN Dot()" + NL
    t = t + "    digits = Str(count)" + NL
    t = t + "    IF digits.Length < 5 THEN digits = (""00000"" + digits).Substring(digits.Length, 5)" + NL
    t = t + "    IF digits.Length > 7 THEN digits = ""9999999""" + NL
    t = t + "    x = 44 - Int((digits.Length * 6 - 1) / 2)" + NL
    t = t + "    FOR i = 0 TO digits.Length - 1" + NL
    t = t + "        d = Asc(digits.CharAt(i)) - 48" + NL
    t = t + "        FOR r = 0 TO 6" + NL
    t = t + "            seg = LED.Substring(d * 35 + r * 5, 5).Replace(""1"", ""A"")" + NL
    t = t + "            rows[r + 6] = rows[r + 6].Substring(0, x) + seg + rows[r + 6].Substring(x + 5, rows[r + 6].Length - x - 5)" + NL
    t = t + "        NEXT" + NL
    t = t + "        x = x + 6" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN rows.Join(Chr(10))" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\WEB\TRACK.SPK")
END SUB

' HTTPD.SPK serves INDEX.ASP for a folder only when it has no INDEX.HTM, so the
' stock home page steps aside (to the first free name) instead of being deleted.
SUB MoveHomePage ()
    VAR names AS Array OF String
    VAR name AS String
    IF NOT FS.Exists("C:\WEB\INDEX.HTM") THEN RETURN
    names = ["WELCOME.HTM", "INDEX1.HTM", "INDEX2.HTM", "INDEX3.HTM", "INDEX4.HTM", "INDEX5.HTM", "INDEX6.HTM", "INDEX7.HTM", "INDEX8.HTM", "INDEX9.HTM"]
    FOR EACH name IN names
        IF NOT FS.Exists("C:\WEB\" + name) THEN
            FS.Rename("C:\WEB\INDEX.HTM", "C:\WEB\" + name)
            Print("  moved the old home page to C:\WEB\" + name)
            RETURN
        END IF
    NEXT
    THROW "C:\WEB\INDEX.HTM is in the way and there is nowhere to move it. Rename it yourself and run this again."
END SUB

' Where SimStats keeps its numbers, outside C:\WEB. Also "this machine": a site
' that belongs to nobody (the machine's owner sees it on admin.asp), which the
' SimHost front page counts its visitors with. Its id is in C:\STATDATA\HOME.TXT.
SUB StatsSetup ()
    VAR dirs AS Array OF String
    VAR dir AS String
    VAR id AS String
    VAR robots AS String
    VAR rule AS String
    dirs = ["C:\STATDATA", "C:\STATDATA\USERS", "C:\STATDATA\SESSIONS", "C:\STATDATA\S"]
    FOR EACH dir IN dirs
        IF NOT FS.Exists(dir) THEN FS.MakeDir(dir)
    NEXT
    IF NOT FS.Exists("C:\STATDATA\HOME.TXT") THEN
        id = Hex(268435456 + Rnd(1879048191))
        IF NOT FS.Exists("C:\STATDATA\S\" + id) THEN FS.MakeDir("C:\STATDATA\S\" + id)
        FS.Append("C:\STATDATA\SITES.TXT", id + "||This machine (" + NET.HostName.Upper() + ")|http://" + NET.HostName.Lower() + "/|0|" + TIME.Date + "|1" + NL)
        FS.Write("C:\STATDATA\HOME.TXT", id)
        Print("  made the site " + id + " for this machine itself")
    END IF
    ' AskSim's crawler reads /robots.txt: it has no business with the tag
    rule = "Disallow: /hit.asp"
    IF intoDir <> "" THEN rule = "Disallow: /" + intoDir.Lower() + "/hit.asp"
    robots = ""
    IF FS.Exists("C:\WEB\ROBOTS.TXT") THEN robots = FS.Read("C:\WEB\ROBOTS.TXT")
    IF NOT robots.Contains(rule) THEN
        IF robots = "" THEN robots = "User-agent: *" + NL
        IF NOT robots.EndsWith(NL) THEN robots = robots + NL
        FS.Write("C:\WEB\ROBOTS.TXT", robots + rule + NL)
        Print("  told crawlers to keep off the tag in C:\WEB\ROBOTS.TXT")
    END IF
END SUB
