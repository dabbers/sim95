' VAPOR|id=GEOSIMIE|name=GeoSimies|kind=web|version=e2c90fbb|category=Internet|run=/|files=C:\WEB\BLANK.TPL;C:\WEB\CLASSIC.TPL;C:\WEB\EDIT.ASP;C:\WEB\GEO.SPK;C:\WEB\GEOSIMIE.HTM;C:\WEB\GUEST.ASP;C:\WEB\HOOD.ASP;C:\WEB\INDEX.ASP;C:\WEB\JOIN.ASP;C:\WEB\LOGIN.ASP;C:\WEB\LOGOUT.ASP;C:\WEB\RING.ASP;C:\WEB\RINGS.ASP;C:\WEB\SHRINE.TPL;C:\WEB\SIGNUP.ASP;C:\WEB\STARS.TPL;C:\WEB\UPLOAD.ASP;C:\WEB\CLIPART\BESTVIEW.PIC;C:\WEB\CLIPART\COOLSITE.PIC;C:\WEB\CLIPART\EMAILME.PIC;C:\WEB\CLIPART\GEOLOGO.PIC;C:\WEB\CLIPART\GLOBE.PIC;C:\WEB\CLIPART\GLOBE1.PIC;C:\WEB\CLIPART\GLOBE2.PIC;C:\WEB\CLIPART\GLOBE3.PIC;C:\WEB\CLIPART\GLOBE4.PIC;C:\WEB\CLIPART\NEW.PIC;C:\WEB\CLIPART\RAINBOW.PIC;C:\WEB\CLIPART\STARS.PIC;C:\WEB\CLIPART\UNDERCON.PIC|tasks=|startup=|folder=GEO|about=Free homepages for everybody: neighborhoods, a page editor with templates and clip art, hit counters, guestbooks and webrings. Becomes this machine's home page, or on a SimHost machine gets a folder of its own.
' INSTALL.SPK - puts GeoSimies on this machine. Generated by tools/build-installer.mjs;
' edit the files in geosimies/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. GeoSimies
' becomes this machine's home page: its pages go into C:\WEB (the stock
' INDEX.HTM moves to WELCOME.HTM) and its clip art into C:\WEB\CLIPART.
' Members' homepages get folders of their own there (C:\WEB\AREA95\1001...).
' Everything people write is kept in C:\GEODATA, which is left alone, so
' running this again upgrades GeoSimies without losing anybody's homepage.
' Then open http://YOURNAME/ in Voyager.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)
    ' On a machine set up for several web apps (SimHost: C:\SYSTEM\WEBAPPS.INI
    ' says mode=folders), this one goes in C:\WEB\GEO and leaves the home page alone.
    IF FS.Exists("C:\SYSTEM\WEBAPPS.INI") THEN
        IF FS.Read("C:\SYSTEM\WEBAPPS.INI").Contains("mode=folders") THEN intoDir = "GEO"
    END IF
    IF intoDir <> "" AND NOT FS.Exists("C:\WEB\" + intoDir) THEN FS.MakeDir("C:\WEB\" + intoDir)
    IF NOT FS.Exists(Dest("C:\WEB\CLIPART")) THEN FS.MakeDir(Dest("C:\WEB\CLIPART"))

    IF intoDir = "" THEN MoveHomePage()
    File0()
    File1()
    File2()
    File3()
    File4()
    File5()
    File6()
    File7()
    File8()
    File9()
    File10()
    File11()
    File12()
    File13()
    File14()
    File15()
    File16()
    File17()
    File18()
    File19()
    File20()
    File21()
    File22()
    File23()
    File24()
    File25()
    File26()
    File27()
    File28()
    File29()
    Print("GeoSimies is installed (30 files).")

    IF intoDir = "" THEN
        Print("Open http://" + NET.HostName.Lower() + "/ in Voyager.")
    ELSE
        Print("Open http://" + NET.HostName.Lower() + "/" + intoDir.Lower() + "/ in Voyager.")
    END IF
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "<html>" + NL
    t = t + "<head>" + NL
    t = t + "<title>{TITLE}</title>" + NL
    t = t + "</head>" + NL
    t = t + "<body bgcolor=""#FFFFFF"">" + NL
    t = t + "<h1>{TITLE}</h1>" + NL
    t = t + "<p>Welcome to my homepage!!!</p>" + NL
    t = t + "<p><!--COUNTER--></p>" + NL
    t = t + "</body>" + NL
    t = t + "</html>" + NL
    Put("C:\WEB\BLANK.TPL")
END SUB

SUB File1 ()
    t = ""
    t = t + "<html>" + NL
    t = t + "<head>" + NL
    t = t + "<title>{TITLE}</title>" + NL
    t = t + "<meta name=""description"" content=""The homepage of {NAME}, at {HOOD} {NUM} on GeoSimies."">" + NL
    t = t + "</head>" + NL
    t = t + "<body bgcolor=""#C0C0C0"" text=""#000000"" link=""#0000FF"" vlink=""#800080"">" + NL
    t = t + "<center>" + NL
    t = t + "<img src=""{ART}undercon.pic"" alt=""UNDER CONSTRUCTION"">" + NL
    t = t + "<h1>{TITLE}</h1>" + NL
    t = t + "<h3><blink>Welcome to my homepage!!!</blink></h3>" + NL
    t = t + "</center>" + NL
    t = t + "<hr>" + NL
    t = t + "<p>This page is <b>UNDER CONSTRUCTION</b>. I am still learning HTML, so please be patient!" + NL
    t = t + "Check back soon for <img src=""{ART}new.pic"" alt=""NEW!""> stuff.</p>" + NL
    t = t + "<h2>About me</h2>" + NL
    t = t + "<p>My name is {NAME}. I live at {HOOD} {NUM} on GeoSimies.</p>" + NL
    t = t + "<h2>My Favorite Links</h2>" + NL
    t = t + "<ul>" + NL
    t = t + "<li><a href=""{TOP}"">GeoSimies</a></li>" + NL
    t = t + "<li><a href=""{TOP}rings.asp"">Webrings</a></li>" + NL
    t = t + "</ul>" + NL
    t = t + "<hr>" + NL
    t = t + "<center>" + NL
    t = t + "<!--COUNTER-->" + NL
    t = t + "<p><a href=""{TOP}guest.asp?h={KEY}&n={NUM}#sign"">Sign my guestbook!</a></p>" + NL
    t = t + "<font size=""1"">This page was last updated on {DATE}.</font>" + NL
    t = t + "</center>" + NL
    t = t + "</body>" + NL
    t = t + "</html>" + NL
    Put("C:\WEB\CLASSIC.TPL")
END SUB

SUB File2 ()
    t = ""
    t = t + "<%@ import file=""GEO.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' EDIT.ASP - the member's own corner: their address, title and description," + NL
    t = t + "' their pages, and (with ?p=name) the page editor." + NL
    t = t + "'   POST do=site     title, description" + NL
    t = t + "'   POST do=save     p, html: a preview, or with publish=1 the page itself" + NL
    t = t + "'   POST do=publish  p: the preview becomes the page (from the preview's own bar)" + NL
    t = t + "'   POST do=new      p, tpl: another page, from a template" + NL
    t = t + "'   POST do=redo     p, tpl: start a page over (as a preview, so nothing is lost yet)" + NL
    t = t + "'   POST do=delete   p" + NL
    t = t + "' The member's HTML is only ever shown here inside a text box, escaped." + NL
    t = t + "VAR home AS String" + NL
    t = t + "VAR hood AS String" + NL
    t = t + "VAR num AS String" + NL
    t = t + "VAR site AS String" + NL
    t = t + "VAR pg AS String" + NL
    t = t + "VAR html AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR said AS String" + NL
    t = t + "VAR path AS String" + NL
    t = t + "VAR fromDraft AS Bool" + NL
    t = t + "VAR one AS String" + NL
    t = t + "VAR item AS String" + NL
    t = t + "VAR id AS String" + NL
    t = t + "VAR ring AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "home = HomeOf(viewer)" + NL
    t = t + "hood = home.Split(""|"")[0]" + NL
    t = t + "num = home.Split(""|"")[1]" + NL
    t = t + "pg = REQUEST.Query(""p"").Lower()" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    RequireToken()" + NL
    t = t + "    pg = REQUEST.Form(""p"").Lower()" + NL
    t = t + "    SELECT CASE REQUEST.Form(""do"")" + NL
    t = t + "        CASE ""site""" + NL
    t = t + "            IF OneLine(REQUEST.Form(""title""), 1000).Length > MAXTITLE THEN" + NL
    t = t + "                problem = ""Keep the title under "" + Str(MAXTITLE) + "" characters.""" + NL
    t = t + "            ELSEIF OneLine(REQUEST.Form(""desc""), 1000).Length > MAXDESC THEN" + NL
    t = t + "                problem = ""Keep the description under "" + Str(MAXDESC) + "" characters.""" + NL
    t = t + "            ELSEIF OneLine(REQUEST.Form(""title""), MAXTITLE) = """" THEN" + NL
    t = t + "                problem = ""Your homepage needs a title.""" + NL
    t = t + "            ELSE" + NL
    t = t + "                UpdateSite(hood, num, OneLine(REQUEST.Form(""title""), MAXTITLE), OneLine(REQUEST.Form(""desc""), MAXDESC))" + NL
    t = t + "                RESPONSE.Redirect(""edit.asp?why="" + UrlEnc(""Saved. The directory shows your new title and description.""))" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""save""" + NL
    t = t + "            IF NOT ValidPage(pg) THEN RESPONSE.Redirect(""edit.asp"")" + NL
    t = t + "            html = REQUEST.Form(""html"")" + NL
    t = t + "            problem = SavePage(hood, num, pg, html, REQUEST.Form(""publish"") = """")" + NL
    t = t + "            IF problem = """" THEN" + NL
    t = t + "                IF REQUEST.Form(""publish"") <> """" THEN RESPONSE.Redirect(""edit.asp?p="" + pg + ""&why="" + UrlEnc(""Saved! Your page is on the Web.""))" + NL
    t = t + "                RESPONSE.Redirect(PageLink(hood, num, pg) + ""?draft=1"")" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""publish""" + NL
    t = t + "            path = SiteData(hood, num) + ""\"" + pg.Upper() + "".DRF""" + NL
    t = t + "            IF NOT ValidPage(pg) OR NOT FS.Exists(path) THEN RESPONSE.Redirect(""edit.asp"")" + NL
    t = t + "            problem = SavePage(hood, num, pg, FS.Read(path), FALSE)" + NL
    t = t + "            IF problem = """" THEN RESPONSE.Redirect(PageLink(hood, num, pg))" + NL
    t = t + "            html = FS.Read(path)" + NL
    t = t + "        CASE ""new""" + NL
    t = t + "            problem = NewPage(hood, num, pg, REQUEST.Form(""tpl""), viewer)" + NL
    t = t + "            IF problem = """" THEN RESPONSE.Redirect(""edit.asp?p="" + pg.Trim())" + NL
    t = t + "            pg = """"" + NL
    t = t + "        CASE ""redo""" + NL
    t = t + "            IF HasPage(hood, num, pg) THEN" + NL
    t = t + "                problem = SavePage(hood, num, pg, FillTemplate(REQUEST.Form(""tpl""), viewer, hood, num, pg), TRUE)" + NL
    t = t + "                IF problem = """" THEN RESPONSE.Redirect(""edit.asp?p="" + pg + ""&why="" + UrlEnc(""Here is the template. It is only a preview until you save it.""))" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""delete""" + NL
    t = t + "            DeletePage(hood, num, pg)" + NL
    t = t + "            RESPONSE.Redirect(""edit.asp?why="" + UrlEnc(""The page "" + pg + "" is gone.""))" + NL
    t = t + "    END SELECT" + NL
    t = t + "ELSE" + NL
    t = t + "    said = REQUEST.Query(""why"")" + NL
    t = t + "    IF REQUEST.Query(""new"") <> """" THEN said = ""Welcome to the neighborhood! Your homepage is up. Change anything you like below.""" + NL
    t = t + "END IF" + NL
    t = t + "site = FindSite(hood, num)" + NL
    t = t + "IF pg <> """" AND NOT HasPage(hood, num, pg) THEN pg = """"" + NL
    t = t + "IF pg <> """" AND html = """" THEN" + NL
    t = t + "    path = SiteData(hood, num) + ""\"" + pg.Upper()" + NL
    t = t + "    IF FS.Exists(path + "".DRF"") THEN" + NL
    t = t + "        html = FS.Read(path + "".DRF"")" + NL
    t = t + "        fromDraft = TRUE" + NL
    t = t + "    ELSE" + NL
    t = t + "        html = FS.Read(path + "".HTM"")" + NL
    t = t + "    END IF" + NL
    t = t + "END IF" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""My Homepage"", ""Build your GeoSimies homepage."") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= Notice(problem) %><%= Notice(said) %>" + NL
    t = t + "<% IF pg <> """" THEN %>" + NL
    t = t + "<h2><font color=""#000080"">Editing: <%= pg %></font></h2>" + NL
    t = t + "<p><font size=""2"">This page is at <a href=""<%= PageLink(hood, num, pg) %>""><%= H(FullAddress(hood, num)) %><% IF pg <> ""index"" THEN %><%= pg %>.asp<% END IF %></a>." + NL
    t = t + "<a href=""edit.asp"">Back to my homepage</a></font></p>" + NL
    t = t + "<% IF fromDraft THEN %><p><font size=""2"" color=""#C00000""><b>This is your preview, not saved yet.</b> Save it to put it on the Web.</font></p><% END IF %>" + NL
    t = t + "<form action=""edit.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<input type=""hidden"" name=""do"" value=""save""><input type=""hidden"" name=""p"" value=""<%= pg %>"">" + NL
    t = t + "<%= LimitedBox(""html"", html, 22, 78, MAXHTML) %>" + NL
    t = t + "<p><input type=""checkbox"" name=""publish"" value=""1""> <font size=""2"">Save it straight away (no preview)</font>" + NL
    t = t + "<input type=""submit"" id=""go"" value=""Preview / Save""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<%= LimitScript(""html"", Str(MAXHTML)) %>" + NL
    t = t + "<%= BoxTop(""Start this page over"", ""#808080"") %>" + NL
    t = t + "<form action=""edit.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<input type=""hidden"" name=""do"" value=""redo""><input type=""hidden"" name=""p"" value=""<%= pg %>"">" + NL
    t = t + "<p><font size=""2"">From the template</font> <select name=""tpl""><%= TemplateOptions() %></select> <input type=""submit"" value=""Start Over""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<h2><font color=""#000080"">Welcome home, <%= H(Field(LoadUser(viewer), ""name"")) %>!</font></h2>" + NL
    t = t + "<p>Your homepage lives at <b><%= HoodInfo(hood, 1) %> <%= num %></b>:<br>" + NL
    t = t + "<a href=""<%= SiteLink(hood, num) %>""><b><%= H(FullAddress(hood, num)) %></b></a><br>" + NL
    t = t + "<font size=""2"">or for short, <a href=""~<%= viewer %>/""><%= H(SiteUrl()) %>~<%= viewer %>/</a></font></p>" + NL
    t = t + "<%= BoxTop(""My Pages"", ""#000080"") %>" + NL
    t = t + "<table cellpadding=""4"" cellspacing=""0"" width=""100%"">" + NL
    t = t + "<% FOR EACH one IN Pages(hood, num) %>" + NL
    t = t + "<tr><td><font size=""2""><b><%= one %></b></font></td>" + NL
    t = t + "<td><font size=""2""><%= PageHits(hood, num, one) %> visitors</font></td>" + NL
    t = t + "<td><font size=""2""><a href=""edit.asp?p=<%= one %>"">Edit</a> | <a href=""<%= PageLink(hood, num, one) %>"">View</a></font></td>" + NL
    t = t + "<td><% IF one <> ""index"" THEN %><form action=""edit.asp"" method=""post""><%= TokenField() %><input type=""hidden"" name=""do"" value=""delete""><input type=""hidden"" name=""p"" value=""<%= one %>""><input type=""submit"" value=""Delete""></form><% END IF %></td></tr>" + NL
    t = t + "<% NEXT %>" + NL
    t = t + "</table>" + NL
    t = t + "<% IF Pages(hood, num).Count < MAXPAGES THEN %>" + NL
    t = t + "<form action=""edit.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<input type=""hidden"" name=""do"" value=""new"">" + NL
    t = t + "<p><font size=""2"">New page called</font> <input name=""p"" size=""8""> <font size=""2"">from</font> <select name=""tpl""><%= TemplateOptions() %></select> <input type=""submit"" value=""Make It""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<p><font size=""2"">Room for <%= MAXPAGES %> pages of up to <%= MAXHTML %> characters each.</font></p>" + NL
    t = t + "<%= BoxTop(""Title and Description"", ""#000080"") %>" + NL
    t = t + "<form action=""edit.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<input type=""hidden"" name=""do"" value=""site"">" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td><font size=""2"">Title:</font></td><td><input name=""title"" size=""50"" value=""<%= H(SiteTitle(site)) %>""></td></tr>" + NL
    t = t + "<tr><td valign=""top""><font size=""2"">Description:</font></td><td><%= LimitedBox(""desc"", SiteDesc(site), 3, 50, MAXDESC) %></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" id=""go"" value=""Save""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "<p><font size=""1"" color=""#808080"">The directory and the search engines show these. A page with no &lt;title&gt; of its own gets this one.</font></p>" + NL
    t = t + "</form>" + NL
    t = t + "<%= LimitScript(""desc"", Str(MAXDESC)) %>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</td><td width=""250"" valign=""top"">" + NL
    t = t + "<%= BoxTop(""Pictures"", ""#008000"") %>" + NL
    t = t + "<p><font size=""2"">You have <%= Pictures(hood, num).Count %> of <%= MAXPICS %>. <a href=""upload.asp"">Add a picture</a> or use the clip art.</font></p>" + NL
    t = t + "<%= BoxTop(""Guestbook"", ""#008000"") %>" + NL
    t = t + "<p><font size=""2""><a href=""guest.asp?h=<%= hood.Lower() %>&n=<%= num %>"">Read my guestbook</a> (<%= GuestEntries(hood, num).Count %> entries)</font></p>" + NL
    t = t + "<%= BoxTop(""Webrings"", ""#008000"") %>" + NL
    t = t + "<p><font size=""2"">" + NL
    t = t + "<% FOR EACH id IN RingsOf(hood, num)" + NL
    t = t + "     ring = FindRing(id)" + NL
    t = t + "     IF ring <> """" THEN %><a href=""ring.asp?r=<%= id %>""><%= H(RingName(ring)) %></a><br><% END IF" + NL
    t = t + "   NEXT %>" + NL
    t = t + "<a href=""rings.asp"">Join or start a webring</a></font></p>" + NL
    t = t + "<%= BoxTop(""HTML Tips"", ""#808080"") %>" + NL
    t = t + "<p><font size=""1"">" + NL
    t = t + "<b>&lt;!--COUNTER--&gt;</b> puts in your hit counter.<br>" + NL
    t = t + "<b>&lt;marquee&gt;</b>scrolling text<b>&lt;/marquee&gt;</b><br>" + NL
    t = t + "<b>&lt;blink&gt;</b>NEW!<b>&lt;/blink&gt;</b><br>" + NL
    t = t + "<b>&lt;img src=""me.pic""&gt;</b> shows your picture me.pic.<br>" + NL
    t = t + "<b>&lt;img src=""../../clipart/undercon.pic""&gt;</b> shows clip art.<br>" + NL
    t = t + "<b>&lt;a href=""links.asp""&gt;</b> links to your page links.<br>" + NL
    t = t + "Your guestbook and webrings go at the bottom by themselves.<br>" + NL
    t = t + "Voyager's SPARK page scripts work. JavaScript is switched off here: it could read everybody's cookies." + NL
    t = t + "</font></p>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\EDIT.ASP")
END SUB

SUB File3 ()
    t = ""
    t = t + "' GEO.SPK - GeoSimies, free homepages for everybody on the SIM95 network." + NL
    t = t + "' Every page pulls this in with <%@ import file=""GEO.SPK"" %>, and every" + NL
    t = t + "' member's page with <%@ import file=""..\..\GEO.SPK"" %>." + NL
    t = t + "'" + NL
    t = t + "' A member gets a homepage at an address in a neighborhood, the way it was" + NL
    t = t + "' done in 1996: http://HOST/area95/1001/ (or /geo/area95/1001/ on a SimHost" + NL
    t = t + "' machine), and /~name/ as a short way there. The pages people write are kept" + NL
    t = t + "' in C:\GEODATA, outside C:\WEB, so the web server never hands them out as" + NL
    t = t + "' they are. What it serves for an address is a small INDEX.ASP that comes back" + NL
    t = t + "' here: ShowPage reads the member's HTML, counts the visitor, and adds the" + NL
    t = t + "' hit counter, the webrings and the guestbook links." + NL
    t = t + "'" + NL
    t = t + "'   C:\GEODATA\USERS\<user>.TXT          one member, key=value per line (password salted + hashed)" + NL
    t = t + "'   C:\GEODATA\SESSIONS\<id>.TXT         a sign-in: user, form token, and the address it came from" + NL
    t = t + "'   C:\GEODATA\MEMBERS.TXT               user|hood|number, one per member" + NL
    t = t + "'   C:\GEODATA\HOODS\<hood>.TXT          number|user|title|description|updated, one per homepage" + NL
    t = t + "'   C:\GEODATA\NEWEST.TXT                hood|number, in the order they moved in" + NL
    t = t + "'   C:\GEODATA\SITES\<hood>\<n>\<p>.HTM  a page as its owner wrote it (.DRF: a preview not yet saved)" + NL
    t = t + "'   C:\GEODATA\SITES\<hood>\<n>\<p>.CNT  that page's hit counter" + NL
    t = t + "'   C:\GEODATA\SITES\<hood>\<n>\GUEST.TXT  the guestbook, one entry per line" + NL
    t = t + "'   C:\GEODATA\SITES\<hood>\<n>\RINGS.TXT  |2|5|  the webrings this homepage is in" + NL
    t = t + "'   C:\GEODATA\RINGS.TXT                 id|owner hood/number|name|description, one per webring" + NL
    t = t + "'   C:\GEODATA\RINGS\<id>.TXT            hood/number, one member per line, in ring order" + NL
    t = t + "'   C:\GEODATA\WHERE.TXT                 the folder GeoSimies was last seen in (see FixUp)" + NL
    t = t + "'   C:\WEB\<hood>\<n>\<page>.ASP         the pages as served (all the same few lines)" + NL
    t = t + "'   C:\WEB\<hood>\<n>\<name>.PIC         the member's own pictures" + NL
    t = t + "'   C:\WEB\~<user>\INDEX.ASP             sends /~ann/ on to Ann's address" + NL
    t = t + "'   C:\WEB\CLIPART\*.PIC                 the clip art everybody may use" + NL
    t = t + "'" + NL
    t = t + "' Every page HTTPD.SPK sends travels as one network message of at most 64K," + NL
    t = t + "' and so does every request Voyager makes, so a member's page is kept to" + NL
    t = t + "' MAXHTML characters, which still fits when every one of them needs escaping." + NL
    t = t + "" + NL
    t = t + "CONST DATADIR = ""C:\GEODATA""" + NL
    t = t + "CONST COOKIE = ""geosimies""" + NL
    t = t + "CONST MAXHTML = 16000         ' characters in one page" + NL
    t = t + "CONST MAXSAFE = 40000         ' ...and once escaped, as the editor shows it" + NL
    t = t + "CONST MAXPAGES = 6            ' pages per homepage, index included" + NL
    t = t + "CONST MAXPICS = 10            ' pictures per homepage" + NL
    t = t + "CONST MAXPIC = 40000          ' characters in one picture" + NL
    t = t + "CONST PICSIZE = 200           ' largest picture, either way" + NL
    t = t + "CONST MAXNAME = 40" + NL
    t = t + "CONST MAXTITLE = 60" + NL
    t = t + "CONST MAXDESC = 200" + NL
    t = t + "CONST MAXSIGN = 500           ' a guestbook entry" + NL
    t = t + "CONST MAXFROM = 60            ' ""where are you from?""" + NL
    t = t + "CONST GUESTKEEP = 200         ' guestbook entries kept" + NL
    t = t + "CONST MAXRINGS = 5            ' webrings one homepage can be in" + NL
    t = t + "CONST MAXRINGNAME = 40" + NL
    t = t + "CONST PAGEROOM = 24000        ' how much directory or guestbook one page may carry" + NL
    t = t + "CONST FIRSTNUM = 1001         ' the first address in a neighborhood" + NL
    t = t + "CONST LASTNUM = 9999" + NL
    t = t + "" + NL
    t = t + "VAR viewer AS String          ' who is signed in; """" for nobody" + NL
    t = t + "VAR formToken AS String       ' their session's form token; see RequireToken" + NL
    t = t + "VAR geoHome AS String         ' GeoDir, once worked out" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the neighborhoods" + NL
    t = t + "" + NL
    t = t + "' key|name|what lives there|colour. The key is a folder name, so 8 letters at most." + NL
    t = t + "FUNCTION Hoods () AS Array OF String" + NL
    t = t + "    VAR list AS Array OF String" + NL
    t = t + "    list.Add(""AREA95|Area95|UFOs, aliens, outer space, science fiction and the X-Files. The truth is out there.|#000040"")" + NL
    t = t + "    list.Add(""SIMWOOD|Simwood|Movies, TV shows, soap operas and fan pages for the stars.|#800000"")" + NL
    t = t + "    list.Add(""CHIPVALE|ChipVale|Computers, programming, SPARK and the information superhighway.|#004040"")" + NL
    t = t + "    list.Add(""HOMETOWN|Hometown|Family, pets, hobbies, recipes and the old home town.|#406000"")" + NL
    t = t + "    list.Add(""NEOTOKYO|NeoTokyo|Anime, manga and video games.|#600060"")" + NL
    t = t + "    list.Add(""ROCKCITY|RockCity|Bands, garage rock, concerts and lyrics.|#202020"")" + NL
    t = t + "    list.Add(""STADIUM|Stadium|Sports, teams, scores and fantasy leagues.|#004080"")" + NL
    t = t + "    list.Add(""TOYLAND|Toyland|Kids, toys, cartoons and Saturday mornings.|#C04000"")" + NL
    t = t + "    RETURN list" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Field i of a neighborhood's entry (0 key, 1 name, 2 about, 3 colour), or """"." + NL
    t = t + "FUNCTION HoodInfo (hood AS String, i AS Integer) AS String" + NL
    t = t + "    VAR entry AS String" + NL
    t = t + "    FOR EACH entry IN Hoods()" + NL
    t = t + "        IF entry.Split(""|"")[0] = hood.Upper() THEN RETURN entry.Split(""|"")[i]" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsHood (hood AS String) AS Bool" + NL
    t = t + "    IF hood = """" OR hood.Length > 8 THEN RETURN FALSE" + NL
    t = t + "    RETURN HoodInfo(hood, 0) <> """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- where things are" + NL
    t = t + "" + NL
    t = t + "' The folder GEO.SPK is in: C:\WEB, or C:\WEB\GEO on a SimHost machine. A" + NL
    t = t + "' member's page is two folders further down, so look up from the page." + NL
    t = t + "FUNCTION GeoDir () AS String" + NL
    t = t + "    VAR d AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF geoHome <> """" THEN RETURN geoHome" + NL
    t = t + "    d = SERVER.ScriptName" + NL
    t = t + "    FOR i = 1 TO 4" + NL
    t = t + "        d = ParentOf(d)" + NL
    t = t + "        IF FS.Exists(d + ""\GEO.SPK"") THEN" + NL
    t = t + "            geoHome = d" + NL
    t = t + "            RETURN d" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    geoHome = ""C:\WEB""" + NL
    t = t + "    RETURN geoHome" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ParentOf (p AS String) AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    parts = p.Split(""\"")" + NL
    t = t + "    IF parts.Count < 2 THEN RETURN p" + NL
    t = t + "    RETURN p.Substring(0, p.Length - parts[parts.Count - 1].Length - 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where GeoSimies is on the web: http://host/ or http://host/geo/" + NL
    t = t + "FUNCTION SiteUrl () AS String" + NL
    t = t + "    RETURN ""http://"" + SERVER.Name.Lower() + WebPath(GeoDir())" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The path of a folder in C:\WEB: ""/"" or ""/geo/""" + NL
    t = t + "FUNCTION WebPath (dir AS String) AS String" + NL
    t = t + "    IF dir.Upper() = ""C:\WEB"" THEN RETURN ""/""" + NL
    t = t + "    RETURN ""/"" + dir.Substring(7, dir.Length - 7).Replace(""\"", ""/"").Lower() + ""/""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION SiteData (hood AS String, num AS String) AS String" + NL
    t = t + "    RETURN DATADIR + ""\SITES\"" + hood.Upper() + ""\"" + num" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION SiteWeb (hood AS String, num AS String) AS String" + NL
    t = t + "    RETURN GeoDir() + ""\"" + hood.Upper() + ""\"" + num" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A homepage's address, from GeoSimies' own folder." + NL
    t = t + "FUNCTION SiteLink (hood AS String, num AS String) AS String" + NL
    t = t + "    RETURN hood.Lower() + ""/"" + num + ""/""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION FullAddress (hood AS String, num AS String) AS String" + NL
    t = t + "    RETURN SiteUrl() + SiteLink(hood, num)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the disk" + NL
    t = t + "" + NL
    t = t + "SUB EnsureDisk ()" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    FOR EACH dir IN ["""", ""\USERS"", ""\SESSIONS"", ""\HOODS"", ""\SITES"", ""\RINGS""]" + NL
    t = t + "        IF NOT FS.Exists(DATADIR + dir) THEN FS.MakeDir(DATADIR + dir)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT FS.Exists(DATADIR + ""\WHERE.TXT"") THEN FS.Write(DATADIR + ""\WHERE.TXT"", GeoDir())" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Text that is safe inside one |-separated line, and back again." + NL
    t = t + "FUNCTION Esc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%"", ""%25"").Replace(""|"", ""%7C"").Replace(Chr(13), """").Replace(Chr(10), ""%0A"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unesc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%0A"", Chr(10)).Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Text that is safe inside a page; Br also keeps the line breaks. Everything a" + NL
    t = t + "' visitor or member typed goes through one of these, except a member's own HTML" + NL
    t = t + "' on their own homepage." + NL
    t = t + "FUNCTION H (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.HtmlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Br (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.HtmlEncode(s).Replace(Chr(10), ""<br>"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UrlEnc (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.UrlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION OnlyFrom (s AS String, allowed AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        IF NOT allowed.Contains(s.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A user name is also a folder name: ~ann. With the ~ it must fit in eight." + NL
    t = t + "FUNCTION ValidName (u AS String) AS Bool" + NL
    t = t + "    IF u.Length < 3 OR u.Length > 7 THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyFrom(u, ""abcdefghijklmnopqrstuvwxyz0123456789"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CleanName (u AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = u.Trim().Lower()" + NL
    t = t + "    IF ValidName(s) THEN RETURN s" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A page's name is its file name: index, links, aliens..." + NL
    t = t + "FUNCTION ValidPage (p AS String) AS Bool" + NL
    t = t + "    IF p.Length < 1 OR p.Length > 8 THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyFrom(p.Lower(), ""abcdefghijklmnopqrstuvwxyz0123456789"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsNumber (s AS String) AS Bool" + NL
    t = t + "    IF s = """" OR s.Length > 8 THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyFrom(s, ""0123456789"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Text from a form, trimmed and cut to a length." + NL
    t = t + "FUNCTION Clip (s AS String, most AS Integer) AS String" + NL
    t = t + "    s = s.Replace(Chr(13), """").Trim()" + NL
    t = t + "    IF s.Length > most THEN s = s.Substring(0, most)" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One line of a form: no line breaks." + NL
    t = t + "FUNCTION OneLine (s AS String, most AS Integer) AS String" + NL
    t = t + "    RETURN Clip(s.Replace(Chr(10), "" ""), most)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The line in text (lines of ""key|..."") that starts with key, or """"." + NL
    t = t + "FUNCTION FindLine (text AS String, key AS String) AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    text = Chr(10) + text" + NL
    t = t + "    at = text.IndexOf(Chr(10) + key + ""|"")" + NL
    t = t + "    IF at < 0 THEN RETURN """"" + NL
    t = t + "    text = text.Substring(at + 1, text.Length - at - 1)" + NL
    t = t + "    at = text.IndexOf(Chr(10))" + NL
    t = t + "    IF at >= 0 THEN text = text.Substring(0, at)" + NL
    t = t + "    RETURN text" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' text with one whole line swapped for another ("""" takes it out)." + NL
    t = t + "FUNCTION SwapLine (text AS String, old AS String, new AS String) AS String" + NL
    t = t + "    IF new = """" THEN" + NL
    t = t + "        text = (Chr(10) + text).Replace(Chr(10) + old + Chr(10), Chr(10))" + NL
    t = t + "    ELSE" + NL
    t = t + "        text = (Chr(10) + text).Replace(Chr(10) + old + Chr(10), Chr(10) + new + Chr(10))" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN text.Substring(1, text.Length - 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Stamp () AS String" + NL
    t = t + "    RETURN TIME.Date + "" "" + TIME.Clock.Substring(0, 5)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- members" + NL
    t = t + "" + NL
    t = t + "FUNCTION UserPath (u AS String) AS String" + NL
    t = t + "    RETURN DATADIR + ""\USERS\"" + u + "".TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UserExists (u AS String) AS Bool" + NL
    t = t + "    IF NOT ValidName(u) THEN RETURN FALSE" + NL
    t = t + "    RETURN FS.Exists(UserPath(u))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LoadUser (u AS String) AS Array OF String" + NL
    t = t + "    RETURN FS.Read(UserPath(u)).Lines()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SaveUser (u AS String, rec AS Array OF String)" + NL
    t = t + "    FS.Write(UserPath(u), rec.Join(Chr(10)))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Field (rec AS Array OF String, key AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN rec" + NL
    t = t + "        IF line.StartsWith(key + ""="") THEN RETURN Unesc(line.Substring(key.Length + 1, line.Length - key.Length - 1))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SetField (rec AS Array OF String, key AS String, value AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO rec.Count - 1" + NL
    t = t + "        IF rec[i].StartsWith(key + ""="") THEN" + NL
    t = t + "            rec[i] = key + ""="" + Esc(value)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    rec.Add(key + ""="" + Esc(value))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Not real cryptography - SIM95 has none - but the password itself never" + NL
    t = t + "' touches the disk. Two running hashes over salt + password, kept under 2^31." + NL
    t = t + "FUNCTION Hash (salt AS String, pw AS String) AS String" + NL
    t = t + "    VAR a AS Integer = 7" + NL
    t = t + "    VAR b AS Integer = 31337" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = salt + "":"" + pw + "":"" + salt" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        c = Asc(s.CharAt(i))" + NL
    t = t + "        a = (a * 131 + c) MOD 2147483629" + NL
    t = t + "        b = (b * 257 + c + a) MOD 2147483587" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN Hex(a) + ""-"" + Hex(b)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NewToken () AS String" + NL
    t = t + "    RETURN Hex(268435456 + Rnd(1879048191))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CheckPassword (u AS String, pw AS String) AS Bool" + NL
    t = t + "    VAR rec AS Array OF String" + NL
    t = t + "    IF NOT UserExists(u) THEN RETURN FALSE" + NL
    t = t + "    rec = LoadUser(u)" + NL
    t = t + "    RETURN Hash(Field(rec, ""salt""), pw) = Field(rec, ""pass"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Which homepage is u's: ""AREA95|1001"", or """"." + NL
    t = t + "FUNCTION HomeOf (u AS String) AS String" + NL
    t = t + "    VAR rec AS Array OF String" + NL
    t = t + "    IF NOT UserExists(u) THEN RETURN """"" + NL
    t = t + "    rec = LoadUser(u)" + NL
    t = t + "    IF Field(rec, ""hood"") = """" THEN RETURN """"" + NL
    t = t + "    RETURN Field(rec, ""hood"") + ""|"" + Field(rec, ""num"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The next free address in a neighborhood: one past the highest taken." + NL
    t = t + "FUNCTION FreeNumber (hood AS String) AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR most AS Integer" + NL
    t = t + "    most = FIRSTNUM - 1" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\HOODS\"" + hood + "".TXT"", """").Lines()" + NL
    t = t + "        IF line <> """" THEN most = Int(MATH.Max(most, Val(line.Split(""|"")[0])))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN most + 1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Taken (hood AS String, num AS String) AS Bool" + NL
    t = t + "    RETURN FS.Exists(SiteData(hood, num)) OR FS.Exists(SiteWeb(hood, num))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Signs somebody up and moves them in: an account, an address, and a first" + NL
    t = t + "' page from a template. Returns """" on success, otherwise what is wrong." + NL
    t = t + "FUNCTION CreateMember (u AS String, pw AS String, name AS String, hood AS String, num AS String, title AS String, tpl AS String) AS String" + NL
    t = t + "    VAR rec AS Array OF String" + NL
    t = t + "    VAR salt AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    hood = hood.Upper()" + NL
    t = t + "    name = OneLine(name, MAXNAME)" + NL
    t = t + "    title = OneLine(title, MAXTITLE)" + NL
    t = t + "    num = num.Trim()" + NL
    t = t + "    IF NOT ValidName(u) THEN RETURN ""Pick a member name of 3 to 7 letters or digits.""" + NL
    t = t + "    IF FS.Exists(UserPath(u)) OR FS.Exists(GeoDir() + ""\~"" + u.Upper()) THEN RETURN ""Somebody already has the name "" + u + "".""" + NL
    t = t + "    IF pw.Length < 4 THEN RETURN ""Pick a password of at least 4 characters.""" + NL
    t = t + "    IF name = """" THEN RETURN ""Tell us your name.""" + NL
    t = t + "    IF NOT IsHood(hood) THEN RETURN ""Pick a neighborhood to live in.""" + NL
    t = t + "    IF num = """" THEN num = Str(FreeNumber(hood))" + NL
    t = t + "    IF NOT IsNumber(num) THEN RETURN ""An address is a number from "" + Str(FIRSTNUM) + "" to "" + Str(LASTNUM) + "".""" + NL
    t = t + "    IF Val(num) < FIRSTNUM OR Val(num) > LASTNUM THEN RETURN ""An address is a number from "" + Str(FIRSTNUM) + "" to "" + Str(LASTNUM) + "".""" + NL
    t = t + "    num = Str(Int(Val(num)))" + NL
    t = t + "    IF Taken(hood, num) THEN RETURN HoodInfo(hood, 1) + "" "" + num + "" is taken. Try "" + Str(FreeNumber(hood)) + "".""" + NL
    t = t + "    IF NOT IsTemplate(tpl) THEN tpl = ""STARS""" + NL
    t = t + "    IF title = """" THEN title = name + ""'s Home Page""" + NL
    t = t + "    salt = NewToken()" + NL
    t = t + "    SetField(rec, ""name"", name)" + NL
    t = t + "    SetField(rec, ""salt"", salt)" + NL
    t = t + "    SetField(rec, ""pass"", Hash(salt, pw))" + NL
    t = t + "    SetField(rec, ""hood"", hood)" + NL
    t = t + "    SetField(rec, ""num"", num)" + NL
    t = t + "    SetField(rec, ""joined"", TIME.Date)" + NL
    t = t + "    SaveUser(u, rec)" + NL
    t = t + "    FS.Append(DATADIR + ""\MEMBERS.TXT"", u + ""|"" + hood + ""|"" + num + Chr(10))" + NL
    t = t + "    FS.Append(DATADIR + ""\HOODS\"" + hood + "".TXT"", num + ""|"" + u + ""|"" + Esc(title) + ""||"" + TIME.Date + Chr(10))" + NL
    t = t + "    FS.Append(DATADIR + ""\NEWEST.TXT"", hood + ""|"" + num + Chr(10))" + NL
    t = t + "    MakeSite(hood, num, u)" + NL
    t = t + "    FS.Write(SiteData(hood, num) + ""\INDEX.HTM"", FillTemplate(tpl, u, hood, num, ""INDEX""))" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The folders of a homepage, its front page's ASP and the ~name shortcut." + NL
    t = t + "SUB MakeSite (hood AS String, num AS String, u AS String)" + NL
    t = t + "    IF NOT FS.Exists(DATADIR + ""\SITES\"" + hood) THEN FS.MakeDir(DATADIR + ""\SITES\"" + hood)" + NL
    t = t + "    IF NOT FS.Exists(SiteData(hood, num)) THEN FS.MakeDir(SiteData(hood, num))" + NL
    t = t + "    IF NOT FS.Exists(GeoDir() + ""\"" + hood) THEN FS.MakeDir(GeoDir() + ""\"" + hood)" + NL
    t = t + "    IF NOT FS.Exists(SiteWeb(hood, num)) THEN FS.MakeDir(SiteWeb(hood, num))" + NL
    t = t + "    WriteStub(hood, num, ""INDEX"")" + NL
    t = t + "    WriteAlias(GeoDir(), u, hood, num)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' What is served for each page: the same three lines, which come back to" + NL
    t = t + "' ShowPage. No member's text is ever written into an .ASP file." + NL
    t = t + "SUB WriteStub (hood AS String, num AS String, pg AS String)" + NL
    t = t + "    FS.Write(SiteWeb(hood, num) + ""\"" + pg.Upper() + "".ASP"", ""<%@ import file=""""..\..\GEO.SPK"""" %>"" + Chr(10) + ""<% ' A GeoSimies homepage: GEO.SPK finds whose from where this file is."" + Chr(10) + ""ShowPage() %>"" + Chr(10))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' /~ann/ goes to Ann's address." + NL
    t = t + "SUB WriteAlias (dir AS String, u AS String, hood AS String, num AS String)" + NL
    t = t + "    IF NOT FS.Exists(dir + ""\~"" + u.Upper()) THEN FS.MakeDir(dir + ""\~"" + u.Upper())" + NL
    t = t + "    FS.Write(dir + ""\~"" + u.Upper() + ""\INDEX.ASP"", ""<% ' GeoSimies: the short way to "" + u + ""'s homepage"" + Chr(10) + ""RESPONSE.Redirect("""""" + WebPath(dir) + SiteLink(hood, num) + """""") %>"" + Chr(10))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' SimHost moves GeoSimies into a folder of its own (C:\WEB\GEO), with the" + NL
    t = t + "' neighborhoods' folders. The ~name shortcuts aren't on its list, so the" + NL
    t = t + "' front page puts them right the first time it finds itself somewhere new." + NL
    t = t + "SUB FixUp ()" + NL
    t = t + "    VAR was AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    IF NOT FS.Exists(DATADIR) THEN RETURN" + NL
    t = t + "    was = ReadOr(DATADIR + ""\WHERE.TXT"", """").Trim()" + NL
    t = t + "    IF was.Upper() = GeoDir().Upper() THEN RETURN" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\MEMBERS.TXT"", """").Lines()" + NL
    t = t + "        p = line.Split(""|"")" + NL
    t = t + "        IF p.Count < 3 THEN CONTINUE" + NL
    t = t + "        IF was <> """" AND FS.Exists(was + ""\~"" + p[0].Upper() + ""\INDEX.ASP"") THEN" + NL
    t = t + "            FS.Delete(was + ""\~"" + p[0].Upper() + ""\INDEX.ASP"")" + NL
    t = t + "            FS.Delete(was + ""\~"" + p[0].Upper())" + NL
    t = t + "        END IF" + NL
    t = t + "        IF FS.Exists(GeoDir() + ""\"" + p[1]) THEN WriteAlias(GeoDir(), p[0], p[1], p[2])" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Write(DATADIR + ""\WHERE.TXT"", GeoDir())" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- homepages" + NL
    t = t + "" + NL
    t = t + "' A homepage's line in its neighborhood: number|user|title|description|updated" + NL
    t = t + "FUNCTION FindSite (hood AS String, num AS String) AS String" + NL
    t = t + "    IF NOT IsHood(hood) OR NOT IsNumber(num) THEN RETURN """"" + NL
    t = t + "    RETURN FindLine(ReadOr(DATADIR + ""\HOODS\"" + hood.Upper() + "".TXT"", """"), num)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION SiteTitle (site AS String) AS String" + NL
    t = t + "    RETURN Unesc(site.Split(""|"")[2])" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION SiteDesc (site AS String) AS String" + NL
    t = t + "    RETURN Unesc(site.Split(""|"")[3])" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB UpdateSite (hood AS String, num AS String, title AS String, desc AS String)" + NL
    t = t + "    VAR old AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    old = FindSite(hood, num)" + NL
    t = t + "    IF old = """" THEN RETURN" + NL
    t = t + "    path = DATADIR + ""\HOODS\"" + hood.Upper() + "".TXT""" + NL
    t = t + "    FS.Write(path, SwapLine(FS.Read(path), old, num + ""|"" + old.Split(""|"")[1] + ""|"" + Esc(title) + ""|"" + Esc(desc) + ""|"" + TIME.Date))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Saving a page marks the homepage as updated today." + NL
    t = t + "SUB Touch (hood AS String, num AS String)" + NL
    t = t + "    VAR site AS String" + NL
    t = t + "    site = FindSite(hood, num)" + NL
    t = t + "    IF site <> """" THEN UpdateSite(hood, num, SiteTitle(site), SiteDesc(site))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The pages of a homepage, index first, as lower-case names." + NL
    t = t + "FUNCTION Pages (hood AS String, num AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    out.Add(""index"")" + NL
    t = t + "    IF NOT FS.Exists(SiteData(hood, num)) THEN RETURN out" + NL
    t = t + "    FOR EACH f IN FS.List(SiteData(hood, num))" + NL
    t = t + "        IF f.EndsWith("".HTM"") AND f <> ""INDEX.HTM"" THEN out.Add(f.Substring(0, f.Length - 4).Lower())" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION HasPage (hood AS String, num AS String, pg AS String) AS Bool" + NL
    t = t + "    IF NOT ValidPage(pg) THEN RETURN FALSE" + NL
    t = t + "    RETURN FS.Exists(SiteData(hood, num) + ""\"" + pg.Upper() + "".HTM"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a page is, from GeoSimies' own folder." + NL
    t = t + "FUNCTION PageLink (hood AS String, num AS String, pg AS String) AS String" + NL
    t = t + "    IF pg.Lower() = ""index"" THEN RETURN SiteLink(hood, num)" + NL
    t = t + "    RETURN SiteLink(hood, num) + pg.Lower() + "".asp""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' """" when the HTML will do, otherwise what is wrong with it. The second limit" + NL
    t = t + "' is for the editor, which shows the page escaped (< is &lt;), and for the" + NL
    t = t + "' request that brings it back: both are single network messages." + NL
    t = t + "FUNCTION CheckHtml (html AS String) AS String" + NL
    t = t + "    IF html.Trim() = """" THEN RETURN ""A page needs something on it. Pick a template if you're stuck!""" + NL
    t = t + "    IF html.Length > MAXHTML THEN RETURN ""That page is "" + Str(html.Length) + "" characters. A GeoSimies page holds "" + Str(MAXHTML) + "". Split it into two pages!""" + NL
    t = t + "    IF H(html).Length > MAXSAFE THEN RETURN ""That page has too many special characters (< > & """") to fit. Take some out, or split it into two pages.""" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Saves a page (draft = FALSE) or a preview of it (draft = TRUE)." + NL
    t = t + "FUNCTION SavePage (hood AS String, num AS String, pg AS String, html AS String, draft AS Bool) AS String" + NL
    t = t + "    VAR problem AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    html = html.Replace(Chr(13), """")" + NL
    t = t + "    problem = CheckHtml(html)" + NL
    t = t + "    IF problem <> """" THEN RETURN problem" + NL
    t = t + "    IF NOT ValidPage(pg) THEN RETURN ""A page name is 1 to 8 letters or digits.""" + NL
    t = t + "    path = SiteData(hood, num) + ""\"" + pg.Upper()" + NL
    t = t + "    IF NOT FS.Exists(path + "".HTM"") AND Pages(hood, num).Count >= MAXPAGES THEN RETURN ""A homepage has room for "" + Str(MAXPAGES) + "" pages.""" + NL
    t = t + "    IF draft THEN" + NL
    t = t + "        FS.Write(path + "".DRF"", html)" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    FS.Write(path + "".HTM"", html)" + NL
    t = t + "    IF FS.Exists(path + "".DRF"") THEN FS.Delete(path + "".DRF"")" + NL
    t = t + "    IF NOT FS.Exists(SiteWeb(hood, num) + ""\"" + pg.Upper() + "".ASP"") THEN WriteStub(hood, num, pg)" + NL
    t = t + "    Touch(hood, num)" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NewPage (hood AS String, num AS String, pg AS String, tpl AS String, u AS String) AS String" + NL
    t = t + "    pg = pg.Trim().Lower()" + NL
    t = t + "    IF NOT ValidPage(pg) THEN RETURN ""A page name is 1 to 8 letters or digits, like links or aliens.""" + NL
    t = t + "    IF HasPage(hood, num, pg) THEN RETURN ""You already have a page called "" + pg + "".""" + NL
    t = t + "    IF NOT IsTemplate(tpl) THEN tpl = ""BLANK""" + NL
    t = t + "    RETURN SavePage(hood, num, pg, FillTemplate(tpl, u, hood, num, pg), FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB DeletePage (hood AS String, num AS String, pg AS String)" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR ext AS String" + NL
    t = t + "    IF pg.Lower() = ""index"" OR NOT ValidPage(pg) THEN RETURN" + NL
    t = t + "    path = SiteData(hood, num) + ""\"" + pg.Upper()" + NL
    t = t + "    FOR EACH ext IN ["".HTM"", "".DRF"", "".CNT""]" + NL
    t = t + "        IF FS.Exists(path + ext) THEN FS.Delete(path + ext)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF FS.Exists(SiteWeb(hood, num) + ""\"" + pg.Upper() + "".ASP"") THEN FS.Delete(SiteWeb(hood, num) + ""\"" + pg.Upper() + "".ASP"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- templates" + NL
    t = t + "" + NL
    t = t + "' name|title|what it looks like. Each is <name>.TPL beside this file." + NL
    t = t + "FUNCTION Templates () AS Array OF String" + NL
    t = t + "    VAR t AS Array OF String" + NL
    t = t + "    t.Add(""STARS|Starry Night|Black sky, twinkling stars, a spinning globe and a marquee. Very 1997."")" + NL
    t = t + "    t.Add(""CLASSIC|Under Construction|Grey and proud of it: a construction sign, a links list, a counter."")" + NL
    t = t + "    t.Add(""SHRINE|Fan Shrine|A tribute page for your favorite band, show or starship."")" + NL
    t = t + "    t.Add(""BLANK|Plain Paper|Almost nothing. For people who know their HTML."")" + NL
    t = t + "    RETURN t" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsTemplate (tpl AS String) AS Bool" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    FOR EACH t IN Templates()" + NL
    t = t + "        IF t.Split(""|"")[0] = tpl.Upper() AND tpl <> """" THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A template with the member's details in it. Pages sit two folders below" + NL
    t = t + "' GeoSimies, so its own pages and the clip art are ../../ away." + NL
    t = t + "FUNCTION FillTemplate (tpl AS String, u AS String, hood AS String, num AS String, pg AS String) AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR site AS String" + NL
    t = t + "    VAR title AS String" + NL
    t = t + "    VAR who AS String" + NL
    t = t + "    text = ReadOr(GeoDir() + ""\"" + tpl.Upper() + "".TPL"", ""<html><body><h1>Welcome to my homepage!!!</h1></body></html>"")" + NL
    t = t + "    site = FindSite(hood, num)" + NL
    t = t + "    title = u + ""'s Home Page""" + NL
    t = t + "    IF site <> """" THEN title = SiteTitle(site)" + NL
    t = t + "    who = u" + NL
    t = t + "    IF UserExists(u) THEN who = Field(LoadUser(u), ""name"")" + NL
    t = t + "    IF pg.Lower() <> ""index"" THEN title = title + "": "" + pg" + NL
    t = t + "    RETURN text.Replace(""{TITLE}"", H(title)).Replace(""{NAME}"", H(who)).Replace(""{USER}"", u).Replace(""{HOOD}"", HoodInfo(hood, 1)).Replace(""{KEY}"", hood.Lower()).Replace(""{NUM}"", num).Replace(""{ART}"", ""../../clipart/"").Replace(""{TOP}"", ""../../"").Replace(""{DATE}"", TIME.Date)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- pictures" + NL
    t = t + "" + NL
    t = t + "FUNCTION CheckPicture (pic AS String) AS String" + NL
    t = t + "    VAR size AS Array OF String" + NL
    t = t + "    IF pic = """" THEN RETURN ""Choose a .PIC file first.""" + NL
    t = t + "    size = pic.Lines()[0].Trim().Split("" "")" + NL
    t = t + "    IF NOT pic.StartsWith(""SIM95PIC "") OR size.Count < 3 THEN RETURN ""That is not a picture. Save one from Sketch as a .PIC file.""" + NL
    t = t + "    IF pic.Length > MAXPIC OR Val(size[1]) > PICSIZE OR Val(size[2]) > PICSIZE THEN RETURN ""That picture is "" + size[1] + "" by "" + size[2] + "". Pictures here are up to "" + Str(PICSIZE) + "" by "" + Str(PICSIZE) + "" (and "" + Str(MAXPIC / 1000) + ""K).""" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The pictures of a homepage, as lower-case file names." + NL
    t = t + "FUNCTION Pictures (hood AS String, num AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    IF NOT FS.Exists(SiteWeb(hood, num)) THEN RETURN out" + NL
    t = t + "    FOR EACH f IN FS.List(SiteWeb(hood, num))" + NL
    t = t + "        IF f.EndsWith("".PIC"") THEN out.Add(f.Lower())" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION SavePicture (hood AS String, num AS String, pname AS String, pic AS String) AS String" + NL
    t = t + "    VAR problem AS String" + NL
    t = t + "    pname = pname.Trim().Lower()" + NL
    t = t + "    IF pname.EndsWith("".pic"") THEN pname = pname.Substring(0, pname.Length - 4)" + NL
    t = t + "    IF NOT ValidPage(pname) THEN RETURN ""A picture's name is 1 to 8 letters or digits, like me or mydog.""" + NL
    t = t + "    problem = CheckPicture(pic)" + NL
    t = t + "    IF problem <> """" THEN RETURN problem" + NL
    t = t + "    IF NOT FS.Exists(SiteWeb(hood, num) + ""\"" + pname.Upper() + "".PIC"") AND Pictures(hood, num).Count >= MAXPICS THEN RETURN ""A homepage has room for "" + Str(MAXPICS) + "" pictures. Delete one first.""" + NL
    t = t + "    FS.Write(SiteWeb(hood, num) + ""\"" + pname.Upper() + "".PIC"", pic.Replace(Chr(13), """"))" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The clip art: file|what it is" + NL
    t = t + "FUNCTION ClipArt () AS Array OF String" + NL
    t = t + "    VAR c AS Array OF String" + NL
    t = t + "    c.Add(""undercon|Under construction"")" + NL
    t = t + "    c.Add(""emailme|E-mail me!"")" + NL
    t = t + "    c.Add(""globe|The globe"")" + NL
    t = t + "    c.Add(""new|NEW!"")" + NL
    t = t + "    c.Add(""stars|A strip of stars"")" + NL
    t = t + "    c.Add(""rainbow|Rainbow line"")" + NL
    t = t + "    c.Add(""bestview|Best viewed in Simxplorer"")" + NL
    t = t + "    c.Add(""coolsite|Cool Site of the Day"")" + NL
    t = t + "    RETURN c" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- sessions" + NL
    t = t + "" + NL
    t = t + "' A session file holds three lines: who is signed in, the session's form" + NL
    t = t + "' token, and the address the sign-in came from. The cookie names the file." + NL
    t = t + "' Members' pages share this web server, so a cookie is only good from the" + NL
    t = t + "' machine that signed in, and every change needs the form token too (see" + NL
    t = t + "' RequireToken): another site can't read GeoSimies' pages to learn it." + NL
    t = t + "" + NL
    t = t + "SUB SignIn (u AS String)" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    id = NewToken()" + NL
    t = t + "    FS.Write(DATADIR + ""\SESSIONS\"" + id + "".TXT"", u + Chr(10) + NewToken() + NewToken() + Chr(10) + REQUEST.From)" + NL
    t = t + "    RESPONSE.SetCookie(COOKIE, id)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION SessionPath () AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    id = REQUEST.Cookie(COOKIE)" + NL
    t = t + "    IF id = """" OR id.Length > 8 THEN RETURN """"" + NL
    t = t + "    IF NOT OnlyFrom(id, ""0123456789ABCDEF"") THEN RETURN """"" + NL
    t = t + "    RETURN DATADIR + ""\SESSIONS\"" + id + "".TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SignOut ()" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    path = SessionPath()" + NL
    t = t + "    IF path <> """" THEN" + NL
    t = t + "        IF FS.Exists(path) THEN FS.Delete(path)" + NL
    t = t + "    END IF" + NL
    t = t + "    RESPONSE.SetCookie(COOKIE, """")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Who the cookie says is signed in, or """". Also sets formToken." + NL
    t = t + "FUNCTION CurrentUser () AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR u AS String" + NL
    t = t + "    path = SessionPath()" + NL
    t = t + "    IF path = """" THEN RETURN """"" + NL
    t = t + "    IF NOT FS.Exists(path) THEN RETURN """"" + NL
    t = t + "    lines = FS.Read(path).Lines()" + NL
    t = t + "    IF lines.Count < 3 THEN RETURN """"" + NL
    t = t + "    u = lines[0].Trim()" + NL
    t = t + "    IF NOT UserExists(u) OR lines[2].Trim() <> REQUEST.From THEN RETURN """"" + NL
    t = t + "    formToken = lines[1].Trim()" + NL
    t = t + "    RETURN u" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The first line of every members-only page." + NL
    t = t + "SUB RequireLogin ()" + NL
    t = t + "    viewer = CurrentUser()" + NL
    t = t + "    IF viewer = """" THEN RESPONSE.Redirect(""index.asp?e=login"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The second line of every page that changes something." + NL
    t = t + "SUB RequireToken ()" + NL
    t = t + "    VAR sent AS String" + NL
    t = t + "    sent = REQUEST.Form(""t"")" + NL
    t = t + "    IF sent = """" THEN sent = REQUEST.Query(""t"")" + NL
    t = t + "    IF sent = """" OR sent <> formToken THEN RESPONSE.Redirect(""edit.asp?why="" + UrlEnc(""That did not come from a GeoSimies page, so nothing was changed.""))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION TokenField () AS String" + NL
    t = t + "    RETURN ""<input type=""""hidden"""" name=""""t"""" value="""""" + formToken + """""">""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- serving a homepage" + NL
    t = t + "" + NL
    t = t + "' The whole of every member's page: C:\WEB\<hood>\<n>\<page>.ASP calls this." + NL
    t = t + "' It works out whose page it is from its own path, counts the visitor, and" + NL
    t = t + "' sends the member's HTML with the counter, webrings and guestbook added." + NL
    t = t + "' ?draft=1 shows the owner their preview instead, and counts nobody." + NL
    t = t + "SUB ShowPage ()" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR hood AS String" + NL
    t = t + "    VAR num AS String" + NL
    t = t + "    VAR pg AS String" + NL
    t = t + "    VAR site AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR html AS String" + NL
    t = t + "    VAR hits AS Integer" + NL
    t = t + "    VAR preview AS Bool" + NL
    t = t + "    parts = SERVER.ScriptName.Split(""\"")" + NL
    t = t + "    pg = parts[parts.Count - 1]" + NL
    t = t + "    pg = pg.Substring(0, pg.Length - 4).Lower()" + NL
    t = t + "    num = parts[parts.Count - 2]" + NL
    t = t + "    hood = parts[parts.Count - 3].Upper()" + NL
    t = t + "    site = FindSite(hood, num)" + NL
    t = t + "    path = SiteData(hood, num) + ""\"" + pg.Upper()" + NL
    t = t + "    IF site = """" OR NOT FS.Exists(path + "".HTM"") THEN" + NL
    t = t + "        RESPONSE.Status = ""404 Not Found""" + NL
    t = t + "        RESPONSE.Write(""<html><head><title>Not here - GeoSimies</title></head><body bgcolor=""""#FFFFFF""""><h2>This homepage has moved or is gone.</h2><p><a href=""""../../"""">Back to GeoSimies</a></p></body></html>"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF REQUEST.Query(""draft"") <> """" AND FS.Exists(path + "".DRF"") THEN" + NL
    t = t + "        viewer = CurrentUser()" + NL
    t = t + "        IF viewer <> """" AND viewer = site.Split(""|"")[1] THEN preview = TRUE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF preview THEN" + NL
    t = t + "        html = FS.Read(path + "".DRF"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        html = FS.Read(path + "".HTM"")" + NL
    t = t + "        hits = Int(Val(ReadOr(path + "".CNT"", ""0""))) + 1" + NL
    t = t + "        FS.Write(path + "".CNT"", Str(hits))" + NL
    t = t + "    END IF" + NL
    t = t + "    html = Counted(Defang(html), hits)" + NL
    t = t + "    html = WithHead(html, site)" + NL
    t = t + "    IF preview THEN html = PreviewBar(pg) + html" + NL
    t = t + "    RESPONSE.Write(Before(html, ""</body"", Footer(hood, num, site)))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' text with more put in front of the first marker (any case), or at the end." + NL
    t = t + "FUNCTION Before (text AS String, marker AS String, more AS String) AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    at = text.Lower().IndexOf(marker)" + NL
    t = t + "    IF at < 0 THEN RETURN text + more" + NL
    t = t + "    RETURN text.Substring(0, at) + more + text.Substring(at, text.Length - at)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A title and a description for the search engines, if the page has none." + NL
    t = t + "FUNCTION WithHead (html AS String, site AS String) AS String" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    VAR more AS String" + NL
    t = t + "    low = html.Lower()" + NL
    t = t + "    IF NOT low.Contains(""<title"") THEN more = ""<title>"" + H(SiteTitle(site)) + ""</title>""" + NL
    t = t + "    IF NOT low.Contains(""name=""""description"""""") AND SiteDesc(site) <> """" THEN more = more + ""<meta name=""""description"""" content="""""" + H(SiteDesc(site)) + """""">""" + NL
    t = t + "    IF more = """" THEN RETURN html" + NL
    t = t + "    IF low.Contains(""<head>"") THEN RETURN html.Substring(0, low.IndexOf(""<head>"") + 6) + more + html.Substring(low.IndexOf(""<head>"") + 6, html.Length - low.IndexOf(""<head>"") - 6)" + NL
    t = t + "    RETURN more + html" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The first <!--COUNTER--> becomes the odometer." + NL
    t = t + "FUNCTION Counted (html AS String, hits AS Integer) AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    at = html.Lower().IndexOf(""<!--counter-->"")" + NL
    t = t + "    IF at < 0 THEN RETURN html" + NL
    t = t + "    RETURN html.Substring(0, at) + Odometer(hits) + html.Substring(at + 14, html.Length - at - 14)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' You are visitor #000123, in green digits on black wheels." + NL
    t = t + "FUNCTION Odometer (hits AS Integer) AS String" + NL
    t = t + "    VAR digits AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    digits = Str(hits)" + NL
    t = t + "    WHILE digits.Length < 6" + NL
    t = t + "        digits = ""0"" + digits" + NL
    t = t + "    END WHILE" + NL
    t = t + "    FOR i = 0 TO digits.Length - 1" + NL
    t = t + "        out = out + ""<td bgcolor=""""#000000""""><tt><font color=""""#00FF00""""><b>"" + digits.CharAt(i) + ""</b></font></tt></td>""" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN ""<table cellpadding=""""0"""" cellspacing=""""0""""><tr><td><font size=""""2""""><b>You are visitor #&nbsp;</b></font></td><td><table cellpadding=""""3"""" cellspacing=""""1"""" bgcolor=""""#808080""""><tr>"" + out + ""</tr></table></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The bar GeoSimies puts at the bottom of every homepage: its webrings, its" + NL
    t = t + "' guestbook, and where it lives." + NL
    t = t + "FUNCTION Footer (hood AS String, num AS String, site AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR ring AS String" + NL
    t = t + "    VAR q AS String" + NL
    t = t + "    q = ""&h="" + hood.Lower() + ""&n="" + num" + NL
    t = t + "    FOR EACH id IN RingsOf(hood, num)" + NL
    t = t + "        ring = FindRing(id)" + NL
    t = t + "        IF ring = """" THEN CONTINUE" + NL
    t = t + "        out = out + ""<tr><td align=""""center"""" bgcolor=""""#FFFFCC""""><font size=""""2"""">[ <a href=""""../../ring.asp?r="" + id + ""&go=prev"" + q + """""">&lt;&lt; Prev</a> | <a href=""""../../ring.asp?r="" + id + """"""><b>"" + H(RingName(ring)) + ""</b></a> | <a href=""""../../ring.asp?r="" + id + ""&go=next"" + q + """""">Next &gt;&gt;</a> | <a href=""""../../ring.asp?r="" + id + ""&go=rand"" + q + """""">Random</a> ]</font></td></tr>""" + NL
    t = t + "    NEXT" + NL
    t = t + "    out = out + ""<tr><td align=""""center""""><font size=""""2""""><a href=""""../../guest.asp?h="" + hood.Lower() + ""&n="" + num + ""#sign"""">Sign my Guestbook</a> | <a href=""""../../guest.asp?h="" + hood.Lower() + ""&n="" + num + """""">View my Guestbook</a></font></td></tr>""" + NL
    t = t + "    out = out + ""<tr><td align=""""center""""><font size=""""1"""">This free homepage lives at "" + HoodInfo(hood, 1) + "" "" + num + "", in <a href=""""../../hood.asp?h="" + hood.Lower() + """""">"" + HoodInfo(hood, 1) + ""</a> at <a href=""""../../"""">GeoSimies</a>. Get your own!</font></td></tr>""" + NL
    t = t + "    RETURN ""<br clear=""""all""""><hr><table width=""""100%"""" cellpadding=""""2"""" cellspacing=""""0"""">"" + out + ""</table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION PreviewBar (pg AS String) AS String" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""6"""" bgcolor=""""#FFFF00""""><tr><td><font color=""""#000000""""><b>PREVIEW</b> - this is how your page will look. Nobody else can see it yet.</font></td>"" _" + NL
    t = t + "         + ""<td align=""""right""""><form action=""""../../edit.asp"""" method=""""post"""">"" + TokenField() + ""<input type=""""hidden"""" name=""""p"""" value="""""" + pg + """"""><input type=""""hidden"""" name=""""do"""" value=""""publish""""><input type=""""submit"""" value=""""Publish it!""""></form></td>"" _" + NL
    t = t + "         + ""<td align=""""right""""><a href=""""../../edit.asp?p="" + pg + """""">Keep editing</a></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Members write their own HTML, and it is served from the same machine as" + NL
    t = t + "' everybody's sign-ins (and, on a SimHost machine, SimBook's and ColdMail's" + NL
    t = t + "' too). Voyager runs only SPARK page scripts, which see nothing but the page." + NL
    t = t + "' Simxplorer runs JavaScript, which could read the cookies. So JavaScript is" + NL
    t = t + "' switched off on homepages: every <script> becomes a SPARK one, an onclick" + NL
    t = t + "' (or any on...) that isn't just the name of a SUB is renamed so it does" + NL
    t = t + "' nothing, and a tag with javascript: (or an &#entity hiding it) is dropped." + NL
    t = t + "' Tags are cut out the way Simxplorer cuts them: from < to the next >." + NL
    t = t + "FUNCTION Defang (html AS String) AS String" + NL
    t = t + "    VAR parts AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR stop AS Integer" + NL
    t = t + "    parts = html.Split(""<"")" + NL
    t = t + "    FOR i = 1 TO parts.Count - 1" + NL
    t = t + "        p = parts[i]" + NL
    t = t + "        stop = p.IndexOf("">"")" + NL
    t = t + "        IF stop < 0 THEN stop = p.Length" + NL
    t = t + "        parts[i] = SafeTag(p.Substring(0, stop)) + p.Substring(stop, p.Length - stop)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN parts.Join(""<"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION SafeTag (tag AS String) AS String" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    VAR squeezed AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    VAR v AS String" + NL
    t = t + "    low = "" "" + tag.Lower().Replace(Chr(10), "" "").Replace(Chr(13), "" "").Replace(Chr(9), "" "")" + NL
    t = t + "    squeezed = low.Replace("" "", """")" + NL
    t = t + "    IF squeezed.Contains(""script:"") OR squeezed.Contains(""&#"") OR squeezed.Contains(""&colon"") OR squeezed.Contains(""&tab"") OR squeezed.Contains(""&newline"") THEN RETURN ""!-- GeoSimies took a script out here --""" + NL
    t = t + "    IF TagWord(low) = ""script"" THEN RETURN ""script type=""""spark""""""" + NL
    t = t + "    at = low.IndexOf(""on"")" + NL
    t = t + "    WHILE at > 0" + NL
    t = t + "        c = low.CharAt(at - 1)" + NL
    t = t + "        IF NOT ""abcdefghijklmnopqrstuvwxyz0123456789_-"".Contains(c) THEN" + NL
    t = t + "            ' the attribute's name, then = and its value" + NL
    t = t + "            i = at + 2" + NL
    t = t + "            WHILE i < low.Length AND ""abcdefghijklmnopqrstuvwxyz"".Contains(low.CharAt(i))" + NL
    t = t + "                i = i + 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "            WHILE i < low.Length AND low.CharAt(i) = "" """ + NL
    t = t + "                i = i + 1" + NL
    t = t + "            END WHILE" + NL
    t = t + "            IF i < low.Length AND low.CharAt(i) = ""="" THEN" + NL
    t = t + "                v = AttrValue(low, i + 1)" + NL
    t = t + "                IF v = """" OR NOT OnlyFrom(v, ""abcdefghijklmnopqrstuvwxyz0123456789_"") THEN tag = tag.Substring(0, at - 1) + ""no"" + tag.Substring(at + 1, tag.Length - at - 1)" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        IF low.Substring(at + 1, low.Length - at - 1).IndexOf(""on"") < 0 THEN BREAK" + NL
    t = t + "        at = at + 1 + low.Substring(at + 1, low.Length - at - 1).IndexOf(""on"")" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN tag" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The tag's name: ""a"" for "" a href=..."", ""/a"" for "" /a""." + NL
    t = t + "FUNCTION TagWord (low AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    low = low.Trim()" + NL
    t = t + "    i = 0" + NL
    t = t + "    IF low.StartsWith(""/"") THEN i = 1" + NL
    t = t + "    WHILE i < low.Length AND ""abcdefghijklmnopqrstuvwxyz0123456789"".Contains(low.CharAt(i))" + NL
    t = t + "        i = i + 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    RETURN low.Substring(0, i)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The value of an attribute whose = is just before from, trimmed." + NL
    t = t + "FUNCTION AttrValue (low AS String, from AS Integer) AS String" + NL
    t = t + "    VAR q AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    rest = low.Substring(from, low.Length - from).Trim()" + NL
    t = t + "    IF rest = """" THEN RETURN """"" + NL
    t = t + "    q = rest.CharAt(0)" + NL
    t = t + "    IF q = """""""" OR q = ""'"" THEN" + NL
    t = t + "        rest = rest.Substring(1, rest.Length - 1)" + NL
    t = t + "        IF rest.IndexOf(q) >= 0 THEN rest = rest.Substring(0, rest.IndexOf(q))" + NL
    t = t + "        RETURN rest.Trim()" + NL
    t = t + "    END IF" + NL
    t = t + "    IF rest.IndexOf("" "") >= 0 THEN rest = rest.Substring(0, rest.IndexOf("" ""))" + NL
    t = t + "    RETURN rest" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION PageHits (hood AS String, num AS String, pg AS String) AS Integer" + NL
    t = t + "    RETURN Int(Val(ReadOr(SiteData(hood, num) + ""\"" + pg.Upper() + "".CNT"", ""0"")))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- guestbooks" + NL
    t = t + "" + NL
    t = t + "' C:\GEODATA\SITES\<hood>\<n>\GUEST.TXT, oldest first:" + NL
    t = t + "'   number|date time|name|where from|message" + NL
    t = t + "FUNCTION GuestPath (hood AS String, num AS String) AS String" + NL
    t = t + "    RETURN SiteData(hood, num) + ""\GUEST.TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION SignGuestbook (hood AS String, num AS String, name AS String, from AS String, text AS String) AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR keep AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR last AS Integer" + NL
    t = t + "    name = OneLine(name, 1000)" + NL
    t = t + "    from = OneLine(from, 1000)" + NL
    t = t + "    text = Clip(text, 100000)" + NL
    t = t + "    IF FindSite(hood, num) = """" THEN RETURN ""There is no homepage there.""" + NL
    t = t + "    IF name = """" THEN RETURN ""Tell us your name!""" + NL
    t = t + "    IF text = """" THEN RETURN ""Write something in the guestbook!""" + NL
    t = t + "    IF name.Length > MAXNAME THEN RETURN ""Keep your name under "" + Str(MAXNAME) + "" characters.""" + NL
    t = t + "    IF from.Length > MAXFROM THEN RETURN ""Keep where you're from under "" + Str(MAXFROM) + "" characters.""" + NL
    t = t + "    IF text.Length > MAXSIGN THEN RETURN ""Keep your message under "" + Str(MAXSIGN) + "" characters.""" + NL
    t = t + "    lines = ReadOr(GuestPath(hood, num), """").Lines()" + NL
    t = t + "    FOR i = 0 TO lines.Count - 1" + NL
    t = t + "        IF lines[i] = """" THEN CONTINUE" + NL
    t = t + "        last = Int(Val(lines[i].Split(""|"")[0]))" + NL
    t = t + "        IF i >= lines.Count - GUESTKEEP THEN keep.Add(lines[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    keep.Add(Str(last + 1) + ""|"" + Stamp() + ""|"" + Esc(name) + ""|"" + Esc(from) + ""|"" + Esc(text))" + NL
    t = t + "    FS.Write(GuestPath(hood, num), keep.Join(Chr(10)) + Chr(10))" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION GuestEntries (hood AS String, num AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(GuestPath(hood, num), """").Lines()" + NL
    t = t + "        IF line <> """" THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB DeleteEntry (hood AS String, num AS String, id AS String)" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    IF NOT IsNumber(id) THEN RETURN" + NL
    t = t + "    line = FindLine(ReadOr(GuestPath(hood, num), """"), id)" + NL
    t = t + "    IF line <> """" THEN FS.Write(GuestPath(hood, num), SwapLine(FS.Read(GuestPath(hood, num)), line, """"))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- webrings" + NL
    t = t + "" + NL
    t = t + "' C:\GEODATA\RINGS.TXT: id|owner hood/number|name|description" + NL
    t = t + "' C:\GEODATA\RINGS\<id>.TXT: one member (hood/number) per line, in ring order" + NL
    t = t + "FUNCTION FindRing (id AS String) AS String" + NL
    t = t + "    IF NOT IsNumber(id) THEN RETURN """"" + NL
    t = t + "    RETURN FindLine(ReadOr(DATADIR + ""\RINGS.TXT"", """"), id)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RingName (ring AS String) AS String" + NL
    t = t + "    RETURN Unesc(ring.Split(""|"")[2])" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RingDesc (ring AS String) AS String" + NL
    t = t + "    RETURN Unesc(ring.Split(""|"")[3])" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RingMembers (id AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\RINGS\"" + id + "".TXT"", """").Lines()" + NL
    t = t + "        IF line.Trim() <> """" THEN out.Add(line.Trim())" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RingsOf (hood AS String, num AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    FOR EACH id IN ReadOr(SiteData(hood, num) + ""\RINGS.TXT"", ""|"").Split(""|"")" + NL
    t = t + "        IF id <> """" THEN out.Add(id)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION InRing (hood AS String, num AS String, id AS String) AS Bool" + NL
    t = t + "    RETURN ReadOr(SiteData(hood, num) + ""\RINGS.TXT"", ""|"").Contains(""|"" + id + ""|"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CreateRing (hood AS String, num AS String, name AS String, desc AS String) AS String" + NL
    t = t + "    VAR id AS Integer" + NL
    t = t + "    name = OneLine(name, 1000)" + NL
    t = t + "    desc = OneLine(desc, 1000)" + NL
    t = t + "    IF name = """" THEN RETURN ""Give your webring a name.""" + NL
    t = t + "    IF name.Length > MAXRINGNAME THEN RETURN ""Keep the name under "" + Str(MAXRINGNAME) + "" characters.""" + NL
    t = t + "    IF desc.Length > MAXDESC THEN RETURN ""Keep the description under "" + Str(MAXDESC) + "" characters.""" + NL
    t = t + "    IF RingsOf(hood, num).Count >= MAXRINGS THEN RETURN ""A homepage can be in "" + Str(MAXRINGS) + "" webrings at most.""" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    id = Int(Val(ReadOr(DATADIR + ""\RINGID.TXT"", ""0""))) + 1" + NL
    t = t + "    FS.Write(DATADIR + ""\RINGID.TXT"", Str(id))" + NL
    t = t + "    FS.Append(DATADIR + ""\RINGS.TXT"", Str(id) + ""|"" + hood.Lower() + ""/"" + num + ""|"" + Esc(name) + ""|"" + Esc(desc) + Chr(10))" + NL
    t = t + "    RETURN JoinRing(hood, num, Str(id))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION JoinRing (hood AS String, num AS String, id AS String) AS String" + NL
    t = t + "    IF FindRing(id) = """" THEN RETURN ""There is no such webring.""" + NL
    t = t + "    IF InRing(hood, num, id) THEN RETURN ""You're already in that webring.""" + NL
    t = t + "    IF RingsOf(hood, num).Count >= MAXRINGS THEN RETURN ""A homepage can be in "" + Str(MAXRINGS) + "" webrings at most.""" + NL
    t = t + "    FS.Append(DATADIR + ""\RINGS\"" + id + "".TXT"", hood.Lower() + ""/"" + num + Chr(10))" + NL
    t = t + "    FS.Write(SiteData(hood, num) + ""\RINGS.TXT"", ReadOr(SiteData(hood, num) + ""\RINGS.TXT"", ""|"") + id + ""|"")" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB LeaveRing (hood AS String, num AS String, id AS String)" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    IF NOT InRing(hood, num, id) THEN RETURN" + NL
    t = t + "    path = DATADIR + ""\RINGS\"" + id + "".TXT""" + NL
    t = t + "    FS.Write(path, SwapLine(ReadOr(path, """"), hood.Lower() + ""/"" + num, """"))" + NL
    t = t + "    FS.Write(SiteData(hood, num) + ""\RINGS.TXT"", ReadOr(SiteData(hood, num) + ""\RINGS.TXT"", ""|"").Replace(""|"" + id + ""|"", ""|""))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where << Prev, Next >> or Random goes from hood/number: another member," + NL
    t = t + "' going round (the last one's Next is the first). """" for an empty ring." + NL
    t = t + "FUNCTION RingStep (id AS String, here AS String, way AS String) AS String" + NL
    t = t + "    VAR members AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    members = RingMembers(id)" + NL
    t = t + "    n = members.Count" + NL
    t = t + "    IF n = 0 THEN RETURN """"" + NL
    t = t + "    i = members.IndexOf(here.Lower())" + NL
    t = t + "    IF way = ""next"" THEN RETURN members[(i + 1) MOD n]" + NL
    t = t + "    IF way = ""prev"" THEN" + NL
    t = t + "        IF i < 0 THEN RETURN members[n - 1]" + NL
    t = t + "        RETURN members[(i - 1 + n) MOD n]" + NL
    t = t + "    END IF" + NL
    t = t + "    ' Random: anybody but here" + NL
    t = t + "    IF n = 1 THEN RETURN members[0]" + NL
    t = t + "    IF i < 0 THEN RETURN members[Rnd(n)]" + NL
    t = t + "    j = Rnd(n - 1)" + NL
    t = t + "    IF j >= i THEN j = j + 1" + NL
    t = t + "    RETURN members[j]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the directory" + NL
    t = t + "" + NL
    t = t + "' Every homepage, as hood|number|user|title|description|updated" + NL
    t = t + "FUNCTION AllSites () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR entry AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH entry IN Hoods()" + NL
    t = t + "        FOR EACH line IN ReadOr(DATADIR + ""\HOODS\"" + entry.Split(""|"")[0] + "".TXT"", """").Lines()" + NL
    t = t + "            IF line <> """" THEN out.Add(entry.Split(""|"")[0] + ""|"" + line)" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION SiteCount (hood AS String) AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\HOODS\"" + hood + "".TXT"", """").Lines()" + NL
    t = t + "        IF line <> """" THEN n = n + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Cool Site of the Day: a different homepage every day, the same one all day." + NL
    t = t + "FUNCTION CoolSite () AS String" + NL
    t = t + "    VAR all AS Array OF String" + NL
    t = t + "    all = AllSites()" + NL
    t = t + "    IF all.Count = 0 THEN RETURN """"" + NL
    t = t + "    RETURN all[(Int(TIME.Now / 86400) * 7919) MOD all.Count]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One homepage as a row of the directory, from a hood|number|user|title|... line." + NL
    t = t + "FUNCTION SiteRow (line AS String) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    IF p.Count < 6 THEN RETURN """"" + NL
    t = t + "    RETURN ""<tr><td valign=""""top""""><font size=""""2""""><b>"" + HoodInfo(p[0], 1) + "" "" + p[1] + ""</b></font></td><td><font size=""""2""""><a href="""""" + SiteLink(p[0], p[1]) + """"""><b>"" + H(Unesc(p[3])) + ""</b></a> <font color=""""#808080"""">by ~"" + p[2] + ""</font><br>"" + H(Unesc(p[4])) + ""</font></td></tr>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- page furniture" + NL
    t = t + "" + NL
    t = t + "FUNCTION Top (title AS String, desc AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = ""<html><head><title>"" + H(title) + "" - GeoSimies</title>"" _" + NL
    t = t + "      + ""<meta name=""""description"""" content="""""" + H(desc) + """""">"" _" + NL
    t = t + "      + ""<meta name=""""keywords"""" content=""""free homepage, free web hosting, home page, personal web page, geocities, geosimies, neighborhood, homesteading, web ring, webring, guestbook, hit counter, under construction"""">"" _" + NL
    t = t + "      + ""</head><body bgcolor=""""#FFFFFF"""" text=""""#000000"""" link=""""#0000CC"""" vlink=""""#660099"""">"" _" + NL
    t = t + "      + ""<table width=""""100%"""" cellpadding=""""4"""" cellspacing=""""0"""" bgcolor=""""#000080""""><tr>"" _" + NL
    t = t + "      + ""<td bgcolor=""""#FFFFFF"""" width=""""104""""><a href=""""index.asp""""><img src=""""clipart/geologo.pic"""" alt=""""GeoSimies"""" width=""""100"""" height=""""24""""></a></td>"" _" + NL
    t = t + "      + ""<td><font color=""""#FFFF00"""" size=""""2""""><b>Free homepages for the whole SIM95 network!</b></font></td>"" _" + NL
    t = t + "      + ""<td align=""""right""""><font color=""""#FFFFFF"""" size=""""2"""">"" _" + NL
    t = t + "      + ""<a href=""""index.asp""""><font color=""""#FFFFFF"""">Home</font></a> | "" _" + NL
    t = t + "      + ""<a href=""""hood.asp""""><font color=""""#FFFFFF"""">Neighborhoods</font></a> | "" _" + NL
    t = t + "      + ""<a href=""""rings.asp""""><font color=""""#FFFFFF"""">Webrings</font></a> | """ + NL
    t = t + "    IF viewer <> """" THEN" + NL
    t = t + "        s = s + ""<a href=""""edit.asp""""><font color=""""#FFFFFF"""">My Homepage</font></a> | "" _" + NL
    t = t + "              + ""<a href=""""logout.asp?t="" + formToken + """"""><font color=""""#FFFFFF"""">Log out</font></a>""" + NL
    t = t + "    ELSE" + NL
    t = t + "        s = s + ""<a href=""""signup.asp""""><font color=""""#FFFFFF"""">Get a FREE Homepage</font></a> | "" _" + NL
    t = t + "              + ""<a href=""""index.asp""""><font color=""""#FFFFFF"""">Log in</font></a>""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN s + ""</font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Bottom () AS String" + NL
    t = t + "    RETURN ""<hr><center><font size=""""1"""" color=""""#808080"""">GeoSimies on "" + H(SERVER.Name) + "" &middot; "" + TIME.Date + "" &middot; <a href=""""geosimie.htm"""">About GeoSimies</a><br><a href=""""geosimie.htm""""><img src=""""clipart/bestview.pic"""" alt=""""Best viewed in Simxplorer"""" width=""""88"""" height=""""31""""></a></font></center></body></html>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION BoxTop (title AS String, colour AS String) AS String" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""3"""" cellspacing=""""0""""><tr><td bgcolor="""""" + colour + """"""><font color=""""#FFFFFF"""" size=""""2""""><b>"" + title + ""</b></font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Notice (text AS String) AS String" + NL
    t = t + "    IF text = """" THEN RETURN """"" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""4""""><tr><td bgcolor=""""#FFFFCC""""><font size=""""2"""">"" + H(text) + ""</font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION HoodOptions (current AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR entry AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    FOR EACH entry IN Hoods()" + NL
    t = t + "        p = entry.Split(""|"")" + NL
    t = t + "        IF p[0] = current.Upper() THEN" + NL
    t = t + "            out = out + ""<option value="""""" + p[0] + """""" selected>"" + p[1] + ""</option>""" + NL
    t = t + "        ELSE" + NL
    t = t + "            out = out + ""<option value="""""" + p[0] + """""">"" + p[1] + ""</option>""" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION TemplateOptions () AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR t AS String" + NL
    t = t + "    FOR EACH t IN Templates()" + NL
    t = t + "        out = out + ""<option value="""""" + t.Split(""|"")[0] + """""">"" + t.Split(""|"")[1] + ""</option>""" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A text box that counts down as you type, and the page script that does the" + NL
    t = t + "' counting (as in SimBook). Voyager sends a whole form as one 64K message and a" + NL
    t = t + "' text area has no maxlength, so this greys out the button (id=""go"") while a" + NL
    t = t + "' box holds too much. The server checks again anyway." + NL
    t = t + "FUNCTION LimitedBox (name AS String, value AS String, rows AS Integer, cols AS Integer, most AS Integer) AS String" + NL
    t = t + "    RETURN ""<textarea name="""""" + name + """""" id="""""" + name + """""" rows="""""" + Str(rows) + """""" cols="""""" + Str(cols) + """""" onchange=""""Limits_Check"""">"" + H(value) + ""</textarea><br>"" _" + NL
    t = t + "         + ""<font size=""""1"""" color=""""#808080"""" id="""""" + name + ""_n"""">up to "" + Str(most) + "" characters</font>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LimitScript (names AS String, limits AS String) AS String" + NL
    t = t + "    RETURN ""<script type=""""spark"""">"" + Chr(10) _" + NL
    t = t + "         + ""SUB Limits_Check ()"" + Chr(10) _" + NL
    t = t + "         + ""    VAR names AS Array OF String"" + Chr(10) _" + NL
    t = t + "         + ""    VAR limits AS Array OF String"" + Chr(10) _" + NL
    t = t + "         + ""    VAR i AS Integer"" + Chr(10) _" + NL
    t = t + "         + ""    VAR n AS Integer"" + Chr(10) _" + NL
    t = t + "         + ""    VAR most AS Integer"" + Chr(10) _" + NL
    t = t + "         + ""    VAR fits AS Bool = TRUE"" + Chr(10) _" + NL
    t = t + "         + ""    names = """""" + names + """""".Split("""","""")"" + Chr(10) _" + NL
    t = t + "         + ""    limits = """""" + limits + """""".Split("""","""")"" + Chr(10) _" + NL
    t = t + "         + ""    FOR i = 0 TO names.Count - 1"" + Chr(10) _" + NL
    t = t + "         + ""        n = PAGE.Get(names[i]).Value.Length"" + Chr(10) _" + NL
    t = t + "         + ""        most = Int(Val(limits[i]))"" + Chr(10) _" + NL
    t = t + "         + ""        IF n > most THEN"" + Chr(10) _" + NL
    t = t + "         + ""            PAGE.Get(names[i] + """"_n"""").Text = Str(n - most) + """" characters too many"""""" + Chr(10) _" + NL
    t = t + "         + ""            fits = FALSE"" + Chr(10) _" + NL
    t = t + "         + ""        ELSE"" + Chr(10) _" + NL
    t = t + "         + ""            PAGE.Get(names[i] + """"_n"""").Text = Str(most - n) + """" characters left"""""" + Chr(10) _" + NL
    t = t + "         + ""        END IF"" + Chr(10) _" + NL
    t = t + "         + ""    NEXT"" + Chr(10) _" + NL
    t = t + "         + ""    PAGE.Get(""""go"""").Enabled = fits"" + Chr(10) _" + NL
    t = t + "         + ""END SUB"" + Chr(10) _" + NL
    t = t + "         + ""</script>""" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\WEB\GEO.SPK")
END SUB

SUB File4 ()
    t = ""
    t = t + "<html><head><title>About GeoSimies - free homepages for the SIM95 network</title>" + NL
    t = t + "<meta name=""description"" content=""GeoSimies is free web hosting for everybody on the SIM95 network: a free homepage in a neighborhood, a page editor with templates and clip art, a hit counter, a guestbook and webrings."">" + NL
    t = t + "<meta name=""keywords"" content=""free homepage, free web hosting, free web space, personal home page, home page builder, website builder, geocities, homesteading, neighborhoods, webring, web ring, guestbook, hit counter, visitor counter, clip art, animated gifs, under construction, marquee, blink, html, personal website, fan page, tripod, angelfire"">" + NL
    t = t + "</head>" + NL
    t = t + "<body bgcolor=""#FFFFFF"">" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""0"" bgcolor=""#000080""><tr><td bgcolor=""#FFFFFF"" width=""104""><img src=""clipart/geologo.pic"" alt=""GeoSimies"" width=""100"" height=""24""></td><td><font color=""#FFFF00"" size=""4""><b>Free homepages for the whole SIM95 network!</b></font></td></tr></table>" + NL
    t = t + "<h2><font color=""#000080"">About GeoSimies</font></h2>" + NL
    t = t + "<p><b>GeoSimies is free web hosting for the SIM95 network.</b> Everybody gets a free homepage:" + NL
    t = t + "a little piece of the World Wide Web with your name on it. No HTML? No problem. Start from a" + NL
    t = t + "template, change the words, and you're on the Web.</p>" + NL
    t = t + "<h3>What you get, free</h3>" + NL
    t = t + "<ul>" + NL
    t = t + "<li><b>A homepage in a neighborhood</b>, with an address of your own, like Area95 1001. Live with" + NL
    t = t + "people who like the same things you do: Area95 (UFOs and sci-fi), Simwood (movies and TV)," + NL
    t = t + "ChipVale (computers), Hometown (family and pets), NeoTokyo (anime and games), RockCity (music)," + NL
    t = t + "Stadium (sports) and Toyland (kids).</li>" + NL
    t = t + "<li><b>A page editor</b> right in your browser, with a preview. Up to six pages.</li>" + NL
    t = t + "<li><b>Templates</b> bursting with style: starry skies, marquees, blinking text and a spinning globe.</li>" + NL
    t = t + "<li><b>Free clip art</b>: under construction signs, e-mail me buttons, rainbow lines and more." + NL
    t = t + "Add your own pictures too.</li>" + NL
    t = t + "<li><b>A hit counter</b> so you know how many people stopped by.</li>" + NL
    t = t + "<li><b>A guestbook</b> for your visitors to sign.</li>" + NL
    t = t + "<li><b>Webrings</b>: join a ring of homepages about the same thing, or start your own.</li>" + NL
    t = t + "<li><b>Cool Site of the Day</b>: maybe it'll be yours!</li>" + NL
    t = t + "</ul>" + NL
    t = t + "<h3>Is it like GeoCities, Tripod or Angelfire?</h3>" + NL
    t = t + "<p>Very much so. GeoSimies is a homesteading community for personal home pages, written in SPARK" + NL
    t = t + "and running on one SIM95 machine. Your pages are kept in plain text files in C:\GEODATA, and" + NL
    t = t + "the search engines find them through the neighborhood directory.</p>" + NL
    t = t + "<p><a href=""signup.asp""><b>Get your free homepage</b></a> or <a href=""index.asp"">log in</a>." + NL
    t = t + "Look around <a href=""hood.asp"">the neighborhoods</a> or the <a href=""rings.asp"">webrings</a>.</p>" + NL
    t = t + "<p align=""center""><img src=""clipart/bestview.pic"" alt=""Best viewed in Simxplorer"" width=""88"" height=""31""></p>" + NL
    t = t + "<hr><center><font size=""1"" color=""#808080"">GeoSimies: free homepages, free web hosting, neighborhoods, guestbooks, hit counters and webrings for SIM95.</font></center>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\GEOSIMIE.HTM")
END SUB

SUB File5 ()
    t = ""
    t = t + "<%@ import file=""GEO.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' GUEST.ASP?h=hood&n=number - a homepage's guestbook: read it, sign it. Anybody" + NL
    t = t + "' may sign; the owner may take entries out (POST do=del, with their token)." + NL
    t = t + "' Everything visitors write is escaped." + NL
    t = t + "VAR hood AS String" + NL
    t = t + "VAR num AS String" + NL
    t = t + "VAR site AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR entries AS Array OF String" + NL
    t = t + "VAR e AS Array OF String" + NL
    t = t + "VAR out AS String" + NL
    t = t + "VAR i AS Integer" + NL
    t = t + "VAR mine AS Bool" + NL
    t = t + "VAR back AS String" + NL
    t = t + "hood = REQUEST.Query(""h"").Upper()" + NL
    t = t + "num = REQUEST.Query(""n"")" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    hood = REQUEST.Form(""h"").Upper()" + NL
    t = t + "    num = REQUEST.Form(""n"")" + NL
    t = t + "END IF" + NL
    t = t + "site = FindSite(hood, num)" + NL
    t = t + "IF site = """" THEN RESPONSE.Redirect(""hood.asp"")" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "mine = viewer <> """" AND viewer = site.Split(""|"")[1]" + NL
    t = t + "back = ""guest.asp?h="" + hood.Lower() + ""&n="" + num" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    IF REQUEST.Form(""do"") = ""del"" THEN" + NL
    t = t + "        RequireLogin()" + NL
    t = t + "        RequireToken()" + NL
    t = t + "        IF mine THEN DeleteEntry(hood, num, REQUEST.Form(""id""))" + NL
    t = t + "        RESPONSE.Redirect(back)" + NL
    t = t + "    END IF" + NL
    t = t + "    problem = SignGuestbook(hood, num, REQUEST.Form(""name""), REQUEST.Form(""from""), REQUEST.Form(""msg""))" + NL
    t = t + "    IF problem = """" THEN RESPONSE.Redirect(back + ""&e=thanks"")" + NL
    t = t + "END IF" + NL
    t = t + "entries = GuestEntries(hood, num)" + NL
    t = t + "FOR i = entries.Count - 1 TO 0 STEP -1" + NL
    t = t + "    e = entries[i].Split(""|"")" + NL
    t = t + "    IF e.Count < 5 THEN CONTINUE" + NL
    t = t + "    out = out + ""<tr><td bgcolor=""""#FFFFE0""""><font size=""""2""""><b>"" + H(Unesc(e[2])) + ""</b>""" + NL
    t = t + "    IF e[3] <> """" THEN out = out + "" from "" + H(Unesc(e[3]))" + NL
    t = t + "    out = out + "" <font color=""""#808080"""">"" + e[1] + ""</font><br>"" + Br(Unesc(e[4])) + ""</font>""" + NL
    t = t + "    IF mine THEN out = out + ""<form action=""""guest.asp"""" method=""""post"""">"" + TokenField() + ""<input type=""""hidden"""" name=""""do"""" value=""""del""""><input type=""""hidden"""" name=""""h"""" value="""""" + hood.Lower() + """"""><input type=""""hidden"""" name=""""n"""" value="""""" + num + """"""><input type=""""hidden"""" name=""""id"""" value="""""" + e[0] + """"""><input type=""""submit"""" value=""""Delete""""></form>""" + NL
    t = t + "    out = out + ""</td></tr>""" + NL
    t = t + "    IF out.Length > PAGEROOM THEN" + NL
    t = t + "        out = out + ""<tr><td><font size=""""2"""" color=""""#808080"""">...and older entries.</font></td></tr>""" + NL
    t = t + "        BREAK" + NL
    t = t + "    END IF" + NL
    t = t + "NEXT" + NL
    t = t + "IF out = """" THEN out = ""<tr><td><font size=""""2"""" color=""""#808080"""">Nobody has signed yet. Be the first!</font></td></tr>""" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Guestbook: "" + SiteTitle(site), ""The guestbook of "" + SiteTitle(site) + "" at "" + HoodInfo(hood, 1) + "" "" + num + "" on GeoSimies."") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<h2><font color=""#000080"">Guestbook</font></h2>" + NL
    t = t + "<p><font size=""2"">for <a href=""<%= SiteLink(hood, num) %>""><b><%= H(SiteTitle(site)) %></b></a> at <%= HoodInfo(hood, 1) %> <%= num %></font></p>" + NL
    t = t + "<% IF REQUEST.Query(""e"") = ""thanks"" THEN %><%= Notice(""Thanks for signing!"") %><% END IF %>" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<table width=""100%"" cellpadding=""4"" cellspacing=""2"">" + NL
    t = t + "<%= out %>" + NL
    t = t + "</table>" + NL
    t = t + "</td><td width=""300"" valign=""top"">" + NL
    t = t + "<a name=""sign""></a>" + NL
    t = t + "<%= BoxTop(""Sign the Guestbook"", ""#008000"") %>" + NL
    t = t + "<form action=""guest.asp"" method=""post"">" + NL
    t = t + "<input type=""hidden"" name=""h"" value=""<%= hood.Lower() %>""><input type=""hidden"" name=""n"" value=""<%= num %>"">" + NL
    t = t + "<p><font size=""2"">Your name:</font><br><input name=""name"" size=""30"" value=""<%= H(REQUEST.Form(""name"")) %>""></p>" + NL
    t = t + "<p><font size=""2"">Where are you from?</font><br><input name=""from"" size=""30"" value=""<%= H(REQUEST.Form(""from"")) %>""></p>" + NL
    t = t + "<p><font size=""2"">Your message:</font><br><%= LimitedBox(""msg"", REQUEST.Form(""msg""), 6, 34, MAXSIGN) %></p>" + NL
    t = t + "<p><input type=""submit"" id=""go"" value=""Sign It!""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<%= LimitScript(""msg"", Str(MAXSIGN)) %>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\GUEST.ASP")
END SUB

SUB File6 ()
    t = ""
    t = t + "<%@ import file=""GEO.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' HOOD.ASP?h=hood - the directory: every homepage in one neighborhood, or" + NL
    t = t + "' (with no h) the neighborhoods themselves. These links are how AskSim's" + NL
    t = t + "' crawler finds members' pages." + NL
    t = t + "VAR hood AS String" + NL
    t = t + "VAR entry AS String" + NL
    t = t + "VAR p AS Array OF String" + NL
    t = t + "VAR out AS String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR shown AS Integer" + NL
    t = t + "VAR total AS Integer" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "hood = REQUEST.Query(""h"").Upper()" + NL
    t = t + "IF NOT IsHood(hood) THEN hood = """"" + NL
    t = t + "IF hood <> """" THEN" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\HOODS\"" + hood + "".TXT"", """").Lines()" + NL
    t = t + "        IF line = """" THEN CONTINUE" + NL
    t = t + "        total = total + 1" + NL
    t = t + "        IF out.Length > PAGEROOM THEN CONTINUE" + NL
    t = t + "        out = out + SiteRow(hood + ""|"" + line)" + NL
    t = t + "        shown = shown + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "END IF" + NL
    t = t + "%>" + NL
    t = t + "<% IF hood = """" THEN %>" + NL
    t = t + "<%= Top(""The Neighborhoods"", ""The GeoSimies neighborhoods: free homepages about UFOs and sci-fi, movies, computers, family and pets, anime, music, sports and toys."") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8""><tr><td>" + NL
    t = t + "<h2><font color=""#000080"">The Neighborhoods</font></h2>" + NL
    t = t + "<p>Every GeoSimies homepage lives in a neighborhood, with neighbors who like the same things." + NL
    t = t + "Pick one to look around.</p>" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""2"">" + NL
    t = t + "<% FOR EACH entry IN Hoods()" + NL
    t = t + "     p = entry.Split(""|"") %>" + NL
    t = t + "<tr><td bgcolor=""<%= p[3] %>"" width=""120""><a href=""hood.asp?h=<%= p[0].Lower() %>""><font color=""#FFFFFF"" size=""4""><b><%= p[1] %></b></font></a></td>" + NL
    t = t + "<td><%= H(p[2]) %><br><font size=""2"" color=""#808080""><%= SiteCount(p[0]) %> homepages &middot; <a href=""signup.asp?h=<%= p[0].Lower() %>"">move in here</a></font></td></tr>" + NL
    t = t + "<% NEXT %>" + NL
    t = t + "</table>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<%= Top(HoodInfo(hood, 1) + "" - "" + HoodInfo(hood, 2), ""Free homepages in "" + HoodInfo(hood, 1) + "" on GeoSimies: "" + HoodInfo(hood, 2)) %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" bgcolor=""<%= HoodInfo(hood, 3) %>""><tr><td><font color=""#FFFFFF"" size=""6""><b><%= HoodInfo(hood, 1) %></b></font><br>" + NL
    t = t + "<font color=""#FFFFFF""><%= H(HoodInfo(hood, 2)) %></font></td></tr></table>" + NL
    t = t + "<table width=""100%"" cellpadding=""8""><tr><td>" + NL
    t = t + "<p><font size=""2""><%= total %> homepages live here. <a href=""signup.asp?h=<%= hood.Lower() %>"">Move in!</a> &middot; <a href=""hood.asp"">All the neighborhoods</a></font></p>" + NL
    t = t + "<table width=""100%"" cellpadding=""4"" cellspacing=""2"">" + NL
    t = t + "<%= out %>" + NL
    t = t + "</table>" + NL
    t = t + "<% IF total = 0 THEN %><p><font size=""2"" color=""#808080"">Nobody lives here yet. Be the first!</font></p><% END IF %>" + NL
    t = t + "<% IF shown < total THEN %><p><font size=""2"" color=""#808080"">...and <%= total - shown %> more.</font></p><% END IF %>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\HOOD.ASP")
END SUB

SUB File7 ()
    t = ""
    t = t + "<%@ import file=""GEO.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' INDEX.ASP - the front page: Cool Site of the Day, the neighborhoods, who" + NL
    t = t + "' just moved in, and a box to log in." + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR cool AS Array OF String" + NL
    t = t + "VAR coolLine AS String" + NL
    t = t + "VAR entry AS String" + NL
    t = t + "VAR p AS Array OF String" + NL
    t = t + "VAR newest AS Array OF String" + NL
    t = t + "VAR i AS Integer" + NL
    t = t + "VAR site AS String" + NL
    t = t + "VAR home AS String" + NL
    t = t + "FixUp()" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "SELECT CASE REQUEST.Query(""e"")" + NL
    t = t + "    CASE ""login""" + NL
    t = t + "        problem = ""Please log in first.""" + NL
    t = t + "    CASE ""bad""" + NL
    t = t + "        problem = ""That member name and password do not match.""" + NL
    t = t + "    CASE ""bye""" + NL
    t = t + "        problem = ""You have logged out. Come back soon!""" + NL
    t = t + "END SELECT" + NL
    t = t + "coolLine = CoolSite()" + NL
    t = t + "IF coolLine <> """" THEN cool = coolLine.Split(""|"")" + NL
    t = t + "newest = ReadOr(DATADIR + ""\NEWEST.TXT"", """").Lines()" + NL
    t = t + "IF viewer <> """" THEN home = HomeOf(viewer)" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Free Homepages for Everybody"", ""GeoSimies gives everybody on the SIM95 network a free homepage in a neighborhood: an address of your own, a page editor, templates, clip art, a hit counter, a guestbook and webrings."") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr>" + NL
    t = t + "<td valign=""top"">" + NL
    t = t + "<h2><font color=""#000080"">Welcome to GeoSimies!</font></h2>" + NL
    t = t + "<p>Stake your claim on the information superhighway! GeoSimies gives you a <b>FREE homepage</b>" + NL
    t = t + "in one of our neighborhoods, with an address of your very own. Build it right here in your browser," + NL
    t = t + "add pictures, a hit counter, a guestbook, and join a webring to meet your neighbors.</p>" + NL
    t = t + "<% IF coolLine <> """" THEN %>" + NL
    t = t + "<%= BoxTop(""Cool Site of the Day"", ""#806000"") %>" + NL
    t = t + "<table cellpadding=""6""><tr><td><a href=""<%= SiteLink(cool[0], cool[1]) %>""><img src=""clipart/coolsite.pic"" alt=""Cool Site of the Day"" width=""88"" height=""31""></a></td>" + NL
    t = t + "<td><font size=""2""><a href=""<%= SiteLink(cool[0], cool[1]) %>""><b><%= H(Unesc(cool[3])) %></b></a><br>" + NL
    t = t + "<%= H(Unesc(cool[4])) %><br><font color=""#808080""><%= HoodInfo(cool[0], 1) %> <%= cool[1] %>, by ~<%= cool[2] %></font></font></td></tr></table>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= BoxTop(""The Neighborhoods"", ""#000080"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""4"" cellspacing=""2"">" + NL
    t = t + "<% FOR EACH entry IN Hoods()" + NL
    t = t + "     p = entry.Split(""|"") %>" + NL
    t = t + "<tr><td bgcolor=""<%= p[3] %>"" width=""110""><a href=""hood.asp?h=<%= p[0].Lower() %>""><font color=""#FFFFFF""><b><%= p[1] %></b></font></a></td>" + NL
    t = t + "<td><font size=""2""><%= H(p[2]) %> <font color=""#808080"">(<%= SiteCount(p[0]) %> homepages)</font></font></td></tr>" + NL
    t = t + "<% NEXT %>" + NL
    t = t + "</table>" + NL
    t = t + "</td>" + NL
    t = t + "<td width=""260"" valign=""top"">" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<% IF viewer <> """" THEN %>" + NL
    t = t + "<%= BoxTop(""Welcome home, ~"" + viewer, ""#008000"") %>" + NL
    t = t + "<p><font size=""2""><b><a href=""edit.asp"">Edit my homepage</a></b><br>" + NL
    t = t + "<% IF home <> """" THEN %>It lives at <a href=""<%= SiteLink(home.Split(""|"")[0], home.Split(""|"")[1]) %>""><%= HoodInfo(home.Split(""|"")[0], 1) %> <%= home.Split(""|"")[1] %></a>.<% END IF %></font></p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<%= BoxTop(""Members: Log In"", ""#008000"") %>" + NL
    t = t + "<form action=""login.asp"" method=""post"">" + NL
    t = t + "<table cellpadding=""2"">" + NL
    t = t + "<tr><td><font size=""2"">Member name:</font></td><td><input name=""u"" size=""12""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Password:</font></td><td><input type=""password"" name=""pw"" size=""12""></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Log In""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "</form>" + NL
    t = t + "<p align=""center""><font size=""3""><b><a href=""signup.asp"">Get your FREE homepage now!</a></b></font></p>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= BoxTop(""Just Moved In"", ""#800000"") %>" + NL
    t = t + "<table cellpadding=""2"">" + NL
    t = t + "<% FOR i = newest.Count - 1 TO 0 STEP -1" + NL
    t = t + "     IF newest.Count - i > 6 THEN BREAK" + NL
    t = t + "     p = newest[i].Split(""|"")" + NL
    t = t + "     IF p.Count < 2 THEN CONTINUE" + NL
    t = t + "     site = FindSite(p[0], p[1])" + NL
    t = t + "     IF site = """" THEN CONTINUE %>" + NL
    t = t + "<tr><td><font size=""2""><a href=""<%= SiteLink(p[0], p[1]) %>""><%= H(SiteTitle(site)) %></a><br><font color=""#808080""><%= HoodInfo(p[0], 1) %> <%= p[1] %></font></font></td></tr>" + NL
    t = t + "<% NEXT %>" + NL
    t = t + "</table>" + NL
    t = t + "<p><font size=""2""><a href=""rings.asp"">Browse the webrings</a></font></p>" + NL
    t = t + "</td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\INDEX.ASP")
END SUB

SUB File8 ()
    t = ""
    t = t + "<%@ import file=""GEO.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' JOIN.ASP - makes a new member, moves them in, and signs them in." + NL
    t = t + "VAR u AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""signup.asp"")" + NL
    t = t + "u = REQUEST.Form(""u"").Trim().Lower()" + NL
    t = t + "IF REQUEST.Form(""pw"") <> REQUEST.Form(""pw2"") THEN" + NL
    t = t + "    problem = ""The two passwords are different.""" + NL
    t = t + "ELSE" + NL
    t = t + "    problem = CreateMember(u, REQUEST.Form(""pw""), REQUEST.Form(""name""), REQUEST.Form(""h""), REQUEST.Form(""n""), REQUEST.Form(""title""), REQUEST.Form(""tpl""))" + NL
    t = t + "END IF" + NL
    t = t + "IF problem <> """" THEN RESPONSE.Redirect(""signup.asp?h="" + UrlEnc(REQUEST.Form(""h"").Lower()) + ""&why="" + UrlEnc(problem))" + NL
    t = t + "SignIn(u)" + NL
    t = t + "RESPONSE.Redirect(""edit.asp?new=1"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\JOIN.ASP")
END SUB

SUB File9 ()
    t = ""
    t = t + "<%@ import file=""GEO.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' LOGIN.ASP - checks the password, hands out a session cookie, and goes to the editor." + NL
    t = t + "VAR u AS String" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "u = CleanName(REQUEST.Form(""u""))" + NL
    t = t + "IF u = """" OR NOT CheckPassword(u, REQUEST.Form(""pw"")) THEN RESPONSE.Redirect(""index.asp?e=bad"")" + NL
    t = t + "SignIn(u)" + NL
    t = t + "RESPONSE.Redirect(""edit.asp"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\LOGIN.ASP")
END SUB

SUB File10 ()
    t = ""
    t = t + "<%@ import file=""GEO.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' LOGOUT.ASP?t=token - forgets the session. The token stops another site from" + NL
    t = t + "' logging you out." + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "SignOut()" + NL
    t = t + "RESPONSE.Redirect(""index.asp?e=bye"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\LOGOUT.ASP")
END SUB

SUB File11 ()
    t = ""
    t = t + "<%@ import file=""GEO.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' RING.ASP?r=id - one webring and its members." + NL
    t = t + "' RING.ASP?r=id&go=next|prev|rand&h=hood&n=number - the webring bar at the" + NL
    t = t + "' bottom of every member's page: on to the next homepage round the ring." + NL
    t = t + "VAR id AS String" + NL
    t = t + "VAR ring AS String" + NL
    t = t + "VAR there AS String" + NL
    t = t + "VAR m AS String" + NL
    t = t + "VAR site AS String" + NL
    t = t + "VAR out AS String" + NL
    t = t + "VAR home AS String" + NL
    t = t + "id = REQUEST.Query(""r"")" + NL
    t = t + "ring = FindRing(id)" + NL
    t = t + "IF ring = """" THEN RESPONSE.Redirect(""rings.asp"")" + NL
    t = t + "IF REQUEST.Query(""go"") <> """" THEN" + NL
    t = t + "    there = RingStep(id, REQUEST.Query(""h"").Lower() + ""/"" + REQUEST.Query(""n""), REQUEST.Query(""go""))" + NL
    t = t + "    IF there = """" THEN RESPONSE.Redirect(""ring.asp?r="" + id)" + NL
    t = t + "    RESPONSE.Redirect(there + ""/"")" + NL
    t = t + "END IF" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "IF viewer <> """" THEN home = HomeOf(viewer)" + NL
    t = t + "FOR EACH m IN RingMembers(id)" + NL
    t = t + "    site = FindSite(m.Split(""/"")[0], m.Split(""/"")[m.Split(""/"").Count - 1])" + NL
    t = t + "    IF site = """" THEN CONTINUE" + NL
    t = t + "    out = out + ""<tr><td><font size=""""2""""><a href="""""" + m + ""/""""><b>"" + H(SiteTitle(site)) + ""</b></a> <font color=""""#808080"""">"" + HoodInfo(m.Split(""/"")[0], 1) + "" "" + site.Split(""|"")[0] + ""</font><br>"" + H(SiteDesc(site)) + ""</font></td></tr>""" + NL
    t = t + "    IF out.Length > PAGEROOM THEN BREAK" + NL
    t = t + "NEXT" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Webring: "" + RingName(ring), RingName(ring) + "": a GeoSimies webring. "" + RingDesc(ring)) %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8""><tr><td valign=""top"">" + NL
    t = t + "<h2><font color=""#800080""><%= H(RingName(ring)) %></font></h2>" + NL
    t = t + "<p><%= H(RingDesc(ring)) %></p>" + NL
    t = t + "<p><font size=""2"">Started by <a href=""<%= ring.Split(""|"")[1] %>/""><%= HoodInfo(ring.Split(""|"")[1].Split(""/"")[0], 1) %> <%= ring.Split(""|"")[1].Split(""/"")[1] %></a>." + NL
    t = t + "<a href=""ring.asp?r=<%= id %>&go=rand"">Visit a random member</a> &middot; <a href=""rings.asp"">All webrings</a></font></p>" + NL
    t = t + "<% IF viewer <> """" AND home <> """" THEN %>" + NL
    t = t + "<% IF NOT InRing(home.Split(""|"")[0], home.Split(""|"")[1], id) THEN %>" + NL
    t = t + "<form action=""rings.asp"" method=""post""><%= TokenField() %><input type=""hidden"" name=""do"" value=""join""><input type=""hidden"" name=""r"" value=""<%= id %>""><input type=""submit"" value=""Join This Webring""></form>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= BoxTop(""Members"", ""#800080"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""4"" cellspacing=""2"">" + NL
    t = t + "<%= out %>" + NL
    t = t + "</table>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\RING.ASP")
END SUB

SUB File12 ()
    t = ""
    t = t + "<%@ import file=""GEO.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' RINGS.ASP - every webring; start one, join one, leave one." + NL
    t = t + "'   POST do=create  name, desc" + NL
    t = t + "'   POST do=join    r" + NL
    t = t + "'   POST do=leave   r" + NL
    t = t + "VAR home AS String" + NL
    t = t + "VAR hood AS String" + NL
    t = t + "VAR num AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR p AS Array OF String" + NL
    t = t + "VAR out AS String" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "IF viewer <> """" THEN" + NL
    t = t + "    home = HomeOf(viewer)" + NL
    t = t + "    hood = home.Split(""|"")[0]" + NL
    t = t + "    num = home.Split(""|"")[1]" + NL
    t = t + "END IF" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    RequireLogin()" + NL
    t = t + "    RequireToken()" + NL
    t = t + "    SELECT CASE REQUEST.Form(""do"")" + NL
    t = t + "        CASE ""create""" + NL
    t = t + "            problem = CreateRing(hood, num, REQUEST.Form(""name""), REQUEST.Form(""desc""))" + NL
    t = t + "        CASE ""join""" + NL
    t = t + "            problem = JoinRing(hood, num, REQUEST.Form(""r""))" + NL
    t = t + "            IF problem = """" THEN RESPONSE.Redirect(""ring.asp?r="" + REQUEST.Form(""r""))" + NL
    t = t + "        CASE ""leave""" + NL
    t = t + "            LeaveRing(hood, num, REQUEST.Form(""r""))" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF problem = """" THEN RESPONSE.Redirect(""rings.asp"")" + NL
    t = t + "END IF" + NL
    t = t + "FOR EACH line IN ReadOr(DATADIR + ""\RINGS.TXT"", """").Lines()" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    IF p.Count < 4 THEN CONTINUE" + NL
    t = t + "    out = out + ""<tr><td valign=""""top""""><font size=""""2""""><a href=""""ring.asp?r="" + p[0] + """"""><b>"" + H(Unesc(p[2])) + ""</b></a> <font color=""""#808080"""">("" + Str(RingMembers(p[0]).Count) + "" members)</font><br>"" + H(Unesc(p[3])) + ""</font></td><td>""" + NL
    t = t + "    IF viewer <> """" THEN" + NL
    t = t + "        IF InRing(hood, num, p[0]) THEN" + NL
    t = t + "            out = out + ""<form action=""""rings.asp"""" method=""""post"""">"" + TokenField() + ""<input type=""""hidden"""" name=""""do"""" value=""""leave""""><input type=""""hidden"""" name=""""r"""" value="""""" + p[0] + """"""><input type=""""submit"""" value=""""Leave""""></form>""" + NL
    t = t + "        ELSE" + NL
    t = t + "            out = out + ""<form action=""""rings.asp"""" method=""""post"""">"" + TokenField() + ""<input type=""""hidden"""" name=""""do"""" value=""""join""""><input type=""""hidden"""" name=""""r"""" value="""""" + p[0] + """"""><input type=""""submit"""" value=""""Join""""></form>""" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    out = out + ""</td></tr>""" + NL
    t = t + "    IF out.Length > PAGEROOM THEN BREAK" + NL
    t = t + "NEXT" + NL
    t = t + "IF out = """" THEN out = ""<tr><td><font size=""""2"""" color=""""#808080"""">No webrings yet. Start the first one!</font></td></tr>""" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Webrings"", ""GeoSimies webrings: rings of homepages about the same thing. Prev, Next or Random takes you round them all."") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8""><tr><td valign=""top"">" + NL
    t = t + "<h2><font color=""#000080"">Webrings</font></h2>" + NL
    t = t + "<p>A webring joins homepages about the same thing in a circle. At the bottom of every member's" + NL
    t = t + "page is <b>[ &lt;&lt; Prev | Ring Name | Next &gt;&gt; | Random ]</b>: follow it round and you'll" + NL
    t = t + "see them all.</p>" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<table width=""100%"" cellpadding=""4"" cellspacing=""2"">" + NL
    t = t + "<%= out %>" + NL
    t = t + "</table>" + NL
    t = t + "</td>" + NL
    t = t + "<% IF viewer <> """" THEN %>" + NL
    t = t + "<td width=""280"" valign=""top"">" + NL
    t = t + "<%= BoxTop(""Start a Webring"", ""#800080"") %>" + NL
    t = t + "<form action=""rings.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<input type=""hidden"" name=""do"" value=""create"">" + NL
    t = t + "<p><font size=""2"">Name:</font><br><input name=""name"" size=""30"" maxlength=""<%= MAXRINGNAME %>""></p>" + NL
    t = t + "<p><font size=""2"">What's it about?</font><br><%= LimitedBox(""desc"", """", 3, 30, MAXDESC) %></p>" + NL
    t = t + "<p><input type=""submit"" id=""go"" value=""Start It""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<%= LimitScript(""desc"", Str(MAXDESC)) %>" + NL
    t = t + "<p><font size=""1"" color=""#808080"">Your homepage joins it first. A homepage can be in <%= MAXRINGS %> webrings.</font></p>" + NL
    t = t + "</td>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\RINGS.ASP")
END SUB

SUB File13 ()
    t = ""
    t = t + "<html>" + NL
    t = t + "<head>" + NL
    t = t + "<title>{TITLE}</title>" + NL
    t = t + "<meta name=""description"" content=""A fan page by {NAME}, at {HOOD} {NUM} on GeoSimies."">" + NL
    t = t + "</head>" + NL
    t = t + "<body bgcolor=""#000040"" text=""#FFFFFF"" link=""#00FFFF"" vlink=""#FF80FF"">" + NL
    t = t + "<center>" + NL
    t = t + "<h1><font color=""#FF00FF"">{TITLE}</font></h1>" + NL
    t = t + "<marquee><font color=""#FFFF00"">*~*~* The BEST fan page on the whole SIM95 network!!! *~*~*</font></marquee>" + NL
    t = t + "<img src=""{ART}rainbow.pic"" alt=""--------"">" + NL
    t = t + "</center>" + NL
    t = t + "<h2><font color=""#FFFF00"">Why they RULE</font></h2>" + NL
    t = t + "<ol>" + NL
    t = t + "<li>Reason number one</li>" + NL
    t = t + "<li>Reason number two</li>" + NL
    t = t + "<li>Reason number three</li>" + NL
    t = t + "</ol>" + NL
    t = t + "<h2><font color=""#FFFF00"">Fan Club</font></h2>" + NL
    t = t + "<p>Want to join? <a href=""{TOP}guest.asp?h={KEY}&n={NUM}#sign"">Sign my guestbook</a> and say hi!</p>" + NL
    t = t + "<h2><font color=""#FFFF00"">Other Fan Pages</font></h2>" + NL
    t = t + "<p>Find more in the <a href=""{TOP}rings.asp"">webrings</a>.</p>" + NL
    t = t + "<center>" + NL
    t = t + "<img src=""{ART}rainbow.pic"" alt=""--------"">" + NL
    t = t + "<!--COUNTER-->" + NL
    t = t + "<p><img src=""{ART}bestview.pic"" alt=""Best viewed in Simxplorer""></p>" + NL
    t = t + "<font size=""1"">Made with love by {NAME}</font>" + NL
    t = t + "</center>" + NL
    t = t + "</body>" + NL
    t = t + "</html>" + NL
    Put("C:\WEB\SHRINE.TPL")
END SUB

SUB File14 ()
    t = ""
    t = t + "<%@ import file=""GEO.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' SIGNUP.ASP?h=hood - pick a neighborhood and an address, and move in." + NL
    t = t + "VAR hood AS String" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "IF viewer <> """" THEN RESPONSE.Redirect(""edit.asp"")" + NL
    t = t + "hood = REQUEST.Query(""h"").Upper()" + NL
    t = t + "IF NOT IsHood(hood) THEN hood = ""AREA95""" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Get a Free Homepage"", ""Sign up for a free GeoSimies homepage: pick a neighborhood, claim an address, and start building."") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<h2><font color=""#000080"">Homestead with GeoSimies!</font></h2>" + NL
    t = t + "<p>It's FREE and it takes a minute. Pick the neighborhood that suits you, and you get an" + NL
    t = t + "address there, like <b>Area95 1001</b>, and a homepage at <tt><%= H(SiteUrl()) %>area95/1001/</tt>" + NL
    t = t + "(and <tt><%= H(SiteUrl()) %>~yourname/</tt> for short).</p>" + NL
    t = t + "<%= Notice(REQUEST.Query(""why"")) %>" + NL
    t = t + "<form action=""join.asp"" method=""post"">" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td><font size=""2"">Your name:</font></td><td><input name=""name"" size=""30""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Member name:</font></td><td><input name=""u"" size=""10""> <font size=""1"" color=""#808080"">3 to 7 letters or digits</font></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Password:</font></td><td><input type=""password"" name=""pw"" size=""12""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Again:</font></td><td><input type=""password"" name=""pw2"" size=""12""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Neighborhood:</font></td><td><select name=""h""><%= HoodOptions(hood) %></select></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Address:</font></td><td><input name=""n"" size=""6""> <font size=""1"" color=""#808080"">a number from <%= FIRSTNUM %> to <%= LASTNUM %>; leave it empty for the next free one</font></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Homepage title:</font></td><td><input name=""title"" size=""40""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Start from:</font></td><td><select name=""tpl""><%= TemplateOptions() %></select></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Move In!""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "</form>" + NL
    t = t + "</td><td width=""300"" valign=""top"">" + NL
    t = t + "<%= BoxTop(""The Neighborhoods"", ""#000080"") %>" + NL
    t = t + "<% VAR entry AS String" + NL
    t = t + "   FOR EACH entry IN Hoods() %>" + NL
    t = t + "<p><font size=""2""><b><a href=""hood.asp?h=<%= entry.Split(""|"")[0].Lower() %>""><%= entry.Split(""|"")[1] %></a></b>: <%= H(entry.Split(""|"")[2]) %><br>" + NL
    t = t + "<font color=""#808080"">next free address: <%= FreeNumber(entry.Split(""|"")[0]) %></font></font></p>" + NL
    t = t + "<% NEXT %>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\SIGNUP.ASP")
END SUB

SUB File15 ()
    t = ""
    t = t + "<html>" + NL
    t = t + "<head>" + NL
    t = t + "<title>{TITLE}</title>" + NL
    t = t + "<meta name=""description"" content=""The homepage of {NAME}, at {HOOD} {NUM} on GeoSimies."">" + NL
    t = t + "</head>" + NL
    t = t + "<body bgcolor=""#000000"" text=""#FFFFFF"" link=""#FFFF00"" vlink=""#FF80FF"" onload=""Page_Load"">" + NL
    t = t + "<center>" + NL
    t = t + "<img src=""{ART}stars.pic"" alt=""* * * * *"">" + NL
    t = t + "<h1><font color=""#FFFF00"">{TITLE}</font></h1>" + NL
    t = t + "<marquee bgcolor=""#000080""><font color=""#00FFFF""><b>*** Welcome to my homepage!!! *** Thanks for stopping by!!! *** Don't forget to sign my guestbook!!! ***</b></font></marquee>" + NL
    t = t + "<p>" + NL
    t = t + "<span id=""g1""><img src=""{ART}globe1.pic"" alt=""globe""></span><span id=""g2""><img src=""{ART}globe2.pic"" alt=""globe""></span><span id=""g3""><img src=""{ART}globe3.pic"" alt=""globe""></span><span id=""g4""><img src=""{ART}globe4.pic"" alt=""globe""></span>" + NL
    t = t + "</p>" + NL
    t = t + "<img src=""{ART}rainbow.pic"" alt=""--------"">" + NL
    t = t + "</center>" + NL
    t = t + "<h2><font color=""#00FF00"">About Me</font></h2>" + NL
    t = t + "<p>Hi! My name is <b>{NAME}</b> and this is my little corner of the information superhighway." + NL
    t = t + "I live at <b>{HOOD} {NUM}</b>. <blink><font color=""#FF0000"">NEW!</font></blink> I just moved in!</p>" + NL
    t = t + "<p>Things I like:</p>" + NL
    t = t + "<ul>" + NL
    t = t + "<li>Surfing the Net</li>" + NL
    t = t + "<li>The X-Files</li>" + NL
    t = t + "<li>Computers (I have a SIM95!!!)</li>" + NL
    t = t + "</ul>" + NL
    t = t + "<center><img src=""{ART}undercon.pic"" alt=""UNDER CONSTRUCTION""><br>" + NL
    t = t + "<font color=""#FFFF00"">This page is under construction. Come back soon!!!</font></center>" + NL
    t = t + "<h2><font color=""#00FF00"">Cool Links</font></h2>" + NL
    t = t + "<ul>" + NL
    t = t + "<li><a href=""{TOP}"">GeoSimies</a> - get your own free homepage!</li>" + NL
    t = t + "<li><a href=""{TOP}hood.asp?h={KEY}"">My neighbors in {HOOD}</a></li>" + NL
    t = t + "</ul>" + NL
    t = t + "<center>" + NL
    t = t + "<img src=""{ART}rainbow.pic"" alt=""--------"">" + NL
    t = t + "<p><!--COUNTER--></p>" + NL
    t = t + "<p><a href=""{TOP}guest.asp?h={KEY}&n={NUM}#sign""><img src=""{ART}emailme.pic"" alt=""Sign my guestbook!""></a></p>" + NL
    t = t + "<p><img src=""{ART}bestview.pic"" alt=""Best viewed in Simxplorer""></p>" + NL
    t = t + "<font size=""1"">Last updated {DATE}</font>" + NL
    t = t + "</center>" + NL
    t = t + "<script type=""spark"">" + NL
    t = t + "' The globe goes round: four pictures, one shown at a time." + NL
    t = t + "SUB Page_Load ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR f AS Integer" + NL
    t = t + "    PAGE.Get(""g2"").Visible = FALSE" + NL
    t = t + "    PAGE.Get(""g3"").Visible = FALSE" + NL
    t = t + "    PAGE.Get(""g4"").Visible = FALSE" + NL
    t = t + "    FOR i = 1 TO 2000" + NL
    t = t + "        SYS.Sleep(250)" + NL
    t = t + "        PAGE.Get(""g"" + Str(f + 1)).Visible = FALSE" + NL
    t = t + "        f = (f + 1) MOD 4" + NL
    t = t + "        PAGE.Get(""g"" + Str(f + 1)).Visible = TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "</script>" + NL
    t = t + "</body>" + NL
    t = t + "</html>" + NL
    Put("C:\WEB\STARS.TPL")
END SUB

SUB File16 ()
    t = ""
    t = t + "<%@ import file=""GEO.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' UPLOAD.ASP - add a picture to your homepage, or take one away, and the clip" + NL
    t = t + "' art everybody may use. A page of its own, because a whole request must fit" + NL
    t = t + "' in one 64K network message: a picture that is too big fails in Voyager." + NL
    t = t + "VAR home AS String" + NL
    t = t + "VAR hood AS String" + NL
    t = t + "VAR num AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR said AS String" + NL
    t = t + "VAR pname AS String" + NL
    t = t + "VAR one AS String" + NL
    t = t + "VAR art AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "home = HomeOf(viewer)" + NL
    t = t + "hood = home.Split(""|"")[0]" + NL
    t = t + "num = home.Split(""|"")[1]" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    RequireToken()" + NL
    t = t + "    IF REQUEST.Form(""del"") <> """" THEN" + NL
    t = t + "        pname = REQUEST.Form(""del"").Lower()" + NL
    t = t + "        IF ValidPage(pname) AND FS.Exists(SiteWeb(hood, num) + ""\"" + pname.Upper() + "".PIC"") THEN FS.Delete(SiteWeb(hood, num) + ""\"" + pname.Upper() + "".PIC"")" + NL
    t = t + "        RESPONSE.Redirect(""upload.asp?why="" + UrlEnc(""The picture is gone.""))" + NL
    t = t + "    END IF" + NL
    t = t + "    pname = REQUEST.Form(""name"").Trim()" + NL
    t = t + "    IF pname = """" THEN pname = REQUEST.Form(""pic.filename"").Split(""\"")[REQUEST.Form(""pic.filename"").Split(""\"").Count - 1]" + NL
    t = t + "    problem = SavePicture(hood, num, pname, REQUEST.Form(""pic""))" + NL
    t = t + "    IF problem = """" THEN RESPONSE.Redirect(""upload.asp?why="" + UrlEnc(""Got it! Put it on a page with <img src="""""" + pname.Lower().Replace("".pic"", """") + "".pic"""">""))" + NL
    t = t + "ELSE" + NL
    t = t + "    said = REQUEST.Query(""why"")" + NL
    t = t + "END IF" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Add a Picture"", ""Add pictures to your GeoSimies homepage."") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= Notice(problem) %><%= Notice(said) %>" + NL
    t = t + "<%= BoxTop(""Add a Picture"", ""#008000"") %>" + NL
    t = t + "<form action=""upload.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<p><input type=""file"" name=""pic"" size=""30""></p>" + NL
    t = t + "<p><font size=""2"">Call it</font> <input name=""name"" size=""8""> <font size=""1"" color=""#808080"">(1 to 8 letters or digits; empty: the file's own name)</font>" + NL
    t = t + "<input type=""submit"" value=""Upload""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<p><font size=""2"">A picture is a .PIC file from Sketch, up to <%= PICSIZE %> by <%= PICSIZE %> and <%= MAXPIC / 1000 %>K." + NL
    t = t + "Voyager can't send anything over 64K, and Sketch saves 400 by 300, so shrink a Sketch" + NL
    t = t + "picture first (SimBook's SHRINK.SPK does it). You have room for <%= MAXPICS %> pictures.</font></p>" + NL
    t = t + "<%= BoxTop(""My Pictures"", ""#000080"") %>" + NL
    t = t + "<table cellpadding=""4"">" + NL
    t = t + "<% FOR EACH one IN Pictures(hood, num) %>" + NL
    t = t + "<tr><td><img src=""<%= SiteLink(hood, num) + one %>"" alt=""<%= one %>""></td>" + NL
    t = t + "<td><font size=""2""><tt>&lt;img src=""<%= one %>""&gt;</tt></font></td>" + NL
    t = t + "<td><form action=""upload.asp"" method=""post""><%= TokenField() %><input type=""hidden"" name=""del"" value=""<%= one.Replace("".pic"", """") %>""><input type=""submit"" value=""Delete""></form></td></tr>" + NL
    t = t + "<% NEXT %>" + NL
    t = t + "</table>" + NL
    t = t + "<% IF Pictures(hood, num).Count = 0 THEN %><p><font size=""2"" color=""#808080"">No pictures yet.</font></p><% END IF %>" + NL
    t = t + "</td><td width=""330"" valign=""top"">" + NL
    t = t + "<%= BoxTop(""Free Clip Art!"", ""#800000"") %>" + NL
    t = t + "<p><font size=""2"">Help yourself. Copy the line under a picture into your page.</font></p>" + NL
    t = t + "<table cellpadding=""4"">" + NL
    t = t + "<% FOR EACH art IN ClipArt() %>" + NL
    t = t + "<tr><td><img src=""clipart/<%= art.Split(""|"")[0] %>.pic"" alt=""<%= art.Split(""|"")[1] %>""><br>" + NL
    t = t + "<font size=""1""><%= art.Split(""|"")[1] %>: <tt>&lt;img src=""../../clipart/<%= art.Split(""|"")[0] %>.pic""&gt;</tt></font></td></tr>" + NL
    t = t + "<% NEXT %>" + NL
    t = t + "</table>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\UPLOAD.ASP")
END SUB

