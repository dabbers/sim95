' VAPOR.SPK - Vapor, the games store and library for SIM95.
'
' A store is a folder on a web server, http://<machine>/vapor/, holding
' CATALOG.TXT (one game per line: id|name|parts|bytes|status|genre|about) and
' each game cut into parts small enough for a network message
' (/vapor/<id>/<n>.txt). Vapor reads the catalog, downloads a game part by part
' with a progress bar, puts it together in C:\GAMES\<id>\<id>.SPK, and keeps a
' library: Play starts it, and the time played is counted while it runs. Games
' that keep C:\GAMES\<id>\ACHIEVE.TXT (name|how|date) get their achievements
' shown.
'
' Files: C:\GAMES\VAPOR.INI (store=), C:\GAMES\LIBRARY.TXT
' (id|name|installed|seconds played|genre|about).
'
' Fetches go one at a time and start in a timer tick of their own, inside a
' TRY with an empty CATCH (see SIM95-NOTES.md); pages come in through the
' socket's events.

CONST HOME = "C:\GAMES"
CONST PATIENCE = 8000

VAR EOL AS String
VAR win AS GUI_Window
VAR bar AS GUI_Menu
VAR head AS GUI_Canvas
VAR games AS GUI_ListBox
VAR banner AS GUI_Canvas
VAR title AS GUI_Label
VAR info AS GUI_Label
VAR about AS GUI_Label
VAR action AS GUI_Button
VAR remove AS GUI_Button
VAR progress AS GUI_ProgressBar
VAR note AS GUI_Label
VAR trophies AS GUI_ListBox
VAR clock AS GUI_Timer
VAR web AS NET_Socket

VAR store AS String               ' "http://alpha/vapor/"
VAR tab AS String = "STORE"
VAR catalog AS Array OF String    ' the store's lines
VAR listed AS Array OF String     ' the lines behind the list, in order

' one fetch at a time
VAR fetching AS Bool
VAR fWhat AS String               ' "catalog" or "part"
VAR fUrl AS String
VAR fNumber AS Integer
VAR fParts AS Array OF String
VAR fDone AS Bool
VAR fSince AS Integer
VAR fError AS String
VAR wantCatalog AS Bool

' the download going on
VAR dlId AS String                ' "" when none
VAR dlLine AS String
VAR dlPart AS Integer
VAR dlParts AS Integer
VAR dlText AS String
VAR dlStart AS Integer
VAR queue AS Array OF String      ' catalog lines waiting

' games being played: id and process
VAR playId AS Array OF String
VAR playPid AS Array OF Integer
VAR playSince AS Array OF Integer

' ================================================================ start

SUB Main ()
    EOL = Chr(10)
    IF NOT FS.Exists(HOME) THEN FS.MakeDir(HOME)
    LoadSettings()
    win = GUI_Window.New("Vapor", 640, 420)
    win.Icon = "app"
    win.onClose = Win_OnClose
    bar = GUI_Menu.New(win)
    bar.onSelect = Menu_OnSelect
    bar.AddMenu("&Vapor")
    bar.AddItem("&Vapor", "&Store" + Chr(9) + "Ctrl+1")
    bar.AddItem("&Vapor", "&Library" + Chr(9) + "Ctrl+2")
    bar.AddItem("&Vapor", "&Downloads" + Chr(9) + "Ctrl+3")
    bar.AddSeparator("&Vapor")
    bar.AddItem("&Vapor", "Change S&tore...")
    bar.AddItem("&Vapor", "&Refresh" + Chr(9) + "F5")
    bar.AddSeparator("&Vapor")
    bar.AddItem("&Vapor", "E&xit")
    bar.AddMenu("&Help")
    bar.AddItem("&Help", "&About Vapor")

    head = GUI_Canvas.New(win)
    head.SetBounds(0, 0, 640, 44)
    head.onDraw = Head_OnDraw
    head.onMouseDown = Head_OnMouseDown
    games = GUI_ListBox.New(win)
    games.SetBounds(6, 50, 180, 342)
    games.onSelect = Games_OnSelect
    games.onDblClick = Action_Click
    banner = GUI_Canvas.New(win)
    banner.SetBounds(194, 50, 440, 100)
    banner.onDraw = Banner_OnDraw
    title = GUI_Label.New(win)
    title.Bold = TRUE
    title.SetBounds(194, 156, 440, 16)
    info = GUI_Label.New(win)
    info.SetBounds(194, 174, 440, 14)
    about = GUI_Label.New(win)
    about.SetBounds(194, 194, 440, 64)
    action = GUI_Button.New(win)
    action.SetBounds(194, 262, 120, 28)
    action.onClick = Action_Click
    remove = GUI_Button.New(win)
    remove.Text = "&Uninstall"
    remove.SetBounds(322, 262, 100, 28)
    remove.onClick = Remove_Click
    progress = GUI_ProgressBar.New(win)
    progress.SetBounds(194, 298, 440, 14)
    progress.Max = 100
    note = GUI_Label.New(win)
    note.SetBounds(194, 316, 440, 14)
    trophies = GUI_ListBox.New(win)
    trophies.SetBounds(194, 334, 440, 58)

    web = NET_Socket.New()
    web.onMessage = Web_OnMessage
    web.onClose = Web_OnClose
    clock = GUI_Timer.New(win)
    clock.Interval = 100
    clock.onTick = Clock_OnTick
    clock.Start()

    wantCatalog = store <> ""
    ShowTab("STORE")
    win.Show()
    IF store = "" THEN ChangeStore()
END SUB

SUB Win_OnClose ()
    SYS.Exit(0)
END SUB

SUB LoadSettings ()
    VAR line AS String
    FOR EACH line IN ReadOr(HOME + "\VAPOR.INI", "").Lines()
        IF line.StartsWith("store=") THEN store = line.Substring(6, line.Length - 6).Trim()
    NEXT
    ' a machine that is a store shops at itself to begin with
    IF store = "" AND FS.Exists("C:\WEB\VAPOR\CATALOG.TXT") THEN store = "http://" + NET.HostName.Lower() + "/vapor/"
END SUB

SUB SaveSettings ()
    FS.Write(HOME + "\VAPOR.INI", "store=" + store + EOL)
END SUB

FUNCTION ReadOr (path AS String, fallback AS String) AS String
    IF FS.Exists(path) THEN RETURN FS.Read(path)
    RETURN fallback
END FUNCTION

' ================================================================ tabs and lists

SUB ShowTab (t AS String)
    VAR line AS String
    tab = t
    games.Clear()
    listed.Clear()
    IF t = "STORE" THEN
        FOR EACH line IN catalog
            listed.Add(line)
            IF Installed(line.Split("|")[0]) THEN
                games.Add(line.Split("|")[1] + "  (in library)")
            ELSE
                games.Add(line.Split("|")[1])
            END IF
        NEXT
        IF catalog.Count = 0 THEN
            IF store = "" THEN
                win.Status = "No store yet: choose Vapor > Change Store."
            ELSE
                win.Status = "Fetching the store from " + store + "..."
            END IF
        END IF
    ELSEIF t = "LIBRARY" THEN
        FOR EACH line IN Library()
            listed.Add(line)
            games.Add(line.Split("|")[1])
        NEXT
        IF listed.Count = 0 THEN win.Status = "Your library is empty. Visit the Store!"
    ELSE
        IF dlId <> "" THEN
            listed.Add(dlLine)
            games.Add(dlLine.Split("|")[1] + "  " + Str(Percent()) + "%")
        END IF
        FOR EACH line IN queue
            listed.Add(line)
            games.Add(line.Split("|")[1] + "  (queued)")
        NEXT
    END IF
    head.Tag = ""
    DrawHead()
    IF listed.Count > 0 THEN
        games.Selected = 0
    END IF
    ShowGame()
END SUB

FUNCTION Library () AS Array OF String
    VAR out AS Array OF String
    VAR line AS String
    FOR EACH line IN ReadOr(HOME + "\LIBRARY.TXT", "").Lines()
        IF line.Split("|").Count >= 4 THEN out.Add(line)
    NEXT
    RETURN out
END FUNCTION

FUNCTION Installed (id AS String) AS Bool
    VAR line AS String
    FOR EACH line IN Library()
        IF line.Split("|")[0] = id THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

FUNCTION LibLine (id AS String) AS String
    VAR line AS String
    FOR EACH line IN Library()
        IF line.Split("|")[0] = id THEN RETURN line
    NEXT
    RETURN ""
END FUNCTION

FUNCTION Current () AS String
    IF games.Selected < 0 OR games.Selected >= listed.Count THEN RETURN ""
    RETURN listed[games.Selected]
END FUNCTION

SUB Games_OnSelect ()
    ShowGame()
END SUB

FUNCTION Unesc (s AS String) AS String
    RETURN s.Replace("%0A", EOL).Replace("%7C", "|").Replace("%25", "%")
END FUNCTION

' Words into lines of about n characters.
FUNCTION Wrap (text AS String, n AS Integer) AS String
    VAR out AS String
    VAR line AS String
    VAR word AS String
    FOR EACH word IN text.Split(" ")
        IF line <> "" AND line.Length + word.Length + 1 > n THEN
            out = out + line + EOL
            line = word
        ELSEIF line = "" THEN
            line = word
        ELSE
            line = line + " " + word
        END IF
    NEXT
    RETURN out + line
END FUNCTION

FUNCTION Played (seconds AS Integer) AS String
    IF seconds < 60 THEN RETURN "Played " + Str(seconds) + " seconds"
    IF seconds < 3600 THEN RETURN "Played " + Str(Int(seconds / 60)) + " minutes"
    RETURN "Played " + Str(Int(seconds / 360) / 10) + " hours"
END FUNCTION

' The right-hand side: the banner, the words, the right button.
SUB ShowGame ()
    VAR line AS String
    VAR p AS Array OF String
    VAR id AS String
    VAR lib AS String
    VAR a AS String
    line = Current()
    trophies.Clear()
    banner.Tag = ""
    IF line = "" THEN
        title.Text = ""
        info.Text = ""
        about.Text = ""
        action.Visible = FALSE
        remove.Visible = FALSE
        DrawBanner("")
        RETURN
    END IF
    p = line.Split("|")
    id = p[0]
    lib = LibLine(id)
    title.Text = p[1]
    action.Visible = TRUE
    remove.Visible = lib <> ""
    IF tab = "LIBRARY" THEN
        info.Text = Played(Int(Val(lib.Split("|")[3]))) + "  -  installed " + lib.Split("|")[2]
        IF lib.Split("|").Count >= 6 THEN about.Text = Wrap(Unesc(lib.Split("|")[5]), 66)
        action.Text = "&Play"
        IF playId.Contains(id) THEN action.Text = "Running"
        action.Enabled = NOT playId.Contains(id)
        FOR EACH a IN ReadOr(HOME + "\" + id + "\ACHIEVE.TXT", "").Lines()
            IF a.Contains("|") THEN trophies.Add("* " + a.Split("|")[0] + " - " + a.Split("|")[1] + "  (" + a.Split("|")[2] + ")")
        NEXT
        IF trophies.Count = 0 THEN trophies.Add("No achievements yet. Go and play!")
    ELSE
        info.Text = p[5] + "  -  " + Str(Int(Val(p[3]) / 1024) + 1) + " KB  -  Free"
        about.Text = Wrap(Unesc(p[6]), 66)
        IF p[4] = "soon" THEN
            info.Text = p[5] + "  -  Coming soon"
            action.Text = "Coming soon"
            action.Enabled = FALSE
        ELSEIF lib <> "" THEN
            action.Text = "&Play"
            action.Enabled = NOT playId.Contains(id)
        ELSEIF id = dlId OR queue.Contains(line) THEN
            action.Text = "Downloading..."
            action.Enabled = FALSE
        ELSE
            action.Text = "&Install"
            action.Enabled = TRUE
        END IF
    END IF
    DrawBanner(id)
END SUB

SUB Action_Click ()
    VAR line AS String
    line = Current()
    IF line = "" THEN RETURN
    IF Installed(line.Split("|")[0]) THEN
        Play(line.Split("|")[0])
    ELSEIF tab = "STORE" AND line.Split("|")[4] <> "soon" THEN
        IF dlId <> line.Split("|")[0] AND NOT queue.Contains(line) THEN queue.Add(line)
        win.Status = line.Split("|")[1] + " is queued for download."
        ShowGame()
    END IF
END SUB

SUB Play (id AS String)
    VAR path AS String
    path = HOME + "\" + id + "\" + id + ".SPK"
    IF NOT FS.Exists(path) THEN
        Say("The game's files are missing. Uninstall it and install it again.", "error")
        RETURN
    END IF
    IF playId.Contains(id) THEN RETURN
    playId.Add(id)
    playPid.Add(SYS.Run(path))
    playSince.Add(SYS.Ticks)
    win.Status = "Playing " + LibLine(id).Split("|")[1] + "..."
    ShowGame()
END SUB

SUB Remove_Click ()
    VAR line AS String
    VAR id AS String
    VAR box AS GUI_MessageBox
    VAR f AS String
    VAR out AS Array OF String
    VAR l AS String
    line = Current()
    IF line = "" THEN RETURN
    id = line.Split("|")[0]
    box = GUI_MessageBox.New(win)
    box.Title = "Vapor"
    box.Kind = "confirm"
    box.Buttons = "yesno"
    box.Text = "Uninstall " + line.Split("|")[1] + "? Its files in " + HOME + "\" + id + " will be deleted (your achievements too)."
    IF NOT box.Show() THEN RETURN
    IF FS.Exists(HOME + "\" + id) THEN
        FOR EACH f IN FS.List(HOME + "\" + id)
            IF NOT f.EndsWith("\") THEN FS.Delete(HOME + "\" + id + "\" + f)
        NEXT
        FS.Delete(HOME + "\" + id)
    END IF
    FOR EACH l IN Library()
        IF l.Split("|")[0] <> id THEN out.Add(l)
    NEXT
    SaveLibrary(out)
    win.Status = line.Split("|")[1] + " was uninstalled."
    ShowTab(tab)
END SUB

SUB SaveLibrary (lines AS Array OF String)
    VAR text AS String
    IF lines.Count > 0 THEN text = lines.Join(EOL) + EOL
    FS.Write(HOME + "\LIBRARY.TXT", text)
END SUB

' ================================================================ the clock: fetches, downloads, play time

SUB Clock_OnTick ()
    TRY
        Tick()
    CATCH err
    END TRY
END SUB

SUB Tick ()
    VAR i AS Integer
    VAR alive AS Bool
    VAR task AS String
    ' games that ended: their time goes in the library
    FOR i = playId.Count - 1 TO 0 STEP -1
        alive = FALSE
        FOR EACH task IN SYS.Tasks()
            IF Int(Val(task.Split("|")[0])) = playPid[i] THEN alive = TRUE
        NEXT
        IF NOT alive THEN
            AddTime(playId[i], Int((SYS.Ticks - playSince[i]) / 1000))
            playId.RemoveAt(i)
            playPid.RemoveAt(i)
            playSince.RemoveAt(i)
            ShowGame()
        END IF
    NEXT
    IF fetching THEN
        IF fDone OR SYS.Ticks - fSince > PATIENCE THEN Arrived()
        RETURN
    END IF
    IF wantCatalog AND store <> "" THEN
        wantCatalog = FALSE
        StartFetch("catalog", store + "catalog.txt")
        RETURN
    END IF
    IF dlId = "" AND queue.Count > 0 THEN
        dlLine = queue[0]
        queue.RemoveAt(0)
        dlId = dlLine.Split("|")[0]
        dlParts = Int(Val(dlLine.Split("|")[2]))
        dlPart = 0
        dlText = ""
        dlStart = SYS.Ticks
    END IF
    IF dlId <> "" THEN
        dlPart = dlPart + 1
        ' (last thing in the tick: it may be spoiled)
        StartFetch("part", store + dlId.Lower() + "/" + Str(dlPart) + ".txt")
    END IF
END SUB

SUB AddTime (id AS String, seconds AS Integer)
    VAR out AS Array OF String
    VAR line AS String
    VAR p AS Array OF String
    FOR EACH line IN Library()
        p = line.Split("|")
        IF p[0] = id THEN
            p[3] = Str(Int(Val(p[3])) + seconds)
            line = p.Join("|")
        END IF
        out.Add(line)
    NEXT
    SaveLibrary(out)
    win.Status = "Thanks for playing!"
END SUB

FUNCTION Percent () AS Integer
    IF dlParts = 0 THEN RETURN 0
    RETURN Int((dlPart - 1) * 100 / dlParts)
END FUNCTION

SUB StartFetch (what AS String, url AS String)
    VAR conn AS NET_Connection
    VAR host AS String
    VAR path AS String
    fetching = TRUE
    fWhat = what
    fUrl = url
    fNumber = fNumber + 1
    fParts.Clear()
    fDone = FALSE
    fError = ""
    fSince = SYS.Ticks
    host = url.Substring(7, url.Length - 7)
    path = host.Substring(host.IndexOf("/"), host.Length - host.IndexOf("/"))
    host = host.Substring(0, host.IndexOf("/"))
    TRY
        conn = web.Connect(host, 80)
        conn.Tag = Str(fNumber)
        conn.Send("GET " + path + " HTTP/1.0" + EOL + "Host: " + host + EOL + "User-Agent: Vapor/1.0 (SIM95)")
    CATCH err
        fError = err
        fDone = TRUE
    END TRY
END SUB

SUB Web_OnMessage (conn AS NET_Connection, message AS String)
    IF conn.Tag = Str(fNumber) AND NOT fDone THEN fParts.Add(message)
END SUB

SUB Web_OnClose (conn AS NET_Connection)
    IF conn.Tag = Str(fNumber) THEN fDone = TRUE
END SUB

' A fetch finished (or gave up): the body, or "" with fError saying why.
FUNCTION Body () AS String
    VAR raw AS String
    raw = fParts.Join(EOL)
    IF fError <> "" THEN RETURN ""
    IF raw = "" THEN
        fError = "no answer"
        RETURN ""
    END IF
    IF NOT raw.StartsWith("HTTP/1.0 200") THEN
        fError = raw.Lines()[0]
        RETURN ""
    END IF
    IF NOT raw.Contains(EOL + EOL) THEN RETURN ""
    RETURN raw.Substring(raw.IndexOf(EOL + EOL) + 2, raw.Length - raw.IndexOf(EOL + EOL) - 2)
END FUNCTION

SUB Arrived ()
    VAR text AS String
    VAR line AS String
    fetching = FALSE
    TRY
        web.Close()
    CATCH err
    END TRY
    text = Body()
    IF fWhat = "catalog" THEN
        catalog.Clear()
        IF text = "" THEN
            win.Status = "The store at " + store + " did not answer (" + fError + ")."
        ELSE
            FOR EACH line IN text.Lines()
                IF line.Split("|").Count >= 7 THEN catalog.Add(line)
            NEXT
            win.Status = "Store: " + store + "  -  " + Str(catalog.Count) + " games"
        END IF
        IF tab = "STORE" THEN ShowTab("STORE")
        RETURN
    END IF
    ' a part of the download
    IF text = "" THEN
        win.Status = "The download of " + dlLine.Split("|")[1] + " failed (" + fError + ")."
        progress.Value = 0
        note.Text = ""
        dlId = ""
        ShowTab(tab)
        RETURN
    END IF
    dlText = dlText + text
    progress.Value = Int(dlPart * 100 / dlParts)
    note.Text = "Downloading " + dlLine.Split("|")[1] + ": part " + Str(dlPart) + " of " + Str(dlParts) + "  -  " + Str(Int(dlText.Length / MATH.Max(1, SYS.Ticks - dlStart) * 1000 / 102.4) / 10) + " KB/s"
    IF tab = "DOWNLOADS" AND games.Count > 0 THEN games.Set(0, dlLine.Split("|")[1] + "  " + Str(Int(dlPart * 100 / dlParts)) + "%")
    IF dlPart >= dlParts THEN Finish()
END SUB

' All the parts are here: put the game together and into the library.
SUB Finish ()
    VAR p AS Array OF String
    VAR dir AS String
    p = dlLine.Split("|")
    dir = HOME + "\" + dlId
    IF NOT FS.Exists(dir) THEN FS.MakeDir(dir)
    FS.Write(dir + "\" + dlId + ".SPK", dlText)
    FS.Append(HOME + "\LIBRARY.TXT", dlId + "|" + p[1] + "|" + TIME.Date + "|0|" + p[5] + "|" + p[6] + EOL)
    win.Status = p[1] + " is installed. Find it in your Library."
    note.Text = p[1] + " is ready to play."
    SYS.Beep(660, 60)
    dlId = ""
    dlText = ""
    ShowTab(tab)
END SUB

' ================================================================ the header and the banners

SUB Head_OnDraw (canvas AS GUI_Canvas)
    head.Tag = ""
    DrawHead()
END SUB

SUB DrawHead ()
    VAR i AS Integer
    VAR names AS Array OF String
    IF head.Tag = tab THEN RETURN
    head.Tag = tab
    head.Clear()
    head.SetColor(0)
    head.FillRect(0, 0, 640, 44)
    head.SetColor(4)
    head.FillRect(0, 0, 640, 40)
    ' the logo: steam rising off a V
    head.SetColor(15)
    head.FillCircle(22, 14, 4)
    head.FillCircle(28, 9, 3)
    head.FillCircle(17, 8, 2)
    head.SetColor(14)
    head.Text(38, 12, "VAPOR")
    names = ["STORE", "LIBRARY", "DOWNLOADS"]
    FOR i = 0 TO 2
        IF names[i] = tab THEN
            head.SetColor(14)
            head.FillRect(150 + i * 130, 36, 110, 4)
            head.SetColor(15)
        ELSE
            head.SetColor(7)
        END IF
        head.Text(150 + i * 130, 12, names[i])
    NEXT
END SUB

SUB Head_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)
    IF x >= 150 AND x < 270 THEN ShowTab("STORE")
    IF x >= 280 AND x < 400 THEN ShowTab("LIBRARY")
    IF x >= 410 AND x < 540 THEN ShowTab("DOWNLOADS")
END SUB

SUB Banner_OnDraw (canvas AS GUI_Canvas)
    VAR line AS String
    line = Current()
    banner.Tag = ""
    IF line = "" THEN
        DrawBanner("")
    ELSE
        DrawBanner(line.Split("|")[0])
    END IF
END SUB

' Each game's banner, drawn.
SUB DrawBanner (id AS String)
    VAR i AS Integer
    IF banner.Tag = id AND id <> "" THEN RETURN
    banner.Tag = id
    banner.Clear()
    SELECT CASE id
        CASE "SIMDOOM"
            banner.SetColor(0)
            banner.FillRect(0, 0, 440, 100)
            FOR i = 0 TO 54
                banner.SetColor(9 - 8 * (i MOD 2))
                banner.FillRect(i * 8, 60 + Rnd(25), 8, 40)
                banner.SetColor(11)
                banner.FillRect(i * 8 + 2, 84 + Rnd(10), 4, 16)
            NEXT
            banner.SetColor(1)
            banner.Text(152, 30, "S I M D O O M")
            banner.SetColor(9)
            banner.Text(150, 28, "S I M D O O M")
        CASE "SNAKE"
            banner.SetColor(0)
            banner.FillRect(0, 0, 440, 100)
            FOR i = 0 TO 20
                banner.SetColor(2)
                banner.FillRect(60 + i * 12, 50 + Int(10 * MATH.Sin(i / 2)), 10, 10)
            NEXT
            banner.SetColor(10)
            banner.FillRect(312, 50 + Int(10 * MATH.Sin(10.5)), 10, 10)
            banner.SetColor(9)
            banner.FillCircle(360, 55, 5)
            banner.SetColor(10)
            banner.Text(170, 14, "SNAKE 95")
        CASE "HL3"
            banner.SetColor(3)
            banner.FillRect(0, 0, 440, 100)
            banner.SetColor(11)
            banner.FillCircle(70, 50, 34)
            banner.SetColor(3)
            banner.FillCircle(70, 50, 28)
            banner.SetColor(11)
            banner.Line(58, 30, 82, 72)
            banner.Line(59, 30, 83, 72)
            banner.Line(70, 50, 56, 72)
            banner.Line(71, 50, 57, 72)
            banner.SetColor(15)
            banner.Text(130, 34, "HALF-LIFE 3")
            banner.SetColor(11)
            banner.Text(130, 56, "Coming soon(TM)")
        CASE ""
            banner.SetColor(7)
            banner.FillRect(0, 0, 440, 100)
        CASE ELSE
            banner.SetColor(4)
            banner.FillRect(0, 0, 440, 100)
            banner.SetColor(15)
            banner.Text(20, 40, id)
    END SELECT
END SUB

' ================================================================ menus

SUB Menu_OnSelect (item AS String)
    SELECT CASE item
        CASE "Store"
            ShowTab("STORE")
        CASE "Library"
            ShowTab("LIBRARY")
        CASE "Downloads"
            ShowTab("DOWNLOADS")
        CASE "Change Store..."
            ChangeStore()
        CASE "Refresh"
            wantCatalog = TRUE
        CASE "Exit"
            win.Close()
        CASE "About Vapor"
            Say("Vapor 1.0 for SIM95" + EOL + EOL + "Games from any machine that runs a Vapor store (http://machine/vapor/), downloaded part by part, with a library, play time and achievements." + EOL + EOL + "Half-Life 3 is coming soon.", "info")
    END SELECT
END SUB

VAR askWin AS GUI_Window
VAR askBox AS GUI_TextBox

SUB ChangeStore ()
    VAR l AS GUI_Label
    VAR b AS GUI_Button
    askWin = GUI_Window.New("Vapor Store", 360, 110)
    askWin.Modal = TRUE
    l = GUI_Label.New(askWin)
    l.Text = "Which machine is your store? (Any machine with Vapor" + EOL + "installed is one: type its name, like alpha.)"
    l.SetBounds(10, 8, 340, 30)
    askBox = GUI_TextBox.New(askWin)
    askBox.Text = store
    askBox.SetBounds(10, 44, 340, 21)
    askBox.onEnter = Store_Ok
    b = GUI_Button.New(askWin)
    b.Text = "OK"
    b.Default = TRUE
    b.SetBounds(272, 74, 78, 26)
    b.onClick = Store_Ok
    askWin.Center()
    askWin.Show()
    askBox.Focus()
END SUB

SUB Store_Ok ()
    VAR s AS String
    s = askBox.Text.Trim().Lower()
    IF s = "" THEN RETURN
    IF NOT s.StartsWith("http://") THEN s = "http://" + s
    IF s.Substring(7, s.Length - 7).IndexOf("/") < 0 THEN s = s + "/vapor/"
    IF NOT s.EndsWith("/") THEN s = s + "/"
    store = s
    SaveSettings()
    askWin.Close()
    catalog.Clear()
    wantCatalog = TRUE
    ShowTab("STORE")
END SUB

SUB Say (text AS String, kind AS String)
    VAR box AS GUI_MessageBox
    box = GUI_MessageBox.New(win)
    box.Title = "Vapor"
    box.Kind = kind
    box.Text = text
    box.Show()
END SUB
