' VAPOR|id=VAPOR|name=Vapor|kind=client|version=d0000c03|category=Vapor|run=C:\PROGRAMS\VAPOR.SPK|files=C:\PROGRAMS\VAPOR.SPK|tasks=VAPOR|startup=|folder=|about=The Vapor program itself.
' VAPOR.SPK - Vapor, the store and library for everything on SIM95: games,
' programs (Simxplorer, Frostbird, Clippy...) and web apps (SimBook, ColdMail,
' AskSim, ELIZA-95).
'
' A store is a folder on a web server, http://<machine>/vapor/, holding
' CATALOG.TXT, one item per line:
'   id|name|parts|bytes|status|category|about|kind|version|run|files|tasks|startup
' and each item cut into parts small enough for a network message
' (/vapor/<id>/<n>.txt). An item is a file that starts with a header line,
'   ' VAPOR|id=...|name=...|kind=...|version=...|...
' kind says what to do with it once it is here:
'   game     it is the game: kept in C:\GAMES\<id>\<id>.SPK and played from there
'   program  it is an installer: Vapor runs it, then "run" opens the program
'   service  the same, for something that starts with the machine (Clippy)
'   web      an installer for a web app, which becomes this machine's home page
'   client   Vapor itself: a new version replaces this program, which restarts
'
' The library (C:\GAMES\LIBRARY.TXT) remembers what is installed, which
' version, and the time played. When the store has a newer version of
' something, the Library offers Update (or Update All); otherwise Reinstall.
' Vapor looks at the store again every few minutes (and at once with Check for
' Updates). A program or game that is on this machine already, put there by
' pasting its INSTALL.SPK, goes into the library as found, and gets updated
' like the rest.
'
' On a store machine, Publish Apps puts every installer saved in C:\MYFILES
' that has a header (all the ones tools/build-installer.mjs makes) into the
' store, replacing older versions: that is how a store's shelves are stocked
' and updated.
'
' Fetches go one at a time and start in a timer tick of their own, inside a
' TRY with an empty CATCH (see SIM95-NOTES.md); pages come in through the
' socket's events.
'
' A store can be at a SimDNS name (http://store.coolsite.sim/vapor/): the
' builder joins the resolver (simweb/src/RESOLVE.SPK, the Rs... names) on the
' end, and the name is asked about in a tick of its own before the fetch.
' The connection goes to the machine the name server names; the request
' still says Host: store.coolsite.sim, so a web server with sites finds it.

CONST HOME = "C:\GAMES"
CONST ME = "C:\PROGRAMS\VAPOR.SPK"
CONST STOREDIR = "C:\WEB\VAPOR"
CONST BROWSER = "C:\PROGRAMS\SIMXPLOR.SPK"
CONST PATIENCE = 8000
CONST PART = 15000
CONST WEBAPPS = "C:\SYSTEM\WEBAPPS.INI"
CONST RECHECK = 300000            ' look at the store again after this long (ms)
CONST BYHAND = "found"             ' the build in the library of something Vapor didn't install

VAR EOL AS String
VAR win AS GUI_Window
VAR bar AS GUI_Menu
VAR head AS GUI_Canvas
VAR games AS GUI_ListBox
VAR banner AS GUI_Canvas
VAR title AS GUI_Label
VAR info AS GUI_Label
VAR about AS GUI_Label
VAR action AS GUI_Button
VAR upd AS GUI_Button
VAR remove AS GUI_Button
VAR progress AS GUI_ProgressBar
VAR note AS GUI_Label
VAR trophies AS GUI_ListBox
VAR clock AS GUI_Timer
VAR web AS NET_Socket

VAR store AS String               ' "http://alpha/vapor/"
VAR tab AS String = "STORE"
VAR catalog AS Array OF String    ' the store's lines
VAR listed AS Array OF String     ' the lines behind the list, in order ("" for a heading)
VAR offeredSelf AS Bool           ' asked once about a newer Vapor

' one fetch at a time
VAR fetching AS Bool
VAR fWhat AS String               ' "catalog" or "part"
VAR fNumber AS Integer
VAR fParts AS Array OF String
VAR fDone AS Bool
VAR fSince AS Integer
VAR fError AS String
VAR wantCatalog AS Bool
VAR catalogAt AS Integer          ' when the catalog last came (0: never)
VAR checking AS Bool              ' Check for Updates: say how it went

' the download going on, and what is waiting
VAR dlId AS String                ' "" when none
VAR dlLine AS String
VAR dlPart AS Integer
VAR dlParts AS Integer
VAR dlText AS String
VAR dlStart AS Integer
VAR queue AS Array OF String      ' catalog lines waiting
VAR setupPid AS Integer           ' an installer Vapor is running
VAR setupLine AS String
VAR setupSince AS Integer

' things running: id and process
VAR playId AS Array OF String
VAR playPid AS Array OF Integer
VAR playSince AS Array OF Integer

' ================================================================ start

SUB Main ()
    EOL = Chr(10)
    IF NOT FS.Exists(HOME) THEN FS.MakeDir(HOME)
    LoadSettings()
    win = GUI_Window.New("Vapor", 640, 420)
    win.Icon = "app"
    win.onClose = Win_OnClose
    bar = GUI_Menu.New(win)
    bar.onSelect = Menu_OnSelect
    bar.AddMenu("&Vapor")
    bar.AddItem("&Vapor", "&Store" + Chr(9) + "Ctrl+1")
    bar.AddItem("&Vapor", "&Library" + Chr(9) + "Ctrl+2")
    bar.AddItem("&Vapor", "&Downloads" + Chr(9) + "Ctrl+3")
    bar.AddSeparator("&Vapor")
    bar.AddItem("&Vapor", "&Update All" + Chr(9) + "Ctrl+U")
    bar.AddItem("&Vapor", "&Check for Updates" + Chr(9) + "F5")
    bar.AddItem("&Vapor", "Change S&tore...")
    bar.AddItem("&Vapor", "&Publish Apps..." + Chr(9) + "Ctrl+P")
    bar.AddSeparator("&Vapor")
    bar.AddItem("&Vapor", "E&xit")
    bar.AddMenu("&Help")
    bar.AddItem("&Help", "&About Vapor")
    bar.SetEnabled("Publish Apps...", FS.Exists(STOREDIR))

    head = GUI_Canvas.New(win)
    head.SetBounds(0, 0, 640, 44)
    head.onDraw = Head_OnDraw
    head.onMouseDown = Head_OnMouseDown
    games = GUI_ListBox.New(win)
    games.SetBounds(6, 50, 180, 342)
    games.onSelect = Games_OnSelect
    games.onDblClick = Action_Click
    banner = GUI_Canvas.New(win)
    banner.SetBounds(194, 50, 440, 100)
    banner.onDraw = Banner_OnDraw
    title = GUI_Label.New(win)
    title.Bold = TRUE
    title.SetBounds(194, 156, 440, 16)
    info = GUI_Label.New(win)
    info.SetBounds(194, 174, 440, 14)
    about = GUI_Label.New(win)
    about.SetBounds(194, 194, 440, 64)
    action = GUI_Button.New(win)
    action.SetBounds(194, 262, 120, 28)
    action.onClick = Action_Click
    upd = GUI_Button.New(win)
    upd.Text = "U&pdate"
    upd.SetBounds(322, 262, 100, 28)
    upd.onClick = Update_Click
    remove = GUI_Button.New(win)
    remove.Text = "&Uninstall"
    remove.SetBounds(430, 262, 100, 28)
    remove.onClick = Remove_Click
    progress = GUI_ProgressBar.New(win)
    progress.SetBounds(194, 298, 440, 14)
    progress.Max = 100
    note = GUI_Label.New(win)
    note.SetBounds(194, 316, 440, 14)
    trophies = GUI_ListBox.New(win)
    trophies.SetBounds(194, 334, 440, 58)

    web = NET_Socket.New()
    web.onMessage = Web_OnMessage
    web.onClose = Web_OnClose
    clock = GUI_Timer.New(win)
    clock.Interval = 100
    clock.onTick = Clock_OnTick
    clock.Start()

    wantCatalog = store <> ""
    ShowTab("STORE")
    win.Show()
    IF store = "" THEN ChangeStore()
END SUB

SUB Win_OnClose ()
    SYS.Exit(0)
END SUB

SUB LoadSettings ()
    VAR line AS String
    FOR EACH line IN ReadOr(HOME + "\VAPOR.INI", "").Lines()
        IF line.StartsWith("store=") THEN store = line.Substring(6, line.Length - 6).Trim()
    NEXT
    ' a machine that is a store shops at itself to begin with
    IF store = "" AND FS.Exists(STOREDIR + "\CATALOG.TXT") THEN store = "http://" + NET.HostName.Lower() + "/vapor/"
END SUB

SUB SaveSettings ()
    FS.Write(HOME + "\VAPOR.INI", "store=" + store + EOL)
END SUB

FUNCTION ReadOr (path AS String, fallback AS String) AS String
    IF FS.Exists(path) THEN RETURN FS.Read(path)
    RETURN fallback
END FUNCTION

' Field i of a | line, or "" when the line is shorter (older lines are).
FUNCTION Field (line AS String, i AS Integer) AS String
    VAR p AS Array OF String
    p = line.Split("|")
    IF i >= p.Count THEN RETURN ""
    RETURN p[i]
END FUNCTION

' key=value from a header line.
FUNCTION Meta (header AS String, key AS String) AS String
    VAR part AS String
    FOR EACH part IN header.Split("|")
        IF part.StartsWith(key + "=") THEN RETURN part.Substring(key.Length + 1, part.Length - key.Length - 1)
    NEXT
    RETURN ""
END FUNCTION

' The version of this Vapor, from its own header.
FUNCTION MyVersion () AS String
    VAR text AS String
    text = ReadOr(ME, "")
    IF NOT text.StartsWith("' VAPOR|") THEN RETURN ""
    RETURN Meta(text.Lines()[0], "version")
END FUNCTION

' ================================================================ tabs and lists

FUNCTION KindName (kind AS String) AS String
    SELECT CASE kind
        CASE "game"
            RETURN "Game"
        CASE "web"
            RETURN "Web app"
        CASE "service"
            RETURN "Program, starts with SIM95"
    END SELECT
    RETURN "Program"
END FUNCTION

SUB ShowTab (t AS String)
    VAR line AS String
    VAR pass AS Integer
    VAR heading AS Bool
    VAR shelf AS Array OF String
    tab = t
    games.Clear()
    listed.Clear()
    IF t = "STORE" THEN
        ' apps first (A to Z), then games (as the store has them), each under a heading
        FOR pass = 0 TO 1
            heading = FALSE
            shelf.Clear()
            FOR EACH line IN catalog
                IF Field(line, 7) = "client" THEN CONTINUE
                IF (Field(line, 7) = "game") <> (pass = 1) THEN CONTINUE
                IF pass = 0 THEN
                    shelf.Add(Field(line, 1).Upper() + "|" + line)
                ELSE
                    shelf.Add("|" + line)
                END IF
            NEXT
            IF pass = 0 THEN shelf.Sort()
            FOR EACH line IN shelf
                line = line.Substring(line.IndexOf("|") + 1, line.Length - line.IndexOf("|") - 1)
                IF NOT heading THEN
                    heading = TRUE
                    listed.Add("")
                    IF pass = 0 THEN
                        games.Add("- APPS -")
                    ELSE
                        games.Add("- GAMES -")
                    END IF
                END IF
                listed.Add(line)
                IF HasUpdate(Field(line, 0)) THEN
                    games.Add("  " + Field(line, 1) + "  (update)")
                ELSEIF Installed(Field(line, 0)) THEN
                    games.Add("  " + Field(line, 1) + "  (installed)")
                ELSE
                    games.Add("  " + Field(line, 1))
                END IF
            NEXT
        NEXT
        IF catalog.Count = 0 THEN
            IF store = "" THEN
                win.Status = "No store yet: choose Vapor > Change Store."
            ELSE
                win.Status = "Fetching the store from " + store + "..."
            END IF
        END IF
    ELSEIF t = "LIBRARY" THEN
        FOR EACH line IN Library()
            listed.Add(line)
            IF HasUpdate(Field(line, 0)) THEN
                games.Add(Field(line, 1) + "  (update)")
            ELSE
                games.Add(Field(line, 1))
            END IF
        NEXT
        IF listed.Count = 0 THEN win.Status = "Your library is empty. Visit the Store!"
    ELSE
        IF dlId <> "" THEN
            listed.Add(dlLine)
            games.Add(Field(dlLine, 1) + "  " + Str(Percent()) + "%")
        END IF
        IF setupLine <> "" THEN
            listed.Add(setupLine)
            games.Add(Field(setupLine, 1) + "  (installing)")
        END IF
        FOR EACH line IN queue
            listed.Add(line)
            games.Add(Field(line, 1) + "  (queued)")
        NEXT
    END IF
    head.Tag = ""
    DrawHead()
    IF listed.Count > 0 THEN
        games.Selected = 0
        IF listed[0] = "" AND listed.Count > 1 THEN games.Selected = 1
    END IF
    ShowGame()
END SUB

FUNCTION Library () AS Array OF String
    VAR out AS Array OF String
    VAR line AS String
    FOR EACH line IN ReadOr(HOME + "\LIBRARY.TXT", "").Lines()
        IF line.Split("|").Count >= 4 THEN out.Add(line)
    NEXT
    RETURN out
END FUNCTION

FUNCTION Installed (id AS String) AS Bool
    RETURN LibLine(id) <> ""
END FUNCTION

FUNCTION LibLine (id AS String) AS String
    VAR line AS String
    FOR EACH line IN Library()
        IF Field(line, 0) = id THEN RETURN line
    NEXT
    RETURN ""
END FUNCTION

FUNCTION StoreLine (id AS String) AS String
    VAR line AS String
    FOR EACH line IN catalog
        IF Field(line, 0) = id THEN RETURN line
    NEXT
    RETURN ""
END FUNCTION

' Is there a newer version in the store than the one installed?
FUNCTION HasUpdate (id AS String) AS Bool
    VAR lib AS String
    VAR shop AS String
    lib = LibLine(id)
    shop = StoreLine(id)
    IF lib = "" OR shop = "" OR Field(shop, 4) <> "ok" THEN RETURN FALSE
    RETURN Field(lib, 6) <> Field(shop, 8)
END FUNCTION

FUNCTION Current () AS String
    IF games.Selected < 0 OR games.Selected >= listed.Count THEN RETURN ""
    RETURN listed[games.Selected]
END FUNCTION

SUB Games_OnSelect ()
    ShowGame()
END SUB

FUNCTION Unesc (s AS String) AS String
    RETURN s.Replace("%0A", EOL).Replace("%7C", "|").Replace("%25", "%")
END FUNCTION

' Words into lines of about n characters.
FUNCTION Wrap (text AS String, n AS Integer) AS String
    VAR out AS String
    VAR line AS String
    VAR word AS String
    FOR EACH word IN text.Split(" ")
        IF line <> "" AND line.Length + word.Length + 1 > n THEN
            out = out + line + EOL
            line = word
        ELSEIF line = "" THEN
            line = word
        ELSE
            line = line + " " + word
        END IF
    NEXT
    RETURN out + line
END FUNCTION

FUNCTION Played (seconds AS Integer) AS String
    IF seconds < 60 THEN RETURN "Played " + Str(seconds) + " seconds"
    IF seconds < 3600 THEN RETURN "Played " + Str(Int(seconds / 60)) + " minutes"
    RETURN "Played " + Str(Int(seconds / 360) / 10) + " hours"
END FUNCTION

FUNCTION Busy (id AS String) AS Bool
    VAR line AS String
    IF id = dlId OR id = Field(setupLine, 0) THEN RETURN TRUE
    FOR EACH line IN queue
        IF Field(line, 0) = id THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

' The right-hand side: the banner, the words, the right buttons.
SUB ShowGame ()
    VAR line AS String
    VAR id AS String
    VAR lib AS String
    VAR shop AS String
    VAR kind AS String
    VAR a AS String
    line = Current()
    trophies.Clear()
    banner.Tag = ""
    upd.Visible = FALSE
    IF line = "" THEN
        title.Text = ""
        info.Text = ""
        about.Text = ""
        action.Visible = FALSE
        remove.Visible = FALSE
        DrawBanner("")
        RETURN
    END IF
    id = Field(line, 0)
    lib = LibLine(id)
    shop = StoreLine(id)
    title.Text = Field(line, 1)
    action.Visible = TRUE
    action.Enabled = TRUE
    remove.Visible = lib <> ""
    IF tab = "LIBRARY" THEN
        kind = Field(lib, 7)
        IF kind = "" THEN kind = "game"
        IF kind = "game" THEN
            info.Text = Played(Int(Val(Field(lib, 3)))) + "  -  installed " + Field(lib, 2)
        ELSE
            info.Text = KindName(kind) + "  -  installed " + Field(lib, 2)
        END IF
        IF Field(lib, 6) = BYHAND THEN
            info.Text = KindName(kind) + "  -  installed without Vapor"
        ELSEIF Field(lib, 6) <> "" THEN
            info.Text = info.Text + "  -  build " + Field(lib, 6)
        END IF
        about.Text = Wrap(Unesc(Field(lib, 5)), 66)
        action.Text = OpenWord(kind)
        IF playId.Contains(id) THEN
            action.Text = "Running"
            action.Enabled = FALSE
        END IF
        ' Update when the store has newer, else Reinstall (the same build again)
        upd.Visible = shop <> "" AND Field(shop, 4) = "ok" AND NOT Busy(id)
        IF HasUpdate(id) THEN
            upd.Text = "U&pdate"
        ELSE
            upd.Text = "Re&install"
        END IF
        IF kind = "game" THEN
            FOR EACH a IN ReadOr(HOME + "\" + id + "\ACHIEVE.TXT", "").Lines()
                IF a.Contains("|") THEN trophies.Add("* " + a.Split("|")[0] + " - " + a.Split("|")[1] + "  (" + a.Split("|")[2] + ")")
            NEXT
            IF trophies.Count = 0 THEN trophies.Add("No achievements yet. Go and play!")
        END IF
        IF HasUpdate(id) THEN trophies.Add("A newer version is in the store (build " + Field(shop, 8) + ").")
    ELSE
        kind = Field(line, 7)
        IF kind = "" THEN kind = "game"
        info.Text = Field(line, 5) + "  -  " + KindName(kind) + "  -  " + Str(Int(Val(Field(line, 3)) / 1024) + 1) + " KB  -  Free"
        about.Text = Wrap(Unesc(Field(line, 6)), 66)
        IF Field(line, 4) = "soon" THEN
            info.Text = Field(line, 5) + "  -  Coming soon"
            action.Text = "Coming soon"
            action.Enabled = FALSE
        ELSEIF Busy(id) THEN
            action.Text = "Downloading..."
            action.Enabled = FALSE
        ELSEIF HasUpdate(id) THEN
            action.Text = "U&pdate"
        ELSEIF lib <> "" THEN
            action.Text = OpenWord(kind)
            action.Enabled = NOT playId.Contains(id)
        ELSE
            action.Text = "&Install"
        END IF
    END IF
    DrawBanner(id)
END SUB

FUNCTION OpenWord (kind AS String) AS String
    IF kind = "game" THEN RETURN "&Play"
    RETURN "&Open"
END FUNCTION

SUB Action_Click ()
    VAR line AS String
    VAR id AS String
    line = Current()
    IF line = "" THEN RETURN
    id = Field(line, 0)
    IF tab = "STORE" AND HasUpdate(id) THEN
        Want(StoreLine(id))
    ELSEIF Installed(id) THEN
        Launch(id)
    ELSEIF tab = "STORE" AND Field(line, 4) <> "soon" THEN
        Want(line)
    END IF
END SUB

' Update, or Reinstall: the store's build, in place of this one.
SUB Update_Click ()
    VAR line AS String
    VAR shop AS String
    line = Current()
    IF line = "" THEN RETURN
    shop = StoreLine(Field(line, 0))
    IF shop <> "" AND Field(shop, 4) = "ok" THEN Want(shop)
END SUB

' Vapor > Check for Updates: the store's catalog again, now.
SUB CheckNow ()
    IF store = "" THEN RETURN
    checking = TRUE
    wantCatalog = TRUE
    win.Status = "Checking " + store + " for updates..."
END SUB

' "", or how many updates there are and where to get them.
FUNCTION UpdateNote () AS String
    VAR l AS String
    VAR n AS Integer
    FOR EACH l IN Library()
        IF HasUpdate(Field(l, 0)) THEN n = n + 1
    NEXT
    IF n > 0 THEN RETURN "  -  " + Str(n) + " update" + Plural(n) + ": Vapor > Update All"
    IF checking THEN RETURN "  -  everything is up to date"
    RETURN ""
END FUNCTION

' Programs and games from the store that are on this machine already, but not
' in the library (their INSTALL.SPK was pasted in): every file the store
' says it writes is here. They go in the library as found, so Update and
' Update All bring them up to the store's build. (A web app only on a SimHost
' machine, where each has its own folder: on the home page it may be one
' another app has taken over.)
SUB Adopt ()
    VAR line AS String
    VAR kind AS String
    VAR p AS Array OF String
    FOR EACH line IN catalog
        IF Field(line, 4) <> "ok" OR Installed(Field(line, 0)) OR Busy(Field(line, 0)) THEN CONTINUE
        kind = Field(line, 7)
        IF kind = "" THEN kind = "game"
        IF kind = "client" THEN CONTINUE
        IF kind = "web" AND NOT (Folders() AND Field(line, 13) <> "") THEN CONTINUE
        IF NOT AllThere(Field(line, 10), Field(line, 13)) THEN CONTINUE
        p = line.Split("|")
        IF p.Count > 8 THEN p[8] = BYHAND
        Keep(p.Join("|"))
    NEXT
END SUB

' Into the download queue. A web app asks first: it takes the home page.
SUB Want (line AS String)
    VAR box AS GUI_MessageBox
    VAR other AS String
    VAR l AS String
    IF Busy(Field(line, 0)) THEN RETURN
    IF Field(line, 7) = "web" AND NOT Installed(Field(line, 0)) AND NOT (Folders() AND Field(line, 13) <> "") THEN
        FOR EACH l IN Library()
            IF Field(l, 7) = "web" THEN other = Field(l, 1)
        NEXT
        box = GUI_MessageBox.New(win)
        box.Title = "Vapor"
        box.Kind = "confirm"
        box.Buttons = "yesno"
        box.Text = Field(line, 1) + " is a web app: it becomes this machine's home page, http://" + NET.HostName.Lower() + "/ (the page there now moves aside to WELCOME.HTM)."
        IF other <> "" THEN box.Text = box.Text + EOL + EOL + "This machine already has " + other + " there, and a machine has room for one web app: " + Field(line, 1) + " will take its place."
        box.Text = box.Text + EOL + EOL + "Install it?"
        IF NOT box.Show() THEN RETURN
    END IF
    queue.Add(line)
    win.Status = Field(line, 1) + " is queued for download."
    ShowGame()
END SUB

' Play a game, open a program, or open a web app in the browser.
SUB Launch (id AS String)
    VAR lib AS String
    VAR kind AS String
    VAR run AS String
    VAR url AS String
    lib = LibLine(id)
    kind = Field(lib, 7)
    IF kind = "" OR kind = "game" THEN
        run = HOME + "\" + id + "\" + id + ".SPK"
    ELSE
        run = Field(lib, 8)
    END IF
    IF kind = "web" THEN
        url = WebUrl(Field(lib, 12))
        IF FS.Exists(BROWSER) THEN
            SYS.Start(BROWSER, url)
        ELSE
            SYS.Start("C:\SYSTEM\VOYAGER.EXE", url)
        END IF
        win.Status = "Opened " + url
        RETURN
    END IF
    IF NOT FS.Exists(run) THEN
        Say("The files are missing (" + run + "). Uninstall it and install it again.", "error")
        RETURN
    END IF
    IF playId.Contains(id) THEN RETURN
    playId.Add(id)
    playPid.Add(SYS.Run(run))
    playSince.Add(SYS.Ticks)
    IF kind = "game" THEN
        win.Status = "Playing " + Field(lib, 1) + "..."
    ELSE
        win.Status = "Opened " + Field(lib, 1) + "."
    END IF
    ShowGame()
END SUB

SUB Remove_Click ()
    VAR line AS String
    VAR id AS String
    VAR lib AS String
    VAR box AS GUI_MessageBox
    line = Current()
    IF line = "" THEN RETURN
    id = Field(line, 0)
    lib = LibLine(id)
    IF lib = "" THEN RETURN
    box = GUI_MessageBox.New(win)
    box.Title = "Vapor"
    box.Kind = "confirm"
    box.Buttons = "yesno"
    IF Field(lib, 7) = "" OR Field(lib, 7) = "game" THEN
        box.Text = "Uninstall " + Field(lib, 1) + "? Its files in " + HOME + "\" + id + " will be deleted (your achievements too)."
    ELSE
        box.Text = "Uninstall " + Field(lib, 1) + "? Its program files go; anything it saved (mail, posts, settings) stays."
    END IF
    IF NOT box.Show() THEN RETURN
    Uninstall(lib)
    win.Status = Field(lib, 1) + " was uninstalled."
    ShowTab(tab)
END SUB

' Stops it, takes it out of startup, deletes the files it wrote, and its folder here.
SUB Uninstall (lib AS String)
    VAR id AS String
    VAR f AS String
    VAR task AS String
    VAR name AS String
    VAR out AS Array OF String
    VAR l AS String
    id = Field(lib, 0)
    FOR EACH name IN Field(lib, 10).Split(";")
        IF name = "" THEN CONTINUE
        FOR EACH task IN SYS.Tasks()
            IF task.Split("|")[1].Upper() = name.Upper() AND Int(Val(task.Split("|")[0])) <> SYS.Pid THEN SYS.Kill(Int(Val(task.Split("|")[0])))
        NEXT
    NEXT
    FOR EACH name IN Field(lib, 11).Split(";")
        IF name <> "" AND FS.Exists("C:\SYSTEM\STARTUP\" + name) THEN FS.Delete("C:\SYSTEM\STARTUP\" + name)
    NEXT
    FOR EACH f IN Field(lib, 9).Split(";")
        IF f <> "" AND f.Upper() <> ME THEN
            IF FS.Exists(Where(f, Field(lib, 12))) THEN FS.Delete(Where(f, Field(lib, 12)))
        END IF
    NEXT
    ' a web app gives the home page back (unless it had a folder of its own)
    IF Field(lib, 7) = "web" AND (Field(lib, 12) = "" OR NOT Folders()) AND NOT FS.Exists("C:\WEB\INDEX.HTM") AND FS.Exists("C:\WEB\WELCOME.HTM") THEN FS.Rename("C:\WEB\WELCOME.HTM", "C:\WEB\INDEX.HTM")
    IF FS.Exists(HOME + "\" + id) THEN
        FOR EACH f IN FS.List(HOME + "\" + id)
            IF NOT f.EndsWith("\") THEN FS.Delete(HOME + "\" + id + "\" + f)
        NEXT
        FS.Delete(HOME + "\" + id)
    END IF
    FOR EACH l IN Library()
        IF Field(l, 0) <> id THEN out.Add(l)
    NEXT
    SaveLibrary(out)
END SUB

SUB SaveLibrary (lines AS Array OF String)
    VAR text AS String
    IF lines.Count > 0 THEN text = lines.Join(EOL) + EOL
    FS.Write(HOME + "\LIBRARY.TXT", text)
END SUB

' Into the library, or the line there brought up to date (keeping when it
' was first installed and the time played).
SUB Keep (line AS String)
    VAR out AS Array OF String
    VAR l AS String
    VAR first AS String
    VAR seconds AS String = "0"
    VAR found AS Bool
    first = TIME.Date
    FOR EACH l IN Library()
        IF Field(l, 0) = Field(line, 0) THEN
            first = Field(l, 2)
            seconds = Field(l, 3)
            found = TRUE
        END IF
    NEXT
    l = Field(line, 0) + "|" + Field(line, 1) + "|" + first + "|" + seconds + "|" + Field(line, 5) + "|" + Field(line, 6) + "|" + Field(line, 8) + "|" + Field(line, 7) + "|" + Field(line, 9) + "|" + Field(line, 10) + "|" + Field(line, 11) + "|" + Field(line, 12) + "|" + Field(line, 13)
    FOR EACH line IN Library()
        IF Field(line, 0) = Field(l, 0) THEN
            out.Add(l)
        ELSE
            out.Add(line)
        END IF
    NEXT
    IF NOT found THEN out.Add(l)
    SaveLibrary(out)
END SUB

SUB UpdateAll ()
    VAR l AS String
    VAR n AS Integer
    FOR EACH l IN Library()
        IF HasUpdate(Field(l, 0)) AND NOT Busy(Field(l, 0)) THEN
            queue.Add(StoreLine(Field(l, 0)))
            n = n + 1
        END IF
    NEXT
    IF n = 0 THEN
        win.Status = "Everything is up to date."
    ELSE
        win.Status = Str(n) + " update" + Plural(n) + " queued."
    END IF
    ShowGame()
END SUB

FUNCTION Plural (n AS Integer) AS String
    IF n = 1 THEN RETURN ""
    RETURN "s"
END FUNCTION

' ================================================================ the clock: fetches, downloads, play time

SUB Clock_OnTick ()
    TRY
        Tick()
    CATCH err
    END TRY
END SUB

FUNCTION Alive (pid AS Integer) AS Bool
    VAR task AS String
    FOR EACH task IN SYS.Tasks()
        IF Int(Val(task.Split("|")[0])) = pid THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

SUB Tick ()
    VAR i AS Integer
    ' things that ended: a game's time goes in the library
    FOR i = playId.Count - 1 TO 0 STEP -1
        IF NOT Alive(playPid[i]) THEN
            AddTime(playId[i], Int((SYS.Ticks - playSince[i]) / 1000))
            playId.RemoveAt(i)
            playPid.RemoveAt(i)
            playSince.RemoveAt(i)
            ShowGame()
        END IF
    NEXT
    ' an installer that finished: into the library. (It may not end: a program
    ' that has printed keeps its console open. So it is done when every file
    ' it writes is there, or when it ends.)
    IF setupLine <> "" THEN
        IF NOT Alive(setupPid) OR (SYS.Ticks - setupSince > 300 AND AllThere(Field(setupLine, 10), Field(setupLine, 13))) OR SYS.Ticks - setupSince > 60000 THEN
            Keep(setupLine)
            win.Status = Field(setupLine, 1) + " is installed."
            note.Text = Field(setupLine, 1) + " is ready."
            progress.Value = 0
            setupLine = ""
            SYS.Beep(660, 60)
            ShowTab(tab)
        END IF
        RETURN
    END IF
    IF fetching THEN
        IF fDone OR SYS.Ticks - fSince > PATIENCE THEN Arrived()
        RETURN
    END IF
    ' now and then, the store again: anything new there shows as an update
    IF store <> "" AND catalogAt <> 0 AND dlId = "" AND queue.Count = 0 AND SYS.Ticks - catalogAt > RECHECK THEN wantCatalog = TRUE
    IF wantCatalog AND store <> "" THEN
        ' a SimDNS name: ask first, in a tick of its own
        IF RsNext(StoreHost()) THEN RETURN
        wantCatalog = FALSE
        StartFetch("catalog", store + "catalog.txt")
        RETURN
    END IF
    IF dlId = "" AND queue.Count > 0 THEN
        dlLine = queue[0]
        queue.RemoveAt(0)
        dlId = Field(dlLine, 0)
        dlParts = Int(Val(Field(dlLine, 2)))
        dlPart = 0
        dlText = ""
        dlStart = SYS.Ticks
    END IF
    IF dlId <> "" THEN
        IF RsNext(StoreHost()) THEN RETURN
        dlPart = dlPart + 1
        ' (last thing in the tick: it may be spoiled)
        StartFetch("part", store + dlId.Lower() + "/" + Str(dlPart) + ".txt")
    END IF
END SUB

FUNCTION AllThere (files AS String, folder AS String) AS Bool
    VAR f AS String
    IF files = "" THEN RETURN FALSE
    FOR EACH f IN files.Split(";")
        IF f <> "" AND NOT FS.Exists(Where(f, folder)) THEN RETURN FALSE
    NEXT
    RETURN TRUE
END FUNCTION

' A machine set up for several web apps (SimHost's C:\SYSTEM\WEBAPPS.INI says
' mode=folders) keeps each in its own folder, C:\WEB\BOOK and so on.
FUNCTION Folders () AS Bool
    RETURN ReadOr(WEBAPPS, "").Contains("mode=folders")
END FUNCTION

' Where a web app's file really is: C:\WEB\BOOK.SPK -> C:\WEB\BOOK\BOOK.SPK
FUNCTION Where (f AS String, folder AS String) AS String
    IF folder = "" OR NOT Folders() THEN RETURN f
    IF NOT f.Upper().StartsWith("C:\WEB\") THEN RETURN f
    RETURN "C:\WEB\" + folder + "\" + f.Substring(7, f.Length - 7)
END FUNCTION

' The address of a web app: the machine, or its folder there.
FUNCTION WebUrl (folder AS String) AS String
    IF folder <> "" AND Folders() THEN RETURN "http://" + NET.HostName.Lower() + "/" + folder.Lower() + "/"
    RETURN "http://" + NET.HostName.Lower() + "/"
END FUNCTION

SUB AddTime (id AS String, seconds AS Integer)
    VAR out AS Array OF String
    VAR line AS String
    VAR p AS Array OF String
    FOR EACH line IN Library()
        p = line.Split("|")
        IF p[0] = id THEN
            p[3] = Str(Int(Val(p[3])) + seconds)
            line = p.Join("|")
        END IF
        out.Add(line)
    NEXT
    SaveLibrary(out)
END SUB

FUNCTION Percent () AS Integer
    IF dlParts = 0 THEN RETURN 0
    RETURN Int((dlPart - 1) * 100 / dlParts)
END FUNCTION

' The store's machine as written in its address (alpha, store.coolsite.sim).
FUNCTION StoreHost () AS String
    VAR h AS String
    IF NOT store.Lower().StartsWith("http://") THEN RETURN ""
    h = store.Substring(7, store.Length - 7)
    IF h.Contains("/") THEN h = h.Substring(0, h.IndexOf("/"))
    RETURN h
END FUNCTION

SUB StartFetch (what AS String, url AS String)
    VAR conn AS NET_Connection
    VAR host AS String
    VAR path AS String
    fetching = TRUE
    fWhat = what
    fNumber = fNumber + 1
    fParts.Clear()
    fDone = FALSE
    fError = ""
    fSince = SYS.Ticks
    host = url.Substring(7, url.Length - 7)
    path = host.Substring(host.IndexOf("/"), host.Length - host.IndexOf("/"))
    host = host.Substring(0, host.IndexOf("/"))
    TRY
        ' (to the machine SimDNS named, if it named one; Host: as written)
        conn = web.Connect(RsTarget(host), 80)
        conn.Tag = Str(fNumber)
        conn.Send("GET " + path + " HTTP/1.0" + EOL + "Host: " + host + EOL + "User-Agent: Vapor/2.0 (SIM95)")
    CATCH err
        fError = err
        fDone = TRUE
    END TRY
END SUB

SUB Web_OnMessage (conn AS NET_Connection, message AS String)
    IF conn.Tag = Str(fNumber) AND NOT fDone THEN fParts.Add(message)
END SUB

SUB Web_OnClose (conn AS NET_Connection)
    IF conn.Tag = Str(fNumber) THEN fDone = TRUE
END SUB

' A fetch finished (or gave up): the body, or "" with fError saying why.
FUNCTION Body () AS String
    VAR raw AS String
    raw = fParts.Join(EOL)
    IF fError <> "" THEN RETURN ""
    IF raw = "" THEN
        fError = "no answer"
        RETURN ""
    END IF
    IF NOT raw.StartsWith("HTTP/1.0 200") THEN
        fError = raw.Lines()[0]
        RETURN ""
    END IF
    IF NOT raw.Contains(EOL + EOL) THEN RETURN ""
    RETURN raw.Substring(raw.IndexOf(EOL + EOL) + 2, raw.Length - raw.IndexOf(EOL + EOL) - 2)
END FUNCTION

SUB Arrived ()
    VAR text AS String
    VAR line AS String
    VAR mine AS String
    VAR box AS GUI_MessageBox
    fetching = FALSE
    TRY
        web.Close()
    CATCH err
    END TRY
    text = Body()
    IF fWhat = "catalog" THEN
        ' (a store that doesn't answer keeps the list it had)
        IF text = "" THEN
            win.Status = "The store at " + store + " did not answer (" + fError + ")."
        ELSE
            catalog.Clear()
            FOR EACH line IN text.Lines()
                IF line.Split("|").Count >= 7 THEN catalog.Add(line)
            NEXT
            Adopt()
            win.Status = "Store: " + store + "  -  " + Str(catalog.Count) + " items" + UpdateNote()
        END IF
        catalogAt = MATH.Max(1, SYS.Ticks)
        checking = FALSE
        IF tab <> "DOWNLOADS" THEN ShowTab(tab)
        ' a newer Vapor? ask once
        mine = MyVersion()
        line = StoreLine("VAPOR")
        IF line <> "" AND mine <> "" AND Field(line, 8) <> mine AND NOT offeredSelf AND NOT Busy("VAPOR") THEN
            offeredSelf = TRUE
            box = GUI_MessageBox.New(win)
            box.Title = "Vapor"
            box.Kind = "confirm"
            box.Buttons = "yesno"
            box.Text = "A new version of Vapor is in the store (build " + Field(line, 8) + "; this is " + mine + ")." + EOL + EOL + "Update Vapor now? It will restart."
            IF box.Show() THEN queue.Insert(0, line)
        END IF
        RETURN
    END IF
    ' a part of the download
    IF text = "" THEN
        win.Status = "The download of " + Field(dlLine, 1) + " failed (" + fError + ")."
        progress.Value = 0
        note.Text = ""
        dlId = ""
        ShowTab(tab)
        RETURN
    END IF
    dlText = dlText + text
    progress.Value = Int(dlPart * 100 / dlParts)
    note.Text = "Downloading " + Field(dlLine, 1) + ": part " + Str(dlPart) + " of " + Str(dlParts) + "  -  " + Str(Int(dlText.Length / MATH.Max(1, SYS.Ticks - dlStart) * 1000 / 102.4) / 10) + " KB/s"
    IF tab = "DOWNLOADS" AND games.Count > 0 THEN games.Set(0, Field(dlLine, 1) + "  " + Str(Int(dlPart * 100 / dlParts)) + "%")
    IF dlPart >= dlParts THEN Finish()
END SUB

' All the parts are here: what happens next depends on what it is.
SUB Finish ()
    VAR f AS String
    VAR dir AS String
    VAR kind AS String
    VAR line AS String
    line = dlLine
    dir = HOME + "\" + dlId
    kind = Field(line, 7)
    IF kind = "" THEN kind = "game"
    IF kind = "client" THEN
        ' a new Vapor: in place of this one, which starts it and goes
        FS.Write(ME, dlText)
        SYS.Start(ME, "")
        SYS.Exit(0)
        RETURN
    END IF
    IF NOT FS.Exists(dir) THEN FS.MakeDir(dir)
    dlId = ""
    IF kind = "game" THEN
        FS.Write(dir + "\" + Field(line, 0) + ".SPK", dlText)
        dlText = ""
        Keep(line)
        win.Status = Field(line, 1) + " is installed. Find it in your Library."
        note.Text = Field(line, 1) + " is ready to play."
        SYS.Beep(660, 60)
        ShowTab(tab)
        RETURN
    END IF
    ' an installer: clear away the old files it writes (an update: a new
    ' install may need what is there, as SimHost moves web apps), run it, and
    ' wait for them
    FS.Write(dir + "\INSTALL.SPK", dlText)
    dlText = ""
    IF Installed(Field(line, 0)) THEN
        FOR EACH f IN Field(line, 10).Split(";")
            IF f <> "" AND f.Upper() <> ME THEN
                IF FS.Exists(Where(f, Field(line, 13))) THEN FS.Delete(Where(f, Field(line, 13)))
            END IF
        NEXT
    END IF
    setupLine = line
    setupSince = SYS.Ticks
    setupPid = SYS.Run(dir + "\INSTALL.SPK")
    note.Text = "Installing " + Field(line, 1) + "..."
    win.Status = "Running " + Field(line, 1) + "'s installer..."
    ShowTab(tab)
END SUB

' ================================================================ publishing (on a store machine)

' Every installer in C:\MYFILES with a Vapor header goes on the store's shelf,
' in place of an older version of it.
SUB Publish ()
    VAR f AS String
    VAR text AS String
    VAR done AS Array OF String
    VAR same AS Array OF String
    VAR answer AS String
    IF NOT FS.Exists(STOREDIR) THEN
        Say("This machine is not a Vapor store. Run Vapor's INSTALL.SPK here first.", "warn")
        RETURN
    END IF
    win.Status = "Looking in C:\MYFILES for installers..."
    FOR EACH f IN FS.List("C:\MYFILES")
        IF NOT f.EndsWith(".SPK") THEN CONTINUE
        text = FS.Read("C:\MYFILES\" + f)
        IF NOT text.StartsWith("' VAPOR|") THEN CONTINUE
        answer = PublishOne(text)
        IF answer.StartsWith("=") THEN
            same.Add(answer.Substring(1, answer.Length - 1))
        ELSEIF answer <> "" THEN
            done.Add(answer)
        END IF
    NEXT
    IF done.Count = 0 AND same.Count = 0 THEN
        Say("There are no installers to publish in C:\MYFILES." + EOL + EOL + "Paste an app's INSTALL.SPK into SPARK, save it in C:\MYFILES (any name ending .SPK) without running it, and choose Publish Apps again.", "info")
        RETURN
    END IF
    answer = ""
    IF done.Count > 0 THEN answer = "Published:" + EOL + "  " + done.Join(EOL + "  ")
    IF same.Count > 0 THEN answer = answer + EOL + EOL + "Already up to date: " + same.Join(", ")
    Say(answer.Trim(), "info")
    wantCatalog = TRUE
END SUB

' One installer into the store: its parts, and its line in the catalog.
' Returns "name (build)" or "=name" when the store already had that version.
FUNCTION PublishOne (text AS String) AS String
    VAR header AS String
    VAR id AS String
    VAR dir AS String
    VAR f AS String
    VAR lines AS Array OF String
    VAR line AS String
    VAR chunk AS String
    VAR n AS Integer
    VAR entry AS String
    VAR out AS Array OF String
    VAR found AS Bool
    header = text.Lines()[0]
    id = Meta(header, "id").Upper()
    IF id = "" OR id.Length > 8 OR id.Contains("\") OR id.Contains(".") THEN RETURN ""
    FOR EACH line IN ReadOr(STOREDIR + "\CATALOG.TXT", "").Lines()
        IF Field(line, 0) = id AND Field(line, 8) = Meta(header, "version") THEN RETURN "=" + Meta(header, "name")
    NEXT
    dir = STOREDIR + "\" + id
    IF FS.Exists(dir) THEN
        FOR EACH f IN FS.List(dir)
            IF NOT f.EndsWith("\") THEN FS.Delete(dir + "\" + f)
        NEXT
    ELSE
        FS.MakeDir(dir)
    END IF
    ' parts of whole lines, each small enough for one network message
    lines = text.Replace(Chr(13), "").Split(EOL)
    IF lines.Count > 0 THEN
        IF lines[lines.Count - 1] = "" THEN lines.RemoveAt(lines.Count - 1)
    END IF
    FOR EACH line IN lines
        IF chunk.Length + line.Length + 1 > PART AND chunk <> "" THEN
            n = n + 1
            FS.Write(dir + "\" + Str(n) + ".TXT", chunk)
            chunk = ""
        END IF
        chunk = chunk + line + EOL
    NEXT
    IF chunk <> "" THEN
        n = n + 1
        FS.Write(dir + "\" + Str(n) + ".TXT", chunk)
    END IF
    entry = id + "|" + Meta(header, "name") + "|" + Str(n) + "|" + Str(text.Length) + "|ok|" + Meta(header, "category") + "|" + Meta(header, "about") + "|" + Meta(header, "kind") + "|" + Meta(header, "version") + "|" + Meta(header, "run") + "|" + Meta(header, "files") + "|" + Meta(header, "tasks") + "|" + Meta(header, "startup") + "|" + Meta(header, "folder").Upper()
    FOR EACH line IN ReadOr(STOREDIR + "\CATALOG.TXT", "").Lines()
        IF line = "" THEN CONTINUE
        IF Field(line, 0) = id THEN
            out.Add(entry)
            found = TRUE
        ELSE
            out.Add(line)
        END IF
    NEXT
    IF NOT found THEN out.Add(entry)
    FS.Write(STOREDIR + "\CATALOG.TXT", out.Join(EOL) + EOL)
    RETURN Meta(header, "name") + " (build " + Meta(header, "version") + ")"
END FUNCTION

' ================================================================ the header and the banners

SUB Head_OnDraw (canvas AS GUI_Canvas)
    head.Tag = ""
    DrawHead()
END SUB

SUB DrawHead ()
    VAR i AS Integer
    VAR names AS Array OF String
    IF head.Tag = tab THEN RETURN
    head.Tag = tab
    head.Clear()
    head.SetColor(0)
    head.FillRect(0, 0, 640, 44)
    head.SetColor(4)
    head.FillRect(0, 0, 640, 40)
    ' the logo: steam rising off a V
    head.SetColor(15)
    head.FillCircle(22, 14, 4)
    head.FillCircle(28, 9, 3)
    head.FillCircle(17, 8, 2)
    head.SetColor(14)
    head.Text(38, 12, "VAPOR")
    names = ["STORE", "LIBRARY", "DOWNLOADS"]
    FOR i = 0 TO 2
        IF names[i] = tab THEN
            head.SetColor(14)
            head.FillRect(150 + i * 130, 36, 110, 4)
            head.SetColor(15)
        ELSE
            head.SetColor(7)
        END IF
        head.Text(150 + i * 130, 12, names[i])
    NEXT
END SUB

SUB Head_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)
    IF x >= 150 AND x < 270 THEN ShowTab("STORE")
    IF x >= 280 AND x < 400 THEN ShowTab("LIBRARY")
    IF x >= 410 AND x < 540 THEN ShowTab("DOWNLOADS")
END SUB

SUB Banner_OnDraw (canvas AS GUI_Canvas)
    VAR line AS String
    line = Current()
    banner.Tag = ""
    DrawBanner(Field(line, 0))
END SUB

' Each item's banner, drawn.
SUB DrawBanner (id AS String)
    VAR i AS Integer
    IF banner.Tag = id AND id <> "" THEN RETURN
    banner.Tag = id
    banner.Clear()
    SELECT CASE id
        CASE "SIMDOOM"
            banner.SetColor(0)
            banner.FillRect(0, 0, 440, 100)
            FOR i = 0 TO 54
                banner.SetColor(9 - 8 * (i MOD 2))
                banner.FillRect(i * 8, 60 + Rnd(25), 8, 40)
                banner.SetColor(11)
                banner.FillRect(i * 8 + 2, 84 + Rnd(10), 4, 16)
            NEXT
            banner.SetColor(1)
            banner.Text(152, 30, "S I M D O O M")
            banner.SetColor(9)
            banner.Text(150, 28, "S I M D O O M")
        CASE "SNAKE"
            banner.SetColor(0)
            banner.FillRect(0, 0, 440, 100)
            FOR i = 0 TO 20
                banner.SetColor(2)
                banner.FillRect(60 + i * 12, 50 + Int(10 * MATH.Sin(i / 2)), 10, 10)
            NEXT
            banner.SetColor(9)
            banner.FillCircle(360, 55, 5)
            banner.SetColor(10)
            banner.Text(170, 14, "SNAKE 95")
        CASE "HL3"
            banner.SetColor(3)
            banner.FillRect(0, 0, 440, 100)
            banner.SetColor(11)
            banner.FillCircle(70, 50, 34)
            banner.SetColor(3)
            banner.FillCircle(70, 50, 28)
            banner.SetColor(11)
            banner.Line(58, 30, 82, 72)
            banner.Line(70, 50, 56, 72)
            banner.SetColor(15)
            banner.Text(130, 34, "HALF-LIFE 3")
            banner.SetColor(11)
            banner.Text(130, 56, "Coming soon(TM)")
        CASE "SIMXPLOR"
            Plate(1, 15, "Simxplorer")
            banner.SetColor(12)
            FOR i = 0 TO 15
                banner.FillCircle(60 + Int(14 * MATH.Cos((-40 - i * 15) * MATH.Pi / 180)), 36 + Int(11 * MATH.Sin((-40 - i * 15) * MATH.Pi / 180)), 4)
                banner.FillCircle(60 + Int(14 * MATH.Cos((-90 + i * 15) * MATH.Pi / 180)), 58 + Int(11 * MATH.Sin((-90 + i * 15) * MATH.Pi / 180)), 4)
            NEXT
        CASE "FROSTBRD"
            Plate(14, 4, "Frostbird")
            banner.SetColor(15)
            banner.FillRect(30, 30, 60, 40)
            banner.SetColor(0)
            banner.Rect(30, 30, 60, 40)
            banner.Line(30, 30, 60, 52)
            banner.Line(60, 52, 89, 30)
        CASE "CLIPPY"
            Plate(11, 0, "Clippy")
            banner.SetColor(8)
            banner.Rect(50, 18, 20, 66)
            banner.Rect(56, 26, 10, 46)
            banner.SetColor(15)
            banner.FillCircle(54, 40, 6)
            banner.FillCircle(70, 40, 6)
            banner.SetColor(0)
            banner.FillCircle(55, 41, 2)
            banner.FillCircle(71, 41, 2)
        CASE "SIMBOOK"
            Plate(4, 15, "[simbook]")
        CASE "COLDMAIL"
            Plate(14, 4, "ColdMail!")
        CASE "ASKSIM"
            Plate(5, 15, "AskSim")
            banner.SetColor(7)
            banner.FillCircle(60, 40, 16)
            banner.SetColor(0)
            banner.FillRect(44, 58, 32, 30)
        CASE "ELIZA"
            Plate(6, 15, "ELIZA-95")
        CASE ""
            banner.SetColor(7)
            banner.FillRect(0, 0, 440, 100)
        CASE ELSE
            Plate(4, 15, id)
    END SELECT
END SUB

' A plain banner: a colour, and the name in big letters.
SUB Plate (back AS Integer, ink AS Integer, name AS String)
    banner.SetColor(back)
    banner.FillRect(0, 0, 440, 100)
    banner.SetColor(8)
    banner.Text(132, 42, name)
    banner.SetColor(ink)
    banner.Text(130, 40, name)
END SUB

' ================================================================ menus

SUB Menu_OnSelect (item AS String)
    SELECT CASE item
        CASE "Store"
            ShowTab("STORE")
        CASE "Library"
            ShowTab("LIBRARY")
        CASE "Downloads"
            ShowTab("DOWNLOADS")
        CASE "Update All"
            UpdateAll()
        CASE "Change Store..."
            ChangeStore()
        CASE "Publish Apps..."
            Publish()
        CASE "Check for Updates"
            CheckNow()
        CASE "Refresh"
            CheckNow()
        CASE "Exit"
            win.Close()
        CASE "About Vapor"
            Say("Vapor 2.0 for SIM95 (build " + MyVersion() + ")" + EOL + EOL + "Games, programs and web apps from any machine that runs a Vapor store (http://machine/vapor/): downloads, a library with updates, play time and achievements." + EOL + EOL + "Half-Life 3 is coming soon.", "info")
    END SELECT
END SUB

VAR askWin AS GUI_Window
VAR askBox AS GUI_TextBox

SUB ChangeStore ()
    VAR l AS GUI_Label
    VAR b AS GUI_Button
    askWin = GUI_Window.New("Vapor Store", 360, 110)
    askWin.Modal = TRUE
    l = GUI_Label.New(askWin)
    l.Text = "Which machine is your store? (Any machine with Vapor" + EOL + "installed is one: type its name, like alpha, or a domain.)"
    l.SetBounds(10, 8, 340, 30)
    askBox = GUI_TextBox.New(askWin)
    askBox.Text = store
    askBox.SetBounds(10, 44, 340, 21)
    askBox.onEnter = Store_Ok
    b = GUI_Button.New(askWin)
    b.Text = "OK"
    b.Default = TRUE
    b.SetBounds(272, 74, 78, 26)
    b.onClick = Store_Ok
    askWin.Center()
    askWin.Show()
    askBox.Focus()
END SUB

SUB Store_Ok ()
    VAR s AS String
    s = askBox.Text.Trim().Lower()
    IF s = "" THEN RETURN
    IF NOT s.StartsWith("http://") THEN s = "http://" + s
    IF s.Substring(7, s.Length - 7).IndexOf("/") < 0 THEN s = s + "/vapor/"
    IF NOT s.EndsWith("/") THEN s = s + "/"
    store = s
    SaveSettings()
    askWin.Close()
    catalog.Clear()
    wantCatalog = TRUE
    ShowTab("STORE")
END SUB

SUB Say (text AS String, kind AS String)
    VAR box AS GUI_MessageBox
    box = GUI_MessageBox.New(win)
    box.Title = "Vapor"
    box.Kind = kind
    box.Text = text
    box.Show()
END SUB

' RESOLVE.SPK - the SimDNS resolver: asks the name server which machine a
' name like www.coolsite.sim is on.
'
' The name server is the central one, STARTHERE.56k.net, where SimNIC (the
' registrar) and NAMED.SPK run, unless C:\SYSTEM\RESOLV.INI says otherwise.
' To move the whole network to another central host, change RSCENTRAL below
' (the builder sets it from CENTRAL in tools/simxplorer-source.mjs).
'
' A library, not a program: a program has it joined on the end (the builder
' does this for Simxplorer, SimPlayer, Vapor, Frostbird, MAILD, the Sim Shell,
' AskSim's crawler, DIG and Personal Web Manager; copy C:\PROGRAMS\RESOLVE.SPK
' onto the end of your own). Every name in it starts with Rs, so it can't clash.
'
' C:\SYSTEM\RESOLV.INI, shared by every program on the machine (optional):
'     nameserver=dnsbox          another name server instead of the central one
'     nameserver=none            no SimDNS at all: SIM95 machine names only
'     search=coolsite.sim        then "www" means www.coolsite.sim
'
' How to use it without ever waiting in the wrong place (SIM95-NOTES.md):
'   1. RsWants(host)  - does this name need asking? FALSE for addresses,
'                       plain machine names, names already known, or when
'                       there is no name server (or it isn't answering).
'   2. RsAsk(host, address) - sends the question to the name server at that
'                       address. It is a Connect: let it be the last thing
'                       the handler does.
'   3. RsBusy()       - TRUE while the answer is on its way. After RSWAIT
'                       with no answer the server is left alone for RSQUIET,
'                       and every name goes to SIM95 as before.
'   4. RsTarget(host) - where to connect: the machine name (or address) the
'                       name server gave, or the name itself when SimDNS
'                       doesn't know it, for SIM95 to look up.
' Answers are kept for their TTL; names SimDNS doesn't know for RSNEG.
'
' Or, from a timer tick, all of that in one line (see RsNext):
'     IF RsNext(host) THEN RETURN          ' asked, or waiting: end the tick
'     conn = sock.Connect(RsTarget(host), 80)
' and for mail, the domain's MX first (see RsNextMail):
'     IF RsNextMail(domain) THEN RETURN
'     conn = sock.Connect(RsMailTarget(domain), 25)

CONST RSCENTRAL = "starthere.56k.net"   ' the central name server
CONST RSINI = "C:\SYSTEM\RESOLV.INI"
CONST RSPORT = 53
CONST RSWAIT = 2000             ' ms to wait for an answer
CONST RSQUIET = 30000            ' ms to leave a silent name server alone
CONST RSNEG = 60000             ' ms to remember that SimDNS doesn't know a name
CONST RSMOST = 100              ' names kept

VAR rsServer AS String              ' "" when SimDNS is off
VAR rsByDefault AS Bool               ' TRUE when RESOLV.INI doesn't name one
VAR rsSearch AS String
VAR rsRead AS Bool
VAR rsReadAt AS Integer
VAR rsSock AS NET_Socket
VAR rsName AS Array OF String       ' the name as asked, lower case
VAR rsTo AS Array OF String         ' where it is ("" when SimDNS doesn't know it)
VAR rsCanon AS Array OF String      ' its last name in DNS before the machine
VAR rsUntil AS Array OF Integer     ' SYS.Ticks when it is forgotten
VAR rsAsking AS String
VAR rsAskAt AS Integer
VAR rsRefused AS Bool
VAR rsDown AS Bool
VAR rsDownAt AS Integer
VAR rsWhy AS String                 ' the last thing that went wrong
VAR rsLastReply AS String           ' the last answer, as it came
VAR rsServerAddr AS String          ' the name server's address, for RsNext
VAR rsServerFor AS String
VAR rsServerAt AS Integer
VAR rsLooking AS Bool               ' RsNext is finding the name server's address
VAR rsLookingAt AS Integer

' Reads RESOLV.INI (again after a few seconds, so a new setting takes).
' With no nameserver= line, the central name server; none (or nothing after
' the =) turns SimDNS off.
SUB RsConfig ()
    VAR line AS String
    VAR low AS String
    IF rsRead AND SYS.Ticks - rsReadAt < 3000 THEN RETURN
    rsRead = TRUE
    rsReadAt = SYS.Ticks
    rsServer = RSCENTRAL
    rsByDefault = TRUE
    rsSearch = ""
    TRY
        IF FS.Exists(RSINI) THEN
            FOR EACH line IN FS.Read(RSINI).Lines()
                low = line.Trim().Lower()
                IF low.StartsWith("nameserver=") THEN
                    rsServer = low.Substring(11, low.Length - 11).Trim()
                    rsByDefault = FALSE
                END IF
                IF low.StartsWith("search=") THEN rsSearch = low.Substring(7, low.Length - 7).Trim()
            NEXT
        END IF
    CATCH err
    END TRY
    IF rsServer = "none" THEN rsServer = ""
    IF rsSearch.StartsWith(".") THEN rsSearch = rsSearch.Substring(1, rsSearch.Length - 1)
    IF rsSearch.EndsWith(".") THEN rsSearch = rsSearch.Substring(0, rsSearch.Length - 1)
END SUB

' The name server (a machine name or address), or "" for none.
FUNCTION RsNameServer () AS String
    RsConfig()
    RETURN rsServer
END FUNCTION

' Is it the central one, because RESOLV.INI doesn't say?
FUNCTION RsIsCentral () AS Bool
    RsConfig()
    RETURN rsByDefault
END FUNCTION

' Makes server this machine's name server, keeping the rest of RESOLV.INI,
' and forgets everything it knew. "" (or none) for no SimDNS at all;
' default for the central one again.
SUB RsSave (server AS String)
    VAR out AS Array OF String
    VAR line AS String
    server = server.Trim().Lower()
    IF server = "" THEN server = "none"
    TRY
        IF FS.Exists(RSINI) THEN
            FOR EACH line IN FS.Read(RSINI).Lines()
                IF line.Trim() <> "" AND NOT line.Trim().Lower().StartsWith("nameserver=") THEN out.Add(line)
            NEXT
        END IF
        IF server <> "default" THEN out.Insert(0, "nameserver=" + server)
        IF out.Count = 0 THEN
            IF FS.Exists(RSINI) THEN FS.Delete(RSINI)
        ELSE
            FS.Write(RSINI, out.Join(Chr(10)) + Chr(10))
        END IF
    CATCH err
        rsWhy = err
    END TRY
    rsRead = FALSE
    RsForget()
END SUB

SUB RsForget ()
    rsName.Clear()
    rsTo.Clear()
    rsCanon.Clear()
    rsUntil.Clear()
    rsDown = FALSE
    rsAsking = ""
END SUB

FUNCTION RsIsAddress (s AS String) AS Bool
    VAR p AS String
    VAR i AS Integer
    IF s.Split(".").Count <> 4 THEN RETURN FALSE
    FOR EACH p IN s.Split(".")
        IF p = "" OR p.Length > 3 THEN RETURN FALSE
        FOR i = 0 TO p.Length - 1
            IF NOT "0123456789".Contains(p.CharAt(i)) THEN RETURN FALSE
        NEXT
    NEXT
    RETURN TRUE
END FUNCTION

' The name the server is asked about: lower case, the search domain added
' to a single word.
FUNCTION RsFull (host AS String) AS String
    VAR h AS String
    h = host.Trim().Lower()
    IF h.EndsWith(".") THEN h = h.Substring(0, h.Length - 1)
    IF NOT h.Contains(".") AND rsSearch <> "" THEN h = h + "." + rsSearch
    RETURN h
END FUNCTION

' Where a name is in the list of answers, or -1 (old answers are dropped).
FUNCTION RsFind (host AS String) AS Integer
    VAR i AS Integer
    i = rsName.IndexOf(host.Trim().Lower())
    IF i < 0 THEN RETURN -1
    IF SYS.Ticks > rsUntil[i] THEN
        rsName.RemoveAt(i)
        rsTo.RemoveAt(i)
        rsCanon.RemoveAt(i)
        rsUntil.RemoveAt(i)
        RETURN -1
    END IF
    RETURN i
END FUNCTION

FUNCTION RsWants (host AS String) AS Bool
    IF NOT RsAsks(host) THEN RETURN FALSE
    RETURN RsFind(host) < 0
END FUNCTION

' The same for a mail domain's MX record.
FUNCTION RsWantsMx (domain AS String) AS Bool
    IF NOT RsAsks(domain) THEN RETURN FALSE
    RETURN RsFind("mx:" + domain.Trim().Lower()) < 0
END FUNCTION

' Is host a name for the name server at all (whether known yet or not)?
FUNCTION RsAsks (host AS String) AS Bool
    VAR h AS String
    RsConfig()
    h = host.Trim().Lower()
    IF rsServer = "" OR h = "" OR h = "localhost" THEN RETURN FALSE
    IF rsDown AND SYS.Ticks - rsDownAt < RSQUIET THEN RETURN FALSE
    IF RsIsAddress(h) THEN RETURN FALSE
    IF NOT h.Contains(".") AND rsSearch = "" THEN RETURN FALSE
    IF h = rsServer OR h = NET.HostName.Lower() THEN RETURN FALSE
    ' a machine's full name (bob.56k.net): SIM95's, never SimDNS's to answer
    IF RsIspName(h) THEN RETURN FALSE
    RETURN TRUE
END FUNCTION

' Does h end in one of SIM95's ISPs (56k.net, dialup.zone...)?
FUNCTION RsIspName (h AS String) AS Bool
    VAR isp AS String
    FOR EACH isp IN ["dialup.zone", "56k.net", "bbs.club", "modem.link", "beep.boop"]
        IF h = isp OR h.EndsWith("." + isp) THEN RETURN TRUE
    NEXT
    RETURN FALSE
END FUNCTION

' Sends the question. A Connect, so it must be the last thing its handler
' does: if the name server refuses, the handler is spoiled (SIM95-NOTES.md).
SUB RsAsk (host AS String, address AS String)
    RsSend(host.Trim().Lower(), "A", address)
END SUB

' Asks for a mail domain's MX records (also a Connect: the last thing).
SUB RsAskMx (domain AS String, address AS String)
    RsSend("mx:" + domain.Trim().Lower(), "MX", address)
END SUB

' key is the name, or mx: and the name; the answer is kept under it.
SUB RsSend (key AS String, qtype AS String, address AS String)
    VAR conn AS NET_Connection
    VAR name AS String
    IF IsNothing(rsSock) THEN
        rsSock = NET_Socket.New()
        rsSock.onMessage = Rs_OnMessage
    END IF
    name = key
    IF name.StartsWith("mx:") THEN name = name.Substring(3, name.Length - 3)
    rsAsking = key
    rsAskAt = SYS.Ticks
    rsRefused = FALSE
    TRY
        conn = rsSock.Connect(address, RSPORT)
        conn.Tag = "rs:" + key
        conn.Send("QUERY " + RsFull(name) + " " + qtype)
    CATCH err
        rsRefused = TRUE
    END TRY
END SUB

' Gives up on the name server for a while: every name goes to SIM95.
SUB RsGiveUp (why AS String)
    rsWhy = why
    rsDown = TRUE
    rsDownAt = SYS.Ticks
    rsAsking = ""
    rsServerAddr = ""
END SUB

' For a program that fetches from a timer tick: TRUE when the tick must end
' now, because a question about host has just been sent (a Connect, so it
' has to be the last thing the handler does) or an answer is on its way.
' FALSE when there is nothing to ask: RsTarget(host) is where to connect.
' A name server that is missing, refuses or says nothing for RSWAIT is left
' alone for RSQUIET, and every name goes to SIM95: nothing ever hangs.
FUNCTION RsNext (host AS String) AS Bool
    RETURN RsStep(host, FALSE)
END FUNCTION

' The same for mail to domain: its MX record (the lowest preference), then
' the CNAMEs or address of the machine that names. RsMailTarget(domain) is
' then where to connect; with no MX, the domain's own machine; with no
' answer at all, the domain itself, for SIM95 to look up.
FUNCTION RsNextMail (domain AS String) AS Bool
    IF RsStep(domain, TRUE) THEN RETURN TRUE
    RETURN RsStep(RsMailHost(domain), FALSE)
END FUNCTION

FUNCTION RsStep (host AS String, mx AS Bool) AS Bool
    VAR addr AS String
    ' another handler is finding the name server (it waits): wait for it
    IF rsLooking THEN
        IF SYS.Ticks - rsLookingAt < RSWAIT THEN RETURN TRUE
        rsLooking = FALSE
        RsGiveUp("no answer about the machine " + rsServer)
        RETURN FALSE
    END IF
    IF RsBusy() THEN RETURN TRUE
    IF mx THEN
        IF NOT RsWantsMx(host) THEN RETURN FALSE
    ELSE
        IF NOT RsWants(host) THEN RETURN FALSE
    END IF
    addr = RsServerAddress()
    IF addr = "" THEN RETURN FALSE
    IF mx THEN
        RsAskMx(host, addr)
    ELSE
        RsAsk(host, addr)
    END IF
    RETURN TRUE
END FUNCTION

' The name server's address, looked up once a minute (one lookup at a time:
' see SIM95-NOTES.md). "" when there is no such machine, and then it gives up.
FUNCTION RsServerAddress () AS String
    VAR addr AS String
    IF RsIsAddress(rsServer) THEN RETURN rsServer
    IF rsServerAddr <> "" AND rsServerFor = rsServer AND SYS.Ticks - rsServerAt < 60000 AND SYS.Ticks >= rsServerAt THEN RETURN rsServerAddr
    rsLooking = TRUE
    rsLookingAt = SYS.Ticks
    addr = NET.Resolve(rsServer)
    IF NOT rsLooking THEN RETURN ""
    rsLooking = FALSE
    IF addr = "" THEN
        RsGiveUp("there is no machine called " + rsServer)
        RETURN ""
    END IF
    rsServerAddr = addr
    rsServerFor = rsServer
    rsServerAt = SYS.Ticks
    RETURN addr
END FUNCTION

FUNCTION RsBusy () AS Bool
    IF rsAsking = "" THEN RETURN FALSE
    IF rsRefused THEN
        RsGiveUp("the name server " + rsServer + " refused")
        RETURN FALSE
    END IF
    IF SYS.Ticks - rsAskAt > RSWAIT THEN
        RsGiveUp("no answer from the name server " + rsServer)
        RETURN FALSE
    END IF
    RETURN TRUE
END FUNCTION

SUB Rs_OnMessage (conn AS NET_Connection, message AS String)
    VAR h AS String
    IF NOT conn.Tag.StartsWith("rs:") THEN RETURN
    h = conn.Tag.Substring(3, conn.Tag.Length - 3)
    conn.Tag = ""
    TRY
        conn.Close()
    CATCH err
    END TRY
    RsTake(h, message)
    IF h = rsAsking THEN rsAsking = ""
END SUB

' Learns an answer: follows its CNAMEs to an address, or to the machine
' name the chain ends at.
SUB RsTake (host AS String, reply AS String)
    VAR lines AS Array OF String
    VAR w AS Array OF String
    VAR cur AS String
    VAR onward AS String
    VAR target AS String
    VAR canon AS String
    VAR ttl AS Integer = 3600
    VAR hops AS Integer
    VAR i AS Integer
    rsLastReply = reply
    IF host.StartsWith("mx:") THEN
        RsTakeMx(host, reply)
        RETURN
    END IF
    lines = reply.Lines()
    IF lines.Count = 0 THEN RETURN
    IF lines[0].StartsWith("NXDOMAIN") THEN
        RsKeep(host, "", "NXDOMAIN", RSNEG)
        RETURN
    END IF
    IF NOT lines[0].StartsWith("OK") THEN
        rsWhy = lines[0]
        RsKeep(host, "", "", 10000)
        RETURN
    END IF
    cur = RsFull(host)
    canon = cur
    FOR hops = 0 TO 8
        onward = ""
        FOR i = 1 TO lines.Count - 1
            w = lines[i].Split(" ")
            IF w.Count >= 4 THEN
                IF w[0] = cur AND w[2] = "A" AND target = "" THEN target = w[3]
                IF w[0] = cur AND w[2] = "CNAME" THEN onward = w[3]
                IF w[0] = cur AND (w[2] = "A" OR w[2] = "CNAME") AND Int(Val(w[1])) < ttl THEN ttl = Int(Val(w[1]))
            END IF
        NEXT
        IF target <> "" THEN
            canon = cur
            BREAK
        END IF
        IF onward = "" THEN BREAK
        canon = cur
        cur = onward
    NEXT
    IF target = "" THEN
        ' a name with no CNAME and no address: not one to connect to
        IF cur = RsFull(host) THEN
            RsKeep(host, "", "", RSNEG)
            RETURN
        END IF
        ' the end of the chain: a SIM95 machine name
        target = cur
    END IF
    IF ttl < 5 THEN ttl = 5
    RsKeep(host, target, canon, ttl * 1000)
END SUB

' Learns an MX answer: the mail machine with the lowest preference. With no
' MX, the server answers with the domain's CNAMEs instead, and the domain's
' own machine takes the mail.
SUB RsTakeMx (key AS String, reply AS String)
    VAR domain AS String
    VAR lines AS Array OF String
    VAR w AS Array OF String
    VAR best AS String
    VAR pref AS Integer = 1000000
    VAR ttl AS Integer = 3600
    VAR i AS Integer
    domain = key.Substring(3, key.Length - 3)
    lines = reply.Lines()
    IF lines.Count = 0 THEN RETURN
    IF lines[0].StartsWith("NXDOMAIN") THEN
        RsKeep(key, "", "NXDOMAIN", RSNEG)
        RsKeep(domain, "", "NXDOMAIN", RSNEG)
        RETURN
    END IF
    IF NOT lines[0].StartsWith("OK") THEN
        rsWhy = lines[0]
        RsKeep(key, "", "", 10000)
        RETURN
    END IF
    FOR i = 1 TO lines.Count - 1
        w = lines[i].Split(" ")
        IF w.Count >= 5 THEN
            IF w[2] = "MX" AND Int(Val(w[3])) < pref THEN
                pref = Int(Val(w[3]))
                best = w[4]
                ttl = Int(Val(w[1]))
            END IF
        END IF
    NEXT
    IF best <> "" THEN
        IF best.EndsWith(".") THEN best = best.Substring(0, best.Length - 1)
        IF ttl < 5 THEN ttl = 5
        RsKeep(key, best, RsFull(domain), ttl * 1000)
        RETURN
    END IF
    RsTake(domain, reply)
    IF RsKnown(domain) THEN
        RsKeep(key, domain, RsFull(domain), RSNEG)
    ELSE
        RsKeep(key, "", "", RSNEG)
    END IF
END SUB

' The machine (or name) that takes domain's mail: its MX, or domain itself.
FUNCTION RsMailHost (domain AS String) AS String
    VAR i AS Integer
    i = RsFind("mx:" + domain.Trim().Lower())
    IF i < 0 THEN RETURN domain
    IF rsTo[i] = "" THEN RETURN domain
    RETURN rsTo[i]
END FUNCTION

' Where to connect for domain's mail.
FUNCTION RsMailTarget (domain AS String) AS String
    RETURN RsTarget(RsMailHost(domain))
END FUNCTION

' Did SimDNS say where domain's mail goes (an MX, or the domain's machine)?
FUNCTION RsMailKnown (domain AS String) AS Bool
    VAR i AS Integer
    i = RsFind("mx:" + domain.Trim().Lower())
    IF i < 0 THEN RETURN FALSE
    IF rsTo[i] = "" THEN RETURN FALSE
    RETURN RsKnown(RsMailHost(domain)) OR NOT RsAsks(RsMailHost(domain))
END FUNCTION

SUB RsKeep (host AS String, target AS String, canon AS String, ms AS Integer)
    VAR i AS Integer
    VAR h AS String
    h = host.Trim().Lower()
    i = rsName.IndexOf(h)
    IF i >= 0 THEN
        rsName.RemoveAt(i)
        rsTo.RemoveAt(i)
        rsCanon.RemoveAt(i)
        rsUntil.RemoveAt(i)
    END IF
    IF rsName.Count >= RSMOST THEN
        rsName.RemoveAt(0)
        rsTo.RemoveAt(0)
        rsCanon.RemoveAt(0)
        rsUntil.RemoveAt(0)
    END IF
    rsName.Add(h)
    rsTo.Add(target)
    rsCanon.Add(canon)
    rsUntil.Add(SYS.Ticks + ms)
END SUB

' Where to connect for host: what SimDNS said, or host itself.
FUNCTION RsTarget (host AS String) AS String
    VAR i AS Integer
    i = RsFind(host)
    IF i < 0 THEN RETURN host
    IF rsTo[i] = "" THEN RETURN host
    RETURN rsTo[i]
END FUNCTION

' The name host's machine was found under (www.coolsite.sim), or host.
FUNCTION RsCanonical (host AS String) AS String
    VAR i AS Integer
    i = RsFind(host)
    IF i < 0 THEN RETURN host
    IF rsTo[i] = "" THEN RETURN host
    RETURN rsCanon[i]
END FUNCTION

' Did SimDNS answer for host (so RsTarget is its machine)?
FUNCTION RsKnown (host AS String) AS Bool
    VAR i AS Integer
    i = RsFind(host)
    IF i < 0 THEN RETURN FALSE
    RETURN rsTo[i] <> ""
END FUNCTION

' Did the name server say there is no such name (NXDOMAIN)?
FUNCTION RsNoSuchName (host AS String) AS Bool
    VAR i AS Integer
    i = RsFind(host)
    IF i < 0 THEN RETURN FALSE
    RETURN rsTo[i] = "" AND rsCanon[i] = "NXDOMAIN"
END FUNCTION

' Is the name server being left alone, because it didn't answer (or there
' is none)? rsWhy says why.
FUNCTION RsSilent () AS Bool
    RsConfig()
    IF rsServer = "" THEN RETURN TRUE
    RETURN rsDown AND SYS.Ticks - rsDownAt < RSQUIET
END FUNCTION
