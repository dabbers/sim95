' INSTALL.SPK - puts Vapor on this machine. Generated by tools/build-installer.mjs;
' edit the files in vapor/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It makes this
' machine a Vapor games store: the store's files go in C:\WEB\VAPOR (the web
' server hands them out at http://YOURNAME/vapor/), with every game cut into
' parts that fit a network message. It also puts the Vapor program in
' C:\PROGRAMS\VAPOR.SPK and starts it. Other machines get Vapor from the
' store's page, and download games from it. Your home page is not touched.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)

    IF NOT FS.Exists(Dest("C:\WEB\VAPOR")) THEN FS.MakeDir(Dest("C:\WEB\VAPOR"))
    IF NOT FS.Exists(Dest("C:\WEB\VAPOR\VAPOR")) THEN FS.MakeDir(Dest("C:\WEB\VAPOR\VAPOR"))
    IF NOT FS.Exists(Dest("C:\WEB\VAPOR\SIMPLAYR")) THEN FS.MakeDir(Dest("C:\WEB\VAPOR\SIMPLAYR"))
    IF NOT FS.Exists(Dest("C:\WEB\VAPOR\SIMWEB")) THEN FS.MakeDir(Dest("C:\WEB\VAPOR\SIMWEB"))
    IF NOT FS.Exists(Dest("C:\WEB\VAPOR\SIMDOOM")) THEN FS.MakeDir(Dest("C:\WEB\VAPOR\SIMDOOM"))
    IF NOT FS.Exists(Dest("C:\WEB\VAPOR\SNAKE")) THEN FS.MakeDir(Dest("C:\WEB\VAPOR\SNAKE"))


    File0()
    File1()
    File2()
    File3()
    File4()
    File5()
    File6()
    File7()
    File8()
    File9()
    File10()
    File11()
    File12()
    File13()
    File14()
    File15()
    File16()
    File17()
    File18()
    File19()
    File20()
    File21()
    File22()
    File23()
    File24()
    File25()
    File26()
    File27()
    File28()
    File29()
    File30()
    Print("Vapor is installed (31 files).")
    SYS.Start("C:\PROGRAMS\VAPOR.SPK", "")

    Print("Vapor is running, and this machine is a store: http://" + NET.HostName.Lower() + "/vapor/")
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "<%" + NL
    t = t + "' GETVAPOR.ASP - the program that fetches Vapor, as plain text, ready to save" + NL
    t = t + "' as C:\MYFILES\GETVAPOR.SPK (Simxplorer: File > Save As File)." + NL
    t = t + "RESPONSE.ContentType = ""text/plain""" + NL
    t = t + "RESPONSE.Write(FS.Read(""C:\WEB\VAPOR\GETVAPOR.TXT"").Replace(""%HOST%"", SERVER.Name.Lower()))" + NL
    t = t + "%>" + NL
    Put("C:\WEB\VAPOR\GETVAPOR.ASP")
END SUB

SUB File1 ()
    t = ""
    t = t + "' GETVAPOR.SPK - copies Vapor from the store on %HOST% and starts it." + NL
    t = t + "' Save it as C:\MYFILES\GETVAPOR.SPK, open it in SPARK and press F5." + NL
    t = t + "CONST FROM = ""%HOST%""" + NL
    t = t + "VAR web AS NET_Socket" + NL
    t = t + "VAR parts AS Array OF String" + NL
    t = t + "VAR done AS Bool" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    ' a failed Connect spoils the handler it happens in, so all of it sits in a TRY" + NL
    t = t + "    TRY" + NL
    t = t + "        Install()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Install ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR count AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR piece AS String" + NL
    t = t + "    web = NET_Socket.New()" + NL
    t = t + "    web.onMessage = Web_OnMessage" + NL
    t = t + "    web.onClose = Web_OnClose" + NL
    t = t + "    Print(""Fetching Vapor from "" + FROM + ""..."")" + NL
    t = t + "    FOR EACH line IN Fetch(""/vapor/catalog.txt"").Lines()" + NL
    t = t + "        IF line.StartsWith(""VAPOR|"") THEN count = Int(Val(line.Split(""|"")[2]))" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF count = 0 THEN" + NL
    t = t + "        Print(""There is no Vapor in the store on "" + FROM + ""."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 1 TO count" + NL
    t = t + "        piece = Fetch(""/vapor/vapor/"" + Str(i) + "".txt"")" + NL
    t = t + "        IF piece = """" THEN RETURN" + NL
    t = t + "        text = text + piece" + NL
    t = t + "        Print(""  part "" + Str(i) + "" of "" + Str(count))" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Write(""C:\PROGRAMS\VAPOR.SPK"", text)" + NL
    t = t + "    IF NOT FS.Exists(""C:\GAMES"") THEN FS.MakeDir(""C:\GAMES"")" + NL
    t = t + "    FS.Write(""C:\GAMES\VAPOR.INI"", ""store=http://"" + FROM + ""/vapor/"" + Chr(10))" + NL
    t = t + "    Print(""Vapor is installed in C:\PROGRAMS\VAPOR.SPK. Starting it..."")" + NL
    t = t + "    SYS.Run(""C:\PROGRAMS\VAPOR.SPK"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One file over the web, read through the socket's events (see SIM95-NOTES.md)." + NL
    t = t + "FUNCTION Fetch (path AS String) AS String" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR raw AS String" + NL
    t = t + "    VAR since AS Integer" + NL
    t = t + "    parts.Clear()" + NL
    t = t + "    done = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = web.Connect(FROM, 80)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        Print(""Could not reach "" + FROM + "": "" + err)" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END TRY" + NL
    t = t + "    conn.Send(""GET "" + path + "" HTTP/1.0"" + Chr(10) + ""Host: "" + FROM)" + NL
    t = t + "    since = SYS.Ticks" + NL
    t = t + "    WHILE NOT done AND SYS.Ticks - since < 10000" + NL
    t = t + "        SYS.Sleep(50)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    raw = parts.Join(Chr(10))" + NL
    t = t + "    IF NOT raw.StartsWith(""HTTP/1.0 200"") THEN" + NL
    t = t + "        Print(""Could not fetch "" + path)" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN raw.Substring(raw.IndexOf(Chr(10) + Chr(10)) + 2, raw.Length - raw.IndexOf(Chr(10) + Chr(10)) - 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    parts.Add(message)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnClose (conn AS NET_Connection)" + NL
    t = t + "    done = TRUE" + NL
    t = t + "END SUB" + NL
    Put("C:\WEB\VAPOR\GETVAPOR.TXT")
END SUB

SUB File2 ()
    t = ""
    t = t + "<%" + NL
    t = t + "' INDEX.ASP - the Vapor store's web site (http://<machine>/vapor/): download" + NL
    t = t + "' Vapor, and see what is on the shelves." + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR p AS Array OF String" + NL
    t = t + "VAR here AS String" + NL
    t = t + "VAR apps AS String" + NL
    t = t + "VAR games AS String" + NL
    t = t + "VAR row AS String" + NL
    t = t + "VAR client AS String" + NL
    t = t + "VAR kind AS String" + NL
    t = t + "here = SERVER.Name.Lower()" + NL
    t = t + "IF FS.Exists(""C:\WEB\VAPOR\CATALOG.TXT"") THEN" + NL
    t = t + "    FOR EACH line IN FS.Read(""C:\WEB\VAPOR\CATALOG.TXT"").Lines()" + NL
    t = t + "        p = line.Split(""|"")" + NL
    t = t + "        IF p.Count < 7 THEN CONTINUE" + NL
    t = t + "        kind = ""game""" + NL
    t = t + "        IF p.Count > 7 THEN kind = p[7]" + NL
    t = t + "        IF kind = ""client"" THEN" + NL
    t = t + "            client = ""build "" + p[8]" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        row = ""<tr><td bgcolor=""""#1B2838"""" valign=""""top""""><font color=""""#66C0F4""""><b>"" + SERVER.HtmlEncode(p[1]) + ""</b></font><br><font size=""""2"""" color=""""#C7D5E0"""">"" + SERVER.HtmlEncode(p[6].Replace(""%0A"", "" "").Replace(""%7C"", ""|"").Replace(""%25"", ""%"")) + ""</font></td>""" + NL
    t = t + "        IF p[4] = ""soon"" THEN" + NL
    t = t + "            row = row + ""<td bgcolor=""""#1B2838"""" align=""""right"""" valign=""""top"""" width=""""140""""><font color=""""#8F98A0"""">Coming soon</font></td></tr>""" + NL
    t = t + "        ELSE" + NL
    t = t + "            row = row + ""<td bgcolor=""""#1B2838"""" align=""""right"""" valign=""""top"""" width=""""140""""><font color=""""#A4D007""""><b>Free</b></font><br><font size=""""1"""" color=""""#8F98A0"""">"" + SERVER.HtmlEncode(p[5]) + "", "" + Str(Int(Val(p[3]) / 1024) + 1) + "" KB""" + NL
    t = t + "            IF p.Count > 8 THEN row = row + ""<br>build "" + p[8]" + NL
    t = t + "            row = row + ""</font></td></tr>""" + NL
    t = t + "        END IF" + NL
    t = t + "        IF kind = ""game"" THEN" + NL
    t = t + "            games = games + row" + NL
    t = t + "        ELSE" + NL
    t = t + "            apps = apps + row" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END IF" + NL
    t = t + "%><html><head><title>Vapor - games and apps for SIM95</title>" + NL
    t = t + "<meta name=""description"" content=""Download Vapor, the store for SIM95: free games like SimDOOM and Snake 95, and apps like Simxplorer, Frostbird, Clippy and SimBook, with updates, a library, play time and achievements."">" + NL
    t = t + "<meta name=""keywords"" content=""download, vapor, steam, games, video games, game store, app store, apps, software, programs, free downloads, updates, doom, browser, email, mail client, clippy, social network"">" + NL
    t = t + "</head>" + NL
    t = t + "<body bgcolor=""#171A21"" text=""#C7D5E0"" link=""#66C0F4"" vlink=""#66C0F4"">" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td bgcolor=""#171A21"">" + NL
    t = t + "<font size=""6"" color=""#FFFFFF""><b>VAPOR</b></font> <font color=""#66C0F4"">store on <%= here %></font></td>" + NL
    t = t + "<td bgcolor=""#171A21"" align=""right""><font size=""2""><a href=""#download"">Download</a> &middot; <a href=""#apps"">Apps</a> &middot; <a href=""#games"">Games</a></font></td></tr></table>" + NL
    t = t + "" + NL
    t = t + "<a name=""download""></a>" + NL
    t = t + "<table width=""100%"" cellpadding=""14"" cellspacing=""0""><tr><td bgcolor=""#2A475E"">" + NL
    t = t + "<font size=""5"" color=""#FFFFFF""><b>Get Vapor</b></font><br>" + NL
    t = t + "<font color=""#C7D5E0"">Games, programs and web apps for SIM95, in one place. Install with a click, keep everything up to date, count your hours, collect achievements.</font>" + NL
    t = t + "<p><font color=""#FFFFFF""><b>1.</b></font> Open <a href=""getvapor.asp""><b>getvapor.asp</b></a> in Simxplorer and choose <b>File &gt; Save As File</b>; save it as <tt>C:\MYFILES\GETVAPOR.SPK</tt>." + NL
    t = t + "<font size=""2"" color=""#8F98A0"">(In Voyager: View Source, then save it from Notes.)</font><br>" + NL
    t = t + "<font color=""#FFFFFF""><b>2.</b></font> Open <tt>GETVAPOR.SPK</tt> in SPARK and press <b>F5</b>. It downloads Vapor, already pointed at this store, and starts it.</p>" + NL
    t = t + "<font size=""2"" color=""#8F98A0"">Or copy the program from the bottom of this page into SPARK. Vapor <%= client %>.</font>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "" + NL
    t = t + "<a name=""apps""></a>" + NL
    t = t + "<h3><font color=""#FFFFFF"">Apps</font></h3>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""2""><%= apps %></table>" + NL
    t = t + "<% IF apps = """" THEN %><p><font size=""2"" color=""#8F98A0"">No apps on the shelves yet. The store's keeper can add them: save any app's INSTALL.SPK in C:\MYFILES on <%= here %>, then Vapor &gt; Publish Apps.</font></p><% END IF %>" + NL
    t = t + "" + NL
    t = t + "<a name=""games""></a>" + NL
    t = t + "<h3><font color=""#FFFFFF"">Games</font></h3>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""2""><%= games %></table>" + NL
    t = t + "" + NL
    t = t + "<h3><font color=""#FFFFFF"">GETVAPOR.SPK</font></h3>" + NL
    t = t + "<table width=""100%"" cellpadding=""6""><tr><td bgcolor=""#000000""><pre><font color=""#A4D007""><%= SERVER.HtmlEncode(FS.Read(""C:\WEB\VAPOR\GETVAPOR.TXT"").Replace(""%HOST%"", here)) %></font></pre></td></tr></table>" + NL
    t = t + "<p><font size=""2"" color=""#8F98A0"">Run your own store: any machine where Vapor's INSTALL.SPK ran is one. Keep its shelves stocked" + NL
    t = t + "and up to date with Publish Apps. Half-Life 3 is coming soon.</font></p>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\VAPOR\INDEX.ASP")
END SUB

SUB File3 ()
    t = ""
    t = t + "' VAPOR|id=SIMDOOM|name=SimDOOM|kind=game|version=c0f9cfa6|category=Shooter|run=C:\GAMES\SIMDOOM\SIMDOOM.SPK|files=C:\GAMES\SIMDOOM\SIMDOOM.SPK|tasks=SIMDOOM|startup=|folder=|about=Rip and tear through E1M1 in glorious 16 colours. A real raycast 3D view, imps that chase you, a pistol, health and ammo, a face that watches you, and achievements. Type IDDQD at your own risk." + NL
    t = t + "' SIMDOOM.SPK - SimDOOM, episode one, map one: a raycaster on a GUI_Canvas." + NL
    t = t + "'" + NL
    t = t + "' Walk with the arrow keys (or W A S D), fire with Space or Ctrl, use with" + NL
    t = t + "' E or Enter. Find the green switch to finish the level. Kill everything if" + NL
    t = t + "' you like; Vapor shows the achievements." + NL
    t = t + "'" + NL
    t = t + "' The 3D view is the classic grid raycaster: for each of 80 columns a ray" + NL
    t = t + "' walks the map a square at a time until it hits a wall, and the distance" + NL
    t = t + "' says how tall to draw that slice. Things (imps, health, ammo) are" + NL
    t = t + "' billboards, drawn back to front and clipped by each column's wall distance." + NL
    t = t + "' It draws only when something changes, so a still screen costs nothing." + NL
    t = t + "" + NL
    t = t + "CONST COLS = 80                ' rays: each is 4 pixels of the 320-pixel view" + NL
    t = t + "CONST VIEWH = 160" + NL
    t = t + "CONST HUDH = 40" + NL
    t = t + "CONST MAPW = 16" + NL
    t = t + "CONST MAPH = 16" + NL
    t = t + "CONST ACHFILE = ""C:\GAMES\SIMDOOM\ACHIEVE.TXT""" + NL
    t = t + "" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR screen AS GUI_Canvas" + NL
    t = t + "VAR clock AS GUI_Timer" + NL
    t = t + "VAR map AS Array OF String" + NL
    t = t + "" + NL
    t = t + "' the player" + NL
    t = t + "VAR px AS Real" + NL
    t = t + "VAR py AS Real" + NL
    t = t + "VAR dirX AS Real" + NL
    t = t + "VAR dirY AS Real" + NL
    t = t + "VAR planeX AS Real" + NL
    t = t + "VAR planeY AS Real" + NL
    t = t + "VAR health AS Integer" + NL
    t = t + "VAR ammo AS Integer" + NL
    t = t + "VAR kills AS Integer" + NL
    t = t + "VAR started AS Integer" + NL
    t = t + "VAR hurtUntil AS Integer" + NL
    t = t + "VAR flashUntil AS Integer" + NL
    t = t + "VAR state AS String = ""title""     ' title, play, dead, won" + NL
    t = t + "VAR dirty AS Bool = TRUE" + NL
    t = t + "VAR faceLook AS Integer" + NL
    t = t + "VAR typed AS String                ' the last letters typed, for the cheat codes" + NL
    t = t + "VAR god AS Bool" + NL
    t = t + "VAR warp AS Bool                   ' -warp: start next to the exit, as DOOM's -warp did" + NL
    t = t + "" + NL
    t = t + "' things: imps, health and ammo, by kind (imp, deadimp, health, ammo)" + NL
    t = t + "VAR tKind AS Array OF String" + NL
    t = t + "VAR tX AS Array OF Real" + NL
    t = t + "VAR tY AS Array OF Real" + NL
    t = t + "VAR tHp AS Array OF Integer" + NL
    t = t + "VAR tWake AS Array OF Bool" + NL
    t = t + "VAR tLastHit AS Array OF Integer" + NL
    t = t + "VAR zbuf AS Array OF Real" + NL
    t = t + "VAR lastMove AS Integer" + NL
    t = t + "" + NL
    t = t + "' ================================================================ start" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    win = GUI_Window.New(""SimDOOM"", 320, VIEWH + HUDH)" + NL
    t = t + "    win.Icon = ""app""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    win.onKey = Key" + NL
    t = t + "    screen = GUI_Canvas.New(win)" + NL
    t = t + "    screen.SetBounds(0, 0, 320, VIEWH + HUDH)" + NL
    t = t + "    screen.onKey = Key" + NL
    t = t + "    screen.onDraw = Screen_OnDraw" + NL
    t = t + "    FOR i = 0 TO COLS - 1" + NL
    t = t + "        zbuf.Add(0)" + NL
    t = t + "    NEXT" + NL
    t = t + "    clock = GUI_Timer.New(win)" + NL
    t = t + "    clock.Interval = 60" + NL
    t = t + "    clock.onTick = Clock_OnTick" + NL
    t = t + "    clock.Start()" + NL
    t = t + "    IF SYS.Args.Count > 0 THEN warp = SYS.Args[0].Lower() = ""-warp""" + NL
    t = t + "    win.Show()" + NL
    t = t + "    screen.Focus()" + NL
    t = t + "    DrawTitle()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' E1M1, more or less: # stone, B brick, W wood, X the exit switch," + NL
    t = t + "' P you, I imps, H health, A ammo." + NL
    t = t + "SUB NewGame ()" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    map = [""################"", _" + NL
    t = t + "           ""#P.....#.......#"", _" + NL
    t = t + "           ""#......#...I...#"", _" + NL
    t = t + "           ""#..BB..#.......#"", _" + NL
    t = t + "           ""#..BB.....H....#"", _" + NL
    t = t + "           ""#......#.......#"", _" + NL
    t = t + "           ""####.###WWW.WWW#"", _" + NL
    t = t + "           ""#......#.......#"", _" + NL
    t = t + "           ""#..I...#...I...#"", _" + NL
    t = t + "           ""#......#.......#"", _" + NL
    t = t + "           ""#..A...........#"", _" + NL
    t = t + "           ""#......#####..##"", _" + NL
    t = t + "           ""###.####...I...#"", _" + NL
    t = t + "           ""#..........A...#"", _" + NL
    t = t + "           ""#..I.......#...X"", _" + NL
    t = t + "           ""################""]" + NL
    t = t + "    tKind.Clear()" + NL
    t = t + "    tX.Clear()" + NL
    t = t + "    tY.Clear()" + NL
    t = t + "    tHp.Clear()" + NL
    t = t + "    tWake.Clear()" + NL
    t = t + "    tLastHit.Clear()" + NL
    t = t + "    FOR y = 0 TO MAPH - 1" + NL
    t = t + "        FOR x = 0 TO MAPW - 1" + NL
    t = t + "            c = map[y].CharAt(x)" + NL
    t = t + "            IF c = ""P"" THEN" + NL
    t = t + "                px = x + 0.5" + NL
    t = t + "                py = y + 0.5" + NL
    t = t + "            ELSEIF c = ""I"" OR c = ""H"" OR c = ""A"" THEN" + NL
    t = t + "                tKind.Add(""imp|health|ammo"".Split(""|"")[""IHA"".IndexOf(c)])" + NL
    t = t + "                tX.Add(x + 0.5)" + NL
    t = t + "                tY.Add(y + 0.5)" + NL
    t = t + "                tHp.Add(2)" + NL
    t = t + "                tWake.Add(FALSE)" + NL
    t = t + "                tLastHit.Add(0)" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' facing east, with a 66-degree view" + NL
    t = t + "    dirX = 1" + NL
    t = t + "    dirY = 0" + NL
    t = t + "    planeX = 0" + NL
    t = t + "    planeY = 0.66" + NL
    t = t + "    health = 100" + NL
    t = t + "    ammo = 30" + NL
    t = t + "    kills = 0" + NL
    t = t + "    god = FALSE" + NL
    t = t + "    IF warp THEN" + NL
    t = t + "        px = 14.5" + NL
    t = t + "        py = 14.5" + NL
    t = t + "    END IF" + NL
    t = t + "    started = SYS.Ticks" + NL
    t = t + "    state = ""play""" + NL
    t = t + "    dirty = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Cell (x AS Integer, y AS Integer) AS String" + NL
    t = t + "    IF x < 0 OR y < 0 OR x >= MAPW OR y >= MAPH THEN RETURN ""#""" + NL
    t = t + "    RETURN map[y].CharAt(x)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Solid (x AS Real, y AS Real) AS Bool" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    c = Cell(Int(x), Int(y))" + NL
    t = t + "    RETURN c = ""#"" OR c = ""B"" OR c = ""W"" OR c = ""X""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ keys" + NL
    t = t + "" + NL
    t = t + "SUB Key (k AS String)" + NL
    t = t + "    VAR speed AS Real = 0.25" + NL
    t = t + "    VAR turnBy AS Real = 0.15" + NL
    t = t + "    VAR nx AS Real" + NL
    t = t + "    VAR ny AS Real" + NL
    t = t + "    IF k.Length = 1 THEN" + NL
    t = t + "        typed = (typed + k.Lower())" + NL
    t = t + "        IF typed.Length > 6 THEN typed = typed.Substring(typed.Length - 6, 6)" + NL
    t = t + "        IF typed.EndsWith(""iddqd"") THEN" + NL
    t = t + "            god = NOT god" + NL
    t = t + "            health = 100" + NL
    t = t + "            Achieve(""Cheater"", ""Type IDDQD"")" + NL
    t = t + "        END IF" + NL
    t = t + "        IF typed.EndsWith(""idkfa"") THEN" + NL
    t = t + "            ammo = 200" + NL
    t = t + "            Achieve(""Cheater"", ""Type IDDQD"")" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    IF state = ""title"" OR state = ""dead"" OR state = ""won"" THEN" + NL
    t = t + "        IF k = ""Enter"" OR k = ""Space"" THEN NewGame()" + NL
    t = t + "        IF k = ""Escape"" THEN win.Close()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE k" + NL
    t = t + "        CASE ""ArrowUp"", ""w"", ""W""" + NL
    t = t + "            Walk(dirX * speed, dirY * speed)" + NL
    t = t + "        CASE ""ArrowDown"", ""s"", ""S""" + NL
    t = t + "            Walk(-dirX * speed, -dirY * speed)" + NL
    t = t + "        CASE ""ArrowLeft""" + NL
    t = t + "            Turn(-turnBy)" + NL
    t = t + "        CASE ""ArrowRight""" + NL
    t = t + "            Turn(turnBy)" + NL
    t = t + "        CASE ""a"", ""A""" + NL
    t = t + "            Walk(dirY * speed, -dirX * speed)" + NL
    t = t + "        CASE ""d"", ""D""" + NL
    t = t + "            Walk(-dirY * speed, dirX * speed)" + NL
    t = t + "        CASE ""Space"", ""Ctrl+Control"", ""Control""" + NL
    t = t + "            Fire()" + NL
    t = t + "        CASE ""e"", ""E"", ""Enter""" + NL
    t = t + "            Use()" + NL
    t = t + "        CASE ""Escape""" + NL
    t = t + "            state = ""title""" + NL
    t = t + "            DrawTitle()" + NL
    t = t + "            RETURN" + NL
    t = t + "    END SELECT" + NL
    t = t + "    dirty = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Moves, sliding along walls, and picks things up." + NL
    t = t + "SUB Walk (dx AS Real, dy AS Real)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF NOT Solid(px + dx * 1.6, py) THEN px = px + dx" + NL
    t = t + "    IF NOT Solid(px, py + dy * 1.6) THEN py = py + dy" + NL
    t = t + "    FOR i = 0 TO tKind.Count - 1" + NL
    t = t + "        IF (tKind[i] = ""health"" OR tKind[i] = ""ammo"") AND MATH.Abs(tX[i] - px) < 0.6 AND MATH.Abs(tY[i] - py) < 0.6 THEN" + NL
    t = t + "            IF tKind[i] = ""health"" THEN health = MATH.Min(100, health + 25)" + NL
    t = t + "            IF tKind[i] = ""ammo"" THEN ammo = ammo + 15" + NL
    t = t + "            tKind[i] = ""taken""" + NL
    t = t + "            SYS.Beep(1200, 30)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    faceLook = 0" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Turning is rotating the view direction and the camera plane together." + NL
    t = t + "SUB Turn (a AS Real)" + NL
    t = t + "    VAR ox AS Real" + NL
    t = t + "    ox = dirX" + NL
    t = t + "    dirX = dirX * MATH.Cos(a) - dirY * MATH.Sin(a)" + NL
    t = t + "    dirY = ox * MATH.Sin(a) + dirY * MATH.Cos(a)" + NL
    t = t + "    ox = planeX" + NL
    t = t + "    planeX = planeX * MATH.Cos(a) - planeY * MATH.Sin(a)" + NL
    t = t + "    planeY = ox * MATH.Sin(a) + planeY * MATH.Cos(a)" + NL
    t = t + "    IF a < 0 THEN" + NL
    t = t + "        faceLook = -1" + NL
    t = t + "    ELSE" + NL
    t = t + "        faceLook = 1" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Hitscan: the nearest imp in the middle of the view, nearer than the wall there." + NL
    t = t + "SUB Fire ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR best AS Integer = -1" + NL
    t = t + "    VAR bestD AS Real = 999" + NL
    t = t + "    VAR sx AS Real" + NL
    t = t + "    VAR d AS Real" + NL
    t = t + "    IF ammo <= 0 THEN" + NL
    t = t + "        SYS.Beep(200, 40)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ammo = ammo - 1" + NL
    t = t + "    flashUntil = SYS.Ticks + 120" + NL
    t = t + "    SYS.Beep(150, 25)" + NL
    t = t + "    FOR i = 0 TO tKind.Count - 1" + NL
    t = t + "        IF tKind[i] <> ""imp"" THEN CONTINUE" + NL
    t = t + "        d = Depth(i)" + NL
    t = t + "        IF d <= 0.2 THEN CONTINUE" + NL
    t = t + "        sx = ScreenX(i)" + NL
    t = t + "        IF MATH.Abs(sx - 160) < 140 / d + 6 AND d < zbuf[Int(COLS / 2)] + 0.3 AND d < bestD THEN" + NL
    t = t + "            best = i" + NL
    t = t + "            bestD = d" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF best >= 0 THEN" + NL
    t = t + "        tHp[best] = tHp[best] - 1" + NL
    t = t + "        tWake[best] = TRUE" + NL
    t = t + "        tLastHit[best] = SYS.Ticks" + NL
    t = t + "        IF tHp[best] <= 0 THEN" + NL
    t = t + "            tKind[best] = ""deadimp""" + NL
    t = t + "            kills = kills + 1" + NL
    t = t + "            IF kills = 1 THEN Achieve(""First Blood"", ""Kill your first imp"")" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Use: the switch, if you are facing it close up." + NL
    t = t + "SUB Use ()" + NL
    t = t + "    IF Cell(Int(px + dirX * 0.9), Int(py + dirY * 0.9)) = ""X"" THEN LevelDone()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB LevelDone ()" + NL
    t = t + "    VAR secs AS Integer" + NL
    t = t + "    VAR total AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    state = ""won""" + NL
    t = t + "    win.Tag = ""won|"" + Str(health) + ""|"" + Str(ammo) + ""|"" + Str(kills)" + NL
    t = t + "    secs = Int((SYS.Ticks - started) / 1000)" + NL
    t = t + "    FOR i = 0 TO tKind.Count - 1" + NL
    t = t + "        IF tKind[i] = ""imp"" OR tKind[i] = ""deadimp"" THEN total = total + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    Achieve(""E1M1 Complete"", ""Reach the exit"")" + NL
    t = t + "    IF kills = total THEN Achieve(""Rip and Tear"", ""Kill every imp on E1M1"")" + NL
    t = t + "    IF secs < 60 THEN Achieve(""Speedrunner"", ""Finish E1M1 in under a minute"")" + NL
    t = t + "    IF health = 100 THEN Achieve(""Untouchable"", ""Finish without a scratch"")" + NL
    t = t + "    DrawEnd(""E1M1 COMPLETE"", ""Kills "" + Str(kills) + ""/"" + Str(total) + ""   Time "" + Str(Int(secs / 60)) + "":"" + (""0"" + Str(secs MOD 60)).Substring(Str(secs MOD 60).Length - 1, 2), 10)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' An achievement, for Vapor to show (each one once)." + NL
    t = t + "SUB Achieve (name AS String, how AS String)" + NL
    t = t + "    VAR have AS String" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(ACHFILE) THEN have = FS.Read(ACHFILE)" + NL
    t = t + "        IF have.Contains(name + ""|"") THEN RETURN" + NL
    t = t + "        FS.Append(ACHFILE, name + ""|"" + how + ""|"" + TIME.Date + Chr(10))" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the monsters" + NL
    t = t + "" + NL
    t = t + "SUB Clock_OnTick ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR d AS Real" + NL
    t = t + "    VAR mx AS Real" + NL
    t = t + "    VAR my AS Real" + NL
    t = t + "    IF state <> ""play"" THEN RETURN" + NL
    t = t + "    IF SYS.Ticks - lastMove > 100 THEN" + NL
    t = t + "        lastMove = SYS.Ticks" + NL
    t = t + "        FOR i = 0 TO tKind.Count - 1" + NL
    t = t + "            IF tKind[i] <> ""imp"" THEN CONTINUE" + NL
    t = t + "            d = MATH.Sqrt((tX[i] - px) * (tX[i] - px) + (tY[i] - py) * (tY[i] - py))" + NL
    t = t + "            IF d < 5 THEN tWake[i] = TRUE" + NL
    t = t + "            IF NOT tWake[i] THEN CONTINUE" + NL
    t = t + "            IF d > 0.9 THEN" + NL
    t = t + "                mx = (px - tX[i]) / d * 0.06" + NL
    t = t + "                my = (py - tY[i]) / d * 0.06" + NL
    t = t + "                IF NOT Solid(tX[i] + mx, tY[i]) THEN tX[i] = tX[i] + mx" + NL
    t = t + "                IF NOT Solid(tX[i], tY[i] + my) THEN tY[i] = tY[i] + my" + NL
    t = t + "                dirty = TRUE" + NL
    t = t + "            ELSEIF SYS.Ticks - tLastHit[i] > 700 THEN" + NL
    t = t + "                ' a swipe of claws" + NL
    t = t + "                tLastHit[i] = SYS.Ticks" + NL
    t = t + "                IF NOT god THEN health = health - 8 - Rnd(5)" + NL
    t = t + "                hurtUntil = SYS.Ticks + 200" + NL
    t = t + "                SYS.Beep(90, 40)" + NL
    t = t + "                dirty = TRUE" + NL
    t = t + "                IF health <= 0 THEN" + NL
    t = t + "                    health = 0" + NL
    t = t + "                    state = ""dead""" + NL
    t = t + "                    win.Tag = ""dead|0|"" + Str(ammo) + ""|"" + Str(kills)" + NL
    t = t + "                    DrawEnd(""YOU ARE DEAD"", ""Press Space to try again"", 9)" + NL
    t = t + "                    RETURN" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    IF flashUntil > 0 AND SYS.Ticks > flashUntil THEN" + NL
    t = t + "        flashUntil = 0" + NL
    t = t + "        dirty = TRUE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF hurtUntil > 0 AND SYS.Ticks > hurtUntil THEN" + NL
    t = t + "        hurtUntil = 0" + NL
    t = t + "        dirty = TRUE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF dirty THEN Render()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ drawing" + NL
    t = t + "" + NL
    t = t + "SUB Screen_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    IF state = ""play"" THEN" + NL
    t = t + "        dirty = TRUE" + NL
    t = t + "        Render()" + NL
    t = t + "    ELSEIF state = ""title"" THEN" + NL
    t = t + "        DrawTitle()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where a thing is in camera space: its depth, and its x on the screen." + NL
    t = t + "FUNCTION Depth (i AS Integer) AS Real" + NL
    t = t + "    VAR sx AS Real" + NL
    t = t + "    VAR sy AS Real" + NL
    t = t + "    VAR inv AS Real" + NL
    t = t + "    sx = tX[i] - px" + NL
    t = t + "    sy = tY[i] - py" + NL
    t = t + "    inv = 1.0 / (planeX * dirY - dirX * planeY)" + NL
    t = t + "    RETURN inv * (-planeY * sx + planeX * sy)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ScreenX (i AS Integer) AS Real" + NL
    t = t + "    VAR sx AS Real" + NL
    t = t + "    VAR sy AS Real" + NL
    t = t + "    VAR inv AS Real" + NL
    t = t + "    VAR across AS Real" + NL
    t = t + "    sx = tX[i] - px" + NL
    t = t + "    sy = tY[i] - py" + NL
    t = t + "    inv = 1.0 / (planeX * dirY - dirX * planeY)" + NL
    t = t + "    across = inv * (dirY * sx - dirX * sy)" + NL
    t = t + "    RETURN 160 * (1 + across / Depth(i))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Render ()" + NL
    t = t + "    dirty = FALSE" + NL
    t = t + "    ' (what is going on, for anybody looking: state|health|ammo|kills|x|y)" + NL
    t = t + "    win.Tag = state + ""|"" + Str(health) + ""|"" + Str(ammo) + ""|"" + Str(kills) + ""|"" + Str(Int(px * 10)) + ""|"" + Str(Int(py * 10))" + NL
    t = t + "    screen.Clear()" + NL
    t = t + "    ' ceiling and floor" + NL
    t = t + "    screen.SetColor(0)" + NL
    t = t + "    screen.FillRect(0, 0, 320, VIEWH / 2)" + NL
    t = t + "    screen.SetColor(8)" + NL
    t = t + "    screen.FillRect(0, VIEWH / 2, 320, VIEWH / 2)" + NL
    t = t + "    Walls()" + NL
    t = t + "    Things()" + NL
    t = t + "    Gun()" + NL
    t = t + "    IF hurtUntil > 0 THEN" + NL
    t = t + "        ' a red edge when an imp gets you" + NL
    t = t + "        screen.SetColor(9)" + NL
    t = t + "        screen.Rect(0, 0, 320, VIEWH)" + NL
    t = t + "        screen.Rect(1, 1, 318, VIEWH - 2)" + NL
    t = t + "        screen.Rect(2, 2, 316, VIEWH - 4)" + NL
    t = t + "    END IF" + NL
    t = t + "    Hud()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Walls ()" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR camX AS Real" + NL
    t = t + "    VAR rx AS Real" + NL
    t = t + "    VAR ry AS Real" + NL
    t = t + "    VAR mapX AS Integer" + NL
    t = t + "    VAR mapY AS Integer" + NL
    t = t + "    VAR ddx AS Real" + NL
    t = t + "    VAR ddy AS Real" + NL
    t = t + "    VAR sdx AS Real" + NL
    t = t + "    VAR sdy AS Real" + NL
    t = t + "    VAR stepX AS Integer" + NL
    t = t + "    VAR stepY AS Integer" + NL
    t = t + "    VAR side AS Integer" + NL
    t = t + "    VAR hit AS String" + NL
    t = t + "    VAR dist AS Real" + NL
    t = t + "    VAR h AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    FOR c = 0 TO COLS - 1" + NL
    t = t + "        camX = 2 * c / COLS - 1" + NL
    t = t + "        rx = dirX + planeX * camX" + NL
    t = t + "        ry = dirY + planeY * camX" + NL
    t = t + "        mapX = Int(px)" + NL
    t = t + "        mapY = Int(py)" + NL
    t = t + "        ddx = 1E30" + NL
    t = t + "        ddy = 1E30" + NL
    t = t + "        IF rx <> 0 THEN ddx = MATH.Abs(1 / rx)" + NL
    t = t + "        IF ry <> 0 THEN ddy = MATH.Abs(1 / ry)" + NL
    t = t + "        IF rx < 0 THEN" + NL
    t = t + "            stepX = -1" + NL
    t = t + "            sdx = (px - mapX) * ddx" + NL
    t = t + "        ELSE" + NL
    t = t + "            stepX = 1" + NL
    t = t + "            sdx = (mapX + 1 - px) * ddx" + NL
    t = t + "        END IF" + NL
    t = t + "        IF ry < 0 THEN" + NL
    t = t + "            stepY = -1" + NL
    t = t + "            sdy = (py - mapY) * ddy" + NL
    t = t + "        ELSE" + NL
    t = t + "            stepY = 1" + NL
    t = t + "            sdy = (mapY + 1 - py) * ddy" + NL
    t = t + "        END IF" + NL
    t = t + "        hit = "".""" + NL
    t = t + "        n = 0" + NL
    t = t + "        WHILE hit = ""."" AND n < 40" + NL
    t = t + "            IF sdx < sdy THEN" + NL
    t = t + "                sdx = sdx + ddx" + NL
    t = t + "                mapX = mapX + stepX" + NL
    t = t + "                side = 0" + NL
    t = t + "            ELSE" + NL
    t = t + "                sdy = sdy + ddy" + NL
    t = t + "                mapY = mapY + stepY" + NL
    t = t + "                side = 1" + NL
    t = t + "            END IF" + NL
    t = t + "            hit = Cell(mapX, mapY)" + NL
    t = t + "            IF hit = ""P"" OR hit = ""I"" OR hit = ""H"" OR hit = ""A"" THEN hit = "".""" + NL
    t = t + "            n = n + 1" + NL
    t = t + "        END WHILE" + NL
    t = t + "        IF side = 0 THEN" + NL
    t = t + "            dist = sdx - ddx" + NL
    t = t + "        ELSE" + NL
    t = t + "            dist = sdy - ddy" + NL
    t = t + "        END IF" + NL
    t = t + "        IF dist < 0.05 THEN dist = 0.05" + NL
    t = t + "        zbuf[c] = dist" + NL
    t = t + "        h = Int(VIEWH / dist)" + NL
    t = t + "        IF h > VIEWH THEN h = VIEWH" + NL
    t = t + "        screen.SetColor(WallColour(hit, side, dist))" + NL
    t = t + "        screen.FillRect(c * 4, Int((VIEWH - h) / 2), 4, h)" + NL
    t = t + "        IF hit = ""X"" AND dist < 6 THEN" + NL
    t = t + "            ' the switch's lever" + NL
    t = t + "            screen.SetColor(15)" + NL
    t = t + "            screen.FillRect(c * 4 + 1, Int(VIEWH / 2 - h / 8), 2, Int(h / 4) + 1)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    Put("C:\WEB\VAPOR\SIMDOOM\1.TXT")
END SUB

SUB File4 ()
    t = ""
    t = t + "' Light and dark sides, and darker far away: all in 16 colours." + NL
    t = t + "FUNCTION WallColour (kind AS String, side AS Integer, dist AS Real) AS Integer" + NL
    t = t + "    VAR far AS Bool" + NL
    t = t + "    far = dist > 5" + NL
    t = t + "    SELECT CASE kind" + NL
    t = t + "        CASE ""B""" + NL
    t = t + "            IF side = 1 OR far THEN RETURN 1" + NL
    t = t + "            RETURN 9" + NL
    t = t + "        CASE ""W""" + NL
    t = t + "            IF side = 1 OR far THEN RETURN 3" + NL
    t = t + "            RETURN 11" + NL
    t = t + "        CASE ""X""" + NL
    t = t + "            IF side = 1 OR far THEN RETURN 2" + NL
    t = t + "            RETURN 10" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF far AND side = 1 THEN RETURN 0" + NL
    t = t + "    IF side = 1 OR far THEN RETURN 8" + NL
    t = t + "    RETURN 7" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Things, far ones first, cut off column by column behind walls." + NL
    t = t + "SUB Things ()" + NL
    t = t + "    VAR order AS Array OF Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR t AS Integer" + NL
    t = t + "    VAR d AS Real" + NL
    t = t + "    VAR sx AS Real" + NL
    t = t + "    VAR size AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR c0 AS Integer" + NL
    t = t + "    VAR c1 AS Integer" + NL
    t = t + "    VAR top AS Integer" + NL
    t = t + "    FOR i = 0 TO tKind.Count - 1" + NL
    t = t + "        IF tKind[i] <> ""taken"" THEN order.Add(i)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR i = 0 TO order.Count - 2" + NL
    t = t + "        FOR j = i + 1 TO order.Count - 1" + NL
    t = t + "            IF Depth(order[j]) > Depth(order[i]) THEN" + NL
    t = t + "                t = order[i]" + NL
    t = t + "                order[i] = order[j]" + NL
    t = t + "                order[j] = t" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH i IN order" + NL
    t = t + "        d = Depth(i)" + NL
    t = t + "        IF d < 0.2 THEN CONTINUE" + NL
    t = t + "        sx = ScreenX(i)" + NL
    t = t + "        size = Int(VIEWH / d)" + NL
    t = t + "        c0 = Int((sx - size / 2) / 4)" + NL
    t = t + "        c1 = Int((sx + size / 2) / 4)" + NL
    t = t + "        FOR c = MATH.Max(0, c0) TO MATH.Min(COLS - 1, c1)" + NL
    t = t + "            IF d >= zbuf[c] THEN CONTINUE" + NL
    t = t + "            top = Int(VIEWH / 2 + size / 2)" + NL
    t = t + "            ThingSlice(tKind[i], c, c - c0, c1 - c0 + 1, top, size, SYS.Ticks - tLastHit[i] < 120)" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One 4-pixel column of a thing: u is which column of it, of w; it stands on y." + NL
    t = t + "SUB ThingSlice (kind AS String, c AS Integer, u AS Integer, w AS Integer, y AS Integer, size AS Integer, hurt AS Bool)" + NL
    t = t + "    VAR f AS Real" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    x = c * 4" + NL
    t = t + "    f = (u + 0.5) / w" + NL
    t = t + "    SELECT CASE kind" + NL
    t = t + "        CASE ""imp""" + NL
    t = t + "            ' a brown body, broader at the shoulders, red eyes, white when hit" + NL
    t = t + "            IF f < 0.15 OR f > 0.85 THEN" + NL
    t = t + "                ' arms" + NL
    t = t + "                screen.SetColor(Pick(hurt, 15, 1))" + NL
    t = t + "                screen.FillRect(x, y - Int(size * 0.65), 4, Int(size * 0.35))" + NL
    t = t + "            ELSE" + NL
    t = t + "                screen.SetColor(Pick(hurt, 15, 3))" + NL
    t = t + "                screen.FillRect(x, y - Int(size * 0.8), 4, Int(size * 0.5))" + NL
    t = t + "                screen.SetColor(Pick(hurt, 15, 1))" + NL
    t = t + "                screen.FillRect(x, y - Int(size * 0.3), 4, Int(size * 0.3))" + NL
    t = t + "                IF (f > 0.3 AND f < 0.42) OR (f > 0.58 AND f < 0.7) THEN" + NL
    t = t + "                    screen.SetColor(9)" + NL
    t = t + "                    screen.FillRect(x, y - Int(size * 0.72), 4, MATH.Max(2, Int(size * 0.06)))" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""deadimp""" + NL
    t = t + "            screen.SetColor(1)" + NL
    t = t + "            screen.FillRect(x, y - Int(size * 0.08), 4, MATH.Max(2, Int(size * 0.08)))" + NL
    t = t + "        CASE ""health""" + NL
    t = t + "            IF f > 0.25 AND f < 0.75 THEN" + NL
    t = t + "                screen.SetColor(15)" + NL
    t = t + "                screen.FillRect(x, y - Int(size * 0.3), 4, Int(size * 0.3))" + NL
    t = t + "                IF f > 0.42 AND f < 0.58 THEN" + NL
    t = t + "                    screen.SetColor(9)" + NL
    t = t + "                    screen.FillRect(x, y - Int(size * 0.27), 4, Int(size * 0.24))" + NL
    t = t + "                ELSE" + NL
    t = t + "                    screen.SetColor(9)" + NL
    t = t + "                    screen.FillRect(x, y - Int(size * 0.18), 4, MATH.Max(1, Int(size * 0.06)))" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""ammo""" + NL
    t = t + "            IF f > 0.3 AND f < 0.7 THEN" + NL
    t = t + "                screen.SetColor(11)" + NL
    t = t + "                screen.FillRect(x, y - Int(size * 0.2), 4, Int(size * 0.2))" + NL
    t = t + "            END IF" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Pick (yes AS Bool, a AS Integer, b AS Integer) AS Integer" + NL
    t = t + "    IF yes THEN RETURN a" + NL
    t = t + "    RETURN b" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Gun ()" + NL
    t = t + "    ' the pistol, and its flash" + NL
    t = t + "    IF flashUntil > 0 THEN" + NL
    t = t + "        screen.SetColor(11)" + NL
    t = t + "        screen.FillCircle(160, VIEWH - 44, 10)" + NL
    t = t + "        screen.SetColor(15)" + NL
    t = t + "        screen.FillCircle(160, VIEWH - 44, 5)" + NL
    t = t + "    END IF" + NL
    t = t + "    screen.SetColor(8)" + NL
    t = t + "    screen.FillRect(152, VIEWH - 36, 16, 36)" + NL
    t = t + "    screen.SetColor(7)" + NL
    t = t + "    screen.FillRect(155, VIEWH - 36, 4, 30)" + NL
    t = t + "    screen.SetColor(0)" + NL
    t = t + "    screen.FillRect(157, VIEWH - 38, 6, 4)" + NL
    t = t + "    ' the hand" + NL
    t = t + "    screen.SetColor(11)" + NL
    t = t + "    screen.FillRect(146, VIEWH - 16, 28, 16)" + NL
    t = t + "    ' crosshair" + NL
    t = t + "    screen.SetColor(10)" + NL
    t = t + "    screen.Pixel(160, VIEWH / 2)" + NL
    t = t + "    screen.Line(156, VIEWH / 2, 158, VIEWH / 2)" + NL
    t = t + "    screen.Line(162, VIEWH / 2, 164, VIEWH / 2)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The status bar: ammo, the face, health, and the level." + NL
    t = t + "SUB Hud ()" + NL
    t = t + "    screen.SetColor(8)" + NL
    t = t + "    screen.FillRect(0, VIEWH, 320, HUDH)" + NL
    t = t + "    screen.SetColor(7)" + NL
    t = t + "    screen.Line(0, VIEWH, 320, VIEWH)" + NL
    t = t + "    screen.SetColor(0)" + NL
    t = t + "    screen.FillRect(4, VIEWH + 4, 80, 32)" + NL
    t = t + "    screen.FillRect(236, VIEWH + 4, 80, 32)" + NL
    t = t + "    screen.SetColor(9)" + NL
    t = t + "    screen.Text(10, VIEWH + 6, (""  "" + Str(ammo)).Substring(Str(ammo).Length, 3))" + NL
    t = t + "    screen.Text(242, VIEWH + 6, (""  "" + Str(health)).Substring(Str(health).Length, 3) + ""%"")" + NL
    t = t + "    screen.SetColor(7)" + NL
    t = t + "    screen.Text(46, VIEWH + 20, ""AMMO"")" + NL
    t = t + "    screen.Text(254, VIEWH + 20, ""HLTH"")" + NL
    t = t + "    screen.Text(96, VIEWH + 12, ""E1M1"")" + NL
    t = t + "    screen.Text(178, VIEWH + 12, Str(kills) + ""K"")" + NL
    t = t + "    Face(160, VIEWH + 20)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The face in the middle, who looks the way you turn and fares as you do." + NL
    t = t + "SUB Face (cx AS Integer, cy AS Integer)" + NL
    t = t + "    VAR look AS Integer" + NL
    t = t + "    screen.SetColor(0)" + NL
    t = t + "    screen.FillRect(cx - 18, cy - 17, 36, 34)" + NL
    t = t + "    screen.SetColor(11)" + NL
    t = t + "    screen.FillCircle(cx, cy, 14)" + NL
    t = t + "    screen.SetColor(3)" + NL
    t = t + "    screen.FillRect(cx - 12, cy - 15, 24, 5)" + NL
    t = t + "    look = faceLook * 2" + NL
    t = t + "    screen.SetColor(15)" + NL
    t = t + "    screen.FillRect(cx - 9, cy - 5, 6, 4)" + NL
    t = t + "    screen.FillRect(cx + 3, cy - 5, 6, 4)" + NL
    t = t + "    screen.SetColor(0)" + NL
    t = t + "    screen.FillRect(cx - 7 + look, cy - 5, 2, 4)" + NL
    t = t + "    screen.FillRect(cx + 5 + look, cy - 5, 2, 4)" + NL
    t = t + "    IF hurtUntil > 0 OR health < 40 THEN" + NL
    t = t + "        ' a grimace, and blood when it is bad" + NL
    t = t + "        screen.SetColor(15)" + NL
    t = t + "        screen.FillRect(cx - 7, cy + 5, 14, 4)" + NL
    t = t + "        screen.SetColor(0)" + NL
    t = t + "        screen.Line(cx - 7, cy + 7, cx + 7, cy + 7)" + NL
    t = t + "        IF health < 40 THEN" + NL
    t = t + "            screen.SetColor(9)" + NL
    t = t + "            screen.FillRect(cx + 4, cy - 12, 3, 10)" + NL
    t = t + "            screen.FillRect(cx - 10, cy + 2, 3, 6)" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSE" + NL
    t = t + "        screen.SetColor(1)" + NL
    t = t + "        screen.Line(cx - 5, cy + 7, cx + 5, cy + 7)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawTitle ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    screen.Clear()" + NL
    t = t + "    screen.SetColor(0)" + NL
    t = t + "    screen.FillRect(0, 0, 320, VIEWH + HUDH)" + NL
    t = t + "    ' flames along the bottom" + NL
    t = t + "    FOR i = 0 TO 39" + NL
    t = t + "        screen.SetColor(Pick(i MOD 2 = 0, 9, 1))" + NL
    t = t + "        screen.FillRect(i * 8, VIEWH + HUDH - 20 - Rnd(30), 8, 60)" + NL
    t = t + "        screen.SetColor(11)" + NL
    t = t + "        screen.FillRect(i * 8 + 2, VIEWH + HUDH - 8 - Rnd(10), 4, 20)" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' the logo: big blocky red letters with a shadow" + NL
    t = t + "    BigWord(""SIMDOOM"", 34, 40, 1)" + NL
    t = t + "    BigWord(""SIMDOOM"", 32, 38, 9)" + NL
    t = t + "    screen.SetColor(7)" + NL
    t = t + "    screen.Text(84, 104, ""EPISODE ONE"")" + NL
    t = t + "    screen.SetColor(15)" + NL
    t = t + "    screen.Text(48, 130, ""PRESS ENTER TO START"")" + NL
    t = t + "    screen.SetColor(8)" + NL
    t = t + "    screen.Text(4, 4, ""Arrows/WASD move  Space fire  E use"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawEnd (title AS String, line AS String, colour AS Integer)" + NL
    t = t + "    screen.SetColor(0)" + NL
    t = t + "    screen.FillRect(30, 40, 260, 80)" + NL
    t = t + "    screen.SetColor(colour)" + NL
    t = t + "    screen.Rect(30, 40, 260, 80)" + NL
    t = t + "    screen.Text(160 - title.Length * 5, 54, title)" + NL
    t = t + "    screen.SetColor(15)" + NL
    t = t + "    screen.Text(160 - line.Length * 5, 80, line)" + NL
    t = t + "    screen.SetColor(7)" + NL
    t = t + "    screen.Text(70, 100, ""SPACE: PLAY AGAIN"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Letters made of blocks, 5 by 7, each block 5 pixels." + NL
    t = t + "SUB BigWord (word AS String, x AS Integer, y AS Integer, colour AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR r AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR rows AS Array OF String" + NL
    t = t + "    screen.SetColor(colour)" + NL
    t = t + "    FOR i = 0 TO word.Length - 1" + NL
    t = t + "        rows = BigGlyph(word.CharAt(i)).Split(""|"")" + NL
    t = t + "        FOR r = 0 TO 6" + NL
    t = t + "            FOR k = 0 TO 4" + NL
    t = t + "                IF rows[r].CharAt(k) = ""#"" THEN screen.FillRect(x + i * 37 + k * 6, y + r * 7, 6, 7)" + NL
    t = t + "            NEXT" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION BigGlyph (c AS String) AS String" + NL
    t = t + "    SELECT CASE c" + NL
    t = t + "        CASE ""S""" + NL
    t = t + "            RETURN ""#####|#....|#....|#####|....#|....#|#####""" + NL
    t = t + "        CASE ""I""" + NL
    t = t + "            RETURN ""#####|..#..|..#..|..#..|..#..|..#..|#####""" + NL
    t = t + "        CASE ""M""" + NL
    t = t + "            RETURN ""#...#|##.##|#.#.#|#.#.#|#...#|#...#|#...#""" + NL
    t = t + "        CASE ""D""" + NL
    t = t + "            RETURN ""####.|#...#|#...#|#...#|#...#|#...#|####.""" + NL
    t = t + "        CASE ""O""" + NL
    t = t + "            RETURN ""#####|#...#|#...#|#...#|#...#|#...#|#####""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN "".....|.....|.....|.....|.....|.....|.....""" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\WEB\VAPOR\SIMDOOM\2.TXT")
END SUB

SUB File5 ()
    t = ""
    t = t + "' VAPOR|id=SNAKE|name=Snake 95|kind=game|version=aa5d9aeb|category=Arcade|run=C:\GAMES\SNAKE\SNAKE.SPK|files=C:\GAMES\SNAKE\SNAKE.SPK|tasks=SNAKE|startup=|folder=|about=Eat the dots. Grow longer. Don't eat yourself. The game that sold a million phones, now on SIM95." + NL
    t = t + "' SNAKE.SPK - Snake 95. Eat the dots; don't eat yourself." + NL
    t = t + "' Arrow keys steer, Space pauses. The best score is kept for Vapor to show." + NL
    t = t + "" + NL
    t = t + "CONST CELL = 12" + NL
    t = t + "CONST GW = 26" + NL
    t = t + "CONST GH = 18" + NL
    t = t + "CONST BESTFILE = ""C:\GAMES\SNAKE\BEST.TXT""" + NL
    t = t + "CONST ACHFILE = ""C:\GAMES\SNAKE\ACHIEVE.TXT""" + NL
    t = t + "" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR board AS GUI_Canvas" + NL
    t = t + "VAR clock AS GUI_Timer" + NL
    t = t + "VAR bodyX AS Array OF Integer" + NL
    t = t + "VAR bodyY AS Array OF Integer" + NL
    t = t + "VAR dx AS Integer = 1" + NL
    t = t + "VAR dy AS Integer" + NL
    t = t + "VAR nextDx AS Integer = 1" + NL
    t = t + "VAR nextDy AS Integer" + NL
    t = t + "VAR foodX AS Integer" + NL
    t = t + "VAR foodY AS Integer" + NL
    t = t + "VAR score AS Integer" + NL
    t = t + "VAR state AS String = ""title""" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    win = GUI_Window.New(""Snake 95"", GW * CELL, GH * CELL + 20)" + NL
    t = t + "    win.Icon = ""app""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    win.onKey = Key" + NL
    t = t + "    board = GUI_Canvas.New(win)" + NL
    t = t + "    board.SetBounds(0, 0, GW * CELL, GH * CELL + 20)" + NL
    t = t + "    board.onKey = Key" + NL
    t = t + "    board.onDraw = Board_OnDraw" + NL
    t = t + "    clock = GUI_Timer.New(win)" + NL
    t = t + "    clock.Interval = 110" + NL
    t = t + "    clock.onTick = Clock_OnTick" + NL
    t = t + "    clock.Start()" + NL
    t = t + "    win.Show()" + NL
    t = t + "    board.Focus()" + NL
    t = t + "    Draw()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB NewGame ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    bodyX.Clear()" + NL
    t = t + "    bodyY.Clear()" + NL
    t = t + "    FOR i = 0 TO 3" + NL
    t = t + "        bodyX.Add(8 - i)" + NL
    t = t + "        bodyY.Add(9)" + NL
    t = t + "    NEXT" + NL
    t = t + "    dx = 1" + NL
    t = t + "    dy = 0" + NL
    t = t + "    nextDx = 1" + NL
    t = t + "    nextDy = 0" + NL
    t = t + "    score = 0" + NL
    t = t + "    Food()" + NL
    t = t + "    state = ""play""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Food ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR clash AS Bool = TRUE" + NL
    t = t + "    WHILE clash" + NL
    t = t + "        foodX = Rnd(GW)" + NL
    t = t + "        foodY = Rnd(GH)" + NL
    t = t + "        clash = FALSE" + NL
    t = t + "        FOR i = 0 TO bodyX.Count - 1" + NL
    t = t + "            IF bodyX[i] = foodX AND bodyY[i] = foodY THEN clash = TRUE" + NL
    t = t + "        NEXT" + NL
    t = t + "    END WHILE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Key (k AS String)" + NL
    t = t + "    IF state <> ""play"" THEN" + NL
    t = t + "        IF k = ""Enter"" OR k = ""Space"" THEN" + NL
    t = t + "            IF state = ""paused"" THEN" + NL
    t = t + "                state = ""play""" + NL
    t = t + "            ELSE" + NL
    t = t + "                NewGame()" + NL
    t = t + "            END IF" + NL
    t = t + "            Draw()" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE k" + NL
    t = t + "        CASE ""ArrowUp""" + NL
    t = t + "            IF dy = 0 THEN" + NL
    t = t + "                nextDx = 0" + NL
    t = t + "                nextDy = -1" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""ArrowDown""" + NL
    t = t + "            IF dy = 0 THEN" + NL
    t = t + "                nextDx = 0" + NL
    t = t + "                nextDy = 1" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""ArrowLeft""" + NL
    t = t + "            IF dx = 0 THEN" + NL
    t = t + "                nextDx = -1" + NL
    t = t + "                nextDy = 0" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""ArrowRight""" + NL
    t = t + "            IF dx = 0 THEN" + NL
    t = t + "                nextDx = 1" + NL
    t = t + "                nextDy = 0" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Space""" + NL
    t = t + "            state = ""paused""" + NL
    t = t + "            Draw()" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Clock_OnTick ()" + NL
    t = t + "    VAR hx AS Integer" + NL
    t = t + "    VAR hy AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF state <> ""play"" THEN RETURN" + NL
    t = t + "    dx = nextDx" + NL
    t = t + "    dy = nextDy" + NL
    t = t + "    hx = bodyX[0] + dx" + NL
    t = t + "    hy = bodyY[0] + dy" + NL
    t = t + "    IF hx < 0 OR hy < 0 OR hx >= GW OR hy >= GH THEN" + NL
    t = t + "        GameOver()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 0 TO bodyX.Count - 2" + NL
    t = t + "        IF bodyX[i] = hx AND bodyY[i] = hy THEN" + NL
    t = t + "            GameOver()" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    bodyX.Insert(0, hx)" + NL
    t = t + "    bodyY.Insert(0, hy)" + NL
    t = t + "    IF hx = foodX AND hy = foodY THEN" + NL
    t = t + "        score = score + 10" + NL
    t = t + "        SYS.Beep(1000, 20)" + NL
    t = t + "        IF score = 100 THEN Achieve(""Hungry"", ""Score 100"")" + NL
    t = t + "        IF score = 300 THEN Achieve(""Long Boi"", ""Score 300"")" + NL
    t = t + "        Food()" + NL
    t = t + "    ELSE" + NL
    t = t + "        bodyX.RemoveAt(bodyX.Count - 1)" + NL
    t = t + "        bodyY.RemoveAt(bodyY.Count - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    Draw()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB GameOver ()" + NL
    t = t + "    state = ""over""" + NL
    t = t + "    SYS.Beep(120, 200)" + NL
    t = t + "    IF score > Best() THEN" + NL
    t = t + "        TRY" + NL
    t = t + "            FS.Write(BESTFILE, Str(score))" + NL
    t = t + "        CATCH err" + NL
    t = t + "        END TRY" + NL
    t = t + "    END IF" + NL
    t = t + "    Achieve(""Ouroboros"", ""Lose a game of Snake"")" + NL
    t = t + "    Draw()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Best () AS Integer" + NL
    t = t + "    IF FS.Exists(BESTFILE) THEN RETURN Int(Val(FS.Read(BESTFILE)))" + NL
    t = t + "    RETURN 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Achieve (name AS String, how AS String)" + NL
    t = t + "    VAR have AS String" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(ACHFILE) THEN have = FS.Read(ACHFILE)" + NL
    t = t + "        IF have.Contains(name + ""|"") THEN RETURN" + NL
    t = t + "        FS.Append(ACHFILE, name + ""|"" + how + ""|"" + TIME.Date + Chr(10))" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Board_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    Draw()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Draw ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    board.Clear()" + NL
    t = t + "    board.SetColor(0)" + NL
    t = t + "    board.FillRect(0, 0, GW * CELL, GH * CELL)" + NL
    t = t + "    IF state = ""title"" THEN" + NL
    t = t + "        board.SetColor(10)" + NL
    t = t + "        board.Text(100, 70, ""SNAKE 95"")" + NL
    t = t + "        board.SetColor(7)" + NL
    t = t + "        board.Text(40, 110, ""PRESS ENTER TO PLAY"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        board.SetColor(9)" + NL
    t = t + "        board.FillCircle(foodX * CELL + 6, foodY * CELL + 6, 5)" + NL
    t = t + "        FOR i = bodyX.Count - 1 TO 0 STEP -1" + NL
    t = t + "            IF i = 0 THEN" + NL
    t = t + "                board.SetColor(10)" + NL
    t = t + "            ELSE" + NL
    t = t + "                board.SetColor(2)" + NL
    t = t + "            END IF" + NL
    t = t + "            board.FillRect(bodyX[i] * CELL + 1, bodyY[i] * CELL + 1, CELL - 2, CELL - 2)" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF state = ""over"" THEN" + NL
    t = t + "            board.SetColor(15)" + NL
    t = t + "            board.Text(90, 90, ""GAME OVER"")" + NL
    t = t + "            board.Text(40, 120, ""ENTER TO PLAY AGAIN"")" + NL
    t = t + "        ELSEIF state = ""paused"" THEN" + NL
    t = t + "            board.SetColor(15)" + NL
    t = t + "            board.Text(120, 100, ""PAUSED"")" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    board.SetColor(8)" + NL
    t = t + "    board.FillRect(0, GH * CELL, GW * CELL, 20)" + NL
    t = t + "    board.SetColor(15)" + NL
    t = t + "    board.Text(4, GH * CELL + 2, ""SCORE "" + Str(score) + ""   BEST "" + Str(MATH.Max(score, Best())))" + NL
    t = t + "    win.Tag = state + ""|"" + Str(score)" + NL
    t = t + "END SUB" + NL
    Put("C:\WEB\VAPOR\SNAKE\1.TXT")
END SUB

SUB File6 ()
    t = ""
    t = t + "' VAPOR|id=SIMPLAYR|name=SimPlayer|kind=program|version=68f17303|category=Multimedia|run=C:\PROGRAMS\PLAYER.SPK|files=C:\PROGRAMS\PLAYER.SPK|tasks=PLAYER|startup=|folder=|about=The movie player for SIM95: plays SimMovies from the disk or streams them from the web, like the ones on SimTube. (Simxplorer has it built in.)" + NL
    t = t + "' INSTALL.SPK - puts SimPlayer on this machine. Generated by tools/build-installer.mjs;" + NL
    t = t + "' edit the files in simplayer/ and rebuild rather than editing this." + NL
    t = t + "'" + NL
    t = t + "' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It writes" + NL
    t = t + "' SimPlayer, the movie player, to C:\PROGRAMS\PLAYER.SPK and starts it. It plays" + NL
    t = t + "' SimMovies (.SMV) from the disk, or streams them from a web address such as" + NL
    t = t + "' a SimTube movie's. Simxplorer has SimPlayer built in; this is the same" + NL
    t = t + "' player on its own, for Voyager users and for movies on the disk." + NL
    t = t + "" + NL
    t = t + "VAR t AS String" + NL
    t = t + "VAR NL AS String" + NL
    t = t + "VAR intoDir AS String   ' """" for the web root, or the folder this web app goes in" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    NL = Chr(10)" + NL
    t = t + "" + NL
    t = t + "" + NL
    t = t + "" + NL
    t = t + "" + NL
    t = t + "    File0()" + NL
    t = t + "    Print(""SimPlayer is installed (1 files)."")" + NL
    t = t + "    SYS.Start(""C:\PROGRAMS\PLAYER.SPK"", """")" + NL
    t = t + "" + NL
    t = t + "    Print(""SimPlayer is running. Next time, start C:\PROGRAMS\PLAYER.SPK from Files, or give it a movie's address."")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where a file goes: in this web app's folder, on a machine that keeps them in folders." + NL
    t = t + "FUNCTION Dest (path AS String) AS String" + NL
    t = t + "    IF intoDir <> """" AND path.Upper().StartsWith(""C:\WEB\"") THEN RETURN ""C:\WEB\"" + intoDir + ""\"" + path.Substring(7, path.Length - 7)" + NL
    t = t + "    RETURN path" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Put (path AS String)" + NL
    t = t + "    FS.Write(Dest(path), t)" + NL
    t = t + "    Print(""  wrote "" + Dest(path))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB File0 ()" + NL
    t = t + "    t = """"" + NL
    t = t + "    t = t + ""' PLAYER.SPK - SimPlayer, the movie player for SIM95. Plays SimMovies (.SMV)"" + NL" + NL
    t = t + "    t = t + ""' from this disk or from the web, such as the ones on SimTube."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""'   SPARK C:\PROGRAMS\PLAYER.SPK C:\MYFILES\DANCE.SMV"" + NL" + NL
    t = t + "    t = t + ""'   SPARK C:\PROGRAMS\PLAYER.SPK http://alpha/tube/movie.asp?v=2"" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' A SimMovie is text: a header, then one line per frame of drawing commands"" + NL" + NL
    t = t + "    t = t + ""' for a GUI_Canvas (see simtube/README.md). A long one is cut into parts of"" + NL" + NL
    t = t + "    t = t + ""' about 15K, each small enough for one network message, and a manifest"" + NL" + NL
    t = t + "    t = t + ""' (it starts """"SIMMOVIE-PARTS 1"""") says where the parts are. SimPlayer fetches"" + NL" + NL
    t = t + "    t = t + ""' the parts one at a time and starts playing as soon as it has a few seconds"" + NL" + NL
    t = t + "    t = t + ""' in hand, like the streaming players do."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' Fetches go one at a time and start in a timer tick of their own, inside a"" + NL" + NL
    t = t + "    t = t + ""' TRY with an empty CATCH (see SIM95-NOTES.md); pages come in through the"" + NL" + NL
    t = t + "    t = t + ""' socket's events. Playback runs off a second timer and SYS.Ticks, so a movie"" + NL" + NL
    t = t + "    t = t + ""' plays at its own speed whatever the timer manages."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' A movie can be at a SimDNS name (http://movies.coolsite.sim/...): the name"" + NL" + NL
    t = t + "    t = t + ""' is asked about first, in a tick of its own, with the resolver's Rs..."" + NL" + NL
    t = t + "    t = t + ""' names. On its own, SimPlayer has simweb/src/RESOLVE.SPK joined on the end;"" + NL" + NL
    t = t + "    t = t + ""' built into Simxplorer it shares the browser's (tools/simxplorer-source.mjs)."" + NL" + NL
    t = t + "    t = t + ""' The request still says Host: movies.coolsite.sim."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' For the curious (and for tests): the window's Tag says what is going on,"" + NL" + NL
    t = t + "    t = t + ""'   state|frame|frames|loaded|parts in|parts|loop|mute"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""CONST AHEAD = 3             ' seconds of movie in hand before playing"" + NL" + NL
    t = t + "    t = t + ""CONST PATIENCE = 8000       ' ms to wait for a web server"" + NL" + NL
    t = t + "    t = t + ""CONST MAXTRIES = 3"" + NL" + NL
    t = t + "    t = t + ""CONST MINW = 336"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""VAR EOL AS String"" + NL" + NL
    t = t + "    t = t + ""VAR win AS GUI_Window"" + NL" + NL
    t = t + "    t = t + ""VAR bar AS GUI_Menu"" + NL" + NL
    t = t + "    t = t + ""VAR addrLabel AS GUI_Label"" + NL" + NL
    t = t + "    t = t + ""VAR addr AS GUI_TextBox"" + NL" + NL
    t = t + "    t = t + ""VAR openBtn AS GUI_Button"" + NL" + NL
    t = t + "    t = t + ""VAR screen AS GUI_Canvas"" + NL" + NL
    t = t + "    t = t + ""VAR info AS GUI_Label"" + NL" + NL
    t = t + "    t = t + ""VAR seekBar AS GUI_Canvas"" + NL" + NL
    t = t + "    t = t + ""VAR playBtn AS GUI_Button"" + NL" + NL
    t = t + "    t = t + ""VAR stopBtn AS GUI_Button"" + NL" + NL
    t = t + "    t = t + ""VAR rewBtn AS GUI_Button"" + NL" + NL
    t = t + "    t = t + ""VAR backBtn AS GUI_Button"" + NL" + NL
    t = t + "    t = t + ""VAR fwdBtn AS GUI_Button"" + NL" + NL
    t = t + "    t = t + ""VAR loopBox AS GUI_CheckBox"" + NL" + NL
    t = t + "    t = t + ""VAR muteBox AS GUI_CheckBox"" + NL" + NL
    t = t + "    t = t + ""VAR timeLabel AS GUI_Label"" + NL" + NL
    t = t + "    t = t + ""VAR ticker AS GUI_Timer"" + NL" + NL
    t = t + "    t = t + ""VAR fetcher AS GUI_Timer"" + NL" + NL
    t = t + "    t = t + ""VAR web AS NET_Socket"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' the movie"" + NL" + NL
    t = t + "    t = t + ""VAR source AS String          ' the file or URL it came from"" + NL" + NL
    t = t + "    t = t + ""VAR mTitle AS String"" + NL" + NL
    t = t + "    t = t + ""VAR mAuthor AS String"" + NL" + NL
    t = t + "    t = t + ""VAR mW AS Integer = 160"" + NL" + NL
    t = t + "    t = t + ""VAR mH AS Integer = 120"" + NL" + NL
    t = t + "    t = t + ""VAR mFps AS Integer = 10"" + NL" + NL
    t = t + "    t = t + ""VAR mFrames AS Integer        ' as the header says; the frames themselves win once all are in"" + NL" + NL
    t = t + "    t = t + ""VAR mBg AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR frames AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""VAR picNames AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""VAR picData AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""VAR partRefs AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""VAR partsIn AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR allIn AS Bool"" + NL" + NL
    t = t + "    t = t + ""VAR remote AS Bool"" + NL" + NL
    t = t + "    t = t + ""VAR gotHeader AS Bool"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' playing"" + NL" + NL
    t = t + "    t = t + ""VAR state AS String = """"empty""""   ' empty, buffering, playing, paused, stopped, ended, error"" + NL" + NL
    t = t + "    t = t + ""VAR problem AS String"" + NL" + NL
    t = t + "    t = t + ""VAR cur AS Integer = -1         ' the frame on the screen"" + NL" + NL
    t = t + "    t = t + ""VAR wantPlay AS Bool"" + NL" + NL
    t = t + "    t = t + ""VAR t0 AS Integer               ' SYS.Ticks when frame f0 was due"" + NL" + NL
    t = t + "    t = t + ""VAR f0 AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR dragging AS Bool"" + NL" + NL
    t = t + "    t = t + ""VAR drawing AS Bool"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' one fetch at a time"" + NL" + NL
    t = t + "    t = t + ""VAR fetching AS Bool"" + NL" + NL
    t = t + "    t = t + ""VAR fFirst AS Bool              ' the first thing at the address (a movie or a manifest)"" + NL" + NL
    t = t + "    t = t + ""VAR fUrl AS String"" + NL" + NL
    t = t + "    t = t + ""VAR fNumber AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR fParts AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""VAR fDone AS Bool"" + NL" + NL
    t = t + "    t = t + ""VAR fSince AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR fError AS String"" + NL" + NL
    t = t + "    t = t + ""VAR wantFirst AS Bool"" + NL" + NL
    t = t + "    t = t + ""VAR tries AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR inside AS Bool              ' a window of Simxplorer's, not a program of its own"" + NL" + NL
    t = t + "    t = t + ""VAR isOpen AS Bool"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' ================================================================ start"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Main ()"" + NL" + NL
    t = t + "    t = t + ""    IF SYS.Args.Count > 0 THEN"" + NL" + NL
    t = t + "    t = t + ""        OpenPlayer(SYS.Args[0], FALSE)"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        OpenPlayer("""""""", FALSE)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Opens the player and the movie at where (if any). Simxplorer has this same"" + NL" + NL
    t = t + "    t = t + ""' player built in (tools/build-installer.mjs renames everything Mv...) and"" + NL" + NL
    t = t + "    t = t + ""' calls it with embedded = TRUE: then it is one of the browser's windows, and"" + NL" + NL
    t = t + "    t = t + ""' closing it closes only the window. Opening another movie reuses the window."" + NL" + NL
    t = t + "    t = t + ""SUB OpenPlayer (where AS String, embedded AS Bool)"" + NL" + NL
    t = t + "    t = t + ""    IF isOpen THEN"" + NL" + NL
    t = t + "    t = t + ""        win.Show()"" + NL" + NL
    t = t + "    t = t + ""        win.Focus()"" + NL" + NL
    t = t + "    t = t + ""        IF where <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""            addr.Text = where"" + NL" + NL
    t = t + "    t = t + ""            OpenMovie(where)"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    inside = embedded"" + NL" + NL
    t = t + "    t = t + ""    isOpen = TRUE"" + NL" + NL
    t = t + "    t = t + ""    EOL = Chr(10)"" + NL" + NL
    t = t + "    t = t + ""    win = GUI_Window.New(""""SimPlayer"""", MINW, 260)"" + NL" + NL
    t = t + "    t = t + ""    win.Icon = """"app"""""" + NL" + NL
    t = t + "    t = t + ""    win.onClose = Win_OnClose"" + NL" + NL
    t = t + "    t = t + ""    win.onKey = Player_OnKey"" + NL" + NL
    t = t + "    t = t + ""    bar = GUI_Menu.New(win)"" + NL" + NL
    t = t + "    t = t + ""    bar.onSelect = Menu_OnSelect"" + NL" + NL
    t = t + "    t = t + ""    bar.AddMenu(""""&File"""")"" + NL" + NL
    t = t + "    t = t + ""    bar.AddItem(""""&File"""", """"&Open File..."""" + Chr(9) + """"Ctrl+O"""")"" + NL" + NL
    t = t + "    t = t + ""    bar.AddItem(""""&File"""", """"Open &URL..."""" + Chr(9) + """"Ctrl+L"""")"" + NL" + NL
    t = t + "    t = t + ""    bar.AddSeparator(""""&File"""")"" + NL" + NL
    t = t + "    t = t + ""    IF inside THEN"" + NL" + NL
    t = t + "    t = t + ""        bar.AddItem(""""&File"""", """"&Close"""")"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        bar.AddItem(""""&File"""", """"E&xit"""")"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    bar.AddMenu(""""&Play"""")"" + NL" + NL
    t = t + "    t = t + ""    bar.AddItem(""""&Play"""", """"&Play/Pause"""" + Chr(9) + """"Space"""")"" + NL" + NL
    t = t + "    t = t + ""    bar.AddItem(""""&Play"""", """"&Stop"""")"" + NL" + NL
    t = t + "    t = t + ""    bar.AddItem(""""&Play"""", """"&Rewind"""" + Chr(9) + """"Home"""")"" + NL" + NL
    t = t + "    t = t + ""    bar.AddItem(""""&Play"""", """"Step &Forward"""" + Chr(9) + """"ArrowRight"""")"" + NL" + NL
    t = t + "    t = t + ""    bar.AddItem(""""&Play"""", """"Step &Back"""" + Chr(9) + """"ArrowLeft"""")"" + NL" + NL
    t = t + "    t = t + ""    bar.AddSeparator(""""&Play"""")"" + NL" + NL
    t = t + "    t = t + ""    bar.AddItem(""""&Play"""", """"&Loop"""")"" + NL" + NL
    t = t + "    t = t + ""    bar.AddItem(""""&Play"""", """"&Mute"""")"" + NL" + NL
    t = t + "    t = t + ""    bar.AddMenu(""""&Help"""")"" + NL" + NL
    t = t + "    t = t + ""    bar.AddItem(""""&Help"""", """"&About SimPlayer"""")"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""    addrLabel = GUI_Label.New(win)"" + NL" + NL
    t = t + "    t = t + ""    addrLabel.Text = """"Address:"""""" + NL" + NL
    t = t + "    t = t + ""    addr = GUI_TextBox.New(win)"" + NL" + NL
    t = t + "    t = t + ""    addr.onEnter = Open_Click"" + NL" + NL
    t = t + "    t = t + ""    openBtn = GUI_Button.New(win)"" + NL" + NL
    t = t + "    t = t + ""    openBtn.Text = """"&Open"""""" + NL" + NL
    t = t + "    t = t + ""    openBtn.onClick = Open_Click"" + NL" + NL
    t = t + "    t = t + ""    screen = GUI_Canvas.New(win)"" + NL" + NL
    t = t + "    t = t + ""    screen.onDraw = Screen_OnDraw"" + NL" + NL
    t = t + "    t = t + ""    screen.onKey = Player_OnKey"" + NL" + NL
    t = t + "    t = t + ""    screen.onMouseDown = Screen_OnMouseDown"" + NL" + NL
    t = t + "    t = t + ""    info = GUI_Label.New(win)"" + NL" + NL
    t = t + "    t = t + ""    info.Bold = TRUE"" + NL" + NL
    t = t + "    t = t + ""    seekBar = GUI_Canvas.New(win)"" + NL" + NL
    t = t + "    t = t + ""    seekBar.onDraw = Seek_OnDraw"" + NL" + NL
    t = t + "    t = t + ""    seekBar.onMouseDown = Seek_OnMouseDown"" + NL" + NL
    t = t + "    t = t + ""    seekBar.onMouseMove = Seek_OnMouseMove"" + NL" + NL
    t = t + "    t = t + ""    seekBar.onMouseUp = Seek_OnMouseUp"" + NL" + NL
    t = t + "    t = t + ""    playBtn = GUI_Button.New(win)"" + NL" + NL
    t = t + "    t = t + ""    playBtn.Text = """"&Play"""""" + NL" + NL
    t = t + "    t = t + ""    playBtn.onClick = Play_Click"" + NL" + NL
    t = t + "    t = t + ""    stopBtn = GUI_Button.New(win)"" + NL" + NL
    t = t + "    t = t + ""    stopBtn.Text = """"&Stop"""""" + NL" + NL
    t = t + "    t = t + ""    stopBtn.onClick = Stop_Click"" + NL" + NL
    t = t + "    t = t + ""    rewBtn = GUI_Button.New(win)"" + NL" + NL
    t = t + "    t = t + ""    rewBtn.Text = """"Re&wind"""""" + NL" + NL
    t = t + "    t = t + ""    rewBtn.onClick = Rewind_Click"" + NL" + NL
    t = t + "    t = t + ""    backBtn = GUI_Button.New(win)"" + NL" + NL
    t = t + "    t = t + ""    backBtn.Text = """"<"""""" + NL" + NL
    t = t + "    t = t + ""    backBtn.onClick = Back_Click"" + NL" + NL
    t = t + "    t = t + ""    fwdBtn = GUI_Button.New(win)"" + NL" + NL
    t = t + "    t = t + ""    fwdBtn.Text = """">"""""" + NL" + NL
    t = t + "    t = t + ""    fwdBtn.onClick = Fwd_Click"" + NL" + NL
    t = t + "    t = t + ""    loopBox = GUI_CheckBox.New(win)"" + NL" + NL
    t = t + "    t = t + ""    loopBox.Text = """"&Loop"""""" + NL" + NL
    t = t + "    t = t + ""    loopBox.onChange = Loop_Change"" + NL" + NL
    t = t + "    t = t + ""    muteBox = GUI_CheckBox.New(win)"" + NL" + NL
    t = t + "    t = t + ""    muteBox.Text = """"&Mute"""""" + NL" + NL
    t = t + "    t = t + ""    muteBox.onChange = Mute_Change"" + NL" + NL
    t = t + "    t = t + ""    timeLabel = GUI_Label.New(win)"" + NL" + NL
    t = t + "    t = t + ""    timeLabel.Align = """"right"""""" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""    web = NET_Socket.New()"" + NL" + NL
    t = t + "    t = t + ""    web.onMessage = Web_OnMessage"" + NL" + NL
    t = t + "    t = t + ""    web.onClose = Web_OnClose"" + NL" + NL
    t = t + "    t = t + ""    ticker = GUI_Timer.New(win)"" + NL" + NL
    t = t + "    t = t + ""    ticker.Interval = 50"" + NL" + NL
    t = t + "    t = t + ""    ticker.onTick = Ticker_OnTick"" + NL" + NL
    t = t + "    t = t + ""    ticker.Start()"" + NL" + NL
    t = t + "    t = t + ""    fetcher = GUI_Timer.New(win)"" + NL" + NL
    t = t + "    t = t + ""    fetcher.Interval = 100"" + NL" + NL
    t = t + "    t = t + ""    fetcher.onTick = Fetcher_OnTick"" + NL" + NL
    t = t + "    t = t + ""    fetcher.Start()"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""    Layout()"" + NL" + NL
    t = t + "    t = t + ""    win.Show()"" + NL" + NL
    t = t + "    t = t + ""    Splash()"" + NL" + NL
    t = t + "    t = t + ""    Refresh()"" + NL" + NL
    t = t + "    t = t + ""    IF where <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        addr.Text = where"" + NL" + NL
    t = t + "    t = t + ""        OpenMovie(where)"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        addr.Focus()"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Win_OnClose ()"" + NL" + NL
    t = t + "    t = t + ""    IF NOT inside THEN SYS.Exit(0)"" + NL" + NL
    t = t + "    t = t + ""    ' inside Simxplorer: stop, and close just this window"" + NL" + NL
    t = t + "    t = t + ""    isOpen = FALSE"" + NL" + NL
    t = t + "    t = t + ""    state = """"empty"""""" + NL" + NL
    t = t + "    t = t + ""    ticker.Stop()"" + NL" + NL
    t = t + "    t = t + ""    fetcher.Stop()"" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        win.Destroy()"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Everything sized round the picture: at least MINW wide, the controls below."" + NL" + NL
    t = t + "    t = t + ""SUB Layout ()"" + NL" + NL
    t = t + "    t = t + ""    VAR cw AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR sh AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR y AS Integer"" + NL" + NL
    t = t + "    t = t + ""    cw = MATH.Max(MINW, mW + 16)"" + NL" + NL
    t = t + "    t = t + ""    sh = MATH.Max(120, mH)"" + NL" + NL
    t = t + "    t = t + ""    addrLabel.SetBounds(8, 8, 52, 16)"" + NL" + NL
    t = t + "    t = t + ""    addr.SetBounds(62, 4, cw - 62 - 64, 22)"" + NL" + NL
    t = t + "    t = t + ""    openBtn.SetBounds(cw - 60, 4, 52, 22)"" + NL" + NL
    t = t + "    t = t + ""    screen.SetBounds(Int((cw - mW) / 2), 32 + Int((sh - mH) / 2), mW, mH)"" + NL" + NL
    t = t + "    t = t + ""    y = 32 + sh + 6"" + NL" + NL
    t = t + "    t = t + ""    info.SetBounds(8, y, cw - 16, 16)"" + NL" + NL
    t = t + "    t = t + ""    seekBar.SetBounds(8, y + 20, cw - 16, 14)"" + NL" + NL
    t = t + "    t = t + ""    y = y + 40"" + NL" + NL
    t = t + "    t = t + ""    playBtn.SetBounds(8, y, 56, 24)"" + NL" + NL
    t = t + "    t = t + ""    stopBtn.SetBounds(68, y, 48, 24)"" + NL" + NL
    t = t + "    t = t + ""    rewBtn.SetBounds(120, y, 60, 24)"" + NL" + NL
    t = t + "    t = t + ""    backBtn.SetBounds(184, y, 24, 24)"" + NL" + NL
    t = t + "    t = t + ""    fwdBtn.SetBounds(210, y, 24, 24)"" + NL" + NL
    t = t + "    t = t + ""    loopBox.SetBounds(8, y + 30, 56, 18)"" + NL" + NL
    t = t + "    t = t + ""    muteBox.SetBounds(68, y + 30, 56, 18)"" + NL" + NL
    t = t + "    t = t + ""    timeLabel.SetBounds(cw - 128, y + 4, 120, 16)"" + NL" + NL
    t = t + "    t = t + ""    win.Width = cw"" + NL" + NL
    t = t + "    t = t + ""    win.Height = y + 54"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Nothing loaded yet: the SimPlayer card."" + NL" + NL
    t = t + "    t = t + ""SUB Splash ()"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    screen.Background = 4"" + NL" + NL
    t = t + "    t = t + ""    screen.Clear()"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 0 TO 7"" + NL" + NL
    Put("C:\WEB\VAPOR\SIMPLAYR\1.TXT")
END SUB

SUB File7 ()
    t = ""
    t = t + "    t = t + ""        screen.SetColor(4)"" + NL" + NL
    t = t + "    t = t + ""        IF i MOD 2 = 1 THEN screen.SetColor(12)"" + NL" + NL
    t = t + "    t = t + ""        screen.FillRect(0, Int(mH * i / 8), mW, 2)"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    ' the S logo"" + NL" + NL
    t = t + "    t = t + ""    screen.SetColor(9)"" + NL" + NL
    t = t + "    t = t + ""    screen.FillRect(Int(mW / 2) - 16, Int(mH / 2) - 34, 32, 32)"" + NL" + NL
    t = t + "    t = t + ""    screen.SetColor(15)"" + NL" + NL
    t = t + "    t = t + ""    screen.FillRect(Int(mW / 2) - 8, Int(mH / 2) - 29, 18, 4)"" + NL" + NL
    t = t + "    t = t + ""    screen.FillRect(Int(mW / 2) - 10, Int(mH / 2) - 25, 5, 6)"" + NL" + NL
    t = t + "    t = t + ""    screen.FillRect(Int(mW / 2) - 8, Int(mH / 2) - 20, 16, 4)"" + NL" + NL
    t = t + "    t = t + ""    screen.FillRect(Int(mW / 2) + 5, Int(mH / 2) - 16, 5, 6)"" + NL" + NL
    t = t + "    t = t + ""    screen.FillRect(Int(mW / 2) - 10, Int(mH / 2) - 10, 18, 4)"" + NL" + NL
    t = t + "    t = t + ""    screen.SetColor(15)"" + NL" + NL
    t = t + "    t = t + ""    screen.Text(Int(mW / 2) - 32, Int(mH / 2) + 6, """"SimPlayer"""")"" + NL" + NL
    t = t + "    t = t + ""    screen.SetColor(14)"" + NL" + NL
    t = t + "    t = t + ""    screen.Text(Int(mW / 2) - 38, Int(mH / 2) + 22, """"Version 1.0"""")"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' ================================================================ opening"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Reset ()"" + NL" + NL
    t = t + "    t = t + ""    frames.Clear()"" + NL" + NL
    t = t + "    t = t + ""    picNames.Clear()"" + NL" + NL
    t = t + "    t = t + ""    picData.Clear()"" + NL" + NL
    t = t + "    t = t + ""    partRefs.Clear()"" + NL" + NL
    t = t + "    t = t + ""    partsIn = 0"" + NL" + NL
    t = t + "    t = t + ""    allIn = FALSE"" + NL" + NL
    t = t + "    t = t + ""    gotHeader = FALSE"" + NL" + NL
    t = t + "    t = t + ""    mTitle = """""""""" + NL" + NL
    t = t + "    t = t + ""    mAuthor = """""""""" + NL" + NL
    t = t + "    t = t + ""    mFps = 10"" + NL" + NL
    t = t + "    t = t + ""    mFrames = 0"" + NL" + NL
    t = t + "    t = t + ""    mBg = 0"" + NL" + NL
    t = t + "    t = t + ""    cur = -1"" + NL" + NL
    t = t + "    t = t + ""    problem = """""""""" + NL" + NL
    t = t + "    t = t + ""    fetching = FALSE"" + NL" + NL
    t = t + "    t = t + ""    wantFirst = FALSE"" + NL" + NL
    t = t + "    t = t + ""    tries = 0"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB OpenMovie (where AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR text AS String"" + NL" + NL
    t = t + "    t = t + ""    where = where.Trim()"" + NL" + NL
    t = t + "    t = t + ""    IF where = """""""" THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    Reset()"" + NL" + NL
    t = t + "    t = t + ""    source = where"" + NL" + NL
    t = t + "    t = t + ""    wantPlay = TRUE"" + NL" + NL
    t = t + "    t = t + ""    IF where.Lower().StartsWith(""""http://"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        remote = TRUE"" + NL" + NL
    t = t + "    t = t + ""        state = """"buffering"""""" + NL" + NL
    t = t + "    t = t + ""        wantFirst = TRUE"" + NL" + NL
    t = t + "    t = t + ""        win.Title = """"SimPlayer - """" + where"" + NL" + NL
    t = t + "    t = t + ""        Refresh()"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    remote = FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF NOT FS.Exists(where) THEN"" + NL" + NL
    t = t + "    t = t + ""        Fail(""""There is no file called """" + where + """"."""")"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    text = FS.Read(where)"" + NL" + NL
    t = t + "    t = t + ""    TakeFirst(text, DirOf(where))"" + NL" + NL
    t = t + "    t = t + ""    ' the parts of a movie on this disk are all here at once"" + NL" + NL
    t = t + "    t = t + ""    WHILE state <> """"error"""" AND partsIn < partRefs.Count"" + NL" + NL
    t = t + "    t = t + ""        IF NOT FS.Exists(partRefs[partsIn]) THEN"" + NL" + NL
    t = t + "    t = t + ""            Fail(""""A part of this movie is missing: """" + partRefs[partsIn])"" + NL" + NL
    t = t + "    t = t + ""            RETURN"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        AddPart(FS.Read(partRefs[partsIn]))"" + NL" + NL
    t = t + "    t = t + ""    END WHILE"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Fail (why AS String)"" + NL" + NL
    t = t + "    t = t + ""    state = """"error"""""" + NL" + NL
    t = t + "    t = t + ""    problem = why"" + NL" + NL
    t = t + "    t = t + ""    wantPlay = FALSE"" + NL" + NL
    t = t + "    t = t + ""    Refresh()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The first thing read from an address: a whole movie, or a manifest that"" + NL" + NL
    t = t + "    t = t + ""' lists its parts."" + NL" + NL
    t = t + "    t = t + ""SUB TakeFirst (text AS String, base AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR lines AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR line AS String"" + NL" + NL
    t = t + "    t = t + ""    lines = text.Lines()"" + NL" + NL
    t = t + "    t = t + ""    IF lines.Count > 0 AND lines[0].StartsWith(""""SIMMOVIE-PARTS"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        FOR EACH line IN lines"" + NL" + NL
    t = t + "    t = t + ""            IF line.StartsWith(""""part="""") THEN"" + NL" + NL
    t = t + "    t = t + ""                partRefs.Add(Resolve(line.Substring(5, line.Length - 5).Trim(), base))"" + NL" + NL
    t = t + "    t = t + ""            ELSE"" + NL" + NL
    t = t + "    t = t + ""                HeaderLine(line)"" + NL" + NL
    t = t + "    t = t + ""            END IF"" + NL" + NL
    t = t + "    t = t + ""        NEXT"" + NL" + NL
    t = t + "    t = t + ""        IF partRefs.Count = 0 THEN"" + NL" + NL
    t = t + "    t = t + ""            Fail(""""That manifest lists no parts."""")"" + NL" + NL
    t = t + "    t = t + ""            RETURN"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        Opened()"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF lines.Count = 0 OR NOT lines[0].StartsWith(""""SIMMOVIE """") THEN"" + NL" + NL
    t = t + "    t = t + ""        Fail(""""That is not a SimMovie. A SimMovie starts with the line SIMMOVIE 1."""")"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    partRefs.Add(source)"" + NL" + NL
    t = t + "    t = t + ""    AddPart(text)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB HeaderLine (line AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR field AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR value AS String"" + NL" + NL
    t = t + "    t = t + ""    IF line.IndexOf(""""="""") < 1 THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    field = line.Substring(0, line.IndexOf(""""="""")).Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    value = line.Substring(line.IndexOf(""""="""") + 1, line.Length - line.IndexOf(""""="""") - 1)"" + NL" + NL
    t = t + "    t = t + ""    SELECT CASE field"" + NL" + NL
    t = t + "    t = t + ""        CASE """"title"""""" + NL" + NL
    t = t + "    t = t + ""            mTitle = value"" + NL" + NL
    t = t + "    t = t + ""        CASE """"author"""""" + NL" + NL
    t = t + "    t = t + ""            mAuthor = value"" + NL" + NL
    t = t + "    t = t + ""        CASE """"width"""""" + NL" + NL
    t = t + "    t = t + ""            mW = Clamp(Int(Val(value)), 16, 320)"" + NL" + NL
    t = t + "    t = t + ""        CASE """"height"""""" + NL" + NL
    t = t + "    t = t + ""            mH = Clamp(Int(Val(value)), 16, 240)"" + NL" + NL
    t = t + "    t = t + ""        CASE """"fps"""""" + NL" + NL
    t = t + "    t = t + ""            mFps = Clamp(Int(Val(value)), 1, 30)"" + NL" + NL
    t = t + "    t = t + ""        CASE """"frames"""""" + NL" + NL
    t = t + "    t = t + ""            mFrames = MATH.Max(0, Int(Val(value)))"" + NL" + NL
    t = t + "    t = t + ""        CASE """"bg"""""" + NL" + NL
    t = t + "    t = t + ""            mBg = Clamp(Int(Val(value)), 0, 15)"" + NL" + NL
    t = t + "    t = t + ""    END SELECT"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION Clamp (n AS Integer, lo AS Integer, hi AS Integer) AS Integer"" + NL" + NL
    t = t + "    t = t + ""    IF n < lo THEN RETURN lo"" + NL" + NL
    t = t + "    t = t + ""    IF n > hi THEN RETURN hi"" + NL" + NL
    t = t + "    t = t + ""    RETURN n"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The header is in: size the window to the picture."" + NL" + NL
    t = t + "    t = t + ""SUB Opened ()"" + NL" + NL
    t = t + "    t = t + ""    IF gotHeader THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    gotHeader = TRUE"" + NL" + NL
    t = t + "    t = t + ""    Layout()"" + NL" + NL
    t = t + "    t = t + ""    screen.Background = mBg"" + NL" + NL
    t = t + "    t = t + ""    screen.Clear()"" + NL" + NL
    t = t + "    t = t + ""    IF mTitle = """""""" THEN mTitle = """"Untitled"""""" + NL" + NL
    t = t + "    t = t + ""    win.Title = """"SimPlayer - """" + mTitle"" + NL" + NL
    t = t + "    t = t + ""    IF wantPlay THEN state = """"buffering"""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' One part: frames, and pictures for them. The first part starts with the header."" + NL" + NL
    t = t + "    t = t + ""SUB AddPart (text AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR lines AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR line AS String"" + NL" + NL
    t = t + "    t = t + ""    lines = text.Lines()"" + NL" + NL
    t = t + "    t = t + ""    i = 0"" + NL" + NL
    t = t + "    t = t + ""    IF lines.Count > 0 AND lines[0].StartsWith(""""SIMMOVIE """") THEN"" + NL" + NL
    t = t + "    t = t + ""        i = 1"" + NL" + NL
    t = t + "    t = t + ""        WHILE i < lines.Count"" + NL" + NL
    t = t + "    t = t + ""            IF lines[i] = """"."""" THEN BREAK"" + NL" + NL
    t = t + "    t = t + ""            ' a manifest has said all this already"" + NL" + NL
    t = t + "    t = t + ""            IF NOT gotHeader THEN HeaderLine(lines[i])"" + NL" + NL
    t = t + "    t = t + ""            i = i + 1"" + NL" + NL
    t = t + "    t = t + ""        END WHILE"" + NL" + NL
    t = t + "    t = t + ""        i = i + 1"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    Opened()"" + NL" + NL
    t = t + "    t = t + ""    WHILE i < lines.Count"" + NL" + NL
    t = t + "    t = t + ""        line = lines[i]"" + NL" + NL
    t = t + "    t = t + ""        i = i + 1"" + NL" + NL
    t = t + "    t = t + ""        IF line = """""""" OR line.StartsWith(""""'"""") THEN CONTINUE"" + NL" + NL
    t = t + "    t = t + ""        IF line.StartsWith(""""!"""") THEN"" + NL" + NL
    t = t + "    t = t + ""            AddPicture(line.Substring(1, line.Length - 1))"" + NL" + NL
    t = t + "    t = t + ""        ELSE"" + NL" + NL
    t = t + "    t = t + ""            frames.Add(line)"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    END WHILE"" + NL" + NL
    t = t + "    t = t + ""    partsIn = partsIn + 1"" + NL" + NL
    t = t + "    t = t + ""    IF partsIn >= partRefs.Count THEN"" + NL" + NL
    t = t + "    t = t + ""        allIn = TRUE"" + NL" + NL
    t = t + "    t = t + ""        mFrames = frames.Count"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    Refresh()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' !name|SIM95PIC w h|row|row..."" + NL" + NL
    t = t + "    t = t + ""SUB AddPicture (line AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR at AS Integer"" + NL" + NL
    t = t + "    t = t + ""    at = line.IndexOf(""""|"""")"" + NL" + NL
    t = t + "    t = t + ""    IF at < 1 THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    picNames.Add(line.Substring(0, at))"" + NL" + NL
    t = t + "    t = t + ""    picData.Add(line.Substring(at + 1, line.Length - at - 1).Replace(""""|"""", EOL))"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Where a part is, from what the manifest says and where the manifest was."" + NL" + NL
    t = t + "    t = t + ""FUNCTION Resolve (ref AS String, base AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR host AS String"" + NL" + NL
    t = t + "    t = t + ""    IF ref.Lower().StartsWith(""""http://"""") THEN RETURN ref"" + NL" + NL
    t = t + "    t = t + ""    IF base.Lower().StartsWith(""""http://"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        IF ref.StartsWith(""""/"""") THEN"" + NL" + NL
    t = t + "    t = t + ""            host = base.Substring(7, base.Length - 7)"" + NL" + NL
    t = t + "    t = t + ""            IF host.IndexOf(""""/"""") >= 0 THEN host = host.Substring(0, host.IndexOf(""""/""""))"" + NL" + NL
    t = t + "    t = t + ""            RETURN """"http://"""" + host + ref"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        RETURN base + ref"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF ref.Contains("""":\"""") THEN RETURN ref"" + NL" + NL
    t = t + "    t = t + ""    RETURN base + ref"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The folder an address is in, with its slash: http://a/tube/ or C:\MYFILES\"" + NL" + NL
    t = t + "    t = t + ""FUNCTION DirOf (where AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR sep AS String"" + NL" + NL
    t = t + "    t = t + ""    sep = """"\"""""" + NL" + NL
    t = t + "    t = t + ""    IF where.Lower().StartsWith(""""http://"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        sep = """"/"""""" + NL" + NL
    t = t + "    t = t + ""        IF where.IndexOf(""""?"""") >= 0 THEN where = where.Substring(0, where.IndexOf(""""?""""))"" + NL" + NL
    t = t + "    t = t + ""        IF where.Substring(7, where.Length - 7).IndexOf(""""/"""") < 0 THEN RETURN where + """"/"""""" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    FOR i = where.Length - 1 TO 0 STEP -1"" + NL" + NL
    t = t + "    t = t + ""        IF where.CharAt(i) = sep THEN RETURN where.Substring(0, i + 1)"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION Total () AS Integer"" + NL" + NL
    t = t + "    t = t + ""    IF allIn THEN RETURN frames.Count"" + NL" + NL
    t = t + "    t = t + ""    RETURN MATH.Max(mFrames, frames.Count)"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Enough is here to play: all of it, or a few seconds past this frame."" + NL" + NL
    t = t + "    t = t + ""FUNCTION Ready () AS Bool"" + NL" + NL
    t = t + "    t = t + ""    IF frames.Count = 0 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF allIn THEN RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""    RETURN frames.Count - 1 - cur >= mFps * AHEAD"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION Percent () AS Integer"" + NL" + NL
    t = t + "    t = t + ""    IF partRefs.Count = 0 THEN RETURN 0"" + NL" + NL
    t = t + "    t = t + ""    RETURN Int(partsIn * 100 / partRefs.Count)"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' ================================================================ playing"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Ticker_OnTick ()"" + NL" + NL
    t = t + "    t = t + ""    IF drawing THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    drawing = TRUE"" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        PlayStep()"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""        win.Status = """"Could not draw frame """" + Str(cur + 1) + """": """" + err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""    drawing = FALSE"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB PlayStep ()"" + NL" + NL
    t = t + "    t = t + ""    VAR want AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR last AS Integer"" + NL" + NL
    t = t + "    t = t + ""    IF state = """"buffering"""" THEN"" + NL" + NL
    t = t + "    t = t + ""        IF wantPlay AND Ready() THEN BeginPlay()"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF state <> """"playing"""" THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    want = f0 + Int((SYS.Ticks - t0) * mFps / 1000)"" + NL" + NL
    t = t + "    t = t + ""    last = Total() - 1"" + NL" + NL
    t = t + "    t = t + ""    IF want > last AND allIn THEN"" + NL" + NL
    t = t + "    t = t + ""        IF cur < last THEN ShowFrame(last, TRUE)"" + NL" + NL
    t = t + "    t = t + ""        IF loopBox.Checked THEN"" + NL" + NL
    t = t + "    t = t + ""            ShowFrame(0, TRUE)"" + NL" + NL
    t = t + "    t = t + ""            t0 = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""            f0 = 0"" + NL" + NL
    t = t + "    t = t + ""        ELSE"" + NL" + NL
    t = t + "    t = t + ""            state = """"ended"""""" + NL" + NL
    t = t + "    t = t + ""            wantPlay = FALSE"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        Refresh()"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF want > frames.Count - 1 THEN"" + NL" + NL
    t = t + "    t = t + ""        ' caught up with the download: wait for more"" + NL" + NL
    t = t + "    t = t + ""        IF cur < frames.Count - 1 THEN ShowFrame(frames.Count - 1, TRUE)"" + NL" + NL
    t = t + "    t = t + ""        state = """"buffering"""""" + NL" + NL
    t = t + "    t = t + ""        Refresh()"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF want > cur THEN"" + NL" + NL
    t = t + "    t = t + ""        ShowFrame(want, TRUE)"" + NL" + NL
    t = t + "    t = t + ""        Refresh()"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB BeginPlay ()"" + NL" + NL
    t = t + "    t = t + ""    IF cur >= Total() - 1 THEN cur = -1"" + NL" + NL
    t = t + "    t = t + ""    IF cur < 0 THEN ShowFrame(0, TRUE)"" + NL" + NL
    t = t + "    t = t + ""    t0 = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    f0 = cur"" + NL" + NL
    t = t + "    t = t + ""    state = """"playing"""""" + NL" + NL
    t = t + "    t = t + ""    wantPlay = TRUE"" + NL" + NL
    t = t + "    t = t + ""    Refresh()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Pause ()"" + NL" + NL
    t = t + "    t = t + ""    wantPlay = FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF state = """"playing"""" OR state = """"buffering"""" THEN state = """"paused"""""" + NL" + NL
    t = t + "    t = t + ""    Refresh()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION HasMovie () AS Bool"" + NL" + NL
    t = t + "    t = t + ""    RETURN frames.Count > 0"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    Put("C:\WEB\VAPOR\SIMPLAYR\2.TXT")
END SUB

SUB File8 ()
    t = ""
    t = t + "    t = t + ""' Frame n on the screen. Going forward, the frames in between are drawn over"" + NL" + NL
    t = t + "    t = t + ""' what is there (from a keyframe, if one comes first); anywhere else, from the"" + NL" + NL
    t = t + "    t = t + ""' keyframe before n."" + NL" + NL
    t = t + "    t = t + ""SUB ShowFrame (n AS Integer, sound AS Bool)"" + NL" + NL
    t = t + "    t = t + ""    VAR start AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    IF n < 0 OR n >= frames.Count THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    start = n"" + NL" + NL
    t = t + "    t = t + ""    WHILE start > 0 AND NOT frames[start].StartsWith(""""*"""")"" + NL" + NL
    t = t + "    t = t + ""        IF start = cur + 1 AND cur >= 0 AND n > cur THEN BREAK"" + NL" + NL
    t = t + "    t = t + ""        start = start - 1"" + NL" + NL
    t = t + "    t = t + ""    END WHILE"" + NL" + NL
    t = t + "    t = t + ""    IF NOT frames[start].StartsWith(""""*"""") AND start = 0 THEN Blank()"" + NL" + NL
    t = t + "    t = t + ""    FOR i = start TO n"" + NL" + NL
    t = t + "    t = t + ""        DrawFrame(frames[i], sound AND i = n)"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    cur = n"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Blank ()"" + NL" + NL
    t = t + "    t = t + ""    screen.Background = mBg"" + NL" + NL
    t = t + "    t = t + ""    screen.Clear()"" + NL" + NL
    t = t + "    t = t + ""    screen.SetColor(0)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB DrawFrame (line AS String, sound AS Bool)"" + NL" + NL
    t = t + "    t = t + ""    VAR c AS String"" + NL" + NL
    t = t + "    t = t + ""    IF line.StartsWith(""""*"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        Blank()"" + NL" + NL
    t = t + "    t = t + ""        line = line.Substring(1, line.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF line = """"-"""" OR line = """""""" THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    FOR EACH c IN line.Split("""";"""")"" + NL" + NL
    t = t + "    t = t + ""        IF c <> """""""" THEN DrawCmd(c, sound)"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' One command: a letter and its numbers."" + NL" + NL
    t = t + "    t = t + ""SUB DrawCmd (c AS String, sound AS Bool)"" + NL" + NL
    t = t + "    t = t + ""    VAR op AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR rest AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR n AS Array OF Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR at AS Integer"" + NL" + NL
    t = t + "    t = t + ""    op = c.CharAt(0)"" + NL" + NL
    t = t + "    t = t + ""    rest = c.Substring(1, c.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""    SELECT CASE op"" + NL" + NL
    t = t + "    t = t + ""        CASE """"C"""""" + NL" + NL
    t = t + "    t = t + ""            screen.SetColor(Clamp(Int(Val(rest)), 0, 15))"" + NL" + NL
    t = t + "    t = t + ""        CASE """"B"""""" + NL" + NL
    t = t + "    t = t + ""            screen.Background = Clamp(Int(Val(rest)), 0, 15)"" + NL" + NL
    t = t + "    t = t + ""        CASE """"X"""""" + NL" + NL
    t = t + "    t = t + ""            screen.Clear()"" + NL" + NL
    t = t + "    t = t + ""        CASE """"T"""""" + NL" + NL
    t = t + "    t = t + ""            ' T x,y,text: the text runs to the end of the command"" + NL" + NL
    t = t + "    t = t + ""            n = Nums(rest, 2)"" + NL" + NL
    t = t + "    t = t + ""            at = SecondComma(rest)"" + NL" + NL
    t = t + "    t = t + ""            IF n.Count = 2 AND at > 0 THEN screen.Text(n[0], n[1], rest.Substring(at + 1, rest.Length - at - 1))"" + NL" + NL
    t = t + "    t = t + ""        CASE """"I"""""" + NL" + NL
    t = t + "    t = t + ""            n = Nums(rest, 2)"" + NL" + NL
    t = t + "    t = t + ""            at = SecondComma(rest)"" + NL" + NL
    t = t + "    t = t + ""            IF n.Count = 2 AND at > 0 THEN"" + NL" + NL
    t = t + "    t = t + ""                i = picNames.IndexOf(rest.Substring(at + 1, rest.Length - at - 1))"" + NL" + NL
    t = t + "    t = t + ""                IF i >= 0 THEN screen.Picture(n[0], n[1], picData[i])"" + NL" + NL
    t = t + "    t = t + ""            END IF"" + NL" + NL
    t = t + "    t = t + ""        CASE """"S"""""" + NL" + NL
    t = t + "    t = t + ""            n = Nums(rest, 2)"" + NL" + NL
    t = t + "    t = t + ""            IF sound AND NOT muteBox.Checked AND n.Count = 2 THEN SYS.Beep(Clamp(n[0], 37, 8000), Clamp(n[1], 1, 1000))"" + NL" + NL
    t = t + "    t = t + ""        CASE """"R"""""" + NL" + NL
    t = t + "    t = t + ""            n = Nums(rest, 4)"" + NL" + NL
    t = t + "    t = t + ""            IF n.Count = 4 THEN screen.Rect(n[0], n[1], n[2], n[3])"" + NL" + NL
    t = t + "    t = t + ""        CASE """"F"""""" + NL" + NL
    t = t + "    t = t + ""            n = Nums(rest, 4)"" + NL" + NL
    t = t + "    t = t + ""            IF n.Count = 4 THEN screen.FillRect(n[0], n[1], n[2], n[3])"" + NL" + NL
    t = t + "    t = t + ""        CASE """"O"""""" + NL" + NL
    t = t + "    t = t + ""            n = Nums(rest, 3)"" + NL" + NL
    t = t + "    t = t + ""            IF n.Count = 3 THEN screen.Circle(n[0], n[1], n[2])"" + NL" + NL
    t = t + "    t = t + ""        CASE """"D"""""" + NL" + NL
    t = t + "    t = t + ""            n = Nums(rest, 3)"" + NL" + NL
    t = t + "    t = t + ""            IF n.Count = 3 THEN screen.FillCircle(n[0], n[1], n[2])"" + NL" + NL
    t = t + "    t = t + ""        CASE """"L"""""" + NL" + NL
    t = t + "    t = t + ""            n = Nums(rest, 0)"" + NL" + NL
    t = t + "    t = t + ""            FOR i = 0 TO Int(n.Count / 2) - 2"" + NL" + NL
    t = t + "    t = t + ""                screen.Line(n[i * 2], n[i * 2 + 1], n[i * 2 + 2], n[i * 2 + 3])"" + NL" + NL
    t = t + "    t = t + ""            NEXT"" + NL" + NL
    t = t + "    t = t + ""        CASE """"P"""""" + NL" + NL
    t = t + "    t = t + ""            n = Nums(rest, 0)"" + NL" + NL
    t = t + "    t = t + ""            IF n.Count >= 4 THEN"" + NL" + NL
    t = t + "    t = t + ""                FOR i = 0 TO Int(n.Count / 2) - 1"" + NL" + NL
    t = t + "    t = t + ""                    screen.Line(n[i * 2], n[i * 2 + 1], n[((i + 1) * 2) MOD (Int(n.Count / 2) * 2)], n[((i + 1) * 2) MOD (Int(n.Count / 2) * 2) + 1])"" + NL" + NL
    t = t + "    t = t + ""                NEXT"" + NL" + NL
    t = t + "    t = t + ""            END IF"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Q"""""" + NL" + NL
    t = t + "    t = t + ""            n = Nums(rest, 0)"" + NL" + NL
    t = t + "    t = t + ""            IF n.Count >= 6 THEN FillPoly(n)"" + NL" + NL
    t = t + "    t = t + ""    END SELECT"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Where the text of T x,y,text (or the name of I x,y,name) starts, less one."" + NL" + NL
    t = t + "    t = t + ""FUNCTION SecondComma (s AS String) AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR a AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR b AS Integer"" + NL" + NL
    t = t + "    t = t + ""    a = s.IndexOf("""","""")"" + NL" + NL
    t = t + "    t = t + ""    IF a < 0 THEN RETURN -1"" + NL" + NL
    t = t + "    t = t + ""    b = s.Substring(a + 1, s.Length - a - 1).IndexOf("""","""")"" + NL" + NL
    t = t + "    t = t + ""    IF b < 0 THEN RETURN -1"" + NL" + NL
    t = t + "    t = t + ""    RETURN a + 1 + b"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The numbers in """"10,20,30"""". most > 0 reads only that many (T and I have"" + NL" + NL
    t = t + "    t = t + ""' text after theirs)."" + NL" + NL
    t = t + "    t = t + ""FUNCTION Nums (s AS String, most AS Integer) AS Array OF Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR out AS Array OF Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR p AS String"" + NL" + NL
    t = t + "    t = t + ""    FOR EACH p IN s.Split("""","""")"" + NL" + NL
    t = t + "    t = t + ""        IF most > 0 AND out.Count >= most THEN BREAK"" + NL" + NL
    t = t + "    t = t + ""        out.Add(Int(Val(p.Trim())))"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    RETURN out"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' A filled polygon, a row at a time: where each row crosses the edges, in"" + NL" + NL
    t = t + "    t = t + ""' pairs."" + NL" + NL
    t = t + "    t = t + ""SUB FillPoly (p AS Array OF Integer)"" + NL" + NL
    t = t + "    t = t + ""    VAR k AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR j AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR y AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR top AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR bottom AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR x1 AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR y1 AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR x2 AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR y2 AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR xs AS Array OF Integer"" + NL" + NL
    t = t + "    t = t + ""    k = Int(p.Count / 2)"" + NL" + NL
    t = t + "    t = t + ""    top = p[1]"" + NL" + NL
    t = t + "    t = t + ""    bottom = p[1]"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 1 TO k - 1"" + NL" + NL
    t = t + "    t = t + ""        top = MATH.Min(top, p[i * 2 + 1])"" + NL" + NL
    t = t + "    t = t + ""        bottom = MATH.Max(bottom, p[i * 2 + 1])"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    FOR y = top TO bottom"" + NL" + NL
    t = t + "    t = t + ""        xs.Clear()"" + NL" + NL
    t = t + "    t = t + ""        FOR i = 0 TO k - 1"" + NL" + NL
    t = t + "    t = t + ""            j = (i + 1) MOD k"" + NL" + NL
    t = t + "    t = t + ""            x1 = p[i * 2]"" + NL" + NL
    t = t + "    t = t + ""            y1 = p[i * 2 + 1]"" + NL" + NL
    t = t + "    t = t + ""            x2 = p[j * 2]"" + NL" + NL
    t = t + "    t = t + ""            y2 = p[j * 2 + 1]"" + NL" + NL
    t = t + "    t = t + ""            IF (y1 <= y AND y2 > y) OR (y2 <= y AND y1 > y) THEN xs.Add(x1 + Int((y - y1) * (x2 - x1) / (y2 - y1)))"" + NL" + NL
    t = t + "    t = t + ""        NEXT"" + NL" + NL
    t = t + "    t = t + ""        xs.Sort()"" + NL" + NL
    t = t + "    t = t + ""        FOR i = 0 TO xs.Count - 2"" + NL" + NL
    t = t + "    t = t + ""            IF i MOD 2 = 0 THEN screen.Line(xs[i], y, xs[i + 1], y)"" + NL" + NL
    t = t + "    t = t + ""        NEXT"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' ================================================================ the controls"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Play_Click ()"" + NL" + NL
    t = t + "    t = t + ""    IF state = """"playing"""" OR (state = """"buffering"""" AND wantPlay) THEN"" + NL" + NL
    t = t + "    t = t + ""        Pause()"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF NOT HasMovie() AND NOT remote THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    IF state = """"error"""" THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    IF state = """"ended"""" OR cur >= Total() - 1 THEN cur = -1"" + NL" + NL
    t = t + "    t = t + ""    wantPlay = TRUE"" + NL" + NL
    t = t + "    t = t + ""    IF Ready() THEN"" + NL" + NL
    t = t + "    t = t + ""        BeginPlay()"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        state = """"buffering"""""" + NL" + NL
    t = t + "    t = t + ""        Refresh()"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Stop_Click ()"" + NL" + NL
    t = t + "    t = t + ""    IF NOT HasMovie() THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    wantPlay = FALSE"" + NL" + NL
    t = t + "    t = t + ""    ShowFrame(0, FALSE)"" + NL" + NL
    t = t + "    t = t + ""    state = """"stopped"""""" + NL" + NL
    t = t + "    t = t + ""    Refresh()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Rewind_Click ()"" + NL" + NL
    t = t + "    t = t + ""    SeekFrame(0)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Back_Click ()"" + NL" + NL
    t = t + "    t = t + ""    IF NOT HasMovie() THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    Pause()"" + NL" + NL
    t = t + "    t = t + ""    IF state = """"stopped"""" OR state = """"ended"""" THEN state = """"paused"""""" + NL" + NL
    t = t + "    t = t + ""    IF cur > 0 THEN ShowFrame(cur - 1, FALSE)"" + NL" + NL
    t = t + "    t = t + ""    Refresh()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Fwd_Click ()"" + NL" + NL
    t = t + "    t = t + ""    IF NOT HasMovie() THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    Pause()"" + NL" + NL
    t = t + "    t = t + ""    IF state = """"stopped"""" OR state = """"ended"""" THEN state = """"paused"""""" + NL" + NL
    t = t + "    t = t + ""    IF cur < frames.Count - 1 THEN ShowFrame(cur + 1, TRUE)"" + NL" + NL
    t = t + "    t = t + ""    Refresh()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Anywhere in what has arrived so far; playing carries on from there."" + NL" + NL
    t = t + "    t = t + ""SUB SeekFrame (n AS Integer)"" + NL" + NL
    t = t + "    t = t + ""    IF NOT HasMovie() THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    n = Clamp(n, 0, frames.Count - 1)"" + NL" + NL
    t = t + "    t = t + ""    ShowFrame(n, FALSE)"" + NL" + NL
    t = t + "    t = t + ""    IF state = """"playing"""" THEN"" + NL" + NL
    t = t + "    t = t + ""        t0 = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""        f0 = n"" + NL" + NL
    t = t + "    t = t + ""    ELSEIF state = """"stopped"""" OR state = """"ended"""" THEN"" + NL" + NL
    t = t + "    t = t + ""        state = """"paused"""""" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    Refresh()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Loop_Change ()"" + NL" + NL
    t = t + "    t = t + ""    bar.SetChecked(""""Loop"""", loopBox.Checked)"" + NL" + NL
    t = t + "    t = t + ""    Refresh()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Mute_Change ()"" + NL" + NL
    t = t + "    t = t + ""    bar.SetChecked(""""Mute"""", muteBox.Checked)"" + NL" + NL
    t = t + "    t = t + ""    Refresh()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Open_Click ()"" + NL" + NL
    t = t + "    t = t + ""    OpenMovie(addr.Text)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB OpenFile ()"" + NL" + NL
    t = t + "    t = t + ""    VAR dlg AS GUI_FileDialog"" + NL" + NL
    t = t + "    t = t + ""    VAR path AS String"" + NL" + NL
    t = t + "    t = t + ""    dlg = GUI_FileDialog.New(win)"" + NL" + NL
    t = t + "    t = t + ""    dlg.Title = """"Open a SimMovie"""""" + NL" + NL
    t = t + "    t = t + ""    dlg.Filter = """"*.SMV"""""" + NL" + NL
    t = t + "    t = t + ""    dlg.Path = """"C:\MYFILES"""""" + NL" + NL
    t = t + "    t = t + ""    path = dlg.ShowOpen()"" + NL" + NL
    t = t + "    t = t + ""    IF path <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        addr.Text = path"" + NL" + NL
    t = t + "    t = t + ""        OpenMovie(path)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Player_OnKey (k AS String)"" + NL" + NL
    t = t + "    t = t + ""    SELECT CASE k"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Space"""""" + NL" + NL
    t = t + "    t = t + ""            Play_Click()"" + NL" + NL
    t = t + "    t = t + ""        CASE """"ArrowRight"""", """"."""""" + NL" + NL
    t = t + "    t = t + ""            Fwd_Click()"" + NL" + NL
    t = t + "    t = t + ""        CASE """"ArrowLeft"""", """","""""" + NL" + NL
    t = t + "    t = t + ""            Back_Click()"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Home"""""" + NL" + NL
    t = t + "    t = t + ""            Rewind_Click()"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Ctrl+O"""""" + NL" + NL
    t = t + "    t = t + ""            OpenFile()"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Ctrl+L"""""" + NL" + NL
    t = t + "    t = t + ""            addr.Focus()"" + NL" + NL
    t = t + "    t = t + ""            addr.SelectAll()"" + NL" + NL
    t = t + "    t = t + ""    END SELECT"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Screen_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)"" + NL" + NL
    t = t + "    t = t + ""    Play_Click()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Screen_OnDraw (canvas AS GUI_Canvas)"" + NL" + NL
    t = t + "    t = t + ""    IF cur >= 0 THEN"" + NL" + NL
    t = t + "    t = t + ""        ShowFrame(cur, FALSE)"" + NL" + NL
    t = t + "    t = t + ""    ELSEIF NOT HasMovie() AND state = """"empty"""" THEN"" + NL" + NL
    t = t + "    t = t + ""        Splash()"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Menu_OnSelect (item AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR box AS GUI_MessageBox"" + NL" + NL
    t = t + "    t = t + ""    SELECT CASE item"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Open File..."""""" + NL" + NL
    t = t + "    t = t + ""            OpenFile()"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Open URL..."""""" + NL" + NL
    t = t + "    t = t + ""            addr.Focus()"" + NL" + NL
    t = t + "    t = t + ""            addr.SelectAll()"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Exit"""", """"Close"""""" + NL" + NL
    t = t + "    t = t + ""            Win_OnClose()"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Play/Pause"""""" + NL" + NL
    t = t + "    t = t + ""            Play_Click()"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Stop"""""" + NL" + NL
    t = t + "    t = t + ""            Stop_Click()"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Rewind"""""" + NL" + NL
    t = t + "    t = t + ""            Rewind_Click()"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Step Forward"""""" + NL" + NL
    t = t + "    t = t + ""            Fwd_Click()"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Step Back"""""" + NL" + NL
    t = t + "    t = t + ""            Back_Click()"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Loop"""""" + NL" + NL
    t = t + "    t = t + ""            loopBox.Checked = NOT loopBox.Checked"" + NL" + NL
    t = t + "    t = t + ""            Loop_Change()"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Mute"""""" + NL" + NL
    t = t + "    t = t + ""            muteBox.Checked = NOT muteBox.Checked"" + NL" + NL
    t = t + "    t = t + ""            Mute_Change()"" + NL" + NL
    t = t + "    t = t + ""        CASE """"About SimPlayer"""""" + NL" + NL
    t = t + "    t = t + ""            box = GUI_MessageBox.New(win)"" + NL" + NL
    t = t + "    t = t + ""            box.Title = """"About SimPlayer"""""" + NL" + NL
    t = t + "    t = t + ""            box.Text = """"SimPlayer 1.0 for SIM95"""" + EOL + EOL + """"Plays SimMovies (.SMV) from your disk or the web, and streams the long ones while they download."""" + EOL + EOL + """"Find movies on SimTube."""""" + NL" + NL
    t = t + "    t = t + ""            box.Show()"" + NL" + NL
    t = t + "    t = t + ""    END SELECT"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    Put("C:\WEB\VAPOR\SIMPLAYR\3.TXT")
END SUB

SUB File9 ()
    t = ""
    t = t + "    t = t + ""' ================================================================ the seek bar"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Seek_OnDraw (canvas AS GUI_Canvas)"" + NL" + NL
    t = t + "    t = t + ""    DrawSeek()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB DrawSeek ()"" + NL" + NL
    t = t + "    t = t + ""    VAR w AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR t AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR x AS Integer"" + NL" + NL
    t = t + "    t = t + ""    w = seekBar.Width"" + NL" + NL
    t = t + "    t = t + ""    t = MATH.Max(1, Total() - 1)"" + NL" + NL
    t = t + "    t = t + ""    seekBar.Background = 7"" + NL" + NL
    t = t + "    t = t + ""    seekBar.Clear()"" + NL" + NL
    t = t + "    t = t + ""    seekBar.SetColor(8)"" + NL" + NL
    t = t + "    t = t + ""    seekBar.Line(0, 0, w - 1, 0)"" + NL" + NL
    t = t + "    t = t + ""    seekBar.Line(0, 0, 0, 13)"" + NL" + NL
    t = t + "    t = t + ""    seekBar.SetColor(15)"" + NL" + NL
    t = t + "    t = t + ""    seekBar.Line(0, 13, w - 1, 13)"" + NL" + NL
    t = t + "    t = t + ""    ' downloaded, and played"" + NL" + NL
    t = t + "    t = t + ""    IF HasMovie() THEN"" + NL" + NL
    t = t + "    t = t + ""        seekBar.SetColor(6)"" + NL" + NL
    t = t + "    t = t + ""        seekBar.FillRect(2, 5, Int((w - 4) * MATH.Min(1, (frames.Count - 1) / t)), 4)"" + NL" + NL
    t = t + "    t = t + ""        x = Int((w - 12) * MATH.Max(0, cur) / t)"" + NL" + NL
    t = t + "    t = t + ""        seekBar.SetColor(4)"" + NL" + NL
    t = t + "    t = t + ""        seekBar.FillRect(2, 5, x, 4)"" + NL" + NL
    t = t + "    t = t + ""        ' the thumb"" + NL" + NL
    t = t + "    t = t + ""        seekBar.SetColor(7)"" + NL" + NL
    t = t + "    t = t + ""        seekBar.FillRect(x + 1, 1, 10, 12)"" + NL" + NL
    t = t + "    t = t + ""        seekBar.SetColor(15)"" + NL" + NL
    t = t + "    t = t + ""        seekBar.Line(x + 1, 1, x + 10, 1)"" + NL" + NL
    t = t + "    t = t + ""        seekBar.Line(x + 1, 1, x + 1, 12)"" + NL" + NL
    t = t + "    t = t + ""        seekBar.SetColor(0)"" + NL" + NL
    t = t + "    t = t + ""        seekBar.Line(x + 1, 12, x + 10, 12)"" + NL" + NL
    t = t + "    t = t + ""        seekBar.Line(x + 10, 1, x + 10, 12)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION FrameAt (x AS Integer) AS Integer"" + NL" + NL
    t = t + "    t = t + ""    RETURN Int(MATH.Max(0, x - 6) * MATH.Max(1, Total() - 1) / MATH.Max(1, seekBar.Width - 12))"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Seek_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)"" + NL" + NL
    t = t + "    t = t + ""    dragging = TRUE"" + NL" + NL
    t = t + "    t = t + ""    SeekFrame(FrameAt(x))"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Seek_OnMouseMove (x AS Integer, y AS Integer)"" + NL" + NL
    t = t + "    t = t + ""    IF dragging THEN SeekFrame(FrameAt(x))"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Seek_OnMouseUp (x AS Integer, y AS Integer, button AS Integer)"" + NL" + NL
    t = t + "    t = t + ""    IF dragging THEN SeekFrame(FrameAt(x))"" + NL" + NL
    t = t + "    t = t + ""    dragging = FALSE"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' ================================================================ what it says"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION Clock (n AS Integer) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR s AS Integer"" + NL" + NL
    t = t + "    t = t + ""    s = Int(MATH.Max(0, n) / mFps)"" + NL" + NL
    t = t + "    t = t + ""    RETURN Str(Int(s / 60)) + """":"""" + Str(100 + s MOD 60).Substring(1, 2)"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Refresh ()"" + NL" + NL
    t = t + "    t = t + ""    VAR what AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR flag AS String"" + NL" + NL
    t = t + "    t = t + ""    SELECT CASE state"" + NL" + NL
    t = t + "    t = t + ""        CASE """"empty"""""" + NL" + NL
    t = t + "    t = t + ""            what = """"Ready. Open a SimMovie (.SMV) from your disk, or type its address."""""" + NL" + NL
    t = t + "    t = t + ""        CASE """"buffering"""""" + NL" + NL
    t = t + "    t = t + ""            what = """"Buffering... """" + Str(Percent()) + """"%"""""" + NL" + NL
    t = t + "    t = t + ""            IF NOT gotHeader THEN what = what + """"  (connecting to """" + HostOf(source) + """")"""""" + NL" + NL
    t = t + "    t = t + ""        CASE """"playing"""""" + NL" + NL
    t = t + "    t = t + ""            what = """"Playing"""""" + NL" + NL
    t = t + "    t = t + ""        CASE """"paused"""""" + NL" + NL
    t = t + "    t = t + ""            what = """"Paused"""""" + NL" + NL
    t = t + "    t = t + ""        CASE """"stopped"""""" + NL" + NL
    t = t + "    t = t + ""            what = """"Stopped"""""" + NL" + NL
    t = t + "    t = t + ""        CASE """"ended"""""" + NL" + NL
    t = t + "    t = t + ""            what = """"Finished"""""" + NL" + NL
    t = t + "    t = t + ""        CASE """"error"""""" + NL" + NL
    t = t + "    t = t + ""            what = problem"" + NL" + NL
    t = t + "    t = t + ""    END SELECT"" + NL" + NL
    t = t + "    t = t + ""    IF remote AND NOT allIn AND state <> """"buffering"""" AND state <> """"error"""" THEN what = what + """"  ("""" + Str(Percent()) + """"% downloaded)"""""" + NL" + NL
    t = t + "    t = t + ""    IF muteBox.Checked AND state <> """"error"""" THEN what = what + """"  [muted]"""""" + NL" + NL
    t = t + "    t = t + ""    win.Status = what"" + NL" + NL
    t = t + "    t = t + ""    IF state = """"playing"""" OR (state = """"buffering"""" AND wantPlay) THEN"" + NL" + NL
    t = t + "    t = t + ""        playBtn.Text = """"&Pause"""""" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        playBtn.Text = """"&Play"""""" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF gotHeader THEN"" + NL" + NL
    t = t + "    t = t + ""        info.Text = mTitle"" + NL" + NL
    t = t + "    t = t + ""        IF mAuthor <> """""""" THEN info.Text = mTitle + """"  -  by """" + mAuthor"" + NL" + NL
    t = t + "    t = t + ""        timeLabel.Text = Clock(MATH.Max(cur, 0)) + """" / """" + Clock(Total())"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        info.Text = """""""""" + NL" + NL
    t = t + "    t = t + ""        timeLabel.Text = """"0:00 / 0:00"""""" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    DrawSeek()"" + NL" + NL
    t = t + "    t = t + ""    flag = """"0|0"""""" + NL" + NL
    t = t + "    t = t + ""    IF loopBox.Checked THEN flag = """"1|0"""""" + NL" + NL
    t = t + "    t = t + ""    IF muteBox.Checked THEN flag = flag.Substring(0, 2) + """"1"""""" + NL" + NL
    t = t + "    t = t + ""    win.Tag = state + """"|"""" + Str(cur) + """"|"""" + Str(Total()) + """"|"""" + Str(frames.Count) + """"|"""" + Str(partsIn) + """"|"""" + Str(partRefs.Count) + """"|"""" + flag"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION HostOf (url AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR h AS String"" + NL" + NL
    t = t + "    t = t + ""    IF NOT url.Lower().StartsWith(""""http://"""") THEN RETURN url"" + NL" + NL
    t = t + "    t = t + ""    h = url.Substring(7, url.Length - 7)"" + NL" + NL
    t = t + "    t = t + ""    IF h.IndexOf(""""/"""") >= 0 THEN h = h.Substring(0, h.IndexOf(""""/""""))"" + NL" + NL
    t = t + "    t = t + ""    RETURN h"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' ================================================================ the web"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Fetcher_OnTick ()"" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        FetchStep()"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB FetchStep ()"" + NL" + NL
    t = t + "    t = t + ""    IF fetching THEN"" + NL" + NL
    t = t + "    t = t + ""        IF fDone OR SYS.Ticks - fSince > PATIENCE THEN Arrived()"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF NOT remote OR state = """"error"""" THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    IF wantFirst THEN"" + NL" + NL
    t = t + "    t = t + ""        ' a SimDNS name: ask first, in a tick of its own"" + NL" + NL
    t = t + "    t = t + ""        IF RsNext(HostOf(source)) THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""        wantFirst = FALSE"" + NL" + NL
    t = t + "    t = t + ""        fFirst = TRUE"" + NL" + NL
    t = t + "    t = t + ""        ' (last thing in the tick: it may be spoiled)"" + NL" + NL
    t = t + "    t = t + ""        StartFetch(source)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF partsIn < partRefs.Count THEN"" + NL" + NL
    t = t + "    t = t + ""        IF RsNext(HostOf(partRefs[partsIn])) THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""        fFirst = FALSE"" + NL" + NL
    t = t + "    t = t + ""        StartFetch(partRefs[partsIn])"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB StartFetch (url AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR conn AS NET_Connection"" + NL" + NL
    t = t + "    t = t + ""    VAR host AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR path AS String"" + NL" + NL
    t = t + "    t = t + ""    fetching = TRUE"" + NL" + NL
    t = t + "    t = t + ""    fUrl = url"" + NL" + NL
    t = t + "    t = t + ""    fNumber = fNumber + 1"" + NL" + NL
    t = t + "    t = t + ""    fParts.Clear()"" + NL" + NL
    t = t + "    t = t + ""    fDone = FALSE"" + NL" + NL
    t = t + "    t = t + ""    fError = """""""""" + NL" + NL
    t = t + "    t = t + ""    fSince = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    host = url.Substring(7, url.Length - 7)"" + NL" + NL
    t = t + "    t = t + ""    IF host.IndexOf(""""/"""") < 0 THEN host = host + """"/"""""" + NL" + NL
    t = t + "    t = t + ""    path = host.Substring(host.IndexOf(""""/""""), host.Length - host.IndexOf(""""/""""))"" + NL" + NL
    t = t + "    t = t + ""    host = host.Substring(0, host.IndexOf(""""/""""))"" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        conn = web.Connect(RsTarget(host), 80)"" + NL" + NL
    t = t + "    t = t + ""        conn.Tag = Str(fNumber)"" + NL" + NL
    t = t + "    t = t + ""        conn.Send(""""GET """" + path + """" HTTP/1.0"""" + EOL + """"Host: """" + host + EOL + """"User-Agent: SimPlayer/1.0 (SIM95)"""" + EOL + """"Accept: video/x-simmovie"""")"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""        fError = err"" + NL" + NL
    t = t + "    t = t + ""        fDone = TRUE"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Web_OnMessage (conn AS NET_Connection, message AS String)"" + NL" + NL
    t = t + "    t = t + ""    IF conn.Tag = Str(fNumber) AND NOT fDone THEN fParts.Add(message)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Web_OnClose (conn AS NET_Connection)"" + NL" + NL
    t = t + "    t = t + ""    IF conn.Tag = Str(fNumber) THEN fDone = TRUE"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' A fetch finished (or gave up): the body, or """""""" with fError saying why."" + NL" + NL
    t = t + "    t = t + ""FUNCTION Body () AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR raw AS String"" + NL" + NL
    t = t + "    t = t + ""    raw = fParts.Join(EOL)"" + NL" + NL
    t = t + "    t = t + ""    IF fError <> """""""" THEN RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""    IF raw = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        fError = """"no answer"""""" + NL" + NL
    t = t + "    t = t + ""        RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF NOT raw.StartsWith(""""HTTP/1.0 200"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        fError = raw.Lines()[0]"" + NL" + NL
    t = t + "    t = t + ""        RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF NOT raw.Contains(EOL + EOL) THEN RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""    RETURN raw.Substring(raw.IndexOf(EOL + EOL) + 2, raw.Length - raw.IndexOf(EOL + EOL) - 2)"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Arrived ()"" + NL" + NL
    t = t + "    t = t + ""    VAR text AS String"" + NL" + NL
    t = t + "    t = t + ""    fetching = FALSE"" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        web.Close()"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""    IF NOT remote OR source = """""""" THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    text = Body()"" + NL" + NL
    t = t + "    t = t + ""    IF text = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        tries = tries + 1"" + NL" + NL
    t = t + "    t = t + ""        IF fError = """""""" THEN fError = """"it was empty"""""" + NL" + NL
    t = t + "    t = t + ""        IF tries >= MAXTRIES OR fError.StartsWith(""""HTTP"""") THEN"" + NL" + NL
    t = t + "    t = t + ""            Fail(""""Could not get """" + fUrl + """" ("""" + fError + """")."""")"" + NL" + NL
    t = t + "    t = t + ""        ELSEIF fFirst THEN"" + NL" + NL
    t = t + "    t = t + ""            wantFirst = TRUE"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    tries = 0"" + NL" + NL
    t = t + "    t = t + ""    IF fFirst THEN"" + NL" + NL
    t = t + "    t = t + ""        TakeFirst(text, DirOf(fUrl))"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        AddPart(text)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' RESOLVE.SPK - the SimDNS resolver: asks the name server which machine a"" + NL" + NL
    t = t + "    t = t + ""' name like www.coolsite.sim is on."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' The name server is the central one, STARTHERE.56k.net, where SimNIC (the"" + NL" + NL
    t = t + "    t = t + ""' registrar) and NAMED.SPK run, unless C:\SYSTEM\RESOLV.INI says otherwise."" + NL" + NL
    t = t + "    t = t + ""' To move the whole network to another central host, change RSCENTRAL below"" + NL" + NL
    t = t + "    t = t + ""' (the builder sets it from CENTRAL in tools/simxplorer-source.mjs)."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' A library, not a program: a program has it joined on the end (the builder"" + NL" + NL
    t = t + "    t = t + ""' does this for Simxplorer, SimPlayer, Vapor, Frostbird, MAILD, the Sim Shell,"" + NL" + NL
    t = t + "    t = t + ""' AskSim's crawler, DIG and Personal Web Manager; copy C:\PROGRAMS\RESOLVE.SPK"" + NL" + NL
    t = t + "    t = t + ""' onto the end of your own). Every name in it starts with Rs, so it can't clash."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' C:\SYSTEM\RESOLV.INI, shared by every program on the machine (optional):"" + NL" + NL
    t = t + "    t = t + ""'     nameserver=dnsbox          another name server instead of the central one"" + NL" + NL
    t = t + "    t = t + ""'     nameserver=none            no SimDNS at all: SIM95 machine names only"" + NL" + NL
    t = t + "    t = t + ""'     search=coolsite.sim        then """"www"""" means www.coolsite.sim"" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' How to use it without ever waiting in the wrong place (SIM95-NOTES.md):"" + NL" + NL
    t = t + "    t = t + ""'   1. RsWants(host)  - does this name need asking? FALSE for addresses,"" + NL" + NL
    t = t + "    t = t + ""'                       plain machine names, names already known, or when"" + NL" + NL
    t = t + "    t = t + ""'                       there is no name server (or it isn't answering)."" + NL" + NL
    t = t + "    t = t + ""'   2. RsAsk(host, address) - sends the question to the name server at that"" + NL" + NL
    t = t + "    t = t + ""'                       address. It is a Connect: let it be the last thing"" + NL" + NL
    t = t + "    t = t + ""'                       the handler does."" + NL" + NL
    t = t + "    t = t + ""'   3. RsBusy()       - TRUE while the answer is on its way. After RSWAIT"" + NL" + NL
    t = t + "    t = t + ""'                       with no answer the server is left alone for RSQUIET,"" + NL" + NL
    t = t + "    t = t + ""'                       and every name goes to SIM95 as before."" + NL" + NL
    t = t + "    t = t + ""'   4. RsTarget(host) - where to connect: the machine name (or address) the"" + NL" + NL
    t = t + "    t = t + ""'                       name server gave, or the name itself when SimDNS"" + NL" + NL
    t = t + "    t = t + ""'                       doesn't know it, for SIM95 to look up."" + NL" + NL
    t = t + "    t = t + ""' Answers are kept for their TTL; names SimDNS doesn't know for RSNEG."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' Or, from a timer tick, all of that in one line (see RsNext):"" + NL" + NL
    t = t + "    t = t + ""'     IF RsNext(host) THEN RETURN          ' asked, or waiting: end the tick"" + NL" + NL
    t = t + "    t = t + ""'     conn = sock.Connect(RsTarget(host), 80)"" + NL" + NL
    t = t + "    t = t + ""' and for mail, the domain's MX first (see RsNextMail):"" + NL" + NL
    t = t + "    t = t + ""'     IF RsNextMail(domain) THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""'     conn = sock.Connect(RsMailTarget(domain), 25)"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""CONST RSCENTRAL = """"starthere.56k.net""""   ' the central name server"" + NL" + NL
    t = t + "    t = t + ""CONST RSINI = """"C:\SYSTEM\RESOLV.INI"""""" + NL" + NL
    t = t + "    t = t + ""CONST RSPORT = 53"" + NL" + NL
    t = t + "    t = t + ""CONST RSWAIT = 2000             ' ms to wait for an answer"" + NL" + NL
    t = t + "    t = t + ""CONST RSQUIET = 30000            ' ms to leave a silent name server alone"" + NL" + NL
    t = t + "    t = t + ""CONST RSNEG = 60000             ' ms to remember that SimDNS doesn't know a name"" + NL" + NL
    t = t + "    t = t + ""CONST RSMOST = 100              ' names kept"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""VAR rsServer AS String              ' """""""" when SimDNS is off"" + NL" + NL
    t = t + "    t = t + ""VAR rsByDefault AS Bool               ' TRUE when RESOLV.INI doesn't name one"" + NL" + NL
    t = t + "    t = t + ""VAR rsSearch AS String"" + NL" + NL
    t = t + "    t = t + ""VAR rsRead AS Bool"" + NL" + NL
    Put("C:\WEB\VAPOR\SIMPLAYR\4.TXT")
END SUB

SUB File10 ()
    t = ""
    t = t + "    t = t + ""VAR rsReadAt AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR rsSock AS NET_Socket"" + NL" + NL
    t = t + "    t = t + ""VAR rsName AS Array OF String       ' the name as asked, lower case"" + NL" + NL
    t = t + "    t = t + ""VAR rsTo AS Array OF String         ' where it is ("""""""" when SimDNS doesn't know it)"" + NL" + NL
    t = t + "    t = t + ""VAR rsCanon AS Array OF String      ' its last name in DNS before the machine"" + NL" + NL
    t = t + "    t = t + ""VAR rsUntil AS Array OF Integer     ' SYS.Ticks when it is forgotten"" + NL" + NL
    t = t + "    t = t + ""VAR rsAsking AS String"" + NL" + NL
    t = t + "    t = t + ""VAR rsAskAt AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR rsRefused AS Bool"" + NL" + NL
    t = t + "    t = t + ""VAR rsDown AS Bool"" + NL" + NL
    t = t + "    t = t + ""VAR rsDownAt AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR rsWhy AS String                 ' the last thing that went wrong"" + NL" + NL
    t = t + "    t = t + ""VAR rsLastReply AS String           ' the last answer, as it came"" + NL" + NL
    t = t + "    t = t + ""VAR rsServerAddr AS String          ' the name server's address, for RsNext"" + NL" + NL
    t = t + "    t = t + ""VAR rsServerFor AS String"" + NL" + NL
    t = t + "    t = t + ""VAR rsServerAt AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR rsLooking AS Bool               ' RsNext is finding the name server's address"" + NL" + NL
    t = t + "    t = t + ""VAR rsLookingAt AS Integer"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Reads RESOLV.INI (again after a few seconds, so a new setting takes)."" + NL" + NL
    t = t + "    t = t + ""' With no nameserver= line, the central name server; none (or nothing after"" + NL" + NL
    t = t + "    t = t + ""' the =) turns SimDNS off."" + NL" + NL
    t = t + "    t = t + ""SUB RsConfig ()"" + NL" + NL
    t = t + "    t = t + ""    VAR line AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR low AS String"" + NL" + NL
    t = t + "    t = t + ""    IF rsRead AND SYS.Ticks - rsReadAt < 3000 THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    rsRead = TRUE"" + NL" + NL
    t = t + "    t = t + ""    rsReadAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    rsServer = RSCENTRAL"" + NL" + NL
    t = t + "    t = t + ""    rsByDefault = TRUE"" + NL" + NL
    t = t + "    t = t + ""    rsSearch = """""""""" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        IF FS.Exists(RSINI) THEN"" + NL" + NL
    t = t + "    t = t + ""            FOR EACH line IN FS.Read(RSINI).Lines()"" + NL" + NL
    t = t + "    t = t + ""                low = line.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""                IF low.StartsWith(""""nameserver="""") THEN"" + NL" + NL
    t = t + "    t = t + ""                    rsServer = low.Substring(11, low.Length - 11).Trim()"" + NL" + NL
    t = t + "    t = t + ""                    rsByDefault = FALSE"" + NL" + NL
    t = t + "    t = t + ""                END IF"" + NL" + NL
    t = t + "    t = t + ""                IF low.StartsWith(""""search="""") THEN rsSearch = low.Substring(7, low.Length - 7).Trim()"" + NL" + NL
    t = t + "    t = t + ""            NEXT"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""    IF rsServer = """"none"""" THEN rsServer = """""""""" + NL" + NL
    t = t + "    t = t + ""    IF rsSearch.StartsWith(""""."""") THEN rsSearch = rsSearch.Substring(1, rsSearch.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""    IF rsSearch.EndsWith(""""."""") THEN rsSearch = rsSearch.Substring(0, rsSearch.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The name server (a machine name or address), or """""""" for none."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsNameServer () AS String"" + NL" + NL
    t = t + "    t = t + ""    RsConfig()"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsServer"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Is it the central one, because RESOLV.INI doesn't say?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsIsCentral () AS Bool"" + NL" + NL
    t = t + "    t = t + ""    RsConfig()"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsByDefault"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Makes server this machine's name server, keeping the rest of RESOLV.INI,"" + NL" + NL
    t = t + "    t = t + ""' and forgets everything it knew. """""""" (or none) for no SimDNS at all;"" + NL" + NL
    t = t + "    t = t + ""' default for the central one again."" + NL" + NL
    t = t + "    t = t + ""SUB RsSave (server AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR out AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR line AS String"" + NL" + NL
    t = t + "    t = t + ""    server = server.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    IF server = """""""" THEN server = """"none"""""" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        IF FS.Exists(RSINI) THEN"" + NL" + NL
    t = t + "    t = t + ""            FOR EACH line IN FS.Read(RSINI).Lines()"" + NL" + NL
    t = t + "    t = t + ""                IF line.Trim() <> """""""" AND NOT line.Trim().Lower().StartsWith(""""nameserver="""") THEN out.Add(line)"" + NL" + NL
    t = t + "    t = t + ""            NEXT"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        IF server <> """"default"""" THEN out.Insert(0, """"nameserver="""" + server)"" + NL" + NL
    t = t + "    t = t + ""        IF out.Count = 0 THEN"" + NL" + NL
    t = t + "    t = t + ""            IF FS.Exists(RSINI) THEN FS.Delete(RSINI)"" + NL" + NL
    t = t + "    t = t + ""        ELSE"" + NL" + NL
    t = t + "    t = t + ""            FS.Write(RSINI, out.Join(Chr(10)) + Chr(10))"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""        rsWhy = err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""    rsRead = FALSE"" + NL" + NL
    t = t + "    t = t + ""    RsForget()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB RsForget ()"" + NL" + NL
    t = t + "    t = t + ""    rsName.Clear()"" + NL" + NL
    t = t + "    t = t + ""    rsTo.Clear()"" + NL" + NL
    t = t + "    t = t + ""    rsCanon.Clear()"" + NL" + NL
    t = t + "    t = t + ""    rsUntil.Clear()"" + NL" + NL
    t = t + "    t = t + ""    rsDown = FALSE"" + NL" + NL
    t = t + "    t = t + ""    rsAsking = """""""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsIsAddress (s AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR p AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    IF s.Split(""""."""").Count <> 4 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    FOR EACH p IN s.Split(""""."""")"" + NL" + NL
    t = t + "    t = t + ""        IF p = """""""" OR p.Length > 3 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""        FOR i = 0 TO p.Length - 1"" + NL" + NL
    t = t + "    t = t + ""            IF NOT """"0123456789"""".Contains(p.CharAt(i)) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""        NEXT"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The name the server is asked about: lower case, the search domain added"" + NL" + NL
    t = t + "    t = t + ""' to a single word."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsFull (host AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR h AS String"" + NL" + NL
    t = t + "    t = t + ""    h = host.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    IF h.EndsWith(""""."""") THEN h = h.Substring(0, h.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""    IF NOT h.Contains(""""."""") AND rsSearch <> """""""" THEN h = h + """"."""" + rsSearch"" + NL" + NL
    t = t + "    t = t + ""    RETURN h"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Where a name is in the list of answers, or -1 (old answers are dropped)."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsFind (host AS String) AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = rsName.IndexOf(host.Trim().Lower())"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN -1"" + NL" + NL
    t = t + "    t = t + ""    IF SYS.Ticks > rsUntil[i] THEN"" + NL" + NL
    t = t + "    t = t + ""        rsName.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsTo.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsCanon.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsUntil.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        RETURN -1"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    RETURN i"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsWants (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    IF NOT RsAsks(host) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsFind(host) < 0"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The same for a mail domain's MX record."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsWantsMx (domain AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    IF NOT RsAsks(domain) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsFind(""""mx:"""" + domain.Trim().Lower()) < 0"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Is host a name for the name server at all (whether known yet or not)?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsAsks (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR h AS String"" + NL" + NL
    t = t + "    t = t + ""    RsConfig()"" + NL" + NL
    t = t + "    t = t + ""    h = host.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    IF rsServer = """""""" OR h = """""""" OR h = """"localhost"""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF rsDown AND SYS.Ticks - rsDownAt < RSQUIET THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF RsIsAddress(h) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF NOT h.Contains(""""."""") AND rsSearch = """""""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF h = rsServer OR h = NET.HostName.Lower() THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Sends the question. A Connect, so it must be the last thing its handler"" + NL" + NL
    t = t + "    t = t + ""' does: if the name server refuses, the handler is spoiled (SIM95-NOTES.md)."" + NL" + NL
    t = t + "    t = t + ""SUB RsAsk (host AS String, address AS String)"" + NL" + NL
    t = t + "    t = t + ""    RsSend(host.Trim().Lower(), """"A"""", address)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Asks for a mail domain's MX records (also a Connect: the last thing)."" + NL" + NL
    t = t + "    t = t + ""SUB RsAskMx (domain AS String, address AS String)"" + NL" + NL
    t = t + "    t = t + ""    RsSend(""""mx:"""" + domain.Trim().Lower(), """"MX"""", address)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' key is the name, or mx: and the name; the answer is kept under it."" + NL" + NL
    t = t + "    t = t + ""SUB RsSend (key AS String, qtype AS String, address AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR conn AS NET_Connection"" + NL" + NL
    t = t + "    t = t + ""    VAR name AS String"" + NL" + NL
    t = t + "    t = t + ""    IF IsNothing(rsSock) THEN"" + NL" + NL
    t = t + "    t = t + ""        rsSock = NET_Socket.New()"" + NL" + NL
    t = t + "    t = t + ""        rsSock.onMessage = Rs_OnMessage"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    name = key"" + NL" + NL
    t = t + "    t = t + ""    IF name.StartsWith(""""mx:"""") THEN name = name.Substring(3, name.Length - 3)"" + NL" + NL
    t = t + "    t = t + ""    rsAsking = key"" + NL" + NL
    t = t + "    t = t + ""    rsAskAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    rsRefused = FALSE"" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        conn = rsSock.Connect(address, RSPORT)"" + NL" + NL
    t = t + "    t = t + ""        conn.Tag = """"rs:"""" + key"" + NL" + NL
    t = t + "    t = t + ""        conn.Send(""""QUERY """" + RsFull(name) + """" """" + qtype)"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""        rsRefused = TRUE"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Gives up on the name server for a while: every name goes to SIM95."" + NL" + NL
    t = t + "    t = t + ""SUB RsGiveUp (why AS String)"" + NL" + NL
    t = t + "    t = t + ""    rsWhy = why"" + NL" + NL
    t = t + "    t = t + ""    rsDown = TRUE"" + NL" + NL
    t = t + "    t = t + ""    rsDownAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    rsAsking = """""""""" + NL" + NL
    t = t + "    t = t + ""    rsServerAddr = """""""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' For a program that fetches from a timer tick: TRUE when the tick must end"" + NL" + NL
    t = t + "    t = t + ""' now, because a question about host has just been sent (a Connect, so it"" + NL" + NL
    t = t + "    t = t + ""' has to be the last thing the handler does) or an answer is on its way."" + NL" + NL
    t = t + "    t = t + ""' FALSE when there is nothing to ask: RsTarget(host) is where to connect."" + NL" + NL
    t = t + "    t = t + ""' A name server that is missing, refuses or says nothing for RSWAIT is left"" + NL" + NL
    t = t + "    t = t + ""' alone for RSQUIET, and every name goes to SIM95: nothing ever hangs."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsNext (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsStep(host, FALSE)"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The same for mail to domain: its MX record (the lowest preference), then"" + NL" + NL
    t = t + "    t = t + ""' the CNAMEs or address of the machine that names. RsMailTarget(domain) is"" + NL" + NL
    t = t + "    t = t + ""' then where to connect; with no MX, the domain's own machine; with no"" + NL" + NL
    t = t + "    t = t + ""' answer at all, the domain itself, for SIM95 to look up."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsNextMail (domain AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    IF RsStep(domain, TRUE) THEN RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsStep(RsMailHost(domain), FALSE)"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsStep (host AS String, mx AS Bool) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR addr AS String"" + NL" + NL
    t = t + "    t = t + ""    ' another handler is finding the name server (it waits): wait for it"" + NL" + NL
    t = t + "    t = t + ""    IF rsLooking THEN"" + NL" + NL
    t = t + "    t = t + ""        IF SYS.Ticks - rsLookingAt < RSWAIT THEN RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""        rsLooking = FALSE"" + NL" + NL
    t = t + "    t = t + ""        RsGiveUp(""""no answer about the machine """" + rsServer)"" + NL" + NL
    t = t + "    t = t + ""        RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF RsBusy() THEN RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""    IF mx THEN"" + NL" + NL
    t = t + "    t = t + ""        IF NOT RsWantsMx(host) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        IF NOT RsWants(host) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    addr = RsServerAddress()"" + NL" + NL
    t = t + "    t = t + ""    IF addr = """""""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF mx THEN"" + NL" + NL
    t = t + "    t = t + ""        RsAskMx(host, addr)"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        RsAsk(host, addr)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The name server's address, looked up once a minute (one lookup at a time:"" + NL" + NL
    t = t + "    t = t + ""' see SIM95-NOTES.md). """""""" when there is no such machine, and then it gives up."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsServerAddress () AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR addr AS String"" + NL" + NL
    t = t + "    t = t + ""    IF RsIsAddress(rsServer) THEN RETURN rsServer"" + NL" + NL
    t = t + "    t = t + ""    IF rsServerAddr <> """""""" AND rsServerFor = rsServer AND SYS.Ticks - rsServerAt < 60000 AND SYS.Ticks >= rsServerAt THEN RETURN rsServerAddr"" + NL" + NL
    t = t + "    t = t + ""    rsLooking = TRUE"" + NL" + NL
    t = t + "    t = t + ""    rsLookingAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    addr = NET.Resolve(rsServer)"" + NL" + NL
    t = t + "    t = t + ""    IF NOT rsLooking THEN RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""    rsLooking = FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF addr = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        RsGiveUp(""""there is no machine called """" + rsServer)"" + NL" + NL
    t = t + "    t = t + ""        RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    rsServerAddr = addr"" + NL" + NL
    t = t + "    t = t + ""    rsServerFor = rsServer"" + NL" + NL
    t = t + "    t = t + ""    rsServerAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    RETURN addr"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsBusy () AS Bool"" + NL" + NL
    t = t + "    t = t + ""    IF rsAsking = """""""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF rsRefused THEN"" + NL" + NL
    t = t + "    t = t + ""        RsGiveUp(""""the name server """" + rsServer + """" refused"""")"" + NL" + NL
    t = t + "    t = t + ""        RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF SYS.Ticks - rsAskAt > RSWAIT THEN"" + NL" + NL
    t = t + "    t = t + ""        RsGiveUp(""""no answer from the name server """" + rsServer)"" + NL" + NL
    t = t + "    t = t + ""        RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Rs_OnMessage (conn AS NET_Connection, message AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR h AS String"" + NL" + NL
    t = t + "    t = t + ""    IF NOT conn.Tag.StartsWith(""""rs:"""") THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    h = conn.Tag.Substring(3, conn.Tag.Length - 3)"" + NL" + NL
    Put("C:\WEB\VAPOR\SIMPLAYR\5.TXT")
END SUB

SUB File11 ()
    t = ""
    t = t + "    t = t + ""    conn.Tag = """""""""" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        conn.Close()"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""    RsTake(h, message)"" + NL" + NL
    t = t + "    t = t + ""    IF h = rsAsking THEN rsAsking = """""""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Learns an answer: follows its CNAMEs to an address, or to the machine"" + NL" + NL
    t = t + "    t = t + ""' name the chain ends at."" + NL" + NL
    t = t + "    t = t + ""SUB RsTake (host AS String, reply AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR lines AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR w AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR cur AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR onward AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR target AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR canon AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR ttl AS Integer = 3600"" + NL" + NL
    t = t + "    t = t + ""    VAR hops AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    rsLastReply = reply"" + NL" + NL
    t = t + "    t = t + ""    IF host.StartsWith(""""mx:"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        RsTakeMx(host, reply)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    lines = reply.Lines()"" + NL" + NL
    t = t + "    t = t + ""    IF lines.Count = 0 THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    IF lines[0].StartsWith(""""NXDOMAIN"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(host, """""""", """"NXDOMAIN"""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF NOT lines[0].StartsWith(""""OK"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        rsWhy = lines[0]"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(host, """""""", """""""", 10000)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    cur = RsFull(host)"" + NL" + NL
    t = t + "    t = t + ""    canon = cur"" + NL" + NL
    t = t + "    t = t + ""    FOR hops = 0 TO 8"" + NL" + NL
    t = t + "    t = t + ""        onward = """""""""" + NL" + NL
    t = t + "    t = t + ""        FOR i = 1 TO lines.Count - 1"" + NL" + NL
    t = t + "    t = t + ""            w = lines[i].Split("""" """")"" + NL" + NL
    t = t + "    t = t + ""            IF w.Count >= 4 THEN"" + NL" + NL
    t = t + "    t = t + ""                IF w[0] = cur AND w[2] = """"A"""" AND target = """""""" THEN target = w[3]"" + NL" + NL
    t = t + "    t = t + ""                IF w[0] = cur AND w[2] = """"CNAME"""" THEN onward = w[3]"" + NL" + NL
    t = t + "    t = t + ""                IF w[0] = cur AND (w[2] = """"A"""" OR w[2] = """"CNAME"""") AND Int(Val(w[1])) < ttl THEN ttl = Int(Val(w[1]))"" + NL" + NL
    t = t + "    t = t + ""            END IF"" + NL" + NL
    t = t + "    t = t + ""        NEXT"" + NL" + NL
    t = t + "    t = t + ""        IF target <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""            canon = cur"" + NL" + NL
    t = t + "    t = t + ""            BREAK"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        IF onward = """""""" THEN BREAK"" + NL" + NL
    t = t + "    t = t + ""        canon = cur"" + NL" + NL
    t = t + "    t = t + ""        cur = onward"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    IF target = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        ' a name with no CNAME and no address: not one to connect to"" + NL" + NL
    t = t + "    t = t + ""        IF cur = RsFull(host) THEN"" + NL" + NL
    t = t + "    t = t + ""            RsKeep(host, """""""", """""""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""            RETURN"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        ' the end of the chain: a SIM95 machine name"" + NL" + NL
    t = t + "    t = t + ""        target = cur"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF ttl < 5 THEN ttl = 5"" + NL" + NL
    t = t + "    t = t + ""    RsKeep(host, target, canon, ttl * 1000)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Learns an MX answer: the mail machine with the lowest preference. With no"" + NL" + NL
    t = t + "    t = t + ""' MX, the server answers with the domain's CNAMEs instead, and the domain's"" + NL" + NL
    t = t + "    t = t + ""' own machine takes the mail."" + NL" + NL
    t = t + "    t = t + ""SUB RsTakeMx (key AS String, reply AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR domain AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR lines AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR w AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR best AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR pref AS Integer = 1000000"" + NL" + NL
    t = t + "    t = t + ""    VAR ttl AS Integer = 3600"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    domain = key.Substring(3, key.Length - 3)"" + NL" + NL
    t = t + "    t = t + ""    lines = reply.Lines()"" + NL" + NL
    t = t + "    t = t + ""    IF lines.Count = 0 THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    IF lines[0].StartsWith(""""NXDOMAIN"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, """""""", """"NXDOMAIN"""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(domain, """""""", """"NXDOMAIN"""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF NOT lines[0].StartsWith(""""OK"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        rsWhy = lines[0]"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, """""""", """""""", 10000)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 1 TO lines.Count - 1"" + NL" + NL
    t = t + "    t = t + ""        w = lines[i].Split("""" """")"" + NL" + NL
    t = t + "    t = t + ""        IF w.Count >= 5 THEN"" + NL" + NL
    t = t + "    t = t + ""            IF w[2] = """"MX"""" AND Int(Val(w[3])) < pref THEN"" + NL" + NL
    t = t + "    t = t + ""                pref = Int(Val(w[3]))"" + NL" + NL
    t = t + "    t = t + ""                best = w[4]"" + NL" + NL
    t = t + "    t = t + ""                ttl = Int(Val(w[1]))"" + NL" + NL
    t = t + "    t = t + ""            END IF"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    IF best <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        IF best.EndsWith(""""."""") THEN best = best.Substring(0, best.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""        IF ttl < 5 THEN ttl = 5"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, best, RsFull(domain), ttl * 1000)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    RsTake(domain, reply)"" + NL" + NL
    t = t + "    t = t + ""    IF RsKnown(domain) THEN"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, domain, RsFull(domain), RSNEG)"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, """""""", """""""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The machine (or name) that takes domain's mail: its MX, or domain itself."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsMailHost (domain AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(""""mx:"""" + domain.Trim().Lower())"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN domain"" + NL" + NL
    t = t + "    t = t + ""    IF rsTo[i] = """""""" THEN RETURN domain"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsTo[i]"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Where to connect for domain's mail."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsMailTarget (domain AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsTarget(RsMailHost(domain))"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Did SimDNS say where domain's mail goes (an MX, or the domain's machine)?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsMailKnown (domain AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(""""mx:"""" + domain.Trim().Lower())"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF rsTo[i] = """""""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsKnown(RsMailHost(domain)) OR NOT RsAsks(RsMailHost(domain))"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB RsKeep (host AS String, target AS String, canon AS String, ms AS Integer)"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR h AS String"" + NL" + NL
    t = t + "    t = t + ""    h = host.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    i = rsName.IndexOf(h)"" + NL" + NL
    t = t + "    t = t + ""    IF i >= 0 THEN"" + NL" + NL
    t = t + "    t = t + ""        rsName.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsTo.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsCanon.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsUntil.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF rsName.Count >= RSMOST THEN"" + NL" + NL
    t = t + "    t = t + ""        rsName.RemoveAt(0)"" + NL" + NL
    t = t + "    t = t + ""        rsTo.RemoveAt(0)"" + NL" + NL
    t = t + "    t = t + ""        rsCanon.RemoveAt(0)"" + NL" + NL
    t = t + "    t = t + ""        rsUntil.RemoveAt(0)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    rsName.Add(h)"" + NL" + NL
    t = t + "    t = t + ""    rsTo.Add(target)"" + NL" + NL
    t = t + "    t = t + ""    rsCanon.Add(canon)"" + NL" + NL
    t = t + "    t = t + ""    rsUntil.Add(SYS.Ticks + ms)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Where to connect for host: what SimDNS said, or host itself."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsTarget (host AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(host)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN host"" + NL" + NL
    t = t + "    t = t + ""    IF rsTo[i] = """""""" THEN RETURN host"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsTo[i]"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The name host's machine was found under (www.coolsite.sim), or host."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsCanonical (host AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(host)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN host"" + NL" + NL
    t = t + "    t = t + ""    IF rsTo[i] = """""""" THEN RETURN host"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsCanon[i]"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Did SimDNS answer for host (so RsTarget is its machine)?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsKnown (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(host)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsTo[i] <> """""""""" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Did the name server say there is no such name (NXDOMAIN)?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsNoSuchName (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(host)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsTo[i] = """""""" AND rsCanon[i] = """"NXDOMAIN"""""" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Is the name server being left alone, because it didn't answer (or there"" + NL" + NL
    t = t + "    t = t + ""' is none)? rsWhy says why."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsSilent () AS Bool"" + NL" + NL
    t = t + "    t = t + ""    RsConfig()"" + NL" + NL
    t = t + "    t = t + ""    IF rsServer = """""""" THEN RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsDown AND SYS.Ticks - rsDownAt < RSQUIET"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    Put(""C:\PROGRAMS\PLAYER.SPK"")" + NL
    t = t + "END SUB" + NL
    Put("C:\WEB\VAPOR\SIMPLAYR\6.TXT")
END SUB

SUB File12 ()
    t = ""
    t = t + "' VAPOR|id=SIMWEB|name=simweb|kind=program|version=b0fb52c6|category=Internet|run=C:\PROGRAMS\PWM.SPK|files=C:\PROGRAMS\PWM.SPK;C:\PROGRAMS\DIG.SPK;C:\PROGRAMS\RESOLVE.SPK|tasks=PWM|startup=|folder=|about=Personal Web Manager and a web server that serves many sites by name: coolsite.sim for your own pages, coolbook.sim for SimBook. Register and point the names at SimNIC; then add them here. With DIG, to ask the name server." + NL
    t = t + "' INSTALL.SPK - puts simweb on this machine. Generated by tools/build-installer.mjs;" + NL
    t = t + "' edit the files in simweb/ and rebuild rather than editing this." + NL
    t = t + "'" + NL
    t = t + "' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It replaces the web" + NL
    t = t + "' server with one that serves several sites by name (C:\WEB\VHOSTS.TXT), and" + NL
    t = t + "' writes Personal Web Manager (C:\PROGRAMS\PWM.SPK), which keeps that list:" + NL
    t = t + "' coolsite.sim for your own pages in C:\WEB\SITES, coolbook.sim for SimBook," + NL
    t = t + "' book.coolsite.sim... It also writes DIG.SPK (ask the name server) and" + NL
    t = t + "' RESOLVE.SPK (the resolver, for your own programs). The old web server is kept" + NL
    t = t + "' as C:\PROGRAMS\HTTPD.ORG and comes back when simweb is uninstalled. Names" + NL
    t = t + "' themselves are registered, and pointed at this machine, at SimNIC:" + NL
    t = t + "' http://starthere.56k.net/nic/" + NL
    t = t + "" + NL
    t = t + "VAR t AS String" + NL
    t = t + "VAR NL AS String" + NL
    t = t + "VAR intoDir AS String   ' """" for the web root, or the folder this web app goes in" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    NL = Chr(10)" + NL
    t = t + "" + NL
    t = t + "" + NL
    t = t + "" + NL
    t = t + "    WebSetup()" + NL
    t = t + "    File0()" + NL
    t = t + "    File1()" + NL
    t = t + "    File2()" + NL
    t = t + "    File3()" + NL
    t = t + "    Print(""simweb is installed (4 files)."")" + NL
    t = t + "    RestartWeb()" + NL
    t = t + "    SYS.Start(""C:\PROGRAMS\PWM.SPK"", """")" + NL
    t = t + "" + NL
    t = t + "    Print(""Personal Web Manager is open. Next time, start C:\PROGRAMS\PWM.SPK from Files."")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where a file goes: in this web app's folder, on a machine that keeps them in folders." + NL
    t = t + "FUNCTION Dest (path AS String) AS String" + NL
    t = t + "    IF intoDir <> """" AND path.Upper().StartsWith(""C:\WEB\"") THEN RETURN ""C:\WEB\"" + intoDir + ""\"" + path.Substring(7, path.Length - 7)" + NL
    t = t + "    RETURN path" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Put (path AS String)" + NL
    t = t + "    FS.Write(Dest(path), t)" + NL
    t = t + "    Print(""  wrote "" + Dest(path))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB File0 ()" + NL
    t = t + "    t = """"" + NL
    t = t + "    t = t + ""' PWM.SPK - Personal Web Manager: this machine's web sites, the way Windows 98's"" + NL" + NL
    t = t + "    t = t + ""' Personal Web Server had them. For the machine's owner, so no password."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' The web server (simweb's HTTPD.SPK) serves a site for each name listed in"" + NL" + NL
    t = t + "    t = t + ""' C:\WEB\VHOSTS.TXT, one a line, name|folder:"" + NL" + NL
    t = t + "    t = t + ""'     coolsite.sim|C:\WEB\SITES\COOLSITE        your own pages"" + NL" + NL
    t = t + "    t = t + ""'     www.coolsite.sim|C:\WEB\SITES\COOLSITE    (the same, with www.)"" + NL" + NL
    t = t + "    t = t + ""'     coolbook.sim|C:\WEB\BOOK                  one of this machine's web apps"" + NL" + NL
    t = t + "    t = t + ""'     book.coolsite.sim|C:\WEB\BOOK"" + NL" + NL
    t = t + "    t = t + ""' This program keeps that list: Add, Edit and Remove a site, and give the"" + NL" + NL
    t = t + "    t = t + ""' machine's apps names under a domain (book.coolsite.sim, mail...). Lines it"" + NL" + NL
    t = t + "    t = t + ""' doesn't know (comments, *.dab.sim) are kept as they are."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' A name works in Simxplorer only once it points at this machine at SimNIC"" + NL" + NL
    t = t + "    t = t + ""' (http://starthere.56k.net/nic/), so each site's name is asked about: the"" + NL" + NL
    t = t + "    t = t + ""' resolver (simweb/src/RESOLVE.SPK, the Rs... names, joined on by the builder)"" + NL" + NL
    t = t + "    t = t + ""' asks the name server, one name a timer tick, the question the last thing the"" + NL" + NL
