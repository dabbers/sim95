' INSTALL.SPK - puts Vapor on this machine. Generated by tools/build-installer.mjs;
' edit the files in vapor/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It makes this
' machine a Vapor games store: the store's files go in C:\WEB\VAPOR (the web
' server hands them out at http://YOURNAME/vapor/), with every game cut into
' parts that fit a network message. It also puts the Vapor program in
' C:\PROGRAMS\VAPOR.SPK and starts it. Other machines get Vapor from the
' store's page, and download games from it. Your home page is not touched.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)

    IF NOT FS.Exists(Dest("C:\WEB\VAPOR")) THEN FS.MakeDir(Dest("C:\WEB\VAPOR"))
    IF NOT FS.Exists(Dest("C:\WEB\VAPOR\VAPOR")) THEN FS.MakeDir(Dest("C:\WEB\VAPOR\VAPOR"))
    IF NOT FS.Exists(Dest("C:\WEB\VAPOR\SIMDOOM")) THEN FS.MakeDir(Dest("C:\WEB\VAPOR\SIMDOOM"))
    IF NOT FS.Exists(Dest("C:\WEB\VAPOR\SNAKE")) THEN FS.MakeDir(Dest("C:\WEB\VAPOR\SNAKE"))


    File0()
    File1()
    File2()
    File3()
    File4()
    File5()
    File6()
    File7()
    File8()
    File9()
    File10()
    Print("Vapor is installed (11 files).")
    SYS.Start("C:\PROGRAMS\VAPOR.SPK", "")

    Print("Vapor is running, and this machine is a store: http://" + NET.HostName.Lower() + "/vapor/")
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "<%" + NL
    t = t + "' GETVAPOR.ASP - the program that fetches Vapor, as plain text, ready to save" + NL
    t = t + "' as C:\MYFILES\GETVAPOR.SPK (Simxplorer: File > Save As File)." + NL
    t = t + "RESPONSE.ContentType = ""text/plain""" + NL
    t = t + "RESPONSE.Write(FS.Read(""C:\WEB\VAPOR\GETVAPOR.TXT"").Replace(""%HOST%"", SERVER.Name.Lower()))" + NL
    t = t + "%>" + NL
    Put("C:\WEB\VAPOR\GETVAPOR.ASP")
END SUB

SUB File1 ()
    t = ""
    t = t + "' GETVAPOR.SPK - copies Vapor from the store on %HOST% and starts it." + NL
    t = t + "' Save it as C:\MYFILES\GETVAPOR.SPK, open it in SPARK and press F5." + NL
    t = t + "CONST FROM = ""%HOST%""" + NL
    t = t + "VAR web AS NET_Socket" + NL
    t = t + "VAR parts AS Array OF String" + NL
    t = t + "VAR done AS Bool" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    ' a failed Connect spoils the handler it happens in, so all of it sits in a TRY" + NL
    t = t + "    TRY" + NL
    t = t + "        Install()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Install ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR count AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR piece AS String" + NL
    t = t + "    web = NET_Socket.New()" + NL
    t = t + "    web.onMessage = Web_OnMessage" + NL
    t = t + "    web.onClose = Web_OnClose" + NL
    t = t + "    Print(""Fetching Vapor from "" + FROM + ""..."")" + NL
    t = t + "    FOR EACH line IN Fetch(""/vapor/catalog.txt"").Lines()" + NL
    t = t + "        IF line.StartsWith(""VAPOR|"") THEN count = Int(Val(line.Split(""|"")[2]))" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF count = 0 THEN" + NL
    t = t + "        Print(""There is no Vapor in the store on "" + FROM + ""."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 1 TO count" + NL
    t = t + "        piece = Fetch(""/vapor/vapor/"" + Str(i) + "".txt"")" + NL
    t = t + "        IF piece = """" THEN RETURN" + NL
    t = t + "        text = text + piece" + NL
    t = t + "        Print(""  part "" + Str(i) + "" of "" + Str(count))" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Write(""C:\PROGRAMS\VAPOR.SPK"", text)" + NL
    t = t + "    IF NOT FS.Exists(""C:\GAMES"") THEN FS.MakeDir(""C:\GAMES"")" + NL
    t = t + "    FS.Write(""C:\GAMES\VAPOR.INI"", ""store=http://"" + FROM + ""/vapor/"" + Chr(10))" + NL
    t = t + "    Print(""Vapor is installed in C:\PROGRAMS\VAPOR.SPK. Starting it..."")" + NL
    t = t + "    SYS.Run(""C:\PROGRAMS\VAPOR.SPK"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One file over the web, read through the socket's events (see SIM95-NOTES.md)." + NL
    t = t + "FUNCTION Fetch (path AS String) AS String" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR raw AS String" + NL
    t = t + "    VAR since AS Integer" + NL
    t = t + "    parts.Clear()" + NL
    t = t + "    done = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = web.Connect(FROM, 80)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        Print(""Could not reach "" + FROM + "": "" + err)" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END TRY" + NL
    t = t + "    conn.Send(""GET "" + path + "" HTTP/1.0"" + Chr(10) + ""Host: "" + FROM)" + NL
    t = t + "    since = SYS.Ticks" + NL
    t = t + "    WHILE NOT done AND SYS.Ticks - since < 10000" + NL
    t = t + "        SYS.Sleep(50)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    raw = parts.Join(Chr(10))" + NL
    t = t + "    IF NOT raw.StartsWith(""HTTP/1.0 200"") THEN" + NL
    t = t + "        Print(""Could not fetch "" + path)" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN raw.Substring(raw.IndexOf(Chr(10) + Chr(10)) + 2, raw.Length - raw.IndexOf(Chr(10) + Chr(10)) - 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    parts.Add(message)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnClose (conn AS NET_Connection)" + NL
    t = t + "    done = TRUE" + NL
    t = t + "END SUB" + NL
    Put("C:\WEB\VAPOR\GETVAPOR.TXT")
END SUB

SUB File2 ()
    t = ""
    t = t + "<%" + NL
    t = t + "' INDEX.ASP - the Vapor store's web site (http://<machine>/vapor/): download" + NL
    t = t + "' Vapor, and see what is on the shelves." + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR p AS Array OF String" + NL
    t = t + "VAR here AS String" + NL
    t = t + "VAR apps AS String" + NL
    t = t + "VAR games AS String" + NL
    t = t + "VAR row AS String" + NL
    t = t + "VAR client AS String" + NL
    t = t + "VAR kind AS String" + NL
    t = t + "here = SERVER.Name.Lower()" + NL
    t = t + "IF FS.Exists(""C:\WEB\VAPOR\CATALOG.TXT"") THEN" + NL
    t = t + "    FOR EACH line IN FS.Read(""C:\WEB\VAPOR\CATALOG.TXT"").Lines()" + NL
    t = t + "        p = line.Split(""|"")" + NL
    t = t + "        IF p.Count < 7 THEN CONTINUE" + NL
    t = t + "        kind = ""game""" + NL
    t = t + "        IF p.Count > 7 THEN kind = p[7]" + NL
    t = t + "        IF kind = ""client"" THEN" + NL
    t = t + "            client = ""build "" + p[8]" + NL
    t = t + "            CONTINUE" + NL
    t = t + "        END IF" + NL
    t = t + "        row = ""<tr><td bgcolor=""""#1B2838"""" valign=""""top""""><font color=""""#66C0F4""""><b>"" + SERVER.HtmlEncode(p[1]) + ""</b></font><br><font size=""""2"""" color=""""#C7D5E0"""">"" + SERVER.HtmlEncode(p[6].Replace(""%0A"", "" "").Replace(""%7C"", ""|"").Replace(""%25"", ""%"")) + ""</font></td>""" + NL
    t = t + "        IF p[4] = ""soon"" THEN" + NL
    t = t + "            row = row + ""<td bgcolor=""""#1B2838"""" align=""""right"""" valign=""""top"""" width=""""140""""><font color=""""#8F98A0"""">Coming soon</font></td></tr>""" + NL
    t = t + "        ELSE" + NL
    t = t + "            row = row + ""<td bgcolor=""""#1B2838"""" align=""""right"""" valign=""""top"""" width=""""140""""><font color=""""#A4D007""""><b>Free</b></font><br><font size=""""1"""" color=""""#8F98A0"""">"" + SERVER.HtmlEncode(p[5]) + "", "" + Str(Int(Val(p[3]) / 1024) + 1) + "" KB""" + NL
    t = t + "            IF p.Count > 8 THEN row = row + ""<br>build "" + p[8]" + NL
    t = t + "            row = row + ""</font></td></tr>""" + NL
    t = t + "        END IF" + NL
    t = t + "        IF kind = ""game"" THEN" + NL
    t = t + "            games = games + row" + NL
    t = t + "        ELSE" + NL
    t = t + "            apps = apps + row" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END IF" + NL
    t = t + "%><html><head><title>Vapor - games and apps for SIM95</title>" + NL
    t = t + "<meta name=""description"" content=""Download Vapor, the store for SIM95: free games like SimDOOM and Snake 95, and apps like Simxplorer, Frostbird, Clippy and SimBook, with updates, a library, play time and achievements."">" + NL
    t = t + "<meta name=""keywords"" content=""download, vapor, steam, games, video games, game store, app store, apps, software, programs, free downloads, updates, doom, browser, email, mail client, clippy, social network"">" + NL
    t = t + "</head>" + NL
    t = t + "<body bgcolor=""#171A21"" text=""#C7D5E0"" link=""#66C0F4"" vlink=""#66C0F4"">" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td bgcolor=""#171A21"">" + NL
    t = t + "<font size=""6"" color=""#FFFFFF""><b>VAPOR</b></font> <font color=""#66C0F4"">store on <%= here %></font></td>" + NL
    t = t + "<td bgcolor=""#171A21"" align=""right""><font size=""2""><a href=""#download"">Download</a> &middot; <a href=""#apps"">Apps</a> &middot; <a href=""#games"">Games</a></font></td></tr></table>" + NL
    t = t + "" + NL
    t = t + "<a name=""download""></a>" + NL
    t = t + "<table width=""100%"" cellpadding=""14"" cellspacing=""0""><tr><td bgcolor=""#2A475E"">" + NL
    t = t + "<font size=""5"" color=""#FFFFFF""><b>Get Vapor</b></font><br>" + NL
    t = t + "<font color=""#C7D5E0"">Games, programs and web apps for SIM95, in one place. Install with a click, keep everything up to date, count your hours, collect achievements.</font>" + NL
    t = t + "<p><font color=""#FFFFFF""><b>1.</b></font> Open <a href=""getvapor.asp""><b>getvapor.asp</b></a> in Simxplorer and choose <b>File &gt; Save As File</b>; save it as <tt>C:\MYFILES\GETVAPOR.SPK</tt>." + NL
    t = t + "<font size=""2"" color=""#8F98A0"">(In Voyager: View Source, then save it from Notes.)</font><br>" + NL
    t = t + "<font color=""#FFFFFF""><b>2.</b></font> Open <tt>GETVAPOR.SPK</tt> in SPARK and press <b>F5</b>. It downloads Vapor, already pointed at this store, and starts it.</p>" + NL
    t = t + "<font size=""2"" color=""#8F98A0"">Or copy the program from the bottom of this page into SPARK. Vapor <%= client %>.</font>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "" + NL
    t = t + "<a name=""apps""></a>" + NL
    t = t + "<h3><font color=""#FFFFFF"">Apps</font></h3>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""2""><%= apps %></table>" + NL
    t = t + "<% IF apps = """" THEN %><p><font size=""2"" color=""#8F98A0"">No apps on the shelves yet. The store's keeper can add them: save any app's INSTALL.SPK in C:\MYFILES on <%= here %>, then Vapor &gt; Publish Apps.</font></p><% END IF %>" + NL
    t = t + "" + NL
    t = t + "<a name=""games""></a>" + NL
    t = t + "<h3><font color=""#FFFFFF"">Games</font></h3>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""2""><%= games %></table>" + NL
    t = t + "" + NL
    t = t + "<h3><font color=""#FFFFFF"">GETVAPOR.SPK</font></h3>" + NL
    t = t + "<table width=""100%"" cellpadding=""6""><tr><td bgcolor=""#000000""><pre><font color=""#A4D007""><%= SERVER.HtmlEncode(FS.Read(""C:\WEB\VAPOR\GETVAPOR.TXT"").Replace(""%HOST%"", here)) %></font></pre></td></tr></table>" + NL
    t = t + "<p><font size=""2"" color=""#8F98A0"">Run your own store: any machine where Vapor's INSTALL.SPK ran is one. Keep its shelves stocked" + NL
    t = t + "and up to date with Publish Apps. Half-Life 3 is coming soon.</font></p>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\VAPOR\INDEX.ASP")
END SUB

SUB File3 ()
    t = ""
    t = t + "' VAPOR|id=SIMDOOM|name=SimDOOM|kind=game|version=c0f9cfa6|category=Shooter|run=C:\GAMES\SIMDOOM\SIMDOOM.SPK|files=C:\GAMES\SIMDOOM\SIMDOOM.SPK|tasks=SIMDOOM|startup=|folder=|about=Rip and tear through E1M1 in glorious 16 colours. A real raycast 3D view, imps that chase you, a pistol, health and ammo, a face that watches you, and achievements. Type IDDQD at your own risk." + NL
    t = t + "' SIMDOOM.SPK - SimDOOM, episode one, map one: a raycaster on a GUI_Canvas." + NL
    t = t + "'" + NL
    t = t + "' Walk with the arrow keys (or W A S D), fire with Space or Ctrl, use with" + NL
    t = t + "' E or Enter. Find the green switch to finish the level. Kill everything if" + NL
    t = t + "' you like; Vapor shows the achievements." + NL
    t = t + "'" + NL
    t = t + "' The 3D view is the classic grid raycaster: for each of 80 columns a ray" + NL
    t = t + "' walks the map a square at a time until it hits a wall, and the distance" + NL
    t = t + "' says how tall to draw that slice. Things (imps, health, ammo) are" + NL
    t = t + "' billboards, drawn back to front and clipped by each column's wall distance." + NL
    t = t + "' It draws only when something changes, so a still screen costs nothing." + NL
    t = t + "" + NL
    t = t + "CONST COLS = 80                ' rays: each is 4 pixels of the 320-pixel view" + NL
    t = t + "CONST VIEWH = 160" + NL
    t = t + "CONST HUDH = 40" + NL
    t = t + "CONST MAPW = 16" + NL
    t = t + "CONST MAPH = 16" + NL
    t = t + "CONST ACHFILE = ""C:\GAMES\SIMDOOM\ACHIEVE.TXT""" + NL
    t = t + "" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR screen AS GUI_Canvas" + NL
    t = t + "VAR clock AS GUI_Timer" + NL
    t = t + "VAR map AS Array OF String" + NL
    t = t + "" + NL
    t = t + "' the player" + NL
    t = t + "VAR px AS Real" + NL
    t = t + "VAR py AS Real" + NL
    t = t + "VAR dirX AS Real" + NL
    t = t + "VAR dirY AS Real" + NL
    t = t + "VAR planeX AS Real" + NL
    t = t + "VAR planeY AS Real" + NL
    t = t + "VAR health AS Integer" + NL
    t = t + "VAR ammo AS Integer" + NL
    t = t + "VAR kills AS Integer" + NL
    t = t + "VAR started AS Integer" + NL
    t = t + "VAR hurtUntil AS Integer" + NL
    t = t + "VAR flashUntil AS Integer" + NL
    t = t + "VAR state AS String = ""title""     ' title, play, dead, won" + NL
    t = t + "VAR dirty AS Bool = TRUE" + NL
    t = t + "VAR faceLook AS Integer" + NL
    t = t + "VAR typed AS String                ' the last letters typed, for the cheat codes" + NL
    t = t + "VAR god AS Bool" + NL
    t = t + "VAR warp AS Bool                   ' -warp: start next to the exit, as DOOM's -warp did" + NL
    t = t + "" + NL
    t = t + "' things: imps, health and ammo, by kind (imp, deadimp, health, ammo)" + NL
    t = t + "VAR tKind AS Array OF String" + NL
    t = t + "VAR tX AS Array OF Real" + NL
    t = t + "VAR tY AS Array OF Real" + NL
    t = t + "VAR tHp AS Array OF Integer" + NL
    t = t + "VAR tWake AS Array OF Bool" + NL
    t = t + "VAR tLastHit AS Array OF Integer" + NL
    t = t + "VAR zbuf AS Array OF Real" + NL
    t = t + "VAR lastMove AS Integer" + NL
    t = t + "" + NL
    t = t + "' ================================================================ start" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    win = GUI_Window.New(""SimDOOM"", 320, VIEWH + HUDH)" + NL
    t = t + "    win.Icon = ""app""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    win.onKey = Key" + NL
    t = t + "    screen = GUI_Canvas.New(win)" + NL
    t = t + "    screen.SetBounds(0, 0, 320, VIEWH + HUDH)" + NL
    t = t + "    screen.onKey = Key" + NL
    t = t + "    screen.onDraw = Screen_OnDraw" + NL
    t = t + "    FOR i = 0 TO COLS - 1" + NL
    t = t + "        zbuf.Add(0)" + NL
    t = t + "    NEXT" + NL
    t = t + "    clock = GUI_Timer.New(win)" + NL
    t = t + "    clock.Interval = 60" + NL
    t = t + "    clock.onTick = Clock_OnTick" + NL
    t = t + "    clock.Start()" + NL
    t = t + "    IF SYS.Args.Count > 0 THEN warp = SYS.Args[0].Lower() = ""-warp""" + NL
    t = t + "    win.Show()" + NL
    t = t + "    screen.Focus()" + NL
    t = t + "    DrawTitle()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' E1M1, more or less: # stone, B brick, W wood, X the exit switch," + NL
    t = t + "' P you, I imps, H health, A ammo." + NL
    t = t + "SUB NewGame ()" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    map = [""################"", _" + NL
    t = t + "           ""#P.....#.......#"", _" + NL
    t = t + "           ""#......#...I...#"", _" + NL
    t = t + "           ""#..BB..#.......#"", _" + NL
    t = t + "           ""#..BB.....H....#"", _" + NL
    t = t + "           ""#......#.......#"", _" + NL
    t = t + "           ""####.###WWW.WWW#"", _" + NL
    t = t + "           ""#......#.......#"", _" + NL
    t = t + "           ""#..I...#...I...#"", _" + NL
    t = t + "           ""#......#.......#"", _" + NL
    t = t + "           ""#..A...........#"", _" + NL
    t = t + "           ""#......#####..##"", _" + NL
    t = t + "           ""###.####...I...#"", _" + NL
    t = t + "           ""#..........A...#"", _" + NL
    t = t + "           ""#..I.......#...X"", _" + NL
    t = t + "           ""################""]" + NL
    t = t + "    tKind.Clear()" + NL
    t = t + "    tX.Clear()" + NL
    t = t + "    tY.Clear()" + NL
    t = t + "    tHp.Clear()" + NL
    t = t + "    tWake.Clear()" + NL
    t = t + "    tLastHit.Clear()" + NL
    t = t + "    FOR y = 0 TO MAPH - 1" + NL
    t = t + "        FOR x = 0 TO MAPW - 1" + NL
    t = t + "            c = map[y].CharAt(x)" + NL
    t = t + "            IF c = ""P"" THEN" + NL
    t = t + "                px = x + 0.5" + NL
    t = t + "                py = y + 0.5" + NL
    t = t + "            ELSEIF c = ""I"" OR c = ""H"" OR c = ""A"" THEN" + NL
    t = t + "                tKind.Add(""imp|health|ammo"".Split(""|"")[""IHA"".IndexOf(c)])" + NL
    t = t + "                tX.Add(x + 0.5)" + NL
    t = t + "                tY.Add(y + 0.5)" + NL
    t = t + "                tHp.Add(2)" + NL
    t = t + "                tWake.Add(FALSE)" + NL
    t = t + "                tLastHit.Add(0)" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' facing east, with a 66-degree view" + NL
    t = t + "    dirX = 1" + NL
    t = t + "    dirY = 0" + NL
    t = t + "    planeX = 0" + NL
    t = t + "    planeY = 0.66" + NL
    t = t + "    health = 100" + NL
    t = t + "    ammo = 30" + NL
    t = t + "    kills = 0" + NL
    t = t + "    god = FALSE" + NL
    t = t + "    IF warp THEN" + NL
    t = t + "        px = 14.5" + NL
    t = t + "        py = 14.5" + NL
    t = t + "    END IF" + NL
    t = t + "    started = SYS.Ticks" + NL
    t = t + "    state = ""play""" + NL
    t = t + "    dirty = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Cell (x AS Integer, y AS Integer) AS String" + NL
    t = t + "    IF x < 0 OR y < 0 OR x >= MAPW OR y >= MAPH THEN RETURN ""#""" + NL
    t = t + "    RETURN map[y].CharAt(x)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Solid (x AS Real, y AS Real) AS Bool" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    c = Cell(Int(x), Int(y))" + NL
    t = t + "    RETURN c = ""#"" OR c = ""B"" OR c = ""W"" OR c = ""X""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ keys" + NL
    t = t + "" + NL
    t = t + "SUB Key (k AS String)" + NL
    t = t + "    VAR speed AS Real = 0.25" + NL
    t = t + "    VAR turnBy AS Real = 0.15" + NL
    t = t + "    VAR nx AS Real" + NL
    t = t + "    VAR ny AS Real" + NL
    t = t + "    IF k.Length = 1 THEN" + NL
    t = t + "        typed = (typed + k.Lower())" + NL
    t = t + "        IF typed.Length > 6 THEN typed = typed.Substring(typed.Length - 6, 6)" + NL
    t = t + "        IF typed.EndsWith(""iddqd"") THEN" + NL
    t = t + "            god = NOT god" + NL
    t = t + "            health = 100" + NL
    t = t + "            Achieve(""Cheater"", ""Type IDDQD"")" + NL
    t = t + "        END IF" + NL
    t = t + "        IF typed.EndsWith(""idkfa"") THEN" + NL
    t = t + "            ammo = 200" + NL
    t = t + "            Achieve(""Cheater"", ""Type IDDQD"")" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    IF state = ""title"" OR state = ""dead"" OR state = ""won"" THEN" + NL
    t = t + "        IF k = ""Enter"" OR k = ""Space"" THEN NewGame()" + NL
    t = t + "        IF k = ""Escape"" THEN win.Close()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE k" + NL
    t = t + "        CASE ""ArrowUp"", ""w"", ""W""" + NL
    t = t + "            Walk(dirX * speed, dirY * speed)" + NL
    t = t + "        CASE ""ArrowDown"", ""s"", ""S""" + NL
    t = t + "            Walk(-dirX * speed, -dirY * speed)" + NL
    t = t + "        CASE ""ArrowLeft""" + NL
    t = t + "            Turn(-turnBy)" + NL
    t = t + "        CASE ""ArrowRight""" + NL
    t = t + "            Turn(turnBy)" + NL
    t = t + "        CASE ""a"", ""A""" + NL
    t = t + "            Walk(dirY * speed, -dirX * speed)" + NL
    t = t + "        CASE ""d"", ""D""" + NL
    t = t + "            Walk(-dirY * speed, dirX * speed)" + NL
    t = t + "        CASE ""Space"", ""Ctrl+Control"", ""Control""" + NL
    t = t + "            Fire()" + NL
    t = t + "        CASE ""e"", ""E"", ""Enter""" + NL
    t = t + "            Use()" + NL
    t = t + "        CASE ""Escape""" + NL
    t = t + "            state = ""title""" + NL
    t = t + "            DrawTitle()" + NL
    t = t + "            RETURN" + NL
    t = t + "    END SELECT" + NL
    t = t + "    dirty = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Moves, sliding along walls, and picks things up." + NL
    t = t + "SUB Walk (dx AS Real, dy AS Real)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF NOT Solid(px + dx * 1.6, py) THEN px = px + dx" + NL
    t = t + "    IF NOT Solid(px, py + dy * 1.6) THEN py = py + dy" + NL
    t = t + "    FOR i = 0 TO tKind.Count - 1" + NL
    t = t + "        IF (tKind[i] = ""health"" OR tKind[i] = ""ammo"") AND MATH.Abs(tX[i] - px) < 0.6 AND MATH.Abs(tY[i] - py) < 0.6 THEN" + NL
    t = t + "            IF tKind[i] = ""health"" THEN health = MATH.Min(100, health + 25)" + NL
    t = t + "            IF tKind[i] = ""ammo"" THEN ammo = ammo + 15" + NL
    t = t + "            tKind[i] = ""taken""" + NL
    t = t + "            SYS.Beep(1200, 30)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    faceLook = 0" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Turning is rotating the view direction and the camera plane together." + NL
    t = t + "SUB Turn (a AS Real)" + NL
    t = t + "    VAR ox AS Real" + NL
    t = t + "    ox = dirX" + NL
    t = t + "    dirX = dirX * MATH.Cos(a) - dirY * MATH.Sin(a)" + NL
    t = t + "    dirY = ox * MATH.Sin(a) + dirY * MATH.Cos(a)" + NL
    t = t + "    ox = planeX" + NL
    t = t + "    planeX = planeX * MATH.Cos(a) - planeY * MATH.Sin(a)" + NL
    t = t + "    planeY = ox * MATH.Sin(a) + planeY * MATH.Cos(a)" + NL
    t = t + "    IF a < 0 THEN" + NL
    t = t + "        faceLook = -1" + NL
    t = t + "    ELSE" + NL
    t = t + "        faceLook = 1" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Hitscan: the nearest imp in the middle of the view, nearer than the wall there." + NL
    t = t + "SUB Fire ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR best AS Integer = -1" + NL
    t = t + "    VAR bestD AS Real = 999" + NL
    t = t + "    VAR sx AS Real" + NL
    t = t + "    VAR d AS Real" + NL
    t = t + "    IF ammo <= 0 THEN" + NL
    t = t + "        SYS.Beep(200, 40)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ammo = ammo - 1" + NL
    t = t + "    flashUntil = SYS.Ticks + 120" + NL
    t = t + "    SYS.Beep(150, 25)" + NL
    t = t + "    FOR i = 0 TO tKind.Count - 1" + NL
    t = t + "        IF tKind[i] <> ""imp"" THEN CONTINUE" + NL
    t = t + "        d = Depth(i)" + NL
    t = t + "        IF d <= 0.2 THEN CONTINUE" + NL
    t = t + "        sx = ScreenX(i)" + NL
    t = t + "        IF MATH.Abs(sx - 160) < 140 / d + 6 AND d < zbuf[Int(COLS / 2)] + 0.3 AND d < bestD THEN" + NL
    t = t + "            best = i" + NL
    t = t + "            bestD = d" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF best >= 0 THEN" + NL
    t = t + "        tHp[best] = tHp[best] - 1" + NL
    t = t + "        tWake[best] = TRUE" + NL
    t = t + "        tLastHit[best] = SYS.Ticks" + NL
    t = t + "        IF tHp[best] <= 0 THEN" + NL
    t = t + "            tKind[best] = ""deadimp""" + NL
    t = t + "            kills = kills + 1" + NL
    t = t + "            IF kills = 1 THEN Achieve(""First Blood"", ""Kill your first imp"")" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Use: the switch, if you are facing it close up." + NL
    t = t + "SUB Use ()" + NL
    t = t + "    IF Cell(Int(px + dirX * 0.9), Int(py + dirY * 0.9)) = ""X"" THEN LevelDone()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB LevelDone ()" + NL
    t = t + "    VAR secs AS Integer" + NL
    t = t + "    VAR total AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    state = ""won""" + NL
    t = t + "    win.Tag = ""won|"" + Str(health) + ""|"" + Str(ammo) + ""|"" + Str(kills)" + NL
    t = t + "    secs = Int((SYS.Ticks - started) / 1000)" + NL
    t = t + "    FOR i = 0 TO tKind.Count - 1" + NL
    t = t + "        IF tKind[i] = ""imp"" OR tKind[i] = ""deadimp"" THEN total = total + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    Achieve(""E1M1 Complete"", ""Reach the exit"")" + NL
    t = t + "    IF kills = total THEN Achieve(""Rip and Tear"", ""Kill every imp on E1M1"")" + NL
    t = t + "    IF secs < 60 THEN Achieve(""Speedrunner"", ""Finish E1M1 in under a minute"")" + NL
    t = t + "    IF health = 100 THEN Achieve(""Untouchable"", ""Finish without a scratch"")" + NL
    t = t + "    DrawEnd(""E1M1 COMPLETE"", ""Kills "" + Str(kills) + ""/"" + Str(total) + ""   Time "" + Str(Int(secs / 60)) + "":"" + (""0"" + Str(secs MOD 60)).Substring(Str(secs MOD 60).Length - 1, 2), 10)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' An achievement, for Vapor to show (each one once)." + NL
    t = t + "SUB Achieve (name AS String, how AS String)" + NL
    t = t + "    VAR have AS String" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(ACHFILE) THEN have = FS.Read(ACHFILE)" + NL
    t = t + "        IF have.Contains(name + ""|"") THEN RETURN" + NL
    t = t + "        FS.Append(ACHFILE, name + ""|"" + how + ""|"" + TIME.Date + Chr(10))" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the monsters" + NL
    t = t + "" + NL
    t = t + "SUB Clock_OnTick ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR d AS Real" + NL
    t = t + "    VAR mx AS Real" + NL
    t = t + "    VAR my AS Real" + NL
    t = t + "    IF state <> ""play"" THEN RETURN" + NL
    t = t + "    IF SYS.Ticks - lastMove > 100 THEN" + NL
    t = t + "        lastMove = SYS.Ticks" + NL
    t = t + "        FOR i = 0 TO tKind.Count - 1" + NL
    t = t + "            IF tKind[i] <> ""imp"" THEN CONTINUE" + NL
    t = t + "            d = MATH.Sqrt((tX[i] - px) * (tX[i] - px) + (tY[i] - py) * (tY[i] - py))" + NL
    t = t + "            IF d < 5 THEN tWake[i] = TRUE" + NL
    t = t + "            IF NOT tWake[i] THEN CONTINUE" + NL
    t = t + "            IF d > 0.9 THEN" + NL
    t = t + "                mx = (px - tX[i]) / d * 0.06" + NL
    t = t + "                my = (py - tY[i]) / d * 0.06" + NL
    t = t + "                IF NOT Solid(tX[i] + mx, tY[i]) THEN tX[i] = tX[i] + mx" + NL
    t = t + "                IF NOT Solid(tX[i], tY[i] + my) THEN tY[i] = tY[i] + my" + NL
    t = t + "                dirty = TRUE" + NL
    t = t + "            ELSEIF SYS.Ticks - tLastHit[i] > 700 THEN" + NL
    t = t + "                ' a swipe of claws" + NL
    t = t + "                tLastHit[i] = SYS.Ticks" + NL
    t = t + "                IF NOT god THEN health = health - 8 - Rnd(5)" + NL
    t = t + "                hurtUntil = SYS.Ticks + 200" + NL
    t = t + "                SYS.Beep(90, 40)" + NL
    t = t + "                dirty = TRUE" + NL
    t = t + "                IF health <= 0 THEN" + NL
    t = t + "                    health = 0" + NL
    t = t + "                    state = ""dead""" + NL
    t = t + "                    win.Tag = ""dead|0|"" + Str(ammo) + ""|"" + Str(kills)" + NL
    t = t + "                    DrawEnd(""YOU ARE DEAD"", ""Press Space to try again"", 9)" + NL
    t = t + "                    RETURN" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    IF flashUntil > 0 AND SYS.Ticks > flashUntil THEN" + NL
    t = t + "        flashUntil = 0" + NL
    t = t + "        dirty = TRUE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF hurtUntil > 0 AND SYS.Ticks > hurtUntil THEN" + NL
    t = t + "        hurtUntil = 0" + NL
    t = t + "        dirty = TRUE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF dirty THEN Render()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ drawing" + NL
    t = t + "" + NL
    t = t + "SUB Screen_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    IF state = ""play"" THEN" + NL
    t = t + "        dirty = TRUE" + NL
    t = t + "        Render()" + NL
    t = t + "    ELSEIF state = ""title"" THEN" + NL
    t = t + "        DrawTitle()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where a thing is in camera space: its depth, and its x on the screen." + NL
    t = t + "FUNCTION Depth (i AS Integer) AS Real" + NL
    t = t + "    VAR sx AS Real" + NL
    t = t + "    VAR sy AS Real" + NL
    t = t + "    VAR inv AS Real" + NL
    t = t + "    sx = tX[i] - px" + NL
    t = t + "    sy = tY[i] - py" + NL
    t = t + "    inv = 1.0 / (planeX * dirY - dirX * planeY)" + NL
    t = t + "    RETURN inv * (-planeY * sx + planeX * sy)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ScreenX (i AS Integer) AS Real" + NL
    t = t + "    VAR sx AS Real" + NL
    t = t + "    VAR sy AS Real" + NL
    t = t + "    VAR inv AS Real" + NL
    t = t + "    VAR across AS Real" + NL
    t = t + "    sx = tX[i] - px" + NL
    t = t + "    sy = tY[i] - py" + NL
    t = t + "    inv = 1.0 / (planeX * dirY - dirX * planeY)" + NL
    t = t + "    across = inv * (dirY * sx - dirX * sy)" + NL
    t = t + "    RETURN 160 * (1 + across / Depth(i))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Render ()" + NL
    t = t + "    dirty = FALSE" + NL
    t = t + "    ' (what is going on, for anybody looking: state|health|ammo|kills|x|y)" + NL
    t = t + "    win.Tag = state + ""|"" + Str(health) + ""|"" + Str(ammo) + ""|"" + Str(kills) + ""|"" + Str(Int(px * 10)) + ""|"" + Str(Int(py * 10))" + NL
    t = t + "    screen.Clear()" + NL
    t = t + "    ' ceiling and floor" + NL
    t = t + "    screen.SetColor(0)" + NL
    t = t + "    screen.FillRect(0, 0, 320, VIEWH / 2)" + NL
    t = t + "    screen.SetColor(8)" + NL
    t = t + "    screen.FillRect(0, VIEWH / 2, 320, VIEWH / 2)" + NL
    t = t + "    Walls()" + NL
    t = t + "    Things()" + NL
    t = t + "    Gun()" + NL
    t = t + "    IF hurtUntil > 0 THEN" + NL
    t = t + "        ' a red edge when an imp gets you" + NL
    t = t + "        screen.SetColor(9)" + NL
    t = t + "        screen.Rect(0, 0, 320, VIEWH)" + NL
    t = t + "        screen.Rect(1, 1, 318, VIEWH - 2)" + NL
    t = t + "        screen.Rect(2, 2, 316, VIEWH - 4)" + NL
    t = t + "    END IF" + NL
    t = t + "    Hud()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Walls ()" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR camX AS Real" + NL
    t = t + "    VAR rx AS Real" + NL
    t = t + "    VAR ry AS Real" + NL
    t = t + "    VAR mapX AS Integer" + NL
    t = t + "    VAR mapY AS Integer" + NL
    t = t + "    VAR ddx AS Real" + NL
    t = t + "    VAR ddy AS Real" + NL
    t = t + "    VAR sdx AS Real" + NL
    t = t + "    VAR sdy AS Real" + NL
    t = t + "    VAR stepX AS Integer" + NL
    t = t + "    VAR stepY AS Integer" + NL
    t = t + "    VAR side AS Integer" + NL
    t = t + "    VAR hit AS String" + NL
    t = t + "    VAR dist AS Real" + NL
    t = t + "    VAR h AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    FOR c = 0 TO COLS - 1" + NL
    t = t + "        camX = 2 * c / COLS - 1" + NL
    t = t + "        rx = dirX + planeX * camX" + NL
    t = t + "        ry = dirY + planeY * camX" + NL
    t = t + "        mapX = Int(px)" + NL
    t = t + "        mapY = Int(py)" + NL
    t = t + "        ddx = 1E30" + NL
    t = t + "        ddy = 1E30" + NL
    t = t + "        IF rx <> 0 THEN ddx = MATH.Abs(1 / rx)" + NL
    t = t + "        IF ry <> 0 THEN ddy = MATH.Abs(1 / ry)" + NL
    t = t + "        IF rx < 0 THEN" + NL
    t = t + "            stepX = -1" + NL
    t = t + "            sdx = (px - mapX) * ddx" + NL
    t = t + "        ELSE" + NL
    t = t + "            stepX = 1" + NL
    t = t + "            sdx = (mapX + 1 - px) * ddx" + NL
    t = t + "        END IF" + NL
    t = t + "        IF ry < 0 THEN" + NL
    t = t + "            stepY = -1" + NL
    t = t + "            sdy = (py - mapY) * ddy" + NL
    t = t + "        ELSE" + NL
    t = t + "            stepY = 1" + NL
    t = t + "            sdy = (mapY + 1 - py) * ddy" + NL
    t = t + "        END IF" + NL
    t = t + "        hit = "".""" + NL
    t = t + "        n = 0" + NL
    t = t + "        WHILE hit = ""."" AND n < 40" + NL
    t = t + "            IF sdx < sdy THEN" + NL
    t = t + "                sdx = sdx + ddx" + NL
    t = t + "                mapX = mapX + stepX" + NL
    t = t + "                side = 0" + NL
    t = t + "            ELSE" + NL
    t = t + "                sdy = sdy + ddy" + NL
    t = t + "                mapY = mapY + stepY" + NL
    t = t + "                side = 1" + NL
    t = t + "            END IF" + NL
    t = t + "            hit = Cell(mapX, mapY)" + NL
    t = t + "            IF hit = ""P"" OR hit = ""I"" OR hit = ""H"" OR hit = ""A"" THEN hit = "".""" + NL
    t = t + "            n = n + 1" + NL
    t = t + "        END WHILE" + NL
    t = t + "        IF side = 0 THEN" + NL
    t = t + "            dist = sdx - ddx" + NL
    t = t + "        ELSE" + NL
    t = t + "            dist = sdy - ddy" + NL
    t = t + "        END IF" + NL
    t = t + "        IF dist < 0.05 THEN dist = 0.05" + NL
    t = t + "        zbuf[c] = dist" + NL
    t = t + "        h = Int(VIEWH / dist)" + NL
    t = t + "        IF h > VIEWH THEN h = VIEWH" + NL
    t = t + "        screen.SetColor(WallColour(hit, side, dist))" + NL
    t = t + "        screen.FillRect(c * 4, Int((VIEWH - h) / 2), 4, h)" + NL
    t = t + "        IF hit = ""X"" AND dist < 6 THEN" + NL
    t = t + "            ' the switch's lever" + NL
    t = t + "            screen.SetColor(15)" + NL
    t = t + "            screen.FillRect(c * 4 + 1, Int(VIEWH / 2 - h / 8), 2, Int(h / 4) + 1)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    Put("C:\WEB\VAPOR\SIMDOOM\1.TXT")
END SUB

SUB File4 ()
    t = ""
    t = t + "' Light and dark sides, and darker far away: all in 16 colours." + NL
    t = t + "FUNCTION WallColour (kind AS String, side AS Integer, dist AS Real) AS Integer" + NL
    t = t + "    VAR far AS Bool" + NL
    t = t + "    far = dist > 5" + NL
    t = t + "    SELECT CASE kind" + NL
    t = t + "        CASE ""B""" + NL
    t = t + "            IF side = 1 OR far THEN RETURN 1" + NL
    t = t + "            RETURN 9" + NL
    t = t + "        CASE ""W""" + NL
    t = t + "            IF side = 1 OR far THEN RETURN 3" + NL
    t = t + "            RETURN 11" + NL
    t = t + "        CASE ""X""" + NL
    t = t + "            IF side = 1 OR far THEN RETURN 2" + NL
    t = t + "            RETURN 10" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF far AND side = 1 THEN RETURN 0" + NL
    t = t + "    IF side = 1 OR far THEN RETURN 8" + NL
    t = t + "    RETURN 7" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Things, far ones first, cut off column by column behind walls." + NL
    t = t + "SUB Things ()" + NL
    t = t + "    VAR order AS Array OF Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR t AS Integer" + NL
    t = t + "    VAR d AS Real" + NL
    t = t + "    VAR sx AS Real" + NL
    t = t + "    VAR size AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR c0 AS Integer" + NL
    t = t + "    VAR c1 AS Integer" + NL
    t = t + "    VAR top AS Integer" + NL
    t = t + "    FOR i = 0 TO tKind.Count - 1" + NL
    t = t + "        IF tKind[i] <> ""taken"" THEN order.Add(i)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR i = 0 TO order.Count - 2" + NL
    t = t + "        FOR j = i + 1 TO order.Count - 1" + NL
    t = t + "            IF Depth(order[j]) > Depth(order[i]) THEN" + NL
    t = t + "                t = order[i]" + NL
    t = t + "                order[i] = order[j]" + NL
    t = t + "                order[j] = t" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH i IN order" + NL
    t = t + "        d = Depth(i)" + NL
    t = t + "        IF d < 0.2 THEN CONTINUE" + NL
    t = t + "        sx = ScreenX(i)" + NL
    t = t + "        size = Int(VIEWH / d)" + NL
    t = t + "        c0 = Int((sx - size / 2) / 4)" + NL
    t = t + "        c1 = Int((sx + size / 2) / 4)" + NL
    t = t + "        FOR c = MATH.Max(0, c0) TO MATH.Min(COLS - 1, c1)" + NL
    t = t + "            IF d >= zbuf[c] THEN CONTINUE" + NL
    t = t + "            top = Int(VIEWH / 2 + size / 2)" + NL
    t = t + "            ThingSlice(tKind[i], c, c - c0, c1 - c0 + 1, top, size, SYS.Ticks - tLastHit[i] < 120)" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One 4-pixel column of a thing: u is which column of it, of w; it stands on y." + NL
    t = t + "SUB ThingSlice (kind AS String, c AS Integer, u AS Integer, w AS Integer, y AS Integer, size AS Integer, hurt AS Bool)" + NL
    t = t + "    VAR f AS Real" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    x = c * 4" + NL
    t = t + "    f = (u + 0.5) / w" + NL
    t = t + "    SELECT CASE kind" + NL
    t = t + "        CASE ""imp""" + NL
    t = t + "            ' a brown body, broader at the shoulders, red eyes, white when hit" + NL
    t = t + "            IF f < 0.15 OR f > 0.85 THEN" + NL
    t = t + "                ' arms" + NL
    t = t + "                screen.SetColor(Pick(hurt, 15, 1))" + NL
    t = t + "                screen.FillRect(x, y - Int(size * 0.65), 4, Int(size * 0.35))" + NL
    t = t + "            ELSE" + NL
    t = t + "                screen.SetColor(Pick(hurt, 15, 3))" + NL
    t = t + "                screen.FillRect(x, y - Int(size * 0.8), 4, Int(size * 0.5))" + NL
    t = t + "                screen.SetColor(Pick(hurt, 15, 1))" + NL
    t = t + "                screen.FillRect(x, y - Int(size * 0.3), 4, Int(size * 0.3))" + NL
    t = t + "                IF (f > 0.3 AND f < 0.42) OR (f > 0.58 AND f < 0.7) THEN" + NL
    t = t + "                    screen.SetColor(9)" + NL
    t = t + "                    screen.FillRect(x, y - Int(size * 0.72), 4, MATH.Max(2, Int(size * 0.06)))" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""deadimp""" + NL
    t = t + "            screen.SetColor(1)" + NL
    t = t + "            screen.FillRect(x, y - Int(size * 0.08), 4, MATH.Max(2, Int(size * 0.08)))" + NL
    t = t + "        CASE ""health""" + NL
    t = t + "            IF f > 0.25 AND f < 0.75 THEN" + NL
    t = t + "                screen.SetColor(15)" + NL
    t = t + "                screen.FillRect(x, y - Int(size * 0.3), 4, Int(size * 0.3))" + NL
    t = t + "                IF f > 0.42 AND f < 0.58 THEN" + NL
    t = t + "                    screen.SetColor(9)" + NL
    t = t + "                    screen.FillRect(x, y - Int(size * 0.27), 4, Int(size * 0.24))" + NL
    t = t + "                ELSE" + NL
    t = t + "                    screen.SetColor(9)" + NL
    t = t + "                    screen.FillRect(x, y - Int(size * 0.18), 4, MATH.Max(1, Int(size * 0.06)))" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""ammo""" + NL
    t = t + "            IF f > 0.3 AND f < 0.7 THEN" + NL
    t = t + "                screen.SetColor(11)" + NL
    t = t + "                screen.FillRect(x, y - Int(size * 0.2), 4, Int(size * 0.2))" + NL
    t = t + "            END IF" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Pick (yes AS Bool, a AS Integer, b AS Integer) AS Integer" + NL
    t = t + "    IF yes THEN RETURN a" + NL
    t = t + "    RETURN b" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Gun ()" + NL
    t = t + "    ' the pistol, and its flash" + NL
    t = t + "    IF flashUntil > 0 THEN" + NL
    t = t + "        screen.SetColor(11)" + NL
    t = t + "        screen.FillCircle(160, VIEWH - 44, 10)" + NL
    t = t + "        screen.SetColor(15)" + NL
    t = t + "        screen.FillCircle(160, VIEWH - 44, 5)" + NL
    t = t + "    END IF" + NL
    t = t + "    screen.SetColor(8)" + NL
    t = t + "    screen.FillRect(152, VIEWH - 36, 16, 36)" + NL
    t = t + "    screen.SetColor(7)" + NL
    t = t + "    screen.FillRect(155, VIEWH - 36, 4, 30)" + NL
    t = t + "    screen.SetColor(0)" + NL
    t = t + "    screen.FillRect(157, VIEWH - 38, 6, 4)" + NL
    t = t + "    ' the hand" + NL
    t = t + "    screen.SetColor(11)" + NL
    t = t + "    screen.FillRect(146, VIEWH - 16, 28, 16)" + NL
    t = t + "    ' crosshair" + NL
    t = t + "    screen.SetColor(10)" + NL
    t = t + "    screen.Pixel(160, VIEWH / 2)" + NL
    t = t + "    screen.Line(156, VIEWH / 2, 158, VIEWH / 2)" + NL
    t = t + "    screen.Line(162, VIEWH / 2, 164, VIEWH / 2)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The status bar: ammo, the face, health, and the level." + NL
    t = t + "SUB Hud ()" + NL
    t = t + "    screen.SetColor(8)" + NL
    t = t + "    screen.FillRect(0, VIEWH, 320, HUDH)" + NL
    t = t + "    screen.SetColor(7)" + NL
    t = t + "    screen.Line(0, VIEWH, 320, VIEWH)" + NL
    t = t + "    screen.SetColor(0)" + NL
    t = t + "    screen.FillRect(4, VIEWH + 4, 80, 32)" + NL
    t = t + "    screen.FillRect(236, VIEWH + 4, 80, 32)" + NL
    t = t + "    screen.SetColor(9)" + NL
    t = t + "    screen.Text(10, VIEWH + 6, (""  "" + Str(ammo)).Substring(Str(ammo).Length, 3))" + NL
    t = t + "    screen.Text(242, VIEWH + 6, (""  "" + Str(health)).Substring(Str(health).Length, 3) + ""%"")" + NL
    t = t + "    screen.SetColor(7)" + NL
    t = t + "    screen.Text(46, VIEWH + 20, ""AMMO"")" + NL
    t = t + "    screen.Text(254, VIEWH + 20, ""HLTH"")" + NL
    t = t + "    screen.Text(96, VIEWH + 12, ""E1M1"")" + NL
    t = t + "    screen.Text(178, VIEWH + 12, Str(kills) + ""K"")" + NL
    t = t + "    Face(160, VIEWH + 20)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The face in the middle, who looks the way you turn and fares as you do." + NL
    t = t + "SUB Face (cx AS Integer, cy AS Integer)" + NL
    t = t + "    VAR look AS Integer" + NL
    t = t + "    screen.SetColor(0)" + NL
    t = t + "    screen.FillRect(cx - 18, cy - 17, 36, 34)" + NL
    t = t + "    screen.SetColor(11)" + NL
    t = t + "    screen.FillCircle(cx, cy, 14)" + NL
    t = t + "    screen.SetColor(3)" + NL
    t = t + "    screen.FillRect(cx - 12, cy - 15, 24, 5)" + NL
    t = t + "    look = faceLook * 2" + NL
    t = t + "    screen.SetColor(15)" + NL
    t = t + "    screen.FillRect(cx - 9, cy - 5, 6, 4)" + NL
    t = t + "    screen.FillRect(cx + 3, cy - 5, 6, 4)" + NL
    t = t + "    screen.SetColor(0)" + NL
    t = t + "    screen.FillRect(cx - 7 + look, cy - 5, 2, 4)" + NL
    t = t + "    screen.FillRect(cx + 5 + look, cy - 5, 2, 4)" + NL
    t = t + "    IF hurtUntil > 0 OR health < 40 THEN" + NL
    t = t + "        ' a grimace, and blood when it is bad" + NL
    t = t + "        screen.SetColor(15)" + NL
    t = t + "        screen.FillRect(cx - 7, cy + 5, 14, 4)" + NL
    t = t + "        screen.SetColor(0)" + NL
    t = t + "        screen.Line(cx - 7, cy + 7, cx + 7, cy + 7)" + NL
    t = t + "        IF health < 40 THEN" + NL
    t = t + "            screen.SetColor(9)" + NL
    t = t + "            screen.FillRect(cx + 4, cy - 12, 3, 10)" + NL
    t = t + "            screen.FillRect(cx - 10, cy + 2, 3, 6)" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSE" + NL
    t = t + "        screen.SetColor(1)" + NL
    t = t + "        screen.Line(cx - 5, cy + 7, cx + 5, cy + 7)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawTitle ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    screen.Clear()" + NL
    t = t + "    screen.SetColor(0)" + NL
    t = t + "    screen.FillRect(0, 0, 320, VIEWH + HUDH)" + NL
    t = t + "    ' flames along the bottom" + NL
    t = t + "    FOR i = 0 TO 39" + NL
    t = t + "        screen.SetColor(Pick(i MOD 2 = 0, 9, 1))" + NL
    t = t + "        screen.FillRect(i * 8, VIEWH + HUDH - 20 - Rnd(30), 8, 60)" + NL
    t = t + "        screen.SetColor(11)" + NL
    t = t + "        screen.FillRect(i * 8 + 2, VIEWH + HUDH - 8 - Rnd(10), 4, 20)" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' the logo: big blocky red letters with a shadow" + NL
    t = t + "    BigWord(""SIMDOOM"", 34, 40, 1)" + NL
    t = t + "    BigWord(""SIMDOOM"", 32, 38, 9)" + NL
    t = t + "    screen.SetColor(7)" + NL
    t = t + "    screen.Text(84, 104, ""EPISODE ONE"")" + NL
    t = t + "    screen.SetColor(15)" + NL
    t = t + "    screen.Text(48, 130, ""PRESS ENTER TO START"")" + NL
    t = t + "    screen.SetColor(8)" + NL
    t = t + "    screen.Text(4, 4, ""Arrows/WASD move  Space fire  E use"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawEnd (title AS String, line AS String, colour AS Integer)" + NL
    t = t + "    screen.SetColor(0)" + NL
    t = t + "    screen.FillRect(30, 40, 260, 80)" + NL
    t = t + "    screen.SetColor(colour)" + NL
    t = t + "    screen.Rect(30, 40, 260, 80)" + NL
    t = t + "    screen.Text(160 - title.Length * 5, 54, title)" + NL
    t = t + "    screen.SetColor(15)" + NL
    t = t + "    screen.Text(160 - line.Length * 5, 80, line)" + NL
    t = t + "    screen.SetColor(7)" + NL
    t = t + "    screen.Text(70, 100, ""SPACE: PLAY AGAIN"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Letters made of blocks, 5 by 7, each block 5 pixels." + NL
    t = t + "SUB BigWord (word AS String, x AS Integer, y AS Integer, colour AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR r AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR rows AS Array OF String" + NL
    t = t + "    screen.SetColor(colour)" + NL
    t = t + "    FOR i = 0 TO word.Length - 1" + NL
    t = t + "        rows = BigGlyph(word.CharAt(i)).Split(""|"")" + NL
    t = t + "        FOR r = 0 TO 6" + NL
    t = t + "            FOR k = 0 TO 4" + NL
    t = t + "                IF rows[r].CharAt(k) = ""#"" THEN screen.FillRect(x + i * 37 + k * 6, y + r * 7, 6, 7)" + NL
    t = t + "            NEXT" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION BigGlyph (c AS String) AS String" + NL
    t = t + "    SELECT CASE c" + NL
    t = t + "        CASE ""S""" + NL
    t = t + "            RETURN ""#####|#....|#....|#####|....#|....#|#####""" + NL
    t = t + "        CASE ""I""" + NL
    t = t + "            RETURN ""#####|..#..|..#..|..#..|..#..|..#..|#####""" + NL
    t = t + "        CASE ""M""" + NL
    t = t + "            RETURN ""#...#|##.##|#.#.#|#.#.#|#...#|#...#|#...#""" + NL
    t = t + "        CASE ""D""" + NL
    t = t + "            RETURN ""####.|#...#|#...#|#...#|#...#|#...#|####.""" + NL
    t = t + "        CASE ""O""" + NL
    t = t + "            RETURN ""#####|#...#|#...#|#...#|#...#|#...#|#####""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN "".....|.....|.....|.....|.....|.....|.....""" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\WEB\VAPOR\SIMDOOM\2.TXT")
END SUB

SUB File5 ()
    t = ""
    t = t + "' VAPOR|id=SNAKE|name=Snake 95|kind=game|version=aa5d9aeb|category=Arcade|run=C:\GAMES\SNAKE\SNAKE.SPK|files=C:\GAMES\SNAKE\SNAKE.SPK|tasks=SNAKE|startup=|folder=|about=Eat the dots. Grow longer. Don't eat yourself. The game that sold a million phones, now on SIM95." + NL
    t = t + "' SNAKE.SPK - Snake 95. Eat the dots; don't eat yourself." + NL
    t = t + "' Arrow keys steer, Space pauses. The best score is kept for Vapor to show." + NL
    t = t + "" + NL
    t = t + "CONST CELL = 12" + NL
    t = t + "CONST GW = 26" + NL
    t = t + "CONST GH = 18" + NL
    t = t + "CONST BESTFILE = ""C:\GAMES\SNAKE\BEST.TXT""" + NL
    t = t + "CONST ACHFILE = ""C:\GAMES\SNAKE\ACHIEVE.TXT""" + NL
    t = t + "" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR board AS GUI_Canvas" + NL
    t = t + "VAR clock AS GUI_Timer" + NL
    t = t + "VAR bodyX AS Array OF Integer" + NL
    t = t + "VAR bodyY AS Array OF Integer" + NL
    t = t + "VAR dx AS Integer = 1" + NL
    t = t + "VAR dy AS Integer" + NL
    t = t + "VAR nextDx AS Integer = 1" + NL
    t = t + "VAR nextDy AS Integer" + NL
    t = t + "VAR foodX AS Integer" + NL
    t = t + "VAR foodY AS Integer" + NL
    t = t + "VAR score AS Integer" + NL
    t = t + "VAR state AS String = ""title""" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    win = GUI_Window.New(""Snake 95"", GW * CELL, GH * CELL + 20)" + NL
    t = t + "    win.Icon = ""app""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    win.onKey = Key" + NL
    t = t + "    board = GUI_Canvas.New(win)" + NL
    t = t + "    board.SetBounds(0, 0, GW * CELL, GH * CELL + 20)" + NL
    t = t + "    board.onKey = Key" + NL
    t = t + "    board.onDraw = Board_OnDraw" + NL
    t = t + "    clock = GUI_Timer.New(win)" + NL
    t = t + "    clock.Interval = 110" + NL
    t = t + "    clock.onTick = Clock_OnTick" + NL
    t = t + "    clock.Start()" + NL
    t = t + "    win.Show()" + NL
    t = t + "    board.Focus()" + NL
    t = t + "    Draw()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB NewGame ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    bodyX.Clear()" + NL
    t = t + "    bodyY.Clear()" + NL
    t = t + "    FOR i = 0 TO 3" + NL
    t = t + "        bodyX.Add(8 - i)" + NL
    t = t + "        bodyY.Add(9)" + NL
    t = t + "    NEXT" + NL
    t = t + "    dx = 1" + NL
    t = t + "    dy = 0" + NL
    t = t + "    nextDx = 1" + NL
    t = t + "    nextDy = 0" + NL
    t = t + "    score = 0" + NL
    t = t + "    Food()" + NL
    t = t + "    state = ""play""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Food ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR clash AS Bool = TRUE" + NL
    t = t + "    WHILE clash" + NL
    t = t + "        foodX = Rnd(GW)" + NL
    t = t + "        foodY = Rnd(GH)" + NL
    t = t + "        clash = FALSE" + NL
    t = t + "        FOR i = 0 TO bodyX.Count - 1" + NL
    t = t + "            IF bodyX[i] = foodX AND bodyY[i] = foodY THEN clash = TRUE" + NL
    t = t + "        NEXT" + NL
    t = t + "    END WHILE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Key (k AS String)" + NL
    t = t + "    IF state <> ""play"" THEN" + NL
    t = t + "        IF k = ""Enter"" OR k = ""Space"" THEN" + NL
    t = t + "            IF state = ""paused"" THEN" + NL
    t = t + "                state = ""play""" + NL
    t = t + "            ELSE" + NL
    t = t + "                NewGame()" + NL
    t = t + "            END IF" + NL
    t = t + "            Draw()" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    SELECT CASE k" + NL
    t = t + "        CASE ""ArrowUp""" + NL
    t = t + "            IF dy = 0 THEN" + NL
    t = t + "                nextDx = 0" + NL
    t = t + "                nextDy = -1" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""ArrowDown""" + NL
    t = t + "            IF dy = 0 THEN" + NL
    t = t + "                nextDx = 0" + NL
    t = t + "                nextDy = 1" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""ArrowLeft""" + NL
    t = t + "            IF dx = 0 THEN" + NL
    t = t + "                nextDx = -1" + NL
    t = t + "                nextDy = 0" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""ArrowRight""" + NL
    t = t + "            IF dx = 0 THEN" + NL
    t = t + "                nextDx = 1" + NL
    t = t + "                nextDy = 0" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Space""" + NL
    t = t + "            state = ""paused""" + NL
    t = t + "            Draw()" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Clock_OnTick ()" + NL
    t = t + "    VAR hx AS Integer" + NL
    t = t + "    VAR hy AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF state <> ""play"" THEN RETURN" + NL
    t = t + "    dx = nextDx" + NL
    t = t + "    dy = nextDy" + NL
    t = t + "    hx = bodyX[0] + dx" + NL
    t = t + "    hy = bodyY[0] + dy" + NL
    t = t + "    IF hx < 0 OR hy < 0 OR hx >= GW OR hy >= GH THEN" + NL
    t = t + "        GameOver()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 0 TO bodyX.Count - 2" + NL
    t = t + "        IF bodyX[i] = hx AND bodyY[i] = hy THEN" + NL
    t = t + "            GameOver()" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    bodyX.Insert(0, hx)" + NL
    t = t + "    bodyY.Insert(0, hy)" + NL
    t = t + "    IF hx = foodX AND hy = foodY THEN" + NL
    t = t + "        score = score + 10" + NL
    t = t + "        SYS.Beep(1000, 20)" + NL
    t = t + "        IF score = 100 THEN Achieve(""Hungry"", ""Score 100"")" + NL
    t = t + "        IF score = 300 THEN Achieve(""Long Boi"", ""Score 300"")" + NL
    t = t + "        Food()" + NL
    t = t + "    ELSE" + NL
    t = t + "        bodyX.RemoveAt(bodyX.Count - 1)" + NL
    t = t + "        bodyY.RemoveAt(bodyY.Count - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    Draw()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB GameOver ()" + NL
    t = t + "    state = ""over""" + NL
    t = t + "    SYS.Beep(120, 200)" + NL
    t = t + "    IF score > Best() THEN" + NL
    t = t + "        TRY" + NL
    t = t + "            FS.Write(BESTFILE, Str(score))" + NL
    t = t + "        CATCH err" + NL
    t = t + "        END TRY" + NL
    t = t + "    END IF" + NL
    t = t + "    Achieve(""Ouroboros"", ""Lose a game of Snake"")" + NL
    t = t + "    Draw()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Best () AS Integer" + NL
    t = t + "    IF FS.Exists(BESTFILE) THEN RETURN Int(Val(FS.Read(BESTFILE)))" + NL
    t = t + "    RETURN 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Achieve (name AS String, how AS String)" + NL
    t = t + "    VAR have AS String" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(ACHFILE) THEN have = FS.Read(ACHFILE)" + NL
    t = t + "        IF have.Contains(name + ""|"") THEN RETURN" + NL
    t = t + "        FS.Append(ACHFILE, name + ""|"" + how + ""|"" + TIME.Date + Chr(10))" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Board_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    Draw()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Draw ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    board.Clear()" + NL
    t = t + "    board.SetColor(0)" + NL
    t = t + "    board.FillRect(0, 0, GW * CELL, GH * CELL)" + NL
    t = t + "    IF state = ""title"" THEN" + NL
    t = t + "        board.SetColor(10)" + NL
    t = t + "        board.Text(100, 70, ""SNAKE 95"")" + NL
    t = t + "        board.SetColor(7)" + NL
    t = t + "        board.Text(40, 110, ""PRESS ENTER TO PLAY"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        board.SetColor(9)" + NL
    t = t + "        board.FillCircle(foodX * CELL + 6, foodY * CELL + 6, 5)" + NL
    t = t + "        FOR i = bodyX.Count - 1 TO 0 STEP -1" + NL
    t = t + "            IF i = 0 THEN" + NL
    t = t + "                board.SetColor(10)" + NL
    t = t + "            ELSE" + NL
    t = t + "                board.SetColor(2)" + NL
    t = t + "            END IF" + NL
    t = t + "            board.FillRect(bodyX[i] * CELL + 1, bodyY[i] * CELL + 1, CELL - 2, CELL - 2)" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF state = ""over"" THEN" + NL
    t = t + "            board.SetColor(15)" + NL
    t = t + "            board.Text(90, 90, ""GAME OVER"")" + NL
    t = t + "            board.Text(40, 120, ""ENTER TO PLAY AGAIN"")" + NL
    t = t + "        ELSEIF state = ""paused"" THEN" + NL
    t = t + "            board.SetColor(15)" + NL
    t = t + "            board.Text(120, 100, ""PAUSED"")" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    board.SetColor(8)" + NL
    t = t + "    board.FillRect(0, GH * CELL, GW * CELL, 20)" + NL
    t = t + "    board.SetColor(15)" + NL
    t = t + "    board.Text(4, GH * CELL + 2, ""SCORE "" + Str(score) + ""   BEST "" + Str(MATH.Max(score, Best())))" + NL
    t = t + "    win.Tag = state + ""|"" + Str(score)" + NL
    t = t + "END SUB" + NL
    Put("C:\WEB\VAPOR\SNAKE\1.TXT")
END SUB

SUB File6 ()
    t = ""
    t = t + "' VAPOR|id=VAPOR|name=Vapor|kind=client|version=c1a16ea6|category=Vapor|run=C:\PROGRAMS\VAPOR.SPK|files=C:\PROGRAMS\VAPOR.SPK|tasks=VAPOR|startup=|folder=|about=The Vapor program itself." + NL
    t = t + "' VAPOR.SPK - Vapor, the store and library for everything on SIM95: games," + NL
    t = t + "' programs (Simxplorer, Frostbird, Clippy...) and web apps (SimBook, ColdMail," + NL
    t = t + "' AskSim, ELIZA-95)." + NL
    t = t + "'" + NL
    t = t + "' A store is a folder on a web server, http://<machine>/vapor/, holding" + NL
    t = t + "' CATALOG.TXT, one item per line:" + NL
    t = t + "'   id|name|parts|bytes|status|category|about|kind|version|run|files|tasks|startup" + NL
    t = t + "' and each item cut into parts small enough for a network message" + NL
    t = t + "' (/vapor/<id>/<n>.txt). An item is a file that starts with a header line," + NL
    t = t + "'   ' VAPOR|id=...|name=...|kind=...|version=...|..." + NL
    t = t + "' kind says what to do with it once it is here:" + NL
    t = t + "'   game     it is the game: kept in C:\GAMES\<id>\<id>.SPK and played from there" + NL
    t = t + "'   program  it is an installer: Vapor runs it, then ""run"" opens the program" + NL
    t = t + "'   service  the same, for something that starts with the machine (Clippy)" + NL
    t = t + "'   web      an installer for a web app, which becomes this machine's home page" + NL
    t = t + "'   client   Vapor itself: a new version replaces this program, which restarts" + NL
    t = t + "'" + NL
    t = t + "' The library (C:\GAMES\LIBRARY.TXT) remembers what is installed, which" + NL
    t = t + "' version, and the time played. When the store has a newer version of" + NL
    t = t + "' something, the Library offers Update (or Update All)." + NL
    t = t + "'" + NL
    t = t + "' On a store machine, Publish Apps puts every installer saved in C:\MYFILES" + NL
    t = t + "' that has a header (all the ones tools/build-installer.mjs makes) into the" + NL
    t = t + "' store, replacing older versions: that is how a store's shelves are stocked" + NL
    t = t + "' and updated." + NL
    t = t + "'" + NL
    t = t + "' Fetches go one at a time and start in a timer tick of their own, inside a" + NL
    t = t + "' TRY with an empty CATCH (see SIM95-NOTES.md); pages come in through the" + NL
    t = t + "' socket's events." + NL
    t = t + "" + NL
    t = t + "CONST HOME = ""C:\GAMES""" + NL
    t = t + "CONST ME = ""C:\PROGRAMS\VAPOR.SPK""" + NL
    t = t + "CONST STOREDIR = ""C:\WEB\VAPOR""" + NL
    t = t + "CONST BROWSER = ""C:\PROGRAMS\SIMXPLOR.SPK""" + NL
    t = t + "CONST PATIENCE = 8000" + NL
    t = t + "CONST PART = 15000" + NL
    t = t + "CONST WEBAPPS = ""C:\SYSTEM\WEBAPPS.INI""" + NL
    t = t + "" + NL
    t = t + "VAR EOL AS String" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR bar AS GUI_Menu" + NL
    t = t + "VAR head AS GUI_Canvas" + NL
    t = t + "VAR games AS GUI_ListBox" + NL
    t = t + "VAR banner AS GUI_Canvas" + NL
    t = t + "VAR title AS GUI_Label" + NL
    t = t + "VAR info AS GUI_Label" + NL
    t = t + "VAR about AS GUI_Label" + NL
    t = t + "VAR action AS GUI_Button" + NL
    t = t + "VAR upd AS GUI_Button" + NL
    t = t + "VAR remove AS GUI_Button" + NL
    t = t + "VAR progress AS GUI_ProgressBar" + NL
    t = t + "VAR note AS GUI_Label" + NL
    t = t + "VAR trophies AS GUI_ListBox" + NL
    t = t + "VAR clock AS GUI_Timer" + NL
    t = t + "VAR web AS NET_Socket" + NL
    t = t + "" + NL
    t = t + "VAR store AS String               ' ""http://alpha/vapor/""" + NL
    t = t + "VAR tab AS String = ""STORE""" + NL
    t = t + "VAR catalog AS Array OF String    ' the store's lines" + NL
    t = t + "VAR listed AS Array OF String     ' the lines behind the list, in order ("""" for a heading)" + NL
    t = t + "VAR offeredSelf AS Bool           ' asked once about a newer Vapor" + NL
    t = t + "" + NL
    t = t + "' one fetch at a time" + NL
    t = t + "VAR fetching AS Bool" + NL
    t = t + "VAR fWhat AS String               ' ""catalog"" or ""part""" + NL
    t = t + "VAR fNumber AS Integer" + NL
    t = t + "VAR fParts AS Array OF String" + NL
    t = t + "VAR fDone AS Bool" + NL
    t = t + "VAR fSince AS Integer" + NL
    t = t + "VAR fError AS String" + NL
    t = t + "VAR wantCatalog AS Bool" + NL
    t = t + "" + NL
    t = t + "' the download going on, and what is waiting" + NL
    t = t + "VAR dlId AS String                ' """" when none" + NL
    t = t + "VAR dlLine AS String" + NL
    t = t + "VAR dlPart AS Integer" + NL
    t = t + "VAR dlParts AS Integer" + NL
    t = t + "VAR dlText AS String" + NL
    t = t + "VAR dlStart AS Integer" + NL
    t = t + "VAR queue AS Array OF String      ' catalog lines waiting" + NL
    t = t + "VAR setupPid AS Integer           ' an installer Vapor is running" + NL
    t = t + "VAR setupLine AS String" + NL
    t = t + "VAR setupSince AS Integer" + NL
    t = t + "" + NL
    t = t + "' things running: id and process" + NL
    t = t + "VAR playId AS Array OF String" + NL
    t = t + "VAR playPid AS Array OF Integer" + NL
    t = t + "VAR playSince AS Array OF Integer" + NL
    t = t + "" + NL
    t = t + "' ================================================================ start" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    EOL = Chr(10)" + NL
    t = t + "    IF NOT FS.Exists(HOME) THEN FS.MakeDir(HOME)" + NL
    t = t + "    LoadSettings()" + NL
    t = t + "    win = GUI_Window.New(""Vapor"", 640, 420)" + NL
    t = t + "    win.Icon = ""app""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    bar = GUI_Menu.New(win)" + NL
    t = t + "    bar.onSelect = Menu_OnSelect" + NL
    t = t + "    bar.AddMenu(""&Vapor"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Store"" + Chr(9) + ""Ctrl+1"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Library"" + Chr(9) + ""Ctrl+2"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Downloads"" + Chr(9) + ""Ctrl+3"")" + NL
    t = t + "    bar.AddSeparator(""&Vapor"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Update All"" + Chr(9) + ""Ctrl+U"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Refresh"" + Chr(9) + ""F5"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""Change S&tore..."")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Publish Apps..."" + Chr(9) + ""Ctrl+P"")" + NL
    t = t + "    bar.AddSeparator(""&Vapor"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""E&xit"")" + NL
    t = t + "    bar.AddMenu(""&Help"")" + NL
    t = t + "    bar.AddItem(""&Help"", ""&About Vapor"")" + NL
    t = t + "    bar.SetEnabled(""Publish Apps..."", FS.Exists(STOREDIR))" + NL
    t = t + "" + NL
    t = t + "    head = GUI_Canvas.New(win)" + NL
    t = t + "    head.SetBounds(0, 0, 640, 44)" + NL
    t = t + "    head.onDraw = Head_OnDraw" + NL
    t = t + "    head.onMouseDown = Head_OnMouseDown" + NL
    t = t + "    games = GUI_ListBox.New(win)" + NL
    t = t + "    games.SetBounds(6, 50, 180, 342)" + NL
    t = t + "    games.onSelect = Games_OnSelect" + NL
    t = t + "    games.onDblClick = Action_Click" + NL
    t = t + "    banner = GUI_Canvas.New(win)" + NL
    t = t + "    banner.SetBounds(194, 50, 440, 100)" + NL
    t = t + "    banner.onDraw = Banner_OnDraw" + NL
    t = t + "    title = GUI_Label.New(win)" + NL
    t = t + "    title.Bold = TRUE" + NL
    t = t + "    title.SetBounds(194, 156, 440, 16)" + NL
    t = t + "    info = GUI_Label.New(win)" + NL
    t = t + "    info.SetBounds(194, 174, 440, 14)" + NL
    t = t + "    about = GUI_Label.New(win)" + NL
    t = t + "    about.SetBounds(194, 194, 440, 64)" + NL
    t = t + "    action = GUI_Button.New(win)" + NL
    t = t + "    action.SetBounds(194, 262, 120, 28)" + NL
    t = t + "    action.onClick = Action_Click" + NL
    t = t + "    upd = GUI_Button.New(win)" + NL
    t = t + "    upd.Text = ""U&pdate""" + NL
    t = t + "    upd.SetBounds(322, 262, 100, 28)" + NL
    t = t + "    upd.onClick = Update_Click" + NL
    t = t + "    remove = GUI_Button.New(win)" + NL
    t = t + "    remove.Text = ""&Uninstall""" + NL
    t = t + "    remove.SetBounds(430, 262, 100, 28)" + NL
    t = t + "    remove.onClick = Remove_Click" + NL
    t = t + "    progress = GUI_ProgressBar.New(win)" + NL
    t = t + "    progress.SetBounds(194, 298, 440, 14)" + NL
    t = t + "    progress.Max = 100" + NL
    t = t + "    note = GUI_Label.New(win)" + NL
    t = t + "    note.SetBounds(194, 316, 440, 14)" + NL
    t = t + "    trophies = GUI_ListBox.New(win)" + NL
    t = t + "    trophies.SetBounds(194, 334, 440, 58)" + NL
    t = t + "" + NL
    t = t + "    web = NET_Socket.New()" + NL
    t = t + "    web.onMessage = Web_OnMessage" + NL
    t = t + "    web.onClose = Web_OnClose" + NL
    t = t + "    clock = GUI_Timer.New(win)" + NL
    t = t + "    clock.Interval = 100" + NL
    t = t + "    clock.onTick = Clock_OnTick" + NL
    t = t + "    clock.Start()" + NL
    t = t + "" + NL
    t = t + "    wantCatalog = store <> """"" + NL
    t = t + "    ShowTab(""STORE"")" + NL
    t = t + "    win.Show()" + NL
    t = t + "    IF store = """" THEN ChangeStore()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB LoadSettings ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(HOME + ""\VAPOR.INI"", """").Lines()" + NL
    t = t + "        IF line.StartsWith(""store="") THEN store = line.Substring(6, line.Length - 6).Trim()" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' a machine that is a store shops at itself to begin with" + NL
    t = t + "    IF store = """" AND FS.Exists(STOREDIR + ""\CATALOG.TXT"") THEN store = ""http://"" + NET.HostName.Lower() + ""/vapor/""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SaveSettings ()" + NL
    t = t + "    FS.Write(HOME + ""\VAPOR.INI"", ""store="" + store + EOL)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Field i of a | line, or """" when the line is shorter (older lines are)." + NL
    t = t + "FUNCTION Field (line AS String, i AS Integer) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    IF i >= p.Count THEN RETURN """"" + NL
    t = t + "    RETURN p[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' key=value from a header line." + NL
    t = t + "FUNCTION Meta (header AS String, key AS String) AS String" + NL
    t = t + "    VAR part AS String" + NL
    t = t + "    FOR EACH part IN header.Split(""|"")" + NL
    t = t + "        IF part.StartsWith(key + ""="") THEN RETURN part.Substring(key.Length + 1, part.Length - key.Length - 1)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The version of this Vapor, from its own header." + NL
    t = t + "FUNCTION MyVersion () AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    text = ReadOr(ME, """")" + NL
    t = t + "    IF NOT text.StartsWith(""' VAPOR|"") THEN RETURN """"" + NL
    t = t + "    RETURN Meta(text.Lines()[0], ""version"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ tabs and lists" + NL
    t = t + "" + NL
    t = t + "FUNCTION KindName (kind AS String) AS String" + NL
    t = t + "    SELECT CASE kind" + NL
    t = t + "        CASE ""game""" + NL
    t = t + "            RETURN ""Game""" + NL
    t = t + "        CASE ""web""" + NL
    t = t + "            RETURN ""Web app""" + NL
    t = t + "        CASE ""service""" + NL
    t = t + "            RETURN ""Program, starts with SIM95""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""Program""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB ShowTab (t AS String)" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR pass AS Integer" + NL
    t = t + "    VAR heading AS Bool" + NL
    t = t + "    tab = t" + NL
    t = t + "    games.Clear()" + NL
    t = t + "    listed.Clear()" + NL
    t = t + "    IF t = ""STORE"" THEN" + NL
    t = t + "        ' apps first, then games, each under a heading" + NL
    t = t + "        FOR pass = 0 TO 1" + NL
    t = t + "            heading = FALSE" + NL
    t = t + "            FOR EACH line IN catalog" + NL
    t = t + "                IF Field(line, 7) = ""client"" THEN CONTINUE" + NL
    t = t + "                IF (Field(line, 7) = ""game"") <> (pass = 1) THEN CONTINUE" + NL
    t = t + "                IF NOT heading THEN" + NL
    t = t + "                    heading = TRUE" + NL
    t = t + "                    listed.Add("""")" + NL
    t = t + "                    IF pass = 0 THEN" + NL
    t = t + "                        games.Add(""- APPS -"")" + NL
    t = t + "                    ELSE" + NL
    t = t + "                        games.Add(""- GAMES -"")" + NL
    t = t + "                    END IF" + NL
    t = t + "                END IF" + NL
    t = t + "                listed.Add(line)" + NL
    t = t + "                IF HasUpdate(Field(line, 0)) THEN" + NL
    t = t + "                    games.Add(""  "" + Field(line, 1) + ""  (update)"")" + NL
    t = t + "                ELSEIF Installed(Field(line, 0)) THEN" + NL
    t = t + "                    games.Add(""  "" + Field(line, 1) + ""  (installed)"")" + NL
    t = t + "                ELSE" + NL
    t = t + "                    games.Add(""  "" + Field(line, 1))" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF catalog.Count = 0 THEN" + NL
    t = t + "            IF store = """" THEN" + NL
    t = t + "                win.Status = ""No store yet: choose Vapor > Change Store.""" + NL
    t = t + "            ELSE" + NL
    t = t + "                win.Status = ""Fetching the store from "" + store + ""...""" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSEIF t = ""LIBRARY"" THEN" + NL
    t = t + "        FOR EACH line IN Library()" + NL
    t = t + "            listed.Add(line)" + NL
    t = t + "            IF HasUpdate(Field(line, 0)) THEN" + NL
    t = t + "                games.Add(Field(line, 1) + ""  (update)"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                games.Add(Field(line, 1))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF listed.Count = 0 THEN win.Status = ""Your library is empty. Visit the Store!""" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF dlId <> """" THEN" + NL
    t = t + "            listed.Add(dlLine)" + NL
    t = t + "            games.Add(Field(dlLine, 1) + ""  "" + Str(Percent()) + ""%"")" + NL
    t = t + "        END IF" + NL
    t = t + "        IF setupLine <> """" THEN" + NL
    t = t + "            listed.Add(setupLine)" + NL
    t = t + "            games.Add(Field(setupLine, 1) + ""  (installing)"")" + NL
    t = t + "        END IF" + NL
    t = t + "        FOR EACH line IN queue" + NL
    t = t + "            listed.Add(line)" + NL
    t = t + "            games.Add(Field(line, 1) + ""  (queued)"")" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    head.Tag = """"" + NL
    t = t + "    DrawHead()" + NL
    t = t + "    IF listed.Count > 0 THEN" + NL
    t = t + "        games.Selected = 0" + NL
    t = t + "        IF listed[0] = """" AND listed.Count > 1 THEN games.Selected = 1" + NL
    t = t + "    END IF" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Library () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(HOME + ""\LIBRARY.TXT"", """").Lines()" + NL
    t = t + "        IF line.Split(""|"").Count >= 4 THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Installed (id AS String) AS Bool" + NL
    t = t + "    RETURN LibLine(id) <> """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LibLine (id AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN Library()" + NL
    t = t + "        IF Field(line, 0) = id THEN RETURN line" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION StoreLine (id AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN catalog" + NL
    t = t + "        IF Field(line, 0) = id THEN RETURN line" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is there a newer version in the store than the one installed?" + NL
    t = t + "FUNCTION HasUpdate (id AS String) AS Bool" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    VAR shop AS String" + NL
    t = t + "    lib = LibLine(id)" + NL
    t = t + "    shop = StoreLine(id)" + NL
    t = t + "    IF lib = """" OR shop = """" OR Field(shop, 4) <> ""ok"" THEN RETURN FALSE" + NL
    t = t + "    RETURN Field(lib, 6) <> Field(shop, 8)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Current () AS String" + NL
    t = t + "    IF games.Selected < 0 OR games.Selected >= listed.Count THEN RETURN """"" + NL
    t = t + "    RETURN listed[games.Selected]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Games_OnSelect ()" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unesc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%0A"", EOL).Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Words into lines of about n characters." + NL
    t = t + "FUNCTION Wrap (text AS String, n AS Integer) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR word AS String" + NL
    t = t + "    FOR EACH word IN text.Split("" "")" + NL
    t = t + "        IF line <> """" AND line.Length + word.Length + 1 > n THEN" + NL
    t = t + "            out = out + line + EOL" + NL
    t = t + "            line = word" + NL
    t = t + "        ELSEIF line = """" THEN" + NL
    t = t + "            line = word" + NL
    t = t + "        ELSE" + NL
    t = t + "            line = line + "" "" + word" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out + line" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Played (seconds AS Integer) AS String" + NL
    t = t + "    IF seconds < 60 THEN RETURN ""Played "" + Str(seconds) + "" seconds""" + NL
    t = t + "    IF seconds < 3600 THEN RETURN ""Played "" + Str(Int(seconds / 60)) + "" minutes""" + NL
    t = t + "    RETURN ""Played "" + Str(Int(seconds / 360) / 10) + "" hours""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Busy (id AS String) AS Bool" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    IF id = dlId OR id = Field(setupLine, 0) THEN RETURN TRUE" + NL
    t = t + "    FOR EACH line IN queue" + NL
    t = t + "        IF Field(line, 0) = id THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The right-hand side: the banner, the words, the right buttons." + NL
    t = t + "SUB ShowGame ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    VAR shop AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    line = Current()" + NL
    t = t + "    trophies.Clear()" + NL
    t = t + "    banner.Tag = """"" + NL
    t = t + "    upd.Visible = FALSE" + NL
    t = t + "    IF line = """" THEN" + NL
    t = t + "        title.Text = """"" + NL
    t = t + "        info.Text = """"" + NL
    t = t + "        about.Text = """"" + NL
    t = t + "        action.Visible = FALSE" + NL
    t = t + "        remove.Visible = FALSE" + NL
    t = t + "        DrawBanner("""")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    id = Field(line, 0)" + NL
    t = t + "    lib = LibLine(id)" + NL
    t = t + "    shop = StoreLine(id)" + NL
    t = t + "    title.Text = Field(line, 1)" + NL
    t = t + "    action.Visible = TRUE" + NL
    t = t + "    action.Enabled = TRUE" + NL
    t = t + "    remove.Visible = lib <> """"" + NL
    t = t + "    IF tab = ""LIBRARY"" THEN" + NL
    t = t + "        kind = Field(lib, 7)" + NL
    t = t + "        IF kind = """" THEN kind = ""game""" + NL
    t = t + "        IF kind = ""game"" THEN" + NL
    t = t + "            info.Text = Played(Int(Val(Field(lib, 3)))) + ""  -  installed "" + Field(lib, 2)" + NL
    t = t + "        ELSE" + NL
    t = t + "            info.Text = KindName(kind) + ""  -  installed "" + Field(lib, 2)" + NL
    t = t + "        END IF" + NL
    t = t + "        IF Field(lib, 6) <> """" THEN info.Text = info.Text + ""  -  build "" + Field(lib, 6)" + NL
    t = t + "        about.Text = Wrap(Unesc(Field(lib, 5)), 66)" + NL
    t = t + "        action.Text = OpenWord(kind)" + NL
    t = t + "        IF playId.Contains(id) THEN" + NL
    t = t + "            action.Text = ""Running""" + NL
    t = t + "            action.Enabled = FALSE" + NL
    t = t + "        END IF" + NL
    t = t + "        upd.Visible = HasUpdate(id) AND NOT Busy(id)" + NL
    t = t + "        IF kind = ""game"" THEN" + NL
    t = t + "            FOR EACH a IN ReadOr(HOME + ""\"" + id + ""\ACHIEVE.TXT"", """").Lines()" + NL
    t = t + "                IF a.Contains(""|"") THEN trophies.Add(""* "" + a.Split(""|"")[0] + "" - "" + a.Split(""|"")[1] + ""  ("" + a.Split(""|"")[2] + "")"")" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF trophies.Count = 0 THEN trophies.Add(""No achievements yet. Go and play!"")" + NL
    t = t + "        END IF" + NL
    t = t + "        IF HasUpdate(id) THEN trophies.Add(""A newer version is in the store (build "" + Field(shop, 8) + "")."")" + NL
    t = t + "    ELSE" + NL
    t = t + "        kind = Field(line, 7)" + NL
    t = t + "        IF kind = """" THEN kind = ""game""" + NL
    t = t + "        info.Text = Field(line, 5) + ""  -  "" + KindName(kind) + ""  -  "" + Str(Int(Val(Field(line, 3)) / 1024) + 1) + "" KB  -  Free""" + NL
    t = t + "        about.Text = Wrap(Unesc(Field(line, 6)), 66)" + NL
    t = t + "        IF Field(line, 4) = ""soon"" THEN" + NL
    t = t + "            info.Text = Field(line, 5) + ""  -  Coming soon""" + NL
    t = t + "            action.Text = ""Coming soon""" + NL
    t = t + "            action.Enabled = FALSE" + NL
    t = t + "        ELSEIF Busy(id) THEN" + NL
    t = t + "            action.Text = ""Downloading...""" + NL
    t = t + "            action.Enabled = FALSE" + NL
    Put("C:\WEB\VAPOR\VAPOR\1.TXT")
END SUB

SUB File7 ()
    t = ""
    t = t + "        ELSEIF HasUpdate(id) THEN" + NL
    t = t + "            action.Text = ""U&pdate""" + NL
    t = t + "        ELSEIF lib <> """" THEN" + NL
    t = t + "            action.Text = OpenWord(kind)" + NL
    t = t + "            action.Enabled = NOT playId.Contains(id)" + NL
    t = t + "        ELSE" + NL
    t = t + "            action.Text = ""&Install""" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    DrawBanner(id)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION OpenWord (kind AS String) AS String" + NL
    t = t + "    IF kind = ""game"" THEN RETURN ""&Play""" + NL
    t = t + "    RETURN ""&Open""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Action_Click ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    line = Current()" + NL
    t = t + "    IF line = """" THEN RETURN" + NL
    t = t + "    id = Field(line, 0)" + NL
    t = t + "    IF tab = ""STORE"" AND HasUpdate(id) THEN" + NL
    t = t + "        Want(StoreLine(id))" + NL
    t = t + "    ELSEIF Installed(id) THEN" + NL
    t = t + "        Launch(id)" + NL
    t = t + "    ELSEIF tab = ""STORE"" AND Field(line, 4) <> ""soon"" THEN" + NL
    t = t + "        Want(line)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Update_Click ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    line = Current()" + NL
    t = t + "    IF line = """" THEN RETURN" + NL
    t = t + "    IF HasUpdate(Field(line, 0)) THEN Want(StoreLine(Field(line, 0)))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Into the download queue. A web app asks first: it takes the home page." + NL
    t = t + "SUB Want (line AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    VAR other AS String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    IF Busy(Field(line, 0)) THEN RETURN" + NL
    t = t + "    IF Field(line, 7) = ""web"" AND NOT Installed(Field(line, 0)) AND NOT (Folders() AND Field(line, 13) <> """") THEN" + NL
    t = t + "        FOR EACH l IN Library()" + NL
    t = t + "            IF Field(l, 7) = ""web"" THEN other = Field(l, 1)" + NL
    t = t + "        NEXT" + NL
    t = t + "        box = GUI_MessageBox.New(win)" + NL
    t = t + "        box.Title = ""Vapor""" + NL
    t = t + "        box.Kind = ""confirm""" + NL
    t = t + "        box.Buttons = ""yesno""" + NL
    t = t + "        box.Text = Field(line, 1) + "" is a web app: it becomes this machine's home page, http://"" + NET.HostName.Lower() + ""/ (the page there now moves aside to WELCOME.HTM).""" + NL
    t = t + "        IF other <> """" THEN box.Text = box.Text + EOL + EOL + ""This machine already has "" + other + "" there, and a machine has room for one web app: "" + Field(line, 1) + "" will take its place.""" + NL
    t = t + "        box.Text = box.Text + EOL + EOL + ""Install it?""" + NL
    t = t + "        IF NOT box.Show() THEN RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    queue.Add(line)" + NL
    t = t + "    win.Status = Field(line, 1) + "" is queued for download.""" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Play a game, open a program, or open a web app in the browser." + NL
    t = t + "SUB Launch (id AS String)" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR run AS String" + NL
    t = t + "    VAR url AS String" + NL
    t = t + "    lib = LibLine(id)" + NL
    t = t + "    kind = Field(lib, 7)" + NL
    t = t + "    IF kind = """" OR kind = ""game"" THEN" + NL
    t = t + "        run = HOME + ""\"" + id + ""\"" + id + "".SPK""" + NL
    t = t + "    ELSE" + NL
    t = t + "        run = Field(lib, 8)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF kind = ""web"" THEN" + NL
    t = t + "        url = WebUrl(Field(lib, 12))" + NL
    t = t + "        IF FS.Exists(BROWSER) THEN" + NL
    t = t + "            SYS.Start(BROWSER, url)" + NL
    t = t + "        ELSE" + NL
    t = t + "            SYS.Start(""C:\SYSTEM\VOYAGER.EXE"", url)" + NL
    t = t + "        END IF" + NL
    t = t + "        win.Status = ""Opened "" + url" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT FS.Exists(run) THEN" + NL
    t = t + "        Say(""The files are missing ("" + run + ""). Uninstall it and install it again."", ""error"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF playId.Contains(id) THEN RETURN" + NL
    t = t + "    playId.Add(id)" + NL
    t = t + "    playPid.Add(SYS.Run(run))" + NL
    t = t + "    playSince.Add(SYS.Ticks)" + NL
    t = t + "    IF kind = ""game"" THEN" + NL
    t = t + "        win.Status = ""Playing "" + Field(lib, 1) + ""...""" + NL
    t = t + "    ELSE" + NL
    t = t + "        win.Status = ""Opened "" + Field(lib, 1) + "".""" + NL
    t = t + "    END IF" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Remove_Click ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    line = Current()" + NL
    t = t + "    IF line = """" THEN RETURN" + NL
    t = t + "    id = Field(line, 0)" + NL
    t = t + "    lib = LibLine(id)" + NL
    t = t + "    IF lib = """" THEN RETURN" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = ""Vapor""" + NL
    t = t + "    box.Kind = ""confirm""" + NL
    t = t + "    box.Buttons = ""yesno""" + NL
    t = t + "    IF Field(lib, 7) = """" OR Field(lib, 7) = ""game"" THEN" + NL
    t = t + "        box.Text = ""Uninstall "" + Field(lib, 1) + ""? Its files in "" + HOME + ""\"" + id + "" will be deleted (your achievements too).""" + NL
    t = t + "    ELSE" + NL
    t = t + "        box.Text = ""Uninstall "" + Field(lib, 1) + ""? Its program files go; anything it saved (mail, posts, settings) stays.""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT box.Show() THEN RETURN" + NL
    t = t + "    Uninstall(lib)" + NL
    t = t + "    win.Status = Field(lib, 1) + "" was uninstalled.""" + NL
    t = t + "    ShowTab(tab)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Stops it, takes it out of startup, deletes the files it wrote, and its folder here." + NL
    t = t + "SUB Uninstall (lib AS String)" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR task AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    id = Field(lib, 0)" + NL
    t = t + "    FOR EACH name IN Field(lib, 10).Split("";"")" + NL
    t = t + "        IF name = """" THEN CONTINUE" + NL
    t = t + "        FOR EACH task IN SYS.Tasks()" + NL
    t = t + "            IF task.Split(""|"")[1].Upper() = name.Upper() AND Int(Val(task.Split(""|"")[0])) <> SYS.Pid THEN SYS.Kill(Int(Val(task.Split(""|"")[0])))" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH name IN Field(lib, 11).Split("";"")" + NL
    t = t + "        IF name <> """" AND FS.Exists(""C:\SYSTEM\STARTUP\"" + name) THEN FS.Delete(""C:\SYSTEM\STARTUP\"" + name)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH f IN Field(lib, 9).Split("";"")" + NL
    t = t + "        IF f <> """" AND f.Upper() <> ME THEN" + NL
    t = t + "            IF FS.Exists(Where(f, Field(lib, 12))) THEN FS.Delete(Where(f, Field(lib, 12)))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' a web app gives the home page back (unless it had a folder of its own)" + NL
    t = t + "    IF Field(lib, 7) = ""web"" AND (Field(lib, 12) = """" OR NOT Folders()) AND NOT FS.Exists(""C:\WEB\INDEX.HTM"") AND FS.Exists(""C:\WEB\WELCOME.HTM"") THEN FS.Rename(""C:\WEB\WELCOME.HTM"", ""C:\WEB\INDEX.HTM"")" + NL
    t = t + "    IF FS.Exists(HOME + ""\"" + id) THEN" + NL
    t = t + "        FOR EACH f IN FS.List(HOME + ""\"" + id)" + NL
    t = t + "            IF NOT f.EndsWith(""\"") THEN FS.Delete(HOME + ""\"" + id + ""\"" + f)" + NL
    t = t + "        NEXT" + NL
    t = t + "        FS.Delete(HOME + ""\"" + id)" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH l IN Library()" + NL
    t = t + "        IF Field(l, 0) <> id THEN out.Add(l)" + NL
    t = t + "    NEXT" + NL
    t = t + "    SaveLibrary(out)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SaveLibrary (lines AS Array OF String)" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    IF lines.Count > 0 THEN text = lines.Join(EOL) + EOL" + NL
    t = t + "    FS.Write(HOME + ""\LIBRARY.TXT"", text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Into the library, or the line there brought up to date (keeping when it" + NL
    t = t + "' was first installed and the time played)." + NL
    t = t + "SUB Keep (line AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    VAR first AS String" + NL
    t = t + "    VAR seconds AS String = ""0""" + NL
    t = t + "    VAR found AS Bool" + NL
    t = t + "    first = TIME.Date" + NL
    t = t + "    FOR EACH l IN Library()" + NL
    t = t + "        IF Field(l, 0) = Field(line, 0) THEN" + NL
    t = t + "            first = Field(l, 2)" + NL
    t = t + "            seconds = Field(l, 3)" + NL
    t = t + "            found = TRUE" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    l = Field(line, 0) + ""|"" + Field(line, 1) + ""|"" + first + ""|"" + seconds + ""|"" + Field(line, 5) + ""|"" + Field(line, 6) + ""|"" + Field(line, 8) + ""|"" + Field(line, 7) + ""|"" + Field(line, 9) + ""|"" + Field(line, 10) + ""|"" + Field(line, 11) + ""|"" + Field(line, 12) + ""|"" + Field(line, 13)" + NL
    t = t + "    FOR EACH line IN Library()" + NL
    t = t + "        IF Field(line, 0) = Field(l, 0) THEN" + NL
    t = t + "            out.Add(l)" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT found THEN out.Add(l)" + NL
    t = t + "    SaveLibrary(out)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB UpdateAll ()" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    FOR EACH l IN Library()" + NL
    t = t + "        IF HasUpdate(Field(l, 0)) AND NOT Busy(Field(l, 0)) THEN" + NL
    t = t + "            queue.Add(StoreLine(Field(l, 0)))" + NL
    t = t + "            n = n + 1" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF n = 0 THEN" + NL
    t = t + "        win.Status = ""Everything is up to date.""" + NL
    t = t + "    ELSE" + NL
    t = t + "        win.Status = Str(n) + "" update"" + Plural(n) + "" queued.""" + NL
    t = t + "    END IF" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Plural (n AS Integer) AS String" + NL
    t = t + "    IF n = 1 THEN RETURN """"" + NL
    t = t + "    RETURN ""s""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the clock: fetches, downloads, play time" + NL
    t = t + "" + NL
    t = t + "SUB Clock_OnTick ()" + NL
    t = t + "    TRY" + NL
    t = t + "        Tick()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Alive (pid AS Integer) AS Bool" + NL
    t = t + "    VAR task AS String" + NL
    t = t + "    FOR EACH task IN SYS.Tasks()" + NL
    t = t + "        IF Int(Val(task.Split(""|"")[0])) = pid THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Tick ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    ' things that ended: a game's time goes in the library" + NL
    t = t + "    FOR i = playId.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF NOT Alive(playPid[i]) THEN" + NL
    t = t + "            AddTime(playId[i], Int((SYS.Ticks - playSince[i]) / 1000))" + NL
    t = t + "            playId.RemoveAt(i)" + NL
    t = t + "            playPid.RemoveAt(i)" + NL
    t = t + "            playSince.RemoveAt(i)" + NL
    t = t + "            ShowGame()" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' an installer that finished: into the library. (It may not end: a program" + NL
    t = t + "    ' that has printed keeps its console open. So it is done when every file" + NL
    t = t + "    ' it writes is there, or when it ends.)" + NL
    t = t + "    IF setupLine <> """" THEN" + NL
    t = t + "        IF NOT Alive(setupPid) OR (SYS.Ticks - setupSince > 300 AND AllThere(Field(setupLine, 10), Field(setupLine, 13))) OR SYS.Ticks - setupSince > 60000 THEN" + NL
    t = t + "            Keep(setupLine)" + NL
    t = t + "            win.Status = Field(setupLine, 1) + "" is installed.""" + NL
    t = t + "            note.Text = Field(setupLine, 1) + "" is ready.""" + NL
    t = t + "            progress.Value = 0" + NL
    t = t + "            setupLine = """"" + NL
    t = t + "            SYS.Beep(660, 60)" + NL
    t = t + "            ShowTab(tab)" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF fetching THEN" + NL
    t = t + "        IF fDone OR SYS.Ticks - fSince > PATIENCE THEN Arrived()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF wantCatalog AND store <> """" THEN" + NL
    t = t + "        wantCatalog = FALSE" + NL
    t = t + "        StartFetch(""catalog"", store + ""catalog.txt"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF dlId = """" AND queue.Count > 0 THEN" + NL
    t = t + "        dlLine = queue[0]" + NL
    t = t + "        queue.RemoveAt(0)" + NL
    t = t + "        dlId = Field(dlLine, 0)" + NL
    t = t + "        dlParts = Int(Val(Field(dlLine, 2)))" + NL
    t = t + "        dlPart = 0" + NL
    t = t + "        dlText = """"" + NL
    t = t + "        dlStart = SYS.Ticks" + NL
    t = t + "    END IF" + NL
    t = t + "    IF dlId <> """" THEN" + NL
    t = t + "        dlPart = dlPart + 1" + NL
    t = t + "        ' (last thing in the tick: it may be spoiled)" + NL
    t = t + "        StartFetch(""part"", store + dlId.Lower() + ""/"" + Str(dlPart) + "".txt"")" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION AllThere (files AS String, folder AS String) AS Bool" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    IF files = """" THEN RETURN FALSE" + NL
    t = t + "    FOR EACH f IN files.Split("";"")" + NL
    t = t + "        IF f <> """" AND NOT FS.Exists(Where(f, folder)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A machine set up for several web apps (SimHost's C:\SYSTEM\WEBAPPS.INI says" + NL
    t = t + "' mode=folders) keeps each in its own folder, C:\WEB\BOOK and so on." + NL
    t = t + "FUNCTION Folders () AS Bool" + NL
    t = t + "    RETURN ReadOr(WEBAPPS, """").Contains(""mode=folders"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a web app's file really is: C:\WEB\BOOK.SPK -> C:\WEB\BOOK\BOOK.SPK" + NL
    t = t + "FUNCTION Where (f AS String, folder AS String) AS String" + NL
    t = t + "    IF folder = """" OR NOT Folders() THEN RETURN f" + NL
    t = t + "    IF NOT f.Upper().StartsWith(""C:\WEB\"") THEN RETURN f" + NL
    t = t + "    RETURN ""C:\WEB\"" + folder + ""\"" + f.Substring(7, f.Length - 7)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The address of a web app: the machine, or its folder there." + NL
    t = t + "FUNCTION WebUrl (folder AS String) AS String" + NL
    t = t + "    IF folder <> """" AND Folders() THEN RETURN ""http://"" + NET.HostName.Lower() + ""/"" + folder.Lower() + ""/""" + NL
    t = t + "    RETURN ""http://"" + NET.HostName.Lower() + ""/""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB AddTime (id AS String, seconds AS Integer)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    FOR EACH line IN Library()" + NL
    t = t + "        p = line.Split(""|"")" + NL
    t = t + "        IF p[0] = id THEN" + NL
    t = t + "            p[3] = Str(Int(Val(p[3])) + seconds)" + NL
    t = t + "            line = p.Join(""|"")" + NL
    t = t + "        END IF" + NL
    t = t + "        out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    SaveLibrary(out)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Percent () AS Integer" + NL
    t = t + "    IF dlParts = 0 THEN RETURN 0" + NL
    t = t + "    RETURN Int((dlPart - 1) * 100 / dlParts)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB StartFetch (what AS String, url AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR host AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    fetching = TRUE" + NL
    t = t + "    fWhat = what" + NL
    t = t + "    fNumber = fNumber + 1" + NL
    t = t + "    fParts.Clear()" + NL
    t = t + "    fDone = FALSE" + NL
    t = t + "    fError = """"" + NL
    t = t + "    fSince = SYS.Ticks" + NL
    t = t + "    host = url.Substring(7, url.Length - 7)" + NL
    t = t + "    path = host.Substring(host.IndexOf(""/""), host.Length - host.IndexOf(""/""))" + NL
    t = t + "    host = host.Substring(0, host.IndexOf(""/""))" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = web.Connect(host, 80)" + NL
    t = t + "        conn.Tag = Str(fNumber)" + NL
    t = t + "        conn.Send(""GET "" + path + "" HTTP/1.0"" + EOL + ""Host: "" + host + EOL + ""User-Agent: Vapor/2.0 (SIM95)"")" + NL
    t = t + "    CATCH err" + NL
    t = t + "        fError = err" + NL
    t = t + "        fDone = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    IF conn.Tag = Str(fNumber) AND NOT fDone THEN fParts.Add(message)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnClose (conn AS NET_Connection)" + NL
    t = t + "    IF conn.Tag = Str(fNumber) THEN fDone = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A fetch finished (or gave up): the body, or """" with fError saying why." + NL
    t = t + "FUNCTION Body () AS String" + NL
    t = t + "    VAR raw AS String" + NL
    t = t + "    raw = fParts.Join(EOL)" + NL
    t = t + "    IF fError <> """" THEN RETURN """"" + NL
    t = t + "    IF raw = """" THEN" + NL
    t = t + "        fError = ""no answer""" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT raw.StartsWith(""HTTP/1.0 200"") THEN" + NL
    t = t + "        fError = raw.Lines()[0]" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT raw.Contains(EOL + EOL) THEN RETURN """"" + NL
    t = t + "    RETURN raw.Substring(raw.IndexOf(EOL + EOL) + 2, raw.Length - raw.IndexOf(EOL + EOL) - 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Arrived ()" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR mine AS String" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    fetching = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        web.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    text = Body()" + NL
    t = t + "    IF fWhat = ""catalog"" THEN" + NL
    t = t + "        catalog.Clear()" + NL
    t = t + "        IF text = """" THEN" + NL
    t = t + "            win.Status = ""The store at "" + store + "" did not answer ("" + fError + "").""" + NL
    t = t + "        ELSE" + NL
    t = t + "            FOR EACH line IN text.Lines()" + NL
    t = t + "                IF line.Split(""|"").Count >= 7 THEN catalog.Add(line)" + NL
    t = t + "            NEXT" + NL
    t = t + "            win.Status = ""Store: "" + store + ""  -  "" + Str(catalog.Count) + "" items""" + NL
    t = t + "        END IF" + NL
    t = t + "        IF tab <> ""DOWNLOADS"" THEN ShowTab(tab)" + NL
    t = t + "        ' a newer Vapor? ask once" + NL
    t = t + "        mine = MyVersion()" + NL
    t = t + "        line = StoreLine(""VAPOR"")" + NL
    t = t + "        IF line <> """" AND mine <> """" AND Field(line, 8) <> mine AND NOT offeredSelf AND NOT Busy(""VAPOR"") THEN" + NL
    t = t + "            offeredSelf = TRUE" + NL
    t = t + "            box = GUI_MessageBox.New(win)" + NL
    t = t + "            box.Title = ""Vapor""" + NL
    t = t + "            box.Kind = ""confirm""" + NL
    t = t + "            box.Buttons = ""yesno""" + NL
    t = t + "            box.Text = ""A new version of Vapor is in the store (build "" + Field(line, 8) + ""; this is "" + mine + "")."" + EOL + EOL + ""Update Vapor now? It will restart.""" + NL
    t = t + "            IF box.Show() THEN queue.Insert(0, line)" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' a part of the download" + NL
    t = t + "    IF text = """" THEN" + NL
    t = t + "        win.Status = ""The download of "" + Field(dlLine, 1) + "" failed ("" + fError + "").""" + NL
    t = t + "        progress.Value = 0" + NL
    t = t + "        note.Text = """"" + NL
    t = t + "        dlId = """"" + NL
    t = t + "        ShowTab(tab)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    dlText = dlText + text" + NL
    t = t + "    progress.Value = Int(dlPart * 100 / dlParts)" + NL
    t = t + "    note.Text = ""Downloading "" + Field(dlLine, 1) + "": part "" + Str(dlPart) + "" of "" + Str(dlParts) + ""  -  "" + Str(Int(dlText.Length / MATH.Max(1, SYS.Ticks - dlStart) * 1000 / 102.4) / 10) + "" KB/s""" + NL
    t = t + "    IF tab = ""DOWNLOADS"" AND games.Count > 0 THEN games.Set(0, Field(dlLine, 1) + ""  "" + Str(Int(dlPart * 100 / dlParts)) + ""%"")" + NL
    t = t + "    IF dlPart >= dlParts THEN Finish()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' All the parts are here: what happens next depends on what it is." + NL
    t = t + "SUB Finish ()" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    line = dlLine" + NL
    t = t + "    dir = HOME + ""\"" + dlId" + NL
    t = t + "    kind = Field(line, 7)" + NL
    t = t + "    IF kind = """" THEN kind = ""game""" + NL
    t = t + "    IF kind = ""client"" THEN" + NL
    t = t + "        ' a new Vapor: in place of this one, which starts it and goes" + NL
    t = t + "        FS.Write(ME, dlText)" + NL
    t = t + "        SYS.Start(ME, """")" + NL
    t = t + "        SYS.Exit(0)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    Put("C:\WEB\VAPOR\VAPOR\2.TXT")
END SUB

SUB File8 ()
    t = ""
    t = t + "    IF NOT FS.Exists(dir) THEN FS.MakeDir(dir)" + NL
    t = t + "    dlId = """"" + NL
    t = t + "    IF kind = ""game"" THEN" + NL
    t = t + "        FS.Write(dir + ""\"" + Field(line, 0) + "".SPK"", dlText)" + NL
    t = t + "        dlText = """"" + NL
    t = t + "        Keep(line)" + NL
    t = t + "        win.Status = Field(line, 1) + "" is installed. Find it in your Library.""" + NL
    t = t + "        note.Text = Field(line, 1) + "" is ready to play.""" + NL
    t = t + "        SYS.Beep(660, 60)" + NL
    t = t + "        ShowTab(tab)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' an installer: clear away the old files it writes (an update: a new" + NL
    t = t + "    ' install may need what is there, as SimHost moves web apps), run it, and" + NL
    t = t + "    ' wait for them" + NL
    t = t + "    FS.Write(dir + ""\INSTALL.SPK"", dlText)" + NL
    t = t + "    dlText = """"" + NL
    t = t + "    IF Installed(Field(line, 0)) THEN" + NL
    t = t + "        FOR EACH f IN Field(line, 10).Split("";"")" + NL
    t = t + "            IF f <> """" AND f.Upper() <> ME THEN" + NL
    t = t + "                IF FS.Exists(Where(f, Field(line, 13))) THEN FS.Delete(Where(f, Field(line, 13)))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    setupLine = line" + NL
    t = t + "    setupSince = SYS.Ticks" + NL
    t = t + "    setupPid = SYS.Run(dir + ""\INSTALL.SPK"")" + NL
    t = t + "    note.Text = ""Installing "" + Field(line, 1) + ""...""" + NL
    t = t + "    win.Status = ""Running "" + Field(line, 1) + ""'s installer...""" + NL
    t = t + "    ShowTab(tab)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ publishing (on a store machine)" + NL
    t = t + "" + NL
    t = t + "' Every installer in C:\MYFILES with a Vapor header goes on the store's shelf," + NL
    t = t + "' in place of an older version of it." + NL
    t = t + "SUB Publish ()" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR done AS Array OF String" + NL
    t = t + "    VAR same AS Array OF String" + NL
    t = t + "    VAR answer AS String" + NL
    t = t + "    IF NOT FS.Exists(STOREDIR) THEN" + NL
    t = t + "        Say(""This machine is not a Vapor store. Run Vapor's INSTALL.SPK here first."", ""warn"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    win.Status = ""Looking in C:\MYFILES for installers...""" + NL
    t = t + "    FOR EACH f IN FS.List(""C:\MYFILES"")" + NL
    t = t + "        IF NOT f.EndsWith("".SPK"") THEN CONTINUE" + NL
    t = t + "        text = FS.Read(""C:\MYFILES\"" + f)" + NL
    t = t + "        IF NOT text.StartsWith(""' VAPOR|"") THEN CONTINUE" + NL
    t = t + "        answer = PublishOne(text)" + NL
    t = t + "        IF answer.StartsWith(""="") THEN" + NL
    t = t + "            same.Add(answer.Substring(1, answer.Length - 1))" + NL
    t = t + "        ELSEIF answer <> """" THEN" + NL
    t = t + "            done.Add(answer)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF done.Count = 0 AND same.Count = 0 THEN" + NL
    t = t + "        Say(""There are no installers to publish in C:\MYFILES."" + EOL + EOL + ""Paste an app's INSTALL.SPK into SPARK, save it in C:\MYFILES (any name ending .SPK) without running it, and choose Publish Apps again."", ""info"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    answer = """"" + NL
    t = t + "    IF done.Count > 0 THEN answer = ""Published:"" + EOL + ""  "" + done.Join(EOL + ""  "")" + NL
    t = t + "    IF same.Count > 0 THEN answer = answer + EOL + EOL + ""Already up to date: "" + same.Join("", "")" + NL
    t = t + "    Say(answer.Trim(), ""info"")" + NL
    t = t + "    wantCatalog = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One installer into the store: its parts, and its line in the catalog." + NL
    t = t + "' Returns ""name (build)"" or ""=name"" when the store already had that version." + NL
    t = t + "FUNCTION PublishOne (text AS String) AS String" + NL
    t = t + "    VAR header AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR chunk AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR entry AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR found AS Bool" + NL
    t = t + "    header = text.Lines()[0]" + NL
    t = t + "    id = Meta(header, ""id"").Upper()" + NL
    t = t + "    IF id = """" OR id.Length > 8 OR id.Contains(""\"") OR id.Contains(""."") THEN RETURN """"" + NL
    t = t + "    FOR EACH line IN ReadOr(STOREDIR + ""\CATALOG.TXT"", """").Lines()" + NL
    t = t + "        IF Field(line, 0) = id AND Field(line, 8) = Meta(header, ""version"") THEN RETURN ""="" + Meta(header, ""name"")" + NL
    t = t + "    NEXT" + NL
    t = t + "    dir = STOREDIR + ""\"" + id" + NL
    t = t + "    IF FS.Exists(dir) THEN" + NL
    t = t + "        FOR EACH f IN FS.List(dir)" + NL
    t = t + "            IF NOT f.EndsWith(""\"") THEN FS.Delete(dir + ""\"" + f)" + NL
    t = t + "        NEXT" + NL
    t = t + "    ELSE" + NL
    t = t + "        FS.MakeDir(dir)" + NL
    t = t + "    END IF" + NL
    t = t + "    ' parts of whole lines, each small enough for one network message" + NL
    t = t + "    lines = text.Replace(Chr(13), """").Split(EOL)" + NL
    t = t + "    IF lines.Count > 0 THEN" + NL
    t = t + "        IF lines[lines.Count - 1] = """" THEN lines.RemoveAt(lines.Count - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH line IN lines" + NL
    t = t + "        IF chunk.Length + line.Length + 1 > PART AND chunk <> """" THEN" + NL
    t = t + "            n = n + 1" + NL
    t = t + "            FS.Write(dir + ""\"" + Str(n) + "".TXT"", chunk)" + NL
    t = t + "            chunk = """"" + NL
    t = t + "        END IF" + NL
    t = t + "        chunk = chunk + line + EOL" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF chunk <> """" THEN" + NL
    t = t + "        n = n + 1" + NL
    t = t + "        FS.Write(dir + ""\"" + Str(n) + "".TXT"", chunk)" + NL
    t = t + "    END IF" + NL
    t = t + "    entry = id + ""|"" + Meta(header, ""name"") + ""|"" + Str(n) + ""|"" + Str(text.Length) + ""|ok|"" + Meta(header, ""category"") + ""|"" + Meta(header, ""about"") + ""|"" + Meta(header, ""kind"") + ""|"" + Meta(header, ""version"") + ""|"" + Meta(header, ""run"") + ""|"" + Meta(header, ""files"") + ""|"" + Meta(header, ""tasks"") + ""|"" + Meta(header, ""startup"") + ""|"" + Meta(header, ""folder"").Upper()" + NL
    t = t + "    FOR EACH line IN ReadOr(STOREDIR + ""\CATALOG.TXT"", """").Lines()" + NL
    t = t + "        IF line = """" THEN CONTINUE" + NL
    t = t + "        IF Field(line, 0) = id THEN" + NL
    t = t + "            out.Add(entry)" + NL
    t = t + "            found = TRUE" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT found THEN out.Add(entry)" + NL
    t = t + "    FS.Write(STOREDIR + ""\CATALOG.TXT"", out.Join(EOL) + EOL)" + NL
    t = t + "    RETURN Meta(header, ""name"") + "" (build "" + Meta(header, ""version"") + "")""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the header and the banners" + NL
    t = t + "" + NL
    t = t + "SUB Head_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    head.Tag = """"" + NL
    t = t + "    DrawHead()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawHead ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR names AS Array OF String" + NL
    t = t + "    IF head.Tag = tab THEN RETURN" + NL
    t = t + "    head.Tag = tab" + NL
    t = t + "    head.Clear()" + NL
    t = t + "    head.SetColor(0)" + NL
    t = t + "    head.FillRect(0, 0, 640, 44)" + NL
    t = t + "    head.SetColor(4)" + NL
    t = t + "    head.FillRect(0, 0, 640, 40)" + NL
    t = t + "    ' the logo: steam rising off a V" + NL
    t = t + "    head.SetColor(15)" + NL
    t = t + "    head.FillCircle(22, 14, 4)" + NL
    t = t + "    head.FillCircle(28, 9, 3)" + NL
    t = t + "    head.FillCircle(17, 8, 2)" + NL
    t = t + "    head.SetColor(14)" + NL
    t = t + "    head.Text(38, 12, ""VAPOR"")" + NL
    t = t + "    names = [""STORE"", ""LIBRARY"", ""DOWNLOADS""]" + NL
    t = t + "    FOR i = 0 TO 2" + NL
    t = t + "        IF names[i] = tab THEN" + NL
    t = t + "            head.SetColor(14)" + NL
    t = t + "            head.FillRect(150 + i * 130, 36, 110, 4)" + NL
    t = t + "            head.SetColor(15)" + NL
    t = t + "        ELSE" + NL
    t = t + "            head.SetColor(7)" + NL
    t = t + "        END IF" + NL
    t = t + "        head.Text(150 + i * 130, 12, names[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Head_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    IF x >= 150 AND x < 270 THEN ShowTab(""STORE"")" + NL
    t = t + "    IF x >= 280 AND x < 400 THEN ShowTab(""LIBRARY"")" + NL
    t = t + "    IF x >= 410 AND x < 540 THEN ShowTab(""DOWNLOADS"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Banner_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    line = Current()" + NL
    t = t + "    banner.Tag = """"" + NL
    t = t + "    DrawBanner(Field(line, 0))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Each item's banner, drawn." + NL
    t = t + "SUB DrawBanner (id AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF banner.Tag = id AND id <> """" THEN RETURN" + NL
    t = t + "    banner.Tag = id" + NL
    t = t + "    banner.Clear()" + NL
    t = t + "    SELECT CASE id" + NL
    t = t + "        CASE ""SIMDOOM""" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "            FOR i = 0 TO 54" + NL
    t = t + "                banner.SetColor(9 - 8 * (i MOD 2))" + NL
    t = t + "                banner.FillRect(i * 8, 60 + Rnd(25), 8, 40)" + NL
    t = t + "                banner.SetColor(11)" + NL
    t = t + "                banner.FillRect(i * 8 + 2, 84 + Rnd(10), 4, 16)" + NL
    t = t + "            NEXT" + NL
    t = t + "            banner.SetColor(1)" + NL
    t = t + "            banner.Text(152, 30, ""S I M D O O M"")" + NL
    t = t + "            banner.SetColor(9)" + NL
    t = t + "            banner.Text(150, 28, ""S I M D O O M"")" + NL
    t = t + "        CASE ""SNAKE""" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "            FOR i = 0 TO 20" + NL
    t = t + "                banner.SetColor(2)" + NL
    t = t + "                banner.FillRect(60 + i * 12, 50 + Int(10 * MATH.Sin(i / 2)), 10, 10)" + NL
    t = t + "            NEXT" + NL
    t = t + "            banner.SetColor(9)" + NL
    t = t + "            banner.FillCircle(360, 55, 5)" + NL
    t = t + "            banner.SetColor(10)" + NL
    t = t + "            banner.Text(170, 14, ""SNAKE 95"")" + NL
    t = t + "        CASE ""HL3""" + NL
    t = t + "            banner.SetColor(3)" + NL
    t = t + "            banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "            banner.SetColor(11)" + NL
    t = t + "            banner.FillCircle(70, 50, 34)" + NL
    t = t + "            banner.SetColor(3)" + NL
    t = t + "            banner.FillCircle(70, 50, 28)" + NL
    t = t + "            banner.SetColor(11)" + NL
    t = t + "            banner.Line(58, 30, 82, 72)" + NL
    t = t + "            banner.Line(70, 50, 56, 72)" + NL
    t = t + "            banner.SetColor(15)" + NL
    t = t + "            banner.Text(130, 34, ""HALF-LIFE 3"")" + NL
    t = t + "            banner.SetColor(11)" + NL
    t = t + "            banner.Text(130, 56, ""Coming soon(TM)"")" + NL
    t = t + "        CASE ""SIMXPLOR""" + NL
    t = t + "            Plate(1, 15, ""Simxplorer"")" + NL
    t = t + "            banner.SetColor(12)" + NL
    t = t + "            FOR i = 0 TO 15" + NL
    t = t + "                banner.FillCircle(60 + Int(14 * MATH.Cos((-40 - i * 15) * MATH.Pi / 180)), 36 + Int(11 * MATH.Sin((-40 - i * 15) * MATH.Pi / 180)), 4)" + NL
    t = t + "                banner.FillCircle(60 + Int(14 * MATH.Cos((-90 + i * 15) * MATH.Pi / 180)), 58 + Int(11 * MATH.Sin((-90 + i * 15) * MATH.Pi / 180)), 4)" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""FROSTBRD""" + NL
    t = t + "            Plate(14, 4, ""Frostbird"")" + NL
    t = t + "            banner.SetColor(15)" + NL
    t = t + "            banner.FillRect(30, 30, 60, 40)" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.Rect(30, 30, 60, 40)" + NL
    t = t + "            banner.Line(30, 30, 60, 52)" + NL
    t = t + "            banner.Line(60, 52, 89, 30)" + NL
    t = t + "        CASE ""CLIPPY""" + NL
    t = t + "            Plate(11, 0, ""Clippy"")" + NL
    t = t + "            banner.SetColor(8)" + NL
    t = t + "            banner.Rect(50, 18, 20, 66)" + NL
    t = t + "            banner.Rect(56, 26, 10, 46)" + NL
    t = t + "            banner.SetColor(15)" + NL
    t = t + "            banner.FillCircle(54, 40, 6)" + NL
    t = t + "            banner.FillCircle(70, 40, 6)" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.FillCircle(55, 41, 2)" + NL
    t = t + "            banner.FillCircle(71, 41, 2)" + NL
    t = t + "        CASE ""SIMBOOK""" + NL
    t = t + "            Plate(4, 15, ""[simbook]"")" + NL
    t = t + "        CASE ""COLDMAIL""" + NL
    t = t + "            Plate(14, 4, ""ColdMail!"")" + NL
    t = t + "        CASE ""ASKSIM""" + NL
    t = t + "            Plate(5, 15, ""AskSim"")" + NL
    t = t + "            banner.SetColor(7)" + NL
    t = t + "            banner.FillCircle(60, 40, 16)" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.FillRect(44, 58, 32, 30)" + NL
    t = t + "        CASE ""ELIZA""" + NL
    t = t + "            Plate(6, 15, ""ELIZA-95"")" + NL
    t = t + "        CASE """"" + NL
    t = t + "            banner.SetColor(7)" + NL
    t = t + "            banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            Plate(4, 15, id)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A plain banner: a colour, and the name in big letters." + NL
    t = t + "SUB Plate (back AS Integer, ink AS Integer, name AS String)" + NL
    t = t + "    banner.SetColor(back)" + NL
    t = t + "    banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "    banner.SetColor(8)" + NL
    t = t + "    banner.Text(132, 42, name)" + NL
    t = t + "    banner.SetColor(ink)" + NL
    t = t + "    banner.Text(130, 40, name)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ menus" + NL
    t = t + "" + NL
    t = t + "SUB Menu_OnSelect (item AS String)" + NL
    t = t + "    SELECT CASE item" + NL
    t = t + "        CASE ""Store""" + NL
    t = t + "            ShowTab(""STORE"")" + NL
    t = t + "        CASE ""Library""" + NL
    t = t + "            ShowTab(""LIBRARY"")" + NL
    t = t + "        CASE ""Downloads""" + NL
    t = t + "            ShowTab(""DOWNLOADS"")" + NL
    t = t + "        CASE ""Update All""" + NL
    t = t + "            UpdateAll()" + NL
    t = t + "        CASE ""Change Store...""" + NL
    t = t + "            ChangeStore()" + NL
    t = t + "        CASE ""Publish Apps...""" + NL
    t = t + "            Publish()" + NL
    t = t + "        CASE ""Refresh""" + NL
    t = t + "            wantCatalog = TRUE" + NL
    t = t + "        CASE ""Exit""" + NL
    t = t + "            win.Close()" + NL
    t = t + "        CASE ""About Vapor""" + NL
    t = t + "            Say(""Vapor 2.0 for SIM95 (build "" + MyVersion() + "")"" + EOL + EOL + ""Games, programs and web apps from any machine that runs a Vapor store (http://machine/vapor/): downloads, a library with updates, play time and achievements."" + EOL + EOL + ""Half-Life 3 is coming soon."", ""info"")" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "VAR askWin AS GUI_Window" + NL
    t = t + "VAR askBox AS GUI_TextBox" + NL
    t = t + "" + NL
    t = t + "SUB ChangeStore ()" + NL
    t = t + "    VAR l AS GUI_Label" + NL
    t = t + "    VAR b AS GUI_Button" + NL
    t = t + "    askWin = GUI_Window.New(""Vapor Store"", 360, 110)" + NL
    t = t + "    askWin.Modal = TRUE" + NL
    t = t + "    l = GUI_Label.New(askWin)" + NL
    t = t + "    l.Text = ""Which machine is your store? (Any machine with Vapor"" + EOL + ""installed is one: type its name, like alpha.)""" + NL
    t = t + "    l.SetBounds(10, 8, 340, 30)" + NL
    t = t + "    askBox = GUI_TextBox.New(askWin)" + NL
    t = t + "    askBox.Text = store" + NL
    t = t + "    askBox.SetBounds(10, 44, 340, 21)" + NL
    t = t + "    askBox.onEnter = Store_Ok" + NL
    t = t + "    b = GUI_Button.New(askWin)" + NL
    t = t + "    b.Text = ""OK""" + NL
    t = t + "    b.Default = TRUE" + NL
    t = t + "    b.SetBounds(272, 74, 78, 26)" + NL
    t = t + "    b.onClick = Store_Ok" + NL
    t = t + "    askWin.Center()" + NL
    t = t + "    askWin.Show()" + NL
    t = t + "    askBox.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Store_Ok ()" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = askBox.Text.Trim().Lower()" + NL
    t = t + "    IF s = """" THEN RETURN" + NL
    t = t + "    IF NOT s.StartsWith(""http://"") THEN s = ""http://"" + s" + NL
    t = t + "    IF s.Substring(7, s.Length - 7).IndexOf(""/"") < 0 THEN s = s + ""/vapor/""" + NL
    t = t + "    IF NOT s.EndsWith(""/"") THEN s = s + ""/""" + NL
    t = t + "    store = s" + NL
    t = t + "    SaveSettings()" + NL
    t = t + "    askWin.Close()" + NL
    t = t + "    catalog.Clear()" + NL
    t = t + "    wantCatalog = TRUE" + NL
    t = t + "    ShowTab(""STORE"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Say (text AS String, kind AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = ""Vapor""" + NL
    t = t + "    box.Kind = kind" + NL
    t = t + "    box.Text = text" + NL
    t = t + "    box.Show()" + NL
    t = t + "END SUB" + NL
    Put("C:\WEB\VAPOR\VAPOR\3.TXT")
END SUB

SUB File9 ()
    t = ""
    t = t + "SIMDOOM|SimDOOM|2|23549|ok|Shooter|Rip and tear through E1M1 in glorious 16 colours. A real raycast 3D view, imps that chase you, a pistol, health and ammo, a face that watches you, and achievements. Type IDDQD at your own risk.|game|c0f9cfa6|C:\GAMES\SIMDOOM\SIMDOOM.SPK|C:\GAMES\SIMDOOM\SIMDOOM.SPK|SIMDOOM||" + NL
    t = t + "SNAKE|Snake 95|1|5545|ok|Arcade|Eat the dots. Grow longer. Don't eat yourself. The game that sold a million phones, now on SIM95.|game|aa5d9aeb|C:\GAMES\SNAKE\SNAKE.SPK|C:\GAMES\SNAKE\SNAKE.SPK|SNAKE||" + NL
    t = t + "HL3|Half-Life 3|0|0|soon|Shooter|The long-awaited conclusion. Coming soon.|game|||||" + NL
    t = t + "VAPOR|Vapor|3|42186|ok|Vapor|The Vapor program itself.|client|c1a16ea6|C:\PROGRAMS\VAPOR.SPK|C:\PROGRAMS\VAPOR.SPK|VAPOR||" + NL
    Put("C:\WEB\VAPOR\CATALOG.TXT")
END SUB

SUB File10 ()
    t = ""
    t = t + "' VAPOR|id=VAPOR|name=Vapor|kind=client|version=c1a16ea6|category=Vapor|run=C:\PROGRAMS\VAPOR.SPK|files=C:\PROGRAMS\VAPOR.SPK|tasks=VAPOR|startup=|folder=|about=The Vapor program itself." + NL
    t = t + "' VAPOR.SPK - Vapor, the store and library for everything on SIM95: games," + NL
    t = t + "' programs (Simxplorer, Frostbird, Clippy...) and web apps (SimBook, ColdMail," + NL
    t = t + "' AskSim, ELIZA-95)." + NL
    t = t + "'" + NL
    t = t + "' A store is a folder on a web server, http://<machine>/vapor/, holding" + NL
    t = t + "' CATALOG.TXT, one item per line:" + NL
    t = t + "'   id|name|parts|bytes|status|category|about|kind|version|run|files|tasks|startup" + NL
    t = t + "' and each item cut into parts small enough for a network message" + NL
    t = t + "' (/vapor/<id>/<n>.txt). An item is a file that starts with a header line," + NL
    t = t + "'   ' VAPOR|id=...|name=...|kind=...|version=...|..." + NL
    t = t + "' kind says what to do with it once it is here:" + NL
    t = t + "'   game     it is the game: kept in C:\GAMES\<id>\<id>.SPK and played from there" + NL
    t = t + "'   program  it is an installer: Vapor runs it, then ""run"" opens the program" + NL
    t = t + "'   service  the same, for something that starts with the machine (Clippy)" + NL
    t = t + "'   web      an installer for a web app, which becomes this machine's home page" + NL
    t = t + "'   client   Vapor itself: a new version replaces this program, which restarts" + NL
    t = t + "'" + NL
    t = t + "' The library (C:\GAMES\LIBRARY.TXT) remembers what is installed, which" + NL
    t = t + "' version, and the time played. When the store has a newer version of" + NL
    t = t + "' something, the Library offers Update (or Update All)." + NL
    t = t + "'" + NL
    t = t + "' On a store machine, Publish Apps puts every installer saved in C:\MYFILES" + NL
    t = t + "' that has a header (all the ones tools/build-installer.mjs makes) into the" + NL
    t = t + "' store, replacing older versions: that is how a store's shelves are stocked" + NL
    t = t + "' and updated." + NL
    t = t + "'" + NL
    t = t + "' Fetches go one at a time and start in a timer tick of their own, inside a" + NL
    t = t + "' TRY with an empty CATCH (see SIM95-NOTES.md); pages come in through the" + NL
    t = t + "' socket's events." + NL
    t = t + "" + NL
    t = t + "CONST HOME = ""C:\GAMES""" + NL
    t = t + "CONST ME = ""C:\PROGRAMS\VAPOR.SPK""" + NL
    t = t + "CONST STOREDIR = ""C:\WEB\VAPOR""" + NL
    t = t + "CONST BROWSER = ""C:\PROGRAMS\SIMXPLOR.SPK""" + NL
    t = t + "CONST PATIENCE = 8000" + NL
    t = t + "CONST PART = 15000" + NL
    t = t + "CONST WEBAPPS = ""C:\SYSTEM\WEBAPPS.INI""" + NL
    t = t + "" + NL
    t = t + "VAR EOL AS String" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR bar AS GUI_Menu" + NL
    t = t + "VAR head AS GUI_Canvas" + NL
    t = t + "VAR games AS GUI_ListBox" + NL
    t = t + "VAR banner AS GUI_Canvas" + NL
    t = t + "VAR title AS GUI_Label" + NL
    t = t + "VAR info AS GUI_Label" + NL
    t = t + "VAR about AS GUI_Label" + NL
    t = t + "VAR action AS GUI_Button" + NL
    t = t + "VAR upd AS GUI_Button" + NL
    t = t + "VAR remove AS GUI_Button" + NL
    t = t + "VAR progress AS GUI_ProgressBar" + NL
    t = t + "VAR note AS GUI_Label" + NL
    t = t + "VAR trophies AS GUI_ListBox" + NL
    t = t + "VAR clock AS GUI_Timer" + NL
    t = t + "VAR web AS NET_Socket" + NL
    t = t + "" + NL
    t = t + "VAR store AS String               ' ""http://alpha/vapor/""" + NL
    t = t + "VAR tab AS String = ""STORE""" + NL
    t = t + "VAR catalog AS Array OF String    ' the store's lines" + NL
    t = t + "VAR listed AS Array OF String     ' the lines behind the list, in order ("""" for a heading)" + NL
    t = t + "VAR offeredSelf AS Bool           ' asked once about a newer Vapor" + NL
    t = t + "" + NL
    t = t + "' one fetch at a time" + NL
    t = t + "VAR fetching AS Bool" + NL
    t = t + "VAR fWhat AS String               ' ""catalog"" or ""part""" + NL
    t = t + "VAR fNumber AS Integer" + NL
    t = t + "VAR fParts AS Array OF String" + NL
    t = t + "VAR fDone AS Bool" + NL
    t = t + "VAR fSince AS Integer" + NL
    t = t + "VAR fError AS String" + NL
    t = t + "VAR wantCatalog AS Bool" + NL
    t = t + "" + NL
    t = t + "' the download going on, and what is waiting" + NL
    t = t + "VAR dlId AS String                ' """" when none" + NL
    t = t + "VAR dlLine AS String" + NL
    t = t + "VAR dlPart AS Integer" + NL
    t = t + "VAR dlParts AS Integer" + NL
    t = t + "VAR dlText AS String" + NL
    t = t + "VAR dlStart AS Integer" + NL
    t = t + "VAR queue AS Array OF String      ' catalog lines waiting" + NL
    t = t + "VAR setupPid AS Integer           ' an installer Vapor is running" + NL
    t = t + "VAR setupLine AS String" + NL
    t = t + "VAR setupSince AS Integer" + NL
    t = t + "" + NL
    t = t + "' things running: id and process" + NL
    t = t + "VAR playId AS Array OF String" + NL
    t = t + "VAR playPid AS Array OF Integer" + NL
    t = t + "VAR playSince AS Array OF Integer" + NL
    t = t + "" + NL
    t = t + "' ================================================================ start" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    EOL = Chr(10)" + NL
    t = t + "    IF NOT FS.Exists(HOME) THEN FS.MakeDir(HOME)" + NL
    t = t + "    LoadSettings()" + NL
    t = t + "    win = GUI_Window.New(""Vapor"", 640, 420)" + NL
    t = t + "    win.Icon = ""app""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    bar = GUI_Menu.New(win)" + NL
    t = t + "    bar.onSelect = Menu_OnSelect" + NL
    t = t + "    bar.AddMenu(""&Vapor"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Store"" + Chr(9) + ""Ctrl+1"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Library"" + Chr(9) + ""Ctrl+2"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Downloads"" + Chr(9) + ""Ctrl+3"")" + NL
    t = t + "    bar.AddSeparator(""&Vapor"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Update All"" + Chr(9) + ""Ctrl+U"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Refresh"" + Chr(9) + ""F5"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""Change S&tore..."")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Publish Apps..."" + Chr(9) + ""Ctrl+P"")" + NL
    t = t + "    bar.AddSeparator(""&Vapor"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""E&xit"")" + NL
    t = t + "    bar.AddMenu(""&Help"")" + NL
    t = t + "    bar.AddItem(""&Help"", ""&About Vapor"")" + NL
    t = t + "    bar.SetEnabled(""Publish Apps..."", FS.Exists(STOREDIR))" + NL
    t = t + "" + NL
    t = t + "    head = GUI_Canvas.New(win)" + NL
    t = t + "    head.SetBounds(0, 0, 640, 44)" + NL
    t = t + "    head.onDraw = Head_OnDraw" + NL
    t = t + "    head.onMouseDown = Head_OnMouseDown" + NL
    t = t + "    games = GUI_ListBox.New(win)" + NL
    t = t + "    games.SetBounds(6, 50, 180, 342)" + NL
    t = t + "    games.onSelect = Games_OnSelect" + NL
    t = t + "    games.onDblClick = Action_Click" + NL
    t = t + "    banner = GUI_Canvas.New(win)" + NL
    t = t + "    banner.SetBounds(194, 50, 440, 100)" + NL
    t = t + "    banner.onDraw = Banner_OnDraw" + NL
    t = t + "    title = GUI_Label.New(win)" + NL
    t = t + "    title.Bold = TRUE" + NL
    t = t + "    title.SetBounds(194, 156, 440, 16)" + NL
    t = t + "    info = GUI_Label.New(win)" + NL
    t = t + "    info.SetBounds(194, 174, 440, 14)" + NL
    t = t + "    about = GUI_Label.New(win)" + NL
    t = t + "    about.SetBounds(194, 194, 440, 64)" + NL
    t = t + "    action = GUI_Button.New(win)" + NL
    t = t + "    action.SetBounds(194, 262, 120, 28)" + NL
    t = t + "    action.onClick = Action_Click" + NL
    t = t + "    upd = GUI_Button.New(win)" + NL
    t = t + "    upd.Text = ""U&pdate""" + NL
    t = t + "    upd.SetBounds(322, 262, 100, 28)" + NL
    t = t + "    upd.onClick = Update_Click" + NL
    t = t + "    remove = GUI_Button.New(win)" + NL
    t = t + "    remove.Text = ""&Uninstall""" + NL
    t = t + "    remove.SetBounds(430, 262, 100, 28)" + NL
    t = t + "    remove.onClick = Remove_Click" + NL
    t = t + "    progress = GUI_ProgressBar.New(win)" + NL
    t = t + "    progress.SetBounds(194, 298, 440, 14)" + NL
    t = t + "    progress.Max = 100" + NL
    t = t + "    note = GUI_Label.New(win)" + NL
    t = t + "    note.SetBounds(194, 316, 440, 14)" + NL
    t = t + "    trophies = GUI_ListBox.New(win)" + NL
    t = t + "    trophies.SetBounds(194, 334, 440, 58)" + NL
    t = t + "" + NL
    t = t + "    web = NET_Socket.New()" + NL
    t = t + "    web.onMessage = Web_OnMessage" + NL
    t = t + "    web.onClose = Web_OnClose" + NL
    t = t + "    clock = GUI_Timer.New(win)" + NL
    t = t + "    clock.Interval = 100" + NL
    t = t + "    clock.onTick = Clock_OnTick" + NL
    t = t + "    clock.Start()" + NL
    t = t + "" + NL
    t = t + "    wantCatalog = store <> """"" + NL
    t = t + "    ShowTab(""STORE"")" + NL
    t = t + "    win.Show()" + NL
    t = t + "    IF store = """" THEN ChangeStore()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB LoadSettings ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(HOME + ""\VAPOR.INI"", """").Lines()" + NL
    t = t + "        IF line.StartsWith(""store="") THEN store = line.Substring(6, line.Length - 6).Trim()" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' a machine that is a store shops at itself to begin with" + NL
    t = t + "    IF store = """" AND FS.Exists(STOREDIR + ""\CATALOG.TXT"") THEN store = ""http://"" + NET.HostName.Lower() + ""/vapor/""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SaveSettings ()" + NL
    t = t + "    FS.Write(HOME + ""\VAPOR.INI"", ""store="" + store + EOL)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Field i of a | line, or """" when the line is shorter (older lines are)." + NL
    t = t + "FUNCTION Field (line AS String, i AS Integer) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    IF i >= p.Count THEN RETURN """"" + NL
    t = t + "    RETURN p[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' key=value from a header line." + NL
    t = t + "FUNCTION Meta (header AS String, key AS String) AS String" + NL
    t = t + "    VAR part AS String" + NL
    t = t + "    FOR EACH part IN header.Split(""|"")" + NL
    t = t + "        IF part.StartsWith(key + ""="") THEN RETURN part.Substring(key.Length + 1, part.Length - key.Length - 1)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The version of this Vapor, from its own header." + NL
    t = t + "FUNCTION MyVersion () AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    text = ReadOr(ME, """")" + NL
    t = t + "    IF NOT text.StartsWith(""' VAPOR|"") THEN RETURN """"" + NL
    t = t + "    RETURN Meta(text.Lines()[0], ""version"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ tabs and lists" + NL
    t = t + "" + NL
    t = t + "FUNCTION KindName (kind AS String) AS String" + NL
    t = t + "    SELECT CASE kind" + NL
    t = t + "        CASE ""game""" + NL
    t = t + "            RETURN ""Game""" + NL
    t = t + "        CASE ""web""" + NL
    t = t + "            RETURN ""Web app""" + NL
    t = t + "        CASE ""service""" + NL
    t = t + "            RETURN ""Program, starts with SIM95""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""Program""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB ShowTab (t AS String)" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR pass AS Integer" + NL
    t = t + "    VAR heading AS Bool" + NL
    t = t + "    tab = t" + NL
    t = t + "    games.Clear()" + NL
    t = t + "    listed.Clear()" + NL
    t = t + "    IF t = ""STORE"" THEN" + NL
    t = t + "        ' apps first, then games, each under a heading" + NL
    t = t + "        FOR pass = 0 TO 1" + NL
    t = t + "            heading = FALSE" + NL
    t = t + "            FOR EACH line IN catalog" + NL
    t = t + "                IF Field(line, 7) = ""client"" THEN CONTINUE" + NL
    t = t + "                IF (Field(line, 7) = ""game"") <> (pass = 1) THEN CONTINUE" + NL
    t = t + "                IF NOT heading THEN" + NL
    t = t + "                    heading = TRUE" + NL
    t = t + "                    listed.Add("""")" + NL
    t = t + "                    IF pass = 0 THEN" + NL
    t = t + "                        games.Add(""- APPS -"")" + NL
    t = t + "                    ELSE" + NL
    t = t + "                        games.Add(""- GAMES -"")" + NL
    t = t + "                    END IF" + NL
    t = t + "                END IF" + NL
    t = t + "                listed.Add(line)" + NL
    t = t + "                IF HasUpdate(Field(line, 0)) THEN" + NL
    t = t + "                    games.Add(""  "" + Field(line, 1) + ""  (update)"")" + NL
    t = t + "                ELSEIF Installed(Field(line, 0)) THEN" + NL
    t = t + "                    games.Add(""  "" + Field(line, 1) + ""  (installed)"")" + NL
    t = t + "                ELSE" + NL
    t = t + "                    games.Add(""  "" + Field(line, 1))" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF catalog.Count = 0 THEN" + NL
    t = t + "            IF store = """" THEN" + NL
    t = t + "                win.Status = ""No store yet: choose Vapor > Change Store.""" + NL
    t = t + "            ELSE" + NL
    t = t + "                win.Status = ""Fetching the store from "" + store + ""...""" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSEIF t = ""LIBRARY"" THEN" + NL
    t = t + "        FOR EACH line IN Library()" + NL
    t = t + "            listed.Add(line)" + NL
    t = t + "            IF HasUpdate(Field(line, 0)) THEN" + NL
    t = t + "                games.Add(Field(line, 1) + ""  (update)"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                games.Add(Field(line, 1))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF listed.Count = 0 THEN win.Status = ""Your library is empty. Visit the Store!""" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF dlId <> """" THEN" + NL
    t = t + "            listed.Add(dlLine)" + NL
    t = t + "            games.Add(Field(dlLine, 1) + ""  "" + Str(Percent()) + ""%"")" + NL
    t = t + "        END IF" + NL
    t = t + "        IF setupLine <> """" THEN" + NL
    t = t + "            listed.Add(setupLine)" + NL
    t = t + "            games.Add(Field(setupLine, 1) + ""  (installing)"")" + NL
    t = t + "        END IF" + NL
    t = t + "        FOR EACH line IN queue" + NL
    t = t + "            listed.Add(line)" + NL
    t = t + "            games.Add(Field(line, 1) + ""  (queued)"")" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    head.Tag = """"" + NL
    t = t + "    DrawHead()" + NL
    t = t + "    IF listed.Count > 0 THEN" + NL
    t = t + "        games.Selected = 0" + NL
    t = t + "        IF listed[0] = """" AND listed.Count > 1 THEN games.Selected = 1" + NL
    t = t + "    END IF" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Library () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(HOME + ""\LIBRARY.TXT"", """").Lines()" + NL
    t = t + "        IF line.Split(""|"").Count >= 4 THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Installed (id AS String) AS Bool" + NL
    t = t + "    RETURN LibLine(id) <> """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LibLine (id AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN Library()" + NL
    t = t + "        IF Field(line, 0) = id THEN RETURN line" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION StoreLine (id AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN catalog" + NL
    t = t + "        IF Field(line, 0) = id THEN RETURN line" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is there a newer version in the store than the one installed?" + NL
    t = t + "FUNCTION HasUpdate (id AS String) AS Bool" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    VAR shop AS String" + NL
    t = t + "    lib = LibLine(id)" + NL
    t = t + "    shop = StoreLine(id)" + NL
    t = t + "    IF lib = """" OR shop = """" OR Field(shop, 4) <> ""ok"" THEN RETURN FALSE" + NL
    t = t + "    RETURN Field(lib, 6) <> Field(shop, 8)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Current () AS String" + NL
    t = t + "    IF games.Selected < 0 OR games.Selected >= listed.Count THEN RETURN """"" + NL
    t = t + "    RETURN listed[games.Selected]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Games_OnSelect ()" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unesc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%0A"", EOL).Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Words into lines of about n characters." + NL
    t = t + "FUNCTION Wrap (text AS String, n AS Integer) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR word AS String" + NL
    t = t + "    FOR EACH word IN text.Split("" "")" + NL
    t = t + "        IF line <> """" AND line.Length + word.Length + 1 > n THEN" + NL
    t = t + "            out = out + line + EOL" + NL
    t = t + "            line = word" + NL
    t = t + "        ELSEIF line = """" THEN" + NL
    t = t + "            line = word" + NL
    t = t + "        ELSE" + NL
    t = t + "            line = line + "" "" + word" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out + line" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Played (seconds AS Integer) AS String" + NL
    t = t + "    IF seconds < 60 THEN RETURN ""Played "" + Str(seconds) + "" seconds""" + NL
    t = t + "    IF seconds < 3600 THEN RETURN ""Played "" + Str(Int(seconds / 60)) + "" minutes""" + NL
    t = t + "    RETURN ""Played "" + Str(Int(seconds / 360) / 10) + "" hours""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Busy (id AS String) AS Bool" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    IF id = dlId OR id = Field(setupLine, 0) THEN RETURN TRUE" + NL
    t = t + "    FOR EACH line IN queue" + NL
    t = t + "        IF Field(line, 0) = id THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The right-hand side: the banner, the words, the right buttons." + NL
    t = t + "SUB ShowGame ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    VAR shop AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    line = Current()" + NL
    t = t + "    trophies.Clear()" + NL
    t = t + "    banner.Tag = """"" + NL
    t = t + "    upd.Visible = FALSE" + NL
    t = t + "    IF line = """" THEN" + NL
    t = t + "        title.Text = """"" + NL
    t = t + "        info.Text = """"" + NL
    t = t + "        about.Text = """"" + NL
    t = t + "        action.Visible = FALSE" + NL
    t = t + "        remove.Visible = FALSE" + NL
    t = t + "        DrawBanner("""")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    id = Field(line, 0)" + NL
    t = t + "    lib = LibLine(id)" + NL
    t = t + "    shop = StoreLine(id)" + NL
    t = t + "    title.Text = Field(line, 1)" + NL
    t = t + "    action.Visible = TRUE" + NL
    t = t + "    action.Enabled = TRUE" + NL
    t = t + "    remove.Visible = lib <> """"" + NL
    t = t + "    IF tab = ""LIBRARY"" THEN" + NL
    t = t + "        kind = Field(lib, 7)" + NL
    t = t + "        IF kind = """" THEN kind = ""game""" + NL
    t = t + "        IF kind = ""game"" THEN" + NL
    t = t + "            info.Text = Played(Int(Val(Field(lib, 3)))) + ""  -  installed "" + Field(lib, 2)" + NL
    t = t + "        ELSE" + NL
    t = t + "            info.Text = KindName(kind) + ""  -  installed "" + Field(lib, 2)" + NL
    t = t + "        END IF" + NL
    t = t + "        IF Field(lib, 6) <> """" THEN info.Text = info.Text + ""  -  build "" + Field(lib, 6)" + NL
    t = t + "        about.Text = Wrap(Unesc(Field(lib, 5)), 66)" + NL
    t = t + "        action.Text = OpenWord(kind)" + NL
    t = t + "        IF playId.Contains(id) THEN" + NL
    t = t + "            action.Text = ""Running""" + NL
    t = t + "            action.Enabled = FALSE" + NL
    t = t + "        END IF" + NL
    t = t + "        upd.Visible = HasUpdate(id) AND NOT Busy(id)" + NL
    t = t + "        IF kind = ""game"" THEN" + NL
    t = t + "            FOR EACH a IN ReadOr(HOME + ""\"" + id + ""\ACHIEVE.TXT"", """").Lines()" + NL
    t = t + "                IF a.Contains(""|"") THEN trophies.Add(""* "" + a.Split(""|"")[0] + "" - "" + a.Split(""|"")[1] + ""  ("" + a.Split(""|"")[2] + "")"")" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF trophies.Count = 0 THEN trophies.Add(""No achievements yet. Go and play!"")" + NL
    t = t + "        END IF" + NL
    t = t + "        IF HasUpdate(id) THEN trophies.Add(""A newer version is in the store (build "" + Field(shop, 8) + "")."")" + NL
    t = t + "    ELSE" + NL
    t = t + "        kind = Field(line, 7)" + NL
    t = t + "        IF kind = """" THEN kind = ""game""" + NL
    t = t + "        info.Text = Field(line, 5) + ""  -  "" + KindName(kind) + ""  -  "" + Str(Int(Val(Field(line, 3)) / 1024) + 1) + "" KB  -  Free""" + NL
    t = t + "        about.Text = Wrap(Unesc(Field(line, 6)), 66)" + NL
    t = t + "        IF Field(line, 4) = ""soon"" THEN" + NL
    t = t + "            info.Text = Field(line, 5) + ""  -  Coming soon""" + NL
    t = t + "            action.Text = ""Coming soon""" + NL
    t = t + "            action.Enabled = FALSE" + NL
    t = t + "        ELSEIF Busy(id) THEN" + NL
    t = t + "            action.Text = ""Downloading...""" + NL
    t = t + "            action.Enabled = FALSE" + NL
    t = t + "        ELSEIF HasUpdate(id) THEN" + NL
    t = t + "            action.Text = ""U&pdate""" + NL
    t = t + "        ELSEIF lib <> """" THEN" + NL
    t = t + "            action.Text = OpenWord(kind)" + NL
    t = t + "            action.Enabled = NOT playId.Contains(id)" + NL
    t = t + "        ELSE" + NL
    t = t + "            action.Text = ""&Install""" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    DrawBanner(id)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION OpenWord (kind AS String) AS String" + NL
    t = t + "    IF kind = ""game"" THEN RETURN ""&Play""" + NL
    t = t + "    RETURN ""&Open""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Action_Click ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    line = Current()" + NL
    t = t + "    IF line = """" THEN RETURN" + NL
    t = t + "    id = Field(line, 0)" + NL
    t = t + "    IF tab = ""STORE"" AND HasUpdate(id) THEN" + NL
    t = t + "        Want(StoreLine(id))" + NL
    t = t + "    ELSEIF Installed(id) THEN" + NL
    t = t + "        Launch(id)" + NL
    t = t + "    ELSEIF tab = ""STORE"" AND Field(line, 4) <> ""soon"" THEN" + NL
    t = t + "        Want(line)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Update_Click ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    line = Current()" + NL
    t = t + "    IF line = """" THEN RETURN" + NL
    t = t + "    IF HasUpdate(Field(line, 0)) THEN Want(StoreLine(Field(line, 0)))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Into the download queue. A web app asks first: it takes the home page." + NL
    t = t + "SUB Want (line AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    VAR other AS String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    IF Busy(Field(line, 0)) THEN RETURN" + NL
    t = t + "    IF Field(line, 7) = ""web"" AND NOT Installed(Field(line, 0)) AND NOT (Folders() AND Field(line, 13) <> """") THEN" + NL
    t = t + "        FOR EACH l IN Library()" + NL
    t = t + "            IF Field(l, 7) = ""web"" THEN other = Field(l, 1)" + NL
    t = t + "        NEXT" + NL
    t = t + "        box = GUI_MessageBox.New(win)" + NL
    t = t + "        box.Title = ""Vapor""" + NL
    t = t + "        box.Kind = ""confirm""" + NL
    t = t + "        box.Buttons = ""yesno""" + NL
    t = t + "        box.Text = Field(line, 1) + "" is a web app: it becomes this machine's home page, http://"" + NET.HostName.Lower() + ""/ (the page there now moves aside to WELCOME.HTM).""" + NL
    t = t + "        IF other <> """" THEN box.Text = box.Text + EOL + EOL + ""This machine already has "" + other + "" there, and a machine has room for one web app: "" + Field(line, 1) + "" will take its place.""" + NL
    t = t + "        box.Text = box.Text + EOL + EOL + ""Install it?""" + NL
    t = t + "        IF NOT box.Show() THEN RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    queue.Add(line)" + NL
    t = t + "    win.Status = Field(line, 1) + "" is queued for download.""" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Play a game, open a program, or open a web app in the browser." + NL
    t = t + "SUB Launch (id AS String)" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR run AS String" + NL
    t = t + "    VAR url AS String" + NL
    t = t + "    lib = LibLine(id)" + NL
    t = t + "    kind = Field(lib, 7)" + NL
    t = t + "    IF kind = """" OR kind = ""game"" THEN" + NL
    t = t + "        run = HOME + ""\"" + id + ""\"" + id + "".SPK""" + NL
    t = t + "    ELSE" + NL
    t = t + "        run = Field(lib, 8)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF kind = ""web"" THEN" + NL
    t = t + "        url = WebUrl(Field(lib, 12))" + NL
    t = t + "        IF FS.Exists(BROWSER) THEN" + NL
    t = t + "            SYS.Start(BROWSER, url)" + NL
    t = t + "        ELSE" + NL
    t = t + "            SYS.Start(""C:\SYSTEM\VOYAGER.EXE"", url)" + NL
    t = t + "        END IF" + NL
    t = t + "        win.Status = ""Opened "" + url" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT FS.Exists(run) THEN" + NL
    t = t + "        Say(""The files are missing ("" + run + ""). Uninstall it and install it again."", ""error"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF playId.Contains(id) THEN RETURN" + NL
    t = t + "    playId.Add(id)" + NL
    t = t + "    playPid.Add(SYS.Run(run))" + NL
    t = t + "    playSince.Add(SYS.Ticks)" + NL
    t = t + "    IF kind = ""game"" THEN" + NL
    t = t + "        win.Status = ""Playing "" + Field(lib, 1) + ""...""" + NL
    t = t + "    ELSE" + NL
    t = t + "        win.Status = ""Opened "" + Field(lib, 1) + "".""" + NL
    t = t + "    END IF" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Remove_Click ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    line = Current()" + NL
    t = t + "    IF line = """" THEN RETURN" + NL
    t = t + "    id = Field(line, 0)" + NL
    t = t + "    lib = LibLine(id)" + NL
    t = t + "    IF lib = """" THEN RETURN" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = ""Vapor""" + NL
    t = t + "    box.Kind = ""confirm""" + NL
    t = t + "    box.Buttons = ""yesno""" + NL
    t = t + "    IF Field(lib, 7) = """" OR Field(lib, 7) = ""game"" THEN" + NL
    t = t + "        box.Text = ""Uninstall "" + Field(lib, 1) + ""? Its files in "" + HOME + ""\"" + id + "" will be deleted (your achievements too).""" + NL
    t = t + "    ELSE" + NL
    t = t + "        box.Text = ""Uninstall "" + Field(lib, 1) + ""? Its program files go; anything it saved (mail, posts, settings) stays.""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT box.Show() THEN RETURN" + NL
    t = t + "    Uninstall(lib)" + NL
    t = t + "    win.Status = Field(lib, 1) + "" was uninstalled.""" + NL
    t = t + "    ShowTab(tab)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Stops it, takes it out of startup, deletes the files it wrote, and its folder here." + NL
    t = t + "SUB Uninstall (lib AS String)" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR task AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    id = Field(lib, 0)" + NL
    t = t + "    FOR EACH name IN Field(lib, 10).Split("";"")" + NL
    t = t + "        IF name = """" THEN CONTINUE" + NL
    t = t + "        FOR EACH task IN SYS.Tasks()" + NL
    t = t + "            IF task.Split(""|"")[1].Upper() = name.Upper() AND Int(Val(task.Split(""|"")[0])) <> SYS.Pid THEN SYS.Kill(Int(Val(task.Split(""|"")[0])))" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH name IN Field(lib, 11).Split("";"")" + NL
    t = t + "        IF name <> """" AND FS.Exists(""C:\SYSTEM\STARTUP\"" + name) THEN FS.Delete(""C:\SYSTEM\STARTUP\"" + name)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH f IN Field(lib, 9).Split("";"")" + NL
    t = t + "        IF f <> """" AND f.Upper() <> ME THEN" + NL
    t = t + "            IF FS.Exists(Where(f, Field(lib, 12))) THEN FS.Delete(Where(f, Field(lib, 12)))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' a web app gives the home page back (unless it had a folder of its own)" + NL
    t = t + "    IF Field(lib, 7) = ""web"" AND (Field(lib, 12) = """" OR NOT Folders()) AND NOT FS.Exists(""C:\WEB\INDEX.HTM"") AND FS.Exists(""C:\WEB\WELCOME.HTM"") THEN FS.Rename(""C:\WEB\WELCOME.HTM"", ""C:\WEB\INDEX.HTM"")" + NL
    t = t + "    IF FS.Exists(HOME + ""\"" + id) THEN" + NL
    t = t + "        FOR EACH f IN FS.List(HOME + ""\"" + id)" + NL
    t = t + "            IF NOT f.EndsWith(""\"") THEN FS.Delete(HOME + ""\"" + id + ""\"" + f)" + NL
    t = t + "        NEXT" + NL
    t = t + "        FS.Delete(HOME + ""\"" + id)" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH l IN Library()" + NL
    t = t + "        IF Field(l, 0) <> id THEN out.Add(l)" + NL
    t = t + "    NEXT" + NL
    t = t + "    SaveLibrary(out)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SaveLibrary (lines AS Array OF String)" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    IF lines.Count > 0 THEN text = lines.Join(EOL) + EOL" + NL
    t = t + "    FS.Write(HOME + ""\LIBRARY.TXT"", text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Into the library, or the line there brought up to date (keeping when it" + NL
    t = t + "' was first installed and the time played)." + NL
    t = t + "SUB Keep (line AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    VAR first AS String" + NL
    t = t + "    VAR seconds AS String = ""0""" + NL
    t = t + "    VAR found AS Bool" + NL
    t = t + "    first = TIME.Date" + NL
    t = t + "    FOR EACH l IN Library()" + NL
    t = t + "        IF Field(l, 0) = Field(line, 0) THEN" + NL
    t = t + "            first = Field(l, 2)" + NL
    t = t + "            seconds = Field(l, 3)" + NL
    t = t + "            found = TRUE" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    l = Field(line, 0) + ""|"" + Field(line, 1) + ""|"" + first + ""|"" + seconds + ""|"" + Field(line, 5) + ""|"" + Field(line, 6) + ""|"" + Field(line, 8) + ""|"" + Field(line, 7) + ""|"" + Field(line, 9) + ""|"" + Field(line, 10) + ""|"" + Field(line, 11) + ""|"" + Field(line, 12) + ""|"" + Field(line, 13)" + NL
    t = t + "    FOR EACH line IN Library()" + NL
    t = t + "        IF Field(line, 0) = Field(l, 0) THEN" + NL
    t = t + "            out.Add(l)" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT found THEN out.Add(l)" + NL
    t = t + "    SaveLibrary(out)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB UpdateAll ()" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    FOR EACH l IN Library()" + NL
    t = t + "        IF HasUpdate(Field(l, 0)) AND NOT Busy(Field(l, 0)) THEN" + NL
    t = t + "            queue.Add(StoreLine(Field(l, 0)))" + NL
    t = t + "            n = n + 1" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF n = 0 THEN" + NL
    t = t + "        win.Status = ""Everything is up to date.""" + NL
    t = t + "    ELSE" + NL
    t = t + "        win.Status = Str(n) + "" update"" + Plural(n) + "" queued.""" + NL
    t = t + "    END IF" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Plural (n AS Integer) AS String" + NL
    t = t + "    IF n = 1 THEN RETURN """"" + NL
    t = t + "    RETURN ""s""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the clock: fetches, downloads, play time" + NL
    t = t + "" + NL
    t = t + "SUB Clock_OnTick ()" + NL
    t = t + "    TRY" + NL
    t = t + "        Tick()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Alive (pid AS Integer) AS Bool" + NL
    t = t + "    VAR task AS String" + NL
    t = t + "    FOR EACH task IN SYS.Tasks()" + NL
    t = t + "        IF Int(Val(task.Split(""|"")[0])) = pid THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Tick ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    ' things that ended: a game's time goes in the library" + NL
    t = t + "    FOR i = playId.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF NOT Alive(playPid[i]) THEN" + NL
    t = t + "            AddTime(playId[i], Int((SYS.Ticks - playSince[i]) / 1000))" + NL
    t = t + "            playId.RemoveAt(i)" + NL
    t = t + "            playPid.RemoveAt(i)" + NL
    t = t + "            playSince.RemoveAt(i)" + NL
    t = t + "            ShowGame()" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' an installer that finished: into the library. (It may not end: a program" + NL
    t = t + "    ' that has printed keeps its console open. So it is done when every file" + NL
    t = t + "    ' it writes is there, or when it ends.)" + NL
    t = t + "    IF setupLine <> """" THEN" + NL
    t = t + "        IF NOT Alive(setupPid) OR (SYS.Ticks - setupSince > 300 AND AllThere(Field(setupLine, 10), Field(setupLine, 13))) OR SYS.Ticks - setupSince > 60000 THEN" + NL
    t = t + "            Keep(setupLine)" + NL
    t = t + "            win.Status = Field(setupLine, 1) + "" is installed.""" + NL
    t = t + "            note.Text = Field(setupLine, 1) + "" is ready.""" + NL
    t = t + "            progress.Value = 0" + NL
    t = t + "            setupLine = """"" + NL
    t = t + "            SYS.Beep(660, 60)" + NL
    t = t + "            ShowTab(tab)" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF fetching THEN" + NL
    t = t + "        IF fDone OR SYS.Ticks - fSince > PATIENCE THEN Arrived()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF wantCatalog AND store <> """" THEN" + NL
    t = t + "        wantCatalog = FALSE" + NL
    t = t + "        StartFetch(""catalog"", store + ""catalog.txt"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF dlId = """" AND queue.Count > 0 THEN" + NL
    t = t + "        dlLine = queue[0]" + NL
    t = t + "        queue.RemoveAt(0)" + NL
    t = t + "        dlId = Field(dlLine, 0)" + NL
    t = t + "        dlParts = Int(Val(Field(dlLine, 2)))" + NL
    t = t + "        dlPart = 0" + NL
    t = t + "        dlText = """"" + NL
    t = t + "        dlStart = SYS.Ticks" + NL
    t = t + "    END IF" + NL
    t = t + "    IF dlId <> """" THEN" + NL
    t = t + "        dlPart = dlPart + 1" + NL
    t = t + "        ' (last thing in the tick: it may be spoiled)" + NL
    t = t + "        StartFetch(""part"", store + dlId.Lower() + ""/"" + Str(dlPart) + "".txt"")" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION AllThere (files AS String, folder AS String) AS Bool" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    IF files = """" THEN RETURN FALSE" + NL
    t = t + "    FOR EACH f IN files.Split("";"")" + NL
    t = t + "        IF f <> """" AND NOT FS.Exists(Where(f, folder)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A machine set up for several web apps (SimHost's C:\SYSTEM\WEBAPPS.INI says" + NL
    t = t + "' mode=folders) keeps each in its own folder, C:\WEB\BOOK and so on." + NL
    t = t + "FUNCTION Folders () AS Bool" + NL
    t = t + "    RETURN ReadOr(WEBAPPS, """").Contains(""mode=folders"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a web app's file really is: C:\WEB\BOOK.SPK -> C:\WEB\BOOK\BOOK.SPK" + NL
    t = t + "FUNCTION Where (f AS String, folder AS String) AS String" + NL
    t = t + "    IF folder = """" OR NOT Folders() THEN RETURN f" + NL
    t = t + "    IF NOT f.Upper().StartsWith(""C:\WEB\"") THEN RETURN f" + NL
    t = t + "    RETURN ""C:\WEB\"" + folder + ""\"" + f.Substring(7, f.Length - 7)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The address of a web app: the machine, or its folder there." + NL
    t = t + "FUNCTION WebUrl (folder AS String) AS String" + NL
    t = t + "    IF folder <> """" AND Folders() THEN RETURN ""http://"" + NET.HostName.Lower() + ""/"" + folder.Lower() + ""/""" + NL
    t = t + "    RETURN ""http://"" + NET.HostName.Lower() + ""/""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB AddTime (id AS String, seconds AS Integer)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    FOR EACH line IN Library()" + NL
    t = t + "        p = line.Split(""|"")" + NL
    t = t + "        IF p[0] = id THEN" + NL
    t = t + "            p[3] = Str(Int(Val(p[3])) + seconds)" + NL
    t = t + "            line = p.Join(""|"")" + NL
    t = t + "        END IF" + NL
    t = t + "        out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    SaveLibrary(out)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Percent () AS Integer" + NL
    t = t + "    IF dlParts = 0 THEN RETURN 0" + NL
    t = t + "    RETURN Int((dlPart - 1) * 100 / dlParts)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB StartFetch (what AS String, url AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR host AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    fetching = TRUE" + NL
    t = t + "    fWhat = what" + NL
    t = t + "    fNumber = fNumber + 1" + NL
    t = t + "    fParts.Clear()" + NL
    t = t + "    fDone = FALSE" + NL
    t = t + "    fError = """"" + NL
    t = t + "    fSince = SYS.Ticks" + NL
    t = t + "    host = url.Substring(7, url.Length - 7)" + NL
    t = t + "    path = host.Substring(host.IndexOf(""/""), host.Length - host.IndexOf(""/""))" + NL
    t = t + "    host = host.Substring(0, host.IndexOf(""/""))" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = web.Connect(host, 80)" + NL
    t = t + "        conn.Tag = Str(fNumber)" + NL
    t = t + "        conn.Send(""GET "" + path + "" HTTP/1.0"" + EOL + ""Host: "" + host + EOL + ""User-Agent: Vapor/2.0 (SIM95)"")" + NL
    t = t + "    CATCH err" + NL
    t = t + "        fError = err" + NL
    t = t + "        fDone = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    IF conn.Tag = Str(fNumber) AND NOT fDone THEN fParts.Add(message)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnClose (conn AS NET_Connection)" + NL
    t = t + "    IF conn.Tag = Str(fNumber) THEN fDone = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A fetch finished (or gave up): the body, or """" with fError saying why." + NL
    t = t + "FUNCTION Body () AS String" + NL
    t = t + "    VAR raw AS String" + NL
    t = t + "    raw = fParts.Join(EOL)" + NL
    t = t + "    IF fError <> """" THEN RETURN """"" + NL
    t = t + "    IF raw = """" THEN" + NL
    t = t + "        fError = ""no answer""" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT raw.StartsWith(""HTTP/1.0 200"") THEN" + NL
    t = t + "        fError = raw.Lines()[0]" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT raw.Contains(EOL + EOL) THEN RETURN """"" + NL
    t = t + "    RETURN raw.Substring(raw.IndexOf(EOL + EOL) + 2, raw.Length - raw.IndexOf(EOL + EOL) - 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Arrived ()" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR mine AS String" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    fetching = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        web.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    text = Body()" + NL
    t = t + "    IF fWhat = ""catalog"" THEN" + NL
    t = t + "        catalog.Clear()" + NL
    t = t + "        IF text = """" THEN" + NL
    t = t + "            win.Status = ""The store at "" + store + "" did not answer ("" + fError + "").""" + NL
    t = t + "        ELSE" + NL
    t = t + "            FOR EACH line IN text.Lines()" + NL
    t = t + "                IF line.Split(""|"").Count >= 7 THEN catalog.Add(line)" + NL
    t = t + "            NEXT" + NL
    t = t + "            win.Status = ""Store: "" + store + ""  -  "" + Str(catalog.Count) + "" items""" + NL
    t = t + "        END IF" + NL
    t = t + "        IF tab <> ""DOWNLOADS"" THEN ShowTab(tab)" + NL
    t = t + "        ' a newer Vapor? ask once" + NL
    t = t + "        mine = MyVersion()" + NL
    t = t + "        line = StoreLine(""VAPOR"")" + NL
    t = t + "        IF line <> """" AND mine <> """" AND Field(line, 8) <> mine AND NOT offeredSelf AND NOT Busy(""VAPOR"") THEN" + NL
    t = t + "            offeredSelf = TRUE" + NL
    t = t + "            box = GUI_MessageBox.New(win)" + NL
    t = t + "            box.Title = ""Vapor""" + NL
    t = t + "            box.Kind = ""confirm""" + NL
    t = t + "            box.Buttons = ""yesno""" + NL
    t = t + "            box.Text = ""A new version of Vapor is in the store (build "" + Field(line, 8) + ""; this is "" + mine + "")."" + EOL + EOL + ""Update Vapor now? It will restart.""" + NL
    t = t + "            IF box.Show() THEN queue.Insert(0, line)" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' a part of the download" + NL
    t = t + "    IF text = """" THEN" + NL
    t = t + "        win.Status = ""The download of "" + Field(dlLine, 1) + "" failed ("" + fError + "").""" + NL
    t = t + "        progress.Value = 0" + NL
    t = t + "        note.Text = """"" + NL
    t = t + "        dlId = """"" + NL
    t = t + "        ShowTab(tab)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    dlText = dlText + text" + NL
    t = t + "    progress.Value = Int(dlPart * 100 / dlParts)" + NL
    t = t + "    note.Text = ""Downloading "" + Field(dlLine, 1) + "": part "" + Str(dlPart) + "" of "" + Str(dlParts) + ""  -  "" + Str(Int(dlText.Length / MATH.Max(1, SYS.Ticks - dlStart) * 1000 / 102.4) / 10) + "" KB/s""" + NL
    t = t + "    IF tab = ""DOWNLOADS"" AND games.Count > 0 THEN games.Set(0, Field(dlLine, 1) + ""  "" + Str(Int(dlPart * 100 / dlParts)) + ""%"")" + NL
    t = t + "    IF dlPart >= dlParts THEN Finish()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' All the parts are here: what happens next depends on what it is." + NL
    t = t + "SUB Finish ()" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    line = dlLine" + NL
    t = t + "    dir = HOME + ""\"" + dlId" + NL
    t = t + "    kind = Field(line, 7)" + NL
    t = t + "    IF kind = """" THEN kind = ""game""" + NL
    t = t + "    IF kind = ""client"" THEN" + NL
    t = t + "        ' a new Vapor: in place of this one, which starts it and goes" + NL
    t = t + "        FS.Write(ME, dlText)" + NL
    t = t + "        SYS.Start(ME, """")" + NL
    t = t + "        SYS.Exit(0)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT FS.Exists(dir) THEN FS.MakeDir(dir)" + NL
    t = t + "    dlId = """"" + NL
    t = t + "    IF kind = ""game"" THEN" + NL
    t = t + "        FS.Write(dir + ""\"" + Field(line, 0) + "".SPK"", dlText)" + NL
    t = t + "        dlText = """"" + NL
    t = t + "        Keep(line)" + NL
    t = t + "        win.Status = Field(line, 1) + "" is installed. Find it in your Library.""" + NL
    t = t + "        note.Text = Field(line, 1) + "" is ready to play.""" + NL
    t = t + "        SYS.Beep(660, 60)" + NL
    t = t + "        ShowTab(tab)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' an installer: clear away the old files it writes (an update: a new" + NL
    t = t + "    ' install may need what is there, as SimHost moves web apps), run it, and" + NL
    t = t + "    ' wait for them" + NL
    t = t + "    FS.Write(dir + ""\INSTALL.SPK"", dlText)" + NL
    t = t + "    dlText = """"" + NL
    t = t + "    IF Installed(Field(line, 0)) THEN" + NL
    t = t + "        FOR EACH f IN Field(line, 10).Split("";"")" + NL
    t = t + "            IF f <> """" AND f.Upper() <> ME THEN" + NL
    t = t + "                IF FS.Exists(Where(f, Field(line, 13))) THEN FS.Delete(Where(f, Field(line, 13)))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    setupLine = line" + NL
    t = t + "    setupSince = SYS.Ticks" + NL
    t = t + "    setupPid = SYS.Run(dir + ""\INSTALL.SPK"")" + NL
    t = t + "    note.Text = ""Installing "" + Field(line, 1) + ""...""" + NL
    t = t + "    win.Status = ""Running "" + Field(line, 1) + ""'s installer...""" + NL
    t = t + "    ShowTab(tab)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ publishing (on a store machine)" + NL
    t = t + "" + NL
    t = t + "' Every installer in C:\MYFILES with a Vapor header goes on the store's shelf," + NL
    t = t + "' in place of an older version of it." + NL
    t = t + "SUB Publish ()" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR done AS Array OF String" + NL
    t = t + "    VAR same AS Array OF String" + NL
    t = t + "    VAR answer AS String" + NL
    t = t + "    IF NOT FS.Exists(STOREDIR) THEN" + NL
    t = t + "        Say(""This machine is not a Vapor store. Run Vapor's INSTALL.SPK here first."", ""warn"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    win.Status = ""Looking in C:\MYFILES for installers...""" + NL
    t = t + "    FOR EACH f IN FS.List(""C:\MYFILES"")" + NL
    t = t + "        IF NOT f.EndsWith("".SPK"") THEN CONTINUE" + NL
    t = t + "        text = FS.Read(""C:\MYFILES\"" + f)" + NL
    t = t + "        IF NOT text.StartsWith(""' VAPOR|"") THEN CONTINUE" + NL
    t = t + "        answer = PublishOne(text)" + NL
    t = t + "        IF answer.StartsWith(""="") THEN" + NL
    t = t + "            same.Add(answer.Substring(1, answer.Length - 1))" + NL
    t = t + "        ELSEIF answer <> """" THEN" + NL
    t = t + "            done.Add(answer)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF done.Count = 0 AND same.Count = 0 THEN" + NL
    t = t + "        Say(""There are no installers to publish in C:\MYFILES."" + EOL + EOL + ""Paste an app's INSTALL.SPK into SPARK, save it in C:\MYFILES (any name ending .SPK) without running it, and choose Publish Apps again."", ""info"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    answer = """"" + NL
    t = t + "    IF done.Count > 0 THEN answer = ""Published:"" + EOL + ""  "" + done.Join(EOL + ""  "")" + NL
    t = t + "    IF same.Count > 0 THEN answer = answer + EOL + EOL + ""Already up to date: "" + same.Join("", "")" + NL
    t = t + "    Say(answer.Trim(), ""info"")" + NL
    t = t + "    wantCatalog = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One installer into the store: its parts, and its line in the catalog." + NL
    t = t + "' Returns ""name (build)"" or ""=name"" when the store already had that version." + NL
    t = t + "FUNCTION PublishOne (text AS String) AS String" + NL
    t = t + "    VAR header AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR chunk AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR entry AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR found AS Bool" + NL
    t = t + "    header = text.Lines()[0]" + NL
    t = t + "    id = Meta(header, ""id"").Upper()" + NL
    t = t + "    IF id = """" OR id.Length > 8 OR id.Contains(""\"") OR id.Contains(""."") THEN RETURN """"" + NL
    t = t + "    FOR EACH line IN ReadOr(STOREDIR + ""\CATALOG.TXT"", """").Lines()" + NL
    t = t + "        IF Field(line, 0) = id AND Field(line, 8) = Meta(header, ""version"") THEN RETURN ""="" + Meta(header, ""name"")" + NL
    t = t + "    NEXT" + NL
    t = t + "    dir = STOREDIR + ""\"" + id" + NL
    t = t + "    IF FS.Exists(dir) THEN" + NL
    t = t + "        FOR EACH f IN FS.List(dir)" + NL
    t = t + "            IF NOT f.EndsWith(""\"") THEN FS.Delete(dir + ""\"" + f)" + NL
    t = t + "        NEXT" + NL
    t = t + "    ELSE" + NL
    t = t + "        FS.MakeDir(dir)" + NL
    t = t + "    END IF" + NL
    t = t + "    ' parts of whole lines, each small enough for one network message" + NL
    t = t + "    lines = text.Replace(Chr(13), """").Split(EOL)" + NL
    t = t + "    IF lines.Count > 0 THEN" + NL
    t = t + "        IF lines[lines.Count - 1] = """" THEN lines.RemoveAt(lines.Count - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH line IN lines" + NL
    t = t + "        IF chunk.Length + line.Length + 1 > PART AND chunk <> """" THEN" + NL
    t = t + "            n = n + 1" + NL
    t = t + "            FS.Write(dir + ""\"" + Str(n) + "".TXT"", chunk)" + NL
    t = t + "            chunk = """"" + NL
    t = t + "        END IF" + NL
    t = t + "        chunk = chunk + line + EOL" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF chunk <> """" THEN" + NL
    t = t + "        n = n + 1" + NL
    t = t + "        FS.Write(dir + ""\"" + Str(n) + "".TXT"", chunk)" + NL
    t = t + "    END IF" + NL
    t = t + "    entry = id + ""|"" + Meta(header, ""name"") + ""|"" + Str(n) + ""|"" + Str(text.Length) + ""|ok|"" + Meta(header, ""category"") + ""|"" + Meta(header, ""about"") + ""|"" + Meta(header, ""kind"") + ""|"" + Meta(header, ""version"") + ""|"" + Meta(header, ""run"") + ""|"" + Meta(header, ""files"") + ""|"" + Meta(header, ""tasks"") + ""|"" + Meta(header, ""startup"") + ""|"" + Meta(header, ""folder"").Upper()" + NL
    t = t + "    FOR EACH line IN ReadOr(STOREDIR + ""\CATALOG.TXT"", """").Lines()" + NL
    t = t + "        IF line = """" THEN CONTINUE" + NL
    t = t + "        IF Field(line, 0) = id THEN" + NL
    t = t + "            out.Add(entry)" + NL
    t = t + "            found = TRUE" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT found THEN out.Add(entry)" + NL
    t = t + "    FS.Write(STOREDIR + ""\CATALOG.TXT"", out.Join(EOL) + EOL)" + NL
    t = t + "    RETURN Meta(header, ""name"") + "" (build "" + Meta(header, ""version"") + "")""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the header and the banners" + NL
    t = t + "" + NL
    t = t + "SUB Head_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    head.Tag = """"" + NL
    t = t + "    DrawHead()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawHead ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR names AS Array OF String" + NL
    t = t + "    IF head.Tag = tab THEN RETURN" + NL
    t = t + "    head.Tag = tab" + NL
    t = t + "    head.Clear()" + NL
    t = t + "    head.SetColor(0)" + NL
    t = t + "    head.FillRect(0, 0, 640, 44)" + NL
    t = t + "    head.SetColor(4)" + NL
    t = t + "    head.FillRect(0, 0, 640, 40)" + NL
    t = t + "    ' the logo: steam rising off a V" + NL
    t = t + "    head.SetColor(15)" + NL
    t = t + "    head.FillCircle(22, 14, 4)" + NL
    t = t + "    head.FillCircle(28, 9, 3)" + NL
    t = t + "    head.FillCircle(17, 8, 2)" + NL
    t = t + "    head.SetColor(14)" + NL
    t = t + "    head.Text(38, 12, ""VAPOR"")" + NL
    t = t + "    names = [""STORE"", ""LIBRARY"", ""DOWNLOADS""]" + NL
    t = t + "    FOR i = 0 TO 2" + NL
    t = t + "        IF names[i] = tab THEN" + NL
    t = t + "            head.SetColor(14)" + NL
    t = t + "            head.FillRect(150 + i * 130, 36, 110, 4)" + NL
    t = t + "            head.SetColor(15)" + NL
    t = t + "        ELSE" + NL
    t = t + "            head.SetColor(7)" + NL
    t = t + "        END IF" + NL
    t = t + "        head.Text(150 + i * 130, 12, names[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Head_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    IF x >= 150 AND x < 270 THEN ShowTab(""STORE"")" + NL
    t = t + "    IF x >= 280 AND x < 400 THEN ShowTab(""LIBRARY"")" + NL
    t = t + "    IF x >= 410 AND x < 540 THEN ShowTab(""DOWNLOADS"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Banner_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    line = Current()" + NL
    t = t + "    banner.Tag = """"" + NL
    t = t + "    DrawBanner(Field(line, 0))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Each item's banner, drawn." + NL
    t = t + "SUB DrawBanner (id AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF banner.Tag = id AND id <> """" THEN RETURN" + NL
    t = t + "    banner.Tag = id" + NL
    t = t + "    banner.Clear()" + NL
    t = t + "    SELECT CASE id" + NL
    t = t + "        CASE ""SIMDOOM""" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "            FOR i = 0 TO 54" + NL
    t = t + "                banner.SetColor(9 - 8 * (i MOD 2))" + NL
    t = t + "                banner.FillRect(i * 8, 60 + Rnd(25), 8, 40)" + NL
    t = t + "                banner.SetColor(11)" + NL
    t = t + "                banner.FillRect(i * 8 + 2, 84 + Rnd(10), 4, 16)" + NL
    t = t + "            NEXT" + NL
    t = t + "            banner.SetColor(1)" + NL
    t = t + "            banner.Text(152, 30, ""S I M D O O M"")" + NL
    t = t + "            banner.SetColor(9)" + NL
    t = t + "            banner.Text(150, 28, ""S I M D O O M"")" + NL
    t = t + "        CASE ""SNAKE""" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "            FOR i = 0 TO 20" + NL
    t = t + "                banner.SetColor(2)" + NL
    t = t + "                banner.FillRect(60 + i * 12, 50 + Int(10 * MATH.Sin(i / 2)), 10, 10)" + NL
    t = t + "            NEXT" + NL
    t = t + "            banner.SetColor(9)" + NL
    t = t + "            banner.FillCircle(360, 55, 5)" + NL
    t = t + "            banner.SetColor(10)" + NL
    t = t + "            banner.Text(170, 14, ""SNAKE 95"")" + NL
    t = t + "        CASE ""HL3""" + NL
    t = t + "            banner.SetColor(3)" + NL
    t = t + "            banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "            banner.SetColor(11)" + NL
    t = t + "            banner.FillCircle(70, 50, 34)" + NL
    t = t + "            banner.SetColor(3)" + NL
    t = t + "            banner.FillCircle(70, 50, 28)" + NL
    t = t + "            banner.SetColor(11)" + NL
    t = t + "            banner.Line(58, 30, 82, 72)" + NL
    t = t + "            banner.Line(70, 50, 56, 72)" + NL
    t = t + "            banner.SetColor(15)" + NL
    t = t + "            banner.Text(130, 34, ""HALF-LIFE 3"")" + NL
    t = t + "            banner.SetColor(11)" + NL
    t = t + "            banner.Text(130, 56, ""Coming soon(TM)"")" + NL
    t = t + "        CASE ""SIMXPLOR""" + NL
    t = t + "            Plate(1, 15, ""Simxplorer"")" + NL
    t = t + "            banner.SetColor(12)" + NL
    t = t + "            FOR i = 0 TO 15" + NL
    t = t + "                banner.FillCircle(60 + Int(14 * MATH.Cos((-40 - i * 15) * MATH.Pi / 180)), 36 + Int(11 * MATH.Sin((-40 - i * 15) * MATH.Pi / 180)), 4)" + NL
    t = t + "                banner.FillCircle(60 + Int(14 * MATH.Cos((-90 + i * 15) * MATH.Pi / 180)), 58 + Int(11 * MATH.Sin((-90 + i * 15) * MATH.Pi / 180)), 4)" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""FROSTBRD""" + NL
    t = t + "            Plate(14, 4, ""Frostbird"")" + NL
    t = t + "            banner.SetColor(15)" + NL
    t = t + "            banner.FillRect(30, 30, 60, 40)" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.Rect(30, 30, 60, 40)" + NL
    t = t + "            banner.Line(30, 30, 60, 52)" + NL
    t = t + "            banner.Line(60, 52, 89, 30)" + NL
    t = t + "        CASE ""CLIPPY""" + NL
    t = t + "            Plate(11, 0, ""Clippy"")" + NL
    t = t + "            banner.SetColor(8)" + NL
    t = t + "            banner.Rect(50, 18, 20, 66)" + NL
    t = t + "            banner.Rect(56, 26, 10, 46)" + NL
    t = t + "            banner.SetColor(15)" + NL
    t = t + "            banner.FillCircle(54, 40, 6)" + NL
    t = t + "            banner.FillCircle(70, 40, 6)" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.FillCircle(55, 41, 2)" + NL
    t = t + "            banner.FillCircle(71, 41, 2)" + NL
    t = t + "        CASE ""SIMBOOK""" + NL
    t = t + "            Plate(4, 15, ""[simbook]"")" + NL
    t = t + "        CASE ""COLDMAIL""" + NL
    t = t + "            Plate(14, 4, ""ColdMail!"")" + NL
    t = t + "        CASE ""ASKSIM""" + NL
    t = t + "            Plate(5, 15, ""AskSim"")" + NL
    t = t + "            banner.SetColor(7)" + NL
    t = t + "            banner.FillCircle(60, 40, 16)" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.FillRect(44, 58, 32, 30)" + NL
    t = t + "        CASE ""ELIZA""" + NL
    t = t + "            Plate(6, 15, ""ELIZA-95"")" + NL
    t = t + "        CASE """"" + NL
    t = t + "            banner.SetColor(7)" + NL
    t = t + "            banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            Plate(4, 15, id)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A plain banner: a colour, and the name in big letters." + NL
    t = t + "SUB Plate (back AS Integer, ink AS Integer, name AS String)" + NL
    t = t + "    banner.SetColor(back)" + NL
    t = t + "    banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "    banner.SetColor(8)" + NL
    t = t + "    banner.Text(132, 42, name)" + NL
    t = t + "    banner.SetColor(ink)" + NL
    t = t + "    banner.Text(130, 40, name)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ menus" + NL
    t = t + "" + NL
    t = t + "SUB Menu_OnSelect (item AS String)" + NL
    t = t + "    SELECT CASE item" + NL
    t = t + "        CASE ""Store""" + NL
    t = t + "            ShowTab(""STORE"")" + NL
    t = t + "        CASE ""Library""" + NL
    t = t + "            ShowTab(""LIBRARY"")" + NL
    t = t + "        CASE ""Downloads""" + NL
    t = t + "            ShowTab(""DOWNLOADS"")" + NL
    t = t + "        CASE ""Update All""" + NL
    t = t + "            UpdateAll()" + NL
    t = t + "        CASE ""Change Store...""" + NL
    t = t + "            ChangeStore()" + NL
    t = t + "        CASE ""Publish Apps...""" + NL
    t = t + "            Publish()" + NL
    t = t + "        CASE ""Refresh""" + NL
    t = t + "            wantCatalog = TRUE" + NL
    t = t + "        CASE ""Exit""" + NL
    t = t + "            win.Close()" + NL
    t = t + "        CASE ""About Vapor""" + NL
    t = t + "            Say(""Vapor 2.0 for SIM95 (build "" + MyVersion() + "")"" + EOL + EOL + ""Games, programs and web apps from any machine that runs a Vapor store (http://machine/vapor/): downloads, a library with updates, play time and achievements."" + EOL + EOL + ""Half-Life 3 is coming soon."", ""info"")" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "VAR askWin AS GUI_Window" + NL
    t = t + "VAR askBox AS GUI_TextBox" + NL
    t = t + "" + NL
    t = t + "SUB ChangeStore ()" + NL
    t = t + "    VAR l AS GUI_Label" + NL
    t = t + "    VAR b AS GUI_Button" + NL
    t = t + "    askWin = GUI_Window.New(""Vapor Store"", 360, 110)" + NL
    t = t + "    askWin.Modal = TRUE" + NL
    t = t + "    l = GUI_Label.New(askWin)" + NL
    t = t + "    l.Text = ""Which machine is your store? (Any machine with Vapor"" + EOL + ""installed is one: type its name, like alpha.)""" + NL
    t = t + "    l.SetBounds(10, 8, 340, 30)" + NL
    t = t + "    askBox = GUI_TextBox.New(askWin)" + NL
    t = t + "    askBox.Text = store" + NL
    t = t + "    askBox.SetBounds(10, 44, 340, 21)" + NL
    t = t + "    askBox.onEnter = Store_Ok" + NL
    t = t + "    b = GUI_Button.New(askWin)" + NL
    t = t + "    b.Text = ""OK""" + NL
    t = t + "    b.Default = TRUE" + NL
    t = t + "    b.SetBounds(272, 74, 78, 26)" + NL
    t = t + "    b.onClick = Store_Ok" + NL
    t = t + "    askWin.Center()" + NL
    t = t + "    askWin.Show()" + NL
    t = t + "    askBox.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Store_Ok ()" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = askBox.Text.Trim().Lower()" + NL
    t = t + "    IF s = """" THEN RETURN" + NL
    t = t + "    IF NOT s.StartsWith(""http://"") THEN s = ""http://"" + s" + NL
    t = t + "    IF s.Substring(7, s.Length - 7).IndexOf(""/"") < 0 THEN s = s + ""/vapor/""" + NL
    t = t + "    IF NOT s.EndsWith(""/"") THEN s = s + ""/""" + NL
    t = t + "    store = s" + NL
    t = t + "    SaveSettings()" + NL
    t = t + "    askWin.Close()" + NL
    t = t + "    catalog.Clear()" + NL
    t = t + "    wantCatalog = TRUE" + NL
    t = t + "    ShowTab(""STORE"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Say (text AS String, kind AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = ""Vapor""" + NL
    t = t + "    box.Kind = kind" + NL
    t = t + "    box.Text = text" + NL
    t = t + "    box.Show()" + NL
    t = t + "END SUB" + NL
    Put("C:\PROGRAMS\VAPOR.SPK")
END SUB
