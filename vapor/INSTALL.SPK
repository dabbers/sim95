    t = t + "    t = t + ""    ShowPage(""""apps"""")"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Menu_OnSelect (item AS String)"" + NL" + NL
    t = t + "    t = t + ""    SELECT CASE item"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Start Service"""""" + NL" + NL
    t = t + "    t = t + ""            IF WebPid() = 0 THEN StartStop_Click()"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Stop Service"""""" + NL" + NL
    t = t + "    t = t + ""            IF WebPid() <> 0 THEN StartStop_Click()"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Exit"""""" + NL" + NL
    t = t + "    t = t + ""            SYS.Exit(0)"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Main"""""" + NL" + NL
    t = t + "    t = t + ""            ShowPage(""""main"""")"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Web Sites"""""" + NL" + NL
    t = t + "    t = t + ""            ShowPage(""""sites"""")"" + NL" + NL
    t = t + "    t = t + ""        CASE """"Domain Apps"""""" + NL" + NL
    t = t + "    t = t + ""            ShowPage(""""apps"""")"" + NL" + NL
    t = t + "    t = t + ""        CASE """"About Personal Web Manager"""""" + NL" + NL
    t = t + "    t = t + ""            Say(""""info"""", """"Personal Web Manager 1.0 for SIM95 (simweb)"""" + EOL + EOL + """"Publishes your pages, and this machine's apps, at names of their own."""" + EOL + """"Names are registered at SimNIC: """" + nicUrl)"" + NL" + NL
    t = t + "    t = t + ""    END SELECT"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB ShowPage (p AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR m AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR s AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR a AS Bool"" + NL" + NL
    t = t + "    t = t + ""    page = p"" + NL" + NL
    t = t + "    t = t + ""    m = (p = """"main"""")"" + NL" + NL
    t = t + "    t = t + ""    s = (p = """"sites"""")"" + NL" + NL
    t = t + "    t = t + ""    a = (p = """"apps"""")"" + NL" + NL
    t = t + "    t = t + ""    mHead.Visible = m"" + NL" + NL
    t = t + "    t = t + ""    mPub.Visible = m"" + NL" + NL
    t = t + "    t = t + ""    mUrl.Visible = m"" + NL" + NL
    t = t + "    t = t + ""    mStart.Visible = m"" + NL" + NL
    t = t + "    t = t + ""    mRestart.Visible = m"" + NL" + NL
    t = t + "    t = t + ""    mSitesHead.Visible = m"" + NL" + NL
    t = t + "    t = t + ""    mSites.Visible = m"" + NL" + NL
    t = t + "    t = t + ""    mNicHead.Visible = m"" + NL" + NL
    t = t + "    t = t + ""    mNic.Visible = m"" + NL" + NL
    t = t + "    t = t + ""    mNicGo.Visible = m"" + NL" + NL
    t = t + "    t = t + ""    sHead.Visible = s"" + NL" + NL
    t = t + "    t = t + ""    sCols.Visible = s"" + NL" + NL
    t = t + "    t = t + ""    sList.Visible = s"" + NL" + NL
    t = t + "    t = t + ""    sAdd.Visible = s"" + NL" + NL
    t = t + "    t = t + ""    sEdit.Visible = s"" + NL" + NL
    t = t + "    t = t + ""    sRemove.Visible = s"" + NL" + NL
    t = t + "    t = t + ""    sCheck.Visible = s"" + NL" + NL
    t = t + "    t = t + ""    sAddr.Visible = s"" + NL" + NL
    t = t + "    t = t + ""    sHint.Visible = s"" + NL" + NL
    t = t + "    t = t + ""    aHead.Visible = a"" + NL" + NL
    t = t + "    t = t + ""    aDomLbl.Visible = a"" + NL" + NL
    t = t + "    t = t + ""    aDomain.Visible = a"" + NL" + NL
    t = t + "    t = t + ""    aSave.Visible = a"" + NL" + NL
    t = t + "    t = t + ""    aHint.Visible = a"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 0 TO aChk.Count - 1"" + NL" + NL
    t = t + "    t = t + ""        aChk[i].Visible = a"" + NL" + NL
    t = t + "    t = t + ""        aLbl[i].Visible = a"" + NL" + NL
    t = t + "    t = t + ""        aTail[i].Visible = a"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    IF m THEN"" + NL" + NL
    t = t + "    t = t + ""        win.Title = APPTITLE + """" - Main"""""" + NL" + NL
    t = t + "    t = t + ""        ShowMain()"" + NL" + NL
    t = t + "    t = t + ""    ELSEIF s THEN"" + NL" + NL
    t = t + "    t = t + ""        win.Title = APPTITLE + """" - Web Sites"""""" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        win.Title = APPTITLE + """" - Domain Apps"""""" + NL" + NL
    t = t + "    t = t + ""        IF aDomain.Text = """""""" THEN aDomain.Text = FirstDomain()"" + NL" + NL
    t = t + "    t = t + ""        FillApps()"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION Say (kind AS String, text AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR box AS GUI_MessageBox"" + NL" + NL
    t = t + "    t = t + ""    box = GUI_MessageBox.New(win)"" + NL" + NL
    t = t + "    t = t + ""    box.Title = APPTITLE"" + NL" + NL
    t = t + "    t = t + ""    box.Kind = kind"" + NL" + NL
    t = t + "    t = t + ""    IF kind = """"confirm"""" THEN box.Buttons = """"yesno"""""" + NL" + NL
    t = t + "    t = t + ""    box.Text = text"" + NL" + NL
    t = t + "    t = t + ""    RETURN box.Show()"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' ---------------------------------------------------------------- the web server"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The web server's process, or 0 when it isn't running."" + NL" + NL
    t = t + "    t = t + ""FUNCTION WebPid () AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR t AS String"" + NL" + NL
    t = t + "    t = t + ""    FOR EACH t IN SYS.Tasks()"" + NL" + NL
    t = t + "    t = t + ""        IF t.Split(""""|"""")[1].Upper() = """"HTTPD"""" THEN RETURN Int(Val(t.Split(""""|"""")[0]))"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    RETURN 0"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB ShowMain ()"" + NL" + NL
    t = t + "    t = t + ""    VAR n AS Integer"" + NL" + NL
    t = t + "    t = t + ""    IF WebPid() <> 0 THEN"" + NL" + NL
    t = t + "    t = t + ""        mPub.Text = """"Web publishing is on. Your home page is available at:"""""" + NL" + NL
    t = t + "    t = t + ""        mUrl.Text = """"http://"""" + here + """"/"""""" + NL" + NL
    t = t + "    t = t + ""        mStart.Text = """"&Stop"""""" + NL" + NL
    t = t + "    t = t + ""        mRestart.Enabled = TRUE"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        mPub.Text = """"Web publishing is off. Your pages can't be seen from"""" + EOL + """"the network. Click Start to make them available."""""" + NL" + NL
    t = t + "    t = t + ""        mUrl.Text = """""""""" + NL" + NL
    t = t + "    t = t + ""        mStart.Text = """"&Start"""""" + NL" + NL
    t = t + "    t = t + ""        mRestart.Enabled = FALSE"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    n = rowName.Count"" + NL" + NL
    t = t + "    t = t + ""    IF n = 0 THEN"" + NL" + NL
    t = t + "    t = t + ""        mSites.Text = """"No sites by name yet. Add one under Web Sites."""""" + NL" + NL
    t = t + "    t = t + ""    ELSEIF n = 1 THEN"" + NL" + NL
    t = t + "    t = t + ""        mSites.Text = """"1 site by name: """" + rowName[0] + """"."""" + EOL + """"See Web Sites for what it serves and whether its name points here."""""" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        mSites.Text = Str(n) + """" sites by name. See Web Sites for what each serves"""" + EOL + """"and whether its name points here."""""" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB StartStop_Click ()"" + NL" + NL
    t = t + "    t = t + ""    VAR pid AS Integer"" + NL" + NL
    t = t + "    t = t + ""    pid = WebPid()"" + NL" + NL
    t = t + "    t = t + ""    IF pid <> 0 THEN"" + NL" + NL
    t = t + "    t = t + ""        SYS.Kill(pid)"" + NL" + NL
    t = t + "    t = t + ""        win.Status = """"The web server is stopped."""""" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        SYS.Run(HTTPD)"" + NL" + NL
    t = t + "    t = t + ""        win.Status = """"The web server is running."""""" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    ShowMain()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Restart_Click ()"" + NL" + NL
    t = t + "    t = t + ""    VAR pid AS Integer"" + NL" + NL
    t = t + "    t = t + ""    pid = WebPid()"" + NL" + NL
    t = t + "    t = t + ""    IF pid <> 0 THEN SYS.Kill(pid)"" + NL" + NL
    t = t + "    t = t + ""    SYS.Run(HTTPD)"" + NL" + NL
    t = t + "    t = t + ""    win.Status = """"The web server was restarted."""""" + NL" + NL
    t = t + "    t = t + ""    ShowMain()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Nic_Click ()"" + NL" + NL
    t = t + "    t = t + ""    OpenPage(nicUrl)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB OpenPage (url AS String)"" + NL" + NL
    t = t + "    t = t + ""    IF FS.Exists(BROWSER) THEN"" + NL" + NL
    t = t + "    t = t + ""        SYS.Start(BROWSER, url)"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        SYS.Start(""""C:\SYSTEM\VOYAGER.EXE"""", url)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    win.Status = """"Opened """" + url"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' ---------------------------------------------------------------- VHOSTS.TXT"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB ReadSites ()"" + NL" + NL
    t = t + "    t = t + ""    VAR line AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR t AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR n AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR d AS String"" + NL" + NL
    t = t + "    t = t + ""    vOther.Clear()"" + NL" + NL
    t = t + "    t = t + ""    vName.Clear()"" + NL" + NL
    t = t + "    t = t + ""    vDir.Clear()"" + NL" + NL
    t = t + "    t = t + ""    IF NOT FS.Exists(VHOSTS) THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    FOR EACH line IN FS.Read(VHOSTS).Lines()"" + NL" + NL
    t = t + "    t = t + ""        t = line.Trim()"" + NL" + NL
    t = t + "    t = t + ""        IF t = """""""" THEN CONTINUE"" + NL" + NL
    t = t + "    t = t + ""        IF t.StartsWith("""";"""") OR t.StartsWith(""""'"""") OR t.StartsWith(""""#"""") OR NOT t.Contains(""""|"""") THEN"" + NL" + NL
    t = t + "    t = t + ""            vOther.Add(line)"" + NL" + NL
    t = t + "    t = t + ""            CONTINUE"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        n = t.Substring(0, t.IndexOf(""""|"""")).Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""        d = t.Substring(t.IndexOf(""""|"""") + 1, t.Length - t.IndexOf(""""|"""") - 1).Trim().Upper()"" + NL" + NL
    t = t + "    t = t + ""        IF d.EndsWith(""""\"""") THEN d = d.Substring(0, d.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""        IF n = """""""" OR vName.Contains(n) THEN"" + NL" + NL
    t = t + "    t = t + ""            vOther.Add(line)"" + NL" + NL
    t = t + "    t = t + ""            CONTINUE"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        vName.Add(n)"" + NL" + NL
    t = t + "    t = t + ""        vDir.Add(d)"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB SaveSites ()"" + NL" + NL
    t = t + "    t = t + ""    VAR out AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR line AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    FOR EACH line IN vOther"" + NL" + NL
    t = t + "    t = t + ""        out.Add(line)"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 0 TO vName.Count - 1"" + NL" + NL
    t = t + "    t = t + ""        out.Add(vName[i] + """"|"""" + vDir[i])"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    FS.Write(VHOSTS, out.Join(EOL) + EOL)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION DirOf (name AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = vName.IndexOf(name)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""    RETURN vDir[i]"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB SetSite (name AS String, dir AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = vName.IndexOf(name)"" + NL" + NL
    t = t + "    t = t + ""    IF i >= 0 THEN"" + NL" + NL
    t = t + "    t = t + ""        vDir[i] = dir"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        vName.Add(name)"" + NL" + NL
    t = t + "    t = t + ""        vDir.Add(dir)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB DropSite (name AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = vName.IndexOf(name)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    vName.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""    vDir.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Does name have a www. twin serving the same folder?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION HasWww (name AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    IF name.StartsWith(""""www."""") OR name.StartsWith(""""*."""") THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF DirOf(name) = """""""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN DirOf(""""www."""" + name) = DirOf(name)"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' What a folder is, in words."" + NL" + NL
    t = t + "    t = t + ""FUNCTION Serves (dir AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    IF dir = """"C:\WEB"""" THEN RETURN """"home page"""""" + NL" + NL
    t = t + "    t = t + ""    i = appDir.IndexOf(dir)"" + NL" + NL
    t = t + "    t = t + ""    IF i >= 0 THEN RETURN appName[i] + """" ("""" + dir.Substring(7, dir.Length - 7) + """")"""""" + NL" + NL
    t = t + "    t = t + ""    IF dir.StartsWith(SITES + """"\"""") THEN RETURN """"own pages ("""" + dir.Substring(7, dir.Length - 7) + """")"""""" + NL" + NL
    t = t + "    t = t + ""    RETURN dir"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The list: one row a site, a www. twin shown with the site."" + NL" + NL
    t = t + "    t = t + ""SUB FillList ()"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR n AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR shown AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR keep AS Integer"" + NL" + NL
    t = t + "    t = t + ""    keep = sList.Selected"" + NL" + NL
    t = t + "    t = t + ""    sList.Clear()"" + NL" + NL
    t = t + "    t = t + ""    rowName.Clear()"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 0 TO vName.Count - 1"" + NL" + NL
    t = t + "    t = t + ""        n = vName[i]"" + NL" + NL
    t = t + "    t = t + ""        IF n.StartsWith(""""www."""") THEN"" + NL" + NL
    t = t + "    t = t + ""            IF HasWww(n.Substring(4, n.Length - 4)) THEN CONTINUE"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        shown = n"" + NL" + NL
    t = t + "    t = t + ""        IF HasWww(n) THEN shown = n + """" +www"""""" + NL" + NL
    t = t + "    t = t + ""        sList.Add(Cols(shown, Serves(vDir[i]), DnsOf(n)))"" + NL" + NL
    t = t + "    t = t + ""        rowName.Add(n)"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    IF keep >= 0 AND keep < sList.Count THEN sList.Selected = keep"" + NL" + NL
    t = t + "    t = t + ""    List_OnSelect()"" + NL" + NL
    t = t + "    t = t + ""    IF page = """"main"""" THEN ShowMain()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION Chosen () AS String"" + NL" + NL
    t = t + "    t = t + ""    IF sList.Selected < 0 OR sList.Selected >= rowName.Count THEN RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""    RETURN rowName[sList.Selected]"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB List_OnSelect ()"" + NL" + NL
    t = t + "    t = t + ""    VAR n AS String"" + NL" + NL
    t = t + "    t = t + ""    n = Chosen()"" + NL" + NL
    t = t + "    t = t + ""    sEdit.Enabled = n <> """""""""" + NL" + NL
    t = t + "    t = t + ""    sRemove.Enabled = n <> """""""""" + NL" + NL
    t = t + "    t = t + ""    IF n = """""""" OR n.StartsWith(""""*."""") THEN"" + NL" + NL
    t = t + "    t = t + ""        sAddr.Text = """""""""" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    sAddr.Text = """"In Simxplorer: http://"""" + n + """"/"""" + EOL + """"In Voyager:    http://"""" + here + """"/"""" + n + """"/"""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' ---------------------------------------------------------------- the apps"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' This machine's web apps, each in a folder of its own (as SimHost puts them):"" + NL" + NL
    t = t + "    t = t + ""' those with an APP.INF, and the known ones from before there was one."" + NL" + NL
    t = t + "    t = t + ""SUB FindApps ()"" + NL" + NL
    t = t + "    t = t + ""    VAR known AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR f AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR k AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR p AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    appDir.Clear()"" + NL" + NL
    t = t + "    t = t + ""    appName.Clear()"" + NL" + NL
    t = t + "    t = t + ""    known = [""""BOOK|BOOK.SPK|SimBook"""", """"MAIL|MAIL.SPK|ColdMail"""", """"ASK|ASK.SPK|AskSim"""", """"GEO|GEO.SPK|GeoSimies"""", """"WIKI|WIKI.SPK|WikiSim"""", """"ELIZA|BOT.SPK|ELIZA-95"""", """"PAL|PAL.SPK|SimPal"""", """"TUBE|TUBE.SPK|SimTube"""", """"STATS|STATS.SPK|SimStats"""", """"VAPOR|CATALOG.TXT|Vapor"""", """"NIC|NIC.SPK|SimNIC""""]"" + NL" + NL
    t = t + "    t = t + ""    IF NOT FS.Exists(""""C:\WEB"""") THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    FOR EACH f IN FS.List(""""C:\WEB"""")"" + NL" + NL
    Put("C:\WEB\VAPOR\SIMWEB\2.TXT")
END SUB

SUB File14 ()
    t = ""
    t = t + "    t = t + ""        IF NOT f.EndsWith(""""\"""") THEN CONTINUE"" + NL" + NL
    t = t + "    t = t + ""        f = f.Substring(0, f.Length - 1).Upper()"" + NL" + NL
    t = t + "    t = t + ""        IF f = """"SITES"""" THEN CONTINUE"" + NL" + NL
    t = t + "    t = t + ""        IF FS.Exists(""""C:\WEB\"""" + f + """"\APP.INF"""") THEN"" + NL" + NL
    t = t + "    t = t + ""            p = FS.Read(""""C:\WEB\"""" + f + """"\APP.INF"""").Split(""""|"""")"" + NL" + NL
    t = t + "    t = t + ""            appDir.Add(""""C:\WEB\"""" + f)"" + NL" + NL
    t = t + "    t = t + ""            appName.Add(p[0].Trim())"" + NL" + NL
    t = t + "    t = t + ""            CONTINUE"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        FOR EACH k IN known"" + NL" + NL
    t = t + "    t = t + ""            p = k.Split(""""|"""")"" + NL" + NL
    t = t + "    t = t + ""            IF p[0] = f AND FS.Exists(""""C:\WEB\"""" + f + """"\"""" + p[1]) THEN"" + NL" + NL
    t = t + "    t = t + ""                appDir.Add(""""C:\WEB\"""" + f)"" + NL" + NL
    t = t + "    t = t + ""                appName.Add(p[2])"" + NL" + NL
    t = t + "    t = t + ""            END IF"" + NL" + NL
    t = t + "    t = t + ""        NEXT"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' A row a app: [x] SimBook  [book    ] .coolsite.sim"" + NL" + NL
    t = t + "    t = t + ""SUB MakeAppRows ()"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR c AS GUI_CheckBox"" + NL" + NL
    t = t + "    t = t + ""    VAR t AS GUI_TextBox"" + NL" + NL
    t = t + "    t = t + ""    VAR l AS GUI_Label"" + NL" + NL
    t = t + "    t = t + ""    VAR y AS Integer"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 0 TO appDir.Count - 1"" + NL" + NL
    t = t + "    t = t + ""        IF i >= 10 THEN BREAK"" + NL" + NL
    t = t + "    t = t + ""        y = 76 + i * 22"" + NL" + NL
    t = t + "    t = t + ""        c = GUI_CheckBox.New(win)"" + NL" + NL
    t = t + "    t = t + ""        c.SetBounds(116, y, 120, 20)"" + NL" + NL
    t = t + "    t = t + ""        c.Text = appName[i]"" + NL" + NL
    t = t + "    t = t + ""        c.Tag = """"app:"""" + appDir[i]"" + NL" + NL
    t = t + "    t = t + ""        aChk.Add(c)"" + NL" + NL
    t = t + "    t = t + ""        t = GUI_TextBox.New(win)"" + NL" + NL
    t = t + "    t = t + ""        t.SetBounds(240, y, 80, 20)"" + NL" + NL
    t = t + "    t = t + ""        t.Tag = """"label:"""" + appDir[i]"" + NL" + NL
    t = t + "    t = t + ""        t.MaxLength = 20"" + NL" + NL
    t = t + "    t = t + ""        aLbl.Add(t)"" + NL" + NL
    t = t + "    t = t + ""        l = GUI_Label.New(win)"" + NL" + NL
    t = t + "    t = t + ""        l.SetBounds(324, y + 2, 240, 18)"" + NL" + NL
    t = t + "    t = t + ""        aTail.Add(l)"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The first domain the sites are under, to start the apps page with."" + NL" + NL
    t = t + "    t = t + ""FUNCTION FirstDomain () AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR n AS String"" + NL" + NL
    t = t + "    t = t + ""    FOR EACH n IN rowName"" + NL" + NL
    t = t + "    t = t + ""        IF NOT n.StartsWith(""""*."""") AND n.Split(""""."""").Count = 2 THEN RETURN n"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION AppDomain () AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR d AS String"" + NL" + NL
    t = t + "    t = t + ""    d = aDomain.Text.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    IF d.StartsWith(""""www."""") THEN d = d.Substring(4, d.Length - 4)"" + NL" + NL
    t = t + "    t = t + ""    IF d.EndsWith(""""."""") THEN d = d.Substring(0, d.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""    RETURN d"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The name under domain that app folder dir has now, or """"""""."" + NL" + NL
    t = t + "    t = t + ""FUNCTION AppLabel (dir AS String, domain AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR n AS String"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 0 TO vName.Count - 1"" + NL" + NL
    t = t + "    t = t + ""        n = vName[i]"" + NL" + NL
    t = t + "    t = t + ""        IF vDir[i] = dir AND n.EndsWith(""""."""" + domain) THEN"" + NL" + NL
    t = t + "    t = t + ""            n = n.Substring(0, n.Length - domain.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""            IF NOT n.Contains(""""."""") AND n <> """"*"""" AND n <> """"www"""" THEN RETURN n"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Domain_OnChange ()"" + NL" + NL
    t = t + "    t = t + ""    FillApps()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB FillApps ()"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR d AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR has AS String"" + NL" + NL
    t = t + "    t = t + ""    d = AppDomain()"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 0 TO aChk.Count - 1"" + NL" + NL
    t = t + "    t = t + ""        has = """""""""" + NL" + NL
    t = t + "    t = t + ""        IF CleanName(d) <> """""""" THEN has = AppLabel(appDir[i], d)"" + NL" + NL
    t = t + "    t = t + ""        aChk[i].Checked = has <> """""""""" + NL" + NL
    t = t + "    t = t + ""        IF has <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""            aLbl[i].Text = has"" + NL" + NL
    t = t + "    t = t + ""        ELSEIF aLbl[i].Text = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""            aLbl[i].Text = appDir[i].Substring(7, appDir[i].Length - 7).Lower()"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        IF d = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""            aTail[i].Text = """".yourdomain.sim"""""" + NL" + NL
    t = t + "    t = t + ""        ELSE"" + NL" + NL
    t = t + "    t = t + ""            aTail[i].Text = """"."""" + d"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    IF aChk.Count = 0 THEN"" + NL" + NL
    t = t + "    t = t + ""        aHint.Text = """"This machine has no web apps in folders of their own (SimHost puts"""" + EOL + """"them there). Give the home page a name under Web Sites instead."""""" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        aHint.Text = """"Tick the apps that should have a name under the domain, and Save."""" + EOL _"" + NL" + NL
    t = t + "    t = t + ""            + """"Each name must point here at SimNIC too: in Advanced DNS, a CNAME"""" + EOL _"" + NL" + NL
    t = t + "    t = t + ""            + """"for each (book CNAME """" + here + """"), or one * CNAME """" + here + """" for them all."""""" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB SaveApps_Click ()"" + NL" + NL
    t = t + "    t = t + ""    VAR d AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR lbl AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR old AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR added AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR removed AS Integer"" + NL" + NL
    t = t + "    t = t + ""    d = CleanName(AppDomain())"" + NL" + NL
    t = t + "    t = t + ""    IF d = """""""" OR d.StartsWith(""""*."""") THEN"" + NL" + NL
    t = t + "    t = t + ""        Say(""""warn"""", """"Type the domain the apps' names go under, like coolsite.sim."""")"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    ReadSites()"" + NL" + NL
    t = t + "    t = t + ""    ' first every label, so a bad one changes nothing"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 0 TO aChk.Count - 1"" + NL" + NL
    t = t + "    t = t + ""        IF aChk[i].Checked THEN"" + NL" + NL
    t = t + "    t = t + ""            lbl = aLbl[i].Text.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""            IF lbl = """""""" OR lbl.Contains(""""."""") OR CleanName(lbl + """"."""" + d) = """""""" OR lbl = """"www"""" THEN"" + NL" + NL
    t = t + "    t = t + ""                Say(""""warn"""", aLbl[i].Text + """" can't be a name under """" + d + """". Use letters, digits and hyphens, like book."""")"" + NL" + NL
    t = t + "    t = t + ""                RETURN"" + NL" + NL
    t = t + "    t = t + ""            END IF"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 0 TO aChk.Count - 1"" + NL" + NL
    t = t + "    t = t + ""        old = AppLabel(appDir[i], d)"" + NL" + NL
    t = t + "    t = t + ""        lbl = aLbl[i].Text.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""        IF aChk[i].Checked THEN"" + NL" + NL
    t = t + "    t = t + ""            IF old <> lbl THEN"" + NL" + NL
    t = t + "    t = t + ""                IF old <> """""""" THEN DropSite(old + """"."""" + d)"" + NL" + NL
    t = t + "    t = t + ""                SetSite(lbl + """"."""" + d, appDir[i])"" + NL" + NL
    t = t + "    t = t + ""                Want(lbl + """"."""" + d)"" + NL" + NL
    t = t + "    t = t + ""                added = added + 1"" + NL" + NL
    t = t + "    t = t + ""            END IF"" + NL" + NL
    t = t + "    t = t + ""        ELSEIF old <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""            DropSite(old + """"."""" + d)"" + NL" + NL
    t = t + "    t = t + ""            removed = removed + 1"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    SaveSites()"" + NL" + NL
    t = t + "    t = t + ""    FillList()"" + NL" + NL
    t = t + "    t = t + ""    FillApps()"" + NL" + NL
    t = t + "    t = t + ""    win.Status = """"Saved: """" + Str(added) + """" names added under """" + d + """", """" + Str(removed) + """" taken away."""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' ---------------------------------------------------------------- adding and editing"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' A site's name as typed, lower case, or """""""" when it can't be one: letters,"" + NL" + NL
    t = t + "    t = t + ""' digits and hyphens, with at least one dot (a *. in front for every name"" + NL" + NL
    t = t + "    t = t + ""' under a domain)."" + NL" + NL
    t = t + "    t = t + ""FUNCTION CleanName (n AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR rest AS String"" + NL" + NL
    t = t + "    t = t + ""    n = n.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    IF n.StartsWith(""""http://"""") THEN n = n.Substring(7, n.Length - 7)"" + NL" + NL
    t = t + "    t = t + ""    IF n.EndsWith(""""/"""") THEN n = n.Substring(0, n.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""    IF n.EndsWith(""""."""") THEN n = n.Substring(0, n.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""    rest = n"" + NL" + NL
    t = t + "    t = t + ""    IF rest.StartsWith(""""*."""") THEN rest = rest.Substring(2, rest.Length - 2)"" + NL" + NL
    t = t + "    t = t + ""    IF rest = """""""" OR rest.Length > 60 OR NOT rest.Contains(""""."""") THEN RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""    IF rest.StartsWith(""""."""") OR rest.StartsWith(""""-"""") OR rest.Contains("""".."""") THEN RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""    FOR i = 0 TO rest.Length - 1"" + NL" + NL
    t = t + "    t = t + ""        IF NOT """"abcdefghijklmnopqrstuvwxyz0123456789-."""".Contains(rest.CharAt(i)) THEN RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    RETURN n"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Where a site's own pages go: C:\WEB\SITES\COOLSITE for coolsite.sim."" + NL" + NL
    t = t + "    t = t + ""FUNCTION OwnFolder (name AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR label AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR c AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR n AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR folder AS String"" + NL" + NL
    t = t + "    t = t + ""    label = """""""""" + NL" + NL
    t = t + "    t = t + ""    FOR i = 0 TO name.Length - 1"" + NL" + NL
    t = t + "    t = t + ""        c = name.CharAt(i)"" + NL" + NL
    t = t + "    t = t + ""        IF c = """"."""" AND label <> """""""" AND label <> """"WWW"""" THEN BREAK"" + NL" + NL
    t = t + "    t = t + ""        IF c = """"."""" THEN"" + NL" + NL
    t = t + "    t = t + ""            label = """""""""" + NL" + NL
    t = t + "    t = t + ""        ELSEIF """"abcdefghijklmnopqrstuvwxyz0123456789"""".Contains(c) THEN"" + NL" + NL
    t = t + "    t = t + ""            label = label + c.Upper()"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    IF label = """""""" THEN label = """"SITE"""""" + NL" + NL
    t = t + "    t = t + ""    IF label.Length > 8 THEN label = label.Substring(0, 8)"" + NL" + NL
    t = t + "    t = t + ""    folder = SITES + """"\"""" + label"" + NL" + NL
    t = t + "    t = t + ""    ' a folder another site already has is that site's"" + NL" + NL
    t = t + "    t = t + ""    WHILE FolderTaken(folder, name) AND n < 99"" + NL" + NL
    t = t + "    t = t + ""        n = n + 1"" + NL" + NL
    t = t + "    t = t + ""        IF label.Length > 6 THEN label = label.Substring(0, 6)"" + NL" + NL
    t = t + "    t = t + ""        folder = SITES + """"\"""" + label + Str(n).PadLeft(2).Replace("""" """", """"0"""")"" + NL" + NL
    t = t + "    t = t + ""    END WHILE"" + NL" + NL
    t = t + "    t = t + ""    RETURN folder"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION FolderTaken (folder AS String, name AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 0 TO vName.Count - 1"" + NL" + NL
    t = t + "    t = t + ""        IF vDir[i] = folder AND vName[i] <> name AND vName[i] <> """"www."""" + name AND vName[i] <> dOld AND vName[i] <> """"www."""" + dOld THEN RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Makes the folder, with an """"Under construction"""" page, if it isn't there."" + NL" + NL
    t = t + "    t = t + ""SUB MakeFolder (folder AS String, name AS String)"" + NL" + NL
    t = t + "    t = t + ""    IF NOT FS.Exists(SITES) THEN FS.MakeDir(SITES)"" + NL" + NL
    t = t + "    t = t + ""    IF NOT FS.Exists(folder) THEN FS.MakeDir(folder)"" + NL" + NL
    t = t + "    t = t + ""    IF FS.Exists(folder + """"\INDEX.HTM"""") OR FS.Exists(folder + """"\INDEX.ASP"""") THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    FS.Write(folder + """"\INDEX.HTM"""", """"<html><head><title>"""" + name + """"</title></head>"""" + EOL _"" + NL" + NL
    t = t + "    t = t + ""        + """"<body bgcolor=""""""""#FFFFFF"""""""">"""" + EOL + """"<center><h1>"""" + name + """"</h1>"""" + EOL _"" + NL" + NL
    t = t + "    t = t + ""        + """"<p><font size=""""""""5"""""""" color=""""""""#CC0000""""""""><b>Under construction</b></font></p>"""" + EOL _"" + NL" + NL
    t = t + "    t = t + ""        + """"<p>This site is being built. Please come back soon!</p>"""" + EOL _"" + NL" + NL
    t = t + "    t = t + ""        + """"<hr width=""""""""50%""""""""><p><font size=""""""""2"""""""">Published with Personal Web Manager on """" + here + """".<br>"""" + EOL _"" + NL" + NL
    t = t + "    t = t + ""        + """"(Its owner puts pages in """" + folder + """".)</font></p></center>"""" + EOL _"" + NL" + NL
    t = t + "    t = t + ""        + """"</body></html>"""" + EOL)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Add_Click ()"" + NL" + NL
    t = t + "    t = t + ""    SiteDialog("""""""")"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Edit_Click ()"" + NL" + NL
    t = t + "    t = t + ""    IF Chosen() = """""""" THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    SiteDialog(Chosen())"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB SiteDialog (old AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR l AS GUI_Label"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR dir AS String"" + NL" + NL
    t = t + "    t = t + ""    IF NOT IsNothing(dWin) THEN"" + NL" + NL
    t = t + "    t = t + ""        dWin.Focus()"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    dOld = old"" + NL" + NL
    t = t + "    t = t + ""    dWin = GUI_Window.New(""""Add Web Site"""", 400, 250)"" + NL" + NL
    t = t + "    t = t + ""    IF old <> """""""" THEN dWin.Title = """"Edit Web Site"""""" + NL" + NL
    t = t + "    t = t + ""    dWin.Icon = """"network"""""" + NL" + NL
    t = t + "    t = t + ""    dWin.Modal = TRUE"" + NL" + NL
    t = t + "    t = t + ""    dWin.onClose = Dialog_OnClose"" + NL" + NL
    t = t + "    t = t + ""    l = GUI_Label.New(dWin)"" + NL" + NL
    t = t + "    t = t + ""    l.SetBounds(10, 12, 80, 20)"" + NL" + NL
    t = t + "    t = t + ""    l.Text = """"Site &name:"""""" + NL" + NL
    t = t + "    t = t + ""    dName = GUI_TextBox.New(dWin)"" + NL" + NL
    t = t + "    t = t + ""    dName.SetBounds(96, 10, 290, 22)"" + NL" + NL
    t = t + "    t = t + ""    dName.Tag = """"sitename"""""" + NL" + NL
    t = t + "    t = t + ""    dName.onChange = DName_OnChange"" + NL" + NL
    t = t + "    t = t + ""    dWww = GUI_CheckBox.New(dWin)"" + NL" + NL
    t = t + "    t = t + ""    dWww.SetBounds(96, 36, 290, 20)"" + NL" + NL
    t = t + "    t = t + ""    dWww.Tag = """"www"""""" + NL" + NL
    t = t + "    t = t + ""    dWww.Checked = TRUE"" + NL" + NL
    t = t + "    t = t + ""    l = GUI_Label.New(dWin)"" + NL" + NL
    t = t + "    t = t + ""    l.SetBounds(10, 66, 380, 20)"" + NL" + NL
    t = t + "    t = t + ""    l.Text = """"It serves:"""""" + NL" + NL
    t = t + "    t = t + ""    dOwn = Radio(""""&My own pages"""", 88, """"own"""")"" + NL" + NL
    t = t + "    t = t + ""    dOwnLbl = GUI_Label.New(dWin)"" + NL" + NL
    t = t + "    t = t + ""    dOwnLbl.SetBounds(30, 108, 360, 18)"" + NL" + NL
    t = t + "    t = t + ""    dApp = Radio(""""A web &app on this machine:"""", 130, """"app"""")"" + NL" + NL
    t = t + "    t = t + ""    dApps = GUI_DropDown.New(dWin)"" + NL" + NL
    t = t + "    t = t + ""    dApps.SetBounds(220, 128, 166, 22)"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 0 TO appDir.Count - 1"" + NL" + NL
    t = t + "    t = t + ""        dApps.Add(appName[i] + """" ("""" + appDir[i].Substring(7, appDir[i].Length - 7) + """")"""")"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    IF appDir.Count > 0 THEN dApps.Selected = 0"" + NL" + NL
    t = t + "    t = t + ""    dApp.Enabled = appDir.Count > 0"" + NL" + NL
    t = t + "    t = t + ""    dApps.Enabled = appDir.Count > 0"" + NL" + NL
    Put("C:\WEB\VAPOR\SIMWEB\3.TXT")
END SUB

SUB File15 ()
    t = ""
    t = t + "    t = t + ""    dHome = Radio(""""This machine's &home page (C:\WEB)"""", 156, """"home"""")"" + NL" + NL
    t = t + "    t = t + ""    dOk = GUI_Button.New(dWin)"" + NL" + NL
    t = t + "    t = t + ""    dOk.SetBounds(206, 210, 86, 28)"" + NL" + NL
    t = t + "    t = t + ""    dOk.Text = """"OK"""""" + NL" + NL
    t = t + "    t = t + ""    dOk.Default = TRUE"" + NL" + NL
    t = t + "    t = t + ""    dOk.onClick = DialogOk_Click"" + NL" + NL
    t = t + "    t = t + ""    dCancel = GUI_Button.New(dWin)"" + NL" + NL
    t = t + "    t = t + ""    dCancel.SetBounds(300, 210, 86, 28)"" + NL" + NL
    t = t + "    t = t + ""    dCancel.Text = """"Cancel"""""" + NL" + NL
    t = t + "    t = t + ""    dCancel.Cancel = TRUE"" + NL" + NL
    t = t + "    t = t + ""    dCancel.onClick = DialogCancel_Click"" + NL" + NL
    t = t + "    t = t + ""    dOwn.Checked = TRUE"" + NL" + NL
    t = t + "    t = t + ""    IF old <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        dName.Text = old"" + NL" + NL
    t = t + "    t = t + ""        dWww.Checked = HasWww(old)"" + NL" + NL
    t = t + "    t = t + ""        dir = DirOf(old)"" + NL" + NL
    t = t + "    t = t + ""        IF dir = """"C:\WEB"""" THEN"" + NL" + NL
    t = t + "    t = t + ""            dHome.Checked = TRUE"" + NL" + NL
    t = t + "    t = t + ""        ELSEIF appDir.IndexOf(dir) >= 0 THEN"" + NL" + NL
    t = t + "    t = t + ""            dApp.Checked = TRUE"" + NL" + NL
    t = t + "    t = t + ""            dApps.Selected = appDir.IndexOf(dir)"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    DName_OnChange()"" + NL" + NL
    t = t + "    t = t + ""    dWin.Show()"" + NL" + NL
    t = t + "    t = t + ""    dName.Focus()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION Radio (text AS String, y AS Integer, tag AS String) AS GUI_RadioButton"" + NL" + NL
    t = t + "    t = t + ""    VAR r AS GUI_RadioButton"" + NL" + NL
    t = t + "    t = t + ""    r = GUI_RadioButton.New(dWin)"" + NL" + NL
    t = t + "    t = t + ""    r.SetBounds(14, y, 300, 20)"" + NL" + NL
    t = t + "    t = t + ""    r.Text = text"" + NL" + NL
    t = t + "    t = t + ""    r.Group = """"serves"""""" + NL" + NL
    t = t + "    t = t + ""    r.Tag = tag"" + NL" + NL
    t = t + "    t = t + ""    RETURN r"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB DName_OnChange ()"" + NL" + NL
    t = t + "    t = t + ""    VAR n AS String"" + NL" + NL
    t = t + "    t = t + ""    n = CleanName(dName.Text)"" + NL" + NL
    t = t + "    t = t + ""    IF n.StartsWith(""""www."""") THEN n = n.Substring(4, n.Length - 4)"" + NL" + NL
    t = t + "    t = t + ""    IF n = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        dWww.Text = """"Also www. in front"""""" + NL" + NL
    t = t + "    t = t + ""        dOwnLbl.Text = """"(a folder of its own in """" + SITES + """")"""""" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        dWww.Text = """"Also www."""" + n"" + NL" + NL
    t = t + "    t = t + ""        dOwnLbl.Text = """"(in """" + OwnFolder(n) + """")"""""" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    dWww.Enabled = NOT n.StartsWith(""""*."""")"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Dialog_OnClose ()"" + NL" + NL
    t = t + "    t = t + ""    dWin = NOTHING"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB DialogCancel_Click ()"" + NL" + NL
    t = t + "    t = t + ""    dWin.Close()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB DialogOk_Click ()"" + NL" + NL
    t = t + "    t = t + ""    VAR n AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR www AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR dir AS String"" + NL" + NL
    t = t + "    t = t + ""    n = CleanName(dName.Text)"" + NL" + NL
    t = t + "    t = t + ""    IF n = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        Say(""""warn"""", """"Type the site's name, like coolsite.sim: letters, digits and hyphens, with a dot."""")"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    www = dWww.Checked AND NOT n.StartsWith(""""*."""")"" + NL" + NL
    t = t + "    t = t + ""    IF n.StartsWith(""""www."""") THEN"" + NL" + NL
    t = t + "    t = t + ""        n = n.Substring(4, n.Length - 4)"" + NL" + NL
    t = t + "    t = t + ""        www = TRUE"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    ReadSites()"" + NL" + NL
    t = t + "    t = t + ""    IF n <> dOld AND DirOf(n) <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        Say(""""warn"""", n + """" is already one of this machine's sites. Choose it in the list and press Edit."""")"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF dHome.Checked THEN"" + NL" + NL
    t = t + "    t = t + ""        dir = """"C:\WEB"""""" + NL" + NL
    t = t + "    t = t + ""    ELSEIF dApp.Checked AND dApps.Selected >= 0 AND dApps.Selected < appDir.Count THEN"" + NL" + NL
    t = t + "    t = t + ""        dir = appDir[dApps.Selected]"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        dir = OwnFolder(n)"" + NL" + NL
    t = t + "    t = t + ""        MakeFolder(dir, n)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF dOld <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        IF HasWww(dOld) THEN DropSite(""""www."""" + dOld)"" + NL" + NL
    t = t + "    t = t + ""        DropSite(dOld)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    DropSite(""""www."""" + n)"" + NL" + NL
    t = t + "    t = t + ""    SetSite(n, dir)"" + NL" + NL
    t = t + "    t = t + ""    IF www THEN SetSite(""""www."""" + n, dir)"" + NL" + NL
    t = t + "    t = t + ""    SaveSites()"" + NL" + NL
    t = t + "    t = t + ""    Want(n)"" + NL" + NL
    t = t + "    t = t + ""    dWin.Close()"" + NL" + NL
    t = t + "    t = t + ""    FillList()"" + NL" + NL
    t = t + "    t = t + ""    sList.Selected = rowName.IndexOf(n)"" + NL" + NL
    t = t + "    t = t + ""    List_OnSelect()"" + NL" + NL
    t = t + "    t = t + ""    win.Status = n + """" serves """" + Serves(dir) + """". Point it at """" + here.Upper() + """" at SimNIC if you haven't."""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Remove_Click ()"" + NL" + NL
    t = t + "    t = t + ""    VAR n AS String"" + NL" + NL
    t = t + "    t = t + ""    n = Chosen()"" + NL" + NL
    t = t + "    t = t + ""    IF n = """""""" THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    IF NOT Say(""""confirm"""", """"Take """" + n + """" off this web server?"""" + EOL + EOL + """"Its folder and pages are left where they are, and its name stays yours at SimNIC."""") THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    ReadSites()"" + NL" + NL
    t = t + "    t = t + ""    IF HasWww(n) THEN DropSite(""""www."""" + n)"" + NL" + NL
    t = t + "    t = t + ""    DropSite(n)"" + NL" + NL
    t = t + "    t = t + ""    SaveSites()"" + NL" + NL
    t = t + "    t = t + ""    FillList()"" + NL" + NL
    t = t + "    t = t + ""    win.Status = n + """" is no longer served here."""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' ---------------------------------------------------------------- DNS"" + NL" + NL
    t = t + "    t = t + ""' What the name server says about each site's name, asked one a tick."" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION DnsOf (name AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    IF name.StartsWith(""""*."""") THEN RETURN """"-"""""" + NL" + NL
    t = t + "    t = t + ""    i = dnsName.IndexOf(name)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN """"checking..."""""" + NL" + NL
    t = t + "    t = t + ""    RETURN dnsSays[i]"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Want (name AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    IF name.StartsWith(""""*."""") THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    i = dnsName.IndexOf(name)"" + NL" + NL
    t = t + "    t = t + ""    IF i >= 0 THEN"" + NL" + NL
    t = t + "    t = t + ""        dnsName.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        dnsSays.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF NOT dnsWant.Contains(name) THEN dnsWant.Add(name)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB CheckAll ()"" + NL" + NL
    t = t + "    t = t + ""    VAR n AS String"" + NL" + NL
    t = t + "    t = t + ""    FOR EACH n IN rowName"" + NL" + NL
    t = t + "    t = t + ""        Want(n)"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Check_Click ()"" + NL" + NL
    t = t + "    t = t + ""    ' asked again from scratch, and a silent name server is tried again too"" + NL" + NL
    t = t + "    t = t + ""    RsForget()"" + NL" + NL
    t = t + "    t = t + ""    dnsName.Clear()"" + NL" + NL
    t = t + "    t = t + ""    dnsSays.Clear()"" + NL" + NL
    t = t + "    t = t + ""    CheckAll()"" + NL" + NL
    t = t + "    t = t + ""    FillList()"" + NL" + NL
    t = t + "    t = t + ""    win.Status = """"Asking the name server, """" + RsNameServer() + """"..."""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Is this machine the one a name leads to?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION IsHere (target AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR t AS String"" + NL" + NL
    t = t + "    t = t + ""    t = target.Lower()"" + NL" + NL
    t = t + "    t = t + ""    IF t.EndsWith(""""."""") THEN t = t.Substring(0, t.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""    RETURN t = here OR t = here.Split(""""."""")[0] OR t = NET.LocalAddress OR t = """"localhost"""""" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' What the resolver knows about name, in words."" + NL" + NL
    t = t + "    t = t + ""FUNCTION DnsWords (name AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    IF RsNameServer() = """""""" THEN RETURN """"no name server"""""" + NL" + NL
    t = t + "    t = t + ""    IF RsKnown(name) THEN"" + NL" + NL
    t = t + "    t = t + ""        IF IsHere(RsTarget(name)) THEN RETURN Chr(10003) + """" points here"""""" + NL" + NL
    t = t + "    t = t + ""        RETURN """"points at """" + RsTarget(name)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF RsNoSuchName(name) THEN RETURN """"not registered"""""" + NL" + NL
    t = t + "    t = t + ""    IF RsSilent() THEN RETURN """"name server not answering"""""" + NL" + NL
    t = t + "    t = t + ""    RETURN """"points nowhere"""""" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Clock_OnTick ()"" + NL" + NL
    t = t + "    t = t + ""    ' nothing may come after this TRY: a tick whose question was refused is spoiled"" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        Tick()"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Tick ()"" + NL" + NL
    t = t + "    t = t + ""    VAR n AS String"" + NL" + NL
    t = t + "    t = t + ""    IF ticking THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    IF page = """"main"""" AND SYS.Ticks MOD 1000 < 100 THEN ShowMain()"" + NL" + NL
    t = t + "    t = t + ""    IF dnsWant.Count = 0 THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    n = dnsWant[0]"" + NL" + NL
    t = t + "    t = t + ""    ticking = TRUE"" + NL" + NL
    t = t + "    t = t + ""    ' asked now (a Connect: the last thing this tick does), or on its way"" + NL" + NL
    t = t + "    t = t + ""    IF RsNext(n) THEN"" + NL" + NL
    t = t + "    t = t + ""        ticking = FALSE"" + NL" + NL
    t = t + "    t = t + ""        win.Status = """"Asking the name server about """" + n + """"..."""""" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    ticking = FALSE"" + NL" + NL
    t = t + "    t = t + ""    dnsWant.RemoveAt(0)"" + NL" + NL
    t = t + "    t = t + ""    dnsName.Add(n)"" + NL" + NL
    t = t + "    t = t + ""    dnsSays.Add(DnsWords(n))"" + NL" + NL
    t = t + "    t = t + ""    FillList()"" + NL" + NL
    t = t + "    t = t + ""    IF dnsWant.Count = 0 THEN win.Status = """"The name server has answered for every site."""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' RESOLVE.SPK - the SimDNS resolver: asks the name server which machine a"" + NL" + NL
    t = t + "    t = t + ""' name like www.coolsite.sim is on."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' The name server is the central one, STARTHERE.56k.net, where SimNIC (the"" + NL" + NL
    t = t + "    t = t + ""' registrar) and NAMED.SPK run, unless C:\SYSTEM\RESOLV.INI says otherwise."" + NL" + NL
    t = t + "    t = t + ""' To move the whole network to another central host, change RSCENTRAL below"" + NL" + NL
    t = t + "    t = t + ""' (the builder sets it from CENTRAL in tools/simxplorer-source.mjs)."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' A library, not a program: a program has it joined on the end (the builder"" + NL" + NL
    t = t + "    t = t + ""' does this for Simxplorer, SimPlayer, Vapor, Frostbird, MAILD, the Sim Shell,"" + NL" + NL
    t = t + "    t = t + ""' AskSim's crawler, DIG and Personal Web Manager; copy C:\PROGRAMS\RESOLVE.SPK"" + NL" + NL
    t = t + "    t = t + ""' onto the end of your own). Every name in it starts with Rs, so it can't clash."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' C:\SYSTEM\RESOLV.INI, shared by every program on the machine (optional):"" + NL" + NL
    t = t + "    t = t + ""'     nameserver=dnsbox          another name server instead of the central one"" + NL" + NL
    t = t + "    t = t + ""'     nameserver=none            no SimDNS at all: SIM95 machine names only"" + NL" + NL
    t = t + "    t = t + ""'     search=coolsite.sim        then """"www"""" means www.coolsite.sim"" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' How to use it without ever waiting in the wrong place (SIM95-NOTES.md):"" + NL" + NL
    t = t + "    t = t + ""'   1. RsWants(host)  - does this name need asking? FALSE for addresses,"" + NL" + NL
    t = t + "    t = t + ""'                       plain machine names, names already known, or when"" + NL" + NL
    t = t + "    t = t + ""'                       there is no name server (or it isn't answering)."" + NL" + NL
    t = t + "    t = t + ""'   2. RsAsk(host, address) - sends the question to the name server at that"" + NL" + NL
    t = t + "    t = t + ""'                       address. It is a Connect: let it be the last thing"" + NL" + NL
    t = t + "    t = t + ""'                       the handler does."" + NL" + NL
    t = t + "    t = t + ""'   3. RsBusy()       - TRUE while the answer is on its way. After RSWAIT"" + NL" + NL
    t = t + "    t = t + ""'                       with no answer the server is left alone for RSQUIET,"" + NL" + NL
    t = t + "    t = t + ""'                       and every name goes to SIM95 as before."" + NL" + NL
    t = t + "    t = t + ""'   4. RsTarget(host) - where to connect: the machine name (or address) the"" + NL" + NL
    t = t + "    t = t + ""'                       name server gave, or the name itself when SimDNS"" + NL" + NL
    t = t + "    t = t + ""'                       doesn't know it, for SIM95 to look up."" + NL" + NL
    t = t + "    t = t + ""' Answers are kept for their TTL; names SimDNS doesn't know for RSNEG."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' Or, from a timer tick, all of that in one line (see RsNext):"" + NL" + NL
    t = t + "    t = t + ""'     IF RsNext(host) THEN RETURN          ' asked, or waiting: end the tick"" + NL" + NL
    t = t + "    t = t + ""'     conn = sock.Connect(RsTarget(host), 80)"" + NL" + NL
    t = t + "    t = t + ""' and for mail, the domain's MX first (see RsNextMail):"" + NL" + NL
    t = t + "    t = t + ""'     IF RsNextMail(domain) THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""'     conn = sock.Connect(RsMailTarget(domain), 25)"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""CONST RSCENTRAL = """"starthere.56k.net""""   ' the central name server"" + NL" + NL
    t = t + "    t = t + ""CONST RSINI = """"C:\SYSTEM\RESOLV.INI"""""" + NL" + NL
    t = t + "    t = t + ""CONST RSPORT = 53"" + NL" + NL
    t = t + "    t = t + ""CONST RSWAIT = 2000             ' ms to wait for an answer"" + NL" + NL
    t = t + "    t = t + ""CONST RSQUIET = 30000            ' ms to leave a silent name server alone"" + NL" + NL
    t = t + "    t = t + ""CONST RSNEG = 60000             ' ms to remember that SimDNS doesn't know a name"" + NL" + NL
    t = t + "    t = t + ""CONST RSMOST = 100              ' names kept"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""VAR rsServer AS String              ' """""""" when SimDNS is off"" + NL" + NL
    t = t + "    t = t + ""VAR rsByDefault AS Bool               ' TRUE when RESOLV.INI doesn't name one"" + NL" + NL
    t = t + "    t = t + ""VAR rsSearch AS String"" + NL" + NL
    t = t + "    t = t + ""VAR rsRead AS Bool"" + NL" + NL
    t = t + "    t = t + ""VAR rsReadAt AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR rsSock AS NET_Socket"" + NL" + NL
    t = t + "    t = t + ""VAR rsName AS Array OF String       ' the name as asked, lower case"" + NL" + NL
    t = t + "    t = t + ""VAR rsTo AS Array OF String         ' where it is ("""""""" when SimDNS doesn't know it)"" + NL" + NL
    t = t + "    t = t + ""VAR rsCanon AS Array OF String      ' its last name in DNS before the machine"" + NL" + NL
    t = t + "    t = t + ""VAR rsUntil AS Array OF Integer     ' SYS.Ticks when it is forgotten"" + NL" + NL
    t = t + "    t = t + ""VAR rsAsking AS String"" + NL" + NL
    t = t + "    t = t + ""VAR rsAskAt AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR rsRefused AS Bool"" + NL" + NL
    t = t + "    t = t + ""VAR rsDown AS Bool"" + NL" + NL
    t = t + "    t = t + ""VAR rsDownAt AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR rsWhy AS String                 ' the last thing that went wrong"" + NL" + NL
    t = t + "    t = t + ""VAR rsLastReply AS String           ' the last answer, as it came"" + NL" + NL
    t = t + "    t = t + ""VAR rsServerAddr AS String          ' the name server's address, for RsNext"" + NL" + NL
    t = t + "    t = t + ""VAR rsServerFor AS String"" + NL" + NL
    t = t + "    t = t + ""VAR rsServerAt AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR rsLooking AS Bool               ' RsNext is finding the name server's address"" + NL" + NL
    t = t + "    t = t + ""VAR rsLookingAt AS Integer"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Reads RESOLV.INI (again after a few seconds, so a new setting takes)."" + NL" + NL
    Put("C:\WEB\VAPOR\SIMWEB\4.TXT")
END SUB

SUB File16 ()
    t = ""
    t = t + "    t = t + ""' With no nameserver= line, the central name server; none (or nothing after"" + NL" + NL
    t = t + "    t = t + ""' the =) turns SimDNS off."" + NL" + NL
    t = t + "    t = t + ""SUB RsConfig ()"" + NL" + NL
    t = t + "    t = t + ""    VAR line AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR low AS String"" + NL" + NL
    t = t + "    t = t + ""    IF rsRead AND SYS.Ticks - rsReadAt < 3000 THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    rsRead = TRUE"" + NL" + NL
    t = t + "    t = t + ""    rsReadAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    rsServer = RSCENTRAL"" + NL" + NL
    t = t + "    t = t + ""    rsByDefault = TRUE"" + NL" + NL
    t = t + "    t = t + ""    rsSearch = """""""""" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        IF FS.Exists(RSINI) THEN"" + NL" + NL
    t = t + "    t = t + ""            FOR EACH line IN FS.Read(RSINI).Lines()"" + NL" + NL
    t = t + "    t = t + ""                low = line.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""                IF low.StartsWith(""""nameserver="""") THEN"" + NL" + NL
    t = t + "    t = t + ""                    rsServer = low.Substring(11, low.Length - 11).Trim()"" + NL" + NL
    t = t + "    t = t + ""                    rsByDefault = FALSE"" + NL" + NL
    t = t + "    t = t + ""                END IF"" + NL" + NL
    t = t + "    t = t + ""                IF low.StartsWith(""""search="""") THEN rsSearch = low.Substring(7, low.Length - 7).Trim()"" + NL" + NL
    t = t + "    t = t + ""            NEXT"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""    IF rsServer = """"none"""" THEN rsServer = """""""""" + NL" + NL
    t = t + "    t = t + ""    IF rsSearch.StartsWith(""""."""") THEN rsSearch = rsSearch.Substring(1, rsSearch.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""    IF rsSearch.EndsWith(""""."""") THEN rsSearch = rsSearch.Substring(0, rsSearch.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The name server (a machine name or address), or """""""" for none."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsNameServer () AS String"" + NL" + NL
    t = t + "    t = t + ""    RsConfig()"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsServer"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Is it the central one, because RESOLV.INI doesn't say?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsIsCentral () AS Bool"" + NL" + NL
    t = t + "    t = t + ""    RsConfig()"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsByDefault"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Makes server this machine's name server, keeping the rest of RESOLV.INI,"" + NL" + NL
    t = t + "    t = t + ""' and forgets everything it knew. """""""" (or none) for no SimDNS at all;"" + NL" + NL
    t = t + "    t = t + ""' default for the central one again."" + NL" + NL
    t = t + "    t = t + ""SUB RsSave (server AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR out AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR line AS String"" + NL" + NL
    t = t + "    t = t + ""    server = server.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    IF server = """""""" THEN server = """"none"""""" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        IF FS.Exists(RSINI) THEN"" + NL" + NL
    t = t + "    t = t + ""            FOR EACH line IN FS.Read(RSINI).Lines()"" + NL" + NL
    t = t + "    t = t + ""                IF line.Trim() <> """""""" AND NOT line.Trim().Lower().StartsWith(""""nameserver="""") THEN out.Add(line)"" + NL" + NL
    t = t + "    t = t + ""            NEXT"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        IF server <> """"default"""" THEN out.Insert(0, """"nameserver="""" + server)"" + NL" + NL
    t = t + "    t = t + ""        IF out.Count = 0 THEN"" + NL" + NL
    t = t + "    t = t + ""            IF FS.Exists(RSINI) THEN FS.Delete(RSINI)"" + NL" + NL
    t = t + "    t = t + ""        ELSE"" + NL" + NL
    t = t + "    t = t + ""            FS.Write(RSINI, out.Join(Chr(10)) + Chr(10))"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""        rsWhy = err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""    rsRead = FALSE"" + NL" + NL
    t = t + "    t = t + ""    RsForget()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB RsForget ()"" + NL" + NL
    t = t + "    t = t + ""    rsName.Clear()"" + NL" + NL
    t = t + "    t = t + ""    rsTo.Clear()"" + NL" + NL
    t = t + "    t = t + ""    rsCanon.Clear()"" + NL" + NL
    t = t + "    t = t + ""    rsUntil.Clear()"" + NL" + NL
    t = t + "    t = t + ""    rsDown = FALSE"" + NL" + NL
    t = t + "    t = t + ""    rsAsking = """""""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsIsAddress (s AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR p AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    IF s.Split(""""."""").Count <> 4 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    FOR EACH p IN s.Split(""""."""")"" + NL" + NL
    t = t + "    t = t + ""        IF p = """""""" OR p.Length > 3 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""        FOR i = 0 TO p.Length - 1"" + NL" + NL
    t = t + "    t = t + ""            IF NOT """"0123456789"""".Contains(p.CharAt(i)) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""        NEXT"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The name the server is asked about: lower case, the search domain added"" + NL" + NL
    t = t + "    t = t + ""' to a single word."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsFull (host AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR h AS String"" + NL" + NL
    t = t + "    t = t + ""    h = host.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    IF h.EndsWith(""""."""") THEN h = h.Substring(0, h.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""    IF NOT h.Contains(""""."""") AND rsSearch <> """""""" THEN h = h + """"."""" + rsSearch"" + NL" + NL
    t = t + "    t = t + ""    RETURN h"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Where a name is in the list of answers, or -1 (old answers are dropped)."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsFind (host AS String) AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = rsName.IndexOf(host.Trim().Lower())"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN -1"" + NL" + NL
    t = t + "    t = t + ""    IF SYS.Ticks > rsUntil[i] THEN"" + NL" + NL
    t = t + "    t = t + ""        rsName.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsTo.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsCanon.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsUntil.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        RETURN -1"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    RETURN i"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsWants (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    IF NOT RsAsks(host) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsFind(host) < 0"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The same for a mail domain's MX record."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsWantsMx (domain AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    IF NOT RsAsks(domain) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsFind(""""mx:"""" + domain.Trim().Lower()) < 0"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Is host a name for the name server at all (whether known yet or not)?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsAsks (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR h AS String"" + NL" + NL
    t = t + "    t = t + ""    RsConfig()"" + NL" + NL
    t = t + "    t = t + ""    h = host.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    IF rsServer = """""""" OR h = """""""" OR h = """"localhost"""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF rsDown AND SYS.Ticks - rsDownAt < RSQUIET THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF RsIsAddress(h) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF NOT h.Contains(""""."""") AND rsSearch = """""""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF h = rsServer OR h = NET.HostName.Lower() THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Sends the question. A Connect, so it must be the last thing its handler"" + NL" + NL
    t = t + "    t = t + ""' does: if the name server refuses, the handler is spoiled (SIM95-NOTES.md)."" + NL" + NL
    t = t + "    t = t + ""SUB RsAsk (host AS String, address AS String)"" + NL" + NL
    t = t + "    t = t + ""    RsSend(host.Trim().Lower(), """"A"""", address)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Asks for a mail domain's MX records (also a Connect: the last thing)."" + NL" + NL
    t = t + "    t = t + ""SUB RsAskMx (domain AS String, address AS String)"" + NL" + NL
    t = t + "    t = t + ""    RsSend(""""mx:"""" + domain.Trim().Lower(), """"MX"""", address)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' key is the name, or mx: and the name; the answer is kept under it."" + NL" + NL
    t = t + "    t = t + ""SUB RsSend (key AS String, qtype AS String, address AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR conn AS NET_Connection"" + NL" + NL
    t = t + "    t = t + ""    VAR name AS String"" + NL" + NL
    t = t + "    t = t + ""    IF IsNothing(rsSock) THEN"" + NL" + NL
    t = t + "    t = t + ""        rsSock = NET_Socket.New()"" + NL" + NL
    t = t + "    t = t + ""        rsSock.onMessage = Rs_OnMessage"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    name = key"" + NL" + NL
    t = t + "    t = t + ""    IF name.StartsWith(""""mx:"""") THEN name = name.Substring(3, name.Length - 3)"" + NL" + NL
    t = t + "    t = t + ""    rsAsking = key"" + NL" + NL
    t = t + "    t = t + ""    rsAskAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    rsRefused = FALSE"" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        conn = rsSock.Connect(address, RSPORT)"" + NL" + NL
    t = t + "    t = t + ""        conn.Tag = """"rs:"""" + key"" + NL" + NL
    t = t + "    t = t + ""        conn.Send(""""QUERY """" + RsFull(name) + """" """" + qtype)"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""        rsRefused = TRUE"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Gives up on the name server for a while: every name goes to SIM95."" + NL" + NL
    t = t + "    t = t + ""SUB RsGiveUp (why AS String)"" + NL" + NL
    t = t + "    t = t + ""    rsWhy = why"" + NL" + NL
    t = t + "    t = t + ""    rsDown = TRUE"" + NL" + NL
    t = t + "    t = t + ""    rsDownAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    rsAsking = """""""""" + NL" + NL
    t = t + "    t = t + ""    rsServerAddr = """""""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' For a program that fetches from a timer tick: TRUE when the tick must end"" + NL" + NL
    t = t + "    t = t + ""' now, because a question about host has just been sent (a Connect, so it"" + NL" + NL
    t = t + "    t = t + ""' has to be the last thing the handler does) or an answer is on its way."" + NL" + NL
    t = t + "    t = t + ""' FALSE when there is nothing to ask: RsTarget(host) is where to connect."" + NL" + NL
    t = t + "    t = t + ""' A name server that is missing, refuses or says nothing for RSWAIT is left"" + NL" + NL
    t = t + "    t = t + ""' alone for RSQUIET, and every name goes to SIM95: nothing ever hangs."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsNext (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsStep(host, FALSE)"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The same for mail to domain: its MX record (the lowest preference), then"" + NL" + NL
    t = t + "    t = t + ""' the CNAMEs or address of the machine that names. RsMailTarget(domain) is"" + NL" + NL
    t = t + "    t = t + ""' then where to connect; with no MX, the domain's own machine; with no"" + NL" + NL
    t = t + "    t = t + ""' answer at all, the domain itself, for SIM95 to look up."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsNextMail (domain AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    IF RsStep(domain, TRUE) THEN RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsStep(RsMailHost(domain), FALSE)"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsStep (host AS String, mx AS Bool) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR addr AS String"" + NL" + NL
    t = t + "    t = t + ""    ' another handler is finding the name server (it waits): wait for it"" + NL" + NL
    t = t + "    t = t + ""    IF rsLooking THEN"" + NL" + NL
    t = t + "    t = t + ""        IF SYS.Ticks - rsLookingAt < RSWAIT THEN RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""        rsLooking = FALSE"" + NL" + NL
    t = t + "    t = t + ""        RsGiveUp(""""no answer about the machine """" + rsServer)"" + NL" + NL
    t = t + "    t = t + ""        RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF RsBusy() THEN RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""    IF mx THEN"" + NL" + NL
    t = t + "    t = t + ""        IF NOT RsWantsMx(host) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        IF NOT RsWants(host) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    addr = RsServerAddress()"" + NL" + NL
    t = t + "    t = t + ""    IF addr = """""""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF mx THEN"" + NL" + NL
    t = t + "    t = t + ""        RsAskMx(host, addr)"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        RsAsk(host, addr)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The name server's address, looked up once a minute (one lookup at a time:"" + NL" + NL
    t = t + "    t = t + ""' see SIM95-NOTES.md). """""""" when there is no such machine, and then it gives up."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsServerAddress () AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR addr AS String"" + NL" + NL
    t = t + "    t = t + ""    IF RsIsAddress(rsServer) THEN RETURN rsServer"" + NL" + NL
    t = t + "    t = t + ""    IF rsServerAddr <> """""""" AND rsServerFor = rsServer AND SYS.Ticks - rsServerAt < 60000 AND SYS.Ticks >= rsServerAt THEN RETURN rsServerAddr"" + NL" + NL
    t = t + "    t = t + ""    rsLooking = TRUE"" + NL" + NL
    t = t + "    t = t + ""    rsLookingAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    addr = NET.Resolve(rsServer)"" + NL" + NL
    t = t + "    t = t + ""    IF NOT rsLooking THEN RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""    rsLooking = FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF addr = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        RsGiveUp(""""there is no machine called """" + rsServer)"" + NL" + NL
    t = t + "    t = t + ""        RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    rsServerAddr = addr"" + NL" + NL
    t = t + "    t = t + ""    rsServerFor = rsServer"" + NL" + NL
    t = t + "    t = t + ""    rsServerAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    RETURN addr"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsBusy () AS Bool"" + NL" + NL
    t = t + "    t = t + ""    IF rsAsking = """""""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF rsRefused THEN"" + NL" + NL
    t = t + "    t = t + ""        RsGiveUp(""""the name server """" + rsServer + """" refused"""")"" + NL" + NL
    t = t + "    t = t + ""        RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF SYS.Ticks - rsAskAt > RSWAIT THEN"" + NL" + NL
    t = t + "    t = t + ""        RsGiveUp(""""no answer from the name server """" + rsServer)"" + NL" + NL
    t = t + "    t = t + ""        RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Rs_OnMessage (conn AS NET_Connection, message AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR h AS String"" + NL" + NL
    t = t + "    t = t + ""    IF NOT conn.Tag.StartsWith(""""rs:"""") THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    h = conn.Tag.Substring(3, conn.Tag.Length - 3)"" + NL" + NL
    t = t + "    t = t + ""    conn.Tag = """""""""" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        conn.Close()"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""    RsTake(h, message)"" + NL" + NL
    t = t + "    t = t + ""    IF h = rsAsking THEN rsAsking = """""""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Learns an answer: follows its CNAMEs to an address, or to the machine"" + NL" + NL
    t = t + "    t = t + ""' name the chain ends at."" + NL" + NL
    t = t + "    t = t + ""SUB RsTake (host AS String, reply AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR lines AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR w AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR cur AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR onward AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR target AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR canon AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR ttl AS Integer = 3600"" + NL" + NL
    t = t + "    t = t + ""    VAR hops AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    rsLastReply = reply"" + NL" + NL
    t = t + "    t = t + ""    IF host.StartsWith(""""mx:"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        RsTakeMx(host, reply)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    lines = reply.Lines()"" + NL" + NL
    t = t + "    t = t + ""    IF lines.Count = 0 THEN RETURN"" + NL" + NL
    Put("C:\WEB\VAPOR\SIMWEB\5.TXT")
END SUB

SUB File17 ()
    t = ""
    t = t + "    t = t + ""    IF lines[0].StartsWith(""""NXDOMAIN"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(host, """""""", """"NXDOMAIN"""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF NOT lines[0].StartsWith(""""OK"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        rsWhy = lines[0]"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(host, """""""", """""""", 10000)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    cur = RsFull(host)"" + NL" + NL
    t = t + "    t = t + ""    canon = cur"" + NL" + NL
    t = t + "    t = t + ""    FOR hops = 0 TO 8"" + NL" + NL
    t = t + "    t = t + ""        onward = """""""""" + NL" + NL
    t = t + "    t = t + ""        FOR i = 1 TO lines.Count - 1"" + NL" + NL
    t = t + "    t = t + ""            w = lines[i].Split("""" """")"" + NL" + NL
    t = t + "    t = t + ""            IF w.Count >= 4 THEN"" + NL" + NL
    t = t + "    t = t + ""                IF w[0] = cur AND w[2] = """"A"""" AND target = """""""" THEN target = w[3]"" + NL" + NL
    t = t + "    t = t + ""                IF w[0] = cur AND w[2] = """"CNAME"""" THEN onward = w[3]"" + NL" + NL
    t = t + "    t = t + ""                IF w[0] = cur AND (w[2] = """"A"""" OR w[2] = """"CNAME"""") AND Int(Val(w[1])) < ttl THEN ttl = Int(Val(w[1]))"" + NL" + NL
    t = t + "    t = t + ""            END IF"" + NL" + NL
    t = t + "    t = t + ""        NEXT"" + NL" + NL
    t = t + "    t = t + ""        IF target <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""            canon = cur"" + NL" + NL
    t = t + "    t = t + ""            BREAK"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        IF onward = """""""" THEN BREAK"" + NL" + NL
    t = t + "    t = t + ""        canon = cur"" + NL" + NL
    t = t + "    t = t + ""        cur = onward"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    IF target = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        ' a name with no CNAME and no address: not one to connect to"" + NL" + NL
    t = t + "    t = t + ""        IF cur = RsFull(host) THEN"" + NL" + NL
    t = t + "    t = t + ""            RsKeep(host, """""""", """""""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""            RETURN"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        ' the end of the chain: a SIM95 machine name"" + NL" + NL
    t = t + "    t = t + ""        target = cur"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF ttl < 5 THEN ttl = 5"" + NL" + NL
    t = t + "    t = t + ""    RsKeep(host, target, canon, ttl * 1000)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Learns an MX answer: the mail machine with the lowest preference. With no"" + NL" + NL
    t = t + "    t = t + ""' MX, the server answers with the domain's CNAMEs instead, and the domain's"" + NL" + NL
    t = t + "    t = t + ""' own machine takes the mail."" + NL" + NL
    t = t + "    t = t + ""SUB RsTakeMx (key AS String, reply AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR domain AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR lines AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR w AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR best AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR pref AS Integer = 1000000"" + NL" + NL
    t = t + "    t = t + ""    VAR ttl AS Integer = 3600"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    domain = key.Substring(3, key.Length - 3)"" + NL" + NL
    t = t + "    t = t + ""    lines = reply.Lines()"" + NL" + NL
    t = t + "    t = t + ""    IF lines.Count = 0 THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    IF lines[0].StartsWith(""""NXDOMAIN"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, """""""", """"NXDOMAIN"""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(domain, """""""", """"NXDOMAIN"""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF NOT lines[0].StartsWith(""""OK"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        rsWhy = lines[0]"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, """""""", """""""", 10000)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 1 TO lines.Count - 1"" + NL" + NL
    t = t + "    t = t + ""        w = lines[i].Split("""" """")"" + NL" + NL
    t = t + "    t = t + ""        IF w.Count >= 5 THEN"" + NL" + NL
    t = t + "    t = t + ""            IF w[2] = """"MX"""" AND Int(Val(w[3])) < pref THEN"" + NL" + NL
    t = t + "    t = t + ""                pref = Int(Val(w[3]))"" + NL" + NL
    t = t + "    t = t + ""                best = w[4]"" + NL" + NL
    t = t + "    t = t + ""                ttl = Int(Val(w[1]))"" + NL" + NL
    t = t + "    t = t + ""            END IF"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    IF best <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        IF best.EndsWith(""""."""") THEN best = best.Substring(0, best.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""        IF ttl < 5 THEN ttl = 5"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, best, RsFull(domain), ttl * 1000)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    RsTake(domain, reply)"" + NL" + NL
    t = t + "    t = t + ""    IF RsKnown(domain) THEN"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, domain, RsFull(domain), RSNEG)"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, """""""", """""""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The machine (or name) that takes domain's mail: its MX, or domain itself."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsMailHost (domain AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(""""mx:"""" + domain.Trim().Lower())"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN domain"" + NL" + NL
    t = t + "    t = t + ""    IF rsTo[i] = """""""" THEN RETURN domain"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsTo[i]"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Where to connect for domain's mail."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsMailTarget (domain AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsTarget(RsMailHost(domain))"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Did SimDNS say where domain's mail goes (an MX, or the domain's machine)?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsMailKnown (domain AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(""""mx:"""" + domain.Trim().Lower())"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF rsTo[i] = """""""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsKnown(RsMailHost(domain)) OR NOT RsAsks(RsMailHost(domain))"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB RsKeep (host AS String, target AS String, canon AS String, ms AS Integer)"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR h AS String"" + NL" + NL
    t = t + "    t = t + ""    h = host.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    i = rsName.IndexOf(h)"" + NL" + NL
    t = t + "    t = t + ""    IF i >= 0 THEN"" + NL" + NL
    t = t + "    t = t + ""        rsName.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsTo.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsCanon.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsUntil.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF rsName.Count >= RSMOST THEN"" + NL" + NL
    t = t + "    t = t + ""        rsName.RemoveAt(0)"" + NL" + NL
    t = t + "    t = t + ""        rsTo.RemoveAt(0)"" + NL" + NL
    t = t + "    t = t + ""        rsCanon.RemoveAt(0)"" + NL" + NL
    t = t + "    t = t + ""        rsUntil.RemoveAt(0)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    rsName.Add(h)"" + NL" + NL
    t = t + "    t = t + ""    rsTo.Add(target)"" + NL" + NL
    t = t + "    t = t + ""    rsCanon.Add(canon)"" + NL" + NL
    t = t + "    t = t + ""    rsUntil.Add(SYS.Ticks + ms)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Where to connect for host: what SimDNS said, or host itself."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsTarget (host AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(host)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN host"" + NL" + NL
    t = t + "    t = t + ""    IF rsTo[i] = """""""" THEN RETURN host"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsTo[i]"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The name host's machine was found under (www.coolsite.sim), or host."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsCanonical (host AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(host)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN host"" + NL" + NL
    t = t + "    t = t + ""    IF rsTo[i] = """""""" THEN RETURN host"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsCanon[i]"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Did SimDNS answer for host (so RsTarget is its machine)?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsKnown (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(host)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsTo[i] <> """""""""" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Did the name server say there is no such name (NXDOMAIN)?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsNoSuchName (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(host)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsTo[i] = """""""" AND rsCanon[i] = """"NXDOMAIN"""""" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Is the name server being left alone, because it didn't answer (or there"" + NL" + NL
    t = t + "    t = t + ""' is none)? rsWhy says why."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsSilent () AS Bool"" + NL" + NL
    t = t + "    t = t + ""    RsConfig()"" + NL" + NL
    t = t + "    t = t + ""    IF rsServer = """""""" THEN RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsDown AND SYS.Ticks - rsDownAt < RSQUIET"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    Put(""C:\PROGRAMS\PWM.SPK"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB File1 ()" + NL
    t = t + "    t = """"" + NL
    t = t + "    t = t + ""' DIG.SPK - asks a SimDNS name server about a name, like dig on Unix."" + NL" + NL
    t = t + "    t = t + ""' From the Terminal or the Sim Shell:"" + NL" + NL
    t = t + "    t = t + ""'     DIG www.coolsite.sim               where is it? (the CNAMEs to its machine)"" + NL" + NL
    t = t + "    t = t + ""'     DIG coolsite.sim MX                its mail machine (also TXT, NS, SOA, ANY)"" + NL" + NL
    t = t + "    t = t + ""'     DIG www.coolsite.sim ANY @bravo    ask BRAVO instead of the usual server"" + NL" + NL
    t = t + "    t = t + ""'     DIG SET dnsbox                     use DNSBOX's SimDNS from now on"" + NL" + NL
    t = t + "    t = t + ""'     DIG SET NONE                       stop using SimDNS (machine names only)"" + NL" + NL
    t = t + "    t = t + ""'     DIG SET DEFAULT                    the central name server again"" + NL" + NL
    t = t + "    t = t + ""'     DIG SET                            which name server is it?"" + NL" + NL
    t = t + "    t = t + ""' The usual name server is the central one (STARTHERE.56k.net), unless"" + NL" + NL
    t = t + "    t = t + ""' C:\SYSTEM\RESOLV.INI says otherwise; Simxplorer's Options and every"" + NL" + NL
    t = t + "    t = t + ""' program that uses RESOLVE.SPK read it. The builder joins RESOLVE.SPK onto"" + NL" + NL
    t = t + "    t = t + ""' the end of this file."" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""VAR digReply AS String"" + NL" + NL
    t = t + "    t = t + ""VAR digSock AS NET_Socket"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Main ()"" + NL" + NL
    t = t + "    t = t + ""    VAR args AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR a AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR name AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR qtype AS String = """"A"""""" + NL" + NL
    t = t + "    t = t + ""    VAR server AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR addr AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR conn AS NET_Connection"" + NL" + NL
    t = t + "    t = t + ""    VAR started AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR failed AS String"" + NL" + NL
    t = t + "    t = t + ""    FOR EACH a IN SYS.Args"" + NL" + NL
    t = t + "    t = t + ""        IF a.Trim() <> """""""" THEN args.Add(a.Trim())"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    IF args.Count = 0 THEN"" + NL" + NL
    t = t + "    t = t + ""        Print(""""Usage: DIG name [type] [@server]      types: A CNAME MX TXT NS SOA ANY"""")"" + NL" + NL
    t = t + "    t = t + ""        Print(""""       DIG SET machine                  make machine this computer's name server"""")"" + NL" + NL
    t = t + "    t = t + ""        Print(""""       DIG SET DEFAULT                  the central one, """" + RSCENTRAL)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF args[0].Upper() = """"SET"""" THEN"" + NL" + NL
    t = t + "    t = t + ""        SetServer(args)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    RsConfig()"" + NL" + NL
    t = t + "    t = t + ""    FOR EACH a IN args"" + NL" + NL
    t = t + "    t = t + ""        IF a.StartsWith(""""@"""") THEN"" + NL" + NL
    t = t + "    t = t + ""            server = a.Substring(1, a.Length - 1).Lower()"" + NL" + NL
    t = t + "    t = t + ""        ELSEIF """"|A|CNAME|MX|TXT|NS|SOA|ANY|"""".Contains(""""|"""" + a.Upper() + """"|"""") AND name <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""            qtype = a.Upper()"" + NL" + NL
    t = t + "    t = t + ""        ELSE"" + NL" + NL
    t = t + "    t = t + ""            name = a.Lower()"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    IF name = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        Print(""""Which name? For example:  DIG www.coolsite.sim"""")"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF server = """""""" THEN server = RsNameServer()"" + NL" + NL
    t = t + "    t = t + ""    IF server = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        Print("""";; SimDNS is off (nameserver=none in C:\SYSTEM\RESOLV.INI). DIG SET DEFAULT turns it on."""")"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    Print("""""""")"" + NL" + NL
    t = t + "    t = t + ""    Print(""""; <<>> DiG 2.1 for SIM95 (SimDNS) <<>> """" + name + """" """" + qtype)"" + NL" + NL
    t = t + "    t = t + ""    addr = NET.Resolve(server)"" + NL" + NL
    t = t + "    t = t + ""    IF addr = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        Print("""";; connection failed: there is no machine called """" + server)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    digSock = NET_Socket.New()"" + NL" + NL
    t = t + "    t = t + ""    digSock.onMessage = Dig_OnMessage"" + NL" + NL
    t = t + "    t = t + ""    started = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        conn = digSock.Connect(addr, RSPORT)"" + NL" + NL
    t = t + "    t = t + ""        conn.Send(""""QUERY """" + RsFull(name) + """" """" + qtype)"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""        failed = err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""    ' A refused Connect spoils this handler (SIM95-NOTES.md): no more waiting."" + NL" + NL
    t = t + "    t = t + ""    IF failed <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        Print("""";; connection to """" + server + """" ("""" + addr + """") port 53 failed: """" + failed.Split("""":"""")[0] + """". Is NAMED.SPK running there?"""")"" + NL" + NL
    t = t + "    t = t + ""        SYS.Exit(0)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    WHILE digReply = """""""" AND SYS.Ticks - started < 3000"" + NL" + NL
    t = t + "    t = t + ""        SYS.Sleep(50)"" + NL" + NL
    t = t + "    t = t + ""    END WHILE"" + NL" + NL
    t = t + "    t = t + ""    IF digReply = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        Print("""";; connection timed out; no answer from """" + server)"" + NL" + NL
    t = t + "    t = t + ""        SYS.Exit(0)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    Show(name, qtype, server, addr, SYS.Ticks - started)"" + NL" + NL
    t = t + "    t = t + ""    SYS.Exit(0)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Dig_OnMessage (conn AS NET_Connection, message AS String)"" + NL" + NL
    t = t + "    t = t + ""    digReply = message"" + NL" + NL
    t = t + "    t = t + ""    conn.Close()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Prints the answer the way dig did, and where a machine name leads."" + NL" + NL
    t = t + "    t = t + ""SUB Show (name AS String, qtype AS String, server AS String, addr AS String, ms AS Integer)"" + NL" + NL
    t = t + "    t = t + ""    VAR lines AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR w AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR status AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR last AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR machine AS String"" + NL" + NL
    t = t + "    t = t + ""    lines = digReply.Lines()"" + NL" + NL
    t = t + "    t = t + ""    status = lines[0].Split("""" """")[0]"" + NL" + NL
    t = t + "    t = t + ""    IF status = """"OK"""" THEN status = """"NOERROR"""""" + NL" + NL
    t = t + "    t = t + ""    Print("""";; ->>HEADER<<- status: """" + status + """", answers: """" + Str(lines.Count - 1))"" + NL" + NL
    Put("C:\WEB\VAPOR\SIMWEB\6.TXT")
END SUB

SUB File18 ()
    t = ""
    t = t + "    t = t + ""    IF lines[0].Contains("""" """") THEN Print("""";; """" + lines[0].Substring(lines[0].IndexOf("""" """") + 1, lines[0].Length - lines[0].IndexOf("""" """") - 1))"" + NL" + NL
    t = t + "    t = t + ""    Print("""""""")"" + NL" + NL
    t = t + "    t = t + ""    Print("""";; QUESTION SECTION:"""")"" + NL" + NL
    t = t + "    t = t + ""    Print("""";"""" + (RsFull(name) + """"."""").PadRight(31) + """" IN  """" + qtype)"" + NL" + NL
    t = t + "    t = t + ""    IF lines.Count > 1 THEN"" + NL" + NL
    t = t + "    t = t + ""        Print("""""""")"" + NL" + NL
    t = t + "    t = t + ""        Print("""";; ANSWER SECTION:"""")"" + NL" + NL
    t = t + "    t = t + ""        FOR i = 1 TO lines.Count - 1"" + NL" + NL
    t = t + "    t = t + ""            w = lines[i].Split("""" """")"" + NL" + NL
    t = t + "    t = t + ""            IF w.Count < 4 THEN CONTINUE"" + NL" + NL
    t = t + "    t = t + ""            Print((w[0] + """"."""").PadRight(24) + """" """" + w[1].PadRight(6) + """" IN  """" + w[2].PadRight(6) + """" """" + Rest(w, 3))"" + NL" + NL
    t = t + "    t = t + ""            IF w[2] = """"CNAME"""" THEN last = w[3]"" + NL" + NL
    t = t + "    t = t + ""            IF w[2] = """"A"""" THEN last = """""""""" + NL" + NL
    t = t + "    t = t + ""        NEXT"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    ' a CNAME chain that ends at a name SimDNS doesn't know ends at a machine"" + NL" + NL
    t = t + "    t = t + ""    IF last <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        machine = last"" + NL" + NL
    t = t + "    t = t + ""        FOR i = 1 TO lines.Count - 1"" + NL" + NL
    t = t + "    t = t + ""            IF lines[i].StartsWith(last + """" """") THEN machine = """""""""" + NL" + NL
    t = t + "    t = t + ""        NEXT"" + NL" + NL
    t = t + "    t = t + ""        IF machine <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""            Print("""""""")"" + NL" + NL
    t = t + "    t = t + ""            Print("""";; """" + machine + """" is a SIM95 machine name: """" + Where(machine) + """" (asked SIM95, not SimDNS)"""")"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    Print("""""""")"" + NL" + NL
    t = t + "    t = t + ""    Print("""";; Query time: """" + Str(ms) + """" msec"""")"" + NL" + NL
    t = t + "    t = t + ""    Print("""";; SERVER: """" + server + """" ("""" + addr + """") port 53"""")"" + NL" + NL
    t = t + "    t = t + ""    Print("""";; WHEN: """" + TIME.Date + """" """" + TIME.Clock)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION Where (machine AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR a AS String"" + NL" + NL
    t = t + "    t = t + ""    a = NET.Resolve(machine)"" + NL" + NL
    t = t + "    t = t + ""    IF a = """""""" THEN RETURN """"not on the network now"""""" + NL" + NL
    t = t + "    t = t + ""    RETURN a"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION Rest (w AS Array OF String, at AS Integer) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR out AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    FOR i = at TO w.Count - 1"" + NL" + NL
    t = t + "    t = t + ""        out.Add(w[i])"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    RETURN out.Join("""" """")"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB SetServer (args AS Array OF String)"" + NL" + NL
    t = t + "    t = t + ""    IF args.Count < 2 THEN"" + NL" + NL
    t = t + "    t = t + ""        IF RsNameServer() = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""            Print(""""SimDNS is off: names are SIM95 machine names only."""")"" + NL" + NL
    t = t + "    t = t + ""        ELSEIF RsIsCentral() THEN"" + NL" + NL
    t = t + "    t = t + ""            Print(""""The name server is """" + RsNameServer() + """", the central one."""")"" + NL" + NL
    t = t + "    t = t + ""        ELSE"" + NL" + NL
    t = t + "    t = t + ""            Print(""""The name server is """" + RsNameServer() + """" (C:\SYSTEM\RESOLV.INI)."""")"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF args[1].Upper() = """"NONE"""" THEN"" + NL" + NL
    t = t + "    t = t + ""        RsSave(""""none"""")"" + NL" + NL
    t = t + "    t = t + ""        Print(""""No name server now: names are SIM95 machine names only."""")"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF args[1].Upper() = """"DEFAULT"""" THEN"" + NL" + NL
    t = t + "    t = t + ""        RsSave(""""default"""")"" + NL" + NL
    t = t + "    t = t + ""        Print(""""The name server is the central one again: """" + RSCENTRAL + """"."""")"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    RsSave(args[1])"" + NL" + NL
    t = t + "    t = t + ""    Print(""""The name server is now """" + args[1].Lower() + """" (C:\SYSTEM\RESOLV.INI). Simxplorer uses it too."""")"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' RESOLVE.SPK - the SimDNS resolver: asks the name server which machine a"" + NL" + NL
    t = t + "    t = t + ""' name like www.coolsite.sim is on."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' The name server is the central one, STARTHERE.56k.net, where SimNIC (the"" + NL" + NL
    t = t + "    t = t + ""' registrar) and NAMED.SPK run, unless C:\SYSTEM\RESOLV.INI says otherwise."" + NL" + NL
    t = t + "    t = t + ""' To move the whole network to another central host, change RSCENTRAL below"" + NL" + NL
    t = t + "    t = t + ""' (the builder sets it from CENTRAL in tools/simxplorer-source.mjs)."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' A library, not a program: a program has it joined on the end (the builder"" + NL" + NL
    t = t + "    t = t + ""' does this for Simxplorer, SimPlayer, Vapor, Frostbird, MAILD, the Sim Shell,"" + NL" + NL
    t = t + "    t = t + ""' AskSim's crawler, DIG and Personal Web Manager; copy C:\PROGRAMS\RESOLVE.SPK"" + NL" + NL
    t = t + "    t = t + ""' onto the end of your own). Every name in it starts with Rs, so it can't clash."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' C:\SYSTEM\RESOLV.INI, shared by every program on the machine (optional):"" + NL" + NL
    t = t + "    t = t + ""'     nameserver=dnsbox          another name server instead of the central one"" + NL" + NL
    t = t + "    t = t + ""'     nameserver=none            no SimDNS at all: SIM95 machine names only"" + NL" + NL
    t = t + "    t = t + ""'     search=coolsite.sim        then """"www"""" means www.coolsite.sim"" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' How to use it without ever waiting in the wrong place (SIM95-NOTES.md):"" + NL" + NL
    t = t + "    t = t + ""'   1. RsWants(host)  - does this name need asking? FALSE for addresses,"" + NL" + NL
    t = t + "    t = t + ""'                       plain machine names, names already known, or when"" + NL" + NL
    t = t + "    t = t + ""'                       there is no name server (or it isn't answering)."" + NL" + NL
    t = t + "    t = t + ""'   2. RsAsk(host, address) - sends the question to the name server at that"" + NL" + NL
    t = t + "    t = t + ""'                       address. It is a Connect: let it be the last thing"" + NL" + NL
    t = t + "    t = t + ""'                       the handler does."" + NL" + NL
    t = t + "    t = t + ""'   3. RsBusy()       - TRUE while the answer is on its way. After RSWAIT"" + NL" + NL
    t = t + "    t = t + ""'                       with no answer the server is left alone for RSQUIET,"" + NL" + NL
    t = t + "    t = t + ""'                       and every name goes to SIM95 as before."" + NL" + NL
    t = t + "    t = t + ""'   4. RsTarget(host) - where to connect: the machine name (or address) the"" + NL" + NL
    t = t + "    t = t + ""'                       name server gave, or the name itself when SimDNS"" + NL" + NL
    t = t + "    t = t + ""'                       doesn't know it, for SIM95 to look up."" + NL" + NL
    t = t + "    t = t + ""' Answers are kept for their TTL; names SimDNS doesn't know for RSNEG."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' Or, from a timer tick, all of that in one line (see RsNext):"" + NL" + NL
    t = t + "    t = t + ""'     IF RsNext(host) THEN RETURN          ' asked, or waiting: end the tick"" + NL" + NL
    t = t + "    t = t + ""'     conn = sock.Connect(RsTarget(host), 80)"" + NL" + NL
    t = t + "    t = t + ""' and for mail, the domain's MX first (see RsNextMail):"" + NL" + NL
    t = t + "    t = t + ""'     IF RsNextMail(domain) THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""'     conn = sock.Connect(RsMailTarget(domain), 25)"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""CONST RSCENTRAL = """"starthere.56k.net""""   ' the central name server"" + NL" + NL
    t = t + "    t = t + ""CONST RSINI = """"C:\SYSTEM\RESOLV.INI"""""" + NL" + NL
    t = t + "    t = t + ""CONST RSPORT = 53"" + NL" + NL
    t = t + "    t = t + ""CONST RSWAIT = 2000             ' ms to wait for an answer"" + NL" + NL
    t = t + "    t = t + ""CONST RSQUIET = 30000            ' ms to leave a silent name server alone"" + NL" + NL
    t = t + "    t = t + ""CONST RSNEG = 60000             ' ms to remember that SimDNS doesn't know a name"" + NL" + NL
    t = t + "    t = t + ""CONST RSMOST = 100              ' names kept"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""VAR rsServer AS String              ' """""""" when SimDNS is off"" + NL" + NL
    t = t + "    t = t + ""VAR rsByDefault AS Bool               ' TRUE when RESOLV.INI doesn't name one"" + NL" + NL
    t = t + "    t = t + ""VAR rsSearch AS String"" + NL" + NL
    t = t + "    t = t + ""VAR rsRead AS Bool"" + NL" + NL
    t = t + "    t = t + ""VAR rsReadAt AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR rsSock AS NET_Socket"" + NL" + NL
    t = t + "    t = t + ""VAR rsName AS Array OF String       ' the name as asked, lower case"" + NL" + NL
    t = t + "    t = t + ""VAR rsTo AS Array OF String         ' where it is ("""""""" when SimDNS doesn't know it)"" + NL" + NL
    t = t + "    t = t + ""VAR rsCanon AS Array OF String      ' its last name in DNS before the machine"" + NL" + NL
    t = t + "    t = t + ""VAR rsUntil AS Array OF Integer     ' SYS.Ticks when it is forgotten"" + NL" + NL
    t = t + "    t = t + ""VAR rsAsking AS String"" + NL" + NL
    t = t + "    t = t + ""VAR rsAskAt AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR rsRefused AS Bool"" + NL" + NL
    t = t + "    t = t + ""VAR rsDown AS Bool"" + NL" + NL
    t = t + "    t = t + ""VAR rsDownAt AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR rsWhy AS String                 ' the last thing that went wrong"" + NL" + NL
    t = t + "    t = t + ""VAR rsLastReply AS String           ' the last answer, as it came"" + NL" + NL
    t = t + "    t = t + ""VAR rsServerAddr AS String          ' the name server's address, for RsNext"" + NL" + NL
    t = t + "    t = t + ""VAR rsServerFor AS String"" + NL" + NL
    t = t + "    t = t + ""VAR rsServerAt AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR rsLooking AS Bool               ' RsNext is finding the name server's address"" + NL" + NL
    t = t + "    t = t + ""VAR rsLookingAt AS Integer"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Reads RESOLV.INI (again after a few seconds, so a new setting takes)."" + NL" + NL
    t = t + "    t = t + ""' With no nameserver= line, the central name server; none (or nothing after"" + NL" + NL
    t = t + "    t = t + ""' the =) turns SimDNS off."" + NL" + NL
    t = t + "    t = t + ""SUB RsConfig ()"" + NL" + NL
    t = t + "    t = t + ""    VAR line AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR low AS String"" + NL" + NL
    t = t + "    t = t + ""    IF rsRead AND SYS.Ticks - rsReadAt < 3000 THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    rsRead = TRUE"" + NL" + NL
    t = t + "    t = t + ""    rsReadAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    rsServer = RSCENTRAL"" + NL" + NL
    t = t + "    t = t + ""    rsByDefault = TRUE"" + NL" + NL
    t = t + "    t = t + ""    rsSearch = """""""""" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        IF FS.Exists(RSINI) THEN"" + NL" + NL
    t = t + "    t = t + ""            FOR EACH line IN FS.Read(RSINI).Lines()"" + NL" + NL
    t = t + "    t = t + ""                low = line.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""                IF low.StartsWith(""""nameserver="""") THEN"" + NL" + NL
    t = t + "    t = t + ""                    rsServer = low.Substring(11, low.Length - 11).Trim()"" + NL" + NL
    t = t + "    t = t + ""                    rsByDefault = FALSE"" + NL" + NL
    t = t + "    t = t + ""                END IF"" + NL" + NL
    t = t + "    t = t + ""                IF low.StartsWith(""""search="""") THEN rsSearch = low.Substring(7, low.Length - 7).Trim()"" + NL" + NL
    t = t + "    t = t + ""            NEXT"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""    IF rsServer = """"none"""" THEN rsServer = """""""""" + NL" + NL
    t = t + "    t = t + ""    IF rsSearch.StartsWith(""""."""") THEN rsSearch = rsSearch.Substring(1, rsSearch.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""    IF rsSearch.EndsWith(""""."""") THEN rsSearch = rsSearch.Substring(0, rsSearch.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The name server (a machine name or address), or """""""" for none."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsNameServer () AS String"" + NL" + NL
    t = t + "    t = t + ""    RsConfig()"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsServer"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Is it the central one, because RESOLV.INI doesn't say?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsIsCentral () AS Bool"" + NL" + NL
    t = t + "    t = t + ""    RsConfig()"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsByDefault"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Makes server this machine's name server, keeping the rest of RESOLV.INI,"" + NL" + NL
    t = t + "    t = t + ""' and forgets everything it knew. """""""" (or none) for no SimDNS at all;"" + NL" + NL
    t = t + "    t = t + ""' default for the central one again."" + NL" + NL
    t = t + "    t = t + ""SUB RsSave (server AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR out AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR line AS String"" + NL" + NL
    t = t + "    t = t + ""    server = server.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    IF server = """""""" THEN server = """"none"""""" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        IF FS.Exists(RSINI) THEN"" + NL" + NL
    t = t + "    t = t + ""            FOR EACH line IN FS.Read(RSINI).Lines()"" + NL" + NL
    t = t + "    t = t + ""                IF line.Trim() <> """""""" AND NOT line.Trim().Lower().StartsWith(""""nameserver="""") THEN out.Add(line)"" + NL" + NL
    t = t + "    t = t + ""            NEXT"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        IF server <> """"default"""" THEN out.Insert(0, """"nameserver="""" + server)"" + NL" + NL
    t = t + "    t = t + ""        IF out.Count = 0 THEN"" + NL" + NL
    t = t + "    t = t + ""            IF FS.Exists(RSINI) THEN FS.Delete(RSINI)"" + NL" + NL
    t = t + "    t = t + ""        ELSE"" + NL" + NL
    t = t + "    t = t + ""            FS.Write(RSINI, out.Join(Chr(10)) + Chr(10))"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""        rsWhy = err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""    rsRead = FALSE"" + NL" + NL
    t = t + "    t = t + ""    RsForget()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB RsForget ()"" + NL" + NL
    t = t + "    t = t + ""    rsName.Clear()"" + NL" + NL
    t = t + "    t = t + ""    rsTo.Clear()"" + NL" + NL
    t = t + "    t = t + ""    rsCanon.Clear()"" + NL" + NL
    t = t + "    t = t + ""    rsUntil.Clear()"" + NL" + NL
    t = t + "    t = t + ""    rsDown = FALSE"" + NL" + NL
    t = t + "    t = t + ""    rsAsking = """""""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsIsAddress (s AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR p AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    IF s.Split(""""."""").Count <> 4 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    FOR EACH p IN s.Split(""""."""")"" + NL" + NL
    t = t + "    t = t + ""        IF p = """""""" OR p.Length > 3 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""        FOR i = 0 TO p.Length - 1"" + NL" + NL
    t = t + "    t = t + ""            IF NOT """"0123456789"""".Contains(p.CharAt(i)) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""        NEXT"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The name the server is asked about: lower case, the search domain added"" + NL" + NL
    t = t + "    t = t + ""' to a single word."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsFull (host AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR h AS String"" + NL" + NL
    t = t + "    t = t + ""    h = host.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    IF h.EndsWith(""""."""") THEN h = h.Substring(0, h.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""    IF NOT h.Contains(""""."""") AND rsSearch <> """""""" THEN h = h + """"."""" + rsSearch"" + NL" + NL
    t = t + "    t = t + ""    RETURN h"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Where a name is in the list of answers, or -1 (old answers are dropped)."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsFind (host AS String) AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = rsName.IndexOf(host.Trim().Lower())"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN -1"" + NL" + NL
    t = t + "    t = t + ""    IF SYS.Ticks > rsUntil[i] THEN"" + NL" + NL
    t = t + "    t = t + ""        rsName.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsTo.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsCanon.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsUntil.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        RETURN -1"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    RETURN i"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    Put("C:\WEB\VAPOR\SIMWEB\7.TXT")
END SUB

SUB File19 ()
    t = ""
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsWants (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    IF NOT RsAsks(host) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsFind(host) < 0"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The same for a mail domain's MX record."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsWantsMx (domain AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    IF NOT RsAsks(domain) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsFind(""""mx:"""" + domain.Trim().Lower()) < 0"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Is host a name for the name server at all (whether known yet or not)?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsAsks (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR h AS String"" + NL" + NL
    t = t + "    t = t + ""    RsConfig()"" + NL" + NL
    t = t + "    t = t + ""    h = host.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    IF rsServer = """""""" OR h = """""""" OR h = """"localhost"""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF rsDown AND SYS.Ticks - rsDownAt < RSQUIET THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF RsIsAddress(h) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF NOT h.Contains(""""."""") AND rsSearch = """""""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF h = rsServer OR h = NET.HostName.Lower() THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Sends the question. A Connect, so it must be the last thing its handler"" + NL" + NL
    t = t + "    t = t + ""' does: if the name server refuses, the handler is spoiled (SIM95-NOTES.md)."" + NL" + NL
    t = t + "    t = t + ""SUB RsAsk (host AS String, address AS String)"" + NL" + NL
    t = t + "    t = t + ""    RsSend(host.Trim().Lower(), """"A"""", address)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Asks for a mail domain's MX records (also a Connect: the last thing)."" + NL" + NL
    t = t + "    t = t + ""SUB RsAskMx (domain AS String, address AS String)"" + NL" + NL
    t = t + "    t = t + ""    RsSend(""""mx:"""" + domain.Trim().Lower(), """"MX"""", address)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' key is the name, or mx: and the name; the answer is kept under it."" + NL" + NL
    t = t + "    t = t + ""SUB RsSend (key AS String, qtype AS String, address AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR conn AS NET_Connection"" + NL" + NL
    t = t + "    t = t + ""    VAR name AS String"" + NL" + NL
    t = t + "    t = t + ""    IF IsNothing(rsSock) THEN"" + NL" + NL
    t = t + "    t = t + ""        rsSock = NET_Socket.New()"" + NL" + NL
    t = t + "    t = t + ""        rsSock.onMessage = Rs_OnMessage"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    name = key"" + NL" + NL
    t = t + "    t = t + ""    IF name.StartsWith(""""mx:"""") THEN name = name.Substring(3, name.Length - 3)"" + NL" + NL
    t = t + "    t = t + ""    rsAsking = key"" + NL" + NL
    t = t + "    t = t + ""    rsAskAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    rsRefused = FALSE"" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        conn = rsSock.Connect(address, RSPORT)"" + NL" + NL
    t = t + "    t = t + ""        conn.Tag = """"rs:"""" + key"" + NL" + NL
    t = t + "    t = t + ""        conn.Send(""""QUERY """" + RsFull(name) + """" """" + qtype)"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""        rsRefused = TRUE"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Gives up on the name server for a while: every name goes to SIM95."" + NL" + NL
    t = t + "    t = t + ""SUB RsGiveUp (why AS String)"" + NL" + NL
    t = t + "    t = t + ""    rsWhy = why"" + NL" + NL
    t = t + "    t = t + ""    rsDown = TRUE"" + NL" + NL
    t = t + "    t = t + ""    rsDownAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    rsAsking = """""""""" + NL" + NL
    t = t + "    t = t + ""    rsServerAddr = """""""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' For a program that fetches from a timer tick: TRUE when the tick must end"" + NL" + NL
    t = t + "    t = t + ""' now, because a question about host has just been sent (a Connect, so it"" + NL" + NL
    t = t + "    t = t + ""' has to be the last thing the handler does) or an answer is on its way."" + NL" + NL
    t = t + "    t = t + ""' FALSE when there is nothing to ask: RsTarget(host) is where to connect."" + NL" + NL
    t = t + "    t = t + ""' A name server that is missing, refuses or says nothing for RSWAIT is left"" + NL" + NL
    t = t + "    t = t + ""' alone for RSQUIET, and every name goes to SIM95: nothing ever hangs."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsNext (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsStep(host, FALSE)"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The same for mail to domain: its MX record (the lowest preference), then"" + NL" + NL
    t = t + "    t = t + ""' the CNAMEs or address of the machine that names. RsMailTarget(domain) is"" + NL" + NL
    t = t + "    t = t + ""' then where to connect; with no MX, the domain's own machine; with no"" + NL" + NL
    t = t + "    t = t + ""' answer at all, the domain itself, for SIM95 to look up."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsNextMail (domain AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    IF RsStep(domain, TRUE) THEN RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsStep(RsMailHost(domain), FALSE)"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsStep (host AS String, mx AS Bool) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR addr AS String"" + NL" + NL
    t = t + "    t = t + ""    ' another handler is finding the name server (it waits): wait for it"" + NL" + NL
    t = t + "    t = t + ""    IF rsLooking THEN"" + NL" + NL
    t = t + "    t = t + ""        IF SYS.Ticks - rsLookingAt < RSWAIT THEN RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""        rsLooking = FALSE"" + NL" + NL
    t = t + "    t = t + ""        RsGiveUp(""""no answer about the machine """" + rsServer)"" + NL" + NL
    t = t + "    t = t + ""        RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF RsBusy() THEN RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""    IF mx THEN"" + NL" + NL
    t = t + "    t = t + ""        IF NOT RsWantsMx(host) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        IF NOT RsWants(host) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    addr = RsServerAddress()"" + NL" + NL
    t = t + "    t = t + ""    IF addr = """""""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF mx THEN"" + NL" + NL
    t = t + "    t = t + ""        RsAskMx(host, addr)"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        RsAsk(host, addr)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The name server's address, looked up once a minute (one lookup at a time:"" + NL" + NL
    t = t + "    t = t + ""' see SIM95-NOTES.md). """""""" when there is no such machine, and then it gives up."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsServerAddress () AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR addr AS String"" + NL" + NL
    t = t + "    t = t + ""    IF RsIsAddress(rsServer) THEN RETURN rsServer"" + NL" + NL
    t = t + "    t = t + ""    IF rsServerAddr <> """""""" AND rsServerFor = rsServer AND SYS.Ticks - rsServerAt < 60000 AND SYS.Ticks >= rsServerAt THEN RETURN rsServerAddr"" + NL" + NL
    t = t + "    t = t + ""    rsLooking = TRUE"" + NL" + NL
    t = t + "    t = t + ""    rsLookingAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    addr = NET.Resolve(rsServer)"" + NL" + NL
    t = t + "    t = t + ""    IF NOT rsLooking THEN RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""    rsLooking = FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF addr = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        RsGiveUp(""""there is no machine called """" + rsServer)"" + NL" + NL
    t = t + "    t = t + ""        RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    rsServerAddr = addr"" + NL" + NL
    t = t + "    t = t + ""    rsServerFor = rsServer"" + NL" + NL
    t = t + "    t = t + ""    rsServerAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    RETURN addr"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsBusy () AS Bool"" + NL" + NL
    t = t + "    t = t + ""    IF rsAsking = """""""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF rsRefused THEN"" + NL" + NL
    t = t + "    t = t + ""        RsGiveUp(""""the name server """" + rsServer + """" refused"""")"" + NL" + NL
    t = t + "    t = t + ""        RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF SYS.Ticks - rsAskAt > RSWAIT THEN"" + NL" + NL
    t = t + "    t = t + ""        RsGiveUp(""""no answer from the name server """" + rsServer)"" + NL" + NL
    t = t + "    t = t + ""        RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Rs_OnMessage (conn AS NET_Connection, message AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR h AS String"" + NL" + NL
    t = t + "    t = t + ""    IF NOT conn.Tag.StartsWith(""""rs:"""") THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    h = conn.Tag.Substring(3, conn.Tag.Length - 3)"" + NL" + NL
    t = t + "    t = t + ""    conn.Tag = """""""""" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        conn.Close()"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""    RsTake(h, message)"" + NL" + NL
    t = t + "    t = t + ""    IF h = rsAsking THEN rsAsking = """""""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Learns an answer: follows its CNAMEs to an address, or to the machine"" + NL" + NL
    t = t + "    t = t + ""' name the chain ends at."" + NL" + NL
    t = t + "    t = t + ""SUB RsTake (host AS String, reply AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR lines AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR w AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR cur AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR onward AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR target AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR canon AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR ttl AS Integer = 3600"" + NL" + NL
    t = t + "    t = t + ""    VAR hops AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    rsLastReply = reply"" + NL" + NL
    t = t + "    t = t + ""    IF host.StartsWith(""""mx:"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        RsTakeMx(host, reply)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    lines = reply.Lines()"" + NL" + NL
    t = t + "    t = t + ""    IF lines.Count = 0 THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    IF lines[0].StartsWith(""""NXDOMAIN"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(host, """""""", """"NXDOMAIN"""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF NOT lines[0].StartsWith(""""OK"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        rsWhy = lines[0]"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(host, """""""", """""""", 10000)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    cur = RsFull(host)"" + NL" + NL
    t = t + "    t = t + ""    canon = cur"" + NL" + NL
    t = t + "    t = t + ""    FOR hops = 0 TO 8"" + NL" + NL
    t = t + "    t = t + ""        onward = """""""""" + NL" + NL
    t = t + "    t = t + ""        FOR i = 1 TO lines.Count - 1"" + NL" + NL
    t = t + "    t = t + ""            w = lines[i].Split("""" """")"" + NL" + NL
    t = t + "    t = t + ""            IF w.Count >= 4 THEN"" + NL" + NL
    t = t + "    t = t + ""                IF w[0] = cur AND w[2] = """"A"""" AND target = """""""" THEN target = w[3]"" + NL" + NL
    t = t + "    t = t + ""                IF w[0] = cur AND w[2] = """"CNAME"""" THEN onward = w[3]"" + NL" + NL
    t = t + "    t = t + ""                IF w[0] = cur AND (w[2] = """"A"""" OR w[2] = """"CNAME"""") AND Int(Val(w[1])) < ttl THEN ttl = Int(Val(w[1]))"" + NL" + NL
    t = t + "    t = t + ""            END IF"" + NL" + NL
    t = t + "    t = t + ""        NEXT"" + NL" + NL
    t = t + "    t = t + ""        IF target <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""            canon = cur"" + NL" + NL
    t = t + "    t = t + ""            BREAK"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        IF onward = """""""" THEN BREAK"" + NL" + NL
    t = t + "    t = t + ""        canon = cur"" + NL" + NL
    t = t + "    t = t + ""        cur = onward"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    IF target = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        ' a name with no CNAME and no address: not one to connect to"" + NL" + NL
    t = t + "    t = t + ""        IF cur = RsFull(host) THEN"" + NL" + NL
    t = t + "    t = t + ""            RsKeep(host, """""""", """""""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""            RETURN"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        ' the end of the chain: a SIM95 machine name"" + NL" + NL
    t = t + "    t = t + ""        target = cur"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF ttl < 5 THEN ttl = 5"" + NL" + NL
    t = t + "    t = t + ""    RsKeep(host, target, canon, ttl * 1000)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Learns an MX answer: the mail machine with the lowest preference. With no"" + NL" + NL
    t = t + "    t = t + ""' MX, the server answers with the domain's CNAMEs instead, and the domain's"" + NL" + NL
    t = t + "    t = t + ""' own machine takes the mail."" + NL" + NL
    t = t + "    t = t + ""SUB RsTakeMx (key AS String, reply AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR domain AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR lines AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR w AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR best AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR pref AS Integer = 1000000"" + NL" + NL
    t = t + "    t = t + ""    VAR ttl AS Integer = 3600"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    domain = key.Substring(3, key.Length - 3)"" + NL" + NL
    t = t + "    t = t + ""    lines = reply.Lines()"" + NL" + NL
    t = t + "    t = t + ""    IF lines.Count = 0 THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    IF lines[0].StartsWith(""""NXDOMAIN"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, """""""", """"NXDOMAIN"""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(domain, """""""", """"NXDOMAIN"""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF NOT lines[0].StartsWith(""""OK"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        rsWhy = lines[0]"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, """""""", """""""", 10000)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 1 TO lines.Count - 1"" + NL" + NL
    t = t + "    t = t + ""        w = lines[i].Split("""" """")"" + NL" + NL
    t = t + "    t = t + ""        IF w.Count >= 5 THEN"" + NL" + NL
    t = t + "    t = t + ""            IF w[2] = """"MX"""" AND Int(Val(w[3])) < pref THEN"" + NL" + NL
    t = t + "    t = t + ""                pref = Int(Val(w[3]))"" + NL" + NL
    t = t + "    t = t + ""                best = w[4]"" + NL" + NL
    t = t + "    t = t + ""                ttl = Int(Val(w[1]))"" + NL" + NL
    t = t + "    t = t + ""            END IF"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    IF best <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        IF best.EndsWith(""""."""") THEN best = best.Substring(0, best.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""        IF ttl < 5 THEN ttl = 5"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, best, RsFull(domain), ttl * 1000)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    RsTake(domain, reply)"" + NL" + NL
    t = t + "    t = t + ""    IF RsKnown(domain) THEN"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, domain, RsFull(domain), RSNEG)"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, """""""", """""""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The machine (or name) that takes domain's mail: its MX, or domain itself."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsMailHost (domain AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(""""mx:"""" + domain.Trim().Lower())"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN domain"" + NL" + NL
    t = t + "    t = t + ""    IF rsTo[i] = """""""" THEN RETURN domain"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsTo[i]"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Where to connect for domain's mail."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsMailTarget (domain AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsTarget(RsMailHost(domain))"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Did SimDNS say where domain's mail goes (an MX, or the domain's machine)?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsMailKnown (domain AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(""""mx:"""" + domain.Trim().Lower())"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF rsTo[i] = """""""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsKnown(RsMailHost(domain)) OR NOT RsAsks(RsMailHost(domain))"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    Put("C:\WEB\VAPOR\SIMWEB\8.TXT")
END SUB

SUB File20 ()
    t = ""
    t = t + "    t = t + ""SUB RsKeep (host AS String, target AS String, canon AS String, ms AS Integer)"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR h AS String"" + NL" + NL
    t = t + "    t = t + ""    h = host.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    i = rsName.IndexOf(h)"" + NL" + NL
    t = t + "    t = t + ""    IF i >= 0 THEN"" + NL" + NL
    t = t + "    t = t + ""        rsName.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsTo.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsCanon.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsUntil.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF rsName.Count >= RSMOST THEN"" + NL" + NL
    t = t + "    t = t + ""        rsName.RemoveAt(0)"" + NL" + NL
    t = t + "    t = t + ""        rsTo.RemoveAt(0)"" + NL" + NL
    t = t + "    t = t + ""        rsCanon.RemoveAt(0)"" + NL" + NL
    t = t + "    t = t + ""        rsUntil.RemoveAt(0)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    rsName.Add(h)"" + NL" + NL
    t = t + "    t = t + ""    rsTo.Add(target)"" + NL" + NL
    t = t + "    t = t + ""    rsCanon.Add(canon)"" + NL" + NL
    t = t + "    t = t + ""    rsUntil.Add(SYS.Ticks + ms)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Where to connect for host: what SimDNS said, or host itself."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsTarget (host AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(host)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN host"" + NL" + NL
    t = t + "    t = t + ""    IF rsTo[i] = """""""" THEN RETURN host"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsTo[i]"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The name host's machine was found under (www.coolsite.sim), or host."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsCanonical (host AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(host)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN host"" + NL" + NL
    t = t + "    t = t + ""    IF rsTo[i] = """""""" THEN RETURN host"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsCanon[i]"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Did SimDNS answer for host (so RsTarget is its machine)?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsKnown (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(host)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsTo[i] <> """""""""" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Did the name server say there is no such name (NXDOMAIN)?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsNoSuchName (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(host)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsTo[i] = """""""" AND rsCanon[i] = """"NXDOMAIN"""""" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Is the name server being left alone, because it didn't answer (or there"" + NL" + NL
    t = t + "    t = t + ""' is none)? rsWhy says why."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsSilent () AS Bool"" + NL" + NL
    t = t + "    t = t + ""    RsConfig()"" + NL" + NL
    t = t + "    t = t + ""    IF rsServer = """""""" THEN RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsDown AND SYS.Ticks - rsDownAt < RSQUIET"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    Put(""C:\PROGRAMS\DIG.SPK"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB File2 ()" + NL
    t = t + "    t = """"" + NL
    t = t + "    t = t + ""' RESOLVE.SPK - the SimDNS resolver: asks the name server which machine a"" + NL" + NL
    t = t + "    t = t + ""' name like www.coolsite.sim is on."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' The name server is the central one, STARTHERE.56k.net, where SimNIC (the"" + NL" + NL
    t = t + "    t = t + ""' registrar) and NAMED.SPK run, unless C:\SYSTEM\RESOLV.INI says otherwise."" + NL" + NL
    t = t + "    t = t + ""' To move the whole network to another central host, change RSCENTRAL below"" + NL" + NL
    t = t + "    t = t + ""' (the builder sets it from CENTRAL in tools/simxplorer-source.mjs)."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' A library, not a program: a program has it joined on the end (the builder"" + NL" + NL
    t = t + "    t = t + ""' does this for Simxplorer, SimPlayer, Vapor, Frostbird, MAILD, the Sim Shell,"" + NL" + NL
    t = t + "    t = t + ""' AskSim's crawler, DIG and Personal Web Manager; copy C:\PROGRAMS\RESOLVE.SPK"" + NL" + NL
    t = t + "    t = t + ""' onto the end of your own). Every name in it starts with Rs, so it can't clash."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' C:\SYSTEM\RESOLV.INI, shared by every program on the machine (optional):"" + NL" + NL
    t = t + "    t = t + ""'     nameserver=dnsbox          another name server instead of the central one"" + NL" + NL
    t = t + "    t = t + ""'     nameserver=none            no SimDNS at all: SIM95 machine names only"" + NL" + NL
    t = t + "    t = t + ""'     search=coolsite.sim        then """"www"""" means www.coolsite.sim"" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' How to use it without ever waiting in the wrong place (SIM95-NOTES.md):"" + NL" + NL
    t = t + "    t = t + ""'   1. RsWants(host)  - does this name need asking? FALSE for addresses,"" + NL" + NL
    t = t + "    t = t + ""'                       plain machine names, names already known, or when"" + NL" + NL
    t = t + "    t = t + ""'                       there is no name server (or it isn't answering)."" + NL" + NL
    t = t + "    t = t + ""'   2. RsAsk(host, address) - sends the question to the name server at that"" + NL" + NL
    t = t + "    t = t + ""'                       address. It is a Connect: let it be the last thing"" + NL" + NL
    t = t + "    t = t + ""'                       the handler does."" + NL" + NL
    t = t + "    t = t + ""'   3. RsBusy()       - TRUE while the answer is on its way. After RSWAIT"" + NL" + NL
    t = t + "    t = t + ""'                       with no answer the server is left alone for RSQUIET,"" + NL" + NL
    t = t + "    t = t + ""'                       and every name goes to SIM95 as before."" + NL" + NL
    t = t + "    t = t + ""'   4. RsTarget(host) - where to connect: the machine name (or address) the"" + NL" + NL
    t = t + "    t = t + ""'                       name server gave, or the name itself when SimDNS"" + NL" + NL
    t = t + "    t = t + ""'                       doesn't know it, for SIM95 to look up."" + NL" + NL
    t = t + "    t = t + ""' Answers are kept for their TTL; names SimDNS doesn't know for RSNEG."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' Or, from a timer tick, all of that in one line (see RsNext):"" + NL" + NL
    t = t + "    t = t + ""'     IF RsNext(host) THEN RETURN          ' asked, or waiting: end the tick"" + NL" + NL
    t = t + "    t = t + ""'     conn = sock.Connect(RsTarget(host), 80)"" + NL" + NL
    t = t + "    t = t + ""' and for mail, the domain's MX first (see RsNextMail):"" + NL" + NL
    t = t + "    t = t + ""'     IF RsNextMail(domain) THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""'     conn = sock.Connect(RsMailTarget(domain), 25)"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""CONST RSCENTRAL = """"starthere.56k.net""""   ' the central name server"" + NL" + NL
    t = t + "    t = t + ""CONST RSINI = """"C:\SYSTEM\RESOLV.INI"""""" + NL" + NL
    t = t + "    t = t + ""CONST RSPORT = 53"" + NL" + NL
    t = t + "    t = t + ""CONST RSWAIT = 2000             ' ms to wait for an answer"" + NL" + NL
    t = t + "    t = t + ""CONST RSQUIET = 30000            ' ms to leave a silent name server alone"" + NL" + NL
    t = t + "    t = t + ""CONST RSNEG = 60000             ' ms to remember that SimDNS doesn't know a name"" + NL" + NL
    t = t + "    t = t + ""CONST RSMOST = 100              ' names kept"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""VAR rsServer AS String              ' """""""" when SimDNS is off"" + NL" + NL
    t = t + "    t = t + ""VAR rsByDefault AS Bool               ' TRUE when RESOLV.INI doesn't name one"" + NL" + NL
    t = t + "    t = t + ""VAR rsSearch AS String"" + NL" + NL
    t = t + "    t = t + ""VAR rsRead AS Bool"" + NL" + NL
    t = t + "    t = t + ""VAR rsReadAt AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR rsSock AS NET_Socket"" + NL" + NL
    t = t + "    t = t + ""VAR rsName AS Array OF String       ' the name as asked, lower case"" + NL" + NL
    t = t + "    t = t + ""VAR rsTo AS Array OF String         ' where it is ("""""""" when SimDNS doesn't know it)"" + NL" + NL
    t = t + "    t = t + ""VAR rsCanon AS Array OF String      ' its last name in DNS before the machine"" + NL" + NL
    t = t + "    t = t + ""VAR rsUntil AS Array OF Integer     ' SYS.Ticks when it is forgotten"" + NL" + NL
    t = t + "    t = t + ""VAR rsAsking AS String"" + NL" + NL
    t = t + "    t = t + ""VAR rsAskAt AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR rsRefused AS Bool"" + NL" + NL
    t = t + "    t = t + ""VAR rsDown AS Bool"" + NL" + NL
    t = t + "    t = t + ""VAR rsDownAt AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR rsWhy AS String                 ' the last thing that went wrong"" + NL" + NL
    t = t + "    t = t + ""VAR rsLastReply AS String           ' the last answer, as it came"" + NL" + NL
    t = t + "    t = t + ""VAR rsServerAddr AS String          ' the name server's address, for RsNext"" + NL" + NL
    t = t + "    t = t + ""VAR rsServerFor AS String"" + NL" + NL
    t = t + "    t = t + ""VAR rsServerAt AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR rsLooking AS Bool               ' RsNext is finding the name server's address"" + NL" + NL
    t = t + "    t = t + ""VAR rsLookingAt AS Integer"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Reads RESOLV.INI (again after a few seconds, so a new setting takes)."" + NL" + NL
    t = t + "    t = t + ""' With no nameserver= line, the central name server; none (or nothing after"" + NL" + NL
    t = t + "    t = t + ""' the =) turns SimDNS off."" + NL" + NL
    t = t + "    t = t + ""SUB RsConfig ()"" + NL" + NL
    t = t + "    t = t + ""    VAR line AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR low AS String"" + NL" + NL
    t = t + "    t = t + ""    IF rsRead AND SYS.Ticks - rsReadAt < 3000 THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    rsRead = TRUE"" + NL" + NL
    t = t + "    t = t + ""    rsReadAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    rsServer = RSCENTRAL"" + NL" + NL
    t = t + "    t = t + ""    rsByDefault = TRUE"" + NL" + NL
    t = t + "    t = t + ""    rsSearch = """""""""" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        IF FS.Exists(RSINI) THEN"" + NL" + NL
    t = t + "    t = t + ""            FOR EACH line IN FS.Read(RSINI).Lines()"" + NL" + NL
    t = t + "    t = t + ""                low = line.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""                IF low.StartsWith(""""nameserver="""") THEN"" + NL" + NL
    t = t + "    t = t + ""                    rsServer = low.Substring(11, low.Length - 11).Trim()"" + NL" + NL
    t = t + "    t = t + ""                    rsByDefault = FALSE"" + NL" + NL
    t = t + "    t = t + ""                END IF"" + NL" + NL
    t = t + "    t = t + ""                IF low.StartsWith(""""search="""") THEN rsSearch = low.Substring(7, low.Length - 7).Trim()"" + NL" + NL
    t = t + "    t = t + ""            NEXT"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""    IF rsServer = """"none"""" THEN rsServer = """""""""" + NL" + NL
    t = t + "    t = t + ""    IF rsSearch.StartsWith(""""."""") THEN rsSearch = rsSearch.Substring(1, rsSearch.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""    IF rsSearch.EndsWith(""""."""") THEN rsSearch = rsSearch.Substring(0, rsSearch.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The name server (a machine name or address), or """""""" for none."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsNameServer () AS String"" + NL" + NL
    t = t + "    t = t + ""    RsConfig()"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsServer"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Is it the central one, because RESOLV.INI doesn't say?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsIsCentral () AS Bool"" + NL" + NL
    t = t + "    t = t + ""    RsConfig()"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsByDefault"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Makes server this machine's name server, keeping the rest of RESOLV.INI,"" + NL" + NL
    t = t + "    t = t + ""' and forgets everything it knew. """""""" (or none) for no SimDNS at all;"" + NL" + NL
    t = t + "    t = t + ""' default for the central one again."" + NL" + NL
    t = t + "    t = t + ""SUB RsSave (server AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR out AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR line AS String"" + NL" + NL
    t = t + "    t = t + ""    server = server.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    IF server = """""""" THEN server = """"none"""""" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        IF FS.Exists(RSINI) THEN"" + NL" + NL
    t = t + "    t = t + ""            FOR EACH line IN FS.Read(RSINI).Lines()"" + NL" + NL
    t = t + "    t = t + ""                IF line.Trim() <> """""""" AND NOT line.Trim().Lower().StartsWith(""""nameserver="""") THEN out.Add(line)"" + NL" + NL
    t = t + "    t = t + ""            NEXT"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        IF server <> """"default"""" THEN out.Insert(0, """"nameserver="""" + server)"" + NL" + NL
    t = t + "    t = t + ""        IF out.Count = 0 THEN"" + NL" + NL
    t = t + "    t = t + ""            IF FS.Exists(RSINI) THEN FS.Delete(RSINI)"" + NL" + NL
    t = t + "    t = t + ""        ELSE"" + NL" + NL
    t = t + "    t = t + ""            FS.Write(RSINI, out.Join(Chr(10)) + Chr(10))"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""        rsWhy = err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""    rsRead = FALSE"" + NL" + NL
    t = t + "    t = t + ""    RsForget()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB RsForget ()"" + NL" + NL
    t = t + "    t = t + ""    rsName.Clear()"" + NL" + NL
    t = t + "    t = t + ""    rsTo.Clear()"" + NL" + NL
    t = t + "    t = t + ""    rsCanon.Clear()"" + NL" + NL
    t = t + "    t = t + ""    rsUntil.Clear()"" + NL" + NL
    t = t + "    t = t + ""    rsDown = FALSE"" + NL" + NL
    t = t + "    t = t + ""    rsAsking = """""""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsIsAddress (s AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR p AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    IF s.Split(""""."""").Count <> 4 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    FOR EACH p IN s.Split(""""."""")"" + NL" + NL
    t = t + "    t = t + ""        IF p = """""""" OR p.Length > 3 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""        FOR i = 0 TO p.Length - 1"" + NL" + NL
    t = t + "    t = t + ""            IF NOT """"0123456789"""".Contains(p.CharAt(i)) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""        NEXT"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The name the server is asked about: lower case, the search domain added"" + NL" + NL
    t = t + "    t = t + ""' to a single word."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsFull (host AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR h AS String"" + NL" + NL
    t = t + "    t = t + ""    h = host.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    IF h.EndsWith(""""."""") THEN h = h.Substring(0, h.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""    IF NOT h.Contains(""""."""") AND rsSearch <> """""""" THEN h = h + """"."""" + rsSearch"" + NL" + NL
    t = t + "    t = t + ""    RETURN h"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Where a name is in the list of answers, or -1 (old answers are dropped)."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsFind (host AS String) AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = rsName.IndexOf(host.Trim().Lower())"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN -1"" + NL" + NL
    t = t + "    t = t + ""    IF SYS.Ticks > rsUntil[i] THEN"" + NL" + NL
    t = t + "    t = t + ""        rsName.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsTo.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsCanon.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsUntil.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        RETURN -1"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    RETURN i"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsWants (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    IF NOT RsAsks(host) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsFind(host) < 0"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The same for a mail domain's MX record."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsWantsMx (domain AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    IF NOT RsAsks(domain) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsFind(""""mx:"""" + domain.Trim().Lower()) < 0"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Is host a name for the name server at all (whether known yet or not)?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsAsks (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR h AS String"" + NL" + NL
    t = t + "    t = t + ""    RsConfig()"" + NL" + NL
    t = t + "    t = t + ""    h = host.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    IF rsServer = """""""" OR h = """""""" OR h = """"localhost"""" THEN RETURN FALSE"" + NL" + NL
    Put("C:\WEB\VAPOR\SIMWEB\9.TXT")
END SUB

SUB File21 ()
    t = ""
    t = t + "    t = t + ""    IF rsDown AND SYS.Ticks - rsDownAt < RSQUIET THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF RsIsAddress(h) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF NOT h.Contains(""""."""") AND rsSearch = """""""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF h = rsServer OR h = NET.HostName.Lower() THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Sends the question. A Connect, so it must be the last thing its handler"" + NL" + NL
    t = t + "    t = t + ""' does: if the name server refuses, the handler is spoiled (SIM95-NOTES.md)."" + NL" + NL
    t = t + "    t = t + ""SUB RsAsk (host AS String, address AS String)"" + NL" + NL
    t = t + "    t = t + ""    RsSend(host.Trim().Lower(), """"A"""", address)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Asks for a mail domain's MX records (also a Connect: the last thing)."" + NL" + NL
    t = t + "    t = t + ""SUB RsAskMx (domain AS String, address AS String)"" + NL" + NL
    t = t + "    t = t + ""    RsSend(""""mx:"""" + domain.Trim().Lower(), """"MX"""", address)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' key is the name, or mx: and the name; the answer is kept under it."" + NL" + NL
    t = t + "    t = t + ""SUB RsSend (key AS String, qtype AS String, address AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR conn AS NET_Connection"" + NL" + NL
    t = t + "    t = t + ""    VAR name AS String"" + NL" + NL
    t = t + "    t = t + ""    IF IsNothing(rsSock) THEN"" + NL" + NL
    t = t + "    t = t + ""        rsSock = NET_Socket.New()"" + NL" + NL
    t = t + "    t = t + ""        rsSock.onMessage = Rs_OnMessage"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    name = key"" + NL" + NL
    t = t + "    t = t + ""    IF name.StartsWith(""""mx:"""") THEN name = name.Substring(3, name.Length - 3)"" + NL" + NL
    t = t + "    t = t + ""    rsAsking = key"" + NL" + NL
    t = t + "    t = t + ""    rsAskAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    rsRefused = FALSE"" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        conn = rsSock.Connect(address, RSPORT)"" + NL" + NL
    t = t + "    t = t + ""        conn.Tag = """"rs:"""" + key"" + NL" + NL
    t = t + "    t = t + ""        conn.Send(""""QUERY """" + RsFull(name) + """" """" + qtype)"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""        rsRefused = TRUE"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Gives up on the name server for a while: every name goes to SIM95."" + NL" + NL
    t = t + "    t = t + ""SUB RsGiveUp (why AS String)"" + NL" + NL
    t = t + "    t = t + ""    rsWhy = why"" + NL" + NL
    t = t + "    t = t + ""    rsDown = TRUE"" + NL" + NL
    t = t + "    t = t + ""    rsDownAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    rsAsking = """""""""" + NL" + NL
    t = t + "    t = t + ""    rsServerAddr = """""""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' For a program that fetches from a timer tick: TRUE when the tick must end"" + NL" + NL
    t = t + "    t = t + ""' now, because a question about host has just been sent (a Connect, so it"" + NL" + NL
    t = t + "    t = t + ""' has to be the last thing the handler does) or an answer is on its way."" + NL" + NL
    t = t + "    t = t + ""' FALSE when there is nothing to ask: RsTarget(host) is where to connect."" + NL" + NL
    t = t + "    t = t + ""' A name server that is missing, refuses or says nothing for RSWAIT is left"" + NL" + NL
    t = t + "    t = t + ""' alone for RSQUIET, and every name goes to SIM95: nothing ever hangs."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsNext (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsStep(host, FALSE)"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The same for mail to domain: its MX record (the lowest preference), then"" + NL" + NL
    t = t + "    t = t + ""' the CNAMEs or address of the machine that names. RsMailTarget(domain) is"" + NL" + NL
    t = t + "    t = t + ""' then where to connect; with no MX, the domain's own machine; with no"" + NL" + NL
    t = t + "    t = t + ""' answer at all, the domain itself, for SIM95 to look up."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsNextMail (domain AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    IF RsStep(domain, TRUE) THEN RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsStep(RsMailHost(domain), FALSE)"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsStep (host AS String, mx AS Bool) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR addr AS String"" + NL" + NL
    t = t + "    t = t + ""    ' another handler is finding the name server (it waits): wait for it"" + NL" + NL
    t = t + "    t = t + ""    IF rsLooking THEN"" + NL" + NL
    t = t + "    t = t + ""        IF SYS.Ticks - rsLookingAt < RSWAIT THEN RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""        rsLooking = FALSE"" + NL" + NL
    t = t + "    t = t + ""        RsGiveUp(""""no answer about the machine """" + rsServer)"" + NL" + NL
    t = t + "    t = t + ""        RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF RsBusy() THEN RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""    IF mx THEN"" + NL" + NL
    t = t + "    t = t + ""        IF NOT RsWantsMx(host) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        IF NOT RsWants(host) THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    addr = RsServerAddress()"" + NL" + NL
    t = t + "    t = t + ""    IF addr = """""""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF mx THEN"" + NL" + NL
    t = t + "    t = t + ""        RsAskMx(host, addr)"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        RsAsk(host, addr)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The name server's address, looked up once a minute (one lookup at a time:"" + NL" + NL
    t = t + "    t = t + ""' see SIM95-NOTES.md). """""""" when there is no such machine, and then it gives up."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsServerAddress () AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR addr AS String"" + NL" + NL
    t = t + "    t = t + ""    IF RsIsAddress(rsServer) THEN RETURN rsServer"" + NL" + NL
    t = t + "    t = t + ""    IF rsServerAddr <> """""""" AND rsServerFor = rsServer AND SYS.Ticks - rsServerAt < 60000 AND SYS.Ticks >= rsServerAt THEN RETURN rsServerAddr"" + NL" + NL
    t = t + "    t = t + ""    rsLooking = TRUE"" + NL" + NL
    t = t + "    t = t + ""    rsLookingAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    addr = NET.Resolve(rsServer)"" + NL" + NL
    t = t + "    t = t + ""    IF NOT rsLooking THEN RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""    rsLooking = FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF addr = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        RsGiveUp(""""there is no machine called """" + rsServer)"" + NL" + NL
    t = t + "    t = t + ""        RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    rsServerAddr = addr"" + NL" + NL
    t = t + "    t = t + ""    rsServerFor = rsServer"" + NL" + NL
    t = t + "    t = t + ""    rsServerAt = SYS.Ticks"" + NL" + NL
    t = t + "    t = t + ""    RETURN addr"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsBusy () AS Bool"" + NL" + NL
    t = t + "    t = t + ""    IF rsAsking = """""""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF rsRefused THEN"" + NL" + NL
    t = t + "    t = t + ""        RsGiveUp(""""the name server """" + rsServer + """" refused"""")"" + NL" + NL
    t = t + "    t = t + ""        RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF SYS.Ticks - rsAskAt > RSWAIT THEN"" + NL" + NL
    t = t + "    t = t + ""        RsGiveUp(""""no answer from the name server """" + rsServer)"" + NL" + NL
    t = t + "    t = t + ""        RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Rs_OnMessage (conn AS NET_Connection, message AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR h AS String"" + NL" + NL
    t = t + "    t = t + ""    IF NOT conn.Tag.StartsWith(""""rs:"""") THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    h = conn.Tag.Substring(3, conn.Tag.Length - 3)"" + NL" + NL
    t = t + "    t = t + ""    conn.Tag = """""""""" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        conn.Close()"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""    RsTake(h, message)"" + NL" + NL
    t = t + "    t = t + ""    IF h = rsAsking THEN rsAsking = """""""""" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Learns an answer: follows its CNAMEs to an address, or to the machine"" + NL" + NL
    t = t + "    t = t + ""' name the chain ends at."" + NL" + NL
    t = t + "    t = t + ""SUB RsTake (host AS String, reply AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR lines AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR w AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR cur AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR onward AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR target AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR canon AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR ttl AS Integer = 3600"" + NL" + NL
    t = t + "    t = t + ""    VAR hops AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    rsLastReply = reply"" + NL" + NL
    t = t + "    t = t + ""    IF host.StartsWith(""""mx:"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        RsTakeMx(host, reply)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    lines = reply.Lines()"" + NL" + NL
    t = t + "    t = t + ""    IF lines.Count = 0 THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    IF lines[0].StartsWith(""""NXDOMAIN"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(host, """""""", """"NXDOMAIN"""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF NOT lines[0].StartsWith(""""OK"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        rsWhy = lines[0]"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(host, """""""", """""""", 10000)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    cur = RsFull(host)"" + NL" + NL
    t = t + "    t = t + ""    canon = cur"" + NL" + NL
    t = t + "    t = t + ""    FOR hops = 0 TO 8"" + NL" + NL
    t = t + "    t = t + ""        onward = """""""""" + NL" + NL
    t = t + "    t = t + ""        FOR i = 1 TO lines.Count - 1"" + NL" + NL
    t = t + "    t = t + ""            w = lines[i].Split("""" """")"" + NL" + NL
    t = t + "    t = t + ""            IF w.Count >= 4 THEN"" + NL" + NL
    t = t + "    t = t + ""                IF w[0] = cur AND w[2] = """"A"""" AND target = """""""" THEN target = w[3]"" + NL" + NL
    t = t + "    t = t + ""                IF w[0] = cur AND w[2] = """"CNAME"""" THEN onward = w[3]"" + NL" + NL
    t = t + "    t = t + ""                IF w[0] = cur AND (w[2] = """"A"""" OR w[2] = """"CNAME"""") AND Int(Val(w[1])) < ttl THEN ttl = Int(Val(w[1]))"" + NL" + NL
    t = t + "    t = t + ""            END IF"" + NL" + NL
    t = t + "    t = t + ""        NEXT"" + NL" + NL
    t = t + "    t = t + ""        IF target <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""            canon = cur"" + NL" + NL
    t = t + "    t = t + ""            BREAK"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        IF onward = """""""" THEN BREAK"" + NL" + NL
    t = t + "    t = t + ""        canon = cur"" + NL" + NL
    t = t + "    t = t + ""        cur = onward"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    IF target = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        ' a name with no CNAME and no address: not one to connect to"" + NL" + NL
    t = t + "    t = t + ""        IF cur = RsFull(host) THEN"" + NL" + NL
    t = t + "    t = t + ""            RsKeep(host, """""""", """""""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""            RETURN"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        ' the end of the chain: a SIM95 machine name"" + NL" + NL
    t = t + "    t = t + ""        target = cur"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF ttl < 5 THEN ttl = 5"" + NL" + NL
    t = t + "    t = t + ""    RsKeep(host, target, canon, ttl * 1000)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Learns an MX answer: the mail machine with the lowest preference. With no"" + NL" + NL
    t = t + "    t = t + ""' MX, the server answers with the domain's CNAMEs instead, and the domain's"" + NL" + NL
    t = t + "    t = t + ""' own machine takes the mail."" + NL" + NL
    t = t + "    t = t + ""SUB RsTakeMx (key AS String, reply AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR domain AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR lines AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR w AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR best AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR pref AS Integer = 1000000"" + NL" + NL
    t = t + "    t = t + ""    VAR ttl AS Integer = 3600"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    domain = key.Substring(3, key.Length - 3)"" + NL" + NL
    t = t + "    t = t + ""    lines = reply.Lines()"" + NL" + NL
    t = t + "    t = t + ""    IF lines.Count = 0 THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    IF lines[0].StartsWith(""""NXDOMAIN"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, """""""", """"NXDOMAIN"""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(domain, """""""", """"NXDOMAIN"""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF NOT lines[0].StartsWith(""""OK"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        rsWhy = lines[0]"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, """""""", """""""", 10000)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 1 TO lines.Count - 1"" + NL" + NL
    t = t + "    t = t + ""        w = lines[i].Split("""" """")"" + NL" + NL
    t = t + "    t = t + ""        IF w.Count >= 5 THEN"" + NL" + NL
    t = t + "    t = t + ""            IF w[2] = """"MX"""" AND Int(Val(w[3])) < pref THEN"" + NL" + NL
    t = t + "    t = t + ""                pref = Int(Val(w[3]))"" + NL" + NL
    t = t + "    t = t + ""                best = w[4]"" + NL" + NL
    t = t + "    t = t + ""                ttl = Int(Val(w[1]))"" + NL" + NL
    t = t + "    t = t + ""            END IF"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    IF best <> """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""        IF best.EndsWith(""""."""") THEN best = best.Substring(0, best.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""        IF ttl < 5 THEN ttl = 5"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, best, RsFull(domain), ttl * 1000)"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    RsTake(domain, reply)"" + NL" + NL
    t = t + "    t = t + ""    IF RsKnown(domain) THEN"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, domain, RsFull(domain), RSNEG)"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        RsKeep(key, """""""", """""""", RSNEG)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The machine (or name) that takes domain's mail: its MX, or domain itself."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsMailHost (domain AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(""""mx:"""" + domain.Trim().Lower())"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN domain"" + NL" + NL
    t = t + "    t = t + ""    IF rsTo[i] = """""""" THEN RETURN domain"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsTo[i]"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Where to connect for domain's mail."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsMailTarget (domain AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsTarget(RsMailHost(domain))"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Did SimDNS say where domain's mail goes (an MX, or the domain's machine)?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsMailKnown (domain AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(""""mx:"""" + domain.Trim().Lower())"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    IF rsTo[i] = """""""" THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN RsKnown(RsMailHost(domain)) OR NOT RsAsks(RsMailHost(domain))"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB RsKeep (host AS String, target AS String, canon AS String, ms AS Integer)"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR h AS String"" + NL" + NL
    t = t + "    t = t + ""    h = host.Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""    i = rsName.IndexOf(h)"" + NL" + NL
    t = t + "    t = t + ""    IF i >= 0 THEN"" + NL" + NL
    t = t + "    t = t + ""        rsName.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsTo.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsCanon.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""        rsUntil.RemoveAt(i)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF rsName.Count >= RSMOST THEN"" + NL" + NL
    t = t + "    t = t + ""        rsName.RemoveAt(0)"" + NL" + NL
    t = t + "    t = t + ""        rsTo.RemoveAt(0)"" + NL" + NL
    t = t + "    t = t + ""        rsCanon.RemoveAt(0)"" + NL" + NL
    t = t + "    t = t + ""        rsUntil.RemoveAt(0)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    rsName.Add(h)"" + NL" + NL
    t = t + "    t = t + ""    rsTo.Add(target)"" + NL" + NL
    t = t + "    t = t + ""    rsCanon.Add(canon)"" + NL" + NL
    Put("C:\WEB\VAPOR\SIMWEB\10.TXT")
END SUB

SUB File22 ()
    t = ""
    t = t + "    t = t + ""    rsUntil.Add(SYS.Ticks + ms)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Where to connect for host: what SimDNS said, or host itself."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsTarget (host AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(host)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN host"" + NL" + NL
    t = t + "    t = t + ""    IF rsTo[i] = """""""" THEN RETURN host"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsTo[i]"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The name host's machine was found under (www.coolsite.sim), or host."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsCanonical (host AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(host)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN host"" + NL" + NL
    t = t + "    t = t + ""    IF rsTo[i] = """""""" THEN RETURN host"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsCanon[i]"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Did SimDNS answer for host (so RsTarget is its machine)?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsKnown (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(host)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsTo[i] <> """""""""" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Did the name server say there is no such name (NXDOMAIN)?"" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsNoSuchName (host AS String) AS Bool"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    i = RsFind(host)"" + NL" + NL
    t = t + "    t = t + ""    IF i < 0 THEN RETURN FALSE"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsTo[i] = """""""" AND rsCanon[i] = """"NXDOMAIN"""""" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Is the name server being left alone, because it didn't answer (or there"" + NL" + NL
    t = t + "    t = t + ""' is none)? rsWhy says why."" + NL" + NL
    t = t + "    t = t + ""FUNCTION RsSilent () AS Bool"" + NL" + NL
    t = t + "    t = t + ""    RsConfig()"" + NL" + NL
    t = t + "    t = t + ""    IF rsServer = """""""" THEN RETURN TRUE"" + NL" + NL
    t = t + "    t = t + ""    RETURN rsDown AND SYS.Ticks - rsDownAt < RSQUIET"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    Put(""C:\PROGRAMS\RESOLVE.SPK"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB File3 ()" + NL
    t = t + "    t = """"" + NL
    t = t + "    t = t + ""' HTTPD.SPK - the web server. Serves C:\WEB on port 80."" + NL" + NL
    t = t + "    t = t + ""' This is the program Voyager talks to when someone opens http://YOURNAME/."" + NL" + NL
    t = t + "    t = t + ""' Edit it, save, and run it again: the web server is now yours."" + NL" + NL
    t = t + "    t = t + ""' Files ending in .ASP are ActiveSparkPages: SPARK runs on this machine"" + NL" + NL
    t = t + "    t = t + ""' and the result is sent. See section 12 of C:\DOCS\SPARK.TXT."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' simweb edition: the stock web server, plus virtual hosts. One machine can"" + NL" + NL
    t = t + "    t = t + ""' serve several sites, each from a folder of its own, listed in"" + NL" + NL
    t = t + "    t = t + ""' C:\WEB\VHOSTS.TXT, one a line:"" + NL" + NL
    t = t + "    t = t + ""'     www.coolsite.sim|C:\WEB\SITES\COOLSITE"" + NL" + NL
    t = t + "    t = t + ""'     *.dab.sim|C:\WEB\SITES\DAB          (any name ending in .dab.sim)"" + NL" + NL
    t = t + "    t = t + ""' A site is reached two ways:"" + NL" + NL
    t = t + "    t = t + ""'   * By its name (Simxplorer, with a SimDNS name server): the Host header"" + NL" + NL
    t = t + "    t = t + ""'     says www.coolsite.sim, and /page.htm is that folder's PAGE.HTM."" + NL" + NL
    t = t + "    t = t + ""'   * By path (Voyager, or anyone without SimDNS): http://alpha/www.coolsite.sim/page.htm"" + NL" + NL
    t = t + "    t = t + ""'     is the same file. /www.coolsite.sim on its own gets a slash added."" + NL" + NL
    t = t + "    t = t + ""' Anything else - this machine's own name, an address, a name not listed -"" + NL" + NL
    t = t + "    t = t + ""' is C:\WEB, exactly as before."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' Server pages in a site run as usual (SERVER.ScriptName is the file on disk,"" + NL" + NL
    t = t + "    t = t + ""' and imports are next to it). REQUEST.Path is the path inside the site, so"" + NL" + NL
    t = t + "    t = t + ""' relative links work both ways. REQUEST.Host is what the browser asked for:"" + NL" + NL
    t = t + "    t = t + ""' www.coolsite.sim by name, alpha by path. Two headers say the rest:"" + NL" + NL
    t = t + "    t = t + ""'     X-Site: www.coolsite.sim       the site being served"" + NL" + NL
    t = t + "    t = t + ""'     X-Base-Path: /www.coolsite.sim/   where the site starts on this server"" + NL" + NL
    t = t + "    t = t + ""'                                       (""""/"""" when reached by name)"" + NL" + NL
    t = t + "    t = t + ""' so a page's own address is """"http://"""" + REQUEST.Host + X-Base-Path + page."" + NL" + NL
    t = t + "    t = t + ""' A RESPONSE.Redirect to """"/x.asp"""" is put back inside the site by path. Links"" + NL" + NL
    t = t + "    t = t + ""' that start with / can't be: in a site, use relative links."" + NL" + NL
    t = t + "    t = t + ""'"" + NL" + NL
    t = t + "    t = t + ""' The stock web server is kept as C:\PROGRAMS\HTTPD.ORG. When simweb is"" + NL" + NL
    t = t + "    t = t + ""' uninstalled (C:\PROGRAMS\PWM.SPK, Personal Web Manager, is gone), this one"" + NL" + NL
    t = t + "    t = t + ""' puts it back."" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""CONST VHOSTS = """"C:\WEB\VHOSTS.TXT"""""" + NL" + NL
    t = t + "    t = t + ""CONST ME = """"C:\PROGRAMS\HTTPD.SPK"""""" + NL" + NL
    t = t + "    t = t + ""CONST ORIGINAL = """"C:\PROGRAMS\HTTPD.ORG"""""" + NL" + NL
    t = t + "    t = t + ""CONST SIMWEB = """"C:\PROGRAMS\PWM.SPK"""""" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""VAR win AS GUI_Window"" + NL" + NL
    t = t + "    t = t + ""VAR log AS GUI_ListBox"" + NL" + NL
    t = t + "    t = t + ""VAR sock AS NET_Socket"" + NL" + NL
    t = t + "    t = t + ""VAR timer AS GUI_Timer"" + NL" + NL
    t = t + "    t = t + ""VAR hits AS Integer"" + NL" + NL
    t = t + "    t = t + ""VAR NL AS String"" + NL" + NL
    t = t + "    t = t + ""VAR vText AS String = """"?""""       ' VHOSTS.TXT as last read"" + NL" + NL
    t = t + "    t = t + ""VAR vName AS Array OF String    ' www.coolsite.sim, or *.dab.sim"" + NL" + NL
    t = t + "    t = t + ""VAR vDir AS Array OF String"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Main ()"" + NL" + NL
    t = t + "    t = t + ""    NL = Chr(10)"" + NL" + NL
    t = t + "    t = t + ""    win = GUI_Window.New(""""Web Server"""", 420, 240)"" + NL" + NL
    t = t + "    t = t + ""    win.Icon = """"network"""""" + NL" + NL
    t = t + "    t = t + ""    win.onClose = Win_OnClose"" + NL" + NL
    t = t + "    t = t + ""    win.onResize = Win_OnResize"" + NL" + NL
    t = t + "    t = t + ""    log = GUI_ListBox.New(win)"" + NL" + NL
    t = t + "    t = t + ""    log.Mono = TRUE"" + NL" + NL
    t = t + "    t = t + ""    Win_OnResize()"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""    sock = NET_Socket.New()"" + NL" + NL
    t = t + "    t = t + ""    sock.onConnect = Sock_OnConnect"" + NL" + NL
    t = t + "    t = t + ""    sock.onMessage = Sock_OnMessage"" + NL" + NL
    t = t + "    t = t + ""    sock.onError = Sock_OnError"" + NL" + NL
    t = t + "    t = t + ""    sock.Listen(80)"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""    ' The address arrives from the network server a moment after we start, so keep the"" + NL" + NL
    t = t + "    t = t + ""    ' status line honest with a slow timer instead of showing 0.0.0.0 forever."" + NL" + NL
    t = t + "    t = t + ""    timer = GUI_Timer.New(win)"" + NL" + NL
    t = t + "    t = t + ""    timer.Interval = 1000"" + NL" + NL
    t = t + "    t = t + ""    timer.onTick = Timer_OnTick"" + NL" + NL
    t = t + "    t = t + ""    timer.Start()"" + NL" + NL
    t = t + "    t = t + ""    Timer_OnTick()"" + NL" + NL
    t = t + "    t = t + ""    win.Show()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Timer_OnTick ()"" + NL" + NL
    t = t + "    t = t + ""    VAR sites AS String"" + NL" + NL
    t = t + "    t = t + ""    ' simweb uninstalled (by Vapor, say): the stock web server comes back"" + NL" + NL
    t = t + "    t = t + ""    IF FS.Exists(ORIGINAL) AND NOT FS.Exists(SIMWEB) THEN"" + NL" + NL
    t = t + "    t = t + ""        PutBack()"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    ReadHosts()"" + NL" + NL
    t = t + "    t = t + ""    IF vName.Count > 0 THEN sites = """" - """" + Str(vName.Count) + """" sites"""""" + NL" + NL
    t = t + "    t = t + ""    IF NET.Online THEN"" + NL" + NL
    t = t + "    t = t + ""        win.Status = """"Listening on """" + NET.LocalAddress + """" port 80 - try http://"""" + NET.HostName.Lower() + """"/"""" + sites"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        win.Status = """"Listening on port 80 - waiting for the network"""""" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB PutBack ()"" + NL" + NL
    t = t + "    t = t + ""    log.Add(""""simweb is gone: the stock web server takes over again"""")"" + NL" + NL
    t = t + "    t = t + ""    timer.Stop()"" + NL" + NL
    t = t + "    t = t + ""    sock.Close()"" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        FS.Delete(ME)"" + NL" + NL
    t = t + "    t = t + ""        FS.Rename(ORIGINAL, ME)"" + NL" + NL
    t = t + "    t = t + ""        SYS.Run(ME)"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""        log.Add(""""ERROR """" + err)"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""    SYS.Exit(0)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Win_OnResize ()"" + NL" + NL
    t = t + "    t = t + ""    log.SetBounds(0, 0, win.Width, win.Height)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Sock_OnConnect (conn AS NET_Connection)"" + NL" + NL
    t = t + "    t = t + ""    conn.Accept()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Sock_OnMessage (conn AS NET_Connection, message AS String)"" + NL" + NL
    t = t + "    t = t + ""    VAR lines AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR parts AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR path AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR query AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR file AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR host AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR site AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR root AS String = """"C:\WEB"""""" + NL" + NL
    t = t + "    t = t + ""    VAR base AS String = """"/"""""" + NL" + NL
    t = t + "    t = t + ""    VAR seg AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR v AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR shown AS String"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""    lines = message.Lines()"" + NL" + NL
    t = t + "    t = t + ""    parts = lines[0].Split("""" """")"" + NL" + NL
    t = t + "    t = t + ""    IF parts.Count < 2 OR (parts[0] <> """"GET"""" AND parts[0] <> """"POST"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        SendError(conn, """"400 Bad Request"""", """"Voyager sends GET or POST. This was neither."""")"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""    path = parts[1]"" + NL" + NL
    t = t + "    t = t + ""    IF path.IndexOf(""""?"""") >= 0 THEN"" + NL" + NL
    t = t + "    t = t + ""        query = path.Substring(path.IndexOf(""""?""""), path.Length - path.IndexOf(""""?""""))"" + NL" + NL
    t = t + "    t = t + ""        path = path.Substring(0, path.IndexOf(""""?""""))"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""    ' Which site? First by the name the browser asked for, then by the first"" + NL" + NL
    t = t + "    t = t + ""    ' part of the path."" + NL" + NL
    t = t + "    t = t + ""    ReadHosts()"" + NL" + NL
    t = t + "    t = t + ""    host = HostHeader(lines)"" + NL" + NL
    t = t + "    t = t + ""    v = SiteIndex(host)"" + NL" + NL
    t = t + "    t = t + ""    IF v >= 0 THEN"" + NL" + NL
    t = t + "    t = t + ""        site = host"" + NL" + NL
    t = t + "    t = t + ""    ELSEIF path.Length > 1 THEN"" + NL" + NL
    t = t + "    t = t + ""        seg = path.Substring(1, path.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""        IF seg.Contains(""""/"""") THEN seg = seg.Substring(0, seg.IndexOf(""""/""""))"" + NL" + NL
    t = t + "    t = t + ""        IF seg.Contains(""""."""") THEN v = SiteIndex(seg.Lower())"" + NL" + NL
    t = t + "    t = t + ""        IF v >= 0 THEN"" + NL" + NL
    t = t + "    t = t + ""            site = seg.Lower()"" + NL" + NL
    t = t + "    t = t + ""            ' /www.coolsite.sim is a folder: say so, so relative links work"" + NL" + NL
    t = t + "    t = t + ""            IF path.Length = seg.Length + 1 THEN"" + NL" + NL
    t = t + "    t = t + ""                Redirect(conn, path + """"/"""" + query)"" + NL" + NL
    t = t + "    t = t + ""                RETURN"" + NL" + NL
    t = t + "    t = t + ""            END IF"" + NL" + NL
    t = t + "    t = t + ""            base = """"/"""" + seg + """"/"""""" + NL" + NL
    t = t + "    t = t + ""            path = path.Substring(seg.Length + 1, path.Length - seg.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    IF v >= 0 THEN root = vDir[v]"" + NL" + NL
    t = t + "    t = t + ""    file = PathToFile(path, root)"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""    hits = hits + 1"" + NL" + NL
    t = t + "    t = t + ""    win.Title = """"Web Server ("""" + Str(hits) + """" hits)"""""" + NL" + NL
    t = t + "    t = t + ""    shown = path"" + NL" + NL
    t = t + "    t = t + ""    IF site <> """""""" THEN shown = site + path"" + NL" + NL
    t = t + "    t = t + ""    log.Add(TIME.Clock + """"  """" + conn.FromAddress + """"  """" + parts[0] + """" """" + shown)"" + NL" + NL
    t = t + "    t = t + ""    IF log.Count > 500 THEN log.RemoveAt(0)"" + NL" + NL
    t = t + "    t = t + ""    log.ScrollToEnd()"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""    ' A directory with no INDEX.HTM may have an INDEX.ASP instead"" + NL" + NL
    t = t + "    t = t + ""    IF file.EndsWith(""""\INDEX.HTM"""") AND NOT FS.Exists(file) THEN file = file.Replace(""""\INDEX.HTM"""", """"\INDEX.ASP"""")"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""    IF file = """""""" OR NOT FS.Exists(file) OR FS.IsDir(file) THEN"" + NL" + NL
    t = t + "    t = t + ""        SendError(conn, """"404 Not Found"""", """"There is no """" + shown + """" on this server."""")"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""    ' ActiveSparkPages: a .ASP file is run, not sent. ASP.Render returns the whole response,"" + NL" + NL
    t = t + "    t = t + ""    ' and the page sees a POSTed form through REQUEST.Form. A page in a site"" + NL" + NL
    t = t + "    t = t + ""    ' sees the path inside the site, and X-Site and X-Base-Path."" + NL" + NL
    t = t + "    t = t + ""    IF file.EndsWith("""".ASP"""") THEN"" + NL" + NL
    t = t + "    t = t + ""        IF site = """""""" THEN"" + NL" + NL
    t = t + "    t = t + ""            conn.Send(ASP.Render(file, message, conn.FromAddress))"" + NL" + NL
    t = t + "    t = t + ""        ELSE"" + NL" + NL
    t = t + "    t = t + ""            conn.Send(InSite(ASP.Render(file, ForSite(message, path + query, site, base), conn.FromAddress), base))"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        conn.Close()"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""    ' Only a page can take a POST; a plain file has nothing to do with one"" + NL" + NL
    t = t + "    t = t + ""    IF parts[0] = """"POST"""" THEN"" + NL" + NL
    t = t + "    t = t + ""        SendError(conn, """"405 Method Not Allowed"""", path + """" is a file, not a page. Only .ASP pages accept a POST."""")"" + NL" + NL
    t = t + "    t = t + ""        RETURN"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""    conn.Send(""""HTTP/1.0 200 OK"""")"" + NL" + NL
    t = t + "    t = t + ""    conn.Send(""""Server: HTTPD.SPK/1.1 (SIM95; simweb)"""")"" + NL" + NL
    t = t + "    t = t + ""    conn.Send(""""Content-Type: """" + ContentType(file))"" + NL" + NL
    t = t + "    t = t + ""    conn.Send("""""""")"" + NL" + NL
    t = t + "    t = t + ""    conn.Send(FS.Read(file))"" + NL" + NL
    t = t + "    t = t + ""    conn.Close()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' ---------------------------------------------------------------- sites"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' Reads VHOSTS.TXT when it has changed. Folders must be in C:\WEB, so a site"" + NL" + NL
    t = t + "    t = t + ""' can't hand out C:\SYSTEM."" + NL" + NL
    t = t + "    t = t + ""SUB ReadHosts ()"" + NL" + NL
    t = t + "    t = t + ""    VAR text AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR line AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR name AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR dir AS String"" + NL" + NL
    t = t + "    t = t + ""    text = """""""""" + NL" + NL
    t = t + "    t = t + ""    TRY"" + NL" + NL
    t = t + "    t = t + ""        IF FS.Exists(VHOSTS) THEN text = FS.Read(VHOSTS)"" + NL" + NL
    t = t + "    t = t + ""    CATCH err"" + NL" + NL
    t = t + "    t = t + ""    END TRY"" + NL" + NL
    t = t + "    t = t + ""    IF text = vText THEN RETURN"" + NL" + NL
    t = t + "    t = t + ""    vText = text"" + NL" + NL
    t = t + "    t = t + ""    vName.Clear()"" + NL" + NL
    t = t + "    t = t + ""    vDir.Clear()"" + NL" + NL
    t = t + "    t = t + ""    FOR EACH line IN text.Lines()"" + NL" + NL
    t = t + "    t = t + ""        line = line.Trim()"" + NL" + NL
    t = t + "    t = t + ""        IF line = """""""" OR line.StartsWith("""";"""") OR line.StartsWith(""""'"""") OR line.StartsWith(""""#"""") OR NOT line.Contains(""""|"""") THEN CONTINUE"" + NL" + NL
    t = t + "    t = t + ""        name = line.Substring(0, line.IndexOf(""""|"""")).Trim().Lower()"" + NL" + NL
    Put("C:\WEB\VAPOR\SIMWEB\11.TXT")
END SUB

SUB File23 ()
    t = ""
    t = t + "    t = t + ""        dir = line.Substring(line.IndexOf(""""|"""") + 1, line.Length - line.IndexOf(""""|"""") - 1).Trim().Upper()"" + NL" + NL
    t = t + "    t = t + ""        IF dir.EndsWith(""""\"""") THEN dir = dir.Substring(0, dir.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""        IF name.EndsWith(""""."""") THEN name = name.Substring(0, name.Length - 1)"" + NL" + NL
    t = t + "    t = t + ""        IF name = """""""" OR NOT name.Contains(""""."""") OR dir.Contains("""".."""") THEN CONTINUE"" + NL" + NL
    t = t + "    t = t + ""        IF dir <> """"C:\WEB"""" AND NOT dir.StartsWith(""""C:\WEB\"""") THEN"" + NL" + NL
    t = t + "    t = t + ""            log.Add(""""VHOSTS.TXT: """" + name + """" is not in C:\WEB, so it is left out"""")"" + NL" + NL
    t = t + "    t = t + ""            CONTINUE"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""        vName.Add(name)"" + NL" + NL
    t = t + "    t = t + ""        vDir.Add(dir)"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The site called name (exactly, else by a *. pattern), or -1."" + NL" + NL
    t = t + "    t = t + ""FUNCTION SiteIndex (name AS String) AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    IF name = """""""" THEN RETURN -1"" + NL" + NL
    t = t + "    t = t + ""    i = vName.IndexOf(name)"" + NL" + NL
    t = t + "    t = t + ""    IF i >= 0 THEN RETURN i"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 0 TO vName.Count - 1"" + NL" + NL
    t = t + "    t = t + ""        IF vName[i].StartsWith(""""*."""") THEN"" + NL" + NL
    t = t + "    t = t + ""            IF name.EndsWith(vName[i].Substring(1, vName[i].Length - 1)) THEN RETURN i"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    RETURN -1"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The Host header, lower case, without a port."" + NL" + NL
    t = t + "    t = t + ""FUNCTION HostHeader (lines AS Array OF String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR h AS String"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 1 TO lines.Count - 1"" + NL" + NL
    t = t + "    t = t + ""        IF lines[i].Trim() = """""""" THEN RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""        IF lines[i].Lower().StartsWith(""""host:"""") THEN"" + NL" + NL
    t = t + "    t = t + ""            h = lines[i].Substring(5, lines[i].Length - 5).Trim().Lower()"" + NL" + NL
    t = t + "    t = t + ""            IF h.Contains("""":"""") THEN h = h.Substring(0, h.IndexOf("""":""""))"" + NL" + NL
    t = t + "    t = t + ""            RETURN h"" + NL" + NL
    t = t + "    t = t + ""        END IF"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' The request as a page in a site sees it: the path inside the site, and"" + NL" + NL
    t = t + "    t = t + ""' X-Site and X-Base-Path (any the browser sent are dropped). The body is"" + NL" + NL
    t = t + "    t = t + ""' left exactly as it came."" + NL" + NL
    t = t + "    t = t + ""FUNCTION ForSite (message AS String, inside AS String, site AS String, base AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR head AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR tail AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR cut AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR out AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR first AS Array OF String"" + NL" + NL
    t = t + "    t = t + ""    VAR i AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR line AS String"" + NL" + NL
    t = t + "    t = t + ""    cut = message.IndexOf(NL + NL)"" + NL" + NL
    t = t + "    t = t + ""    IF cut < 0 THEN"" + NL" + NL
    t = t + "    t = t + ""        head = message"" + NL" + NL
    t = t + "    t = t + ""    ELSE"" + NL" + NL
    t = t + "    t = t + ""        head = message.Substring(0, cut)"" + NL" + NL
    t = t + "    t = t + ""        tail = message.Substring(cut, message.Length - cut)"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    first = head.Lines()[0].Split("""" """")"" + NL" + NL
    t = t + "    t = t + ""    out = first[0] + """" """" + inside"" + NL" + NL
    t = t + "    t = t + ""    FOR i = 2 TO first.Count - 1"" + NL" + NL
    t = t + "    t = t + ""        out = out + """" """" + first[i]"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    i = 0"" + NL" + NL
    t = t + "    t = t + ""    FOR EACH line IN head.Lines()"" + NL" + NL
    t = t + "    t = t + ""        i = i + 1"" + NL" + NL
    t = t + "    t = t + ""        IF i = 1 OR line.Trim() = """""""" THEN CONTINUE"" + NL" + NL
    t = t + "    t = t + ""        IF line.Lower().StartsWith(""""x-site:"""") OR line.Lower().StartsWith(""""x-base-path:"""") THEN CONTINUE"" + NL" + NL
    t = t + "    t = t + ""        out = out + NL + line"" + NL" + NL
    t = t + "    t = t + ""    NEXT"" + NL" + NL
    t = t + "    t = t + ""    RETURN out + NL + """"X-Site: """" + site + NL + """"X-Base-Path: """" + base + tail"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' A page's answer, with a Location of """"/..."""" put back inside the site."" + NL" + NL
    t = t + "    t = t + ""FUNCTION InSite (response AS String, base AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR cut AS Integer"" + NL" + NL
    t = t + "    t = t + ""    VAR head AS String"" + NL" + NL
    t = t + "    t = t + ""    IF base = """"/"""" THEN RETURN response"" + NL" + NL
    t = t + "    t = t + ""    cut = response.IndexOf(NL + NL)"" + NL" + NL
    t = t + "    t = t + ""    IF cut < 0 THEN cut = response.Length"" + NL" + NL
    t = t + "    t = t + ""    head = response.Substring(0, cut)"" + NL" + NL
    t = t + "    t = t + ""    IF NOT head.Contains(NL + """"Location: /"""") THEN RETURN response"" + NL" + NL
    t = t + "    t = t + ""    IF head.Contains(NL + """"Location: //"""") THEN RETURN response"" + NL" + NL
    t = t + "    t = t + ""    RETURN head.Replace(NL + """"Location: /"""", NL + """"Location: """" + base) + response.Substring(cut, response.Length - cut)"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Redirect (conn AS NET_Connection, there AS String)"" + NL" + NL
    t = t + "    t = t + ""    conn.Send(""""HTTP/1.0 302 Found"""")"" + NL" + NL
    t = t + "    t = t + ""    conn.Send(""""Location: """" + there)"" + NL" + NL
    t = t + "    t = t + ""    conn.Send(""""Content-Type: text/html"""")"" + NL" + NL
    t = t + "    t = t + ""    conn.Send("""""""")"" + NL" + NL
    t = t + "    t = t + ""    conn.Send(""""<html><body><p>This site is at <a href="""""""""""" + there + """""""""""">"""" + there + """"</a>.</p></body></html>"""")"" + NL" + NL
    t = t + "    t = t + ""    conn.Close()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION PathToFile (path AS String, root AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    VAR p AS String"" + NL" + NL
    t = t + "    t = t + ""    p = path.Replace(""""/"""", """"\"""").Upper()"" + NL" + NL
    t = t + "    t = t + ""    IF p.Contains("""".."""") THEN RETURN """""""""" + NL" + NL
    t = t + "    t = t + ""    IF p.EndsWith(""""\"""") THEN p = p + """"INDEX.HTM"""""" + NL" + NL
    t = t + "    t = t + ""    IF p = """""""" THEN p = """"\INDEX.HTM"""""" + NL" + NL
    t = t + "    t = t + ""    RETURN root + p"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION ContentType (file AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    IF file.EndsWith("""".HTM"""") THEN RETURN """"text/html"""""" + NL" + NL
    t = t + "    t = t + ""    IF file.EndsWith("""".PIC"""") THEN RETURN """"image/x-sim95pic"""""" + NL" + NL
    t = t + "    t = t + ""    RETURN """"text/plain"""""" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB SendError (conn AS NET_Connection, status AS String, text AS String)"" + NL" + NL
    t = t + "    t = t + ""    conn.Send(""""HTTP/1.0 """" + status)"" + NL" + NL
    t = t + "    t = t + ""    conn.Send(""""Content-Type: text/html"""")"" + NL" + NL
    t = t + "    t = t + ""    conn.Send("""""""")"" + NL" + NL
    t = t + "    t = t + ""    conn.Send(""""<html><head><title>"""" + status + """"</title></head><body><h1>"""" + status + """"</h1><p>"""" + text + """"</p><hr><i>HTTPD.SPK on """" + NET.HostName + """"</i></body></html>"""")"" + NL" + NL
    t = t + "    t = t + ""    conn.Close()"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Sock_OnError (message AS String)"" + NL" + NL
    t = t + "    t = t + ""    win.Status = """"Error: """" + message"" + NL" + NL
    t = t + "    t = t + ""    log.Add(""""ERROR """" + message)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""SUB Win_OnClose ()"" + NL" + NL
    t = t + "    t = t + ""    sock.Close()"" + NL" + NL
    t = t + "    t = t + ""    SYS.Exit(0)"" + NL" + NL
    t = t + "    t = t + ""END SUB"" + NL" + NL
    t = t + "    Put(""C:\PROGRAMS\HTTPD.SPK"")" + NL
    t = t + "END SUB" + NL
    t = t + "' simweb's setup, run by its installer: before the files are written, the" + NL
    t = t + "' folders, the list of sites and the stock web server's backup; after them," + NL
    t = t + "' the web server restarted so the new one (with sites by name) takes over." + NL
    t = t + "" + NL
    t = t + "CONST STOCKHTTPD = ""C:\PROGRAMS\HTTPD.ORG""" + NL
    t = t + "" + NL
    t = t + "SUB WebSetup ()" + NL
    t = t + "    VAR old AS String" + NL
    t = t + "    IF NOT FS.Exists(""C:\WEB\SITES"") THEN FS.MakeDir(""C:\WEB\SITES"")" + NL
    t = t + "    IF NOT FS.Exists(""C:\WEB\VHOSTS.TXT"") THEN" + NL
    t = t + "        FS.Write(""C:\WEB\VHOSTS.TXT"", ""; VHOSTS.TXT - sites the web server serves by name, one a line: name|folder"" + NL _" + NL
    t = t + "            + ""; (folders in C:\WEB). Personal Web Manager (C:\PROGRAMS\PWM.SPK) keeps it;"" + NL _" + NL
    t = t + "            + ""; you may edit it by hand too. For example:"" + NL _" + NL
    t = t + "            + "";   www.coolsite.sim|C:\WEB\SITES\COOLSITE"" + NL _" + NL
    t = t + "            + "";   coolbook.sim|C:\WEB\BOOK"" + NL _" + NL
    t = t + "            + "";   *.dab.sim|C:\WEB\SITES\DAB"" + NL)" + NL
    t = t + "        Print(""  wrote C:\WEB\VHOSTS.TXT"")" + NL
    t = t + "    END IF" + NL
    t = t + "    ' the stock web server is kept, once, so uninstalling can put it back" + NL
    t = t + "    ' (SimDNS, which came before simweb, kept it the same way)" + NL
    t = t + "    IF FS.Exists(""C:\PROGRAMS\HTTPD.SPK"") AND NOT FS.Exists(STOCKHTTPD) THEN" + NL
    t = t + "        old = FS.Read(""C:\PROGRAMS\HTTPD.SPK"")" + NL
    t = t + "        IF NOT old.Contains(""simweb edition"") AND NOT old.Contains(""SimDNS edition"") THEN" + NL
    t = t + "            FS.Write(STOCKHTTPD, old)" + NL
    t = t + "            Print(""  kept the old web server as "" + STOCKHTTPD)" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Stops the running web server and starts the new one. If the web server is" + NL
    t = t + "' off (Settings), it stays off: the new one starts when it is turned on." + NL
    t = t + "SUB RestartWeb ()" + NL
    t = t + "    VAR task AS String" + NL
    t = t + "    VAR was AS Bool" + NL
    t = t + "    FOR EACH task IN SYS.Tasks()" + NL
    t = t + "        IF task.Split(""|"")[1].Upper() = ""HTTPD"" THEN" + NL
    t = t + "            SYS.Kill(Int(Val(task.Split(""|"")[0])))" + NL
    t = t + "            was = TRUE" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF was THEN" + NL
    t = t + "        SYS.Run(""C:\PROGRAMS\HTTPD.SPK"")" + NL
    t = t + "        Print(""  restarted the web server: it serves the sites in C:\WEB\VHOSTS.TXT by name"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        Print(""  the web server is off (Settings); the new one starts when it is turned on"")" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    Put("C:\WEB\VAPOR\SIMWEB\12.TXT")
END SUB

SUB File24 ()
    t = ""
    t = t + "' VAPOR|id=VAPOR|name=Vapor|kind=client|version=61f71a2e|category=Vapor|run=C:\PROGRAMS\VAPOR.SPK|files=C:\PROGRAMS\VAPOR.SPK|tasks=VAPOR|startup=|folder=|about=The Vapor program itself." + NL
    t = t + "' VAPOR.SPK - Vapor, the store and library for everything on SIM95: games," + NL
    t = t + "' programs (Simxplorer, Frostbird, Clippy...) and web apps (SimBook, ColdMail," + NL
    t = t + "' AskSim, ELIZA-95)." + NL
    t = t + "'" + NL
    t = t + "' A store is a folder on a web server, http://<machine>/vapor/, holding" + NL
    t = t + "' CATALOG.TXT, one item per line:" + NL
    t = t + "'   id|name|parts|bytes|status|category|about|kind|version|run|files|tasks|startup" + NL
    t = t + "' and each item cut into parts small enough for a network message" + NL
    t = t + "' (/vapor/<id>/<n>.txt). An item is a file that starts with a header line," + NL
    t = t + "'   ' VAPOR|id=...|name=...|kind=...|version=...|..." + NL
    t = t + "' kind says what to do with it once it is here:" + NL
    t = t + "'   game     it is the game: kept in C:\GAMES\<id>\<id>.SPK and played from there" + NL
    t = t + "'   program  it is an installer: Vapor runs it, then ""run"" opens the program" + NL
    t = t + "'   service  the same, for something that starts with the machine (Clippy)" + NL
    t = t + "'   web      an installer for a web app, which becomes this machine's home page" + NL
    t = t + "'   client   Vapor itself: a new version replaces this program, which restarts" + NL
    t = t + "'" + NL
    t = t + "' The library (C:\GAMES\LIBRARY.TXT) remembers what is installed, which" + NL
    t = t + "' version, and the time played. When the store has a newer version of" + NL
    t = t + "' something, the Library offers Update (or Update All)." + NL
    t = t + "'" + NL
    t = t + "' On a store machine, Publish Apps puts every installer saved in C:\MYFILES" + NL
    t = t + "' that has a header (all the ones tools/build-installer.mjs makes) into the" + NL
    t = t + "' store, replacing older versions: that is how a store's shelves are stocked" + NL
    t = t + "' and updated." + NL
    t = t + "'" + NL
    t = t + "' Fetches go one at a time and start in a timer tick of their own, inside a" + NL
    t = t + "' TRY with an empty CATCH (see SIM95-NOTES.md); pages come in through the" + NL
    t = t + "' socket's events." + NL
    t = t + "'" + NL
    t = t + "' A store can be at a SimDNS name (http://store.coolsite.sim/vapor/): the" + NL
    t = t + "' builder joins the resolver (simweb/src/RESOLVE.SPK, the Rs... names) on the" + NL
    t = t + "' end, and the name is asked about in a tick of its own before the fetch." + NL
    t = t + "' The connection goes to the machine the name server names; the request" + NL
    t = t + "' still says Host: store.coolsite.sim, so a web server with sites finds it." + NL
    t = t + "" + NL
    t = t + "CONST HOME = ""C:\GAMES""" + NL
    t = t + "CONST ME = ""C:\PROGRAMS\VAPOR.SPK""" + NL
    t = t + "CONST STOREDIR = ""C:\WEB\VAPOR""" + NL
    t = t + "CONST BROWSER = ""C:\PROGRAMS\SIMXPLOR.SPK""" + NL
    t = t + "CONST PATIENCE = 8000" + NL
    t = t + "CONST PART = 15000" + NL
    t = t + "CONST WEBAPPS = ""C:\SYSTEM\WEBAPPS.INI""" + NL
    t = t + "" + NL
    t = t + "VAR EOL AS String" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR bar AS GUI_Menu" + NL
    t = t + "VAR head AS GUI_Canvas" + NL
    t = t + "VAR games AS GUI_ListBox" + NL
    t = t + "VAR banner AS GUI_Canvas" + NL
    t = t + "VAR title AS GUI_Label" + NL
    t = t + "VAR info AS GUI_Label" + NL
    t = t + "VAR about AS GUI_Label" + NL
    t = t + "VAR action AS GUI_Button" + NL
    t = t + "VAR upd AS GUI_Button" + NL
    t = t + "VAR remove AS GUI_Button" + NL
    t = t + "VAR progress AS GUI_ProgressBar" + NL
    t = t + "VAR note AS GUI_Label" + NL
    t = t + "VAR trophies AS GUI_ListBox" + NL
    t = t + "VAR clock AS GUI_Timer" + NL
    t = t + "VAR web AS NET_Socket" + NL
    t = t + "" + NL
    t = t + "VAR store AS String               ' ""http://alpha/vapor/""" + NL
    t = t + "VAR tab AS String = ""STORE""" + NL
    t = t + "VAR catalog AS Array OF String    ' the store's lines" + NL
    t = t + "VAR listed AS Array OF String     ' the lines behind the list, in order ("""" for a heading)" + NL
    t = t + "VAR offeredSelf AS Bool           ' asked once about a newer Vapor" + NL
    t = t + "" + NL
    t = t + "' one fetch at a time" + NL
    t = t + "VAR fetching AS Bool" + NL
    t = t + "VAR fWhat AS String               ' ""catalog"" or ""part""" + NL
    t = t + "VAR fNumber AS Integer" + NL
    t = t + "VAR fParts AS Array OF String" + NL
    t = t + "VAR fDone AS Bool" + NL
    t = t + "VAR fSince AS Integer" + NL
    t = t + "VAR fError AS String" + NL
    t = t + "VAR wantCatalog AS Bool" + NL
    t = t + "" + NL
    t = t + "' the download going on, and what is waiting" + NL
    t = t + "VAR dlId AS String                ' """" when none" + NL
    t = t + "VAR dlLine AS String" + NL
    t = t + "VAR dlPart AS Integer" + NL
    t = t + "VAR dlParts AS Integer" + NL
    t = t + "VAR dlText AS String" + NL
    t = t + "VAR dlStart AS Integer" + NL
    t = t + "VAR queue AS Array OF String      ' catalog lines waiting" + NL
    t = t + "VAR setupPid AS Integer           ' an installer Vapor is running" + NL
    t = t + "VAR setupLine AS String" + NL
    t = t + "VAR setupSince AS Integer" + NL
    t = t + "" + NL
    t = t + "' things running: id and process" + NL
    t = t + "VAR playId AS Array OF String" + NL
    t = t + "VAR playPid AS Array OF Integer" + NL
    t = t + "VAR playSince AS Array OF Integer" + NL
    t = t + "" + NL
    t = t + "' ================================================================ start" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    EOL = Chr(10)" + NL
    t = t + "    IF NOT FS.Exists(HOME) THEN FS.MakeDir(HOME)" + NL
    t = t + "    LoadSettings()" + NL
    t = t + "    win = GUI_Window.New(""Vapor"", 640, 420)" + NL
    t = t + "    win.Icon = ""app""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    bar = GUI_Menu.New(win)" + NL
    t = t + "    bar.onSelect = Menu_OnSelect" + NL
    t = t + "    bar.AddMenu(""&Vapor"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Store"" + Chr(9) + ""Ctrl+1"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Library"" + Chr(9) + ""Ctrl+2"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Downloads"" + Chr(9) + ""Ctrl+3"")" + NL
    t = t + "    bar.AddSeparator(""&Vapor"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Update All"" + Chr(9) + ""Ctrl+U"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Refresh"" + Chr(9) + ""F5"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""Change S&tore..."")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Publish Apps..."" + Chr(9) + ""Ctrl+P"")" + NL
    t = t + "    bar.AddSeparator(""&Vapor"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""E&xit"")" + NL
    t = t + "    bar.AddMenu(""&Help"")" + NL
    t = t + "    bar.AddItem(""&Help"", ""&About Vapor"")" + NL
    t = t + "    bar.SetEnabled(""Publish Apps..."", FS.Exists(STOREDIR))" + NL
    t = t + "" + NL
    t = t + "    head = GUI_Canvas.New(win)" + NL
    t = t + "    head.SetBounds(0, 0, 640, 44)" + NL
    t = t + "    head.onDraw = Head_OnDraw" + NL
    t = t + "    head.onMouseDown = Head_OnMouseDown" + NL
    t = t + "    games = GUI_ListBox.New(win)" + NL
    t = t + "    games.SetBounds(6, 50, 180, 342)" + NL
    t = t + "    games.onSelect = Games_OnSelect" + NL
    t = t + "    games.onDblClick = Action_Click" + NL
    t = t + "    banner = GUI_Canvas.New(win)" + NL
    t = t + "    banner.SetBounds(194, 50, 440, 100)" + NL
    t = t + "    banner.onDraw = Banner_OnDraw" + NL
    t = t + "    title = GUI_Label.New(win)" + NL
    t = t + "    title.Bold = TRUE" + NL
    t = t + "    title.SetBounds(194, 156, 440, 16)" + NL
    t = t + "    info = GUI_Label.New(win)" + NL
    t = t + "    info.SetBounds(194, 174, 440, 14)" + NL
    t = t + "    about = GUI_Label.New(win)" + NL
    t = t + "    about.SetBounds(194, 194, 440, 64)" + NL
    t = t + "    action = GUI_Button.New(win)" + NL
    t = t + "    action.SetBounds(194, 262, 120, 28)" + NL
    t = t + "    action.onClick = Action_Click" + NL
    t = t + "    upd = GUI_Button.New(win)" + NL
    t = t + "    upd.Text = ""U&pdate""" + NL
    t = t + "    upd.SetBounds(322, 262, 100, 28)" + NL
    t = t + "    upd.onClick = Update_Click" + NL
    t = t + "    remove = GUI_Button.New(win)" + NL
    t = t + "    remove.Text = ""&Uninstall""" + NL
    t = t + "    remove.SetBounds(430, 262, 100, 28)" + NL
    t = t + "    remove.onClick = Remove_Click" + NL
    t = t + "    progress = GUI_ProgressBar.New(win)" + NL
    t = t + "    progress.SetBounds(194, 298, 440, 14)" + NL
    t = t + "    progress.Max = 100" + NL
    t = t + "    note = GUI_Label.New(win)" + NL
    t = t + "    note.SetBounds(194, 316, 440, 14)" + NL
    t = t + "    trophies = GUI_ListBox.New(win)" + NL
    t = t + "    trophies.SetBounds(194, 334, 440, 58)" + NL
    t = t + "" + NL
    t = t + "    web = NET_Socket.New()" + NL
    t = t + "    web.onMessage = Web_OnMessage" + NL
    t = t + "    web.onClose = Web_OnClose" + NL
    t = t + "    clock = GUI_Timer.New(win)" + NL
    t = t + "    clock.Interval = 100" + NL
    t = t + "    clock.onTick = Clock_OnTick" + NL
    t = t + "    clock.Start()" + NL
    t = t + "" + NL
    t = t + "    wantCatalog = store <> """"" + NL
    t = t + "    ShowTab(""STORE"")" + NL
    t = t + "    win.Show()" + NL
    t = t + "    IF store = """" THEN ChangeStore()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB LoadSettings ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(HOME + ""\VAPOR.INI"", """").Lines()" + NL
    t = t + "        IF line.StartsWith(""store="") THEN store = line.Substring(6, line.Length - 6).Trim()" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' a machine that is a store shops at itself to begin with" + NL
    t = t + "    IF store = """" AND FS.Exists(STOREDIR + ""\CATALOG.TXT"") THEN store = ""http://"" + NET.HostName.Lower() + ""/vapor/""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SaveSettings ()" + NL
    t = t + "    FS.Write(HOME + ""\VAPOR.INI"", ""store="" + store + EOL)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Field i of a | line, or """" when the line is shorter (older lines are)." + NL
    t = t + "FUNCTION Field (line AS String, i AS Integer) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    IF i >= p.Count THEN RETURN """"" + NL
    t = t + "    RETURN p[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' key=value from a header line." + NL
    t = t + "FUNCTION Meta (header AS String, key AS String) AS String" + NL
    t = t + "    VAR part AS String" + NL
    t = t + "    FOR EACH part IN header.Split(""|"")" + NL
    t = t + "        IF part.StartsWith(key + ""="") THEN RETURN part.Substring(key.Length + 1, part.Length - key.Length - 1)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The version of this Vapor, from its own header." + NL
    t = t + "FUNCTION MyVersion () AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    text = ReadOr(ME, """")" + NL
    t = t + "    IF NOT text.StartsWith(""' VAPOR|"") THEN RETURN """"" + NL
    t = t + "    RETURN Meta(text.Lines()[0], ""version"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ tabs and lists" + NL
    t = t + "" + NL
    t = t + "FUNCTION KindName (kind AS String) AS String" + NL
    t = t + "    SELECT CASE kind" + NL
    t = t + "        CASE ""game""" + NL
    t = t + "            RETURN ""Game""" + NL
    t = t + "        CASE ""web""" + NL
    t = t + "            RETURN ""Web app""" + NL
    t = t + "        CASE ""service""" + NL
    t = t + "            RETURN ""Program, starts with SIM95""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""Program""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB ShowTab (t AS String)" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR pass AS Integer" + NL
    t = t + "    VAR heading AS Bool" + NL
    t = t + "    VAR shelf AS Array OF String" + NL
    t = t + "    tab = t" + NL
    t = t + "    games.Clear()" + NL
    t = t + "    listed.Clear()" + NL
    t = t + "    IF t = ""STORE"" THEN" + NL
    t = t + "        ' apps first (A to Z), then games (as the store has them), each under a heading" + NL
    t = t + "        FOR pass = 0 TO 1" + NL
    t = t + "            heading = FALSE" + NL
    t = t + "            shelf.Clear()" + NL
    t = t + "            FOR EACH line IN catalog" + NL
    t = t + "                IF Field(line, 7) = ""client"" THEN CONTINUE" + NL
    t = t + "                IF (Field(line, 7) = ""game"") <> (pass = 1) THEN CONTINUE" + NL
    t = t + "                IF pass = 0 THEN" + NL
    t = t + "                    shelf.Add(Field(line, 1).Upper() + ""|"" + line)" + NL
    t = t + "                ELSE" + NL
    t = t + "                    shelf.Add(""|"" + line)" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF pass = 0 THEN shelf.Sort()" + NL
    t = t + "            FOR EACH line IN shelf" + NL
    t = t + "                line = line.Substring(line.IndexOf(""|"") + 1, line.Length - line.IndexOf(""|"") - 1)" + NL
    t = t + "                IF NOT heading THEN" + NL
    t = t + "                    heading = TRUE" + NL
    t = t + "                    listed.Add("""")" + NL
    t = t + "                    IF pass = 0 THEN" + NL
    t = t + "                        games.Add(""- APPS -"")" + NL
    t = t + "                    ELSE" + NL
    t = t + "                        games.Add(""- GAMES -"")" + NL
    t = t + "                    END IF" + NL
    t = t + "                END IF" + NL
    t = t + "                listed.Add(line)" + NL
    t = t + "                IF HasUpdate(Field(line, 0)) THEN" + NL
    t = t + "                    games.Add(""  "" + Field(line, 1) + ""  (update)"")" + NL
    t = t + "                ELSEIF Installed(Field(line, 0)) THEN" + NL
    t = t + "                    games.Add(""  "" + Field(line, 1) + ""  (installed)"")" + NL
    t = t + "                ELSE" + NL
    t = t + "                    games.Add(""  "" + Field(line, 1))" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF catalog.Count = 0 THEN" + NL
    t = t + "            IF store = """" THEN" + NL
    t = t + "                win.Status = ""No store yet: choose Vapor > Change Store.""" + NL
    t = t + "            ELSE" + NL
    t = t + "                win.Status = ""Fetching the store from "" + store + ""...""" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSEIF t = ""LIBRARY"" THEN" + NL
    t = t + "        FOR EACH line IN Library()" + NL
    t = t + "            listed.Add(line)" + NL
    t = t + "            IF HasUpdate(Field(line, 0)) THEN" + NL
    t = t + "                games.Add(Field(line, 1) + ""  (update)"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                games.Add(Field(line, 1))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF listed.Count = 0 THEN win.Status = ""Your library is empty. Visit the Store!""" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF dlId <> """" THEN" + NL
    t = t + "            listed.Add(dlLine)" + NL
    t = t + "            games.Add(Field(dlLine, 1) + ""  "" + Str(Percent()) + ""%"")" + NL
    t = t + "        END IF" + NL
    t = t + "        IF setupLine <> """" THEN" + NL
    t = t + "            listed.Add(setupLine)" + NL
    t = t + "            games.Add(Field(setupLine, 1) + ""  (installing)"")" + NL
    t = t + "        END IF" + NL
    t = t + "        FOR EACH line IN queue" + NL
    t = t + "            listed.Add(line)" + NL
    t = t + "            games.Add(Field(line, 1) + ""  (queued)"")" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    head.Tag = """"" + NL
    t = t + "    DrawHead()" + NL
    t = t + "    IF listed.Count > 0 THEN" + NL
    t = t + "        games.Selected = 0" + NL
    t = t + "        IF listed[0] = """" AND listed.Count > 1 THEN games.Selected = 1" + NL
    t = t + "    END IF" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Library () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(HOME + ""\LIBRARY.TXT"", """").Lines()" + NL
    t = t + "        IF line.Split(""|"").Count >= 4 THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Installed (id AS String) AS Bool" + NL
    t = t + "    RETURN LibLine(id) <> """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LibLine (id AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN Library()" + NL
    t = t + "        IF Field(line, 0) = id THEN RETURN line" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION StoreLine (id AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN catalog" + NL
    t = t + "        IF Field(line, 0) = id THEN RETURN line" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is there a newer version in the store than the one installed?" + NL
    t = t + "FUNCTION HasUpdate (id AS String) AS Bool" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    VAR shop AS String" + NL
    t = t + "    lib = LibLine(id)" + NL
    t = t + "    shop = StoreLine(id)" + NL
    t = t + "    IF lib = """" OR shop = """" OR Field(shop, 4) <> ""ok"" THEN RETURN FALSE" + NL
    t = t + "    RETURN Field(lib, 6) <> Field(shop, 8)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Current () AS String" + NL
    t = t + "    IF games.Selected < 0 OR games.Selected >= listed.Count THEN RETURN """"" + NL
    t = t + "    RETURN listed[games.Selected]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Games_OnSelect ()" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unesc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%0A"", EOL).Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Words into lines of about n characters." + NL
    t = t + "FUNCTION Wrap (text AS String, n AS Integer) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR word AS String" + NL
    t = t + "    FOR EACH word IN text.Split("" "")" + NL
    t = t + "        IF line <> """" AND line.Length + word.Length + 1 > n THEN" + NL
    t = t + "            out = out + line + EOL" + NL
    t = t + "            line = word" + NL
    t = t + "        ELSEIF line = """" THEN" + NL
    t = t + "            line = word" + NL
    t = t + "        ELSE" + NL
    t = t + "            line = line + "" "" + word" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out + line" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Played (seconds AS Integer) AS String" + NL
    t = t + "    IF seconds < 60 THEN RETURN ""Played "" + Str(seconds) + "" seconds""" + NL
    t = t + "    IF seconds < 3600 THEN RETURN ""Played "" + Str(Int(seconds / 60)) + "" minutes""" + NL
    t = t + "    RETURN ""Played "" + Str(Int(seconds / 360) / 10) + "" hours""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Busy (id AS String) AS Bool" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    IF id = dlId OR id = Field(setupLine, 0) THEN RETURN TRUE" + NL
    t = t + "    FOR EACH line IN queue" + NL
    t = t + "        IF Field(line, 0) = id THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The right-hand side: the banner, the words, the right buttons." + NL
    t = t + "SUB ShowGame ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    VAR shop AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    line = Current()" + NL
    t = t + "    trophies.Clear()" + NL
    t = t + "    banner.Tag = """"" + NL
    t = t + "    upd.Visible = FALSE" + NL
    t = t + "    IF line = """" THEN" + NL
    t = t + "        title.Text = """"" + NL
    t = t + "        info.Text = """"" + NL
    t = t + "        about.Text = """"" + NL
    t = t + "        action.Visible = FALSE" + NL
    t = t + "        remove.Visible = FALSE" + NL
    t = t + "        DrawBanner("""")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    id = Field(line, 0)" + NL
    t = t + "    lib = LibLine(id)" + NL
    t = t + "    shop = StoreLine(id)" + NL
    t = t + "    title.Text = Field(line, 1)" + NL
    t = t + "    action.Visible = TRUE" + NL
    t = t + "    action.Enabled = TRUE" + NL
    t = t + "    remove.Visible = lib <> """"" + NL
    t = t + "    IF tab = ""LIBRARY"" THEN" + NL
    t = t + "        kind = Field(lib, 7)" + NL
    t = t + "        IF kind = """" THEN kind = ""game""" + NL
    t = t + "        IF kind = ""game"" THEN" + NL
    t = t + "            info.Text = Played(Int(Val(Field(lib, 3)))) + ""  -  installed "" + Field(lib, 2)" + NL
    t = t + "        ELSE" + NL
    t = t + "            info.Text = KindName(kind) + ""  -  installed "" + Field(lib, 2)" + NL
    t = t + "        END IF" + NL
    t = t + "        IF Field(lib, 6) <> """" THEN info.Text = info.Text + ""  -  build "" + Field(lib, 6)" + NL
    t = t + "        about.Text = Wrap(Unesc(Field(lib, 5)), 66)" + NL
    t = t + "        action.Text = OpenWord(kind)" + NL
    t = t + "        IF playId.Contains(id) THEN" + NL
    t = t + "            action.Text = ""Running""" + NL
    t = t + "            action.Enabled = FALSE" + NL
    t = t + "        END IF" + NL
    t = t + "        upd.Visible = HasUpdate(id) AND NOT Busy(id)" + NL
    t = t + "        IF kind = ""game"" THEN" + NL
    t = t + "            FOR EACH a IN ReadOr(HOME + ""\"" + id + ""\ACHIEVE.TXT"", """").Lines()" + NL
    Put("C:\WEB\VAPOR\VAPOR\1.TXT")
END SUB

SUB File25 ()
    t = ""
    t = t + "                IF a.Contains(""|"") THEN trophies.Add(""* "" + a.Split(""|"")[0] + "" - "" + a.Split(""|"")[1] + ""  ("" + a.Split(""|"")[2] + "")"")" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF trophies.Count = 0 THEN trophies.Add(""No achievements yet. Go and play!"")" + NL
    t = t + "        END IF" + NL
    t = t + "        IF HasUpdate(id) THEN trophies.Add(""A newer version is in the store (build "" + Field(shop, 8) + "")."")" + NL
    t = t + "    ELSE" + NL
    t = t + "        kind = Field(line, 7)" + NL
    t = t + "        IF kind = """" THEN kind = ""game""" + NL
    t = t + "        info.Text = Field(line, 5) + ""  -  "" + KindName(kind) + ""  -  "" + Str(Int(Val(Field(line, 3)) / 1024) + 1) + "" KB  -  Free""" + NL
    t = t + "        about.Text = Wrap(Unesc(Field(line, 6)), 66)" + NL
    t = t + "        IF Field(line, 4) = ""soon"" THEN" + NL
    t = t + "            info.Text = Field(line, 5) + ""  -  Coming soon""" + NL
    t = t + "            action.Text = ""Coming soon""" + NL
    t = t + "            action.Enabled = FALSE" + NL
    t = t + "        ELSEIF Busy(id) THEN" + NL
    t = t + "            action.Text = ""Downloading...""" + NL
    t = t + "            action.Enabled = FALSE" + NL
    t = t + "        ELSEIF HasUpdate(id) THEN" + NL
    t = t + "            action.Text = ""U&pdate""" + NL
    t = t + "        ELSEIF lib <> """" THEN" + NL
    t = t + "            action.Text = OpenWord(kind)" + NL
    t = t + "            action.Enabled = NOT playId.Contains(id)" + NL
    t = t + "        ELSE" + NL
    t = t + "            action.Text = ""&Install""" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    DrawBanner(id)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION OpenWord (kind AS String) AS String" + NL
    t = t + "    IF kind = ""game"" THEN RETURN ""&Play""" + NL
    t = t + "    RETURN ""&Open""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Action_Click ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    line = Current()" + NL
    t = t + "    IF line = """" THEN RETURN" + NL
    t = t + "    id = Field(line, 0)" + NL
    t = t + "    IF tab = ""STORE"" AND HasUpdate(id) THEN" + NL
    t = t + "        Want(StoreLine(id))" + NL
    t = t + "    ELSEIF Installed(id) THEN" + NL
    t = t + "        Launch(id)" + NL
    t = t + "    ELSEIF tab = ""STORE"" AND Field(line, 4) <> ""soon"" THEN" + NL
    t = t + "        Want(line)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Update_Click ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    line = Current()" + NL
    t = t + "    IF line = """" THEN RETURN" + NL
    t = t + "    IF HasUpdate(Field(line, 0)) THEN Want(StoreLine(Field(line, 0)))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Into the download queue. A web app asks first: it takes the home page." + NL
    t = t + "SUB Want (line AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    VAR other AS String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    IF Busy(Field(line, 0)) THEN RETURN" + NL
    t = t + "    IF Field(line, 7) = ""web"" AND NOT Installed(Field(line, 0)) AND NOT (Folders() AND Field(line, 13) <> """") THEN" + NL
    t = t + "        FOR EACH l IN Library()" + NL
    t = t + "            IF Field(l, 7) = ""web"" THEN other = Field(l, 1)" + NL
    t = t + "        NEXT" + NL
    t = t + "        box = GUI_MessageBox.New(win)" + NL
    t = t + "        box.Title = ""Vapor""" + NL
    t = t + "        box.Kind = ""confirm""" + NL
    t = t + "        box.Buttons = ""yesno""" + NL
    t = t + "        box.Text = Field(line, 1) + "" is a web app: it becomes this machine's home page, http://"" + NET.HostName.Lower() + ""/ (the page there now moves aside to WELCOME.HTM).""" + NL
    t = t + "        IF other <> """" THEN box.Text = box.Text + EOL + EOL + ""This machine already has "" + other + "" there, and a machine has room for one web app: "" + Field(line, 1) + "" will take its place.""" + NL
    t = t + "        box.Text = box.Text + EOL + EOL + ""Install it?""" + NL
    t = t + "        IF NOT box.Show() THEN RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    queue.Add(line)" + NL
    t = t + "    win.Status = Field(line, 1) + "" is queued for download.""" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Play a game, open a program, or open a web app in the browser." + NL
    t = t + "SUB Launch (id AS String)" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR run AS String" + NL
    t = t + "    VAR url AS String" + NL
    t = t + "    lib = LibLine(id)" + NL
    t = t + "    kind = Field(lib, 7)" + NL
    t = t + "    IF kind = """" OR kind = ""game"" THEN" + NL
    t = t + "        run = HOME + ""\"" + id + ""\"" + id + "".SPK""" + NL
    t = t + "    ELSE" + NL
    t = t + "        run = Field(lib, 8)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF kind = ""web"" THEN" + NL
    t = t + "        url = WebUrl(Field(lib, 12))" + NL
    t = t + "        IF FS.Exists(BROWSER) THEN" + NL
    t = t + "            SYS.Start(BROWSER, url)" + NL
    t = t + "        ELSE" + NL
    t = t + "            SYS.Start(""C:\SYSTEM\VOYAGER.EXE"", url)" + NL
    t = t + "        END IF" + NL
    t = t + "        win.Status = ""Opened "" + url" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT FS.Exists(run) THEN" + NL
    t = t + "        Say(""The files are missing ("" + run + ""). Uninstall it and install it again."", ""error"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF playId.Contains(id) THEN RETURN" + NL
    t = t + "    playId.Add(id)" + NL
    t = t + "    playPid.Add(SYS.Run(run))" + NL
    t = t + "    playSince.Add(SYS.Ticks)" + NL
    t = t + "    IF kind = ""game"" THEN" + NL
    t = t + "        win.Status = ""Playing "" + Field(lib, 1) + ""...""" + NL
    t = t + "    ELSE" + NL
    t = t + "        win.Status = ""Opened "" + Field(lib, 1) + "".""" + NL
    t = t + "    END IF" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Remove_Click ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    line = Current()" + NL
    t = t + "    IF line = """" THEN RETURN" + NL
    t = t + "    id = Field(line, 0)" + NL
    t = t + "    lib = LibLine(id)" + NL
    t = t + "    IF lib = """" THEN RETURN" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = ""Vapor""" + NL
    t = t + "    box.Kind = ""confirm""" + NL
    t = t + "    box.Buttons = ""yesno""" + NL
    t = t + "    IF Field(lib, 7) = """" OR Field(lib, 7) = ""game"" THEN" + NL
    t = t + "        box.Text = ""Uninstall "" + Field(lib, 1) + ""? Its files in "" + HOME + ""\"" + id + "" will be deleted (your achievements too).""" + NL
    t = t + "    ELSE" + NL
    t = t + "        box.Text = ""Uninstall "" + Field(lib, 1) + ""? Its program files go; anything it saved (mail, posts, settings) stays.""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT box.Show() THEN RETURN" + NL
    t = t + "    Uninstall(lib)" + NL
    t = t + "    win.Status = Field(lib, 1) + "" was uninstalled.""" + NL
    t = t + "    ShowTab(tab)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Stops it, takes it out of startup, deletes the files it wrote, and its folder here." + NL
    t = t + "SUB Uninstall (lib AS String)" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR task AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    id = Field(lib, 0)" + NL
    t = t + "    FOR EACH name IN Field(lib, 10).Split("";"")" + NL
    t = t + "        IF name = """" THEN CONTINUE" + NL
    t = t + "        FOR EACH task IN SYS.Tasks()" + NL
    t = t + "            IF task.Split(""|"")[1].Upper() = name.Upper() AND Int(Val(task.Split(""|"")[0])) <> SYS.Pid THEN SYS.Kill(Int(Val(task.Split(""|"")[0])))" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH name IN Field(lib, 11).Split("";"")" + NL
    t = t + "        IF name <> """" AND FS.Exists(""C:\SYSTEM\STARTUP\"" + name) THEN FS.Delete(""C:\SYSTEM\STARTUP\"" + name)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH f IN Field(lib, 9).Split("";"")" + NL
    t = t + "        IF f <> """" AND f.Upper() <> ME THEN" + NL
    t = t + "            IF FS.Exists(Where(f, Field(lib, 12))) THEN FS.Delete(Where(f, Field(lib, 12)))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' a web app gives the home page back (unless it had a folder of its own)" + NL
    t = t + "    IF Field(lib, 7) = ""web"" AND (Field(lib, 12) = """" OR NOT Folders()) AND NOT FS.Exists(""C:\WEB\INDEX.HTM"") AND FS.Exists(""C:\WEB\WELCOME.HTM"") THEN FS.Rename(""C:\WEB\WELCOME.HTM"", ""C:\WEB\INDEX.HTM"")" + NL
    t = t + "    IF FS.Exists(HOME + ""\"" + id) THEN" + NL
    t = t + "        FOR EACH f IN FS.List(HOME + ""\"" + id)" + NL
    t = t + "            IF NOT f.EndsWith(""\"") THEN FS.Delete(HOME + ""\"" + id + ""\"" + f)" + NL
    t = t + "        NEXT" + NL
    t = t + "        FS.Delete(HOME + ""\"" + id)" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH l IN Library()" + NL
    t = t + "        IF Field(l, 0) <> id THEN out.Add(l)" + NL
    t = t + "    NEXT" + NL
    t = t + "    SaveLibrary(out)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SaveLibrary (lines AS Array OF String)" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    IF lines.Count > 0 THEN text = lines.Join(EOL) + EOL" + NL
    t = t + "    FS.Write(HOME + ""\LIBRARY.TXT"", text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Into the library, or the line there brought up to date (keeping when it" + NL
    t = t + "' was first installed and the time played)." + NL
    t = t + "SUB Keep (line AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    VAR first AS String" + NL
    t = t + "    VAR seconds AS String = ""0""" + NL
    t = t + "    VAR found AS Bool" + NL
    t = t + "    first = TIME.Date" + NL
    t = t + "    FOR EACH l IN Library()" + NL
    t = t + "        IF Field(l, 0) = Field(line, 0) THEN" + NL
    t = t + "            first = Field(l, 2)" + NL
    t = t + "            seconds = Field(l, 3)" + NL
    t = t + "            found = TRUE" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    l = Field(line, 0) + ""|"" + Field(line, 1) + ""|"" + first + ""|"" + seconds + ""|"" + Field(line, 5) + ""|"" + Field(line, 6) + ""|"" + Field(line, 8) + ""|"" + Field(line, 7) + ""|"" + Field(line, 9) + ""|"" + Field(line, 10) + ""|"" + Field(line, 11) + ""|"" + Field(line, 12) + ""|"" + Field(line, 13)" + NL
    t = t + "    FOR EACH line IN Library()" + NL
    t = t + "        IF Field(line, 0) = Field(l, 0) THEN" + NL
    t = t + "            out.Add(l)" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT found THEN out.Add(l)" + NL
    t = t + "    SaveLibrary(out)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB UpdateAll ()" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    FOR EACH l IN Library()" + NL
    t = t + "        IF HasUpdate(Field(l, 0)) AND NOT Busy(Field(l, 0)) THEN" + NL
    t = t + "            queue.Add(StoreLine(Field(l, 0)))" + NL
    t = t + "            n = n + 1" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF n = 0 THEN" + NL
    t = t + "        win.Status = ""Everything is up to date.""" + NL
    t = t + "    ELSE" + NL
    t = t + "        win.Status = Str(n) + "" update"" + Plural(n) + "" queued.""" + NL
    t = t + "    END IF" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Plural (n AS Integer) AS String" + NL
    t = t + "    IF n = 1 THEN RETURN """"" + NL
    t = t + "    RETURN ""s""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the clock: fetches, downloads, play time" + NL
    t = t + "" + NL
    t = t + "SUB Clock_OnTick ()" + NL
    t = t + "    TRY" + NL
    t = t + "        Tick()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Alive (pid AS Integer) AS Bool" + NL
    t = t + "    VAR task AS String" + NL
    t = t + "    FOR EACH task IN SYS.Tasks()" + NL
    t = t + "        IF Int(Val(task.Split(""|"")[0])) = pid THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Tick ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    ' things that ended: a game's time goes in the library" + NL
    t = t + "    FOR i = playId.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF NOT Alive(playPid[i]) THEN" + NL
    t = t + "            AddTime(playId[i], Int((SYS.Ticks - playSince[i]) / 1000))" + NL
    t = t + "            playId.RemoveAt(i)" + NL
    t = t + "            playPid.RemoveAt(i)" + NL
    t = t + "            playSince.RemoveAt(i)" + NL
    t = t + "            ShowGame()" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' an installer that finished: into the library. (It may not end: a program" + NL
    t = t + "    ' that has printed keeps its console open. So it is done when every file" + NL
    t = t + "    ' it writes is there, or when it ends.)" + NL
    t = t + "    IF setupLine <> """" THEN" + NL
    t = t + "        IF NOT Alive(setupPid) OR (SYS.Ticks - setupSince > 300 AND AllThere(Field(setupLine, 10), Field(setupLine, 13))) OR SYS.Ticks - setupSince > 60000 THEN" + NL
    t = t + "            Keep(setupLine)" + NL
    t = t + "            win.Status = Field(setupLine, 1) + "" is installed.""" + NL
    t = t + "            note.Text = Field(setupLine, 1) + "" is ready.""" + NL
    t = t + "            progress.Value = 0" + NL
    t = t + "            setupLine = """"" + NL
    t = t + "            SYS.Beep(660, 60)" + NL
    t = t + "            ShowTab(tab)" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF fetching THEN" + NL
    t = t + "        IF fDone OR SYS.Ticks - fSince > PATIENCE THEN Arrived()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF wantCatalog AND store <> """" THEN" + NL
    t = t + "        ' a SimDNS name: ask first, in a tick of its own" + NL
    t = t + "        IF RsNext(StoreHost()) THEN RETURN" + NL
    t = t + "        wantCatalog = FALSE" + NL
    t = t + "        StartFetch(""catalog"", store + ""catalog.txt"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF dlId = """" AND queue.Count > 0 THEN" + NL
    t = t + "        dlLine = queue[0]" + NL
    t = t + "        queue.RemoveAt(0)" + NL
    t = t + "        dlId = Field(dlLine, 0)" + NL
    t = t + "        dlParts = Int(Val(Field(dlLine, 2)))" + NL
    t = t + "        dlPart = 0" + NL
    t = t + "        dlText = """"" + NL
    t = t + "        dlStart = SYS.Ticks" + NL
    t = t + "    END IF" + NL
    t = t + "    IF dlId <> """" THEN" + NL
    t = t + "        IF RsNext(StoreHost()) THEN RETURN" + NL
    t = t + "        dlPart = dlPart + 1" + NL
    t = t + "        ' (last thing in the tick: it may be spoiled)" + NL
    t = t + "        StartFetch(""part"", store + dlId.Lower() + ""/"" + Str(dlPart) + "".txt"")" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION AllThere (files AS String, folder AS String) AS Bool" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    IF files = """" THEN RETURN FALSE" + NL
    t = t + "    FOR EACH f IN files.Split("";"")" + NL
    t = t + "        IF f <> """" AND NOT FS.Exists(Where(f, folder)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A machine set up for several web apps (SimHost's C:\SYSTEM\WEBAPPS.INI says" + NL
    t = t + "' mode=folders) keeps each in its own folder, C:\WEB\BOOK and so on." + NL
    t = t + "FUNCTION Folders () AS Bool" + NL
    t = t + "    RETURN ReadOr(WEBAPPS, """").Contains(""mode=folders"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a web app's file really is: C:\WEB\BOOK.SPK -> C:\WEB\BOOK\BOOK.SPK" + NL
    t = t + "FUNCTION Where (f AS String, folder AS String) AS String" + NL
    t = t + "    IF folder = """" OR NOT Folders() THEN RETURN f" + NL
    t = t + "    IF NOT f.Upper().StartsWith(""C:\WEB\"") THEN RETURN f" + NL
    t = t + "    RETURN ""C:\WEB\"" + folder + ""\"" + f.Substring(7, f.Length - 7)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The address of a web app: the machine, or its folder there." + NL
    t = t + "FUNCTION WebUrl (folder AS String) AS String" + NL
    t = t + "    IF folder <> """" AND Folders() THEN RETURN ""http://"" + NET.HostName.Lower() + ""/"" + folder.Lower() + ""/""" + NL
    t = t + "    RETURN ""http://"" + NET.HostName.Lower() + ""/""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB AddTime (id AS String, seconds AS Integer)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    FOR EACH line IN Library()" + NL
    t = t + "        p = line.Split(""|"")" + NL
    t = t + "        IF p[0] = id THEN" + NL
    t = t + "            p[3] = Str(Int(Val(p[3])) + seconds)" + NL
    t = t + "            line = p.Join(""|"")" + NL
    t = t + "        END IF" + NL
    t = t + "        out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    SaveLibrary(out)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Percent () AS Integer" + NL
    t = t + "    IF dlParts = 0 THEN RETURN 0" + NL
    t = t + "    RETURN Int((dlPart - 1) * 100 / dlParts)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The store's machine as written in its address (alpha, store.coolsite.sim)." + NL
    t = t + "FUNCTION StoreHost () AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    IF NOT store.Lower().StartsWith(""http://"") THEN RETURN """"" + NL
    t = t + "    h = store.Substring(7, store.Length - 7)" + NL
    t = t + "    IF h.Contains(""/"") THEN h = h.Substring(0, h.IndexOf(""/""))" + NL
    t = t + "    RETURN h" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB StartFetch (what AS String, url AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR host AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    fetching = TRUE" + NL
    t = t + "    fWhat = what" + NL
    t = t + "    fNumber = fNumber + 1" + NL
    t = t + "    fParts.Clear()" + NL
    t = t + "    fDone = FALSE" + NL
    t = t + "    fError = """"" + NL
    t = t + "    fSince = SYS.Ticks" + NL
    t = t + "    host = url.Substring(7, url.Length - 7)" + NL
    t = t + "    path = host.Substring(host.IndexOf(""/""), host.Length - host.IndexOf(""/""))" + NL
    t = t + "    host = host.Substring(0, host.IndexOf(""/""))" + NL
    t = t + "    TRY" + NL
    t = t + "        ' (to the machine SimDNS named, if it named one; Host: as written)" + NL
    t = t + "        conn = web.Connect(RsTarget(host), 80)" + NL
    t = t + "        conn.Tag = Str(fNumber)" + NL
    t = t + "        conn.Send(""GET "" + path + "" HTTP/1.0"" + EOL + ""Host: "" + host + EOL + ""User-Agent: Vapor/2.0 (SIM95)"")" + NL
    t = t + "    CATCH err" + NL
    t = t + "        fError = err" + NL
    t = t + "        fDone = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    IF conn.Tag = Str(fNumber) AND NOT fDone THEN fParts.Add(message)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnClose (conn AS NET_Connection)" + NL
    t = t + "    IF conn.Tag = Str(fNumber) THEN fDone = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A fetch finished (or gave up): the body, or """" with fError saying why." + NL
    t = t + "FUNCTION Body () AS String" + NL
    t = t + "    VAR raw AS String" + NL
    t = t + "    raw = fParts.Join(EOL)" + NL
    t = t + "    IF fError <> """" THEN RETURN """"" + NL
    t = t + "    IF raw = """" THEN" + NL
    t = t + "        fError = ""no answer""" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT raw.StartsWith(""HTTP/1.0 200"") THEN" + NL
    t = t + "        fError = raw.Lines()[0]" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT raw.Contains(EOL + EOL) THEN RETURN """"" + NL
    t = t + "    RETURN raw.Substring(raw.IndexOf(EOL + EOL) + 2, raw.Length - raw.IndexOf(EOL + EOL) - 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Arrived ()" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR mine AS String" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    fetching = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        web.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    text = Body()" + NL
    t = t + "    IF fWhat = ""catalog"" THEN" + NL
    t = t + "        catalog.Clear()" + NL
    t = t + "        IF text = """" THEN" + NL
    t = t + "            win.Status = ""The store at "" + store + "" did not answer ("" + fError + "").""" + NL
    t = t + "        ELSE" + NL
    t = t + "            FOR EACH line IN text.Lines()" + NL
    t = t + "                IF line.Split(""|"").Count >= 7 THEN catalog.Add(line)" + NL
    t = t + "            NEXT" + NL
    t = t + "            win.Status = ""Store: "" + store + ""  -  "" + Str(catalog.Count) + "" items""" + NL
    t = t + "        END IF" + NL
    t = t + "        IF tab <> ""DOWNLOADS"" THEN ShowTab(tab)" + NL
    t = t + "        ' a newer Vapor? ask once" + NL
    t = t + "        mine = MyVersion()" + NL
    t = t + "        line = StoreLine(""VAPOR"")" + NL
    t = t + "        IF line <> """" AND mine <> """" AND Field(line, 8) <> mine AND NOT offeredSelf AND NOT Busy(""VAPOR"") THEN" + NL
    t = t + "            offeredSelf = TRUE" + NL
    t = t + "            box = GUI_MessageBox.New(win)" + NL
    t = t + "            box.Title = ""Vapor""" + NL
    t = t + "            box.Kind = ""confirm""" + NL
    t = t + "            box.Buttons = ""yesno""" + NL
    Put("C:\WEB\VAPOR\VAPOR\2.TXT")
END SUB

SUB File26 ()
    t = ""
    t = t + "            box.Text = ""A new version of Vapor is in the store (build "" + Field(line, 8) + ""; this is "" + mine + "")."" + EOL + EOL + ""Update Vapor now? It will restart.""" + NL
    t = t + "            IF box.Show() THEN queue.Insert(0, line)" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' a part of the download" + NL
    t = t + "    IF text = """" THEN" + NL
    t = t + "        win.Status = ""The download of "" + Field(dlLine, 1) + "" failed ("" + fError + "").""" + NL
    t = t + "        progress.Value = 0" + NL
    t = t + "        note.Text = """"" + NL
    t = t + "        dlId = """"" + NL
    t = t + "        ShowTab(tab)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    dlText = dlText + text" + NL
    t = t + "    progress.Value = Int(dlPart * 100 / dlParts)" + NL
    t = t + "    note.Text = ""Downloading "" + Field(dlLine, 1) + "": part "" + Str(dlPart) + "" of "" + Str(dlParts) + ""  -  "" + Str(Int(dlText.Length / MATH.Max(1, SYS.Ticks - dlStart) * 1000 / 102.4) / 10) + "" KB/s""" + NL
    t = t + "    IF tab = ""DOWNLOADS"" AND games.Count > 0 THEN games.Set(0, Field(dlLine, 1) + ""  "" + Str(Int(dlPart * 100 / dlParts)) + ""%"")" + NL
    t = t + "    IF dlPart >= dlParts THEN Finish()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' All the parts are here: what happens next depends on what it is." + NL
    t = t + "SUB Finish ()" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    line = dlLine" + NL
    t = t + "    dir = HOME + ""\"" + dlId" + NL
    t = t + "    kind = Field(line, 7)" + NL
    t = t + "    IF kind = """" THEN kind = ""game""" + NL
    t = t + "    IF kind = ""client"" THEN" + NL
    t = t + "        ' a new Vapor: in place of this one, which starts it and goes" + NL
    t = t + "        FS.Write(ME, dlText)" + NL
    t = t + "        SYS.Start(ME, """")" + NL
    t = t + "        SYS.Exit(0)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT FS.Exists(dir) THEN FS.MakeDir(dir)" + NL
    t = t + "    dlId = """"" + NL
    t = t + "    IF kind = ""game"" THEN" + NL
    t = t + "        FS.Write(dir + ""\"" + Field(line, 0) + "".SPK"", dlText)" + NL
    t = t + "        dlText = """"" + NL
    t = t + "        Keep(line)" + NL
    t = t + "        win.Status = Field(line, 1) + "" is installed. Find it in your Library.""" + NL
    t = t + "        note.Text = Field(line, 1) + "" is ready to play.""" + NL
    t = t + "        SYS.Beep(660, 60)" + NL
    t = t + "        ShowTab(tab)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' an installer: clear away the old files it writes (an update: a new" + NL
    t = t + "    ' install may need what is there, as SimHost moves web apps), run it, and" + NL
    t = t + "    ' wait for them" + NL
    t = t + "    FS.Write(dir + ""\INSTALL.SPK"", dlText)" + NL
    t = t + "    dlText = """"" + NL
    t = t + "    IF Installed(Field(line, 0)) THEN" + NL
    t = t + "        FOR EACH f IN Field(line, 10).Split("";"")" + NL
    t = t + "            IF f <> """" AND f.Upper() <> ME THEN" + NL
    t = t + "                IF FS.Exists(Where(f, Field(line, 13))) THEN FS.Delete(Where(f, Field(line, 13)))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    setupLine = line" + NL
    t = t + "    setupSince = SYS.Ticks" + NL
    t = t + "    setupPid = SYS.Run(dir + ""\INSTALL.SPK"")" + NL
    t = t + "    note.Text = ""Installing "" + Field(line, 1) + ""...""" + NL
    t = t + "    win.Status = ""Running "" + Field(line, 1) + ""'s installer...""" + NL
    t = t + "    ShowTab(tab)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ publishing (on a store machine)" + NL
    t = t + "" + NL
    t = t + "' Every installer in C:\MYFILES with a Vapor header goes on the store's shelf," + NL
    t = t + "' in place of an older version of it." + NL
    t = t + "SUB Publish ()" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR done AS Array OF String" + NL
    t = t + "    VAR same AS Array OF String" + NL
    t = t + "    VAR answer AS String" + NL
    t = t + "    IF NOT FS.Exists(STOREDIR) THEN" + NL
    t = t + "        Say(""This machine is not a Vapor store. Run Vapor's INSTALL.SPK here first."", ""warn"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    win.Status = ""Looking in C:\MYFILES for installers...""" + NL
    t = t + "    FOR EACH f IN FS.List(""C:\MYFILES"")" + NL
    t = t + "        IF NOT f.EndsWith("".SPK"") THEN CONTINUE" + NL
    t = t + "        text = FS.Read(""C:\MYFILES\"" + f)" + NL
    t = t + "        IF NOT text.StartsWith(""' VAPOR|"") THEN CONTINUE" + NL
    t = t + "        answer = PublishOne(text)" + NL
    t = t + "        IF answer.StartsWith(""="") THEN" + NL
    t = t + "            same.Add(answer.Substring(1, answer.Length - 1))" + NL
    t = t + "        ELSEIF answer <> """" THEN" + NL
    t = t + "            done.Add(answer)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF done.Count = 0 AND same.Count = 0 THEN" + NL
    t = t + "        Say(""There are no installers to publish in C:\MYFILES."" + EOL + EOL + ""Paste an app's INSTALL.SPK into SPARK, save it in C:\MYFILES (any name ending .SPK) without running it, and choose Publish Apps again."", ""info"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    answer = """"" + NL
    t = t + "    IF done.Count > 0 THEN answer = ""Published:"" + EOL + ""  "" + done.Join(EOL + ""  "")" + NL
    t = t + "    IF same.Count > 0 THEN answer = answer + EOL + EOL + ""Already up to date: "" + same.Join("", "")" + NL
    t = t + "    Say(answer.Trim(), ""info"")" + NL
    t = t + "    wantCatalog = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One installer into the store: its parts, and its line in the catalog." + NL
    t = t + "' Returns ""name (build)"" or ""=name"" when the store already had that version." + NL
    t = t + "FUNCTION PublishOne (text AS String) AS String" + NL
    t = t + "    VAR header AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR chunk AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR entry AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR found AS Bool" + NL
    t = t + "    header = text.Lines()[0]" + NL
    t = t + "    id = Meta(header, ""id"").Upper()" + NL
    t = t + "    IF id = """" OR id.Length > 8 OR id.Contains(""\"") OR id.Contains(""."") THEN RETURN """"" + NL
    t = t + "    FOR EACH line IN ReadOr(STOREDIR + ""\CATALOG.TXT"", """").Lines()" + NL
    t = t + "        IF Field(line, 0) = id AND Field(line, 8) = Meta(header, ""version"") THEN RETURN ""="" + Meta(header, ""name"")" + NL
    t = t + "    NEXT" + NL
    t = t + "    dir = STOREDIR + ""\"" + id" + NL
    t = t + "    IF FS.Exists(dir) THEN" + NL
    t = t + "        FOR EACH f IN FS.List(dir)" + NL
    t = t + "            IF NOT f.EndsWith(""\"") THEN FS.Delete(dir + ""\"" + f)" + NL
    t = t + "        NEXT" + NL
    t = t + "    ELSE" + NL
    t = t + "        FS.MakeDir(dir)" + NL
    t = t + "    END IF" + NL
    t = t + "    ' parts of whole lines, each small enough for one network message" + NL
    t = t + "    lines = text.Replace(Chr(13), """").Split(EOL)" + NL
    t = t + "    IF lines.Count > 0 THEN" + NL
    t = t + "        IF lines[lines.Count - 1] = """" THEN lines.RemoveAt(lines.Count - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH line IN lines" + NL
    t = t + "        IF chunk.Length + line.Length + 1 > PART AND chunk <> """" THEN" + NL
    t = t + "            n = n + 1" + NL
    t = t + "            FS.Write(dir + ""\"" + Str(n) + "".TXT"", chunk)" + NL
    t = t + "            chunk = """"" + NL
    t = t + "        END IF" + NL
    t = t + "        chunk = chunk + line + EOL" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF chunk <> """" THEN" + NL
    t = t + "        n = n + 1" + NL
    t = t + "        FS.Write(dir + ""\"" + Str(n) + "".TXT"", chunk)" + NL
    t = t + "    END IF" + NL
    t = t + "    entry = id + ""|"" + Meta(header, ""name"") + ""|"" + Str(n) + ""|"" + Str(text.Length) + ""|ok|"" + Meta(header, ""category"") + ""|"" + Meta(header, ""about"") + ""|"" + Meta(header, ""kind"") + ""|"" + Meta(header, ""version"") + ""|"" + Meta(header, ""run"") + ""|"" + Meta(header, ""files"") + ""|"" + Meta(header, ""tasks"") + ""|"" + Meta(header, ""startup"") + ""|"" + Meta(header, ""folder"").Upper()" + NL
    t = t + "    FOR EACH line IN ReadOr(STOREDIR + ""\CATALOG.TXT"", """").Lines()" + NL
    t = t + "        IF line = """" THEN CONTINUE" + NL
    t = t + "        IF Field(line, 0) = id THEN" + NL
    t = t + "            out.Add(entry)" + NL
    t = t + "            found = TRUE" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT found THEN out.Add(entry)" + NL
    t = t + "    FS.Write(STOREDIR + ""\CATALOG.TXT"", out.Join(EOL) + EOL)" + NL
    t = t + "    RETURN Meta(header, ""name"") + "" (build "" + Meta(header, ""version"") + "")""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the header and the banners" + NL
    t = t + "" + NL
    t = t + "SUB Head_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    head.Tag = """"" + NL
    t = t + "    DrawHead()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawHead ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR names AS Array OF String" + NL
    t = t + "    IF head.Tag = tab THEN RETURN" + NL
    t = t + "    head.Tag = tab" + NL
    t = t + "    head.Clear()" + NL
    t = t + "    head.SetColor(0)" + NL
    t = t + "    head.FillRect(0, 0, 640, 44)" + NL
    t = t + "    head.SetColor(4)" + NL
    t = t + "    head.FillRect(0, 0, 640, 40)" + NL
    t = t + "    ' the logo: steam rising off a V" + NL
    t = t + "    head.SetColor(15)" + NL
    t = t + "    head.FillCircle(22, 14, 4)" + NL
    t = t + "    head.FillCircle(28, 9, 3)" + NL
    t = t + "    head.FillCircle(17, 8, 2)" + NL
    t = t + "    head.SetColor(14)" + NL
    t = t + "    head.Text(38, 12, ""VAPOR"")" + NL
    t = t + "    names = [""STORE"", ""LIBRARY"", ""DOWNLOADS""]" + NL
    t = t + "    FOR i = 0 TO 2" + NL
    t = t + "        IF names[i] = tab THEN" + NL
    t = t + "            head.SetColor(14)" + NL
    t = t + "            head.FillRect(150 + i * 130, 36, 110, 4)" + NL
    t = t + "            head.SetColor(15)" + NL
    t = t + "        ELSE" + NL
    t = t + "            head.SetColor(7)" + NL
    t = t + "        END IF" + NL
    t = t + "        head.Text(150 + i * 130, 12, names[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Head_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    IF x >= 150 AND x < 270 THEN ShowTab(""STORE"")" + NL
    t = t + "    IF x >= 280 AND x < 400 THEN ShowTab(""LIBRARY"")" + NL
    t = t + "    IF x >= 410 AND x < 540 THEN ShowTab(""DOWNLOADS"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Banner_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    line = Current()" + NL
    t = t + "    banner.Tag = """"" + NL
    t = t + "    DrawBanner(Field(line, 0))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Each item's banner, drawn." + NL
    t = t + "SUB DrawBanner (id AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF banner.Tag = id AND id <> """" THEN RETURN" + NL
    t = t + "    banner.Tag = id" + NL
    t = t + "    banner.Clear()" + NL
    t = t + "    SELECT CASE id" + NL
    t = t + "        CASE ""SIMDOOM""" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "            FOR i = 0 TO 54" + NL
    t = t + "                banner.SetColor(9 - 8 * (i MOD 2))" + NL
    t = t + "                banner.FillRect(i * 8, 60 + Rnd(25), 8, 40)" + NL
    t = t + "                banner.SetColor(11)" + NL
    t = t + "                banner.FillRect(i * 8 + 2, 84 + Rnd(10), 4, 16)" + NL
    t = t + "            NEXT" + NL
    t = t + "            banner.SetColor(1)" + NL
    t = t + "            banner.Text(152, 30, ""S I M D O O M"")" + NL
    t = t + "            banner.SetColor(9)" + NL
    t = t + "            banner.Text(150, 28, ""S I M D O O M"")" + NL
    t = t + "        CASE ""SNAKE""" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "            FOR i = 0 TO 20" + NL
    t = t + "                banner.SetColor(2)" + NL
    t = t + "                banner.FillRect(60 + i * 12, 50 + Int(10 * MATH.Sin(i / 2)), 10, 10)" + NL
    t = t + "            NEXT" + NL
    t = t + "            banner.SetColor(9)" + NL
    t = t + "            banner.FillCircle(360, 55, 5)" + NL
    t = t + "            banner.SetColor(10)" + NL
    t = t + "            banner.Text(170, 14, ""SNAKE 95"")" + NL
    t = t + "        CASE ""HL3""" + NL
    t = t + "            banner.SetColor(3)" + NL
    t = t + "            banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "            banner.SetColor(11)" + NL
    t = t + "            banner.FillCircle(70, 50, 34)" + NL
    t = t + "            banner.SetColor(3)" + NL
    t = t + "            banner.FillCircle(70, 50, 28)" + NL
    t = t + "            banner.SetColor(11)" + NL
    t = t + "            banner.Line(58, 30, 82, 72)" + NL
    t = t + "            banner.Line(70, 50, 56, 72)" + NL
    t = t + "            banner.SetColor(15)" + NL
    t = t + "            banner.Text(130, 34, ""HALF-LIFE 3"")" + NL
    t = t + "            banner.SetColor(11)" + NL
    t = t + "            banner.Text(130, 56, ""Coming soon(TM)"")" + NL
    t = t + "        CASE ""SIMXPLOR""" + NL
    t = t + "            Plate(1, 15, ""Simxplorer"")" + NL
    t = t + "            banner.SetColor(12)" + NL
    t = t + "            FOR i = 0 TO 15" + NL
    t = t + "                banner.FillCircle(60 + Int(14 * MATH.Cos((-40 - i * 15) * MATH.Pi / 180)), 36 + Int(11 * MATH.Sin((-40 - i * 15) * MATH.Pi / 180)), 4)" + NL
    t = t + "                banner.FillCircle(60 + Int(14 * MATH.Cos((-90 + i * 15) * MATH.Pi / 180)), 58 + Int(11 * MATH.Sin((-90 + i * 15) * MATH.Pi / 180)), 4)" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""FROSTBRD""" + NL
    t = t + "            Plate(14, 4, ""Frostbird"")" + NL
    t = t + "            banner.SetColor(15)" + NL
    t = t + "            banner.FillRect(30, 30, 60, 40)" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.Rect(30, 30, 60, 40)" + NL
    t = t + "            banner.Line(30, 30, 60, 52)" + NL
    t = t + "            banner.Line(60, 52, 89, 30)" + NL
    t = t + "        CASE ""CLIPPY""" + NL
    t = t + "            Plate(11, 0, ""Clippy"")" + NL
    t = t + "            banner.SetColor(8)" + NL
    t = t + "            banner.Rect(50, 18, 20, 66)" + NL
    t = t + "            banner.Rect(56, 26, 10, 46)" + NL
    t = t + "            banner.SetColor(15)" + NL
    t = t + "            banner.FillCircle(54, 40, 6)" + NL
    t = t + "            banner.FillCircle(70, 40, 6)" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.FillCircle(55, 41, 2)" + NL
    t = t + "            banner.FillCircle(71, 41, 2)" + NL
    t = t + "        CASE ""SIMBOOK""" + NL
    t = t + "            Plate(4, 15, ""[simbook]"")" + NL
    t = t + "        CASE ""COLDMAIL""" + NL
    t = t + "            Plate(14, 4, ""ColdMail!"")" + NL
    t = t + "        CASE ""ASKSIM""" + NL
    t = t + "            Plate(5, 15, ""AskSim"")" + NL
    t = t + "            banner.SetColor(7)" + NL
    t = t + "            banner.FillCircle(60, 40, 16)" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.FillRect(44, 58, 32, 30)" + NL
    t = t + "        CASE ""ELIZA""" + NL
    t = t + "            Plate(6, 15, ""ELIZA-95"")" + NL
    t = t + "        CASE """"" + NL
    t = t + "            banner.SetColor(7)" + NL
    t = t + "            banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            Plate(4, 15, id)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A plain banner: a colour, and the name in big letters." + NL
    t = t + "SUB Plate (back AS Integer, ink AS Integer, name AS String)" + NL
    t = t + "    banner.SetColor(back)" + NL
    t = t + "    banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "    banner.SetColor(8)" + NL
    t = t + "    banner.Text(132, 42, name)" + NL
    t = t + "    banner.SetColor(ink)" + NL
    t = t + "    banner.Text(130, 40, name)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ menus" + NL
    t = t + "" + NL
    t = t + "SUB Menu_OnSelect (item AS String)" + NL
    t = t + "    SELECT CASE item" + NL
    t = t + "        CASE ""Store""" + NL
    t = t + "            ShowTab(""STORE"")" + NL
    t = t + "        CASE ""Library""" + NL
    t = t + "            ShowTab(""LIBRARY"")" + NL
    t = t + "        CASE ""Downloads""" + NL
    t = t + "            ShowTab(""DOWNLOADS"")" + NL
    t = t + "        CASE ""Update All""" + NL
    t = t + "            UpdateAll()" + NL
    t = t + "        CASE ""Change Store...""" + NL
    t = t + "            ChangeStore()" + NL
    t = t + "        CASE ""Publish Apps...""" + NL
    t = t + "            Publish()" + NL
    t = t + "        CASE ""Refresh""" + NL
    t = t + "            wantCatalog = TRUE" + NL
    t = t + "        CASE ""Exit""" + NL
    t = t + "            win.Close()" + NL
    t = t + "        CASE ""About Vapor""" + NL
    t = t + "            Say(""Vapor 2.0 for SIM95 (build "" + MyVersion() + "")"" + EOL + EOL + ""Games, programs and web apps from any machine that runs a Vapor store (http://machine/vapor/): downloads, a library with updates, play time and achievements."" + EOL + EOL + ""Half-Life 3 is coming soon."", ""info"")" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "VAR askWin AS GUI_Window" + NL
    t = t + "VAR askBox AS GUI_TextBox" + NL
    t = t + "" + NL
    t = t + "SUB ChangeStore ()" + NL
    t = t + "    VAR l AS GUI_Label" + NL
    t = t + "    VAR b AS GUI_Button" + NL
    t = t + "    askWin = GUI_Window.New(""Vapor Store"", 360, 110)" + NL
    t = t + "    askWin.Modal = TRUE" + NL
    t = t + "    l = GUI_Label.New(askWin)" + NL
    t = t + "    l.Text = ""Which machine is your store? (Any machine with Vapor"" + EOL + ""installed is one: type its name, like alpha, or a domain.)""" + NL
    t = t + "    l.SetBounds(10, 8, 340, 30)" + NL
    t = t + "    askBox = GUI_TextBox.New(askWin)" + NL
    t = t + "    askBox.Text = store" + NL
    t = t + "    askBox.SetBounds(10, 44, 340, 21)" + NL
    t = t + "    askBox.onEnter = Store_Ok" + NL
    t = t + "    b = GUI_Button.New(askWin)" + NL
    t = t + "    b.Text = ""OK""" + NL
    t = t + "    b.Default = TRUE" + NL
    t = t + "    b.SetBounds(272, 74, 78, 26)" + NL
    t = t + "    b.onClick = Store_Ok" + NL
    t = t + "    askWin.Center()" + NL
    t = t + "    askWin.Show()" + NL
    t = t + "    askBox.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Store_Ok ()" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = askBox.Text.Trim().Lower()" + NL
    t = t + "    IF s = """" THEN RETURN" + NL
    t = t + "    IF NOT s.StartsWith(""http://"") THEN s = ""http://"" + s" + NL
    t = t + "    IF s.Substring(7, s.Length - 7).IndexOf(""/"") < 0 THEN s = s + ""/vapor/""" + NL
    t = t + "    IF NOT s.EndsWith(""/"") THEN s = s + ""/""" + NL
    t = t + "    store = s" + NL
    t = t + "    SaveSettings()" + NL
    t = t + "    askWin.Close()" + NL
    t = t + "    catalog.Clear()" + NL
    t = t + "    wantCatalog = TRUE" + NL
    t = t + "    ShowTab(""STORE"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Say (text AS String, kind AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = ""Vapor""" + NL
    t = t + "    box.Kind = kind" + NL
    t = t + "    box.Text = text" + NL
    t = t + "    box.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' RESOLVE.SPK - the SimDNS resolver: asks the name server which machine a" + NL
    t = t + "' name like www.coolsite.sim is on." + NL
    t = t + "'" + NL
    t = t + "' The name server is the central one, STARTHERE.56k.net, where SimNIC (the" + NL
    t = t + "' registrar) and NAMED.SPK run, unless C:\SYSTEM\RESOLV.INI says otherwise." + NL
    t = t + "' To move the whole network to another central host, change RSCENTRAL below" + NL
    t = t + "' (the builder sets it from CENTRAL in tools/simxplorer-source.mjs)." + NL
    t = t + "'" + NL
    t = t + "' A library, not a program: a program has it joined on the end (the builder" + NL
    t = t + "' does this for Simxplorer, SimPlayer, Vapor, Frostbird, MAILD, the Sim Shell," + NL
    t = t + "' AskSim's crawler, DIG and Personal Web Manager; copy C:\PROGRAMS\RESOLVE.SPK" + NL
    t = t + "' onto the end of your own). Every name in it starts with Rs, so it can't clash." + NL
    t = t + "'" + NL
    t = t + "' C:\SYSTEM\RESOLV.INI, shared by every program on the machine (optional):" + NL
    t = t + "'     nameserver=dnsbox          another name server instead of the central one" + NL
    t = t + "'     nameserver=none            no SimDNS at all: SIM95 machine names only" + NL
    t = t + "'     search=coolsite.sim        then ""www"" means www.coolsite.sim" + NL
    t = t + "'" + NL
    t = t + "' How to use it without ever waiting in the wrong place (SIM95-NOTES.md):" + NL
    t = t + "'   1. RsWants(host)  - does this name need asking? FALSE for addresses," + NL
    t = t + "'                       plain machine names, names already known, or when" + NL
    Put("C:\WEB\VAPOR\VAPOR\3.TXT")
END SUB

SUB File27 ()
    t = ""
    t = t + "'                       there is no name server (or it isn't answering)." + NL
    t = t + "'   2. RsAsk(host, address) - sends the question to the name server at that" + NL
    t = t + "'                       address. It is a Connect: let it be the last thing" + NL
    t = t + "'                       the handler does." + NL
    t = t + "'   3. RsBusy()       - TRUE while the answer is on its way. After RSWAIT" + NL
    t = t + "'                       with no answer the server is left alone for RSQUIET," + NL
    t = t + "'                       and every name goes to SIM95 as before." + NL
    t = t + "'   4. RsTarget(host) - where to connect: the machine name (or address) the" + NL
    t = t + "'                       name server gave, or the name itself when SimDNS" + NL
    t = t + "'                       doesn't know it, for SIM95 to look up." + NL
    t = t + "' Answers are kept for their TTL; names SimDNS doesn't know for RSNEG." + NL
    t = t + "'" + NL
    t = t + "' Or, from a timer tick, all of that in one line (see RsNext):" + NL
    t = t + "'     IF RsNext(host) THEN RETURN          ' asked, or waiting: end the tick" + NL
    t = t + "'     conn = sock.Connect(RsTarget(host), 80)" + NL
    t = t + "' and for mail, the domain's MX first (see RsNextMail):" + NL
    t = t + "'     IF RsNextMail(domain) THEN RETURN" + NL
    t = t + "'     conn = sock.Connect(RsMailTarget(domain), 25)" + NL
    t = t + "" + NL
    t = t + "CONST RSCENTRAL = ""starthere.56k.net""   ' the central name server" + NL
    t = t + "CONST RSINI = ""C:\SYSTEM\RESOLV.INI""" + NL
    t = t + "CONST RSPORT = 53" + NL
    t = t + "CONST RSWAIT = 2000             ' ms to wait for an answer" + NL
    t = t + "CONST RSQUIET = 30000            ' ms to leave a silent name server alone" + NL
    t = t + "CONST RSNEG = 60000             ' ms to remember that SimDNS doesn't know a name" + NL
    t = t + "CONST RSMOST = 100              ' names kept" + NL
    t = t + "" + NL
    t = t + "VAR rsServer AS String              ' """" when SimDNS is off" + NL
    t = t + "VAR rsByDefault AS Bool               ' TRUE when RESOLV.INI doesn't name one" + NL
    t = t + "VAR rsSearch AS String" + NL
    t = t + "VAR rsRead AS Bool" + NL
    t = t + "VAR rsReadAt AS Integer" + NL
    t = t + "VAR rsSock AS NET_Socket" + NL
    t = t + "VAR rsName AS Array OF String       ' the name as asked, lower case" + NL
    t = t + "VAR rsTo AS Array OF String         ' where it is ("""" when SimDNS doesn't know it)" + NL
    t = t + "VAR rsCanon AS Array OF String      ' its last name in DNS before the machine" + NL
    t = t + "VAR rsUntil AS Array OF Integer     ' SYS.Ticks when it is forgotten" + NL
    t = t + "VAR rsAsking AS String" + NL
    t = t + "VAR rsAskAt AS Integer" + NL
    t = t + "VAR rsRefused AS Bool" + NL
    t = t + "VAR rsDown AS Bool" + NL
    t = t + "VAR rsDownAt AS Integer" + NL
    t = t + "VAR rsWhy AS String                 ' the last thing that went wrong" + NL
    t = t + "VAR rsLastReply AS String           ' the last answer, as it came" + NL
    t = t + "VAR rsServerAddr AS String          ' the name server's address, for RsNext" + NL
    t = t + "VAR rsServerFor AS String" + NL
    t = t + "VAR rsServerAt AS Integer" + NL
    t = t + "VAR rsLooking AS Bool               ' RsNext is finding the name server's address" + NL
    t = t + "VAR rsLookingAt AS Integer" + NL
    t = t + "" + NL
    t = t + "' Reads RESOLV.INI (again after a few seconds, so a new setting takes)." + NL
    t = t + "' With no nameserver= line, the central name server; none (or nothing after" + NL
    t = t + "' the =) turns SimDNS off." + NL
    t = t + "SUB RsConfig ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    IF rsRead AND SYS.Ticks - rsReadAt < 3000 THEN RETURN" + NL
    t = t + "    rsRead = TRUE" + NL
    t = t + "    rsReadAt = SYS.Ticks" + NL
    t = t + "    rsServer = RSCENTRAL" + NL
    t = t + "    rsByDefault = TRUE" + NL
    t = t + "    rsSearch = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                low = line.Trim().Lower()" + NL
    t = t + "                IF low.StartsWith(""nameserver="") THEN" + NL
    t = t + "                    rsServer = low.Substring(11, low.Length - 11).Trim()" + NL
    t = t + "                    rsByDefault = FALSE" + NL
    t = t + "                END IF" + NL
    t = t + "                IF low.StartsWith(""search="") THEN rsSearch = low.Substring(7, low.Length - 7).Trim()" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF rsServer = ""none"" THEN rsServer = """"" + NL
    t = t + "    IF rsSearch.StartsWith(""."") THEN rsSearch = rsSearch.Substring(1, rsSearch.Length - 1)" + NL
    t = t + "    IF rsSearch.EndsWith(""."") THEN rsSearch = rsSearch.Substring(0, rsSearch.Length - 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The name server (a machine name or address), or """" for none." + NL
    t = t + "FUNCTION RsNameServer () AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsServer" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is it the central one, because RESOLV.INI doesn't say?" + NL
    t = t + "FUNCTION RsIsCentral () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsByDefault" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Makes server this machine's name server, keeping the rest of RESOLV.INI," + NL
    t = t + "' and forgets everything it knew. """" (or none) for no SimDNS at all;" + NL
    t = t + "' default for the central one again." + NL
    t = t + "SUB RsSave (server AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    server = server.Trim().Lower()" + NL
    t = t + "    IF server = """" THEN server = ""none""" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                IF line.Trim() <> """" AND NOT line.Trim().Lower().StartsWith(""nameserver="") THEN out.Add(line)" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "        IF server <> ""default"" THEN out.Insert(0, ""nameserver="" + server)" + NL
    t = t + "        IF out.Count = 0 THEN" + NL
    t = t + "            IF FS.Exists(RSINI) THEN FS.Delete(RSINI)" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Write(RSINI, out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsWhy = err" + NL
    t = t + "    END TRY" + NL
    t = t + "    rsRead = FALSE" + NL
    t = t + "    RsForget()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RsForget ()" + NL
    t = t + "    rsName.Clear()" + NL
    t = t + "    rsTo.Clear()" + NL
    t = t + "    rsCanon.Clear()" + NL
    t = t + "    rsUntil.Clear()" + NL
    t = t + "    rsDown = FALSE" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsIsAddress (s AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF s.Split(""."").Count <> 4 THEN RETURN FALSE" + NL
    t = t + "    FOR EACH p IN s.Split(""."")" + NL
    t = t + "        IF p = """" OR p.Length > 3 THEN RETURN FALSE" + NL
    t = t + "        FOR i = 0 TO p.Length - 1" + NL
    t = t + "            IF NOT ""0123456789"".Contains(p.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name the server is asked about: lower case, the search domain added" + NL
    t = t + "' to a single word." + NL
    t = t + "FUNCTION RsFull (host AS String) AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF h.EndsWith(""."") THEN h = h.Substring(0, h.Length - 1)" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch <> """" THEN h = h + ""."" + rsSearch" + NL
    t = t + "    RETURN h" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a name is in the list of answers, or -1 (old answers are dropped)." + NL
    t = t + "FUNCTION RsFind (host AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = rsName.IndexOf(host.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN -1" + NL
    t = t + "    IF SYS.Ticks > rsUntil[i] THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "        RETURN -1" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsWants (host AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(host) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(host) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for a mail domain's MX record." + NL
    t = t + "FUNCTION RsWantsMx (domain AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(domain) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(""mx:"" + domain.Trim().Lower()) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is host a name for the name server at all (whether known yet or not)?" + NL
    t = t + "FUNCTION RsAsks (host AS String) AS Bool" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF rsServer = """" OR h = """" OR h = ""localhost"" THEN RETURN FALSE" + NL
    t = t + "    IF rsDown AND SYS.Ticks - rsDownAt < RSQUIET THEN RETURN FALSE" + NL
    t = t + "    IF RsIsAddress(h) THEN RETURN FALSE" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch = """" THEN RETURN FALSE" + NL
    t = t + "    IF h = rsServer OR h = NET.HostName.Lower() THEN RETURN FALSE" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Sends the question. A Connect, so it must be the last thing its handler" + NL
    t = t + "' does: if the name server refuses, the handler is spoiled (SIM95-NOTES.md)." + NL
    t = t + "SUB RsAsk (host AS String, address AS String)" + NL
    t = t + "    RsSend(host.Trim().Lower(), ""A"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Asks for a mail domain's MX records (also a Connect: the last thing)." + NL
    t = t + "SUB RsAskMx (domain AS String, address AS String)" + NL
    t = t + "    RsSend(""mx:"" + domain.Trim().Lower(), ""MX"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' key is the name, or mx: and the name; the answer is kept under it." + NL
    t = t + "SUB RsSend (key AS String, qtype AS String, address AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    IF IsNothing(rsSock) THEN" + NL
    t = t + "        rsSock = NET_Socket.New()" + NL
    t = t + "        rsSock.onMessage = Rs_OnMessage" + NL
    t = t + "    END IF" + NL
    t = t + "    name = key" + NL
    t = t + "    IF name.StartsWith(""mx:"") THEN name = name.Substring(3, name.Length - 3)" + NL
    t = t + "    rsAsking = key" + NL
    t = t + "    rsAskAt = SYS.Ticks" + NL
    t = t + "    rsRefused = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = rsSock.Connect(address, RSPORT)" + NL
    t = t + "        conn.Tag = ""rs:"" + key" + NL
    t = t + "        conn.Send(""QUERY "" + RsFull(name) + "" "" + qtype)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsRefused = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Gives up on the name server for a while: every name goes to SIM95." + NL
    t = t + "SUB RsGiveUp (why AS String)" + NL
    t = t + "    rsWhy = why" + NL
    t = t + "    rsDown = TRUE" + NL
    t = t + "    rsDownAt = SYS.Ticks" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "    rsServerAddr = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' For a program that fetches from a timer tick: TRUE when the tick must end" + NL
    t = t + "' now, because a question about host has just been sent (a Connect, so it" + NL
    t = t + "' has to be the last thing the handler does) or an answer is on its way." + NL
    t = t + "' FALSE when there is nothing to ask: RsTarget(host) is where to connect." + NL
    t = t + "' A name server that is missing, refuses or says nothing for RSWAIT is left" + NL
    t = t + "' alone for RSQUIET, and every name goes to SIM95: nothing ever hangs." + NL
    t = t + "FUNCTION RsNext (host AS String) AS Bool" + NL
    t = t + "    RETURN RsStep(host, FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for mail to domain: its MX record (the lowest preference), then" + NL
    t = t + "' the CNAMEs or address of the machine that names. RsMailTarget(domain) is" + NL
    t = t + "' then where to connect; with no MX, the domain's own machine; with no" + NL
    t = t + "' answer at all, the domain itself, for SIM95 to look up." + NL
    t = t + "FUNCTION RsNextMail (domain AS String) AS Bool" + NL
    t = t + "    IF RsStep(domain, TRUE) THEN RETURN TRUE" + NL
    t = t + "    RETURN RsStep(RsMailHost(domain), FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsStep (host AS String, mx AS Bool) AS Bool" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    ' another handler is finding the name server (it waits): wait for it" + NL
    t = t + "    IF rsLooking THEN" + NL
    t = t + "        IF SYS.Ticks - rsLookingAt < RSWAIT THEN RETURN TRUE" + NL
    t = t + "        rsLooking = FALSE" + NL
    t = t + "        RsGiveUp(""no answer about the machine "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF RsBusy() THEN RETURN TRUE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        IF NOT RsWantsMx(host) THEN RETURN FALSE" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF NOT RsWants(host) THEN RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    addr = RsServerAddress()" + NL
    t = t + "    IF addr = """" THEN RETURN FALSE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        RsAskMx(host, addr)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsAsk(host, addr)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name server's address, looked up once a minute (one lookup at a time:" + NL
    t = t + "' see SIM95-NOTES.md). """" when there is no such machine, and then it gives up." + NL
    t = t + "FUNCTION RsServerAddress () AS String" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    IF RsIsAddress(rsServer) THEN RETURN rsServer" + NL
    t = t + "    IF rsServerAddr <> """" AND rsServerFor = rsServer AND SYS.Ticks - rsServerAt < 60000 AND SYS.Ticks >= rsServerAt THEN RETURN rsServerAddr" + NL
    t = t + "    rsLooking = TRUE" + NL
    t = t + "    rsLookingAt = SYS.Ticks" + NL
    t = t + "    addr = NET.Resolve(rsServer)" + NL
    t = t + "    IF NOT rsLooking THEN RETURN """"" + NL
    t = t + "    rsLooking = FALSE" + NL
    t = t + "    IF addr = """" THEN" + NL
    t = t + "        RsGiveUp(""there is no machine called "" + rsServer)" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    rsServerAddr = addr" + NL
    t = t + "    rsServerFor = rsServer" + NL
    t = t + "    rsServerAt = SYS.Ticks" + NL
    t = t + "    RETURN addr" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsBusy () AS Bool" + NL
    t = t + "    IF rsAsking = """" THEN RETURN FALSE" + NL
    t = t + "    IF rsRefused THEN" + NL
    t = t + "        RsGiveUp(""the name server "" + rsServer + "" refused"")" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF SYS.Ticks - rsAskAt > RSWAIT THEN" + NL
    t = t + "        RsGiveUp(""no answer from the name server "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Rs_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    IF NOT conn.Tag.StartsWith(""rs:"") THEN RETURN" + NL
    t = t + "    h = conn.Tag.Substring(3, conn.Tag.Length - 3)" + NL
    t = t + "    conn.Tag = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        conn.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    RsTake(h, message)" + NL
    t = t + "    IF h = rsAsking THEN rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an answer: follows its CNAMEs to an address, or to the machine" + NL
    t = t + "' name the chain ends at." + NL
    t = t + "SUB RsTake (host AS String, reply AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR onward AS String" + NL
    t = t + "    VAR target AS String" + NL
    t = t + "    VAR canon AS String" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR hops AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    rsLastReply = reply" + NL
    t = t + "    IF host.StartsWith(""mx:"") THEN" + NL
    t = t + "        RsTakeMx(host, reply)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(host, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(host, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    cur = RsFull(host)" + NL
    t = t + "    canon = cur" + NL
    t = t + "    FOR hops = 0 TO 8" + NL
    t = t + "        onward = """"" + NL
    t = t + "        FOR i = 1 TO lines.Count - 1" + NL
    t = t + "            w = lines[i].Split("" "")" + NL
    t = t + "            IF w.Count >= 4 THEN" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""A"" AND target = """" THEN target = w[3]" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""CNAME"" THEN onward = w[3]" + NL
    t = t + "                IF w[0] = cur AND (w[2] = ""A"" OR w[2] = ""CNAME"") AND Int(Val(w[1])) < ttl THEN ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF target <> """" THEN" + NL
    t = t + "            canon = cur" + NL
    t = t + "            BREAK" + NL
    t = t + "        END IF" + NL
    t = t + "        IF onward = """" THEN BREAK" + NL
    t = t + "        canon = cur" + NL
    t = t + "        cur = onward" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF target = """" THEN" + NL
    t = t + "        ' a name with no CNAME and no address: not one to connect to" + NL
    t = t + "        IF cur = RsFull(host) THEN" + NL
    t = t + "            RsKeep(host, """", """", RSNEG)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        ' the end of the chain: a SIM95 machine name" + NL
    t = t + "        target = cur" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ttl < 5 THEN ttl = 5" + NL
    t = t + "    RsKeep(host, target, canon, ttl * 1000)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an MX answer: the mail machine with the lowest preference. With no" + NL
    t = t + "' MX, the server answers with the domain's CNAMEs instead, and the domain's" + NL
    t = t + "' own machine takes the mail." + NL
    t = t + "SUB RsTakeMx (key AS String, reply AS String)" + NL
    t = t + "    VAR domain AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR best AS String" + NL
    t = t + "    VAR pref AS Integer = 1000000" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    domain = key.Substring(3, key.Length - 3)" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(key, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RsKeep(domain, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(key, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 1 TO lines.Count - 1" + NL
    t = t + "        w = lines[i].Split("" "")" + NL
    t = t + "        IF w.Count >= 5 THEN" + NL
    t = t + "            IF w[2] = ""MX"" AND Int(Val(w[3])) < pref THEN" + NL
    t = t + "                pref = Int(Val(w[3]))" + NL
    t = t + "                best = w[4]" + NL
    t = t + "                ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF best <> """" THEN" + NL
    t = t + "        IF best.EndsWith(""."") THEN best = best.Substring(0, best.Length - 1)" + NL
    t = t + "        IF ttl < 5 THEN ttl = 5" + NL
    t = t + "        RsKeep(key, best, RsFull(domain), ttl * 1000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    RsTake(domain, reply)" + NL
    t = t + "    IF RsKnown(domain) THEN" + NL
    t = t + "        RsKeep(key, domain, RsFull(domain), RSNEG)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsKeep(key, """", """", RSNEG)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The machine (or name) that takes domain's mail: its MX, or domain itself." + NL
    t = t + "FUNCTION RsMailHost (domain AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN domain" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN domain" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where to connect for domain's mail." + NL
    Put("C:\WEB\VAPOR\VAPOR\4.TXT")
END SUB

SUB File28 ()
    t = ""
    t = t + "FUNCTION RsMailTarget (domain AS String) AS String" + NL
    t = t + "    RETURN RsTarget(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS say where domain's mail goes (an MX, or the domain's machine)?" + NL
    t = t + "FUNCTION RsMailKnown (domain AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN FALSE" + NL
    t = t + "    RETURN RsKnown(RsMailHost(domain)) OR NOT RsAsks(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB RsKeep (host AS String, target AS String, canon AS String, ms AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    i = rsName.IndexOf(h)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF rsName.Count >= RSMOST THEN" + NL
    t = t + "        rsName.RemoveAt(0)" + NL
    t = t + "        rsTo.RemoveAt(0)" + NL
    t = t + "        rsCanon.RemoveAt(0)" + NL
    t = t + "        rsUntil.RemoveAt(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    rsName.Add(h)" + NL
    t = t + "    rsTo.Add(target)" + NL
    t = t + "    rsCanon.Add(canon)" + NL
    t = t + "    rsUntil.Add(SYS.Ticks + ms)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where to connect for host: what SimDNS said, or host itself." + NL
    t = t + "FUNCTION RsTarget (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name host's machine was found under (www.coolsite.sim), or host." + NL
    t = t + "FUNCTION RsCanonical (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsCanon[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS answer for host (so RsTarget is its machine)?" + NL
    t = t + "FUNCTION RsKnown (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] <> """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did the name server say there is no such name (NXDOMAIN)?" + NL
    t = t + "FUNCTION RsNoSuchName (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] = """" AND rsCanon[i] = ""NXDOMAIN""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is the name server being left alone, because it didn't answer (or there" + NL
    t = t + "' is none)? rsWhy says why." + NL
    t = t + "FUNCTION RsSilent () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    IF rsServer = """" THEN RETURN TRUE" + NL
    t = t + "    RETURN rsDown AND SYS.Ticks - rsDownAt < RSQUIET" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\WEB\VAPOR\VAPOR\5.TXT")
END SUB

SUB File29 ()
    t = ""
    t = t + "SIMDOOM|SimDOOM|2|23549|ok|Shooter|Rip and tear through E1M1 in glorious 16 colours. A real raycast 3D view, imps that chase you, a pistol, health and ammo, a face that watches you, and achievements. Type IDDQD at your own risk.|game|c0f9cfa6|C:\GAMES\SIMDOOM\SIMDOOM.SPK|C:\GAMES\SIMDOOM\SIMDOOM.SPK|SIMDOOM||" + NL
    t = t + "SNAKE|Snake 95|1|5545|ok|Arcade|Eat the dots. Grow longer. Don't eat yourself. The game that sold a million phones, now on SIM95.|game|aa5d9aeb|C:\GAMES\SNAKE\SNAKE.SPK|C:\GAMES\SNAKE\SNAKE.SPK|SNAKE||" + NL
    t = t + "HL3|Half-Life 3|0|0|soon|Shooter|The long-awaited conclusion. Coming soon.|game|||||" + NL
    t = t + "SIMPLAYR|SimPlayer|6|84904|ok|Multimedia|The movie player for SIM95: plays SimMovies from the disk or streams them from the web, like the ones on SimTube. (Simxplorer has it built in.)|program|68f17303|C:\PROGRAMS\PLAYER.SPK|C:\PROGRAMS\PLAYER.SPK|PLAYER||" + NL
    t = t + "SIMWEB|simweb|12|173832|ok|Internet|Personal Web Manager and a web server that serves many sites by name: coolsite.sim for your own pages, coolbook.sim for SimBook. Register and point the names at SimNIC; then add them here. With DIG, to ask the name server.|program|b0fb52c6|C:\PROGRAMS\PWM.SPK|C:\PROGRAMS\PWM.SPK;C:\PROGRAMS\DIG.SPK;C:\PROGRAMS\RESOLVE.SPK|PWM||" + NL
    t = t + "VAPOR|Vapor|5|62052|ok|Vapor|The Vapor program itself.|client|61f71a2e|C:\PROGRAMS\VAPOR.SPK|C:\PROGRAMS\VAPOR.SPK|VAPOR||" + NL
    Put("C:\WEB\VAPOR\CATALOG.TXT")
END SUB

SUB File30 ()
    t = ""
    t = t + "' VAPOR|id=VAPOR|name=Vapor|kind=client|version=61f71a2e|category=Vapor|run=C:\PROGRAMS\VAPOR.SPK|files=C:\PROGRAMS\VAPOR.SPK|tasks=VAPOR|startup=|folder=|about=The Vapor program itself." + NL
    t = t + "' VAPOR.SPK - Vapor, the store and library for everything on SIM95: games," + NL
    t = t + "' programs (Simxplorer, Frostbird, Clippy...) and web apps (SimBook, ColdMail," + NL
    t = t + "' AskSim, ELIZA-95)." + NL
    t = t + "'" + NL
    t = t + "' A store is a folder on a web server, http://<machine>/vapor/, holding" + NL
    t = t + "' CATALOG.TXT, one item per line:" + NL
    t = t + "'   id|name|parts|bytes|status|category|about|kind|version|run|files|tasks|startup" + NL
    t = t + "' and each item cut into parts small enough for a network message" + NL
    t = t + "' (/vapor/<id>/<n>.txt). An item is a file that starts with a header line," + NL
    t = t + "'   ' VAPOR|id=...|name=...|kind=...|version=...|..." + NL
    t = t + "' kind says what to do with it once it is here:" + NL
    t = t + "'   game     it is the game: kept in C:\GAMES\<id>\<id>.SPK and played from there" + NL
    t = t + "'   program  it is an installer: Vapor runs it, then ""run"" opens the program" + NL
    t = t + "'   service  the same, for something that starts with the machine (Clippy)" + NL
    t = t + "'   web      an installer for a web app, which becomes this machine's home page" + NL
    t = t + "'   client   Vapor itself: a new version replaces this program, which restarts" + NL
    t = t + "'" + NL
    t = t + "' The library (C:\GAMES\LIBRARY.TXT) remembers what is installed, which" + NL
    t = t + "' version, and the time played. When the store has a newer version of" + NL
    t = t + "' something, the Library offers Update (or Update All)." + NL
    t = t + "'" + NL
    t = t + "' On a store machine, Publish Apps puts every installer saved in C:\MYFILES" + NL
    t = t + "' that has a header (all the ones tools/build-installer.mjs makes) into the" + NL
    t = t + "' store, replacing older versions: that is how a store's shelves are stocked" + NL
    t = t + "' and updated." + NL
    t = t + "'" + NL
    t = t + "' Fetches go one at a time and start in a timer tick of their own, inside a" + NL
    t = t + "' TRY with an empty CATCH (see SIM95-NOTES.md); pages come in through the" + NL
    t = t + "' socket's events." + NL
    t = t + "'" + NL
    t = t + "' A store can be at a SimDNS name (http://store.coolsite.sim/vapor/): the" + NL
    t = t + "' builder joins the resolver (simweb/src/RESOLVE.SPK, the Rs... names) on the" + NL
    t = t + "' end, and the name is asked about in a tick of its own before the fetch." + NL
    t = t + "' The connection goes to the machine the name server names; the request" + NL
    t = t + "' still says Host: store.coolsite.sim, so a web server with sites finds it." + NL
    t = t + "" + NL
    t = t + "CONST HOME = ""C:\GAMES""" + NL
    t = t + "CONST ME = ""C:\PROGRAMS\VAPOR.SPK""" + NL
    t = t + "CONST STOREDIR = ""C:\WEB\VAPOR""" + NL
    t = t + "CONST BROWSER = ""C:\PROGRAMS\SIMXPLOR.SPK""" + NL
    t = t + "CONST PATIENCE = 8000" + NL
    t = t + "CONST PART = 15000" + NL
    t = t + "CONST WEBAPPS = ""C:\SYSTEM\WEBAPPS.INI""" + NL
    t = t + "" + NL
    t = t + "VAR EOL AS String" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR bar AS GUI_Menu" + NL
    t = t + "VAR head AS GUI_Canvas" + NL
    t = t + "VAR games AS GUI_ListBox" + NL
    t = t + "VAR banner AS GUI_Canvas" + NL
    t = t + "VAR title AS GUI_Label" + NL
    t = t + "VAR info AS GUI_Label" + NL
    t = t + "VAR about AS GUI_Label" + NL
    t = t + "VAR action AS GUI_Button" + NL
    t = t + "VAR upd AS GUI_Button" + NL
    t = t + "VAR remove AS GUI_Button" + NL
    t = t + "VAR progress AS GUI_ProgressBar" + NL
    t = t + "VAR note AS GUI_Label" + NL
    t = t + "VAR trophies AS GUI_ListBox" + NL
    t = t + "VAR clock AS GUI_Timer" + NL
    t = t + "VAR web AS NET_Socket" + NL
    t = t + "" + NL
    t = t + "VAR store AS String               ' ""http://alpha/vapor/""" + NL
    t = t + "VAR tab AS String = ""STORE""" + NL
    t = t + "VAR catalog AS Array OF String    ' the store's lines" + NL
    t = t + "VAR listed AS Array OF String     ' the lines behind the list, in order ("""" for a heading)" + NL
    t = t + "VAR offeredSelf AS Bool           ' asked once about a newer Vapor" + NL
    t = t + "" + NL
    t = t + "' one fetch at a time" + NL
    t = t + "VAR fetching AS Bool" + NL
    t = t + "VAR fWhat AS String               ' ""catalog"" or ""part""" + NL
    t = t + "VAR fNumber AS Integer" + NL
    t = t + "VAR fParts AS Array OF String" + NL
    t = t + "VAR fDone AS Bool" + NL
    t = t + "VAR fSince AS Integer" + NL
    t = t + "VAR fError AS String" + NL
    t = t + "VAR wantCatalog AS Bool" + NL
    t = t + "" + NL
    t = t + "' the download going on, and what is waiting" + NL
    t = t + "VAR dlId AS String                ' """" when none" + NL
    t = t + "VAR dlLine AS String" + NL
    t = t + "VAR dlPart AS Integer" + NL
    t = t + "VAR dlParts AS Integer" + NL
    t = t + "VAR dlText AS String" + NL
    t = t + "VAR dlStart AS Integer" + NL
    t = t + "VAR queue AS Array OF String      ' catalog lines waiting" + NL
    t = t + "VAR setupPid AS Integer           ' an installer Vapor is running" + NL
    t = t + "VAR setupLine AS String" + NL
    t = t + "VAR setupSince AS Integer" + NL
    t = t + "" + NL
    t = t + "' things running: id and process" + NL
    t = t + "VAR playId AS Array OF String" + NL
    t = t + "VAR playPid AS Array OF Integer" + NL
    t = t + "VAR playSince AS Array OF Integer" + NL
    t = t + "" + NL
    t = t + "' ================================================================ start" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    EOL = Chr(10)" + NL
    t = t + "    IF NOT FS.Exists(HOME) THEN FS.MakeDir(HOME)" + NL
    t = t + "    LoadSettings()" + NL
    t = t + "    win = GUI_Window.New(""Vapor"", 640, 420)" + NL
    t = t + "    win.Icon = ""app""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    bar = GUI_Menu.New(win)" + NL
    t = t + "    bar.onSelect = Menu_OnSelect" + NL
    t = t + "    bar.AddMenu(""&Vapor"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Store"" + Chr(9) + ""Ctrl+1"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Library"" + Chr(9) + ""Ctrl+2"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Downloads"" + Chr(9) + ""Ctrl+3"")" + NL
    t = t + "    bar.AddSeparator(""&Vapor"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Update All"" + Chr(9) + ""Ctrl+U"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Refresh"" + Chr(9) + ""F5"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""Change S&tore..."")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""&Publish Apps..."" + Chr(9) + ""Ctrl+P"")" + NL
    t = t + "    bar.AddSeparator(""&Vapor"")" + NL
    t = t + "    bar.AddItem(""&Vapor"", ""E&xit"")" + NL
    t = t + "    bar.AddMenu(""&Help"")" + NL
    t = t + "    bar.AddItem(""&Help"", ""&About Vapor"")" + NL
    t = t + "    bar.SetEnabled(""Publish Apps..."", FS.Exists(STOREDIR))" + NL
    t = t + "" + NL
    t = t + "    head = GUI_Canvas.New(win)" + NL
    t = t + "    head.SetBounds(0, 0, 640, 44)" + NL
    t = t + "    head.onDraw = Head_OnDraw" + NL
    t = t + "    head.onMouseDown = Head_OnMouseDown" + NL
    t = t + "    games = GUI_ListBox.New(win)" + NL
    t = t + "    games.SetBounds(6, 50, 180, 342)" + NL
    t = t + "    games.onSelect = Games_OnSelect" + NL
    t = t + "    games.onDblClick = Action_Click" + NL
    t = t + "    banner = GUI_Canvas.New(win)" + NL
    t = t + "    banner.SetBounds(194, 50, 440, 100)" + NL
    t = t + "    banner.onDraw = Banner_OnDraw" + NL
    t = t + "    title = GUI_Label.New(win)" + NL
    t = t + "    title.Bold = TRUE" + NL
    t = t + "    title.SetBounds(194, 156, 440, 16)" + NL
    t = t + "    info = GUI_Label.New(win)" + NL
    t = t + "    info.SetBounds(194, 174, 440, 14)" + NL
    t = t + "    about = GUI_Label.New(win)" + NL
    t = t + "    about.SetBounds(194, 194, 440, 64)" + NL
    t = t + "    action = GUI_Button.New(win)" + NL
    t = t + "    action.SetBounds(194, 262, 120, 28)" + NL
    t = t + "    action.onClick = Action_Click" + NL
    t = t + "    upd = GUI_Button.New(win)" + NL
    t = t + "    upd.Text = ""U&pdate""" + NL
    t = t + "    upd.SetBounds(322, 262, 100, 28)" + NL
    t = t + "    upd.onClick = Update_Click" + NL
    t = t + "    remove = GUI_Button.New(win)" + NL
    t = t + "    remove.Text = ""&Uninstall""" + NL
    t = t + "    remove.SetBounds(430, 262, 100, 28)" + NL
    t = t + "    remove.onClick = Remove_Click" + NL
    t = t + "    progress = GUI_ProgressBar.New(win)" + NL
    t = t + "    progress.SetBounds(194, 298, 440, 14)" + NL
    t = t + "    progress.Max = 100" + NL
    t = t + "    note = GUI_Label.New(win)" + NL
    t = t + "    note.SetBounds(194, 316, 440, 14)" + NL
    t = t + "    trophies = GUI_ListBox.New(win)" + NL
    t = t + "    trophies.SetBounds(194, 334, 440, 58)" + NL
    t = t + "" + NL
    t = t + "    web = NET_Socket.New()" + NL
    t = t + "    web.onMessage = Web_OnMessage" + NL
    t = t + "    web.onClose = Web_OnClose" + NL
    t = t + "    clock = GUI_Timer.New(win)" + NL
    t = t + "    clock.Interval = 100" + NL
    t = t + "    clock.onTick = Clock_OnTick" + NL
    t = t + "    clock.Start()" + NL
    t = t + "" + NL
    t = t + "    wantCatalog = store <> """"" + NL
    t = t + "    ShowTab(""STORE"")" + NL
    t = t + "    win.Show()" + NL
    t = t + "    IF store = """" THEN ChangeStore()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB LoadSettings ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(HOME + ""\VAPOR.INI"", """").Lines()" + NL
    t = t + "        IF line.StartsWith(""store="") THEN store = line.Substring(6, line.Length - 6).Trim()" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' a machine that is a store shops at itself to begin with" + NL
    t = t + "    IF store = """" AND FS.Exists(STOREDIR + ""\CATALOG.TXT"") THEN store = ""http://"" + NET.HostName.Lower() + ""/vapor/""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SaveSettings ()" + NL
    t = t + "    FS.Write(HOME + ""\VAPOR.INI"", ""store="" + store + EOL)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Field i of a | line, or """" when the line is shorter (older lines are)." + NL
    t = t + "FUNCTION Field (line AS String, i AS Integer) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    IF i >= p.Count THEN RETURN """"" + NL
    t = t + "    RETURN p[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' key=value from a header line." + NL
    t = t + "FUNCTION Meta (header AS String, key AS String) AS String" + NL
    t = t + "    VAR part AS String" + NL
    t = t + "    FOR EACH part IN header.Split(""|"")" + NL
    t = t + "        IF part.StartsWith(key + ""="") THEN RETURN part.Substring(key.Length + 1, part.Length - key.Length - 1)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The version of this Vapor, from its own header." + NL
    t = t + "FUNCTION MyVersion () AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    text = ReadOr(ME, """")" + NL
    t = t + "    IF NOT text.StartsWith(""' VAPOR|"") THEN RETURN """"" + NL
    t = t + "    RETURN Meta(text.Lines()[0], ""version"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ tabs and lists" + NL
    t = t + "" + NL
    t = t + "FUNCTION KindName (kind AS String) AS String" + NL
    t = t + "    SELECT CASE kind" + NL
    t = t + "        CASE ""game""" + NL
    t = t + "            RETURN ""Game""" + NL
    t = t + "        CASE ""web""" + NL
    t = t + "            RETURN ""Web app""" + NL
    t = t + "        CASE ""service""" + NL
    t = t + "            RETURN ""Program, starts with SIM95""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN ""Program""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB ShowTab (t AS String)" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR pass AS Integer" + NL
    t = t + "    VAR heading AS Bool" + NL
    t = t + "    VAR shelf AS Array OF String" + NL
    t = t + "    tab = t" + NL
    t = t + "    games.Clear()" + NL
    t = t + "    listed.Clear()" + NL
    t = t + "    IF t = ""STORE"" THEN" + NL
    t = t + "        ' apps first (A to Z), then games (as the store has them), each under a heading" + NL
    t = t + "        FOR pass = 0 TO 1" + NL
    t = t + "            heading = FALSE" + NL
    t = t + "            shelf.Clear()" + NL
    t = t + "            FOR EACH line IN catalog" + NL
    t = t + "                IF Field(line, 7) = ""client"" THEN CONTINUE" + NL
    t = t + "                IF (Field(line, 7) = ""game"") <> (pass = 1) THEN CONTINUE" + NL
    t = t + "                IF pass = 0 THEN" + NL
    t = t + "                    shelf.Add(Field(line, 1).Upper() + ""|"" + line)" + NL
    t = t + "                ELSE" + NL
    t = t + "                    shelf.Add(""|"" + line)" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF pass = 0 THEN shelf.Sort()" + NL
    t = t + "            FOR EACH line IN shelf" + NL
    t = t + "                line = line.Substring(line.IndexOf(""|"") + 1, line.Length - line.IndexOf(""|"") - 1)" + NL
    t = t + "                IF NOT heading THEN" + NL
    t = t + "                    heading = TRUE" + NL
    t = t + "                    listed.Add("""")" + NL
    t = t + "                    IF pass = 0 THEN" + NL
    t = t + "                        games.Add(""- APPS -"")" + NL
    t = t + "                    ELSE" + NL
    t = t + "                        games.Add(""- GAMES -"")" + NL
    t = t + "                    END IF" + NL
    t = t + "                END IF" + NL
    t = t + "                listed.Add(line)" + NL
    t = t + "                IF HasUpdate(Field(line, 0)) THEN" + NL
    t = t + "                    games.Add(""  "" + Field(line, 1) + ""  (update)"")" + NL
    t = t + "                ELSEIF Installed(Field(line, 0)) THEN" + NL
    t = t + "                    games.Add(""  "" + Field(line, 1) + ""  (installed)"")" + NL
    t = t + "                ELSE" + NL
    t = t + "                    games.Add(""  "" + Field(line, 1))" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF catalog.Count = 0 THEN" + NL
    t = t + "            IF store = """" THEN" + NL
    t = t + "                win.Status = ""No store yet: choose Vapor > Change Store.""" + NL
    t = t + "            ELSE" + NL
    t = t + "                win.Status = ""Fetching the store from "" + store + ""...""" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    ELSEIF t = ""LIBRARY"" THEN" + NL
    t = t + "        FOR EACH line IN Library()" + NL
    t = t + "            listed.Add(line)" + NL
    t = t + "            IF HasUpdate(Field(line, 0)) THEN" + NL
    t = t + "                games.Add(Field(line, 1) + ""  (update)"")" + NL
    t = t + "            ELSE" + NL
    t = t + "                games.Add(Field(line, 1))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF listed.Count = 0 THEN win.Status = ""Your library is empty. Visit the Store!""" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF dlId <> """" THEN" + NL
    t = t + "            listed.Add(dlLine)" + NL
    t = t + "            games.Add(Field(dlLine, 1) + ""  "" + Str(Percent()) + ""%"")" + NL
    t = t + "        END IF" + NL
    t = t + "        IF setupLine <> """" THEN" + NL
    t = t + "            listed.Add(setupLine)" + NL
    t = t + "            games.Add(Field(setupLine, 1) + ""  (installing)"")" + NL
    t = t + "        END IF" + NL
    t = t + "        FOR EACH line IN queue" + NL
    t = t + "            listed.Add(line)" + NL
    t = t + "            games.Add(Field(line, 1) + ""  (queued)"")" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    head.Tag = """"" + NL
    t = t + "    DrawHead()" + NL
    t = t + "    IF listed.Count > 0 THEN" + NL
    t = t + "        games.Selected = 0" + NL
    t = t + "        IF listed[0] = """" AND listed.Count > 1 THEN games.Selected = 1" + NL
    t = t + "    END IF" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Library () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(HOME + ""\LIBRARY.TXT"", """").Lines()" + NL
    t = t + "        IF line.Split(""|"").Count >= 4 THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Installed (id AS String) AS Bool" + NL
    t = t + "    RETURN LibLine(id) <> """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LibLine (id AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN Library()" + NL
    t = t + "        IF Field(line, 0) = id THEN RETURN line" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION StoreLine (id AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN catalog" + NL
    t = t + "        IF Field(line, 0) = id THEN RETURN line" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is there a newer version in the store than the one installed?" + NL
    t = t + "FUNCTION HasUpdate (id AS String) AS Bool" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    VAR shop AS String" + NL
    t = t + "    lib = LibLine(id)" + NL
    t = t + "    shop = StoreLine(id)" + NL
    t = t + "    IF lib = """" OR shop = """" OR Field(shop, 4) <> ""ok"" THEN RETURN FALSE" + NL
    t = t + "    RETURN Field(lib, 6) <> Field(shop, 8)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Current () AS String" + NL
    t = t + "    IF games.Selected < 0 OR games.Selected >= listed.Count THEN RETURN """"" + NL
    t = t + "    RETURN listed[games.Selected]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Games_OnSelect ()" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unesc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%0A"", EOL).Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Words into lines of about n characters." + NL
    t = t + "FUNCTION Wrap (text AS String, n AS Integer) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR word AS String" + NL
    t = t + "    FOR EACH word IN text.Split("" "")" + NL
    t = t + "        IF line <> """" AND line.Length + word.Length + 1 > n THEN" + NL
    t = t + "            out = out + line + EOL" + NL
    t = t + "            line = word" + NL
    t = t + "        ELSEIF line = """" THEN" + NL
    t = t + "            line = word" + NL
    t = t + "        ELSE" + NL
    t = t + "            line = line + "" "" + word" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out + line" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Played (seconds AS Integer) AS String" + NL
    t = t + "    IF seconds < 60 THEN RETURN ""Played "" + Str(seconds) + "" seconds""" + NL
    t = t + "    IF seconds < 3600 THEN RETURN ""Played "" + Str(Int(seconds / 60)) + "" minutes""" + NL
    t = t + "    RETURN ""Played "" + Str(Int(seconds / 360) / 10) + "" hours""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Busy (id AS String) AS Bool" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    IF id = dlId OR id = Field(setupLine, 0) THEN RETURN TRUE" + NL
    t = t + "    FOR EACH line IN queue" + NL
    t = t + "        IF Field(line, 0) = id THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The right-hand side: the banner, the words, the right buttons." + NL
    t = t + "SUB ShowGame ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    VAR shop AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    line = Current()" + NL
    t = t + "    trophies.Clear()" + NL
    t = t + "    banner.Tag = """"" + NL
    t = t + "    upd.Visible = FALSE" + NL
    t = t + "    IF line = """" THEN" + NL
    t = t + "        title.Text = """"" + NL
    t = t + "        info.Text = """"" + NL
    t = t + "        about.Text = """"" + NL
    t = t + "        action.Visible = FALSE" + NL
    t = t + "        remove.Visible = FALSE" + NL
    t = t + "        DrawBanner("""")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    id = Field(line, 0)" + NL
    t = t + "    lib = LibLine(id)" + NL
    t = t + "    shop = StoreLine(id)" + NL
    t = t + "    title.Text = Field(line, 1)" + NL
    t = t + "    action.Visible = TRUE" + NL
    t = t + "    action.Enabled = TRUE" + NL
    t = t + "    remove.Visible = lib <> """"" + NL
    t = t + "    IF tab = ""LIBRARY"" THEN" + NL
    t = t + "        kind = Field(lib, 7)" + NL
    t = t + "        IF kind = """" THEN kind = ""game""" + NL
    t = t + "        IF kind = ""game"" THEN" + NL
    t = t + "            info.Text = Played(Int(Val(Field(lib, 3)))) + ""  -  installed "" + Field(lib, 2)" + NL
    t = t + "        ELSE" + NL
    t = t + "            info.Text = KindName(kind) + ""  -  installed "" + Field(lib, 2)" + NL
    t = t + "        END IF" + NL
    t = t + "        IF Field(lib, 6) <> """" THEN info.Text = info.Text + ""  -  build "" + Field(lib, 6)" + NL
    t = t + "        about.Text = Wrap(Unesc(Field(lib, 5)), 66)" + NL
    t = t + "        action.Text = OpenWord(kind)" + NL
    t = t + "        IF playId.Contains(id) THEN" + NL
    t = t + "            action.Text = ""Running""" + NL
    t = t + "            action.Enabled = FALSE" + NL
    t = t + "        END IF" + NL
    t = t + "        upd.Visible = HasUpdate(id) AND NOT Busy(id)" + NL
    t = t + "        IF kind = ""game"" THEN" + NL
    t = t + "            FOR EACH a IN ReadOr(HOME + ""\"" + id + ""\ACHIEVE.TXT"", """").Lines()" + NL
    t = t + "                IF a.Contains(""|"") THEN trophies.Add(""* "" + a.Split(""|"")[0] + "" - "" + a.Split(""|"")[1] + ""  ("" + a.Split(""|"")[2] + "")"")" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF trophies.Count = 0 THEN trophies.Add(""No achievements yet. Go and play!"")" + NL
    t = t + "        END IF" + NL
    t = t + "        IF HasUpdate(id) THEN trophies.Add(""A newer version is in the store (build "" + Field(shop, 8) + "")."")" + NL
    t = t + "    ELSE" + NL
    t = t + "        kind = Field(line, 7)" + NL
    t = t + "        IF kind = """" THEN kind = ""game""" + NL
    t = t + "        info.Text = Field(line, 5) + ""  -  "" + KindName(kind) + ""  -  "" + Str(Int(Val(Field(line, 3)) / 1024) + 1) + "" KB  -  Free""" + NL
    t = t + "        about.Text = Wrap(Unesc(Field(line, 6)), 66)" + NL
    t = t + "        IF Field(line, 4) = ""soon"" THEN" + NL
    t = t + "            info.Text = Field(line, 5) + ""  -  Coming soon""" + NL
    t = t + "            action.Text = ""Coming soon""" + NL
    t = t + "            action.Enabled = FALSE" + NL
    t = t + "        ELSEIF Busy(id) THEN" + NL
    t = t + "            action.Text = ""Downloading...""" + NL
    t = t + "            action.Enabled = FALSE" + NL
    t = t + "        ELSEIF HasUpdate(id) THEN" + NL
    t = t + "            action.Text = ""U&pdate""" + NL
    t = t + "        ELSEIF lib <> """" THEN" + NL
    t = t + "            action.Text = OpenWord(kind)" + NL
    t = t + "            action.Enabled = NOT playId.Contains(id)" + NL
    t = t + "        ELSE" + NL
    t = t + "            action.Text = ""&Install""" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    DrawBanner(id)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION OpenWord (kind AS String) AS String" + NL
    t = t + "    IF kind = ""game"" THEN RETURN ""&Play""" + NL
    t = t + "    RETURN ""&Open""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Action_Click ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    line = Current()" + NL
    t = t + "    IF line = """" THEN RETURN" + NL
    t = t + "    id = Field(line, 0)" + NL
    t = t + "    IF tab = ""STORE"" AND HasUpdate(id) THEN" + NL
    t = t + "        Want(StoreLine(id))" + NL
    t = t + "    ELSEIF Installed(id) THEN" + NL
    t = t + "        Launch(id)" + NL
    t = t + "    ELSEIF tab = ""STORE"" AND Field(line, 4) <> ""soon"" THEN" + NL
    t = t + "        Want(line)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Update_Click ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    line = Current()" + NL
    t = t + "    IF line = """" THEN RETURN" + NL
    t = t + "    IF HasUpdate(Field(line, 0)) THEN Want(StoreLine(Field(line, 0)))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Into the download queue. A web app asks first: it takes the home page." + NL
    t = t + "SUB Want (line AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    VAR other AS String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    IF Busy(Field(line, 0)) THEN RETURN" + NL
    t = t + "    IF Field(line, 7) = ""web"" AND NOT Installed(Field(line, 0)) AND NOT (Folders() AND Field(line, 13) <> """") THEN" + NL
    t = t + "        FOR EACH l IN Library()" + NL
    t = t + "            IF Field(l, 7) = ""web"" THEN other = Field(l, 1)" + NL
    t = t + "        NEXT" + NL
    t = t + "        box = GUI_MessageBox.New(win)" + NL
    t = t + "        box.Title = ""Vapor""" + NL
    t = t + "        box.Kind = ""confirm""" + NL
    t = t + "        box.Buttons = ""yesno""" + NL
    t = t + "        box.Text = Field(line, 1) + "" is a web app: it becomes this machine's home page, http://"" + NET.HostName.Lower() + ""/ (the page there now moves aside to WELCOME.HTM).""" + NL
    t = t + "        IF other <> """" THEN box.Text = box.Text + EOL + EOL + ""This machine already has "" + other + "" there, and a machine has room for one web app: "" + Field(line, 1) + "" will take its place.""" + NL
    t = t + "        box.Text = box.Text + EOL + EOL + ""Install it?""" + NL
    t = t + "        IF NOT box.Show() THEN RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    queue.Add(line)" + NL
    t = t + "    win.Status = Field(line, 1) + "" is queued for download.""" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Play a game, open a program, or open a web app in the browser." + NL
    t = t + "SUB Launch (id AS String)" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR run AS String" + NL
    t = t + "    VAR url AS String" + NL
    t = t + "    lib = LibLine(id)" + NL
    t = t + "    kind = Field(lib, 7)" + NL
    t = t + "    IF kind = """" OR kind = ""game"" THEN" + NL
    t = t + "        run = HOME + ""\"" + id + ""\"" + id + "".SPK""" + NL
    t = t + "    ELSE" + NL
    t = t + "        run = Field(lib, 8)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF kind = ""web"" THEN" + NL
    t = t + "        url = WebUrl(Field(lib, 12))" + NL
    t = t + "        IF FS.Exists(BROWSER) THEN" + NL
    t = t + "            SYS.Start(BROWSER, url)" + NL
    t = t + "        ELSE" + NL
    t = t + "            SYS.Start(""C:\SYSTEM\VOYAGER.EXE"", url)" + NL
    t = t + "        END IF" + NL
    t = t + "        win.Status = ""Opened "" + url" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT FS.Exists(run) THEN" + NL
    t = t + "        Say(""The files are missing ("" + run + ""). Uninstall it and install it again."", ""error"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF playId.Contains(id) THEN RETURN" + NL
    t = t + "    playId.Add(id)" + NL
    t = t + "    playPid.Add(SYS.Run(run))" + NL
    t = t + "    playSince.Add(SYS.Ticks)" + NL
    t = t + "    IF kind = ""game"" THEN" + NL
    t = t + "        win.Status = ""Playing "" + Field(lib, 1) + ""...""" + NL
    t = t + "    ELSE" + NL
    t = t + "        win.Status = ""Opened "" + Field(lib, 1) + "".""" + NL
    t = t + "    END IF" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Remove_Click ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR lib AS String" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    line = Current()" + NL
    t = t + "    IF line = """" THEN RETURN" + NL
    t = t + "    id = Field(line, 0)" + NL
    t = t + "    lib = LibLine(id)" + NL
    t = t + "    IF lib = """" THEN RETURN" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = ""Vapor""" + NL
    t = t + "    box.Kind = ""confirm""" + NL
    t = t + "    box.Buttons = ""yesno""" + NL
    t = t + "    IF Field(lib, 7) = """" OR Field(lib, 7) = ""game"" THEN" + NL
    t = t + "        box.Text = ""Uninstall "" + Field(lib, 1) + ""? Its files in "" + HOME + ""\"" + id + "" will be deleted (your achievements too).""" + NL
    t = t + "    ELSE" + NL
    t = t + "        box.Text = ""Uninstall "" + Field(lib, 1) + ""? Its program files go; anything it saved (mail, posts, settings) stays.""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT box.Show() THEN RETURN" + NL
    t = t + "    Uninstall(lib)" + NL
    t = t + "    win.Status = Field(lib, 1) + "" was uninstalled.""" + NL
    t = t + "    ShowTab(tab)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Stops it, takes it out of startup, deletes the files it wrote, and its folder here." + NL
    t = t + "SUB Uninstall (lib AS String)" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR task AS String" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    id = Field(lib, 0)" + NL
    t = t + "    FOR EACH name IN Field(lib, 10).Split("";"")" + NL
    t = t + "        IF name = """" THEN CONTINUE" + NL
    t = t + "        FOR EACH task IN SYS.Tasks()" + NL
    t = t + "            IF task.Split(""|"")[1].Upper() = name.Upper() AND Int(Val(task.Split(""|"")[0])) <> SYS.Pid THEN SYS.Kill(Int(Val(task.Split(""|"")[0])))" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH name IN Field(lib, 11).Split("";"")" + NL
    t = t + "        IF name <> """" AND FS.Exists(""C:\SYSTEM\STARTUP\"" + name) THEN FS.Delete(""C:\SYSTEM\STARTUP\"" + name)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH f IN Field(lib, 9).Split("";"")" + NL
    t = t + "        IF f <> """" AND f.Upper() <> ME THEN" + NL
    t = t + "            IF FS.Exists(Where(f, Field(lib, 12))) THEN FS.Delete(Where(f, Field(lib, 12)))" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' a web app gives the home page back (unless it had a folder of its own)" + NL
    t = t + "    IF Field(lib, 7) = ""web"" AND (Field(lib, 12) = """" OR NOT Folders()) AND NOT FS.Exists(""C:\WEB\INDEX.HTM"") AND FS.Exists(""C:\WEB\WELCOME.HTM"") THEN FS.Rename(""C:\WEB\WELCOME.HTM"", ""C:\WEB\INDEX.HTM"")" + NL
    t = t + "    IF FS.Exists(HOME + ""\"" + id) THEN" + NL
    t = t + "        FOR EACH f IN FS.List(HOME + ""\"" + id)" + NL
    t = t + "            IF NOT f.EndsWith(""\"") THEN FS.Delete(HOME + ""\"" + id + ""\"" + f)" + NL
    t = t + "        NEXT" + NL
    t = t + "        FS.Delete(HOME + ""\"" + id)" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH l IN Library()" + NL
    t = t + "        IF Field(l, 0) <> id THEN out.Add(l)" + NL
    t = t + "    NEXT" + NL
    t = t + "    SaveLibrary(out)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SaveLibrary (lines AS Array OF String)" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    IF lines.Count > 0 THEN text = lines.Join(EOL) + EOL" + NL
    t = t + "    FS.Write(HOME + ""\LIBRARY.TXT"", text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Into the library, or the line there brought up to date (keeping when it" + NL
    t = t + "' was first installed and the time played)." + NL
    t = t + "SUB Keep (line AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    VAR first AS String" + NL
    t = t + "    VAR seconds AS String = ""0""" + NL
    t = t + "    VAR found AS Bool" + NL
    t = t + "    first = TIME.Date" + NL
    t = t + "    FOR EACH l IN Library()" + NL
    t = t + "        IF Field(l, 0) = Field(line, 0) THEN" + NL
    t = t + "            first = Field(l, 2)" + NL
    t = t + "            seconds = Field(l, 3)" + NL
    t = t + "            found = TRUE" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    l = Field(line, 0) + ""|"" + Field(line, 1) + ""|"" + first + ""|"" + seconds + ""|"" + Field(line, 5) + ""|"" + Field(line, 6) + ""|"" + Field(line, 8) + ""|"" + Field(line, 7) + ""|"" + Field(line, 9) + ""|"" + Field(line, 10) + ""|"" + Field(line, 11) + ""|"" + Field(line, 12) + ""|"" + Field(line, 13)" + NL
    t = t + "    FOR EACH line IN Library()" + NL
    t = t + "        IF Field(line, 0) = Field(l, 0) THEN" + NL
    t = t + "            out.Add(l)" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT found THEN out.Add(l)" + NL
    t = t + "    SaveLibrary(out)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB UpdateAll ()" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    FOR EACH l IN Library()" + NL
    t = t + "        IF HasUpdate(Field(l, 0)) AND NOT Busy(Field(l, 0)) THEN" + NL
    t = t + "            queue.Add(StoreLine(Field(l, 0)))" + NL
    t = t + "            n = n + 1" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF n = 0 THEN" + NL
    t = t + "        win.Status = ""Everything is up to date.""" + NL
    t = t + "    ELSE" + NL
    t = t + "        win.Status = Str(n) + "" update"" + Plural(n) + "" queued.""" + NL
    t = t + "    END IF" + NL
    t = t + "    ShowGame()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Plural (n AS Integer) AS String" + NL
    t = t + "    IF n = 1 THEN RETURN """"" + NL
    t = t + "    RETURN ""s""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the clock: fetches, downloads, play time" + NL
    t = t + "" + NL
    t = t + "SUB Clock_OnTick ()" + NL
    t = t + "    TRY" + NL
    t = t + "        Tick()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Alive (pid AS Integer) AS Bool" + NL
    t = t + "    VAR task AS String" + NL
    t = t + "    FOR EACH task IN SYS.Tasks()" + NL
    t = t + "        IF Int(Val(task.Split(""|"")[0])) = pid THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Tick ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    ' things that ended: a game's time goes in the library" + NL
    t = t + "    FOR i = playId.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF NOT Alive(playPid[i]) THEN" + NL
    t = t + "            AddTime(playId[i], Int((SYS.Ticks - playSince[i]) / 1000))" + NL
    t = t + "            playId.RemoveAt(i)" + NL
    t = t + "            playPid.RemoveAt(i)" + NL
    t = t + "            playSince.RemoveAt(i)" + NL
    t = t + "            ShowGame()" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' an installer that finished: into the library. (It may not end: a program" + NL
    t = t + "    ' that has printed keeps its console open. So it is done when every file" + NL
    t = t + "    ' it writes is there, or when it ends.)" + NL
    t = t + "    IF setupLine <> """" THEN" + NL
    t = t + "        IF NOT Alive(setupPid) OR (SYS.Ticks - setupSince > 300 AND AllThere(Field(setupLine, 10), Field(setupLine, 13))) OR SYS.Ticks - setupSince > 60000 THEN" + NL
    t = t + "            Keep(setupLine)" + NL
    t = t + "            win.Status = Field(setupLine, 1) + "" is installed.""" + NL
    t = t + "            note.Text = Field(setupLine, 1) + "" is ready.""" + NL
    t = t + "            progress.Value = 0" + NL
    t = t + "            setupLine = """"" + NL
    t = t + "            SYS.Beep(660, 60)" + NL
    t = t + "            ShowTab(tab)" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF fetching THEN" + NL
    t = t + "        IF fDone OR SYS.Ticks - fSince > PATIENCE THEN Arrived()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF wantCatalog AND store <> """" THEN" + NL
    t = t + "        ' a SimDNS name: ask first, in a tick of its own" + NL
    t = t + "        IF RsNext(StoreHost()) THEN RETURN" + NL
    t = t + "        wantCatalog = FALSE" + NL
    t = t + "        StartFetch(""catalog"", store + ""catalog.txt"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF dlId = """" AND queue.Count > 0 THEN" + NL
    t = t + "        dlLine = queue[0]" + NL
    t = t + "        queue.RemoveAt(0)" + NL
    t = t + "        dlId = Field(dlLine, 0)" + NL
    t = t + "        dlParts = Int(Val(Field(dlLine, 2)))" + NL
    t = t + "        dlPart = 0" + NL
    t = t + "        dlText = """"" + NL
    t = t + "        dlStart = SYS.Ticks" + NL
    t = t + "    END IF" + NL
    t = t + "    IF dlId <> """" THEN" + NL
    t = t + "        IF RsNext(StoreHost()) THEN RETURN" + NL
    t = t + "        dlPart = dlPart + 1" + NL
    t = t + "        ' (last thing in the tick: it may be spoiled)" + NL
    t = t + "        StartFetch(""part"", store + dlId.Lower() + ""/"" + Str(dlPart) + "".txt"")" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION AllThere (files AS String, folder AS String) AS Bool" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    IF files = """" THEN RETURN FALSE" + NL
    t = t + "    FOR EACH f IN files.Split("";"")" + NL
    t = t + "        IF f <> """" AND NOT FS.Exists(Where(f, folder)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A machine set up for several web apps (SimHost's C:\SYSTEM\WEBAPPS.INI says" + NL
    t = t + "' mode=folders) keeps each in its own folder, C:\WEB\BOOK and so on." + NL
    t = t + "FUNCTION Folders () AS Bool" + NL
    t = t + "    RETURN ReadOr(WEBAPPS, """").Contains(""mode=folders"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a web app's file really is: C:\WEB\BOOK.SPK -> C:\WEB\BOOK\BOOK.SPK" + NL
    t = t + "FUNCTION Where (f AS String, folder AS String) AS String" + NL
    t = t + "    IF folder = """" OR NOT Folders() THEN RETURN f" + NL
    t = t + "    IF NOT f.Upper().StartsWith(""C:\WEB\"") THEN RETURN f" + NL
    t = t + "    RETURN ""C:\WEB\"" + folder + ""\"" + f.Substring(7, f.Length - 7)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The address of a web app: the machine, or its folder there." + NL
    t = t + "FUNCTION WebUrl (folder AS String) AS String" + NL
    t = t + "    IF folder <> """" AND Folders() THEN RETURN ""http://"" + NET.HostName.Lower() + ""/"" + folder.Lower() + ""/""" + NL
    t = t + "    RETURN ""http://"" + NET.HostName.Lower() + ""/""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB AddTime (id AS String, seconds AS Integer)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    FOR EACH line IN Library()" + NL
    t = t + "        p = line.Split(""|"")" + NL
    t = t + "        IF p[0] = id THEN" + NL
    t = t + "            p[3] = Str(Int(Val(p[3])) + seconds)" + NL
    t = t + "            line = p.Join(""|"")" + NL
    t = t + "        END IF" + NL
    t = t + "        out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    SaveLibrary(out)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Percent () AS Integer" + NL
    t = t + "    IF dlParts = 0 THEN RETURN 0" + NL
    t = t + "    RETURN Int((dlPart - 1) * 100 / dlParts)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The store's machine as written in its address (alpha, store.coolsite.sim)." + NL
    t = t + "FUNCTION StoreHost () AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    IF NOT store.Lower().StartsWith(""http://"") THEN RETURN """"" + NL
    t = t + "    h = store.Substring(7, store.Length - 7)" + NL
    t = t + "    IF h.Contains(""/"") THEN h = h.Substring(0, h.IndexOf(""/""))" + NL
    t = t + "    RETURN h" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB StartFetch (what AS String, url AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR host AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    fetching = TRUE" + NL
    t = t + "    fWhat = what" + NL
    t = t + "    fNumber = fNumber + 1" + NL
    t = t + "    fParts.Clear()" + NL
    t = t + "    fDone = FALSE" + NL
    t = t + "    fError = """"" + NL
    t = t + "    fSince = SYS.Ticks" + NL
    t = t + "    host = url.Substring(7, url.Length - 7)" + NL
    t = t + "    path = host.Substring(host.IndexOf(""/""), host.Length - host.IndexOf(""/""))" + NL
    t = t + "    host = host.Substring(0, host.IndexOf(""/""))" + NL
    t = t + "    TRY" + NL
    t = t + "        ' (to the machine SimDNS named, if it named one; Host: as written)" + NL
    t = t + "        conn = web.Connect(RsTarget(host), 80)" + NL
    t = t + "        conn.Tag = Str(fNumber)" + NL
    t = t + "        conn.Send(""GET "" + path + "" HTTP/1.0"" + EOL + ""Host: "" + host + EOL + ""User-Agent: Vapor/2.0 (SIM95)"")" + NL
    t = t + "    CATCH err" + NL
    t = t + "        fError = err" + NL
    t = t + "        fDone = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    IF conn.Tag = Str(fNumber) AND NOT fDone THEN fParts.Add(message)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnClose (conn AS NET_Connection)" + NL
    t = t + "    IF conn.Tag = Str(fNumber) THEN fDone = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A fetch finished (or gave up): the body, or """" with fError saying why." + NL
    t = t + "FUNCTION Body () AS String" + NL
    t = t + "    VAR raw AS String" + NL
    t = t + "    raw = fParts.Join(EOL)" + NL
    t = t + "    IF fError <> """" THEN RETURN """"" + NL
    t = t + "    IF raw = """" THEN" + NL
    t = t + "        fError = ""no answer""" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT raw.StartsWith(""HTTP/1.0 200"") THEN" + NL
    t = t + "        fError = raw.Lines()[0]" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT raw.Contains(EOL + EOL) THEN RETURN """"" + NL
    t = t + "    RETURN raw.Substring(raw.IndexOf(EOL + EOL) + 2, raw.Length - raw.IndexOf(EOL + EOL) - 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Arrived ()" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR mine AS String" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    fetching = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        web.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    text = Body()" + NL
    t = t + "    IF fWhat = ""catalog"" THEN" + NL
    t = t + "        catalog.Clear()" + NL
    t = t + "        IF text = """" THEN" + NL
    t = t + "            win.Status = ""The store at "" + store + "" did not answer ("" + fError + "").""" + NL
    t = t + "        ELSE" + NL
    t = t + "            FOR EACH line IN text.Lines()" + NL
    t = t + "                IF line.Split(""|"").Count >= 7 THEN catalog.Add(line)" + NL
    t = t + "            NEXT" + NL
    t = t + "            win.Status = ""Store: "" + store + ""  -  "" + Str(catalog.Count) + "" items""" + NL
    t = t + "        END IF" + NL
    t = t + "        IF tab <> ""DOWNLOADS"" THEN ShowTab(tab)" + NL
    t = t + "        ' a newer Vapor? ask once" + NL
    t = t + "        mine = MyVersion()" + NL
    t = t + "        line = StoreLine(""VAPOR"")" + NL
    t = t + "        IF line <> """" AND mine <> """" AND Field(line, 8) <> mine AND NOT offeredSelf AND NOT Busy(""VAPOR"") THEN" + NL
    t = t + "            offeredSelf = TRUE" + NL
    t = t + "            box = GUI_MessageBox.New(win)" + NL
    t = t + "            box.Title = ""Vapor""" + NL
    t = t + "            box.Kind = ""confirm""" + NL
    t = t + "            box.Buttons = ""yesno""" + NL
    t = t + "            box.Text = ""A new version of Vapor is in the store (build "" + Field(line, 8) + ""; this is "" + mine + "")."" + EOL + EOL + ""Update Vapor now? It will restart.""" + NL
    t = t + "            IF box.Show() THEN queue.Insert(0, line)" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' a part of the download" + NL
    t = t + "    IF text = """" THEN" + NL
    t = t + "        win.Status = ""The download of "" + Field(dlLine, 1) + "" failed ("" + fError + "").""" + NL
    t = t + "        progress.Value = 0" + NL
    t = t + "        note.Text = """"" + NL
    t = t + "        dlId = """"" + NL
    t = t + "        ShowTab(tab)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    dlText = dlText + text" + NL
    t = t + "    progress.Value = Int(dlPart * 100 / dlParts)" + NL
    t = t + "    note.Text = ""Downloading "" + Field(dlLine, 1) + "": part "" + Str(dlPart) + "" of "" + Str(dlParts) + ""  -  "" + Str(Int(dlText.Length / MATH.Max(1, SYS.Ticks - dlStart) * 1000 / 102.4) / 10) + "" KB/s""" + NL
    t = t + "    IF tab = ""DOWNLOADS"" AND games.Count > 0 THEN games.Set(0, Field(dlLine, 1) + ""  "" + Str(Int(dlPart * 100 / dlParts)) + ""%"")" + NL
    t = t + "    IF dlPart >= dlParts THEN Finish()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' All the parts are here: what happens next depends on what it is." + NL
    t = t + "SUB Finish ()" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR kind AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    line = dlLine" + NL
    t = t + "    dir = HOME + ""\"" + dlId" + NL
    t = t + "    kind = Field(line, 7)" + NL
    t = t + "    IF kind = """" THEN kind = ""game""" + NL
    t = t + "    IF kind = ""client"" THEN" + NL
    t = t + "        ' a new Vapor: in place of this one, which starts it and goes" + NL
    t = t + "        FS.Write(ME, dlText)" + NL
    t = t + "        SYS.Start(ME, """")" + NL
    t = t + "        SYS.Exit(0)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT FS.Exists(dir) THEN FS.MakeDir(dir)" + NL
    t = t + "    dlId = """"" + NL
    t = t + "    IF kind = ""game"" THEN" + NL
    t = t + "        FS.Write(dir + ""\"" + Field(line, 0) + "".SPK"", dlText)" + NL
    t = t + "        dlText = """"" + NL
    t = t + "        Keep(line)" + NL
    t = t + "        win.Status = Field(line, 1) + "" is installed. Find it in your Library.""" + NL
    t = t + "        note.Text = Field(line, 1) + "" is ready to play.""" + NL
    t = t + "        SYS.Beep(660, 60)" + NL
    t = t + "        ShowTab(tab)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' an installer: clear away the old files it writes (an update: a new" + NL
    t = t + "    ' install may need what is there, as SimHost moves web apps), run it, and" + NL
    t = t + "    ' wait for them" + NL
    t = t + "    FS.Write(dir + ""\INSTALL.SPK"", dlText)" + NL
    t = t + "    dlText = """"" + NL
    t = t + "    IF Installed(Field(line, 0)) THEN" + NL
    t = t + "        FOR EACH f IN Field(line, 10).Split("";"")" + NL
    t = t + "            IF f <> """" AND f.Upper() <> ME THEN" + NL
    t = t + "                IF FS.Exists(Where(f, Field(line, 13))) THEN FS.Delete(Where(f, Field(line, 13)))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    setupLine = line" + NL
    t = t + "    setupSince = SYS.Ticks" + NL
    t = t + "    setupPid = SYS.Run(dir + ""\INSTALL.SPK"")" + NL
    t = t + "    note.Text = ""Installing "" + Field(line, 1) + ""...""" + NL
    t = t + "    win.Status = ""Running "" + Field(line, 1) + ""'s installer...""" + NL
    t = t + "    ShowTab(tab)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ publishing (on a store machine)" + NL
    t = t + "" + NL
    t = t + "' Every installer in C:\MYFILES with a Vapor header goes on the store's shelf," + NL
    t = t + "' in place of an older version of it." + NL
    t = t + "SUB Publish ()" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR done AS Array OF String" + NL
    t = t + "    VAR same AS Array OF String" + NL
    t = t + "    VAR answer AS String" + NL
    t = t + "    IF NOT FS.Exists(STOREDIR) THEN" + NL
    t = t + "        Say(""This machine is not a Vapor store. Run Vapor's INSTALL.SPK here first."", ""warn"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    win.Status = ""Looking in C:\MYFILES for installers...""" + NL
    t = t + "    FOR EACH f IN FS.List(""C:\MYFILES"")" + NL
    t = t + "        IF NOT f.EndsWith("".SPK"") THEN CONTINUE" + NL
    t = t + "        text = FS.Read(""C:\MYFILES\"" + f)" + NL
    t = t + "        IF NOT text.StartsWith(""' VAPOR|"") THEN CONTINUE" + NL
    t = t + "        answer = PublishOne(text)" + NL
    t = t + "        IF answer.StartsWith(""="") THEN" + NL
    t = t + "            same.Add(answer.Substring(1, answer.Length - 1))" + NL
    t = t + "        ELSEIF answer <> """" THEN" + NL
    t = t + "            done.Add(answer)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF done.Count = 0 AND same.Count = 0 THEN" + NL
    t = t + "        Say(""There are no installers to publish in C:\MYFILES."" + EOL + EOL + ""Paste an app's INSTALL.SPK into SPARK, save it in C:\MYFILES (any name ending .SPK) without running it, and choose Publish Apps again."", ""info"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    answer = """"" + NL
    t = t + "    IF done.Count > 0 THEN answer = ""Published:"" + EOL + ""  "" + done.Join(EOL + ""  "")" + NL
    t = t + "    IF same.Count > 0 THEN answer = answer + EOL + EOL + ""Already up to date: "" + same.Join("", "")" + NL
    t = t + "    Say(answer.Trim(), ""info"")" + NL
    t = t + "    wantCatalog = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One installer into the store: its parts, and its line in the catalog." + NL
    t = t + "' Returns ""name (build)"" or ""=name"" when the store already had that version." + NL
    t = t + "FUNCTION PublishOne (text AS String) AS String" + NL
    t = t + "    VAR header AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR chunk AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR entry AS String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR found AS Bool" + NL
    t = t + "    header = text.Lines()[0]" + NL
    t = t + "    id = Meta(header, ""id"").Upper()" + NL
    t = t + "    IF id = """" OR id.Length > 8 OR id.Contains(""\"") OR id.Contains(""."") THEN RETURN """"" + NL
    t = t + "    FOR EACH line IN ReadOr(STOREDIR + ""\CATALOG.TXT"", """").Lines()" + NL
    t = t + "        IF Field(line, 0) = id AND Field(line, 8) = Meta(header, ""version"") THEN RETURN ""="" + Meta(header, ""name"")" + NL
    t = t + "    NEXT" + NL
    t = t + "    dir = STOREDIR + ""\"" + id" + NL
    t = t + "    IF FS.Exists(dir) THEN" + NL
    t = t + "        FOR EACH f IN FS.List(dir)" + NL
    t = t + "            IF NOT f.EndsWith(""\"") THEN FS.Delete(dir + ""\"" + f)" + NL
    t = t + "        NEXT" + NL
    t = t + "    ELSE" + NL
    t = t + "        FS.MakeDir(dir)" + NL
    t = t + "    END IF" + NL
    t = t + "    ' parts of whole lines, each small enough for one network message" + NL
    t = t + "    lines = text.Replace(Chr(13), """").Split(EOL)" + NL
    t = t + "    IF lines.Count > 0 THEN" + NL
    t = t + "        IF lines[lines.Count - 1] = """" THEN lines.RemoveAt(lines.Count - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR EACH line IN lines" + NL
    t = t + "        IF chunk.Length + line.Length + 1 > PART AND chunk <> """" THEN" + NL
    t = t + "            n = n + 1" + NL
    t = t + "            FS.Write(dir + ""\"" + Str(n) + "".TXT"", chunk)" + NL
    t = t + "            chunk = """"" + NL
    t = t + "        END IF" + NL
    t = t + "        chunk = chunk + line + EOL" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF chunk <> """" THEN" + NL
    t = t + "        n = n + 1" + NL
    t = t + "        FS.Write(dir + ""\"" + Str(n) + "".TXT"", chunk)" + NL
    t = t + "    END IF" + NL
    t = t + "    entry = id + ""|"" + Meta(header, ""name"") + ""|"" + Str(n) + ""|"" + Str(text.Length) + ""|ok|"" + Meta(header, ""category"") + ""|"" + Meta(header, ""about"") + ""|"" + Meta(header, ""kind"") + ""|"" + Meta(header, ""version"") + ""|"" + Meta(header, ""run"") + ""|"" + Meta(header, ""files"") + ""|"" + Meta(header, ""tasks"") + ""|"" + Meta(header, ""startup"") + ""|"" + Meta(header, ""folder"").Upper()" + NL
    t = t + "    FOR EACH line IN ReadOr(STOREDIR + ""\CATALOG.TXT"", """").Lines()" + NL
    t = t + "        IF line = """" THEN CONTINUE" + NL
    t = t + "        IF Field(line, 0) = id THEN" + NL
    t = t + "            out.Add(entry)" + NL
    t = t + "            found = TRUE" + NL
    t = t + "        ELSE" + NL
    t = t + "            out.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF NOT found THEN out.Add(entry)" + NL
    t = t + "    FS.Write(STOREDIR + ""\CATALOG.TXT"", out.Join(EOL) + EOL)" + NL
    t = t + "    RETURN Meta(header, ""name"") + "" (build "" + Meta(header, ""version"") + "")""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the header and the banners" + NL
    t = t + "" + NL
    t = t + "SUB Head_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    head.Tag = """"" + NL
    t = t + "    DrawHead()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawHead ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR names AS Array OF String" + NL
    t = t + "    IF head.Tag = tab THEN RETURN" + NL
    t = t + "    head.Tag = tab" + NL
    t = t + "    head.Clear()" + NL
    t = t + "    head.SetColor(0)" + NL
    t = t + "    head.FillRect(0, 0, 640, 44)" + NL
    t = t + "    head.SetColor(4)" + NL
    t = t + "    head.FillRect(0, 0, 640, 40)" + NL
    t = t + "    ' the logo: steam rising off a V" + NL
    t = t + "    head.SetColor(15)" + NL
    t = t + "    head.FillCircle(22, 14, 4)" + NL
    t = t + "    head.FillCircle(28, 9, 3)" + NL
    t = t + "    head.FillCircle(17, 8, 2)" + NL
    t = t + "    head.SetColor(14)" + NL
    t = t + "    head.Text(38, 12, ""VAPOR"")" + NL
    t = t + "    names = [""STORE"", ""LIBRARY"", ""DOWNLOADS""]" + NL
    t = t + "    FOR i = 0 TO 2" + NL
    t = t + "        IF names[i] = tab THEN" + NL
    t = t + "            head.SetColor(14)" + NL
    t = t + "            head.FillRect(150 + i * 130, 36, 110, 4)" + NL
    t = t + "            head.SetColor(15)" + NL
    t = t + "        ELSE" + NL
    t = t + "            head.SetColor(7)" + NL
    t = t + "        END IF" + NL
    t = t + "        head.Text(150 + i * 130, 12, names[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Head_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    IF x >= 150 AND x < 270 THEN ShowTab(""STORE"")" + NL
    t = t + "    IF x >= 280 AND x < 400 THEN ShowTab(""LIBRARY"")" + NL
    t = t + "    IF x >= 410 AND x < 540 THEN ShowTab(""DOWNLOADS"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Banner_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    line = Current()" + NL
    t = t + "    banner.Tag = """"" + NL
    t = t + "    DrawBanner(Field(line, 0))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Each item's banner, drawn." + NL
    t = t + "SUB DrawBanner (id AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF banner.Tag = id AND id <> """" THEN RETURN" + NL
    t = t + "    banner.Tag = id" + NL
    t = t + "    banner.Clear()" + NL
    t = t + "    SELECT CASE id" + NL
    t = t + "        CASE ""SIMDOOM""" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "            FOR i = 0 TO 54" + NL
    t = t + "                banner.SetColor(9 - 8 * (i MOD 2))" + NL
    t = t + "                banner.FillRect(i * 8, 60 + Rnd(25), 8, 40)" + NL
    t = t + "                banner.SetColor(11)" + NL
    t = t + "                banner.FillRect(i * 8 + 2, 84 + Rnd(10), 4, 16)" + NL
    t = t + "            NEXT" + NL
    t = t + "            banner.SetColor(1)" + NL
    t = t + "            banner.Text(152, 30, ""S I M D O O M"")" + NL
    t = t + "            banner.SetColor(9)" + NL
    t = t + "            banner.Text(150, 28, ""S I M D O O M"")" + NL
    t = t + "        CASE ""SNAKE""" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "            FOR i = 0 TO 20" + NL
    t = t + "                banner.SetColor(2)" + NL
    t = t + "                banner.FillRect(60 + i * 12, 50 + Int(10 * MATH.Sin(i / 2)), 10, 10)" + NL
    t = t + "            NEXT" + NL
    t = t + "            banner.SetColor(9)" + NL
    t = t + "            banner.FillCircle(360, 55, 5)" + NL
    t = t + "            banner.SetColor(10)" + NL
    t = t + "            banner.Text(170, 14, ""SNAKE 95"")" + NL
    t = t + "        CASE ""HL3""" + NL
    t = t + "            banner.SetColor(3)" + NL
    t = t + "            banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "            banner.SetColor(11)" + NL
    t = t + "            banner.FillCircle(70, 50, 34)" + NL
    t = t + "            banner.SetColor(3)" + NL
    t = t + "            banner.FillCircle(70, 50, 28)" + NL
    t = t + "            banner.SetColor(11)" + NL
    t = t + "            banner.Line(58, 30, 82, 72)" + NL
    t = t + "            banner.Line(70, 50, 56, 72)" + NL
    t = t + "            banner.SetColor(15)" + NL
    t = t + "            banner.Text(130, 34, ""HALF-LIFE 3"")" + NL
    t = t + "            banner.SetColor(11)" + NL
    t = t + "            banner.Text(130, 56, ""Coming soon(TM)"")" + NL
    t = t + "        CASE ""SIMXPLOR""" + NL
    t = t + "            Plate(1, 15, ""Simxplorer"")" + NL
    t = t + "            banner.SetColor(12)" + NL
    t = t + "            FOR i = 0 TO 15" + NL
    t = t + "                banner.FillCircle(60 + Int(14 * MATH.Cos((-40 - i * 15) * MATH.Pi / 180)), 36 + Int(11 * MATH.Sin((-40 - i * 15) * MATH.Pi / 180)), 4)" + NL
    t = t + "                banner.FillCircle(60 + Int(14 * MATH.Cos((-90 + i * 15) * MATH.Pi / 180)), 58 + Int(11 * MATH.Sin((-90 + i * 15) * MATH.Pi / 180)), 4)" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""FROSTBRD""" + NL
    t = t + "            Plate(14, 4, ""Frostbird"")" + NL
    t = t + "            banner.SetColor(15)" + NL
    t = t + "            banner.FillRect(30, 30, 60, 40)" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.Rect(30, 30, 60, 40)" + NL
    t = t + "            banner.Line(30, 30, 60, 52)" + NL
    t = t + "            banner.Line(60, 52, 89, 30)" + NL
    t = t + "        CASE ""CLIPPY""" + NL
    t = t + "            Plate(11, 0, ""Clippy"")" + NL
    t = t + "            banner.SetColor(8)" + NL
    t = t + "            banner.Rect(50, 18, 20, 66)" + NL
    t = t + "            banner.Rect(56, 26, 10, 46)" + NL
    t = t + "            banner.SetColor(15)" + NL
    t = t + "            banner.FillCircle(54, 40, 6)" + NL
    t = t + "            banner.FillCircle(70, 40, 6)" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.FillCircle(55, 41, 2)" + NL
    t = t + "            banner.FillCircle(71, 41, 2)" + NL
    t = t + "        CASE ""SIMBOOK""" + NL
    t = t + "            Plate(4, 15, ""[simbook]"")" + NL
    t = t + "        CASE ""COLDMAIL""" + NL
    t = t + "            Plate(14, 4, ""ColdMail!"")" + NL
    t = t + "        CASE ""ASKSIM""" + NL
    t = t + "            Plate(5, 15, ""AskSim"")" + NL
    t = t + "            banner.SetColor(7)" + NL
    t = t + "            banner.FillCircle(60, 40, 16)" + NL
    t = t + "            banner.SetColor(0)" + NL
    t = t + "            banner.FillRect(44, 58, 32, 30)" + NL
    t = t + "        CASE ""ELIZA""" + NL
    t = t + "            Plate(6, 15, ""ELIZA-95"")" + NL
    t = t + "        CASE """"" + NL
    t = t + "            banner.SetColor(7)" + NL
    t = t + "            banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "        CASE ELSE" + NL
    t = t + "            Plate(4, 15, id)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A plain banner: a colour, and the name in big letters." + NL
    t = t + "SUB Plate (back AS Integer, ink AS Integer, name AS String)" + NL
    t = t + "    banner.SetColor(back)" + NL
    t = t + "    banner.FillRect(0, 0, 440, 100)" + NL
    t = t + "    banner.SetColor(8)" + NL
    t = t + "    banner.Text(132, 42, name)" + NL
    t = t + "    banner.SetColor(ink)" + NL
    t = t + "    banner.Text(130, 40, name)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ menus" + NL
    t = t + "" + NL
    t = t + "SUB Menu_OnSelect (item AS String)" + NL
    t = t + "    SELECT CASE item" + NL
    t = t + "        CASE ""Store""" + NL
    t = t + "            ShowTab(""STORE"")" + NL
    t = t + "        CASE ""Library""" + NL
    t = t + "            ShowTab(""LIBRARY"")" + NL
    t = t + "        CASE ""Downloads""" + NL
    t = t + "            ShowTab(""DOWNLOADS"")" + NL
    t = t + "        CASE ""Update All""" + NL
    t = t + "            UpdateAll()" + NL
    t = t + "        CASE ""Change Store...""" + NL
    t = t + "            ChangeStore()" + NL
    t = t + "        CASE ""Publish Apps...""" + NL
    t = t + "            Publish()" + NL
    t = t + "        CASE ""Refresh""" + NL
    t = t + "            wantCatalog = TRUE" + NL
    t = t + "        CASE ""Exit""" + NL
    t = t + "            win.Close()" + NL
    t = t + "        CASE ""About Vapor""" + NL
    t = t + "            Say(""Vapor 2.0 for SIM95 (build "" + MyVersion() + "")"" + EOL + EOL + ""Games, programs and web apps from any machine that runs a Vapor store (http://machine/vapor/): downloads, a library with updates, play time and achievements."" + EOL + EOL + ""Half-Life 3 is coming soon."", ""info"")" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "VAR askWin AS GUI_Window" + NL
    t = t + "VAR askBox AS GUI_TextBox" + NL
    t = t + "" + NL
    t = t + "SUB ChangeStore ()" + NL
    t = t + "    VAR l AS GUI_Label" + NL
    t = t + "    VAR b AS GUI_Button" + NL
    t = t + "    askWin = GUI_Window.New(""Vapor Store"", 360, 110)" + NL
    t = t + "    askWin.Modal = TRUE" + NL
    t = t + "    l = GUI_Label.New(askWin)" + NL
    t = t + "    l.Text = ""Which machine is your store? (Any machine with Vapor"" + EOL + ""installed is one: type its name, like alpha, or a domain.)""" + NL
    t = t + "    l.SetBounds(10, 8, 340, 30)" + NL
    t = t + "    askBox = GUI_TextBox.New(askWin)" + NL
    t = t + "    askBox.Text = store" + NL
    t = t + "    askBox.SetBounds(10, 44, 340, 21)" + NL
    t = t + "    askBox.onEnter = Store_Ok" + NL
    t = t + "    b = GUI_Button.New(askWin)" + NL
    t = t + "    b.Text = ""OK""" + NL
    t = t + "    b.Default = TRUE" + NL
    t = t + "    b.SetBounds(272, 74, 78, 26)" + NL
    t = t + "    b.onClick = Store_Ok" + NL
    t = t + "    askWin.Center()" + NL
    t = t + "    askWin.Show()" + NL
    t = t + "    askBox.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Store_Ok ()" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = askBox.Text.Trim().Lower()" + NL
    t = t + "    IF s = """" THEN RETURN" + NL
    t = t + "    IF NOT s.StartsWith(""http://"") THEN s = ""http://"" + s" + NL
    t = t + "    IF s.Substring(7, s.Length - 7).IndexOf(""/"") < 0 THEN s = s + ""/vapor/""" + NL
    t = t + "    IF NOT s.EndsWith(""/"") THEN s = s + ""/""" + NL
    t = t + "    store = s" + NL
    t = t + "    SaveSettings()" + NL
    t = t + "    askWin.Close()" + NL
    t = t + "    catalog.Clear()" + NL
    t = t + "    wantCatalog = TRUE" + NL
    t = t + "    ShowTab(""STORE"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Say (text AS String, kind AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = ""Vapor""" + NL
    t = t + "    box.Kind = kind" + NL
    t = t + "    box.Text = text" + NL
    t = t + "    box.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' RESOLVE.SPK - the SimDNS resolver: asks the name server which machine a" + NL
    t = t + "' name like www.coolsite.sim is on." + NL
    t = t + "'" + NL
    t = t + "' The name server is the central one, STARTHERE.56k.net, where SimNIC (the" + NL
    t = t + "' registrar) and NAMED.SPK run, unless C:\SYSTEM\RESOLV.INI says otherwise." + NL
    t = t + "' To move the whole network to another central host, change RSCENTRAL below" + NL
    t = t + "' (the builder sets it from CENTRAL in tools/simxplorer-source.mjs)." + NL
    t = t + "'" + NL
    t = t + "' A library, not a program: a program has it joined on the end (the builder" + NL
    t = t + "' does this for Simxplorer, SimPlayer, Vapor, Frostbird, MAILD, the Sim Shell," + NL
    t = t + "' AskSim's crawler, DIG and Personal Web Manager; copy C:\PROGRAMS\RESOLVE.SPK" + NL
    t = t + "' onto the end of your own). Every name in it starts with Rs, so it can't clash." + NL
    t = t + "'" + NL
    t = t + "' C:\SYSTEM\RESOLV.INI, shared by every program on the machine (optional):" + NL
    t = t + "'     nameserver=dnsbox          another name server instead of the central one" + NL
    t = t + "'     nameserver=none            no SimDNS at all: SIM95 machine names only" + NL
    t = t + "'     search=coolsite.sim        then ""www"" means www.coolsite.sim" + NL
    t = t + "'" + NL
    t = t + "' How to use it without ever waiting in the wrong place (SIM95-NOTES.md):" + NL
    t = t + "'   1. RsWants(host)  - does this name need asking? FALSE for addresses," + NL
    t = t + "'                       plain machine names, names already known, or when" + NL
    t = t + "'                       there is no name server (or it isn't answering)." + NL
    t = t + "'   2. RsAsk(host, address) - sends the question to the name server at that" + NL
    t = t + "'                       address. It is a Connect: let it be the last thing" + NL
    t = t + "'                       the handler does." + NL
    t = t + "'   3. RsBusy()       - TRUE while the answer is on its way. After RSWAIT" + NL
    t = t + "'                       with no answer the server is left alone for RSQUIET," + NL
    t = t + "'                       and every name goes to SIM95 as before." + NL
    t = t + "'   4. RsTarget(host) - where to connect: the machine name (or address) the" + NL
    t = t + "'                       name server gave, or the name itself when SimDNS" + NL
    t = t + "'                       doesn't know it, for SIM95 to look up." + NL
    t = t + "' Answers are kept for their TTL; names SimDNS doesn't know for RSNEG." + NL
    t = t + "'" + NL
    t = t + "' Or, from a timer tick, all of that in one line (see RsNext):" + NL
    t = t + "'     IF RsNext(host) THEN RETURN          ' asked, or waiting: end the tick" + NL
    t = t + "'     conn = sock.Connect(RsTarget(host), 80)" + NL
    t = t + "' and for mail, the domain's MX first (see RsNextMail):" + NL
    t = t + "'     IF RsNextMail(domain) THEN RETURN" + NL
    t = t + "'     conn = sock.Connect(RsMailTarget(domain), 25)" + NL
    t = t + "" + NL
    t = t + "CONST RSCENTRAL = ""starthere.56k.net""   ' the central name server" + NL
    t = t + "CONST RSINI = ""C:\SYSTEM\RESOLV.INI""" + NL
    t = t + "CONST RSPORT = 53" + NL
    t = t + "CONST RSWAIT = 2000             ' ms to wait for an answer" + NL
    t = t + "CONST RSQUIET = 30000            ' ms to leave a silent name server alone" + NL
    t = t + "CONST RSNEG = 60000             ' ms to remember that SimDNS doesn't know a name" + NL
    t = t + "CONST RSMOST = 100              ' names kept" + NL
    t = t + "" + NL
    t = t + "VAR rsServer AS String              ' """" when SimDNS is off" + NL
    t = t + "VAR rsByDefault AS Bool               ' TRUE when RESOLV.INI doesn't name one" + NL
    t = t + "VAR rsSearch AS String" + NL
    t = t + "VAR rsRead AS Bool" + NL
    t = t + "VAR rsReadAt AS Integer" + NL
    t = t + "VAR rsSock AS NET_Socket" + NL
    t = t + "VAR rsName AS Array OF String       ' the name as asked, lower case" + NL
    t = t + "VAR rsTo AS Array OF String         ' where it is ("""" when SimDNS doesn't know it)" + NL
    t = t + "VAR rsCanon AS Array OF String      ' its last name in DNS before the machine" + NL
    t = t + "VAR rsUntil AS Array OF Integer     ' SYS.Ticks when it is forgotten" + NL
    t = t + "VAR rsAsking AS String" + NL
    t = t + "VAR rsAskAt AS Integer" + NL
    t = t + "VAR rsRefused AS Bool" + NL
    t = t + "VAR rsDown AS Bool" + NL
    t = t + "VAR rsDownAt AS Integer" + NL
    t = t + "VAR rsWhy AS String                 ' the last thing that went wrong" + NL
    t = t + "VAR rsLastReply AS String           ' the last answer, as it came" + NL
    t = t + "VAR rsServerAddr AS String          ' the name server's address, for RsNext" + NL
    t = t + "VAR rsServerFor AS String" + NL
    t = t + "VAR rsServerAt AS Integer" + NL
    t = t + "VAR rsLooking AS Bool               ' RsNext is finding the name server's address" + NL
    t = t + "VAR rsLookingAt AS Integer" + NL
    t = t + "" + NL
    t = t + "' Reads RESOLV.INI (again after a few seconds, so a new setting takes)." + NL
    t = t + "' With no nameserver= line, the central name server; none (or nothing after" + NL
    t = t + "' the =) turns SimDNS off." + NL
    t = t + "SUB RsConfig ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    IF rsRead AND SYS.Ticks - rsReadAt < 3000 THEN RETURN" + NL
    t = t + "    rsRead = TRUE" + NL
    t = t + "    rsReadAt = SYS.Ticks" + NL
    t = t + "    rsServer = RSCENTRAL" + NL
    t = t + "    rsByDefault = TRUE" + NL
    t = t + "    rsSearch = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                low = line.Trim().Lower()" + NL
    t = t + "                IF low.StartsWith(""nameserver="") THEN" + NL
    t = t + "                    rsServer = low.Substring(11, low.Length - 11).Trim()" + NL
    t = t + "                    rsByDefault = FALSE" + NL
    t = t + "                END IF" + NL
    t = t + "                IF low.StartsWith(""search="") THEN rsSearch = low.Substring(7, low.Length - 7).Trim()" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF rsServer = ""none"" THEN rsServer = """"" + NL
    t = t + "    IF rsSearch.StartsWith(""."") THEN rsSearch = rsSearch.Substring(1, rsSearch.Length - 1)" + NL
    t = t + "    IF rsSearch.EndsWith(""."") THEN rsSearch = rsSearch.Substring(0, rsSearch.Length - 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The name server (a machine name or address), or """" for none." + NL
    t = t + "FUNCTION RsNameServer () AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsServer" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is it the central one, because RESOLV.INI doesn't say?" + NL
    t = t + "FUNCTION RsIsCentral () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsByDefault" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Makes server this machine's name server, keeping the rest of RESOLV.INI," + NL
    t = t + "' and forgets everything it knew. """" (or none) for no SimDNS at all;" + NL
    t = t + "' default for the central one again." + NL
    t = t + "SUB RsSave (server AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    server = server.Trim().Lower()" + NL
    t = t + "    IF server = """" THEN server = ""none""" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                IF line.Trim() <> """" AND NOT line.Trim().Lower().StartsWith(""nameserver="") THEN out.Add(line)" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "        IF server <> ""default"" THEN out.Insert(0, ""nameserver="" + server)" + NL
    t = t + "        IF out.Count = 0 THEN" + NL
    t = t + "            IF FS.Exists(RSINI) THEN FS.Delete(RSINI)" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Write(RSINI, out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsWhy = err" + NL
    t = t + "    END TRY" + NL
    t = t + "    rsRead = FALSE" + NL
    t = t + "    RsForget()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RsForget ()" + NL
    t = t + "    rsName.Clear()" + NL
    t = t + "    rsTo.Clear()" + NL
    t = t + "    rsCanon.Clear()" + NL
    t = t + "    rsUntil.Clear()" + NL
    t = t + "    rsDown = FALSE" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsIsAddress (s AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF s.Split(""."").Count <> 4 THEN RETURN FALSE" + NL
    t = t + "    FOR EACH p IN s.Split(""."")" + NL
    t = t + "        IF p = """" OR p.Length > 3 THEN RETURN FALSE" + NL
    t = t + "        FOR i = 0 TO p.Length - 1" + NL
    t = t + "            IF NOT ""0123456789"".Contains(p.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name the server is asked about: lower case, the search domain added" + NL
    t = t + "' to a single word." + NL
    t = t + "FUNCTION RsFull (host AS String) AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF h.EndsWith(""."") THEN h = h.Substring(0, h.Length - 1)" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch <> """" THEN h = h + ""."" + rsSearch" + NL
    t = t + "    RETURN h" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a name is in the list of answers, or -1 (old answers are dropped)." + NL
    t = t + "FUNCTION RsFind (host AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = rsName.IndexOf(host.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN -1" + NL
    t = t + "    IF SYS.Ticks > rsUntil[i] THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "        RETURN -1" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsWants (host AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(host) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(host) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for a mail domain's MX record." + NL
    t = t + "FUNCTION RsWantsMx (domain AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(domain) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(""mx:"" + domain.Trim().Lower()) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is host a name for the name server at all (whether known yet or not)?" + NL
    t = t + "FUNCTION RsAsks (host AS String) AS Bool" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF rsServer = """" OR h = """" OR h = ""localhost"" THEN RETURN FALSE" + NL
    t = t + "    IF rsDown AND SYS.Ticks - rsDownAt < RSQUIET THEN RETURN FALSE" + NL
    t = t + "    IF RsIsAddress(h) THEN RETURN FALSE" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch = """" THEN RETURN FALSE" + NL
    t = t + "    IF h = rsServer OR h = NET.HostName.Lower() THEN RETURN FALSE" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Sends the question. A Connect, so it must be the last thing its handler" + NL
    t = t + "' does: if the name server refuses, the handler is spoiled (SIM95-NOTES.md)." + NL
    t = t + "SUB RsAsk (host AS String, address AS String)" + NL
    t = t + "    RsSend(host.Trim().Lower(), ""A"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Asks for a mail domain's MX records (also a Connect: the last thing)." + NL
    t = t + "SUB RsAskMx (domain AS String, address AS String)" + NL
    t = t + "    RsSend(""mx:"" + domain.Trim().Lower(), ""MX"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' key is the name, or mx: and the name; the answer is kept under it." + NL
    t = t + "SUB RsSend (key AS String, qtype AS String, address AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    IF IsNothing(rsSock) THEN" + NL
    t = t + "        rsSock = NET_Socket.New()" + NL
    t = t + "        rsSock.onMessage = Rs_OnMessage" + NL
    t = t + "    END IF" + NL
    t = t + "    name = key" + NL
    t = t + "    IF name.StartsWith(""mx:"") THEN name = name.Substring(3, name.Length - 3)" + NL
    t = t + "    rsAsking = key" + NL
    t = t + "    rsAskAt = SYS.Ticks" + NL
    t = t + "    rsRefused = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = rsSock.Connect(address, RSPORT)" + NL
    t = t + "        conn.Tag = ""rs:"" + key" + NL
    t = t + "        conn.Send(""QUERY "" + RsFull(name) + "" "" + qtype)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsRefused = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Gives up on the name server for a while: every name goes to SIM95." + NL
    t = t + "SUB RsGiveUp (why AS String)" + NL
    t = t + "    rsWhy = why" + NL
    t = t + "    rsDown = TRUE" + NL
    t = t + "    rsDownAt = SYS.Ticks" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "    rsServerAddr = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' For a program that fetches from a timer tick: TRUE when the tick must end" + NL
    t = t + "' now, because a question about host has just been sent (a Connect, so it" + NL
    t = t + "' has to be the last thing the handler does) or an answer is on its way." + NL
    t = t + "' FALSE when there is nothing to ask: RsTarget(host) is where to connect." + NL
    t = t + "' A name server that is missing, refuses or says nothing for RSWAIT is left" + NL
    t = t + "' alone for RSQUIET, and every name goes to SIM95: nothing ever hangs." + NL
    t = t + "FUNCTION RsNext (host AS String) AS Bool" + NL
    t = t + "    RETURN RsStep(host, FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for mail to domain: its MX record (the lowest preference), then" + NL
    t = t + "' the CNAMEs or address of the machine that names. RsMailTarget(domain) is" + NL
    t = t + "' then where to connect; with no MX, the domain's own machine; with no" + NL
    t = t + "' answer at all, the domain itself, for SIM95 to look up." + NL
    t = t + "FUNCTION RsNextMail (domain AS String) AS Bool" + NL
    t = t + "    IF RsStep(domain, TRUE) THEN RETURN TRUE" + NL
    t = t + "    RETURN RsStep(RsMailHost(domain), FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsStep (host AS String, mx AS Bool) AS Bool" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    ' another handler is finding the name server (it waits): wait for it" + NL
    t = t + "    IF rsLooking THEN" + NL
    t = t + "        IF SYS.Ticks - rsLookingAt < RSWAIT THEN RETURN TRUE" + NL
    t = t + "        rsLooking = FALSE" + NL
    t = t + "        RsGiveUp(""no answer about the machine "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF RsBusy() THEN RETURN TRUE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        IF NOT RsWantsMx(host) THEN RETURN FALSE" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF NOT RsWants(host) THEN RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    addr = RsServerAddress()" + NL
    t = t + "    IF addr = """" THEN RETURN FALSE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        RsAskMx(host, addr)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsAsk(host, addr)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name server's address, looked up once a minute (one lookup at a time:" + NL
    t = t + "' see SIM95-NOTES.md). """" when there is no such machine, and then it gives up." + NL
    t = t + "FUNCTION RsServerAddress () AS String" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    IF RsIsAddress(rsServer) THEN RETURN rsServer" + NL
    t = t + "    IF rsServerAddr <> """" AND rsServerFor = rsServer AND SYS.Ticks - rsServerAt < 60000 AND SYS.Ticks >= rsServerAt THEN RETURN rsServerAddr" + NL
    t = t + "    rsLooking = TRUE" + NL
    t = t + "    rsLookingAt = SYS.Ticks" + NL
    t = t + "    addr = NET.Resolve(rsServer)" + NL
    t = t + "    IF NOT rsLooking THEN RETURN """"" + NL
    t = t + "    rsLooking = FALSE" + NL
    t = t + "    IF addr = """" THEN" + NL
    t = t + "        RsGiveUp(""there is no machine called "" + rsServer)" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    rsServerAddr = addr" + NL
    t = t + "    rsServerFor = rsServer" + NL
    t = t + "    rsServerAt = SYS.Ticks" + NL
    t = t + "    RETURN addr" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsBusy () AS Bool" + NL
    t = t + "    IF rsAsking = """" THEN RETURN FALSE" + NL
    t = t + "    IF rsRefused THEN" + NL
    t = t + "        RsGiveUp(""the name server "" + rsServer + "" refused"")" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF SYS.Ticks - rsAskAt > RSWAIT THEN" + NL
    t = t + "        RsGiveUp(""no answer from the name server "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Rs_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    IF NOT conn.Tag.StartsWith(""rs:"") THEN RETURN" + NL
    t = t + "    h = conn.Tag.Substring(3, conn.Tag.Length - 3)" + NL
    t = t + "    conn.Tag = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        conn.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    RsTake(h, message)" + NL
    t = t + "    IF h = rsAsking THEN rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an answer: follows its CNAMEs to an address, or to the machine" + NL
    t = t + "' name the chain ends at." + NL
    t = t + "SUB RsTake (host AS String, reply AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR onward AS String" + NL
    t = t + "    VAR target AS String" + NL
    t = t + "    VAR canon AS String" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR hops AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    rsLastReply = reply" + NL
    t = t + "    IF host.StartsWith(""mx:"") THEN" + NL
    t = t + "        RsTakeMx(host, reply)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(host, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(host, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    cur = RsFull(host)" + NL
    t = t + "    canon = cur" + NL
    t = t + "    FOR hops = 0 TO 8" + NL
    t = t + "        onward = """"" + NL
    t = t + "        FOR i = 1 TO lines.Count - 1" + NL
    t = t + "            w = lines[i].Split("" "")" + NL
    t = t + "            IF w.Count >= 4 THEN" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""A"" AND target = """" THEN target = w[3]" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""CNAME"" THEN onward = w[3]" + NL
    t = t + "                IF w[0] = cur AND (w[2] = ""A"" OR w[2] = ""CNAME"") AND Int(Val(w[1])) < ttl THEN ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF target <> """" THEN" + NL
    t = t + "            canon = cur" + NL
    t = t + "            BREAK" + NL
    t = t + "        END IF" + NL
    t = t + "        IF onward = """" THEN BREAK" + NL
    t = t + "        canon = cur" + NL
    t = t + "        cur = onward" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF target = """" THEN" + NL
    t = t + "        ' a name with no CNAME and no address: not one to connect to" + NL
    t = t + "        IF cur = RsFull(host) THEN" + NL
    t = t + "            RsKeep(host, """", """", RSNEG)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        ' the end of the chain: a SIM95 machine name" + NL
    t = t + "        target = cur" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ttl < 5 THEN ttl = 5" + NL
    t = t + "    RsKeep(host, target, canon, ttl * 1000)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an MX answer: the mail machine with the lowest preference. With no" + NL
    t = t + "' MX, the server answers with the domain's CNAMEs instead, and the domain's" + NL
    t = t + "' own machine takes the mail." + NL
    t = t + "SUB RsTakeMx (key AS String, reply AS String)" + NL
    t = t + "    VAR domain AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR best AS String" + NL
    t = t + "    VAR pref AS Integer = 1000000" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    domain = key.Substring(3, key.Length - 3)" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(key, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RsKeep(domain, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(key, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 1 TO lines.Count - 1" + NL
    t = t + "        w = lines[i].Split("" "")" + NL
    t = t + "        IF w.Count >= 5 THEN" + NL
    t = t + "            IF w[2] = ""MX"" AND Int(Val(w[3])) < pref THEN" + NL
    t = t + "                pref = Int(Val(w[3]))" + NL
    t = t + "                best = w[4]" + NL
    t = t + "                ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF best <> """" THEN" + NL
    t = t + "        IF best.EndsWith(""."") THEN best = best.Substring(0, best.Length - 1)" + NL
    t = t + "        IF ttl < 5 THEN ttl = 5" + NL
    t = t + "        RsKeep(key, best, RsFull(domain), ttl * 1000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    RsTake(domain, reply)" + NL
    t = t + "    IF RsKnown(domain) THEN" + NL
    t = t + "        RsKeep(key, domain, RsFull(domain), RSNEG)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsKeep(key, """", """", RSNEG)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The machine (or name) that takes domain's mail: its MX, or domain itself." + NL
    t = t + "FUNCTION RsMailHost (domain AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN domain" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN domain" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where to connect for domain's mail." + NL
    t = t + "FUNCTION RsMailTarget (domain AS String) AS String" + NL
    t = t + "    RETURN RsTarget(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS say where domain's mail goes (an MX, or the domain's machine)?" + NL
    t = t + "FUNCTION RsMailKnown (domain AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN FALSE" + NL
    t = t + "    RETURN RsKnown(RsMailHost(domain)) OR NOT RsAsks(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB RsKeep (host AS String, target AS String, canon AS String, ms AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    i = rsName.IndexOf(h)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF rsName.Count >= RSMOST THEN" + NL
    t = t + "        rsName.RemoveAt(0)" + NL
    t = t + "        rsTo.RemoveAt(0)" + NL
    t = t + "        rsCanon.RemoveAt(0)" + NL
    t = t + "        rsUntil.RemoveAt(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    rsName.Add(h)" + NL
    t = t + "    rsTo.Add(target)" + NL
    t = t + "    rsCanon.Add(canon)" + NL
    t = t + "    rsUntil.Add(SYS.Ticks + ms)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where to connect for host: what SimDNS said, or host itself." + NL
    t = t + "FUNCTION RsTarget (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name host's machine was found under (www.coolsite.sim), or host." + NL
    t = t + "FUNCTION RsCanonical (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsCanon[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS answer for host (so RsTarget is its machine)?" + NL
    t = t + "FUNCTION RsKnown (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] <> """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did the name server say there is no such name (NXDOMAIN)?" + NL
    t = t + "FUNCTION RsNoSuchName (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] = """" AND rsCanon[i] = ""NXDOMAIN""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is the name server being left alone, because it didn't answer (or there" + NL
    t = t + "' is none)? rsWhy says why." + NL
    t = t + "FUNCTION RsSilent () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    IF rsServer = """" THEN RETURN TRUE" + NL
    t = t + "    RETURN rsDown AND SYS.Ticks - rsDownAt < RSQUIET" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\PROGRAMS\VAPOR.SPK")
END SUB
