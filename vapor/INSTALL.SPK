    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""' ---------------------------------------------------------------- the look"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION SideButton (text AS String, y AS Integer, h AS Handler) AS GUI_Button"" + NL" + NL
    t = t + "    t = t + ""    VAR b AS GUI_Button"" + NL" + NL
    t = t + "    t = t + ""    b = GUI_Button.New(win)"" + NL" + NL
    t = t + "    t = t + ""    b.SetBounds(8, y, 84, 30)"" + NL" + NL
    t = t + "    t = t + ""    b.Text = text"" + NL" + NL
    t = t + "    t = t + ""    b.onClick = h"" + NL" + NL
    t = t + "    t = t + ""    RETURN b"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION SiteButton (text AS String, x AS Integer, h AS Handler) AS GUI_Button"" + NL" + NL
    t = t + "    t = t + ""    VAR b AS GUI_Button"" + NL" + NL
    t = t + "    t = t + ""    b = GUI_Button.New(win)"" + NL" + NL
    t = t + "    t = t + ""    b.SetBounds(x, 216, 84, 26)"" + NL" + NL
    t = t + "    t = t + ""    b.Text = text"" + NL" + NL
    t = t + "    t = t + ""    b.onClick = h"" + NL" + NL
    t = t + "    t = t + ""    RETURN b"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION Heading (text AS String, y AS Integer) AS GUI_Label"" + NL" + NL
    t = t + "    t = t + ""    VAR l AS GUI_Label"" + NL" + NL
    t = t + "    t = t + ""    l = GUI_Label.New(win)"" + NL" + NL
    t = t + "    t = t + ""    l.SetBounds(116, y, 330, 20)"" + NL" + NL
    t = t + "    t = t + ""    l.Text = text"" + NL" + NL
    t = t + "    t = t + ""    l.Bold = TRUE"" + NL" + NL
    t = t + "    t = t + ""    RETURN l"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION Para (words AS String, y AS Integer, h AS Integer) AS GUI_Label"" + NL" + NL
    t = t + "    t = t + ""    VAR l AS GUI_Label"" + NL" + NL
    t = t + "    t = t + ""    l = GUI_Label.New(win)"" + NL" + NL
    t = t + "    t = t + ""    l.SetBounds(116, y, 444, h)"" + NL" + NL
    t = t + "    t = t + ""    l.Text = words"" + NL" + NL
    t = t + "    t = t + ""    RETURN l"" + NL" + NL
    t = t + "    t = t + ""END FUNCTION"" + NL" + NL
    t = t + "    t = t + """" + NL" + NL
    t = t + "    t = t + ""FUNCTION Cols (a AS String, b AS String, c AS String) AS String"" + NL" + NL
    t = t + "    t = t + ""    IF a.Length > 23 THEN a = a.Substring(0, 22) + """"~"""""" + NL" + NL
    t = t + "    t = t + ""    IF b.Length > 27 THEN b = b.Substring(0, 26) + """"~"""""" + NL" + NL
    Put("C:\WEB\VAPOR\SIMWEB\1.TXT")
END SUB

SUB File13 ()
    t = ""
    t = t + "    t = t + ""    RETURN a.PadRight(24) + b.PadRight(28) + c"" + NL" + NL
