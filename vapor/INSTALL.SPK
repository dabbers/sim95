    t = t + "    t = t + ""    ReadSites()"" + NL" + NL
    t = t + "    t = t + ""    FillList()"" + NL" + NL
    t = t + "    t = t + ""    CheckAll()"" + NL" + NL
    t = t + "    t = t + ""    ShowPage(""""main"""")"" + NL" + NL
    t = t + "    t = t + ""    IF SYS.Args.Count > 0 THEN"" + NL" + NL
    t = t + "    t = t + ""        IF SYS.Args[0].Lower() = """"sites"""" THEN ShowPage(""""sites"""")"" + NL" + NL
    t = t + "    t = t + ""        IF SYS.Args[0].Lower() = """"apps"""" THEN ShowPage(""""apps"""")"" + NL" + NL
    t = t + "    t = t + ""    END IF"" + NL" + NL
    t = t + "    t = t + ""    win.Show()"" + NL" + NL
