' VAPOR|id=FROSTBRD|name=Frostbird|kind=program|version=1fb85dda|category=Internet|run=C:\PROGRAMS\FROSTBRD.SPK|files=C:\PROGRAMS\FROSTBRD.SPK|tasks=FROSTBRD|startup=|folder=|about=A desktop mail program for ColdMail: Get Mail, Write, Reply, Forward.
' INSTALL.SPK - puts Frostbird on this machine. Generated by tools/build-installer.mjs;
' edit the files in frostbird/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. It writes
' Frostbird, a mail program for ColdMail, to C:\PROGRAMS\FROSTBRD.SPK and
' starts it. Any machine can have it: it collects your mail from the ColdMail
' server named in your address (ann@alpha: the machine ALPHA), which needs
' ColdMail's newer MAILD.SPK (the one that listens on port 110 too). Letters
' are kept in C:\FROST. Simxplorer's Mail button opens it.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)




    File0()
    Print("Frostbird is installed (1 files).")
    SYS.Start("C:\PROGRAMS\FROSTBRD.SPK", "")

    Print("Frostbird is running. Next time, start C:\PROGRAMS\FROSTBRD.SPK from Files.")
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "' FROSTBRD.SPK - Frostbird, a desktop mail program for ColdMail." + NL
    t = t + "'" + NL
    t = t + "' Three panes, like the mail programs of the day: folders on the left, the" + NL
    t = t + "' letters in the folder at the top, the letter you are reading below. Get Mail" + NL
    t = t + "' signs in to your ColdMail server on port 110 (see MAILD.SPK) and brings" + NL
    t = t + "' down what is new; Write, Reply and Forward send through the same server." + NL
    t = t + "' Letters stay on the server too, so the webmail still shows them." + NL
    t = t + "'" + NL
    t = t + "' Files (all in C:\FROST):" + NL
    t = t + "'   ACCOUNT.INI          address=, pass= (scrambled, not secret: it is 1996), check= minutes" + NL
    t = t + "'   INBOX.TXT, SENT.TXT  one line per letter: n|date|from|to|subject|size|flags" + NL
    t = t + "'                        (n is the server's number; flags has N while unread)" + NL
    t = t + "'   MAIL\<n>.MSG         the letters themselves" + NL
    t = t + "'" + NL
    t = t + "' A conversation with the server is a list of commands sent one at a time;" + NL
    t = t + "' each answer (Pop_OnMessage) sends the next. Connecting happens in a timer" + NL
    t = t + "' tick of its own, inside a TRY with an empty CATCH: see SIM95-NOTES.md." + NL
    t = t + "'" + NL
    t = t + "' The server is the part of the address after the @. A domain such as" + NL
    t = t + "' coolsite.sim is asked about first (the builder joins the SimDNS resolver," + NL
    t = t + "' simweb/src/RESOLVE.SPK, on the end): its MX record, the one with the lowest" + NL
    t = t + "' preference, then the CNAMEs of the machine that names; each question takes" + NL
    t = t + "' a tick of its own. With no name server, or no answer, it is a SIM95" + NL
    t = t + "' machine name, as always." + NL
    t = t + "" + NL
    t = t + "CONST HOME = ""C:\FROST""" + NL
    t = t + "CONST POPPORT = 110" + NL
    t = t + "CONST PATIENCE = 8000" + NL
    t = t + "CONST TBW = 64" + NL
    t = t + "CONST TBH = 44" + NL
    t = t + "CONST TBCOUNT = 6" + NL
    t = t + "" + NL
    t = t + "VAR EOL AS String" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR bar AS GUI_Menu" + NL
    t = t + "VAR tools AS GUI_Canvas" + NL
    t = t + "VAR folders AS GUI_ListBox" + NL
    t = t + "VAR letters AS GUI_ListBox" + NL
    t = t + "VAR reader AS GUI_TextArea" + NL
    t = t + "VAR clock AS GUI_Timer" + NL
    t = t + "VAR sock AS NET_Socket" + NL
    t = t + "VAR tbPressed AS Integer = -1" + NL
    t = t + "" + NL
    t = t + "' the account" + NL
    t = t + "VAR myAddress AS String" + NL
    t = t + "VAR myPass AS String" + NL
    t = t + "VAR checkEvery AS Integer = 5" + NL
    t = t + "VAR lastCheck AS Integer" + NL
    t = t + "" + NL
    t = t + "' what is showing" + NL
    t = t + "VAR folder AS String = ""INBOX""" + NL
    t = t + "VAR shown AS Array OF String       ' index lines of the letters in the list, in order" + NL
    t = t + "" + NL
    t = t + "' talking to the server" + NL
    t = t + "VAR jobs AS Array OF String        ' ""get"", ""dele|n"", ""send|letter""" + NL
    t = t + "VAR talking AS Bool" + NL
    t = t + "VAR wantConnect AS Bool" + NL
    t = t + "VAR cmds AS Array OF String        ' what to say, in order (""RETR 7|INBOX"": the part after | is ours)" + NL
    t = t + "VAR cmdAt AS Integer" + NL
    t = t + "VAR convNumber AS Integer" + NL
    t = t + "VAR convError AS String" + NL
    t = t + "VAR convSince AS Integer" + NL
    t = t + "VAR newCount AS Integer" + NL
    t = t + "VAR quiet AS Bool                  ' an automatic check: no box if it fails" + NL
    t = t + "" + NL
    t = t + "' ================================================================ start" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    EOL = Chr(10)" + NL
    t = t + "    IF NOT FS.Exists(HOME) THEN FS.MakeDir(HOME)" + NL
    t = t + "    IF NOT FS.Exists(HOME + ""\MAIL"") THEN FS.MakeDir(HOME + ""\MAIL"")" + NL
    t = t + "    LoadAccount()" + NL
    t = t + "    win = GUI_Window.New(""Frostbird"", 720, 480)" + NL
    t = t + "    win.Icon = ""chat""" + NL
    t = t + "    win.Resizable = TRUE" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    win.onResize = Win_OnResize" + NL
    t = t + "" + NL
    t = t + "    bar = GUI_Menu.New(win)" + NL
    t = t + "    bar.onSelect = Menu_OnSelect" + NL
    t = t + "    bar.AddMenu(""&File"")" + NL
    t = t + "    bar.AddItem(""&File"", ""&Get New Mail"" + Chr(9) + ""F5"")" + NL
    t = t + "    bar.AddItem(""&File"", ""&Write a Letter"" + Chr(9) + ""Ctrl+N"")" + NL
    t = t + "    bar.AddSeparator(""&File"")" + NL
    t = t + "    bar.AddItem(""&File"", ""&Account Settings..."")" + NL
    t = t + "    bar.AddSeparator(""&File"")" + NL
    t = t + "    bar.AddItem(""&File"", ""E&xit"" + Chr(9) + ""Ctrl+Q"")" + NL
    t = t + "    bar.AddMenu(""&Message"")" + NL
    t = t + "    bar.AddItem(""&Message"", ""&Reply"" + Chr(9) + ""Ctrl+R"")" + NL
    t = t + "    bar.AddItem(""&Message"", ""&Forward"" + Chr(9) + ""Ctrl+L"")" + NL
    t = t + "    bar.AddItem(""&Message"", ""&Delete"" + Chr(9) + ""Delete"")" + NL
    t = t + "    bar.AddItem(""&Message"", ""Mark as &Unread"" + Chr(9) + ""Ctrl+U"")" + NL
    t = t + "    bar.AddMenu(""&Help"")" + NL
    t = t + "    bar.AddItem(""&Help"", ""&About Frostbird"")" + NL
    t = t + "" + NL
    t = t + "    tools = GUI_Canvas.New(win)" + NL
    t = t + "    tools.onDraw = Tools_OnDraw" + NL
    t = t + "    tools.onMouseDown = Tools_OnMouseDown" + NL
    t = t + "    tools.onMouseUp = Tools_OnMouseUp" + NL
    t = t + "    folders = GUI_ListBox.New(win)" + NL
    t = t + "    folders.onSelect = Folders_OnSelect" + NL
    t = t + "    letters = GUI_ListBox.New(win)" + NL
    t = t + "    letters.Mono = TRUE" + NL
    t = t + "    letters.onSelect = Letters_OnSelect" + NL
    t = t + "    letters.onDblClick = Letters_OnSelect" + NL
    t = t + "    reader = GUI_TextArea.New(win)" + NL
    t = t + "    reader.ReadOnly = TRUE" + NL
    t = t + "    reader.WordWrap = TRUE" + NL
    t = t + "    Win_OnResize()" + NL
    t = t + "" + NL
    t = t + "    sock = NET_Socket.New()" + NL
    t = t + "    sock.onMessage = Pop_OnMessage" + NL
    t = t + "    sock.onClose = Pop_OnClose" + NL
    t = t + "    clock = GUI_Timer.New(win)" + NL
    t = t + "    clock.Interval = 200" + NL
    t = t + "    clock.onTick = Clock_OnTick" + NL
    t = t + "    clock.Start()" + NL
    t = t + "" + NL
    t = t + "    ShowFolders()" + NL
    t = t + "    folders.Selected = 0" + NL
    t = t + "    ShowFolder(""INBOX"")" + NL
    t = t + "    win.Status = ""Ready""" + NL
    t = t + "    win.Show()" + NL
    t = t + "    IF myAddress = """" THEN" + NL
    t = t + "        AccountSettings()" + NL
    t = t + "    ELSE" + NL
    t = t + "        GetMail(TRUE)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF SYS.Args.Count > 0 THEN" + NL
    t = t + "        IF SYS.Args[0].Lower().StartsWith(""mailto:"") THEN Compose(SYS.Args[0].Substring(7, SYS.Args[0].Length - 7), """", """", """")" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnResize ()" + NL
    t = t + "    VAR w AS Integer" + NL
    t = t + "    VAR h AS Integer" + NL
    t = t + "    w = win.Width" + NL
    t = t + "    h = win.Height" + NL
    t = t + "    tools.SetBounds(0, 0, w, TBH + 3)" + NL
    t = t + "    folders.SetBounds(2, TBH + 5, 140, h - TBH - 7)" + NL
    t = t + "    letters.SetBounds(146, TBH + 5, w - 148, Int((h - TBH) * 0.4))" + NL
    t = t + "    reader.SetBounds(146, TBH + 9 + Int((h - TBH) * 0.4), w - 148, h - TBH - 11 - Int((h - TBH) * 0.4))" + NL
    t = t + "    DrawTools()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the account" + NL
    t = t + "" + NL
    t = t + "' The password is kept scrambled, which keeps it from a glance and no more." + NL
    t = t + "FUNCTION Scramble (s AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        out = out + (""000"" + Hex(Asc(s.CharAt(i)) + (7 * (i + 1)) MOD 13 + 16)).Substring((""000"" + Hex(Asc(s.CharAt(i)) + (7 * (i + 1)) MOD 13 + 16)).Length - 4, 4)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unscramble (s AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    FOR i = 0 TO Int(s.Length / 4) - 1" + NL
    t = t + "        c = HexVal(s.Substring(i * 4, 4)) - (7 * (i + 1)) MOD 13 - 16" + NL
    t = t + "        out = out + Chr(c)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION HexVal (h AS String) AS Integer" + NL
    t = t + "    VAR v AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO h.Length - 1" + NL
    t = t + "        v = v * 16 + ""0123456789ABCDEF"".IndexOf(h.CharAt(i).Upper())" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN v" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB LoadAccount ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(HOME + ""\ACCOUNT.INI"", """").Lines()" + NL
    t = t + "        IF line.StartsWith(""address="") THEN myAddress = line.Substring(8, line.Length - 8).Trim().Lower()" + NL
    t = t + "        IF line.StartsWith(""pass="") THEN myPass = Unscramble(line.Substring(5, line.Length - 5).Trim())" + NL
    t = t + "        IF line.StartsWith(""check="") THEN checkEvery = Int(Val(line.Substring(6, line.Length - 6)))" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB SaveAccount ()" + NL
    t = t + "    FS.Write(HOME + ""\ACCOUNT.INI"", ""address="" + myAddress + EOL + ""pass="" + Scramble(myPass) + EOL + ""check="" + Str(checkEvery) + EOL)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "VAR setWin AS GUI_Window" + NL
    t = t + "VAR setAddress AS GUI_TextBox" + NL
    t = t + "VAR setPass AS GUI_TextBox" + NL
    t = t + "VAR setCheck AS GUI_DropDown" + NL
    t = t + "" + NL
    t = t + "SUB AccountSettings ()" + NL
    t = t + "    VAR l AS GUI_Label" + NL
    t = t + "    VAR b AS GUI_Button" + NL
    t = t + "    setWin = GUI_Window.New(""Account Settings"", 380, 190)" + NL
    t = t + "    setWin.Modal = TRUE" + NL
    t = t + "    setWin.Icon = ""settings""" + NL
    t = t + "    l = GUI_Label.New(setWin)" + NL
    t = t + "    l.Text = ""Frostbird reads your ColdMail. Type the address and password you"" + EOL + ""use for the webmail; the server is the machine after the @.""" + NL
    t = t + "    l.SetBounds(10, 8, 360, 32)" + NL
    t = t + "    l = GUI_Label.New(setWin)" + NL
    t = t + "    l.Text = ""&E-mail address:""" + NL
    t = t + "    l.SetBounds(10, 54, 100, 14)" + NL
    t = t + "    setAddress = GUI_TextBox.New(setWin)" + NL
    t = t + "    setAddress.Text = myAddress" + NL
    t = t + "    setAddress.SetBounds(120, 50, 250, 21)" + NL
    t = t + "    l = GUI_Label.New(setWin)" + NL
    t = t + "    l.Text = ""&Password:""" + NL
    t = t + "    l.SetBounds(10, 84, 100, 14)" + NL
    t = t + "    setPass = GUI_TextBox.New(setWin)" + NL
    t = t + "    setPass.Password = TRUE" + NL
    t = t + "    setPass.Text = myPass" + NL
    t = t + "    setPass.SetBounds(120, 80, 250, 21)" + NL
    t = t + "    l = GUI_Label.New(setWin)" + NL
    t = t + "    l.Text = ""&Check for mail:""" + NL
    t = t + "    l.SetBounds(10, 114, 100, 14)" + NL
    t = t + "    setCheck = GUI_DropDown.New(setWin)" + NL
    t = t + "    setCheck.Items = [""every minute"", ""every 5 minutes"", ""every 15 minutes"", ""never""]" + NL
    t = t + "    setCheck.Selected = 1" + NL
    t = t + "    IF checkEvery = 1 THEN setCheck.Selected = 0" + NL
    t = t + "    IF checkEvery = 15 THEN setCheck.Selected = 2" + NL
    t = t + "    IF checkEvery = 0 THEN setCheck.Selected = 3" + NL
    t = t + "    setCheck.SetBounds(120, 110, 150, 21)" + NL
    t = t + "    b = GUI_Button.New(setWin)" + NL
    t = t + "    b.Text = ""OK""" + NL
    t = t + "    b.Default = TRUE" + NL
    t = t + "    b.SetBounds(206, 152, 78, 26)" + NL
    t = t + "    b.onClick = Settings_Ok" + NL
    t = t + "    b = GUI_Button.New(setWin)" + NL
    t = t + "    b.Text = ""Cancel""" + NL
    t = t + "    b.Cancel = TRUE" + NL
    t = t + "    b.SetBounds(292, 152, 78, 26)" + NL
    t = t + "    b.onClick = Settings_Cancel" + NL
    t = t + "    setWin.Center()" + NL
    t = t + "    setWin.Show()" + NL
    t = t + "    setAddress.Focus()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Settings_Ok ()" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    a = setAddress.Text.Trim().Lower()" + NL
    t = t + "    IF NOT a.Contains(""@"") OR a.StartsWith(""@"") OR a.EndsWith(""@"") THEN" + NL
    t = t + "        Say(""Addresses look like ann@alpha: your mail name, an @, and the machine that keeps your mail."", ""warn"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    myAddress = a" + NL
    t = t + "    myPass = setPass.Text" + NL
    t = t + "    checkEvery = Int(Val(""1|5|15|0"".Split(""|"")[setCheck.Selected]))" + NL
    t = t + "    SaveAccount()" + NL
    t = t + "    setWin.Close()" + NL
    t = t + "    GetMail(FALSE)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Settings_Cancel ()" + NL
    t = t + "    setWin.Close()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ServerName () AS String" + NL
    t = t + "    RETURN myAddress.Substring(myAddress.IndexOf(""@"") + 1, myAddress.Length - myAddress.IndexOf(""@"") - 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ folders and letters" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Esc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%"", ""%25"").Replace(""|"", ""%7C"").Replace(Chr(13), """").Replace(Chr(10), ""%0A"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unesc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%0A"", Chr(10)).Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Index (f AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(HOME + ""\"" + f + "".TXT"", """").Lines()" + NL
    t = t + "        IF line.Split(""|"").Count >= 7 THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SaveIndex (f AS String, lines AS Array OF String)" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    IF lines.Count > 0 THEN text = lines.Join(EOL) + EOL" + NL
    t = t + "    FS.Write(HOME + ""\"" + f + "".TXT"", text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unread () AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    FOR EACH line IN Index(""INBOX"")" + NL
    t = t + "        IF line.Split(""|"")[6].Contains(""N"") THEN n = n + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB ShowFolders ()" + NL
    t = t + "    VAR keep AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    keep = folders.Selected" + NL
    t = t + "    n = Unread()" + NL
    t = t + "    folders.Clear()" + NL
    t = t + "    IF n > 0 THEN" + NL
    t = t + "        folders.Add(""Inbox ("" + Str(n) + "")"")" + NL
    t = t + "        win.Title = ""("" + Str(n) + "") Frostbird""" + NL
    t = t + "    ELSE" + NL
    t = t + "        folders.Add(""Inbox"")" + NL
    t = t + "        win.Title = ""Frostbird""" + NL
    t = t + "    END IF" + NL
    t = t + "    folders.Add(""Sent"")" + NL
    t = t + "    IF keep >= 0 THEN folders.Selected = keep" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Folders_OnSelect ()" + NL
    t = t + "    IF folders.Selected = 1 THEN" + NL
    t = t + "        ShowFolder(""SENT"")" + NL
    t = t + "    ELSE" + NL
    t = t + "        ShowFolder(""INBOX"")" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ""Ann Example <ann@alpha>"" -> ""Ann Example""" + NL
    t = t + "FUNCTION NameOf (address AS String) AS String" + NL
    t = t + "    address = address.Trim()" + NL
    t = t + "    IF address.Contains(""<"") AND address.IndexOf(""<"") > 0 THEN RETURN address.Substring(0, address.IndexOf(""<"")).Trim().Replace("""""""", """")" + NL
    t = t + "    RETURN address" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Fit (s AS String, width AS Integer) AS String" + NL
    t = t + "    IF s.Length > width THEN RETURN s.Substring(0, width - 1) + ""~""" + NL
    t = t + "    RETURN s.PadRight(width)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One line of the letter list: unread mark, who, subject, date." + NL
    t = t + "FUNCTION ListLine (line AS String) AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR mark AS String = "" """ + NL
    t = t + "    VAR person AS String" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    IF p[6].Contains(""N"") THEN mark = ""*""" + NL
    t = t + "    IF folder = ""SENT"" THEN" + NL
    t = t + "        person = ""To: "" + NameOf(Unesc(p[3]))" + NL
    t = t + "    ELSE" + NL
    t = t + "        person = NameOf(Unesc(p[2]))" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN mark + "" "" + Fit(person, 22) + "" "" + Fit(Unesc(p[4]), 34) + "" "" + p[1]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB ShowFolder (f AS String)" + NL
    t = t + "    VAR all AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR keep AS String" + NL
    t = t + "    IF letters.Selected >= 0 AND letters.Selected < shown.Count AND f = folder THEN keep = shown[letters.Selected].Split(""|"")[0]" + NL
    t = t + "    folder = f" + NL
    t = t + "    all = Index(f)" + NL
    t = t + "    shown.Clear()" + NL
    t = t + "    letters.Clear()" + NL
    t = t + "    ' newest first" + NL
    t = t + "    FOR i = all.Count - 1 TO 0 STEP -1" + NL
    t = t + "        shown.Add(all[i])" + NL
    t = t + "        letters.Add(ListLine(all[i]))" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF shown.Count = 0 THEN reader.Text = """"" + NL
    t = t + "    FOR i = 0 TO shown.Count - 1" + NL
    t = t + "        IF shown[i].Split(""|"")[0] = keep THEN letters.Selected = i" + NL
    t = t + "    NEXT" + NL
    t = t + "    DrawTools()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Current () AS String" + NL
    t = t + "    IF letters.Selected < 0 OR letters.Selected >= shown.Count THEN RETURN """"" + NL
    t = t + "    RETURN shown[letters.Selected]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LetterText (n AS String) AS String" + NL
    t = t + "    RETURN ReadOr(HOME + ""\MAIL\"" + n + "".MSG"", """")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The value of a header line, or """"." + NL
    t = t + "FUNCTION Header (letter AS String, name AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN letter.Lines()" + NL
    t = t + "        IF line = """" THEN RETURN """"" + NL
    t = t + "        IF line.Lower().StartsWith(name.Lower() + "":"") THEN RETURN line.Substring(name.Length + 1, line.Length - name.Length - 1).Trim()" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION BodyOf (letter AS String) AS String" + NL
    t = t + "    letter = letter.Replace(Chr(13), """")" + NL
    t = t + "    IF NOT letter.Contains(EOL + EOL) THEN RETURN """"" + NL
    t = t + "    RETURN letter.Substring(letter.IndexOf(EOL + EOL) + 2, letter.Length - letter.IndexOf(EOL + EOL) - 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Letters_OnSelect ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR letter AS String" + NL
    t = t + "    VAR all AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    line = Current()" + NL
    t = t + "    IF line = """" THEN RETURN" + NL
    t = t + "    letter = LetterText(line.Split(""|"")[0])" + NL
    t = t + "    reader.Text = ""From:     "" + Header(letter, ""From"") + EOL _" + NL
    t = t + "                + ""To:       "" + Header(letter, ""To"") + EOL _" + NL
    t = t + "                + ""Date:     "" + Header(letter, ""Date"") + EOL _" + NL
    t = t + "                + ""Subject:  "" + Header(letter, ""Subject"") + EOL _" + NL
    t = t + "                + ""--------------------------------------------------------------"" + EOL + EOL + BodyOf(letter)" + NL
    t = t + "    IF line.Split(""|"")[6].Contains(""N"") THEN" + NL
    t = t + "        all = Index(folder)" + NL
    t = t + "        FOR i = 0 TO all.Count - 1" + NL
    t = t + "            IF all[i] = line THEN all[i] = line.Substring(0, line.Length - line.Split(""|"")[6].Length) + line.Split(""|"")[6].Replace(""N"", """")" + NL
    t = t + "        NEXT" + NL
    t = t + "        SaveIndex(folder, all)" + NL
    t = t + "        i = letters.Selected" + NL
    t = t + "        ShowFolder(folder)" + NL
    t = t + "        letters.Selected = i" + NL
    t = t + "        ShowFolders()" + NL
    t = t + "    END IF" + NL
    t = t + "    DrawTools()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB MarkUnread ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR all AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    line = Current()" + NL
    t = t + "    IF line = """" OR line.Split(""|"")[6].Contains(""N"") THEN RETURN" + NL
    t = t + "    all = Index(folder)" + NL
    t = t + "    FOR i = 0 TO all.Count - 1" + NL
    t = t + "        IF all[i] = line THEN all[i] = line + ""N""" + NL
    t = t + "    NEXT" + NL
    t = t + "    SaveIndex(folder, all)" + NL
    t = t + "    i = letters.Selected" + NL
    t = t + "    ShowFolder(folder)" + NL
    t = t + "    letters.Selected = i" + NL
    t = t + "    ShowFolders()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DeleteLetter ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR all AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR l AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    line = Current()" + NL
    t = t + "    IF line = """" THEN RETURN" + NL
    t = t + "    i = letters.Selected" + NL
    t = t + "    FOR EACH l IN Index(folder)" + NL
    t = t + "        IF l <> line THEN out.Add(l)" + NL
    t = t + "    NEXT" + NL
    t = t + "    SaveIndex(folder, out)" + NL
    t = t + "    IF FS.Exists(HOME + ""\MAIL\"" + line.Split(""|"")[0] + "".MSG"") THEN FS.Delete(HOME + ""\MAIL\"" + line.Split(""|"")[0] + "".MSG"")" + NL
    t = t + "    ' gone from the server as well, so the webmail agrees" + NL
    t = t + "    jobs.Add(""dele|"" + line.Split(""|"")[0])" + NL
    t = t + "    reader.Text = """"" + NL
    t = t + "    ShowFolder(folder)" + NL
    t = t + "    IF letters.Count > 0 THEN" + NL
    t = t + "        letters.Selected = MATH.Min(i, letters.Count - 1)" + NL
    t = t + "        Letters_OnSelect()" + NL
    t = t + "    END IF" + NL
    t = t + "    ShowFolders()" + NL
    t = t + "    win.Status = ""Deleted.""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ writing" + NL
    t = t + "" + NL
    t = t + "VAR cWin AS Array OF GUI_Window    ' letters being written, each in a window" + NL
    t = t + "VAR cTo AS Array OF GUI_TextBox" + NL
    t = t + "VAR cSubject AS Array OF GUI_TextBox" + NL
    t = t + "VAR cText AS Array OF GUI_TextArea" + NL
    t = t + "" + NL
    t = t + "SUB Compose (toList AS String, subject AS String, text AS String, title AS String)" + NL
    t = t + "    VAR w AS GUI_Window" + NL
    t = t + "    VAR l AS GUI_Label" + NL
    t = t + "    VAR t AS GUI_TextBox" + NL
    t = t + "    VAR s AS GUI_TextBox" + NL
    t = t + "    VAR a AS GUI_TextArea" + NL
    t = t + "    VAR b AS GUI_Button" + NL
    t = t + "    IF title = """" THEN title = ""Write: (no subject)""" + NL
    t = t + "    w = GUI_Window.New(title, 520, 380)" + NL
    t = t + "    w.Icon = ""notes""" + NL
    t = t + "    w.Tag = Str(cWin.Count)" + NL
    t = t + "    l = GUI_Label.New(w)" + NL
    t = t + "    l.Text = ""&To:""" + NL
    t = t + "    l.SetBounds(8, 12, 60, 14)" + NL
    t = t + "    t = GUI_TextBox.New(w)" + NL
    t = t + "    t.Text = toList" + NL
    t = t + "    t.SetBounds(70, 8, 442, 21)" + NL
    t = t + "    l = GUI_Label.New(w)" + NL
    t = t + "    l.Text = ""S&ubject:""" + NL
    t = t + "    l.SetBounds(8, 40, 60, 14)" + NL
    t = t + "    s = GUI_TextBox.New(w)" + NL
    t = t + "    s.Text = subject" + NL
    t = t + "    s.SetBounds(70, 36, 442, 21)" + NL
    t = t + "    a = GUI_TextArea.New(w)" + NL
    t = t + "    a.WordWrap = TRUE" + NL
    t = t + "    a.Text = text" + NL
    t = t + "    a.SetBounds(8, 64, 504, 274)" + NL
    t = t + "    b = GUI_Button.New(w)" + NL
    t = t + "    b.Text = ""&Send""" + NL
    t = t + "    b.Tag = Str(cWin.Count)" + NL
    t = t + "    b.SetBounds(352, 346, 76, 26)" + NL
    t = t + "    b.onClick = Compose_Send" + NL
    t = t + "    b = GUI_Button.New(w)" + NL
    t = t + "    b.Text = ""Cancel""" + NL
    t = t + "    b.Tag = Str(cWin.Count)" + NL
    t = t + "    b.SetBounds(436, 346, 76, 26)" + NL
    t = t + "    b.onClick = Compose_Cancel" + NL
    t = t + "    cWin.Add(w)" + NL
    t = t + "    cTo.Add(t)" + NL
    t = t + "    cSubject.Add(s)" + NL
    t = t + "    cText.Add(a)" + NL
    t = t + "    w.Show()" + NL
    t = t + "    IF toList = """" THEN" + NL
    t = t + "        t.Focus()" + NL
    t = t + "    ELSE" + NL
    t = t + "        a.Focus()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Several windows share these handlers: the one whose button has the focus" + NL
    t = t + "' is the one (see SAMPLES\CALC.SPK); failing that, the last one opened." + NL
    t = t + "FUNCTION Which () AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = cWin.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF NOT IsNothing(cWin[i]) THEN" + NL
    t = t + "            IF cWin[i].Active THEN RETURN i" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR i = cWin.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF cWin[i].Visible THEN RETURN i" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN -1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Compose_Send ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR letter AS String" + NL
    t = t + "    i = Which()" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    IF cTo[i].Text.Trim() = """" THEN" + NL
    t = t + "        Say(""Who is it to? Addresses look like bob@bravo."", ""warn"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF myAddress = """" THEN" + NL
    t = t + "        AccountSettings()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    letter = ""To: "" + cTo[i].Text.Replace(EOL, "" "") + EOL + ""Subject: "" + cSubject[i].Text.Replace(EOL, "" "") + EOL + EOL + cText[i].Text.Replace(Chr(13), """")" + NL
    t = t + "    jobs.Add(""send|"" + letter)" + NL
    t = t + "    cWin[i].Hide()" + NL
    t = t + "    win.Status = ""Sending...""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Compose_Cancel ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = Which()" + NL
    t = t + "    IF i >= 0 THEN cWin[i].Hide()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Quote (letter AS String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    out = EOL + EOL + ""On "" + Header(letter, ""Date"") + "", "" + NameOf(Header(letter, ""From"")) + "" wrote:"" + EOL" + NL
    t = t + "    FOR EACH line IN BodyOf(letter).Lines()" + NL
    t = t + "        out = out + ""> "" + line + EOL" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Reply ()" + NL
    t = t + "    VAR letter AS String" + NL
    t = t + "    VAR subject AS String" + NL
    t = t + "    IF Current() = """" THEN RETURN" + NL
    t = t + "    letter = LetterText(Current().Split(""|"")[0])" + NL
    t = t + "    subject = Header(letter, ""Subject"")" + NL
    t = t + "    IF NOT subject.Lower().StartsWith(""re:"") THEN subject = ""Re: "" + subject" + NL
    t = t + "    IF folder = ""SENT"" THEN" + NL
    t = t + "        Compose(Header(letter, ""To""), subject, Quote(letter), ""Write: "" + subject)" + NL
    t = t + "    ELSE" + NL
    t = t + "        Compose(Bare(Header(letter, ""From"")), subject, Quote(letter), ""Write: "" + subject)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Forward ()" + NL
    t = t + "    VAR letter AS String" + NL
    t = t + "    VAR subject AS String" + NL
    t = t + "    IF Current() = """" THEN RETURN" + NL
    t = t + "    letter = LetterText(Current().Split(""|"")[0])" + NL
    t = t + "    subject = ""Fwd: "" + Header(letter, ""Subject"")" + NL
    t = t + "    Compose("""", subject, EOL + EOL + ""-------- Forwarded Message --------"" + EOL + ""From: "" + Header(letter, ""From"") + EOL + ""Date: "" + Header(letter, ""Date"") + EOL + ""Subject: "" + Header(letter, ""Subject"") + EOL + EOL + BodyOf(letter), ""Write: "" + subject)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Bare (address AS String) AS String" + NL
    t = t + "    VAR a AS String" + NL
    t = t + "    a = address.Trim()" + NL
    t = t + "    IF a.Contains(""<"") AND a.Contains("">"") THEN a = a.Substring(a.IndexOf(""<"") + 1, a.IndexOf("">"") - a.IndexOf(""<"") - 1)" + NL
    t = t + "    RETURN a.Trim().Lower()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ talking to the server" + NL
    t = t + "" + NL
    t = t + "SUB GetMail (automatic AS Bool)" + NL
    t = t + "    IF myAddress = """" THEN" + NL
    t = t + "        AccountSettings()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT jobs.Contains(""get"") THEN jobs.Add(""get"")" + NL
    t = t + "    quiet = automatic" + NL
    t = t + "    lastCheck = SYS.Ticks" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Clock_OnTick ()" + NL
    t = t + "    ' nothing may come after this TRY: a tick whose Connect failed is spoiled" + NL
    t = t + "    TRY" + NL
    t = t + "        Tick()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Tick ()" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    IF talking THEN" + NL
    t = t + "        IF convError <> """" OR SYS.Ticks - convSince > PATIENCE THEN EndTalk()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF checkEvery > 0 AND SYS.Ticks - lastCheck > checkEvery * 60000 THEN GetMail(TRUE)" + NL
    t = t + "    IF jobs.Count = 0 OR myAddress = """" THEN RETURN" + NL
    t = t + "    ' a domain: where its mail goes, asked in ticks of their own first" + NL
    t = t + "    IF RsNextMail(ServerName()) THEN" + NL
    t = t + "        win.Status = ""Looking up "" + ServerName() + ""...""" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    ' everything waiting goes in one conversation" + NL
    t = t + "    cmds.Clear()" + NL
    t = t + "    cmds.Add(""USER "" + myAddress.Split(""@"")[0])" + NL
    t = t + "    cmds.Add(""PASS "" + myPass)" + NL
    t = t + "    newCount = 0" + NL
    t = t + "    WHILE jobs.Count > 0" + NL
    t = t + "        IF jobs[0] = ""get"" THEN" + NL
    t = t + "            cmds.Add(""LIST|INBOX"")" + NL
    t = t + "            cmds.Add(""LIST SENT|SENT"")" + NL
    t = t + "            win.Status = ""Checking for mail on "" + ServerName() + ""...""" + NL
    t = t + "        ELSEIF jobs[0].StartsWith(""dele|"") THEN" + NL
    t = t + "            cmds.Add(""DELE "" + jobs[0].Substring(5, jobs[0].Length - 5))" + NL
    t = t + "        ELSEIF jobs[0].StartsWith(""send|"") THEN" + NL
    t = t + "            cmds.Add(""SEND"" + EOL + jobs[0].Substring(5, jobs[0].Length - 5))" + NL
    t = t + "            ' and bring the copy in Sent down" + NL
    t = t + "            cmds.Add(""LIST SENT|SENT"")" + NL
    t = t + "        END IF" + NL
    t = t + "        jobs.RemoveAt(0)" + NL
    t = t + "    END WHILE" + NL
    t = t + "    cmds.Add(""QUIT"")" + NL
    t = t + "    cmdAt = -1" + NL
    t = t + "    convNumber = convNumber + 1" + NL
    t = t + "    convError = """"" + NL
    t = t + "    convSince = SYS.Ticks" + NL
    t = t + "    talking = TRUE" + NL
    t = t + "    DrawTools()" + NL
    t = t + "    TRY" + NL
    t = t + "        ' (the machine SimDNS named for the domain's mail, or the name itself)" + NL
    t = t + "        conn = sock.Connect(RsMailTarget(ServerName()), POPPORT)" + NL
    t = t + "        conn.Tag = Str(convNumber)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        convError = err" + NL
    t = t + "    END TRY" + NL
    t = t + "    ' (the server speaks first: Pop_OnMessage carries on from its greeting)" + NL
    t = t + "    ' Nothing else may wait in this tick." + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The server's answer to what we said last (or its greeting): note it, say the next thing." + NL
    t = t + "SUB Pop_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR said AS String" + NL
    t = t + "    VAR tag AS String" + NL
    t = t + "    VAR answer AS String" + NL
    t = t + "    IF conn.Tag <> Str(convNumber) OR NOT talking THEN RETURN" + NL
    t = t + "    convSince = SYS.Ticks" + NL
    t = t + "    IF cmdAt >= 0 THEN" + NL
    t = t + "        said = cmds[cmdAt]" + NL
    t = t + "        tag = """"" + NL
    t = t + "        IF said.Contains(""|"") THEN" + NL
    t = t + "            tag = said.Substring(said.IndexOf(""|"") + 1, said.Length - said.IndexOf(""|"") - 1)" + NL
    t = t + "            said = said.Substring(0, said.IndexOf(""|""))" + NL
    t = t + "        END IF" + NL
    t = t + "        answer = """"" + NL
    t = t + "        IF message.Contains(EOL) THEN answer = message.Substring(message.IndexOf(EOL) + 1, message.Length - message.IndexOf(EOL) - 1)" + NL
    t = t + "        IF message.StartsWith(""-ERR"") THEN" + NL
    t = t + "            IF said.StartsWith(""PASS"") THEN" + NL
    t = t + "                convError = ""The server on "" + ServerName() + "" says: "" + message.Substring(5, message.Length - 5) + "" Check the password in Account Settings.""" + NL
    t = t + "                RETURN" + NL
    t = t + "            END IF" + NL
    t = t + "            IF said.StartsWith(""SEND"") THEN Say(""Your letter was not sent:"" + EOL + EOL + message.Substring(5, message.Length - 5), ""warn"")" + NL
    t = t + "        ELSEIF said.StartsWith(""LIST"") THEN" + NL
    t = t + "            Listed(tag, answer)" + NL
    t = t + "        ELSEIF said.StartsWith(""RETR"") THEN" + NL
    t = t + "            Fetched(tag, said.Substring(5, said.Length - 5).Trim(), answer)" + NL
    t = t + "        ELSEIF said.StartsWith(""SEND"") THEN" + NL
    t = t + "            win.Status = ""Your letter is on its way.""" + NL
    t = t + "        END IF" + NL
    t = t + "    END IF" + NL
    t = t + "    cmdAt = cmdAt + 1" + NL
    t = t + "    IF cmdAt >= cmds.Count THEN" + NL
    t = t + "        EndTalk()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    said = cmds[cmdAt]" + NL
    t = t + "    IF said.Contains(""|"") THEN said = said.Substring(0, said.IndexOf(""|""))" + NL
    t = t + "    TRY" + NL
    t = t + "        conn.Send(said)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        convError = ""The server on "" + ServerName() + "" hung up.""" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Pop_OnClose (conn AS NET_Connection)" + NL
    t = t + "    IF conn.Tag = Str(convNumber) AND talking AND cmdAt < cmds.Count - 1 THEN convError = ""The server on "" + ServerName() + "" hung up.""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The server's list of a folder: fetch the letters we have not got." + NL
    t = t + "SUB Listed (f AS String, answer AS String)" + NL
    t = t + "    VAR mine AS Array OF String" + NL
    t = t + "    VAR have AS String = ""|""" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR onServer AS String = ""|""" + NL
    t = t + "    VAR keep AS Array OF String" + NL
    t = t + "    mine = Index(f)" + NL
    t = t + "    FOR EACH line IN mine" + NL
    t = t + "        have = have + line.Split(""|"")[0] + ""|""" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR EACH line IN answer.Lines()" + NL
    t = t + "        IF line.Split(""|"").Count < 7 THEN CONTINUE" + NL
    t = t + "        onServer = onServer + line.Split(""|"")[0] + ""|""" + NL
    t = t + "        IF NOT have.Contains(""|"" + line.Split(""|"")[0] + ""|"") THEN" + NL
    t = t + "            ' the letter, and its line once it is here (unread in the Inbox)" + NL
    t = t + "            cmds.Insert(cmdAt + 1, ""RETR "" + line.Split(""|"")[0] + ""|"" + f + ""|"" + line)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' letters deleted elsewhere (the webmail) go here too" + NL
    t = t + "    FOR EACH line IN mine" + NL
    t = t + "        IF onServer.Contains(""|"" + line.Split(""|"")[0] + ""|"") THEN" + NL
    t = t + "            keep.Add(line)" + NL
    t = t + "        ELSEIF FS.Exists(HOME + ""\MAIL\"" + line.Split(""|"")[0] + "".MSG"") THEN" + NL
    t = t + "            FS.Delete(HOME + ""\MAIL\"" + line.Split(""|"")[0] + "".MSG"")" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF keep.Count <> mine.Count THEN SaveIndex(f, keep)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A letter came down: tag is ""FOLDER|its index line""." + NL
    t = t + "SUB Fetched (tag AS String, n AS String, letter AS String)" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    f = tag.Split(""|"")[0]" + NL
    t = t + "    line = tag.Substring(f.Length + 1, tag.Length - f.Length - 1)" + NL
    t = t + "    FS.Write(HOME + ""\MAIL\"" + n + "".MSG"", letter)" + NL
    t = t + "    IF f = ""INBOX"" THEN" + NL
    t = t + "        IF NOT line.Split(""|"")[6].Contains(""N"") THEN line = line + ""N""" + NL
    t = t + "        newCount = newCount + 1" + NL
    t = t + "    ELSE" + NL
    t = t + "        line = line.Substring(0, line.Length - line.Split(""|"")[6].Length)" + NL
    t = t + "    END IF" + NL
    t = t + "    FS.Append(HOME + ""\"" + f + "".TXT"", line + EOL)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB EndTalk ()" + NL
    t = t + "    VAR err AS String" + NL
    t = t + "    talking = FALSE" + NL
    t = t + "    err = convError" + NL
    t = t + "    convError = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        sock.Close()" + NL
    t = t + "    CATCH problem" + NL
    t = t + "    END TRY" + NL
    t = t + "    ShowFolder(folder)" + NL
    t = t + "    ShowFolders()" + NL
    t = t + "    DrawTools()" + NL
    t = t + "    IF err <> """" OR cmdAt < cmds.Count - 1 THEN" + NL
    t = t + "        IF err = """" THEN err = ""The server on "" + ServerName() + "" did not answer. Is ColdMail's mail server running there?""" + NL
    t = t + "        IF err.Contains(""refused"") OR err.Contains(""timed out"") OR err.Contains(""Unknown host"") THEN err = ""Frostbird could not reach the mail server on "" + ServerName() + "". ("" + err + "")""" + NL
    t = t + "        win.Status = ""Could not get mail.""" + NL
    t = t + "        IF NOT quiet THEN Say(err, ""error"")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF newCount > 0 THEN" + NL
    t = t + "        win.Status = Str(newCount) + "" new letter"" + Plural(newCount) + "" from "" + ServerName()" + NL
    t = t + "        SYS.Beep(880, 80)" + NL
    t = t + "    ELSEIF win.Status.StartsWith(""Checking"") THEN" + NL
    t = t + "        win.Status = ""No new mail.""" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Plural (n AS Integer) AS String" + NL
    t = t + "    IF n = 1 THEN RETURN """"" + NL
    t = t + "    RETURN ""s""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Say (text AS String, kind AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    box = GUI_MessageBox.New(win)" + NL
    t = t + "    box.Title = ""Frostbird""" + NL
    t = t + "    box.Kind = kind" + NL
    t = t + "    box.Text = text" + NL
    t = t + "    box.Show()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ menus" + NL
    t = t + "" + NL
    t = t + "SUB Menu_OnSelect (item AS String)" + NL
    t = t + "    SELECT CASE item" + NL
    t = t + "        CASE ""Get New Mail""" + NL
    t = t + "            GetMail(FALSE)" + NL
    t = t + "        CASE ""Write a Letter""" + NL
    t = t + "            Compose("""", """", """", """")" + NL
    t = t + "        CASE ""Account Settings...""" + NL
    t = t + "            AccountSettings()" + NL
    t = t + "        CASE ""Exit""" + NL
    t = t + "            win.Close()" + NL
    t = t + "        CASE ""Reply""" + NL
    t = t + "            Reply()" + NL
    t = t + "        CASE ""Forward""" + NL
    t = t + "            Forward()" + NL
    t = t + "        CASE ""Delete""" + NL
    t = t + "            DeleteLetter()" + NL
    t = t + "        CASE ""Mark as Unread""" + NL
    t = t + "            MarkUnread()" + NL
    t = t + "        CASE ""About Frostbird""" + NL
    t = t + "            Say(""Frostbird 1.0 for SIM95"" + EOL + EOL + ""A mail program for ColdMail: it collects your letters from your mail server on port 110 and sends through it."" + EOL + EOL + ""Letters are kept in C:\FROST."", ""info"")" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the toolbar" + NL
    t = t + "" + NL
    t = t + "FUNCTION ToolLabel (i AS Integer) AS String" + NL
    t = t + "    RETURN ""Get Mail|Write|Reply|Forward|Delete|Settings"".Split(""|"")[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ToolOn (i AS Integer) AS Bool" + NL
    t = t + "    IF i = 0 THEN RETURN NOT talking" + NL
    t = t + "    IF i >= 2 AND i <= 4 THEN RETURN Current() <> """"" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Tools_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    DrawTools()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawTools ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    VAR on AS Bool" + NL
    t = t + "    VAR label AS String" + NL
    t = t + "    VAR d AS Integer" + NL
    t = t + "    tools.Clear()" + NL
    t = t + "    tools.SetColor(7)" + NL
    t = t + "    tools.FillRect(0, 0, tools.Width, tools.Height)" + NL
    t = t + "    FOR i = 0 TO TBCOUNT - 1" + NL
    t = t + "        x = 2 + i * TBW" + NL
    t = t + "        on = ToolOn(i)" + NL
    t = t + "        d = 0" + NL
    t = t + "        IF i = tbPressed THEN d = 1" + NL
    t = t + "        IF d = 1 THEN" + NL
    t = t + "            Bevel(x, 1, TBW - 2, TBH, 0, 15)" + NL
    t = t + "        ELSE" + NL
    t = t + "            Bevel(x, 1, TBW - 2, TBH, 15, 8)" + NL
    t = t + "        END IF" + NL
    t = t + "        DrawIcon(i, x + Int((TBW - 24) / 2) + d, 5 + d, on)" + NL
    t = t + "        label = ToolLabel(i)" + NL
    t = t + "        IF on THEN" + NL
    t = t + "            TinyText(x + Int((TBW - 2 - (label.Length * 6 - 1)) / 2) + d, 31 + d, label, 0)" + NL
    t = t + "        ELSE" + NL
    t = t + "            TinyText(x + Int((TBW - 2 - (label.Length * 6 - 1)) / 2) + 1, 32, label, 15)" + NL
    t = t + "            TinyText(x + Int((TBW - 2 - (label.Length * 6 - 1)) / 2), 31, label, 8)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    tools.SetColor(8)" + NL
    t = t + "    tools.Line(0, TBH + 2, tools.Width, TBH + 2)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Bevel (x AS Integer, y AS Integer, w AS Integer, h AS Integer, light AS Integer, dark AS Integer)" + NL
    t = t + "    tools.SetColor(light)" + NL
    t = t + "    tools.Line(x, y, x + w - 1, y)" + NL
    t = t + "    tools.Line(x, y, x, y + h - 1)" + NL
    t = t + "    tools.SetColor(dark)" + NL
    t = t + "    tools.Line(x, y + h - 1, x + w - 1, y + h - 1)" + NL
    t = t + "    tools.Line(x + w - 1, y, x + w - 1, y + h - 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Pick (on AS Bool, yes AS Integer, no AS Integer) AS Integer" + NL
    t = t + "    IF on THEN RETURN yes" + NL
    t = t + "    RETURN no" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A filled polygon: points as ""x,y x,y ..."", offset by ox, oy." + NL
    t = t + "SUB Poly (points AS String, ox AS Integer, oy AS Integer, colour AS Integer)" + NL
    t = t + "    VAR xs AS Array OF Real" + NL
    t = t + "    VAR ys AS Array OF Real" + NL
    t = t + "    VAR pt AS String" + NL
    t = t + "    VAR hits AS Array OF Real" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR t AS Real" + NL
    t = t + "    VAR yy AS Real" + NL
    t = t + "    VAR top AS Real = 9999" + NL
    t = t + "    VAR bottom AS Real = -9999" + NL
    t = t + "    FOR EACH pt IN points.Split("" "")" + NL
    t = t + "        xs.Add(Val(pt.Split("","")[0]))" + NL
    t = t + "        ys.Add(Val(pt.Split("","")[1]))" + NL
    t = t + "        top = MATH.Min(top, ys[ys.Count - 1])" + NL
    t = t + "        bottom = MATH.Max(bottom, ys[ys.Count - 1])" + NL
    t = t + "    NEXT" + NL
    t = t + "    tools.SetColor(colour)" + NL
    t = t + "    FOR y = Int(top) TO Int(bottom)" + NL
    t = t + "        yy = y + 0.5" + NL
    t = t + "        hits.Clear()" + NL
    t = t + "        FOR i = 0 TO xs.Count - 1" + NL
    t = t + "            j = (i + 1) MOD xs.Count" + NL
    t = t + "            IF (ys[i] <= yy AND ys[j] > yy) OR (ys[j] <= yy AND ys[i] > yy) THEN hits.Add(xs[i] + (yy - ys[i]) * (xs[j] - xs[i]) / (ys[j] - ys[i]))" + NL
    t = t + "        NEXT" + NL
    t = t + "        FOR i = 0 TO hits.Count - 2" + NL
    t = t + "            FOR j = i + 1 TO hits.Count - 1" + NL
    t = t + "                IF hits[j] < hits[i] THEN" + NL
    t = t + "                    t = hits[i]" + NL
    t = t + "                    hits[i] = hits[j]" + NL
    t = t + "                    hits[j] = t" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "        NEXT" + NL
    t = t + "        i = 0" + NL
    t = t + "        WHILE i + 1 < hits.Count" + NL
    t = t + "            tools.FillRect(ox + MATH.Round(hits[i]), oy + y, MATH.Max(1, MATH.Round(hits[i + 1]) - MATH.Round(hits[i])), 1)" + NL
    t = t + "            i = i + 2" + NL
    t = t + "        END WHILE" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Envelope (ox AS Integer, oy AS Integer, on AS Bool)" + NL
    t = t + "    tools.SetColor(Pick(on, 15, 7))" + NL
    t = t + "    tools.FillRect(ox + 1, oy + 6, 20, 13)" + NL
    t = t + "    tools.SetColor(Pick(on, 0, 8))" + NL
    t = t + "    tools.Rect(ox + 1, oy + 6, 20, 13)" + NL
    t = t + "    tools.Line(ox + 1, oy + 6, ox + 11, oy + 13)" + NL
    t = t + "    tools.Line(ox + 11, oy + 13, ox + 20, oy + 6)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawIcon (i AS Integer, ox AS Integer, oy AS Integer, on AS Bool)" + NL
    t = t + "    SELECT CASE i" + NL
    t = t + "        CASE 0" + NL
    t = t + "            ' an envelope with a blue arrow coming down into it" + NL
    t = t + "            Envelope(ox, oy + 3, on)" + NL
    t = t + "            Poly(""8,0 14,0 14,5 18,5 11,12 4,5 8,5"", ox + 1, oy, Pick(on, 12, 8))" + NL
    t = t + "        CASE 1" + NL
    t = t + "            ' a sheet of paper and a pencil" + NL
    t = t + "            tools.SetColor(Pick(on, 15, 7))" + NL
    t = t + "            tools.FillRect(ox + 3, oy + 1, 14, 20)" + NL
    t = t + "            tools.SetColor(Pick(on, 0, 8))" + NL
    t = t + "            tools.Rect(ox + 3, oy + 1, 14, 20)" + NL
    t = t + "            tools.Line(ox + 6, oy + 6, ox + 13, oy + 6)" + NL
    t = t + "            tools.Line(ox + 6, oy + 10, ox + 13, oy + 10)" + NL
    t = t + "            tools.Line(ox + 6, oy + 14, ox + 10, oy + 14)" + NL
    t = t + "            Poly(""20,4 23,7 12,18 9,19 10,15"", ox, oy, Pick(on, 11, 8))" + NL
    t = t + "            tools.SetColor(Pick(on, 0, 8))" + NL
    t = t + "            tools.Line(ox + 20, oy + 4, ox + 9, oy + 19)" + NL
    t = t + "        CASE 2" + NL
    t = t + "            ' a curved arrow going back" + NL
    t = t + "            Envelope(ox, oy + 2, on)" + NL
    t = t + "            Poly(""0,6 7,0 7,4 15,4 15,8 7,8 7,12"", ox + 2, oy, Pick(on, 2, 8))" + NL
    t = t + "        CASE 3" + NL
    t = t + "            ' an arrow going on" + NL
    t = t + "            Envelope(ox, oy + 2, on)" + NL
    t = t + "            Poly(""15,6 8,0 8,4 0,4 0,8 8,8 8,12"", ox + 6, oy, Pick(on, 2, 8))" + NL
    t = t + "        CASE 4" + NL
    t = t + "            ' a red cross" + NL
    t = t + "            Poly(""2,4 6,0 11,5 16,0 20,4 15,9 20,14 16,18 11,13 6,18 2,14 7,9"", ox + 1, oy + 2, Pick(on, 9, 8))" + NL
    t = t + "        CASE 5" + NL
    t = t + "            ' a key" + NL
    t = t + "            tools.SetColor(Pick(on, 3, 8))" + NL
    t = t + "            tools.FillCircle(ox + 6, oy + 11, 5)" + NL
    t = t + "            tools.SetColor(7)" + NL
    t = t + "            tools.FillCircle(ox + 6, oy + 11, 2)" + NL
    t = t + "            tools.SetColor(Pick(on, 3, 8))" + NL
    t = t + "            tools.FillRect(ox + 10, oy + 10, 12, 3)" + NL
    t = t + "            tools.FillRect(ox + 17, oy + 13, 2, 4)" + NL
    t = t + "            tools.FillRect(ox + 20, oy + 13, 2, 3)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Glyph (c AS String) AS String" + NL
    t = t + "    SELECT CASE Asc(c)" + NL
    t = t + "        CASE 32" + NL
    t = t + "            RETURN "".....|.....|.....|.....|.....|.....|.....|.....""" + NL
    t = t + "        CASE 68" + NL
    t = t + "            RETURN ""####.|#...#|#...#|#...#|#...#|#...#|####.|.....""" + NL
    t = t + "        CASE 70" + NL
    t = t + "            RETURN ""#####|#....|#....|####.|#....|#....|#....|.....""" + NL
    t = t + "        CASE 71" + NL
    t = t + "            RETURN "".###.|#...#|#....|#.###|#...#|#...#|.###.|.....""" + NL
    t = t + "        CASE 77" + NL
    t = t + "            RETURN ""#...#|##.##|#.#.#|#.#.#|#...#|#...#|#...#|.....""" + NL
    t = t + "        CASE 82" + NL
    t = t + "            RETURN ""####.|#...#|#...#|####.|#.#..|#..#.|#...#|.....""" + NL
    t = t + "        CASE 83" + NL
    t = t + "            RETURN "".####|#....|#....|.###.|....#|....#|####.|.....""" + NL
    t = t + "        CASE 87" + NL
    t = t + "            RETURN ""#...#|#...#|#...#|#.#.#|#.#.#|#.#.#|.#.#.|.....""" + NL
    t = t + "        CASE 97" + NL
    t = t + "            RETURN "".....|.....|.###.|....#|.####|#...#|.####|.....""" + NL
    t = t + "        CASE 100" + NL
    t = t + "            RETURN ""....#|....#|.####|#...#|#...#|#...#|.####|.....""" + NL
    t = t + "        CASE 101" + NL
    t = t + "            RETURN "".....|.....|.###.|#...#|#####|#....|.###.|.....""" + NL
    t = t + "        CASE 103" + NL
    t = t + "            RETURN "".....|.....|.####|#...#|#...#|.####|....#|.###.""" + NL
    t = t + "        CASE 105" + NL
    t = t + "            RETURN ""..#..|.....|.##..|..#..|..#..|..#..|.###.|.....""" + NL
    t = t + "        CASE 108" + NL
    t = t + "            RETURN "".##..|..#..|..#..|..#..|..#..|..#..|.###.|.....""" + NL
    t = t + "        CASE 110" + NL
    t = t + "            RETURN "".....|.....|#.##.|##..#|#...#|#...#|#...#|.....""" + NL
    t = t + "        CASE 111" + NL
    t = t + "            RETURN "".....|.....|.###.|#...#|#...#|#...#|.###.|.....""" + NL
    t = t + "        CASE 112" + NL
    t = t + "            RETURN "".....|.....|####.|#...#|#...#|####.|#....|#....""" + NL
    t = t + "        CASE 114" + NL
    t = t + "            RETURN "".....|.....|#.##.|##..#|#....|#....|#....|.....""" + NL
    t = t + "        CASE 115" + NL
    t = t + "            RETURN "".....|.....|.####|#....|.###.|....#|####.|.....""" + NL
    t = t + "        CASE 116" + NL
    t = t + "            RETURN "".#...|.#...|###..|.#...|.#...|.#..#|..##.|.....""" + NL
    t = t + "        CASE 119" + NL
    t = t + "            RETURN "".....|.....|#...#|#...#|#.#.#|#.#.#|.#.#.|.....""" + NL
    t = t + "        CASE 121" + NL
    t = t + "            RETURN "".....|.....|#...#|#...#|#...#|.####|....#|.###.""" + NL
    t = t + "    END SELECT" + NL
    t = t + "    RETURN "".....|.....|.....|.....|.....|.....|.....|.....""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB TinyText (x AS Integer, y AS Integer, text AS String, colour AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR r AS Integer" + NL
    t = t + "    VAR rows AS Array OF String" + NL
    t = t + "    VAR row AS String" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR start AS Integer" + NL
    t = t + "    tools.SetColor(colour)" + NL
    t = t + "    FOR i = 0 TO text.Length - 1" + NL
    t = t + "        rows = Glyph(text.CharAt(i)).Split(""|"")" + NL
    t = t + "        FOR r = 0 TO 7" + NL
    t = t + "            row = rows[r] + "".""" + NL
    t = t + "            start = -1" + NL
    t = t + "            FOR k = 0 TO 5" + NL
    t = t + "                IF row.CharAt(k) = ""#"" AND start < 0 THEN start = k" + NL
    t = t + "                IF row.CharAt(k) <> ""#"" AND start >= 0 THEN" + NL
    t = t + "                    tools.FillRect(x + i * 6 + start, y + r, k - start, 1)" + NL
    t = t + "                    start = -1" + NL
    t = t + "                END IF" + NL
    t = t + "            NEXT" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ToolAt (x AS Integer, y AS Integer) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF x < 2 OR y > TBH THEN RETURN -1" + NL
    t = t + "    i = Int((x - 2) / TBW)" + NL
    t = t + "    IF i >= TBCOUNT THEN RETURN -1" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Tools_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = ToolAt(x, y)" + NL
    t = t + "    IF i < 0 THEN RETURN" + NL
    t = t + "    IF NOT ToolOn(i) THEN RETURN" + NL
    t = t + "    tbPressed = i" + NL
    t = t + "    DrawTools()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Tools_OnMouseUp (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = tbPressed" + NL
    t = t + "    tbPressed = -1" + NL
    t = t + "    DrawTools()" + NL
    t = t + "    IF i < 0 OR ToolAt(x, y) <> i THEN RETURN" + NL
    t = t + "    SELECT CASE i" + NL
    t = t + "        CASE 0" + NL
    t = t + "            GetMail(FALSE)" + NL
    t = t + "        CASE 1" + NL
    t = t + "            Compose("""", """", """", """")" + NL
    t = t + "        CASE 2" + NL
    t = t + "            Reply()" + NL
    t = t + "        CASE 3" + NL
    t = t + "            Forward()" + NL
    t = t + "        CASE 4" + NL
    t = t + "            DeleteLetter()" + NL
    t = t + "        CASE 5" + NL
    t = t + "            AccountSettings()" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' RESOLVE.SPK - the SimDNS resolver: asks the name server which machine a" + NL
    t = t + "' name like www.coolsite.sim is on." + NL
    t = t + "'" + NL
    t = t + "' The name server is the central one, STARTHERE.56k.net, where SimNIC (the" + NL
    t = t + "' registrar) and NAMED.SPK run, unless C:\SYSTEM\RESOLV.INI says otherwise." + NL
    t = t + "' To move the whole network to another central host, change RSCENTRAL below" + NL
    t = t + "' (the builder sets it from CENTRAL in tools/simxplorer-source.mjs)." + NL
    t = t + "'" + NL
    t = t + "' A library, not a program: a program has it joined on the end (the builder" + NL
    t = t + "' does this for Simxplorer, SimPlayer, Vapor, Frostbird, MAILD, the Sim Shell," + NL
    t = t + "' AskSim's crawler, DIG and Personal Web Manager; copy C:\PROGRAMS\RESOLVE.SPK" + NL
    t = t + "' onto the end of your own). Every name in it starts with Rs, so it can't clash." + NL
    t = t + "'" + NL
    t = t + "' C:\SYSTEM\RESOLV.INI, shared by every program on the machine (optional):" + NL
    t = t + "'     nameserver=dnsbox          another name server instead of the central one" + NL
    t = t + "'     nameserver=none            no SimDNS at all: SIM95 machine names only" + NL
    t = t + "'     search=coolsite.sim        then ""www"" means www.coolsite.sim" + NL
    t = t + "'" + NL
    t = t + "' How to use it without ever waiting in the wrong place (SIM95-NOTES.md):" + NL
    t = t + "'   1. RsWants(host)  - does this name need asking? FALSE for addresses," + NL
    t = t + "'                       plain machine names, names already known, or when" + NL
    t = t + "'                       there is no name server (or it isn't answering)." + NL
    t = t + "'   2. RsAsk(host, address) - sends the question to the name server at that" + NL
    t = t + "'                       address. It is a Connect: let it be the last thing" + NL
    t = t + "'                       the handler does." + NL
    t = t + "'   3. RsBusy()       - TRUE while the answer is on its way. After RSWAIT" + NL
    t = t + "'                       with no answer the server is left alone for RSQUIET," + NL
    t = t + "'                       and every name goes to SIM95 as before." + NL
    t = t + "'   4. RsTarget(host) - where to connect: the machine name (or address) the" + NL
    t = t + "'                       name server gave, or the name itself when SimDNS" + NL
    t = t + "'                       doesn't know it, for SIM95 to look up." + NL
    t = t + "' Answers are kept for their TTL; names SimDNS doesn't know for RSNEG." + NL
    t = t + "'" + NL
    t = t + "' Or, from a timer tick, all of that in one line (see RsNext):" + NL
    t = t + "'     IF RsNext(host) THEN RETURN          ' asked, or waiting: end the tick" + NL
    t = t + "'     conn = sock.Connect(RsTarget(host), 80)" + NL
    t = t + "' and for mail, the domain's MX first (see RsNextMail):" + NL
    t = t + "'     IF RsNextMail(domain) THEN RETURN" + NL
    t = t + "'     conn = sock.Connect(RsMailTarget(domain), 25)" + NL
    t = t + "" + NL
    t = t + "CONST RSCENTRAL = ""starthere.56k.net""   ' the central name server" + NL
    t = t + "CONST RSINI = ""C:\SYSTEM\RESOLV.INI""" + NL
    t = t + "CONST RSPORT = 53" + NL
    t = t + "CONST RSWAIT = 5000             ' ms to wait for an answer (a slow line takes a while)" + NL
    t = t + "CONST RSQUIET = 30000            ' ms to leave a silent name server alone" + NL
    t = t + "CONST RSNEG = 60000             ' ms to remember that SimDNS doesn't know a name" + NL
    t = t + "CONST RSMOST = 100              ' names kept" + NL
    t = t + "" + NL
    t = t + "VAR rsServer AS String              ' """" when SimDNS is off" + NL
    t = t + "VAR rsByDefault AS Bool               ' TRUE when RESOLV.INI doesn't name one" + NL
    t = t + "VAR rsSearch AS String" + NL
    t = t + "VAR rsRead AS Bool" + NL
    t = t + "VAR rsReadAt AS Integer" + NL
    t = t + "VAR rsSock AS NET_Socket" + NL
    t = t + "VAR rsName AS Array OF String       ' the name as asked, lower case" + NL
    t = t + "VAR rsTo AS Array OF String         ' where it is ("""" when SimDNS doesn't know it)" + NL
    t = t + "VAR rsCanon AS Array OF String      ' its last name in DNS before the machine" + NL
    t = t + "VAR rsUntil AS Array OF Integer     ' SYS.Ticks when it is forgotten" + NL
    t = t + "VAR rsAsking AS String" + NL
    t = t + "VAR rsAskAt AS Integer" + NL
    t = t + "VAR rsRefused AS Bool" + NL
    t = t + "VAR rsDown AS Bool" + NL
    t = t + "VAR rsDownAt AS Integer" + NL
    t = t + "VAR rsWhy AS String                 ' the last thing that went wrong" + NL
    t = t + "VAR rsLastReply AS String           ' the last answer, as it came" + NL
    t = t + "VAR rsServerAddr AS String          ' the name server's address, for RsNext" + NL
    t = t + "VAR rsServerFor AS String" + NL
    t = t + "VAR rsServerAt AS Integer" + NL
    t = t + "VAR rsLooking AS Bool               ' RsNext is finding the name server's address" + NL
    t = t + "VAR rsLookingAt AS Integer" + NL
    t = t + "" + NL
    t = t + "' Reads RESOLV.INI (again after a few seconds, so a new setting takes)." + NL
    t = t + "' With no nameserver= line, the central name server; none (or nothing after" + NL
    t = t + "' the =) turns SimDNS off." + NL
    t = t + "SUB RsConfig ()" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR low AS String" + NL
    t = t + "    IF rsRead AND SYS.Ticks - rsReadAt < 3000 THEN RETURN" + NL
    t = t + "    rsRead = TRUE" + NL
    t = t + "    rsReadAt = SYS.Ticks" + NL
    t = t + "    rsServer = RSCENTRAL" + NL
    t = t + "    rsByDefault = TRUE" + NL
    t = t + "    rsSearch = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                low = line.Trim().Lower()" + NL
    t = t + "                IF low.StartsWith(""nameserver="") THEN" + NL
    t = t + "                    rsServer = low.Substring(11, low.Length - 11).Trim()" + NL
    t = t + "                    rsByDefault = FALSE" + NL
    t = t + "                END IF" + NL
    t = t + "                IF low.StartsWith(""search="") THEN rsSearch = low.Substring(7, low.Length - 7).Trim()" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF rsServer = ""none"" THEN rsServer = """"" + NL
    t = t + "    IF rsSearch.StartsWith(""."") THEN rsSearch = rsSearch.Substring(1, rsSearch.Length - 1)" + NL
    t = t + "    IF rsSearch.EndsWith(""."") THEN rsSearch = rsSearch.Substring(0, rsSearch.Length - 1)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The name server (a machine name or address), or """" for none." + NL
    t = t + "FUNCTION RsNameServer () AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsServer" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is it the central one, because RESOLV.INI doesn't say?" + NL
    t = t + "FUNCTION RsIsCentral () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    RETURN rsByDefault" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Makes server this machine's name server, keeping the rest of RESOLV.INI," + NL
    t = t + "' and forgets everything it knew. """" (or none) for no SimDNS at all;" + NL
    t = t + "' default for the central one again." + NL
    t = t + "SUB RsSave (server AS String)" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    server = server.Trim().Lower()" + NL
    t = t + "    IF server = """" THEN server = ""none""" + NL
    t = t + "    TRY" + NL
    t = t + "        IF FS.Exists(RSINI) THEN" + NL
    t = t + "            FOR EACH line IN FS.Read(RSINI).Lines()" + NL
    t = t + "                IF line.Trim() <> """" AND NOT line.Trim().Lower().StartsWith(""nameserver="") THEN out.Add(line)" + NL
    t = t + "            NEXT" + NL
    t = t + "        END IF" + NL
    t = t + "        IF server <> ""default"" THEN out.Insert(0, ""nameserver="" + server)" + NL
    t = t + "        IF out.Count = 0 THEN" + NL
    t = t + "            IF FS.Exists(RSINI) THEN FS.Delete(RSINI)" + NL
    t = t + "        ELSE" + NL
    t = t + "            FS.Write(RSINI, out.Join(Chr(10)) + Chr(10))" + NL
    t = t + "        END IF" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsWhy = err" + NL
    t = t + "    END TRY" + NL
    t = t + "    rsRead = FALSE" + NL
    t = t + "    RsForget()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB RsForget ()" + NL
    t = t + "    rsName.Clear()" + NL
    t = t + "    rsTo.Clear()" + NL
    t = t + "    rsCanon.Clear()" + NL
    t = t + "    rsUntil.Clear()" + NL
    t = t + "    rsDown = FALSE" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsIsAddress (s AS String) AS Bool" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF s.Split(""."").Count <> 4 THEN RETURN FALSE" + NL
    t = t + "    FOR EACH p IN s.Split(""."")" + NL
    t = t + "        IF p = """" OR p.Length > 3 THEN RETURN FALSE" + NL
    t = t + "        FOR i = 0 TO p.Length - 1" + NL
    t = t + "            IF NOT ""0123456789"".Contains(p.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name the server is asked about: lower case, the search domain added" + NL
    t = t + "' to a single word." + NL
    t = t + "FUNCTION RsFull (host AS String) AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF h.EndsWith(""."") THEN h = h.Substring(0, h.Length - 1)" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch <> """" THEN h = h + ""."" + rsSearch" + NL
    t = t + "    RETURN h" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where a name is in the list of answers, or -1 (old answers are dropped)." + NL
    t = t + "FUNCTION RsFind (host AS String) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = rsName.IndexOf(host.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN -1" + NL
    t = t + "    IF SYS.Ticks > rsUntil[i] THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "        RETURN -1" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN i" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsWants (host AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(host) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(host) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for a mail domain's MX record." + NL
    t = t + "FUNCTION RsWantsMx (domain AS String) AS Bool" + NL
    t = t + "    IF NOT RsAsks(domain) THEN RETURN FALSE" + NL
    t = t + "    RETURN RsFind(""mx:"" + domain.Trim().Lower()) < 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is host a name for the name server at all (whether known yet or not)?" + NL
    t = t + "FUNCTION RsAsks (host AS String) AS Bool" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    IF rsServer = """" OR h = """" OR h = ""localhost"" THEN RETURN FALSE" + NL
    t = t + "    IF rsDown AND SYS.Ticks - rsDownAt < RSQUIET THEN RETURN FALSE" + NL
    t = t + "    IF RsIsAddress(h) THEN RETURN FALSE" + NL
    t = t + "    IF NOT h.Contains(""."") AND rsSearch = """" THEN RETURN FALSE" + NL
    t = t + "    IF h = rsServer OR h = NET.HostName.Lower() THEN RETURN FALSE" + NL
    t = t + "    ' a machine's full name (bob.56k.net): SIM95's, never SimDNS's to answer" + NL
    t = t + "    IF RsIspName(h) THEN RETURN FALSE" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Does h end in one of SIM95's ISPs (56k.net, dialup.zone...)?" + NL
    t = t + "FUNCTION RsIspName (h AS String) AS Bool" + NL
    t = t + "    VAR isp AS String" + NL
    t = t + "    FOR EACH isp IN [""dialup.zone"", ""56k.net"", ""bbs.club"", ""modem.link"", ""beep.boop""]" + NL
    t = t + "        IF h = isp OR h.EndsWith(""."" + isp) THEN RETURN TRUE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN FALSE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Sends the question. A Connect, so it must be the last thing its handler" + NL
    t = t + "' does: if the name server refuses, the handler is spoiled (SIM95-NOTES.md)." + NL
    t = t + "SUB RsAsk (host AS String, address AS String)" + NL
    t = t + "    RsSend(host.Trim().Lower(), ""A"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Asks for a mail domain's MX records (also a Connect: the last thing)." + NL
    t = t + "SUB RsAskMx (domain AS String, address AS String)" + NL
    t = t + "    RsSend(""mx:"" + domain.Trim().Lower(), ""MX"", address)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' key is the name, or mx: and the name; the answer is kept under it." + NL
    t = t + "SUB RsSend (key AS String, qtype AS String, address AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR name AS String" + NL
    t = t + "    IF IsNothing(rsSock) THEN" + NL
    t = t + "        rsSock = NET_Socket.New()" + NL
    t = t + "        rsSock.onMessage = Rs_OnMessage" + NL
    t = t + "    END IF" + NL
    t = t + "    name = key" + NL
    t = t + "    IF name.StartsWith(""mx:"") THEN name = name.Substring(3, name.Length - 3)" + NL
    t = t + "    rsAsking = key" + NL
    t = t + "    rsAskAt = SYS.Ticks" + NL
    t = t + "    rsRefused = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = rsSock.Connect(address, RSPORT)" + NL
    t = t + "        conn.Tag = ""rs:"" + key" + NL
    t = t + "        conn.Send(""QUERY "" + RsFull(name) + "" "" + qtype)" + NL
    t = t + "    CATCH err" + NL
    t = t + "        rsRefused = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Gives up on the name server for a while: every name goes to SIM95." + NL
    t = t + "SUB RsGiveUp (why AS String)" + NL
    t = t + "    rsWhy = why" + NL
    t = t + "    rsDown = TRUE" + NL
    t = t + "    rsDownAt = SYS.Ticks" + NL
    t = t + "    rsAsking = """"" + NL
    t = t + "    rsServerAddr = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' For a program that fetches from a timer tick: TRUE when the tick must end" + NL
    t = t + "' now, because a question about host has just been sent (a Connect, so it" + NL
    t = t + "' has to be the last thing the handler does) or an answer is on its way." + NL
    t = t + "' FALSE when there is nothing to ask: RsTarget(host) is where to connect." + NL
    t = t + "' A name server that is missing, refuses or says nothing for RSWAIT is left" + NL
    t = t + "' alone for RSQUIET, and every name goes to SIM95: nothing ever hangs." + NL
    t = t + "FUNCTION RsNext (host AS String) AS Bool" + NL
    t = t + "    RETURN RsStep(host, FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The same for mail to domain: its MX record (the lowest preference), then" + NL
    t = t + "' the CNAMEs or address of the machine that names. RsMailTarget(domain) is" + NL
    t = t + "' then where to connect; with no MX, the domain's own machine; with no" + NL
    t = t + "' answer at all, the domain itself, for SIM95 to look up." + NL
    t = t + "FUNCTION RsNextMail (domain AS String) AS Bool" + NL
    t = t + "    IF RsStep(domain, TRUE) THEN RETURN TRUE" + NL
    t = t + "    RETURN RsStep(RsMailHost(domain), FALSE)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsStep (host AS String, mx AS Bool) AS Bool" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    ' another handler is finding the name server (it waits): wait for it" + NL
    t = t + "    IF rsLooking THEN" + NL
    t = t + "        IF SYS.Ticks - rsLookingAt < RSWAIT THEN RETURN TRUE" + NL
    t = t + "        rsLooking = FALSE" + NL
    t = t + "        RsGiveUp(""no answer about the machine "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF RsBusy() THEN RETURN TRUE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        IF NOT RsWantsMx(host) THEN RETURN FALSE" + NL
    t = t + "    ELSE" + NL
    t = t + "        IF NOT RsWants(host) THEN RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    addr = RsServerAddress()" + NL
    t = t + "    IF addr = """" THEN RETURN FALSE" + NL
    t = t + "    IF mx THEN" + NL
    t = t + "        RsAskMx(host, addr)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsAsk(host, addr)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name server's address, looked up once a minute (one lookup at a time:" + NL
    t = t + "' see SIM95-NOTES.md). """" when there is no such machine, and then it gives up." + NL
    t = t + "FUNCTION RsServerAddress () AS String" + NL
    t = t + "    VAR addr AS String" + NL
    t = t + "    IF RsIsAddress(rsServer) THEN RETURN rsServer" + NL
    t = t + "    IF rsServerAddr <> """" AND rsServerFor = rsServer AND SYS.Ticks - rsServerAt < 60000 AND SYS.Ticks >= rsServerAt THEN RETURN rsServerAddr" + NL
    t = t + "    rsLooking = TRUE" + NL
    t = t + "    rsLookingAt = SYS.Ticks" + NL
    t = t + "    addr = NET.Resolve(rsServer)" + NL
    t = t + "    IF NOT rsLooking THEN RETURN """"" + NL
    t = t + "    rsLooking = FALSE" + NL
    t = t + "    IF addr = """" THEN" + NL
    t = t + "        RsGiveUp(""there is no machine called "" + rsServer)" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    rsServerAddr = addr" + NL
    t = t + "    rsServerFor = rsServer" + NL
    t = t + "    rsServerAt = SYS.Ticks" + NL
    t = t + "    RETURN addr" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RsBusy () AS Bool" + NL
    t = t + "    IF rsAsking = """" THEN RETURN FALSE" + NL
    t = t + "    IF rsRefused THEN" + NL
    t = t + "        RsGiveUp(""the name server "" + rsServer + "" refused"")" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    IF SYS.Ticks - rsAskAt > RSWAIT THEN" + NL
    t = t + "        RsGiveUp(""no answer from the name server "" + rsServer)" + NL
    t = t + "        RETURN FALSE" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Rs_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    IF NOT conn.Tag.StartsWith(""rs:"") THEN RETURN" + NL
    t = t + "    h = conn.Tag.Substring(3, conn.Tag.Length - 3)" + NL
    t = t + "    conn.Tag = """"" + NL
    t = t + "    TRY" + NL
    t = t + "        conn.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    RsTake(h, message)" + NL
    t = t + "    IF h = rsAsking THEN rsAsking = """"" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an answer: follows its CNAMEs to an address, or to the machine" + NL
    t = t + "' name the chain ends at." + NL
    t = t + "SUB RsTake (host AS String, reply AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    VAR onward AS String" + NL
    t = t + "    VAR target AS String" + NL
    t = t + "    VAR canon AS String" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR hops AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    rsLastReply = reply" + NL
    t = t + "    IF host.StartsWith(""mx:"") THEN" + NL
    t = t + "        RsTakeMx(host, reply)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(host, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(host, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    cur = RsFull(host)" + NL
    t = t + "    canon = cur" + NL
    t = t + "    FOR hops = 0 TO 8" + NL
    t = t + "        onward = """"" + NL
    t = t + "        FOR i = 1 TO lines.Count - 1" + NL
    t = t + "            w = lines[i].Split("" "")" + NL
    t = t + "            IF w.Count >= 4 THEN" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""A"" AND target = """" THEN target = w[3]" + NL
    t = t + "                IF w[0] = cur AND w[2] = ""CNAME"" THEN onward = w[3]" + NL
    t = t + "                IF w[0] = cur AND (w[2] = ""A"" OR w[2] = ""CNAME"") AND Int(Val(w[1])) < ttl THEN ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF target <> """" THEN" + NL
    t = t + "            canon = cur" + NL
    t = t + "            BREAK" + NL
    t = t + "        END IF" + NL
    t = t + "        IF onward = """" THEN BREAK" + NL
    t = t + "        canon = cur" + NL
    t = t + "        cur = onward" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF target = """" THEN" + NL
    t = t + "        ' a name with no CNAME and no address: not one to connect to" + NL
    t = t + "        IF cur = RsFull(host) THEN" + NL
    t = t + "            RsKeep(host, """", """", RSNEG)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        ' the end of the chain: a SIM95 machine name" + NL
    t = t + "        target = cur" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ttl < 5 THEN ttl = 5" + NL
    t = t + "    RsKeep(host, target, canon, ttl * 1000)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Learns an MX answer: the mail machine with the lowest preference. With no" + NL
    t = t + "' MX, the server answers with the domain's CNAMEs instead, and the domain's" + NL
    t = t + "' own machine takes the mail." + NL
    t = t + "SUB RsTakeMx (key AS String, reply AS String)" + NL
    t = t + "    VAR domain AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR w AS Array OF String" + NL
    t = t + "    VAR best AS String" + NL
    t = t + "    VAR pref AS Integer = 1000000" + NL
    t = t + "    VAR ttl AS Integer = 3600" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    domain = key.Substring(3, key.Length - 3)" + NL
    t = t + "    lines = reply.Lines()" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN" + NL
    t = t + "    IF lines[0].StartsWith(""NXDOMAIN"") THEN" + NL
    t = t + "        RsKeep(key, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RsKeep(domain, """", ""NXDOMAIN"", RSNEG)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT lines[0].StartsWith(""OK"") THEN" + NL
    t = t + "        rsWhy = lines[0]" + NL
    t = t + "        RsKeep(key, """", """", 10000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = 1 TO lines.Count - 1" + NL
    t = t + "        w = lines[i].Split("" "")" + NL
    t = t + "        IF w.Count >= 5 THEN" + NL
    t = t + "            IF w[2] = ""MX"" AND Int(Val(w[3])) < pref THEN" + NL
    t = t + "                pref = Int(Val(w[3]))" + NL
    t = t + "                best = w[4]" + NL
    t = t + "                ttl = Int(Val(w[1]))" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF best <> """" THEN" + NL
    t = t + "        IF best.EndsWith(""."") THEN best = best.Substring(0, best.Length - 1)" + NL
    t = t + "        IF ttl < 5 THEN ttl = 5" + NL
    t = t + "        RsKeep(key, best, RsFull(domain), ttl * 1000)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    RsTake(domain, reply)" + NL
    t = t + "    IF RsKnown(domain) THEN" + NL
    t = t + "        RsKeep(key, domain, RsFull(domain), RSNEG)" + NL
    t = t + "    ELSE" + NL
    t = t + "        RsKeep(key, """", """", RSNEG)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The machine (or name) that takes domain's mail: its MX, or domain itself." + NL
    t = t + "FUNCTION RsMailHost (domain AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN domain" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN domain" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where to connect for domain's mail." + NL
    t = t + "FUNCTION RsMailTarget (domain AS String) AS String" + NL
    t = t + "    RETURN RsTarget(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS say where domain's mail goes (an MX, or the domain's machine)?" + NL
    t = t + "FUNCTION RsMailKnown (domain AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(""mx:"" + domain.Trim().Lower())" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN FALSE" + NL
    t = t + "    RETURN RsKnown(RsMailHost(domain)) OR NOT RsAsks(RsMailHost(domain))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB RsKeep (host AS String, target AS String, canon AS String, ms AS Integer)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    h = host.Trim().Lower()" + NL
    t = t + "    i = rsName.IndexOf(h)" + NL
    t = t + "    IF i >= 0 THEN" + NL
    t = t + "        rsName.RemoveAt(i)" + NL
    t = t + "        rsTo.RemoveAt(i)" + NL
    t = t + "        rsCanon.RemoveAt(i)" + NL
    t = t + "        rsUntil.RemoveAt(i)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF rsName.Count >= RSMOST THEN" + NL
    t = t + "        rsName.RemoveAt(0)" + NL
    t = t + "        rsTo.RemoveAt(0)" + NL
    t = t + "        rsCanon.RemoveAt(0)" + NL
    t = t + "        rsUntil.RemoveAt(0)" + NL
    t = t + "    END IF" + NL
    t = t + "    rsName.Add(h)" + NL
    t = t + "    rsTo.Add(target)" + NL
    t = t + "    rsCanon.Add(canon)" + NL
    t = t + "    rsUntil.Add(SYS.Ticks + ms)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where to connect for host: what SimDNS said, or host itself." + NL
    t = t + "FUNCTION RsTarget (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsTo[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The name host's machine was found under (www.coolsite.sim), or host." + NL
    t = t + "FUNCTION RsCanonical (host AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN host" + NL
    t = t + "    IF rsTo[i] = """" THEN RETURN host" + NL
    t = t + "    RETURN rsCanon[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did SimDNS answer for host (so RsTarget is its machine)?" + NL
    t = t + "FUNCTION RsKnown (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] <> """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Did the name server say there is no such name (NXDOMAIN)?" + NL
    t = t + "FUNCTION RsNoSuchName (host AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    i = RsFind(host)" + NL
    t = t + "    IF i < 0 THEN RETURN FALSE" + NL
    t = t + "    RETURN rsTo[i] = """" AND rsCanon[i] = ""NXDOMAIN""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Is the name server being left alone, because it didn't answer (or there" + NL
    t = t + "' is none)? rsWhy says why." + NL
    t = t + "FUNCTION RsSilent () AS Bool" + NL
    t = t + "    RsConfig()" + NL
    t = t + "    IF rsServer = """" THEN RETURN TRUE" + NL
    t = t + "    RETURN rsDown AND SYS.Ticks - rsDownAt < RSQUIET" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\PROGRAMS\FROSTBRD.SPK")
END SUB
