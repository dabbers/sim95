' FROSTBRD.SPK - Frostbird, a desktop mail program for ColdMail.
'
' Three panes, like the mail programs of the day: folders on the left, the
' letters in the folder at the top, the letter you are reading below. Get Mail
' signs in to your ColdMail server on port 110 (see MAILD.SPK) and brings
' down what is new; Write, Reply and Forward send through the same server.
' Letters stay on the server too, so the webmail still shows them.
'
' Files (all in C:\FROST):
'   ACCOUNT.INI          address=, pass= (scrambled, not secret: it is 1996), check= minutes
'   INBOX.TXT, SENT.TXT  one line per letter: n|date|from|to|subject|size|flags
'                        (n is the server's number; flags has N while unread)
'   MAIL\<n>.MSG         the letters themselves
'
' A conversation with the server is a list of commands sent one at a time;
' each answer (Pop_OnMessage) sends the next. Connecting happens in a timer
' tick of its own, inside a TRY with an empty CATCH: see SIM95-NOTES.md.
'
' The server is the part of the address after the @. A domain such as
' coolsite.sim is asked about first (the builder joins the SimDNS resolver,
' simdns/src/RESOLVE.SPK, on the end): its MX record, the one with the lowest
' preference, then the CNAMEs of the machine that names; each question takes
' a tick of its own. With no name server, or no answer, it is a SIM95
' machine name, as always.

CONST HOME = "C:\FROST"
CONST POPPORT = 110
CONST PATIENCE = 8000
CONST TBW = 64
CONST TBH = 44
CONST TBCOUNT = 6

VAR EOL AS String
VAR win AS GUI_Window
VAR bar AS GUI_Menu
VAR tools AS GUI_Canvas
VAR folders AS GUI_ListBox
VAR letters AS GUI_ListBox
VAR reader AS GUI_TextArea
VAR clock AS GUI_Timer
VAR sock AS NET_Socket
VAR tbPressed AS Integer = -1

' the account
VAR myAddress AS String
VAR myPass AS String
VAR checkEvery AS Integer = 5
VAR lastCheck AS Integer

' what is showing
VAR folder AS String = "INBOX"
VAR shown AS Array OF String       ' index lines of the letters in the list, in order

' talking to the server
VAR jobs AS Array OF String        ' "get", "dele|n", "send|letter"
VAR talking AS Bool
VAR wantConnect AS Bool
VAR cmds AS Array OF String        ' what to say, in order ("RETR 7|INBOX": the part after | is ours)
VAR cmdAt AS Integer
VAR convNumber AS Integer
VAR convError AS String
VAR convSince AS Integer
VAR newCount AS Integer
VAR quiet AS Bool                  ' an automatic check: no box if it fails

' ================================================================ start

SUB Main ()
    EOL = Chr(10)
    IF NOT FS.Exists(HOME) THEN FS.MakeDir(HOME)
    IF NOT FS.Exists(HOME + "\MAIL") THEN FS.MakeDir(HOME + "\MAIL")
    LoadAccount()
    win = GUI_Window.New("Frostbird", 720, 480)
    win.Icon = "chat"
    win.Resizable = TRUE
    win.onClose = Win_OnClose
    win.onResize = Win_OnResize

    bar = GUI_Menu.New(win)
    bar.onSelect = Menu_OnSelect
    bar.AddMenu("&File")
    bar.AddItem("&File", "&Get New Mail" + Chr(9) + "F5")
    bar.AddItem("&File", "&Write a Letter" + Chr(9) + "Ctrl+N")
    bar.AddSeparator("&File")
    bar.AddItem("&File", "&Account Settings...")
    bar.AddSeparator("&File")
    bar.AddItem("&File", "E&xit" + Chr(9) + "Ctrl+Q")
    bar.AddMenu("&Message")
    bar.AddItem("&Message", "&Reply" + Chr(9) + "Ctrl+R")
    bar.AddItem("&Message", "&Forward" + Chr(9) + "Ctrl+L")
    bar.AddItem("&Message", "&Delete" + Chr(9) + "Delete")
    bar.AddItem("&Message", "Mark as &Unread" + Chr(9) + "Ctrl+U")
    bar.AddMenu("&Help")
    bar.AddItem("&Help", "&About Frostbird")

    tools = GUI_Canvas.New(win)
    tools.onDraw = Tools_OnDraw
    tools.onMouseDown = Tools_OnMouseDown
    tools.onMouseUp = Tools_OnMouseUp
    folders = GUI_ListBox.New(win)
    folders.onSelect = Folders_OnSelect
    letters = GUI_ListBox.New(win)
    letters.Mono = TRUE
    letters.onSelect = Letters_OnSelect
    letters.onDblClick = Letters_OnSelect
    reader = GUI_TextArea.New(win)
    reader.ReadOnly = TRUE
    reader.WordWrap = TRUE
    Win_OnResize()

    sock = NET_Socket.New()
    sock.onMessage = Pop_OnMessage
    sock.onClose = Pop_OnClose
    clock = GUI_Timer.New(win)
    clock.Interval = 200
    clock.onTick = Clock_OnTick
    clock.Start()

    ShowFolders()
    folders.Selected = 0
    ShowFolder("INBOX")
    win.Status = "Ready"
    win.Show()
    IF myAddress = "" THEN
        AccountSettings()
    ELSE
        GetMail(TRUE)
    END IF
    IF SYS.Args.Count > 0 THEN
        IF SYS.Args[0].Lower().StartsWith("mailto:") THEN Compose(SYS.Args[0].Substring(7, SYS.Args[0].Length - 7), "", "", "")
    END IF
END SUB

SUB Win_OnResize ()
    VAR w AS Integer
    VAR h AS Integer
    w = win.Width
    h = win.Height
    tools.SetBounds(0, 0, w, TBH + 3)
    folders.SetBounds(2, TBH + 5, 140, h - TBH - 7)
    letters.SetBounds(146, TBH + 5, w - 148, Int((h - TBH) * 0.4))
    reader.SetBounds(146, TBH + 9 + Int((h - TBH) * 0.4), w - 148, h - TBH - 11 - Int((h - TBH) * 0.4))
    DrawTools()
END SUB

SUB Win_OnClose ()
    SYS.Exit(0)
END SUB

' ================================================================ the account

' The password is kept scrambled, which keeps it from a glance and no more.
FUNCTION Scramble (s AS String) AS String
    VAR out AS String
    VAR i AS Integer
    FOR i = 0 TO s.Length - 1
        out = out + ("000" + Hex(Asc(s.CharAt(i)) + (7 * (i + 1)) MOD 13 + 16)).Substring(("000" + Hex(Asc(s.CharAt(i)) + (7 * (i + 1)) MOD 13 + 16)).Length - 4, 4)
    NEXT
    RETURN out
END FUNCTION

FUNCTION Unscramble (s AS String) AS String
    VAR out AS String
    VAR i AS Integer
    VAR c AS Integer
    FOR i = 0 TO Int(s.Length / 4) - 1
        c = HexVal(s.Substring(i * 4, 4)) - (7 * (i + 1)) MOD 13 - 16
        out = out + Chr(c)
    NEXT
    RETURN out
END FUNCTION

FUNCTION HexVal (h AS String) AS Integer
    VAR v AS Integer
    VAR i AS Integer
    FOR i = 0 TO h.Length - 1
        v = v * 16 + "0123456789ABCDEF".IndexOf(h.CharAt(i).Upper())
    NEXT
    RETURN v
END FUNCTION

SUB LoadAccount ()
    VAR line AS String
    FOR EACH line IN ReadOr(HOME + "\ACCOUNT.INI", "").Lines()
        IF line.StartsWith("address=") THEN myAddress = line.Substring(8, line.Length - 8).Trim().Lower()
        IF line.StartsWith("pass=") THEN myPass = Unscramble(line.Substring(5, line.Length - 5).Trim())
        IF line.StartsWith("check=") THEN checkEvery = Int(Val(line.Substring(6, line.Length - 6)))
    NEXT
END SUB

SUB SaveAccount ()
    FS.Write(HOME + "\ACCOUNT.INI", "address=" + myAddress + EOL + "pass=" + Scramble(myPass) + EOL + "check=" + Str(checkEvery) + EOL)
END SUB

VAR setWin AS GUI_Window
VAR setAddress AS GUI_TextBox
VAR setPass AS GUI_TextBox
VAR setCheck AS GUI_DropDown

SUB AccountSettings ()
    VAR l AS GUI_Label
    VAR b AS GUI_Button
    setWin = GUI_Window.New("Account Settings", 380, 190)
    setWin.Modal = TRUE
    setWin.Icon = "settings"
    l = GUI_Label.New(setWin)
    l.Text = "Frostbird reads your ColdMail. Type the address and password you" + EOL + "use for the webmail; the server is the machine after the @."
    l.SetBounds(10, 8, 360, 32)
    l = GUI_Label.New(setWin)
    l.Text = "&E-mail address:"
    l.SetBounds(10, 54, 100, 14)
    setAddress = GUI_TextBox.New(setWin)
    setAddress.Text = myAddress
    setAddress.SetBounds(120, 50, 250, 21)
    l = GUI_Label.New(setWin)
    l.Text = "&Password:"
    l.SetBounds(10, 84, 100, 14)
    setPass = GUI_TextBox.New(setWin)
    setPass.Password = TRUE
    setPass.Text = myPass
    setPass.SetBounds(120, 80, 250, 21)
    l = GUI_Label.New(setWin)
    l.Text = "&Check for mail:"
    l.SetBounds(10, 114, 100, 14)
    setCheck = GUI_DropDown.New(setWin)
    setCheck.Items = ["every minute", "every 5 minutes", "every 15 minutes", "never"]
    setCheck.Selected = 1
    IF checkEvery = 1 THEN setCheck.Selected = 0
    IF checkEvery = 15 THEN setCheck.Selected = 2
    IF checkEvery = 0 THEN setCheck.Selected = 3
    setCheck.SetBounds(120, 110, 150, 21)
    b = GUI_Button.New(setWin)
    b.Text = "OK"
    b.Default = TRUE
    b.SetBounds(206, 152, 78, 26)
    b.onClick = Settings_Ok
    b = GUI_Button.New(setWin)
    b.Text = "Cancel"
    b.Cancel = TRUE
    b.SetBounds(292, 152, 78, 26)
    b.onClick = Settings_Cancel
    setWin.Center()
    setWin.Show()
    setAddress.Focus()
END SUB

SUB Settings_Ok ()
    VAR a AS String
    a = setAddress.Text.Trim().Lower()
    IF NOT a.Contains("@") OR a.StartsWith("@") OR a.EndsWith("@") THEN
        Say("Addresses look like ann@alpha: your mail name, an @, and the machine that keeps your mail.", "warn")
        RETURN
    END IF
    myAddress = a
    myPass = setPass.Text
    checkEvery = Int(Val("1|5|15|0".Split("|")[setCheck.Selected]))
    SaveAccount()
    setWin.Close()
    GetMail(FALSE)
END SUB

SUB Settings_Cancel ()
    setWin.Close()
END SUB

FUNCTION ServerName () AS String
    RETURN myAddress.Substring(myAddress.IndexOf("@") + 1, myAddress.Length - myAddress.IndexOf("@") - 1)
END FUNCTION

' ================================================================ folders and letters

FUNCTION ReadOr (path AS String, fallback AS String) AS String
    IF FS.Exists(path) THEN RETURN FS.Read(path)
    RETURN fallback
END FUNCTION

FUNCTION Esc (s AS String) AS String
    RETURN s.Replace("%", "%25").Replace("|", "%7C").Replace(Chr(13), "").Replace(Chr(10), "%0A")
END FUNCTION

FUNCTION Unesc (s AS String) AS String
    RETURN s.Replace("%0A", Chr(10)).Replace("%7C", "|").Replace("%25", "%")
END FUNCTION

FUNCTION Index (f AS String) AS Array OF String
    VAR out AS Array OF String
    VAR line AS String
    FOR EACH line IN ReadOr(HOME + "\" + f + ".TXT", "").Lines()
        IF line.Split("|").Count >= 7 THEN out.Add(line)
    NEXT
    RETURN out
END FUNCTION

SUB SaveIndex (f AS String, lines AS Array OF String)
    VAR text AS String
    IF lines.Count > 0 THEN text = lines.Join(EOL) + EOL
    FS.Write(HOME + "\" + f + ".TXT", text)
END SUB

FUNCTION Unread () AS Integer
    VAR line AS String
    VAR n AS Integer
    FOR EACH line IN Index("INBOX")
        IF line.Split("|")[6].Contains("N") THEN n = n + 1
    NEXT
    RETURN n
END FUNCTION

SUB ShowFolders ()
    VAR keep AS Integer
    VAR n AS Integer
    keep = folders.Selected
    n = Unread()
    folders.Clear()
    IF n > 0 THEN
        folders.Add("Inbox (" + Str(n) + ")")
        win.Title = "(" + Str(n) + ") Frostbird"
    ELSE
        folders.Add("Inbox")
        win.Title = "Frostbird"
    END IF
    folders.Add("Sent")
    IF keep >= 0 THEN folders.Selected = keep
END SUB

SUB Folders_OnSelect ()
    IF folders.Selected = 1 THEN
        ShowFolder("SENT")
    ELSE
        ShowFolder("INBOX")
    END IF
END SUB

' "Ann Example <ann@alpha>" -> "Ann Example"
FUNCTION NameOf (address AS String) AS String
    address = address.Trim()
    IF address.Contains("<") AND address.IndexOf("<") > 0 THEN RETURN address.Substring(0, address.IndexOf("<")).Trim().Replace("""", "")
    RETURN address
END FUNCTION

FUNCTION Fit (s AS String, width AS Integer) AS String
    IF s.Length > width THEN RETURN s.Substring(0, width - 1) + "~"
    RETURN s.PadRight(width)
END FUNCTION

' One line of the letter list: unread mark, who, subject, date.
FUNCTION ListLine (line AS String) AS String
    VAR p AS Array OF String
    VAR mark AS String = " "
    VAR person AS String
    p = line.Split("|")
    IF p[6].Contains("N") THEN mark = "*"
    IF folder = "SENT" THEN
        person = "To: " + NameOf(Unesc(p[3]))
    ELSE
        person = NameOf(Unesc(p[2]))
    END IF
    RETURN mark + " " + Fit(person, 22) + " " + Fit(Unesc(p[4]), 34) + " " + p[1]
END FUNCTION

SUB ShowFolder (f AS String)
    VAR all AS Array OF String
    VAR i AS Integer
    VAR keep AS String
    IF letters.Selected >= 0 AND letters.Selected < shown.Count AND f = folder THEN keep = shown[letters.Selected].Split("|")[0]
    folder = f
    all = Index(f)
    shown.Clear()
    letters.Clear()
    ' newest first
    FOR i = all.Count - 1 TO 0 STEP -1
        shown.Add(all[i])
        letters.Add(ListLine(all[i]))
    NEXT
    IF shown.Count = 0 THEN reader.Text = ""
    FOR i = 0 TO shown.Count - 1
        IF shown[i].Split("|")[0] = keep THEN letters.Selected = i
    NEXT
    DrawTools()
END SUB

FUNCTION Current () AS String
    IF letters.Selected < 0 OR letters.Selected >= shown.Count THEN RETURN ""
    RETURN shown[letters.Selected]
END FUNCTION

FUNCTION LetterText (n AS String) AS String
    RETURN ReadOr(HOME + "\MAIL\" + n + ".MSG", "")
END FUNCTION

' The value of a header line, or "".
FUNCTION Header (letter AS String, name AS String) AS String
    VAR line AS String
    FOR EACH line IN letter.Lines()
        IF line = "" THEN RETURN ""
        IF line.Lower().StartsWith(name.Lower() + ":") THEN RETURN line.Substring(name.Length + 1, line.Length - name.Length - 1).Trim()
    NEXT
    RETURN ""
END FUNCTION

FUNCTION BodyOf (letter AS String) AS String
    letter = letter.Replace(Chr(13), "")
    IF NOT letter.Contains(EOL + EOL) THEN RETURN ""
    RETURN letter.Substring(letter.IndexOf(EOL + EOL) + 2, letter.Length - letter.IndexOf(EOL + EOL) - 2)
END FUNCTION

SUB Letters_OnSelect ()
    VAR line AS String
    VAR letter AS String
    VAR all AS Array OF String
    VAR i AS Integer
    line = Current()
    IF line = "" THEN RETURN
    letter = LetterText(line.Split("|")[0])
    reader.Text = "From:     " + Header(letter, "From") + EOL _
                + "To:       " + Header(letter, "To") + EOL _
                + "Date:     " + Header(letter, "Date") + EOL _
                + "Subject:  " + Header(letter, "Subject") + EOL _
                + "--------------------------------------------------------------" + EOL + EOL + BodyOf(letter)
    IF line.Split("|")[6].Contains("N") THEN
        all = Index(folder)
        FOR i = 0 TO all.Count - 1
            IF all[i] = line THEN all[i] = line.Substring(0, line.Length - line.Split("|")[6].Length) + line.Split("|")[6].Replace("N", "")
        NEXT
        SaveIndex(folder, all)
        i = letters.Selected
        ShowFolder(folder)
        letters.Selected = i
        ShowFolders()
    END IF
    DrawTools()
END SUB

SUB MarkUnread ()
    VAR line AS String
    VAR all AS Array OF String
    VAR i AS Integer
    line = Current()
    IF line = "" OR line.Split("|")[6].Contains("N") THEN RETURN
    all = Index(folder)
    FOR i = 0 TO all.Count - 1
        IF all[i] = line THEN all[i] = line + "N"
    NEXT
    SaveIndex(folder, all)
    i = letters.Selected
    ShowFolder(folder)
    letters.Selected = i
    ShowFolders()
END SUB

SUB DeleteLetter ()
    VAR line AS String
    VAR all AS Array OF String
    VAR out AS Array OF String
    VAR l AS String
    VAR i AS Integer
    line = Current()
    IF line = "" THEN RETURN
    i = letters.Selected
    FOR EACH l IN Index(folder)
        IF l <> line THEN out.Add(l)
    NEXT
    SaveIndex(folder, out)
    IF FS.Exists(HOME + "\MAIL\" + line.Split("|")[0] + ".MSG") THEN FS.Delete(HOME + "\MAIL\" + line.Split("|")[0] + ".MSG")
    ' gone from the server as well, so the webmail agrees
    jobs.Add("dele|" + line.Split("|")[0])
    reader.Text = ""
    ShowFolder(folder)
    IF letters.Count > 0 THEN
        letters.Selected = MATH.Min(i, letters.Count - 1)
        Letters_OnSelect()
    END IF
    ShowFolders()
    win.Status = "Deleted."
END SUB

' ================================================================ writing

VAR cWin AS Array OF GUI_Window    ' letters being written, each in a window
VAR cTo AS Array OF GUI_TextBox
VAR cSubject AS Array OF GUI_TextBox
VAR cText AS Array OF GUI_TextArea

SUB Compose (toList AS String, subject AS String, text AS String, title AS String)
    VAR w AS GUI_Window
    VAR l AS GUI_Label
    VAR t AS GUI_TextBox
    VAR s AS GUI_TextBox
    VAR a AS GUI_TextArea
    VAR b AS GUI_Button
    IF title = "" THEN title = "Write: (no subject)"
    w = GUI_Window.New(title, 520, 380)
    w.Icon = "notes"
    w.Tag = Str(cWin.Count)
    l = GUI_Label.New(w)
    l.Text = "&To:"
    l.SetBounds(8, 12, 60, 14)
    t = GUI_TextBox.New(w)
    t.Text = toList
    t.SetBounds(70, 8, 442, 21)
    l = GUI_Label.New(w)
    l.Text = "S&ubject:"
    l.SetBounds(8, 40, 60, 14)
    s = GUI_TextBox.New(w)
    s.Text = subject
    s.SetBounds(70, 36, 442, 21)
    a = GUI_TextArea.New(w)
    a.WordWrap = TRUE
    a.Text = text
    a.SetBounds(8, 64, 504, 274)
    b = GUI_Button.New(w)
    b.Text = "&Send"
    b.Tag = Str(cWin.Count)
    b.SetBounds(352, 346, 76, 26)
    b.onClick = Compose_Send
    b = GUI_Button.New(w)
    b.Text = "Cancel"
    b.Tag = Str(cWin.Count)
    b.SetBounds(436, 346, 76, 26)
    b.onClick = Compose_Cancel
    cWin.Add(w)
    cTo.Add(t)
    cSubject.Add(s)
    cText.Add(a)
    w.Show()
    IF toList = "" THEN
        t.Focus()
    ELSE
        a.Focus()
    END IF
END SUB

' Several windows share these handlers: the one whose button has the focus
' is the one (see SAMPLES\CALC.SPK); failing that, the last one opened.
FUNCTION Which () AS Integer
    VAR i AS Integer
    FOR i = cWin.Count - 1 TO 0 STEP -1
        IF NOT IsNothing(cWin[i]) THEN
            IF cWin[i].Active THEN RETURN i
        END IF
    NEXT
    FOR i = cWin.Count - 1 TO 0 STEP -1
        IF cWin[i].Visible THEN RETURN i
    NEXT
    RETURN -1
END FUNCTION

SUB Compose_Send ()
    VAR i AS Integer
    VAR letter AS String
    i = Which()
    IF i < 0 THEN RETURN
    IF cTo[i].Text.Trim() = "" THEN
        Say("Who is it to? Addresses look like bob@bravo.", "warn")
        RETURN
    END IF
    IF myAddress = "" THEN
        AccountSettings()
        RETURN
    END IF
    letter = "To: " + cTo[i].Text.Replace(EOL, " ") + EOL + "Subject: " + cSubject[i].Text.Replace(EOL, " ") + EOL + EOL + cText[i].Text.Replace(Chr(13), "")
    jobs.Add("send|" + letter)
    cWin[i].Hide()
    win.Status = "Sending..."
END SUB

SUB Compose_Cancel ()
    VAR i AS Integer
    i = Which()
    IF i >= 0 THEN cWin[i].Hide()
END SUB

FUNCTION Quote (letter AS String) AS String
    VAR out AS String
    VAR line AS String
    out = EOL + EOL + "On " + Header(letter, "Date") + ", " + NameOf(Header(letter, "From")) + " wrote:" + EOL
    FOR EACH line IN BodyOf(letter).Lines()
        out = out + "> " + line + EOL
    NEXT
    RETURN out
END FUNCTION

SUB Reply ()
    VAR letter AS String
    VAR subject AS String
    IF Current() = "" THEN RETURN
    letter = LetterText(Current().Split("|")[0])
    subject = Header(letter, "Subject")
    IF NOT subject.Lower().StartsWith("re:") THEN subject = "Re: " + subject
    IF folder = "SENT" THEN
        Compose(Header(letter, "To"), subject, Quote(letter), "Write: " + subject)
    ELSE
        Compose(Bare(Header(letter, "From")), subject, Quote(letter), "Write: " + subject)
    END IF
END SUB

SUB Forward ()
    VAR letter AS String
    VAR subject AS String
    IF Current() = "" THEN RETURN
    letter = LetterText(Current().Split("|")[0])
    subject = "Fwd: " + Header(letter, "Subject")
    Compose("", subject, EOL + EOL + "-------- Forwarded Message --------" + EOL + "From: " + Header(letter, "From") + EOL + "Date: " + Header(letter, "Date") + EOL + "Subject: " + Header(letter, "Subject") + EOL + EOL + BodyOf(letter), "Write: " + subject)
END SUB

FUNCTION Bare (address AS String) AS String
    VAR a AS String
    a = address.Trim()
    IF a.Contains("<") AND a.Contains(">") THEN a = a.Substring(a.IndexOf("<") + 1, a.IndexOf(">") - a.IndexOf("<") - 1)
    RETURN a.Trim().Lower()
END FUNCTION

' ================================================================ talking to the server

SUB GetMail (automatic AS Bool)
    IF myAddress = "" THEN
        AccountSettings()
        RETURN
    END IF
    IF NOT jobs.Contains("get") THEN jobs.Add("get")
    quiet = automatic
    lastCheck = SYS.Ticks
END SUB

SUB Clock_OnTick ()
    ' nothing may come after this TRY: a tick whose Connect failed is spoiled
    TRY
        Tick()
    CATCH err
    END TRY
END SUB

SUB Tick ()
    VAR conn AS NET_Connection
    IF talking THEN
        IF convError <> "" OR SYS.Ticks - convSince > PATIENCE THEN EndTalk()
        RETURN
    END IF
    IF checkEvery > 0 AND SYS.Ticks - lastCheck > checkEvery * 60000 THEN GetMail(TRUE)
    IF jobs.Count = 0 OR myAddress = "" THEN RETURN
    ' a domain: where its mail goes, asked in ticks of their own first
    IF RsNextMail(ServerName()) THEN
        win.Status = "Looking up " + ServerName() + "..."
        RETURN
    END IF
    ' everything waiting goes in one conversation
    cmds.Clear()
    cmds.Add("USER " + myAddress.Split("@")[0])
    cmds.Add("PASS " + myPass)
    newCount = 0
    WHILE jobs.Count > 0
        IF jobs[0] = "get" THEN
            cmds.Add("LIST|INBOX")
            cmds.Add("LIST SENT|SENT")
            win.Status = "Checking for mail on " + ServerName() + "..."
        ELSEIF jobs[0].StartsWith("dele|") THEN
            cmds.Add("DELE " + jobs[0].Substring(5, jobs[0].Length - 5))
        ELSEIF jobs[0].StartsWith("send|") THEN
            cmds.Add("SEND" + EOL + jobs[0].Substring(5, jobs[0].Length - 5))
            ' and bring the copy in Sent down
            cmds.Add("LIST SENT|SENT")
        END IF
        jobs.RemoveAt(0)
    END WHILE
    cmds.Add("QUIT")
    cmdAt = -1
    convNumber = convNumber + 1
    convError = ""
    convSince = SYS.Ticks
    talking = TRUE
    DrawTools()
    TRY
        ' (the machine SimDNS named for the domain's mail, or the name itself)
        conn = sock.Connect(RsMailTarget(ServerName()), POPPORT)
        conn.Tag = Str(convNumber)
    CATCH err
        convError = err
    END TRY
    ' (the server speaks first: Pop_OnMessage carries on from its greeting)
    ' Nothing else may wait in this tick.
END SUB

' The server's answer to what we said last (or its greeting): note it, say the next thing.
SUB Pop_OnMessage (conn AS NET_Connection, message AS String)
    VAR said AS String
    VAR tag AS String
    VAR answer AS String
    IF conn.Tag <> Str(convNumber) OR NOT talking THEN RETURN
    convSince = SYS.Ticks
    IF cmdAt >= 0 THEN
        said = cmds[cmdAt]
        tag = ""
        IF said.Contains("|") THEN
            tag = said.Substring(said.IndexOf("|") + 1, said.Length - said.IndexOf("|") - 1)
            said = said.Substring(0, said.IndexOf("|"))
        END IF
        answer = ""
        IF message.Contains(EOL) THEN answer = message.Substring(message.IndexOf(EOL) + 1, message.Length - message.IndexOf(EOL) - 1)
        IF message.StartsWith("-ERR") THEN
            IF said.StartsWith("PASS") THEN
                convError = "The server on " + ServerName() + " says: " + message.Substring(5, message.Length - 5) + " Check the password in Account Settings."
                RETURN
            END IF
            IF said.StartsWith("SEND") THEN Say("Your letter was not sent:" + EOL + EOL + message.Substring(5, message.Length - 5), "warn")
        ELSEIF said.StartsWith("LIST") THEN
            Listed(tag, answer)
        ELSEIF said.StartsWith("RETR") THEN
            Fetched(tag, said.Substring(5, said.Length - 5).Trim(), answer)
        ELSEIF said.StartsWith("SEND") THEN
            win.Status = "Your letter is on its way."
        END IF
    END IF
    cmdAt = cmdAt + 1
    IF cmdAt >= cmds.Count THEN
        EndTalk()
        RETURN
    END IF
    said = cmds[cmdAt]
    IF said.Contains("|") THEN said = said.Substring(0, said.IndexOf("|"))
    TRY
        conn.Send(said)
    CATCH err
        convError = "The server on " + ServerName() + " hung up."
    END TRY
END SUB

SUB Pop_OnClose (conn AS NET_Connection)
    IF conn.Tag = Str(convNumber) AND talking AND cmdAt < cmds.Count - 1 THEN convError = "The server on " + ServerName() + " hung up."
END SUB

' The server's list of a folder: fetch the letters we have not got.
SUB Listed (f AS String, answer AS String)
    VAR mine AS Array OF String
    VAR have AS String = "|"
    VAR line AS String
    VAR onServer AS String = "|"
    VAR keep AS Array OF String
    mine = Index(f)
    FOR EACH line IN mine
        have = have + line.Split("|")[0] + "|"
    NEXT
    FOR EACH line IN answer.Lines()
        IF line.Split("|").Count < 7 THEN CONTINUE
        onServer = onServer + line.Split("|")[0] + "|"
        IF NOT have.Contains("|" + line.Split("|")[0] + "|") THEN
            ' the letter, and its line once it is here (unread in the Inbox)
            cmds.Insert(cmdAt + 1, "RETR " + line.Split("|")[0] + "|" + f + "|" + line)
        END IF
    NEXT
    ' letters deleted elsewhere (the webmail) go here too
    FOR EACH line IN mine
        IF onServer.Contains("|" + line.Split("|")[0] + "|") THEN
            keep.Add(line)
        ELSEIF FS.Exists(HOME + "\MAIL\" + line.Split("|")[0] + ".MSG") THEN
            FS.Delete(HOME + "\MAIL\" + line.Split("|")[0] + ".MSG")
        END IF
    NEXT
    IF keep.Count <> mine.Count THEN SaveIndex(f, keep)
END SUB

' A letter came down: tag is "FOLDER|its index line".
SUB Fetched (tag AS String, n AS String, letter AS String)
    VAR f AS String
    VAR line AS String
    f = tag.Split("|")[0]
    line = tag.Substring(f.Length + 1, tag.Length - f.Length - 1)
    FS.Write(HOME + "\MAIL\" + n + ".MSG", letter)
    IF f = "INBOX" THEN
        IF NOT line.Split("|")[6].Contains("N") THEN line = line + "N"
        newCount = newCount + 1
    ELSE
        line = line.Substring(0, line.Length - line.Split("|")[6].Length)
    END IF
    FS.Append(HOME + "\" + f + ".TXT", line + EOL)
END SUB

SUB EndTalk ()
    VAR err AS String
    talking = FALSE
    err = convError
    convError = ""
    TRY
        sock.Close()
    CATCH problem
    END TRY
    ShowFolder(folder)
    ShowFolders()
    DrawTools()
    IF err <> "" OR cmdAt < cmds.Count - 1 THEN
        IF err = "" THEN err = "The server on " + ServerName() + " did not answer. Is ColdMail's mail server running there?"
        IF err.Contains("refused") OR err.Contains("timed out") OR err.Contains("Unknown host") THEN err = "Frostbird could not reach the mail server on " + ServerName() + ". (" + err + ")"
        win.Status = "Could not get mail."
        IF NOT quiet THEN Say(err, "error")
        RETURN
    END IF
    IF newCount > 0 THEN
        win.Status = Str(newCount) + " new letter" + Plural(newCount) + " from " + ServerName()
        SYS.Beep(880, 80)
    ELSEIF win.Status.StartsWith("Checking") THEN
        win.Status = "No new mail."
    END IF
END SUB

FUNCTION Plural (n AS Integer) AS String
    IF n = 1 THEN RETURN ""
    RETURN "s"
END FUNCTION

SUB Say (text AS String, kind AS String)
    VAR box AS GUI_MessageBox
    box = GUI_MessageBox.New(win)
    box.Title = "Frostbird"
    box.Kind = kind
    box.Text = text
    box.Show()
END SUB

' ================================================================ menus

SUB Menu_OnSelect (item AS String)
    SELECT CASE item
        CASE "Get New Mail"
            GetMail(FALSE)
        CASE "Write a Letter"
            Compose("", "", "", "")
        CASE "Account Settings..."
            AccountSettings()
        CASE "Exit"
            win.Close()
        CASE "Reply"
            Reply()
        CASE "Forward"
            Forward()
        CASE "Delete"
            DeleteLetter()
        CASE "Mark as Unread"
            MarkUnread()
        CASE "About Frostbird"
            Say("Frostbird 1.0 for SIM95" + EOL + EOL + "A mail program for ColdMail: it collects your letters from your mail server on port 110 and sends through it." + EOL + EOL + "Letters are kept in C:\FROST.", "info")
    END SELECT
END SUB

' ================================================================ the toolbar

FUNCTION ToolLabel (i AS Integer) AS String
    RETURN "Get Mail|Write|Reply|Forward|Delete|Settings".Split("|")[i]
END FUNCTION

FUNCTION ToolOn (i AS Integer) AS Bool
    IF i = 0 THEN RETURN NOT talking
    IF i >= 2 AND i <= 4 THEN RETURN Current() <> ""
    RETURN TRUE
END FUNCTION

SUB Tools_OnDraw (canvas AS GUI_Canvas)
    DrawTools()
END SUB

SUB DrawTools ()
    VAR i AS Integer
    VAR x AS Integer
    VAR on AS Bool
    VAR label AS String
    VAR d AS Integer
    tools.Clear()
    tools.SetColor(7)
    tools.FillRect(0, 0, tools.Width, tools.Height)
    FOR i = 0 TO TBCOUNT - 1
        x = 2 + i * TBW
        on = ToolOn(i)
        d = 0
        IF i = tbPressed THEN d = 1
        IF d = 1 THEN
            Bevel(x, 1, TBW - 2, TBH, 0, 15)
        ELSE
            Bevel(x, 1, TBW - 2, TBH, 15, 8)
        END IF
        DrawIcon(i, x + Int((TBW - 24) / 2) + d, 5 + d, on)
        label = ToolLabel(i)
        IF on THEN
            TinyText(x + Int((TBW - 2 - (label.Length * 6 - 1)) / 2) + d, 31 + d, label, 0)
        ELSE
            TinyText(x + Int((TBW - 2 - (label.Length * 6 - 1)) / 2) + 1, 32, label, 15)
            TinyText(x + Int((TBW - 2 - (label.Length * 6 - 1)) / 2), 31, label, 8)
        END IF
    NEXT
    tools.SetColor(8)
    tools.Line(0, TBH + 2, tools.Width, TBH + 2)
END SUB

SUB Bevel (x AS Integer, y AS Integer, w AS Integer, h AS Integer, light AS Integer, dark AS Integer)
    tools.SetColor(light)
    tools.Line(x, y, x + w - 1, y)
    tools.Line(x, y, x, y + h - 1)
    tools.SetColor(dark)
    tools.Line(x, y + h - 1, x + w - 1, y + h - 1)
    tools.Line(x + w - 1, y, x + w - 1, y + h - 1)
END SUB

FUNCTION Pick (on AS Bool, yes AS Integer, no AS Integer) AS Integer
    IF on THEN RETURN yes
    RETURN no
END FUNCTION

' A filled polygon: points as "x,y x,y ...", offset by ox, oy.
SUB Poly (points AS String, ox AS Integer, oy AS Integer, colour AS Integer)
    VAR xs AS Array OF Real
    VAR ys AS Array OF Real
    VAR pt AS String
    VAR hits AS Array OF Real
    VAR y AS Integer
    VAR i AS Integer
    VAR j AS Integer
    VAR t AS Real
    VAR yy AS Real
    VAR top AS Real = 9999
    VAR bottom AS Real = -9999
    FOR EACH pt IN points.Split(" ")
        xs.Add(Val(pt.Split(",")[0]))
        ys.Add(Val(pt.Split(",")[1]))
        top = MATH.Min(top, ys[ys.Count - 1])
        bottom = MATH.Max(bottom, ys[ys.Count - 1])
    NEXT
    tools.SetColor(colour)
    FOR y = Int(top) TO Int(bottom)
        yy = y + 0.5
        hits.Clear()
        FOR i = 0 TO xs.Count - 1
            j = (i + 1) MOD xs.Count
            IF (ys[i] <= yy AND ys[j] > yy) OR (ys[j] <= yy AND ys[i] > yy) THEN hits.Add(xs[i] + (yy - ys[i]) * (xs[j] - xs[i]) / (ys[j] - ys[i]))
        NEXT
        FOR i = 0 TO hits.Count - 2
            FOR j = i + 1 TO hits.Count - 1
                IF hits[j] < hits[i] THEN
                    t = hits[i]
                    hits[i] = hits[j]
                    hits[j] = t
                END IF
            NEXT
        NEXT
        i = 0
        WHILE i + 1 < hits.Count
            tools.FillRect(ox + MATH.Round(hits[i]), oy + y, MATH.Max(1, MATH.Round(hits[i + 1]) - MATH.Round(hits[i])), 1)
            i = i + 2
        END WHILE
    NEXT
END SUB

SUB Envelope (ox AS Integer, oy AS Integer, on AS Bool)
    tools.SetColor(Pick(on, 15, 7))
    tools.FillRect(ox + 1, oy + 6, 20, 13)
    tools.SetColor(Pick(on, 0, 8))
    tools.Rect(ox + 1, oy + 6, 20, 13)
    tools.Line(ox + 1, oy + 6, ox + 11, oy + 13)
    tools.Line(ox + 11, oy + 13, ox + 20, oy + 6)
END SUB

SUB DrawIcon (i AS Integer, ox AS Integer, oy AS Integer, on AS Bool)
    SELECT CASE i
        CASE 0
            ' an envelope with a blue arrow coming down into it
            Envelope(ox, oy + 3, on)
            Poly("8,0 14,0 14,5 18,5 11,12 4,5 8,5", ox + 1, oy, Pick(on, 12, 8))
        CASE 1
            ' a sheet of paper and a pencil
            tools.SetColor(Pick(on, 15, 7))
            tools.FillRect(ox + 3, oy + 1, 14, 20)
            tools.SetColor(Pick(on, 0, 8))
            tools.Rect(ox + 3, oy + 1, 14, 20)
            tools.Line(ox + 6, oy + 6, ox + 13, oy + 6)
            tools.Line(ox + 6, oy + 10, ox + 13, oy + 10)
            tools.Line(ox + 6, oy + 14, ox + 10, oy + 14)
            Poly("20,4 23,7 12,18 9,19 10,15", ox, oy, Pick(on, 11, 8))
            tools.SetColor(Pick(on, 0, 8))
            tools.Line(ox + 20, oy + 4, ox + 9, oy + 19)
        CASE 2
            ' a curved arrow going back
            Envelope(ox, oy + 2, on)
            Poly("0,6 7,0 7,4 15,4 15,8 7,8 7,12", ox + 2, oy, Pick(on, 2, 8))
        CASE 3
            ' an arrow going on
            Envelope(ox, oy + 2, on)
            Poly("15,6 8,0 8,4 0,4 0,8 8,8 8,12", ox + 6, oy, Pick(on, 2, 8))
        CASE 4
            ' a red cross
            Poly("2,4 6,0 11,5 16,0 20,4 15,9 20,14 16,18 11,13 6,18 2,14 7,9", ox + 1, oy + 2, Pick(on, 9, 8))
        CASE 5
            ' a key
            tools.SetColor(Pick(on, 3, 8))
            tools.FillCircle(ox + 6, oy + 11, 5)
            tools.SetColor(7)
            tools.FillCircle(ox + 6, oy + 11, 2)
            tools.SetColor(Pick(on, 3, 8))
            tools.FillRect(ox + 10, oy + 10, 12, 3)
            tools.FillRect(ox + 17, oy + 13, 2, 4)
            tools.FillRect(ox + 20, oy + 13, 2, 3)
    END SELECT
END SUB

FUNCTION Glyph (c AS String) AS String
    SELECT CASE Asc(c)
        CASE 32
            RETURN ".....|.....|.....|.....|.....|.....|.....|....."
        CASE 68
            RETURN "####.|#...#|#...#|#...#|#...#|#...#|####.|....."
        CASE 70
            RETURN "#####|#....|#....|####.|#....|#....|#....|....."
        CASE 71
            RETURN ".###.|#...#|#....|#.###|#...#|#...#|.###.|....."
        CASE 77
            RETURN "#...#|##.##|#.#.#|#.#.#|#...#|#...#|#...#|....."
        CASE 82
            RETURN "####.|#...#|#...#|####.|#.#..|#..#.|#...#|....."
        CASE 83
            RETURN ".####|#....|#....|.###.|....#|....#|####.|....."
        CASE 87
            RETURN "#...#|#...#|#...#|#.#.#|#.#.#|#.#.#|.#.#.|....."
        CASE 97
            RETURN ".....|.....|.###.|....#|.####|#...#|.####|....."
        CASE 100
            RETURN "....#|....#|.####|#...#|#...#|#...#|.####|....."
        CASE 101
            RETURN ".....|.....|.###.|#...#|#####|#....|.###.|....."
        CASE 103
            RETURN ".....|.....|.####|#...#|#...#|.####|....#|.###."
        CASE 105
            RETURN "..#..|.....|.##..|..#..|..#..|..#..|.###.|....."
        CASE 108
            RETURN ".##..|..#..|..#..|..#..|..#..|..#..|.###.|....."
        CASE 110
            RETURN ".....|.....|#.##.|##..#|#...#|#...#|#...#|....."
        CASE 111
            RETURN ".....|.....|.###.|#...#|#...#|#...#|.###.|....."
        CASE 112
            RETURN ".....|.....|####.|#...#|#...#|####.|#....|#...."
        CASE 114
            RETURN ".....|.....|#.##.|##..#|#....|#....|#....|....."
        CASE 115
            RETURN ".....|.....|.####|#....|.###.|....#|####.|....."
        CASE 116
            RETURN ".#...|.#...|###..|.#...|.#...|.#..#|..##.|....."
        CASE 119
            RETURN ".....|.....|#...#|#...#|#.#.#|#.#.#|.#.#.|....."
        CASE 121
            RETURN ".....|.....|#...#|#...#|#...#|.####|....#|.###."
    END SELECT
    RETURN ".....|.....|.....|.....|.....|.....|.....|....."
END FUNCTION

SUB TinyText (x AS Integer, y AS Integer, text AS String, colour AS Integer)
    VAR i AS Integer
    VAR r AS Integer
    VAR rows AS Array OF String
    VAR row AS String
    VAR k AS Integer
    VAR start AS Integer
    tools.SetColor(colour)
    FOR i = 0 TO text.Length - 1
        rows = Glyph(text.CharAt(i)).Split("|")
        FOR r = 0 TO 7
            row = rows[r] + "."
            start = -1
            FOR k = 0 TO 5
                IF row.CharAt(k) = "#" AND start < 0 THEN start = k
                IF row.CharAt(k) <> "#" AND start >= 0 THEN
                    tools.FillRect(x + i * 6 + start, y + r, k - start, 1)
                    start = -1
                END IF
            NEXT
        NEXT
    NEXT
END SUB

FUNCTION ToolAt (x AS Integer, y AS Integer) AS Integer
    VAR i AS Integer
    IF x < 2 OR y > TBH THEN RETURN -1
    i = Int((x - 2) / TBW)
    IF i >= TBCOUNT THEN RETURN -1
    RETURN i
END FUNCTION

SUB Tools_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)
    VAR i AS Integer
    i = ToolAt(x, y)
    IF i < 0 THEN RETURN
    IF NOT ToolOn(i) THEN RETURN
    tbPressed = i
    DrawTools()
END SUB

SUB Tools_OnMouseUp (x AS Integer, y AS Integer, button AS Integer)
    VAR i AS Integer
    i = tbPressed
    tbPressed = -1
    DrawTools()
    IF i < 0 OR ToolAt(x, y) <> i THEN RETURN
    SELECT CASE i
        CASE 0
            GetMail(FALSE)
        CASE 1
            Compose("", "", "", "")
        CASE 2
            Reply()
        CASE 3
            Forward()
        CASE 4
            DeleteLetter()
        CASE 5
            AccountSettings()
    END SELECT
END SUB
