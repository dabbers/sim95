    t = t + "C0;F82,12,24,24;I76,16,logo" + NL
    t = t + "C0;F76,16,24,24;I70,20,logo" + NL
    t = t + "C0;F70,20,24,24;C1;F1,101,158,18;C11;T8,104,SimTube presents...;I64,24,logo" + NL
    t = t + "C0;F64,24,24,24;I58,28,logo" + NL
