' VAPOR|id=SIMTUBE|name=SimTube|kind=web|version=46b586db|category=Fun|run=/|files=C:\WEB\COMMENT.ASP;C:\WEB\GETPLAY.ASP;C:\WEB\INDEX.ASP;C:\WEB\JOIN.ASP;C:\WEB\LOGIN.ASP;C:\WEB\LOGOUT.ASP;C:\WEB\MOVIE.ASP;C:\WEB\RATE.ASP;C:\WEB\SIMTUBE.HTM;C:\WEB\THUMB.ASP;C:\WEB\TOP.ASP;C:\WEB\TUBE.SPK;C:\WEB\UPLOAD.ASP;C:\WEB\WATCH.ASP;C:\PROGRAMS\PLAYER.SPK;C:\TUBEDATA\SEED\BASE.SMV;C:\TUBEDATA\SEED\DANCE.SMV;C:\TUBEDATA\SEED\WELCOME.SMV|tasks=|startup=|folder=TUBE|about=Movies for the SIM95 network: watch, upload, rate and comment, with SimPlayer (C:\PROGRAMS\PLAYER.SPK) to play them. Becomes this machine's home page, or on a SimHost machine gets a folder of its own.
' INSTALL.SPK - puts SimTube on this machine. Generated by tools/build-installer.mjs;
' edit the files in simtube/ and rebuild rather than editing this.
'
' Save this as C:\MYFILES\INSTALL.SPK in SPARK and press F5. SimTube becomes
' this machine's home page: its pages go into C:\WEB (the stock INDEX.HTM moves
' to WELCOME.HTM), and SimPlayer, the movie player, into C:\PROGRAMS\PLAYER.SPK.
' The sample movies wait in C:\TUBEDATA\SEED until the first visit to the front
' page puts them up. Movies, accounts and comments in C:\TUBEDATA are left
' alone, so running it again upgrades SimTube. Then open http://YOURNAME/ in
' Voyager, and play a movie with C:\PROGRAMS\PLAYER.SPK.

VAR t AS String
VAR NL AS String
VAR intoDir AS String   ' "" for the web root, or the folder this web app goes in

SUB Main ()
    NL = Chr(10)
    ' On a machine set up for several web apps (SimHost: C:\SYSTEM\WEBAPPS.INI
    ' says mode=folders), this one goes in C:\WEB\TUBE and leaves the home page alone.
    IF FS.Exists("C:\SYSTEM\WEBAPPS.INI") THEN
        IF FS.Read("C:\SYSTEM\WEBAPPS.INI").Contains("mode=folders") THEN intoDir = "TUBE"
    END IF
    IF intoDir <> "" AND NOT FS.Exists("C:\WEB\" + intoDir) THEN FS.MakeDir("C:\WEB\" + intoDir)


    IF intoDir = "" THEN MoveHomePage()
    TubeDirs()
    File0()
    File1()
    File2()
    File3()
    File4()
    File5()
    File6()
    File7()
    File8()
    File9()
    File10()
    File11()
    File12()
    File13()
    File14()
    File15()
    File16()
    File17()
    Print("SimTube is installed (18 files).")

    IF intoDir = "" THEN
        Print("Open http://" + NET.HostName.Lower() + "/ in Voyager.")
    ELSE
        Print("Open http://" + NET.HostName.Lower() + "/" + intoDir.Lower() + "/ in Voyager.")
    END IF
END SUB

' Where a file goes: in this web app's folder, on a machine that keeps them in folders.
FUNCTION Dest (path AS String) AS String
    IF intoDir <> "" AND path.Upper().StartsWith("C:\WEB\") THEN RETURN "C:\WEB\" + intoDir + "\" + path.Substring(7, path.Length - 7)
    RETURN path
END FUNCTION

SUB Put (path AS String)
    FS.Write(Dest(path), t)
    Print("  wrote " + Dest(path))
END SUB

SUB File0 ()
    t = ""
    t = t + "<%@ import file=""TUBE.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' COMMENT.ASP - adds a comment under a movie, then goes back to it." + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "line = FindVideo(REQUEST.Form(""v""))" + NL
    t = t + "IF line = """" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "problem = AddComment(VF(line, 0), viewer, REQUEST.Form(""text""))" + NL
    t = t + "IF problem <> """" THEN RESPONSE.Redirect(""watch.asp?back=1&v="" + VF(line, 0) + ""&why="" + UrlEnc(problem))" + NL
    t = t + "RESPONSE.Redirect(""watch.asp?back=1&v="" + VF(line, 0))" + NL
    t = t + "%>" + NL
    Put("C:\WEB\COMMENT.ASP")
END SUB

SUB File1 ()
    t = ""
    t = t + "<%" + NL
    t = t + "' GETPLAY.ASP - SimPlayer itself, as plain text, ready to save as" + NL
    t = t + "' C:\PROGRAMS\PLAYER.SPK (Simxplorer: File > Save As File; or copy it into SPARK)." + NL
    t = t + "RESPONSE.ContentType = ""text/plain""" + NL
    t = t + "IF FS.Exists(""C:\PROGRAMS\PLAYER.SPK"") THEN" + NL
    t = t + "    RESPONSE.Write(FS.Read(""C:\PROGRAMS\PLAYER.SPK""))" + NL
    t = t + "ELSE" + NL
    t = t + "    RESPONSE.Write(""' SimPlayer is not on this machine. Install SimTube again to put it back."")" + NL
    t = t + "END IF" + NL
    t = t + "%>" + NL
    Put("C:\WEB\GETPLAY.ASP")
END SUB

SUB File2 ()
    t = ""
    t = t + "<%@ import file=""TUBE.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' INDEX.ASP - the front page: the newest movies, the most viewed, and the door in." + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR rec AS Array OF String" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "Seed()" + NL
    t = t + "SELECT CASE REQUEST.Query(""e"")" + NL
    t = t + "    CASE ""login""" + NL
    t = t + "        problem = ""That user name and password do not match. (Or you need to log in first.)""" + NL
    t = t + "    CASE ""join""" + NL
    t = t + "        problem = REQUEST.Query(""why"")" + NL
    t = t + "    CASE ""bye""" + NL
    t = t + "        problem = ""You have logged out. See you soon.""" + NL
    t = t + "    CASE ""token""" + NL
    t = t + "        problem = ""That did not come from a SimTube page, so nothing was changed.""" + NL
    t = t + "END SELECT" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Home"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr>" + NL
    t = t + "<td valign=""top"">" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<%= BoxTop(""Featured Movies"") %>" + NL
    t = t + "<%= Grid(Newest(GRIDSIZE)) %>" + NL
    t = t + "<p><font size=""2"">SimTube movies play in <b>SimPlayer</b>. Click a movie, then open its address in SimPlayer." + NL
    t = t + "No SimPlayer yet? <a href=""getplay.asp"">Get SimPlayer</a>.</font></p>" + NL
    t = t + "</td>" + NL
    t = t + "<td width=""210"" valign=""top"" bgcolor=""#EEEEEE"">" + NL
    t = t + "<% IF viewer <> """" THEN" + NL
    t = t + "    rec = LoadUser(viewer) %>" + NL
    t = t + "<%= BoxTop(""Hello, "" + H(Field(rec, ""name""))) %>" + NL
    t = t + "<p><font size=""2""><a href=""upload.asp""><b>Upload a movie</b></a><br>" + NL
    t = t + "<a href=""logout.asp?<%= TokenArg() %>"">Log out</a></font></p>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<a name=""login""></a>" + NL
    t = t + "<%= BoxTop(""Log In"") %>" + NL
    t = t + "<form action=""login.asp"" method=""post"">" + NL
    t = t + "<font size=""2"">User name:<br><input name=""u"" size=""14""><br>" + NL
    t = t + "Password:<br><input type=""password"" name=""pw"" size=""14""><br>" + NL
    t = t + "<input type=""submit"" value=""Log In""></font>" + NL
    t = t + "</form>" + NL
    t = t + "<%= BoxTop(""Sign Up"") %>" + NL
    t = t + "<form action=""join.asp"" method=""post"">" + NL
    t = t + "<font size=""2"">Your name:<br><input name=""name"" size=""18""><br>" + NL
    t = t + "User name:<br><input name=""u"" size=""14""><br>" + NL
    t = t + "Password:<br><input type=""password"" name=""pw"" size=""14""><br>" + NL
    t = t + "Again:<br><input type=""password"" name=""pw2"" size=""14""><br>" + NL
    t = t + "<input type=""submit"" value=""Sign Up""></font>" + NL
    t = t + "<p><font size=""1"" color=""#808080"">User names are 3 to 8 letters or digits." + NL
    t = t + "Signing up lets you upload, rate and comment.</font></p>" + NL
    t = t + "</form>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<%= BoxTop(""Most Viewed"") %>" + NL
    t = t + "<table cellpadding=""2"" cellspacing=""0"">" + NL
    t = t + "<% FOR EACH line IN MostViewed(5) %>" + NL
    t = t + "<tr><td valign=""top""><a href=""watch.asp?v=<%= VF(line, 0) %>""><img src=""thumb.asp?v=<%= VF(line, 0) %>"" width=""40"" height=""30"" border=""1"" alt=""""></a></td>" + NL
    t = t + "<td valign=""top""><font size=""1""><a href=""watch.asp?v=<%= VF(line, 0) %>""><b><%= H(VTitle(line)) %></b></a><br><%= Plural(Views(VF(line, 0)), ""view"", ""views"") %></font></td></tr>" + NL
    t = t + "<% NEXT %>" + NL
    t = t + "</table>" + NL
    t = t + "<p><font size=""1""><a href=""top.asp"">More...</a></font></p>" + NL
    t = t + "</td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\INDEX.ASP")
END SUB

SUB File3 ()
    t = ""
    t = t + "<%@ import file=""TUBE.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' JOIN.ASP - makes a new account and signs it in." + NL
    t = t + "VAR u AS String" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "u = REQUEST.Form(""u"").Trim().Lower()" + NL
    t = t + "IF REQUEST.Form(""pw"") <> REQUEST.Form(""pw2"") THEN" + NL
    t = t + "    problem = ""The two passwords are different.""" + NL
    t = t + "ELSE" + NL
    t = t + "    problem = CreateUser(u, REQUEST.Form(""pw""), REQUEST.Form(""name""))" + NL
    t = t + "END IF" + NL
    t = t + "IF problem <> """" THEN RESPONSE.Redirect(""index.asp?e=join&why="" + UrlEnc(problem))" + NL
    t = t + "SignIn(u)" + NL
    t = t + "RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\JOIN.ASP")
END SUB

SUB File4 ()
    t = ""
    t = t + "<%@ import file=""TUBE.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' LOGIN.ASP - checks the password, hands out a session cookie, and goes home." + NL
    t = t + "VAR u AS String" + NL
    t = t + "u = CleanName(REQUEST.Form(""u""))" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "IF u = """" OR NOT CheckPassword(u, REQUEST.Form(""pw"")) THEN RESPONSE.Redirect(""index.asp?e=login"")" + NL
    t = t + "SignIn(u)" + NL
    t = t + "RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\LOGIN.ASP")
END SUB

SUB File5 ()
    t = ""
    t = t + "<%@ import file=""TUBE.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' LOGOUT.ASP?t=token - forgets the session on disk and in Voyager. The token" + NL
    t = t + "' stops another site from logging you out." + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "SignOut()" + NL
    t = t + "RESPONSE.Redirect(""index.asp?e=bye"")" + NL
    t = t + "%>" + NL
    Put("C:\WEB\LOGOUT.ASP")
END SUB

SUB File6 ()
    t = ""
    t = t + "<%@ import file=""TUBE.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' MOVIE.ASP?v=N - the movie, for SimPlayer: its manifest (what it is, and" + NL
    t = t + "' where the parts are), as video/x-simmovie. MOVIE.ASP?v=N&p=K is part K." + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR part AS String" + NL
    t = t + "RESPONSE.Clear()" + NL
    t = t + "line = FindVideo(REQUEST.Query(""v""))" + NL
    t = t + "IF line = """" THEN" + NL
    t = t + "    RESPONSE.Status = ""404 Not Found""" + NL
    t = t + "    RESPONSE.ContentType = ""text/plain""" + NL
    t = t + "    RESPONSE.Write(""There is no such movie on SimTube."")" + NL
    t = t + "    RESPONSE.End()" + NL
    t = t + "END IF" + NL
    t = t + "RESPONSE.ContentType = MIME" + NL
    t = t + "part = REQUEST.Query(""p"")" + NL
    t = t + "IF part = """" THEN" + NL
    t = t + "    RESPONSE.Write(Manifest(line))" + NL
    t = t + "    RESPONSE.End()" + NL
    t = t + "END IF" + NL
    t = t + "IF NOT IsNumber(part) OR NOT FS.Exists(DATADIR + ""\MOVIES\"" + VF(line, 0) + ""\"" + part + "".SMV"") THEN" + NL
    t = t + "    RESPONSE.Status = ""404 Not Found""" + NL
    t = t + "    RESPONSE.ContentType = ""text/plain""" + NL
    t = t + "    RESPONSE.Write(""This movie has no part "" + part + ""."")" + NL
    t = t + "    RESPONSE.End()" + NL
    t = t + "END IF" + NL
    t = t + "RESPONSE.Write(FS.Read(DATADIR + ""\MOVIES\"" + VF(line, 0) + ""\"" + part + "".SMV""))" + NL
    t = t + "RESPONSE.End()" + NL
    t = t + "%>" + NL
    Put("C:\WEB\MOVIE.ASP")
END SUB

SUB File7 ()
    t = ""
    t = t + "<%@ import file=""TUBE.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' RATE.ASP - one to five stars for a movie (once each; again changes it), then back to it." + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR given AS Integer" + NL
    t = t + "RequireLogin()" + NL
    t = t + "RequireToken()" + NL
    t = t + "IF REQUEST.Method <> ""POST"" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "line = FindVideo(REQUEST.Form(""v""))" + NL
    t = t + "IF line = """" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "given = Int(Val(REQUEST.Form(""stars"")))" + NL
    t = t + "IF given < 1 OR given > 5 THEN RESPONSE.Redirect(""watch.asp?back=1&v="" + VF(line, 0) + ""&why="" + UrlEnc(""Pick from one to five stars.""))" + NL
    t = t + "Rate(VF(line, 0), viewer, given)" + NL
    t = t + "RESPONSE.Redirect(""watch.asp?back=1&v="" + VF(line, 0) + ""&why="" + UrlEnc(""Thanks! You gave it "" + Plural(given, ""star"", ""stars"") + "".""))" + NL
    t = t + "%>" + NL
    Put("C:\WEB\RATE.ASP")
END SUB

SUB File8 ()
    t = ""
    t = t + "<html><head><title>About SimTube - movies for the SIM95 network</title>" + NL
    t = t + "<meta name=""description"" content=""SimTube is a free movie site for the SIM95 network: watch, upload, rate and comment on SimMovies, and play them in SimPlayer, the streaming movie player for SIM95."">" + NL
    t = t + "<meta name=""keywords"" content=""video, videos, movies, movie, streaming, streaming video, player, media player, realplayer, windows media player, upload, watch, broadcast, tv, television, cartoons, animation, funny, dancing baby, all your base, simtube, simplayer, smv"">" + NL
    t = t + "</head>" + NL
    t = t + "<body bgcolor=""#FFFFFF"">" + NL
    t = t + "<table width=""100%"" cellpadding=""6"" cellspacing=""0""><tr><td><font size=""6""><b>Sim</b></font><font size=""6""><b><font color=""#CC0000"">[</font>Tube<font color=""#CC0000"">]</font></b></font><br><font size=""1"" color=""#808080"">Your 16-colour television</font></td></tr></table>" + NL
    t = t + "<table width=""100%"" cellpadding=""0"" cellspacing=""0""><tr><td bgcolor=""#CC0000""><font size=""1"">&nbsp;</font></td></tr></table>" + NL
    t = t + "<h2><font color=""#CC0000"">About SimTube</font></h2>" + NL
    t = t + "<p><b>SimTube is the movie site for the SIM95 network.</b> Watch the latest cartoons," + NL
    t = t + "put up your own, give them stars and say what you think. It is free and anyone can join.</p>" + NL
    t = t + "" + NL
    t = t + "<h3>Watching</h3>" + NL
    t = t + "<p>SimTube movies play in <b>SimPlayer</b>, the movie player for SIM95 (<tt>C:\PROGRAMS\PLAYER.SPK</tt>)." + NL
    t = t + "Each movie's page has its address, like <tt>http://<i>machine</i>/tube/movie.asp?v=1</tt>." + NL
    t = t + "Paste it into SimPlayer's Address box and press Enter. SimPlayer shows <i>Buffering...</i>" + NL
    t = t + "while the first part arrives, then starts playing while the rest download. It has Play/Pause," + NL
    t = t + "Stop, Rewind, a frame at a time (the &lt; and &gt; buttons), a seek bar you can click or drag," + NL
    t = t + "Loop, and Mute (yes, SimMovies beep).</p>" + NL
    t = t + "<p>No SimPlayer on your machine? <a href=""getplay.asp"">Get SimPlayer</a> and save it as" + NL
    t = t + "<tt>C:\PROGRAMS\PLAYER.SPK</tt>.</p>" + NL
    t = t + "" + NL
    t = t + "<h3>Making a movie</h3>" + NL
    t = t + "<p>A SimMovie (<tt>.SMV</tt>) is a text file you can write in Notes or make with a SPARK" + NL
    t = t + "program. It starts with a header, then a line holding just a full stop, then one line for" + NL
    t = t + "each frame:</p>" + NL
    t = t + "<pre>SIMMOVIE 1" + NL
    t = t + "title=Ball" + NL
    t = t + "author=ann" + NL
    t = t + "width=160" + NL
    t = t + "height=120" + NL
    t = t + "fps=10" + NL
    t = t + "frames=3" + NL
    t = t + "bg=0" + NL
    t = t + "thumb=1" + NL
    t = t + "." + NL
    t = t + "*C12;D20,60,10" + NL
    t = t + "C0;F10,50,21,21;C12;D30,60,10" + NL
    t = t + "C0;F20,50,21,21;C12;D40,60,10;S440,50</pre>" + NL
    t = t + "<p>Header: <tt>title</tt>, <tt>author</tt>, <tt>width</tt> and <tt>height</tt> (up to 320 by 240)," + NL
    t = t + "<tt>fps</tt> (frames a second, 1 to 30), <tt>frames</tt>, <tt>bg</tt> (the background colour)," + NL
    t = t + "<tt>thumb</tt> (which frame is the movie's picture; the first, if not given) and <tt>about</tt>.</p>" + NL
    t = t + "<p>A frame is drawing commands separated by semicolons. A frame that starts with" + NL
    t = t + "<tt>*</tt> is a <b>keyframe</b>: it starts from a blank screen, and SimPlayer can jump" + NL
    t = t + "straight to it. Any other frame draws over the one before, so only what moves need be drawn" + NL
    t = t + "again. A frame of just <tt>-</tt> changes nothing.</p>" + NL
    t = t + "<table border=""1"" cellpadding=""3"" cellspacing=""0"">" + NL
    t = t + "<tr><td><tt>C</tt><i>n</i></td><td>drawing colour, 0 to 15</td></tr>" + NL
    t = t + "<tr><td><tt>B</tt><i>n</i></td><td>background colour (for <tt>X</tt>)</td></tr>" + NL
    t = t + "<tr><td><tt>X</tt></td><td>clear the screen</td></tr>" + NL
    t = t + "<tr><td><tt>F</tt><i>x,y,w,h</i></td><td>filled box</td></tr>" + NL
    t = t + "<tr><td><tt>R</tt><i>x,y,w,h</i></td><td>box</td></tr>" + NL
    t = t + "<tr><td><tt>D</tt><i>x,y,r</i></td><td>filled circle</td></tr>" + NL
    t = t + "<tr><td><tt>O</tt><i>x,y,r</i></td><td>circle</td></tr>" + NL
    t = t + "<tr><td><tt>L</tt><i>x1,y1,x2,y2,...</i></td><td>lines joining the points</td></tr>" + NL
    t = t + "<tr><td><tt>P</tt><i>x1,y1,x2,y2,...</i></td><td>polygon</td></tr>" + NL
    t = t + "<tr><td><tt>Q</tt><i>x1,y1,x2,y2,...</i></td><td>filled polygon</td></tr>" + NL
    t = t + "<tr><td><tt>T</tt><i>x,y,words</i></td><td>text (no semicolons in it)</td></tr>" + NL
    t = t + "<tr><td><tt>I</tt><i>x,y,name</i></td><td>a picture</td></tr>" + NL
    t = t + "<tr><td><tt>S</tt><i>freq,ms</i></td><td>a beep (unless SimPlayer is muted)</td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "<p>A picture is defined on a line of its own, before it is used, with the rows of a" + NL
    t = t + "Sketch <tt>.PIC</tt> joined by <tt>|</tt>: <tt>!ball|SIM95PIC 4 2|0CC0|C00C</tt>." + NL
    t = t + "Colours: 0 black, 1 maroon, 2 green, 3 olive, 4 navy, 5 purple, 6 teal, 7 silver, 8 gray," + NL
    t = t + "9 red, 10 lime, 11 yellow, 12 blue, 13 magenta, 14 cyan, 15 white.</p>" + NL
    t = t + "" + NL
    t = t + "<h3>Long movies</h3>" + NL
    t = t + "<p>Everything on the SIM95 network travels in messages of up to 64K, so SimTube cuts every" + NL
    t = t + "movie into parts of 15K. <tt>movie.asp?v=1</tt> answers with a <b>manifest</b>" + NL
    t = t + "(<tt>video/x-simmovie</tt>) that lists them:</p>" + NL
    t = t + "<pre>SIMMOVIE-PARTS 1" + NL
    t = t + "title=Dancing Baby" + NL
    t = t + "width=160" + NL
    t = t + "height=120" + NL
    t = t + "fps=10" + NL
    t = t + "frames=240" + NL
    t = t + "parts=4" + NL
    t = t + "part=movie.asp?v=2&amp;p=1" + NL
    t = t + "part=movie.asp?v=2&amp;p=2" + NL
    t = t + "...</pre>" + NL
    t = t + "<p>An upload can be up to 60K. Put a longer movie up in pieces: upload the start, then" + NL
    t = t + "send the rest with <b>Add More Frames</b> on its page. You can do the same on your own disk:" + NL
    t = t + "SimPlayer opens a manifest file and its parts from the same folder.</p>" + NL
    t = t + "" + NL
    t = t + "<p><a href=""index.asp""><b>Go to SimTube</b></a></p>" + NL
    t = t + "<hr><center><font size=""1"" color=""#808080"">SimTube: movies, cartoons and streaming video for SIM95.</font></center>" + NL
    t = t + "</body></html>" + NL
    Put("C:\WEB\SIMTUBE.HTM")
END SUB

SUB File9 ()
    t = ""
    t = t + "<%@ import file=""TUBE.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' THUMB.ASP?v=N - a movie's picture, a SIM95PIC drawn from one of its frames when it went up." + NL
    t = t + "VAR line AS String" + NL
    t = t + "RESPONSE.Clear()" + NL
    t = t + "line = FindVideo(REQUEST.Query(""v""))" + NL
    t = t + "IF line = """" THEN" + NL
    t = t + "    RESPONSE.Status = ""404 Not Found""" + NL
    t = t + "    RESPONSE.End()" + NL
    t = t + "END IF" + NL
    t = t + "RESPONSE.ContentType = ""image/x-sim95pic""" + NL
    t = t + "RESPONSE.Write(ReadOr(DATADIR + ""\MOVIES\"" + VF(line, 0) + ""\THUMB.PIC"", """"))" + NL
    t = t + "RESPONSE.End()" + NL
    t = t + "%>" + NL
    Put("C:\WEB\THUMB.ASP")
END SUB

SUB File10 ()
    t = ""
    t = t + "<%@ import file=""TUBE.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' TOP.ASP - Most Viewed: the movies watched most, most first." + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR n AS Integer" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Most Viewed"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= BoxTop(""Most Viewed"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""4"" cellspacing=""0"">" + NL
    t = t + "<% FOR EACH line IN MostViewed(TOPSHOWN)" + NL
    t = t + "     n = n + 1 %>" + NL
    t = t + "<tr><td width=""24"" valign=""top""><font size=""4"" color=""#CC0000""><b><%= n %></b></font></td>" + NL
    t = t + "<td width=""90"" valign=""top""><%= Thumb(VF(line, 0)) %></td>" + NL
    t = t + "<td valign=""top""><font size=""2""><a href=""watch.asp?v=<%= VF(line, 0) %>""><b><%= H(VTitle(line)) %></b></a><br>" + NL
    t = t + "<%= Plural(Views(VF(line, 0)), ""view"", ""views"") %> &middot; <%= RunTime(line) %> &middot; <%= Stars(Rating(VF(line, 0))) %><br>" + NL
    t = t + "From: <%= H(NameOf(VF(line, 1))) %></font></td></tr>" + NL
    t = t + "<% NEXT %>" + NL
    t = t + "<% IF n = 0 THEN %><tr><td><font size=""2"" color=""#808080"">Nothing has been watched yet.</font></td></tr><% END IF %>" + NL
    t = t + "</table>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\TOP.ASP")
END SUB

SUB File11 ()
    t = ""
    t = t + "' TUBE.SPK - SimTube, the movie site for SIM95. Every page pulls this in with" + NL
    t = t + "' <%@ import file=""TUBE.SPK"" %>." + NL
    t = t + "'" + NL
    t = t + "' Movies are SimMovies (.SMV): text, a header and then one line of canvas" + NL
    t = t + "' drawing commands per frame (see README.md). Voyager can't play them; the" + NL
    t = t + "' watch page gives the movie's address to open in SimPlayer" + NL
    t = t + "' (C:\PROGRAMS\PLAYER.SPK). That address, movie.asp?v=N, answers with a" + NL
    t = t + "' manifest (Content-Type video/x-simmovie) naming the parts, and" + NL
    t = t + "' movie.asp?v=N&p=K with part K: each part is under 15K, so it fits in one" + NL
    t = t + "' network message with plenty to spare." + NL
    t = t + "'" + NL
    t = t + "' Everything lives in plain text files under C:\TUBEDATA, outside C:\WEB:" + NL
    t = t + "'" + NL
    t = t + "'   C:\TUBEDATA\VIDEOS.TXT           one line per movie (see below)" + NL
    t = t + "'   C:\TUBEDATA\MOVIES\<id>\<n>.SMV  the parts of a movie; THUMB.PIC its picture" + NL
    t = t + "'   C:\TUBEDATA\VIEWS\<id>.TXT       how many times it has been watched" + NL
    t = t + "'   C:\TUBEDATA\RATINGS\<id>.TXT     |ann=5|bob=3|  one rating each, 1 to 5 stars" + NL
    t = t + "'   C:\TUBEDATA\COMMENTS\<id>.TXT    date time|user|text, oldest first" + NL
    t = t + "'   C:\TUBEDATA\USERS\<user>.TXT     an account, key=value per line" + NL
    t = t + "'   C:\TUBEDATA\SESSIONS\<id>.TXT    who a sign-in cookie belongs to, and its form token" + NL
    t = t + "'   C:\TUBEDATA\NEXTID.TXT           the last movie number handed out" + NL
    t = t + "'   C:\TUBEDATA\SEED\*.SMV           sample movies from the installer, put on" + NL
    t = t + "'                                    the shelf by the first visit to the front page" + NL
    t = t + "'" + NL
    t = t + "' A movie's line: id|owner|title|date|frames|fps|width|height|parts|chars|about|author|bg" + NL
    t = t + "' Text is escaped with Esc so it never holds | or a line break." + NL
    t = t + "'" + NL
    t = t + "' Server pages are stopped after about ten million steps and must send less" + NL
    t = t + "' than 64K, so lists stop after a screenful and the work done for a movie" + NL
    t = t + "' (cutting it into parts and drawing its thumbnail) happens once, on upload." + NL
    t = t + "" + NL
    t = t + "CONST DATADIR = ""C:\TUBEDATA""" + NL
    t = t + "CONST COOKIE = ""simtube""" + NL
    t = t + "CONST MIME = ""video/x-simmovie""" + NL
    t = t + "CONST PARTSIZE = 15000       ' characters to a part; Vapor cuts its games the same" + NL
    t = t + "CONST MAXUPLOAD = 60000      ' a whole request must fit in one 64K message" + NL
    t = t + "CONST MAXTITLE = 60" + NL
    t = t + "CONST MAXABOUT = 500" + NL
    t = t + "CONST MAXCOMMENT = 500" + NL
    t = t + "CONST MAXNAME = 40" + NL
    t = t + "CONST GRIDSIZE = 12              ' movies on the front page" + NL
    t = t + "CONST TOPSHOWN = 20          ' on the Most Viewed page" + NL
    t = t + "CONST COMMENTSHOWN = 30" + NL
    t = t + "CONST COMMENTROOM = 24000    ' how much of a page the comments may take" + NL
    t = t + "CONST THUMBW = 80" + NL
    t = t + "" + NL
    t = t + "VAR viewer AS String          ' who is signed in; """" for nobody" + NL
    t = t + "VAR formToken AS String" + NL
    t = t + "VAR lastId AS String          ' the movie ImportMovie made" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the disk" + NL
    t = t + "" + NL
    t = t + "SUB EnsureDisk ()" + NL
    t = t + "    VAR dir AS String" + NL
    t = t + "    VAR dirs AS Array OF String" + NL
    t = t + "    dirs = ["""", ""\USERS"", ""\SESSIONS"", ""\MOVIES"", ""\VIEWS"", ""\RATINGS"", ""\COMMENTS"", ""\SEED""]" + NL
    t = t + "    FOR EACH dir IN dirs" + NL
    t = t + "        IF NOT FS.Exists(DATADIR + dir) THEN FS.MakeDir(DATADIR + dir)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION ReadOr (path AS String, fallback AS String) AS String" + NL
    t = t + "    IF FS.Exists(path) THEN RETURN FS.Read(path)" + NL
    t = t + "    RETURN fallback" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Esc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%"", ""%25"").Replace(""|"", ""%7C"").Replace(Chr(13), """").Replace(Chr(10), ""%0A"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Unesc (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(""%0A"", Chr(10)).Replace(""%7C"", ""|"").Replace(""%25"", ""%"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION H (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.HtmlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Br (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.HtmlEncode(s).Replace(Chr(10), ""<br>"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UrlEnc (s AS String) AS String" + NL
    t = t + "    RETURN SERVER.UrlEncode(s)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION OnlyFrom (s AS String, allowed AS String) AS Bool" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        IF NOT allowed.Contains(s.CharAt(i)) THEN RETURN FALSE" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN TRUE" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsNumber (s AS String) AS Bool" + NL
    t = t + "    IF s = """" OR s.Length > 8 THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyFrom(s, ""0123456789"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION ValidName (u AS String) AS Bool" + NL
    t = t + "    IF u.Length < 3 OR u.Length > 8 THEN RETURN FALSE" + NL
    t = t + "    RETURN OnlyFrom(u, ""abcdefghijklmnopqrstuvwxyz0123456789"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CleanName (u AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = u.Trim().Lower()" + NL
    t = t + "    IF ValidName(s) THEN RETURN s" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Clip (s AS String, most AS Integer) AS String" + NL
    t = t + "    s = s.Replace(Chr(13), """").Trim()" + NL
    t = t + "    IF s.Length > most THEN s = s.Substring(0, most)" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION OneLine (s AS String) AS String" + NL
    t = t + "    RETURN s.Replace(Chr(13), "" "").Replace(Chr(10), "" "")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Clamp (n AS Integer, lo AS Integer, hi AS Integer) AS Integer" + NL
    t = t + "    IF n < lo THEN RETURN lo" + NL
    t = t + "    IF n > hi THEN RETURN hi" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Stamp () AS String" + NL
    t = t + "    RETURN TIME.Date + "" "" + TIME.Clock.Substring(0, 5)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where this page is: C:\WEB, or C:\WEB\TUBE when SimTube has a folder of its own." + NL
    t = t + "FUNCTION AppDir () AS String" + NL
    t = t + "    VAR page AS String" + NL
    t = t + "    page = SERVER.ScriptName" + NL
    t = t + "    RETURN page.Substring(0, page.Length - page.Split(""\"")[page.Split(""\"").Count - 1].Length - 1)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Where SimTube is on the web: http://host/ or http://host/tube/" + NL
    t = t + "FUNCTION SiteUrl () AS String" + NL
    t = t + "    IF AppDir().Upper() = ""C:\WEB"" THEN RETURN ""http://"" + SERVER.Name.Lower() + ""/""" + NL
    t = t + "    RETURN ""http://"" + SERVER.Name.Lower() + ""/"" + AppDir().Substring(7, AppDir().Length - 7).Replace(""\"", ""/"").Lower() + ""/""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The address SimPlayer opens." + NL
    t = t + "FUNCTION MovieUrl (id AS String) AS String" + NL
    t = t + "    RETURN SiteUrl() + ""movie.asp?v="" + id" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- accounts" + NL
    t = t + "' The same as SimBook's: a salted hash, never the password; a session file" + NL
    t = t + "' named by the cookie; a form token on everything that changes something." + NL
    t = t + "" + NL
    t = t + "FUNCTION UserPath (u AS String) AS String" + NL
    t = t + "    RETURN DATADIR + ""\USERS\"" + u + "".TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION UserExists (u AS String) AS Bool" + NL
    t = t + "    IF NOT ValidName(u) THEN RETURN FALSE" + NL
    t = t + "    RETURN FS.Exists(UserPath(u))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION LoadUser (u AS String) AS Array OF String" + NL
    t = t + "    RETURN FS.Read(UserPath(u)).Lines()" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SaveUser (u AS String, rec AS Array OF String)" + NL
    t = t + "    FS.Write(UserPath(u), rec.Join(Chr(10)))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Field (rec AS Array OF String, name AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN rec" + NL
    t = t + "        IF line.StartsWith(name + ""="") THEN RETURN Unesc(line.Substring(name.Length + 1, line.Length - name.Length - 1))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SetField (rec AS Array OF String, name AS String, value AS String)" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO rec.Count - 1" + NL
    t = t + "        IF rec[i].StartsWith(name + ""="") THEN" + NL
    t = t + "            rec[i] = name + ""="" + Esc(value)" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    rec.Add(name + ""="" + Esc(value))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' What a member is called. The sample movies belong to SimTube itself." + NL
    t = t + "FUNCTION NameOf (u AS String) AS String" + NL
    t = t + "    IF u = ""simtube"" THEN RETURN ""SimTube""" + NL
    t = t + "    IF NOT UserExists(u) THEN RETURN u" + NL
    t = t + "    RETURN Field(LoadUser(u), ""name"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Not real cryptography - SIM95 has none - but the password itself never" + NL
    t = t + "' touches the disk." + NL
    t = t + "FUNCTION Hash (salt AS String, pw AS String) AS String" + NL
    t = t + "    VAR a AS Integer = 7" + NL
    t = t + "    VAR b AS Integer = 31337" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = salt + "":"" + pw + "":"" + salt" + NL
    t = t + "    FOR i = 0 TO s.Length - 1" + NL
    t = t + "        c = Asc(s.CharAt(i))" + NL
    t = t + "        a = (a * 131 + c) MOD 2147483629" + NL
    t = t + "        b = (b * 257 + c + a) MOD 2147483587" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN Hex(a) + ""-"" + Hex(b)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION NewToken () AS String" + NL
    t = t + "    RETURN Hex(268435456 + Rnd(1879048191))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CreateUser (u AS String, pw AS String, name AS String) AS String" + NL
    t = t + "    VAR rec AS Array OF String" + NL
    t = t + "    VAR salt AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    IF NOT ValidName(u) THEN RETURN ""Pick a user name of 3 to 8 letters or digits.""" + NL
    t = t + "    IF u = ""simtube"" OR FS.Exists(UserPath(u)) THEN RETURN ""Somebody already has the name "" + u + "".""" + NL
    t = t + "    IF pw.Length < 4 THEN RETURN ""Pick a password of at least 4 characters.""" + NL
    t = t + "    name = OneLine(Clip(name, MAXNAME))" + NL
    t = t + "    IF name = """" THEN RETURN ""Tell us your name.""" + NL
    t = t + "    salt = NewToken()" + NL
    t = t + "    SetField(rec, ""name"", name)" + NL
    t = t + "    SetField(rec, ""salt"", salt)" + NL
    t = t + "    SetField(rec, ""pass"", Hash(salt, pw))" + NL
    t = t + "    SetField(rec, ""joined"", TIME.Date)" + NL
    t = t + "    SaveUser(u, rec)" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION CheckPassword (u AS String, pw AS String) AS Bool" + NL
    t = t + "    VAR rec AS Array OF String" + NL
    t = t + "    IF NOT UserExists(u) THEN RETURN FALSE" + NL
    t = t + "    rec = LoadUser(u)" + NL
    t = t + "    RETURN Hash(Field(rec, ""salt""), pw) = Field(rec, ""pass"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SignIn (u AS String)" + NL
    t = t + "    VAR token AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    token = NewToken()" + NL
    t = t + "    FS.Write(DATADIR + ""\SESSIONS\"" + token + "".TXT"", u + Chr(10) + NewToken() + NewToken())" + NL
    t = t + "    RESPONSE.SetCookie(COOKIE, token)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION SessionPath () AS String" + NL
    t = t + "    VAR token AS String" + NL
    t = t + "    token = REQUEST.Cookie(COOKIE)" + NL
    t = t + "    IF token = """" OR token.Length > 8 THEN RETURN """"" + NL
    t = t + "    IF NOT OnlyFrom(token, ""0123456789ABCDEF"") THEN RETURN """"" + NL
    t = t + "    RETURN DATADIR + ""\SESSIONS\"" + token + "".TXT""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB SignOut ()" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    path = SessionPath()" + NL
    t = t + "    IF path <> """" THEN" + NL
    t = t + "        IF FS.Exists(path) THEN FS.Delete(path)" + NL
    t = t + "    END IF" + NL
    t = t + "    RESPONSE.SetCookie(COOKIE, """")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Who the cookie says is signed in, or """". Also sets formToken." + NL
    t = t + "FUNCTION CurrentUser () AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR u AS String" + NL
    t = t + "    path = SessionPath()" + NL
    t = t + "    IF path = """" THEN RETURN """"" + NL
    t = t + "    IF NOT FS.Exists(path) THEN RETURN """"" + NL
    t = t + "    lines = FS.Read(path).Lines()" + NL
    t = t + "    IF lines.Count < 2 THEN RETURN """"" + NL
    t = t + "    u = lines[0].Trim()" + NL
    t = t + "    IF NOT UserExists(u) THEN RETURN """"" + NL
    t = t + "    formToken = lines[1].Trim()" + NL
    t = t + "    RETURN u" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB RequireLogin ()" + NL
    t = t + "    viewer = CurrentUser()" + NL
    t = t + "    IF viewer = """" THEN RESPONSE.Redirect(""index.asp?e=login"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Voyager sends SimTube's cookie with a form on any site, so the cookie alone" + NL
    t = t + "' proves nothing: every form carries the session's token too." + NL
    t = t + "SUB RequireToken ()" + NL
    t = t + "    VAR sent AS String" + NL
    t = t + "    sent = REQUEST.Form(""t"")" + NL
    t = t + "    IF sent = """" THEN sent = REQUEST.Query(""t"")" + NL
    t = t + "    IF sent = """" OR sent <> formToken THEN RESPONSE.Redirect(""index.asp?e=token"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION TokenField () AS String" + NL
    t = t + "    RETURN ""<input type=""""hidden"""" name=""""t"""" value="""""" + formToken + """""">""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION TokenArg () AS String" + NL
    t = t + "    RETURN ""t="" + formToken" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Counter (name AS String) AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    n = Int(Val(ReadOr(DATADIR + ""\"" + name + "".TXT"", ""0""))) + 1" + NL
    t = t + "    FS.Write(DATADIR + ""\"" + name + "".TXT"", Str(n))" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- the movies" + NL
    t = t + "" + NL
    t = t + "FUNCTION AllVideos () AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\VIDEOS.TXT"", """").Lines()" + NL
    t = t + "        IF line.Split(""|"").Count >= 13 THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The line of movie id, or """"." + NL
    t = t + "FUNCTION FindVideo (id AS String) AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    IF NOT IsNumber(id) THEN RETURN """"" + NL
    t = t + "    text = Chr(10) + ReadOr(DATADIR + ""\VIDEOS.TXT"", """")" + NL
    t = t + "    at = text.IndexOf(Chr(10) + id + ""|"")" + NL
    t = t + "    IF at < 0 THEN RETURN """"" + NL
    t = t + "    text = text.Substring(at + 1, text.Length - at - 1)" + NL
    t = t + "    IF text.IndexOf(Chr(10)) >= 0 THEN text = text.Substring(0, text.IndexOf(Chr(10)))" + NL
    t = t + "    RETURN text" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION VF (line AS String, i AS Integer) AS String" + NL
    t = t + "    RETURN line.Split(""|"")[i]" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION VTitle (line AS String) AS String" + NL
    t = t + "    RETURN Unesc(VF(line, 2))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A movie's line, changed (more frames came)." + NL
    t = t + "SUB ReplaceVideo (old AS String, line AS String)" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    text = (Chr(10) + ReadOr(DATADIR + ""\VIDEOS.TXT"", """")).Replace(Chr(10) + old + Chr(10), Chr(10) + line + Chr(10))" + NL
    t = t + "    FS.Write(DATADIR + ""\VIDEOS.TXT"", text.Substring(1, text.Length - 1))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Views (id AS String) AS Integer" + NL
    t = t + "    RETURN Int(Val(ReadOr(DATADIR + ""\VIEWS\"" + id + "".TXT"", ""0"")))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB AddView (id AS String)" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    FS.Write(DATADIR + ""\VIEWS\"" + id + "".TXT"", Str(Views(id) + 1))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' How long a movie runs, as m:ss." + NL
    t = t + "FUNCTION RunTime (line AS String) AS String" + NL
    t = t + "    VAR s AS Integer" + NL
    t = t + "    s = Int(Val(VF(line, 4)) / MATH.Max(1, Val(VF(line, 5))))" + NL
    t = t + "    RETURN Str(Int(s / 60)) + "":"" + Str(100 + s MOD 60).Substring(1, 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Plural (n AS Integer, one AS String, many AS String) AS String" + NL
    t = t + "    IF n = 1 THEN RETURN ""1 "" + one" + NL
    t = t + "    RETURN Str(n) + "" "" + many" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- ratings" + NL
    t = t + "" + NL
    t = t + "FUNCTION RatingsOf (id AS String) AS String" + NL
    t = t + "    RETURN ReadOr(DATADIR + ""\RATINGS\"" + id + "".TXT"", ""|"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The average, times ten (so 4.5 stars is 45); 0 for none." + NL
    t = t + "FUNCTION Rating (id AS String) AS Integer" + NL
    t = t + "    VAR r AS String" + NL
    t = t + "    VAR sum AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    FOR EACH r IN RatingsOf(id).Split(""|"")" + NL
    t = t + "        IF r.Contains(""="") THEN" + NL
    t = t + "            sum = sum + Int(Val(r.Split(""="")[1]))" + NL
    t = t + "            n = n + 1" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF n = 0 THEN RETURN 0" + NL
    t = t + "    RETURN MATH.Round(sum * 10 / n)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION RatingCount (id AS String) AS Integer" + NL
    t = t + "    RETURN RatingsOf(id).Split(""="").Count - 1" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION MyRating (id AS String, u AS String) AS Integer" + NL
    t = t + "    VAR r AS String" + NL
    t = t + "    FOR EACH r IN RatingsOf(id).Split(""|"")" + NL
    t = t + "        IF r.StartsWith(u + ""="") THEN RETURN Int(Val(r.Split(""="")[1]))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One rating each; rating again changes it." + NL
    t = t + "SUB Rate (id AS String, u AS String, stars AS Integer)" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR r AS String" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    out = ""|""" + NL
    t = t + "    FOR EACH r IN RatingsOf(id).Split(""|"")" + NL
    t = t + "        IF r <> """" AND NOT r.StartsWith(u + ""="") THEN out = out + r + ""|""" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Write(DATADIR + ""\RATINGS\"" + id + "".TXT"", out + u + ""="" + Str(Clamp(stars, 1, 5)) + ""|"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Five stars, filled in gold as far as the rating goes." + NL
    t = t + "FUNCTION Stars (r AS Integer) AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    n = Int((r + 5) / 10)" + NL
    t = t + "    s = ""<font color=""""#FFB400""""><b>"" + ""*****"".Substring(0, n) + ""</b></font><font color=""""#C0C0C0""""><b>"" + ""*****"".Substring(0, 5 - n) + ""</b></font>""" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- comments" + NL
    t = t + "" + NL
    t = t + "FUNCTION Comments (id AS String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN ReadOr(DATADIR + ""\COMMENTS\"" + id + "".TXT"", """").Lines()" + NL
    t = t + "        IF line.Split(""|"").Count >= 3 THEN out.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION AddComment (id AS String, u AS String, text AS String) AS String" + NL
    t = t + "    text = text.Replace(Chr(13), """").Trim()" + NL
    t = t + "    IF text = """" THEN RETURN ""Write something first.""" + NL
    t = t + "    IF text.Length > MAXCOMMENT THEN RETURN ""Keep comments under "" + Str(MAXCOMMENT) + "" characters.""" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    FS.Append(DATADIR + ""\COMMENTS\"" + id + "".TXT"", Stamp() + ""|"" + u + ""|"" + Esc(text) + Chr(10))" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The newest comments, as many as fit, newest first." + NL
    t = t + "FUNCTION CommentsHtml (all AS Array OF String) AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR shown AS Integer" + NL
    t = t + "    IF all.Count = 0 THEN RETURN ""<tr><td><font size=""""2"""" color=""""#808080"""">No comments yet. Be the first!</font></td></tr>""" + NL
    t = t + "    FOR i = all.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF shown >= COMMENTSHOWN OR out.Length > COMMENTROOM THEN BREAK" + NL
    t = t + "        p = all[i].Split(""|"")" + NL
    t = t + "        out = out + ""<tr><td bgcolor=""""#EEEEEE""""><font size=""""2""""><b>"" + H(NameOf(p[1])) + ""</b> <font color=""""#808080"""">"" + H(p[0]) + ""</font><br>"" + Br(Unesc(p[2])) + ""</font></td></tr>""" + NL
    t = t + "        shown = shown + 1" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF shown < all.Count THEN out = out + ""<tr><td><font size=""""1"""" color=""""#808080"""">The newest "" + Str(shown) + "" of "" + Str(all.Count) + "" comments.</font></td></tr>""" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- reading a movie" + NL
    t = t + "" + NL
    t = t + "' The header of a SimMovie: its lines up to the ""."" that ends it, or an" + NL
    t = t + "' empty list when it is not one." + NL
    t = t + "FUNCTION HeadOf (lines AS Array OF String) AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN out" + NL
    t = t + "    IF NOT lines[0].StartsWith(""SIMMOVIE 1"") THEN RETURN out" + NL
    t = t + "    FOR i = 1 TO MATH.Min(lines.Count - 1, 40)" + NL
    t = t + "        IF lines[i] = ""."" THEN" + NL
    t = t + "            out.Add(""."")" + NL
    t = t + "            RETURN out" + NL
    t = t + "        END IF" + NL
    t = t + "        out.Add(lines[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    out.Clear()" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Meta (head AS Array OF String, name AS String) AS String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    FOR EACH line IN head" + NL
    t = t + "        IF line.StartsWith(name + ""="") THEN RETURN line.Substring(name.Length + 1, line.Length - name.Length - 1)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' What is wrong with a movie, or """". head is its header (HeadOf)." + NL
    t = t + "FUNCTION CheckMovie (lines AS Array OF String, head AS Array OF String) AS String" + NL
    t = t + "    VAR w AS Integer" + NL
    t = t + "    VAR ht AS Integer" + NL
    t = t + "    VAR fps AS Integer" + NL
    t = t + "    IF head.Count = 0 THEN RETURN ""That is not a SimMovie. A SimMovie starts with the line SIMMOVIE 1, and its header ends with a line holding just a full stop.""" + NL
    t = t + "    w = Int(Val(Meta(head, ""width"")))" + NL
    t = t + "    ht = Int(Val(Meta(head, ""height"")))" + NL
    t = t + "    fps = Int(Val(Meta(head, ""fps"")))" + NL
    t = t + "    IF w < 16 OR w > 320 OR ht < 16 OR ht > 240 THEN RETURN ""A SimMovie is from 16x16 to 320x240. This one says "" + Str(w) + ""x"" + Str(ht) + "".""" + NL
    t = t + "    IF fps < 1 OR fps > 30 THEN RETURN ""A SimMovie plays at 1 to 30 frames a second. This one says "" + Str(fps) + "".""" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION IsFrame (line AS String) AS Bool" + NL
    t = t + "    RETURN line <> """" AND NOT line.StartsWith(""!"") AND NOT line.StartsWith(""'"")" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- putting a movie up" + NL
    t = t + "" + NL
    t = t + "' Takes an uploaded (or sample) movie: cuts it into parts, draws its" + NL
    t = t + "' thumbnail, and puts it on the shelf. Returns """" (and sets lastId) or what is wrong." + NL
    t = t + "FUNCTION ImportMovie (owner AS String, text AS String, title AS String, about AS String) AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR head AS Array OF String" + NL
    t = t + "    VAR body AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    VAR problem AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR parts AS Integer" + NL
    t = t + "    text = text.Replace(Chr(13), """")" + NL
    t = t + "    IF text.Length > MAXUPLOAD THEN RETURN ""That movie is too big for one upload ("" + Str(Int(text.Length / 1024)) + ""K). Upload the first "" + Str(MAXUPLOAD / 1000) + ""K, then add the rest with Add More Frames.""" + NL
    t = t + "    lines = text.Lines()" + NL
    t = t + "    head = HeadOf(lines)" + NL
    t = t + "    problem = CheckMovie(lines, head)" + NL
    t = t + "    IF problem <> """" THEN RETURN problem" + NL
    t = t + "    FOR i = head.Count + 1 TO lines.Count - 1" + NL
    t = t + "        line = lines[i]" + NL
    t = t + "        IF line.Length > PARTSIZE - 200 THEN RETURN ""Line "" + Str(i + 1) + "" is too long: keep each frame and picture under "" + Str(PARTSIZE - 200) + "" characters.""" + NL
    t = t + "        IF IsFrame(line) THEN n = n + 1" + NL
    t = t + "        IF line <> """" THEN body.Add(line)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF n = 0 THEN RETURN ""That movie has no frames.""" + NL
    t = t + "    title = OneLine(Clip(title, MAXTITLE))" + NL
    t = t + "    IF title = """" THEN title = OneLine(Clip(Meta(head, ""title""), MAXTITLE))" + NL
    t = t + "    IF title = """" THEN title = ""Untitled""" + NL
    t = t + "    about = Clip(about, MAXABOUT)" + NL
    t = t + "    IF about = """" THEN about = Clip(Meta(head, ""about""), MAXABOUT)" + NL
    t = t + "    EnsureDisk()" + NL
    t = t + "    id = Str(Counter(""NEXTID""))" + NL
    t = t + "    FS.MakeDir(DATADIR + ""\MOVIES\"" + id)" + NL
    t = t + "    ' the header SimPlayer reads first, with the real count of frames" + NL
    t = t + "    body.Insert(0, ""."")" + NL
    t = t + "    FOR i = head.Count - 2 TO 0 STEP -1" + NL
    t = t + "        IF NOT head[i].StartsWith(""title="") AND NOT head[i].StartsWith(""frames="") THEN body.Insert(0, head[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    body.Insert(0, ""frames="" + Str(n))" + NL
    t = t + "    body.Insert(0, ""title="" + title)" + NL
    t = t + "    body.Insert(0, ""SIMMOVIE 1"")" + NL
    t = t + "    parts = WriteParts(id, 0, """", body, 0)" + NL
    t = t + "    FS.Append(DATADIR + ""\VIDEOS.TXT"", id + ""|"" + owner + ""|"" + Esc(title) + ""|"" + TIME.Date + ""|"" + Str(n) + ""|"" + Meta(head, ""fps"") + ""|"" + Meta(head, ""width"") + ""|"" + Meta(head, ""height"") + ""|"" + Str(parts) + ""|"" + Str(text.Length) + ""|"" + Esc(about) + ""|"" + Esc(OneLine(Clip(Meta(head, ""author""), MAXNAME))) + ""|"" + Str(Clamp(Int(Val(Meta(head, ""bg""))), 0, 15)) + Chr(10))" + NL
    t = t + "    FS.Write(DATADIR + ""\MOVIES\"" + id + ""\THUMB.PIC"", Thumbnail(body, Int(Val(Meta(head, ""width""))), Int(Val(Meta(head, ""height""))), Clamp(Int(Val(Meta(head, ""bg""))), 0, 15), Int(Val(Meta(head, ""thumb"")))))" + NL
    t = t + "    lastId = id" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Writes lines into parts of at most PARTSIZE characters, starting with" + NL
    t = t + "' part done + 1, which begins with carry. start: the first line to write." + NL
    t = t + "' Returns how many parts there are now." + NL
    t = t + "FUNCTION WriteParts (id AS String, done AS Integer, carry AS String, lines AS Array OF String, start AS Integer) AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR cur AS String" + NL
    t = t + "    cur = carry" + NL
    t = t + "    FOR i = start TO lines.Count - 1" + NL
    t = t + "        IF cur.Length + lines[i].Length + 1 > PARTSIZE AND cur <> """" THEN" + NL
    t = t + "            done = done + 1" + NL
    t = t + "            FS.Write(DATADIR + ""\MOVIES\"" + id + ""\"" + Str(done) + "".SMV"", cur)" + NL
    t = t + "            cur = """"" + NL
    t = t + "        END IF" + NL
    t = t + "        cur = cur + lines[i] + Chr(10)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF cur <> """" THEN" + NL
    t = t + "        done = done + 1" + NL
    t = t + "        FS.Write(DATADIR + ""\MOVIES\"" + id + ""\"" + Str(done) + "".SMV"", cur)" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN done" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Add More Frames: a long movie goes up in pieces under 64K. A piece may start" + NL
    t = t + "' with the movie's header (it is skipped), or be just more frame lines." + NL
    t = t + "FUNCTION AppendMovie (line AS String, text AS String) AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR head AS Array OF String" + NL
    t = t + "    VAR body AS Array OF String" + NL
    t = t + "    VAR first AS Array OF String" + NL
    t = t + "    VAR p AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR parts AS Integer" + NL
    t = t + "    VAR last AS String" + NL
    t = t + "    VAR skip AS Integer" + NL
    t = t + "    text = text.Replace(Chr(13), """")" + NL
    t = t + "    IF text.Length > MAXUPLOAD THEN RETURN ""That piece is too big for one upload. Keep each piece under "" + Str(MAXUPLOAD / 1000) + ""K.""" + NL
    t = t + "    lines = text.Lines()" + NL
    t = t + "    head = HeadOf(lines)" + NL
    t = t + "    IF head.Count > 0 THEN" + NL
    t = t + "        IF Meta(head, ""width"") <> VF(line, 6) OR Meta(head, ""height"") <> VF(line, 7) THEN RETURN ""That piece is "" + Meta(head, ""width"") + ""x"" + Meta(head, ""height"") + ""; the movie is "" + VF(line, 6) + ""x"" + VF(line, 7) + "".""" + NL
    t = t + "    END IF" + NL
    t = t + "    skip = 0" + NL
    t = t + "    IF head.Count > 0 THEN skip = head.Count + 1" + NL
    t = t + "    FOR i = skip TO lines.Count - 1" + NL
    t = t + "        IF lines[i] = """" THEN CONTINUE" + NL
    t = t + "        IF lines[i].StartsWith(""SIMMOVIE"") THEN RETURN ""That piece has a header in the middle.""" + NL
    t = t + "        IF lines[i].Length > PARTSIZE - 200 THEN RETURN ""Line "" + Str(i + 1) + "" is too long: keep each frame and picture under "" + Str(PARTSIZE - 200) + "" characters.""" + NL
    t = t + "        IF IsFrame(lines[i]) THEN n = n + 1" + NL
    t = t + "        body.Add(lines[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF n = 0 THEN RETURN ""That piece has no frames in it.""" + NL
    t = t + "    id = VF(line, 0)" + NL
    t = t + "    parts = Int(Val(VF(line, 8)))" + NL
    t = t + "    last = ReadOr(DATADIR + ""\MOVIES\"" + id + ""\"" + Str(parts) + "".SMV"", """")" + NL
    t = t + "    parts = WriteParts(id, parts - 1, last, body, 0)" + NL
    t = t + "    n = n + Int(Val(VF(line, 4)))" + NL
    t = t + "    ' part 1's header says how many frames there are" + NL
    t = t + "    first = ReadOr(DATADIR + ""\MOVIES\"" + id + ""\1.SMV"", """").Lines()" + NL
    t = t + "    FOR i = 0 TO MATH.Min(first.Count - 1, 40)" + NL
    t = t + "        IF first[i] = ""."" THEN BREAK" + NL
    t = t + "        IF first[i].StartsWith(""frames="") THEN first[i] = ""frames="" + Str(n)" + NL
    t = t + "    NEXT" + NL
    t = t + "    FS.Write(DATADIR + ""\MOVIES\"" + id + ""\1.SMV"", first.Join(Chr(10)))" + NL
    t = t + "    p = line.Split(""|"")" + NL
    t = t + "    p[4] = Str(n)" + NL
    t = t + "    p[8] = Str(parts)" + NL
    t = t + "    p[9] = Str(Int(Val(p[9])) + text.Length)" + NL
    t = t + "    ReplaceVideo(line, p.Join(""|""))" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The manifest SimPlayer reads at movie.asp?v=N: what the movie is, and where its parts are." + NL
    t = t + "FUNCTION Manifest (line AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    id = VF(line, 0)" + NL
    t = t + "    s = ""SIMMOVIE-PARTS 1"" + Chr(10) _" + NL
    t = t + "      + ""title="" + VTitle(line) + Chr(10) _" + NL
    t = t + "      + ""author="" + Unesc(VF(line, 11)) + Chr(10) _" + NL
    t = t + "      + ""uploader="" + NameOf(VF(line, 1)) + Chr(10) _" + NL
    t = t + "      + ""width="" + VF(line, 6) + Chr(10) _" + NL
    t = t + "      + ""height="" + VF(line, 7) + Chr(10) _" + NL
    t = t + "      + ""fps="" + VF(line, 5) + Chr(10) _" + NL
    t = t + "      + ""frames="" + VF(line, 4) + Chr(10) _" + NL
    t = t + "      + ""bg="" + VF(line, 12) + Chr(10) _" + NL
    t = t + "      + ""parts="" + VF(line, 8) + Chr(10)" + NL
    t = t + "    FOR i = 1 TO Int(Val(VF(line, 8)))" + NL
    t = t + "        s = s + ""part=movie.asp?v="" + id + ""&p="" + Str(i) + Chr(10)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN s" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The installer leaves sample movies in C:\TUBEDATA\SEED. The first visit to" + NL
    t = t + "' the front page puts them on the shelf, once each (SEEDED.TXT remembers)." + NL
    t = t + "SUB Seed ()" + NL
    t = t + "    VAR f AS String" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    VAR done AS String" + NL
    t = t + "    IF NOT FS.Exists(DATADIR + ""\SEED"") THEN RETURN" + NL
    t = t + "    done = ReadOr(DATADIR + ""\SEEDED.TXT"", ""|"")" + NL
    t = t + "    FOR EACH f IN FS.List(DATADIR + ""\SEED"")" + NL
    t = t + "        IF f.EndsWith(""\"") OR NOT f.Upper().EndsWith("".SMV"") THEN CONTINUE" + NL
    t = t + "        IF NOT done.Contains(""|"" + f.Upper() + ""|"") THEN" + NL
    t = t + "            text = FS.Read(DATADIR + ""\SEED\"" + f)" + NL
    t = t + "            IF ImportMovie(""simtube"", text, """", """") = """" THEN" + NL
    t = t + "                done = done + f.Upper() + ""|""" + NL
    t = t + "                FS.Write(DATADIR + ""\SEEDED.TXT"", done)" + NL
    t = t + "            END IF" + NL
    t = t + "        END IF" + NL
    t = t + "        FS.Delete(DATADIR + ""\SEED\"" + f)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- thumbnails" + NL
    t = t + "' A movie's picture is one of its frames (thumb= in its header, or the first)," + NL
    t = t + "' drawn small into a .PIC the way SimPlayer would draw it on a canvas." + NL
    t = t + "" + NL
    t = t + "VAR px AS Array OF Integer" + NL
    t = t + "VAR tw AS Integer" + NL
    t = t + "VAR th AS Integer" + NL
    t = t + "VAR tk AS Real               ' thumbnail pixels to a movie pixel" + NL
    t = t + "VAR pen AS Integer" + NL
    t = t + "VAR paper AS Integer" + NL
    t = t + "VAR tBg AS Integer" + NL
    t = t + "VAR tPicNames AS Array OF String" + NL
    t = t + "VAR tPicData AS Array OF String" + NL
    t = t + "" + NL
    t = t + "FUNCTION Thumbnail (body AS Array OF String, w AS Integer, ht AS Integer, bg AS Integer, want AS Integer) AS String" + NL
    t = t + "    VAR frames AS Array OF Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR start AS Integer" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR row AS String" + NL
    t = t + "    VAR out AS String" + NL
    t = t + "    VAR digits AS String" + NL
    t = t + "    VAR past AS Bool" + NL
    t = t + "    digits = ""0123456789ABCDEF""" + NL
    t = t + "    tw = THUMBW" + NL
    t = t + "    tk = THUMBW / w" + NL
    t = t + "    th = Clamp(Int(ht * tk), 8, 80)" + NL
    t = t + "    tPicNames.Clear()" + NL
    t = t + "    tPicData.Clear()" + NL
    t = t + "    ' which lines are frames (after the header's "".""), and the pictures" + NL
    t = t + "    FOR i = 0 TO body.Count - 1" + NL
    t = t + "        IF NOT past THEN" + NL
    t = t + "            IF body[i] = ""."" THEN past = TRUE" + NL
    t = t + "        ELSEIF body[i].StartsWith(""!"") THEN" + NL
    t = t + "            IF body[i].IndexOf(""|"") > 1 THEN" + NL
    t = t + "                tPicNames.Add(body[i].Substring(1, body[i].IndexOf(""|"") - 1))" + NL
    t = t + "                tPicData.Add(body[i].Substring(body[i].IndexOf(""|"") + 1, body[i].Length - body[i].IndexOf(""|"") - 1))" + NL
    t = t + "            END IF" + NL
    t = t + "        ELSEIF IsFrame(body[i]) THEN" + NL
    t = t + "            frames.Add(i)" + NL
    t = t + "        END IF" + NL
    t = t + "    NEXT" + NL
    t = t + "    tBg = bg" + NL
    t = t + "    paper = bg" + NL
    t = t + "    pen = 0" + NL
    t = t + "    px.Clear()" + NL
    t = t + "    FOR i = 1 TO tw * th" + NL
    t = t + "        px.Add(bg)" + NL
    t = t + "    NEXT" + NL
    t = t + "    IF frames.Count > 0 THEN" + NL
    t = t + "        want = Clamp(want, 0, frames.Count - 1)" + NL
    t = t + "        start = want" + NL
    t = t + "        WHILE start > 0 AND NOT body[frames[start]].StartsWith(""*"")" + NL
    t = t + "            start = start - 1" + NL
    t = t + "        END WHILE" + NL
    t = t + "        FOR i = start TO want" + NL
    t = t + "            ThumbFrame(body[frames[i]])" + NL
    t = t + "        NEXT" + NL
    t = t + "    END IF" + NL
    t = t + "    out = ""SIM95PIC "" + Str(tw) + "" "" + Str(th)" + NL
    t = t + "    FOR y = 0 TO th - 1" + NL
    t = t + "        row = """"" + NL
    t = t + "        FOR x = 0 TO tw - 1" + NL
    t = t + "            row = row + digits.CharAt(px[y * tw + x])" + NL
    t = t + "        NEXT" + NL
    t = t + "        out = out + Chr(10) + row" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out + Chr(10)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB ThumbFrame (line AS String)" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    IF line.StartsWith(""*"") THEN" + NL
    t = t + "        paper = tBg" + NL
    t = t + "        ThumbClear()" + NL
    t = t + "        pen = 0" + NL
    t = t + "        line = line.Substring(1, line.Length - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF line = ""-"" OR line = """" THEN RETURN" + NL
    t = t + "    FOR EACH c IN line.Split("";"")" + NL
    t = t + "        IF c <> """" THEN ThumbCmd(c)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ThumbClear ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    FOR i = 0 TO px.Count - 1" + NL
    t = t + "        px[i] = paper" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION TNums (s AS String, most AS Integer) AS Array OF Integer" + NL
    t = t + "    VAR out AS Array OF Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    FOR EACH p IN s.Split("","")" + NL
    t = t + "        IF most > 0 AND out.Count >= most THEN BREAK" + NL
    t = t + "        out.Add(Int(Val(p.Trim())))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A box of thumbnail pixels, in movie coordinates." + NL
    t = t + "SUB TBox (x AS Integer, y AS Integer, w AS Integer, ht AS Integer)" + NL
    t = t + "    VAR x0 AS Integer" + NL
    t = t + "    VAR y0 AS Integer" + NL
    t = t + "    VAR x1 AS Integer" + NL
    t = t + "    VAR y1 AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    x0 = Clamp(Int(x * tk), 0, tw)" + NL
    t = t + "    y0 = Clamp(Int(y * tk), 0, th)" + NL
    t = t + "    x1 = Clamp(MATH.Max(Int((x + w) * tk), x0 + 1), 0, tw)" + NL
    t = t + "    y1 = Clamp(MATH.Max(Int((y + ht) * tk), y0 + 1), 0, th)" + NL
    t = t + "    FOR j = y0 TO y1 - 1" + NL
    t = t + "        FOR i = x0 TO x1 - 1" + NL
    t = t + "            px[j * tw + i] = pen" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB TDot (x AS Integer, y AS Integer)" + NL
    t = t + "    IF x >= 0 AND y >= 0 AND x < tw AND y < th THEN px[y * tw + x] = pen" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A line, in thumbnail pixels." + NL
    t = t + "SUB TLine (x1 AS Real, y1 AS Real, x2 AS Real, y2 AS Real)" + NL
    t = t + "    VAR n AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    n = Int(MATH.Max(Abs(x2 - x1), Abs(y2 - y1))) + 1" + NL
    t = t + "    FOR i = 0 TO n" + NL
    t = t + "        TDot(Int(x1 + (x2 - x1) * i / n), Int(y1 + (y2 - y1) * i / n))" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB ThumbCmd (c AS String)" + NL
    t = t + "    VAR op AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    VAR n AS Array OF Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR r AS Real" + NL
    t = t + "    VAR cx AS Real" + NL
    t = t + "    VAR cy AS Real" + NL
    t = t + "    op = c.CharAt(0)" + NL
    t = t + "    rest = c.Substring(1, c.Length - 1)" + NL
    t = t + "    SELECT CASE op" + NL
    t = t + "        CASE ""C""" + NL
    t = t + "            pen = Clamp(Int(Val(rest)), 0, 15)" + NL
    t = t + "        CASE ""B""" + NL
    t = t + "            paper = Clamp(Int(Val(rest)), 0, 15)" + NL
    t = t + "        CASE ""X""" + NL
    t = t + "            ThumbClear()" + NL
    t = t + "        CASE ""F""" + NL
    t = t + "            n = TNums(rest, 4)" + NL
    t = t + "            IF n.Count = 4 THEN TBox(n[0], n[1], n[2], n[3])" + NL
    t = t + "        CASE ""R""" + NL
    t = t + "            n = TNums(rest, 4)" + NL
    t = t + "            IF n.Count = 4 THEN" + NL
    t = t + "                TLine(n[0] * tk, n[1] * tk, (n[0] + n[2]) * tk, n[1] * tk)" + NL
    t = t + "                TLine(n[0] * tk, (n[1] + n[3]) * tk, (n[0] + n[2]) * tk, (n[1] + n[3]) * tk)" + NL
    t = t + "                TLine(n[0] * tk, n[1] * tk, n[0] * tk, (n[1] + n[3]) * tk)" + NL
    t = t + "                TLine((n[0] + n[2]) * tk, n[1] * tk, (n[0] + n[2]) * tk, (n[1] + n[3]) * tk)" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""D"", ""O""" + NL
    t = t + "            n = TNums(rest, 3)" + NL
    t = t + "            IF n.Count = 3 THEN" + NL
    t = t + "                cx = n[0] * tk" + NL
    t = t + "                cy = n[1] * tk" + NL
    t = t + "                r = n[2] * tk" + NL
    t = t + "                IF op = ""D"" THEN" + NL
    t = t + "                    FOR j = Int(cy - r) TO Int(cy + r)" + NL
    t = t + "                        k = Int(MATH.Sqrt(MATH.Max(0, r * r - (j + 0.5 - cy) * (j + 0.5 - cy))))" + NL
    t = t + "                        FOR i = Int(cx - k) TO Int(cx + k)" + NL
    t = t + "                            TDot(i, j)" + NL
    t = t + "                        NEXT" + NL
    t = t + "                    NEXT" + NL
    t = t + "                ELSE" + NL
    t = t + "                    k = MATH.Max(8, Int(r * 7))" + NL
    t = t + "                    FOR i = 0 TO k" + NL
    t = t + "                        TDot(Int(cx + r * MATH.Cos(i * 2 * MATH.Pi / k)), Int(cy + r * MATH.Sin(i * 2 * MATH.Pi / k)))" + NL
    t = t + "                    NEXT" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""L"", ""P""" + NL
    t = t + "            n = TNums(rest, 0)" + NL
    t = t + "            k = Int(n.Count / 2)" + NL
    t = t + "            FOR i = 0 TO k - 2" + NL
    t = t + "                TLine(n[i * 2] * tk, n[i * 2 + 1] * tk, n[i * 2 + 2] * tk, n[i * 2 + 3] * tk)" + NL
    t = t + "            NEXT" + NL
    t = t + "            IF op = ""P"" AND k > 2 THEN TLine(n[k * 2 - 2] * tk, n[k * 2 - 1] * tk, n[0] * tk, n[1] * tk)" + NL
    t = t + "        CASE ""Q""" + NL
    t = t + "            n = TNums(rest, 0)" + NL
    t = t + "            IF n.Count >= 6 THEN TPoly(n)" + NL
    t = t + "        CASE ""T""" + NL
    t = t + "            ' text is too small to read in a thumbnail: a smudge for each letter" + NL
    t = t + "            n = TNums(rest, 2)" + NL
    t = t + "            i = rest.IndexOf("","")" + NL
    t = t + "            IF n.Count = 2 AND i >= 0 THEN" + NL
    t = t + "                rest = rest.Substring(i + 1, rest.Length - i - 1)" + NL
    t = t + "                IF rest.IndexOf("","") >= 0 THEN" + NL
    t = t + "                    rest = rest.Substring(rest.IndexOf("","") + 1, rest.Length - rest.IndexOf("","") - 1)" + NL
    t = t + "                    FOR i = 0 TO MATH.Min(rest.Length, 60) - 1" + NL
    t = t + "                        IF rest.CharAt(i) <> "" "" THEN TBox(n[0] + i * 7 + 1, n[1] + 3, 5, 7)" + NL
    t = t + "                    NEXT" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""I""" + NL
    t = t + "            n = TNums(rest, 2)" + NL
    t = t + "            i = rest.IndexOf("","")" + NL
    t = t + "            IF n.Count = 2 AND i >= 0 THEN" + NL
    t = t + "                rest = rest.Substring(i + 1, rest.Length - i - 1)" + NL
    t = t + "                IF rest.IndexOf("","") >= 0 THEN" + NL
    t = t + "                    i = tPicNames.IndexOf(rest.Substring(rest.IndexOf("","") + 1, rest.Length - rest.IndexOf("","") - 1))" + NL
    t = t + "                    IF i >= 0 THEN TPicture(n[0], n[1], tPicData[i])" + NL
    t = t + "                END IF" + NL
    t = t + "            END IF" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A filled polygon, a row of thumbnail pixels at a time." + NL
    t = t + "SUB TPoly (n AS Array OF Integer)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    VAR yy AS Real" + NL
    t = t + "    VAR upper AS Real" + NL
    t = t + "    VAR lower AS Real" + NL
    t = t + "    VAR xs AS Array OF Real" + NL
    t = t + "    k = Int(n.Count / 2)" + NL
    t = t + "    upper = n[1]" + NL
    t = t + "    lower = n[1]" + NL
    t = t + "    FOR i = 1 TO k - 1" + NL
    t = t + "        upper = MATH.Min(upper, n[i * 2 + 1])" + NL
    t = t + "        lower = MATH.Max(lower, n[i * 2 + 1])" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR y = Int(upper * tk) TO Int(lower * tk)" + NL
    t = t + "        yy = (y + 0.5) / tk" + NL
    t = t + "        xs.Clear()" + NL
    t = t + "        FOR i = 0 TO k - 1" + NL
    t = t + "            j = (i + 1) MOD k" + NL
    t = t + "            IF (n[i * 2 + 1] <= yy AND n[j * 2 + 1] > yy) OR (n[j * 2 + 1] <= yy AND n[i * 2 + 1] > yy) THEN xs.Add(n[i * 2] + (yy - n[i * 2 + 1]) * (n[j * 2] - n[i * 2]) / (n[j * 2 + 1] - n[i * 2 + 1]))" + NL
    t = t + "        NEXT" + NL
    t = t + "        xs.Sort()" + NL
    t = t + "        FOR i = 0 TO xs.Count - 2 STEP 2" + NL
    t = t + "            FOR x = Int(xs[i] * tk) TO Int(xs[i + 1] * tk)" + NL
    t = t + "                TDot(x, y)" + NL
    t = t + "            NEXT" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A picture (SIM95PIC w h|row|row...), shrunk to fit." + NL
    t = t + "SUB TPicture (x AS Integer, y AS Integer, data AS String)" + NL
    t = t + "    VAR rows AS Array OF String" + NL
    t = t + "    VAR w AS Integer" + NL
    t = t + "    VAR ht AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR sx AS Integer" + NL
    t = t + "    VAR sy AS Integer" + NL
    t = t + "    VAR c AS Integer" + NL
    t = t + "    rows = data.Split(""|"")" + NL
    t = t + "    IF rows.Count < 2 OR rows[0].Split("" "").Count < 3 THEN RETURN" + NL
    t = t + "    w = Int(Val(rows[0].Split("" "")[1]))" + NL
    t = t + "    ht = Int(Val(rows[0].Split("" "")[2]))" + NL
    t = t + "    FOR j = Int(y * tk) TO Int((y + ht) * tk) - 1" + NL
    t = t + "        sy = Int((j + 0.5) / tk) - y" + NL
    t = t + "        IF sy < 0 OR sy >= ht OR sy + 1 >= rows.Count THEN CONTINUE" + NL
    t = t + "        FOR i = Int(x * tk) TO Int((x + w) * tk) - 1" + NL
    t = t + "            sx = Int((i + 0.5) / tk) - x" + NL
    t = t + "            IF sx < 0 OR sx >= rows[sy + 1].Length THEN CONTINUE" + NL
    t = t + "            c = ""0123456789ABCDEF"".IndexOf(rows[sy + 1].CharAt(sx).Upper())" + NL
    t = t + "            IF c >= 0 THEN" + NL
    t = t + "                pen = c" + NL
    t = t + "                TDot(i, j)" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ---------------------------------------------------------------- page furniture" + NL
    t = t + "" + NL
    t = t + "FUNCTION Top (title AS String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    s = ""<html><head><title>"" + H(title) + "" - SimTube</title></head>"" _" + NL
    t = t + "      + ""<body bgcolor=""""#FFFFFF"""" text=""""#000000"""" link=""""#0033CC"""" vlink=""""#663399"""">"" _" + NL
    t = t + "      + ""<table width=""""100%"""" cellpadding=""""6"""" cellspacing=""""0""""><tr>"" _" + NL
    t = t + "      + ""<td><a href=""""index.asp""""><font size=""""6"""" color=""""#000000""""><b>Sim</b></font><font size=""""6"""" color=""""#FFFFFF""""><b><font color=""""#CC0000"""">[</font>Tube<font color=""""#CC0000"""">]</font></b></font></a>"" _" + NL
    t = t + "      + ""<br><font size=""""1"""" color=""""#808080"""">Your 16-colour television</font></td>"" _" + NL
    t = t + "      + ""<td align=""""right"""" valign=""""bottom""""><font size=""""2"""">"" _" + NL
    t = t + "      + ""<a href=""""index.asp"""">Home</a> | <a href=""""top.asp"""">Most Viewed</a> | <a href=""""upload.asp"""">Upload</a> | <a href=""""simtube.htm"""">Help</a>""" + NL
    t = t + "    IF viewer <> """" THEN" + NL
    t = t + "        s = s + "" | <b>"" + H(NameOf(viewer)) + ""</b> (<a href=""""logout.asp?"" + TokenArg() + """""">log out</a>)""" + NL
    t = t + "    ELSE" + NL
    t = t + "        s = s + "" | <a href=""""index.asp#login"""">Log in</a>""" + NL
    t = t + "    END IF" + NL
    t = t + "    RETURN s + ""</font></td></tr></table><table width=""""100%"""" cellpadding=""""0"""" cellspacing=""""0""""><tr><td bgcolor=""""#CC0000""""><font size=""""1"""">&nbsp;</font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Bottom () AS String" + NL
    t = t + "    RETURN ""<hr><center><font size=""""1"""" color=""""#808080"""">SimTube on "" + H(SERVER.Name) + "" &middot; "" + TIME.Date + "" &middot; <a href=""""simtube.htm"""">About SimTube</a> &middot; <a href=""""getplay.asp"""">Get SimPlayer</a></font></center></body></html>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION BoxTop (title AS String) AS String" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""3"""" cellspacing=""""0""""><tr><td bgcolor=""""#CC0000""""><font color=""""#FFFFFF"""" size=""""2""""><b>"" + title + ""</b></font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Notice (text AS String) AS String" + NL
    t = t + "    IF text = """" THEN RETURN """"" + NL
    t = t + "    RETURN ""<table width=""""100%"""" cellpadding=""""4""""><tr><td bgcolor=""""#FFF9D7""""><font size=""""2"""">"" + H(text) + ""</font></td></tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Thumb (id AS String) AS String" + NL
    t = t + "    RETURN ""<a href=""""watch.asp?v="" + id + """"""><img src=""""thumb.asp?v="" + id + """""" width=""""80"""" height=""""60"""" border=""""1"""" alt=""""""""></a>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' One movie on a list: its picture, title, length, views and stars." + NL
    t = t + "FUNCTION VideoCell (line AS String) AS String" + NL
    t = t + "    VAR id AS String" + NL
    t = t + "    id = VF(line, 0)" + NL
    t = t + "    RETURN ""<td valign=""""top"""" width=""""33%"""">"" + Thumb(id) + ""<br><font size=""""2""""><a href=""""watch.asp?v="" + id + """"""><b>"" + H(VTitle(line)) + ""</b></a></font><br>"" _" + NL
    t = t + "         + ""<font size=""""1"""">"" + RunTime(line) + "" &middot; "" + Plural(Views(id), ""view"", ""views"") + ""<br>"" + Stars(Rating(id)) + ""<br>From: "" + H(NameOf(VF(line, 1))) + ""</font></td>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Movies, three to a row." + NL
    t = t + "FUNCTION Grid (lines AS Array OF String) AS String" + NL
    t = t + "    VAR s AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF lines.Count = 0 THEN RETURN ""<p><font size=""""2"""" color=""""#808080"""">No movies here yet. <a href=""""upload.asp"""">Upload one!</a></font></p>""" + NL
    t = t + "    s = ""<table width=""""100%"""" cellpadding=""""6"""" cellspacing=""""0""""><tr>""" + NL
    t = t + "    FOR i = 0 TO lines.Count - 1" + NL
    t = t + "        IF i > 0 AND i MOD 3 = 0 THEN s = s + ""</tr><tr>""" + NL
    t = t + "        s = s + VideoCell(lines[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN s + ""</tr></table>""" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The newest movies first." + NL
    t = t + "FUNCTION Newest (most AS Integer) AS Array OF String" + NL
    t = t + "    VAR all AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    all = AllVideos()" + NL
    t = t + "    FOR i = all.Count - 1 TO 0 STEP -1" + NL
    t = t + "        IF out.Count >= most THEN BREAK" + NL
    t = t + "        out.Add(all[i])" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The most watched movies first." + NL
    t = t + "FUNCTION MostViewed (most AS Integer) AS Array OF String" + NL
    t = t + "    VAR all AS Array OF String" + NL
    t = t + "    VAR keys AS Array OF String" + NL
    t = t + "    VAR out AS Array OF String" + NL
    t = t + "    VAR k AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    all = AllVideos()" + NL
    t = t + "    FOR i = 0 TO all.Count - 1" + NL
    t = t + "        keys.Add(Str(Views(VF(all[i], 0))).PadLeft(9) + ""|"" + Str(100000 - i).PadLeft(6) + ""|"" + Str(i))" + NL
    t = t + "    NEXT" + NL
    t = t + "    keys.Sort()" + NL
    t = t + "    keys.Reverse()" + NL
    t = t + "    FOR EACH k IN keys" + NL
    t = t + "        IF out.Count >= most THEN BREAK" + NL
    t = t + "        out.Add(all[Int(Val(k.Split(""|"")[2]))])" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    Put("C:\WEB\TUBE.SPK")
END SUB

SUB File12 ()
    t = ""
    t = t + "<%@ import file=""TUBE.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' UPLOAD.ASP - put a movie up (a .SMV file of up to 60K), or (to=N) add the" + NL
    t = t + "' next piece of a longer one to the end of your movie N." + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "RequireLogin()" + NL
    t = t + "IF REQUEST.Method = ""POST"" THEN" + NL
    t = t + "    RequireToken()" + NL
    t = t + "    IF REQUEST.Form(""to"") <> """" THEN" + NL
    t = t + "        line = FindVideo(REQUEST.Form(""to""))" + NL
    t = t + "        IF line = """" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "        IF VF(line, 1) <> viewer THEN RESPONSE.Redirect(""watch.asp?back=1&v="" + VF(line, 0) + ""&why="" + UrlEnc(""Only the person who put a movie up can add to it.""))" + NL
    t = t + "        problem = AppendMovie(line, REQUEST.Form(""movie""))" + NL
    t = t + "        IF problem = """" THEN problem = ""The frames were added. The movie is "" + RunTime(FindVideo(VF(line, 0))) + "" long now.""" + NL
    t = t + "        RESPONSE.Redirect(""watch.asp?back=1&v="" + VF(line, 0) + ""&why="" + UrlEnc(problem))" + NL
    t = t + "    END IF" + NL
    t = t + "    IF REQUEST.Form(""movie"") = """" THEN" + NL
    t = t + "        problem = ""Choose a .SMV file to upload.""" + NL
    t = t + "    ELSE" + NL
    t = t + "        problem = ImportMovie(viewer, REQUEST.Form(""movie""), REQUEST.Form(""title""), REQUEST.Form(""about""))" + NL
    t = t + "        IF problem = """" THEN RESPONSE.Redirect(""watch.asp?v="" + lastId)" + NL
    t = t + "    END IF" + NL
    t = t + "END IF" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(""Upload"") %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= Notice(problem) %>" + NL
    t = t + "<%= BoxTop(""Upload a Movie"") %>" + NL
    t = t + "<form action=""upload.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<table cellpadding=""3"">" + NL
    t = t + "<tr><td><font size=""2"">Movie file (.SMV):</font></td><td><input type=""file"" name=""movie"" size=""30""></td></tr>" + NL
    t = t + "<tr><td><font size=""2"">Title:</font></td><td><input name=""title"" size=""40"" maxlength=""<%= MAXTITLE %>""> <font size=""1"" color=""#808080"">(or the one in the file)</font></td></tr>" + NL
    t = t + "<tr><td valign=""top""><font size=""2"">About it:</font></td><td><textarea name=""about"" rows=""3"" cols=""40""></textarea></td></tr>" + NL
    t = t + "<tr><td></td><td><input type=""submit"" value=""Upload""></td></tr>" + NL
    t = t + "</table>" + NL
    t = t + "</form>" + NL
    t = t + "<%= BoxTop(""Making a Movie"") %>" + NL
    t = t + "<p><font size=""2"">A SimMovie is a text file. It starts with a header and a line holding" + NL
    t = t + "just a full stop, then has one line for each frame, made of drawing commands" + NL
    t = t + "separated by semicolons:</font></p>" + NL
    t = t + "<pre>SIMMOVIE 1" + NL
    t = t + "title=My First Movie" + NL
    t = t + "width=160" + NL
    t = t + "height=120" + NL
    t = t + "fps=10" + NL
    t = t + "bg=0" + NL
    t = t + "." + NL
    t = t + "*C12;D40,60,10;C15;T60,54,Hello!" + NL
    t = t + "C0;F30,50,21,21;C12;D44,60,10" + NL
    t = t + "C0;F34,50,21,21;C12;D48,60,10;S440,50" + NL
    t = t + "-</pre>" + NL
    t = t + "<p><font size=""2"">A line starting with * is a keyframe: it starts from a blank screen." + NL
    t = t + "Other lines draw over the frame before; - means nothing changes. The commands:" + NL
    t = t + "<tt>C</tt> colour, <tt>B</tt> background, <tt>X</tt> clear, <tt>F</tt> filled box x,y,w,h," + NL
    t = t + "<tt>R</tt> box, <tt>D</tt> filled circle x,y,r, <tt>O</tt> circle, <tt>L</tt> lines x1,y1,x2,y2,...," + NL
    t = t + "<tt>P</tt> polygon, <tt>Q</tt> filled polygon, <tt>T</tt> text x,y,words, <tt>I</tt> picture x,y,name" + NL
    t = t + "and <tt>S</tt> a beep frequency,ms. A picture is a line of its own:" + NL
    t = t + "<tt>!name|SIM95PIC w h|row|row|...</tt>. The <a href=""simtube.htm"">help page</a> has the lot.</font></p>" + NL
    t = t + "<p><font size=""2"">A whole upload must fit in one 64K network message, so a movie can be up" + NL
    t = t + "to 60K. Longer ones go up in pieces: upload the first, then use Add More Frames on" + NL
    t = t + "its page for the rest. SimTube cuts every movie into 15K parts, and SimPlayer" + NL
    t = t + "starts playing while the rest download.</font></p>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\UPLOAD.ASP")
END SUB

SUB File13 ()
    t = ""
    t = t + "<%@ import file=""TUBE.SPK"" %>" + NL
    t = t + "<%" + NL
    t = t + "' WATCH.ASP?v=N - one movie: its picture and details, where to play it, stars and comments." + NL
    t = t + "' Voyager can't play a movie, so this page hands over its address for SimPlayer." + NL
    t = t + "VAR id AS String" + NL
    t = t + "VAR line AS String" + NL
    t = t + "VAR all AS Array OF String" + NL
    t = t + "VAR i AS Integer" + NL
    t = t + "VAR mine AS Integer" + NL
    t = t + "viewer = CurrentUser()" + NL
    t = t + "id = REQUEST.Query(""v"")" + NL
    t = t + "line = FindVideo(id)" + NL
    t = t + "IF line = """" THEN RESPONSE.Redirect(""index.asp"")" + NL
    t = t + "' coming back from rating or commenting is not another view" + NL
    t = t + "IF REQUEST.Query(""back"") = """" THEN AddView(id)" + NL
    t = t + "all = Comments(id)" + NL
    t = t + "IF viewer <> """" THEN mine = MyRating(id, viewer)" + NL
    t = t + "%>" + NL
    t = t + "<%= Top(VTitle(line)) %>" + NL
    t = t + "<table width=""100%"" cellpadding=""8"" cellspacing=""0""><tr><td valign=""top"">" + NL
    t = t + "<%= Notice(REQUEST.Query(""why"")) %>" + NL
    t = t + "<h2><%= H(VTitle(line)) %></h2>" + NL
    t = t + "<table cellpadding=""6"" cellspacing=""0""><tr>" + NL
    t = t + "<td valign=""top"" bgcolor=""#000000""><img src=""thumb.asp?v=<%= id %>"" alt=""<%= H(VTitle(line)) %>""></td>" + NL
    t = t + "<td valign=""top""><font size=""2"">" + NL
    t = t + "From: <b><%= H(NameOf(VF(line, 1))) %></b><br>" + NL
    t = t + "<% IF VF(line, 11) <> """" THEN %>Made by: <%= H(Unesc(VF(line, 11))) %><br><% END IF %>" + NL
    t = t + "Added: <%= VF(line, 3) %><br>" + NL
    t = t + "Runs: <%= RunTime(line) %> (<%= VF(line, 4) %> frames at <%= VF(line, 5) %> a second, <%= VF(line, 6) %>x<%= VF(line, 7) %>)<br>" + NL
    t = t + "Views: <b><%= Views(id) %></b><br>" + NL
    t = t + "Rating: <%= Stars(Rating(id)) %> (<%= Plural(RatingCount(id), ""rating"", ""ratings"") %>)" + NL
    t = t + "</font></td>" + NL
    t = t + "</tr></table>" + NL
    t = t + "<% IF VF(line, 10) <> """" THEN %><p><%= Br(Unesc(VF(line, 10))) %></p><% END IF %>" + NL
    t = t + "" + NL
    t = t + "<%= BoxTop(""Watch It"") %>" + NL
    t = t + "<p><font size=""2"">This movie plays in <b>SimPlayer</b>. Open SimPlayer (<tt>C:\PROGRAMS\PLAYER.SPK</tt>)," + NL
    t = t + "paste this address into its Address box and press Enter. It starts as soon as the first part is in.</font></p>" + NL
    t = t + "<form><input id=""url"" size=""56"" value=""<%= H(MovieUrl(id)) %>"" readonly></form>" + NL
    t = t + "<p><font size=""2""><a href=""movie.asp?v=<%= id %>"" type=""<%= MIME %>"">movie.asp?v=<%= id %></a>" + NL
    t = t + "(a <tt><%= MIME %></tt> SimMovie, <%= Plural(Int(Val(VF(line, 8))), ""part"", ""parts"") %>)" + NL
    t = t + "&middot; From SPARK: <tt>SYS.Start(""C:\PROGRAMS\PLAYER.SPK"", ""<%= H(MovieUrl(id)) %>"")</tt>" + NL
    t = t + "&middot; No SimPlayer? <a href=""getplay.asp"">Get it here</a>.</font></p>" + NL
    t = t + "" + NL
    t = t + "<%= BoxTop(""Rate This Movie"") %>" + NL
    t = t + "<% IF viewer <> """" THEN %>" + NL
    t = t + "<form action=""rate.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<input type=""hidden"" name=""v"" value=""<%= id %>"">" + NL
    t = t + "<p><font size=""2"">Your rating:" + NL
    t = t + "<select name=""stars"">" + NL
    t = t + "<% FOR i = 5 TO 1 STEP -1 %><option value=""<%= i %>""<% IF i = mine THEN %> selected<% END IF %>><%= ""*****"".Substring(0, i) %> (<%= i %>)</option><% NEXT %>" + NL
    t = t + "</select> <input type=""submit"" value=""Rate""></font></p>" + NL
    t = t + "</form>" + NL
    t = t + "<% ELSE %>" + NL
    t = t + "<p><font size=""2""><a href=""index.asp#login"">Log in</a> to rate and comment.</font></p>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "" + NL
    t = t + "<a name=""comments""></a>" + NL
    t = t + "<%= BoxTop(""Comments ("" + Str(all.Count) + "")"") %>" + NL
    t = t + "<% IF viewer <> """" THEN %>" + NL
    t = t + "<form action=""comment.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<input type=""hidden"" name=""v"" value=""<%= id %>"">" + NL
    t = t + "<p><textarea name=""text"" rows=""3"" cols=""50""></textarea><br>" + NL
    t = t + "<font size=""1"" color=""#808080"">Up to <%= MAXCOMMENT %> characters.</font>" + NL
    t = t + "<input type=""submit"" value=""Post Comment""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "<table width=""100%"" cellpadding=""4"" cellspacing=""2"">" + NL
    t = t + "<%= CommentsHtml(all) %>" + NL
    t = t + "</table>" + NL
    t = t + "" + NL
    t = t + "<% IF viewer = VF(line, 1) THEN %>" + NL
    t = t + "<%= BoxTop(""Add More Frames"") %>" + NL
    t = t + "<form action=""upload.asp"" method=""post""><%= TokenField() %>" + NL
    t = t + "<input type=""hidden"" name=""to"" value=""<%= id %>"">" + NL
    t = t + "<p><font size=""2"">A movie over 60K goes up in pieces. Send the next piece of the .SMV file" + NL
    t = t + "(the frame lines that come next; a header at the top is fine) and it is added to the end.</font><br>" + NL
    t = t + "<input type=""file"" name=""movie"" size=""30""> <input type=""submit"" value=""Add Frames""></p>" + NL
    t = t + "</form>" + NL
    t = t + "<% END IF %>" + NL
    t = t + "</td></tr></table>" + NL
    t = t + "<%= Bottom() %>" + NL
    Put("C:\WEB\WATCH.ASP")
END SUB

SUB File14 ()
    t = ""
    t = t + "' PLAYER.SPK - SimPlayer, the movie player for SIM95. Plays SimMovies (.SMV)" + NL
    t = t + "' from this disk or from the web, such as the ones on SimTube." + NL
    t = t + "'" + NL
    t = t + "'   SPARK C:\PROGRAMS\PLAYER.SPK C:\MYFILES\DANCE.SMV" + NL
    t = t + "'   SPARK C:\PROGRAMS\PLAYER.SPK http://alpha/tube/movie.asp?v=2" + NL
    t = t + "'" + NL
    t = t + "' A SimMovie is text: a header, then one line per frame of drawing commands" + NL
    t = t + "' for a GUI_Canvas (see simtube/README.md). A long one is cut into parts of" + NL
    t = t + "' about 15K, each small enough for one network message, and a manifest" + NL
    t = t + "' (it starts ""SIMMOVIE-PARTS 1"") says where the parts are. SimPlayer fetches" + NL
    t = t + "' the parts one at a time and starts playing as soon as it has a few seconds" + NL
    t = t + "' in hand, like the streaming players do." + NL
    t = t + "'" + NL
    t = t + "' Fetches go one at a time and start in a timer tick of their own, inside a" + NL
    t = t + "' TRY with an empty CATCH (see SIM95-NOTES.md); pages come in through the" + NL
    t = t + "' socket's events. Playback runs off a second timer and SYS.Ticks, so a movie" + NL
    t = t + "' plays at its own speed whatever the timer manages." + NL
    t = t + "'" + NL
    t = t + "' For the curious (and for tests): the window's Tag says what is going on," + NL
    t = t + "'   state|frame|frames|loaded|parts in|parts|loop|mute" + NL
    t = t + "" + NL
    t = t + "CONST AHEAD = 3             ' seconds of movie in hand before playing" + NL
    t = t + "CONST PATIENCE = 8000       ' ms to wait for a web server" + NL
    t = t + "CONST MAXTRIES = 3" + NL
    t = t + "CONST MINW = 336" + NL
    t = t + "" + NL
    t = t + "VAR EOL AS String" + NL
    t = t + "VAR win AS GUI_Window" + NL
    t = t + "VAR bar AS GUI_Menu" + NL
    t = t + "VAR addrLabel AS GUI_Label" + NL
    t = t + "VAR addr AS GUI_TextBox" + NL
    t = t + "VAR openBtn AS GUI_Button" + NL
    t = t + "VAR screen AS GUI_Canvas" + NL
    t = t + "VAR info AS GUI_Label" + NL
    t = t + "VAR seekBar AS GUI_Canvas" + NL
    t = t + "VAR playBtn AS GUI_Button" + NL
    t = t + "VAR stopBtn AS GUI_Button" + NL
    t = t + "VAR rewBtn AS GUI_Button" + NL
    t = t + "VAR backBtn AS GUI_Button" + NL
    t = t + "VAR fwdBtn AS GUI_Button" + NL
    t = t + "VAR loopBox AS GUI_CheckBox" + NL
    t = t + "VAR muteBox AS GUI_CheckBox" + NL
    t = t + "VAR timeLabel AS GUI_Label" + NL
    t = t + "VAR ticker AS GUI_Timer" + NL
    t = t + "VAR fetcher AS GUI_Timer" + NL
    t = t + "VAR web AS NET_Socket" + NL
    t = t + "" + NL
    t = t + "' the movie" + NL
    t = t + "VAR source AS String          ' the file or URL it came from" + NL
    t = t + "VAR mTitle AS String" + NL
    t = t + "VAR mAuthor AS String" + NL
    t = t + "VAR mW AS Integer = 160" + NL
    t = t + "VAR mH AS Integer = 120" + NL
    t = t + "VAR mFps AS Integer = 10" + NL
    t = t + "VAR mFrames AS Integer        ' as the header says; the frames themselves win once all are in" + NL
    t = t + "VAR mBg AS Integer" + NL
    t = t + "VAR frames AS Array OF String" + NL
    t = t + "VAR picNames AS Array OF String" + NL
    t = t + "VAR picData AS Array OF String" + NL
    t = t + "VAR partRefs AS Array OF String" + NL
    t = t + "VAR partsIn AS Integer" + NL
    t = t + "VAR allIn AS Bool" + NL
    t = t + "VAR remote AS Bool" + NL
    t = t + "VAR gotHeader AS Bool" + NL
    t = t + "" + NL
    t = t + "' playing" + NL
    t = t + "VAR state AS String = ""empty""   ' empty, buffering, playing, paused, stopped, ended, error" + NL
    t = t + "VAR problem AS String" + NL
    t = t + "VAR cur AS Integer = -1         ' the frame on the screen" + NL
    t = t + "VAR wantPlay AS Bool" + NL
    t = t + "VAR t0 AS Integer               ' SYS.Ticks when frame f0 was due" + NL
    t = t + "VAR f0 AS Integer" + NL
    t = t + "VAR dragging AS Bool" + NL
    t = t + "VAR drawing AS Bool" + NL
    t = t + "" + NL
    t = t + "' one fetch at a time" + NL
    t = t + "VAR fetching AS Bool" + NL
    t = t + "VAR fFirst AS Bool              ' the first thing at the address (a movie or a manifest)" + NL
    t = t + "VAR fUrl AS String" + NL
    t = t + "VAR fNumber AS Integer" + NL
    t = t + "VAR fParts AS Array OF String" + NL
    t = t + "VAR fDone AS Bool" + NL
    t = t + "VAR fSince AS Integer" + NL
    t = t + "VAR fError AS String" + NL
    t = t + "VAR wantFirst AS Bool" + NL
    t = t + "VAR tries AS Integer" + NL
    t = t + "" + NL
    t = t + "' ================================================================ start" + NL
    t = t + "" + NL
    t = t + "SUB Main ()" + NL
    t = t + "    EOL = Chr(10)" + NL
    t = t + "    win = GUI_Window.New(""SimPlayer"", MINW, 260)" + NL
    t = t + "    win.Icon = ""app""" + NL
    t = t + "    win.onClose = Win_OnClose" + NL
    t = t + "    win.onKey = Player_OnKey" + NL
    t = t + "    bar = GUI_Menu.New(win)" + NL
    t = t + "    bar.onSelect = Menu_OnSelect" + NL
    t = t + "    bar.AddMenu(""&File"")" + NL
    t = t + "    bar.AddItem(""&File"", ""&Open File..."" + Chr(9) + ""Ctrl+O"")" + NL
    t = t + "    bar.AddItem(""&File"", ""Open &URL..."" + Chr(9) + ""Ctrl+L"")" + NL
    t = t + "    bar.AddSeparator(""&File"")" + NL
    t = t + "    bar.AddItem(""&File"", ""E&xit"")" + NL
    t = t + "    bar.AddMenu(""&Play"")" + NL
    t = t + "    bar.AddItem(""&Play"", ""&Play/Pause"" + Chr(9) + ""Space"")" + NL
    t = t + "    bar.AddItem(""&Play"", ""&Stop"")" + NL
    t = t + "    bar.AddItem(""&Play"", ""&Rewind"" + Chr(9) + ""Home"")" + NL
    t = t + "    bar.AddItem(""&Play"", ""Step &Forward"" + Chr(9) + ""ArrowRight"")" + NL
    t = t + "    bar.AddItem(""&Play"", ""Step &Back"" + Chr(9) + ""ArrowLeft"")" + NL
    t = t + "    bar.AddSeparator(""&Play"")" + NL
    t = t + "    bar.AddItem(""&Play"", ""&Loop"")" + NL
    t = t + "    bar.AddItem(""&Play"", ""&Mute"")" + NL
    t = t + "    bar.AddMenu(""&Help"")" + NL
    t = t + "    bar.AddItem(""&Help"", ""&About SimPlayer"")" + NL
    t = t + "" + NL
    t = t + "    addrLabel = GUI_Label.New(win)" + NL
    t = t + "    addrLabel.Text = ""Address:""" + NL
    t = t + "    addr = GUI_TextBox.New(win)" + NL
    t = t + "    addr.onEnter = Open_Click" + NL
    t = t + "    openBtn = GUI_Button.New(win)" + NL
    t = t + "    openBtn.Text = ""&Open""" + NL
    t = t + "    openBtn.onClick = Open_Click" + NL
    t = t + "    screen = GUI_Canvas.New(win)" + NL
    t = t + "    screen.onDraw = Screen_OnDraw" + NL
    t = t + "    screen.onKey = Player_OnKey" + NL
    t = t + "    screen.onMouseDown = Screen_OnMouseDown" + NL
    t = t + "    info = GUI_Label.New(win)" + NL
    t = t + "    info.Bold = TRUE" + NL
    t = t + "    seekBar = GUI_Canvas.New(win)" + NL
    t = t + "    seekBar.onDraw = Seek_OnDraw" + NL
    t = t + "    seekBar.onMouseDown = Seek_OnMouseDown" + NL
    t = t + "    seekBar.onMouseMove = Seek_OnMouseMove" + NL
    t = t + "    seekBar.onMouseUp = Seek_OnMouseUp" + NL
    t = t + "    playBtn = GUI_Button.New(win)" + NL
    t = t + "    playBtn.Text = ""&Play""" + NL
    t = t + "    playBtn.onClick = Play_Click" + NL
    t = t + "    stopBtn = GUI_Button.New(win)" + NL
    t = t + "    stopBtn.Text = ""&Stop""" + NL
    t = t + "    stopBtn.onClick = Stop_Click" + NL
    t = t + "    rewBtn = GUI_Button.New(win)" + NL
    t = t + "    rewBtn.Text = ""Re&wind""" + NL
    t = t + "    rewBtn.onClick = Rewind_Click" + NL
    t = t + "    backBtn = GUI_Button.New(win)" + NL
    t = t + "    backBtn.Text = ""<""" + NL
    t = t + "    backBtn.onClick = Back_Click" + NL
    t = t + "    fwdBtn = GUI_Button.New(win)" + NL
    t = t + "    fwdBtn.Text = "">""" + NL
    t = t + "    fwdBtn.onClick = Fwd_Click" + NL
    t = t + "    loopBox = GUI_CheckBox.New(win)" + NL
    t = t + "    loopBox.Text = ""&Loop""" + NL
    t = t + "    loopBox.onChange = Loop_Change" + NL
    t = t + "    muteBox = GUI_CheckBox.New(win)" + NL
    t = t + "    muteBox.Text = ""&Mute""" + NL
    t = t + "    muteBox.onChange = Mute_Change" + NL
    t = t + "    timeLabel = GUI_Label.New(win)" + NL
    t = t + "    timeLabel.Align = ""right""" + NL
    t = t + "" + NL
    t = t + "    web = NET_Socket.New()" + NL
    t = t + "    web.onMessage = Web_OnMessage" + NL
    t = t + "    web.onClose = Web_OnClose" + NL
    t = t + "    ticker = GUI_Timer.New(win)" + NL
    t = t + "    ticker.Interval = 50" + NL
    t = t + "    ticker.onTick = Ticker_OnTick" + NL
    t = t + "    ticker.Start()" + NL
    t = t + "    fetcher = GUI_Timer.New(win)" + NL
    t = t + "    fetcher.Interval = 100" + NL
    t = t + "    fetcher.onTick = Fetcher_OnTick" + NL
    t = t + "    fetcher.Start()" + NL
    t = t + "" + NL
    t = t + "    Layout()" + NL
    t = t + "    win.Show()" + NL
    t = t + "    Splash()" + NL
    t = t + "    Refresh()" + NL
    t = t + "    IF SYS.Args.Count > 0 THEN" + NL
    t = t + "        addr.Text = SYS.Args[0]" + NL
    t = t + "        OpenMovie(SYS.Args[0])" + NL
    t = t + "    ELSE" + NL
    t = t + "        addr.Focus()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Win_OnClose ()" + NL
    t = t + "    SYS.Exit(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Everything sized round the picture: at least MINW wide, the controls below." + NL
    t = t + "SUB Layout ()" + NL
    t = t + "    VAR cw AS Integer" + NL
    t = t + "    VAR sh AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    cw = MATH.Max(MINW, mW + 16)" + NL
    t = t + "    sh = MATH.Max(120, mH)" + NL
    t = t + "    addrLabel.SetBounds(8, 8, 52, 16)" + NL
    t = t + "    addr.SetBounds(62, 4, cw - 62 - 64, 22)" + NL
    t = t + "    openBtn.SetBounds(cw - 60, 4, 52, 22)" + NL
    t = t + "    screen.SetBounds(Int((cw - mW) / 2), 32 + Int((sh - mH) / 2), mW, mH)" + NL
    t = t + "    y = 32 + sh + 6" + NL
    t = t + "    info.SetBounds(8, y, cw - 16, 16)" + NL
    t = t + "    seekBar.SetBounds(8, y + 20, cw - 16, 14)" + NL
    t = t + "    y = y + 40" + NL
    t = t + "    playBtn.SetBounds(8, y, 56, 24)" + NL
    t = t + "    stopBtn.SetBounds(68, y, 48, 24)" + NL
    t = t + "    rewBtn.SetBounds(120, y, 60, 24)" + NL
    t = t + "    backBtn.SetBounds(184, y, 24, 24)" + NL
    t = t + "    fwdBtn.SetBounds(210, y, 24, 24)" + NL
    t = t + "    loopBox.SetBounds(8, y + 30, 56, 18)" + NL
    t = t + "    muteBox.SetBounds(68, y + 30, 56, 18)" + NL
    t = t + "    timeLabel.SetBounds(cw - 128, y + 4, 120, 16)" + NL
    t = t + "    win.Width = cw" + NL
    t = t + "    win.Height = y + 54" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Nothing loaded yet: the SimPlayer card." + NL
    t = t + "SUB Splash ()" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    screen.Background = 4" + NL
    t = t + "    screen.Clear()" + NL
    t = t + "    FOR i = 0 TO 7" + NL
    t = t + "        screen.SetColor(4)" + NL
    t = t + "        IF i MOD 2 = 1 THEN screen.SetColor(12)" + NL
    t = t + "        screen.FillRect(0, Int(mH * i / 8), mW, 2)" + NL
    t = t + "    NEXT" + NL
    t = t + "    ' the S logo" + NL
    t = t + "    screen.SetColor(9)" + NL
    t = t + "    screen.FillRect(Int(mW / 2) - 16, Int(mH / 2) - 34, 32, 32)" + NL
    t = t + "    screen.SetColor(15)" + NL
    t = t + "    screen.FillRect(Int(mW / 2) - 8, Int(mH / 2) - 29, 18, 4)" + NL
    t = t + "    screen.FillRect(Int(mW / 2) - 10, Int(mH / 2) - 25, 5, 6)" + NL
    t = t + "    screen.FillRect(Int(mW / 2) - 8, Int(mH / 2) - 20, 16, 4)" + NL
    t = t + "    screen.FillRect(Int(mW / 2) + 5, Int(mH / 2) - 16, 5, 6)" + NL
    t = t + "    screen.FillRect(Int(mW / 2) - 10, Int(mH / 2) - 10, 18, 4)" + NL
    t = t + "    screen.SetColor(15)" + NL
    t = t + "    screen.Text(Int(mW / 2) - 32, Int(mH / 2) + 6, ""SimPlayer"")" + NL
    t = t + "    screen.SetColor(14)" + NL
    t = t + "    screen.Text(Int(mW / 2) - 38, Int(mH / 2) + 22, ""Version 1.0"")" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ opening" + NL
    t = t + "" + NL
    t = t + "SUB Reset ()" + NL
    t = t + "    frames.Clear()" + NL
    t = t + "    picNames.Clear()" + NL
    t = t + "    picData.Clear()" + NL
    t = t + "    partRefs.Clear()" + NL
    t = t + "    partsIn = 0" + NL
    t = t + "    allIn = FALSE" + NL
    t = t + "    gotHeader = FALSE" + NL
    t = t + "    mTitle = """"" + NL
    t = t + "    mAuthor = """"" + NL
    t = t + "    mFps = 10" + NL
    t = t + "    mFrames = 0" + NL
    t = t + "    mBg = 0" + NL
    t = t + "    cur = -1" + NL
    t = t + "    problem = """"" + NL
    t = t + "    fetching = FALSE" + NL
    t = t + "    wantFirst = FALSE" + NL
    t = t + "    tries = 0" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB OpenMovie (where AS String)" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    where = where.Trim()" + NL
    t = t + "    IF where = """" THEN RETURN" + NL
    t = t + "    Reset()" + NL
    t = t + "    source = where" + NL
    t = t + "    wantPlay = TRUE" + NL
    t = t + "    IF where.Lower().StartsWith(""http://"") THEN" + NL
    t = t + "        remote = TRUE" + NL
    t = t + "        state = ""buffering""" + NL
    t = t + "        wantFirst = TRUE" + NL
    t = t + "        win.Title = ""SimPlayer - "" + where" + NL
    t = t + "        Refresh()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    remote = FALSE" + NL
    t = t + "    IF NOT FS.Exists(where) THEN" + NL
    t = t + "        Fail(""There is no file called "" + where + ""."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    text = FS.Read(where)" + NL
    t = t + "    TakeFirst(text, DirOf(where))" + NL
    t = t + "    ' the parts of a movie on this disk are all here at once" + NL
    t = t + "    WHILE state <> ""error"" AND partsIn < partRefs.Count" + NL
    t = t + "        IF NOT FS.Exists(partRefs[partsIn]) THEN" + NL
    t = t + "            Fail(""A part of this movie is missing: "" + partRefs[partsIn])" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        AddPart(FS.Read(partRefs[partsIn]))" + NL
    t = t + "    END WHILE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Fail (why AS String)" + NL
    t = t + "    state = ""error""" + NL
    t = t + "    problem = why" + NL
    t = t + "    wantPlay = FALSE" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' The first thing read from an address: a whole movie, or a manifest that" + NL
    t = t + "' lists its parts." + NL
    t = t + "SUB TakeFirst (text AS String, base AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    lines = text.Lines()" + NL
    t = t + "    IF lines.Count > 0 AND lines[0].StartsWith(""SIMMOVIE-PARTS"") THEN" + NL
    t = t + "        FOR EACH line IN lines" + NL
    t = t + "            IF line.StartsWith(""part="") THEN" + NL
    t = t + "                partRefs.Add(Resolve(line.Substring(5, line.Length - 5).Trim(), base))" + NL
    t = t + "            ELSE" + NL
    t = t + "                HeaderLine(line)" + NL
    t = t + "            END IF" + NL
    t = t + "        NEXT" + NL
    t = t + "        IF partRefs.Count = 0 THEN" + NL
    t = t + "            Fail(""That manifest lists no parts."")" + NL
    t = t + "            RETURN" + NL
    t = t + "        END IF" + NL
    t = t + "        Opened()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF lines.Count = 0 OR NOT lines[0].StartsWith(""SIMMOVIE "") THEN" + NL
    t = t + "        Fail(""That is not a SimMovie. A SimMovie starts with the line SIMMOVIE 1."")" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    partRefs.Add(source)" + NL
    t = t + "    AddPart(text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB HeaderLine (line AS String)" + NL
    t = t + "    VAR field AS String" + NL
    t = t + "    VAR value AS String" + NL
    t = t + "    IF line.IndexOf(""="") < 1 THEN RETURN" + NL
    t = t + "    field = line.Substring(0, line.IndexOf(""="")).Trim().Lower()" + NL
    t = t + "    value = line.Substring(line.IndexOf(""="") + 1, line.Length - line.IndexOf(""="") - 1)" + NL
    t = t + "    SELECT CASE field" + NL
    t = t + "        CASE ""title""" + NL
    t = t + "            mTitle = value" + NL
    t = t + "        CASE ""author""" + NL
    t = t + "            mAuthor = value" + NL
    t = t + "        CASE ""width""" + NL
    t = t + "            mW = Clamp(Int(Val(value)), 16, 320)" + NL
    t = t + "        CASE ""height""" + NL
    t = t + "            mH = Clamp(Int(Val(value)), 16, 240)" + NL
    t = t + "        CASE ""fps""" + NL
    t = t + "            mFps = Clamp(Int(Val(value)), 1, 30)" + NL
    t = t + "        CASE ""frames""" + NL
    t = t + "            mFrames = MATH.Max(0, Int(Val(value)))" + NL
    t = t + "        CASE ""bg""" + NL
    t = t + "            mBg = Clamp(Int(Val(value)), 0, 15)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION Clamp (n AS Integer, lo AS Integer, hi AS Integer) AS Integer" + NL
    t = t + "    IF n < lo THEN RETURN lo" + NL
    t = t + "    IF n > hi THEN RETURN hi" + NL
    t = t + "    RETURN n" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The header is in: size the window to the picture." + NL
    t = t + "SUB Opened ()" + NL
    t = t + "    IF gotHeader THEN RETURN" + NL
    t = t + "    gotHeader = TRUE" + NL
    t = t + "    Layout()" + NL
    t = t + "    screen.Background = mBg" + NL
    t = t + "    screen.Clear()" + NL
    t = t + "    IF mTitle = """" THEN mTitle = ""Untitled""" + NL
    t = t + "    win.Title = ""SimPlayer - "" + mTitle" + NL
    t = t + "    IF wantPlay THEN state = ""buffering""" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One part: frames, and pictures for them. The first part starts with the header." + NL
    t = t + "SUB AddPart (text AS String)" + NL
    t = t + "    VAR lines AS Array OF String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR line AS String" + NL
    t = t + "    lines = text.Lines()" + NL
    t = t + "    i = 0" + NL
    t = t + "    IF lines.Count > 0 AND lines[0].StartsWith(""SIMMOVIE "") THEN" + NL
    t = t + "        i = 1" + NL
    t = t + "        WHILE i < lines.Count" + NL
    t = t + "            IF lines[i] = ""."" THEN BREAK" + NL
    t = t + "            ' a manifest has said all this already" + NL
    t = t + "            IF NOT gotHeader THEN HeaderLine(lines[i])" + NL
    t = t + "            i = i + 1" + NL
    t = t + "        END WHILE" + NL
    t = t + "        i = i + 1" + NL
    t = t + "    END IF" + NL
    t = t + "    Opened()" + NL
    t = t + "    WHILE i < lines.Count" + NL
    t = t + "        line = lines[i]" + NL
    t = t + "        i = i + 1" + NL
    t = t + "        IF line = """" OR line.StartsWith(""'"") THEN CONTINUE" + NL
    t = t + "        IF line.StartsWith(""!"") THEN" + NL
    t = t + "            AddPicture(line.Substring(1, line.Length - 1))" + NL
    t = t + "        ELSE" + NL
    t = t + "            frames.Add(line)" + NL
    t = t + "        END IF" + NL
    t = t + "    END WHILE" + NL
    t = t + "    partsIn = partsIn + 1" + NL
    t = t + "    IF partsIn >= partRefs.Count THEN" + NL
    t = t + "        allIn = TRUE" + NL
    t = t + "        mFrames = frames.Count" + NL
    t = t + "    END IF" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' !name|SIM95PIC w h|row|row..." + NL
    t = t + "SUB AddPicture (line AS String)" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    at = line.IndexOf(""|"")" + NL
    t = t + "    IF at < 1 THEN RETURN" + NL
    t = t + "    picNames.Add(line.Substring(0, at))" + NL
    t = t + "    picData.Add(line.Substring(at + 1, line.Length - at - 1).Replace(""|"", EOL))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where a part is, from what the manifest says and where the manifest was." + NL
    t = t + "FUNCTION Resolve (ref AS String, base AS String) AS String" + NL
    t = t + "    VAR host AS String" + NL
    t = t + "    IF ref.Lower().StartsWith(""http://"") THEN RETURN ref" + NL
    t = t + "    IF base.Lower().StartsWith(""http://"") THEN" + NL
    t = t + "        IF ref.StartsWith(""/"") THEN" + NL
    t = t + "            host = base.Substring(7, base.Length - 7)" + NL
    t = t + "            IF host.IndexOf(""/"") >= 0 THEN host = host.Substring(0, host.IndexOf(""/""))" + NL
    t = t + "            RETURN ""http://"" + host + ref" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN base + ref" + NL
    t = t + "    END IF" + NL
    t = t + "    IF ref.Contains("":\"") THEN RETURN ref" + NL
    t = t + "    RETURN base + ref" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The folder an address is in, with its slash: http://a/tube/ or C:\MYFILES\" + NL
    t = t + "FUNCTION DirOf (where AS String) AS String" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR sep AS String" + NL
    t = t + "    sep = ""\""" + NL
    t = t + "    IF where.Lower().StartsWith(""http://"") THEN" + NL
    t = t + "        sep = ""/""" + NL
    t = t + "        IF where.IndexOf(""?"") >= 0 THEN where = where.Substring(0, where.IndexOf(""?""))" + NL
    t = t + "        IF where.Substring(7, where.Length - 7).IndexOf(""/"") < 0 THEN RETURN where + ""/""" + NL
    t = t + "    END IF" + NL
    t = t + "    FOR i = where.Length - 1 TO 0 STEP -1" + NL
    t = t + "        IF where.CharAt(i) = sep THEN RETURN where.Substring(0, i + 1)" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN """"" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Total () AS Integer" + NL
    t = t + "    IF allIn THEN RETURN frames.Count" + NL
    t = t + "    RETURN MATH.Max(mFrames, frames.Count)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Enough is here to play: all of it, or a few seconds past this frame." + NL
    t = t + "FUNCTION Ready () AS Bool" + NL
    t = t + "    IF frames.Count = 0 THEN RETURN FALSE" + NL
    t = t + "    IF allIn THEN RETURN TRUE" + NL
    t = t + "    RETURN frames.Count - 1 - cur >= mFps * AHEAD" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "FUNCTION Percent () AS Integer" + NL
    t = t + "    IF partRefs.Count = 0 THEN RETURN 0" + NL
    t = t + "    RETURN Int(partsIn * 100 / partRefs.Count)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ playing" + NL
    t = t + "" + NL
    t = t + "SUB Ticker_OnTick ()" + NL
    t = t + "    IF drawing THEN RETURN" + NL
    t = t + "    drawing = TRUE" + NL
    t = t + "    TRY" + NL
    t = t + "        PlayStep()" + NL
    t = t + "    CATCH err" + NL
    t = t + "        win.Status = ""Could not draw frame "" + Str(cur + 1) + "": "" + err" + NL
    t = t + "    END TRY" + NL
    t = t + "    drawing = FALSE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB PlayStep ()" + NL
    t = t + "    VAR want AS Integer" + NL
    t = t + "    VAR last AS Integer" + NL
    t = t + "    IF state = ""buffering"" THEN" + NL
    t = t + "        IF wantPlay AND Ready() THEN BeginPlay()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF state <> ""playing"" THEN RETURN" + NL
    t = t + "    want = f0 + Int((SYS.Ticks - t0) * mFps / 1000)" + NL
    t = t + "    last = Total() - 1" + NL
    t = t + "    IF want > last AND allIn THEN" + NL
    t = t + "        IF cur < last THEN ShowFrame(last, TRUE)" + NL
    t = t + "        IF loopBox.Checked THEN" + NL
    t = t + "            ShowFrame(0, TRUE)" + NL
    t = t + "            t0 = SYS.Ticks" + NL
    t = t + "            f0 = 0" + NL
    t = t + "        ELSE" + NL
    t = t + "            state = ""ended""" + NL
    t = t + "            wantPlay = FALSE" + NL
    t = t + "        END IF" + NL
    t = t + "        Refresh()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF want > frames.Count - 1 THEN" + NL
    t = t + "        ' caught up with the download: wait for more" + NL
    t = t + "        IF cur < frames.Count - 1 THEN ShowFrame(frames.Count - 1, TRUE)" + NL
    t = t + "        state = ""buffering""" + NL
    t = t + "        Refresh()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF want > cur THEN" + NL
    t = t + "        ShowFrame(want, TRUE)" + NL
    t = t + "        Refresh()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB BeginPlay ()" + NL
    t = t + "    IF cur >= Total() - 1 THEN cur = -1" + NL
    t = t + "    IF cur < 0 THEN ShowFrame(0, TRUE)" + NL
    t = t + "    t0 = SYS.Ticks" + NL
    t = t + "    f0 = cur" + NL
    t = t + "    state = ""playing""" + NL
    t = t + "    wantPlay = TRUE" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Pause ()" + NL
    t = t + "    wantPlay = FALSE" + NL
    t = t + "    IF state = ""playing"" OR state = ""buffering"" THEN state = ""paused""" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION HasMovie () AS Bool" + NL
    t = t + "    RETURN frames.Count > 0" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' Frame n on the screen. Going forward, the frames in between are drawn over" + NL
    t = t + "' what is there (from a keyframe, if one comes first); anywhere else, from the" + NL
    t = t + "' keyframe before n." + NL
    t = t + "SUB ShowFrame (n AS Integer, sound AS Bool)" + NL
    t = t + "    VAR start AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    IF n < 0 OR n >= frames.Count THEN RETURN" + NL
    t = t + "    start = n" + NL
    t = t + "    WHILE start > 0 AND NOT frames[start].StartsWith(""*"")" + NL
    t = t + "        IF start = cur + 1 AND cur >= 0 AND n > cur THEN BREAK" + NL
    t = t + "        start = start - 1" + NL
    t = t + "    END WHILE" + NL
    t = t + "    IF NOT frames[start].StartsWith(""*"") AND start = 0 THEN Blank()" + NL
    t = t + "    FOR i = start TO n" + NL
    t = t + "        DrawFrame(frames[i], sound AND i = n)" + NL
    t = t + "    NEXT" + NL
    t = t + "    cur = n" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Blank ()" + NL
    t = t + "    screen.Background = mBg" + NL
    t = t + "    screen.Clear()" + NL
    t = t + "    screen.SetColor(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawFrame (line AS String, sound AS Bool)" + NL
    t = t + "    VAR c AS String" + NL
    t = t + "    IF line.StartsWith(""*"") THEN" + NL
    t = t + "        Blank()" + NL
    t = t + "        line = line.Substring(1, line.Length - 1)" + NL
    t = t + "    END IF" + NL
    t = t + "    IF line = ""-"" OR line = """" THEN RETURN" + NL
    t = t + "    FOR EACH c IN line.Split("";"")" + NL
    t = t + "        IF c <> """" THEN DrawCmd(c, sound)" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' One command: a letter and its numbers." + NL
    t = t + "SUB DrawCmd (c AS String, sound AS Bool)" + NL
    t = t + "    VAR op AS String" + NL
    t = t + "    VAR rest AS String" + NL
    t = t + "    VAR n AS Array OF Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR at AS Integer" + NL
    t = t + "    op = c.CharAt(0)" + NL
    t = t + "    rest = c.Substring(1, c.Length - 1)" + NL
    t = t + "    SELECT CASE op" + NL
    t = t + "        CASE ""C""" + NL
    t = t + "            screen.SetColor(Clamp(Int(Val(rest)), 0, 15))" + NL
    t = t + "        CASE ""B""" + NL
    t = t + "            screen.Background = Clamp(Int(Val(rest)), 0, 15)" + NL
    t = t + "        CASE ""X""" + NL
    t = t + "            screen.Clear()" + NL
    t = t + "        CASE ""T""" + NL
    t = t + "            ' T x,y,text: the text runs to the end of the command" + NL
    t = t + "            n = Nums(rest, 2)" + NL
    t = t + "            at = SecondComma(rest)" + NL
    t = t + "            IF n.Count = 2 AND at > 0 THEN screen.Text(n[0], n[1], rest.Substring(at + 1, rest.Length - at - 1))" + NL
    t = t + "        CASE ""I""" + NL
    t = t + "            n = Nums(rest, 2)" + NL
    t = t + "            at = SecondComma(rest)" + NL
    t = t + "            IF n.Count = 2 AND at > 0 THEN" + NL
    t = t + "                i = picNames.IndexOf(rest.Substring(at + 1, rest.Length - at - 1))" + NL
    t = t + "                IF i >= 0 THEN screen.Picture(n[0], n[1], picData[i])" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""S""" + NL
    t = t + "            n = Nums(rest, 2)" + NL
    t = t + "            IF sound AND NOT muteBox.Checked AND n.Count = 2 THEN SYS.Beep(Clamp(n[0], 37, 8000), Clamp(n[1], 1, 1000))" + NL
    t = t + "        CASE ""R""" + NL
    t = t + "            n = Nums(rest, 4)" + NL
    t = t + "            IF n.Count = 4 THEN screen.Rect(n[0], n[1], n[2], n[3])" + NL
    t = t + "        CASE ""F""" + NL
    t = t + "            n = Nums(rest, 4)" + NL
    t = t + "            IF n.Count = 4 THEN screen.FillRect(n[0], n[1], n[2], n[3])" + NL
    t = t + "        CASE ""O""" + NL
    t = t + "            n = Nums(rest, 3)" + NL
    t = t + "            IF n.Count = 3 THEN screen.Circle(n[0], n[1], n[2])" + NL
    t = t + "        CASE ""D""" + NL
    t = t + "            n = Nums(rest, 3)" + NL
    t = t + "            IF n.Count = 3 THEN screen.FillCircle(n[0], n[1], n[2])" + NL
    t = t + "        CASE ""L""" + NL
    t = t + "            n = Nums(rest, 0)" + NL
    t = t + "            FOR i = 0 TO Int(n.Count / 2) - 2" + NL
    t = t + "                screen.Line(n[i * 2], n[i * 2 + 1], n[i * 2 + 2], n[i * 2 + 3])" + NL
    t = t + "            NEXT" + NL
    t = t + "        CASE ""P""" + NL
    t = t + "            n = Nums(rest, 0)" + NL
    t = t + "            IF n.Count >= 4 THEN" + NL
    t = t + "                FOR i = 0 TO Int(n.Count / 2) - 1" + NL
    t = t + "                    screen.Line(n[i * 2], n[i * 2 + 1], n[((i + 1) * 2) MOD (Int(n.Count / 2) * 2)], n[((i + 1) * 2) MOD (Int(n.Count / 2) * 2) + 1])" + NL
    t = t + "                NEXT" + NL
    t = t + "            END IF" + NL
    t = t + "        CASE ""Q""" + NL
    t = t + "            n = Nums(rest, 0)" + NL
    t = t + "            IF n.Count >= 6 THEN FillPoly(n)" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Where the text of T x,y,text (or the name of I x,y,name) starts, less one." + NL
    t = t + "FUNCTION SecondComma (s AS String) AS Integer" + NL
    t = t + "    VAR a AS Integer" + NL
    t = t + "    VAR b AS Integer" + NL
    t = t + "    a = s.IndexOf("","")" + NL
    t = t + "    IF a < 0 THEN RETURN -1" + NL
    t = t + "    b = s.Substring(a + 1, s.Length - a - 1).IndexOf("","")" + NL
    t = t + "    IF b < 0 THEN RETURN -1" + NL
    t = t + "    RETURN a + 1 + b" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' The numbers in ""10,20,30"". most > 0 reads only that many (T and I have" + NL
    t = t + "' text after theirs)." + NL
    t = t + "FUNCTION Nums (s AS String, most AS Integer) AS Array OF Integer" + NL
    t = t + "    VAR out AS Array OF Integer" + NL
    t = t + "    VAR p AS String" + NL
    t = t + "    FOR EACH p IN s.Split("","")" + NL
    t = t + "        IF most > 0 AND out.Count >= most THEN BREAK" + NL
    t = t + "        out.Add(Int(Val(p.Trim())))" + NL
    t = t + "    NEXT" + NL
    t = t + "    RETURN out" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' A filled polygon, a row at a time: where each row crosses the edges, in" + NL
    t = t + "' pairs." + NL
    t = t + "SUB FillPoly (p AS Array OF Integer)" + NL
    t = t + "    VAR k AS Integer" + NL
    t = t + "    VAR i AS Integer" + NL
    t = t + "    VAR j AS Integer" + NL
    t = t + "    VAR y AS Integer" + NL
    t = t + "    VAR top AS Integer" + NL
    t = t + "    VAR bottom AS Integer" + NL
    t = t + "    VAR x1 AS Integer" + NL
    t = t + "    VAR y1 AS Integer" + NL
    t = t + "    VAR x2 AS Integer" + NL
    t = t + "    VAR y2 AS Integer" + NL
    t = t + "    VAR xs AS Array OF Integer" + NL
    t = t + "    k = Int(p.Count / 2)" + NL
    t = t + "    top = p[1]" + NL
    t = t + "    bottom = p[1]" + NL
    t = t + "    FOR i = 1 TO k - 1" + NL
    t = t + "        top = MATH.Min(top, p[i * 2 + 1])" + NL
    t = t + "        bottom = MATH.Max(bottom, p[i * 2 + 1])" + NL
    t = t + "    NEXT" + NL
    t = t + "    FOR y = top TO bottom" + NL
    t = t + "        xs.Clear()" + NL
    t = t + "        FOR i = 0 TO k - 1" + NL
    t = t + "            j = (i + 1) MOD k" + NL
    t = t + "            x1 = p[i * 2]" + NL
    t = t + "            y1 = p[i * 2 + 1]" + NL
    t = t + "            x2 = p[j * 2]" + NL
    t = t + "            y2 = p[j * 2 + 1]" + NL
    t = t + "            IF (y1 <= y AND y2 > y) OR (y2 <= y AND y1 > y) THEN xs.Add(x1 + Int((y - y1) * (x2 - x1) / (y2 - y1)))" + NL
    t = t + "        NEXT" + NL
    t = t + "        xs.Sort()" + NL
    t = t + "        FOR i = 0 TO xs.Count - 2" + NL
    t = t + "            IF i MOD 2 = 0 THEN screen.Line(xs[i], y, xs[i + 1], y)" + NL
    t = t + "        NEXT" + NL
    t = t + "    NEXT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the controls" + NL
    t = t + "" + NL
    t = t + "SUB Play_Click ()" + NL
    t = t + "    IF state = ""playing"" OR (state = ""buffering"" AND wantPlay) THEN" + NL
    t = t + "        Pause()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT HasMovie() AND NOT remote THEN RETURN" + NL
    t = t + "    IF state = ""error"" THEN RETURN" + NL
    t = t + "    IF state = ""ended"" OR cur >= Total() - 1 THEN cur = -1" + NL
    t = t + "    wantPlay = TRUE" + NL
    t = t + "    IF Ready() THEN" + NL
    t = t + "        BeginPlay()" + NL
    t = t + "    ELSE" + NL
    t = t + "        state = ""buffering""" + NL
    t = t + "        Refresh()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Stop_Click ()" + NL
    t = t + "    IF NOT HasMovie() THEN RETURN" + NL
    t = t + "    wantPlay = FALSE" + NL
    t = t + "    ShowFrame(0, FALSE)" + NL
    t = t + "    state = ""stopped""" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Rewind_Click ()" + NL
    t = t + "    SeekFrame(0)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Back_Click ()" + NL
    t = t + "    IF NOT HasMovie() THEN RETURN" + NL
    t = t + "    Pause()" + NL
    t = t + "    IF state = ""stopped"" OR state = ""ended"" THEN state = ""paused""" + NL
    t = t + "    IF cur > 0 THEN ShowFrame(cur - 1, FALSE)" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Fwd_Click ()" + NL
    t = t + "    IF NOT HasMovie() THEN RETURN" + NL
    t = t + "    Pause()" + NL
    t = t + "    IF state = ""stopped"" OR state = ""ended"" THEN state = ""paused""" + NL
    t = t + "    IF cur < frames.Count - 1 THEN ShowFrame(cur + 1, TRUE)" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' Anywhere in what has arrived so far; playing carries on from there." + NL
    t = t + "SUB SeekFrame (n AS Integer)" + NL
    t = t + "    IF NOT HasMovie() THEN RETURN" + NL
    t = t + "    n = Clamp(n, 0, frames.Count - 1)" + NL
    t = t + "    ShowFrame(n, FALSE)" + NL
    t = t + "    IF state = ""playing"" THEN" + NL
    t = t + "        t0 = SYS.Ticks" + NL
    t = t + "        f0 = n" + NL
    t = t + "    ELSEIF state = ""stopped"" OR state = ""ended"" THEN" + NL
    t = t + "        state = ""paused""" + NL
    t = t + "    END IF" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Loop_Change ()" + NL
    t = t + "    bar.SetChecked(""Loop"", loopBox.Checked)" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Mute_Change ()" + NL
    t = t + "    bar.SetChecked(""Mute"", muteBox.Checked)" + NL
    t = t + "    Refresh()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Open_Click ()" + NL
    t = t + "    OpenMovie(addr.Text)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB OpenFile ()" + NL
    t = t + "    VAR dlg AS GUI_FileDialog" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    dlg = GUI_FileDialog.New(win)" + NL
    t = t + "    dlg.Title = ""Open a SimMovie""" + NL
    t = t + "    dlg.Filter = ""*.SMV""" + NL
    t = t + "    dlg.Path = ""C:\MYFILES""" + NL
    t = t + "    path = dlg.ShowOpen()" + NL
    t = t + "    IF path <> """" THEN" + NL
    t = t + "        addr.Text = path" + NL
    t = t + "        OpenMovie(path)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Player_OnKey (k AS String)" + NL
    t = t + "    SELECT CASE k" + NL
    t = t + "        CASE ""Space""" + NL
    t = t + "            Play_Click()" + NL
    t = t + "        CASE ""ArrowRight"", "".""" + NL
    t = t + "            Fwd_Click()" + NL
    t = t + "        CASE ""ArrowLeft"", "",""" + NL
    t = t + "            Back_Click()" + NL
    t = t + "        CASE ""Home""" + NL
    t = t + "            Rewind_Click()" + NL
    t = t + "        CASE ""Ctrl+O""" + NL
    t = t + "            OpenFile()" + NL
    t = t + "        CASE ""Ctrl+L""" + NL
    t = t + "            addr.Focus()" + NL
    t = t + "            addr.SelectAll()" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Screen_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    Play_Click()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Screen_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    IF cur >= 0 THEN" + NL
    t = t + "        ShowFrame(cur, FALSE)" + NL
    t = t + "    ELSEIF NOT HasMovie() AND state = ""empty"" THEN" + NL
    t = t + "        Splash()" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Menu_OnSelect (item AS String)" + NL
    t = t + "    VAR box AS GUI_MessageBox" + NL
    t = t + "    SELECT CASE item" + NL
    t = t + "        CASE ""Open File...""" + NL
    t = t + "            OpenFile()" + NL
    t = t + "        CASE ""Open URL...""" + NL
    t = t + "            addr.Focus()" + NL
    t = t + "            addr.SelectAll()" + NL
    t = t + "        CASE ""Exit""" + NL
    t = t + "            SYS.Exit(0)" + NL
    t = t + "        CASE ""Play/Pause""" + NL
    t = t + "            Play_Click()" + NL
    t = t + "        CASE ""Stop""" + NL
    t = t + "            Stop_Click()" + NL
    t = t + "        CASE ""Rewind""" + NL
    t = t + "            Rewind_Click()" + NL
    t = t + "        CASE ""Step Forward""" + NL
    t = t + "            Fwd_Click()" + NL
    t = t + "        CASE ""Step Back""" + NL
    t = t + "            Back_Click()" + NL
    t = t + "        CASE ""Loop""" + NL
    t = t + "            loopBox.Checked = NOT loopBox.Checked" + NL
    t = t + "            Loop_Change()" + NL
    t = t + "        CASE ""Mute""" + NL
    t = t + "            muteBox.Checked = NOT muteBox.Checked" + NL
    t = t + "            Mute_Change()" + NL
    t = t + "        CASE ""About SimPlayer""" + NL
    t = t + "            box = GUI_MessageBox.New(win)" + NL
    t = t + "            box.Title = ""About SimPlayer""" + NL
    t = t + "            box.Text = ""SimPlayer 1.0 for SIM95"" + EOL + EOL + ""Plays SimMovies (.SMV) from your disk or the web, and streams the long ones while they download."" + EOL + EOL + ""Find movies on SimTube.""" + NL
    t = t + "            box.Show()" + NL
    t = t + "    END SELECT" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the seek bar" + NL
    t = t + "" + NL
    t = t + "SUB Seek_OnDraw (canvas AS GUI_Canvas)" + NL
    t = t + "    DrawSeek()" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB DrawSeek ()" + NL
    t = t + "    VAR w AS Integer" + NL
    t = t + "    VAR t AS Integer" + NL
    t = t + "    VAR x AS Integer" + NL
    t = t + "    w = seekBar.Width" + NL
    t = t + "    t = MATH.Max(1, Total() - 1)" + NL
    t = t + "    seekBar.Background = 7" + NL
    t = t + "    seekBar.Clear()" + NL
    t = t + "    seekBar.SetColor(8)" + NL
    t = t + "    seekBar.Line(0, 0, w - 1, 0)" + NL
    t = t + "    seekBar.Line(0, 0, 0, 13)" + NL
    t = t + "    seekBar.SetColor(15)" + NL
    t = t + "    seekBar.Line(0, 13, w - 1, 13)" + NL
    t = t + "    ' downloaded, and played" + NL
    t = t + "    IF HasMovie() THEN" + NL
    t = t + "        seekBar.SetColor(6)" + NL
    t = t + "        seekBar.FillRect(2, 5, Int((w - 4) * MATH.Min(1, (frames.Count - 1) / t)), 4)" + NL
    t = t + "        x = Int((w - 12) * MATH.Max(0, cur) / t)" + NL
    t = t + "        seekBar.SetColor(4)" + NL
    t = t + "        seekBar.FillRect(2, 5, x, 4)" + NL
    t = t + "        ' the thumb" + NL
    t = t + "        seekBar.SetColor(7)" + NL
    t = t + "        seekBar.FillRect(x + 1, 1, 10, 12)" + NL
    t = t + "        seekBar.SetColor(15)" + NL
    t = t + "        seekBar.Line(x + 1, 1, x + 10, 1)" + NL
    t = t + "        seekBar.Line(x + 1, 1, x + 1, 12)" + NL
    t = t + "        seekBar.SetColor(0)" + NL
    t = t + "        seekBar.Line(x + 1, 12, x + 10, 12)" + NL
    t = t + "        seekBar.Line(x + 10, 1, x + 10, 12)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION FrameAt (x AS Integer) AS Integer" + NL
    t = t + "    RETURN Int(MATH.Max(0, x - 6) * MATH.Max(1, Total() - 1) / MATH.Max(1, seekBar.Width - 12))" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Seek_OnMouseDown (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    dragging = TRUE" + NL
    t = t + "    SeekFrame(FrameAt(x))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Seek_OnMouseMove (x AS Integer, y AS Integer)" + NL
    t = t + "    IF dragging THEN SeekFrame(FrameAt(x))" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Seek_OnMouseUp (x AS Integer, y AS Integer, button AS Integer)" + NL
    t = t + "    IF dragging THEN SeekFrame(FrameAt(x))" + NL
    t = t + "    dragging = FALSE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' ================================================================ what it says" + NL
    t = t + "" + NL
    t = t + "FUNCTION Clock (n AS Integer) AS String" + NL
    t = t + "    VAR s AS Integer" + NL
    t = t + "    s = Int(MATH.Max(0, n) / mFps)" + NL
    t = t + "    RETURN Str(Int(s / 60)) + "":"" + Str(100 + s MOD 60).Substring(1, 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Refresh ()" + NL
    t = t + "    VAR what AS String" + NL
    t = t + "    VAR flag AS String" + NL
    t = t + "    SELECT CASE state" + NL
    t = t + "        CASE ""empty""" + NL
    t = t + "            what = ""Ready. Open a SimMovie (.SMV) from your disk, or type its address.""" + NL
    t = t + "        CASE ""buffering""" + NL
    t = t + "            what = ""Buffering... "" + Str(Percent()) + ""%""" + NL
    t = t + "            IF NOT gotHeader THEN what = what + ""  (connecting to "" + HostOf(source) + "")""" + NL
    t = t + "        CASE ""playing""" + NL
    t = t + "            what = ""Playing""" + NL
    t = t + "        CASE ""paused""" + NL
    t = t + "            what = ""Paused""" + NL
    t = t + "        CASE ""stopped""" + NL
    t = t + "            what = ""Stopped""" + NL
    t = t + "        CASE ""ended""" + NL
    t = t + "            what = ""Finished""" + NL
    t = t + "        CASE ""error""" + NL
    t = t + "            what = problem" + NL
    t = t + "    END SELECT" + NL
    t = t + "    IF remote AND NOT allIn AND state <> ""buffering"" AND state <> ""error"" THEN what = what + ""  ("" + Str(Percent()) + ""% downloaded)""" + NL
    t = t + "    IF muteBox.Checked AND state <> ""error"" THEN what = what + ""  [muted]""" + NL
    t = t + "    win.Status = what" + NL
    t = t + "    IF state = ""playing"" OR (state = ""buffering"" AND wantPlay) THEN" + NL
    t = t + "        playBtn.Text = ""&Pause""" + NL
    t = t + "    ELSE" + NL
    t = t + "        playBtn.Text = ""&Play""" + NL
    t = t + "    END IF" + NL
    t = t + "    IF gotHeader THEN" + NL
    t = t + "        info.Text = mTitle" + NL
    t = t + "        IF mAuthor <> """" THEN info.Text = mTitle + ""  -  by "" + mAuthor" + NL
    t = t + "        timeLabel.Text = Clock(MATH.Max(cur, 0)) + "" / "" + Clock(Total())" + NL
    t = t + "    ELSE" + NL
    t = t + "        info.Text = """"" + NL
    t = t + "        timeLabel.Text = ""0:00 / 0:00""" + NL
    t = t + "    END IF" + NL
    t = t + "    DrawSeek()" + NL
    t = t + "    flag = ""0|0""" + NL
    t = t + "    IF loopBox.Checked THEN flag = ""1|0""" + NL
    t = t + "    IF muteBox.Checked THEN flag = flag.Substring(0, 2) + ""1""" + NL
    t = t + "    win.Tag = state + ""|"" + Str(cur) + ""|"" + Str(Total()) + ""|"" + Str(frames.Count) + ""|"" + Str(partsIn) + ""|"" + Str(partRefs.Count) + ""|"" + flag" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "FUNCTION HostOf (url AS String) AS String" + NL
    t = t + "    VAR h AS String" + NL
    t = t + "    IF NOT url.Lower().StartsWith(""http://"") THEN RETURN url" + NL
    t = t + "    h = url.Substring(7, url.Length - 7)" + NL
    t = t + "    IF h.IndexOf(""/"") >= 0 THEN h = h.Substring(0, h.IndexOf(""/""))" + NL
    t = t + "    RETURN h" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "' ================================================================ the web" + NL
    t = t + "" + NL
    t = t + "SUB Fetcher_OnTick ()" + NL
    t = t + "    TRY" + NL
    t = t + "        FetchStep()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB FetchStep ()" + NL
    t = t + "    IF fetching THEN" + NL
    t = t + "        IF fDone OR SYS.Ticks - fSince > PATIENCE THEN Arrived()" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT remote OR state = ""error"" THEN RETURN" + NL
    t = t + "    IF wantFirst THEN" + NL
    t = t + "        wantFirst = FALSE" + NL
    t = t + "        fFirst = TRUE" + NL
    t = t + "        ' (last thing in the tick: it may be spoiled)" + NL
    t = t + "        StartFetch(source)" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    IF partsIn < partRefs.Count THEN" + NL
    t = t + "        fFirst = FALSE" + NL
    t = t + "        StartFetch(partRefs[partsIn])" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB StartFetch (url AS String)" + NL
    t = t + "    VAR conn AS NET_Connection" + NL
    t = t + "    VAR host AS String" + NL
    t = t + "    VAR path AS String" + NL
    t = t + "    fetching = TRUE" + NL
    t = t + "    fUrl = url" + NL
    t = t + "    fNumber = fNumber + 1" + NL
    t = t + "    fParts.Clear()" + NL
    t = t + "    fDone = FALSE" + NL
    t = t + "    fError = """"" + NL
    t = t + "    fSince = SYS.Ticks" + NL
    t = t + "    host = url.Substring(7, url.Length - 7)" + NL
    t = t + "    IF host.IndexOf(""/"") < 0 THEN host = host + ""/""" + NL
    t = t + "    path = host.Substring(host.IndexOf(""/""), host.Length - host.IndexOf(""/""))" + NL
    t = t + "    host = host.Substring(0, host.IndexOf(""/""))" + NL
    t = t + "    TRY" + NL
    t = t + "        conn = web.Connect(host, 80)" + NL
    t = t + "        conn.Tag = Str(fNumber)" + NL
    t = t + "        conn.Send(""GET "" + path + "" HTTP/1.0"" + EOL + ""Host: "" + host + EOL + ""User-Agent: SimPlayer/1.0 (SIM95)"" + EOL + ""Accept: video/x-simmovie"")" + NL
    t = t + "    CATCH err" + NL
    t = t + "        fError = err" + NL
    t = t + "        fDone = TRUE" + NL
    t = t + "    END TRY" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnMessage (conn AS NET_Connection, message AS String)" + NL
    t = t + "    IF conn.Tag = Str(fNumber) AND NOT fDone THEN fParts.Add(message)" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "SUB Web_OnClose (conn AS NET_Connection)" + NL
    t = t + "    IF conn.Tag = Str(fNumber) THEN fDone = TRUE" + NL
    t = t + "END SUB" + NL
    t = t + "" + NL
    t = t + "' A fetch finished (or gave up): the body, or """" with fError saying why." + NL
    t = t + "FUNCTION Body () AS String" + NL
    t = t + "    VAR raw AS String" + NL
    t = t + "    raw = fParts.Join(EOL)" + NL
    t = t + "    IF fError <> """" THEN RETURN """"" + NL
    t = t + "    IF raw = """" THEN" + NL
    t = t + "        fError = ""no answer""" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT raw.StartsWith(""HTTP/1.0 200"") THEN" + NL
    t = t + "        fError = raw.Lines()[0]" + NL
    t = t + "        RETURN """"" + NL
    t = t + "    END IF" + NL
    t = t + "    IF NOT raw.Contains(EOL + EOL) THEN RETURN """"" + NL
    t = t + "    RETURN raw.Substring(raw.IndexOf(EOL + EOL) + 2, raw.Length - raw.IndexOf(EOL + EOL) - 2)" + NL
    t = t + "END FUNCTION" + NL
    t = t + "" + NL
    t = t + "SUB Arrived ()" + NL
    t = t + "    VAR text AS String" + NL
    t = t + "    fetching = FALSE" + NL
    t = t + "    TRY" + NL
    t = t + "        web.Close()" + NL
    t = t + "    CATCH err" + NL
    t = t + "    END TRY" + NL
    t = t + "    IF NOT remote OR source = """" THEN RETURN" + NL
    t = t + "    text = Body()" + NL
    t = t + "    IF text = """" THEN" + NL
    t = t + "        tries = tries + 1" + NL
    t = t + "        IF fError = """" THEN fError = ""it was empty""" + NL
    t = t + "        IF tries >= MAXTRIES OR fError.StartsWith(""HTTP"") THEN" + NL
    t = t + "            Fail(""Could not get "" + fUrl + "" ("" + fError + "")."")" + NL
    t = t + "        ELSEIF fFirst THEN" + NL
    t = t + "            wantFirst = TRUE" + NL
    t = t + "        END IF" + NL
    t = t + "        RETURN" + NL
    t = t + "    END IF" + NL
    t = t + "    tries = 0" + NL
    t = t + "    IF fFirst THEN" + NL
    t = t + "        TakeFirst(text, DirOf(fUrl))" + NL
    t = t + "    ELSE" + NL
    t = t + "        AddPart(text)" + NL
    t = t + "    END IF" + NL
    t = t + "END SUB" + NL
    Put("C:\PROGRAMS\PLAYER.SPK")
END SUB

